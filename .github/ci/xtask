#!/usr/bin/env bash
# CI 专用 xtask 入口：`xtask <cmd> [args]` ≡ 本地 `./xtask`（apphost）的行为 —— 用仓库根 `.z42/` 这份 SDK 的
# z42vm + libs 跑 artifacts/xtask/xtask.zpkg。由 ci-bootstrap / xtask-bootstrap-artifact 两个 action 在末尾加进
# $GITHUB_PATH，此后 workflow 的步骤里直接写 `xtask test all ...`。
#
# `.z42/` 由 setup-z42-sdk 装（上一版 nightly，与本地 `scripts/install-z42.sh` 同位置同形态），xtask.zpkg 也是用
# 这份 SDK 的 z42c 编的 ⇒ **编 xtask 与跑 xtask 是同一个工具链**，与本地一致（add-sdk-libs D7）。此前 CI 用
# 种子编 xtask、却跑在 cargo 现编的构建树 z42vm + 构建树 stdlib 上 —— 「用种子编、用新版跑」的错位一直存在。
#
# 与本地 apphost 逐项对齐：
#   · VM / libs 取 `.z42/`（Windows 带 `.exe`）；调用方显式设了 Z42_LIBS 则尊重（apphost 同款）；
#   · **不设** Z42_PORTABLE_VM：仓库根的 `./xtask` 旁没有 z42vm，apphost 不设它；xtask 构建 / 测试当前源码时
#     派生的子进程由 xtask 自己定位构建树工具。
#   · 不再需要「Windows 从 z42vm.exe 的拷贝启动」：那是为了 `package` 等命令让 cargo 重链**构建树**的 z42vm.exe
#     时不撞上正在运行的它；xtask 现在跑在 SDK 的 VM 上，cargo 从不碰它。
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
sdk="$root/.z42"
vm="$sdk/bin/z42vm"
[ -f "$vm.exe" ] && vm="$vm.exe"
zpkg="$root/artifacts/xtask/xtask.zpkg"

[ -f "$vm" ]   || { echo "::error::xtask shim: SDK not installed ($vm) — run the setup-z42-sdk / ci-bootstrap action first" >&2; exit 2; }
[ -f "$zpkg" ] || { echo "::error::xtask shim: xtask.zpkg missing ($zpkg) — run a bootstrap action first" >&2; exit 2; }

export Z42_LIBS="${Z42_LIBS:-$sdk/libs}"
exec "$vm" "$zpkg" -- "$@"
