#!/usr/bin/env bash
# CI 专用 xtask 入口：`xtask <cmd> [args]` ≡ 用仓库标准布局里的 release z42vm + flat stdlib
# 跑 artifacts/xtask/xtask.zpkg。由 ci-bootstrap / xtask-bootstrap-artifact 两个 action 在
# 末尾加进 $GITHUB_PATH，此后 workflow 的步骤里直接写 `xtask test all ...`。
#
# 为什么需要它（centralize-xtask-layout）：此前每个步骤都手抄一遍
#   vm=".../z42vm"; [ -f "$vm.exe" ] && vm="$vm.exe"
#   Z42_PORTABLE_VM="$vm" Z42_LIBS=".../dist/release" "$vm" artifacts/xtask/xtask.zpkg -- ...
# ci.yml 里 38 处。z42vm / flat stdlib / xtask.zpkg 这三个位置因此在 CI 里被复制了 50+ 次，
# 布局一动就得全改。现在**这三个位置在 CI 里只写在这一个文件**。
#
# 行为与原样板逐项等价：
#   · Windows 的 `.exe` 后缀；
#   · Windows 不能覆盖**正在运行**的 exe —— 而 `package` 等命令会让 cargo 重链 z42vm.exe。
#     所以 Windows 上每次都从 cargo 输出目录之外的一份**拷贝**启动（原样板里的 `.ci-runner`）；
#     Z42_PORTABLE_VM 仍指向 cargo 输出里的那份（xtask 派生子进程用它）。每次现拷，
#     故上一步刚重链出的新 z42vm 在下一次调用即生效。Unix 上直接用原件。
#   · Z42_PORTABLE_VM / Z42_LIBS 只在调用方**没设**时才给默认值，调用方显式设置的照旧生效。
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
vm="$root/artifacts/build/runtime/release/z42vm"
[ -f "$vm.exe" ] && vm="$vm.exe"
libs="$root/artifacts/build/libraries/dist/release"
zpkg="$root/artifacts/xtask/xtask.zpkg"

[ -f "$vm" ]   || { echo "::error::xtask shim: z42vm not built ($vm) — run a bootstrap action first" >&2; exit 2; }
[ -f "$zpkg" ] || { echo "::error::xtask shim: xtask.zpkg missing ($zpkg) — run a bootstrap action first" >&2; exit 2; }

runner="$vm"
if [ "${RUNNER_OS:-}" = "Windows" ]; then
  d="${RUNNER_TEMP:-$root/.ci-runner}/xtask-runner"
  mkdir -p "$d"
  cp -f "$vm" "$d/"
  cp -f "$root"/artifacts/build/runtime/release/*.dll "$d/" 2>/dev/null || true
  runner="$d/$(basename "$vm")"
fi

export Z42_PORTABLE_VM="${Z42_PORTABLE_VM:-$vm}"
export Z42_LIBS="${Z42_LIBS:-$libs}"
exec "$runner" "$zpkg" -- "$@"
