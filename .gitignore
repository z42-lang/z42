# Build artifacts (all redirected to artifacts/)
artifacts/

# Per-project incremental compile cache (z42c build; port-incremental-build-cache).
# Default lands at <projectDir>/.cache for bare projects (e.g. test-unit tomls under
# src/), ${output_dir}/.cache otherwise (already covered by artifacts/).
.cache/

# .NET / C#
*.user
*.suo
.vs/
*.nupkg
*.snupkg
*.lock.json
!packages.lock.json
# Build intermediates — always redirected to artifacts/ via Directory.Build.props
obj/
bin/

# Rust
# Cargo.lock IS committed for binary-producing crates (z42vm / launcher / test-runner /
# host embed + platform shims) so CI builds are reproducible. Without it `cargo build`
# re-resolves transitive deps on every run; upstream drift (e.g. a new alloc-no-stdlib
# major) then breaks a previously-green commit with zero source changes.
# Only the user-facing example/scaffold locks stay ignored.
**/examples/**/Cargo.lock
*.rlib
*.rmeta

# IDE
.vscode/settings.json
# workspace 本地扩展 symlink（`xtask deps install vscode` 生成，指向 src/toolchain/devtools/vscode）
.vscode/extensions/z42.z42-lang
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# z42 build outputs
*.z42c
*.zbc
*.zlib
*.zmod
*.zasm
*.z42ir.json
dist/
.cache/

# zbc-format wire-format fixtures: source.zbc are checked-in byte goldens
# (regen via src/tests/zbc-format/generate-fixtures.sh after a writer minor bump).
# Negate the *.zbc rule for this directory only.
!src/tests/zbc-format/**/source.zbc

# Cross-zpkg e2e test build artifacts (per-package libs/ populated by test driver).
src/tests/cross-zpkg/*/*/libs/

# BenchmarkDotNet output (auto-created in CWD when running `dotnet run` from any dir)
BenchmarkDotNet.Artifacts/

# Bench output / baseline files (only .gitkeep tracked; CI publishes real baselines elsewhere)
bench/results/*.json
bench/baselines/*.json

# Claude scheduler local state
.claude/scheduled_tasks.lock

# dotnet test runner output
TestResults/
.z42/

# Generated dev-CLI apphost at the repo root (scripts/build-xtask.sh).
# Native, platform-specific — regenerate, don't commit.
/xtask

# Guard against publish output leaking into the source tree (add-build-toolchain,
# 2026-07-05): publish_dir now defaults to ${output_dir}/publish, but a stray
# explicit publish into a component dir must never get committed.
src/**/programs/
src/**/publish/
src/toolchain/*/core/z42
src/toolchain/*/core/bin/
