// spectral_norm: Benchmarks Game spectral-norm — double arrays, tight nested loops.
// Checksum = trunc(norm × 1e9).
namespace Compare.SpectralNorm;

using Std;
using Std.IO;

double A(int i, int j) {
    int ij = i + j;
    return 1.0 / (double)(ij * (ij + 1) / 2 + i + 1);
}

void MulAv(double[] v, double[] av, int n) {
    for (int i = 0; i < n; i = i + 1) {
        double s = 0.0;
        for (int j = 0; j < n; j = j + 1) { s = s + A(i, j) * v[j]; }
        av[i] = s;
    }
}

void MulAtv(double[] v, double[] atv, int n) {
    for (int i = 0; i < n; i = i + 1) {
        double s = 0.0;
        for (int j = 0; j < n; j = j + 1) { s = s + A(j, i) * v[j]; }
        atv[i] = s;
    }
}

void MulAtAv(double[] v, double[] dst, double[] tmp, int n) {
    MulAv(v, tmp, n);
    MulAtv(tmp, dst, n);
}

void Main() {
    string[] args = Environment.GetCommandLineArgs();
    int n = int.Parse(args[0]);
    double[] u = new double[n];
    double[] v = new double[n];
    double[] tmp = new double[n];
    for (int i = 0; i < n; i = i + 1) { u[i] = 1.0; }
    for (int k = 0; k < 10; k = k + 1) {
        MulAtAv(u, v, tmp, n);
        MulAtAv(v, u, tmp, n);
    }
    double vbv = 0.0; double vv = 0.0;
    for (int i = 0; i < n; i = i + 1) { vbv = vbv + u[i] * v[i]; vv = vv + v[i] * v[i]; }
    long chk = (long)(Math.Sqrt(vbv / vv) * 1000000000.0);
    Console.WriteLine("RESULT " + chk.ToString());
}
