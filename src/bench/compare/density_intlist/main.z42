// density_intlist: List<int> grown to n elements by push — bytes/element.
namespace Compare.DensityIntList;

using Std;
using Std.IO;
using Std.Collections;

void Main() {
    string[] args = Environment.GetCommandLineArgs();
    int n = int.Parse(args[0]);
    var list = new List<int>();
    int i = 0;
    while (i < n) {
        list.Add(i);
        i = i + 1;
    }
    long s = 0L;
    i = 0;
    while (i < list.Count) { s = s + (long)list[i]; i = i + 1; }
    Console.WriteLine("RESULT " + s.ToString());
}
