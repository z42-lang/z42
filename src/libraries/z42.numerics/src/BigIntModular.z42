// BigIntModular —— 模幂（含 Montgomery REDC 快路径）与模逆（refactor-split-bigint，2026-09-03）。
// 自 2234 行的 BigInt.z42 按职责提出：BigInt 保留同名公开方法作薄委托（API 不变），算法体逐字搬移，
// 仅把 `this` 改为显式 `this` 参数、跨类调用改为 `BigIntXxx._helper(...)`。
namespace Std.Numerics;

using Std;
using Std.Random;

internal static class BigIntModular {
    /// Compute `(this ^ exp) mod modulus` via square-and-multiply
    /// (LSB-first), walking exp's bits with `TestBit` / `ShiftRight`.
    /// Reduces O(2^N) intermediate-size explosion of `Pow().Mod()` to
    /// O(N) modular multiplications. RSA / Diffie-Hellman backbone.
    ///
    /// v0 limits:
    ///   * `modulus > 0` — else ArgumentException
    ///   * `exp >= 0`    — negative exponent needs modular inverse
    ///                     (separate spec; throws ArgumentException)
    ///   * `exp == 0`    → returns 1 (mathematical convention; even
    ///                     `0^0 mod m == 1` follows it)
    ///   * `modulus == 1` → always 0 (anything mod 1 is 0)
    ///
    /// Out of v0 scope: Montgomery / Barrett reduction (constants
    /// higher than ideal; correctness comes first).
    internal static BigInt ModPow(BigInt self, BigInt exp, BigInt modulus) {
        if (modulus._sign <= 0) {
            throw new ArgumentException("BigInt.ModPow: modulus must be > 0");
        }
        // add-bigint-modpow-negexp (2026-05-25): route negative exponent
        // through ModInverse (`a^(-n) mod m == (a^-1 mod m)^n mod m`).
        // Requires gcd(this, modulus) == 1 — ModInverse handles the check.
        if (exp._sign < 0) {
            BigInt inv = BigIntModular.ModInverse(self, modulus);
            BigInt absExp = exp.Abs();
            return inv.ModPow(absExp, modulus);
        }
        if (modulus.IsOne()) return BigInt.Zero;
        if (exp.IsZero())    return BigInt.One;
        // add-bigint-modpow-montgomery (2026-05-28): for odd modulus we
        // route through Montgomery REDC — replaces each per-step divmod
        // (O(n*m) limb ops) with a single multi-limb add-and-shift
        // reduction (O(n) limb ops). Setup cost is one Mod for R^2 mod n
        // plus a single-limb modular inverse, amortised over typically
        // 2*bitLength(exp) modular multiplications — net 2-3× speedup
        // on the cryptographic-size moduli (RSA, X25519, Ed25519, ECDSA)
        // that dominate ModPow callers.
        //
        // Even modulus keeps the legacy square-and-multiply path because
        // Montgomery requires gcd(R, n) = 1 (n must be odd for R = 2^k).
        if (modulus._mag.Length > 0 && (modulus._mag[0] & 1) == 1) {
            return BigIntModular._modPowMontgomery(self, exp, modulus);
        }
        // Reduce base into [0, modulus). Mod follows dividend sign in
        // BigInt; for negative `this` the magnitude reduces fine and
        // (result * b) wraps mod modulus correctly.
        BigInt b      = self.Mod(modulus);
        if (b._sign < 0) b = b.Add(modulus);
        BigInt result = BigInt.One;
        BigInt e      = exp;
        while (!e.IsZero()) {
            if (e.TestBit(0)) {
                BigInt prod = result.Multiply(b);
                result = prod.Mod(modulus);
            }
            e = e.ShiftRight(1);
            if (!e.IsZero()) {
                BigInt sq = b.Multiply(b);
                b = sq.Mod(modulus);
            }
        }
        return result;
    }

    internal static BigInt _modPowMontgomery(BigInt base_, BigInt exp, BigInt modulus) {
        int[] n = modulus._mag;
        int k = n.Length;
        // n' = -n[0]^(-1) mod 2^31. n must be odd (caller guaranteed).
        int nPrime = BigIntModular._montNPrime(n[0]);
        // R^2 mod n via standard ops (one-time setup).
        BigInt R2 = BigInt.One.ShiftLeft(31 * 2 * k).Mod(modulus);
        // Convert base into Montgomery form. Reduce first so |base| < n.
        BigInt b = base_.Mod(modulus);
        if (b._sign < 0) b = b.Add(modulus);
        int[] bMont = BigIntModular._montMul(b._mag, R2._mag, n, nPrime, k);
        // result starts at R mod n (i.e. 1 in Montgomery form).
        int[] resultMont = BigIntModular._montMul(BigInt._oneMag(), R2._mag, n, nPrime, k);
        BigInt e = exp;
        while (!e.IsZero()) {
            if (e.TestBit(0)) {
                resultMont = BigIntModular._montMul(resultMont, bMont, n, nPrime, k);
            }
            e = e.ShiftRight(1);
            if (!e.IsZero()) {
                bMont = BigIntModular._montMul(bMont, bMont, n, nPrime, k);
            }
        }
        // Convert out: MontMul(resultMont, 1).
        int[] out_ = BigIntModular._montMul(resultMont, BigInt._oneMag(), n, nPrime, k);
        return BigInt._fromMagSign(out_, 1);
    }

    /// Montgomery multiplication: (a * b) * R^(-1) mod n. Returns k-limb
    /// magnitude (possibly trimmed if leading zeros). Both `a` and `b`
    /// must already be ≤ n in magnitude (Montgomery-form inputs).
    internal static int[] _montMul(int[] a, int[] b, int[] n, int nPrime, int k) {
        int[] t = BigInt._magMul(a, b);   // length ≤ 2k
        return BigIntModular._montRedc(t, n, nPrime, k);
    }

    /// Montgomery REDC: given T < n*R, compute T * R^(-1) mod n.
    /// Implementation per Handbook of Applied Cryptography §14.32 (CIOS
    /// inverse — single-pass loop over k limb positions).
    internal static int[] _montRedc(int[] t, int[] n, int nPrime, int k) {
        // Working buffer of size 2k+1 (room for carry into top limb).
        int sz = 2 * k + 1;
        int[] T = new int[sz];
        int i = 0;
        int copyN = t.Length;
        if (copyN > sz) copyN = sz;
        while (i < copyN) { T[i] = t[i]; i = i + 1; }
        long baseM1 = BigInt.BASE - 1L;   // 0x7FFFFFFF mask
        // For each lower limb position j in [0, k), zero it out by adding
        // m*n shifted by j positions, where m = T[j]*nPrime mod base.
        int j = 0;
        while (j < k) {
            long mLong = ((long)T[j] * (long)nPrime) & baseM1;
            // T += m * n * base^j
            long carry = 0L;
            int ii = 0;
            while (ii < k) {
                long sum = (long)T[j + ii] + mLong * ((long)n[ii] & baseM1) + carry;
                T[j + ii] = (int)(sum & baseM1);
                carry = (sum >> 31) & baseM1;
                // Note: sum can be up to (2^31-1) + (2^31-1)*(2^31-1) + (2^31-1)
                //     < 2^62. Fits in long. carry < 2^31 always.
                ii = ii + 1;
            }
            // Propagate carry into upper limbs.
            int p = j + k;
            while (carry > 0L && p < sz) {
                long sum = (long)T[p] + carry;
                T[p] = (int)(sum & baseM1);
                carry = (sum >> 31) & baseM1;
                p = p + 1;
            }
            j = j + 1;
        }
        // Shift right by k limbs to get U = T / R.
        int[] u = new int[k + 1];
        int q = 0;
        while (q < k + 1) {
            u[q] = T[k + q];
            q = q + 1;
        }
        // If U >= n, subtract n once (single conditional final step).
        bool uGe = false;
        if (u[k] > 0) {
            uGe = true;
        } else {
            // Compare u[0..k-1] vs n[0..k-1] from top down. Use a `decided`
            // flag to distinguish "broke out on differing limb" (uGe is
            // whatever the comparison said) from "all limbs equal" (which
            // also means U >= n — exact equality still needs the subtract
            // to canonicalise the representation).
            bool decided = false;
            int s = k - 1;
            while (s >= 0 && !decided) {
                int aLimb = (int)((long)u[s] & baseM1);
                int bLimb = (int)((long)n[s] & baseM1);
                if (aLimb != bLimb) {
                    uGe = aLimb > bLimb;
                    decided = true;
                }
                s = s - 1;
            }
            if (!decided) { uGe = true; }
        }
        if (uGe) {
            long borrow = 0L;
            int x = 0;
            while (x < k) {
                long diff = ((long)u[x] & baseM1) - ((long)n[x] & baseM1) - borrow;
                if (diff < 0L) {
                    diff = diff + BigInt.BASE;
                    borrow = 1L;
                } else {
                    borrow = 0L;
                }
                u[x] = (int)diff;
                x = x + 1;
            }
            // u[k] absorbs final borrow (was 0 or 1 from "u[k] > 0" branch).
            u[k] = u[k] - (int)borrow;
        }
        // Trim trailing zeros (u is k+1 limbs; top often 0).
        return BigInt._trim(u);
    }

    /// Compute n' such that n * n' ≡ -1 (mod 2^31). Requires n0 odd.
    /// Newton's iteration: x_{i+1} = x_i * (2 - n0 * x_i) (mod 2^31)
    /// — bit-precision doubles per step, so 5 iterations suffice for 31 bits.
    internal static int _montNPrime(int n0) {
        long n = (long)n0 & 0x7FFFFFFFL;
        long x = 1L;
        int it = 0;
        while (it < 5) {
            long nx = (n * x) & 0x7FFFFFFFL;
            long two_minus = (2L - nx) & 0x7FFFFFFFL;
            x = (x * two_minus) & 0x7FFFFFFFL;
            it = it + 1;
        }
        // n' = -n^(-1) mod 2^31
        long nPrime = (BigInt.BASE - x) & 0x7FFFFFFFL;
        return (int)nPrime;
    }

    /// Modular multiplicative inverse: returns `x` in `[0, modulus)` such
    /// that `(this * x) mod modulus == 1`. Computed via iterative extended
    /// Euclidean algorithm.
    ///
    /// Throws `ArgumentException` if:
    ///   * `modulus <= 1` — `mod 1` collapses every value to 0 (no
    ///     invertible elements); `modulus <= 0` is undefined
    ///   * `gcd(this, modulus) != 1` — no inverse exists (includes the
    ///     `this == 0` case since `gcd(0, m) == m != 1`)
    ///
    /// Negative `this` is normalised via `this.Mod(modulus)` to `[0, m)`
    /// before the algorithm runs; result is always non-negative.
    ///
    /// Use cases: ModPow with negative exponent (via `(a^-1)^|e| mod m`);
    /// RSA private-key derivation (`d = e^-1 mod φ(n)`); Bezout coefficients.
    internal static BigInt ModInverse(BigInt self, BigInt modulus) {
        if (modulus._sign <= 0 || modulus.IsOne()) {
            throw new ArgumentException("BigInt.ModInverse: modulus must be > 1");
        }
        // Normalise `this` into [0, modulus). Mod follows dividend sign,
        // so add modulus when negative.
        BigInt a = self.Mod(modulus);
        if (a._sign < 0) a = a.Add(modulus);
        if (a.IsZero()) {
            throw new ArgumentException("BigInt.ModInverse: gcd(0, m) != 1 — inverse does not exist");
        }
        // Iterative extended Euclidean.
        // Invariant: g0 = old_g, g1 = current_g; x0, x1 are coefficients such
        // that x_k * (this_normalised) ≡ g_k (mod modulus).
        BigInt g0 = modulus;
        BigInt g1 = a;
        BigInt x0 = BigInt.Zero;
        BigInt x1 = BigInt.One;
        while (!g1.IsZero()) {
            BigInt q   = g0.Divide(g1);
            BigInt qg1 = q.Multiply(g1);
            BigInt g2  = g0.Subtract(qg1);
            BigInt qx1 = q.Multiply(x1);
            BigInt x2  = x0.Subtract(qx1);
            g0 = g1;
            g1 = g2;
            x0 = x1;
            x1 = x2;
        }
        if (!g0.IsOne()) {
            throw new ArgumentException("BigInt.ModInverse: gcd(self, modulus) != 1 — inverse does not exist");
        }
        // x0 may be negative; normalise to [0, modulus).
        BigInt r = x0.Mod(modulus);
        if (r._sign < 0) r = r.Add(modulus);
        return r;
    }
}
