// z42.collections local test — Stack<T> shared IBasicCollection contract.
namespace Z42CollectionsTests;

using Std;
using Std.Test;
using Std.Test.Contracts;
using Std.Collections;

// add-collection-contract-phase2 (2026-06-11): drive the shared collection
// contract (empty → AddOne ×3 distinct → Count==3 → Clear → empty) against a
// Stack<int>. Phase 1 wired LinkedList/SortedSet/PriorityQueue; this closes
// Stack's coverage in one line.
[Test]
void test_stack_basic_collection_contract() {
    BasicCollectionContract.Run("Stack<int>", new Stack<int>());
}

// fix-queue-stack-empty-guard (2026-07-12): Pop/Peek on an empty stack used
// to drive count to -1 and index items[-1] (trap / garbage). They now throw,
// matching same-package PriorityQueue/LinkedList.
[Test]
void test_stack_pop_empty_throws() {
    var s = new Stack<int>();
    bool caught = false;
    try {
        s.Pop();
    } catch (Exception e) {
        caught = true;
    }
    Assert.True(caught);
    Assert.Equal(0, s.Count());   // count must stay 0, not go negative
}

[Test]
void test_stack_peek_empty_throws() {
    var s = new Stack<int>();
    bool caught = false;
    try {
        s.Peek();
    } catch (Exception e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_stack_drain_then_pop_throws() {
    var s = new Stack<int>();
    s.Push(1);
    s.Push(2);
    Assert.Equal(2, s.Pop());
    Assert.Equal(1, s.Pop());
    Assert.Equal(0, s.Count());
    bool caught = false;
    try {
        s.Pop();   // one past empty — must throw, not underflow
    } catch (Exception e) {
        caught = true;
    }
    Assert.True(caught);
    Assert.Equal(0, s.Count());
}

// add-collection-toarray (2026-07-12, review §2.6): non-destructive top-first snapshot.
[Test]
void test_stack_toarray_top_first() {
    var s = new Stack<int>();
    s.Push(1); s.Push(2); s.Push(3);
    int[] a = s.ToArray();
    Assert.Equal(3, a.Length);
    Assert.Equal(3, a[0]);               // top of stack first
    Assert.Equal(2, a[1]);
    Assert.Equal(1, a[2]);
    Assert.Equal(3, s.Count());          // non-destructive
}
