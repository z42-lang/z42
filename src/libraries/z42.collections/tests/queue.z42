// z42.collections local test — Queue<T> shared IBasicCollection contract.
namespace Z42CollectionsTests;

using Std;
using Std.Test;
using Std.Test.Contracts;
using Std.Collections;

// add-collection-contract-phase2 (2026-06-11): drive the shared collection
// contract (empty → AddOne ×3 distinct → Count==3 → Clear → empty) against a
// Queue<int>. Phase 1 wired LinkedList/SortedSet/PriorityQueue; this closes
// Queue's coverage in one line.
[Test]
void test_queue_basic_collection_contract() {
    BasicCollectionContract.Run("Queue<int>", new Queue<int>());
}

// fix-queue-stack-empty-guard (2026-07-12): Dequeue/Peek on an empty queue
// used to read a stale slot and drive count to -1 (silent state corruption).
// They now throw, matching same-package PriorityQueue/LinkedList.
[Test]
void test_queue_dequeue_empty_throws() {
    var q = new Queue<int>();
    bool caught = false;
    try {
        q.Dequeue();
    } catch (Exception e) {
        caught = true;
    }
    Assert.True(caught);
    Assert.Equal(0, q.Count());   // count must stay 0, not go negative
}

[Test]
void test_queue_peek_empty_throws() {
    var q = new Queue<int>();
    bool caught = false;
    try {
        q.Peek();
    } catch (Exception e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_queue_drain_then_dequeue_throws() {
    var q = new Queue<int>();
    q.Enqueue(1);
    q.Enqueue(2);
    Assert.Equal(1, q.Dequeue());
    Assert.Equal(2, q.Dequeue());
    Assert.Equal(0, q.Count());
    bool caught = false;
    try {
        q.Dequeue();   // one past empty — must throw, not underflow
    } catch (Exception e) {
        caught = true;
    }
    Assert.True(caught);
    Assert.Equal(0, q.Count());
}

// add-collection-toarray (2026-07-12, review §2.6): non-destructive FIFO snapshot.
[Test]
void test_queue_toarray_fifo() {
    var q = new Queue<int>();
    q.Enqueue(1); q.Enqueue(2); q.Enqueue(3);
    int[] a = q.ToArray();
    Assert.Equal(3, a.Length);
    Assert.Equal(1, a[0]);
    Assert.Equal(2, a[1]);
    Assert.Equal(3, a[2]);
    Assert.Equal(3, q.Count());          // non-destructive
    q.Dequeue();                          // head moves; ToArray tracks it
    int[] b = q.ToArray();
    Assert.Equal(2, b.Length);
    Assert.Equal(2, b[0]);
    Assert.Equal(3, b[1]);
}
