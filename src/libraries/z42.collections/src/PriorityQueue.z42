namespace Std.Collections;


/// 最小堆优先队列：O(log n) 的 Enqueue / Dequeue，O(1) 的 Peek。
/// where T: IComparable —— CompareTo 小的先出队。
///
/// 只有最小堆形态；要最大堆请把排序键取负，或用反向 CompareTo 的包装类型。
/// 单类型形参：优先级就是元素本身，没有独立的 TPriority。
public class PriorityQueue<T> : IBasicCollection<T> where T: IComparable {
    T[] items;
    int count;
    int capacity;

    /// 创建空优先队列。
    public PriorityQueue() {
        this.capacity = 4;
        this.items = new T[4];
        this.count = 0;
    }

    /// 返回元素个数（方法，不是字段）。
    public int Count() { return this.count; }
    /// 是否为空。
    public bool IsEmpty() { return this.count == 0; }

    /// 入堆，O(log n)。
    public void Enqueue(T item) {
        if (this.count == this.capacity) this.Grow();
        this.items[this.count] = item;
        this.count = this.count + 1;
        this.SiftUp(this.count - 1);
    }

    /// IBasicCollection 契约的统一插入入口，委托给 Enqueue。
    public void AddOne(T item) { this.Enqueue(item); }

    /// 取出并返回最小元素；空队列抛 Exception。O(log n)。
    public T Dequeue() {
        if (this.count == 0) {
            throw new Exception("PriorityQueue.Dequeue: queue is empty");
        }
        T root = this.items[0];
        this.count = this.count - 1;
        if (this.count > 0) {
            this.items[0] = this.items[this.count];
            this.SiftDown(0);
        }
        return root;
    }

    /// 只看最小元素不取出；空队列抛 Exception。O(1)。
    public T Peek() {
        if (this.count == 0) {
            throw new Exception("PriorityQueue.Peek: queue is empty");
        }
        return this.items[0];
    }

    /// 清空所有元素，保留已分配容量。
    public void Clear() { this.count = 0; }

    // ── 内部实现 ──────────────────────────────────────────────────────────

    void SiftUp(int idx) {
        int i = idx;
        while (i > 0) {
            int parent = (i - 1) / 2;
            if (this.items[i].CompareTo(this.items[parent]) >= 0) {
                return;
            }
            T tmp = this.items[i];
            this.items[i] = this.items[parent];
            this.items[parent] = tmp;
            i = parent;
        }
    }

    void SiftDown(int idx) {
        int n = this.count;
        int i = idx;
        while (true) {
            int left  = 2 * i + 1;
            int right = 2 * i + 2;
            int smallest = i;
            if (left  < n && this.items[left].CompareTo(this.items[smallest])  < 0) {
                smallest = left;
            }
            if (right < n && this.items[right].CompareTo(this.items[smallest]) < 0) {
                smallest = right;
            }
            if (smallest == i) return;
            T tmp = this.items[i];
            this.items[i] = this.items[smallest];
            this.items[smallest] = tmp;
            i = smallest;
        }
    }

    void Grow() {
        int newCap = this.capacity * 2;
        T[] bigger = new T[newCap];
        Array.Copy(this.items, bigger, this.count);
        this.items = bigger;
        this.capacity = newCap;
    }
}
