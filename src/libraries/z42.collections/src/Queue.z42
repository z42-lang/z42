namespace Std.Collections;


/// 先进先出队列，摊还 O(1) 的 Enqueue / Dequeue。对 T 无约束。
public class Queue<T> : IBasicCollection<T> {
    // 环形缓冲区基于 T[]，摊还 O(1) Enqueue/Dequeue。
    T[] items;
    int head;
    int tail;
    int count;
    int capacity;

    /// 创建空队列。
    public Queue() {
        this.capacity = 4;
        this.items = new T[4];
        this.head = 0;
        this.tail = 0;
        this.count = 0;
    }

    /// 返回元素个数（方法，不是字段）。
    public int Count() { return this.count; }
    /// 是否为空。
    public bool IsEmpty() { return this.count == 0; }

    /// 入队（队尾）。
    public void Enqueue(T item) {
        if (this.count == this.capacity) this.Grow();
        this.items[this.tail] = item;
        this.tail = (this.tail + 1) % this.capacity;
        this.count = this.count + 1;
    }

    /// IBasicCollection 契约的统一插入入口，委托给 Enqueue。
    public void AddOne(T item) { this.Enqueue(item); }

    /// 出队并返回队首；空队列抛 Exception。
    public T Dequeue() {
        if (this.count == 0) {
            throw new Exception("Queue.Dequeue: queue is empty");
        }
        T item = this.items[this.head];
        this.head = (this.head + 1) % this.capacity;
        this.count = this.count - 1;
        return item;
    }

    /// 只看队首；空队列抛 Exception。
    public T Peek() {
        if (this.count == 0) {
            throw new Exception("Queue.Peek: queue is empty");
        }
        return this.items[this.head];
    }

    /// 清空（幂等）。
    public void Clear() {
        this.head = 0;
        this.tail = 0;
        this.count = 0;
    }

    /// 快照数组，队首在前（FIFO 顺序）；不消耗队列。
    public T[] ToArray() {
        T[] result = new T[this.count];
        int src = this.head;
        int i = 0;
        while (i < this.count) {
            result[i] = this.items[src];
            src = (src + 1) % this.capacity;
            i = i + 1;
        }
        return result;
    }

    /// 扩容容量（容量管理入口，正常使用无需调用）。
    public void Grow() {
        int newCap = this.capacity * 2;
        T[] bigger = new T[newCap];
        int i = 0;
        int src = this.head;
        while (i < this.count) {
            bigger[i] = this.items[src];
            src = (src + 1) % this.capacity;
            i = i + 1;
        }
        this.items = bigger;
        this.capacity = newCap;
        this.head = 0;
        this.tail = this.count;
    }
}
