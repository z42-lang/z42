namespace Std.Collections;

/// 双向链表节点，持有可读可写的 Value 字段。
public class LinkedListNode<T> {
    /// 节点值（可读可写字段）。
    public T Value;

    // 链接由 LinkedList<T> 在接合时维护；外部调用 SetNext / SetPrevious
    // 会破坏链表的 Count 与端点不变式（按约定视为包内方法）。
    LinkedListNode<T> next;
    LinkedListNode<T> prev;

    /// 创建持有 value 的节点。
    public LinkedListNode(T value) {
        this.Value = value;
        this.next = null;
        this.prev = null;
    }

    /// 后继节点；尾节点返回 null。
    public LinkedListNode<T>? Next()     { return this.next; }
    /// 前驱节点；头节点返回 null。
    public LinkedListNode<T>? Previous() { return this.prev; }

    /// 设置后继节点（通常由 LinkedList<T> 维护）。
    public void SetNext(LinkedListNode<T> n)     { this.next = n; }
    /// 设置前驱节点（通常由 LinkedList<T> 维护）。
    public void SetPrevious(LinkedListNode<T> p) { this.prev = p; }
}

/// 双向链表：O(1) 的两端插入/删除与端点访问，O(n) 的按值查找。
/// where T: IEquatable（Find / Contains / Remove 需要比较相等）。
public class LinkedList<T> : IBasicCollection<T> where T: IEquatable {
    LinkedListNode<T> head;
    LinkedListNode<T> tail;
    int count;

    /// 创建空链表。
    public LinkedList() {
        this.head = null;
        this.tail = null;
        this.count = 0;
    }

    /// 返回元素个数（方法，不是字段）。
    public int Count() { return this.count; }
    /// 是否为空。
    public bool IsEmpty() { return this.count == 0; }

    /// 头节点；空链表返回 null（不抛）。
    public LinkedListNode<T>? First() { return this.head; }
    /// 尾节点；空链表返回 null（不抛）。
    public LinkedListNode<T>? Last()  { return this.tail; }

    /// 头 → 尾顺序的快照数组；不改动链表。
    public T[] ToArray() {
        T[] result = new T[this.count];
        var node = this.head;
        int i = 0;
        while (node != null) {
            result[i] = node.Value;
            node = node.Next();
            i = i + 1;
        }
        return result;
    }

    // ── 插入 ────────────────────────────────────────────────────────────

    /// 头插，返回新建的节点。
    public LinkedListNode<T> AddFirst(T value) {
        var node = new LinkedListNode<T>(value);
        if (this.head == null) {
            // 空链表 —— 节点既是头也是尾。
            this.head = node;
            this.tail = node;
        } else {
            node.SetNext(this.head);
            this.head.SetPrevious(node);
            this.head = node;
        }
        this.count = this.count + 1;
        return node;
    }

    /// 尾插，返回新建的节点。
    public LinkedListNode<T> AddLast(T value) {
        var node = new LinkedListNode<T>(value);
        if (this.tail == null) {
            this.head = node;
            this.tail = node;
        } else {
            node.SetPrevious(this.tail);
            this.tail.SetNext(node);
            this.tail = node;
        }
        this.count = this.count + 1;
        return node;
    }

    /// IBasicCollection 契约的统一插入入口，委托给 AddLast。
    public void AddOne(T item) { this.AddLast(item); }

    // ── 删除 ────────────────────────────────────────────────────────────

    /// 摘掉头节点并返回其 Value；空链表抛 Exception。
    public T RemoveFirst() {
        var node = this.head;
        if (node == null) {
            throw new Exception("LinkedList is empty");
        }
        var v = node.Value;
        this.head = node.Next();
        if (this.head == null) {
            this.tail = null;
        } else {
            this.head.SetPrevious(null);
        }
        this.count = this.count - 1;
        return v;
    }

    /// 摘掉尾节点并返回其 Value；空链表抛 Exception。
    public T RemoveLast() {
        var node = this.tail;
        if (node == null) {
            throw new Exception("LinkedList is empty");
        }
        var v = node.Value;
        this.tail = node.Previous();
        if (this.tail == null) {
            this.head = null;
        } else {
            this.tail.SetNext(null);
        }
        this.count = this.count - 1;
        return v;
    }

    /// 删除第一个值相等的节点；删掉返回 true，没找到返回 false。
    public bool Remove(T value) {
        var cur = this.head;
        while (cur != null) {
            if (cur.Value.Equals(value)) {
                LinkedListNode<T> p = cur.Previous();
                LinkedListNode<T> n = cur.Next();
                if (p == null) {
                    this.head = n;
                } else {
                    p.SetNext(n);
                }
                if (n == null) {
                    this.tail = p;
                } else {
                    n.SetPrevious(p);
                }
                this.count = this.count - 1;
                return true;
            }
            cur = cur.Next();
        }
        return false;
    }

    /// 清空（幂等）。
    public void Clear() {
        this.head = null;
        this.tail = null;
        this.count = 0;
    }

    // ── 查找 ────────────────────────────────────────────────────────────

    /// 是否存在值相等的节点，等价 Find(value) != null。
    public bool Contains(T value) { return this.Find(value) != null; }

    /// 第一个值相等的节点；没找到返回 null。
    public LinkedListNode<T>? Find(T value) {
        var cur = this.head;
        while (cur != null) {
            if (cur.Value.Equals(value)) {
                return cur;
            }
            cur = cur.Next();
        }
        return null;
    }

}
