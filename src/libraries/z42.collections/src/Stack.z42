namespace Std.Collections;

using Std;

// Generic LIFO stack (L3-G4d — stdlib generic export).
// Backing T[] with amortised O(1) Push/Pop and exponential growth.
// add-collection-contract-phase1 (2026-06-03): implements IBasicCollection<T>
// to opt into Std.Test.Contracts.BasicCollectionContract coverage.
public class Stack<T> : IBasicCollection<T> {
    T[] items;
    int count;
    int capacity;

    public Stack() {
        this.capacity = 4;
        this.items = new T[4];
        this.count = 0;
    }

    public int Count() { return this.count; }
    public bool IsEmpty() { return this.count == 0; }

    public void Push(T item) {
        if (this.count == this.capacity) this.Grow();
        this.items[this.count] = item;
        this.count = this.count + 1;
    }

    // IBasicCollection contract entry (add-collection-contract-phase2): LIFO add.
    public void AddOne(T item) { this.Push(item); }

    public T Pop() {
        if (this.count == 0) {
            throw new Exception("Stack.Pop: stack is empty");
        }
        this.count = this.count - 1;
        return this.items[this.count];
    }

    public T Peek() {
        if (this.count == 0) {
            throw new Exception("Stack.Peek: stack is empty");
        }
        return this.items[this.count - 1];
    }

    public void Clear() {
        this.count = 0;
    }

    // add-collection-toarray (review §2.6): snapshot with the top of the stack
    // first (LIFO order, matching C# Stack<T>.ToArray). Does not modify the stack.
    public T[] ToArray() {
        T[] result = new T[this.count];
        int i = 0;
        while (i < this.count) {
            result[i] = this.items[this.count - 1 - i];
            i = i + 1;
        }
        return result;
    }

    public void Grow() {
        int newCap = this.capacity * 2;
        T[] bigger = new T[newCap];
        Array.Copy(this.items, bigger, this.count);
        this.items = bigger;
        this.capacity = newCap;
    }
}
