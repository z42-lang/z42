// 已知诊断错误码。镜像 C# `static class DiagnosticCodes`（const string → static string）。
//   E01xx Lexer / E02xx Parser / E03xx Features / E04xx TypeCheck / E05xx IrGen /
//   E06xx Package·import / E09xx Native·Test / E10xx 调用实参绑定。
namespace Z42.Core;

public static class DiagnosticCodes {
    // Lexer
    public static string UnterminatedString = "E0101";
    public static string InvalidEscape       = "E0102";
    public static string InvalidNumericLit   = "E0103";

    // Parser
    public static string UnexpectedToken     = "E0201";
    public static string ExpectedToken       = "E0202";
    public static string UnexpectedEof       = "E0203";
    public static string MissingReturnType   = "E0204";
    public static string AmbiguousExpression = "E0205";
    public static string ParamsNotLast          = "E0206";  // params 非末参（add-params-varargs）
    public static string ParamsNotArray         = "E0207";  // params 类型非 T[]
    public static string ParamsModifierConflict = "E0208";  // params 与 ref/out/默认值同现
    // 只能出现在文件顶部的声明（using / global using / namespace）出现在语句位置。
    // 语言本就不接受，但此前只是一路级联出 4 条无关错误（"unexpected token in expression"
    // / "expected ';'" / 两条 "undefined"），没有一条说得出真正原因。
    public static string DeclarationInStatement = "E0209";

    // Feature gates
    public static string FeatureDisabled     = "E0301";

    // Type checker
    public static string UndefinedSymbol       = "E0401";
    public static string TypeMismatch          = "E0402";
    public static string MissingReturn         = "E0403";
    public static string AccessViolation       = "E0404";   // 成员访问（enforce-access-control）+ 类型引用（enforce-class-access：private/protected 嵌套类；跨包 internal 类为 follow-up）——镜像 C# 单一 CS0122
    public static string InvalidModifier       = "E0405";
    public static string IntLiteralOutOfRange  = "E0406";
    public static string UninitializedVariable = "E0407";
    public static string DuplicateDeclaration  = "E0408";
    public static string VoidAssignment        = "E0409";
    public static string InvalidBreakContinue  = "E0410";
    public static string InvalidInheritance    = "E0411";
    public static string InterfaceMismatch     = "E0412";
    public static string InvalidImpl           = "E0413";
    public static string EventFieldExternalAccess = "E0414";
    public static string ReadonlyAssignment       = "E0415";   // readonly 字段不可在构造函数外赋值（add-readonly-fields-opt）
    public static string ConstNeedsInit           = "E0416";   // const 声明必须有初始化器（add-const-keyword）
    public static string ConstNotConstantInit     = "E0417";   // const 初始化器必须是编译期常量（add-const-keyword）
    public static string ConstAssignment          = "E0418";   // 不可对 const 赋值（add-const-keyword）
    public static string ConstExprBadRef          = "E0419";   // 常量表达式只能引用已定义的 const（add-const-keyword）
    public static string InvalidCatchType         = "E0420";
    public static string InvalidDefaultType       = "E0421";
    public static string GenericFuncConstraintViolation = "E0422";
    public static string AmbiguousOverload        = "E0425";   // 重载歧义（add-type-based-overloads）
    public static string CtorArgMismatch          = "E0426";   // new C(args) 实参与本地 ctor 形参不匹配（防静默按位截断）
    public static string InvalidFuncConstraint    = "E0423";
    public static string IllegalCast              = "E0424";
    // impl-sealed-semantics（E0416–E0419 已被 add-const-keyword 占用 → sealed 用 E0427–E0429）
    public static string SealedInheritance        = "E0427";   // 不能继承 sealed 类
    public static string SealedOverride           = "E0428";   // 不能 override 一个 sealed（override）方法
    public static string SealedMethodNoBase       = "E0429";   // 方法级 sealed 必须 override 基类某 virtual 方法
    // partial types (add-partial-types)
    public static string PartialModifierMissing   = "E0430";   // 同名类型某声明未标 partial（须全部标）
    public static string PartialKindMismatch      = "E0431";   // 碎片 Kind（class/struct/interface）不一致
    public static string PartialBaseConflict      = "E0432";   // 基类由多个碎片声明（至多一个）
    public static string PartialDuplicateMember   = "E0433";   // 碎片间重复成员（同名字段 / 同签名方法）
    public static string PartialMethodSigMismatch = "E0434";   // partial method 实现无匹配声明 / 声明与实现签名不一致
    public static string PartialNestedUnsupported = "E0435";   // 嵌套类型自身 partial（v1 不支持，design D9）
    public static string MissingUsing = "E0436";               // 用了某依赖 ns 却未在本文件 using（file-scoped usings）
    public static string TargetTypedNewNeedsType = "E0437";    // target-typed `new()` 目标类型不可推断 / 重载歧义（add-target-typed-new）
    // E0438 预留：值 struct 自引用（struct 直接/间接以自身为值字段）诊断——add-struct-nested-fields 的
    // follow-up（当前由 StructLayout.IsBlobStruct 的 Size==0 兜底防崩，自引用 struct 退化为引用语义不报错）。
    public static string ImplicitNarrowingConversion = "E0439";  // 存在显式转换却用于隐式上下文（窄化/有损）——需 (T) cast（tighten-implicit-conversions）
    public static string ConversionOperatorConflict  = "E0440";  // 转换运算符声明冲突：同 (源→目标) 重复 / implicit+explicit 同对（add-user-conversions ②，声明期检测）
    public static string InconsistentAccessibility   = "E0441";  // 不一致可访问性：更高可见性的成员/类型签名暴露了更低可见性的类型（C# CS0050 族；complete-class-access-control ②）
    public static string TopLevelAccessModifier      = "E0442";  // 顶层声明（class/interface/struct/record/enum/函数）标 private/protected——模块作用域无意义（complete-class-access-control ③）
    public static string UndefinedType               = "E0443";  // 类型注解引用了未定义的类型名（对标 C# CS0246；fix-undefined-type-diagnostic）
    public static string AttributeSuffixRequired     = "E0444";  // `: Attribute` 类名必须以 `Attribute` 结尾（D8 后缀约定；attribute-handler-registry PR2）
    public static string AnalyzerSuffixRequired      = "E0445";  // `: Analyzer` 类名必须以 `Analyzer` 结尾（D8 后缀约定；attribute-handler-registry PR3a）
    public static string GenericMethodArity          = "E0446";  // 泛型方法调用 `Foo<...>()` 的类型实参数与方法声明的类型形参数不符（add-generic-methods）
    public static string GeneratorSuffixRequired     = "E0447";  // `: Generator` 类名必须以 `Generator` 结尾（D8 后缀约定；attribute-handler-registry PR4a）
    public static string GeneratorTargetOutOfScope   = "E0448";  // generator 只能改它 trigger 命中的声明（Augment/Replace 越界；attribute-handler-registry PR4a 护栏）
    public static string GeneratorDependencyCycle    = "E0449";  // generator 的 consumes/produces 依赖成环——拓扑分层无法定序（attribute-handler-registry PR4e 有界多轮护栏）。PR4e-wire 起 GeneratorDriver 已由字面量切回常量引用（E0449 随 nightly 载入 z42c.core）。
    public static string CallerMacroInvalid          = "E0450";  // 编译期宏 `name!()` 误用（attribute-handler-registry PR6b）：未知宏名 / 参数类型不符 / 出现在非参数默认值位。**语义层用字面量 "E0450" 发码**（不引用本常量），避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache（同 PR4e E0449 手法，待随 nightly 载入后可切常量）。
    public static string PropertyNoSetter            = "E0452";  // 给没有 setter 的属性赋值：`X { get; }` 只读自动属性仅可在构造函数内经 `this` 写（对标 C# CS0200），`X { get {..} }` 计算属性任何位置都不可赋值（fix-autoprop-getonly-backing-write）。**语义层用字面量 "E0452" 发码**（同 E0449/E0450/E0451 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string AssocTypeBinding            = "E0453";  // 关联类型（add-associated-types PR-3）：接口里 `type Item;` 未被实现方绑定 / 实现方写了不带绑定的 `type Item;` / 接口自己写了绑定 / `where T : IFoo<Zzz = int>` 里 Zzz 不是该接口的关联类型 / 实参绑定与约束要求不符。**语义层用字面量 "E0453" 发码**（同 E0449/E0450/E0451/E0452 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string StaticClassInstanceMember   = "E0451";  // static 类含实例成员（方法/字段/属性/构造器）、声明基类、或实现接口——static 类只容纳静态成员（对标 C# CS0708/0710/0713/0714；fix-static-class-instance-members）。**语义层用字面量 "E0451" 发码**（同 E0449/E0450 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string SelfParamThroughInterface   = "E0454";  // 经**接口静态类型**调用形参位含 `Self` 的方法（`IEq a, b; a.Same(b)`）——`Self` 在形参位是**逆变**方向、没有唯一安全上界：接口只保证实参也实现了该接口，而实现方的签名要的是**它自己**，放行即运行期类型混淆（实测 `P.Same` 拿到 `Q` 后 `other.V` 读出 **null**、静默返回 false）。对标 Rust 的 object-safety（`Self` 在形参位 ⇒ 该方法不可经 `dyn Trait` 调用）；z42 的替代写法是型参：`bool f<T>(T a, T b) where T : IEq`，那条路 `Self ≡ T` 精确、且经 Part A 真校验。（bind-self-param-and-constraint-members Part B）**语义层用字面量 "E0454" 发码**（同 E0449–E0453 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string GenericTypeArgRequired      = "E0455";  // 省略尖括号调用一个**方法体真的消费型参**的泛型方法（体内有 `typeof(T)`/`new T()`/`default(T)`/`new T[n]`，或把 T 转发给嵌套泛型调用 `Bar<T>()`）。类型实参推断（add-generic-type-arg-inference 阶段 C）**刻意不回灌** `BoundCall.MethodTypeArgs`——回灌会把 opcode 从 `Op.Call` 换成 `Op.CallGeneric`、重排 zbc 串池、并关掉 `exec_call.rs` 的 native 快路径门，而全仓 112 处隐式泛型调用全是不消费型参的 `Array.Copy<T>` ⇒ 纯回归。代价是这类 callee 在运行期会读到**空**的 `frame.method_type_args`（静默错值，同 generic-new-array-value-type-null-tail）。本码把静默错值换成编译错误，修法就是显式写出 `<T>`。判定不到（导入方法无本地 Decl）→ 放行 = 改动前行为。**语义层用字面量 "E0455" 发码**（同 E0449–E0454 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string AmbiguousBareTypeName       = "E0456";  // 非限定短名同时匹配**多个可见命名空间**里的类型（`using A; using B;` 后裸写 `Foo`，A.Foo 与 B.Foo 都在）。此前 `SymbolTable.Classes` 按裸名 first/last-wins **静默择一**，选中哪一份取决于加载顺序 —— 实测三命名空间 fixture 里 `Helper.Who()` 无声地选了 B、零诊断。对标 C# CS0104。**当前命名空间里的那一份优先**（不算歧义），与 C# 一致；限定写法（`A.Foo`）永远不歧义。**语义层用字面量 "E0456" 发码**（同 E0449–E0455 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string FileScopedNamespaceMisplaced = "E0457";  // 一个文件里写了**多个**文件级 `namespace X;`，或把 `namespace` 写在类型/函数声明**之后**。z42 的编译单元只有一个命名空间（`CompilationUnit.Namespace` 是单值），而 parser 的 namespace 分支在顶层声明循环里、每命中一次就整个覆盖 `ns` ⇒ 此前**静默 last-wins**：声明在 `namespace First;` 底下的类被登记进最后那个 ns，连限定名都随之解析错（实测 `A.Helper.Who()` 打印的是 B 的实现）。这不是「少报一条诊断」，是**解析到错误的类型**。对齐 C# CS8907/CS8955。恢复策略保留**第一个** ns。块形式 `namespace X { }` z42 本就不支持（parse 错）。**语法层用字面量 "E0457" 发码**（同 E0449–E0456 手法，避 core→syntax 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string DuplicateTypeName = "E0458";  // 同一命名空间里重复声明同一个类型（同 ns、同名、同 arity，且并非全部 `partial`）。此前**静默 last-wins**：后声明的赢，前一个连同成员一起消失，单文件与跨 CU 两种形态都零诊断——跨 CU 形态在真实工程里更危险（两个文件各写一个 `class Config`，谁也不会注意到其中一个从来没生效过）。对齐 C# CS0101。🔴 判据是 **(ns, 名字, arity)** 三者都相同：裸名键在同短名跨 ns 时也会撞（那归 E0456 管），而 arity 预扫是 per-CU 的，跨 CU 的不同 arity 同名今天能编过、报成「重复定义」是错的（Deferred `arity-mangle-not-package-wide`）。**语义层用字面量 "E0458" 发码**（同 E0449–E0457 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache）。

    // IrGen
    public static string UnsupportedSyntax   = "E0501";

    // Package / import resolution
    public static string NamespaceCollision  = "E0601";
    public static string UnresolvedUsing     = "E0602";
    public static string ReservedNamespace            = "W0603";
    public static string CapturedValueSnapshotAssign  = "W0604";
    public static string ReservedNamespaceDeclaration = "E0605";

    // Internal compiler error
    public static string InternalCompilerError = "E0900";

    // Native / InternalCall
    public static string ExternRequiresNative     = "E0903";
    public static string NativeRequiresExtern     = "E0904";
    public static string NativeAttributeMalformed = "E0907";

    // Native interop — pinned block
    public static string PinnedNotPinnable = "E0908a";
    public static string PinnedControlFlow = "E0908b";

    // Native interop — manifest reader / synthesis
    public static string ManifestParseError              = "E0909";
    public static string NativeImportSynthesisFailure    = "E0916";

    // Test framework
    public static string TestSignatureInvalid          = "E0911";
    public static string BenchmarkSignatureInvalid     = "E0912";
    public static string ShouldThrowTypeInvalid        = "E0913";
    public static string SkipReasonMissing             = "E0914";
    public static string SetupTeardownSignatureInvalid = "E0915";
    public static string TimeoutValueInvalid           = "E0917";

    // E10xx: call-site argument binding
    public static string PositionalAfterNamed     = "E1001";
    public static string UnknownArgumentName      = "E1002";
    public static string DuplicateArgumentName    = "E1003";
    public static string ParameterDoublySpecified = "E1004";
    public static string MissingRequiredArgument  = "E1005";

    // E11xx: add-symbol-availability-macro —— `available!(X)` 专属。
    // ⚠️ 与 E0450 同款纪律：**语义层用字面量发码，不引用这两个常量** —— 新增 core→semantics
    // 跨成员符号会撞 F2 冷启动 stale-cache（见 CallerMacroInvalid 注 + PR4e E0449 手法）。
    // 待本 change 随 nightly 载入后可切常量引用。
    public static string AvailableAmbiguous   = "E1101";  // 目标解析到多个重载，无法唯一确定（v1 不支持签名消歧）
    public static string AvailableBadArgument = "E1102";  // 参数不是符号引用（字面量/任意表达式），或参数个数不为 1
}
