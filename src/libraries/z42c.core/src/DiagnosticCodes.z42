// 已知诊断错误码。镜像 C# `static class DiagnosticCodes`（const string → static string）。
//   E01xx Lexer / E02xx Parser / E03xx Features / E04xx TypeCheck / E05xx IrGen /
//   E06xx Package·import / E09xx Native·Test / E10xx 调用实参绑定。
namespace Z42.Core;

public static class DiagnosticCodes {
    // Lexer
    public static string UnterminatedString = "E0101";
    public static string InvalidEscape       = "E0102";
    public static string InvalidNumericLit   = "E0103";

    // Parser
    public static string UnexpectedToken     = "E0201";
    public static string ExpectedToken       = "E0202";
    public static string UnexpectedEof       = "E0203";
    public static string MissingReturnType   = "E0204";
    public static string AmbiguousExpression = "E0205";
    public static string ParamsNotLast          = "E0206";  // params 非末参（add-params-varargs）
    public static string ParamsNotArray         = "E0207";  // params 类型非 T[]
    public static string ParamsModifierConflict = "E0208";  // params 与 ref/out/默认值同现
    // 只能出现在文件顶部的声明（using / global using / namespace）出现在语句位置。
    // 语言本就不接受，但此前只是一路级联出 4 条无关错误（"unexpected token in expression"
    // / "expected ';'" / 两条 "undefined"），没有一条说得出真正原因。
    public static string DeclarationInStatement = "E0209";

    // Feature gates
    public static string FeatureDisabled     = "E0301";

    // Type checker
    public static string UndefinedSymbol       = "E0401";
    public static string TypeMismatch          = "E0402";
    public static string MissingReturn         = "E0403";
    public static string AccessViolation       = "E0404";   // 成员访问（enforce-access-control）+ 类型引用（enforce-class-access：private/protected 嵌套类；跨包 internal 类为 follow-up）——镜像 C# 单一 CS0122
    public static string InvalidModifier       = "E0405";
    public static string IntLiteralOutOfRange  = "E0406";
    public static string UninitializedVariable = "E0407";
    public static string DuplicateDeclaration  = "E0408";
    public static string VoidAssignment        = "E0409";
    public static string InvalidBreakContinue  = "E0410";
    public static string InvalidInheritance    = "E0411";
    public static string InterfaceMismatch     = "E0412";
    public static string InvalidImpl           = "E0413";
    public static string EventFieldExternalAccess = "E0414";
    public static string ReadonlyAssignment       = "E0415";   // readonly 字段不可在构造函数外赋值（add-readonly-fields-opt）
    public static string ConstNeedsInit           = "E0416";   // const 声明必须有初始化器（add-const-keyword）
    public static string ConstNotConstantInit     = "E0417";   // const 初始化器必须是编译期常量（add-const-keyword）
    public static string ConstAssignment          = "E0418";   // 不可对 const 赋值（add-const-keyword）
    public static string ConstExprBadRef          = "E0419";   // 常量表达式只能引用已定义的 const（add-const-keyword）
    public static string InvalidCatchType         = "E0420";
    public static string InvalidDefaultType       = "E0421";
    public static string GenericFuncConstraintViolation = "E0422";
    public static string AmbiguousOverload        = "E0425";   // 重载歧义（add-type-based-overloads）
    public static string CtorArgMismatch          = "E0426";   // new C(args) 实参与本地 ctor 形参不匹配（防静默按位截断）
    public static string InvalidFuncConstraint    = "E0423";
    public static string IllegalCast              = "E0424";
    // impl-sealed-semantics（E0416–E0419 已被 add-const-keyword 占用 → sealed 用 E0427–E0429）
    public static string SealedInheritance        = "E0427";   // 不能继承 sealed 类
    public static string SealedOverride           = "E0428";   // 不能 override 一个 sealed（override）方法
    public static string SealedMethodNoBase       = "E0429";   // 方法级 sealed 必须 override 基类某 virtual 方法
    // partial types (add-partial-types)
    public static string PartialModifierMissing   = "E0430";   // 同名类型某声明未标 partial（须全部标）
    public static string PartialKindMismatch      = "E0431";   // 碎片 Kind（class/struct/interface）不一致
    public static string PartialBaseConflict      = "E0432";   // 基类由多个碎片声明（至多一个）
    public static string PartialDuplicateMember   = "E0433";   // 碎片间重复成员（同名字段 / 同签名方法）
    public static string PartialMethodSigMismatch = "E0434";   // partial method 实现无匹配声明 / 声明与实现签名不一致
    public static string PartialNestedUnsupported = "E0435";   // 嵌套类型自身 partial（v1 不支持，design D9）
    public static string MissingUsing = "E0436";               // 用了某依赖 ns 却未在本文件 using（file-scoped usings）
    public static string TargetTypedNewNeedsType = "E0437";    // target-typed `new()` 目标类型不可推断 / 重载歧义（add-target-typed-new）
    // E0438 预留：值 struct 自引用（struct 直接/间接以自身为值字段）诊断——add-struct-nested-fields 的
    // follow-up（当前由 StructLayout.IsBlobStruct 的 Size==0 兜底防崩，自引用 struct 退化为引用语义不报错）。
    // 常量在此先登记占号（零发射点，待诊断实现后接上）：占号若只写在文档里，`xtask test diagcodes`
    // 就看不见它，后来者扫这张表找空位会把它当空号拿走——E0474 / E0477 / E0481 三次撞码都是这个形状。
    public static string StructSelfReference = "E0438";
    public static string ImplicitNarrowingConversion = "E0439";  // 存在显式转换却用于隐式上下文（窄化/有损）——需 (T) cast（tighten-implicit-conversions）
    public static string ConversionOperatorConflict  = "E0440";  // 转换运算符声明冲突：同 (源→目标) 重复 / implicit+explicit 同对（add-user-conversions ②，声明期检测）
    public static string InconsistentAccessibility   = "E0441";  // 不一致可访问性：更高可见性的成员/类型签名暴露了更低可见性的类型（C# CS0050 族；complete-class-access-control ②）
    public static string TopLevelAccessModifier      = "E0442";  // 顶层声明（class/interface/struct/record/enum/函数）标 private/protected——模块作用域无意义（complete-class-access-control ③）
    public static string UndefinedType               = "E0443";  // 类型注解引用了未定义的类型名（对标 C# CS0246；fix-undefined-type-diagnostic）
    public static string AttributeSuffixRequired     = "E0444";  // `: Attribute` 类名必须以 `Attribute` 结尾（D8 后缀约定；attribute-handler-registry PR2）
    public static string AnalyzerSuffixRequired      = "E0445";  // `: Analyzer` 类名必须以 `Analyzer` 结尾（D8 后缀约定；attribute-handler-registry PR3a）
    public static string GenericMethodArity          = "E0446";  // 泛型方法调用 `Foo<...>()` 的类型实参数与方法声明的类型形参数不符（add-generic-methods）
    public static string GeneratorSuffixRequired     = "E0447";  // `: Generator` 类名必须以 `Generator` 结尾（D8 后缀约定；attribute-handler-registry PR4a）
    public static string GeneratorTargetOutOfScope   = "E0448";  // generator 只能改它 trigger 命中的声明（Augment/Replace 越界；attribute-handler-registry PR4a 护栏）
    public static string GeneratorDependencyCycle    = "E0449";  // generator 的 consumes/produces 依赖成环——拓扑分层无法定序（attribute-handler-registry PR4e 有界多轮护栏）。PR4e-wire 起 GeneratorDriver 已由字面量切回常量引用（E0449 随 nightly 载入 z42c.core）。
    public static string CallerMacroInvalid          = "E0450";  // 编译期宏 `name!()` 误用（attribute-handler-registry PR6b）：未知宏名 / 参数类型不符 / 出现在非参数默认值位。**语义层用字面量 "E0450" 发码**（不引用本常量），避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache（同 PR4e E0449 手法，待随 nightly 载入后可切常量）。
    public static string PropertyNoSetter            = "E0452";  // 给没有 setter 的属性赋值：`X { get; }` 只读自动属性仅可在构造函数内经 `this` 写（对标 C# CS0200），`X { get {..} }` 计算属性任何位置都不可赋值（fix-autoprop-getonly-backing-write）；静态 `static X { get; }` 仅本类静态 ctor 内可写、计算属性写初始化器 `= e` 同码（add-static-properties）。**语义层用字面量 "E0452" 发码**（同 E0449/E0450/E0451 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string AssocTypeBinding            = "E0453";  // 关联类型（add-associated-types PR-3）：接口里 `type Item;` 未被实现方绑定 / 实现方写了不带绑定的 `type Item;` / 接口自己写了绑定 / `where T : IFoo<Zzz = int>` 里 Zzz 不是该接口的关联类型 / 实参绑定与约束要求不符。**语义层用字面量 "E0453" 发码**（同 E0449/E0450/E0451/E0452 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string StaticClassInstanceMember   = "E0451";  // static 类含实例成员（方法/字段/属性/构造器）、声明基类、或实现接口——static 类只容纳静态成员（对标 C# CS0708/0710/0713/0714；fix-static-class-instance-members）。**语义层用字面量 "E0451" 发码**（同 E0449/E0450 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string SelfParamThroughInterface   = "E0454";  // 经**接口静态类型**调用形参位含 `Self` 的方法（`IEq a, b; a.Same(b)`）——`Self` 在形参位是**逆变**方向、没有唯一安全上界：接口只保证实参也实现了该接口，而实现方的签名要的是**它自己**，放行即运行期类型混淆（实测 `P.Same` 拿到 `Q` 后 `other.V` 读出 **null**、静默返回 false）。对标 Rust 的 object-safety（`Self` 在形参位 ⇒ 该方法不可经 `dyn Trait` 调用）；z42 的替代写法是型参：`bool f<T>(T a, T b) where T : IEq`，那条路 `Self ≡ T` 精确、且经 Part A 真校验。（bind-self-param-and-constraint-members Part B）**语义层用字面量 "E0454" 发码**（同 E0449–E0453 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string GenericTypeArgRequired      = "E0455";  // 省略尖括号调用一个**方法体真的消费型参**的泛型方法（体内有 `typeof(T)`/`new T()`/`default(T)`/`new T[n]`，或把 T 转发给嵌套泛型调用 `Bar<T>()`）。类型实参推断（add-generic-type-arg-inference 阶段 C）**刻意不回灌** `BoundCall.MethodTypeArgs`——回灌会把 opcode 从 `Op.Call` 换成 `Op.CallGeneric`、重排 zbc 串池、并关掉 `exec_call.rs` 的 native 快路径门，而全仓 112 处隐式泛型调用全是不消费型参的 `Array.Copy<T>` ⇒ 纯回归。代价是这类 callee 在运行期会读到**空**的 `frame.method_type_args`（静默错值，同 generic-new-array-value-type-null-tail）。本码把静默错值换成编译错误，修法就是显式写出 `<T>`。判定不到（导入方法无本地 Decl）→ 放行 = 改动前行为。**语义层用字面量 "E0455" 发码**（同 E0449–E0454 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string AmbiguousBareTypeName       = "E0456";  // 非限定短名同时匹配**多个可见命名空间**里的类型（`using A; using B;` 后裸写 `Foo`，A.Foo 与 B.Foo 都在）。此前 `SymbolTable.Classes` 按裸名 first/last-wins **静默择一**，选中哪一份取决于加载顺序 —— 实测三命名空间 fixture 里 `Helper.Who()` 无声地选了 B、零诊断。对标 C# CS0104。**当前命名空间里的那一份优先**（不算歧义），与 C# 一致；限定写法（`A.Foo`）永远不歧义。**语义层用字面量 "E0456" 发码**（同 E0449–E0455 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string FileScopedNamespaceMisplaced = "E0457";  // 一个文件里写了**多个**文件级 `namespace X;`，或把 `namespace` 写在类型/函数声明**之后**。z42 的编译单元只有一个命名空间（`CompilationUnit.Namespace` 是单值），而 parser 的 namespace 分支在顶层声明循环里、每命中一次就整个覆盖 `ns` ⇒ 此前**静默 last-wins**：声明在 `namespace First;` 底下的类被登记进最后那个 ns，连限定名都随之解析错（实测 `A.Helper.Who()` 打印的是 B 的实现）。这不是「少报一条诊断」，是**解析到错误的类型**。对齐 C# CS8907/CS8955。恢复策略保留**第一个** ns。块形式 `namespace X { }` z42 本就不支持（parse 错）。**语法层用字面量 "E0457" 发码**（同 E0449–E0456 手法，避 core→syntax 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string DuplicateTypeName = "E0458";  // 同一命名空间里重复声明同一个类型（同 ns、同名、同 arity，且并非全部 `partial`）。此前**静默 last-wins**：后声明的赢，前一个连同成员一起消失，单文件与跨 CU 两种形态都零诊断——跨 CU 形态在真实工程里更危险（两个文件各写一个 `class Config`，谁也不会注意到其中一个从来没生效过）。对齐 C# CS0101。🔴 判据是 **(ns, 名字, arity)** 三者都相同：裸名键在同短名跨 ns 时也会撞（那归 E0456 管），而 arity 预扫是 per-CU 的，跨 CU 的不同 arity 同名今天能编过、报成「重复定义」是错的（Deferred `arity-mangle-not-package-wide`）。**语义层用字面量 "E0458" 发码**（同 E0449–E0457 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache）。

    // IrGen
    public static string UnsupportedSyntax   = "E0501";

    // Package / import resolution
    // report-crosspkg-duplicate-type（2026-09-12 接线）：**同一个 FQN 被多个依赖包声明**。
    // 这个码此前**只分配、从未接线**：`ImportedSymbolLoader.z42` 顶上的注释白纸黑字写着
    // 「延后：…E0601 冲突诊断」，`error-codes.md` 也登记了「导入符号冲突」——实测两个包各声明 `Demo.Ns.Widget`，编译 rc=0 零诊断，
    // 字母序靠前的包赢，输的那份连同全部成员从未存在过。症状二更糟：去调只有输家才有的成员，
    // 得到的是「no method `X` on `Widget`」——用户正看着那份源码，诊断答非所问。
    // 与 E0456 的分工：E0456 管「同**短名**跨 ns」（限定写法即可消歧）；本码管「**FQN 本身**重复」
    // （写全限定名也分不开，被遮蔽那份在 z42 里没有任何写法能指到 —— C# 靠 extern alias，z42 无）。
    // **语义层用字面量 "E0601" 发码**（同 E0449–E0462 手法，避 core→semantics 新跨成员符号撞 F2
    // 冷启动 stale-cache）。
    public static string NamespaceCollision  = "E0601";
    public static string UnresolvedUsing     = "E0602";
    public static string ReservedNamespace            = "W0603";
    public static string CapturedValueSnapshotAssign  = "W0604";
    public static string ReservedNamespaceDeclaration = "E0605";
    // report-crosspkg-duplicate-type：**本包声明的类型遮蔽了某个导入包的同 FQN 类型**。
    //
    // 🔴 这条曾按 C# CS0436 做成 warning（理由：「本地恒赢是既定规则、不是猜」），**改成了 error**：
    // 规则明确 ≠ 结果可接受 —— 被遮蔽的那一份**根本指不了**（两者 FQN 逐字相同，限定名也分不开；
    // C# 有 extern alias 作逃生口，z42 没有），失败形态与 E0601 一模一样：去调依赖包那份才有的
    // 成员，得到「no method X on Widget」这种答非所问的诊断。
    //
    // 与 E0601「未引用则不报」的分工不同：那条是两个第三方依赖打架、下游既没用到也无权修；
    // 本条冲突的两份里**有一份是本包自己写的**，改名随时可以 ⇒ error 可行动。唯一代价是
    // 「故意遮蔽以覆盖库类型」这条野路子（本就无法控制、指不到被覆盖那份），实测全仓 0 处。
    // **语义层用字面量 "E0606" 发码**（同 E0601）。
    public static string LocalTypeShadowsImport = "E0606";

    // Internal compiler error
    public static string InternalCompilerError = "E0900";

    // Native / InternalCall
    public static string ExternRequiresNative     = "E0903";
    public static string NativeRequiresExtern     = "E0904";
    public static string NativeAttributeMalformed = "E0907";

    // Native interop — pinned block
    public static string PinnedNotPinnable = "E0908a";
    public static string PinnedControlFlow = "E0908b";

    // Native interop — manifest reader / synthesis
    public static string ManifestParseError              = "E0909";
    public static string NativeImportSynthesisFailure    = "E0916";

    // Test framework
    public static string TestSignatureInvalid          = "E0911";
    public static string BenchmarkSignatureInvalid     = "E0912";
    public static string ShouldThrowTypeInvalid        = "E0913";
    public static string SkipReasonMissing             = "E0914";
    public static string SetupTeardownSignatureInvalid = "E0915";
    public static string TimeoutValueInvalid           = "E0917";

    // E10xx: call-site argument binding
    public static string PositionalAfterNamed     = "E1001";
    public static string UnknownArgumentName      = "E1002";
    public static string DuplicateArgumentName    = "E1003";
    public static string ParameterDoublySpecified = "E1004";
    public static string MissingRequiredArgument  = "E1005";   // 缺位形参无默认值（add-call-arity-diagnostics 起才真正发码；此前全仓零发码点）
    public static string TooManyArguments         = "E1006";   // 非 params 调用实参多于形参。**语义层用字面量发码**（同 E0449–E0468 手法，避 core→semantics 新跨成员符号 F2 冷启动）

    // E11xx: add-symbol-availability-macro —— `available!(X)` 专属。
    // ⚠️ 与 E0450 同款纪律：**语义层用字面量发码，不引用这两个常量** —— 新增 core→semantics
    // 跨成员符号会撞 F2 冷启动 stale-cache（见 CallerMacroInvalid 注 + PR4e E0449 手法）。
    // 待本 change 随 nightly 载入后可切常量引用。
    public static string AvailableAmbiguous   = "E1101";  // 目标解析到多个重载，无法唯一确定（v1 不支持签名消歧）
    public static string AvailableBadArgument = "E1102";  // 参数不是符号引用（字面量/任意表达式），或参数个数不为 1
    public static string MethodOfTargetNotFound  = "E0459";  // `methodof(T.M)` 的目标方法不存在，或没有重载匹配给出的参数类型列表。诊断**必须列出该名字下全部可用重载**（本地候选附声明位置）——本特性的全部价值是把「函数名改了静默失效」变成编译期错误，若只说「找不到」而不给候选，用户就只知道错了、不知道该写什么。**语义层用字面量 "E0459" 发码**（同 E0449–E0458 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string MethodOfAmbiguous       = "E0460";  // `methodof` 无法唯一确定目标：给了参数类型列表却匹配到多个（泛型基类替换后同签名，Lippert 的第一类——参数列表也分不开），或省略了参数列表而候选 ≥2。**绝不静默择一**：静默择一等于把本特性要根治的「悄悄绑到另一个重载」原样搬回来。诊断给出可照抄的补签名写法。**语义层用字面量 "E0460" 发码**（同上）。
    public static string MethodOfUnreferenceable = "E0461";  // `methodof` 的目标是**指不了**的方法：用户定义的运算符与转换根本没有名字（源码里是 `operator +`，`op_*` 是编译器内部拼写，不属于语言）。必须说「指不了」而非含糊报「找不到」——两者的下一步完全不同。检查**先于候选收集**：运算符压根不进 `ct.Methods`，否则会先撞上「没有这个方法」、诊断答非所问。**语义层用字面量 "E0461" 发码**（同上）。
    public static string MethodOfMalformed       = "E0462";  // `methodof(...)` 括号内的**签名语法**形态错：缺 `Type.Member`（写成 `methodof(Logger)`）、owner 带类型实参（`methodof(Box<int>.Get)` —— 泛型类共享一份发射，两个实例化产同一个 qualified 名，区分无意义）、方法带类型实参（v1 按名字指代泛型方法）。**语法层用字面量 "E0462" 发码**（同 E0457 手法，避 core→syntax 新跨成员符号撞 F2 冷启动 stale-cache）。
    public static string ConstraintMethodArgTypeParam = "E0463";  // 在**型参收者**（`where T : IEq` 的 `T`）上调用约束接口方法时，给一个形参位是 `Self`（经 `_substSelfSig` 精确替换为型参 `T` 自身）的形参传了**具体类型**实参（`a.Same("nope")` / `a.CompareTo("x")`）。`T` 是 caller 固定的不透明型参，只接受同一型参的值；具体类型无法赋给它。此前 `Self→T` 替换把形参变成**裸型参**，`Conversion` 分支 B「恰一侧含型参→GenericErase」照旧擦除放行 ⇒ 编译期零诊断、运行期派发到 `T.M` 后从实参读出不存在的字段（静默错值/崩）。与 **E0454**（#530 Part B）的分工：E0454 管**接口静态类型**收者（逆变、无安全上界 ⇒ 一刀切禁止），本码管**型参收者**（`Self ≡ T` 精确 ⇒ 可安全真查实参）。只收「目标裸型参 + 源无型参」单方向，不碰分支 B 的 `T→object`/`T→接口` 放行。**语义层用字面量 "E0463" 发码**（同 E0449–E0462 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string ForwardTargetNotFound   = "E0464";  // `[Forward(methodof(X.M))]` 点名的成员**不在该字段的类型上**（点错了字段，或那个成员属于另一个 `[Forward]` 字段）。methodof 自身只保证「X 上有 M」，保证不了「这个字段的类型是 X」——两件事，故单列一码。**语义层用字面量 "E0464" 发码**（同 E0449–E0462 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache）。
    public static string ForwardNotRenderable    = "E0465";  // `[Forward]` ①② 档的转发面**声明不在本包** ⇒ 渲染不出等价签名：跨包元数据把**参数名**丢了（ImportedSymbolLoader 只取 TypeName），`ref`/`out` 此前在 TSIG 格式里**根本不记录**——判定不了，而丢掉 ref 的后果是**静默**的错误语义（实测调用点少写 ref 照样编译通过、修改丢失）。「判定不了 + 错了不响」只能整类拒绝。⚠️ **两个前提现已解除**：参数名由 fix-crosspkg-named-args 修，`ref` 由 record-ref-in-signature 经 param attr-ref 通道跨包传播。放宽本码需重新核对整条转发渲染路径（签名渲染 / 实参转发 / `ref` 在生成代码里的位置），属独立变更——**前提没了，但还没做**。修法是改用 ③ `partial` 声明档：签名由用户手写，`ref` 用户自己写对。**语义层用字面量发码**（同上）。
    public static string ForwardAmbiguous        = "E0466";  // `[Forward]` 无法唯一确定转发目标：② 档点名的名字在该类型上有**多个重载**（methodof 的签名消歧发生在「X.M 指哪个」那一层，而转发要生成一个具名方法、必须知道是哪一个），或多个 `[Forward]` 字段同时提供同名成员（S4：**声明处**报，不推迟到用时——Go 推迟到用时报、且动态接口断言处静默返回 false，那是更坏的形态）。**语义层用字面量发码**（同上）。
    public static string ForwardSkipped          = "I0466";  // 【Info】外层类已自己声明了同名成员 → `[Forward]` **跳过不生成**（S5）。这不是错误：用户的实现优先。⚠️ 本常量原登记 **I0467** 而发射点一直发的是 **I0466**（名实不符、`error-codes.md` 早已标注）；enforce-diagnostic-code-uniqueness 改值归位，**I0467 就此退役、编号不复用**。但必须**说出来**——否则「我贴了 [Forward] 却没生效」是一个没有任何解释的缺席。⚠️ 按名字跳过、arity 不同也跳：跨碎片同名重载会让先声明的那个从方法表里**静默消失**（partial-types.md「跨碎片重载 → 静默覆盖」），生成一个同名重载等于吃掉用户自己的方法。
    public static string ForwardMalformed        = "E0468";  // `[Forward]` 特性形态/用法错误（四子类）：字段类型不是 class/interface、没有成员面可转发 / `[Forward(...)]` 实参既非 `typeof(接口)` 也非 `methodof(类型.成员)` / `typeof(X)` 里 X 不解析成接口 / `methodof(类型.成员)` 点名的成员不在该字段的类型上。**此前这四处误发字面量 "E0463"**（与约束实参校验 E0463 `ConstraintMethodArgTypeParam` 一码两义——#604 与 #610 并行开发各抢了 E0463 空号），fix-iface-satisfaction-gaps 拆出本码修正。**语义层用字面量 "E0468" 发码**（同 E0449–E0467 手法，避 core→semantics 新跨成员符号撞 F2 冷启动 stale-cache，待随 nightly 载入后可切常量）。
    public static string BaseCtorRequired        = "E0469";  // add-implicit-base-ctor-call：实例构造器没写初始化子句（⇒ 隐式 `: base()`），而基类有实例构造器、但**无一可零实参调用**（无参 / 形参全带默认值 / 仅 params 尾参）⇒ 须显式 `: base(...)`（对标 C# CS7036）。派生类**没写任何构造器**时不报——它直接继承基类的带参构造器。**语义层用字面量 "E0469" 发码**（同 E0449–E0468 手法）。
    public static string AssignTargetNotLvalue   = "E0482";  // 赋值目标不是左值（没有可写的存储）：`42 = a` / `f() = x` / `(A, B) = (a, b)` 在**表达式位置**（那是造一个新元组再赋给它）。**此前这道检查根本不存在**——上述三种全都编得过、跑得过、什么也不发生、零诊断。最伤人的是表达式体成员 `Pair(int a, int b) => (A, B) = (a, b);`：读起来完全像给两个字段赋值，实际字段全 0（`=>` 后只能是表达式，`_parseArrowBody` 发 `_parseExpr`，连解构声明都不是）。判据是白名单：标识符 / 成员 / 下标 / 静态字段 / 捕获变量。⚠️ 与 **E0470**（`ref` 实参左值）**不是一回事**：那条要「可取址」，严得多（静态字段 / 值 struct 字段 / 属性一律拒）；赋值只要「有存储」，那三样都合法——同一个词两个强度，故两码。⚠️ 本码原为 **E0477**，与「取重载自由函数引用无匹配」（先占号，#745）撞码，按先来后到于 enforce-diagnostic-code-uniqueness 改号到 E0482。
    public static string ObsoleteNullOperator = "E0480";  // 使用了已移除的空值运算符 `?.`（空条件成员访问）或 `??`（空合并）。两者同码：它们是同一个口子的两种写法——都把「可能为 null」静默收尾掉，让问题溜过检查。`??` 的迁移写法是把兜底写出来（`var v = a; if (v == null) { v = b; }`）；若是「读设置取默认值」，优先换成接受默认值的 API（全仓 70 处 `GetEnvironmentVariable("X") ?? ""` 就是这么迁的 → `GetEnvironmentVariable("X", "")`）。它是「让问题逃掉」的口子之一：把「可能为 null」静默向下传播，最终在离现场很远的地方崩。诊断给迁移写法（`var t = <target>; if (t != null) { t.<member> }`），并按普通 `.` 继续解析以免级联错（同 E0471 对 `out`/`in` 的手法）。⚠️ 顺带修掉一个真 bug：原脱糖把接收者**绑定了两次** ⇒ `F()?.X` 会**调用 F 两次**（原注释自述「简单接收者双求值无副作用」，即已知而未修）。**语法层用字面量 "E0480" 发码**。
    public static string PossibleNullReturn = "E0479";  // 把「可能为 null」的值 `return` 给**未标 `?`** 的返回类型。未标的返回类型意味着「调用方不必检查」，所以放行就等于凭空造了一个洞——标记体系被洗穿。修法两条（诊断里都给）：给返回类型加 `?`（把义务传给调用方），或在这里先检查。⚠️ 只认**确定性**来源（标 `?` 的名字 / 标 `?` 的调用结果）；`return null;` 字面量本身不报——那是反向推导（design D8），是「建议加 `?`」而非「这里有错」，留给后续 PR。**语义层用字面量 "E0479" 发码**（同 E0449–E0478 手法）。
    public static string DereferenceOfNullMarked = "E0478";  // 解引用一个标了 `?` 的形参而未先检查空值。`?` 的语义是「**请编译器在这里强制检查**」，**缺席 = 不强制**（不是「保证非空」）⇒ 未标的代码一行不用改，零迁移成本。逃生口只有窄化：`if (s != null) { … }` 或早返回守卫 `if (s == null) { return; }`——**不提供 `!` 那样的「我保证」后缀**，那正是 User 要避开的「让问题逃掉」的口子。本 PR 只覆盖**裸名**解引用（字段/属性要先定快照规则）与**形参**标记（返回值标记要在调用点拿被调方签名，`BoundCall` 有 46 个构造点，留给后续）。**语义层用字面量 "E0478" 发码**（同 E0449–E0477 手法）。
    public static string NullableFieldNotSnapshotted = "E0484";  // 直接解引用一个标了 `?` 的**字段/属性**，而没有先快照到局部。与形参（E0478）分成两码，是因为**修法不同**：形参就地 `if (s != null)` 就够，字段不行。字段不是一个「值」，是一个**每次读都重新求值的位置**——`if (this.F != null) { this.F.M(); }` 里的两个 `this.F` 是两次独立的读：别的线程能在中间写；`F` 若是属性还是两次真调用，返回值可以不同。所以字段**永不就地窄化**，修法是 `var v = this.F; if (v != null) { … }`（局部是个值，检查一次就永远成立）。⚠️ 跨包暂不携带标记（字段的 TSIG 拼写走 `SurfaceTypeName`，`?` 已擦除）⇒ 导入字段一律视为未标，**漏报**方向。**语义层用字面量 "E0484" 发码**（同 E0449–E0483 手法）。
    public static string DeconstructShadowsMember = "W0701"; // 【Warning】解构声明的绑定名遮蔽了当前类的字段 / 属性：`(A, B) = (a, b);`（花括号体里）声明的是两个**新局部**，随即离开作用域，一个成员都没动。局部遮蔽字段本身合法（`int A = 5;` 照旧放行），单看语法挑不出毛病——只能靠「遮蔽了同名成员」这个信号拦。仅在有 `this` 的上下文里查（静态体内无成员可遮蔽）。表达式位置的同一写法由 **E0482** 直接报错。**语义层用字面量 "W0701" 发码**（同 W0700 手法）。

    // ── ref/out/in 参数契约（simplify-ref-parameters）──────────────────────────
    public static string RefArgNotAddressable    = "E0470";  // `ref` 实参不是可取址的左值（属性 / 索引器 / 静态字段 / 值 struct 的字段 / 字面量 / 调用结果 / 数组虚成员）。这些形态此前编译通过但**写回静默丢失**——取的是承载读出值的临时寄存器的地址。⚠️ 比 E0482（赋值左值）严得多：那条只要「有存储」，这条要「可取址」。
    public static string ObsoleteParamModifier   = "E0471";  // 使用了 `out` / `in` 作参数修饰符（形参位或调用点）。三态已收敛为单一 `ref`。诊断附迁移写法，并按 `ref` 继续解析以免级联错。
    public static string RefArgModifierMissing   = "E0472";  // 形参是 `ref`，**实参漏写** `ref`。此前编译通过且方法里的写入**静默丢失**（被调方改的是自己的形参寄存器，出口 copy-out 没有调用方的 lvalue 可写回）。
    public static string RefArgModifierUnexpected = "E0473"; // 形参**不是** `ref`，实参却多写了 `ref`。与 E0472 方向相反同样有害：写入**传回了调用方**，即「按引用与否由调用点决定」，光看函数声明判断不出参数会不会被改。

    // ── 属性访问器形态 / 可空标记（add-property-custom-setter · enforce-value-type-non-null）──
    public static string MixedPropertyAccessors  = "E0474";  // 属性的两个访问器**混合** auto 与带体（一半 `get;`/`set;`、另一半 `get { }`/`set { }`）。z42 无 C# 的 `field` 关键字：auto 半边读写合成后备 `__prop_X`、带体半边写自备字段 → **读写错位**。须要么都 auto、要么都带体。
    public static string NullableToNonNullableValue = "E0475"; // 把可空表达式隐式转给**不可空的值类型**目标。`?` 擦除后此前一路放行，运行期才以 `type mismatch in arithmetic: Null vs I64` 之类的内部错误炸出来。
    public static string NullableValueType       = "E0476";  // 对**值类型**写 `?`（`int?` / `Guid?` / 值 struct）。可空只适用引用类型——`?` 对值类型此前是个「看起来存在、实际为零」的标注。⚠️ `byte[]?` 这类**数组**不受限（数组是引用类型）。
    public static string FuncRefNoMatchingOverload = "E0477"; // 取一个**重载自由函数**的引用时目标委托类型在场，但**没有任何重载**的签名（形参逐位 + 返回）与该委托精确相等。诊断列出该名字下全部候选签名。
    public static string ValueTypeNullComparison = "E0483";  // 值类型表达式与 `null` 比较（`==` / `!=`）。值类型永不含 null ⇒ 该比较是**静默恒假/恒真**，此前零诊断。⚠️ 本码原为 **E0474**，与「属性访问器混合 auto 与带体」（先占号，#737）撞码，按先来后到于 enforce-diagnostic-code-uniqueness 改号到 E0481；随即又与 #747「接口非法成员」撞上 —— 那边早两个 commit 合入、保号，本码再让一次到 **E0483**。⚠️ 两次让号都是因为**本码的发射点用字面量**、号在登记表里没有主，抢号时看不见它。

    public static string InterfaceIllegalMember   = "E0481";  // 接口声明了**非法成员**——字段（静态/实例）或嵌套类型。接口只能声明方法、属性、索引器、事件、关联类型。此前 `_fillInterface` 把这些**静默跳过**（`interface I { static int X; }` 编译通过但 X 无处可用）。**语义层用字面量 "E0481" 发码**。

    // ── 包级初始化（add-module-init-hook）──────────────────────────────────────
    // 两个码**不得合并**：「标注目标非法」与「包内重复」是两件事，合并即一码两义。
    // ⚠️ BadTarget 原取 E0484，rebase 时发现已被「解引用标了 `?` 的字段/属性」占走（那边早合入
    // main）⇒ 按先来后到让号到 E0486；E0485 当时未被占，保留。**分配码必须扫全源，别只信文档**。
    // （E0474 / E0477 / E0481 三次撞码刚归位过）。**语义层用字面量发码**（同 E0449–E0483 手法，
    // 见 bootstrap-seed.md：新常量与其引用不能同 PR，避 core→semantics 冷启动 stale-cache）。
    public static string ModuleInitBadTarget     = "E0486";  // `[ModuleInit]` 标注目标非法：必须是 `static` + 无参 + 返回 `void` + 非泛型 + 非抽象的方法。标在类型/字段上，或签名不符，都归此码。
    public static string ModuleInitDuplicate     = "E0485";
    public static string ModuleInitInExePackage  = "E0487";  // 可执行包（`kind = "exe"`）里出现了 `[ModuleInit]`。包初始化器在 `Main` 之前执行 ⇒ **它失败时没有任何用户代码能捕获**（对标 C#：entry 模块的 module initializer 抛异常就是未捕获崩溃）。而 exe 本来就有 `Main` 这个天然入口，同一件事的第二种表达 ⇒ 禁掉。库包（`kind = "lib"`）不受限。  // 一个包里出现了**第二个** `[ModuleInit]`。包级初始化器至多一个（User 裁决 2026-09-22）——多处装配写在同一个方法里，顺序才是显式的。诊断报在后出现的那处，并指出第一处的 file:line。

    // ── 迭代协议（fix-foreach-protocol-detection）──────────────────────────────
    // **语义层用字面量 "E0488" 发码**（同 E0449–E0486 手法，见 bootstrap-seed.md：新常量与其
    // 引用不能同 PR，避 core→semantics 冷启动 stale-cache）。
    // ⚠️ 本码原先分配的号与「`[ModuleInit]` 只对库包开放」（#772）撞 —— 那个 PR 早几小时开、
    // 按先来后到保号，本码让到 E0488。**扫全源不够**：撞码那次 #772 还没合进 main，扫 main 看不见它。
    // 分配码时除了扫全源，还要 `gh pr list` 逐个在飞分支扫 `DiagnosticCodes.z42`——
    // CI 跑的是 PR 自己的 base 而非合并结果，两个并行 PR 各拿同一个号会双双全绿合入。
    public static string NotIterable             = "E0488";  // `foreach` 的目标**不可迭代**：既不是数组，也没有「整数索引器 + `Count`/`Length`」，也没有 `GetEnumerator()`。此前三条路径全落空时**不报任何诊断**，发射端径直走数组臂对一个非数组对象发 `array_len` ⇒ 编译期零诊断、运行期抛 `ArrayLen: expected array`。只在成员面可得（类 / 接口）时发；型参 / Unknown / Error 类型保守放过。
    public static string NullableOverrideMismatch = "E0489";  // override / 接口实现的 `?` 方向违规（define-null-check-marks D7）。规则是**加严可以、放松不行**：**返回类型**实现方可以**去** `?`（承诺更强）、不可以**加**（基类/接口没标 ⇒ 经它调用的人没有检查义务，加了等于标记被静默丢弃）；**形参**实现方可以**加** `?`（自己查得更多）、不可以**去**（契约是「任何实现都会检查这个入参」，去掉就不检查了）。两条禁的都是「比自己兑现的契约更松」那一侧 —— 松的那侧就是洞。只在签名已配对成功后比标记位（override 走 `_nearestBaseMethod` 命中、接口走 MangleKey 命中），不重做匹配。跨包可靠：方法形参/返回的 `?` 由 TSIG 文本双向携带；字段不参与 override/接口实现，与本码无关。**语义层用字面量 "E0489" 发码**（同 E0449–E0488 手法）。
    public static string ExpectRequiresLiteralReason = "E0490";  // `Expect(…)` 的理由参数缺失、不是字符串字面量、或是空串（define-null-check-marks D5）。`Expect("理由")` 是空检查义务的**唯一显式逃生口**，它与 C# 的 `!` 的全部区别就在这个参数：`!` 是纯编译期擦除——不检查、不留痕、不解释；`Expect` 运行期**真检查**（为 null 就抛 `NullReferenceException`，消息 = 你写的理由），并把「你**为什么**认为它非空」留在代码里，可 grep、可在 review 里数。⇒ 理由必须是**字面量**（运行期拼出来的字符串无法在 review 时读到）且**非空**（`Expect("")` 等于把它还原成 `!`）。⚠️ `Expect` **不是保留字**：收者类型上若有用户自己声明的 `Expect` 成员，**真成员优先**、intrinsic 不介入（全仓已有一个真的：`TomlParser.Expect(char, string)`）；值类型收者同样不介入（值类型永不为 null，那是个恒真检查）。**语义层用字面量 "E0490" 发码**（同 E0449–E0489 手法）。
    public static string InterpHoleTrailing      = "E0492";  // 插值洞里表达式之后还有剩余 token：`$"{d:F2}"` / `$"{a b}"`。**此前静默丢掉**——`_parseInterpolated` 只取子 parser `ParseExpression()` 的结果、从不问它有没有读完，于是 `d` 解析完就停在 `:` 前，`:F2` 一个字节没人看 ⇒ C# 读者写惯的格式说明符原样失效（`{d:F2}` 打出 3.14159、`{n:X}` 打出 42），零诊断。z42 不支持格式说明符，所以这里报错而不是实现它——「不支持」必须说出来，静默失效比不支持更糟。⚠️ 位置用整个 `$"…"` token 的 Span：子 parser 产的 Span 其 File 是合成的 `"<interp>"`、偏移是洞内坐标，打印出来是用户无从定位的 `<interp>(1,4)`（该缺陷仍在，只影响洞内**解析失败**那条路）。

    public static string HandlerZpkgLoadFailed   = "E0493";  // `[analyzers]` 段声明的 handler zpkg（analyzer / generator）**加载失败**。此前 `GeneratorLoader` / `AnalyzerLoader` 里的 `__load_module` 抛出的异常一路穿出 driver ⇒ 用户看到的是带 z42c 内部栈帧的 `uncaught exception`，既不指明是哪个 `[analyzers]` 条目、也不给出处置。最常见成因：**indexed zpkg 被单独拷走**——开发态（非 `--release`）产出的是「主文件 + 散装 `.zbc`」，只拷主文件过去，加载端就报 `cannot load indexed zpkg`。处置写在诊断消息里（连散装 `.zbc` 一起拷，或用 `--release` 得到单文件 packed zpkg）。⚠️ 编号：E0491 / E0492 已被未合并分支占走，本码取 E0493。**pipeline 层用字面量 "E0493" 发码**（同 E0449–E0490 手法，避免新增 core→pipeline 跨成员符号撞 F2 冷启动 stale-cache）。

    public static string UnknownNamespace        = "E0494";  // `using X;` 里的 `X` **不存在**——依赖的包里没有它，本包也没有声明它。此前**零诊断**：usings 的唯一去向是 `ImportedSymbolLoader.Load` 的激活过滤，名字对不上就只是没激活任何东西，与「写了个用不到的 using」不可区分 ⇒ 拼错命名空间得到的不是「没有这个命名空间」，而是后面一堆**位置在别处**的 `E0401` / `E0443`。与 E0436（「用了却没 using」）互为反向：那条查漏、这条查错。⚠️ **父命名空间算已知**（`using Std;` 合法，即便注册的只有 `Std.IO`）；无依赖目录的单文件路径整条跳过（已知集为空，否则全量误报）。**pipeline 层用字面量 "E0494" 发码**（同 E0449–E0493 手法）。
    public static string OperatorNotOverloadable = "E0495";  // `operator X` 重载的写法不成立：**符号不在可重载表里**（`!` / `&&` / `~` …），或**形参不是两个**（一元重载）。z42 只重载 `operators.md` 那张 16 条表里的二元运算符。此前两种写法都**声明零诊断**、且都产出永远派发不到的方法：表外符号回落 `"op_" + op` 造出**非法名**、`fn @Vec.op_!$1$Vec` 真的被发进 zbc；一元 `-` 则撞进表里的 `op_Subtract`、产出 `op_Subtract$1$T` 而派发侧只按二元形态查。用户看到的唯一提示是使用处那句与真因无关的 `E0402: operator `-` requires numeric operand`。⚠️ arity 判定必须在**形参列表解析之后**——一元与二元共用同一个符号，算名字的那一刻 arity 还不知道。⚠️ 派发侧 `TypeFactsTc._operatorMethodNameTc` 对表外符号一直回落 `""`（「`""` 表不可重载」），本码把声明侧对齐到同一约定。**语法层用字面量 "E0495" 发码**（同 E0449–E0493 手法）。

    // ── 穷尽性（add-switch-exhaustiveness）────────────────────────────────────
    public static string SwitchNotExhaustive     = "W0700";  // 【Warning】`switch` 不穷尽：对 `bool` / `enum` / 封闭类型做 `switch` 时漏了分支且没有 `default`。

    // ── 已退役的编号（仅占号，永不发射；编号不复用）────────────────────────────
    // 这三个号的「已被占用」此前只记在 docs/reference/src/appendix/error-codes.md 里，而门只读这张表
    // ⇒ 它们在门眼里是空位。登记表是唯一能占号的地方，**退役号也必须占在这里**。
    // 前缀不同即不同码（E0466 与 I0466 并存即先例），所以退役 I0467 不牵连 E 前缀的 0467——那个号仍可分配。
    public static string RetiredForwardSkipped      = "I0467";  // 原 ForwardSkipped：登记此号而发射点一直发 I0466，2026-09-22 改值归位后空出
    public static string RetiredUnknownNativeName   = "E0901";  // 原 UnknownNativeName（C# bootstrap 编译器删除时一并消失，未移植到 z42c）
    public static string RetiredNativeArityMismatch = "E0902";  // 原 NativeArityMismatch（同上）
}
