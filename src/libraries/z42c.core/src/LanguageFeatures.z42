// 语言特性开关。受限写法：无 enum（特性名用 snake_case 字符串）；无泛型类字段
// （Dict<...> 被丢弃）→ 并行数组 string[] names + bool[] enabled + count。
// IsEnabled(未知名) = false（拼写错误被发现，不静默启用）。
//
// ✅ **已接线**（add-l0-protocol-table 批 1，2026-09-25）：`z42.toml` 的 `[syntax]` 段 →
// `ManifestLoader._parseSyntax`（只搬中性 name/value）→ `z42c.driver` 的 `Main._build` 建表
// （`Phase1Profile` 起底 + 按 toml 覆盖，**未知名报错退出**）→ `CompileInput.Features` →
// `IncrementalDriver` 的**两处** `new Parser` → `Parser._requireFeature` 发 **E0301**。
// 特性集同时折进 `depsId`（否则「全量生效、增量被忽略」）。
//
// ⚠️ **但只有 6 个名字今天真的关得掉东西**（add-l2-parse-table 批 2 起 + 批 3 的 `using_stmt`）：
//   · `control_flow` —— if/while/for/foreach/do/switch **+ break/continue**
//   · `exceptions`   —— try **+ throw**
//   · `bitwise`      —— `| ^ & << >>`（`&=`/`|=`/`^=` 的归属待裁，未挂）
//   · `ternary`      —— `?:`
//   · `pattern_match`—— **进模式引擎**的那几条路（`x is T` / `x is T v` 是类型测试，**保留**）
//   · `using_stmt`   —— `using` **语句**四形态（import / 别名**指令**不受影响）
// 其余 9 个名字**仍是死旋钮** —— 它们描述的是「将来可裁剪的语法面」，不是「今天生效的配置」。
// 别把「这张表接线了」读成「每个名字都生效了」。
// 前三个的表项在 `z42c.syntax/src/ParseTable.z42`（`FeatureNames` + `Feature(kind)`），
// 语句那两个在同文件的 `StmtRules.Feature`。
// 后续接线：在各构造的解析入口加一句 `_requireFeature`，然后**为它加一条会红的门**
// （`scripts/test/xtask_test_incremental.z42` 的 `_syntaxKnobTakesEffect` 是模板：
// 负例必须报 E0301、且要验「红的理由对不对」）。
//
// 🔴 **名字必须对应真实存在的语法构造**。这张表曾长期宣告 4 个**不存在**的特性
// （`using_stmt` —— z42 没有 using 语句；`null_coalesce` —— `??`/`?.` 已删、parser 报 E0480；
// `async` —— `await` 从不被任何 parser 消费、无 Task 类型；`list_patterns` —— 全仓零
// ListPattern、模式解析器没有 `[` 分支），外加 2 个「库有、语言构造没有」的
// （`threading` —— `lock` 连关键字都不是；`native_interop` —— FFI 真有但挂它名下的
// `pinned` 是个没人消费的死 token）。六个已于 2026-09-23 删除。
// **加名字前先确认 parser 真的有消费该语法的代码路径**，否则这里就又多一句假话 ——
// 在开关真正接线之前，没有任何门能替你发现这件事。
namespace Z42.Core;

public sealed class LanguageFeatures {
    private string[] _names;
    private bool[]   _enabled;
    private int      _count;
    public  int      Phase;   // 1 = Phase1（C# 9-12 子集）, 2 = Phase2（保留）

    public LanguageFeatures() {
        this._names   = new string[40];
        this._enabled = new bool[40];
        this._count   = 0;
        this.Phase    = 1;
    }

    // upsert：已存在则覆盖，否则追加。
    public void Set(string name, bool on) {
        int i = 0;
        while (i < this._count) {
            if (this._names[i] == name) { this._enabled[i] = on; return; }
            i = i + 1;
        }
        this._names[this._count]   = name;
        this._enabled[this._count] = on;
        this._count = this._count + 1;
    }

    // 名字在表里吗 —— 与 `IsEnabled` 分开是必须的：`IsEnabled` 对「未知名」和「已知但关着」
    // 都返回 false，消费方据此**分不出拼写错误与故意关闭**。接线后 `[syntax]` 要对未知名报错
    // （同 `Opt.ByName` 的口径），所以必须有这一问。
    public bool Has(string name) {
        int i = 0;
        while (i < this._count) {
            if (this._names[i] == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // 已登记的特性名（供消费方在报未知名时列出「已知有哪些」）。
    public string NameAt(int i) {
        if (i < 0 || i >= this._count) { return ""; }
        return this._names[i];
    }

    // 未知特性默认 false（安全：拼写错误不会静默启用）。
    public bool IsEnabled(string name) {
        int i = 0;
        while (i < this._count) {
            if (this._names[i] == name) { return this._enabled[i]; }
            i = i + 1;
        }
        return false;
    }

    public int Count() { return this._count; }

    // ── 预置 profile ────────────────────────────────────────────────────────
    //
    // 只有一个。`MinimalProfile()`（仅 interpolated_str/ternary/cast/bitwise）已于
    // add-l2-parse-table 批 2 删除：它**零生产调用方**（只有自己的单测），而且 `[syntax]`
    // 语法里**选不到 profile**（`Main._build` 固定从 `Phase1Profile()` 起底、只能逐项覆盖）
    // ⇒ 它不是「能用而没人用」，是「用不上」。真要按 profile 裁剪，得先加 manifest 键，
    // 那是独立一条（届时它的 4 个名字里已有 3 个真能裁掉语法了）。

    // Phase 1 完整特性集（C# 12 子集全开）。
    public static LanguageFeatures Phase1Profile() {
        var f = new LanguageFeatures();
        f.Set("interpolated_str", true);
        f.Set("control_flow",     true);
        f.Set("oop",              true);
        f.Set("generics",         true);
        f.Set("arrays",           true);
        f.Set("exceptions",       true);
        f.Set("pattern_match",    true);
        f.Set("lambda",           true);
        f.Set("nullable",         true);   // 引用类型的 `T?` 空检查标记；值类型 `int?` 报 E0476
        f.Set("ternary",          true);
        f.Set("cast",             true);
        f.Set("tuples",           true);
        f.Set("delegates",        true);
        f.Set("reflection",       true);
        f.Set("bitwise",          true);
        f.Set("using_stmt",       true);   // `using` 语句（add-using-statement 批 3；曾是幻影名）
        f.Phase = 1;
        return f;
    }
}
