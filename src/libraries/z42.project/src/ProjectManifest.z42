namespace Z42.Build.Project;

/// `z42.toml` 的完整类型化模型（单项目）。z42c 与 z42.build 共同依赖的唯一真相。
///
/// 受限自举子集写法：sealed class + 构造函数、bool HasX 替 nullable、array+count 替泛型。
/// 各段随 schema 增长在对应记录补字段；本根只做聚合。
/// workspace 清单（`[workspace]`）单独解析，见 `WorkspaceManifest`。
public sealed class ProjectManifest {
    public ProjectInfo Project;        // [project]
    public Sources     Sources;        // [sources]
    public BuildConfig Build;          // [build]
    public Profile[]   Profiles;       // [profile.*]
    public int         ProfileCount;
    public DepEntry[]  Deps;           // [dependencies]
    public int         DepCount;
    public ExeTarget[] Exes;           // [[exe]]（单 exe 时 ExeCount == 0）
    public int         ExeCount;
    public PlatformSet Platform;       // [platform.*]
    // ── dev 目标（test / bench / example；release 构建忽略）──────────────────
    public TargetSection TestsSection;   // [tests]
    public TargetSection BenchSection;   // [bench]
    public TargetSection ExampleSection; // [example]
    public RunTarget[] Tests;          // [[test]]
    public int         TestCount;
    public RunTarget[] Benches;        // [[bench]]
    public int         BenchCount;
    public RunTarget[] Examples;       // [[example]]
    public int         ExampleCount;
    // ── [optimize] 逐 pass 具名开关（add-compiler-inlining）───────────────────
    // 中性 name/value 对（如 inline=true / const-fold=false）；消费方（z42c.driver）按名映射到编译器
    // 的 Opt 位（Opt.ByName）建 tomlBits/tomlMask 交 Opt.Resolve。z42.project **不**耦合 Opt 位值。
    // 可变公字段（默认空，ManifestLoader 构造后填），避免撑大已 20 参的构造函数。
    public string[] OptimizeNames; public bool[] OptimizeValues; public int OptimizeCount;
    // ── [analyzers] 编译期 handler zpkg 引用（attribute-handler-registry D9）─────
    // 独立引用段：声明「加载进编译器、编译期运行、不链入目标程序」的 analyzer/generator zpkg
    // （与 [dependencies] 物理分开）。中性 DepEntry（name+version）；消费方（z42c）按名在 LibsDirs
    // 解析到 `<name>.zpkg`、加载其 `: Analyzer` 类型执行。可变公字段（默认空，ManifestLoader 构造后填）。
    public DepEntry[] Analyzers; public int AnalyzerCount;
    // ── [lints] 诊断规则开关 / severity 覆盖（attribute-handler-registry PR3b）─────
    // 中性 key/severity 字符串对（如 `Z9002="warning"` / `"webgen.*"="none"`）——z42.project **不**
    // 认识规则 Id / severity 语义，只搬运；消费方（z42c 的 LintConfig）解释成每规则最终 severity
    // （EnabledByDefault + 覆盖 + 通配 + warnings-as-errors）。`warnings-as-errors` 布尔单独拎出。
    // 可变公字段（默认空，ManifestLoader 构造后填），同 OptimizeNames 模式。
    public string[] LintNames; public string[] LintSeverities; public int LintCount;
    public bool LintWarningsAsErrors;
    public ProjectManifest(ProjectInfo project, Sources sources, BuildConfig build,
                           Profile[] profiles, int profileCount,
                           DepEntry[] deps, int depCount,
                           ExeTarget[] exes, int exeCount,
                           PlatformSet platform,
                           TargetSection testsSection, TargetSection benchSection,
                           TargetSection exampleSection,
                           RunTarget[] tests, int testCount,
                           RunTarget[] benches, int benchCount,
                           RunTarget[] examples, int exampleCount) {
        this.Project = project; this.Sources = sources; this.Build = build;
        this.Profiles = profiles; this.ProfileCount = profileCount;
        this.Deps = deps; this.DepCount = depCount;
        this.Exes = exes; this.ExeCount = exeCount;
        this.Platform = platform;
        this.TestsSection = testsSection; this.BenchSection = benchSection;
        this.ExampleSection = exampleSection;
        this.Tests = tests; this.TestCount = testCount;
        this.Benches = benches; this.BenchCount = benchCount;
        this.Examples = examples; this.ExampleCount = exampleCount;
        this.OptimizeNames = new string[0]; this.OptimizeValues = new bool[0]; this.OptimizeCount = 0;
        this.Analyzers = new DepEntry[0]; this.AnalyzerCount = 0;
        this.LintNames = new string[0]; this.LintSeverities = new string[0]; this.LintCount = 0;
        this.LintWarningsAsErrors = false;
    }
}
