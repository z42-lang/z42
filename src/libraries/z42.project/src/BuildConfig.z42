namespace Z42.Build.Project;

/// `[build]` 段。目录默认见 docs/design/compiler/project.md。HasX 标志区分「显式设置」与「缺省」。
public sealed class BuildConfig {
    public bool   HasOutputDir;
    public string OutputDir;
    public bool   HasCacheDir;
    public string CacheDir;
    public bool   HasDistDir;
    public string DistDir;
    public bool   Incremental;
    // fix-hooks-source-scan：`[build] hooks = "<dir>"`（projDir 相对）。声明后该目录由 z42c
    // 自动排除出 app 源 glob（hooks 由 z42b 单独编，不该进 app zpkg）。HasHooks=false → 未声明。
    public bool   HasHooks;
    public string HooksDir;
    // add-member-forwarding：`[build] generated_dir`。**generator 产出的源码落盘到哪**。
    //
    // ⚠️ **staged（本变更只登记、尚无人消费）**：把它接到 driver 需要 `CompileArtifacts` 上的
    // 新字段，而 z42c 自建的冷启动收敛**一次只吸收一层**新跨成员符号（`_buildCompilerViaZ42c`
    // 只重新自包含一次重试）。本变更已经用掉那一层（pipeline 引用 semantics 的 ForwardGenerator
    // 与 GenOutcome.Texts），故落盘接线随**下一个变更**落地——那时只剩 driver→pipeline 一层。
    // 这条与 `CompileInputs.Fix` 是同一种 staged 手法（登记先行、消费晚一拍）。
    // 没配置 → `<output_dir>/generated`（沿用 cache_dir/dist_dir 那套「目录型配置 + 从
    // output_dir 派生默认值」的形状，`${output_dir}` 模板现成可用）。
    //
    // 配的是「写到哪」而不是「写不写」⇒ **恒落盘**：选 Generator 路线的理由就是「以后可以
    // 支持调试」，栈帧里出现 `__gen$…z42` 时背后得永远有个真文件可以打开，而不是「先想起来
    // 开个开关、再重编一次」。没用 generator 的包一个字节都不写。
    // 显式写 `generated_dir = ""` 表示不落盘（只读 FS / CI 不要额外产物）。
    public bool   HasGeneratedDir;
    public string GeneratedDir;
    public BuildConfig(bool hasOut, string outDir, bool hasCache, string cacheDir,
                       bool hasDist, string distDir, bool incremental,
                       bool hasHooks, string hooksDir) {
        this.HasOutputDir = hasOut; this.OutputDir = outDir;
        this.HasCacheDir = hasCache; this.CacheDir = cacheDir;
        this.HasDistDir = hasDist; this.DistDir = distDir;
        this.Incremental = incremental;
        this.HasHooks = hasHooks; this.HooksDir = hooksDir;
        this.HasGeneratedDir = false; this.GeneratedDir = "";
    }
}
