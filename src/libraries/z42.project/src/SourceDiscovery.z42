// 源文件发现 —— [sources].include glob → 绝对路径列表。z42c 与 z42.build/z42b 共享。
// glob（`**/*.z42` 递归 / `*.z42` 单层）排除 dist/.cache，去重 + Ordinal 排序
// （common-pitfalls §1：文件系统枚举非确定，显式 sort）。
//
// 与 z42c.project 的同名实现一致，但命名空间用 Z42.Build.Project（避开 z42c 内部 Z42.Project 冲突）；z42c 重构后引用本库、删自带版。
namespace Z42.Build.Project;

using Std;
using Std.IO;

public static class SourceDiscovery {
    // fix-hooks-source-scan 阶段3：原三参 `Discover(pd, inc, incCount)` shim 已删除——所有调用点
    // （z42c `Main.z42` / `Z42cCompiler`）自阶段2 起改调 `DiscoverWithExclude`，且阶段2 nightly
    // （其种子 `Main.z42` 已调 `DiscoverWithExclude`、不再引用 `Discover`）已发布，故 z42c 运行期
    // 自依赖不再需要三参 shim（bootstrap-seed 轴④，比源引用的 API 晚一个 nightly）。
    //
    // fix-hooks-source-scan：应用 `[sources] exclude` glob（此前 `Sources.Exclude` 解析了却从不
    // 生效）+ 调用方并入的 hooks 目录（`[build] hooks` → 自动排除）。excludes 为相对
    // projectDir 的 glob（`hooks/**` / `src/gen/**` / `**/*.z42` / 精确路径）。
    public static string[] DiscoverWithExclude(string projectDir, string[] includes, int includeCount,
                                               string[] excludes, int excludeCount) {
        string[] acc = new string[8];
        int n = 0;
        int gi = 0;
        while (gi < includeCount) {
            string[] hits = SourceDiscovery._expand(projectDir, includes[gi]);
            int hi = 0;
            while (hi < hits.Length) {
                string p = hits[hi];
                if (!SourceDiscovery._excluded(projectDir, p, excludes, excludeCount) && !SourceDiscovery._contains(acc, n, p)) {
                    if (n == acc.Length) {
                        string[] bigger = new string[acc.Length * 2];
                        int k = 0; while (k < n) { bigger[k] = acc[k]; k = k + 1; }
                        acc = bigger;
                    }
                    acc[n] = p; n = n + 1;
                }
                hi = hi + 1;
            }
            gi = gi + 1;
        }
        // Ordinal 插入排序（确定性）
        string[] r = new string[n];
        int i = 0;
        while (i < n) { r[i] = acc[i]; i = i + 1; }
        i = 1;
        while (i < n) {
            string key = r[i];
            int j = i - 1;
            bool more = j >= 0;
            while (more) {
                if (r[j].CompareTo(key) > 0) { r[j + 1] = r[j]; j = j - 1; more = j >= 0; }
                else { more = false; }
            }
            r[j + 1] = key;
            i = i + 1;
        }
        return r;
    }

    // glob 展开。三档：
    //   ① `**/<suffix>`           → 整个 projectDir 递归
    //   ② `<prefix>/**/<suffix>`  → prefix 子目录下递归（如默认 `src/**/*.z42`）
    //   ③ 其余                    → **逐段展开**（见下）
    //
    // ③ 此前是「按最后一个 `/` 切成 dirPart + filePart，再 Path.Glob(projDir/dirPart, filePart)」，
    // 那假定**目录部分是字面量**。于是 `tests/*/source.z42` 这种完全合法的写法会去找一个字面名
    // 叫 `*` 的目录 → 不存在 → **静默返回空数组**。静默空是最坏的失败形态：调用方（z42b 按
    // `[tests] include` 发现测试目标）看到的「这个包没有测试」与「真的没有测试」不可区分。
    // 改为逐段走：目录段照样吃 `*` / `?`。
    private static string[] _expand(string projectDir, string pattern) {
        if (pattern.StartsWith("**/")) {
            return Path.GlobRecursive(projectDir, pattern.Substring(3, pattern.Length - 3));
        }
        int mid = pattern.IndexOf("/**/");
        if (mid >= 0) {
            string prefix = pattern.Substring(0, mid);
            string suffix = pattern.Substring(mid + 4, pattern.Length - (mid + 4));
            return Path.GlobRecursive(Path.Join(projectDir, prefix), suffix);
        }
        // 逐段：最后一段是文件模式，之前每段都是目录模式（可带通配）。
        // 目录前沿（frontier）逐段扩张；Path.Glob 返回目录与文件两者，故用 Directory.Exists 滤出目录。
        string[] segs = SourceDiscovery._splitSlash(pattern);
        string[] frontier = new string[1];
        frontier[0] = projectDir;
        int fn = 1;
        int si = 0;
        while (si < segs.Length - 1) {
            string[] next = new string[8];
            int nn = 0;
            int di = 0;
            while (di < fn) {
                string[] dirHits = SourceDiscovery._dirStep(frontier[di], segs[si]);
                int hi = 0;
                while (hi < dirHits.Length) {
                    if (nn == next.Length) { next = SourceDiscovery._growStrings(next, nn); }
                    next[nn] = dirHits[hi]; nn = nn + 1;
                    hi = hi + 1;
                }
                di = di + 1;
            }
            frontier = next; fn = nn;
            si = si + 1;
        }
        string last = segs[segs.Length - 1];
        string[] acc = new string[8];
        int an = 0;
        int fi = 0;
        while (fi < fn) {
            string[] fileHits = Path.Glob(frontier[fi], last);
            int k = 0;
            while (k < fileHits.Length) {
                if (an == acc.Length) { acc = SourceDiscovery._growStrings(acc, an); }
                acc[an] = fileHits[k]; an = an + 1;
                k = k + 1;
            }
            fi = fi + 1;
        }
        string[] r = new string[an];
        int j = 0; while (j < an) { r[j] = acc[j]; j = j + 1; }
        return r;
    }

    // 一段目录展开：字面段直接拼（存在才留），通配段走 Path.Glob 后只留目录。
    private static string[] _dirStep(string dir, string seg) {
        if (!SourceDiscovery._hasWildcard(seg)) {
            string cand = Path.Join(dir, seg);
            if (!Directory.Exists(cand)) { return new string[0]; }
            string[] one = new string[1]; one[0] = cand;
            return one;
        }
        string[] hits = Path.Glob(dir, seg);
        int n = 0;
        int i = 0;
        while (i < hits.Length) { if (Directory.Exists(hits[i])) { n = n + 1; } i = i + 1; }
        string[] r = new string[n];
        int j = 0;
        i = 0;
        while (i < hits.Length) {
            if (Directory.Exists(hits[i])) { r[j] = hits[i]; j = j + 1; }
            i = i + 1;
        }
        return r;
    }

    private static bool _hasWildcard(string s) {
        int i = 0;
        while (i < s.Length) {
            char c = s.CharAt(i);
            if (c == '*' || c == '?') { return true; }
            i = i + 1;
        }
        return false;
    }

    private static string[] _splitSlash(string s) {
        int n = 1;
        int i = 0;
        while (i < s.Length) { if (s.CharAt(i) == '/') { n = n + 1; } i = i + 1; }
        string[] r = new string[n];
        int start = 0;
        int k = 0;
        i = 0;
        while (i < s.Length) {
            if (s.CharAt(i) == '/') {
                r[k] = s.Substring(start, i - start); k = k + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        r[k] = s.Substring(start, s.Length - start);
        return r;
    }

    private static string[] _growStrings(string[] a, int n) {
        string[] b = new string[n * 2];
        int k = 0; while (k < n) { b[k] = a[k]; k = k + 1; }
        return b;
    }

    // 排除产物目录（dist/.cache 任意层级出现）+ 调用方传入的 exclude glob。
    private static bool _excluded(string projectDir, string p, string[] excludes, int excludeCount) {
        string rel = p;
        if (p.StartsWith(projectDir)) { rel = p.Substring(projectDir.Length, p.Length - projectDir.Length); }
        if (rel.Contains("/dist/") || rel.Contains("/.cache/")
            || rel.StartsWith("dist/") || rel.StartsWith(".cache/")
            || rel.StartsWith("/dist/") || rel.StartsWith("/.cache/")) { return true; }
        int ei = 0;
        while (ei < excludeCount) {
            if (SourceDiscovery._matchesExclude(rel, excludes[ei])) { return true; }
            ei = ei + 1;
        }
        return false;
    }

    // exclude glob 匹配（相对路径 rel vs pattern）。支持 `<prefix>/**`（prefix 下全部）、
    // `**/<suffix>`（后缀，如 `**/*.z42`）、精确相对路径 / basename。leading `/` 归一化。
    private static bool _matchesExclude(string rel, string pattern) {
        string r = rel;
        if (r.StartsWith("/")) { r = r.Substring(1, r.Length - 1); }
        if (pattern.EndsWith("/**")) {
            string prefix = pattern.Substring(0, pattern.Length - 3);
            return r == prefix || r.StartsWith(prefix + "/");
        }
        if (pattern.StartsWith("**/")) {
            string suffix = pattern.Substring(3, pattern.Length - 3);
            return r == suffix || r.EndsWith("/" + suffix) || r.EndsWith(suffix);
        }
        return r == pattern || r.EndsWith("/" + pattern);
    }

    private static bool _contains(string[] a, int n, string s) {
        int i = 0;
        while (i < n) {
            if (a[i] == s) { return true; }
            i = i + 1;
        }
        return false;
    }
}
