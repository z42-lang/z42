// BuildLayout.Display 中**依赖当前目录形状**的那几条断言。
//
// 为什么单独一个文件：`Display` 内部读 `Environment.GetCurrentDirectory()`，没有注入点。
// 下面三条都隐含同一个前提——**cwd 是一个有父目录的深路径**，桌面上永远成立，但
// 嵌入式 tier-2（wasm / Android app 进程）的 cwd 就是文件系统根 `/`：
//
//   cwd = "/" 时：GetDirectoryName("/") → ""，Join("", "artifacts") → "artifacts"（相对！），
//   而 Join("/", "artifacts/debug/.cache") → "/artifacts/debug/.cache" 只有 24 字符，
//   比它的相对形式 "../artifacts/debug/.cache"（25 字符）**还短** ⇒ Display 按设计回落绝对路径。
//
// 也就是说这三条在 cwd == "/" 下失败**不是 Display 的缺陷**，是测试对环境的假设不成立。
// 故按 `z42.io/operating_system`（排除理由同样是 current_dir）的既有先例，把它们隔离到
// 本文件，由 `scripts/test/xtask_test_embedded_golden.z42` 的 `_targetExcludes` 挡在
// tier-2 之外；同目录 `build_layout.z42` 里与 cwd 无关的 8 条继续在全部目标上跑。
namespace Z42ProjectBuildLayoutDisplayCwdTests;

using Std;
using Std.IO;
using Std.Test;
using Z42.Build.Project;

// 当前目录之下 → `./` 相对形式。
[Test]
void test_display_under_cwd_is_dotted_relative() {
    string cwd = Environment.GetCurrentDirectory();
    Assert.Equal("./artifacts/debug/.cache",
                 BuildLayout.Display(Path.Join(cwd, "artifacts/debug/.cache")));
}

// 上级目录 → `../x`（子目录里 `z42 clean` 的场景；与同屏的 `../dist` 一致）。
[Test]
void test_display_parent_uses_dotdot() {
    string cwd = Path.Normalize(Environment.GetCurrentDirectory());
    string parent = Path.GetDirectoryName(cwd);
    Assert.Equal("../artifacts", BuildLayout.Display(Path.Join(parent, "artifacts")));
}

// `/./` 这类未规范化输入先被规范化再呈现。
[Test]
void test_display_normalizes_dot_segments() {
    string cwd = Environment.GetCurrentDirectory();
    Assert.Equal("./artifacts", BuildLayout.Display(Path.Join(cwd, ".") + "/artifacts"));
}
