// BuildLayout：产物目录的级联解析（z42c 写、launcher run 找、z42b clean 删共用）。
namespace Z42ProjectBuildLayoutTests;

using Std;
using Std.IO;
using Std.Test;
using Z42.Build.Project;

ProjectManifest _pm(string buildSection) {
    return ManifestLoader.ParseText("[project]\nname = \"app\"\nkind = \"exe\"\n" + buildSection);
}

// 无 [build]：dist = <工程>/dist（历史默认），output/cache/generated 在 artifacts/<profile> 下。
[Test]
void test_defaults() {
    BuildLayout l = BuildLayout.Resolve(_pm(""), "/p/app", false);
    Assert.Equal("/p/app/dist", l.DistDir);
    Assert.Equal("/p/app/artifacts/debug", l.OutputDir);
    Assert.Equal("/p/app/artifacts/debug/.cache", l.CacheDir);
    Assert.Equal("/p/app/artifacts/debug/generated", l.GeneratedDir);
    Assert.False(l.OutputDirConfigured);

    BuildLayout r = BuildLayout.Resolve(_pm(""), "/p/app", true);
    Assert.Equal("release", r.Profile);
    Assert.Equal("/p/app/artifacts/release/.cache", r.CacheDir);
    Assert.Equal("/p/app/dist", r.DistDir);
}

// 显式 output_dir：dist / cache 都从它派生；相对路径按工程目录解析。
[Test]
void test_configured_output_dir_cascades() {
    BuildLayout l = BuildLayout.Resolve(_pm("[build]\noutput_dir = \"out/${profile}\"\n"), "/p/app", true);
    Assert.Equal("/p/app/out/release", l.OutputDir);
    Assert.Equal("/p/app/out/release/dist", l.DistDir);
    Assert.Equal("/p/app/out/release/.cache", l.CacheDir);
    Assert.True(l.OutputDirConfigured);
}

// 只配 dist_dir：${output_dir} 仍取默认 artifacts/<profile>。
[Test]
void test_configured_dist_dir_uses_default_output() {
    BuildLayout l = BuildLayout.Resolve(_pm("[build]\ndist_dir = \"${output_dir}/bin\"\n"), "/p/app", false);
    Assert.Equal("/p/app/artifacts/debug/bin", l.DistDir);
}

// generated_dir 显式 "" = 不落盘。
[Test]
void test_generated_dir_disabled() {
    BuildLayout l = BuildLayout.Resolve(_pm("[build]\ngenerated_dir = \"\"\n"), "/p/app", false);
    Assert.Equal("", l.GeneratedDir);
}

// ── Display：产物目录呈现给终端（fix-cli-path-display）────────────────────────
//
// 解析出的 output/cache/generated 一律绝对（z42c 要拿它建目录写文件），但直接打到终端上
// 既冗长、又与同一屏里相对的 `wrote -> ./dist/…` 割裂。Display 只管呈现，不改实际取值。

// 当前目录之下 → `./` 相对形式。
[Test]
void test_display_under_cwd_is_dotted_relative() {
    string cwd = Environment.GetCurrentDirectory();
    Assert.Equal("./artifacts/debug/.cache",
                 BuildLayout.Display(Path.Join(cwd, "artifacts/debug/.cache")));
}

// 就是当前目录本身 → `.`。
[Test]
void test_display_cwd_itself() {
    Assert.Equal(".", BuildLayout.Display(Environment.GetCurrentDirectory()));
}

// 上级目录 → `../x`（子目录里 `z42 clean` 的场景；与同屏的 `../dist` 一致）。
[Test]
void test_display_parent_uses_dotdot() {
    string cwd = Path.Normalize(Environment.GetCurrentDirectory());
    string parent = Path.GetDirectoryName(cwd);
    Assert.Equal("../artifacts", BuildLayout.Display(Path.Join(parent, "artifacts")));
}

// 本就是相对路径（默认 dist = `./dist`）→ 统一补 `./`，不被规范化吃掉。
[Test]
void test_display_relative_input_keeps_dot_prefix() {
    Assert.Equal("./dist", BuildLayout.Display("./dist"));
    Assert.Equal("./dist", BuildLayout.Display("dist"));
    Assert.Equal("../dist", BuildLayout.Display("../dist"));
}

// `/./` 这类未规范化输入先被规范化再呈现。
[Test]
void test_display_normalizes_dot_segments() {
    string cwd = Environment.GetCurrentDirectory();
    Assert.Equal("./artifacts", BuildLayout.Display(Path.Join(cwd, ".") + "/artifacts"));
}

// 与 cwd 分叉很深时回落绝对路径（不吐一串 `../../../..`）。
[Test]
void test_display_falls_back_to_absolute_when_relative_is_longer() {
    Assert.Equal("/x", BuildLayout.Display("/x"));
}

// Resolve 不再把 `.` 段带进产物目录（本次要修的根因）。
[Test]
void test_resolve_normalizes_dot_project_dir() {
    BuildLayout l = BuildLayout.Resolve(_pm(""), ".", false);
    Assert.True(!l.OutputDir.Contains("/./"));
    Assert.True(!l.CacheDir.Contains("/./"));
    Assert.True(!l.ProjectDir.EndsWith("/."));
}
