// SourceDiscovery 的 glob 展开回归测试。
//
// 核心回归：**目录段带通配**（`a/*/c.z42`）此前被当成字面目录名 `*` 去找，静默返回空数组。
// 静默返回空是最坏的失败形态——调用方（z42b 按 `[tests] include` 发现测试目标）看到的是
// 「这个包没有测试」，与「真的没有测试」不可区分。
namespace Z42ProjectSourceDiscoveryTests;

using Std;
using Std.IO;
using Std.Test;
using Z42.Build.Project;

// 造一棵固定的临时源树，返回根目录：
//   <root>/tests/one.z42
//   <root>/tests/alpha/source.z42
//   <root>/tests/alpha/helper.z42
//   <root>/tests/beta/source.z42
string _mkTree() {
    string root = Directory.CreateTempDir("z42-srcdisc");
    Directory.Create(Path.Join(root, "tests"));
    Directory.Create(Path.Join(root, Path.Join("tests", "alpha")));
    Directory.Create(Path.Join(root, Path.Join("tests", "beta")));
    File.WriteAllText(Path.Join(root, Path.Join("tests", "one.z42")), "// one\n");
    File.WriteAllText(Path.Join(root, Path.Join("tests", Path.Join("alpha", "source.z42"))), "// a\n");
    File.WriteAllText(Path.Join(root, Path.Join("tests", Path.Join("alpha", "helper.z42"))), "// h\n");
    File.WriteAllText(Path.Join(root, Path.Join("tests", Path.Join("beta", "source.z42"))), "// b\n");
    return root;
}

string[] _discover(string root, string pattern) {
    string[] inc = new string[1];
    inc[0] = pattern;
    return SourceDiscovery.DiscoverWithExclude(root, inc, 1, new string[0], 0);
}

// 目录段带 `*`：两个子目录各命中一个 source.z42。修复前返回 0 个（静默空）。
[Test]
[Skip(platform: "wasm", reason: "wasm 沙箱没有真实文件系统，造不了临时源树")]
void test_wildcard_directory_segment_expands() {
    string root = _mkTree();
    string[] hits = _discover(root, "tests/*/source.z42");
    Assert.Equal(2, hits.Length);
    Assert.True(hits[0].EndsWith("/tests/alpha/source.z42"));
    Assert.True(hits[1].EndsWith("/tests/beta/source.z42"));
}

// 单层（无目录通配）不受影响：只认 tests/ 直下的文件，不下钻。
[Test]
[Skip(platform: "wasm", reason: "wasm 沙箱没有真实文件系统，造不了临时源树")]
void test_single_level_glob_unchanged() {
    string root = _mkTree();
    string[] hits = _discover(root, "tests/*.z42");
    Assert.Equal(1, hits.Length);
    Assert.True(hits[0].EndsWith("/tests/one.z42"));
}

// `<prefix>/**/<suffix>` 递归档不受影响：整个子目录一起进来（目录单元靠它带上兄弟文件）。
[Test]
[Skip(platform: "wasm", reason: "wasm 沙箱没有真实文件系统，造不了临时源树")]
void test_recursive_glob_picks_up_sibling_files() {
    string root = _mkTree();
    string[] hits = _discover(root, "tests/alpha/**/*.z42");
    Assert.Equal(2, hits.Length);
    Assert.True(hits[0].EndsWith("/tests/alpha/helper.z42"));
    Assert.True(hits[1].EndsWith("/tests/alpha/source.z42"));
}

// 目录段通配匹配不到任何目录 → 空（不是报错）。
[Test]
[Skip(platform: "wasm", reason: "wasm 沙箱没有真实文件系统，造不了临时源树")]
void test_wildcard_directory_no_match_is_empty() {
    string root = _mkTree();
    string[] hits = _discover(root, "nope/*/source.z42");
    Assert.Equal(0, hits.Length);
}

// ── rooted 字面文件路径直通（add-single-file-run）────────────────────────────
//
// 单文件运行把用户源文件的**绝对路径**写进合成清单的 include，而合成清单住在缓存目录里——
// 源文件在 projectDir 之外，与 projectDir 拼接必然落空。改动前实测：`no sources matched`。

// 清单外的绝对路径命中，且返回的就是 include 里给的那个路径。
[Test]
[Skip(platform: "wasm", reason: "wasm 沙箱没有真实文件系统，造不了临时源树")]
void test_rooted_literal_path_outside_project_is_found() {
    string root = _mkTree();
    string outside = Path.Join(root, Path.Join("tests", "one.z42"));
    // projectDir 故意指向一个**不包含**该文件的目录（模拟缓存目录里的合成清单）。
    string[] hits = _discover(Path.Join(root, Path.Join("tests", "beta")), outside);
    Assert.Equal(1, hits.Length);
    Assert.Equal(outside, hits[0]);
}

// 绝对路径不存在 → 零个（交给上层报 no sources matched），不是报错也不是崩溃。
[Test]
[Skip(platform: "wasm", reason: "wasm 沙箱没有真实文件系统，造不了临时源树")]
void test_rooted_literal_path_missing_is_empty() {
    string root = _mkTree();
    string[] hits = _discover(root, Path.Join(root, "does-not-exist.z42"));
    Assert.Equal(0, hits.Length);
}

// rooted 但**含通配符** → 不进字面直通分支，仍交给既有 glob 展开。
//
// 既有 glob 分支把 pattern 当成**相对 projectDir** 的模式逐段展开，因此一个 rooted 模式
// 在它那里本来就匹配不到东西（改动前如此，本次不改）——这里断言 0 正是为了钉住
// 「字面直通只认无通配符的 rooted 路径、不越界接管 glob 模式」这条边界。
[Test]
[Skip(platform: "wasm", reason: "wasm 沙箱没有真实文件系统，造不了临时源树")]
void test_rooted_pattern_with_wildcard_not_taken_by_literal_branch() {
    string root = _mkTree();
    string[] hits = _discover(root, Path.Join(root, Path.Join("tests", "*.z42")));
    Assert.Equal(0, hits.Length);
}

// 🔴 相对字面路径的语义**必须不变**：仍按相对 projectDir 解析，不得改成相对进程工作目录。
// 普通工程写 `include = ["src/Main.z42"]` 靠的就是这条；直通分支限定 rooted 正是为了护住它。
[Test]
[Skip(platform: "wasm", reason: "wasm 沙箱没有真实文件系统，造不了临时源树")]
void test_relative_literal_path_still_resolves_against_project_dir() {
    string root = _mkTree();
    string[] hits = _discover(root, "tests/one.z42");
    Assert.Equal(1, hits.Length);
    Assert.True(hits[0].EndsWith("/tests/one.z42"));
}
