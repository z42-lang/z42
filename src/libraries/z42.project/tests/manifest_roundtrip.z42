// z42.project ManifestLoader 首个 GREEN（converge-onto-z42-project 阶段 1）：
// .z42.toml → **组合式** ProjectManifest / WorkspaceManifest 模型 round-trip。
namespace Z42ProjectRoundtripTests;

using Std;
using Std.Test;
using Z42.Build.Project;

[Test]
void test_project_manifest_roundtrip() {
    string toml = "[project]\nname = \"demo\"\nversion = \"1.2.3\"\nkind = \"exe\"\nentry = \"Main\"\n\n[sources]\ninclude = [\"src/**/*.z42\"]\nexclude = [\"src/gen/**\"]\n\n[dependencies]\n\"z42.core\" = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    // [project] → 组合式 m.Project.*
    Assert.Equal("demo", m.Project.Name);
    Assert.Equal("1.2.3", m.Project.Version);
    Assert.Equal("exe", m.Project.Kind);
    Assert.Equal(true, m.Project.HasEntry);
    Assert.Equal("Main", m.Project.Entry);
    // [sources] → 组合式 m.Sources.*
    Assert.Equal(1, m.Sources.IncludeCount);
    Assert.Equal("src/**/*.z42", m.Sources.Include[0]);
    Assert.Equal(1, m.Sources.ExcludeCount);
    Assert.Equal("src/gen/**", m.Sources.Exclude[0]);
    // [dependencies] → 顶层 m.Deps
    Assert.Equal(1, m.DepCount);
    Assert.Equal("z42.core", m.Deps[0].Name);
    Assert.Equal("0.1.0", m.Deps[0].Version);
}

[Test]
void test_workspace_manifest_roundtrip() {
    string toml = "[workspace]\nmembers = [\"*\"]\ndefault-members = [\"a\", \"b\"]\n\n[workspace.build]\noutput_dir = \"out/${member_name}\"\ncache_dir = \"${output_dir}/cache\"\n";
    WorkspaceManifest w = ManifestLoader.ParseWorkspaceText(toml);
    Assert.Equal(1, w.MemberCount);
    Assert.Equal("*", w.Members[0]);
    Assert.Equal(2, w.DefaultCount);
    Assert.Equal("a", w.DefaultMembers[0]);
    Assert.Equal("b", w.DefaultMembers[1]);
    Assert.Equal(true, w.HasOutputDir);
    Assert.Equal("out/${member_name}", w.OutputDir);   // 路径模板原样保留
    Assert.Equal("${output_dir}/cache", w.CacheDir);
}

// ── [optimize] 逐 pass 具名开关（add-compiler-inlining；解析 support 侧，消费受两-nightly 纪律）──
[Test]
void test_optimize_section_parsed() {
    // 用真实带连字符的 pass 名（与编译器 Opt.ByName 串一致）验证连字符裸键解析。
    string toml = "[project]\nname = \"o\"\nversion = \"0.1.0\"\n\n[optimize]\ninline = true\nconst-fold = false\ncopy-prop = true\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(3, m.OptimizeCount);
    // 键序不保证 → 按名查
    bool sawInline = false; bool sawCf = false; bool sawCp = false;
    int i = 0;
    while (i < m.OptimizeCount) {
        if (m.OptimizeNames[i] == "inline")     { sawInline = true; Assert.Equal(true,  m.OptimizeValues[i]); }
        if (m.OptimizeNames[i] == "const-fold") { sawCf     = true; Assert.Equal(false, m.OptimizeValues[i]); }
        if (m.OptimizeNames[i] == "copy-prop")  { sawCp     = true; Assert.Equal(true,  m.OptimizeValues[i]); }
        i = i + 1;
    }
    Assert.True(sawInline);
    Assert.True(sawCf);
    Assert.True(sawCp);
}

[Test]
void test_optimize_section_absent_empty() {
    string toml = "[project]\nname = \"o\"\nversion = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.OptimizeCount);   // 缺 [optimize] → 空（消费方回落 profile 默认）
}

// ── [analyzers] 编译期 handler zpkg 引用（attribute-handler-registry D9）───────
[Test]
void test_analyzers_section_parsed() {
    // [analyzers] 值同 [dependencies]（版本串），复用 _parseDeps → DepEntry。
    string toml = "[project]\nname = \"a\"\nversion = \"0.1.0\"\n\n[analyzers]\n\"demo.noemptycatch\" = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(1, m.AnalyzerCount);
    Assert.Equal("demo.noemptycatch", m.Analyzers[0].Name);
    Assert.Equal("0.1.0", m.Analyzers[0].Version);
}

[Test]
void test_analyzers_section_absent_empty() {
    string toml = "[project]\nname = \"a\"\nversion = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.AnalyzerCount);   // 缺 [analyzers] → 空（无外部 handler 加载）
}
