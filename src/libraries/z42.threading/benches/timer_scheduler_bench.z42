// requires-caps: threads
namespace Z42TimerSchedulerBench;
using Std.Threading;
using Std.Harness;

[Benchmark]
void timer_waiting_create_cancel_32(Bencher b) {
    b.iter(() => {
        Timer[] timers = new Timer[32];
        for (int i = 0; i < timers.Length; i++) { timers[i] = Timer.StartOnce(60000, () => {}); }
        for (int i = 0; i < timers.Length; i++) { timers[i].Stop(); }
        for (int i = 0; i < timers.Length; i++) { timers[i].StopAndJoin(); }
        GC.KeepAlive(timers);
    });
}

[Benchmark]
void timer_is_running_128(Bencher b) {
    Timer timer = Timer.StartOnce(60000, () => {});
    try {
        b.iter(() => {
            int count = 0;
            for (int i = 0; i < 128; i++) { if (timer.IsRunning()) { count = count + 1; } }
            GC.KeepAlive(count);
        });
    } finally { timer.StopAndJoin(); }
}
