namespace Std.Threading;

using Std;

// 2026-05-20 add-sync-primitives-rwlock: multi-reader / single-writer lock.
//
// Two RAII callback methods mirroring `Mutex<T>.Lock(Func<T,T>)`:
//   - `Read(Action<T>)` lets multiple threads see a snapshot of the
//     current value concurrently. Mutations inside the body do NOT
//     propagate to the stored value (closure §4.1 value-snapshot capture).
//     Export observations through static fields / shared objects like Mutex.
//   - `Write(Func<T,T>)` acquires exclusively (blocks all readers + other
//     writers); body returns the new stored value.
//
// store-sync-values-in-heap (2026-09-14): written in z42 on top of `MonitorNative`.
// The value is the `_value` field (GC-visible); the runtime holds no value.
//
//   - A reader holds the monitor only while it bumps `_readers` in and out —
//     the body runs without it, so readers run concurrently.
//   - A writer holds the monitor for its whole body, after waiting for the
//     active readers to drain. Readers arriving meanwhile block on the monitor.
//   - Write-preferring: while a writer is waiting (`_writersWaiting > 0`), new
//     readers wait too, so a read-heavy load cannot starve writers.
//
// Reentrancy on the same thread:
//   - `Write` inside `Write`, or `Read` inside `Write` → throws (the monitor
//     rejects re-entry by its holder).
//   - `Write` inside `Read` waits for its own read to finish, and `Read` inside
//     `Read` waits if a writer queued up in between — both self-deadlock, as
//     with any read-write lock. Do not nest acquisitions of the same RwLock.
//
// Usage:
//   var config = new RwLock<long>(0);
//   // 50 readers in parallel:
//   config.Read((long v) => { Stats.Last = v; });
//   // Occasional update:
//   config.Write((long v) => v + 1);
public class RwLock<T> {
    private object _mon;
    private T _value;
    private int _readers;
    private int _writersWaiting;

    public RwLock(T initial) {
        this._mon = MonitorNative.New();
        this._value = initial;
        this._readers = 0;
        this._writersWaiting = 0;
    }

    // Multi-reader. Body sees a snapshot of the current value.
    public void Read(Action<T> body) {
        MonitorNative.Enter(this._mon);
        T snapshot;
        try {
            while (this._writersWaiting > 0) {
                MonitorNative.Wait(this._mon);
            }
            this._readers = this._readers + 1;
            snapshot = this._value;
        } finally {
            MonitorNative.Exit(this._mon);
        }
        try {
            body(snapshot);
        } finally {
            this._leaveRead();
        }
    }

    // Exclusive writer. body returns the new value to store.
    public void Write(Func<T, T> body) {
        MonitorNative.Enter(this._mon);
        try {
            this._writersWaiting = this._writersWaiting + 1;
            try {
                while (this._readers > 0) {
                    MonitorNative.Wait(this._mon);
                }
            } finally {
                this._writersWaiting = this._writersWaiting - 1;
            }
            this._value = body(this._value);
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }

    // 2026-05-20 add-sync-primitives-try-variants: non-blocking shared
    // acquire. If a writer holds or is waiting for the lock, returns false
    // and body is NOT invoked. On success returns true and body has already
    // run + the read released.
    public bool TryRead(Action<T> body) {
        if (!MonitorNative.TryEnter(this._mon)) {
            return false;
        }
        bool ok = false;
        T snapshot = default(T);
        try {
            if (this._writersWaiting == 0) {
                this._readers = this._readers + 1;
                snapshot = this._value;
                ok = true;
            }
        } finally {
            MonitorNative.Exit(this._mon);
        }
        if (!ok) {
            return false;
        }
        try {
            body(snapshot);
        } finally {
            this._leaveRead();
        }
        return true;
    }

    // 2026-05-20 add-sync-primitives-try-variants: non-blocking exclusive
    // acquire. If any reader OR writer holds the lock, returns false and
    // body is NOT invoked. On success runs the body, stores its return,
    // releases the lock, returns true.
    public bool TryWrite(Func<T, T> body) {
        if (!MonitorNative.TryEnter(this._mon)) {
            return false;
        }
        bool ok = false;
        try {
            if (this._readers == 0) {
                ok = true;
                this._value = body(this._value);
            }
        } finally {
            MonitorNative.Exit(this._mon);
        }
        return ok;
    }

    private void _leaveRead() {
        MonitorNative.Enter(this._mon);
        try {
            this._readers = this._readers - 1;
        } finally {
            MonitorNative.Exit(this._mon);    // wakes a writer waiting for readers to drain
        }
    }
}
