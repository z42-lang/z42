namespace Std.Threading;


/// 多读单写的读写锁，同样是「锁包着数据」的回调形态。读者并发跑，写者独占，写者优先。
///
/// 不可重入：Write 里套 Write、Write 里套 Read 抛 LockRecursionException；Read 里套 Write、
/// 以及夹在写者后面的 Read 里套 Read 会自死锁——不要在同一个 RwLock 上嵌套获取。
public class RwLock<T> {
    // 读者只在进出增减 _readers 时短暂持锁，回调体不持锁 → 读者并发跑；写者等读者归零后独占；
    // 有写者排队（_writersWaiting > 0）时新读者也等，避免读多写少饿死写者。
    private object _mon;
    private T _value;
    private int _readers;
    private int _writersWaiting;

    /// 用 initial 作为初始被保护值。
    public RwLock(T initial) {
        this._mon = MonitorNative.New();
        this._value = initial;
        this._readers = 0;
        this._writersWaiting = 0;
    }

    /// 共享获取：body 拿到当前值的一份快照。body 没有返回值，改不了存储的值。
    public void Read(Action<T> body) {
        MonitorNative.Enter(this._mon);
        T snapshot;
        try {
            while (this._writersWaiting > 0) {
                MonitorNative.Wait(this._mon);
            }
            this._readers = this._readers + 1;
            snapshot = this._value;
        } finally {
            MonitorNative.Exit(this._mon);
        }
        try {
            body(snapshot);
        } finally {
            this._leaveRead();
        }
    }

    /// 独占获取（挡住所有读者和其他写者）：body 的返回值成为新的存储值。
    public void Write(Func<T, T> body) {
        MonitorNative.Enter(this._mon);
        try {
            this._writersWaiting = this._writersWaiting + 1;
            try {
                while (this._readers > 0) {
                    MonitorNative.Wait(this._mon);
                }
            } finally {
                this._writersWaiting = this._writersWaiting - 1;
            }
            this._value = body(this._value);
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }

    /// 非阻塞共享获取：拿不到就返回 false 且不调用 body；成功时 body 已跑完、读已释放，返回 true。
    public bool TryRead(Action<T> body) {
        if (!MonitorNative.TryEnter(this._mon)) {
            return false;
        }
        bool ok = false;
        T snapshot = default(T);
        try {
            if (this._writersWaiting == 0) {
                this._readers = this._readers + 1;
                snapshot = this._value;
                ok = true;
            }
        } finally {
            MonitorNative.Exit(this._mon);
        }
        if (!ok) {
            return false;
        }
        try {
            body(snapshot);
        } finally {
            this._leaveRead();
        }
        return true;
    }

    /// 非阻塞独占获取：有任何读者或写者占着就返回 false 且不调用 body；成功时返回 true，值已写回。
    public bool TryWrite(Func<T, T> body) {
        if (!MonitorNative.TryEnter(this._mon)) {
            return false;
        }
        bool ok = false;
        try {
            if (this._readers == 0) {
                ok = true;
                this._value = body(this._value);
            }
        } finally {
            MonitorNative.Exit(this._mon);
        }
        return ok;
    }

    private void _leaveRead() {
        MonitorNative.Enter(this._mon);
        try {
            this._readers = this._readers - 1;
        } finally {
            MonitorNative.Exit(this._mon);    // 唤醒一个等待读者归零的写者
        }
    }
}
