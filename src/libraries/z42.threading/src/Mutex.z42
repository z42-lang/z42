namespace Std.Threading;


/// 锁包着数据的互斥原语：被保护的值放在 Mutex<T> 内部，只有 Lock 的回调体能碰到它。
///
/// 没有 Acquire / Release，Lock 自己配对；不可重入，重入抛 LockRecursionException。
public class Mutex<T> {
    private object _mon;
    // 值存在普通字段 _value 里（对 GC 可见）；运行时只提供锁（MonitorNative），不存值。
    private T _value;

    /// 用 initial 作为初始被保护值。
    public Mutex(T initial) {
        this._mon = MonitorNative.New();
        this._value = initial;
    }

    /// 取锁 → 用当前值调用 body → 把 body 的返回值写回 → 放锁。
    ///
    /// 整段对其他线程的 Lock / Read / Update 是原子的。
    /// 需要带出结果时使用 Read 或 Update。
    public void Lock(Func<T, T> body) {
        // try/finally：body 抛异常时写回被跳过（值不变），锁照样释放。
        MonitorNative.Enter(this._mon);
        try {
            this._value = body(this._value);
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }

    /// 在排他锁内读取当前值并返回 body 的结果，不替换被保护的值。
    /// 引用类型的内部修改不会被限制；body 抛异常时仍释放锁并传播原异常。
    public TResult Read<TResult>(Func<T, TResult> body) {
        MonitorNative.Enter(this._mon);
        try {
            return body(this._value);
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }

    /// 在排他锁内用当前值调用 body，将其二元组的 Item1 写回，并返回 Item2。
    /// body 抛异常时不执行字段写回，释放锁并传播原异常；已发生的引用对象内部修改不回滚。
    public TResult Update<TResult>(Func<T, (T, TResult)> body) {
        MonitorNative.Enter(this._mon);
        try {
            (next, result) = body(this._value);
            this._value = next;
            return result;
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }
}
