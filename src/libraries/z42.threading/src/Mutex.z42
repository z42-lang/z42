namespace Std.Threading;


/// 锁包着数据的互斥原语：被保护的值放在 Mutex<T> 内部，只有 Lock 的回调体能碰到它。
///
/// 没有 Acquire / Release，Lock 自己配对；不可重入，重入抛 LockRecursionException。
public class Mutex<T> {
    private object _mon;
    // 值存在普通字段 _value 里（对 GC 可见）；运行时只提供锁（MonitorNative），不存值。
    private T _value;

    /// 用 initial 作为初始被保护值。
    public Mutex(T initial) {
        this._mon = MonitorNative.New();
        this._value = initial;
    }

    /// 取锁 → 用当前值调用 body → 把 body 的返回值写回 → 放锁。
    ///
    /// 整段对其他线程的 Lock 是原子的。没有返回值：想把锁内读到的值带出来，在
    /// body 里写静态字段或 1 元数组单元。
    public void Lock(Func<T, T> body) {
        // try/finally：body 抛异常时写回被跳过（值不变），锁照样释放。
        MonitorNative.Enter(this._mon);
        try {
            this._value = body(this._value);
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }
}
