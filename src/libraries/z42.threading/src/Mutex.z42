namespace Std.Threading;

using Std;

// 2026-05-20 add-sync-primitives: exclusive critical section primitive.
//
// store-sync-values-in-heap (2026-09-14): the value lives in `_value`, an ordinary
// field — visible to the GC like any other object reference. The runtime only
// provides the lock (`MonitorNative`), never the storage. (The previous
// implementation kept the value inside a Rust-side `parking_lot::Mutex<Value>`
// that no GC root covered, so a value held only by the Mutex was collected.)
//
// `Lock` wraps the body in try/finally: if the callback throws, the assignment
// is skipped (the stored value stays unchanged) and the lock is still released.
//
// Non-reentrant: calling `Lock` again on the same instance from inside its own
// body throws (the monitor rejects re-entry by its holder) instead of
// deadlocking. Restructure the code rather than relying on reentrancy.
//
// Usage:
//   var counter = new Mutex<long>(0);
//   counter.Lock((v) => v + 1);
public class Mutex<T> {
    private object _mon;
    private T _value;

    public Mutex(T initial) {
        this._mon = MonitorNative.New();
        this._value = initial;
    }

    // Acquire the lock, invoke `body` with the current stored value, write
    // back its return value, then release the lock — atomically with
    // respect to other threads' Lock calls on the same Mutex.
    public void Lock(Func<T, T> body) {
        MonitorNative.Enter(this._mon);
        try {
            this._value = body(this._value);
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }
}
