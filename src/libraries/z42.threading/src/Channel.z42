namespace Std.Threading;


/// 多生产者 / 多消费者 FIFO 队列。三种容量形态（无界 / 有界 / 会合）由构造器决定，之后不能改。
public class Channel<T> {
    private object _mon;
    private T[] _buf;          // 环形缓冲；存活项是 _buf[(_head + i) % _buf.Length]，i < _count
    private int _head;
    private int _count;
    private int _cap;          // -1 = 无界；> 0 = 有界；0 = 会合
    private bool _closed;
    private long _sent;        // 已入队总数
    private long _taken;       // 已出队总数（会合通道的发送者等自己的值被取走）
    private int _recvWaiting;  // 阻塞在 Recv 里的接收者数（会合通道 TrySend 只交接给一个）

    /// 无界构造器（默认）。队列按需扩容，没有上限；要背压用有界构造器。
    public Channel() {
        this._init(-1, 16);
    }

    /// 有界构造器。capacity > 0 有界（Send 在队列满时阻塞直到腾出位置）；capacity == 0 会合
    /// （每个 Send 阻塞直到这个值被另一条线程取走）。
    /// @throws ArgumentException capacity < 0 时。
    public Channel(int capacity) {
        if (capacity < 0) {
            throw new ArgumentException("Channel: capacity must be >= 0, got " + capacity.ToString());
        }
        int slots = capacity;
        if (slots == 0) { slots = 1; }
        this._init(capacity, slots);
    }

    private void _init(int cap, int slots) {
        this._mon = MonitorNative.New();
        this._buf = new T[slots];
        this._head = 0;
        this._count = 0;
        this._cap = cap;
        this._closed = false;
        this._sent = 0;
        this._taken = 0;
        this._recvWaiting = 0;
    }

    /// 按容量形态阻塞地发送 v。通道已关闭、或等待期间被关闭 → 抛 ChannelDisconnectedException("channel closed")。
    /// @throws ChannelDisconnectedException 通道已关闭或等待期间被关闭时。
    public void Send(T v) {
        MonitorNative.Enter(this._mon);
        try {
            if (this._closed) {
                throw new ChannelDisconnectedException("channel closed");
            }
            while (this._isFull()) {
                MonitorNative.Wait(this._mon);
                if (this._closed) {
                    throw new ChannelDisconnectedException("channel closed");
                }
            }
            long mine = this._enqueue(v);
            if (this._cap == 0) {
                while (this._taken < mine) {
                    MonitorNative.Wait(this._mon);
                }
            }
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }

    /// 阻塞到有值可取。通道已关闭且队列已空时抛 ChannelDisconnectedException("channel disconnected")；
    /// 队列里还有值就照常取，关闭不丢数据。
    /// @throws ChannelDisconnectedException 通道已关闭且队列已空时。
    public T Recv() {
        T v;
        MonitorNative.Enter(this._mon);
        try {
            this._recvWaiting = this._recvWaiting + 1;
            try {
                while (this._count == 0 && !this._closed) {
                    MonitorNative.Wait(this._mon);
                }
            } finally {
                this._recvWaiting = this._recvWaiting - 1;
            }
            if (this._count == 0) {
                throw new ChannelDisconnectedException("channel disconnected");
            }
            v = this._dequeue();
        } finally {
            MonitorNative.Exit(this._mon);
        }
        return v;
    }

    /// 不阻塞。返回判别式数组：[0, value]（取到值）/ [1]（暂时没值）/ [2]（已关闭且空）。
    /// 判别位是 long，用 (long)r[0] 取。
    public object[] TryRecv() {
        object[] result;
        MonitorNative.Enter(this._mon);
        try {
            if (this._count > 0) {
                result = new object[2];
                result[0] = (long)0;
                result[1] = this._dequeue();
            } else if (this._closed) {
                result = new object[1];
                result[0] = (long)2;
            } else {
                result = new object[1];
                result[0] = (long)1;
            }
        } finally {
            MonitorNative.Exit(this._mon);
        }
        return result;
    }

    /// 幂等关闭通道，不可撤销。已入队的值仍可取完；唤醒阻塞中的 Recv 和等位置的 Send。
    public void Close() {
        MonitorNative.Enter(this._mon);
        try {
            this._closed = true;
        } finally {
            MonitorNative.Exit(this._mon);
        }
    }

    /// 不阻塞发送，不抛异常。有界满、通道已关闭返回 false；会合通道只有在已有接收者阻塞在
    /// Recv 上时才返回 true。
    public bool TrySend(T v) {
        bool ok = false;
        MonitorNative.Enter(this._mon);
        try {
            if (!this._closed && !this._isFull()) {
                if (this._cap != 0 || this._recvWaiting > this._count) {
                    this._enqueue(v);
                    ok = true;
                }
            }
        } finally {
            MonitorNative.Exit(this._mon);
        }
        return ok;
    }

    // ── 内部实现：调用方已持有 monitor ──────────────────────────────────

    private bool _isFull() {
        if (this._cap < 0) { return false; }
        return this._count >= this._buf.Length;
    }

    // 入队 v（无界缓冲满时扩容）。返回其 1-based 序号。
    private long _enqueue(T v) {
        if (this._count == this._buf.Length) {
            this._grow();
        }
        int tail = (this._head + this._count) % this._buf.Length;
        this._buf[tail] = v;
        this._count = this._count + 1;
        this._sent = this._sent + 1;
        return this._sent;
    }

    private T _dequeue() {
        T v = this._buf[this._head];
        // 清空该槽位，避免已出队的值被缓冲继续持有。
        this._buf[this._head] = default(T);
        this._head = (this._head + 1) % this._buf.Length;
        this._count = this._count - 1;
        this._taken = this._taken + 1;
        return v;
    }

    private void _grow() {
        T[] bigger = new T[this._buf.Length * 2];
        int i = 0;
        while (i < this._count) {
            bigger[i] = this._buf[(this._head + i) % this._buf.Length];
            i = i + 1;
        }
        this._buf = bigger;
        this._head = 0;
    }
}
