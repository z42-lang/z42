namespace Std.Threading;
using Std.Diagnostics;

/// 一次性或周期性后台回调，共享等待调度和按需增长的回调工作线程。
///
/// 每次回调可能由不同工作线程执行，不保证线程亲和性；闲置后内部线程退出。
public sealed class Timer {
    private static TimerScheduler _scheduler = new TimerScheduler();
    internal TimerScheduler Owner;
    internal object Completion;
    internal Action Callback;
    internal long Interval;
    internal bool Periodic;
    internal bool Stopped;
    internal bool Assigned;
    internal bool Executing;
    internal bool Joined;
    internal string Failure;
    internal int HeapIndex;
    internal long Remaining;
    internal long LastMillis;
    internal long DueMillis;
    internal long Fraction;

    private Timer(Action callback, long interval, bool periodic) {
        this.Owner = Timer._scheduler;
        this.Completion = MonitorNative.New();
        this.Callback = callback;
        this.Interval = interval;
        this.Periodic = periodic;
        this.HeapIndex = -1;
    }

    /// 每 intervalMs 毫秒触发一次，首次在 +interval；回调完成后才开始下一轮等待。
    /// @throws ArgumentException intervalMs <= 0 时。
    /// @throws ThreadException 无法启动共享调度线程时。
    public static Timer StartPeriodic(long intervalMs, Action callback) {
        if (intervalMs <= 0) { throw new ArgumentException("Timer.StartPeriodic: intervalMs must be > 0"); }
        Timer timer = new Timer(callback, intervalMs, true);
        timer.Owner.Add(timer);
        return timer;
    }

    /// delayMs 之后触发一次；0 表示尽快调度。
    /// @throws ArgumentException delayMs < 0 时。
    /// @throws ThreadException 无法启动共享调度线程时。
    public static Timer StartOnce(long delayMs, Action callback) {
        if (delayMs < 0) { throw new ArgumentException("Timer.StartOnce: delayMs must be >= 0"); }
        Timer timer = new Timer(callback, delayMs, false);
        timer.Owner.Add(timer);
        return timer;
    }

    /// 幂等停止并立即返回；正在执行的回调可以结束。
    public void Stop() { this.Owner.Stop(this); }

    /// 停止并等待此 Timer 的已分派回调结束，不等待其他 Timer。
    /// @throws ThreadException 重复调用、自身回调内调用或后台日志失败时。
    ///
    /// 自身回调内调用先停止再抛异常，不消耗之后的外部 Join 机会。
    public void StopAndJoin() {
        this.Stop();
        try { MonitorNative.Enter(this.Completion); }
        catch (LockRecursionException e) { throw new ThreadException("cannot join the current thread"); }
        MonitorNative.Exit(this.Completion);
        MonitorNative.Enter(this.Owner.Gate);
        try {
            if (this.Joined) { throw new ThreadException("thread already joined"); }
            this.Joined = true;
            while (this.Assigned) { MonitorNative.Wait(this.Owner.Gate); }
            string failure = this.Failure;
            this.Failure = null;
            if (failure != null) { throw new ThreadException(failure); }
        } finally { MonitorNative.Exit(this.Owner.Gate); }
    }

    /// 已停止或一次性回调结束时为 false；尚在等待工作线程的任务仍为 true。
    public bool IsRunning() {
        // A single atomic flag snapshot, not a completion barrier.
        return !this.Stopped;
    }
    // The caller holds Completion. Returning this frame drops callback/exception
    // locals before Assigned is cleared and StopAndJoin may complete.
    internal string Invoke() {
        try {
            try {
                var callback = this.Callback;
                callback();
            } catch (Exception e) {
                string name = this.Periodic ? "Timer.StartPeriodic" : "Timer.StartOnce";
                Log.Error(name + ": callback threw: " + e.Message);
            }
            return null;
        } catch (Exception e) { return e.Message; }
    }
}
