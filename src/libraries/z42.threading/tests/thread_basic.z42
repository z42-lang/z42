// requires-caps: threads
// add-threading-stdlib (2026-05-20): smoke test — spawn an empty worker
// and join. Verifies the basic plumbing (Thread.Start → JoinHandle in
// VmCore.threads → join → JOIN_OK discriminator → quiet return).
namespace Z42ThreadingBasicTests;

using Std.Threading;
using Std.Harness;

[Test]
void test_spawn_empty_action_then_join() {
    Thread t = Thread.Start(() => { });
    t.Join();
    // No exception thrown is the success criterion. Add a sanity assert
    // so the test isn't "trivially passing" if `t.Join()` accidentally
    // becomes a no-op (e.g., short-circuit before native dispatch).
    Assert.True(t.SlotId() > 0);
}

[Test]
void test_join_after_join_throws_thread_exception() {
    Thread t = Thread.Start(() => { });
    t.Join();
    bool caught = false;
    try {
        t.Join();
    } catch (ThreadException e) {
        caught = true;
        Assert.True(e.Message.Length > 0);
    }
    Assert.True(caught);
}

[Test]
void test_self_join_throws_and_preserves_external_join() {
    Thread[] worker = new Thread[1];
    bool[] caught = new bool[1];
    Channel<int> ready = new Channel<int>(1);
    Channel<int> done = new Channel<int>(1);
    worker[0] = Thread.Start(() => {
        ready.Recv();
        try { worker[0].Join(); }
        catch (ThreadException e) {
            caught[0] = e.Message == "cannot join the current thread";
        }
        done.Send(1);
    });
    ready.Send(1);
    done.Recv();
    worker[0].Join();
    Assert.True(caught[0]);
    bool joined = false;
    try { worker[0].Join(); }
    catch (ThreadException e) { joined = e.Message == "thread already joined"; }
    Assert.True(joined);
}
