// requires-caps: threads
namespace Z42MonitorTimeoutTests;
using Std.Threading;
using Std.Harness;

[Test]
void test_zero_timeout_reacquires_and_negative_keeps_owner() {
    object monitor = MonitorNative.New();
    MonitorNative.Enter(monitor);
    try {
        Assert.False(MonitorNative.WaitFor(monitor, 0));
        Assert.False(MonitorNative.TryEnter(monitor));
        bool caught = false;
        try { MonitorNative.WaitFor(monitor, -1); }
        catch (ArgumentOutOfRangeException e) { caught = true; }
        Assert.True(caught);
        Assert.False(MonitorNative.TryEnter(monitor));
    } finally { MonitorNative.Exit(monitor); }
}

[Test]
void test_timeout_requires_owner_and_valid_handle() {
    bool owner = false;
    try { MonitorNative.WaitFor(MonitorNative.New(), 0); }
    catch (SynchronizationLockException e) { owner = true; }
    Assert.True(owner);
    bool invalid = false;
    try { MonitorNative.WaitFor("invalid", 0); }
    catch (ArgumentException e) { invalid = true; }
    Assert.True(invalid);
    bool missing = false;
    try { MonitorNative.WaitFor(null, 0); }
    catch (ArgumentNullException e) { missing = true; }
    Assert.True(missing);
}

[Test]
void test_finite_wait_expires_and_preserves_owner() {
    object monitor = MonitorNative.New();
    MonitorNative.Enter(monitor);
    try {
        bool expired = false;
        for (int i = 0; i < 100 && !expired; i++) {
            expired = !MonitorNative.WaitFor(monitor, 1);
        }
        Assert.True(expired);
        Assert.False(MonitorNative.TryEnter(monitor));
    } finally { MonitorNative.Exit(monitor); }
}

[Test]
void test_exit_wakes_long_wait_with_gc_and_no_lost_signal() {
    object monitor = MonitorNative.New();
    bool[] ready = new bool[1];
    MonitorNative.Enter(monitor);
    Thread worker = Thread.Start(() => {
        MonitorNative.Enter(monitor);
        try { GC.ForceCollect(); ready[0] = true; }
        finally { MonitorNative.Exit(monitor); }
    });
    try {
        while (!ready[0]) { MonitorNative.WaitFor(monitor, 9223372036854775807); }
        Assert.False(MonitorNative.TryEnter(monitor));
    } finally { MonitorNative.Exit(monitor); }
    worker.Join();
    Assert.True(ready[0]);
}
