//! 正则表达式编译与匹配。
//!
//! 把 pattern 字符串编译成 `Regex` 对象，再做匹配 / 查找 / 替换 / 切分。语法是常见正则的
//! 子集——够用于日志行解析、字段抽取、简单校验；不够用于需要 lookaround、backreference
//! 或 Unicode 属性类的场景。
//!
//! ## 转义契约
//!
//! 类外支持 `\n \t \r \d \D \w \W \s \S \b \B`；类内只支持 `\n \t \r`。
//! 转义后的其它 ASCII 字母或数字在 Compile 时抛 RegexException；标点、反斜杠及非 ASCII 字符按字面转义。
//! 词边界仅用于类外；类内 `\b` 不提供 backspace 语义，需要时使用实际控制字符。
//!
//! ## 不支持
//!
//! - **lookaround**：`(?=)` `(?!)` `(?<=)` `(?<!)`——编译报错
//! - **backreference**：pattern 里的 `\1`（编译报错）；replacement 里的 `$1` 是支持的
//! - **Unicode 属性类**：`\p{L}` / `\p{Greek}`；`\w` `\s` `\b` 全是 ASCII 定义
//! - **字符类内的转义类**：`[\d]` `[\w]` `[\s]`（编译报错）
//! - **`(?s)` / `(?x)` / 作用域 flag / pattern 中途改 flag**
//! - **占有量词**与**原子组**
//! - **`{,m}` 量词写法**
//! - **`\x` / `\u` 数值转义**（编译报错）
//! - **线性时间保证**：引擎是回溯式的，默认无上限；Compile(pattern, maxSteps) 可限制引擎步数，但不是时间或内存上限
//! - **并发复用同一个 `Regex`**：匹配状态存在实例字段上，多线程共享会互相踩
namespace Std.Regex;

using Std.Collections;

/// 编译后的 pattern：解析为 AST，提供匹配 / 查找 / 替换 / 切分方法。
///
/// 线程内复用；同一个 `Regex` 实例不要跨线程并发调用（匹配过程写实例字段）。
/// 调用退出时释放临时输入绑定和字符缓冲；返回的 Match 独立持有输入与捕获快照。
public class Regex {
    private long _maxSteps;
    private long _remainingSteps;
    private RegexProgram _program;
    private bool _anchoredStart;
    private int _groupCount;        // 1 + capturing groups（group 0 = entire match）

    // ── mutable match state ───────────────────────────────────────────────
    // 单线程模型；多次 Match 调用会 reset 这些字段。
    private string _input;
    // Bulk-materialised match subject (one `ToCharArray()` per public call, see
    // _BindInput) so the backtracking engine's repeated same-position reads are
    // O(1) array indexing instead of a `CharAt` builtin call each. `_input` is
    // kept for `.Length` / `.Substring`.
    private char[] _chars;
    private int[] _slots;
    private RegexInstruction[] _choices;
    // Each choice stores [position, trail length, final position, position step].
    // A zero step marks a single alternative.
    private int[] _choiceData;
    // Each recorded change stores a slot index and its previous value.
    private int[] _trail;
    private int _choiceCount;
    private int _trailCount;

    // 命名组名 → 1-based 捕获下标 的并行数组；pattern 里没有 `(?<name>…)` 时为空数组。
    // 名字区分大小写，且每个 pattern 内必须唯一（parser 拒绝重名）。
    private string[] _groupNames;
    private int[]    _groupIndices;
    private int      _namedGroupCount;
    // pattern 以 `(?i)` 开头时开启大小写不敏感匹配；作用于整个 pattern，
    // 暂不支持中途改 flag。
    private bool _caseInsensitive;
    // pattern 以 `(?m)`（或组合 `(?im)` / `(?mi)`）开头时开启 multiline；
    // `^` / `$` 也匹配 `\n` 之后 / 之前。
    private bool _multiline;

    private Regex(RegexNode[] seq, int seqCount, int groupCount,
                  string[] groupNames, int[] groupIndices, int namedGroupCount,
                  bool caseInsensitive, bool multiline) {
        this._program         = new RegexProgram(seq, seqCount);
        this._anchoredStart   = seqCount > 0 && seq[0]._kind == 4 && !multiline;
        if (groupCount > 1 || this._program.RepeatCount > 0) {
            this._slots = new int[(groupCount + this._program.RepeatCount) * 2];
        }
        this._groupCount      = groupCount;
        this._groupNames      = groupNames;
        this._groupIndices    = groupIndices;
        this._namedGroupCount = namedGroupCount;
        this._caseInsensitive = caseInsensitive;
        this._multiline       = multiline;
    }

    /// 解析 pattern 并预处理开头的内联 flag；语法错误在此抛 RegexException，而不是匹配时。
    public static Regex Compile(string pattern) {
        // 内联 flag 剥离：开头的 `(?[im]+)` 为整个 pattern 开启大小写不敏感 / multiline，
        // 剥离后把剩余部分交给 RegexParser。接受 `i` / `m` 任意组合、任意顺序，重复容忍
        // （对齐 .NET RegexOptions 语义）。
        bool caseInsensitive = false;
        bool multiline       = false;
        string body          = pattern;
        if (pattern.Length >= 4
                && pattern.CharAt(0) == '('
                && pattern.CharAt(1) == '?') {
            int j = 2;
            bool ci = false;
            bool ml = false;
            bool ok = true;
            while (j < pattern.Length && pattern.CharAt(j) != ')') {
                char fc = pattern.CharAt(j);
                if (fc == 'i')      { ci = true; }
                else if (fc == 'm') { ml = true; }
                else { ok = false; break; }
                j = j + 1;
            }
            // Need ≥ 1 flag char + matching `)`; `(?)` alone does NOT strip.
            if (ok && j < pattern.Length && pattern.CharAt(j) == ')' && j > 2) {
                caseInsensitive = ci;
                multiline       = ml;
                body            = pattern.Substring(j + 1, pattern.Length - j - 1);
            }
        }
        var p = new RegexParser(body);
        p.ParsePattern();
        return new Regex(p.ResultNodes, p.ResultCount, 1 + p.GroupCount,
                         p.GroupNames, p.GroupIndices, p.NamedGroupCount,
                         caseInsensitive, multiline);
    }

    /// 编译并设置每次查找的正数步数预算；耗尽抛 RegexMatchLimitException。
    /// FindAll（包括 Replace/Split）整次调用共享预算；Find/IsMatch 每次重新计数。
    /// 步数包含引擎调度、重复原子尝试和捕获恢复，不限制编译、输入物化、时间或内存。
    public static Regex Compile(string pattern, long maxSteps) {
        if (maxSteps <= 0L) { throw new ArgumentOutOfRangeException("maxSteps must be positive"); }
        Regex result = Regex.Compile(pattern);
        result._maxSteps = maxSteps;
        return result;
    }

    private void ConsumeStep() {
        if (this._remainingSteps == 0L) {
            throw new RegexMatchLimitException("regex match step limit exceeded");
        }
        this._remainingSteps = this._remainingSteps - 1L;
    }

    // ASCII 大小写折叠（A-Z → a-z），其余字符不变；供大小写不敏感匹配路径使用。
    static int _fold(int ch) {
        if (ch >= 65 && ch <= 90) { return ch + 32; }
        return ch;
    }

    // ASCII 大小写互换（A-Z ↔ a-z）：大小写不敏感模式下用输入字符的两种大小写去试 charset。
    static int _swapCase(int ch) {
        if (ch >= 65 && ch <= 90)  { return ch + 32; }
        if (ch >= 97 && ch <= 122) { return ch - 32; }
        return ch;
    }

    /// 命名组名 → 1-based 下标；未声明返回 -1。
    public int GroupIndexOf(string name) {
        int i = 0;
        while (i < this._namedGroupCount) {
            if (this._groupNames[i] == name) {
                return this._groupIndices[i];
            }
            i = i + 1;
        }
        return -1;
    }

    /// 捕获组个数，不含 group 0。
    public int GroupCount() { return this._groupCount - 1; }

    // ── Public API ────────────────────────────────────────────────────────

    /// 是否匹配；等价于 Find(input) != null。
    public bool IsMatch(string input) {
        return this.Find(input) != null;
    }

    /// 返回第一个 match；无匹配返回 null。`^` 开头（且未开 `(?m)`）时只尝试位置 0。
    public Match Find(string input) {
        try {
            this._BindInput(input);
            return this.ScanFrom(0);
        } finally {
            this._ReleaseInput();
        }
    }

    /// 返回所有非重叠 match（可能为空数组）；空匹配也计入，每遇空匹配起点前进一格。
    public Match[] FindAll(string input) {
        try {
            Match[] buf = new Match[8];
            int n = 0;
            int pos = 0;
            this._BindInput(input);
            while (pos <= input.Length) {
                Match m = this.ScanFrom(pos);
                if (m == null) { break; }
                if (n >= buf.Length) {
                    Match[] grown = new Match[buf.Length * 2];
                    int i = 0;
                    while (i < n) { grown[i] = buf[i]; i = i + 1; }
                    buf = grown;
                }
                buf[n] = m;
                n = n + 1;
                int end = m.End();
                pos = end == m.Start() ? end + 1 : end;
            }
            Match[] result = new Match[n];
            int j = 0;
            while (j < n) { result[j] = buf[j]; j = j + 1; }
            return result;
        } finally {
            this._ReleaseInput();
        }
    }

    /// 替换所有非重叠 match；replacement 支持 `$0` / `$1`…`$9` 占位符与 `$$`（字面 `$`）。
    public string Replace(string input, string replacement) {
        Match[] matches = this.FindAll(input);
        if (matches.Length == 0) { return input; }
        int firstDollar = replacement.IndexOf('$');
        string[] tokens = null;
        int[] captures = null;
        if (firstDollar >= 0) {
            var literals = new List<string>();
            var dynamicTokens = new List<int>();
            this._ParseReplacement(replacement, firstDollar, literals, dynamicTokens);
            tokens = literals.ToArray();
            if (dynamicTokens.Count == 0) {
                replacement = String.ConcatParts(tokens, tokens.Length);
            } else {
                captures = dynamicTokens.ToArray();
            }
        }
        var parts = new List<string>();
        int cursor = 0;
        for (int i = 0; i < matches.Length; i = i + 1) {
            Match m = matches[i];
            int start = m.Start();
            if (cursor < start) {
                parts.Add(input.Substring(cursor, start - cursor));
            }
            if (captures != null) {
                for (int j = 0; j < captures.Length; j = j + 2) {
                    tokens[captures[j]] = m.Group(captures[j + 1]);
                }
                parts.Add(tokens.Length == 1 ? tokens[0] : String.ConcatParts(tokens, tokens.Length));
            } else {
                parts.Add(replacement);
            }
            cursor = m.End();
        }
        if (cursor < input.Length) {
            parts.Add(input.Substring(cursor, input.Length - cursor));
        }
        return String.ConcatParts(parts.ToArray(), parts.Count);
    }

    // Store ordinary text in runs. Only $$ and a single in-range group digit
    // consume a token, while unrecognized two-character sequences stay literal.
    private void _ParseReplacement(string replacement, int firstDollar, List<string> literals, List<int> dynamicTokens) {
        int length = replacement.Length;
        int literalStart = 0;
        int pos = firstDollar;
        while (pos + 1 < length) {
            if (replacement.CharAt(pos) != '$') {
                pos = pos + 1;
                continue;
            }
            char next = replacement.CharAt(pos + 1);
            int group = (int)next - 48;
            bool dollar = next == '$';
            if (dollar || (group >= 0 && group <= 9 && group <= this.GroupCount())) {
                if (literalStart < pos) {
                    literals.Add(replacement.Substring(literalStart, pos - literalStart));
                }
                if (!dollar) {
                    dynamicTokens.Add(literals.Count);
                    dynamicTokens.Add(group);
                }
                literals.Add(dollar ? "$" : null);
                literalStart = pos + 2;
            }
            pos = pos + 2;
        }
        if (literalStart < length) {
            literals.Add(replacement.Substring(literalStart, length - literalStart));
        }
    }

    /// 按 match 切分；无匹配返回 [input]，空输入返回 [""]。
    public string[] Split(string input) {
        Match[] matches = this.FindAll(input);
        if (matches.Length == 0) {
            string[] one = new string[1];
            one[0] = input;
            return one;
        }
        string[] parts = new string[matches.Length + 1];
        int cursor = 0;
        int i = 0;
        while (i < matches.Length) {
            Match m = matches[i];
            parts[i] = input.Substring(cursor, m.Start() - cursor);
            cursor = m.End();
            i = i + 1;
        }
        parts[matches.Length] = input.Substring(cursor, input.Length - cursor);
        return parts;
    }

    // ── Engine ────────────────────────────────────────────────────────────

    // Scans the subject bound by _BindInput from startPos onward.
    private Match ScanFrom(int startPos) {
        string input = this._input;
        int from = startPos;
        while (from <= input.Length) {
            this.ResetState();
            int end = this.Run(from);
            if (end >= 0) {
                // R2: give the Match its own copy of the reused slot arrays (null when
                // no capturing groups — Match never reads them for group 0).
                return new Match(input, from, end, this.SnapshotCaptures(0), this.SnapshotCaptures(this._groupCount), this._groupCount, this);
            }
            if (this._anchoredStart) { return null; }
            from = from + 1;
        }
        return null;
    }

    // Find / FindAll own this binding only until their finally blocks; Match owns its input.
    // Materialise the subject once per public call, not once per scan position: an
    // unanchored scan calls ResetState at every start position, and FindAll (hence Replace /
    // Split) calls ScanFrom once per match on the same subject.
    private void _BindInput(string input) {
        this._remainingSteps = this._maxSteps;
        this._input = input;
        this._chars = input.ToCharArray();
    }

    private void _ReleaseInput() {
        this._input = null;
        this._chars = null;
        // Keep ordinary workspaces for reuse without retaining a large call's high-water mark.
        if (this._choices != null && this._choices.Length > 1024) {
            this._choices = null;
            this._choiceData = null;
        }
        if (this._trail != null && this._trail.Length > 4096) {
            this._trail = null;
        }
    }

    // Slots are [capture starts, capture ends, repeat counts, repeat body start positions].
    private void ResetState() {
        this._choiceCount = 0;
        this._trailCount = 0;
        if (this._groupCount > 1) {
            for (int i = 0; i < this._groupCount * 2; i = i + 1) {
                this._slots[i] = -1;
            }
        }
    }

    private void Choose(RegexInstruction instruction, int position, int last, int step) {
        if (this._choices == null) {
            this._choices = new RegexInstruction[8];
            this._choiceData = new int[32];
        } else if (this._choiceCount == this._choices.Length) {
            this._choices = Array.Resize<RegexInstruction>(this._choices, this._choiceCount * 2);
            this._choiceData = Array.Resize<int>(this._choiceData, this._choiceCount * 8);
        }
        this._choices[this._choiceCount] = instruction;
        int choice = this._choiceCount * 4;
        this._choiceData[choice] = position;
        this._choiceData[choice + 1] = this._trailCount;
        this._choiceData[choice + 2] = last;
        this._choiceData[choice + 3] = step;
        this._choiceCount = this._choiceCount + 1;
    }

    private void SetSlot(int slot, int value) {
        if (this._choiceCount > 0 && this._slots[slot] != value) {
            if (this._trail == null) {
                this._trail = new int[16];
            } else if (this._trailCount == this._trail.Length) {
                this._trail = Array.Resize<int>(this._trail, this._trailCount * 2);
            }
            this._trail[this._trailCount] = slot;
            this._trail[this._trailCount + 1] = this._slots[slot];
            this._trailCount = this._trailCount + 2;
        }
        this._slots[slot] = value;
    }

    private void Rewind(int count) {
        bool limited = this._maxSteps != 0L;
        while (this._trailCount > count) {
            if (limited) { this.ConsumeStep(); }
            this._trailCount = this._trailCount - 2;
            this._slots[this._trail[this._trailCount]] = this._trail[this._trailCount + 1];
        }
    }

    private int Run(int position) {
        RegexInstruction instruction = this._program.Entry;
        bool limited = this._maxSteps != 0L;
        while (true) {
            if (limited) { this.ConsumeStep(); }
            if (instruction == null) {
                if (this._choiceCount == 0) { return -1; }
                this._choiceCount = this._choiceCount - 1;
                int choice = this._choiceCount * 4;
                this.Rewind(this._choiceData[choice + 1]);
                instruction = this._choices[this._choiceCount];
                position = this._choiceData[choice];
                int step = this._choiceData[choice + 3];
                if (step != 0 && position != this._choiceData[choice + 2]) {
                    this._choiceData[choice] = position + step;
                    this._choiceCount = this._choiceCount + 1;
                }
            }
            RegexOperation operation = instruction.Operation;
            if (operation == RegexOperation.Accept) { return position; }
            if (operation == RegexOperation.Literal) {
                if (position == this._chars.Length) { instruction = null; continue; }
                int actual = (int)this._chars[position];
                int expected = instruction.Node._ch;
                bool equal = this._caseInsensitive
                    ? Regex._fold(actual) == Regex._fold(expected) : actual == expected;
                if (equal) { position = position + 1; }
                instruction = equal ? instruction.Next : null;
            } else if (operation == RegexOperation.Atom) {
                int next = this.MatchAtom(instruction.Node, position);
                if (next < 0) {
                    instruction = null;
                } else {
                    position = next;
                    instruction = instruction.Next;
                }
            } else if (operation == RegexOperation.Branch) {
                this.Choose(instruction.Other, position, position, 0);
                instruction = instruction.Next;
            } else if (operation == RegexOperation.CaptureStart) {
                this.SetSlot(instruction.Slot, position);
                instruction = instruction.Next;
            } else if (operation == RegexOperation.CaptureEnd) {
                this.SetSlot(this._groupCount + instruction.Slot, position);
                instruction = instruction.Next;
            } else if (operation == RegexOperation.RepeatAtom) {
                int next = this.MatchRepeatAtom(instruction, position);
                if (next < 0) {
                    instruction = null;
                } else {
                    position = next;
                    instruction = instruction.Next;
                }
            } else {
                instruction = this.RunRepeat(instruction, position);
            }
        }
    }

    // A consuming atom has no internal choices. Its possible end positions form
    // one contiguous range that can share a single backtrack frame.
    private int MatchRepeatAtom(RegexInstruction instruction, int start) {
        bool limited = this._maxSteps != 0L;
        RegexNode repeat = instruction.Node;
        RegexNode atom = repeat._childSeq[0];
        int end = start;
        int limit = this._chars.Length;
        if (repeat._max >= 0 && repeat._max < limit - start) {
            limit = start + repeat._max;
        }
        while (end < limit) {
            if (limited) { this.ConsumeStep(); }
            if (this.MatchAtom(atom, end) < 0) { break; }
            end = end + 1;
        }
        if (end - start < repeat._min) { return -1; }
        int minEnd = start + repeat._min;
        if (repeat._greedy) {
            if (end > minEnd) { this.Choose(instruction.Next, end - 1, minEnd, -1); }
            return end;
        }
        if (end > minEnd) { this.Choose(instruction.Next, minEnd + 1, end, 1); }
        return minEnd;
    }

    private RegexInstruction RunRepeat(RegexInstruction instruction, int position) {
        int countSlot = this._groupCount * 2 + instruction.Slot;
        int startSlot = countSlot + this._program.RepeatCount;
        RegexOperation operation = instruction.Operation;
        if (operation == RegexOperation.RepeatInit) {
            this.SetSlot(countSlot, 0);
            return instruction.Next;
        }
        if (operation == RegexOperation.RepeatBody) {
            this.SetSlot(startSlot, position);
            return instruction.Next;
        }
        RegexNode node = instruction.Node;
        int count = this._slots[countSlot];
        if (operation == RegexOperation.RepeatEnd) {
            // Reject this iteration once the minimum is met. Backtracking can still
            // try another body branch that consumes input before leaving the repeat.
            if (position == this._slots[startSlot] && count >= node._min) { return null; }
            this.SetSlot(countSlot, count + 1);
            return instruction.Next;
        }
        if (count < node._min) { return instruction.Next; }
        if (node._max >= 0 && count == node._max) { return instruction.Other; }
        if (node._greedy) {
            this.Choose(instruction.Other, position, position, 0);
            return instruction.Next;
        }
        this.Choose(instruction.Next, position, position, 0);
        return instruction.Other;
    }

    private int MatchAtom(RegexNode node, int position) {
        int kind = node._kind;
        int length = this._chars.Length;
        if (kind == 4) {
            return position == 0 || (this._multiline && (int)this._chars[position - 1] == 10)
                ? position : -1;
        }
        if (kind == 5) {
            return position == length || (this._multiline && (int)this._chars[position] == 10)
                ? position : -1;
        }
        if (kind == 9) { return this._AtWordBoundary(position) ? position : -1; }
        if (kind == 10) { return this._AtWordBoundary(position) ? -1 : position; }
        if (position == length) { return -1; }
        if (kind == 2) { return position + 1; }
        int ch = (int)this._chars[position];
        if (kind == 1) {
            bool equal = this._caseInsensitive
                ? Regex._fold(ch) == Regex._fold(node._ch) : ch == node._ch;
            return equal ? position + 1 : -1;
        }
        bool hit = node.CharsetMatches(ch);
        if (this._caseInsensitive) {
            int swapped = Regex._swapCase(ch);
            if (swapped != ch) {
                bool other = node.CharsetMatches(swapped);
                hit = node._negated ? hit && other : hit || other;
            }
        }
        return hit ? position + 1 : -1;
    }

    private int[] SnapshotCaptures(int offset) {
        if (this._groupCount <= 1) { return null; }
        int[] snapshot = new int[this._groupCount];
        Array.CopyRange(this._slots, offset, snapshot, 0, snapshot.Length);
        return snapshot;
    }

    // 位置 pos 恰好夹在一个 ASCII 词字符与非词字符（或非词一侧的输入边界）之间时为真。
    // 输入端点算非词，所以 pos 0 / Length 处若相邻字符是词字符，`\b` 也匹配。
    private bool _AtWordBoundary(int pos) {
        bool leftWord  = pos > 0
                      && Regex._IsWordChar((int)this._chars[pos - 1]);
        bool rightWord = pos < this._input.Length
                      && Regex._IsWordChar((int)this._chars[pos]);
        return leftWord != rightWord;
    }

    // ASCII `\w` 成员判定：`[A-Za-z0-9_]`。大小写不敏感 flag 无影响（两种大小写都已在集合内）。
    private static bool _IsWordChar(int ch) {
        return (ch >= 48 && ch <= 57)    // 0-9
            || (ch >= 65 && ch <= 90)    // A-Z
            || (ch >= 97 && ch <= 122)   // a-z
            || ch == 95;                 // _
    }
}
