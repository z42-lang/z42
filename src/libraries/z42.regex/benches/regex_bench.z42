// Micro-benchmarks for z42.regex hot paths — compile, IsMatch, FindAll.
// Baseline data for the 0.4.x perf stream. Run via `z42 xtask.zpkg bench stdlib z42.regex`.

namespace Z42RegexBench;

using Std.Harness;
using Std.Regex;

[Benchmark]
void bench_regex_compile() {
    var re = Regex.Compile("[a-z0-9._]+@[a-z0-9-]+\\.[a-z]+");
    BenchHelpers.blackBox(re);
}

[Benchmark]
void bench_regex_is_match(Bencher b) {
    var re = Regex.Compile("[a-z0-9._]+@[a-z0-9-]+\\.[a-z]+");
    b.iter(() => {
        bool hit = re.IsMatch("contact us at team.lead@example-corp.com for details")
                 && !re.IsMatch("no email here, just words and 12345 numbers");
        BenchHelpers.blackBox(hit);
    });
}

[Benchmark]
void bench_regex_find_all(Bencher b) {
    var re = Regex.Compile("[0-9]+");
    string hay = "order 12 shipped 345 units to 6789 customers in 10 regions over 2026 days";
    b.iter(() => {
        BenchHelpers.blackBox(re.FindAll(hay));
    });
}

// Smoke [Test] — bench bodies run + match sanity.
[Test]
void test_regex_bench_bodies_run() {
    var b = new Bencher(1, 3);
    var re = Regex.Compile("[0-9]+");
    b.iter(() => {
        BenchHelpers.blackBox(re.IsMatch("a1b"));
    });
    Assert.Equal(3, b.Samples);
    Assert.True(b.TotalNs > 0L);
    Assert.True(re.IsMatch("x42"));
}

[Benchmark]
void bench_regex_replace(Bencher b) {
    var re = Regex.Compile("[0-9]+");
    string hay = "id 12 x 345 y 6789 z 10 w 2026 done";
    b.iter(() => {
        BenchHelpers.blackBox(re.Replace(hay, "#"));
    });
}

[Benchmark]
void bench_regex_group_capture() {
    var re = Regex.Compile("^([a-z]+)-([0-9]{2,4})$");
    var b = new Bencher(4, 24);
    b.iter(() => {
        Match hit = re.Find("example-2048");
        Assert.Equal("2048", hit.Group(2));
        BenchHelpers.blackBox(hit);
    });
    b.printSummary("regex_group_capture");
}

[Benchmark]
void bench_regex_anchored_literal() {
    var re = Regex.Compile("^literal$");
    var b = new Bencher(4, 24);
    b.iter(() => {
        for (int i = 0; i < 32; i = i + 1) {
            BenchHelpers.blackBox(re.IsMatch("literal"));
            BenchHelpers.blackBox(re.IsMatch("literals"));
        }
    });
    b.printSummary("regex_anchored_literal");
}

[Benchmark]
void bench_regex_replace_many_literal(Bencher b) {
    MeasureManyReplacements(b, "x", "中😀");
}

[Benchmark]
void bench_regex_replace_many_captures(Bencher b) {
    MeasureManyReplacements(b, "(x)", "中$1$$");
}

void MeasureManyReplacements(Bencher b, string pattern, string replacement) {
    var regex = Regex.Compile(pattern);
    string[] input = new string[512];
    Array.Fill<string>(input, "éx");
    string text = String.ConcatParts(input, input.Length);
    b.iter(() => { BenchHelpers.blackBox(regex.Replace(text, replacement)); });
}
