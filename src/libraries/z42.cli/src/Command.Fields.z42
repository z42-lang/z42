namespace Std.Cli;
using Std.Reflection;

/// `Command` 的 partial 碎片 —— 字段 ↔ 参数：读 `[Option]` / `[Argument]` 声明 parser，
/// 解析后按字段类型转换并回写。
public partial class Command {

    // 本命令贴了 `[Option]` / `[Argument]` 的字段（声明序；基类字段在前）。
    private _FieldSpec[] _fieldSpecs() {
        FieldInfo[] fs = this.GetType().GetFields();
        _FieldSpec[] buf = new _FieldSpec[fs.Length];
        int n = 0;
        int i = 0;
        while (i < fs.Length) {
            _FieldSpec? s = _FieldSpec.From(this, fs[i]);
            if (s != null) { buf[n] = s; n = n + 1; }
            i = i + 1;
        }
        _FieldSpec[] outArr = new _FieldSpec[n];
        int j = 0;
        while (j < n) { outArr[j] = buf[j]; j = j + 1; }
        return outArr;
    }

    // 叶子 / 默认动作的 parser：非全局 option + 全部 argument；includeGlobals 时全局 option
    // 也作普通 option（没有子命令可路由时，全局与否没有区别）。
    private ArgParser _buildParser(bool includeGlobals) {
        ArgParser p = new ArgParser(this._progName(), this._cmdDescription);
        _FieldSpec[] specs = this._fieldSpecs();
        int i = 0;
        while (i < specs.Length) {
            _FieldSpec s = specs[i];
            if (s.IsOption && (!s.Opt.Global || includeGlobals)) { this._declareOption(p, s); }
            if (!s.IsOption) { this._declareArgument(p, s); }
            i = i + 1;
        }
        return p;
    }

    private void _declareOption(ArgParser p, _FieldSpec s) {
        string help = this._specHelp(s);
        if (s.Kind == _FieldSpec.KBool) {
            if (s.Opt.Required) { throw s.Error("a flag (bool) cannot be required"); }
            p.AddFlag(s.Name, s.Opt.ShortName, help);
        } else if (s.Kind == _FieldSpec.KStrings) {
            p.AddRepeatedOption(s.Name, s.Opt.ShortName, help);
        } else if (s.Opt.Required) {
            p.AddRequiredOption(s.Name, s.Opt.ShortName, help);
        } else {
            p.AddOption(s.Name, s.Opt.ShortName, help, s.DefaultText(this));
        }
        string[] al = s.Aliases();
        int i = 0;
        while (i < al.Length) { p.AddAlias(s.Name, al[i]); i = i + 1; }
    }

    private void _declareArgument(ArgParser p, _FieldSpec s) {
        string help = this._specHelp(s);
        if (s.Kind == _FieldSpec.KBool) { throw s.Error("an argument cannot be bool"); }
        if (s.Kind == _FieldSpec.KStrings) {
            if (s.Arg.Passthrough) { p.AddPassthrough(s.Name, help); }
            else { p.AddVariadicPositional(s.Name, help); }
            return;
        }
        if (s.Arg.Passthrough) { throw s.Error("passthrough needs a string[] field"); }
        if (s.Arg.Required) { p.AddPositional(s.Name, help); }
        else { p.AddOptionalPositional(s.Name, help); }
    }

    // 有子命令时：全局 option 进 router 的 persistent 层。
    private void _declareGlobals(SubcommandRouter r) {
        _FieldSpec[] specs = this._fieldSpecs();
        int i = 0;
        while (i < specs.Length) {
            _FieldSpec s = specs[i];
            i = i + 1;
            if (!s.IsOption || !s.Opt.Global) { continue; }
            if (s.Kind == _FieldSpec.KStrings) { throw s.Error("a global option cannot be repeatable"); }
            if (s.Opt.Required) { throw s.Error("a global option cannot be required"); }
            if (s.Kind == _FieldSpec.KBool) {
                r.AddPersistentFlag(s.Name, s.Opt.ShortName, this._specHelp(s));
            } else {
                r.AddPersistentOption(s.Name, s.Opt.ShortName, this._specHelp(s), s.DefaultText(this));
            }
            string[] al = s.Aliases();
            int k = 0;
            while (k < al.Length) { r.AddPersistentAlias(s.Name, al[k]); k = k + 1; }
        }
    }

    // 有子命令而无默认动作：非全局参数无处可写，声明期报错。
    private void _requireNoLocals() {
        _FieldSpec[] specs = this._fieldSpecs();
        int i = 0;
        while (i < specs.Length) {
            if (!specs[i].IsOption || !specs[i].Opt.Global) {
                throw specs[i].Error("command has subcommands but no default action (SetDefaultAction); " +
                    "only global options are allowed here");
            }
            i = i + 1;
        }
    }

    private string _specHelp(_FieldSpec s) {
        string? o = this._helpOverride(s.Field.Name);
        string help = o != null ? o : s.HelpText();
        string[]? ch = s.Choices();
        if (ch == null) { return help; }
        string[] c = ch;
        string list = string.Join("|", c);
        return help.Length > 0 ? help + " {" + list + "}" : "{" + list + "}";
    }

    // ── 绑定 ─────────────────────────────────────────────────────────────

    private void _bindGlobals(CommandResolution res) {
        _FieldSpec[] specs = this._fieldSpecs();
        int i = 0;
        while (i < specs.Length) {
            _FieldSpec s = specs[i];
            i = i + 1;
            if (!s.IsOption || !s.Opt.Global) { continue; }
            if (s.Kind == _FieldSpec.KBool) {
                s.Field.SetValue(this, res.PersistentFlag(s.Name));
            } else {
                s.Field.SetValue(this, s.Convert(res.PersistentOption(s.Name)));
            }
        }
    }

    private void _bindLocals(ParseResult pr, bool includeGlobals) {
        _FieldSpec[] specs = this._fieldSpecs();
        int pos = 0;
        int i = 0;
        while (i < specs.Length) {
            _FieldSpec s = specs[i];
            i = i + 1;
            if (s.IsOption) {
                if (!s.Opt.Global || includeGlobals) { this._bindOption(pr, s); }
                continue;
            }
            if (s.Kind == _FieldSpec.KStrings) {
                s.Field.SetValue(this, pr.VariadicValues());
            } else {
                if (pos < pr.PositionalCount()) { s.Field.SetValue(this, s.Convert(pr.GetPositional(pos))); }
                pos = pos + 1;
            }
        }
    }

    // 未出现的 option 保留字段初始值（即默认值），不做回写。
    private void _bindOption(ParseResult pr, _FieldSpec s) {
        if (s.Kind == _FieldSpec.KBool) {
            if (pr.GetFlag(s.Name)) { s.Field.SetValue(this, true); }
        } else if (s.Kind == _FieldSpec.KStrings) {
            string[] vs = pr.GetRepeatedOption(s.Name);
            if (vs.Length > 0) { s.Field.SetValue(this, vs); }
        } else if (pr.WasOptionSet(s.Name)) {
            s.Field.SetValue(this, s.Convert(pr.GetOption(s.Name)));
        }
    }
}
