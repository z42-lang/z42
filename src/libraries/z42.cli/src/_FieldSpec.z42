namespace Std.Cli;
using Std.Reflection;

/// `Command` 的一个参数字段：字段 + 它的 `[Option]` / `[Argument]` + 派生出的参数名与类型类别。
class _FieldSpec {
    public const int KString  = 0;
    public const int KBool    = 1;
    public const int KInt     = 2;
    public const int KLong    = 3;
    public const int KDouble  = 4;
    public const int KEnum    = 5;
    public const int KStrings = 6;

    public FieldInfo Field;
    public bool IsOption;
    public OptionAttribute Opt;        // IsOption 为 false 时是占位实例
    public ArgumentAttribute Arg;      // IsOption 为 true 时是占位实例
    public string Name;
    public int Kind;
    private string _owner;

    private _FieldSpec(string owner, FieldInfo f, bool isOption, OptionAttribute opt, ArgumentAttribute arg) {
        this._owner = owner;
        this.Field = f;
        this.IsOption = isOption;
        this.Opt = opt;
        this.Arg = arg;
        string explicitName = isOption ? opt.Name : arg.Name;
        this.Name = explicitName.Length > 0 ? explicitName : _FieldSpec.Kebab(f.Name);
        this.Kind = _FieldSpec.KindOf(f.FieldType);
        if (this.Kind < 0) {
            throw this.Error("unsupported field type '" + f.FieldType.FullName +
                "' (use string / bool / int / long / double / enum / string[])");
        }
    }

    // 字段没有贴 `[Option]` / `[Argument]` → null；两个都贴 → 报错。
    public static _FieldSpec? From(Command owner, FieldInfo f) {
        Attribute? o = f.GetAttribute(typeof(OptionAttribute));
        Attribute? a = f.GetAttribute(typeof(ArgumentAttribute));
        if (o == null && a == null) { return null; }
        string ownerName = owner.CommandName();
        if (o != null && a != null) {
            throw new CliException("command '" + ownerName + "', field '" + f.Name +
                "': [Option] and [Argument] are mutually exclusive");
        }
        if (o != null) {
            return new _FieldSpec(ownerName, f, true, (OptionAttribute)o, new ArgumentAttribute());
        }
        return new _FieldSpec(ownerName, f, false, new OptionAttribute(), (ArgumentAttribute)a);
    }

    public CliException Error(string msg) {
        return new CliException("command '" + this._owner + "', field '" + this.Field.Name + "': " + msg);
    }

    public string HelpText() { return this.IsOption ? this.Opt.Help : this.Arg.Help; }

    public string[] Aliases() { return this.Opt.Alias == null ? new string[0] : this.Opt.Alias; }

    // 显式 choices 优先；enum 字段自动取成员名（kebab-case）；否则 null（不限）。
    public string[]? Choices() {
        string[] explicitChoices = this.IsOption ? this.Opt.Choices : this.Arg.Choices;
        if (explicitChoices != null) { return explicitChoices; }
        if (this.Kind != _FieldSpec.KEnum) { return null; }
        string[] names = Enum.GetNames(this.Field.FieldType);
        string[] outArr = new string[names.Length];
        int i = 0;
        while (i < names.Length) { outArr[i] = _FieldSpec.Kebab(names[i]); i = i + 1; }
        return outArr;
    }

    // 字段当前值（构造后即初始值）的参数文本，供帮助的 `[default: …]`。
    public string DefaultText(Command owner) {
        object v = this.Field.GetValue(owner);
        if (v == null) { return ""; }
        if (this.Kind == _FieldSpec.KEnum) {
            string n = Enum.GetName(this.Field.FieldType, long.Parse(v.ToString()));
            return _FieldSpec.Kebab(n);
        }
        return v.ToString();
    }

    // 参数文本 → 字段类型的值；不在 choices 内 / 数字非法时抛 CliException。
    public object Convert(string raw) {
        string[]? ch = this.Choices();
        if (ch != null) { _FieldSpec.CheckChoice(this.Display(), raw, ch); }
        if (this.Kind == _FieldSpec.KString) { return raw; }
        try {
            if (this.Kind == _FieldSpec.KInt)    { return int.Parse(raw); }
            if (this.Kind == _FieldSpec.KLong)   { return long.Parse(raw); }
            if (this.Kind == _FieldSpec.KDouble) { return double.Parse(raw); }
        } catch (Exception e) {
            throw new CliException("invalid value '" + raw + "' for " + this.Display() + ": expected a number");
        }
        string[] names = Enum.GetNames(this.Field.FieldType);
        int i = 0;
        while (i < names.Length) {
            if (_FieldSpec.Kebab(names[i]) == raw) { return Enum.Parse(this.Field.FieldType, names[i]); }
            i = i + 1;
        }
        throw new CliException("internal: enum value '" + raw + "' passed the choice check");
    }

    private string Display() { return this.IsOption ? "'--" + this.Name + "'" : "<" + this.Name + ">"; }

    private static void CheckChoice(string display, string raw, string[] choices) {
        int i = 0;
        while (i < choices.Length) {
            if (choices[i] == raw) { return; }
            i = i + 1;
        }
        string msg = "invalid value '" + raw + "' for " + display + " (choose from " + string.Join(" | ", choices) + ")";
        string? near = _Suggest.Nearest(raw, choices);
        if (near != null) { msg = msg + " (did you mean '" + near + "'?)"; }
        throw new CliException(msg);
    }

    // 类型类别；不支持返回 -1。
    private static int KindOf(Type t) {
        if (t.IsEnum) { return _FieldSpec.KEnum; }
        string fn = t.FullName;
        if (fn == "Std.String")   { return _FieldSpec.KString; }
        if (fn == "Std.Boolean")  { return _FieldSpec.KBool; }
        if (fn == "Std.Int32")    { return _FieldSpec.KInt; }
        if (fn == "Std.Int64")    { return _FieldSpec.KLong; }
        if (fn == "Std.Double")   { return _FieldSpec.KDouble; }
        if (fn == "Std.String[]") { return _FieldSpec.KStrings; }
        return -1;
    }

    /// PascalCase / camelCase → kebab-case：`NoBuild` → `no-build`，`HTTPPort` → `http-port`。
    public static string Kebab(string s) {
        string outStr = "";
        int i = 0;
        while (i < s.Length) {
            char c = s.CharAt(i);
            bool upper = (int)c >= 65 && (int)c <= 90;
            if (upper && i > 0) {
                char prev = s.CharAt(i - 1);
                bool prevUpper = (int)prev >= 65 && (int)prev <= 90;
                bool nextLower = i + 1 < s.Length && (int)s.CharAt(i + 1) >= 97 && (int)s.CharAt(i + 1) <= 122;
                if (!prevUpper || nextLower) { outStr = outStr + "-"; }
            }
            outStr = outStr + c.ToLower().ToString();
            i = i + 1;
        }
        return outStr;
    }
}
