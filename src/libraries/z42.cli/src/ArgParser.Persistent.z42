namespace Std.Cli;

/// `ArgParser` 的 partial 碎片 —— persistent 剥离：把本 parser 已注册的
/// flag / option 从 argv 任意位置剥出，供 `SubcommandRouter` 的跨子命令
/// 全局旗标使用。
public partial class ArgParser {

    // ── Persistent strip ─────────────────────────────────────────────────

    /// 把本 parser 已注册的 flag / option 从 argv 的**任意位置**剥出并解析：
    /// 命中的 token（及其取值 token）进本 parser 的 Parse，其余原样保留在
    /// `Kept`（保序）。只识别 `--long` / `--long=v` / `--long v` / `-s` / `-s v` /
    /// `-sv` 六种形态；不认识的 token、`-h/--help`、以及 `--` 之后的 token 全部留在
    /// `Kept`（`--` 之后的剥离语义归叶子 parser 的 positional，不归全局旗标）。
    ///
    /// 取值 token 缺失时抛 CliException。叶子路由 / 簇解析 / 负数回退都不在本方法职责内。
    public _StripOutcome StripDeclared(string[] argv) {
        string[] persistent = new string[argv.Length * 2 + 1];
        int pc = 0;
        string[] kept = new string[argv.Length];
        int kc = 0;
        bool sawSeparator = false;
        int i = 0;
        while (i < argv.Length) {
            string t = argv[i];
            if (sawSeparator || t == "--" || t.Length < 2 || t.CharAt(0) != '-' ||
                t == "-h" || t == "--help") {
                if (t == "--") { sawSeparator = true; }
                kept[kc] = t;
                kc = kc + 1;
                i = i + 1;
                continue;
            }
            _StripKind k = t.CharAt(1) == '-' ? this._ClassifyLong(argv, i) : this._ClassifyShort(argv, i);
            if (k.Kind == 0) {
                // 未命中任何本 parser 声明 → 留给后续路由
                kept[kc] = t;
                kc = kc + 1;
                i = i + 1;
                continue;
            }
            while (i < k.Next) {
                persistent[pc] = argv[i];
                pc = pc + 1;
                i = i + 1;
            }
        }
        // 剥出的 token 只含已声明项，Parse 不可能报 unknown；空剥出也解析一次（取默认值）。
        ParseResult parsed = pc > 0 ? this.Parse(_Exact(persistent, pc)) : this.Parse(new string[0]);
        return new _StripOutcome(_Exact(kept, kc), parsed);
    }

    // long token 分类：0=与本 parser 无关；1=flag（1 token）；2=option 分离值（2 token）；
    // 3=option 内联值（1 token）。Next 是命中时的下一个未处理下标。
    private _StripKind _ClassifyLong(string[] argv, int i) {
        string t = argv[i];
        string name = t;
        bool hasValue = false;
        int eq = this.IndexOf(t, '=');
        if (eq >= 0) {
            name = t.Substring(2, eq - 2);
            hasValue = true;
        } else {
            name = t.Substring(2, t.Length - 2);
        }
        if (this.FindFlagByLong(name) >= 0) {
            return new _StripKind(1, i + 1);
        }
        if (this.FindOptionByLong(name) >= 0) {
            if (hasValue) { return new _StripKind(3, i + 1); }
            if (i + 1 >= argv.Length) {
                throw new CliException("option '--" + name + "' requires a value");
            }
            return new _StripKind(2, i + 2);
        }
        return new _StripKind(0, i + 1);
    }

    // short token 分类：整名注册的 flag / option（`-s` / `-s v`），或首字符是 option
    // 短名的紧贴形态（`-sv`）。Kind 语义同 _ClassifyLong。
    private _StripKind _ClassifyShort(string[] argv, int i) {
        string t = argv[i];
        string name = t.Substring(1, t.Length - 1);
        if (this.FindFlagByShort(name) >= 0) {
            return new _StripKind(1, i + 1);
        }
        if (this.FindOptionByShort(name) >= 0) {
            if (i + 1 >= argv.Length) {
                throw new CliException("option '-" + name + "' requires a value");
            }
            return new _StripKind(2, i + 2);
        }
        if (name.Length > 1 && this.FindOptionByShort(name.Substring(0, 1)) >= 0) {
            return new _StripKind(3, i + 1);
        }
        return new _StripKind(0, i + 1);
    }

    // 拷出前 n 个元素的精确长度副本。
    private static string[] _Exact(string[] a, int n) {
        string[] r = new string[n];
        int i = 0;
        while (i < n) { r[i] = a[i]; i = i + 1; }
        return r;
    }
}

/// token 分类结果的内部载体（见 ArgParser._ClassifyLong / _ClassifyShort）。
public class _StripKind {
    /// 0=与本 parser 无关；1=flag；2=option 分离值；3=option 内联值。
    public int Kind;
    /// 命中时下一个未处理下标。
    public int Next;

    /// 用类别与下一个下标创建。
    public _StripKind(int kind, int next) {
        this.Kind = kind;
        this.Next = next;
    }
}

/// `ArgParser.StripDeclared` 的结果：剥离后剩余的 argv（保序）+ 剥出 token 的解析结果。
public class _StripOutcome {
    /// 未命中的 token（原序）。
    public string[] Kept;
    /// 剥出 token 经本 parser 解析的结果。
    public ParseResult Result;

    /// 用两部分结果创建。
    public _StripOutcome(string[] kept, ParseResult result) {
        this.Kept   = kept;
        this.Result = result;
    }
}
