namespace Std.Cli;

/// SubcommandRouter.Resolve 的结果：IsMatch / IsHelp / IsUnknown 恰好一个为真。
public sealed class CommandResolution {
    // 0 = match, 1 = help, 2 = unknown.
    int _kind;
    string[]    _path;
    ParseResult _result;
    string      _helpText;
    string      _errorMessage;
    // 各层 router 剥出的 persistent 解析结果，根层在前（未声明任何 persistent 时为 null）。
    ParseResult[] _persistents;

    /// 创建一个 CommandResolution（kind 0=match / 1=help / 2=unknown）。
    public CommandResolution(int kind, string[] path, ParseResult result,
                             string helpText, string errorMessage) {
        this._kind         = kind;
        this._path         = path;
        this._result       = result;
        this._helpText     = helpText;
        this._errorMessage = errorMessage;
        this._persistents  = null;
    }

    /// 命中叶子命令且未请求 help。
    public static CommandResolution Match(ParseResult result) {
        return new CommandResolution(0, new string[0], result, "", "");
    }

    /// 某层请求了 help；`helpText` 是该层的帮助文本。
    public static CommandResolution Help(string helpText) {
        return new CommandResolution(1, new string[0], null, helpText, "");
    }

    /// 某 router 层遇到不认识的 token。
    public static CommandResolution Unknown(string errorMessage, string helpText) {
        return new CommandResolution(2, new string[0], null, helpText, errorMessage);
    }

    /// 是否命中叶子命令（未请求 help）。
    public bool IsMatch()   { return this._kind == 0; }

    /// 是否在任一层遇到 `-h` / `--help`（或某层无剩余 token，或叶子 ShowHelp() 为真）。
    public bool IsHelp()    { return this._kind == 1; }

    /// 是否在某 router 层遇到不认识的 token。
    public bool IsUnknown() { return this._kind == 2; }

    /// 已走过的命中链，如 `["build", "package"]`。
    public string[] Path() { return this._path; }

    /// 叶子的 ParseResult；仅在 IsMatch() 时有效。
    public ParseResult Result() { return this._result; }

    /// 相应层的帮助文本；仅在 IsHelp() / IsUnknown() 时有效。
    public string HelpText() { return this._helpText; }

    /// 错误消息；仅在 IsUnknown() 时有效。
    public string ErrorMessage() { return this._errorMessage; }

    /// 递归回卷时在 path 头部前插祖先子命令名；原地修改并返回 this 以便链式调用（Resolve 内部使用）。
    public CommandResolution Prepend(string name) {
        string[] np = new string[this._path.Length + 1];
        np[0] = name;
        int i = 0;
        while (i < this._path.Length) {
            np[i + 1] = this._path[i];
            i = i + 1;
        }
        this._path = np;
        return this;
    }

    /// 把祖先层剥出的 persistent 解析结果挂到结果**头部**（根层最终在最前；
    /// Resolve 递归回卷时调用；原地修改并返回 this）。
    public CommandResolution AttachPersistent(ParseResult p) {
        if (p == null) { return this; }
        int n = this._persistents == null ? 0 : this._persistents.Length;
        ParseResult[] np = new ParseResult[n + 1];
        np[0] = p;
        int i = 0;
        while (i < n) {
            np[i + 1] = this._persistents[i];
            i = i + 1;
        }
        this._persistents = np;
        return this;
    }

    // 从根到叶扫 persistent 层，返回第一个注册了 longName 的结果；全无则返回 null。
    ParseResult? _FindPersistent(string longName, bool option) {
        int i = 0;
        while (this._persistents != null && i < this._persistents.Length) {
            ParseResult p = this._persistents[i];
            if (option ? p.HasOption(longName) : p.HasFlag(longName)) {
                return p;
            }
            i = i + 1;
        }
        return null;
    }

    /// 各层 persistent option 的最终值（根层优先）；名字未在任何层声明抛 CliException。
    public string PersistentOption(string longName) {
        ParseResult? found = this._FindPersistent(longName, true);
        if (found == null) {
            throw new CliException("persistent option '" + longName + "' not registered");
        }
        ParseResult p = found;
        return p.GetOption(longName);
    }

    /// 各层 persistent option 是否在 argv 里显式给出（根层优先）；名字未在任何层声明抛 CliException。
    public bool PersistentOptionSet(string longName) {
        ParseResult? found = this._FindPersistent(longName, true);
        if (found == null) {
            throw new CliException("persistent option '" + longName + "' not registered");
        }
        ParseResult p = found;
        return p.WasOptionSet(longName);
    }

    /// 各层 persistent flag 是否出现（根层优先）；名字未在任何层声明抛 CliException。
    public bool PersistentFlag(string longName) {
        ParseResult? found = this._FindPersistent(longName, false);
        if (found == null) {
            throw new CliException("persistent flag '" + longName + "' not registered");
        }
        ParseResult p = found;
        return p.GetFlag(longName);
    }
}
