// fullMode .zbc → IrModule 读取器（add-file-level-incremental D5；对照 git 历史 C#
// ZbcReader.cs 移植，覆盖 z42 ZbcWriter 实际发射面）。消费方 = 增量编译 cached 文件重建。
// 严格 strict-pin：major/minor 与 writer 不符 → null（调用方按坏 cache 降级 fresh）。
// IMPT/EXPT 不解码（writer 从函数集重推导）；FRCS/BLID z42 writer 不发射，目录驱动天然跳过。
// 占位块 label + C#-style 模块池重建（ConstStr 首现序）——真实 label / 池原序 / TIDX idx
// 是 writer 残留，由集成层持 cache meta 回填（design D5a）；TIDX 串在纯 wire 读取下
// 以「缺则追加」并入模块池（顺序修正同样归 meta 回填）。
namespace Z42.IR.BinaryFormat;

using Z42.IR;
using Std;
using Std.Encoding;

// 字节游标（镜像 z42c.project ZpkgCursor；z42c.ir 是叶子包，不能反向依赖）。
public sealed class ZbcCursor {
    public byte[] Data;
    public int    Pos;
    public ZbcCursor(byte[] data, int pos) { this.Data = data; this.Pos = pos; }
    public int U8()  { int v = (int)this.Data[this.Pos]; this.Pos = this.Pos + 1; return v; }
    public int U16() { int a = this.U8(); int b = this.U8(); return a | (b << 8); }
    public int U32() { int a = this.U16(); int b = this.U16(); return a | (b << 16); }
    // 无符号 LEB128（STRS segment-dict）。最多 5 字节（32-bit）防越界死循环。
    public int Varint() {
        int result = 0;
        int shift = 0;
        int guard = 0;
        while (guard < 5) {
            int b = this.U8();
            result = result | ((b & 0x7F) << shift);
            if ((b & 0x80) == 0) { return result; }
            shift = shift + 7;
            guard = guard + 1;
        }
        return result;
    }
    public long I64() {
        long lo = (long)this.U32();
        long hi = (long)this.U32();
        return (lo & 0xFFFFFFFFL) | (hi << 32);
    }
    public string Str(int len) {
        byte[] b = new byte[len];
        int i = 0;
        while (i < len) { b[i] = this.Data[this.Pos + i]; i = i + 1; }
        this.Pos = this.Pos + len;
        return Utf8.GetString(b);
    }
}

// 段目录条目。
public sealed class ZbcSectionZ {
    public string Tag; public int Offset; public int Size;
    public ZbcSectionZ(string tag, int offset, int size) { this.Tag = tag; this.Offset = offset; this.Size = size; }
}

// SIGS 条目（组装 IrFunction 用的中转）。
public sealed class SigEntryZ {
    public string   Name;
    public int      ParamCount;
    public string   RetType;
    public string   ExecMode;
    public bool     IsStatic;
    public int      Visibility;   // add-member-visibility（zbc 1.23）：0/1/2
    public int      MethodFlags;  // add-method-modifiers（zbc 1.24）：bit0=virtual/bit1=abstract
    public int      MinArg;       // add-param-metadata（zbc 1.25）：必填逻辑参数个数
    public int      ParamsFrom;   // add-param-metadata：params 逻辑 index（255=无）
    public string[] ParamNames;   // add-param-metadata：每参源名（含 this 槽）
    public int[]    ParamDefaultKinds; // 0=无/1=null/2=i64/3=f64bits/4=bool/5=str
    public long[]   ParamDefaultVals;  // kind 2/3/4 载荷
    public string[] ParamDefaultStrs;  // kind 5 字符串值
    public string[] ParamTypes; public int ParamTypeCount;
    public IrAttrRef[] Attrs; public int AttrCount;
    public IrAttrRefList[] ParamAttrs; public int ParamAttrsLen;
    public string DeprecationMsg;   // add-deprecated-directive（zbc 1.37）：MethodFlags bit3 gated 消息串
    public SigEntryZ() {
        this.Name = ""; this.ParamCount = 0; this.RetType = "void"; this.ExecMode = "Interp";
        this.IsStatic = false;
        this.Visibility = 0;
        this.MethodFlags = 0;
        this.DeprecationMsg = "";
        this.MinArg = 0; this.ParamsFrom = 255;
        this.ParamNames = new string[0]; this.ParamDefaultKinds = new int[0];
        this.ParamDefaultVals = new long[0]; this.ParamDefaultStrs = new string[0];
        this.ParamTypes = new string[0]; this.ParamTypeCount = 0;
        this.Attrs = new IrAttrRef[0]; this.AttrCount = 0;
        this.ParamAttrs = new IrAttrRefList[0]; this.ParamAttrsLen = 0;
    }
}

public static class ZbcReader {

    // 顶层：zbc 字节 → IrModule；任何不符（magic/pin/未知 opcode/截断）→ null。
    public static IrModule Read(byte[] data) {
        if (data.Length < 16) { return null; }
        if ((int)data[0] != 90 || (int)data[1] != 66 || (int)data[2] != 67 || (int)data[3] != 0) { return null; }   // "ZBC\0"
        ZbcCursor h = new ZbcCursor(data, 4);
        int major = h.U16();
        int minor = h.U16();
        int flags = h.U16();
        int secCount = h.U16();
        if (major != ZbcVersion.Major || minor != ZbcVersion.Minor) { return null; }
        if (secCount == 0) { return null; }   // z42 writer 恒写目录
        ZbcSectionZ[] dir = ZbcReader._readDir(data, secCount);

        string nspc = ZbcReader._readNspc(data, dir);
        string[] pool = ZbcReader._readStrs(data, dir);
        if (pool == null) { return null; }
        IrClassDesc[] classes = ZbcReader._readType(data, dir, pool);
        int classCount = ZbcReader._lastN;
        SigEntryZ[] sigs = ZbcReader._readSigs(data, dir, pool);
        if (sigs == null) { return null; }
        int fnCount = ZbcReader._lastN;

        // token 解析表（SIGS/TYPE 插入序，镜像 TokenAllocator.FromModule）。
        string[] fnNames = new string[fnCount];
        int i = 0;
        while (i < fnCount) { fnNames[i] = sigs[i].Name; i = i + 1; }
        string[] clsNames = new string[classCount];
        i = 0;
        while (i < classCount) { clsNames[i] = classes[i].Name; i = i + 1; }

        IrFunction[] fns = ZbcReader._readFunc(data, dir, pool, sigs, fnCount, fnNames, clsNames, classCount);
        if (fns == null) { return null; }
        if (!ZbcReader._applyRegt(data, dir, fns, fnCount)) { return null; }
        ZbcReader._applyDbug(data, dir, pool, fns, fnCount);

        // 类型回填（REGT 就位后）。
        i = 0;
        while (i < fnCount) { ZbcReaderInstr.Retype(fns[i]); i = i + 1; }

        // 模块池重建（ConstStr 首现序）+ ConstStr.Idx 全局 STRS → 1-based 模块池。
        string[] localPool = new string[8];
        localPool[0] = "";
        int localN = 1;
        int[] strsToLocal = new int[pool.Length];
        i = 0;
        while (i < pool.Length) { strsToLocal[i] = 0 - 1; i = i + 1; }
        i = 0;
        while (i < fnCount) {
            IrFunction f = fns[i];
            int b = 0;
            while (b < f.BlockCount) {
                IrBlock blk = f.Blocks[b];
                int k = 0;
                while (k < blk.InstrCount) {
                    if (blk.Instrs[k] is ConstStrInstr) {
                        ConstStrInstr cs = blk.Instrs[k] as ConstStrInstr;
                        int gi = cs.Idx;
                        if (gi >= 0 && gi < pool.Length) {
                            if (strsToLocal[gi] < 0) {
                                if (localN == localPool.Length) {
                                    string[] bigger = new string[localPool.Length * 2];
                                    int m = 0; while (m < localN) { bigger[m] = localPool[m]; m = m + 1; }
                                    localPool = bigger;
                                }
                                localPool[localN] = pool[gi];
                                strsToLocal[gi] = localN;
                                localN = localN + 1;
                            }
                            cs.Idx = strsToLocal[gi];
                        }
                    }
                    k = k + 1;
                }
                b = b + 1;
            }
            i = i + 1;
        }

        IrModule irm = new IrModule(nspc, localPool, localN, classes, classCount, fns, fnCount);

        // TIDX（wire StrIdx = STRS idx + 1，0=无）→ 模块池 idx（缺则追加；序由 meta 回填修正）。
        IrTestEntry[] tests = ZbcReader._readTidx(data, dir);
        if (tests != null && ZbcReader._lastN > 0) {
            int tn = ZbcReader._lastN;
            int e = 0;
            while (e < tn) {
                IrTestEntry t = tests[e];
                t.SkipReasonStrIdx = ZbcReader._tidxToLocal(t.SkipReasonStrIdx, pool, irm);
                t.SkipPlatformStrIdx = ZbcReader._tidxToLocal(t.SkipPlatformStrIdx, pool, irm);
                t.SkipFeatureStrIdx = ZbcReader._tidxToLocal(t.SkipFeatureStrIdx, pool, irm);
                t.ExpectedThrowTypeIdx = ZbcReader._tidxToLocal(t.ExpectedThrowTypeIdx, pool, irm);
                int tc = 0;
                while (tc < t.TestCaseCount) {
                    t.TestCases[tc].ArgReprStrIdx = ZbcReader._tidxToLocal(t.TestCases[tc].ArgReprStrIdx, pool, irm);
                    tc = tc + 1;
                }
                e = e + 1;
            }
            irm.TestIndex = tests; irm.TestCount = tn;
        }
        return irm;
    }

    // 段大小旁路（z42 无 out 参；单线程解码安全，与 ZbcReaderInstr._argN 同款）。
    private static int _lastN = 0;

    // ── 目录与基础段 ────────────────────────────────────────────────────────────

    private static ZbcSectionZ[] _readDir(byte[] data, int secCount) {
        ZbcSectionZ[] dir = new ZbcSectionZ[secCount];
        ZbcCursor c = new ZbcCursor(data, 16);
        int i = 0;
        while (i < secCount) {
            string tag = c.Str(4);
            int off = c.U32();
            int size = c.U32();
            dir[i] = new ZbcSectionZ(tag, off, size);
            i = i + 1;
        }
        return dir;
    }

    private static ZbcSectionZ _sec(ZbcSectionZ[] dir, string tag) {
        int i = 0;
        while (i < dir.Length) {
            if (dir[i].Tag == tag) { return dir[i]; }
            i = i + 1;
        }
        return null;
    }

    private static string _readNspc(byte[] data, ZbcSectionZ[] dir) {
        ZbcSectionZ s = ZbcReader._sec(dir, "NSPC");
        if (s == null || s.Size < 2) { return ""; }
        ZbcCursor c = new ZbcCursor(data, s.Offset);
        int len = c.U16();
        return c.Str(len);
    }

    // STRS segment-dict（zbc 1.21）：段字典 + 每串段索引序列 → join('.') 还原。
    private static string[] _readStrs(byte[] data, ZbcSectionZ[] dir) {
        ZbcSectionZ s = ZbcReader._sec(dir, "STRS");
        if (s == null || s.Size < 8) { return null; }
        return ZbcReader.DecodeStrs(data, s.Offset);
    }

    // STRS segment-dict 解码（从 offset 起）。public：供单测直接对 BuildStrs 输出往返验证。
    // 段索引越界 → null（strict，与 strict-pin 同风格）。
    public static string[] DecodeStrs(byte[] data, int offset) {
        ZbcCursor c = new ZbcCursor(data, offset);
        int segCount = c.U32();
        string[] segDict = new string[segCount];
        int i = 0;
        while (i < segCount) {
            int segLen = c.Varint();
            segDict[i] = c.Str(segLen);
            i = i + 1;
        }
        int strCount = c.U32();
        string[] r = new string[strCount];
        i = 0;
        while (i < strCount) {
            int segN = c.Varint();
            string name = "";
            int j = 0;
            while (j < segN) {
                int segIdx = c.Varint();
                if (segIdx < 0 || segIdx >= segCount) { return null; }
                if (j > 0) { name = name + "."; }
                name = name + segDict[segIdx];
                j = j + 1;
            }
            r[i] = name;
            i = i + 1;
        }
        return r;
    }

    // ── TYPE ────────────────────────────────────────────────────────────────────

    private static IrClassDesc[] _readType(byte[] data, ZbcSectionZ[] dir, string[] pool) {
        ZbcSectionZ s = ZbcReader._sec(dir, "TYPE");
        if (s == null || s.Size < 4) { ZbcReader._lastN = 0; return new IrClassDesc[0]; }
        return ZbcReader.ReadTypeAt(data, s.Offset, pool);
    }

    // TYPE 段体解析（给定偏移；reconcile-tsig-from-runtime-sections 公开——zpkg MODS 每模块
    // 记录内嵌的 TYPE 字节与 zbc TYPE 段同构，ZpkgReader.ReadModuleTypes 复用本入口）。
    public static IrClassDesc[] ReadTypeAt(byte[] data, int offset, string[] pool) {
        ZbcCursor c = new ZbcCursor(data, offset);
        int n = c.U32();
        IrClassDesc[] classes = new IrClassDesc[n];
        int ci = 0;
        while (ci < n) {
            string name = ZbcReader._p(pool, c.U32());
            int baseRaw = c.U32();
            bool hasBase = !ZbcReader._isNoneU32(baseRaw);
            string baseName = hasBase ? ZbcReader._p(pool, baseRaw) : "";
            int fc = c.U16();
            IrFieldDesc[] fields = new IrFieldDesc[fc];
            int f = 0;
            while (f < fc) {
                string fname = ZbcReader._p(pool, c.U32());
                c.U8();   // type_tag（提示位；串为准，1.7 约定）
                string ft = ZbcReader._p(pool, c.U32());
                IrFieldDesc fd = new IrFieldDesc(fname, ft);
                ZbcReader._readFieldAttrs(c, pool, fd);
                fd.Visibility = c.U8();   // add-member-visibility（zbc 1.23）：attrs 后
                ZbcReader._readFieldFlags(c, pool, fd);   // add-deprecated-directive（zbc 1.37）
                fields[f] = fd;
                f = f + 1;
            }
            IrClassDesc cd = new IrClassDesc(name, hasBase, baseName, fields, fc);
            int tpc = c.U8();
            cd.TypeParams = new string[tpc]; cd.TypeParamCount = tpc;
            cd.TypeParamConstraints = new IrConstraintDesc[tpc];
            int tpi = 0;
            while (tpi < tpc) {
                cd.TypeParams[tpi] = ZbcReader._p(pool, c.U32());
                // constraint bundle（z42 writer 子集：flags[bit3 tpRef] + ifaceCount + ifaces）
                IrConstraintDesc bundle = new IrConstraintDesc();
                int cflags = c.U8();
                if ((cflags & 8) != 0) { bundle.TypeParamConstraint = ZbcReader._p(pool, c.U32()); }
                int ifc = c.U8();
                bundle.Interfaces = new string[ifc]; bundle.InterfaceCount = ifc;
                int ifi = 0;
                while (ifi < ifc) { bundle.Interfaces[ifi] = ZbcReader._p(pool, c.U32()); ifi = ifi + 1; }
                cd.TypeParamConstraints[tpi] = bundle;
                tpi = tpi + 1;
            }
            int ac = c.U16();
            cd.Attrs = new IrAttrRef[ac]; cd.AttrCount = ac;
            int ai = 0;
            while (ai < ac) {
                string tn = ZbcReader._p(pool, c.U32());
                cd.Attrs[ai] = new IrAttrRef(tn, ZbcReader._p(pool, c.U32()));
                ai = ai + 1;
            }
            cd.Flags = c.U8();
            cd.Visibility = c.U8();   // enforce-class-access（zbc 1.33）：类声明可见性字节（紧随 Flags）
            if ((cd.Flags & 64) != 0) { cd.DeprecationMsg = ZbcReader._p(pool, c.U32()); }   // add-deprecated-directive（zbc 1.37）：类级 bit6 gated 消息串
            int sfc = c.U16();
            cd.StaticFields = new IrFieldDesc[sfc]; cd.StaticFieldCount = sfc;
            int sf = 0;
            while (sf < sfc) {
                string sn = ZbcReader._p(pool, c.U32());
                c.U8();
                string st = ZbcReader._p(pool, c.U32());
                IrFieldDesc sd = new IrFieldDesc(sn, st);
                ZbcReader._readFieldAttrs(c, pool, sd);
                sd.Visibility = c.U8();   // add-member-visibility（zbc 1.23）：attrs 后
                ZbcReader._readFieldFlags(c, pool, sd);   // add-deprecated-directive（zbc 1.37）
                cd.StaticFields[sf] = sd;
                sf = sf + 1;
            }
            int ifn = c.U16();
            cd.Interfaces = new string[ifn]; cd.InterfaceCount = ifn;
            int ix = 0;
            while (ix < ifn) { cd.Interfaces[ix] = ZbcReader._p(pool, c.U32()); ix = ix + 1; }
            // enum 成员块（Flags bit5 gated；add-enum-type-metadata）：此前 z42c 侧未消费——
            // enum 记录一旦出现会致游标错位（潜伏），随 1.28 一并补齐消费（读入 cd）。
            if ((cd.Flags & 32) != 0) {
                int emc = c.U16();
                cd.EnumMemberNames = new string[emc]; cd.EnumMemberValues = new long[emc]; cd.EnumMemberCount = emc;
                int emx = 0;
                while (emx < emc) {
                    cd.EnumMemberNames[emx] = ZbcReader._p(pool, c.U32());
                    cd.EnumMemberValues[emx] = c.I64();
                    emx = emx + 1;
                }
            }
            // 接口方法签名块（zbc 1.28，fix-crosspkg-interface-impl；Flags bit4 gated）：
            // mcount:u16 + (name:u32, ret:u32, pcount:u8, ptype:u32×pc)×n → 平行数组 + 扁平参数表。
            if ((cd.Flags & 16) != 0) {
                int imc = c.U16();
                cd.IfaceMethodNames = new string[imc]; cd.IfaceMethodRets = new string[imc];
                cd.IfaceMethodParamCounts = new int[imc]; cd.IfaceMethodCount = imc;
                string[] ipts = new string[8];
                int iptc = 0;
                int imr = 0;
                while (imr < imc) {
                    cd.IfaceMethodNames[imr] = ZbcReader._p(pool, c.U32());
                    cd.IfaceMethodRets[imr] = ZbcReader._p(pool, c.U32());
                    int ipc = c.U8();
                    cd.IfaceMethodParamCounts[imr] = ipc;
                    int ipr = 0;
                    while (ipr < ipc) {
                        if (iptc == ipts.Length) {
                            string[] b = new string[ipts.Length * 2];
                            int k = 0; while (k < iptc) { b[k] = ipts[k]; k = k + 1; }
                            ipts = b;
                        }
                        ipts[iptc] = ZbcReader._p(pool, c.U32());
                        iptc = iptc + 1;
                        ipr = ipr + 1;
                    }
                    imr = imr + 1;
                }
                cd.IfaceMethodParamTypes = ipts; cd.IfaceMethodParamTotal = iptc;
            }
            // 值 struct 布局块（zbc 1.31，add-struct-value-semantics A-use）：Flags bit2(0x04)=struct 时
            // 追加 size:u32 + ref_count:u16 + (byte_off:u32, kind:u8)×n。**必须与 ZbcWriter.BuildType 对称**
            // ——DepScan/TsigReconcile 读依赖 zpkg 的 TYPE 段时不消费此块会致游标错位、后续类字段读越界。
            if ((cd.Flags & 4) != 0) {
                cd.StructSize = c.U32();
                int src = c.U16();
                cd.StructRefOffsets = new int[src]; cd.StructRefKinds = new int[src]; cd.StructRefCount = src;
                int srx = 0;
                while (srx < src) {
                    cd.StructRefOffsets[srx] = c.U32();
                    cd.StructRefKinds[srx] = c.U8();
                    srx = srx + 1;
                }
            }
            // 合成内联 struct 布局块（zbc 1.32，add-struct-heap-inline P3b）：Flags bit7(0x80) gated，随 struct 块之后。
            // z42c/stdlib 零生产内联字段类 → 此块实际从不出现在 z42c 读的依赖里；但为与 ZbcWriter.BuildType 对称、
            // 防未来错位，仍按序消费（gated 不出现即零字节）。
            if ((cd.Flags & 128) != 0) {
                cd.InlineSize = c.U32();
                int irc = c.U16();
                cd.InlineRefOffsets = new int[irc]; cd.InlineRefKinds = new int[irc]; cd.InlineRefCount = irc;
                int irx = 0;
                while (irx < irc) {
                    cd.InlineRefOffsets[irx] = c.U32();
                    cd.InlineRefKinds[irx] = c.U8();
                    irx = irx + 1;
                }
            }
            // 对象全字段布局块（zbc 1.34，unify-object-byte-layout PR-1）：普通引用类（Flags 不含
            // struct(4)/interface(16)/enum(32)/delegate(64)=116）随 inline 块之后。**必须与 ZbcWriter 对称**——
            // z42c/stdlib 大量产普通类 → DepScan/TsigReconcile 读依赖 TYPE 段不消费此块会致游标错位、后续读越界。
            if ((cd.Flags & 116) == 0) {   // 116 = 4|16|32|64
                cd.ObjectSize = c.U32();
                int ofc = c.U16();
                cd.ObjFieldOffsets = new int[ofc]; cd.ObjFieldSizes = new int[ofc]; cd.ObjFieldKinds = new int[ofc]; cd.ObjFieldCount = ofc;
                int ofx = 0;
                while (ofx < ofc) {
                    cd.ObjFieldOffsets[ofx] = c.U32();
                    cd.ObjFieldSizes[ofx] = c.U32();
                    cd.ObjFieldKinds[ofx] = c.U8();
                    ofx = ofx + 1;
                }
                int orc = c.U16();
                cd.ObjRefOffsets = new int[orc]; cd.ObjRefKinds = new int[orc]; cd.ObjRefCount = orc;
                int orx = 0;
                while (orx < orc) {
                    cd.ObjRefOffsets[orx] = c.U32();
                    cd.ObjRefKinds[orx] = c.U8();
                    orx = orx + 1;
                }
            }
            classes[ci] = cd;
            ci = ci + 1;
        }
        ZbcReader._lastN = n;
        return classes;
    }

    private static void _readFieldAttrs(ZbcCursor c, string[] pool, IrFieldDesc fd) {
        int n = c.U16();
        fd.Attrs = new IrAttrRef[n]; fd.AttrCount = n;
        int i = 0;
        while (i < n) {
            string tn = ZbcReader._p(pool, c.U32());
            fd.Attrs[i] = new IrAttrRef(tn, ZbcReader._p(pool, c.U32()));
            i = i + 1;
        }
    }

    // add-deprecated-directive（zbc 1.37）：字段 flags 字节（bit0=deprecated）+ gated 消息串。镜像 _writeFieldFlags。
    private static void _readFieldFlags(ZbcCursor c, string[] pool, IrFieldDesc fd) {
        int ff = c.U8();
        if ((ff & 1) != 0) { fd.Deprecated = true; fd.DeprecationMsg = ZbcReader._p(pool, c.U32()); }
    }

    // ── SIGS ────────────────────────────────────────────────────────────────────

    private static SigEntryZ[] _readSigs(byte[] data, ZbcSectionZ[] dir, string[] pool) {
        ZbcSectionZ s = ZbcReader._sec(dir, "SIGS");
        if (s == null || s.Size < 4) { return null; }
        ZbcCursor c = new ZbcCursor(data, s.Offset);
        int n = c.U32();
        SigEntryZ[] r = new SigEntryZ[n];
        int i = 0;
        while (i < n) {
            SigEntryZ e = new SigEntryZ();
            e.Name = ZbcReader._p(pool, c.U32());
            e.ParamCount = c.U16();
            c.U8();   // ret_tag（提示位；串为准）
            e.RetType = ZbcReader._p(pool, c.U32());
            int em = c.U8();
            if (em == 1) { e.ExecMode = "Jit"; } else if (em == 2) { e.ExecMode = "Aot"; } else { e.ExecMode = "Interp"; }
            e.IsStatic = c.U8() != 0;
            e.Visibility = c.U8();   // add-member-visibility（zbc 1.23）：is_static 后、params 前
            e.MethodFlags = c.U8();  // add-method-modifiers（zbc 1.24）：visibility 后、params 前
            e.MinArg = c.U16();      // add-param-metadata（zbc 1.25）：method_flags 后
            e.ParamsFrom = c.U8();
            e.ParamTypes = new string[e.ParamCount]; e.ParamTypeCount = e.ParamCount;
            e.ParamNames = new string[e.ParamCount];
            e.ParamDefaultKinds = new int[e.ParamCount];
            e.ParamDefaultVals = new long[e.ParamCount];
            e.ParamDefaultStrs = new string[e.ParamCount];
            int p = 0;
            while (p < e.ParamCount) {
                e.ParamTypes[p] = ZbcReader._p(pool, c.U32());
                e.ParamNames[p] = ZbcReader._p(pool, c.U32());   // name_str_idx
                int dk = c.U8();                                  // default_kind
                e.ParamDefaultKinds[p] = dk;
                long dv = 0; string ds = "";
                if (dk == 2 || dk == 3) { dv = c.I64(); }
                else if (dk == 4) { dv = (long)c.U8(); }
                else if (dk == 5) { ds = ZbcReader._p(pool, c.U32()); }
                e.ParamDefaultVals[p] = dv; e.ParamDefaultStrs[p] = ds;
                p = p + 1;
            }
            int tpc = c.U8();   // z42 writer 恒 0；防御性跳过（bundle 与 writer 子集同构）
            int t = 0;
            while (t < tpc) {
                c.U32();
                int cflags = c.U8();
                if ((cflags & 8) != 0) { c.U32(); }
                int ifc = c.U8();
                int ii = 0;
                while (ii < ifc) { c.U32(); ii = ii + 1; }
                t = t + 1;
            }
            int ac = c.U16();
            e.Attrs = new IrAttrRef[ac]; e.AttrCount = ac;
            int a = 0;
            while (a < ac) {
                string tn = ZbcReader._p(pool, c.U32());
                e.Attrs[a] = new IrAttrRef(tn, ZbcReader._p(pool, c.U32()));
                a = a + 1;
            }
            // 每参数 attr 块（writer 对每个 param 恒写 count，含 0）。
            e.ParamAttrs = new IrAttrRefList[e.ParamCount]; e.ParamAttrsLen = e.ParamCount;
            int pa = 0;
            bool anyPa = false;
            while (pa < e.ParamCount) {
                int pn = c.U16();
                IrAttrRef[] items = new IrAttrRef[pn];
                int pj = 0;
                while (pj < pn) {
                    string tn = ZbcReader._p(pool, c.U32());
                    items[pj] = new IrAttrRef(tn, ZbcReader._p(pool, c.U32()));
                    pj = pj + 1;
                }
                if (pn > 0) { anyPa = true; }
                e.ParamAttrs[pa] = new IrAttrRefList(items, pn);
                pa = pa + 1;
            }
            if (!anyPa) { e.ParamAttrs = new IrAttrRefList[0]; e.ParamAttrsLen = 0; }   // writer：ParamAttrsLen=0 → 全零块，往返等价
            // add-deprecated-directive（zbc 1.37）：method_flags bit3 gated 消息串 idx（SIGS 条目尾部）。
            if ((e.MethodFlags & 8) != 0) { e.DeprecationMsg = ZbcReader._p(pool, c.U32()); }
            r[i] = e;
            i = i + 1;
        }
        ZbcReader._lastN = n;
        return r;
    }

    // ── FUNC ────────────────────────────────────────────────────────────────────

    private static IrFunction[] _readFunc(byte[] data, ZbcSectionZ[] dir, string[] pool,
                                          SigEntryZ[] sigs, int fnCount,
                                          string[] fnNames, string[] clsNames, int clsCount) {
        ZbcSectionZ s = ZbcReader._sec(dir, "FUNC");
        if (s == null || s.Size < 4) { return null; }
        ZbcCursor c = new ZbcCursor(data, s.Offset);
        int n = c.U32();
        if (n != fnCount) { return null; }
        IrFunction[] fns = new IrFunction[n];
        int fi = 0;
        while (fi < n) {
            int regCount = c.U16();
            int blockCount = c.U16();
            int instrLen = c.U32();
            int excCount = c.U16();
            int[] blockOffs = new int[blockCount];
            int bi = 0;
            while (bi < blockCount) { blockOffs[bi] = c.U32(); bi = bi + 1; }
            // 异常表（blockOffsets 后、instrBytes 前）
            int[] excS = new int[excCount]; int[] excE = new int[excCount]; int[] excC = new int[excCount];
            int[] excT = new int[excCount]; int[] excR = new int[excCount];
            int xe = 0;
            while (xe < excCount) {
                excS[xe] = c.U16(); excE[xe] = c.U16(); excC[xe] = c.U16();
                excT[xe] = c.U32(); excR[xe] = c.U16();
                xe = xe + 1;
            }
            int instrBase = c.Pos;
            IrBlock[] blocks = new IrBlock[blockCount];
            bi = 0;
            while (bi < blockCount) {
                int bStart = instrBase + blockOffs[bi];
                int bEnd = instrBase + instrLen;
                if (bi + 1 < blockCount) { bEnd = instrBase + blockOffs[bi + 1]; }
                ZbcCursor bc = new ZbcCursor(data, bStart);
                DecodedBlockZ db = ZbcReaderInstr.DecodeBlock(bc, bEnd, pool, fnNames, fnCount, clsNames, clsCount);
                if (!db.Ok) { return null; }
                string label = "entry";
                if (bi > 0) { label = "block_" + bi.ToString(); }
                blocks[bi] = new IrBlock(label, db.Instrs, db.InstrCount, db.Term, db.HasTerm);
                bi = bi + 1;
            }
            c.Pos = instrBase + instrLen;
            SigEntryZ sig = sigs[fi];
            IrFunction f = new IrFunction(sig.Name, sig.ParamCount, sig.RetType, sig.IsStatic,
                                          blocks, blockCount, regCount,
                                          sig.ExecMode, sig.ParamTypes, sig.ParamTypeCount,
                                          new int[0], 0,
                                          new IrLineEntry[0], 0, new IrLocalVarEntry[0], 0);
            f.Attrs = sig.Attrs; f.AttrCount = sig.AttrCount;
            f.ParamAttrs = sig.ParamAttrs; f.ParamAttrsLen = sig.ParamAttrsLen;
            f.Visibility = sig.Visibility; f.MethodFlags = sig.MethodFlags;   // 1.23/1.24 round-trip
            f.DeprecationMsg = sig.DeprecationMsg;   // add-deprecated-directive（zbc 1.37）round-trip
            f.MinArg = sig.MinArg; f.ParamsFrom = sig.ParamsFrom;             // add-param-metadata round-trip
            f.ParamNames = sig.ParamNames; f.ParamDefaultKinds = sig.ParamDefaultKinds;
            f.ParamDefaultVals = sig.ParamDefaultVals; f.ParamDefaultStrs = sig.ParamDefaultStrs;
            if (excCount > 0) {
                IrExcEntry[] et = new IrExcEntry[excCount];
                xe = 0;
                while (xe < excCount) {
                    string ts = ZbcReader._blk(excS[xe]);
                    string te = ZbcReader._blk(excE[xe]);   // == blockCount 的哨兵同款命名 → 写回落 dflt
                    string cl = ZbcReader._blk(excC[xe]);
                    bool hasT = !ZbcReader._isNoneU32(excT[xe]);
                    string ct = hasT ? ZbcReader._p(pool, excT[xe]) : "";
                    et[xe] = new IrExcEntry(ts, te, cl, hasT, ct, new TypedReg(excR[xe], IrType.Unknown));
                    xe = xe + 1;
                }
                f.ExcTable = et; f.ExcCount = excCount;
            }
            fns[fi] = f;
            fi = fi + 1;
        }
        return fns;
    }

    private static string _blk(int idx) {
        if (idx == 0) { return "entry"; }
        return "block_" + idx.ToString();
    }

    // ── REGT / DBUG / TIDX ──────────────────────────────────────────────────────

    private static bool _applyRegt(byte[] data, ZbcSectionZ[] dir, IrFunction[] fns, int fnCount) {
        ZbcSectionZ s = ZbcReader._sec(dir, "REGT");
        if (s == null || s.Size < 4) { return false; }   // z42 writer 恒发射 REGT
        ZbcCursor c = new ZbcCursor(data, s.Offset);
        int n = c.U32();
        if (n != fnCount) { return false; }
        int fi = 0;
        while (fi < n) {
            int rc = c.U32();
            int[] rt = new int[rc];
            int i = 0;
            while (i < rc) { rt[i] = c.U8(); i = i + 1; }
            fns[fi].RegTypes = rt; fns[fi].RegTypeCount = rc;
            fi = fi + 1;
        }
        return true;
    }

    private static void _applyDbug(byte[] data, ZbcSectionZ[] dir, string[] pool, IrFunction[] fns, int fnCount) {
        ZbcSectionZ s = ZbcReader._sec(dir, "DBUG");
        if (s == null || s.Size < 4) { return; }
        ZbcCursor c = new ZbcCursor(data, s.Offset);
        int n = c.U32();
        if (n != fnCount) { return; }
        int fi = 0;
        while (fi < n) {
            int lc = c.U16();
            IrLineEntry[] lines = new IrLineEntry[lc];
            int i = 0;
            while (i < lc) {
                int blk = c.U16();
                int ins = c.U16();
                int line = c.U32();
                int fileIdx = c.U32();
                int col = c.U32();
                bool hasFile = !ZbcReader._isNoneU32(fileIdx);
                string file = hasFile ? ZbcReader._p(pool, fileIdx) : "";
                lines[i] = new IrLineEntry(blk, ins, line, hasFile, file, col);
                i = i + 1;
            }
            int vc = c.U16();
            IrLocalVarEntry[] vars = new IrLocalVarEntry[vc];
            i = 0;
            while (i < vc) {
                string name = ZbcReader._p(pool, c.U32());
                vars[i] = new IrLocalVarEntry(name, c.U16());
                i = i + 1;
            }
            fns[fi].LineTable = lines; fns[fi].LineCount = lc;
            fns[fi].LocalVars = vars; fns[fi].LocalVarCount = vc;
            fi = fi + 1;
        }
    }

    private static IrTestEntry[] _readTidx(byte[] data, ZbcSectionZ[] dir) {
        ZbcSectionZ s = ZbcReader._sec(dir, "TIDX");
        if (s == null || s.Size < 9) { ZbcReader._lastN = 0; return null; }
        ZbcCursor c = new ZbcCursor(data, s.Offset);
        string magic = c.Str(4);
        if (magic != "TIDX") { ZbcReader._lastN = 0; return null; }
        int ver = c.U8();
        if (ver != TidxVersion.Version) { ZbcReader._lastN = 0; return null; }
        int n = c.U32();
        IrTestEntry[] r = new IrTestEntry[n];
        int e = 0;
        while (e < n) {
            IrTestEntry t = new IrTestEntry(c.U32());
            t.Kind = c.U8();
            t.Flags = c.U16();
            t.SkipReasonStrIdx = c.U32();
            t.SkipPlatformStrIdx = c.U32();
            t.SkipFeatureStrIdx = c.U32();
            t.ExpectedThrowTypeIdx = c.U32();
            int tc = c.U32();
            t.TestCases = new IrTestCase[tc]; t.TestCaseCount = tc;
            int j = 0;
            while (j < tc) { t.TestCases[j] = new IrTestCase(c.U32()); j = j + 1; }
            t.TimeoutMs = c.U32();
            r[e] = t;
            e = e + 1;
        }
        ZbcReader._lastN = n;
        return r;
    }

    // TIDX wire idx（1-based STRS + 1 偏移，0=无）→ 1-based 模块池 idx（缺则追加）。
    private static int _tidxToLocal(int wireIdx, string[] strs, IrModule irm) {
        if (wireIdx <= 0) { return 0; }
        int gi = wireIdx - 1;
        if (gi < 0 || gi >= strs.Length) { return 0; }
        string v = strs[gi];
        int i = 1;
        while (i < irm.StringCount) {
            if (irm.StringPool[i] == v) { return i; }
            i = i + 1;
        }
        if (irm.StringCount == irm.StringPool.Length) {
            string[] bigger = new string[irm.StringPool.Length * 2];
            int m = 0; while (m < irm.StringCount) { bigger[m] = irm.StringPool[m]; m = m + 1; }
            irm.StringPool = bigger;
        }
        irm.StringPool[irm.StringCount] = v;
        irm.StringCount = irm.StringCount + 1;
        return irm.StringCount - 1;
    }

    private static string _p(string[] pool, int idx) {
        if (idx >= 0 && idx < pool.Length) { return pool[idx]; }
        return "";
    }

    // u32 0xFFFFFFFF 哨兵检测。⚠ 不能与 `0 - 1` 比较：ZbcCursor.U32 以 `a|(b<<16)`
    // 组装，z42 int 移位语义下 0xFFFFFFFF 不为 -1（e2e 实证同 ZbcReaderInstr._isImport）。
    private static bool _isNoneU32(int v) {
        return (v & 0x7FFFFFFF) == 0x7FFFFFFF && ((v >> 31) & 1) == 1;
    }
}
