// 非泛型 string→object 哈希表（z42c.ir 自持副本；模式同 semantics/StrMap——ir 是叶子不能依赖 semantics）。
// port-z42c-import CI-2：DependencyIndex 键表用。+TryAdd（first-wins 语义，common-pitfalls §1 的消费端）。
// ⚠ 无 Remove（开放寻址线性探测删除需墓碑）——需要"剔除"时重建新表。
namespace Z42.IR;

public sealed class StrMap {
    private string[] _keys;
    private object[] _vals;
    private bool[]   _used;
    private int      _count;
    private int      _cap;

    public StrMap() {
        this._cap = 16;
        this._keys = new string[16];
        this._vals = new object[16];
        this._used = new bool[16];
        this._count = 0;
    }

    public int Count() { return this._count; }

    public bool ContainsKey(string key) { return this._find(key) >= 0; }

    // 不存在返回 null（调用方 `as`-下行前 ContainsKey 或判 null）。
    public object Get(string key) {
        int i = this._find(key);
        if (i >= 0) { return this._vals[i]; }
        return null;
    }

    public void Put(string key, object val) {
        if (this._count * 2 >= this._cap) { this._grow(); }
        int slot = this._slotFor(key);
        if (!this._used[slot]) { this._count = this._count + 1; }
        this._keys[slot] = key;
        this._vals[slot] = val;
        this._used[slot] = true;
    }

    // first-wins：已存在则不覆盖（返回 false）。
    public bool TryAdd(string key, object val) {
        if (this.ContainsKey(key)) { return false; }
        this.Put(key, val);
        return true;
    }

    // ── 无分配槽位遍历（perf-compiler-lookup-tables）────────────────────────────────
    // 调用方按 0..Capacity()-1 扫 UsedAt(i) 为 true 的槽读 KeyAt/ValAt，取代「Keys() 分配整表 + 逐键 Get 再哈希」
    // 的热点写法（重载候选枚举 / 用户转换查找）。槽序 = 哈希布局序，**非确定性迭代序**——只可用于
    // 「过滤后按稳定键再排」或「结果与顺序无关」的场景（common-pitfalls §1）；需要确定序仍用 Keys()。
    public int    Capacity()      { return this._cap; }
    public bool   UsedAt(int i)   { return this._used[i]; }
    public string KeyAt(int i)    { return this._keys[i]; }
    public object ValAt(int i)    { return this._vals[i]; }
    // 批量视图：整表扫描的调用方拿一次数组，就不必每槽两次 z42 方法调用（UsedAt + ValAt）。
    // ⚠ 返回的是内部数组本体，只可读、且只在扫描期间持有 —— 任何 Put 都可能触发 _grow 换掉它们。
    public bool[]   UsedArr()     { return this._used; }
    public object[] ValArr()      { return this._vals; }

    public string[] Keys() {
        string[] r = new string[this._count];
        int n = 0;
        int i = 0;
        while (i < this._cap) {
            if (this._used[i]) { r[n] = this._keys[i]; n = n + 1; }
            i = i + 1;
        }
        return r;
    }

    // 槽号：`_cap` 恒为 2 的幂（16 起、_grow 翻倍）⇒ `h % _cap` 等价于 `h & (_cap-1)`，
    // 省掉每次查找一次整除。与旧式 `(h & 0x7FFFFFFF) % _cap` 逐位等值：低位掩码本就落在
    // 0x7FFFFFFF 之内，清符号位那一步对结果没有影响，结果恒非负。探测序不变 ⇒ 槽布局不变。
    // 原来还外套一层 `_hash` 方法调用，每次查找一次 —— 一并内联掉。

    // 查找已有 key 的槽（命中返回槽号，未命中 -1）。
    private int _find(string key) {
        int slot = key.GetHashCode() & (this._cap - 1);
        int probes = 0;
        while (probes < this._cap) {
            if (!this._used[slot]) { return -1; }
            if (this._keys[slot] == key) { return slot; }
            slot = slot + 1;
            if (slot >= this._cap) { slot = 0; }
            probes = probes + 1;
        }
        return -1;
    }

    // 为 Put 找槽：命中 key 的槽（更新）或第一个空槽（负载 <0.5 必有空）。
    private int _slotFor(string key) {
        int slot = key.GetHashCode() & (this._cap - 1);
        while (this._used[slot] && this._keys[slot] != key) {
            slot = slot + 1;
            if (slot >= this._cap) { slot = 0; }
        }
        return slot;
    }

    private void _grow() {
        int oldCap = this._cap;
        string[] oldKeys = this._keys;
        object[] oldVals = this._vals;
        bool[]   oldUsed = this._used;
        this._cap = oldCap * 2;
        this._keys = new string[this._cap];
        this._vals = new object[this._cap];
        this._used = new bool[this._cap];
        this._count = 0;
        int i = 0;
        while (i < oldCap) {
            if (oldUsed[i]) { this.Put(oldKeys[i], oldVals[i]); }
            i = i + 1;
        }
    }
}
