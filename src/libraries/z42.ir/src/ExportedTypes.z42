// 导出类型签名模型（port-z42c-tsig TS-1）。镜像 C# z42.IR/ExportedTypes.cs。
// TSIG/IMPL 段的内存形态；受限写法 typed array + count。
namespace Z42.IR;

public sealed class ExportedParamZ {
    public string Name;       // 方法/函数 "p{i}"；委托 "arg{i}"（C# 实测）
    public string TypeName;
    public string DefaultBlob;   // PR6：`$Default` ConstBlob 串（无默认值 → ""）
    public string CallerKind;    // PR6：caller 宏种类 "member"/"line"/"file"/"module"（非 caller → ""）
    public ExportedParamZ(string name, string typeName) { this.Name = name; this.TypeName = typeName; this.DefaultBlob = ""; this.CallerKind = ""; }
}

public sealed class ExportedMethodZ {
    public string           Name;
    public string           ReturnType;
    public string           Visibility;   // "public"/"private"/"protected"/"internal"
    public bool             IsStatic;
    public bool             IsVirtual;
    public bool             IsAbstract;
    public int              MinArgCount;
    public ExportedParamZ[] Params;
    public int              ParamCount;
    public int              ParamsFrom;   // add-params-varargs：变长形参索引（0-based，= ParamCount-1）；-1 = 非变长。
    // add-params-varargs：ParamsFrom 保持累加式（构造函数元数不变）——ZpkgReader._method
    // 是自举编译器自身 TSIG 读取机制的调用点，旧种子（未含 ParamsFrom）冻结编译的调用约定
    // 不能被新增必填形参打破，否则自举链上旧种子读新格式 zpkg 时动态解析会 ABI 不匹配崩溃
    // （undefined register）。默认 -1（非变长），需要非默认值时构造后单独赋值。
    public bool             IsSealed;      // impl-sealed-semantics-devirt：方法级 sealed（METHOD_FLAG_SEALED）。
    // 同 ParamsFrom：构造函数元数保持不变（旧种子 ABI），默认 false，TsigReconcile 从 (MethodFlags & 4) 构造后赋值。
    public bool             IsDeprecated;    // add-deprecated-directive：方法级 `[Deprecated]`（METHOD_FLAG_DEPRECATED bit3）。
    public string           DeprecationMsg;  // 同 IsSealed：ctor 元数不变（旧种子 ABI），默认 false/""，TsigReconcile 构造后赋值。
    public int              TypeParamCount;  // add-array-paired-sort：方法级泛型形参个数（SIGS 早已存 tp 块，无格式 bump）。
    // 同 IsSealed/ParamsFrom：ctor 元数不变（旧种子 ABI），默认 0，构造后由 SigEntryZ 赋值。供泛型 arity 重载过滤。
    public ExportedMethodZ(string name, string returnType, string visibility,
                           bool isStatic, bool isVirtual, bool isAbstract, int minArgCount,
                           ExportedParamZ[] params_, int paramCount) {
        this.Name = name; this.ReturnType = returnType; this.Visibility = visibility;
        this.IsStatic = isStatic; this.IsVirtual = isVirtual; this.IsAbstract = isAbstract;
        this.MinArgCount = minArgCount; this.Params = params_; this.ParamCount = paramCount;
        this.ParamsFrom = 0 - 1;
        this.IsSealed = false;
        this.IsDeprecated = false; this.DeprecationMsg = "";
        this.TypeParamCount = 0;
    }
}

public sealed class ExportedFieldZ {
    public string Name;
    public string TypeName;
    public string Visibility;
    public bool   IsStatic;
    public bool   IsDeprecated;    // add-deprecated-directive：字段级 `[Deprecated]`（field-flags bit0）。
    public string DeprecationMsg;  // ctor 元数不变（旧种子 ABI），默认 false/""，TsigReconcile 构造后赋值。
    public ExportedFieldZ(string name, string typeName, string visibility, bool isStatic) {
        this.Name = name; this.TypeName = typeName; this.Visibility = visibility; this.IsStatic = isStatic;
        this.IsDeprecated = false; this.DeprecationMsg = "";
    }
}

public sealed class ExportedClassZ {
    public string            Name;        // 裸名（非 FQ；C# ct.Name 实测）
    public bool              HasBase;
    public string            BaseName;    // 短名（"Object"——TSIG 用符号表基名，区别于 TYPE 段的 "Std.Object"）
    public ExportedFieldZ[]  Fields;   public int FieldCount;
    public ExportedMethodZ[] Methods;  public int MethodCount;
    public string[] Interfaces; public int InterfaceCount;   // 实现的接口名（port-z42c-interface）
    public string[] TypeParams; public int TpCount;          // 泛型类型参数名（如 "T"/"K"/"V"）
    public bool     IsSealed;   // impl-sealed-semantics-devirt：sealed class（CLASS_FLAG_SEALED，TYPE Flags bit1）。
    // 构造函数元数保持不变（旧种子 ABI），默认 false，TsigReconcile 从 (cd.Flags & 2) 构造后赋值。
    public string   Visibility;   // enforce-class-access：类声明可见性（"public"/"private"/"protected"/"internal"）。
    // 默认 "public"，TsigReconcile 从 cd.Visibility（zbc TYPE 可见性字节）构造后赋值；ImportedSymbolLoader 据此填 Z42ClassType.Visibility（跨包 internal 类引用强制）。
    public bool     IsDeprecated;    // add-deprecated-directive：类级 `[Deprecated]`（CLASS_FLAG_DEPRECATED，TYPE Flags bit6）。
    public string   DeprecationMsg;  // ctor 元数不变（旧种子 ABI），默认 false/""，TsigReconcile 从 (cd.Flags & 64) 构造后赋值。
    // add-associated-types PR-1：泛型 where 约束（与 TypeParams 按下标对齐；null = 无约束）。
    // 修前跨包泛型实例化的 where 约束 **100% 不校验** —— 不只接口，连 base-class / class / struct /
    // 型参引用也不查：SymbolTable.ClassConstraints 的唯一写入点只遍历本包 CU 的 ClassDecl，导入类型
    // 全程不碰，Check 第一行 HasConstraints 即返回。约束数据本就在 zbc TYPE 段（bit0-6 早已规约），
    // 只是 TsigReconcile 从不读、这里也无处承载。
    // 直接复用 IrConstraintDesc（同库同 namespace），不另造一套平行编码 —— 少一层转换就少一处漂移点。
    // 种子 ABI：**不进构造函数签名**，ctor 内给默认值，由 TsigReconcile 构造后赋值（同 IsSealed/Visibility/IsDeprecated）。
    public IrConstraintDesc[] TypeParamConstraints; public int TpConstraintCount;
    public ExportedClassZ(string name, bool hasBase, string baseName,
                          ExportedFieldZ[] fields, int fieldCount,
                          ExportedMethodZ[] methods, int methodCount,
                          string[] typeParams, int tpCount) {
        this.Name = name; this.HasBase = hasBase; this.BaseName = baseName;
        this.Fields = fields; this.FieldCount = fieldCount;
        this.Methods = methods; this.MethodCount = methodCount;
        this.Interfaces = new string[0]; this.InterfaceCount = 0;
        this.TypeParams = typeParams; this.TpCount = tpCount;
        this.IsSealed = false;
        this.Visibility = "public";   // enforce-class-access：默认 public（reconcile 后赋值；未赋值即 public，绝不误拒）
        this.IsDeprecated = false; this.DeprecationMsg = "";
        this.TypeParamConstraints = null; this.TpConstraintCount = 0;   // add-associated-types PR-1（reconcile 后赋值）
    }
}

public sealed class ExportedInterfaceZ {
    public string            Name;
    public ExportedMethodZ[] Methods;     public int MethodCount;
    public string[]          TypeParams;  public int TpCount;
    // complete-class-access-control ④：接口声明可见性（"public"/"private"/"protected"/"internal"）。
    // 默认 "public"（未赋值即 public，绝不误拒）；TsigReconcile 从 cd.Visibility（zbc TYPE 可见性字节）
    // 构造后赋值；ImportedSymbolLoader 据此填 Z42InterfaceType.Visibility（跨包 internal 接口引用强制）。
    public string            Visibility;
    public ExportedInterfaceZ(string name, ExportedMethodZ[] methods, int methodCount,
                              string[] typeParams, int tpCount) {
        this.Name = name; this.Methods = methods; this.MethodCount = methodCount;
        this.TypeParams = typeParams; this.TpCount = tpCount;
        this.Visibility = "public";
    }
}

public sealed class ExportedEnumMemberZ {
    public string Name;
    public long   Value;
    public ExportedEnumMemberZ(string name, long value) { this.Name = name; this.Value = value; }
}

public sealed class ExportedEnumZ {
    public string                Name;
    public ExportedEnumMemberZ[] Members;
    public int                   MemberCount;
    public ExportedEnumZ(string name, ExportedEnumMemberZ[] members, int memberCount) {
        this.Name = name; this.Members = members; this.MemberCount = memberCount;
    }
}

public sealed class ExportedFuncZ {
    public string           Name;        // 短名（sem.Funcs 键；非 FQ——C# 字节实测）
    public string           ReturnType;
    public int              MinArgCount;
    public ExportedParamZ[] Params;
    public int              ParamCount;
    public int              ParamsFrom;   // add-params-varargs：变长形参索引（0-based，= ParamCount-1）；-1 = 非变长。
    // add-params-varargs：ParamsFrom 保持累加式，理由同 ExportedMethodZ（见其注释）。
    public ExportedFuncZ(string name, string returnType, int minArgCount,
                         ExportedParamZ[] params_, int paramCount) {
        this.Name = name; this.ReturnType = returnType; this.MinArgCount = minArgCount;
        this.Params = params_; this.ParamCount = paramCount; this.ParamsFrom = 0 - 1;
    }
}

public sealed class ExportedDelegateZ {
    public string           Name;
    public string           ReturnType;
    public ExportedParamZ[] Params;      public int ParamCount;
    public string[]         TypeParams;  public int TpCount;
    public bool             HasContainer;
    public string           ContainerClass;
    public ExportedDelegateZ(string name, string returnType,
                             ExportedParamZ[] params_, int paramCount,
                             string[] typeParams, int tpCount,
                             bool hasContainer, string containerClass) {
        this.Name = name; this.ReturnType = returnType;
        this.Params = params_; this.ParamCount = paramCount;
        this.TypeParams = typeParams; this.TpCount = tpCount;
        this.HasContainer = hasContainer; this.ContainerClass = containerClass;
    }
}

// 跨 zpkg `impl Trait for Type { ... }` 声明（L3-Impl2；镜像 C# ExportedImplDef）。
// target/trait 为 FQ 名（经 ImportedClassNs 解析），使消费端跨包合并 trait 进 imported target。
// 方法体不在此（在 MODS 段 func 名 "<TargetFq>.<m>"），此处仅签名供消费端 TypeChecker。
public sealed class ExportedImplZ {
    public string            TargetFq;
    public string            TraitFq;
    public string[]          TypeArgs;   public int TypeArgCount;
    public ExportedMethodZ[] Methods;    public int MethodCount;
    public ExportedImplZ(string targetFq, string traitFq,
                         string[] typeArgs, int typeArgCount,
                         ExportedMethodZ[] methods, int methodCount) {
        this.TargetFq = targetFq; this.TraitFq = traitFq;
        this.TypeArgs = typeArgs; this.TypeArgCount = typeArgCount;
        this.Methods = methods; this.MethodCount = methodCount;
    }
}

public sealed class ExportedModuleZ {
    public string               Namespace;
    public ExportedClassZ[]     Classes;     public int ClassCount;
    public ExportedInterfaceZ[] Interfaces;  public int InterfaceCount;
    public ExportedEnumZ[]      Enums;       public int EnumCount;
    public ExportedFuncZ[]      Functions;   public int FunctionCount;
    public ExportedDelegateZ[]  Delegates;   public int DelegateCount;
    public ExportedImplZ[]      Impls;       public int ImplCount;   // L3-Impl2（IMPL 段；提取后回填）
    public ExportedModuleZ(string ns,
                           ExportedClassZ[] classes, int classCount,
                           ExportedInterfaceZ[] interfaces, int interfaceCount,
                           ExportedEnumZ[] enums, int enumCount,
                           ExportedFuncZ[] functions, int functionCount,
                           ExportedDelegateZ[] delegates, int delegateCount) {
        this.Namespace = ns;
        this.Classes = classes; this.ClassCount = classCount;
        this.Interfaces = interfaces; this.InterfaceCount = interfaceCount;
        this.Enums = enums; this.EnumCount = enumCount;
        this.Functions = functions; this.FunctionCount = functionCount;
        this.Delegates = delegates; this.DelegateCount = delegateCount;
        this.Impls = new ExportedImplZ[0]; this.ImplCount = 0;
    }
}
