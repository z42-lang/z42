// 从 TYPE/SIGS/IMPL 重建 ExportedModuleZ（unify-type-metadata P2 建、P3 转正）。
// P3 删 TSIG 后，这是 z42c 跨包类型签名的**唯一来源**（DepScan 消费）——取代已删的 TSIG 段。
// 重建口径镜像 ExportedTypeExtractor（TSIG 的原生产端）：类 FQ→裸名（剥 arity-mangle）、
// Object 四方法注入（非 struct）、base 链 topmost-first 合并（override 保留祖先位）、参数名
// "p{i}"、可见性 u8→串、enum 恒=内建 GCHandleType、自由函数=全包 SIGS、IMPL 段→Impls。
// （P2 期另有对账器 Compare 与 TSIG oracle 逐字段验证 29 包 0-DIFF，P3 删 TSIG 后随之移除。）
namespace Z42.Project;

using Std;
using Std.IO;   // repl-scan-nsindex-cache：LazyReconWorld.EnsureIdx 惰性 open（File.ReadAllBytes）
using Z42.IR;

// world 每包的 TYPE/SIGS 解析缓存（z42 无交错数组 → 包装类）。
public sealed class ReconWorldPkg {
    public ZpkgModuleTypes[] Types;
    public ZpkgModuleSigs[]  Sigs;
    public ReconWorldPkg(ZpkgModuleTypes[] types, ZpkgModuleSigs[] sigs) { this.Types = types; this.Sigs = sigs; }
}

// 惰性跨包类型世界（lazy-type-world）：取代 BuildWorld 的一次性全量解析。Wp 按包懒填——
// 基类链重建遇到导入祖先 FQ 时，取其命名空间路由到「声明该 ns 的所有包」，只解析那几个包
// （spike 实证：闭包 max=3、avg=1，路由 230/230 与全量扫描一致）。首次 eval O(引用闭包)，
// 不随标准库增大恶化。产物与 eager 全量逐字节相同（解析确定 + 路由等价，见 design）。
public sealed class LazyReconWorld {
    public ZpkgInfo[]      World;       // world 包（非 exe），与 WorldDirs / Wp 平行；惰性 open 模式下初始 null
    public string[]        WorldDirs;   // 各包目录（indexed 散装 zbc 定位）
    public int             Wc;
    public ReconWorldPkg[] Wp;          // 懒填：null = 未解析
    // repl-scan-nsindex-cache：惰性 open 模式——World[i]==null 时按 WorldPaths[i] 现开（ns 索引命中路径下，
    // ScanDirsLazy 不再 open-all，只在 EnsureIdx 真正需要该包 TYPE/SIGS 时才开）。null = eager 模式（World 已全开）。
    public string[]        WorldPaths;
    // ns → world 索引（扁平 (ns, idx) 对；z42 无 int[][]，故平行数组 + 线性查）
    private string[] _pairNs; private int[] _pairIdx; private int _pairN;

    public LazyReconWorld(ZpkgInfo[] world, string[] worldDirs, int wc) {
        this.World = world; this.WorldDirs = worldDirs; this.Wc = wc;
        this.WorldPaths = null;   // eager 模式（现有调用方 + 种子 z42c）：World 已全开
        this.Wp = new ReconWorldPkg[wc];
        // 从每包 NSPC 建 (ns, world索引) 对表（廉价；不碰 TYPE/SIGS）。
        string[] pn = new string[16]; int[] pidx = new int[16]; int cnt = 0;
        int p = 0;
        while (p < wc) {
            string[] nss = ZpkgReader.ReadNamespaces(world[p]);
            int a = 0;
            while (a < nss.Length) {
                if (cnt == pn.Length) {
                    string[] b1 = new string[pn.Length * 2]; int[] b2 = new int[pn.Length * 2];
                    int k = 0; while (k < cnt) { b1[k] = pn[k]; b2[k] = pidx[k]; k = k + 1; }
                    pn = b1; pidx = b2;
                }
                pn[cnt] = nss[a]; pidx[cnt] = p; cnt = cnt + 1;
                a = a + 1;
            }
            p = p + 1;
        }
        this._pairNs = pn; this._pairIdx = pidx; this._pairN = cnt;
    }

    // 现开第 i 包（repl-scan-nsindex-cache 惰性 open：World[i]==null 且有 WorldPaths → Open 并缓存回）。
    private ZpkgInfo _openPkg(int i) {
        ZpkgInfo z = this.World[i];
        if (z == null && this.WorldPaths != null && i < this.WorldPaths.Length) {
            z = ZpkgReader.Open(File.ReadAllBytes(this.WorldPaths[i]));
            this.World[i] = z;
        }
        return z;
    }

    // repl-per-symbol-reconcile（中层）：**只读第 i 包的 `ns` 一个模块** TYPE/SIGS，追加进 Wp[i]（按 ns 增长）。
    // 幂等（已含该 ns 模块则跳过）。这是「按符号 reconcile」的关键——`Object`→只读 `Std` 模块，不碰
    // z42.core 其余 3 模块。Wp[i].Types[m]/Sigs[m] 平行同模块 → `_locate`/base 链按名字扫、与顺序无关 →
    // 产出与整包读 byte-identical（自举字节不动点门禁）。
    public void EnsureNs(int i, string ns) {
        if (this.Wp[i] != null) {
            int m = 0;
            while (m < this.Wp[i].Types.Length) { if (this.Wp[i].Types[m].Namespace == ns) { return; } m = m + 1; }
        }
        ZpkgInfo z = this._openPkg(i);
        ZpkgModuleTypes mt = ZpkgReader.ReadOneModuleTypes(z, this.WorldDirs[i], ns);
        ZpkgModuleSigs  ms = ZpkgReader.ReadOneModuleSigs(z, ns);
        if (this.Wp[i] == null) { this.Wp[i] = new ReconWorldPkg(new ZpkgModuleTypes[0], new ZpkgModuleSigs[0]); }
        ReconWorldPkg wp = this.Wp[i];
        int n = wp.Types.Length;
        ZpkgModuleTypes[] t2 = new ZpkgModuleTypes[n + 1];
        ZpkgModuleSigs[]  s2 = new ZpkgModuleSigs[n + 1];
        int k = 0;
        while (k < n) { t2[k] = wp.Types[k]; s2[k] = wp.Sigs[k]; k = k + 1; }
        t2[n] = mt; s2[n] = ms;
        wp.Types = t2; wp.Sigs = s2;
    }

    // 整包填满（eager / EnsureAll / 差分）：对第 i 包每个命名空间 EnsureNs（结果 == 旧整包读，byte-identical
    // ——_locate/base 链按名字扫、与模块顺序无关）。repl-per-symbol-reconcile：与 EnsureFq 的 per-ns 一致。
    public ReconWorldPkg EnsureIdx(int i) {
        ZpkgInfo z = this._openPkg(i);
        string[] nss = ZpkgReader.ReadNamespaces(z);
        int a = 0;
        while (a < nss.Length) { this.EnsureNs(i, nss[a]); a = a + 1; }
        if (this.Wp[i] == null) { this.Wp[i] = new ReconWorldPkg(new ZpkgModuleTypes[0], new ZpkgModuleSigs[0]); }
        return this.Wp[i];
    }

    // repl-scan-nsindex-cache：惰性 open 工厂——不 open 任何包、路由由传入的 (ns,idx) 对直接给定
    // （来自持久化 ns 索引），World 全 null 待 EnsureIdx 现开。与 3-arg 构造器（eager，World 已全开 +
    // 现场 ReadNamespaces 建路由）互补；两者产出的路由语义一致（同一 sorted 包序 + 同一 ns 列表）。
    public static LazyReconWorld LazyFromPairs(string[] worldPaths, string[] worldDirs, int wc,
                                               string[] pairNs, int[] pairIdx, int pairN) {
        LazyReconWorld w = new LazyReconWorld(new ZpkgInfo[0], new string[0], 0);
        w.World = new ZpkgInfo[wc];          // 全 null → 惰性 open
        w.WorldPaths = worldPaths; w.WorldDirs = worldDirs; w.Wc = wc;
        w.Wp = new ReconWorldPkg[wc];
        w._pairNs = pairNs; w._pairIdx = pairIdx; w._pairN = pairN;
        return w;
    }

    // 路由：解析**所有**声明 fq 命名空间的包（Decision 1/2：非 first-wins，与全量扫描等价）。
    // repl-per-symbol-reconcile（中层）：按命名空间填——`EnsureNs(pkg, ns)` **只读该 ns 模块**，不再整包
    // `EnsureIdx`。`Object`→只填 z42.core 的 `Std` 模块，不碰其余 3 模块。产出与整包填 byte-identical
    // （同数据、_locate/base 链按名字扫）→ 自举字节不动点门禁守住。
    public void EnsureFq(string fq) {
        string ns = LazyReconWorld._nsOf(fq);
        int j = 0;
        while (j < this._pairN) {
            if (this._pairNs[j] == ns) { this.EnsureNs(this._pairIdx[j], ns); }
            j = j + 1;
        }
    }

    // 填满全部（差分/eager 等价：EnsureAll 后 == 旧 BuildWorld 全量）。
    public void EnsureAll() {
        int i = 0; while (i < this.Wc) { this.EnsureIdx(i); i = i + 1; }
    }

    // eager 包装：已全量解析的 wp[]（旧 4-arg Rebuild / 种子 z42c 运行期兼容）。Wp 全填、无路由
    // （_pairN=0 → EnsureFq no-op；扫描无 null 条目，行为 == 旧 BuildWorld 全量 world）。
    public static LazyReconWorld FromEager(ReconWorldPkg[] wp, int wc) {
        LazyReconWorld w = new LazyReconWorld(new ZpkgInfo[0], new string[0], 0);
        w.Wp = wp; w.Wc = wc;
        return w;
    }

    // 向 world 追加一个包（REPL 增量 Repl.R{N}：使其类能被 `_locate` 自身定位 + 后续轮引用）。
    // 立即解析并登记其命名空间到路由表。返回新包索引。
    public int AppendPackage(ZpkgInfo z, string dir) {
        // Wp 是最紧的数组（构造时 = wc，而 World/WorldDirs 可能 = paths.Length 更大）——按 Wp 判扩容，
        // 三者同步扩到一致容量，避免 Wp[Wc] 越界（旧 bug：按 World.Length 判 → Wp 溢出）。
        if (this.Wc == this.Wp.Length) {
            int cap = this.Wp.Length * 2 + 1;
            ZpkgInfo[] w2 = new ZpkgInfo[cap]; string[] d2 = new string[cap]; ReconWorldPkg[] p2 = new ReconWorldPkg[cap];
            int k = 0; while (k < this.Wc) { w2[k] = this.World[k]; d2[k] = this.WorldDirs[k]; p2[k] = this.Wp[k]; k = k + 1; }
            this.World = w2; this.WorldDirs = d2; this.Wp = p2;
        }
        int idx = this.Wc;
        this.World[idx] = z; this.WorldDirs[idx] = dir; this.Wp[idx] = null;
        this.Wc = idx + 1;
        string[] nss = ZpkgReader.ReadNamespaces(z);
        int a = 0;
        while (a < nss.Length) { this._addPair(nss[a], idx); a = a + 1; }
        return idx;
    }

    private void _addPair(string ns, int idx) {
        if (this._pairN == this._pairNs.Length) {
            string[] b1 = new string[this._pairNs.Length * 2]; int[] b2 = new int[this._pairIdx.Length * 2];
            int k = 0; while (k < this._pairN) { b1[k] = this._pairNs[k]; b2[k] = this._pairIdx[k]; k = k + 1; }
            this._pairNs = b1; this._pairIdx = b2;
        }
        this._pairNs[this._pairN] = ns; this._pairIdx[this._pairN] = idx; this._pairN = this._pairN + 1;
    }

    // ns = fq 最后一个 '.'(46) 之前——嵌套 '+' / 泛型 '$' 不含 '.'，故切分隔离命名空间。
    private static string _nsOf(string fq) {
        int i = fq.Length - 1;
        while (i >= 0) { if ((int)fq.CharAt(i) == 46) { return fq.Substring(0, i); } i = i - 1; }
        return "";
    }
}

public static class TsigReconcile {

    // ── 重建 ────────────────────────────────────────────────────────────────
    // world 类型/签名表**一次性**解析（drop-tsig-expt P3：跨包 base 链复用——每次 Rebuild 重解析
    // 全 world 会 O(deps×world) 次包解析、海量分配拖垮 GC）。调用方（DepScan）建一次，跨全部
    // Rebuild 复用。worldDirs[wi] 供 indexed 散装 zbc 定位。
    public static ReconWorldPkg[] BuildWorld(ZpkgInfo[] world, string[] worldDirs, int wc) {
        ReconWorldPkg[] wp = new ReconWorldPkg[wc];
        int wi = 0;
        while (wi < wc) {
            wp[wi] = new ReconWorldPkg(ZpkgReader.ReadModuleTypes(world[wi], worldDirs[wi]), ZpkgReader.ReadModuleSigs(world[wi]));
            wi = wi + 1;
        }
        return wp;
    }

    // 兼容重载（4-arg + BuildWorld）：种子 z42c 运行期的旧 DepScan 仍调此路径——包装为 eager
    // LazyReconWorld（Wp 全填）。本 change 的新 DepScan 走下面 3-arg 的惰性 Rebuild；跨一版种子后
    // 此 4-arg + BuildWorld 可删（bootstrap-seed 轴④：改 z42c 运行期自依赖函数签名，保旧一版给种子）。
    public static ExportedModuleZ[] Rebuild(ZpkgInfo z, string zDir, ReconWorldPkg[] wp, int wc) {
        return TsigReconcile.Rebuild(z, zDir, LazyReconWorld.FromEager(wp, wc));
    }

    // 从 TYPE/SIGS/IMPL 重建 z 的 ExportedModuleZ[]（world = 惰性跨包类型世界，见 LazyReconWorld）。
    public static ExportedModuleZ[] Rebuild(ZpkgInfo z, string zDir, LazyReconWorld world) {
        ZpkgModuleTypes[] types = ZpkgReader.ReadModuleTypes(z, zDir);
        ZpkgModuleSigs[] sigs = ZpkgReader.ReadModuleSigs(z);
        int n = types.Length;
        if (sigs.Length < n) { n = sigs.Length; }
        // 全包 free functions（oracle：allFuncs 对每个模块重复同一列表——IrDump._compile 口径）。
        ExportedFuncZ[] allFuncs = new ExportedFuncZ[8]; int afc = 0;
        int fmi = 0;
        while (fmi < n) {
            ZpkgModuleSigs fms = sigs[fmi];
            int fi = 0;
            while (fi < fms.FuncCount) {
                IrFunction f = fms.Functions[fi];
                string rest = TsigReconcile._stripNs(f.Name, fms.Namespace);
                if (rest.IndexOf(".") < 0 && !TsigReconcile._hasNativeAttr(f) && rest.IndexOf("__lambda") < 0 && rest.IndexOf("__local_") < 0) {
                    ExportedParamZ[] ps = TsigReconcile._params(f, false);
                    ExportedFuncZ ef = new ExportedFuncZ(rest, f.RetType, f.MinArg, ps, ps.Length);
                    ef.ParamsFrom = TsigReconcile._pfInt(f.ParamsFrom);
                    if (afc == allFuncs.Length) { ExportedFuncZ[] b = new ExportedFuncZ[allFuncs.Length * 2]; int k = 0; while (k < afc) { b[k] = allFuncs[k]; k = k + 1; } allFuncs = b; }
                    allFuncs[afc] = ef; afc = afc + 1;
                }
                fi = fi + 1;
            }
            fmi = fmi + 1;
        }
        ExportedFuncZ[] pkgFuncs = new ExportedFuncZ[afc];
        int pfi = 0;
        while (pfi < afc) { pkgFuncs[pfi] = allFuncs[pfi]; pfi = pfi + 1; }
        ExportedModuleZ[] r = new ExportedModuleZ[n];
        int mi = 0;
        while (mi < n) {
            r[mi] = TsigReconcile._rebuildModule(types[mi], sigs[mi], world, pkgFuncs, afc);
            mi = mi + 1;
        }
        // drop-tsig-expt（P3）：IMPL 段（跨包 impl Trait for Type）仍写——读进 Impls
        // （取代 ReadTsig 的 _readImpl；DepScan 消费侧靠它做跨包 impl 传播）。
        ZpkgReader.ReadImplInto(z, r, n);
        return r;
    }

    // repl-per-symbol-reconcile（T2 Phase 1）：**只 reconcile 一个 fq 类型**（不整包 Rebuild）。
    // 读其命名空间模块的 TYPE（ReadOneModuleTypes，只读该 ns）→ 找到 IrClassDesc → 复用已按单类型的
    // `_rebuildClass`（基类链经 `world.EnsureFq` 按需）。产出 == 整包 Rebuild 里该类那条（同 `_rebuildClass`
    // 同 IrClassDesc 同 world → byte-identical）。供 T2 Phase 2 的 SymbolTable completer 按引用类型调用。
    // 未找到（该包不声明 fq / ns 无此类）→ null。
    public static ExportedClassZ ReconcileOne(ZpkgInfo z, string zDir, string fq, LazyReconWorld world) {
        string ns = TsigReconcile._nsOfFq(fq);
        ZpkgModuleTypes mt = ZpkgReader.ReadOneModuleTypes(z, zDir, ns);
        int t = 0;
        while (t < mt.ClassCount) {
            if (mt.Classes[t].Name == fq) { return TsigReconcile._rebuildClass(mt.Classes[t], ns, world); }
            t = t + 1;
        }
        return null;
    }

    // repl-per-symbol-reconcile（completer 批量）：从**已读的 IrClassDesc** 直接 reconcile 一个类型
    // （不重读模块）。供 DepScan.ReconcileCandidatesInNs：读一次 ns 模块、对多个匹配候选各 reconcile。
    public static ExportedClassZ ReconcileOneFromDesc(IrClassDesc cd, string ns, LazyReconWorld world) {
        return TsigReconcile._rebuildClass(cd, ns, world);
    }

    // fq 的命名空间（最后一个 '.' 之前；镜像 LazyReconWorld._nsOf）。嵌套 '+' / 泛型 '$' 不含 '.'。
    private static string _nsOfFq(string fq) {
        int i = fq.Length - 1;
        while (i >= 0) { if ((int)fq.CharAt(i) == 46) { return fq.Substring(0, i); } i = i - 1; }
        return "";
    }

    private static ExportedModuleZ _rebuildModule(ZpkgModuleTypes mt, ZpkgModuleSigs ms,
                                                  LazyReconWorld world,
                                                  ExportedFuncZ[] pkgFuncs, int pkgFuncCount) {
        string ns = mt.Namespace;
        // classes / interfaces / enums 拆分（bit6 delegate 跳过——oracle 消费面无）
        ExportedClassZ[] classes = new ExportedClassZ[8]; int cc = 0;
        // 接口重建（fix-crosspkg-interface-impl，zbc 1.28）：TYPE 接口条目携方法签名块 →
        // 恢复 ExportedInterfaceZ（名+方法）。此前跳过（em.Interfaces 恒空）致跨包
        // `class X : IFace@其他包` 被当基类、is/as/接口派发全失配。
        ExportedInterfaceZ[] ifaces = new ExportedInterfaceZ[4]; int ific = 0;
        // 本地 enum：从 TYPE 段的 enum 成员（add-enum-type-metadata，zbc 1.22）重建 ExportedEnumZ，
        // 使跨包 `using` 能 resolve 用户 enum 类型（add-repl-decls-multiline：REPL 声明累积；亦修
        // 一般跨包 enum 导入——此前恒被排除、只留内建 GCHandleType）。无格式 bump（数据已在 zbc）。
        ExportedEnumZ[] enums = new ExportedEnumZ[4]; int ec = 0;
        int i = 0;
        while (i < mt.ClassCount) {
            IrClassDesc cd = mt.Classes[i];
            if ((cd.Flags & 64) != 0) { i = i + 1; continue; }   // delegate：TSIG 消费面无
            if (cd.Name == "Std.Object" || cd.Name == "Object") { i = i + 1; continue; }   // TSIG 不导出隐式根 Object
            if ((cd.Flags & 32) != 0) {                          // enum：TYPE 成员块 → ExportedEnumZ
                ExportedEnumMemberZ[] mems = new ExportedEnumMemberZ[cd.EnumMemberCount];
                int em = 0;
                while (em < cd.EnumMemberCount) { mems[em] = new ExportedEnumMemberZ(cd.EnumMemberNames[em], cd.EnumMemberValues[em]); em = em + 1; }
                if (ec == enums.Length) { ExportedEnumZ[] b = new ExportedEnumZ[enums.Length * 2]; int k = 0; while (k < ec) { b[k] = enums[k]; k = k + 1; } enums = b; }
                enums[ec] = new ExportedEnumZ(TsigReconcile._bare(cd.Name, ns), mems, cd.EnumMemberCount);
                ec = ec + 1;
                i = i + 1;
                continue;
            }
            if ((cd.Flags & 16) != 0) {                          // 接口：TYPE 方法块 → ExportedInterfaceZ
                if (ific == ifaces.Length) { ExportedInterfaceZ[] b = new ExportedInterfaceZ[ifaces.Length * 2]; int k = 0; while (k < ific) { b[k] = ifaces[k]; k = k + 1; } ifaces = b; }
                ifaces[ific] = TsigReconcile._rebuildInterface(cd, ns);
                ific = ific + 1;
                i = i + 1;
                continue;
            }
            if (cc == classes.Length) { ExportedClassZ[] b = new ExportedClassZ[classes.Length * 2]; int k = 0; while (k < cc) { b[k] = classes[k]; k = k + 1; } classes = b; }
            classes[cc] = TsigReconcile._rebuildClass(cd, ns, world);
            cc = cc + 1;
            i = i + 1;
        }
        // enums：本地 enum（上面重建）→ 导出，使跨包 `using` resolve 用户 enum 类型。
        return new ExportedModuleZ(ns, classes, cc,
                                   ifaces, ific,
                                   enums, ec,
                                   pkgFuncs, pkgFuncCount,
                                   new ExportedDelegateZ[0], 0);
    }

    // 接口重建（fix-crosspkg-interface-impl）：TYPE 接口条目的方法签名块（zbc 1.28）→
    // ExportedInterfaceZ（bare 名 + ExportedMethodZ[]）。参数名合成 p0/p1…（TSIG 消费只按位）。
    private static ExportedInterfaceZ _rebuildInterface(IrClassDesc cd, string ns) {
        string bare = TsigReconcile._bare(cd.Name, ns);
        ExportedMethodZ[] methods = new ExportedMethodZ[cd.IfaceMethodCount];
        int ipbase = 0;
        int mi = 0;
        while (mi < cd.IfaceMethodCount) {
            int ipc = cd.IfaceMethodParamCounts[mi];
            ExportedParamZ[] ps = new ExportedParamZ[ipc];
            int pi = 0;
            while (pi < ipc) { ps[pi] = new ExportedParamZ("p" + pi.ToString(), cd.IfaceMethodParamTypes[ipbase + pi]); pi = pi + 1; }
            methods[mi] = new ExportedMethodZ(cd.IfaceMethodNames[mi], cd.IfaceMethodRets[mi], "public",
                                              false, true, true, ipc, ps, ipc);
            ipbase = ipbase + ipc;
            mi = mi + 1;
        }
        ExportedInterfaceZ eiz = new ExportedInterfaceZ(bare, methods, cd.IfaceMethodCount,
                                      cd.TypeParams, cd.TypeParamCount);
        eiz.Visibility = TsigReconcile._visStr(cd.Visibility);   // complete-class-access-control ④：接口可见性字节 → 字符串（跨包 internal 接口引用强制）
        return eiz;
    }

    private static ExportedClassZ _rebuildClass(IrClassDesc cd, string ns,
                                                LazyReconWorld world) {
        bool isStruct = (cd.Flags & 4) != 0;
        string bare = TsigReconcile._bare(cd.Name, ns);
        // base 链（惰性 world：遇祖先 FQ 先 EnsureFq 路由填充其包，再按 FQ 名在已填包中定位；
        // 记录 (pkg, mod) 供祖先 SIGS 精确定位）。lazy-type-world：跳过未填充（null）条目。
        IrClassDesc[] chain = new IrClassDesc[32];
        int[] chainPkg = new int[32]; int[] chainMod = new int[32];
        int chainLen = 0;
        IrClassDesc walk = cd;
        int walkPkg = 0 - 1; int walkMod = 0 - 1;
        TsigReconcile._locate(cd.Name, world, chainPkg, chainMod, 0);   // 定位自身（内含 EnsureFq）
        walkPkg = chainPkg[0]; walkMod = chainMod[0];
        int guard = 0;
        while (walk != null && guard < 32) {
            chain[chainLen] = walk; chainPkg[chainLen] = walkPkg; chainMod[chainLen] = walkMod;
            chainLen = chainLen + 1;
            string bn = walk.HasBase ? walk.BaseName : "";
            walk = null;
            if (bn != "" && bn != "Std.Object" && bn != "Object") {
                world.EnsureFq(bn);   // 路由填充声明 bn 命名空间的所有包
                int p2 = 0;
                while (p2 < world.Wc && walk == null) {
                    if (world.Wp[p2] != null) {
                        int m2 = 0;
                        while (m2 < world.Wp[p2].Types.Length && walk == null) {
                            int t2 = 0;
                            while (t2 < world.Wp[p2].Types[m2].ClassCount && walk == null) {
                                if (world.Wp[p2].Types[m2].Classes[t2].Name == bn) { walk = world.Wp[p2].Types[m2].Classes[t2]; walkPkg = p2; walkMod = m2; }
                                t2 = t2 + 1;
                            }
                            m2 = m2 + 1;
                        }
                    }
                    p2 = p2 + 1;
                }
            }
            guard = guard + 1;
        }
        // base 名（oracle：非 struct 恒 HasBase=true 短名默认 "Object"；struct HasBase=false base ""）
        string baseName = "Object";
        if (cd.HasBase && cd.BaseName != "") { baseName = TsigReconcile._shortName(cd.BaseName); }
        bool hasBase = !isStruct;
        if (isStruct) { baseName = ""; }
        // fields：链 topmost-first 实例字段，再本类 static
        ExportedFieldZ[] fields = new ExportedFieldZ[8]; int fldc = 0;
        int ci = chainLen - 1;
        while (ci >= 0) {
            IrClassDesc anc = chain[ci];
            int fi = 0;
            while (fi < anc.FieldCount) {
                if (fldc == fields.Length) { ExportedFieldZ[] b = new ExportedFieldZ[fields.Length * 2]; int k = 0; while (k < fldc) { b[k] = fields[k]; k = k + 1; } fields = b; }
                ExportedFieldZ efz = new ExportedFieldZ(anc.Fields[fi].Name, anc.Fields[fi].Type, TsigReconcile._visStr(anc.Fields[fi].Visibility), false);
                efz.IsDeprecated = anc.Fields[fi].Deprecated; efz.DeprecationMsg = anc.Fields[fi].DeprecationMsg;   // add-deprecated-directive
                fields[fldc] = efz;
                fldc = fldc + 1; fi = fi + 1;
            }
            ci = ci - 1;
        }
        int sfi = 0;
        while (sfi < cd.StaticFieldCount) {
            if (fldc == fields.Length) { ExportedFieldZ[] b = new ExportedFieldZ[fields.Length * 2]; int k = 0; while (k < fldc) { b[k] = fields[k]; k = k + 1; } fields = b; }
            ExportedFieldZ sefz = new ExportedFieldZ(cd.StaticFields[sfi].Name, cd.StaticFields[sfi].Type, TsigReconcile._visStr(cd.StaticFields[sfi].Visibility), true);
            sefz.IsDeprecated = cd.StaticFields[sfi].Deprecated; sefz.DeprecationMsg = cd.StaticFields[sfi].DeprecationMsg;   // add-deprecated-directive
            fields[fldc] = sefz;
            fldc = fldc + 1; sfi = sfi + 1;
        }
        // methods：Object 四方法（非 struct）+ 链 topmost-first SIGS 方法合并（override 保留祖先位）
        ExportedMethodZ[] methods = new ExportedMethodZ[16];
        string[] seenName = new string[16]; int[] seenAt = new int[16];
        int mc = 0; int seenc = 0;
        if (!isStruct) {
            ExportedMethodZ[] o4 = ObjectMethods.Four();   // compiler-review §4.3：单源
            methods[0] = o4[0]; methods[1] = o4[1]; methods[2] = o4[2]; methods[3] = o4[3];
            seenName[0] = "ToString"; seenName[1] = "Equals"; seenName[2] = "GetHashCode"; seenName[3] = "GetType";
            seenAt[0] = 0; seenAt[1] = 1; seenAt[2] = 2; seenAt[3] = 3;
            mc = 4; seenc = 4;
        }
        // pass 1：实例方法——链 topmost-first 合并（override 替换祖先位；oracle 语义：
        // override 条目 IsVirtual=false（TSIG virtual=仅显式 virtual 关键字），abstract 同）。
        ci = chainLen - 1;
        while (ci >= 0) {
            IrClassDesc anc = chain[ci];
            ZpkgModuleSigs ancSigs = null;
            if (chainPkg[ci] >= 0 && chainMod[ci] >= 0) { ancSigs = world.Wp[chainPkg[ci]].Sigs[chainMod[ci]]; }
            if (ancSigs != null) {
                string prefix = anc.Name + ".";
                int si = 0;
                while (si < ancSigs.FuncCount) {
                    IrFunction f = ancSigs.Functions[si];
                    if (!f.IsStatic && f.Name.StartsWith(prefix)) {
                        string mkey = f.Name.Substring(prefix.Length);
                        if (mkey.IndexOf(".") < 0 && mkey != "__static_init__" && mkey.IndexOf("__lambda") < 0 && mkey.IndexOf("__local_") < 0) {
                            ExportedMethodZ em = TsigReconcile._methodFromSig(f, mkey);
                            if (em.IsAbstract) { em.IsVirtual = false; }   // TSIG：abstract 不置 virtual
                            int at = TsigReconcile._indexOf(seenName, seenc, mkey);
                            if (at >= 0) {
                                em.IsVirtual = false;   // override（替换祖先位）：TSIG virtual=false
                                methods[seenAt[at]] = em;
                            }
                            else {
                                if (mc == methods.Length) { ExportedMethodZ[] b = new ExportedMethodZ[methods.Length * 2]; int k = 0; while (k < mc) { b[k] = methods[k]; k = k + 1; } methods = b; }
                                if (seenc == seenName.Length) { string[] sn = new string[seenName.Length * 2]; int[] sa = new int[seenAt.Length * 2]; int k = 0; while (k < seenc) { sn[k] = seenName[k]; sa[k] = seenAt[k]; k = k + 1; } seenName = sn; seenAt = sa; }
                                methods[mc] = em; seenName[seenc] = mkey; seenAt[seenc] = mc;
                                seenc = seenc + 1; mc = mc + 1;
                            }
                        }
                    }
                    si = si + 1;
                }
            }
            ci = ci - 1;
        }
        // pass 2：本类 static 方法（oracle：own-class only、声明序 append、不与实例 seen 合并）。
        ZpkgModuleSigs selfSigs = null;
        if (chainPkg[0] >= 0 && chainMod[0] >= 0) { selfSigs = world.Wp[chainPkg[0]].Sigs[chainMod[0]]; }
        if (selfSigs != null) {
            string sprefix = cd.Name + ".";
            int ssi = 0;
            while (ssi < selfSigs.FuncCount) {
                IrFunction f = selfSigs.Functions[ssi];
                if (f.IsStatic && f.Name.StartsWith(sprefix)) {
                    string mkey = f.Name.Substring(sprefix.Length);
                    if (mkey.IndexOf(".") < 0 && mkey != "__static_init__" && mkey.IndexOf("__lambda") < 0 && mkey.IndexOf("__local_") < 0) {
                        ExportedMethodZ em = TsigReconcile._methodFromSig(f, mkey);
                        em.IsVirtual = false;   // TSIG：static 恒 vfalse（`static override` 不置 virtual）
                        if (mc == methods.Length) { ExportedMethodZ[] b = new ExportedMethodZ[methods.Length * 2]; int k = 0; while (k < mc) { b[k] = methods[k]; k = k + 1; } methods = b; }
                        methods[mc] = em; mc = mc + 1;
                    }
                }
                ssi = ssi + 1;
            }
        }
        ExportedClassZ ecz = new ExportedClassZ(bare, hasBase, baseName,
                                  TsigReconcile._trimF(fields, fldc), fldc,
                                  TsigReconcile._trimM(methods, mc), mc,
                                  cd.TypeParams == null ? new string[0] : cd.TypeParams, cd.TypeParamCount);
        // 实现的接口表（fix-crosspkg-interface-impl 补齐）：TYPE 接口块存 FQ 名 → bare 化
        // （镜像 local Z42ClassType.InterfaceNames 的裸名约定；SymbolTable.Implements 按裸名匹配）。
        // 缺此则 imported 类 → 接口的可赋性（`ICompiler c = new NoCompiler()`）恒 E0402。
        if (cd.InterfaceCount > 0) {
            string[] ifb = new string[cd.InterfaceCount];
            int ifi = 0;
            while (ifi < cd.InterfaceCount) { ifb[ifi] = TsigReconcile._shortName(cd.Interfaces[ifi]); ifi = ifi + 1; }
            ecz.Interfaces = ifb; ecz.InterfaceCount = cd.InterfaceCount;
        }
        ecz.IsSealed = (cd.Flags & 2) != 0;   // impl-sealed-semantics-devirt：CLASS_FLAG_SEALED（TYPE Flags bit1）
        ecz.IsDeprecated = (cd.Flags & 64) != 0; ecz.DeprecationMsg = cd.DeprecationMsg;   // add-deprecated-directive：CLASS_FLAG_DEPRECATED（bit6）
        ecz.Visibility = TsigReconcile._visStr(cd.Visibility);   // enforce-class-access：类可见性字节 → 字符串（跨包 internal 类引用强制）
        return ecz;
    }

    private static ExportedMethodZ _methodFromSig(IrFunction f, string mkey) {
        bool isInstance = !f.IsStatic;
        ExportedParamZ[] ps = TsigReconcile._params(f, isInstance);
        ExportedMethodZ em = new ExportedMethodZ(mkey, f.RetType, TsigReconcile._visStr(f.Visibility),
                                  f.IsStatic, (f.MethodFlags & 1) != 0, (f.MethodFlags & 2) != 0,
                                  f.MinArg, ps, ps.Length);
        em.ParamsFrom = TsigReconcile._pfInt(f.ParamsFrom);
        em.IsSealed = (f.MethodFlags & 4) != 0;   // impl-sealed-semantics-devirt：METHOD_FLAG_SEALED
        em.IsDeprecated = (f.MethodFlags & 8) != 0; em.DeprecationMsg = f.DeprecationMsg;   // add-deprecated-directive：METHOD_FLAG_DEPRECATED（bit3）
        return em;
    }

    // SIGS 参数 → ExportedParamZ[]（跳 this 槽；名 = "p{i}"，镜像 TSIG C# 实测口径）。
    private static ExportedParamZ[] _params(IrFunction f, bool skipThis) {
        int off = 0; if (skipThis) { off = 1; }
        int n = f.ParamCount - off;
        if (n < 0) { n = 0; }
        ExportedParamZ[] ps = new ExportedParamZ[n];
        int i = 0;
        while (i < n) {
            string pt = "?";
            if (i + off < f.ParamTypeCount) { pt = f.ParamTypes[i + off]; }
            ps[i] = new ExportedParamZ("p" + i.ToString(), pt);
            i = i + 1;
        }
        return ps;
    }

    // ── 助手 ────────────────────────────────────────────────────────────────
    // ns 前缀剥离（不动 $N；用于 free-func "." 检测——method 名 <Class$N>.<m> 须保 "." 判别）。
    private static string _stripNs(string fq, string ns) {
        if (fq.StartsWith(ns + ".")) { return fq.Substring(ns.Length + 1); }
        return fq;
    }
    // 类显示名：剥 ns + 尾部 arity-mangle（Name$N，oracle 用裸 c.Name）。仅当 $ 后全是数字到末尾。
    private static string _bare(string fq, string ns) {
        string r = TsigReconcile._stripNs(fq, ns);
        int d = r.IndexOf("$");
        if (d > 0) {
            bool allDigit = d + 1 < r.Length;
            int k = d + 1;
            while (k < r.Length) { int ch = (int)r.CharAt(k); if (ch < 48 || ch > 57) { allDigit = false; } k = k + 1; }
            if (allDigit) { r = r.Substring(0, d); }
        }
        return r;
    }
    private static string _shortName(string fq) {
        int i = fq.Length - 1;
        while (i >= 0) { if ((int)fq.CharAt(i) == 46) { return fq.Substring(i + 1); } i = i - 1; }
        return fq;
    }
    private static string _visStr(int v) {
        if (v == 1) { return "private"; }
        if (v == 2) { return "protected"; }
        if (v == 3) { return "internal"; }   // enforce-access-control：跨包 internal 强制
        return "public";
    }
    private static int _pfInt(int b) { if (b == 255 || b < 0) { return 0 - 1; } return b; }
    private static bool _hasNativeAttr(IrFunction f) {
        int i = 0;
        while (i < f.AttrCount) { if (f.Attrs[i].TypeName.EndsWith("Native") || f.Attrs[i].TypeName.EndsWith("NativeAttribute")) { return true; } i = i + 1; }
        return false;
    }
    // 在惰性 world 中定位 FQ 类型所属的 (pkg, mod)（未找到 = -1）。先 EnsureFq 路由填充该 FQ
    // 命名空间的包，再扫描已填充条目（跳过 null 的未解析包——它们与 fq 无关，否则已被 EnsureFq 填）。
    private static void _locate(string fq, LazyReconWorld world, int[] outPkg, int[] outMod, int slot) {
        outPkg[slot] = 0 - 1; outMod[slot] = 0 - 1;
        world.EnsureFq(fq);
        int p = 0;
        while (p < world.Wc) {
            if (world.Wp[p] != null) {
                int m = 0;
                while (m < world.Wp[p].Types.Length) {
                    int t = 0;
                    while (t < world.Wp[p].Types[m].ClassCount) {
                        if (world.Wp[p].Types[m].Classes[t].Name == fq) { outPkg[slot] = p; outMod[slot] = m; return; }
                        t = t + 1;
                    }
                    m = m + 1;
                }
            }
            p = p + 1;
        }
    }
    private static int _indexOf(string[] arr, int n, string key) {
        int i = 0;
        while (i < n) { if (arr[i] == key) { return i; } i = i + 1; }
        return 0 - 1;
    }
    private static ExportedFieldZ[] _trimF(ExportedFieldZ[] a, int n) {
        ExportedFieldZ[] r = new ExportedFieldZ[n];
        int i = 0; while (i < n) { r[i] = a[i]; i = i + 1; }
        return r;
    }
    private static ExportedMethodZ[] _trimM(ExportedMethodZ[] a, int n) {
        ExportedMethodZ[] r = new ExportedMethodZ[n];
        int i = 0; while (i < n) { r[i] = a[i]; i = i + 1; }
        return r;
    }
}
