// 反射式测试 runner：并入一个编好的测试 / bench 产物，经 TestDiscovery（运行期反射）找出
// `[Test]` / `[Benchmark]` / `[Setup]` / `[Teardown]`，逐条执行并归类 pass / fail / skip
// （`[Skip]` 平台 / 能力门、`[Ignore]`、`[ShouldThrow<E>]` 按类型可赋值判定）。
//
// 测试函数是零参、无接收者的自由函数或静态方法，经 `MethodInfo.Invoke` 调用。
//
// 每条 [Test] 的生命周期：同命名空间（或同类型）的 [Setup] → 测试 → [Teardown]（总会执行）。
// 退出码：0 = 全过；1 = 有失败，或一条可跑的测试都没发现。
//
// 输出格式：`format` 为 "pretty"（缺省，PASS/FAIL/SKIP 行 + Result 汇总）或 "json"（单个结构化
// `TestReport`，benchmark 条目带从其输出解析出的 `bench_stats`）。
namespace Std.Test;

using Std.IO;

// Internal invoke outcome (z42 has no out-params). Carries thrown state + the
// benchmark's captured stdout (json mode only; "" otherwise / on throw).
public class InvokeOutcome {
    public bool Threw;
    public Type? Thrown;      // 抛出的异常的运行期类型（[ShouldThrow<E>] 判定用）
    public string ErrType;
    public string ErrMsg;
    public string Captured;
    public InvokeOutcome() {
        this.Threw = false; this.Thrown = null; this.ErrType = ""; this.ErrMsg = ""; this.Captured = "";
    }
}

public static class Runner {
    // Load + run every [Test] / [Benchmark] in the compiled module at `path`,
    // rendering output in `format` ("pretty" | "json"). Returns a process exit
    // code (0 = no failures, 1 = at least one failure).
    public static int RunModule(string path, string format) {
        bool json = (format == "json");
        TestCase[] entries = TestDiscovery.Discover(path);

        int runnable = 0;
        int c = 0;
        while (c < entries.Length) {
            if (entries[c].IsTest() || entries[c].IsBenchmark()) { runnable = runnable + 1; }
            c = c + 1;
        }
        TestResult[] results = new TestResult[runnable];

        int passed = 0; int failed = 0; int skipped = 0;
        int ri = 0;
        int i = 0;
        while (i < entries.Length) {
            TestCase e = entries[i];
            // [Test] and [Benchmark] are dispatched identically (zero-arg
            // invocation); the benchmark body constructs its own Bencher and
            // self-reports — mirrors the retired Rust runner, which ran both.
            if (e.IsTest() || e.IsBenchmark()) {
                TestResult tr = Runner._runOne(e, entries, json);
                results[ri] = tr;
                ri = ri + 1;
                if (tr.Status == "passed")      { passed = passed + 1; }
                else if (tr.Status == "failed") { failed = failed + 1; }
                else                            { skipped = skipped + 1; }
            }
            i = i + 1;
        }

        if (json) {
            Console.WriteLine(TestReport.toJson(path, results));
        } else {
            Console.WriteLine("");
            Console.WriteLine("  Result: " + passed.ToString() + " passed, "
                + failed.ToString() + " failed, " + skipped.ToString() + " skipped");
        }
        // error-on-zero-discovered-tests：被要求跑一个**一条 [Test]/[Benchmark] 都没发现**的产物，
        // 此前打印 `0 passed, 0 failed, 0 skipped` 后 **exit 0** —— 「我的测试没跑」与「我的测试全过」
        // 在退出码上不可区分。能触发它的都是真事故：attribute 拼错（[Tests]/[test]）、[sources] glob
        // 漏掉文件、测试函数被改名/误删、或调用方把一个根本没有测试的目录当成了测试单元。
        // 报告照常打印（json 消费方不受影响），错误另走 stderr，退出码非零。
        if (runnable == 0) {
            ConsoleError.WriteLine("error: no [Test] or [Benchmark] found in `" + path + "`");
            ConsoleError.WriteLine("  a test artifact with zero discovered tests is treated as a failure —");
            ConsoleError.WriteLine("  check the attribute spelling, the package's [sources] globs, and that");
            ConsoleError.WriteLine("  the test functions still exist in the compiled artifact.");
        }
        return Runner.ExitCodeFor(runnable, failed);
    }

    // 退出码决策（抽成纯函数以便直接单测；RunModule 里那段是 I/O，决策在这里）。
    //   runnable == 0 → 1：**「测试没跑」不得与「测试全过」在退出码上等价**。
    //     能触发它的都是真事故：attribute 拼错（[Tests]/[test]）、[sources] glob 漏掉文件、
    //     测试函数被改名/误删、或调用方把一个根本没有测试的目录当成了测试单元。
    //   failed > 0  → 1：有失败。
    //   否则        → 0。
    public static int ExitCodeFor(int runnable, int failed) {
        if (runnable == 0) { return 1; }
        if (failed > 0) { return 1; }
        return 0;
    }

    // Run every [Test]/[Benchmark] in the module at `path`, RETURNING the results
    // without printing. For aggregating across a bundle of modules (embedded
    // test-host, wire-embedded-testhost): the caller collects results from many
    // modules and renders one combined TestReport.
    public static TestResult[] RunModuleResults(string path) {
        TestCase[] entries = TestDiscovery.Discover(path);
        int runnable = 0;
        int c = 0;
        while (c < entries.Length) {
            if (entries[c].IsTest() || entries[c].IsBenchmark()) { runnable = runnable + 1; }
            c = c + 1;
        }
        TestResult[] results = new TestResult[runnable];
        int ri = 0;
        int i = 0;
        while (i < entries.Length) {
            TestCase e = entries[i];
            if (e.IsTest() || e.IsBenchmark()) {
                results[ri] = Runner._runOne(e, entries, true);   // json=true → no pretty print
                ri = ri + 1;
            }
            i = i + 1;
        }
        return results;
    }

    // Run one [Test]/[Benchmark]. Returns its TestResult; prints pretty lines only
    // when `!json` (pretty output stays byte-identical to pre-structured-output).
    static TestResult _runOne(TestCase e, TestCase[] all, bool json) {
        bool isBench = e.IsBenchmark();
        if (e.IsIgnored()) {
            if (!json) { Console.WriteLine("  SKIP " + e.Qualified + " (ignored)"); }
            return new TestResult(e.Qualified, "skipped", isBench, "ignored", null);
        }
        if (e.IsSkipped() && Runner._skipApplies(e)) {
            string why = (e.SkipReason != null) ? (" (" + e.SkipReason + ")") : "";
            if (!json) { Console.WriteLine("  SKIP " + e.Qualified + why); }
            string sreason = (e.SkipReason != null) ? e.SkipReason : "skipped";
            return new TestResult(e.Qualified, "skipped", isBench, sreason, null);
        }

        string ns = e.DeclaringType();
        Runner._runLifecycle(all, ns, 3);   // [Setup]
        InvokeOutcome o = Runner._invoke(e, json);
        Runner._runLifecycle(all, ns, 4);   // [Teardown] (always)

        if (e.HasShouldThrow()) {
            if (o.Threw && Runner._typeMatches(o.Thrown, e.Expected)) {
                if (!json) { Console.WriteLine("  PASS " + e.Qualified); }
                return Runner._pass(e, isBench, o.Captured, json);
            }
            string got = o.Threw ? o.ErrType : "no throw";
            Type? exp = e.Expected;
            string want = "?";
            if (exp is Type et) { want = et.FullName; }
            string freason = "expected throw " + want + ", got " + got;
            if (!json) { Console.WriteLine("  FAIL " + e.Qualified + " (" + freason + ")"); }
            return new TestResult(e.Qualified, "failed", isBench, freason, null);
        }
        if (o.Threw) {
            string treason = o.ErrType + ": " + o.ErrMsg;
            if (!json) { Console.WriteLine("  FAIL " + e.Qualified + ": " + treason); }
            return new TestResult(e.Qualified, "failed", isBench, treason, null);
        }
        if (!json) { Console.WriteLine("  PASS " + e.Qualified); }
        return Runner._pass(e, isBench, o.Captured, json);
    }

    // Invoke the entry. In json mode, capture its stdout (so the benchmark's
    // `bench[...]` line can be parsed and is not echoed into the JSON stream).
    static InvokeOutcome _invoke(TestCase e, bool json) {
        InvokeOutcome o = new InvokeOutcome();
        if (json) {
            try {
                o.Captured = TestIO.captureStdout(() => { e.Invoke(); });
            } catch (Exception ex) {
                Type tt = ex.GetType(); o.Threw = true; o.ErrMsg = ex.Message; o.Thrown = tt; o.ErrType = tt.FullName;
            }
        } else {
            try {
                e.Invoke();
            } catch (Exception ex) {
                Type tt = ex.GetType(); o.Threw = true; o.ErrMsg = ex.Message; o.Thrown = tt; o.ErrType = tt.FullName;
            }
        }
        return o;
    }

    // Build a passed TestResult; for a benchmark in json mode, parse its captured
    // summary line into bench_stats (null if the line is absent/malformed).
    static TestResult _pass(TestCase e, bool isBench, string captured, bool json) {
        BenchStats stats = null;
        if (json && isBench) { stats = BenchStats.parse(captured); }
        return new TestResult(e.Qualified, "passed", isBench, null, stats);
    }

    // Run all [Setup] (kind 3) or [Teardown] (kind 4) functions declared in the
    // same namespace `ns` as the test. (z42 free-function fixtures have no shared
    // instance; same-namespace grouping preserves locality.)
    static void _runLifecycle(TestCase[] all, string ns, int kind) {
        int i = 0;
        while (i < all.Length) {
            TestCase e = all[i];
            if (e.Kind == kind && e.DeclaringType() == ns) {
                try { e.Invoke(); } catch (Exception ex) { }
            }
            i = i + 1;
        }
    }

    // Does this [Skip] apply on the current host? Unconditional skip → yes.
    // Platform skip → yes iff host OS matches. Feature skip → yes iff the running
    // VM lacks that capability (fix-wasm-corpus-capability-gate): `[Skip(feature:
    // X)]` reads as "this test requires capability X; skip where it's absent" —
    // so it runs where X is present (e.g. threads/socket on native) and skips
    // where it isn't (wasm). Deny-by-default preserved: an unknown feature is not
    // in Capabilities() → absent → skip.
    static bool _skipApplies(TestCase e) {
        if (e.SkipPlatform != null) { return Platform.OS() == e.SkipPlatform; }
        if (e.SkipFeature != null) { return !Runner._capsHas(e.SkipFeature); }
        return true;
    }

    // Does the running VM report capability `feature` (Std.Platform.Capabilities())?
    static bool _capsHas(string feature) {
        string[] caps = Platform.Capabilities();
        int i = 0;
        while (i < caps.Length) {
            if (caps[i] == feature) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Match the thrown type against the [ShouldThrow<E>] expectation: E itself or any subtype.
    // A missing expectation (`[ShouldThrow]` without a type argument, E0913) or a missing thrown
    // type → no match (reported as a fail).
    static bool _typeMatches(Type? thrown, Type? expected) {
        // `Type` 重载了 `==` / `!=`（按 FullName 比较），判空用类型模式。
        if (expected is Type exp) {
            if (thrown is Type thr) { return exp.IsAssignableFrom(thr); }
        }
        return false;
    }
}
