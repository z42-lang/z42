namespace Std.Harness;

using Std.Reflection;   // Assembly / MethodInfo
using Std.Collections;  // List<object[]> —— data provider 的行容器

/// 一条被发现的测试 / bench / 生命周期函数。
public class TestCase {
    /// 报告用的名字：`<命名空间或类型>.<函数名>`。
    public string Qualified;
    /// 1=Test, 2=Benchmark, 3=Setup, 4=Teardown.
    public int Kind;
    /// 被标注的函数本体，[`Invoke`] 的反射调用目标。
    public MethodInfo Method;
    /// 贴了 `[Skip]` 为 true（三个门控实参见下面的 `Skip*` 字段）。
    public bool Skipped;
    /// 贴了 `[Ignore]` 为 true（无条件跳过，不报理由）。
    public bool Ignored;
    /// `[Skip]` 的三个实参；没给的为 null。
    public string? SkipReason;
    /// `[Skip]` 的 platform 实参；没给为 null。
    public string? SkipPlatform;
    /// `[Skip]` 的 feature 实参；没给为 null。
    public string? SkipFeature;
    /// `[ShouldThrow<E>]`：贴了即 true；`Expected` 为 E（漏写类型实参时为 null）。
    public bool ShouldThrow;
    /// 期望抛出的异常类型（`[ShouldThrow<E>]` 的 E）；漏写类型实参为 null。
    public Type? Expected;

    /// 测试/基准声明的专属 setup（`[Test(setup: methodof(…))]`）；null = 无。
    ///
    /// 执行序：非定向 [Setup]（公共）之后。
    public MethodInfo? DeclaredSetup;
    /// 同上，teardown：非定向 [Teardown]（公共）之前（专属先、公共后）。
    public MethodInfo? DeclaredTeardown;
    /// `[Test(data: methodof(Fix.rows))]` 的运行期数据行 provider；null = 无。
    ///
    /// 发现期调用（零参 → `List<object[]>`，每元素一行实参），按行展开成多条用例——
    /// 与 `[Case]` 同一条展开路（编译期互斥）。
    public MethodInfo? DataProvider;
    /// `[Case(…)]` 的实参（参数化测试展开后本条对应的那行）；null = 非参数化。
    public object[] Args;
    /// 发现期暂存：本方法的全部 `[Case]` 行（null = 无）——Discover 收齐后展开成多条用例。
    public object[] CaseRows;   // 元素是 object[]（一行 Case）

    /// 装配一条用例：名字 / kind / 函数取实参，skip 与期望异常等一律先置默认，
    /// 由发现层（`_fromMethod`）读 attribute 后补写。
    public TestCase(string qualified, int kind, MethodInfo method) {
        this.Qualified = qualified; this.Kind = kind; this.Method = method;
        this.Skipped = false; this.Ignored = false;
        this.SkipReason = null; this.SkipPlatform = null; this.SkipFeature = null;
        this.ShouldThrow = false; this.Expected = null;
        this.DeclaredSetup = null; this.DeclaredTeardown = null;
        this.DataProvider = null;
        this.Args = null; this.CaseRows = null;
    }

    /// 是否 `[Test]`（Kind == 1）。
    public bool IsTest()      { return this.Kind == 1; }
    /// 是否 `[Benchmark]`（Kind == 2）。
    public bool IsBenchmark() { return this.Kind == 2; }
    /// 是否 `[Setup]`（Kind == 3）。
    public bool IsSetup()     { return this.Kind == 3; }
    /// 是否 `[Teardown]`（Kind == 4）。
    public bool IsTeardown()  { return this.Kind == 4; }
    /// 是否贴了 `[Skip]`。
    public bool IsSkipped()   { return this.Skipped; }
    /// 是否贴了 `[Ignore]`。
    public bool IsIgnored()   { return this.Ignored; }
    /// 是否贴了 `[ShouldThrow<E>]`。
    public bool HasShouldThrow() { return this.ShouldThrow; }

    /// 所属命名空间（自由函数）或类型（静态方法）的全限定名——`[Setup]` / `[Teardown]` 按它成组。
    public string DeclaringType() {
        int i = this.Qualified.LastIndexOf('.');
        if (i < 0) { return ""; }
        return this.Qualified.Substring(0, i);
    }

    /// 调用（无接收者）。被调函数里抛出的异常按原类型传出。
    ///
    /// 零参形态直接调（`[Test]` / `[Setup]` / `[Teardown]` 及要自定采样档/标签的
    /// `[Benchmark]`）；**推荐**的 `[Benchmark] void f(Bencher b)` 形态由这里建固定档
    /// (2, 20) 的 [`Bencher`] 传入，跑完按函数名自动打摘要行——基准体只写 `b.iter(() => …)`，
    /// 预热/采样/摘要全是 runner 的事。
    public void Invoke() {
        if (this.Args != null) {
            this.Method.Invoke(null, TestCase._coerceArgs(this.Method, this.Args));
            return;
        }
        if (this.TakesBencher()) {
            Bencher b = new Bencher(2, 20);   // 事实标准固定档：确定性采样数，正确性波/CI A/B 的现状口径
            object[] args = new object[1];
            args[0] = b;
            this.Method.Invoke(null, args);
            b.printSummary(this.Method.Name);
            return;
        }
        this.Method.Invoke(null, new object[0]);
    }

    /// 恰好一个 `Std.Harness.Bencher` 形参（编译期 E0912 已保证 `[Benchmark]` 只有零参与这一种形状）。
    public bool TakesBencher() {
        ParameterInfo[] ps = this.Method.GetParameters();
        if (ps.Length != 1) { return false; }
        Type pt = ps[0].ParameterType;
        if (pt is Type t) { return t.FullName == "Std.Harness.Bencher"; }
        return false;
    }

    /// 展开出一行参数化用例：浅拷贝、带 Args、名字加实参后缀。
    ///
    /// Skip/ShouldThrow/声明 fixture 照抄——方法级，对每行同样生效。
    public TestCase CloneForCase(object[] row) {
        TestCase c = new TestCase(this.Qualified + "(" + TestCase._fmtArgs(row) + ")", this.Kind, this.Method);
        c.Skipped = this.Skipped; c.Ignored = this.Ignored;
        c.SkipReason = this.SkipReason; c.SkipPlatform = this.SkipPlatform; c.SkipFeature = this.SkipFeature;
        c.ShouldThrow = this.ShouldThrow; c.Expected = this.Expected;
        c.DeclaredSetup = this.DeclaredSetup; c.DeclaredTeardown = this.DeclaredTeardown;
        c.Args = row;
        return c;
    }

    /// 交错数组增长一档（`new object[n][]` 语法不可用：逐行分配再拷）。
    public static object[] _growRows(object[] old) {
        int n = old == null ? 0 : old.Length;
        object[] r = new object[n + 1];
        int i = 0;
        while (i < n) { r[i] = old[i]; i = i + 1; }
        return r;
    }

    // 实参列表的可读形（报告/名字用）：null → null；string 加引号；其余 ToString。
    static string _fmtArgs(object[] row) {
        string acc = "";
        int i = 0;
        while (i < row.Length) {
            if (i > 0) { acc = acc + ", "; }
            object v = row[i];
            if (v == null) { acc = acc + "null"; }
            else if (v is string sv) { acc = acc + "\"" + sv + "\""; }
            else { acc = acc + v.ToString(); }
            i = i + 1;
        }
        return acc;
    }

    // 在反射调用前按形参类型勘合 Case 整数字面量。
    static object[] _coerceArgs(MethodInfo m, object[] args) {
        ParameterInfo[] ps = m.GetParameters();
        // 行套数 = 形参数。[Case] 行编译期已查（E0911/E0920 口径）；data 行运行期才见值，这里兜底。
        if (args.Length != ps.Length) {
            throw new Exception("参数化数据行实参数（" + args.Length.ToString() + "）须等于测试形参数（"
                + ps.Length.ToString() + "）——逐位对应（方法 " + m.Name + "）");
        }
        object[] r = new object[args.Length];
        int i = 0;
        while (i < args.Length) {
            r[i] = TestCase._coerceOne(args[i], ps[i].ParameterType);
            i = i + 1;
        }
        return r;
    }

    // Case 整数字面量按 Int32 判断，只扩宽到 Int64 或 Double 形参。
    static object _coerceOne(object v, Type pt) {
        if (v == null) { return null; }
        string want = pt.FullName;
        if (want == "Std.Int64" && v is int) { return (long)v; }
        if (want == "Std.Double" && v is int) { return (double)v; }
        return v;
    }
}

/// 运行期反射发现测试：并入编好的产物，把贴了测试 attribute 的函数读成 [`TestCase`]。
///
/// 把编好的测试 / bench 产物并入当前 VM，经反射找出贴了 `[Test]` / `[Benchmark]` /
/// `[Setup]` / `[Teardown]` 的函数，连同 `[Skip]` / `[Ignore]` / `[ShouldThrow<E>]`
/// 一起读成 [`TestCase`]。
///
/// 发现面 = 产物的自由函数（`Assembly.GetFunctions()`）+ 各类型的静态方法（`Type.GetMethods()`）；
/// 只读 attribute 活实例，不依赖编译器写进产物的测试专用元数据，也不依赖测试专用的 VM 能力。
/// 结果按全限定名排序：同输入同输出，便于比对报告。
public static class TestDiscovery {
    /// 并入 `path`（.zpkg / .zbc）并发现其中的测试。加载失败抛异常。
    public static TestCase[] Discover(string path) {
        ModuleLoader.Load(path);                                       // 可执行
        Assembly asm = AssemblyLoadContext.Default().Load(path);       // 反射视图（枚举）
        TestCase[] found = new TestCase[8];
        int n = 0;
        MethodInfo[] fs = asm.GetFunctions();
        int i = 0;
        while (i < fs.Length) {
            TestCase tc = TestDiscovery._fromMethod(fs[i]);
            if (tc != null) {
                object[] rows = TestDiscovery._rowsOf(tc);
                if (rows == null) {
                    found = TestDiscovery._push(found, n, tc); n = n + 1;
                } else {
                    int r = 0;
                    while (r < rows.Length) {
                        TestCase one = tc.CloneForCase(rows[r] as object[]);
                        found = TestDiscovery._push(found, n, one); n = n + 1;
                        r = r + 1;
                    }
                }
            }
            i = i + 1;
        }
        Type[] types = asm.GetTypes();
        int t = 0;
        while (t < types.Length) {
            Type live = Type.GetType(types[t].FullName);   // 解析到并入后的活类型（可 Invoke）
            if (live != null) {
                MethodInfo[] ms = live.GetMethods();
                int k = 0;
                while (k < ms.Length) {
                    if (ms[k].IsStatic) {
                        TestCase mc = TestDiscovery._fromMethod(ms[k]);
                        if (mc != null) {
                            object[] rows = TestDiscovery._rowsOf(mc);
                            if (rows == null) {
                                found = TestDiscovery._push(found, n, mc); n = n + 1;
                            } else {
                                int r = 0;
                                while (r < rows.Length) {
                                    TestCase one = mc.CloneForCase(rows[r] as object[]);
                                    found = TestDiscovery._push(found, n, one); n = n + 1;
                                    r = r + 1;
                                }
                            }
                        }
                    }
                    k = k + 1;
                }
            }
            t = t + 1;
        }
        TestCase[] outp = new TestCase[n];
        int c = 0;
        while (c < n) { outp[c] = found[c]; c = c + 1; }
        TestDiscovery._sortByName(outp);
        return outp;
    }

    // 读一个函数的 attribute；没有测试 kind attribute 的返回 null。
    static TestCase _fromMethod(MethodInfo m) {
        Attribute[] attrs = m.GetCustomAttributes();
        int kind = 0;
        int a = 0;
        while (a < attrs.Length) {
            Attribute at = attrs[a];
            if (at is TestAttribute) { kind = 1; }
            else if (at is BenchmarkAttribute) { kind = 2; }
            else if (at is SetupAttribute) { kind = 3; }
            else if (at is TeardownAttribute) { kind = 4; }
            a = a + 1;
        }
        if (kind == 0) { return null; }
        TestCase tc = new TestCase(TestDiscovery._displayName(m), kind, m);
        a = 0;
        while (a < attrs.Length) {
            Attribute at = attrs[a];
            if (at is SkipAttribute) {
                SkipAttribute s = at as SkipAttribute;
                tc.Skipped = true;
                tc.SkipReason = TestDiscovery._orNull(s.Reason);
                tc.SkipPlatform = TestDiscovery._orNull(s.Platform);
                tc.SkipFeature = TestDiscovery._orNull(s.Feature);
            } else if (at is IgnoreAttribute) {
                tc.Ignored = true;
            } else if (at is TestAttribute) {
                TestAttribute ta = at as TestAttribute;
                tc.DeclaredSetup = ta.Setup;
                tc.DeclaredTeardown = ta.Teardown;
                tc.DataProvider = ta.Data;
            } else if (at is CaseAttribute) {
                CaseAttribute ca = at as CaseAttribute;
                object[] grown = TestCase._growRows(tc.CaseRows);
                grown[grown.Length - 1] = ca.Args;
                tc.CaseRows = grown;
            } else if (at is BenchmarkAttribute) {
                BenchmarkAttribute ba = at as BenchmarkAttribute;
                tc.DeclaredSetup = ba.Setup;
                tc.DeclaredTeardown = ba.Teardown;
            } else if (at is IExpectsException) {
                tc.ShouldThrow = true;
                tc.Expected = (at as IExpectsException).ExceptionType();
            }
            a = a + 1;
        }
        return tc;
    }

    // `<所属>.<源码名>`：`__qualified` 的所属部分（剥掉签名改名后缀前的最后一段）+ 源码名。
    static string _displayName(MethodInfo m) {
        string q = m.__qualified;
        int i = q.LastIndexOf('.');
        if (i < 0) { return m.Name; }
        return q.Substring(0, i) + "." + m.Name;
    }

    // 本方法的参数化数据行：data provider（运行期生成）优先，其次 `[Case]` 行；都无 → null。
    // 两者编译期互斥（E0920），这里取非空的那份。
    static object[] _rowsOf(TestCase tc) {
        MethodInfo p = tc.DataProvider;   // 快照：字段判空后不能直接再读（E0484）
        if (p != null) { return TestDiscovery._providerRows(tc, p); }
        return tc.CaseRows;
    }

    // 调 data provider 拿行（零参 → `List<object[]>`，每元素一行实参）。provider 抛异常 /
    // 返回形状不对：直接抛带上下文的异常——发现即崩（套件红），不做「静默零行」——那与
    // 「provider 写坏了」不可区分，是最坏的失败形态。
    static object[] _providerRows(TestCase tc, MethodInfo p) {
        object grid;
        try {
            grid = p.Invoke(null, new object[0]);
        } catch (Exception e) {
            throw new Exception("data provider 失败（" + tc.Qualified + " ← "
                + p.Name + "）: " + e.Message);
        }
        List<object[]> rows = grid as List<object[]>;
        if (rows == null) {
            throw new Exception("data provider 形状不对（" + tc.Qualified + " ← "
                + p.Name + "）: 须返回 List<object[]>（每元素一行实参 object[]）");
        }
        object[] outRows = new object[rows.Count];
        int r = 0;
        while (r < rows.Count) { outRows[r] = rows[r]; r = r + 1; }
        return outRows;
    }

    static string? _orNull(string s) {
        if (s == null || s.Length == 0) { return null; }
        return s;
    }

    static TestCase[] _push(TestCase[] a, int n, TestCase x) {
        if (n == a.Length) {
            TestCase[] b = new TestCase[a.Length * 2];
            int i = 0;
            while (i < n) { b[i] = a[i]; i = i + 1; }
            a = b;
        }
        a[n] = x;
        return a;
    }

    // 插入排序（用例数小；稳定）。
    static void _sortByName(TestCase[] a) {
        int i = 1;
        while (i < a.Length) {
            TestCase x = a[i];
            int j = i - 1;
            while (j >= 0 && a[j].Qualified.CompareTo(x.Qualified) > 0) {
                a[j + 1] = a[j];
                j = j - 1;
            }
            a[j + 1] = x;
            i = i + 1;
        }
    }
}
