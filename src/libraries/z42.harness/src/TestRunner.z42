namespace Std.Harness;
using Std.IO;

/// 不依赖 attribute / 反射的命令式单元测试 runner：`Begin` / `Fail` / `Summary` 三段式。
///
/// 每条测试一对 `Begin(name)` + `try { ... } catch (Exception e) { Fail(e); }`：
///
///     var t = new TestRunner("MyTests");
///     t.Begin("Addition");
///     try { Assert.Equal(4, 2 + 2); } catch (Exception e) { t.Fail(e); }
///     return t.Summary();   // 退出码 = failed 计数
///
/// `Begin` 隐式结算上一条（未被 `Fail` 标记即 PASS）；`Summary` 结算最后一条并打印汇总。
/// 适合手写 main 的小产物；常规测试用 `[Test]` + [`Runner`]。
public class TestRunner {
    string ContextName;
    string CurrentName;
    bool   CurrentActive;
    bool   CurrentFailed;
    int    Passed;
    int    Failed;

    public TestRunner(string contextName) {
        this.ContextName   = contextName;
        this.CurrentName   = "";
        this.CurrentActive = false;
        this.CurrentFailed = false;
        this.Passed        = 0;
        this.Failed        = 0;
        Console.WriteLine("══════════════════════════════════════");
        Console.WriteLine($" {contextName}");
        Console.WriteLine("══════════════════════════════════════");
    }

    /// 开始一条测试；有进行中的条目则先结算它。
    public void Begin(string name) {
        if (this.CurrentActive) {
            this.Finalize();
        }
        this.CurrentName   = name;
        this.CurrentActive = true;
        this.CurrentFailed = false;
    }

    /// 标记当前条目失败（在 catch 处调用），打印失败原因。
    ///
    /// 打印用 `ToString()` 而非 `Message`：`Assert` 抛的 `TestFailure` 里
    /// `Message` 只是概括语（"values not equal"），actual / expected 要经
    /// `ToString()` 才带得出来；裸 `Exception` 的 `ToString()` 同样不丢信息。
    public void Fail(Exception e) {
        this.CurrentFailed = true;
        Console.WriteLine($"  ✗ FAIL: {this.CurrentName}");
        Console.WriteLine($"          {e.ToString()}");
    }

    /// 结算最后一条（若有）、打印汇总。返回 failed 计数，适合直接做进程退出码。
    public int Summary() {
        if (this.CurrentActive) {
            this.Finalize();
        }
        Console.WriteLine("──────────────────────────────────────");
        Console.WriteLine($" Result: {this.Passed} passed, {this.Failed} failed");
        Console.WriteLine("══════════════════════════════════════");
        return this.Failed;
    }

    // 内部：把当前 case 计入 pass/fail 统计 + 打印 PASS 行。
    void Finalize() {
        if (this.CurrentFailed) {
            this.Failed = this.Failed + 1;
        } else {
            this.Passed = this.Passed + 1;
            Console.WriteLine($"  ✓ {this.CurrentName}");
        }
        this.CurrentActive = false;
    }
}
