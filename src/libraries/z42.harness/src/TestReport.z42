namespace Std.Harness;


/// 一条测试 / 基准的运行结果。没有 duration / 失败位置 / 栈字段：进程内 runner
/// 没有可靠来源，略去而不是编造。
public class TestResult {
    /// 全限定名：`<命名空间或类型>.<函数名>`。
    public string Name;
    /// `"passed"` | `"failed"` | `"skipped"`。
    public string Status;
    /// 该条是否为 `[Benchmark]`（json 报告的 `is_benchmark` 字段）。
    public bool IsBenchmark;
    /// 仅失败 / 跳过时非 null。
    public string Reason;
    /// 仅基准且摘要行解析成功时非 null。
    public BenchStats Stats;

    /// 全字段直赋：`reason` 仅失败 / 跳过时非 null，`stats` 仅基准解析成功时非 null。
    public TestResult(string name, string status, bool isBenchmark, string reason, BenchStats stats) {
        this.Name = name;
        this.Status = status;
        this.IsBenchmark = isBenchmark;
        this.Reason = reason;
        this.Stats = stats;
    }
}

/// runner `--format json` 模式的报告序列化。本包零依赖，JSON 手写而非经 z42.json。
/// schema：
///
///     { "tool":"z42b", "module":"<path>",
///       "summary":{"total":N,"passed":P,"failed":F,"skipped":S},
///       "results":[ {"name":..,"status":..,"is_benchmark":..[,"reason":..][,"bench_stats":..]} ] }
public static class TestReport {
    /// 渲染一份 JSON 报告。形参名是 `artifact` 而非 `module`——`module` 是 z42 保留字。
    public static string toJson(string artifact, TestResult[] results) {
        int total = results.Length;
        int passed = 0; int failed = 0; int skipped = 0;
        int i = 0;
        while (i < results.Length) {
            string st = results[i].Status;
            if (st == "passed")       { passed = passed + 1; }
            else if (st == "failed")  { failed = failed + 1; }
            else                      { skipped = skipped + 1; }
            i = i + 1;
        }

        string s = "{";
        s = s + "\"tool\":\"z42b\",";
        s = s + "\"module\":\"" + TestReport.esc(artifact) + "\",";
        s = s + "\"summary\":{"
            + "\"total\":" + total.ToString() + ","
            + "\"passed\":" + passed.ToString() + ","
            + "\"failed\":" + failed.ToString() + ","
            + "\"skipped\":" + skipped.ToString() + "},";
        s = s + "\"results\":[";
        int j = 0;
        while (j < results.Length) {
            if (j > 0) { s = s + ","; }
            s = s + TestReport.resultJson(results[j]);
            j = j + 1;
        }
        s = s + "]}";
        return s;
    }

    /// 渲染单条结果的 JSON 对象（不带尾逗号；由 toJson 以 "," 接合）。
    public static string resultJson(TestResult r) {
        string s = "{";
        s = s + "\"name\":\"" + TestReport.esc(r.Name) + "\",";
        s = s + "\"status\":\"" + r.Status + "\",";
        s = s + "\"is_benchmark\":" + (r.IsBenchmark ? "true" : "false");
        if (r.Reason != null) {
            s = s + ",\"reason\":\"" + TestReport.esc(r.Reason) + "\"";
        }
        if (r.Stats != null) {
            s = s + ",\"bench_stats\":" + TestReport._statsJson(r.Stats);
        }
        s = s + "}";
        return s;
    }

    static string _statsJson(BenchStats b) {
        // mean_ns / stddev_ns (extend-ab-bench-micro-criterion): -1 when the
        // summary line omitted them (older Bencher) → consumers treat as "no CI".
        return "{"
            + "\"label\":\"" + TestReport.esc(b.Label) + "\","
            + "\"min_ns\":" + b.MinNs.ToString() + ","
            + "\"median_ns\":" + b.MedianNs.ToString() + ","
            + "\"max_ns\":" + b.MaxNs.ToString() + ","
            + "\"mean_ns\":" + b.MeanNs.ToString() + ","
            + "\"stddev_ns\":" + b.StdDevNs.ToString() + ","
            + "\"samples\":" + b.Samples.ToString()
            + "}";
    }

    /// 最小 JSON 字符串转义：引号、反斜杠及异常消息里常见的控制字符。
    ///
    /// 对本报告携带的字符串（名字、状态、原因文本）已足够。
    public static string esc(string str) {
        string outp = "";
        int i = 0;
        while (i < str.Length) {
            string c = str.Substring(i, 1);
            if (c == "\"")       { outp = outp + "\\\""; }
            else if (c == "\\")  { outp = outp + "\\\\"; }
            else if (c == "\n")  { outp = outp + "\\n"; }
            else if (c == "\r")  { outp = outp + "\\r"; }
            else if (c == "\t")  { outp = outp + "\\t"; }
            else                 { outp = outp + c; }
            i = i + 1;
        }
        return outp;
    }
}
