namespace Std.Harness;

using Std.IO;

/// 测试束里的一条。
///
/// `Entry` 为 null 标记单元测试（`[Test]` 模块）；非 null（golden 程序的入口符号）
/// 标记整程序 golden。`Zbc` / `Expected` 是相对束目录的文件名；`Requires` 是该条
/// 声明的能力（源码 `// requires-caps:` 经 manifest 带来），空 = 无。
public class BundleCase {
    /// 条目名；golden 与被能力门跳过的条目以它作 TestResult.Name。
    public string Name;
    /// 产物文件名（`.zbc`），相对束目录。
    public string Zbc;
    /// null → 单元测试；非 null → golden 的入口符号。
    public string Entry;
    /// golden 的期望输出文件名（可为 null / ""）。
    public string Expected;
    /// 该条声明的能力（空 = 无要求）；本 VM 缺任一项则整条跳过、不加载。
    public string[] Requires;

    /// 按 name / zbc / entry / expected 建一条；`Requires` 初始化为空数组。
    public BundleCase(string name, string zbc, string entry, string expected) {
        this.Name = name;
        this.Zbc = zbc;
        this.Entry = entry;
        this.Expected = expected;
        this.Requires = new string[0];
    }

    /// 是否整程序 golden 条目（`Entry` 非 null）。
    public bool IsGolden() { return this.Entry != null; }
}

/// 测试束执行器：golden + 单元 + 汇总。
///
/// golden（整程序，隔离 VM 里跑、比对 stdout）+ 单元（共享 VM 的 `[Test]` 模块，
/// 经 [`Runner.RunModuleResults`]）+ 汇总。设备端 test-agent 与宿主
/// `z42b test --rid host` 共用这套算法。
///
/// manifest 本身是 JSON，但本包零依赖：调用方用自己的 z42.json 把 manifest.json
/// 解析成 `BundleCase[]` 再传进来。
public static class BundleRunner {
    /// 跑 `cases` 里的每一条并返回汇总结果（golden 在前、单元在后，缺能力被跳过的
    /// 条目排在末尾）。
    ///
    /// 能力门在加载之前：声明的能力本 VM 缺失的条目直接记 skipped、不加载（加载
    /// 本身就可能 trap——没有 native interop 的 VM 上 `[Native]` 门面在解析器里 panic）。
    ///
    /// @param allCases 束内全部条目
    /// @param bundleDir 存放 zbc / 期望输出文件的目录
    /// @param libsDir 隔离 golden VM 的 stdlib 目录（"" → `Z42_LIBS`，否则 `<bundleDir>/../libs`）
    public static TestResult[] RunBundle(BundleCase[] allCases, string bundleDir, string libsDir) {
        // Capability gate FIRST, before anything is loaded: a case whose declared caps
        // this VM lacks is reported skipped and never loaded — loading alone can trap
        // (a [Native] facade on a VM without native interop panics in the resolver).
        // The VM's Capabilities() is the ground truth; nothing upstream guesses it.
        string[] have = Platform.Capabilities();
        TestResult[] skipped = new TestResult[0];
        int runnable = 0;
        for (int i = 0; i < allCases.Length; i = i + 1) {
            if (BundleRunner._missingCaps(allCases[i], have).Length == 0) { runnable = runnable + 1; }
        }
        BundleCase[] cases = new BundleCase[runnable];
        int ri = 0;
        for (int i = 0; i < allCases.Length; i = i + 1) {
            string missing = BundleRunner._missingCaps(allCases[i], have);
            if (missing.Length == 0) { cases[ri] = allCases[i]; ri = ri + 1; continue; }
            TestResult[] one = new TestResult[1];
            one[0] = new TestResult(allCases[i].Name, "skipped", false,
                "requires caps this platform lacks: " + missing, null);
            skipped = BundleRunner._concat(skipped, one);
        }
        int n = cases.Length;

        // Pass 1: count goldens (need their own gathered arrays for the batched
        // isolated run).
        int gN = 0;
        for (int i = 0; i < n; i = i + 1) {
            if (cases[i].IsGolden()) { gN = gN + 1; }
        }

        TestResult[] all = new TestResult[0];

        // Goldens: gather → ModuleLoader.RunIsolated (batched, isolated) → compare stdout.
        if (gN > 0) {
            string[] gPaths = new string[gN];
            string[] gEntries = new string[gN];
            string[] gNames = new string[gN];
            string[] gExpected = new string[gN];
            int gi = 0;
            for (int i = 0; i < n; i = i + 1) {
                BundleCase c = cases[i];
                if (!c.IsGolden()) { continue; }
                gPaths[gi] = Path.Join(bundleDir, c.Zbc);
                gEntries[gi] = c.Entry;
                gNames[gi] = c.Name;
                string exp = "";
                if (c.Expected != null && c.Expected.Length > 0) {
                    string ep = Path.Join(bundleDir, c.Expected);
                    if (File.Exists(ep)) { exp = File.ReadAllText(ep); }
                }
                gExpected[gi] = exp;
                gi = gi + 1;
            }
            string libs = BundleRunner._resolveLibs(libsDir, bundleDir);
            int jobs = BundleRunner._jobs();
            string[] outs = ModuleLoader.RunIsolated(gPaths, gEntries, libs, jobs);
            TestResult[] gr = new TestResult[gN];
            for (int i = 0; i < gN; i = i + 1) {
                string got = BundleRunner._stripNl(outs[i]);
                string want = BundleRunner._stripNl(gExpected[i]);
                if (got == want) {
                    gr[i] = new TestResult(gNames[i], "passed", false, null, null);
                } else {
                    gr[i] = new TestResult(gNames[i], "failed", false,
                        "stdout mismatch: want [" + BundleRunner._oneLine(want) + "] got [" + BundleRunner._oneLine(got) + "]", null);
                }
            }
            all = BundleRunner._concat(all, gr);
        }

        // Units: shared-VM [Test] modules.
        for (int i = 0; i < n; i = i + 1) {
            BundleCase c = cases[i];
            if (c.IsGolden()) { continue; }
            TestResult[] rs = Runner.RunModuleResults(Path.Join(bundleDir, c.Zbc));
            all = BundleRunner._concat(all, rs);
        }

        return BundleRunner._concat(all, skipped);
    }

    // Comma-joined declared caps of `c` that are absent from `have` ("" = runnable).
    static string _missingCaps(BundleCase c, string[] have) {
        string missing = "";
        if (c.Requires == null) { return missing; }
        for (int i = 0; i < c.Requires.Length; i = i + 1) {
            bool found = false;
            for (int j = 0; j < have.Length; j = j + 1) {
                if (have[j] == c.Requires[i]) { found = true; }
            }
            if (!found) { missing = missing.Length == 0 ? c.Requires[i] : missing + "," + c.Requires[i]; }
        }
        return missing;
    }

    /// 束结果的退出码：任一条 failed → 1，否则 0。
    public static int ExitCode(TestResult[] results) {
        int i = 0;
        while (i < results.Length) {
            if (results[i].Status == "failed") { return 1; }
            i = i + 1;
        }
        return 0;
    }

    // Resolve the stdlib dir for isolated golden VMs: explicit libsDir wins, else
    // Z42_LIBS (desktop harness), else <bundleDir>/../libs (the on-device
    // deployable stages stdlib as a sibling of the bundle dir).
    static string _resolveLibs(string libsDir, string bundleDir) {
        if (libsDir != null && libsDir.Length > 0) { return libsDir; }
        string env = Environment.GetEnvironmentVariable("Z42_LIBS", "");
        if (env.Length > 0) { return env; }
        string cand = Path.Join(Path.GetDirectoryName(bundleDir), "libs");
        if (Directory.Exists(cand)) { return cand; }
        return "";
    }

    // Golden parallelism (P2): Z42_TEST_JOBS (int) → workers; 0/unset = auto
    // (cores), 1 = sequential.
    static int _jobs() {
        string jv = Environment.GetEnvironmentVariable("Z42_TEST_JOBS", "");
        if (jv.Length > 0) {
            try { return int.Parse(jv); } catch (Exception e) { return 0; }
        }
        return 0;
    }

    // Grow: return a ++ b (z42 has no jagged arrays / built-in concat here).
    static TestResult[] _concat(TestResult[] a, TestResult[] b) {
        TestResult[] merged = new TestResult[a.Length + b.Length];
        for (int i = 0; i < a.Length; i = i + 1) { merged[i] = a[i]; }
        for (int i = 0; i < b.Length; i = i + 1) { merged[a.Length + i] = b[i]; }
        return merged;
    }

    // Strip trailing newlines only (mirror the host golden runner's
    // _stripTrailingNewlines — NOT a full trim, so trailing spaces still matter).
    static string _stripNl(string s) {
        int e = s.Length;
        while (e > 0) {
            string ch = s.Substring(e - 1, 1);
            if (ch == "\n" || ch == "\r") { e = e - 1; } else { break; }
        }
        return s.Substring(0, e);
    }

    // First non-empty line (for a compact mismatch reason). Leading newlines are
    // skipped: a run error arrives as "\n<z42-run-error: …>" appended to empty
    // stdout, which would otherwise show as an empty `got []`.
    static string _oneLine(string s) {
        int st = 0;
        while (st < s.Length && (s.Substring(st, 1) == "\n" || s.Substring(st, 1) == "\r")) { st = st + 1; }
        s = s.Substring(st);
        int nl = s.IndexOf("\n");
        string head = (nl >= 0) ? s.Substring(0, nl) : s;
        if (head.Length > 80) { head = head.Substring(0, 80) + "…"; }
        return head;
    }
}
