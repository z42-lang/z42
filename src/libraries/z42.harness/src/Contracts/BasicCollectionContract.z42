namespace Std.Harness.Contracts;

/// `IBasicCollection<T>` 的行为契约测试。
///
/// 对任何实现都普遍成立的不变式，一条 `[Test]` 一行搞定，不必在每个集合的测试
/// 文件里抄五遍断言。
///
///     [Test]
///     void test_linkedlist_basic_contract() {
///         BasicCollectionContract.Run("LinkedList<int>", new LinkedList<int>());
///     }
///
/// 在一个新实例上跑完整生命周期：新建为空 → `AddOne` 三个互异元素 →
/// `Count()==3` 且非空 → `Clear()` → 空 → 再 `Clear()` 幂等。元素取互异值，
/// 契约对去重语义的集合（SortedSet）同样成立。
///
/// @warning 形参是实例而非 `Func<IBasicCollection<int>>`：z42 委托暂无返回型协变，
///     `() => new LinkedList<int>()` 不能赋给 `Func<IBasicCollection<int>>`；
///     收实例靠调用点的隐式向上转型。元素类型暂固定为 `int`。
public static class BasicCollectionContract {
    /// 对 `instance` 断言 `IBasicCollection` 的全部不变式。
    ///
    /// @param name 失败上下文里的人类可读标签（如 `"Queue<int>"`）
    /// @param instance **新建**的实例——第一条不变式就断言它为空
    public static void Run(string name, IBasicCollection<int> instance) {
        // Invariant 1: a freshly-constructed collection is empty.
        Assert.Equal(0, instance.Count());
        Assert.True(instance.IsEmpty());

        // Invariant 2 (add-collection-contract-phase2): adding N *distinct*
        // elements makes Count == N and IsEmpty == false. Distinct values keep
        // this universal — Queue/Stack/LinkedList/PriorityQueue retain all 3;
        // SortedSet dedups but 3 distinct values are still 3 (repeats would
        // collapse to 1 and break universality). Catches a Count that fails to
        // increment on add, or an IsEmpty stuck on a stale flag.
        instance.AddOne(1);
        instance.AddOne(2);
        instance.AddOne(3);
        Assert.Equal(3, instance.Count());
        Assert.False(instance.IsEmpty());

        // Invariant 3: Clear() on a *non-empty* collection returns it to empty.
        // Catches a Clear that resets indices but not Count, or vice versa.
        instance.Clear();
        Assert.Equal(0, instance.Count());
        Assert.True(instance.IsEmpty());

        // Invariant 4: Clear() on an already-empty collection is idempotent.
        instance.Clear();
        Assert.Equal(0, instance.Count());
        Assert.True(instance.IsEmpty());
    }
}
