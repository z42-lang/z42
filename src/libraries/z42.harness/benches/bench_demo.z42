// add-benchmark-runner-dispatch (2026-05-31) — in-tree e2e demo of
// runner-dispatched `[Benchmark]` methods + regression test that the
// pre-spec "Bencher inside [Test]" workaround still works.
//
// Output (pretty): test wave shows `✓ bench:bench_addition_demo (Nms)`
// for the benchmark and `✓ test_bencher_inside_test_still_works (Mms)`
// for the regression test. Both also write a `bench[label] min=...`
// line to stdout from `printSummary`.

namespace Z42TestBenchDemo;

using Std.Harness;

// ── [Benchmark] runner-dispatched form ────────────────────────────────

[Benchmark]
void bench_addition_demo(Bencher b) {
    // 注入形态的样例：预热/采样/摘要全由 runner 承担（固定档 2/20——见下），体里只写 b.iter。
    b.iter(() => {
        int x = 1 + 2 + 3;
        BenchHelpers.blackBox(x);
    });
    // Sanity check on the injected Bencher — if iter didn't run, Samples
    // would be the ctor value 20 but Min/Max/Median would be 0 (no
    // measurement). We assert both counters and stats moved to confirm
    // the body actually executed.
    Assert.Equal(20, b.Samples);
    Assert.True(b.TotalNs > 0L);
}

// ── Bencher-arg form (add-benchmark-bencher-arg-trampoline, 2026-05-31) ──
// The compiler desugars `[Benchmark] void f(Bencher b)` into a zero-arg
// wrapper that constructs the Bencher + calls this body + printSummary("f").
// The runner dispatches `bench_add_argform` and captures its stats.

[Benchmark]
void bench_add_argform(Bencher b) {
    b.iter(() => {
        int x = 1 + 2 + 3;
        BenchHelpers.blackBox(x);
    });
}

// ── Regression: Bencher inside [Test] still works (pre-spec pattern) ──

[Test]
void test_bencher_inside_test_still_works() {
    var b = new Bencher(2, 5);
    b.iter(() => {
        int y = 4 + 5 + 6;
        BenchHelpers.blackBox(y);
    });
    b.printSummary("inside_test_regression");
    Assert.Equal(5, b.Samples);
    Assert.True(b.TotalNs > 0L);
}
