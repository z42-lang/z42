// z42c.syntax 顶层声明解析单测：namespace/using/class/field/method/ctor/类型文本（incr 4）
//   + struct/interface/enum（incr 6b-1）+ record/delegate/顶层func（incr 6b-2）+ property（incr 6b-3）
//   + 泛型形参<T>+where（incr 6b-4）+ attribute[X]（incr 6b-5）。
namespace Z42cSyntaxDeclTests;

using Std;
using Std.Test;
using Z42.Syntax;
using Z42.Core;

string parseUnit(string src) {
    var p = new Parser(src, "t.z42");
    var u = p.ParseCompilationUnit();
    return u.Dump();
}

// add-params-varargs 阶段 6.5：`params` 约束校验诊断（E0206/E0207/E0208）。
// 返回逗号拼接的诊断 code 序列（空串=无诊断），便于用 Assert.Equal 精确断言条数+顺序。
string parseErrorCodes(string src) {
    var p = new Parser(src, "t.z42");
    p.ParseCompilationUnit();
    var diags = p.Diagnostics();
    string codes = "";
    int i = 0;
    while (i < diags.Count()) {
        if (codes != "") { codes = codes + ","; }
        codes = codes + diags.Get(i).Code;
        i = i + 1;
    }
    return codes;
}

[Test]
void test_namespace_and_usings() {
    Assert.Equal("(unit (ns Foo.Bar) (using Std) (using Std.IO))",
                 parseUnit("namespace Foo.Bar; using Std; using Std.IO;"));
}

[Test]
void test_empty_class() {
    Assert.Equal("(unit (class C))", parseUnit("class C {}"));
}

[Test]
void test_class_modifiers_and_base() {
    Assert.Equal("(unit (class public sealed Foo : Bar, IBaz))",
                 parseUnit("public sealed class Foo : Bar, IBaz {}"));
}

[Test]
void test_fields() {
    Assert.Equal("(unit (class C (field private int x) (field public string Name \"a\")))",
                 parseUnit("class C { private int x; public string Name = \"a\"; }"));
}

// add-const-keyword：const 字段修饰进 Mods（含引用已定义 const 的常量表达式初始化器）。
[Test]
void test_const_field() {
    Assert.Equal("(unit (class C (field const int Max 100) (field const int Two (* Max 2))))",
                 parseUnit("class C { const int Max = 100; const int Two = Max * 2; }"));
}

[Test]
void test_method() {
    Assert.Equal("(unit (class C (method public int Add (int a, int b) (block (return (+ a b))))))",
                 parseUnit("class C { public int Add(int a, int b) { return a + b; } }"));
}

[Test]
void test_constructor() {
    Assert.Equal("(unit (class Point (ctor public Point (int x) (block (expr (= (. this x) x))))))",
                 parseUnit("class Point { public Point(int x) { this.x = x; } }"));
}

[Test]
void test_abstract_method_no_body() {
    Assert.Equal("(unit (class C (method public abstract int Foo ())))",
                 parseUnit("class C { public abstract int Foo(); }"));
}

[Test]
void test_generic_and_array_types() {
    Assert.Equal("(unit (class C (field private List<int> xs) (field private string[] names) (field private Dict<string,int> m)))",
                 parseUnit("class C { private List<int> xs; private string[] names; private Dict<string, int> m; }"));
}

[Test]
void test_nested_generic_type() {
    Assert.Equal("(unit (class C (field private List<List<int>> m)))",
                 parseUnit("class C { private List<List<int>> m; }"));
}

[Test]
void test_full_class() {
    Assert.Equal("(unit (ns App) (using Std) (class public Counter (field private int n) (ctor public Counter (int start) (block (expr (= (. this n) start)))) (method public int Next () (block (expr (= n (+ n 1))) (return n)))))",
        parseUnit("namespace App; using Std; public class Counter { private int n; public Counter(int start) { this.n = start; } public int Next() { n = n + 1; return n; } }"));
}

[Test]
void test_struct() {
    // struct 复用 class 成员机制（含 ctor 消歧）
    Assert.Equal("(unit (struct Point (field public int X) (field public int Y)))",
                 parseUnit("struct Point { public int X; public int Y; }"));
    Assert.Equal("(unit (struct public Pair (field public int A) (ctor public Pair (int a) (block (expr (= (. this A) a))))))",
                 parseUnit("public struct Pair { public int A; public Pair(int a) { this.A = a; } }"));
}

[Test]
void test_interface() {
    // interface 体为方法签名（无体 → `;`）
    Assert.Equal("(unit (interface IFoo (method int Bar ()) (method void Baz (int x))))",
                 parseUnit("interface IFoo { int Bar(); void Baz(int x); }"));
    Assert.Equal("(unit (interface public IShape : IDrawable (method double Area ())))",
                 parseUnit("public interface IShape : IDrawable { double Area(); }"));
}

[Test]
void test_enum() {
    Assert.Equal("(unit (enum Color Red Green Blue))",
                 parseUnit("enum Color { Red, Green, Blue }"));
    // 底层类型 + 显式值（含未显式的裸成员） + 尾随逗号
    Assert.Equal("(unit (enum public Flags : int (A 1) B (C 5)))",
                 parseUnit("public enum Flags : int { A = 1, B, C = 5, }"));
}

[Test]
void test_top_level_func() {
    // 顶层自由函数（head=func，区别于类成员 method）
    Assert.Equal("(unit (func int Add (int a, int b) (block (return (+ a b)))))",
                 parseUnit("int Add(int a, int b) { return a + b; }"));
    Assert.Equal("(unit (ns T) (func string greet (string n) (block (return n))))",
                 parseUnit("namespace T; string greet(string n) { return n; }"));
}

[Test]
void test_delegate() {
    Assert.Equal("(unit (delegate int BinOp (int a, int b)))",
                 parseUnit("delegate int BinOp(int a, int b);"));
    Assert.Equal("(unit (delegate public void Handler (string msg)))",
                 parseUnit("public delegate void Handler(string msg);"));
}

[Test]
void test_record() {
    // add-record-attribute（N+1）：`record` 关键字已删 → `[Record] class` 替代。位置参数（`;` 短形式）
    // → PUBLIC 字段 + 主构造器；attr 外层包裹，Kind=class。
    Assert.Equal("(unit (attr [Record] (class Point (field public int X) (field public int Y) (ctor public Point (int X, int Y) (block (expr (= (. this X) X)) (expr (= (. this Y) Y)))))))",
                 parseUnit("[Record] class Point(int X, int Y);"));
    // [Record] class + 基类 + 块体成员 → 位置参数降级为 public 字段 + ctor，`: Base` 紧随名字
    Assert.Equal("(unit (attr [Record] (class public Person : Base (field public string Name) (ctor public Person (string Name) (block (expr (= (. this Name) Name)))) (method int Age () (block (return 0))))))",
                 parseUnit("[Record] public class Person(string Name) : Base { int Age() { return 0; } }"));
    // [Record] class 无位置参数（块式）
    Assert.Equal("(unit (attr [Record] (class Empty)))", parseUnit("[Record] class Empty { }"));
    // [Record] struct — 与 class 同一就地展开（public 字段 + 主构造器），Kind=struct（值类型轴）
    Assert.Equal("(unit (attr [Record] (struct Vec (field public int X) (field public int Y) (ctor public Vec (int X, int Y) (block (expr (= (. this X) X)) (expr (= (. this Y) Y)))))))",
                 parseUnit("[Record] struct Vec(int X, int Y);"));
    // 裸主构造器（无 [Record]）：位置参数 → PRIVATE 字段 + 主构造器（C# 12 primary ctor 语义）
    Assert.Equal("(unit (class Point (field private int X) (field private int Y) (ctor public Point (int X, int Y) (block (expr (= (. this X) X)) (expr (= (. this Y) Y))))))",
                 parseUnit("class Point(int X, int Y);"));
    // 裸主构造器 struct（无 [Record]）：位置参数 → PRIVATE 字段（值类型主构造器）
    Assert.Equal("(unit (struct P (field private int X) (ctor public P (int X) (block (expr (= (. this X) X))))))",
                 parseUnit("struct P(int X);"));
}

[Test]
void test_record_keyword_removed() {
    // N+1：`record` 关键字已删 → 现为普通标识符（可作类型名 / 字段名），不再触发记录降级。
    Assert.Equal("(unit (class C (field record x)))",
                 parseUnit("class C { record x; }"));
}

[Test]
void test_property() {
    Assert.Equal("(unit (class C (prop public int Age get set)))",
                 parseUnit("class C { public int Age { get; set; } }"));
    Assert.Equal("(unit (class C (prop public string Name get)))",   // get-only
                 parseUnit("class C { public string Name { get; } }"));
    Assert.Equal("(unit (class C (prop public int X get set 0)))",   // 初值
                 parseUnit("class C { public int X { get; set; } = 0; }"));
    Assert.Equal("(unit (class C (prop public int Y get private set)))",  // 访问器修饰
                 parseUnit("class C { public int Y { get; private set; } }"));
}

[Test]
void test_property_in_interface() {
    Assert.Equal("(unit (interface IShape (prop double Area get) (method void Draw ())))",
                 parseUnit("interface IShape { double Area { get; } void Draw(); }"));
}

// add-property-getter：命名属性的计算 getter（`get { ... }`）解析成带块体的 prop（区别于 auto `get;`）。
[Test]
void test_computed_property_getter() {
    Assert.Equal("(unit (class C (prop public int Doubled get (block (return (* (. this n) 2))))))",
                 parseUnit("class C { public int Doubled { get { return this.n * 2; } } }"));
    Assert.Equal("(unit (class C (prop public bool Big get (block (return (> (. this n) 10))))))",
                 parseUnit("class C { public bool Big { get { return this.n > 10; } } }"));
    // auto-property 仍是分号形式（不带块体）——与计算 getter 区分。
    Assert.Equal("(unit (class C (prop public int A get)))",
                 parseUnit("class C { public int A { get; } }"));
}

// add-expression-bodied-members：`T P => e;` 与 `get => e;` 必须脱糖成与 `get { return e; }`
// **逐字相同**的 AST（下游零新路径的依据）；此前 `=>` 落进字段分支 ⇒ E0202 连环。
[Test]
void test_expression_bodied_property() {
    string block = parseUnit("class C { public int D { get { return this.n * 2; } } }");
    Assert.Equal(block, parseUnit("class C { public int D => this.n * 2; }"));
    Assert.Equal(block, parseUnit("class C { public int D { get => this.n * 2; } }"));
    Assert.Equal("", parseErrorCodes("class C { public int D => this.n * 2; }"));
    // 修饰符原样保留（override / abstract 基类属性的实现位）
    Assert.Equal(parseUnit("class C { public override string Name { get { return \"c\"; } } }"),
                 parseUnit("class C { public override string Name => \"c\"; }"));
    // 表达式体方法不受影响（仍是方法，不被误判成属性）
    Assert.Equal("(unit (class C (method public int F () (block (return 1)))))",
                 parseUnit("class C { public int F() => 1; }"));
}

// add-expression-bodied-members：索引器 `=> e;` 与访问器 `get => e;` / `set => e;` 无诊断。
// （indexer 的 Dump 不含体，行为由 src/tests/types/expression_bodied_members.z42 断言。）
[Test]
void test_expression_bodied_indexer() {
    Assert.Equal("", parseErrorCodes("class C { int[] d; public int this[int i] => this.d[i]; }"));
    Assert.Equal("", parseErrorCodes("class C { int[] d; public int this[int i] { get => this.d[i]; set => this.d[i] = value; } }"));
    // 缺分号仍报错（`=>` 体必须 `;` 结尾）
    Assert.Equal("E0202", parseErrorCodes("class C { public int D => 1 }"));
}

[Test]
void test_generic_type_decl() {
    Assert.Equal("(unit (class Box<T> (field private T value)))",
                 parseUnit("class Box<T> { private T value; }"));
    // 泛型形参 + 基接口（带类型实参）+ where 约束（约束含泛型类型实参）
    Assert.Equal("(unit (class Map<K,V> : IDict<K,V> where K : IComparable<K>))",
                 parseUnit("class Map<K, V> : IDict<K, V> where K : IComparable<K> { }"));
    Assert.Equal("(unit (interface IList<T> (method T Get (int i))))",
                 parseUnit("interface IList<T> { T Get(int i); }"));
}

[Test]
void test_generic_method() {
    Assert.Equal("(unit (class C (method public T Make<T> (int n) (block (return null)))))",
                 parseUnit("class C { public T Make<T>(int n) { return null; } }"));
    // 泛型方法 + where new() 约束
    Assert.Equal("(unit (class C (method void F<T> (T x) where T : new() (block))))",
                 parseUnit("class C { void F<T>(T x) where T : new() { } }"));
}

[Test]
void test_generic_delegate_and_record() {
    Assert.Equal("(unit (delegate R Func<T,R> (T x)))",
                 parseUnit("delegate R Func<T, R>(T x);"));
    Assert.Equal("(unit (attr [Record] (class Box<T> (field public T value) (ctor public Box (T value) (block (expr (= (. this value) value)))))))",
                 parseUnit("[Record] class Box<T>(T value);"));
    // where 多段 + class 约束
    Assert.Equal("(unit (delegate void Cb<T> (T x) where T : class))",
                 parseUnit("delegate void Cb<T>(T x) where T : class;"));
}

[Test]
void test_generic_where_constraints() {
    // 多形参 + 多约束（+ 分隔：Rust 风格，z42 语法；类型 + new()）+ 多 where 子句（incr 6d-3 结构化）
    Assert.Equal("(unit (class Foo<T,U> where T : IComparable<T>, new() where U : class))",
                 parseUnit("class Foo<T, U> where T : IComparable<T> + new() where U : class { }"));
}

[Test]
void test_attribute_on_member() {
    Assert.Equal("(unit (class C (attr [Test] (method void foo () (block)))))",
                 parseUnit("class C { [Test] void foo() {} }"));
    // 位置参数（表达式 Dump）
    Assert.Equal("(unit (class C (attr [Timeout 600] (method void slow () (block)))))",
                 parseUnit("class C { [Timeout(600)] void slow() {} }"));
}

[Test]
void test_attribute_on_type() {
    Assert.Equal("(unit (attr [Serializable] (class public C)))",
                 parseUnit("[Serializable] public class C { }"));
    // 多个 attribute（分组）
    Assert.Equal("(unit (attr [A] [B] (class C)))",
                 parseUnit("[A][B] class C {}"));
    // 单组多 attribute（逗号分隔）
    Assert.Equal("(unit (attr [A] [B] (class C)))",
                 parseUnit("[A, B] class C {}"));
}

[Test]
void test_attribute_named_args() {
    // 命名参数 k=v → AssignExpr Dump
    Assert.Equal("(unit (attr [Native (= lib \"m\")] (class C)))",
                 parseUnit("[Native(lib=\"m\")] class C {}"));
}

[Test]
void test_params_not_last_error() {
    // params 修饰的形参不在末位 → E0206（ParamsNotLast）
    Assert.Equal(DiagnosticCodes.ParamsNotLast,
                 parseErrorCodes("class C { void F(params int[] xs, int y) {} }"));
}

[Test]
void test_params_not_array_error() {
    // params 形参类型非 T[] → E0207（ParamsNotArray）
    Assert.Equal(DiagnosticCodes.ParamsNotArray,
                 parseErrorCodes("class C { void F(params int xs) {} }"));
}

[Test]
void test_params_modifier_conflict_with_ref_error() {
    // params 与 ref 同现 → E0208（ParamsModifierConflict）
    Assert.Equal(DiagnosticCodes.ParamsModifierConflict,
                 parseErrorCodes("class C { void F(params ref int[] xs) {} }"));
}

[Test]
void test_params_modifier_conflict_with_default_error() {
    // params 与默认值同现 → E0208（ParamsModifierConflict）
    Assert.Equal(DiagnosticCodes.ParamsModifierConflict,
                 parseErrorCodes("class C { void F(params int[] xs = null) {} }"));
}

[Test]
void test_params_valid_no_error() {
    // 合法形态（非末 params 之前的普通参数 + 末位 params T[]）→ 无诊断
    Assert.Equal("", parseErrorCodes("class C { void F(int a, params int[] xs) {} }"));
}

// ── 关联类型（add-associated-types PR-3）──────────────────────────────────────
//
// `type` **不是关键字**（全仓大量把它当普通标识符：变量名/参数名/属性名），所以它只能靠
// `MemberParser._parseMemberBody` 的三 token 前瞻拦截（`type` + 标识符 + `;`/`=`）。
// 这组用例守的正是「拦得住 + 不误拦」两侧。

[Test]
void test_assoc_type_decl_in_interface() {
    string src = "interface IEnum { type Item; }";
    Assert.Equal(true, parseUnit(src).Contains("(assoc-type Item)"));
}

[Test]
void test_assoc_type_binding_in_class() {
    string src = "class C : IEnum { type Item = int; }";
    Assert.Equal(true, parseUnit(src).Contains("(assoc-type Item = int)"));
}

[Test]
void test_assoc_type_binding_in_where_clause() {
    // 命名绑定只在**约束位**允许（TypeParser._allowAssocBindings 门控）。
    string src = "class Use<T> where T : IEnum<Item = int> { }";
    Assert.Equal(true, parseUnit(src).Contains("Item = int"));
}

[Test]
void test_assoc_binding_not_allowed_in_ordinary_type_position() {
    // 普通类型位写 `Item = int` 不得被当成绑定——`List<Item = int>` 里的 `=` 应触发解析错误，
    // 而不是被静默吃掉。（门控退出即关，这条守的是「没有全局放开」。）
    string src = "class C { List<Item = int> f; }";
    Assert.Equal(true, parseErrorCodes(src) != "");
}

[Test]
void test_type_as_identifier_still_parses() {
    // 🔒 回归守卫：`type` 仍是普通标识符。方法名/参数名/局部变量名叫 type 都不受前瞻影响
    // （第三个 token 分别是 `(` / `,`|`)` / 非 `;=`）。
    string src = "class C { int type(int type) { int x = type; return x; } }";
    Assert.Equal("", parseErrorCodes(src));
}

// ── simplify-ref-parameters：三态收敛为单一 `ref` ──────────────────────
//
// `out` / `in` 作参数修饰符报 E0471，并在消息里给出迁移写法。**必须消费掉那个 token**，
// 否则会从参数列表脱轨（参数列表提前闭合、方法体被撕成垃圾成员）——所以这些用例断言的是
// **恰好一条** E0471，多于一条就说明解析同步断了。

[Test]
void test_out_param_modifier_rejected() {
    Assert.Equal("E0471", parseErrorCodes("class C { void F(out int v) { } }"));
}

[Test]
void test_in_param_modifier_rejected() {
    Assert.Equal("E0471", parseErrorCodes("class C { int F(in int x) { return x; } }"));
}

[Test]
void test_out_arg_modifier_rejected() {
    Assert.Equal("E0471", parseErrorCodes("class C { void M() { F(out v); } }"));
}

[Test]
void test_out_var_arg_modifier_rejected() {
    Assert.Equal("E0471", parseErrorCodes("class C { void M() { F(out var v); } }"));
}

[Test]
void test_in_arg_modifier_rejected() {
    Assert.Equal("E0471", parseErrorCodes("class C { void M() { F(in v); } }"));
}

[Test]
void test_ref_param_and_arg_still_ok() {
    // 🔒 回归守卫：`ref` 本身不受影响（形参 + 调用点 + `ref var` 内联声明）。
    Assert.Equal("", parseErrorCodes("class C { void F(ref int v) { } void M() { int a = 0; this.F(ref a); } }"));
    Assert.Equal("", parseErrorCodes("class C { void M() { F(ref var n); } }"));
}

[Test]
void test_ref_discard_parses() {
    // `ref _` 丢弃符：编译器分配隐藏零值槽，`_` 不进作用域。
    Assert.Equal("", parseErrorCodes("class C { void M() { F(ref _); } }"));
}

[Test]
void test_in_still_works_in_foreach() {
    // 🔒 `in` 只是不再作参数修饰符，foreach 的关键字身份不变。
    Assert.Equal("", parseErrorCodes("class C { void M(int[] xs) { foreach (var x in xs) { } } }"));
}

// ── define-null-check-marks：`?.` 已移除 ────────────────────────────────
//
// `?.` 是 User 点名的「让问题逃掉」的口子之一：把「可能为 null」静默向下传播，
// 最终在离现场很远的地方崩。
//
// 与 E0471 同样的纪律：**必须消费掉那个 token 并按普通 `.` 继续解析**，否则会从
// 表达式脱轨、把后面撕成垃圾。所以这些用例断言的是**恰好一条** E0480 ——
// 多于一条就说明解析同步断了。

[Test]
void test_null_conditional_member_rejected() {
    Assert.Equal("E0480", parseErrorCodes("class C { void M() { var v = n?.value; } }"));
}

// 链式：两个 `?.` 恰好两条，且不产生第三条级联错。
[Test]
void test_null_conditional_chain_rejected() {
    Assert.Equal("E0480,E0480", parseErrorCodes("class C { void M() { var v = a?.b?.c; } }"));
}

// 解析同步的证据：`?.` 之后的语句照常解析，不被撕碎。
[Test]
void test_null_conditional_recovers_to_plain_member() {
    Assert.Equal("E0480", parseErrorCodes("class C { void M() { var v = n?.value; int ok = 1; } }"));
}

// 对照组：普通 `.` 不受影响（别把 `?.` 的退役误伤成员访问）。
[Test]
void test_plain_member_access_still_ok() {
    Assert.Equal("", parseErrorCodes("class C { void M() { var v = n.value; } }"));
}

// 对照组：三元里的 `?` 后面跟成员访问 —— `cond ? a.b : c` 不得被当成 `?.`。
// 词法上 `? a` 与 `?.` 是两回事，但这条用例让它变成有人看着的不变式。
[Test]
void test_ternary_with_member_access_not_mistaken_for_null_conditional() {
    Assert.Equal("", parseErrorCodes("class C { int M(bool c) { return c ? a.b : d.e; } }"));
}

// ── define-null-check-marks：`??` 已移除 ────────────────────────────────
//
// 与 `?.` 同码（E0480）：两者是同一个口子的两种写法，都把「可能为 null」静默收尾掉。
//
// 纪律同上：**必须完整吃掉右侧表达式**，否则 `a ?? b ? c : d` 会从表达式脱轨。
// 所以断言的是**恰好 N 条**——多一条就说明解析同步断了。

[Test]
void test_null_coalescing_rejected() {
    Assert.Equal("E0480", parseErrorCodes("class C { void M() { var v = a ?? b; } }"));
}

// 右结合的链：两个 `??` 恰好两条。
[Test]
void test_null_coalescing_chain_rejected() {
    Assert.Equal("E0480,E0480", parseErrorCodes("class C { void M() { var v = a ?? b ?? c; } }"));
}

// 与 `?:` 混写——最容易脱轨的形态（`??` bp 25 紧于 `?:` bp 20）。
// 恰好一条，证明右侧被完整吃掉、三元没被撕开。
[Test]
void test_null_coalescing_with_ternary_recovers() {
    Assert.Equal("E0480", parseErrorCodes("class C { void M() { var v = a ?? b ? c : d; } }"));
}

// 对照组：三元单独用不受影响。
[Test]
void test_ternary_alone_still_ok() {
    Assert.Equal("", parseErrorCodes("class C { int M(bool c) { return c ? 1 : 2; } }"));
}

// ── 运算符重载：只有二元形态成立（E0495）─────────────────────────────────
// 修前这两种不成立的写法在**声明处一句话不说**：表外符号回落 `"op_" + op` 造出非法名
// `op_!`（`fn @Vec.op_!$1$Vec` 真的被发进 zbc），一元 `-` 撞进表里的 `op_Subtract` 产出
// `op_Subtract$1$T`；派发侧 `TypeFactsTc._operatorMethodNameTc` 两者都查不到 ⇒ 用户只在
// 使用处看到一句与真因无关的 `E0402: operator `-` requires numeric operand`。
//
// ⭐ 判别力必须**成对**看：每条阴性都配一条只差一处的阳性。单看阴性没有分辨力 —— 一个
// 「凡是 operator 都报错」的错误实现同样能让三条阴性全绿。

// 阳性：表内二元一条没动，名字仍降低成 op_Add。
[Test]
void test_binary_operator_overload_unchanged() {
    Assert.Equal("", parseErrorCodes("class V { public static V operator +(V a, V b) { return a; } }"));
    Assert.Equal("(unit (class V (method public static V op_Add (V a, V b) (block (return a)))))",
                 parseUnit("class V { public static V operator +(V a, V b) { return a; } }"));
}

// 阴性①：符号不在 16 条表里 ⇒ 不可重载（此前造出非法名 op_!）。
[Test]
void test_unlisted_operator_symbol_rejected() {
    Assert.Equal("E0495", parseErrorCodes("class V { public static bool operator !(V a) { return true; } }"));
}

// 阴性②：一元形态 ⇒ 形参不是两个（此前撞进 op_Subtract）。
// 与下面那条阳性**只差一个形参**，两条必须一起读。
[Test]
void test_unary_operator_overload_rejected() {
    Assert.Equal("E0495", parseErrorCodes("class V { public static V operator -(V a) { return a; } }"));
}

// 阳性：同一个符号的二元形态照旧成立 —— 证明阴性②拦的是 arity 而不是符号 `-`。
[Test]
void test_binary_minus_overload_still_ok() {
    Assert.Equal("", parseErrorCodes("class V { public static V operator -(V a, V b) { return a; } }"));
}

// 阳性：转换运算符走的是另一条分支（implicit/explicit + 目标类型），一个形参也照旧成立
// —— 证明 arity 判定没有误伤 op_Implicit / op_Explicit。
[Test]
void test_conversion_operator_single_param_still_ok() {
    Assert.Equal("", parseErrorCodes("class V { public static implicit operator int(V a) { return 0; } }"));
}

// ── 元组**类型**的元数上界（此前只有字面量侧有）────────────────────────────
// 修前类型侧只校验下界 ⇒ 9 元组类型合成出 `ValueTuple9`、再由类型解析报
// `E0443: undefined type: ValueTuple9` —— 把编译器内部的脱糖名漏给了用户（用户从没写过
// 这个名字），而同一个错误在字面量侧有准确诊断。tuples.md「限制（v1）」一直写着
// 「元数 2..8；更大元组报错」：文档是对的，类型侧漏了这一半。

// 阴性：9 元组类型 ⇒ 恰好一条 E0402（修前是零条——错误要到语义层解析类型时才冒出来）。
[Test]
void test_tuple_type_arity_over_max_rejected() {
    Assert.Equal("E0402", parseErrorCodes("class C { void M() { (int,int,int,int,int,int,int,int,int) t; } }"));
}

// 阳性（上界边界）：8 元组类型仍零诊断 —— 证明拦的是 >8 而不是「元组类型」。
[Test]
void test_tuple_type_arity_at_max_ok() {
    Assert.Equal("", parseErrorCodes("class C { void M() { (int,int,int,int,int,int,int,int) t; } }"));
}

// 阳性（常见元数）：2 元组不受影响。
[Test]
void test_tuple_type_arity_two_ok() {
    Assert.Equal("", parseErrorCodes("class C { void M() { (int,string) t; } }"));
}

// 阳性：函数类型走 `->` 分流，形参数量不受元组上界约束（9 个形参照旧合法）。
[Test]
void test_func_type_many_params_unaffected() {
    Assert.Equal("", parseErrorCodes("class C { void M() { (int,int,int,int,int,int,int,int,int) -> int f; } }"));
}
