// z42c.syntax Lexer 单测：标识符/关键字/字面量/符号/注释/位置（incr 1）
//   + 数字格式 hex/bin/分隔/后缀/指数（incr 6c-1）+ raw/插值串/转义解码（incr 6c-2）。
namespace Z42cSyntaxLexerTests;

using Std;
using Std.Test;
using Z42.Syntax;
using Z42.Core;

// 辅助：lex 后返回第 i 个 token。
[Test]
void test_identifier() {
    var lx = new Lexer("abc", "t.z42");
    lx.Tokenize();
    Assert.Equal(2, lx.TokenCount());                 // abc + Eof
    Assert.Equal(TokenKind.Identifier, lx.TokenAt(0).Kind);
    Assert.Equal("abc", lx.TokenAt(0).Text);
    Assert.Equal(TokenKind.Eof, lx.TokenAt(1).Kind);
}

[Test]
void test_keywords() {
    var lx = new Lexer("class int if foreach", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.Class, lx.TokenAt(0).Kind);
    Assert.Equal(TokenKind.Int, lx.TokenAt(1).Kind);
    Assert.Equal(TokenKind.If, lx.TokenAt(2).Kind);
    Assert.Equal(TokenKind.Foreach, lx.TokenAt(3).Kind);
}

[Test]
void test_underscore_is_own_token() {
    var lx = new Lexer("_", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.Underscore, lx.TokenAt(0).Kind);
    // _abc 仍是标识符
    var lx2 = new Lexer("_abc", "t.z42");
    lx2.Tokenize();
    Assert.Equal(TokenKind.Identifier, lx2.TokenAt(0).Kind);
    Assert.Equal("_abc", lx2.TokenAt(0).Text);
}

[Test]
void test_int_and_float() {
    var lx = new Lexer("123 3.14", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.IntLiteral, lx.TokenAt(0).Kind);
    Assert.Equal("123", lx.TokenAt(0).Text);
    Assert.Equal(TokenKind.FloatLiteral, lx.TokenAt(1).Kind);
    Assert.Equal("3.14", lx.TokenAt(1).Text);
}

[Test]
void test_member_access_not_float() {
    // `a.b` → Identifier Dot Identifier（点后非数字，不是浮点）
    var lx = new Lexer("a.b", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.Identifier, lx.TokenAt(0).Kind);
    Assert.Equal(TokenKind.Dot, lx.TokenAt(1).Kind);
    Assert.Equal(TokenKind.Identifier, lx.TokenAt(2).Kind);
}

[Test]
void test_string_literal() {
    var lx = new Lexer("\"hello\"", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.StringLiteral, lx.TokenAt(0).Kind);
    Assert.Equal("\"hello\"", lx.TokenAt(0).Text);   // raw lexeme，含引号
}

[Test]
void test_symbols_longest_match() {
    var lx = new Lexer("== -> += << ( ) ;", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.EqEq, lx.TokenAt(0).Kind);
    Assert.Equal(TokenKind.Arrow, lx.TokenAt(1).Kind);
    Assert.Equal(TokenKind.PlusEq, lx.TokenAt(2).Kind);
    Assert.Equal(TokenKind.LtLt, lx.TokenAt(3).Kind);
    Assert.Equal(TokenKind.LParen, lx.TokenAt(4).Kind);
    Assert.Equal(TokenKind.RParen, lx.TokenAt(5).Kind);
    Assert.Equal(TokenKind.Semicolon, lx.TokenAt(6).Kind);
}

[Test]
void test_snippet_token_sequence() {
    var lx = new Lexer("int x = 1;", "t.z42");
    lx.Tokenize();
    Assert.Equal(6, lx.TokenCount());   // int x = 1 ; Eof
    Assert.Equal(TokenKind.Int, lx.TokenAt(0).Kind);
    Assert.Equal(TokenKind.Identifier, lx.TokenAt(1).Kind);
    Assert.Equal(TokenKind.Eq, lx.TokenAt(2).Kind);
    Assert.Equal(TokenKind.IntLiteral, lx.TokenAt(3).Kind);
    Assert.Equal(TokenKind.Semicolon, lx.TokenAt(4).Kind);
    Assert.Equal(TokenKind.Eof, lx.TokenAt(5).Kind);
}

[Test]
void test_comments_skipped() {
    var lx = new Lexer("// line comment\n/* block */ x", "t.z42");
    lx.Tokenize();
    Assert.Equal(2, lx.TokenCount());   // x + Eof
    Assert.Equal(TokenKind.Identifier, lx.TokenAt(0).Kind);
    Assert.Equal("x", lx.TokenAt(0).Text);
}

[Test]
void test_hex_bin_literals() {
    var lx = new Lexer("0xFF 0b1010 0XaB", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.IntLiteral, lx.TokenAt(0).Kind);
    Assert.Equal("0xFF", lx.TokenAt(0).Text);
    Assert.Equal(TokenKind.IntLiteral, lx.TokenAt(1).Kind);
    Assert.Equal("0b1010", lx.TokenAt(1).Text);
    Assert.Equal(TokenKind.IntLiteral, lx.TokenAt(2).Kind);
    Assert.Equal("0XaB", lx.TokenAt(2).Text);
}

[Test]
void test_digit_separators() {
    var lx = new Lexer("1_000_000 3.141_592", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.IntLiteral, lx.TokenAt(0).Kind);
    Assert.Equal("1_000_000", lx.TokenAt(0).Text);
    Assert.Equal(TokenKind.FloatLiteral, lx.TokenAt(1).Kind);
    Assert.Equal("3.141_592", lx.TokenAt(1).Text);
}

[Test]
void test_numeric_suffixes() {
    var lx = new Lexer("100L 3.14f 42u 2.5d", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.IntLiteral, lx.TokenAt(0).Kind);
    Assert.Equal("100L", lx.TokenAt(0).Text);
    Assert.Equal(TokenKind.FloatLiteral, lx.TokenAt(1).Kind);   // f 后缀 → 浮点
    Assert.Equal("3.14f", lx.TokenAt(1).Text);
    Assert.Equal(TokenKind.IntLiteral, lx.TokenAt(2).Kind);
    Assert.Equal("42u", lx.TokenAt(2).Text);
    Assert.Equal(TokenKind.FloatLiteral, lx.TokenAt(3).Kind);   // d 后缀 → 浮点
    Assert.Equal("2.5d", lx.TokenAt(3).Text);
}

[Test]
void test_float_exponent() {
    var lx = new Lexer("1e10 1.5e-3 2E+8", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.FloatLiteral, lx.TokenAt(0).Kind);   // 指数即浮点（无小数点）
    Assert.Equal("1e10", lx.TokenAt(0).Text);
    Assert.Equal(TokenKind.FloatLiteral, lx.TokenAt(1).Kind);
    Assert.Equal("1.5e-3", lx.TokenAt(1).Text);
    Assert.Equal(TokenKind.FloatLiteral, lx.TokenAt(2).Kind);
    Assert.Equal("2E+8", lx.TokenAt(2).Text);
}

[Test]
void test_raw_string() {
    // 源 """hello"""（三引号）→ RawStringLiteral，raw lexeme 含三引号
    var lx = new Lexer("\"\"\"hello\"\"\"", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.RawStringLiteral, lx.TokenAt(0).Kind);
    Assert.Equal("\"\"\"hello\"\"\"", lx.TokenAt(0).Text);
}

[Test]
void test_interpolated_string() {
    // 源 $"hi {name}"
    var lx = new Lexer("$\"hi {name}\"", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.InterpolatedStringLiteral, lx.TokenAt(0).Kind);
    Assert.Equal("$\"hi {name}\"", lx.TokenAt(0).Text);
    // 洞内嵌套字符串：$"{f("x")}" 整体单 token，洞内的 " 不终止外层
    var lx2 = new Lexer("$\"{f(\"x\")}\"", "t.z42");
    lx2.Tokenize();
    Assert.Equal(TokenKind.InterpolatedStringLiteral, lx2.TokenAt(0).Kind);
    Assert.Equal("$\"{f(\"x\")}\"", lx2.TokenAt(0).Text);
    Assert.Equal(TokenKind.Eof, lx2.TokenAt(1).Kind);   // 之后即 Eof（无残余 token）
}

[Test]
void test_decode_string() {
    // raw lexeme（含引号）→ 解码值（剥引号 + 还原转义）
    Assert.Equal("a\nb", Lexer.DecodeString("\"a\\nb\""));       // \n → 换行
    Assert.Equal("c:\\x", Lexer.DecodeString("\"c:\\\\x\""));    // \\ → 反斜杠
    Assert.Equal("say \"hi\"", Lexer.DecodeString("\"say \\\"hi\\\"\""));  // \" → 引号
    Assert.Equal("plain", Lexer.DecodeString("\"plain\""));      // 无转义
}

[Test]
void test_line_column_tracking() {
    var lx = new Lexer("a\n  b", "t.z42");
    lx.Tokenize();
    // a @ line 1 col 1
    Assert.Equal(1, lx.TokenAt(0).Span.Line);
    Assert.Equal(1, lx.TokenAt(0).Span.Column);
    // b @ line 2 col 3
    Assert.Equal(2, lx.TokenAt(1).Span.Line);
    Assert.Equal(3, lx.TokenAt(1).Span.Column);
}

[Test]
void test_char_literal_tokens() {
    // char 字面量：普通 / 转义（整 token 含引号，raw lexeme）
    var lx = new Lexer("'A' '\\n'", "t.z42");
    lx.Tokenize();
    Assert.Equal(TokenKind.CharLiteral, lx.TokenAt(0).Kind);
    Assert.Equal("'A'", lx.TokenAt(0).Text);
    Assert.Equal(TokenKind.CharLiteral, lx.TokenAt(1).Kind);
}

// 由码点构造单字符串（测试断言用，独立于被测的转义字面量）。
string _cp(int code) {
    char[] z = new char[1];
    z[0] = (char)code;
    return String.FromChars(z);
}

[Test]
void test_decode_control_escapes() {
    // reject-invalid-string-escape：C 系控制转义 \a \b \f \v \0 解码为对应码点（非字母）。
    Assert.Equal(_cp(7),  Lexer.DecodeString("\"\\a\""));   // \a → BEL 0x07
    Assert.Equal(_cp(8),  Lexer.DecodeString("\"\\b\""));   // \b → BS  0x08（不再是字母 b）
    Assert.Equal(_cp(12), Lexer.DecodeString("\"\\f\""));   // \f → FF  0x0C
    Assert.Equal(_cp(11), Lexer.DecodeString("\"\\v\""));   // \v → VT  0x0B
    Assert.Equal(_cp(0),  Lexer.DecodeString("\"\\0\""));   // \0 → NUL 0x00
}

[Test]
void test_invalid_escape_string_reports_e0102() {
    // 未知转义 \U（Windows 路径首坑）→ 报 E0102，不静默丢反斜杠。
    var lx = new Lexer("\"C:\\Users\"", "t.z42");
    lx.Tokenize();
    var bag = lx.Diagnostics();
    bool hasE0102 = false;
    int i = 0;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == DiagnosticCodes.InvalidEscape) { hasE0102 = true; }
        i = i + 1;
    }
    Assert.True(hasE0102);
}

[Test]
void test_invalid_escape_char_reports_e0102() {
    // char 字面量未知转义 '\q' → E0102。
    var lx = new Lexer("'\\q'", "t.z42");
    lx.Tokenize();
    var bag = lx.Diagnostics();
    bool hasE0102 = false;
    int i = 0;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == DiagnosticCodes.InvalidEscape) { hasE0102 = true; }
        i = i + 1;
    }
    Assert.True(hasE0102);
}

[Test]
void test_invalid_escape_interpolated_reports_e0102() {
    // 插值串文本段未知转义 $"a\qb" → E0102。
    var lx = new Lexer("$\"a\\qb\"", "t.z42");
    lx.Tokenize();
    var bag = lx.Diagnostics();
    bool hasE0102 = false;
    int i = 0;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == DiagnosticCodes.InvalidEscape) { hasE0102 = true; }
        i = i + 1;
    }
    Assert.True(hasE0102);
}

[Test]
void test_invalid_escape_surfaces_through_parser() {
    // fix-lexer-diags-dropped：lexer 诊断必须经 Parser 上浮（回归守卫——此前 Parser 从不并入
    // lexer bag，E0102 端到端被丢，编译静默通过）。用 Parser 全流程确认 E0102 出现在 ParseDiags。
    var p = new Parser("void Main() { string s = \"C:\\Users\"; }", "t.z42");
    p.ParseCompilationUnit();
    var bag = p.Diagnostics();
    bool hasE0102 = false;
    int i = 0;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == DiagnosticCodes.InvalidEscape) { hasE0102 = true; }
        i = i + 1;
    }
    Assert.True(hasE0102);
}

[Test]
void test_unterminated_string_still_incomplete() {
    // fix-lexer-diags-dropped 不得回归 REPL 续行：未终止串在语句入口仍判「未写完」
    // （incomplete 标志由 parser 期字段直读设置，不受 lexer 诊断合并影响）。
    var p = new Parser("string s = \"abc", "t.z42");
    p.ParseStatement();
    var bag = p.Diagnostics();
    // 未闭合串 + 缺 ; → 仍标记「未写完」（AtEof 或 SemiAtEof 任一）；若 lexer E0101 被 pre-parse
    // 合并，HasErrors 提前为真会抑制此标记 → 本断言即回归为红。
    Assert.True(bag.IsIncompleteAtEof() || bag.IsIncompleteSemiAtEof());
}

[Test]
void test_valid_escapes_no_diag() {
    // 合法转义集不报诊断（含新增 \b \f \a \v）。
    var lx = new Lexer("\"\\n\\t\\r\\a\\b\\f\\v\\0\\\\\\\"\"", "t.z42");
    lx.Tokenize();
    Assert.Equal(0, lx.Diagnostics().Count());
}

[Test]
void test_keyword_table_accessors() {
    // 关键字只读访问器（add-vscode-syntax-ext）：计数>0、逐项非空、哨兵关键字在表中。
    var lx = new Lexer("", "t.z42");
    Assert.True(lx.KeywordCount() > 0);
    bool hasImpl = false;
    bool hasParams = false;
    int i = 0;
    while (i < lx.KeywordCount()) {
        string name = lx.KeywordNameAt(i);
        Assert.True(name.Length > 0);
        if (name == "impl")   { hasImpl = true; }
        if (name == "params") { hasParams = true; }
        i = i + 1;
    }
    Assert.True(hasImpl);
    Assert.True(hasParams);
}

[Test]
void test_dump_keywords_matches_table() {
    // DumpKeywords 行数 == KeywordCount，且首行 == 表首项（注册序）。
    var lx = new Lexer("", "t.z42");
    string dump = DumpTool.DumpKeywords();
    string[] lines = dump.Split("\n");
    int nonEmpty = 0;
    int i = 0;
    while (i < lines.Length) {
        if (lines[i].Length > 0) { nonEmpty = nonEmpty + 1; }
        i = i + 1;
    }
    Assert.Equal(lx.KeywordCount(), nonEmpty);
    Assert.Equal(lx.KeywordNameAt(0), lines[0]);
}
