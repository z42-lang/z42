// 模式 AST 节点（z42c.syntax）—— Rust 风格模式匹配核心（A1）。
// 三应用位点共用一套模式文法：switch 语句 case / switch 表达式 arm / is 表达式右侧。
// 受限写法：class 继承 + virtual Dump()（s-expression）。绑定用裸标识符（无 var）。
//
// 歧义消解（详见 docs/spec/changes/add-pattern-matching-core/design.md Decision 2）：
//   解析期按名字形状先分流（字面量→Constant / `_`→Wildcard / 名字→Name / `(`→Positional / `{`→Property）；
//   NamePattern 的「类型 vs 常量 vs 绑定」留 bind 期（PatternBinder）按类型表唯一定性。
namespace Z42.Syntax;

using Z42.Core;

public class Pattern {
    public Span Span;
    public virtual string Dump() { return "?pat"; }
}

// 通配 `_`：匹配任意、不绑定。仅出现在嵌套子模式位；顶层 switch 的 catch-all 仍走 default/`_`（hasPattern=false）。
public sealed class WildcardPattern : Pattern {
    public WildcardPattern(Span span) { this.Span = span; }
    public override string Dump() { return "_"; }
}

// 常量模式：字面量（1/"s"/'c'/true/null）或点分枚举/常量（Color.Red）。携原始 Expr，
// binder 走既有 _bindExpr、emit 走 Eq(subj, value) —— 保证与旧 switch 常量路径 byte-identical。
public sealed class ConstantPattern : Pattern {
    public Expr Value;
    public ConstantPattern(Expr value, Span span) { this.Span = span; this.Value = value; }
    public override string Dump() { return this.Value.Dump(); }
}

// 名字/类型模式：`T`（类型测试）/ `T x`（类型测试+绑定）/ 裸单名（绑定）/ 点分名（常量）。
// Bind==""：`T` / 裸名 / 点分名（三者由 bind 期定性）；Bind!=""：`T x`（显式类型+绑定，恒类型模式）。
public sealed class NamePattern : Pattern {
    public TypeExpr Type;
    public string   Bind;   // ""=无显式绑定名
    public NamePattern(TypeExpr type, string bind, Span span) { this.Span = span; this.Type = type; this.Bind = bind; }
    public override string Dump() {
        if (this.Bind.Length > 0) { return "(type " + this.Type.Dump() + " " + this.Bind + ")"; }
        return "(name " + this.Type.Dump() + ")";
    }
}

// 位置模式（record 解构）：T(p0, p1, ...) —— IsInstance(T) + 按主构造器声明序逐字段递归匹配子模式。
// 约束（PatternBinder 校验）：T 必须 IsRecord；子模式数 == record 字段数。
public sealed class PositionalPattern : Pattern {
    public TypeExpr  Type;
    public Pattern[] Elems;
    public int       ElemCount;
    public PositionalPattern(TypeExpr type, Pattern[] elems, int elemCount, Span span) { this.Span = span;
        this.Type = type; this.Elems = elems; this.ElemCount = elemCount;
    }
    public override string Dump() {
        string s = "(pos " + this.Type.Dump();
        int i = 0;
        while (i < this.ElemCount) { s = s + " " + this.Elems[i].Dump(); i = i + 1; }
        return s + ")";
    }
}

// 属性模式：T { F: p, ... } / { F: p, ... }（HasType=false 省略类型，仅按字段名匹配、不测类型）。
public sealed class PropertyPattern : Pattern {
    public TypeExpr  Type;         // HasType==false 时无效
    public bool      HasType;
    public string[]  FieldNames;
    public Pattern[] FieldPats;
    public int       FieldCount;
    public PropertyPattern(TypeExpr type, bool hasType, string[] names, Pattern[] pats, int count, Span span) { this.Span = span;
        this.Type = type; this.HasType = hasType; this.FieldNames = names; this.FieldPats = pats; this.FieldCount = count;
    }
    public override string Dump() {
        string s = "(prop";
        if (this.HasType) { s = s + " " + this.Type.Dump(); }
        int i = 0;
        while (i < this.FieldCount) { s = s + " " + this.FieldNames[i] + ":" + this.FieldPats[i].Dump(); i = i + 1; }
        return s + ")";
    }
}

// 元组模式（add-tuple-types）：`( p0, p1, ... )`（≥2 子模式）—— 按位解构 Std.ValueTupleN 的
// Item1..ItemN 字段，逐位递归匹配子模式。裸 `(` 起始（不带类型引导），区别于类型引导的位置模式 `T(...)`。
// binder 走独立 _bindTuple（subject 须为 ValueTupleN 实例化类型），不复用位置模式的 IsRecord 强制。
public sealed class TuplePattern : Pattern {
    public Pattern[] Elems;
    public int       Count;
    public TuplePattern(Pattern[] elems, int count, Span span) { this.Span = span; this.Elems = elems; this.Count = count; }
    public override string Dump() {
        string s = "(tuple-pat";
        int i = 0;
        while (i < this.Count) { s = s + " " + this.Elems[i].Dump(); i = i + 1; }
        return s + ")";
    }
}

// or-模式（A2）：P0 | P1 | ...，任一匹配即匹配。仅出现在 switch 臂（is 保持 `|` = 位或）。
// 约束（PatternBinder 校验）：子模式不得引入任何绑定（A2 defer 各 alt 绑定集一致性 + 合流 phi）。
public sealed class OrPattern : Pattern {
    public Pattern[] Alts;
    public int       Count;
    public OrPattern(Pattern[] alts, int count, Span span) { this.Span = span; this.Alts = alts; this.Count = count; }
    public override string Dump() {
        string s = "(or";
        int i = 0;
        while (i < this.Count) { s = s + " " + this.Alts[i].Dump(); i = i + 1; }
        return s + ")";
    }
}

// @ 绑定（A2）：name @ P —— 绑 name 到整个 subject 且 subject 须匹配子模式 P。子模式 Sub 不含顶层 or。
public sealed class AtPattern : Pattern {
    public string  Name;
    public Pattern Sub;
    public AtPattern(string name, Pattern sub, Span span) { this.Span = span; this.Name = name; this.Sub = sub; }
    public override string Dump() { return "(at " + this.Name + " " + this.Sub.Dump() + ")"; }
}

// 闭区间范围模式（A2）：lo ..= hi —— subj >= lo && subj <= hi（含端点）。Lo/Hi 为常量 Expr。
public sealed class RangePattern : Pattern {
    public Expr Lo;
    public Expr Hi;
    public RangePattern(Expr lo, Expr hi, Span span) { this.Span = span; this.Lo = lo; this.Hi = hi; }
    public override string Dump() { return "(range " + this.Lo.Dump() + " ..= " + this.Hi.Dump() + ")"; }
}

// 关系模式（A2）：> v / >= v / < v / <= v —— subj <op> v。Op = TokenKind（Gt/GtEq/Lt/LtEq）。V 为常量 Expr。
public sealed class RelationalPattern : Pattern {
    public int  Op;
    public Expr Value;
    public RelationalPattern(int op, Expr value, Span span) { this.Span = span; this.Op = op; this.Value = value; }
    public override string Dump() { return "(rel " + this.Op.ToString() + " " + this.Value.Dump() + ")"; }
}
