// 解析器（Pratt 表达式 + 递归下降语句）。z42c.syntax 自举 increment #2–#6a。
// 表达式：字面量/标识符/括号/一元 + 二元（优先级爬升，含位运算·??·is·as·复合赋值·三目·new）+ 后缀(. () [])。
// 语句：block / if / while / for / foreach / do-while / switch / try-catch-finally
//       / return / break / continue / throw / var-decl / expr-stmt。
// 声明：namespace / using / class·struct·interface（修饰符 + 基类/接口列表 + field/method/ctor/property）/ enum（成员 + 可选值）
//       / record（位置式 + 块体）/ delegate / 顶层自由 func（命名空间级，MethodDecl.IsFree）。
// 成员 property：auto `{ get; set; }`（含访问器修饰 + 初值）；自定义 body / 表达式体 / init-only 延后。
// 泛型：类型声明 + 方法 + delegate + record 的形参 `<T>`（文本捕获）+ `where T : ...` 约束（new()/class/struct/类型）。
// attribute：前置 `[X]`/`[X(args)]`/`[A][B]`（顶层 + 成员）→ AttributedDecl 包裹；args 为表达式。
// 类型：全部走 `_parseType()` 产 TypeExpr（incr 6d；含 >>/>>> 嵌套泛型拆分）；形参 `<T>`→TypeParamList、
//       where→WhereClause[]、catch 类型→TypeExpr（6d-3）。`_parseTypeText`/`_consumeAngles` 已移除。
// 延后：lambda；真实 Visitor（并入后端）；byte-identical。
namespace Z42.Syntax;

using Z42.Core;

public sealed class Parser {
    private Lexer _lx;
    private Token[] _toks;                 // = _lx.Tokens()，词法结束后固定不变（见 Lexer.Tokens 注释）
    private int   _tokN;                   // = _lx.TokenCount()，peek 的 Eof clamp 上界
    private int   _pos;
    public DiagnosticBag _diags;
    private bool  _lexMerged;              // lexer 诊断是否已并入 _diags（merge-once 守卫）
    public int   _pendingGt;
    public TypeParser _typeP;             // review P1-2：类型子解析器（mediator backref）
    public ExprParser _exprP;             // review P1-2：表达式子解析器
    public StmtParser _stmtP;             // review P1-2：语句子解析器
    public DeclParser _declP;             // review P1-2：声明子解析器
    public MemberParser _memberP;         // review P1-2：成员子解析器   // 嵌套泛型 `>>`/`>>>` 拆分：close 时若吃了 GtGt，余下的 `>` 记此
    public PatternParser _patP;           // 模式子解析器（Rust 风格模式匹配核心 A1）

    // attribute-handler-registry PR3c：`#suppress`/`#restore` 局部抑制收集。子解析器经 `this._p`
    // 引用共享同一累加器。_supRegions=已闭合区间；_supOpen*=开区间栈（LIFO 按 RuleId 配对）。收尾
    // `_finalizeSuppress` 把未闭合的延伸到 EOF 并挂到 CU。见 SuppressRegion / design PR3c 落地。
    public SuppressRegion[] _supRegions; public int _supCount;
    private string[] _supOpenIds; private int[] _supOpenStarts; private int _supOpenCount;

    public Parser(string src, string file) {
        this._lx = new Lexer(src, file);
        this._lx.Tokenize();
        this._toks = this._lx.Tokens();
        this._tokN = this._lx.TokenCount();
        this._pos = 0;
        this._pendingGt = 0;
        this._diags = new DiagnosticBag();
        this._lexMerged = false;
        this._typeP = new TypeParser(this);
        this._exprP = new ExprParser(this);
        this._stmtP = new StmtParser(this);
        this._declP = new DeclParser(this);
        this._memberP = new MemberParser(this);
        this._patP = new PatternParser(this);
        this._supRegions = new SuppressRegion[0]; this._supCount = 0;
        this._supOpenIds = new string[0]; this._supOpenStarts = new int[0]; this._supOpenCount = 0;
    }

    // ── PR3c 局部抑制指令 ────────────────────────────────────────────────────
    // `#suppress <Id> ["reason"]` / `#restore <Id>`。仅在语句列表 / 顶层声明列表边界调用（见 Hash token）。
    // 返回 true=消费了一条指令（调用方 continue）；false=`#` 后非 suppress/restore → 不动游标，
    // 留给正常错误路径（`#` 现无其它语义，孤立 Hash 仍报错，与既有行为一致）。
    public bool _tryParseSuppressDirective() {
        if (this._peek().Kind != TokenKind.Hash) { return false; }
        Token nx = this._peekAt(1);
        if (nx.Kind != TokenKind.Identifier) { return false; }
        if (nx.Text == "suppress") { this._parseSuppressOpen(); return true; }
        if (nx.Text == "restore")  { this._parseSuppressClose(); return true; }
        return false;
    }

    private void _parseSuppressOpen() {
        int start = this._peek().Span.Start;   // `#` 起点
        this._advance();   // #
        this._advance();   // suppress
        string id = this._parseSuppressRuleId();
        if (this._peek().Kind == TokenKind.StringLiteral) { this._advance(); }   // 可选 reason，接受即弃
        if (this._supOpenCount == this._supOpenIds.Length) {
            int cap = this._supOpenIds.Length * 2; if (cap == 0) { cap = 4; }
            string[] ni = new string[cap]; int[] nst = new int[cap];
            Array.Copy(this._supOpenIds, ni, this._supOpenCount); Array.Copy(this._supOpenStarts, nst, this._supOpenCount);
            this._supOpenIds = ni; this._supOpenStarts = nst;
        }
        this._supOpenIds[this._supOpenCount] = id;
        this._supOpenStarts[this._supOpenCount] = start;
        this._supOpenCount = this._supOpenCount + 1;
    }

    private void _parseSuppressClose() {
        int end = this._peek().Span.Start;   // `#restore` 起点 = 抑制区排他上界
        this._advance();   // #
        this._advance();   // restore
        string id = this._parseSuppressRuleId();
        // 弹出同 Id 最近开区间（LIFO），定型 [openStart, end)。无匹配 → 宽松忽略（无诊断，同 C# pragma restore）。
        int j = this._supOpenCount - 1;
        while (j >= 0) {
            if (this._supOpenIds[j] == id) {
                this._addSuppressRegion(id, this._supOpenStarts[j], end);
                int k = j;
                while (k < this._supOpenCount - 1) {
                    this._supOpenIds[k] = this._supOpenIds[k + 1];
                    this._supOpenStarts[k] = this._supOpenStarts[k + 1];
                    k = k + 1;
                }
                this._supOpenCount = this._supOpenCount - 1;
                return;
            }
            j = j - 1;
        }
    }

    // RuleId = 单个标识符（如 Z9002）；缺失 → 诊断 + 返回空串（抑制退化为无效，安全）。
    private string _parseSuppressRuleId() {
        if (this._peek().Kind == TokenKind.Identifier) {
            string id = this._peek().Text; this._advance(); return id;
        }
        this._diags.Error(DiagnosticCodes.ExpectedToken, "expected rule id after #suppress/#restore", this._peek().Span);
        return "";
    }

    private void _addSuppressRegion(string id, int start, int end) {
        if (this._supCount == this._supRegions.Length) {
            int cap = this._supRegions.Length * 2; if (cap == 0) { cap = 4; }
            SuppressRegion[] nr = new SuppressRegion[cap];
            Array.Copy(this._supRegions, nr, this._supCount);
            this._supRegions = nr;
        }
        this._supRegions[this._supCount] = new SuppressRegion(id, start, end);
        this._supCount = this._supCount + 1;
    }

    // 收尾：未闭合的开区间延伸到 cuEnd（EOF）；把收集区间挂到 CU。ParseCompilationUnit 末尾调用。
    public void _finalizeSuppress(CompilationUnit cu, int cuEnd) {
        int j = 0;
        while (j < this._supOpenCount) {
            this._addSuppressRegion(this._supOpenIds[j], this._supOpenStarts[j], cuEnd);
            j = j + 1;
        }
        this._supOpenCount = 0;
        cu.SuppressRegions = this._supRegions;
        cu.SuppressRegionCount = this._supCount;
    }

    // 已 lex 的 token 流（add-file-level-incremental D8 性能修正，User 追认 2026-07-08）：
    // parse 时顺手捕获标识符集（增量失效边输入），消编排层的第二遍 lex。只读访问。
    public Lexer Tokens() { return this._lx; }

    public DiagnosticBag Diagnostics() { this._ensureLexDiagsMerged(); return this._diags; }

    // 把 Lexer 诊断（E0101/E0102/E0103）并入 _diags，一次性（fix-lexer-diags-dropped）。
    // 时机：parse 收尾 / 首次外部读诊断——晚于 parse 期的 incomplete 判定（那用 _diags 字段直读，
    // 不经本访问器），故不影响 REPL 续行；只把 lexer 错补进最终 bag 供下游上浮。
    private void _ensureLexDiagsMerged() {
        if (this._lexMerged) { return; }
        this._lexMerged = true;
        this._diags.MergeFrom(this._lx.Diagnostics());
    }

    // ── token 游标 ──────────────────────────────────────────────────────────
    // 热路径（profile：_peekAt self 4.22% + _peek 1.14%）——原来每次 peek 都要
    // `_lx.TokenCount()` + `_lx.TokenAt(i)` 两次 z42 方法调用（各一个帧），现在直接走缓存数组。
    public Token _peek()       { int i = this._pos; if (i >= this._tokN) { i = this._tokN - 1; } return this._toks[i]; }
    public Token _peekAt(int o) {
        int i = this._pos + o;
        if (i >= this._tokN) { i = this._tokN - 1; }   // clamp 到 Eof
        return this._toks[i];
    }
    public void _advance() { this._pos = this._pos + 1; }

    // 游标快照 / 回滚——speculative 解析（泛型调用 `名<T>(` 歧义消解）失败时回退。
    public int  _mark()          { return this._pos; }
    public void _reset(int m)    { this._pos = m; }

    internal void _expect(int kind, string what) {
        if (this._peek().Kind == kind) { this._advance(); return; }
        // 当前 token 已是 EOF → 不是写错了，是没写完（缺闭合符 / 正文 / 分号）。标记可恢复不完整，
        // 供 REPL 完整性探针续读（add-repl-parser-completeness）。判据是「当前 == Eof」而非具体
        // 缺什么——void foo() 缺的是 ';'、class B 缺的是 '{'，统一在此归一。
        if (this._peek().Kind == TokenKind.Eof) {
            // 仅当此前没有真语法错时，EOF 缺 token 才算「没写完」（首错就在 EOF）。若前面已有错误
            // （真语法错、解析恢复后才走到 EOF），不置 incomplete——那是真错，交求值正常报错，
            // 不能误判为「续读」（否则 `class 1` 这类真错会被 REPL 当没写完而挂起等续行）。
            if (!this._diags.HasErrors()) { this._diags.MarkIncompleteAtEof(); }
            this._diags.Error(DiagnosticCodes.UnexpectedEof, "unexpected end of input, expected '" + what + "'", this._peek().Span);
        } else {
            this._diags.Error(DiagnosticCodes.ExpectedToken, "expected '" + what + "'", this._peek().Span);
        }
    }
    // 分号单独处理（不走 _expect）：缺 `;` 于 EOF 置 _incompleteSemiAtEof（而非 _incompleteAtEof），
    // 因为「缺 ;」的续读语义按入口不同——声明入口 `void foo()` 要续读，表达式入口 REPL 的 `42` 不要。
    // 由 Completeness 按入口取舍（见 Completeness.z42）。
    public void _expectSemi() {
        if (this._peek().Kind == TokenKind.Semicolon) { this._advance(); return; }
        if (this._peek().Kind == TokenKind.Eof) {
            if (!this._diags.HasErrors()) { this._diags.MarkIncompleteSemiAtEof(); }
            this._diags.Error(DiagnosticCodes.UnexpectedEof, "unexpected end of input, expected ';'", this._peek().Span);
        } else {
            this._diags.Error(DiagnosticCodes.ExpectedToken, "expected ';'", this._peek().Span);
        }
    }

    // 名字 / 操作数位置的报错：当前 token 是 EOF → 记可恢复不完整（没写完），否则报给定诊断。
    // 与 _expect 对称，覆盖非「期待固定 token」的缺失点（如 class 缺名、表达式缺操作数）。
    public void _errorOrIncomplete(string code, string message) {
        if (this._peek().Kind == TokenKind.Eof) {
            // 同 _expect：仅首错在 EOF 才算「没写完」（前面已有真错则不置，见 _expect 注释）。
            if (!this._diags.HasErrors()) { this._diags.MarkIncompleteAtEof(); }
            this._diags.Error(DiagnosticCodes.UnexpectedEof, "unexpected end of input (" + message + ")", this._peek().Span);
        } else {
            this._diags.Error(code, message, this._peek().Span);
        }
    }

    // ════ 表达式 ════════════════════════════════════════════════════════════
    public Expr ParseExpression() { return this._exprP._parseExpr(0); }






    // ════ 语句 ══════════════════════════════════════════════════════════════
    // 错误恢复：跳过到（含）下一个 `;`，或在 `}` / EOF 前停下。让一条错误只报一次，
    // 后续语句仍能正常解析。
    void _skipToSemicolon() {
        while (this._peek().Kind != TokenKind.Semicolon
            && this._peek().Kind != TokenKind.RBrace
            && this._peek().Kind != TokenKind.Eof) {
            this._advance();
        }
        if (this._peek().Kind == TokenKind.Semicolon) { this._advance(); }
    }

    public Stmt ParseStatement() {
        Token st = this._peek();
        int k = st.Kind;
        // `using` / `global using` / `namespace` 只能出现在文件顶部。语言本来就不接受它们
        // 出现在语句位置，但此前是一路级联出 4 条互不相关的错误（"unexpected token in
        // expression" → "expected ';'" → 两条 "undefined"），没有一条说得出真正原因，
        // 写错的人得自己猜。这里在唯一的语句分发点截住，给一条说清楚的诊断并跳到
        // 分号恢复（后续语句照常解析，不再连锁误报）。
        if (k == TokenKind.Using || k == TokenKind.Namespace
            || (k == TokenKind.Identifier && st.Text == "global"
                && this._peekAt(1).Kind == TokenKind.Using)) {
            string what = (k == TokenKind.Namespace) ? "namespace" : "using";
            this._diags.Error(DiagnosticCodes.DeclarationInStatement,
                "`" + what + "` may only appear at the top of a file, before any type or function"
                + " — move it above the enclosing declaration",
                st.Span);
            this._skipToSemicolon();
            return new ExprStmt(new NullLitExpr(st.Span), st.Span);
        }
        if (k == TokenKind.LBrace)  {
            // 属性形态解构声明 `{ X: x } = e;`（省类型）须先于块语句判别——配平 `}` 后见 `=` 才是解构声明，
            // 否则是普通块（块不作 lvalue、后不跟 `=`，无歧义）。complete-pattern-engine 特性 1。
            if (this._stmtP._isDeconstructDeclStart()) { return this._stmtP._parseDeconstructDecl(); }
            return this._stmtP._parseBlock();
        }
        if (k == TokenKind.Return)  { return this._stmtP._parseReturn(); }
        if (k == TokenKind.If)      { return this._stmtP._parseIf(); }
        if (k == TokenKind.While)   { return this._stmtP._parseWhile(); }
        if (k == TokenKind.For)     { return this._stmtP._parseFor(); }
        if (k == TokenKind.Foreach) { return this._stmtP._parseForeach(); }
        if (k == TokenKind.Do)      { return this._stmtP._parseDoWhile(); }
        if (k == TokenKind.Switch)  { return this._stmtP._parseSwitch(); }
        if (k == TokenKind.Try)     { return this._stmtP._parseTry(); }
        if (k == TokenKind.Break)   { this._advance(); this._expectSemi(); return new BreakStmt(st.Span); }
        if (k == TokenKind.Continue){ this._advance(); this._expectSemi(); return new ContinueStmt(st.Span); }
        if (k == TokenKind.Throw)   { this._advance(); Expr te = this._exprP._parseExpr(0); this._expectSemi(); return new ThrowStmt(te, st.Span); }
        if (this._stmtP._isLocalFnStart()) { return this._stmtP._parseLocalFn(); }   // impl-local-fn-l2：先于 var-decl 判别
        if (this._stmtP._isVarDeclStart()) { return this._stmtP._parseVarDecl(); }
        if (this._stmtP._isDeconstructDeclStart()) { return this._stmtP._parseDeconstructDecl(); }   // 模式匹配 B：`T(x,y) = e;`
        Expr e = this._exprP._parseExpr(0);
        this._expectSemi();
        return new ExprStmt(e, st.Span);
    }


    // for (init; cond; incr) body —— 三段任意可省。init 走 ParseStatement（消费自身 ';'）。

    // do body while (cond);

    // switch (subj) { case p: stmts...  default: stmts... }

    // try {} catch (Type v) {} catch {} finally {} —— 类型/变量名均可省。





    // var x = e;  /  int x = e;  /  Foo x = e;

    // 局部函数起始判别（impl-local-fn-l2）：跳过返回类型表达式后紧跟 `Identifier (`。
    // 区别于 var-decl（`type ident =/;`）与调用（`ident(` / `obj.m(`）。

    // 从 offset start 跳过一个类型表达式，返回其后的 offset（-1 = 非类型）。
    // 处理：类型关键字 / 标识符类型 + 可选泛型 `<...>` + 点路径 `.Ident` + 数组 `[]`。

    // 解析局部函数语句（已确认 _isLocalFnStart）：type + name + 方法尾（params + body）→ LocalFunctionStmt。


    public bool _isTypeKeyword(int k) {
        if (k == TokenKind.String || k == TokenKind.Int || k == TokenKind.Long || k == TokenKind.Short) { return true; }
        if (k == TokenKind.Double || k == TokenKind.Float || k == TokenKind.Byte || k == TokenKind.Bool) { return true; }
        if (k == TokenKind.Char || k == TokenKind.Void || k == TokenKind.Object) { return true; }
        if (k == TokenKind.Uint || k == TokenKind.Ulong || k == TokenKind.Ushort || k == TokenKind.Sbyte) { return true; }
        if (k == TokenKind.I8 || k == TokenKind.I16 || k == TokenKind.I32 || k == TokenKind.I64) { return true; }
        if (k == TokenKind.U8 || k == TokenKind.U16 || k == TokenKind.U32 || k == TokenKind.U64) { return true; }
        if (k == TokenKind.F32 || k == TokenKind.F64) { return true; }
        return false;
    }

    // ════ 顶层声明 ══════════════════════════════════════════════════════════
    public CompilationUnit ParseCompilationUnit() {
        Span cusp = this._peek().Span;
        bool hasNs = false;
        string ns = "";
        Decl[] decls = new Decl[16];
        int n = 0;
        while (this._peek().Kind != TokenKind.Eof) {
            int k = this._peek().Kind;
            // PR3c：顶层声明列表边界的 `#suppress`/`#restore`（可圈定整个顶层声明）。非指令的 `#` 落回错误路径。
            if (k == TokenKind.Hash) {
                if (this._tryParseSuppressDirective()) { continue; }
            }
            if (k == TokenKind.Namespace) {
                this._advance(); ns = this._declP._parseQualifiedName(); hasNs = true; this._expectSemi();
                continue;
            }
            // add-global-using：`global`（上下文 token，非关键字）+ `using` → 包级 using。
            // 置于普通 using 判定前——`global` 是 Identifier，仅在紧跟 `using` 时特判。
            if (k == TokenKind.Identifier && this._peek().Text == "global" && this._peekAt(1).Kind == TokenKind.Using) {
                Span gsp = this._peek().Span;
                this._advance();   // global
                this._advance();   // using
                string gn = this._declP._parseQualifiedName(); this._expectSemi();
                UsingDecl gu = new UsingDecl(gn, gsp); gu.IsGlobal = true;
                decls = this._declP._growDecls(decls, n); decls[n] = gu; n = n + 1;
                continue;
            }
            if (k == TokenKind.Using) {
                Span usp = this._peek().Span;
                this._advance();
                // add-type-alias：`using Id = Type;`——`using` 后 Identifier 紧跟 `=` → 类型别名。
                if (this._peek().Kind == TokenKind.Identifier && this._peekAt(1).Kind == TokenKind.Eq) {
                    Token an = this._peek();
                    this._advance();   // Id
                    this._advance();   // =
                    TypeExpr at = this._typeP._parseType();
                    this._expectSemi();
                    decls = this._declP._growDecls(decls, n); decls[n] = new UsingAliasDecl(an.Text, at, usp); n = n + 1;
                    continue;
                }
                string un = this._declP._parseQualifiedName(); this._expectSemi();
                decls = this._declP._growDecls(decls, n); decls[n] = new UsingDecl(un, usp); n = n + 1;
                continue;
            }
            AttrList attrs = this._declP._parseAttributes();
            string mods = this._declP._parseModifiers();
            int dk = this._peek().Kind;
            // complete-class-access-control ③：顶层声明（模块作用域）不得标 private/protected——
            // 默认 internal，private/protected 在模块层无意义。嵌套类型/成员经 MemberParser 不走此路径。
            // 覆盖 class/struct/interface/enum/delegate/顶层函数（impl 无可见性，排除）。
            if (dk == TokenKind.Class || dk == TokenKind.Struct || dk == TokenKind.Interface
                || dk == TokenKind.Enum || dk == TokenKind.Delegate
                || this._isTypeKeyword(dk) || dk == TokenKind.Identifier || dk == TokenKind.LParen) {
                if (this._declP._modsHas(mods, "private") || this._declP._modsHas(mods, "protected")) {
                    this._diags.Error(DiagnosticCodes.TopLevelAccessModifier,
                        "top-level declaration cannot be private or protected (use internal or public)", this._peek().Span);
                }
            }
            Decl d = new UsingDecl("<error>", this._peek().Span);
            bool ok = true;
            if (dk == TokenKind.Class || dk == TokenKind.Struct || dk == TokenKind.Interface) {
                string kind = "class";
                if (dk == TokenKind.Struct) { kind = "struct"; }
                else if (dk == TokenKind.Interface) { kind = "interface"; }
                d = this._declP._parseTypeDecl(mods, kind, attrs);   // add-record-attribute：传 attrs 供位置参数就地判 [Record]
            } else if (dk == TokenKind.Impl) {
                d = this._declP._parseImplDecl(mods);
            } else if (dk == TokenKind.Enum) {
                d = this._declP._parseEnum(mods);
            } else if (dk == TokenKind.Delegate) {
                d = this._declP._parseDelegate(mods);
            } else if (this._isTypeKeyword(dk) || dk == TokenKind.Identifier || dk == TokenKind.LParen) {
                // 顶层自由函数：Type Name(params) { body }（Type 可为元组类型 `(int,string) f()` 或函数类型返回）
                d = this._declP._parseTopLevelFunc(mods);
            } else {
                this._diags.Error(DiagnosticCodes.UnexpectedToken, "expected declaration (class/struct/interface/enum/delegate/func)", this._peek().Span);
                this._advance();
                ok = false;
            }
            if (ok) {
                if (attrs.Count > 0) { d = new AttributedDecl(attrs.Items, attrs.Count, d, d.Span); }
                decls = this._declP._growDecls(decls, n); decls[n] = d; n = n + 1;
            }
        }
        int cuEnd = this._peek().Span.End;   // Eof 位置 = 未闭合抑制区的排他上界
        CompilationUnit cu = new CompilationUnit(hasNs, ns, decls, n, cusp);
        this._finalizeSuppress(cu, cuEnd);   // PR3c：未闭合 `#suppress` 延伸到 EOF，挂区间到 CU
        // fix-lexer-diags-dropped：并入 lexer 诊断（收尾，晚于 incomplete 判定）。
        this._ensureLexDiagsMerged();
        // fix-parse-diags-dropped：把 parse 诊断挂上 CU，供下游 typecheck 汇点合并上浮。
        cu.ParseDiags = this._diags;
        return cu;
    }



    // 前置 attribute：连续的 `[ Name [(args)] [, Name2 ...] ]` 组（args 为表达式，命名参数即 AssignExpr）。
    // 仅在声明/成员起始位置调用（此处 `[` 不会与索引/数组类型歧义）。



    // mods 串（空格分隔）是否含指定修饰词。

    // class / struct / interface 共用：消费关键字 + 名字 + 基类/接口列表 + 成员块。
    // 三者结构同构（仅 Kind 不同）；语义差异（struct 值类型、interface 仅签名）留给后端。

    // event 字段类型是否多播（MulticastAction/Func/Predicate）→ 走 Subscribe/Unsubscribe 访问器合成。

    // 合成单个 event 访问器（add_X / remove_X），multicast（镜像 C# SynthesizeClassEvent）：
    //   add_X(h): IDisposable { return this.X.Subscribe(h); }
    //   remove_X(h): void     { this.X.Unsubscribe(h); }
    // hasBody=false（interface）→ 仅签名。handler 类型 = Action/Func/Predicate<同型参>。

    // event 字段类型是否单播（Action/Func/Predicate）。

    // 合成单播 event 访问器（D-7，镜像 C# SynthesizeClassEvent 单播分支）：
    //   add_X(h): IDisposable {
    //     if (this.X != null) throw new InvalidOperationException("single-cast event already bound");
    //     this.X = h; return Disposable.From(() => this.remove_X(h));
    //   }
    //   remove_X(h): void { if (DelegateOps.ReferenceEquals(this.X, h)) this.X = null; }
    // handler 类型 = 字段裸类型（Action<T> 自身）。hasBody=false（interface）→ 仅签名。

    // impl <Trait> for <Target> { methods }  —— 跨包 trait 实现（port-z42c-impl-block）。
    // 镜像 C# ParseImplDecl：消费 impl → trait 类型 → for → target 类型 → 成员块（方法）。
    // 方法经 _parseMember（owner = target 简名）解析；extern 校验留给 semantics。

    // enum Color [: int] { Red, Green = 5, Blue }  —— 成员 name [= [-]int]；值仅捕获文本，自增/校验留给后端。

    // delegate R Name<T>(params) where ...;

    // 顶层自由函数：retType Name<T>(params) where ... { body }（命名空间级，无 this）。

    // [Record] class/struct Name<T> [(pos params)] [: base] [where ...] { members }  /  [Record] class Name(...) ;
    //   （`record` 关键字已删——位置参数由 _parseTypeDecl 就地展开，[Record]→public 字段 / 无→private）



    // 索引器 `T this[params] { get { body } set { body } }`（GS5）。
    // 下游 SymbolCollector/TypeChecker/IrGen/ExportedTypeExtractor 暂跳过——仅防 parse 崩溃。

    // auto-property `{ [vis]? get; [ [vis]? set; ] }` [= init;]。get/set 为上下文标识符（非关键字）。


    // 参数列表 `( T a, T b )`（消费两端括号）。method/ctor/func/delegate/record 位置参数共用。

    // 基类/接口列表 `: A, B, C`（假定 peek==Colon）。

    // ctor 占位返回类型（永不 Dump）。
    // 运算符符号 → 重载方法名（镜像 C#：op_Add/op_Subtract/op_Multiply/op_Divide/op_Modulo）。


    // method / ctor / 顶层 func 尾部：参数列表 + 可选 where + body（`{}`）或无体（`;`）。


    // 类型形参声明 `<T>` / `<K, V>`（仅名字，单层；closing 单 `>`）。无 → 空 TypeParamList。

    // where 子句：`where T : C1, C2 [where U : ...]`（可多段）。约束含类型 / new() / class / struct。


    // 结构化类型（incr 6d）：限定名 + 泛型 <...>（递归，含 >>/>>> 拆分）+ 数组 [] + nullable ?。

    // 函数类型 `(T1, T2, ...) -> R`。调用时 peek 在 `(`。

    // 消费一个类型实参闭合 `>`：优先用 pending（来自上层 GtGt 拆分），否则吃 Gt，或把 GtGt 拆成两个 `>`。


    // lambda 检测：单 IDENT => 或括号组后随 =>（有限 lookahead 扫平衡括号）。

    // lambda 解析（镜像 C# ParseLambda）：参数（可带类型）→ => → 表达式体（BpAssign-1 级）或块体。

    // char 字面量解码（镜像 C# UnescapeChar）：剥引号 → 复用 Lexer.DecodeString 还原转义 → 取首字符。
    // GS4：$"...{expr}..." → InterpolatedStringExpr。
    // 算法：逐字扫描 token body（剥 $" 前缀 + " 后缀）；
    //   文本段：处理 \n/\t/\r/\\/\" 转义 + {{/}} 字面；
    //   {expr} 洞：深度追踪定位 closing }，子 Parser 解析内部 expr。
    // 镜像 C# ExprParser.Atoms.ParseInterpolatedString 逻辑。

}
