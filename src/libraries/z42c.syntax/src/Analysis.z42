// attribute-handler-registry PR3a —— Analyzer 契约（编译期诊断分析框架的公共 API 面）。
//
// 放在 z42c.syntax（AST 所在处、被 z42c.semantics 依赖）——对齐 Roslyn：analyzer 包依赖编译器的
// 语法 API（Microsoft.CodeAnalysis），而非纯运行时库（stdlib 不能反依赖编译器）。外部 analyzer
// zpkg 经 [dependencies] 依赖 z42c.syntax + z42c.core 来编写，用 z42.toml `[analyzers]` 段声明被
// 编译器加载执行（D9：独立编译期 zpkg 类别，编译期运行、不链入目标程序、不入消费产物）。设计 SoT：
// docs/spec/changes/attribute-handler-registry/design.md §Analyzer 接口 / §Decisions D8·D9。
//
// 契约 = 纯抽象 + 数据：Analyzer / DiagSink 是接口（驱动在 z42c.semantics 提供具体实现）；DiagRule
// 是数据类；SyntaxKind / AnalyzerSeverity 是 int 常量（z42 无 enum → static class + int，同 TokenKind）。
// PR3a 只落 OnSyntaxNode（语法相位，无需语义模型）；OnSymbol / OnOperation / OnBody / OnReference /
// OnIrOp 等观察面按 design 观察面表后续增量扩（各加一个 Observed*Kinds() + On*() 对）。类名须以
// `Analyzer` 结尾（D8，E0445 强制，见 SymbolCollector._passAnalyzerSuffixEnforce）。
//
// ⚠️ 契约形态偏离设计的 Roslyn `Register(ctx)` + `ctx.OnSyntaxNode(kind, lambda)` 回调注册模型，改用
// **无 delegate 的 visitor 模型**（ObservedKinds() 声明观察面 + OnSyntaxNode() 逐节点回调）。原因：
// z42 自举编译器**刻意规避 delegate**（BinaryTypeTable 用 int tag 替 Func<>），且**命名 delegate 跨
// zpkg 丢失 FQ 名**（Bound.z42/ExprEmitter.z42：delegate 塌成结构化 Z42FuncType）→ 契约里的命名
// delegate 无法跨包解析。visitor 模型全走接口派发（跨包已验证）+ 纯虚调用，driver 侧零 delegate/零闭包，
// analyzer 侧也无需 lambda。design.md 已同步此偏离（§Analyzer 接口 决策注）。
namespace Z42.Syntax;

using Z42.Core;   // Span

// analyzer 观察的语法节点种类。PR3a 起步覆盖用得上的子集，按需扩（对应 AST 节点类；驱动遍历 AST 时
// 把每个节点映射到这些 kind 再分派）。值稳定、只增不改（外部 analyzer 按名引用）。
public static class SyntaxKind {
    public static int CatchClause  = 1;   // Stmt.z42 CatchClause —— 空 catch 吞异常 lint 等
    public static int TryCatchStmt = 2;   // Stmt.z42 TryCatchStmt
    public static int ClassDecl    = 3;   // Decl.z42 ClassDecl —— 命名规范等
    public static int MethodDecl   = 4;   // Decl.z42 MethodDecl
    public static int WhileStmt    = 5;   // Stmt.z42 WhileStmt
    public static int ForStmt      = 6;   // Stmt.z42 ForStmt
}

// 诊断严重级（对齐 Roslyn 四级；是 z42c.core DiagnosticSeverity 的超集——多一个 Hidden 供 --fix）。
public static class AnalyzerSeverity {
    public static int Hidden  = 0;   // 不显示，仅供 --fix 消费（design）
    public static int Info    = 1;   // 建议
    public static int Warning = 2;
    public static int Error   = 3;   // 编译失败
}

// 一条可诊断规则的声明——analyzer 声明它能发哪些规则（供 config 枚举 / severity 解析，PR3b [lints]）。
public sealed class DiagRule {
    public string Id;                // 如 "Z9002"
    public string Title;
    public string MessageFormat;
    public string Category;          // 如 "Correctness"
    public int DefaultSeverity;      // AnalyzerSeverity.*
    public bool EnabledByDefault;

    public DiagRule(string id, string title, string messageFormat, string category, int defaultSeverity, bool enabledByDefault) {
        this.Id = id;
        this.Title = title;
        this.MessageFormat = messageFormat;
        this.Category = category;
        this.DefaultSeverity = defaultSeverity;
        this.EnabledByDefault = enabledByDefault;
    }
}

// analyzer 报告诊断的接收口。驱动（z42c.semantics）实现它，把 Report 映射进编译器 DiagnosticBag
// （按规则默认级 + 将来 [lints] 覆盖决定最终 severity；PR3b）。
public interface DiagSink {
    void Report(DiagRule rule, Span at);
}

// analyzer 契约（visitor 模型，无 delegate——见文件头注偏离说明）。实现接口即声明 kind（无 marker，
// 靠接口发现，D6）；类名须以 `Analyzer` 结尾（D8，E0445）。
//   · SupportedRules() —— 声明能发哪些规则（config / 工具枚举，PR3b [lints]）。
//   · ObservedKinds()  —— 声明观察哪些 SyntaxKind（driver 只对命中的节点回调，省无关派发）。
//   · OnSyntaxNode()   —— driver 对每个命中节点调用；analyzer 内按 kind 分派 + as-cast node + 报告诊断。
public interface Analyzer {
    DiagRule[] SupportedRules();
    int[] ObservedKinds();
    void OnSyntaxNode(int kind, object node, DiagSink diags);
}

// ─── 代码修复契约（attribute-handler-registry PR7，D4「同套 splice」）─────────────────────────
//
// C# 把 analyzer（报诊断）和 CodeFixProvider（产修复，仅 IDE）拆成两个类型；z42 **统一**成一套
// （design.md D4：C# 局限「分析器/修复拆两类型，修复仅 IDE」→ z42「同套 splice，`--fix` build 期应用」）。
// analyzer 在同一个 `OnSyntaxNode` 回调里、命中问题时把诊断与修复**一起**报出去——回调里本就握着
// AST 节点，产修复零额外定位成本。第三方 analyzer zpkg 经 `[analyzers]` 加载，**分析+修复捆绑**一同
// 扩展（谁报诊断谁产修复，满足 litmus B 第三方可扩展）。
//
// **staged-bootstrap（PR4e/PR4e-wire 同款，bootstrap-seed.md 轴②/③）**：本文件（z42c.syntax）新增的
// TextEdit/CodeFix/FixSink 被 z42c.semantics 消费 = syntax→semantics 新跨成员符号，post-F2 冷启动
// stale-cache 单 PR 过不了（[[two-gen-bootstrap-regressed-blocks-format-bumps]]，无 sentinel 逃生通道）。
// 故分两阶段：
//   · **PR7-support（本 PR）**：只把契约类型登记进 z42c.syntax（纯 additive，**无任何 in-tree 消费**）→
//     随 nightly 发布进种子。同时预置 F2-安全的接线桩（AnalyzerDriver.Run 的 `bool fix` 重载体空转、
//     CompileInputs.Fix 未接），使 wire 阶段零新跨成员符号。byte-identical、零格式-bump。
//   · **PR7-wire（下个 nightly）**：DiagSinkImpl 实现 FixSink 收集编辑；`z42c build --fix` 就地重写源文件；
//     内建可修复规则 + 跨包 golden（第三方 analyzer 携修复）。
//
// analyzer 用法（下转到 FixSink；host 无 --fix 能力时优雅回落到纯 Report）：
//   void OnSyntaxNode(int kind, object node, DiagSink diags) {
//       if (/* 命中问题 */) {
//           if (diags is FixSink) { (diags as FixSink).ReportFix(rule, span, myFix); }
//           else { diags.Report(rule, span); }
//       }
//   }

// 一处源码替换：把 `At`（Span）覆盖的字节区间 [At.Start, At.End) 替换成 `NewText`。Span 自带 `File`
// 定位到源文件、`Start`/`End` 是字节偏移 → 应用侧（PR7-wire）无需额外传路径。
public sealed class TextEdit {
    public Span At;
    public string NewText;
    public TextEdit(Span at, string newText) { this.At = at; this.NewText = newText; }
}

// 一条诊断对应的命名修复 = 一组有序编辑（通常 1 条）。`Title` 是人读的动作名（如 "补 null 检查"）。
public sealed class CodeFix {
    public string Title;
    public TextEdit[] Edits;
    public int EditCount;
    public CodeFix(string title, TextEdit[] edits, int editCount) {
        this.Title = title; this.Edits = edits; this.EditCount = editCount;
    }
}

// 可选的“带修复”接收口——与 DiagSink **分离**（analyzer 下转到它），使 PR7-support 能纯 additive 加它、
// 既有 DiagSink/Analyzer/DiagSinkImpl 逐字节不动（无 syntax→semantics 新消费 → 冷启动安全）。
// `ReportFix` 语义 = 报诊断（等同 DiagSink.Report）**并**附带修复；`--fix` 激活时（PR7-wire）应用编辑。
public interface FixSink {
    void ReportFix(DiagRule rule, Span at, CodeFix fix);
}
