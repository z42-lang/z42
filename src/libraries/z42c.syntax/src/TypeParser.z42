// 类型子解析器（compiler-review P1-2：拆 Parser God-Class）。
// 持 Parser 反向引用 _p（mediator）：游标原语 _p._peek/_advance/_expect、共享 _p._pendingGt/_diags；
// 跨界 _p._parseExpr（表达式）/_p._parseParamList/_p._parseBlock（声明/语句）。同组互调仍 this._X。
namespace Z42.Syntax;

using Z42.Core;

public sealed class TypeParser {
    private Parser _p;
    public TypeParser(Parser p) { this._p = p; }

    internal TypeExpr _emptyType() { return new NamedType("", new TypeExpr[0], 0, this._p._peek().Span); }

    internal TypeParamList _emptyTypeParams() { return new TypeParamList(new string[0], 0, this._p._peek().Span); }

    internal TypeParamList _parseTypeParams() {
        Span sp = this._p._peek().Span;
        string[] names = new string[4];
        int n = 0;
        if (this._p._peek().Kind == TokenKind.Lt) {
            this._p._advance();   // <
            if (this._p._peek().Kind != TokenKind.Gt) {
                while (true) {
                    string nm = this._p._peek().Text;
                    if (this._p._peek().Kind == TokenKind.Identifier) { this._p._advance(); }
                    else { this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected type-param name", this._p._peek().Span); this._p._advance(); }
                    if (n == names.Length) {
                        string[] b = new string[names.Length * 2];
                        Array.Copy(names, b, n);
                        names = b;
                    }
                    names[n] = nm; n = n + 1;
                    if (this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); } else { break; }
                }
            }
            this._p._expect(TokenKind.Gt, ">");
        }
        return new TypeParamList(names, n, sp);
    }

    internal WhereList _parseWhereClause() {
        Span sp = this._p._peek().Span;
        WhereClause[] items = new WhereClause[4];
        int n = 0;
        while (this._p._peek().Kind == TokenKind.Where) {
            Span wsp = this._p._peek().Span;
            this._p._advance();
            string tp = this._p._peek().Text;
            if (this._p._peek().Kind == TokenKind.Identifier) { this._p._advance(); }
            else { this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected type-param name after 'where'", this._p._peek().Span); }
            this._p._expect(TokenKind.Colon, ":");
            WhereConstraint[] cons = new WhereConstraint[4];
            int cn = 0;
            cons[0] = this._parseConstraint(); cn = 1;
            while (this._p._peek().Kind == TokenKind.Plus) {    // z42 用 + 分隔多约束（Rust 风格，见 docs/design/language/generics.md）
                this._p._advance();
                if (cn == cons.Length) {
                    WhereConstraint[] b = new WhereConstraint[cons.Length * 2];
                    Array.Copy(cons, b, cn);
                    cons = b;
                }
                cons[cn] = this._parseConstraint(); cn = cn + 1;
            }
            if (n == items.Length) {
                WhereClause[] b = new WhereClause[items.Length * 2];
                Array.Copy(items, b, n);
                items = b;
            }
            items[n] = new WhereClause(tp, cons, cn, wsp); n = n + 1;
        }
        return new WhereList(items, n, sp);
    }

    private WhereConstraint _parseConstraint() {
        Span sp = this._p._peek().Span;
        int k = this._p._peek().Kind;
        if (k == TokenKind.New) {
            this._p._advance();
            this._p._expect(TokenKind.LParen, "(");
            this._p._expect(TokenKind.RParen, ")");
            return new WhereConstraint(false, this._emptyType(), "new()", sp);
        }
        if (k == TokenKind.Class)  { this._p._advance(); return new WhereConstraint(false, this._emptyType(), "class", sp); }
        if (k == TokenKind.Struct) { this._p._advance(); return new WhereConstraint(false, this._emptyType(), "struct", sp); }
        // `where T : enum`——此前**没有**这个特判，`enum` 落进下面的 `_parseType()` 兜底变成
        // `NamedType("enum")`，语义层查不到同名类/接口 → 整条静默丢弃（complete-where-constraints PR-2）。
        if (k == TokenKind.Enum)   { this._p._advance(); return new WhereConstraint(false, this._emptyType(), "enum", sp); }
        return new WhereConstraint(true, this._parseType(), "", sp);
    }

    internal TypeExpr _parseType() {
        Span sp = this._p._peek().Span;
        // 类型位 `(`：函数类型 `(T1,...) -> R`、元组类型 `(T1, ..., Tn)`（add-tuple-types）、
        // 或括号分组 `(T)`。先解析括号内类型列表，再按尾随 `->` 有无分流（func vs tuple/分组）。
        if (this._p._peek().Kind == TokenKind.LParen) { return this._parseParenType(); }
        string name = this._p._peek().Text;
        this._p._advance();
        while (this._p._peek().Kind == TokenKind.Dot) {
            this._p._advance();
            name = name + "." + this._p._peek().Text;
            if (this._p._peek().Kind == TokenKind.Identifier) { this._p._advance(); }
        }
        TypeExpr[] args = new TypeExpr[4];
        int ac = 0;
        if (this._p._peek().Kind == TokenKind.Lt) {
            this._p._advance();   // <
            if (!this._tryCloseTypeArgs()) {   // 非空实参列表
                while (true) {
                    if (ac == args.Length) {
                        TypeExpr[] b = new TypeExpr[args.Length * 2];
                        Array.Copy(args, b, ac);
                        args = b;
                    }
                    args[ac] = this._parseType(); ac = ac + 1;
                    if (this._p._pendingGt == 0 && this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); continue; }
                    break;
                }
                if (!this._tryCloseTypeArgs()) {
                    this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected '>'", this._p._peek().Span);
                }
            }
        }
        TypeExpr t = new NamedType(name, args, ac, sp);
        while (this._p._pendingGt == 0 && this._p._peek().Kind == TokenKind.LBracket && this._p._peekAt(1).Kind == TokenKind.RBracket) {
            this._p._advance(); this._p._advance();
            t = new ArrayType(t, sp);
        }
        if (this._p._peek().Kind == TokenKind.Question) { this._p._advance(); t = new NullableType(t, sp); }
        return t;
    }

    // 解析 `( T0, T1, ... )` 后按尾随 `->` 有无分流：
    //   `->` 跟随 → 函数类型 `(params) -> R`（byte-identical，产 FuncTypeExpr）；
    //   否则 ≥2 元素 → 元组类型 → NamedType("Std.ValueTupleN", elems)（add-tuple-types 值元组脱糖）；
    //   否则 1 元素 → 括号分组，返回内层类型本身；0 元素 `()` 无 `->` → 报错（无 unit 类型）。
    private TypeExpr _parseParenType() {
        Span sp = this._p._peek().Span;
        this._p._expect(TokenKind.LParen, "(");
        TypeExpr[] ps = new TypeExpr[4];
        int pc = 0;
        if (this._p._peek().Kind != TokenKind.RParen) {
            while (true) {
                if (pc == ps.Length) {
                    TypeExpr[] b = new TypeExpr[ps.Length * 2];
                    Array.Copy(ps, b, pc);
                    ps = b;
                }
                ps[pc] = this._parseType(); pc = pc + 1;
                if (this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); continue; }
                break;
            }
        }
        this._p._expect(TokenKind.RParen, ")");
        if (this._p._peek().Kind == TokenKind.Arrow) {
            this._p._advance();   // ->
            TypeExpr ret = this._parseType();
            return new FuncTypeExpr(ps, pc, ret, sp);
        }
        if (pc >= 2) {
            // 元组类型 → 合成 ValueTupleN 泛型实例化（z42.core prelude 恒加载，短名恒可解析；
            // FQ `Std.ValueTupleN` 反而不经 using 解析，故用短名）。后端沿用泛型 struct record 机制。
            TypeExpr[] elems = new TypeExpr[pc];
            Array.Copy(ps, elems, pc);
            return new NamedType("ValueTuple" + pc.ToString(), elems, pc, sp);
        }
        if (pc == 1) { return ps[0]; }   // 括号分组类型 `(T)` = T
        this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected '->' for function type, or a tuple type with 2+ elements", sp);
        return this._emptyType();
    }

    private bool _tryCloseTypeArgs() {
        if (this._p._pendingGt > 0) { this._p._pendingGt = this._p._pendingGt - 1; return true; }
        if (this._p._peek().Kind == TokenKind.Gt) { this._p._advance(); return true; }
        if (this._p._peek().Kind == TokenKind.GtGt) { this._p._advance(); this._p._pendingGt = 1; return true; }
        return false;
    }

    // add-generic-methods：泛型方法调用 `名<T,U>(` 歧义消解——游标停在 '<'，试解析类型实参列表。
    // 成功返回精确大小的 args（>= 1，游标越过闭合 '>'）；失败返回 null（调用方负责回滚游标/诊断/_pendingGt）。
    // 复用 _parseType + _tryCloseTypeArgs（含 >>/>>> 拆分）。每个实参必须以 标识符 / 类型关键字 起始，
    // 排除 `a < 5`、`a < b + c` 之类比较；`a < b > (x)` 与 C# 一致判为泛型调用（stdlib 无此模式，golden 兜底）。
    internal TypeExpr[] _tryParseCallTypeArgs() {
        this._p._advance();                                  // consume '<'
        if (this._tryCloseTypeArgs()) { return null; }       // 空 <> 非泛型调用
        TypeExpr[] args = new TypeExpr[4];
        int ac = 0;
        while (true) {
            int sk = this._p._peek().Kind;
            if (sk != TokenKind.Identifier && !this._p._isTypeKeyword(sk) && sk != TokenKind.LParen) { return null; }
            if (ac == args.Length) {
                TypeExpr[] b = new TypeExpr[args.Length * 2];
                Array.Copy(args, b, ac);
                args = b;
            }
            args[ac] = this._parseType(); ac = ac + 1;
            if (this._p._pendingGt == 0 && this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); continue; }
            break;
        }
        if (!this._tryCloseTypeArgs()) { return null; }      // 未整齐闭合 → 非泛型调用
        TypeExpr[] outp = new TypeExpr[ac];
        Array.Copy(args, outp, ac);
        return outp;
    }

}