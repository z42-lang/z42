// REPL 输入分类（add-repl-decls-multiline）。token 级判别一段输入属于哪类：
//   var 声明   `var x = ...` / `T x = ...`（T=标识符或内建类型）
//   顶层声明   自由函数 `[修饰符] RetType Name(...)` / 类型 `[修饰符] class|struct|interface|enum Name`
//   其余        表达式 / 语句（交给 Script.Eval 的表达式-优先路径）
//
// 判别只看头部 token（跳过前导修饰符）：区分 var(`=`) 与 函数(`(`) 靠第三 token；类型靠关键字。
// 保守——漏判（如泛型返回 `List<int> f()`）退回表达式路径（自然报错），不误判纯表达式为声明。
namespace Std.Scripting;

using Std;
using Std.Collections;
using Z42.Syntax;

// 分类结果。IsVarDecl / IsDecl 互斥；都为 false = 表达式/语句。
public class ParsedInput {
    public bool IsVarDecl;   // var 声明：VarName/InitExpr 有效
    public string VarName;
    public string InitExpr;
    public string DeclType;  // 显式声明类型名（`A a = ..` → "A"）；`var a = ..` → ""（靠 init 推断）。
                             // 供 REPL 发静态字段时保留类型 → target-typed new 等能从声明类型定型。
    public bool IsDecl;      // 顶层函数/类型声明：DeclName = 声明的符号名（重定义查重用）
    public string DeclName;
    public bool IsTypeDecl;  // IsDecl 中进一步区分：类型声明（class/struct/enum/interface）；false = 自由函数。供 .types 只列类型。
    public bool HasVisibility;  // 输入是否显式写了 public/private/protected/internal（供 REPL 决定是否补 public）。
    public ParsedInput() {
        this.IsVarDecl = false; this.VarName = ""; this.InitExpr = ""; this.DeclType = "";
        this.IsDecl = false; this.DeclName = ""; this.IsTypeDecl = false; this.HasVisibility = false;
    }
}

public static class Classifier {

    // 主分类入口。
    public static ParsedInput Classify(string trimmed) {
        ParsedInput p = new ParsedInput();
        Lexer lx = new Lexer(trimmed, "<repl>");
        lx.Tokenize();
        int cnt = lx.TokenCount();
        // 跳过前导修饰符（public/private/static/abstract/...）到首个实义 token；
        // 顺带记录是否显式写了可见性修饰符（供 REPL 对缺省类型声明补 public）。
        int mi = 0;
        while (mi < cnt && Classifier._isModifier(lx.TokenAt(mi).Kind)) {
            if (Classifier._isVisibility(lx.TokenAt(mi).Kind)) { p.HasVisibility = true; }
            mi = mi + 1;
        }
        if (mi >= cnt) { return p; }
        int k0 = lx.TokenAt(mi).Kind;

        // ── 类型声明：class / struct / enum / interface（TokenKind 19..22；`record` 关键字已删）──
        if (k0 >= TokenKind.Class && k0 <= TokenKind.Interface) {
            p.IsDecl = true;
            p.IsTypeDecl = true;
            if (mi + 1 < cnt && lx.TokenAt(mi + 1).Kind == TokenKind.Identifier) {
                p.DeclName = lx.TokenAt(mi + 1).Text;
            }
            return p;
        }

        // ── `var <ident> = ...`：var 无类型前缀，单独判（类型靠 init 推断）──
        if (k0 == TokenKind.Var && mi + 2 < cnt
            && lx.TokenAt(mi + 1).Kind == TokenKind.Identifier
            && lx.TokenAt(mi + 2).Kind == TokenKind.Eq) {
            Classifier._fillVarDecl(p, lx, trimmed, mi + 1, mi + 2, "");
            return p;
        }

        // ── <type> <ident> ( | = ：先跳过一个完整类型引用前缀（限定名 A.B.C + 泛型 <...> +
        // 数组 [] + 可空 ?），再看其后是否 `<ident> (`（自由函数）或 `<ident> =`（var 声明）。
        // 单 token 类型（int/List/...）是退化情形；泛型 `List<int>`、限定名 `Std.Collections.List`、
        // 数组 `int[]` 等多 token 类型也一并识别（否则漏判 → 退回表达式路径 → 声明不入会话）。
        int te = Classifier._typeRefEnd(lx, cnt, mi);   // 类型之后第一个 token 下标；-1 = mi 非类型起始
        if (te > mi && te + 1 < cnt && lx.TokenAt(te).Kind == TokenKind.Identifier) {
            int kAfter = lx.TokenAt(te + 1).Kind;
            // 自由函数声明：<type> <ident> (
            if (kAfter == TokenKind.LParen) {
                p.IsDecl = true;
                p.DeclName = lx.TokenAt(te).Text;
                return p;
            }
            // var 声明：<type> <ident> = —— 保留用户写的完整显式类型文本，让声明类型能作
            // target-typed new / 集合字面量的目标（否则 E0437）。
            if (kAfter == TokenKind.Eq) {
                int tStart = lx.TokenAt(mi).Span.Start;
                int tEnd = lx.TokenAt(te - 1).Span.End;
                string declType = trimmed.Substring(tStart, tEnd - tStart);
                Classifier._fillVarDecl(p, lx, trimmed, te, te + 1, declType);
                return p;
            }
        }

        return p;
    }

    // 填充 var 声明结果：变量名（nameIdx 处 token）+ 显式类型文本（declType，`var` 时为空）+
    // init 表达式（eqIdx 的 `=` 之后到行尾，去尾随分号）。
    private static void _fillVarDecl(ParsedInput p, Lexer lx, string trimmed, int nameIdx, int eqIdx, string declType) {
        p.IsVarDecl = true;
        p.VarName = lx.TokenAt(nameIdx).Text;
        p.DeclType = declType;
        int eqEnd = lx.TokenAt(eqIdx).Span.End;
        string init = trimmed.Substring(eqEnd, trimmed.Length - eqEnd).Trim();
        if (init.EndsWith(";")) { init = init.Substring(0, init.Length - 1).Trim(); }
        p.InitExpr = init;
    }

    // 从 token `start` 起跳过一个完整类型引用，返回类型之后第一个 token 的下标；
    // `start` 处不是合法类型起始（非标识符 / 非内建类型关键字）→ 返回 -1。
    // 语法：限定名 `A.B.C` + 可选泛型实参 `<...>`（含嵌套，`>>` 记 -2）+ 可选数组 `[]`（多维）
    // + 可选可空 `?`。保守启发式——只跟踪尖括号深度跳过泛型实参，不校验实参内部合法性；
    // 尖括号不闭合 / 跨越外层 → 返回 -1（上层随即退回表达式路径，安全）。
    private static int _typeRefEnd(Lexer lx, int cnt, int start) {
        if (start >= cnt) { return -1; }
        if (!Classifier._isTypeToken(lx.TokenAt(start).Kind)) { return -1; }
        int i = start + 1;
        // 限定名 A.B.C
        while (i + 1 < cnt && lx.TokenAt(i).Kind == TokenKind.Dot
               && lx.TokenAt(i + 1).Kind == TokenKind.Identifier) {
            i = i + 2;
        }
        // 泛型实参 <...>（尖括号深度；GtGt=`>>` 记 -2，词法器无三重 `>>>`）
        if (i < cnt && lx.TokenAt(i).Kind == TokenKind.Lt) {
            int depth = 1;
            i = i + 1;
            while (i < cnt && depth > 0) {
                int k = lx.TokenAt(i).Kind;
                if (k == TokenKind.Lt) { depth = depth + 1; }
                else if (k == TokenKind.Gt) { depth = depth - 1; }
                else if (k == TokenKind.GtGt) { depth = depth - 2; }
                i = i + 1;
            }
            if (depth != 0) { return -1; }   // 未闭合，或 `>>` 越过外层边界 → 非合法类型前缀
        }
        // 数组 []（可多维 [][]）
        while (i + 1 < cnt && lx.TokenAt(i).Kind == TokenKind.LBracket
               && lx.TokenAt(i + 1).Kind == TokenKind.RBracket) {
            i = i + 2;
        }
        // 可空 ?
        if (i < cnt && lx.TokenAt(i).Kind == TokenKind.Question) { i = i + 1; }
        return i;
    }

    // 前导修饰符 token（声明可带、跳过后再判类型/函数关键字）。
    private static bool _isModifier(int kind) {
        return kind == TokenKind.Static || kind == TokenKind.Public || kind == TokenKind.Private
            || kind == TokenKind.Protected || kind == TokenKind.Internal || kind == TokenKind.Abstract
            || kind == TokenKind.Sealed || kind == TokenKind.Override || kind == TokenKind.Virtual
            || kind == TokenKind.New || kind == TokenKind.Extern || kind == TokenKind.Async
            || kind == TokenKind.Partial;
    }

    // 可见性修饰符 token（public/private/protected/internal）。
    private static bool _isVisibility(int kind) {
        return kind == TokenKind.Public || kind == TokenKind.Private
            || kind == TokenKind.Protected || kind == TokenKind.Internal;
    }

    // 可作类型名的 token：标识符，或内建类型关键字（string/int/.../f64，TokenKind 69..93）。
    private static bool _isTypeToken(int kind) {
        if (kind == TokenKind.Identifier) { return true; }
        if (kind >= TokenKind.String && kind <= TokenKind.F64) { return true; }
        return false;
    }
}
