namespace Std.Scripting;

using Std;
using Z42.Syntax;
using Z42.Semantics;
using Z42.Pipeline;
using Z42.IR;
using Z42.Project;

public static class Script {
    // 新建空会话。
    public static ScriptState Create() { return new ScriptState(); }

    // D2 骨架探针：验证 compiler-consuming stdlib 库依赖解析（已编译通过）。
    // 完整 Eval 待 D8 裁决，见文件头。
    public static int Probe() {
        CompileInputs inp = new CompileInputs();
        inp.SrcCount = 0;
        return inp.SrcCount;
    }
}
