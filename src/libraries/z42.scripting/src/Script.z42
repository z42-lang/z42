// Script.Eval —— REPL 编译+执行层（scripting-charter Form B）。
//
// 流程：分类输入（using / var 声明 / 表达式）→ build 每轮源（D7 唯一命名空间 Repl.R{N} +
// carry-forward Vars{N} 类）→ IReplCompiler.CompileRound（门面：内部 ParseAll→PackageCompile→
// packed 字节，含 E0401 惰性 reconcile 重试）→ Engine.LoadBytes（内存加载）→ Engine.Invoke（自由
// 函数 Eval{N}）→ EvalResult。编译失败**或求值期运行异常**（throw / 除零 / 越界 / 类型不符等）
// 均不推进会话、作失败 EvalResult 返回（错误恢复）——异常不逃逸，REPL 可继续接受输入。
//
// sink-repl-compile-facade：编译世界（DepScanResult）+ 编译编排住编译器（z42c.pipeline，经
// `IReplCompiler` 门面 + 运行期反射注入），scripting 编译期 stdlib-only。CachedScan 是 opaque
// `object` 句柄；ParseAll/PackageCompile/DepScan 全不在本文件出现。
//
// 状态模型（D7 + D8）：会话变量提升为 Vars{N} 类静态字段；每轮 carry 前轮全部变量
// （`public static var v = Vars{prev}.v;`），新变量追加；用户对变量的裸引用经 Rewriter
// 改写成 `Vars{N}.v`。依赖已合并的 infer-var-field-types（跨轮 carry 的 var 字段类型正确）。
namespace Std.Scripting;

using Std;
using Std.IO;
using Std.Collections;
using Std.Threading;   // Thread（add-repl-prewarm：Join 后台预热 worker）
using Z42.Syntax;            // Lexer / TokenKind（_isStatement token 判——前端已是 stdlib）
using Z42.Project;           // ZpkgWriterZ.Major/Minor（FormatVersion .version 元指令）
using Z42.IR.BinaryFormat;   // ZbcVersion（.version 元指令）
using Z42.Build;             // IReplCompiler / ReplCompileResult（编译经门面——sink-repl-compile-facade）

// 分类结果 `ParsedInput` + 分类器 `Classifier` 见 Classifier.z42。

public static class Script {
    // 新建空会话。从 Z42_LIBS 派生编译依赖目录；DeclaredDeps 留空 → DepScan 放行全部包。
    public static ScriptState Create() {
        // LibsDirs = Z42_LIBS 各目录（**仅静态库**）。
        string libs = Environment.GetEnvironmentVariable("Z42_LIBS");
        return Script.CreateWithLibs(libs != null ? libs : "");
    }

    // 显式给依赖目录（`:` 分隔）建会话，**不读环境变量**。wasm/playground 无 env 时用：
    // 传虚拟 VFS 目录（如 "/libs"），DepScan 从 VFS 扫已挂载的 zpkg。native 的 Create 委托到此。
    public static ScriptState CreateWithLibs(string libsCsv) {
        ScriptState s = new ScriptState();
        // perf ②：不再建会话磁盘目录——carry-forward 改为 CachedScan 的内存增量并入（见 Eval）。
        string[] envDirs = new string[0];
        if (libsCsv != null && libsCsv.Length > 0) { envDirs = libsCsv.Split(":"); }
        s.LibsDirs = envDirs; s.LibsDirsN = envDirs.Length;
        // 默认 using（隐式导入，对齐 C# ImplicitUsings / Kotlin·Scala REPL 默认 import）：常用命名空间
        // 开箱即用（Console / List / StringBuilder / Math），无需手动 using。lazy-repl-depscan：首轮
        // eager-load 这些包（在门面 CompileRound 的 E0401 回退里，Z42cReplCompiler._loadUsingsPackages）。
        s.Usings.Add("Std.IO");
        s.Usings.Add("Std.Collections");
        s.Usings.Add("Std.Text");
        s.Usings.Add("Std.Math");
        return s;
    }

    // add-repl-prewarm：构建依赖世界（首次 eval 的 ~3.4s 一次性开销：ScanDirsLazy 扫全 stdlib+
    // 编译器世界 + 加载默认 using 包）。REPL 启动即 spawn 一个 worker 线程跑它，与用户打字并行，
    // 首次 Eval 消费前 Join 汇合 → 首次 eval 从「回车后干等 3.4s」变「近乎瞬时」。
    //
    // repl-lazy-prelude：worker 只建依赖世界**骨架**（nsMap 路由 + 惰性 world），**不 reconcile prelude、
    // 不预载 usings** → 立即发布。`1+1` 类纯表达式零包加载（1.72s→~0.40s），秒回车也不卡。首次引用 Std
    // 符号时由门面 CompileRound 的 E0401 回退按需加载 prelude+usings（前台，一次性）——**已由 T2 per-type
    // completer（#98/#101）从 ~1.7s 降到 ~0.33s**（见 Z42cReplCompiler._loadReferencedTypes / repl.md T2 节）。**不后台
    // reconcile**：本 VM 的 GC 安全点协作会让计算密集的后台线程阻塞
    // 主线程 eval，后台预热反而把 `1+1` 拖慢（实测双缓冲 Phase 2 下秒回车 `1+1`=3s）。
    // 并发安全：worker 建完 skel 即原子发布（64 位指针写）、随即退出——绝无「发布后继续变异 scan」，
    // 与主线程 eval / 补全器无数据竞争；补全器并发读只见 null 或完全成品。幂等：已建则直接返回。
    public static void Prewarm(ScriptState state) {
        if (state.CachedScan != null) { return; }
        // 门面建依赖世界骨架（惰性 scan：路由 nsMap + LazyReconWorld，不预 reconcile）。opaque 句柄。
        object skel = ReplCompilerHost.Get().CreateWorld(state.LibsDirs, state.LibsDirsN, state.DeclaredDeps, state.DepCount);
        state.CachedScan = skel;
    }

    // add-repl-prewarm：Eval 顶部汇合点。有后台 worker → Join（已完成则瞬回；打字极快则阻塞到
    // 完成，退化为同步、不更差）。worker 异常 / 无 worker（.reset 重建 s / -c 单次求值）→ inline
    // Prewarm 兜底，行为与预热前一致。
    private static void _ensureWarm(ScriptState state) {
        if (state.CachedScan != null) { return; }
        if (state.PrewarmThread != null) {
            Thread t = state.PrewarmThread;
            state.PrewarmThread = null;   // 只 Join 一次
            try { t.Join(); } catch (Exception e) { }   // worker 异常 → 下面 inline 兜底重建
        }
        if (state.CachedScan == null) { Script.Prewarm(state); }
    }

    // add-repl-members-metacommand：public 汇合入口，供依赖 completer 的元指令（.members）在**无 eval**
    // 时先确保 CachedScan 就绪（否则首命令即 .members 会读到 null scan、返回空）。等价 Eval 顶部的汇合。
    public static void EnsureWarm(ScriptState state) { Script._ensureWarm(state); }

    // add-repl-ns-completion-err-map：诊断行号回映。生成源 = prelude（namespace/usings/[Vars 类]）+ 用户输入，
    // 故用户输入第一行在生成源里 = prelude 换行数 + 1 → 用户行 = 诊断行 − prelude换行数（表达式轮/声明轮统一）。
    private static int _countNewlines(string s) {
        int n = 0; int i = 0;
        char nl = (char)10;   // z42 词法器不支持 char 转义（见 interactive_main (char)27 idiom）
        while (i < s.Length) { if (s.CharAt(i) == nl) { n = n + 1; } i = i + 1; }
        return n;
    }

    // 把诊断串 `<file>(<L>,<C>): <rest>` 回映：抽 L → 用户行；丢内部生成文件名 + **不可靠的列号**
    // （Rewriter 会改写用户输入、移动列位置）。用户行 ≤ 1（单行输入 / 落在 prelude）→ 只留 <rest>，
    // 不加噪声。格式不符（无 `(`/`,`/`): `）→ 原样返回（稳健兜底）。
    private static string _remapDiag(string msg, int preludeLines) {
        int lp = msg.IndexOf("(");
        if (lp < 0) { return msg; }
        string afterLp = msg.Substring(lp + 1, msg.Length - lp - 1);
        int comma = afterLp.IndexOf(",");
        if (comma < 0) { return msg; }
        int endSeq = msg.IndexOf("): ");
        if (endSeq < 0 || endSeq < lp) { return msg; }
        string lStr = msg.Substring(lp + 1, comma);   // afterLp[0,comma) = 行号数字串
        int userLine = Convert.ToInt32(lStr) - preludeLines;
        string rest = msg.Substring(endSeq + 3, msg.Length - endSeq - 3);   // "): " 之后
        if (userLine <= 1) { return rest; }
        return "第 " + userLine.ToString() + " 行: " + rest;
    }

    // .version 元指令：REPL 使用的二进制格式版本（zbc + zpkg，strict-pin 值）。
    // 运行时（z42vm）版本串未经 builtin 暴露给 z42 → 留待 follow-up（repl-future-runtime-version）。
    public static string FormatVersion() {
        return "zbc " + ZbcVersion.Major.ToString() + "." + ZbcVersion.Minor.ToString()
             + ", zpkg " + ZpkgWriterZ.Major.ToString() + "." + ZpkgWriterZ.Minor.ToString();
    }

    public static EvalResult Eval(ScriptState state, string input) {
        string trimmed = input.Trim();

        // add-repl-prewarm：确保依赖世界就绪。放在最顶——含下面 `using` 累积路径也先汇合，
        // 避免后台 worker 读 state.Usings 与主线程改 state.Usings 竞争（Join 是内存屏障）。
        // worker 已完成 → Join 瞬回；无 worker（.reset / -c）→ inline Prewarm 兜底。
        Script._ensureWarm(state);

        // ── using 声明：累积（去重），不编译 ──
        if (trimmed.StartsWith("using ")) {
            string nsName = trimmed.Substring(6, trimmed.Length - 6).Trim();
            if (nsName.EndsWith(";")) { nsName = nsName.Substring(0, nsName.Length - 1).Trim(); }
            bool seen = false;
            int sk = 0;
            while (sk < state.Usings.Count) { if (state.Usings[sk] == nsName) { seen = true; } sk = sk + 1; }
            if (!seen) { state.Usings.Add(nsName); }
            return new EvalResult(true, false, null, "", state);
        }

        int n = state.Counter + 1;
        string ns = "Repl.R" + n.ToString();
        string efn = "Eval" + n.ToString();
        string cls = "Vars" + n.ToString();

        ParsedInput p = Classifier.Classify(trimmed);
        // 依赖世界已由顶部 _ensureWarm 就绪（CachedScan != null）。

        // ── 顶层声明轮（函数 / 类型）：编入 Repl.R{n}、登记 ns，后续轮 `using` 可见（零壳类/零改写）──
        if (p.IsDecl) { return Script._evalDecl(state, trimmed, p, n, ns); }

        bool isDecl = p.IsVarDecl;
        bool hasVars = state.VarNames.Count > 0;
        bool useVarsClass = isDecl || hasVars;
        // perf ⑤：只有 var 声明轮发新的 Vars{n} 类（并入缓存 scan / 前进 VarsRound）；非声明轮
        // 直接引用现有 Vars{VarsRound}（赋值就地改其静态字段，值持久），不发新类、不并入、不前进
        //  → 抹平「每轮都累积一个包」的 O(n) 增长（长会话保持恒定快）。
        // 本轮用户引用/声明 init 所指向的 Vars 类：声明轮 = 本轮新类；否则 = 现有 VarsRound 类。
        string refCls = isDecl ? cls : ("Vars" + state.VarsRound.ToString());

        // ── build prelude（namespace + usings + 声明 ns + 现有 Vars 类；+ [var 声明轮] carry-forward）──
        string prelude = Script._basePrelude(state, ns);
        if (isDecl) {
            string carryCls = "Vars" + state.VarsRound.ToString();
            prelude = prelude + "public static class " + cls + " {\n";
            int vi = 0;
            while (vi < state.VarNames.Count) {
                string vn = state.VarNames[vi];
                prelude = prelude + "  public static var " + vn + " = " + carryCls + "." + vn + ";\n";
                vi = vi + 1;
            }
            string initR = Rewriter.Rewrite(p.InitExpr, state.VarNames, cls);
            // 保留用户写的显式类型（`A a = new()` → `public static A a = ..`），让声明类型能作
            // target-typed new / 集合字面量的目标；`var a = ..` 仍发 `var`（靠 init 推断 + carry）。
            string declKw = (p.DeclType.Length > 0) ? p.DeclType : "var";
            prelude = prelude + "  public static " + declKw + " " + p.VarName + " = " + initR + ";\n";
            prelude = prelude + "}\n";
        }

        // 用户输入对变量的裸引用 → refCls（声明轮=本轮新类，否则=现有 VarsRound 类）
        string rewritten = input;
        if (useVarsClass) { rewritten = Rewriter.Rewrite(input, state.VarNames, refCls); }

        // fix-repl-trailing-semicolon：剥离单个尾随分号，让 `expr;` / `stmt;` 与不带分号等价
        // （REPL 常见写法）。否则表达式路径 `return (X);` 遇 `X;` → `return (X;);`（E0202），
        // 语句/回退路径 `X; return null;` 遇 `X;` → `X;; return null;` 撞 `;;` 空语句（parser 拒）
        // → 两路皆炸、该轮副作用丢失。剥尾随后两路都正确；多语句 `a();b();` 的中间 `;` 保留、
        // 尾随剥掉 → 回退路径 `a();b(); return null;` 自然合法。上游 using/var-decl 各自的 `;`
        // 处理（line 132 / Classifier line 81）已在此前完成、走 trimmed/p.*，不受影响。
        if (rewritten.EndsWith(";")) { rewritten = rewritten.Substring(0, rewritten.Length - 1).Trim(); }
        if (trimmed.EndsWith(";")) { trimmed = trimmed.Substring(0, trimmed.Length - 1).Trim(); }

        // ── 编译 ──
        ReplCompileResult art;
        bool hasValue = true;
        if (isDecl) {
            art = Script._compileBody(state, n, prelude, efn, "return (" + cls + "." + p.VarName + ");");
        } else if (Script._isStatement(trimmed)) {
            // perf ③：明确是语句（赋值 / 语句关键字）→ 直接编语句，不试表达式（省一次编译）。
            art = Script._compileBody(state, n, prelude, efn, rewritten + "; return null;");
            hasValue = false;
        } else {
            // 表达式优先；失败 → 回退纯语句（副作用调用等）。
            art = Script._compileBody(state, n, prelude, efn, "return (" + rewritten + ");");
            if (art.ErrorCount > 0) {
                ReplCompileResult artS = Script._compileBody(state, n, prelude, efn, rewritten + "; return null;");
                if (artS.ErrorCount == 0) { art = artS; hasValue = false; }
            }
        }
        if (art.ErrorCount > 0) {
            int pl = Script._countNewlines(prelude);   // 生成源 = prelude + wrapper+用户输入 → 行号回映基准
            string err = "";
            int di = 0;
            while (di < art.DiagCount) { err = err + Script._remapDiag(art.Diagnostics[di], pl) + "\n"; di = di + 1; }
            return new EvalResult(false, false, null, err, state);   // 会话不推进
        }

        // ── bytes → VM 内存加载 → invoke（try/catch）→ [成功且声明轮] 内存增量并入缓存世界 ──
        // perf ②/⑤：不再落盘。只有声明轮的 Vars{n} 会被后续轮 `using Repl.R{n}` 引用，故仅它们
        // 并入缓存世界；非声明轮的包无人在编译期引用（其副作用/赋值经运行期静态字段持久），跳过。
        // ExtendWorld 放在 Invoke 成功之后：本轮 Invoke 只依赖已 LoadBytes 的模块，不需要先 ExtendWorld；
        // 失败轮就不并入缓存世界，避免污染后续轮编译（fix-repl-eval-exception）。
        byte[] bytes = art.Bytes;
        Engine.LoadBytes(bytes);
        object result = null;
        try {
            result = Engine.Invoke(ns + "." + efn);
        } catch (Exception e) {
            // 运行期异常（用户 throw / 除零 / 越界 / 类型不符如 `int x = "s"` 的 __box_prim 等）
            // 不得逃逸终止 REPL——捕获后作失败 EvalResult 返回，让 REPL 继续接受下一条输入。
            // Counter 必须前进（不同于编译错误路径）：本轮模块 Repl.R{n} 已 LoadBytes 进 VM
            // （含抛出的 Eval{n}），若不前进会重用同一轮号 → 下轮重编同名 Eval{n} 无法覆盖 VM 里
            // 已加载的旧函数，会再次执行旧的抛出逻辑（异常"粘住"、后续输入全部复现该异常）。
            // 仅前进 Counter；不 ExtendWorld、不推进 VarsRound/VarNames → 会话变量与编译世界不受污染。
            state.Counter = n;
            return new EvalResult(false, false, null, e.GetType().Name + ": " + e.Message + "\n", state);
        }
        // 求值成功才把声明轮 Vars{n} 并入缓存世界（供后续轮 `using Repl.R{n}` 编译期解析）。
        if (isDecl) { ReplCompilerHost.Get().ExtendWorld(state.CachedScan, bytes, "repl_r" + n.ToString()); }

        // ── 推进会话状态（⑤：仅声明轮前进 VarsRound + 记变量名）──
        state.Counter = n;
        if (isDecl) {
            state.VarsRound = n;
            bool dup = false;
            int dk = 0;
            while (dk < state.VarNames.Count) { if (state.VarNames[dk] == p.VarName) { dup = true; } dk = dk + 1; }
            if (!dup) { state.VarNames.Add(p.VarName); }
        }
        object retVal = null;
        if (hasValue) { retVal = result; }
        return new EvalResult(true, hasValue, retVal, "", state);
    }

    // prelude：namespace + 累积 usings + 全部声明 ns（后续轮见已声明 fn/type）+ 现有 Vars{VarsRound} 类。
    // 声明 ns 的 `using` 使自由函数（fix-imported-free-func-namespace）与类型（ImportedClassNs）跨包裸调解析。
    private static string _basePrelude(ScriptState state, string ns) {
        string prelude = "namespace " + ns + ";\n";
        int u = 0;
        while (u < state.Usings.Count) { prelude = prelude + "using " + state.Usings[u] + ";\n"; u = u + 1; }
        int d = 0;
        while (d < state.DeclNamespaces.Count) { prelude = prelude + "using " + state.DeclNamespaces[d] + ";\n"; d = d + 1; }
        if (state.VarsRound > 0) { prelude = prelude + "using Repl.R" + state.VarsRound.ToString() + ";\n"; }
        return prelude;
    }

    // 顶层声明轮：声明原样作 Repl.R{n} 命名空间成员编译，并入缓存 scan + 内存加载，登记 ns/名。
    // 不 Invoke（无 Eval{n}）。重定义（同名）→ ERROR、会话不推进（MVP，不 supersede）。
    private static EvalResult _evalDecl(ScriptState state, string declText, ParsedInput p, int n, string ns) {
        if (p.DeclName.Length > 0) {
            int i = 0;
            while (i < state.DeclNames.Count) {
                if (state.DeclNames[i] == p.DeclName) {
                    return new EvalResult(false, false, null,
                        "error: '" + p.DeclName + "' is already declared in this session (redefinition not supported)\n", state);
                }
                i = i + 1;
            }
        }
        // REPL 每轮编成独立 package（Repl.R{n}）。类型默认可见性 internal 在此有两个后果：
        //   ① 同轮 public 成员 → E0441 不一致可访问性；② 下一轮跨 package 引用 → E0404。
        // 故对**缺省未写可见性**的类型声明自动补 public，使裸 `class Foo {..}` 跨轮可用（显式写
        // 可见性的尊重用户）。自由函数不需要（跨包 internal 自由函数 REPL 已可用）。
        string emitText = declText;
        if (p.IsTypeDecl && !p.HasVisibility) { emitText = "public " + declText; }
        string prelude = Script._basePrelude(state, ns);
        ReplCompileResult art = Script._compileRaw(state, n, prelude + emitText + "\n");
        if (art.ErrorCount > 0) {
            int pl = Script._countNewlines(prelude);   // 声明轮：declText 紧接 prelude，行号回映同理
            string err = "";
            int di = 0;
            while (di < art.DiagCount) { err = err + Script._remapDiag(art.Diagnostics[di], pl) + "\n"; di = di + 1; }
            return new EvalResult(false, false, null, err, state);
        }
        byte[] bytes = art.Bytes;
        ReplCompilerHost.Get().ExtendWorld(state.CachedScan, bytes, "repl_r" + n.ToString());
        Engine.LoadBytes(bytes);
        state.Counter = n;
        state.DeclNamespaces.Add(ns);
        if (p.DeclName.Length > 0) {
            state.DeclNames.Add(p.DeclName);
            if (p.IsTypeDecl) { state.DeclTypeNames.Add(p.DeclName); }   // .types 只列类型（非自由函数）
        }
        return new EvalResult(true, false, null, "", state);
    }

    // 用给定 eval body 编译本轮包（表达式/语句两种 body 复用）。
    private static ReplCompileResult _compileBody(ScriptState state, int n, string prelude, string efn, string body) {
        return Script._compileSrc(state, n, prelude + "public static object " + efn + "() { " + body + " }\n");
    }

    // 编译一整段裸源（顶层声明轮直接把声明附在 prelude 后，不包裹 Eval 函数）。
    private static ReplCompileResult _compileRaw(ScriptState state, int n, string src) {
        return Script._compileSrc(state, n, src);
    }

    // 单文件源 → 门面 CompileRound（sink-repl-compile-facade）。ParseAll/PackageCompile + E0401 惰性
    // per-type / 整包 reconcile 重试全在编译器实现侧（Z42cReplCompiler），本文件只把源 + 活跃 usings
    // 交给门面，取回 packed 字节 + 原始诊断。`state.CachedScan` 是 opaque 世界句柄。
    private static ReplCompileResult _compileSrc(ScriptState state, int n, string src) {
        string[] usings = state.Usings.ToArray();
        return ReplCompilerHost.Get().CompileRound(state.CachedScan, "repl_r" + n.ToString(), src, usings, usings.Length);
    }

    // perf ③：token 级判「明确是语句」（→ 跳过表达式尝试，省一次编译）。判据保守——只认
    // ①首 token 为语句关键字（return/if/while/...）②顶层（括号深度 0）出现赋值符（= / += / ++ ...）。
    // 漏判（如复合赋值没覆盖全）只是退回「表达式优先 + 回退语句」老路，仍正确；**误判**（把纯表达式
    // 当语句）才会吞掉返回值，故只认这两类强信号，纯算术/调用一律留给表达式路径。
    private static bool _isStatement(string trimmed) {
        Lexer lx = new Lexer(trimmed, "<repl>");
        lx.Tokenize();
        int cnt = lx.TokenCount();
        if (cnt == 0) { return false; }
        int k0 = lx.TokenAt(0).Kind;
        if (k0 == TokenKind.Return || k0 == TokenKind.If || k0 == TokenKind.While
            || k0 == TokenKind.For || k0 == TokenKind.Foreach || k0 == TokenKind.Do
            || k0 == TokenKind.Switch || k0 == TokenKind.Try || k0 == TokenKind.Throw
            || k0 == TokenKind.Break || k0 == TokenKind.Continue) { return true; }
        int depth = 0;
        int i = 0;
        while (i < cnt) {
            int k = lx.TokenAt(i).Kind;
            if (k == TokenKind.LParen || k == TokenKind.LBracket || k == TokenKind.LBrace) { depth = depth + 1; }
            else if (k == TokenKind.RParen || k == TokenKind.RBracket || k == TokenKind.RBrace) { depth = depth - 1; }
            else if (depth == 0) {
                if (k == TokenKind.Eq || k == TokenKind.PlusEq || k == TokenKind.MinusEq
                    || k == TokenKind.StarEq || k == TokenKind.SlashEq || k == TokenKind.PercentEq
                    || k == TokenKind.AmpEq || k == TokenKind.PipeEq || k == TokenKind.CaretEq
                    || k == TokenKind.PlusPlus || k == TokenKind.MinusMinus) { return true; }
            }
            i = i + 1;
        }
        return false;
    }
}
