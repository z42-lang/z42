// REPL 会话累积状态（add-z42-repl 阶段 2，growing transcript）。
// 每轮成功 eval 后推进；失败时不推进（EvalResult.State = 原状态，会话不破坏）。
namespace Std.Scripting;

using Std;
using Std.Collections;

public class ScriptState {
    public List<string> Usings;    // 生效的 using 命名空间（如 "Std.IO"）
    public List<string> VarNames;  // 会话变量名（.vars / 引用改写用）
    public List<string> VarDecls;  // 各变量的声明源（提升为静态字段行）
    public List<string> Decls;     // 顶层 fn/class 声明源（累积）
    public int Counter;            // 最近一次成功轮次号（下一轮 = Counter+1）

    public ScriptState() {
        this.Usings = new List<string>();
        this.VarNames = new List<string>();
        this.VarDecls = new List<string>();
        this.Decls = new List<string>();
        this.Counter = 0;
    }
}
