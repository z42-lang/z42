//! 确定性伪随机数：给同一个 seed 得到同一串数。
//!
//! 适合测试 fixture、模拟、洗牌、临时 ID、UI 抖动。
//!
//! ## 不支持
//!
//! - 没有从 OS 熵源取 seed 的入口：`Random()` 只能拿墙钟毫秒，可被猜测。需要强 seed 请直接用
//!   [`Std.Crypto.SecureRandom`]，不要给 `Random` 喂熵。
//! - 没有 `SampleLong`：`Shuffle` 有 `Int` / `Long` / `String` 三个版本，`Sample` 只有 `Int` / `String`。
//! - 没有泛型 / 对象数组版本：`Shuffle` 与 `Sample` 只接受这三种元素类型的数组，`T[]` / `object[]` 不支持。
//! - 没有状态的保存与恢复：内部状态不可读写，无法在两次运行之间续跑同一条序列（只能记住 seed 加抽取次数重放）。
//! - 没有 `NextBytes(byte[])`：要随机字节请自己从 `NextInt()` 拆，或用 [`Std.Crypto.SecureRandom.GetBytes`]。
//! - 分布只有正态与指数：泊松 / 二项 / 伽马等未提供。
//! - 不做线程同步：并发调用同一实例会撕裂内部状态，结果无定义。
//!
//! @warning **不是 CSPRNG。** 输出可预测——观察到少量输出即可反推内部状态。session token、CSRF nonce、
//! 密钥、盐、密码等任何「不可预测性」有安全含义的场景，一律用 [`Std.Crypto.SecureRandom`]。
//! @warning **非线程安全。** 一个 `Random` 实例不能被多个线程共用。多线程请每线程一个实例，并用不同的
//! `streamId` 保证序列互不重叠。
namespace Std.Random;
using Std.Time;

/// PCG-XSH-RR 伪随机数发生器。
public class Random {
    private long _state;

    // PCG 增量必须是奇数（`| 1`）。默认值 1442695040888963407 | 1 与历史硬编码一致，
    // 保证 `Random(seed)` 与旧代码产生同一序列。
    private long _inc;

    /// 用墙钟时间作 seed。每次运行结果不同，**不可复现**。
    public Random() {
        // wall-clock seed — 同 C# new Random() default behaviour。
        long ms = DateTime.UtcNow().UnixMs();
        this.Init(ms, 1442695040888963407 | 1);
    }

    /// 固定 seed：相同 seed ⇒ 逐位相同的序列。
    public Random(long seed) {
        this.Init(seed, 1442695040888963407 | 1);
    }

    /// 固定 seed 并选一条独立的流。
    ///
    /// seed 相同、`streamId` 不同的两个实例，产生的序列互不重叠。
    /// @param streamId 内部取 `streamId | 1` 作为 PCG 增量
    public Random(long seed, long streamId) {
        this.Init(seed, streamId | 1);
    }

    // PCG 种子步：状态从 0 开始，增量 + 步进一次，混入用户 seed。等价于 pcg32_srandom_r(rng, seed, seq)。
    private void Init(long seed, long inc) {
        this._inc = inc;
        this._state = 0;
        this.Step();
        this._state = this._state + seed;
        this.Step();
    }

    // 一轮 PCG：状态前进，返回 32 位输出（掩码到 long 的低位，因为 z42 没有 uint）。
    // XSH-RR 输出本身只有 32 位，但为了把掩码写清楚，存在 i64 里。
    private long Step() {
        long oldState = this._state;
        // Multiplier from L'Ecuyer 1999 (PCG paper constant).
        long mul = 6364136223846793005;
        long inc = this._inc;
        this._state = oldState * mul + inc;
        // 32-bit mask. Decimal literal since z42 hex literal support is TBD.
        long MASK32 = 4294967295;          // 0xFFFFFFFF
        // xorshift: ((state >> 18) ^ state) >> 27, masked to 32 bits.
        long shifted = (((oldState >> 18) ^ oldState) >> 27) & MASK32;
        // rotate-right by top 5 bits of state (0..31).
        int rot = (int)((oldState >> 59) & 31);
        // raw32 rotate-right: ((x >> rot) | (x << (32 - rot))) & MASK32.
        long result;
        if (rot == 0) {
            result = shifted;
        } else {
            result = ((shifted >> rot) | (shifted << (32 - rot))) & MASK32;
        }
        return result;
    }

    /// 返回整个 i64 范围（含负数）的随机数。
    public long NextLong() {
        long high = this.Step();
        long low  = this.Step();
        return (high << 32) | low;
    }

    /// 返回整个 i32 范围（含负数）的随机数。
    public int NextInt() {
        long raw32 = this.Step();
        long signBit = 2147483648;        // 0x80000000
        long wrap     = 4294967296;        // 0x100000000
        // Sign-extend the 32-bit value into i32: if bit 31 set, value is negative.
        if ((raw32 & signBit) != 0) {
            return (int)(raw32 - wrap);
        }
        return (int)raw32;
    }

    /// 返回 `[min, max)` 内的整数。
    ///
    /// 用取模映射，不做 rejection sampling：span 不整除 2⁶³ 时存在微小偏差。
    /// @throws ArgumentException `max <= min`
    public long NextLongRange(long min, long max) {
        if (max <= min) {
            throw new ArgumentException("NextLongRange: max must be > min");
        }
        long span = max - min;
        // Modulo bias is negligible for span << 2^63; acceptable for L1.
        long raw = this.NextLong();
        // Ensure non-negative before modulo.
        if (raw < 0) { raw = raw + 9223372036854775807 + 1; }
        return min + (raw % span);
    }

    /// 返回 `[min, max)` 内的整数。
    ///
    /// 用取模映射，不做 rejection sampling：span 不整除 2³² 时存在微小偏差。
    /// @throws ArgumentException `max <= min`
    /// @example
    ///     new Random(42).NextIntRange(5, 6)    // => 5
    public int NextIntRange(int min, int max) {
        if (max <= min) {
            throw new ArgumentException("NextIntRange: max must be > min");
        }
        int span = max - min;
        long raw = this.Step();
        // `raw` is already in [0, 2^32) (masked low 32 bits); modulo is safe.
        return min + (int)(raw % (long)span);
    }

    /// 返回 `[0.0, 1.0)` 内的随机数，取 53 位尾数精度。
    public double NextDouble() {
        // Use top 53 bits (double mantissa width) for full precision.
        // shift right 11 to drop low bits AND clear sign — but `>>` in z42
        // is arithmetic shift on i64, so we explicitly mask after to be safe.
        long bits = this.NextLong();
        long mantissaMask = 9007199254740991;     // (1 << 53) - 1
        long unsigned53 = ((bits >> 11) & mantissaMask);
        return (double)unsigned53 / 9007199254740992.0;     // 1 / 2^53
    }

    /// 各 1/2 概率返回 true。
    public bool NextBool() {
        return (this.Step() & 1) == 1;
    }

    // `Shuffle` 是原地 Fisher–Yates。`Sample` 用 partial Fisher–Yates（O(k) 次交换）：
    // 长度已知时比标准 reservoir 更简单，且同样均匀。

    /// 原地 Fisher–Yates 洗牌。长度 0 / 1 是 no-op。
    public void ShuffleInt(int[] arr) {
        int n = arr.Length;
        int i = n - 1;
        while (i > 0) {
            int j = this.NextIntRange(0, i + 1);
            int tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            i = i - 1;
        }
    }

    /// 原地 Fisher–Yates 洗牌。长度 0 / 1 是 no-op。
    public void ShuffleLong(long[] arr) {
        int n = arr.Length;
        int i = n - 1;
        while (i > 0) {
            int j = this.NextIntRange(0, i + 1);
            long tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            i = i - 1;
        }
    }

    /// 原地 Fisher–Yates 洗牌。长度 0 / 1 是 no-op。
    public void ShuffleString(string[] arr) {
        int n = arr.Length;
        int i = n - 1;
        while (i > 0) {
            int j = this.NextIntRange(0, i + 1);
            string tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            i = i - 1;
        }
    }

    /// 不放回抽 `k` 个，不改动 `arr`，返回新数组。结果本身已是随机顺序。
    /// @throws ArgumentException `k < 0` 或 `k > arr.Length`
    public int[] SampleInt(int[] arr, int k) {
        if (k < 0) throw new ArgumentException("SampleInt: k must be >= 0");
        if (k > arr.Length) throw new ArgumentException("SampleInt: k > arr.Length");
        // Copy arr → working buffer; partial Fisher–Yates first k positions.
        int n = arr.Length;
        int[] work = new int[n];
        int i = 0;
        while (i < n) { work[i] = arr[i]; i = i + 1; }
        // Swap each of the first k positions with a uniformly-random index
        // in [pos, n).
        int pos = 0;
        while (pos < k) {
            int j = this.NextIntRange(pos, n);
            int tmp = work[pos];
            work[pos] = work[j];
            work[j] = tmp;
            pos = pos + 1;
        }
        int[] result = new int[k];
        int r = 0;
        while (r < k) { result[r] = work[r]; r = r + 1; }
        return result;
    }

    /// 不放回抽 `k` 个，不改动 `arr`，返回新数组。结果本身已是随机顺序。
    /// @throws ArgumentException `k < 0` 或 `k > arr.Length`
    public string[] SampleString(string[] arr, int k) {
        if (k < 0) throw new ArgumentException("SampleString: k must be >= 0");
        if (k > arr.Length) throw new ArgumentException("SampleString: k > arr.Length");
        int n = arr.Length;
        string[] work = new string[n];
        int i = 0;
        while (i < n) { work[i] = arr[i]; i = i + 1; }
        int pos = 0;
        while (pos < k) {
            int j = this.NextIntRange(pos, n);
            string tmp = work[pos];
            work[pos] = work[j];
            work[j] = tmp;
            pos = pos + 1;
        }
        string[] result = new string[k];
        int r = 0;
        while (r < k) { result[r] = work[r]; r = r + 1; }
        return result;
    }

    /// 正态分布采样（Box–Muller）。一对均匀数只产出一个正态数。
    public double NextGaussian(double mean, double stddev) {
        double u = this.NextDouble();
        // Avoid log(0) — re-draw the rare zero (open-interval semantics).
        while (u == 0.0) { u = this.NextDouble(); }
        double v = this.NextDouble();
        double r = Math.Sqrt(-2.0 * Math.Log(u));
        double z = r * Math.Cos(Math.Tau * v);
        return mean + stddev * z;
    }

    /// 指数分布采样，`lambda` 是速率参数（均值 = `1 / lambda`）。
    /// @throws ArgumentException `lambda <= 0`
    public double NextExponential(double lambda) {
        if (lambda <= 0.0) {
            throw new ArgumentException(
                "Random.NextExponential: lambda must be > 0, got " + lambda.ToString());
        }
        double u = this.NextDouble();
        while (u == 0.0) { u = this.NextDouble(); }
        return -Math.Log(u) / lambda;
    }

}
