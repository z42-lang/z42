namespace Std.Random;
using Std;
using Std.Time;

// add-z42-random (2026-05-15)：通用伪随机数（PCG-XSH-RR 64→32 输出）。
//
// **不是 CSPRNG**：仅作 deterministic 测试 / fixture / 临时 ID 用。
// 安全场景请等 z42.crypto。
//
// 算法：PCG (Permuted Congruential Generator) — 状态 64-bit，
// 输出 32-bit by xor-shift-high + rotate-right。Wikipedia / pcg-random.org
// 参考实现等价。
public class Random {
    private long _state;

    // extend-z42-random (2026-06-03): per-instance increment for PCG
    // stream selection. Must be odd. Default 1442695040888963407 | 1
    // matches the historical hard-coded value, so a `Random(seed)`
    // built before this spec produces the same sequence.
    private long _inc;

    public Random() {
        // wall-clock seed — 同 C# new Random() default behaviour。
        long ms = DateTime.UtcNow().UnixMs();
        this.Init(ms, 1442695040888963407 | 1);
    }

    public Random(long seed) {
        this.Init(seed, 1442695040888963407 | 1);
    }

    /// extend-z42-random (2026-06-03): pick an independent PCG stream.
    /// `streamId | 1` becomes the per-instance increment. Two
    /// instances with the same seed but different streamId produce
    /// strictly disjoint sequences (PCG correctness guarantee).
    public Random(long seed, long streamId) {
        this.Init(seed, streamId | 1);
    }

    private void Init(long seed, long inc) {
        this._inc = inc;
        // PCG seed step: state starts as 0, increment + step once with the
        // user seed mixed in. Equivalent to pcg32_srandom_r(rng, seed, seq).
        this._state = 0;
        this.Step();
        this._state = this._state + seed;
        this.Step();
    }

    /// One PCG round: state advances; return 32-bit output (masked into low
    /// bits of a `long` since z42 has no `uint`). The full XSH-RR output
    /// fits in 32 bits but we keep it in i64 storage to make masking explicit.
    private long Step() {
        long oldState = this._state;
        // Multiplier from L'Ecuyer 1999 (PCG paper constant).
        long mul = 6364136223846793005;
        long inc = this._inc;
        this._state = oldState * mul + inc;
        // 32-bit mask. Decimal literal since z42 hex literal support is TBD.
        long MASK32 = 4294967295;          // 0xFFFFFFFF
        // xorshift: ((state >> 18) ^ state) >> 27, masked to 32 bits.
        long shifted = (((oldState >> 18) ^ oldState) >> 27) & MASK32;
        // rotate-right by top 5 bits of state (0..31).
        int rot = (int)((oldState >> 59) & 31);
        // raw32 rotate-right: ((x >> rot) | (x << (32 - rot))) & MASK32.
        long result;
        if (rot == 0) {
            result = shifted;
        } else {
            result = ((shifted >> rot) | (shifted << (32 - rot))) & MASK32;
        }
        return result;
    }

    /// Full 64-bit random. Composed from two 32-bit steps.
    public long NextLong() {
        long high = this.Step();
        long low  = this.Step();
        return (high << 32) | low;
    }

    /// Random 32-bit int (returned as z42 i32; high bit may be set → negative).
    public int NextInt() {
        long raw32 = this.Step();
        long signBit = 2147483648;        // 0x80000000
        long wrap     = 4294967296;        // 0x100000000
        // Sign-extend the 32-bit value into i32: if bit 31 set, value is negative.
        if ((raw32 & signBit) != 0) {
            return (int)(raw32 - wrap);
        }
        return (int)raw32;
    }

    /// Uniformly distributed long in [min, max). Throws if max <= min.
    public long NextLongRange(long min, long max) {
        if (max <= min) {
            throw new ArgumentException("NextLongRange: max must be > min");
        }
        long span = max - min;
        // Modulo bias is negligible for span << 2^63; acceptable for L1.
        long raw = this.NextLong();
        // Ensure non-negative before modulo.
        if (raw < 0) { raw = raw + 9223372036854775807 + 1; }
        return min + (raw % span);
    }

    /// Uniformly distributed int in [min, max). Throws if max <= min.
    public int NextIntRange(int min, int max) {
        if (max <= min) {
            throw new ArgumentException("NextIntRange: max must be > min");
        }
        int span = max - min;
        long raw = this.Step();
        // `raw` is already in [0, 2^32) (masked low 32 bits); modulo is safe.
        return min + (int)(raw % (long)span);
    }

    /// Uniformly distributed double in [0.0, 1.0).
    public double NextDouble() {
        // Use top 53 bits (double mantissa width) for full precision.
        // shift right 11 to drop low bits AND clear sign — but `>>` in z42
        // is arithmetic shift on i64, so we explicitly mask after to be safe.
        long bits = this.NextLong();
        long mantissaMask = 9007199254740991;     // (1 << 53) - 1
        long unsigned53 = ((bits >> 11) & mantissaMask);
        return (double)unsigned53 / 9007199254740992.0;     // 1 / 2^53
    }

    /// Coin flip — true with probability 0.5.
    public bool NextBool() {
        return (this.Step() & 1) == 1;
    }

    // add-random-shuffle-sample (2026-05-27): collection helpers.
    //
    // `Shuffle` is in-place Fisher–Yates. `Sample` reservoir-style — picks
    // `k` items without replacement. For sequences whose length is unknown
    // ahead of time the standard reservoir algorithm; here we know
    // `arr.Length` so we use partial Fisher–Yates (O(k) swaps) which is
    // simpler + still uniform.

    /// In-place Fisher–Yates shuffle. Mutates `arr`. Empty / single-element
    /// arrays are no-ops. Distribution is uniform over the n! permutations
    /// (modulo the PCG output's modulo bias — negligible for n < 2^32).
    public void ShuffleInt(int[] arr) {
        int n = arr.Length;
        int i = n - 1;
        while (i > 0) {
            int j = this.NextIntRange(0, i + 1);
            int tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            i = i - 1;
        }
    }

    public void ShuffleLong(long[] arr) {
        int n = arr.Length;
        int i = n - 1;
        while (i > 0) {
            int j = this.NextIntRange(0, i + 1);
            long tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            i = i - 1;
        }
    }

    public void ShuffleString(string[] arr) {
        int n = arr.Length;
        int i = n - 1;
        while (i > 0) {
            int j = this.NextIntRange(0, i + 1);
            string tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            i = i - 1;
        }
    }

    /// Sample `k` distinct elements from `arr` (without replacement).
    /// Throws if `k > arr.Length` or `k < 0`. Order in result is shuffle
    /// order (i.e., uniformly random); `arr` is not mutated.
    public int[] SampleInt(int[] arr, int k) {
        if (k < 0) throw new ArgumentException("SampleInt: k must be >= 0");
        if (k > arr.Length) throw new ArgumentException("SampleInt: k > arr.Length");
        // Copy arr → working buffer; partial Fisher–Yates first k positions.
        int n = arr.Length;
        int[] work = new int[n];
        int i = 0;
        while (i < n) { work[i] = arr[i]; i = i + 1; }
        // Swap each of the first k positions with a uniformly-random index
        // in [pos, n).
        int pos = 0;
        while (pos < k) {
            int j = this.NextIntRange(pos, n);
            int tmp = work[pos];
            work[pos] = work[j];
            work[j] = tmp;
            pos = pos + 1;
        }
        int[] result = new int[k];
        int r = 0;
        while (r < k) { result[r] = work[r]; r = r + 1; }
        return result;
    }

    public string[] SampleString(string[] arr, int k) {
        if (k < 0) throw new ArgumentException("SampleString: k must be >= 0");
        if (k > arr.Length) throw new ArgumentException("SampleString: k > arr.Length");
        int n = arr.Length;
        string[] work = new string[n];
        int i = 0;
        while (i < n) { work[i] = arr[i]; i = i + 1; }
        int pos = 0;
        while (pos < k) {
            int j = this.NextIntRange(pos, n);
            string tmp = work[pos];
            work[pos] = work[j];
            work[j] = tmp;
            pos = pos + 1;
        }
        string[] result = new string[k];
        int r = 0;
        while (r < k) { result[r] = work[r]; r = r + 1; }
        return result;
    }

    // ── Distributions (extend-z42-random, 2026-06-03) ────────────────

    /// Normal / Gaussian sample via Box-Muller. Two uniform draws
    /// → one normal draw with the requested mean + standard deviation.
    /// The second normal draw from the same pair is discarded; for
    /// hot loops a future spec could cache it (`_gaussianPaired`).
    public double NextGaussian(double mean, double stddev) {
        double u = this.NextDouble();
        // Avoid log(0) — re-draw the rare zero (open-interval semantics).
        while (u == 0.0) { u = this.NextDouble(); }
        double v = this.NextDouble();
        double r = Math.Sqrt(-2.0 * Math.Log(u));
        double z = r * Math.Cos(Math.Tau * v);
        return mean + stddev * z;
    }

    /// Exponential sample via inverse CDF. `lambda` is the rate
    /// parameter (`mean == 1 / lambda`). Throws `ArgumentException`
    /// for `lambda <= 0`.
    public double NextExponential(double lambda) {
        if (lambda <= 0.0) {
            throw new ArgumentException(
                "Random.NextExponential: lambda must be > 0, got " + lambda.ToString());
        }
        double u = this.NextDouble();
        while (u == 0.0) { u = this.NextDouble(); }
        return -Math.Log(u) / lambda;
    }

}
