// Micro-benchmarks for z42.crypto hot paths — SHA-256 and BLAKE3 over small and
// multi-chunk (>1024B, exercises the BLAKE3 tree path — a past bug surface) inputs.
// Baseline data for the 0.4.x perf stream. Run via `z42 xtask.zpkg bench stdlib z42.crypto`.

namespace Z42CryptoBench;

using Std;
using Std.Crypto;

byte[] _mkPayload(int n) {
    byte[] data = new byte[n];
    int i = 0;
    while (i < n) { data[i] = (byte)(i % 251); i = i + 1; }
    return data;
}

[Benchmark]
void bench_sha256_small() {
    byte[] msg = _mkPayload(64);
    var b = new Bencher(2, 20);
    b.iter(() => {
        BenchHelpers.blackBox(Sha256.Hash(msg));
    });
    b.printSummary("sha256_small");
}

[Benchmark]
void bench_sha256_4k() {
    byte[] msg = _mkPayload(4096);
    var b = new Bencher(2, 10);
    b.iter(() => {
        BenchHelpers.blackBox(Sha256.Hash(msg));
    });
    b.printSummary("sha256_4k");
}

[Benchmark]
void bench_blake3_small() {
    byte[] msg = _mkPayload(64);
    var b = new Bencher(2, 20);
    b.iter(() => {
        BenchHelpers.blackBox(Blake3.Hash(msg));
    });
    b.printSummary("blake3_small");
}

[Benchmark]
void bench_blake3_4k_multichunk() {
    // >1024B input drives the multi-chunk tree path (fix-blake3-multichunk-root-flag).
    byte[] msg = _mkPayload(4096);
    var b = new Bencher(2, 10);
    b.iter(() => {
        BenchHelpers.blackBox(Blake3.Hash(msg));
    });
    b.printSummary("blake3_4k_multichunk");
}

// Smoke [Test] — bench bodies run.
[Test]
void test_crypto_bench_bodies_run() {
    var b = new Bencher(1, 3);
    byte[] msg = _mkPayload(8);
    b.iter(() => {
        BenchHelpers.blackBox(Sha256.Hash(msg));
    });
    Assert.Equal(3, b.Samples);
    Assert.True(b.TotalNs > 0L);
}

// perf-stdlib-hot-paths：AES 基准（此前无覆盖）。CBC 与 GCM 各 4 KB 往返；S-box 静态化前每 16 字节块
// 重建 S-box 约 11 次，是最热的纯脚本路径之一。
byte[] _mkKey(int n) {
    byte[] k = new byte[n];
    int i = 0;
    while (i < n) { k[i] = (byte)(i * 13 + 7); i = i + 1; }
    return k;
}

[Benchmark]
void bench_aes_cbc_roundtrip_4k() {
    byte[] key = _mkKey(16);
    byte[] iv = _mkKey(16);
    byte[] msg = _mkPayload(4096);
    var b = new Bencher(2, 10);
    b.iter(() => {
        byte[] ct = Aes.EncryptCbcPkcs7(key, iv, msg);
        BenchHelpers.blackBox(Aes.DecryptCbcPkcs7(key, iv, ct).Length);
    });
    b.printSummary("aes_cbc_roundtrip_4k");
}

[Benchmark]
void bench_aes_gcm_roundtrip_4k() {
    byte[] key = _mkKey(16);
    byte[] iv = _mkKey(12);
    byte[] aad = new byte[0];
    byte[] msg = _mkPayload(4096);
    var b = new Bencher(2, 10);
    b.iter(() => {
        byte[] ct = Aes.EncryptGcm(key, iv, aad, msg);
        BenchHelpers.blackBox(Aes.DecryptGcm(key, iv, aad, ct).Length);
    });
    b.printSummary("aes_gcm_roundtrip_4k");
}
