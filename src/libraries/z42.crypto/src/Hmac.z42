namespace Std.Crypto;

using Std.Encoding;

// HMAC-SHA256（RFC 2104），纯脚本实现于 `Sha256` 之上。算法：K' = len(K)>64 时 SHA256(K)，
// 否则 K 右补 0x00 到 64 字节；inner = SHA256((K' XOR 0x36×64) || msg)；HMAC = SHA256((K' XOR 0x5C×64) || inner)。
public static class HmacSha256 {
    // ── Public API ───────────────────────────────────────────────────────────

    /// 计算 `message` 在 `key` 下的 HMAC-SHA256，返回 32 字节摘要。
    public static byte[] Compute(byte[] key, byte[] message) {
        byte[] paddedKey = _padKey(key);

        // Inner: SHA256( (K' XOR ipad) || message )
        byte[] inner = new byte[64 + message.Length];
        int i = 0;
        while (i < 64) {
            inner[i] = (byte)((int)paddedKey[i] ^ 0x36);
            i = i + 1;
        }
        i = 0;
        while (i < message.Length) {
            inner[64 + i] = message[i];
            i = i + 1;
        }
        byte[] innerHash = Sha256.Hash(inner);

        // Outer: SHA256( (K' XOR opad) || innerHash )
        byte[] outer = new byte[64 + 32];
        i = 0;
        while (i < 64) {
            outer[i] = (byte)((int)paddedKey[i] ^ 0x5C);
            i = i + 1;
        }
        i = 0;
        while (i < 32) {
            outer[64 + i] = innerHash[i];
            i = i + 1;
        }
        return Sha256.Hash(outer);
    }

    /// 对 UTF-8 编码的字符串 key / message 计算 HMAC-SHA256（返回 32 字节）。
    public static byte[] ComputeString(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return Compute(keyBytes, msgBytes);
    }

    /// 计算 HMAC-SHA256 并输出小写十六进制（64 字符）。
    public static string ComputeHex(byte[] key, byte[] message) {
        return Hex.Encode(Compute(key, message));
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-SHA256 并输出小写十六进制。
    public static string ComputeStringHex(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return Hex.Encode(Compute(keyBytes, msgBytes));
    }

    // ── Internals ────────────────────────────────────────────────────────────

    // 把 key 归一化为 64 字节（SHA-256 块大小）：更长 → 先 SHA-256（32 字节）再补 0x00 到 64；
    // 更短 → 右补 0x00；恰好 → 防御性拷贝（XOR 填充会改动缓冲区）。
    static byte[] _padKey(byte[] key) {
        byte[] padded = new byte[64];
        if (key.Length > 64) {
            byte[] digest = Sha256.Hash(key);
            int i = 0;
            while (i < 32) {
                padded[i] = digest[i];
                i = i + 1;
            }
            // bytes [32..63] already 0 from `new byte[64]`
        } else {
            int i = 0;
            while (i < key.Length) {
                padded[i] = key[i];
                i = i + 1;
            }
            // bytes [key.Length..63] already 0
        }
        return padded;
    }
}

// HMAC-SHA-1（RFC 2104），布局与 HmacSha256 相同。块大小 64（与 SHA-256 同），摘要 20 字节。
// ⚠️ 仅当旧系统互操作要求时使用（TOTP RFC 6238 默认、AWS Signature V2 等），新设计用 HMAC-SHA-256。
public static class HmacSha1 {
    /// 计算 `message` 在 `key` 下的 HMAC-SHA1，返回 20 字节摘要。
    public static byte[] Compute(byte[] key, byte[] message) {
        return _computeCore(key, message);
    }

    static byte[] _computeCore(byte[] key, byte[] message) {
        byte[] paddedKey = _padKey(key);

        // Inner: SHA1( (K' XOR ipad) || message )
        byte[] inner = new byte[64 + message.Length];
        int i = 0;
        while (i < 64) {
            inner[i] = (byte)((int)paddedKey[i] ^ 0x36);
            i = i + 1;
        }
        i = 0;
        while (i < message.Length) {
            inner[64 + i] = message[i];
            i = i + 1;
        }
        byte[] innerHash = Sha1.Hash(inner);

        // Outer: SHA1( (K' XOR opad) || innerHash )  (20-byte inner digest)
        byte[] outer = new byte[64 + 20];
        i = 0;
        while (i < 64) {
            outer[i] = (byte)((int)paddedKey[i] ^ 0x5C);
            i = i + 1;
        }
        i = 0;
        while (i < 20) {
            outer[64 + i] = innerHash[i];
            i = i + 1;
        }
        return Sha1.Hash(outer);
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-SHA1。
    public static byte[] ComputeString(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return _computeCore(keyBytes, msgBytes);
    }

    /// 计算 HMAC-SHA1 并输出小写十六进制。
    public static string ComputeHex(byte[] key, byte[] message) {
        return Hex.Encode(_computeCore(key, message));
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-SHA1 并输出小写十六进制。
    public static string ComputeStringHex(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return Hex.Encode(_computeCore(keyBytes, msgBytes));
    }

    // 把 key 归一化为 64 字节：更长 → 先 SHA-1（20 字节）再补 0x00 到 64；更短 → 右补 0x00。
    static byte[] _padKey(byte[] key) {
        byte[] padded = new byte[64];
        if (key.Length > 64) {
            byte[] digest = Sha1.Hash(key);
            int i = 0;
            while (i < 20) {
                padded[i] = digest[i];
                i = i + 1;
            }
        } else {
            int i = 0;
            while (i < key.Length) {
                padded[i] = key[i];
                i = i + 1;
            }
        }
        return padded;
    }
}

// HMAC-SHA-512（RFC 2104）。块大小 128（SHA-256 为 64），摘要 64 字节。
public static class HmacSha512 {
    /// 计算 `message` 在 `key` 下的 HMAC-SHA512，返回 64 字节摘要。
    public static byte[] Compute(byte[] key, byte[] message) {
        return HmacSha512._computeCore(key, message);
    }

    static byte[] _computeCore(byte[] key, byte[] message) {
        byte[] paddedKey = HmacSha512._padKey(key);

        // Inner: SHA512( (K' XOR ipad 128 bytes) || message )
        byte[] inner = new byte[128 + message.Length];
        int i = 0;
        while (i < 128) {
            inner[i] = (byte)((int)paddedKey[i] ^ 0x36);
            i = i + 1;
        }
        i = 0;
        while (i < message.Length) {
            inner[128 + i] = message[i];
            i = i + 1;
        }
        byte[] innerHash = Sha512.Hash(inner);

        // Outer: SHA512( (K' XOR opad 128 bytes) || innerHash 64 bytes )
        byte[] outer = new byte[128 + 64];
        i = 0;
        while (i < 128) {
            outer[i] = (byte)((int)paddedKey[i] ^ 0x5C);
            i = i + 1;
        }
        i = 0;
        while (i < 64) {
            outer[128 + i] = innerHash[i];
            i = i + 1;
        }
        return Sha512.Hash(outer);
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-SHA512。
    public static byte[] ComputeString(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return HmacSha512._computeCore(keyBytes, msgBytes);
    }

    /// 计算 HMAC-SHA512 并输出小写十六进制。
    public static string ComputeHex(byte[] key, byte[] message) {
        return Hex.Encode(HmacSha512._computeCore(key, message));
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-SHA512 并输出小写十六进制。
    public static string ComputeStringHex(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return Hex.Encode(HmacSha512._computeCore(keyBytes, msgBytes));
    }

    // 把 key 归一化为 128 字节（SHA-512 块大小）：更长（>128）→ 先 SHA-512（64 字节）再补 0 到 128；
    // 更短 → 右补 0x00。
    static byte[] _padKey(byte[] key) {
        byte[] padded = new byte[128];
        if (key.Length > 128) {
            byte[] digest = Sha512.Hash(key);
            int i = 0;
            while (i < 64) {
                padded[i] = digest[i];
                i = i + 1;
            }
        } else {
            int i = 0;
            while (i < key.Length) {
                padded[i] = key[i];
                i = i + 1;
            }
        }
        return padded;
    }
}

// HMAC-SHA-384（RFC 2104）。块大小 128（与 HMAC-SHA-512 同），内部用 SHA-384 所以摘要 48 字节。
public static class HmacSha384 {
    /// 计算 `message` 在 `key` 下的 HMAC-SHA384，返回 48 字节摘要。
    public static byte[] Compute(byte[] key, byte[] message) {
        return HmacSha384._computeCore(key, message);
    }

    static byte[] _computeCore(byte[] key, byte[] message) {
        byte[] paddedKey = HmacSha384._padKey(key);

        byte[] inner = new byte[128 + message.Length];
        int i = 0;
        while (i < 128) {
            inner[i] = (byte)((int)paddedKey[i] ^ 0x36);
            i = i + 1;
        }
        i = 0;
        while (i < message.Length) {
            inner[128 + i] = message[i];
            i = i + 1;
        }
        byte[] innerHash = Sha384.Hash(inner);

        // Outer: SHA384( (K' XOR opad) || innerHash 48 bytes )
        byte[] outer = new byte[128 + 48];
        i = 0;
        while (i < 128) {
            outer[i] = (byte)((int)paddedKey[i] ^ 0x5C);
            i = i + 1;
        }
        i = 0;
        while (i < 48) {
            outer[128 + i] = innerHash[i];
            i = i + 1;
        }
        return Sha384.Hash(outer);
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-SHA384。
    public static byte[] ComputeString(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return HmacSha384._computeCore(keyBytes, msgBytes);
    }

    /// 计算 HMAC-SHA384 并输出小写十六进制。
    public static string ComputeHex(byte[] key, byte[] message) {
        return Hex.Encode(HmacSha384._computeCore(key, message));
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-SHA384 并输出小写十六进制。
    public static string ComputeStringHex(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return Hex.Encode(HmacSha384._computeCore(keyBytes, msgBytes));
    }

    // 与 HMAC-SHA-512 同用 128 字节块；长 key 先经 SHA-384（48 字节）再补 0。
    static byte[] _padKey(byte[] key) {
        byte[] padded = new byte[128];
        if (key.Length > 128) {
            byte[] digest = Sha384.Hash(key);
            int i = 0;
            while (i < 48) {
                padded[i] = digest[i];
                i = i + 1;
            }
        } else {
            int i = 0;
            while (i < key.Length) {
                padded[i] = key[i];
                i = i + 1;
            }
        }
        return padded;
    }
}

// HMAC-MD5（RFC 2104），HmacSha1 的纯脚本镜像——同为 64 字节块，MD5 摘要 16 字节。
// ⚠️ HMAC-MD5 作为 MAC 仍基本可用（Wang 碰撞攻击不直接扩展到 HMAC，外层 key 随机化了 H 状态），
// 但仅当协议强制（HTTP Digest-MD5 / CRAM-MD5 / APR1 / legacy SASL）时使用；新设计用 HMAC-SHA-256。
public static class HmacMd5 {
    /// 计算 `message` 在 `key` 下的 HMAC-MD5，返回 16 字节摘要。
    public static byte[] Compute(byte[] key, byte[] message) {
        return HmacMd5._computeCore(key, message);
    }

    static byte[] _computeCore(byte[] key, byte[] message) {
        byte[] paddedKey = HmacMd5._padKey(key);

        // Inner: MD5( (K' XOR ipad) || message )
        byte[] inner = new byte[64 + message.Length];
        int i = 0;
        while (i < 64) {
            inner[i] = (byte)((int)paddedKey[i] ^ 0x36);
            i = i + 1;
        }
        i = 0;
        while (i < message.Length) {
            inner[64 + i] = message[i];
            i = i + 1;
        }
        byte[] innerHash = Md5.Hash(inner);

        // Outer: MD5( (K' XOR opad) || innerHash 16 bytes )
        byte[] outer = new byte[64 + 16];
        i = 0;
        while (i < 64) {
            outer[i] = (byte)((int)paddedKey[i] ^ 0x5C);
            i = i + 1;
        }
        i = 0;
        while (i < 16) {
            outer[64 + i] = innerHash[i];
            i = i + 1;
        }
        return Md5.Hash(outer);
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-MD5。
    public static byte[] ComputeString(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return HmacMd5._computeCore(keyBytes, msgBytes);
    }

    /// 计算 HMAC-MD5 并输出小写十六进制。
    public static string ComputeHex(byte[] key, byte[] message) {
        return Hex.Encode(HmacMd5._computeCore(key, message));
    }

    /// 对 UTF-8 字符串 key / message 计算 HMAC-MD5 并输出小写十六进制。
    public static string ComputeStringHex(string key, string message) {
        byte[] keyBytes = Utf8.GetBytes(key);
        byte[] msgBytes = Utf8.GetBytes(message);
        return Hex.Encode(HmacMd5._computeCore(keyBytes, msgBytes));
    }

    // 把 key 归一化为 64 字节（MD5 块大小）：更长 → Md5(key)（16 字节）再补 0 到 64；更短 → 右补 0x00。
    static byte[] _padKey(byte[] key) {
        byte[] padded = new byte[64];
        if (key.Length > 64) {
            byte[] digest = Md5.Hash(key);
            int i = 0;
            while (i < 16) {
                padded[i] = digest[i];
                i = i + 1;
            }
        } else {
            int i = 0;
            while (i < key.Length) {
                padded[i] = key[i];
                i = i + 1;
            }
        }
        return padded;
    }
}
