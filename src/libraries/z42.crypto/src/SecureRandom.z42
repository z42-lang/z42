namespace Std.Crypto;


// OS 支撑的密码学安全随机数发生器。原始熵抽头 `__crypto_random_bytes` 已迁移到核心
// `Std.Runtime.Entropy`（跨切面原语，供 core 的 Guid.NewGuid 复用）；SecureRandom 委托到那里
// （单一声明点），本类保持安全语义门面（rejection sampling、有界整数）。
// **用这里生成** session token、CSRF nonce、KDF salt、掩码密钥、口令等一切需要不可预测性的场合。
// **勿用 `Std.Random`**（PCG，确定性 PRNG，用于 fixture / 仿真 / 临时 ID）做安全用途。
// wasm32 抛 `Std.NotSupportedException`。
public static class SecureRandom {
    /// 从 OS CSPRNG 填充 n 字节（n ≥ 0）。
    public static byte[] GetBytes(int n) {
        if (n < 0) {
            throw new ArgumentException("n must be non-negative, got " + n.ToString());
        }
        return Entropy.GetBytes(n);
    }

    /// 整个 i32 范围均匀分布的随机 int（含负数）。由 4 个 CSPRNG 字节大端构建。
    public static int NextInt() {
        byte[] b = GetBytes(4);
        long r = (((long)b[0] & 0xFFL) << 24)
              | (((long)b[1] & 0xFFL) << 16)
              | (((long)b[2] & 0xFFL) << 8)
              |  ((long)b[3] & 0xFFL);
        return (int)r;
    }

    /// 整个 i64 范围均匀分布的随机 long，由 8 个 CSPRNG 字节大端构建。
    public static long NextLong() {
        byte[] b = GetBytes(8);
        long r = 0L;
        int i = 0;
        while (i < 8) {
            r = (r << 8) | ((long)b[i] & 0xFFL);
            i = i + 1;
        }
        return r;
    }

    /// [0, bound) 均匀分布的随机 int，用 rejection sampling 避免模偏差；bound ≤ 0 抛 `ArgumentException`。
    public static int NextU32Bounded(int bound) {
        if (bound <= 0) {
            throw new ArgumentException("bound must be positive, got " + bound.ToString());
        }
        // Two-step rejection sampling on raw u32:
        //   1. Compute the "fair zone" = floor(2^32 / bound) * bound.
        //   2. Sample u in [0, 2^32). If u >= zone, reject and resample.
        // Expected rejection rate < 50% when bound ≤ 2^31.
        long u32max_plus_one = 4294967296L;     // 2^32
        long zone = (u32max_plus_one / (long)bound) * (long)bound;
        while (true) {
            byte[] b = GetBytes(4);
            long u = (((long)b[0] & 0xFFL) << 24)
                  | (((long)b[1] & 0xFFL) << 16)
                  | (((long)b[2] & 0xFFL) << 8)
                  |  ((long)b[3] & 0xFFL);
            if (u < zone) {
                return (int)(u % (long)bound);
            }
        }
        throw new Exception("unreachable");
    }
}
