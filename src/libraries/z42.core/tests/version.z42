// add-guid-lazy-version (2026-09-03): Std.Version 单元测试。
namespace Z42VersionTests;

using Std.Test;
using Std;

[Test]
void test_two_component() {
    var v = new Version(1, 2);
    Assert.Equal(1, v.Major);
    Assert.Equal(2, v.Minor);
    Assert.Equal(-1, v.Build);
    Assert.Equal(-1, v.Revision);
    Assert.Equal("1.2", v.ToString());
}

[Test]
void test_four_component() {
    var v = new Version(1, 2, 3, 4);
    Assert.Equal(3, v.Build);
    Assert.Equal(4, v.Revision);
    Assert.Equal("1.2.3.4", v.ToString());
}

[Test]
void test_parse_three() {
    var v = Version.Parse("2.5.1");
    Assert.Equal(2, v.Major);
    Assert.Equal(5, v.Minor);
    Assert.Equal(1, v.Build);
    Assert.Equal(-1, v.Revision);
    Assert.Equal("2.5.1", v.ToString());
}

[Test]
void test_compare_ordering() {
    Assert.Equal(-1, new Version(1, 0).CompareTo(new Version(1, 1)));
    Assert.Equal(1, new Version(2, 0).CompareTo(new Version(1, 9)));
    Assert.Equal(0, new Version(1, 2, 3).CompareTo(new Version(1, 2, 3)));
    // an unset component (-1) sorts below a real 0 (BCL parity)
    Assert.Equal(-1, new Version(1, 0).CompareTo(new Version(1, 0, 0)));
}

[Test]
void test_equals() {
    Assert.True(new Version(1, 2, 3).Equals(new Version(1, 2, 3)));
    Assert.False(new Version(1, 2, 3).Equals(new Version(1, 2, 4)));
    Assert.False(new Version(1, 2).Equals(new Version(1, 2, 0)));
}

[Test]
void test_tryparse_bad_returns_null() {
    Assert.Null(Version.TryParse("abc"));
    Assert.Null(Version.TryParse("1"));
    Assert.Null(Version.TryParse("1.2.3.4.5"));
    Assert.Null(Version.TryParse("1.-2"));
    Assert.NotNull(Version.TryParse("1.2.3"));
}

[Test]
void test_ctor_negative_throws() {
    Assert.ThrowsAny(() => new Version(1, -1));
}
