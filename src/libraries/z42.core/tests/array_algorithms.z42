// library-review PR-D (2026-08-31): Array static algorithms —
// Sort / IndexOf / Copy / Fill / Reverse (generic static, C# System.Array parity).
namespace Z42CoreArrayAlgorithmsTests;

using Std;
using Std.Test;

[Test]
void test_indexof() {
    int[] xs = new int[]{ 3, 1, 4, 1, 5 };
    Assert.Equal(2, Array.IndexOf<int>(xs, 4));
    Assert.Equal(1, Array.IndexOf<int>(xs, 1));   // first match
    Assert.Equal(-1, Array.IndexOf<int>(xs, 9));
    string[] ss = new string[]{ "a", "b", "c" };
    Assert.Equal(1, Array.IndexOf<string>(ss, "b"));
}

[Test]
void test_reverse() {
    int[] xs = new int[]{ 1, 2, 3, 4 };
    Array.Reverse<int>(xs);
    Assert.Equal(4, xs[0]);
    Assert.Equal(3, xs[1]);
    Assert.Equal(2, xs[2]);
    Assert.Equal(1, xs[3]);
    int[] odd = new int[]{ 1, 2, 3 };
    Array.Reverse<int>(odd);
    Assert.Equal(3, odd[0]);
    Assert.Equal(2, odd[1]);   // middle fixed
    Assert.Equal(1, odd[2]);
}

[Test]
void test_fill() {
    int[] xs = new int[4];
    Array.Fill<int>(xs, 7);
    Assert.Equal(7, xs[0]);
    Assert.Equal(7, xs[3]);
}

[Test]
void test_copy() {
    int[] src = new int[]{ 10, 20, 30, 40 };
    int[] dst = new int[4];
    Array.Copy<int>(src, dst, 3);
    Assert.Equal(10, dst[0]);
    Assert.Equal(30, dst[2]);
    Assert.Equal(0, dst[3]);   // untouched
}

[Test]
void test_copy_out_of_range() {
    int[] src = new int[]{ 1, 2 };
    int[] dst = new int[2];
    Assert.ThrowsAny(() => Array.Copy<int>(src, dst, 5));
}

[Test]
void test_sort_default() {
    int[] xs = new int[]{ 3, 1, 4, 1, 5, 9, 2, 6 };
    Array.Sort<int>(xs);
    Assert.Equal(1, xs[0]);
    Assert.Equal(1, xs[1]);
    Assert.Equal(2, xs[2]);
    Assert.Equal(9, xs[7]);
    string[] ss = new string[]{ "banana", "apple", "cherry" };
    Array.Sort<string>(ss);
    Assert.Equal("apple", ss[0]);
    Assert.Equal("banana", ss[1]);
    Assert.Equal("cherry", ss[2]);
}

[Test]
void test_sort_comparator_descending() {
    int[] xs = new int[]{ 3, 1, 4, 1, 5 };
    Array.Sort<int>(xs, (a, b) => b - a);   // descending
    Assert.Equal(5, xs[0]);
    Assert.Equal(4, xs[1]);
    Assert.Equal(3, xs[2]);
    Assert.Equal(1, xs[3]);
    Assert.Equal(1, xs[4]);
}

// add-array-paired-sort：配对排序 Sort<TKey,TValue>(keys, items)——按 keys 升序，items 同步换位。
// 与 comparator Sort<T>(arr, Func) 同为 2 参、仅类型参数个数不同：泛型 arity 重载过滤区分二者
// （`Sort<int>(arr, lambda)` 绑 comparator；`Sort<int,string>(keys, items)` 绑配对）。
[Test]
void test_sort_paired() {
    int[] keys = new int[]{ 3, 1, 4, 1, 5 };
    string[] items = new string[]{ "c", "a", "d", "A", "e" };
    Array.Sort<int, string>(keys, items);
    Assert.Equal(1, keys[0]); Assert.Equal(1, keys[1]);
    Assert.Equal(3, keys[2]); Assert.Equal(4, keys[3]); Assert.Equal(5, keys[4]);
    // items 随 keys 换位（stable：两个 key=1 保持原相对序 "a" 先于 "A"）
    Assert.Equal("a", items[0]); Assert.Equal("A", items[1]);
    Assert.Equal("c", items[2]); Assert.Equal("d", items[3]); Assert.Equal("e", items[4]);
}

[Test]
void test_sort_paired_noop_small() {
    int[] keys = new int[]{ 7 };
    string[] items = new string[]{ "x" };
    Array.Sort<int, string>(keys, items);   // n<2 no-op
    Assert.Equal(7, keys[0]); Assert.Equal("x", items[0]);
}

[Test]
void test_sort_stable_small() {
    int[] xs = new int[]{ 2, 1 };
    Array.Sort<int>(xs);
    Assert.Equal(1, xs[0]);
    Assert.Equal(2, xs[1]);
    int[] one = new int[]{ 42 };
    Array.Sort<int>(one);   // n<2 no-op
    Assert.Equal(42, one[0]);
}
