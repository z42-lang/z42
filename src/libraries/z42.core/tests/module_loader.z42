// Std.Runtime.ModuleLoader：按 FQN 实例化 / 调用，以及加载失败的形状。
// 真实的跨包加载（编译器组件、hooks、analyzer zpkg）由 z42b / REPL / z42c.pipeline 的用例覆盖。
namespace Z42CoreModuleLoaderTests;

using Std.Harness;


public class Probe {
    public int V;
    public Probe() { this.V = 7; }
}

int answer() { return 42; }

public class Holder {
    public static Probe Value = new Probe();
    public static Probe Empty = null;
}

[Test]
void test_create_known_type() {
    object o = ModuleLoader.Create("Z42CoreModuleLoaderTests.Probe");
    Assert.NotNull(o);
    Probe p = o as Probe;
    Assert.NotNull(p);
    Assert.Equal(7, p.V);
}

[Test]
void test_create_unknown_type_is_null() {
    Assert.Null(ModuleLoader.Create("No.Such.Namespace.NoSuchType"));
}

[Test]
void test_invoke_free_function_by_fqn() {
    object r = ModuleLoader.Invoke("Z42CoreModuleLoaderTests.answer");
    Assert.Equal(42, (int)r);
}

[Test]
void test_load_missing_path_throws() {
    bool threw = false;
    try { ModuleLoader.Load("/no/such/dir/no_such_module.zpkg"); } catch (Exception e) { threw = true; }
    Assert.True(threw);
}

public static class LoadProbe {
    public static int Count = 0;
}

// 加载一个模块不得动调用方已有的静态状态（此前 `__load_module` 每次加载后把 VM 里全部静态字段清零，
// 已初始化过的类型不会再跑初始化器 ⇒ 读回 0 / null）。加载对象取搜索路径里的 z42.core.zpkg（必然存在）。
[Test]
void test_load_keeps_static_state() {
    LoadProbe.Count = 5;
    string[] dirs = ModuleSearch.Dirs();
    bool loaded = false;
    int i = 0;
    while (i < dirs.Length && !loaded) {
        try { ModuleLoader.Load(dirs[i] + "/z42.core.zpkg"); loaded = true; } catch (Exception e) { }
        i = i + 1;
    }
    Assert.True(loaded);
    Assert.Equal(5, LoadProbe.Count);
}

bool _has(string[] a, string name) {
    int i = 0;
    while (i < a.Length) { if (a[i] == name) { return true; } i = i + 1; }
    return false;
}

[Test]
void test_member_names_of_static_value() {
    Assert.NotNull(Holder.Value);   // 只读已存的值：先让 Holder 的静态初始化跑过
    string[] m = ModuleLoader.MemberNamesOfStaticValue("Z42CoreModuleLoaderTests.Holder.Value");
    Assert.True(_has(m, "V"));
}

[Test]
void test_member_names_of_null_or_missing_static_is_empty() {
    Assert.Equal(0, ModuleLoader.MemberNamesOfStaticValue("Z42CoreModuleLoaderTests.Holder.Empty").Length);
    Assert.Equal(0, ModuleLoader.MemberNamesOfStaticValue("Z42CoreModuleLoaderTests.Holder.Nope").Length);
}
