// Std.Runtime.AppProperties 的「无 app 侧车」一档：属性面的每个方法都给出"空"的合理答案，
// 不抛异常、不报错——「没有属性」是绝大多数工程的常态。
// 有侧车时的完整链路（基表 / profile 覆盖 / 数组 / 嵌套表）由 Rust 侧单测覆盖：
// 那需要一个带 [properties] 的工程 + build，超出单文件用例的形态。
namespace Z42CoreAppPropertiesTests;

[Test]
void test_absent_property_lookups_are_empty() {
    Assert.Null(AppProperties.Get("anything"));
    Assert.False(AppProperties.Has("anything"));
    Assert.Equal(0, AppProperties.Names().Length);
    Assert.Null(AppProperties.Raw());
}

[Test]
void test_get_or_default_falls_back_when_absent() {
    Assert.Equal("fallback", AppProperties.GetOrDefault("anything", "fallback"));
}
