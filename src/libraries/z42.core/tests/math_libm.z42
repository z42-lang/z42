// z42.core 库本地测试 — Math 的 libm native 绑定专测。
//
// core-test-completeness 程序（2026-09-01, session 4）：此前 libm 绑定
// （Sqrt/Log/Log10/Sin/Cos/Tan/Atan2/Exp）零 `[Test]` 覆盖——只有
// e2e `tests/math/source.z42` 覆盖了 AbsInt/MaxInt/MinInt/Pow/Floor/
// Ceiling/Round。本文件补齐 8 个纯 native libm 绑定的往返/已知值断言。
//
// ⚠️ libm 返回 double，用 EqualApprox 断浮点容差（不用 Assert.Equal 精确）。
namespace Z42CoreMathLibmTests;

using Std;
using Std.Test;

// ── Sqrt ─────────────────────────────────────────────────────────────────
[Test]
void test_sqrt() {
    Assert.EqualApprox(4.0, Math.Sqrt(16.0), 1e-12);
    Assert.EqualApprox(0.0, Math.Sqrt(0.0), 1e-12);
    Assert.EqualApprox(1.4142135623730951, Math.Sqrt(2.0), 1e-12);
    // Sqrt ∘ Pow 往返：sqrt(x^2) == x（正数）
    Assert.EqualApprox(7.0, Math.Sqrt(Math.Pow(7.0, 2.0)), 1e-9);
}

// ── Log（自然对数）─────────────────────────────────────────────────────────
[Test]
void test_log() {
    Assert.EqualApprox(0.0, Math.Log(1.0), 1e-12);       // ln 1 == 0
    Assert.EqualApprox(1.0, Math.Log(Math.E), 1e-12);    // ln e == 1
    // Log ∘ Exp 互逆
    Assert.EqualApprox(3.5, Math.Log(Math.Exp(3.5)), 1e-9);
}

// ── Log10 ──────────────────────────────────────────────────────────────────
[Test]
void test_log10() {
    Assert.EqualApprox(0.0, Math.Log10(1.0), 1e-12);
    Assert.EqualApprox(3.0, Math.Log10(1000.0), 1e-12);
    Assert.EqualApprox(-2.0, Math.Log10(0.01), 1e-12);
}

// ── Exp ────────────────────────────────────────────────────────────────────
[Test]
void test_exp() {
    Assert.EqualApprox(1.0, Math.Exp(0.0), 1e-12);           // e^0 == 1
    Assert.EqualApprox(Math.E, Math.Exp(1.0), 1e-12);        // e^1 == e
    Assert.EqualApprox(7.38905609893065, Math.Exp(2.0), 1e-9);
}

// ── Sin / Cos / Tan ────────────────────────────────────────────────────────
[Test]
void test_sin() {
    Assert.EqualApprox(0.0, Math.Sin(0.0), 1e-12);
    Assert.EqualApprox(1.0, Math.Sin(Math.Pi / 2.0), 1e-12);
    Assert.EqualApprox(0.0, Math.Sin(Math.Pi), 1e-9);        // ~0，浮点残差
}

[Test]
void test_cos() {
    Assert.EqualApprox(1.0, Math.Cos(0.0), 1e-12);
    Assert.EqualApprox(0.0, Math.Cos(Math.Pi / 2.0), 1e-9);
    Assert.EqualApprox(-1.0, Math.Cos(Math.Pi), 1e-12);
}

[Test]
void test_tan() {
    Assert.EqualApprox(0.0, Math.Tan(0.0), 1e-12);
    Assert.EqualApprox(1.0, Math.Tan(Math.Pi / 4.0), 1e-9);
}

// ── Atan2 ──────────────────────────────────────────────────────────────────
[Test]
void test_atan2() {
    Assert.EqualApprox(0.0, Math.Atan2(0.0, 1.0), 1e-12);           // 正 x 轴
    Assert.EqualApprox(Math.Pi / 4.0, Math.Atan2(1.0, 1.0), 1e-12); // 第一象限对角
    Assert.EqualApprox(Math.Pi / 2.0, Math.Atan2(1.0, 0.0), 1e-12); // 正 y 轴
    Assert.EqualApprox(Math.Pi, Math.Atan2(0.0, -1.0), 1e-12);      // 负 x 轴
}

// ── 三角恒等式（跨绑定组合，回归护栏）───────────────────────────────────────
[Test]
void test_sin_cos_pythagorean() {
    // sin²θ + cos²θ == 1
    var t = 0.9;
    var s = Math.Sin(t);
    var c = Math.Cos(t);
    Assert.EqualApprox(1.0, s * s + c * c, 1e-12);
}
