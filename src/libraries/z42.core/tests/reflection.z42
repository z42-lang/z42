// add-reflection-mvp (2026-06-08): read-only reflection over GetType().
// Covers Type handle → GetFields/GetMethods/BaseType/GetGenericArguments and
// the Std.Reflection.{FieldInfo,MethodInfo,ParameterInfo} member objects.
namespace Z42CoreReflectionTests;

using Std;
using Std.Test;
using Std.Reflection;

class Base {
    public int a;
}

class Derived : Base {
    public int b;

    public int Add(int x, int y) {
        return x + y;
    }

    public static int Helper() {
        return 42;
    }
}

class Box<T> {
    public T value;
}

// plan-generic-reflection G1: MakeGenericType + runtime constraint validation.
interface IEntity {
    int Id();
}
class UserEntity : IEntity {
    public int Id() { return 1; }
}
class Repo<T> where T: IEntity {
    public T current;
}

// add-reflection-properties: GetProperties() derives PropertyInfo from the
// get_/set_ accessor convention.
class PropHolder {
    public int Size { get; set; }   // read-write → get_Size + set_Size
    public string Tag { get; }      // read-only  → get_Tag only
}

class PropChild : PropHolder {
    public bool Active { get; set; }
}

// add-reflection-type-flags: Type.IsAbstract / IsSealed reflect class modifiers.
abstract class AbstractThing {
    public int n;
}

sealed class SealedThing {
    public int n;
}

// add-reflection-value-record-flags: struct → IsValueType, record → IsRecord.
struct ValueThing {
    public int v;
}

record RecordThing(int a, int b);

// add-reflection-static-fields: GetFields() includes static fields + IsStatic.
class FieldHolder {
    public int instanceVal;
    public static int staticVal;
}

// add-field-attribute-reflection: field-level user attributes.
class FieldTag : Attribute {   // unqualified (via `using Std`) — qualified `Std.Attribute` base trips a typechecker FQN-upcast gap, see reflection.md Deferred
    public string Note;
    public FieldTag(string note) { this.Note = note; }
}

class TaggedFields {
    [FieldTag("hot")] public int marked;
    public int unmarked;
}

// add-parameter-attribute-reflection: parameter-level user attributes.
class TaggedParams {
    public void Op([FieldTag("first")] int a, int b, [FieldTag("third")] string c) { }
}

// add-member-visibility (unify P1-b): FieldInfo/MethodInfo IsPublic/IsPrivate
// reflect the declared member modifier (protected → neither).
class VisibilityHolder {
    public int pubField;
    private int privField;
    protected int protField;
    public void PubMethod() { }
    private void PrivMethod() { }
}

// add-method-modifiers (unify P1-c): MethodInfo.IsVirtual (authoritative) / IsAbstract.
abstract class Shape {
    public virtual int Area() { return 0; }
    public abstract int Perimeter();
    public int Sides() { return 4; }
}
class Square : Shape {
    public override int Area() { return 1; }
    public override int Perimeter() { return 4; }
}

// add-delegate-metadata (unify P1-e②): delegate-as-class → Type.IsDelegate +
// synthesized Invoke carries the signature.
delegate int Adder(int addA, int addB);

// add-param-metadata (unify P1-d): ParameterInfo.IsOptional/IsParams/Name/DefaultValue.
class ParamHolder {
    public int Blend(int width, int height = 10, string label = "hi", bool flag = true) { return width; }
    public int Sum(int seed, params int[] rest) { return seed; }
}

// add-interface-member-reflection: typeof(IFace).GetMethods() surfaces the
// interface's declared method signatures.
interface IShape {
    double Area();
    void Scale(double factor);
}
interface IExtendedShape : IShape {
    void Reset();
}

[Test]
void test_gettype_name_and_fullname() {
    Derived d = new Derived();
    Type t = d.GetType();
    Assert.Equal("Derived", t.Name);
    Assert.Equal("Z42CoreReflectionTests.Derived", t.FullName);
}

// align-type-memberinfo-hierarchy: Type : MemberInfo.
[Test]
void test_type_is_memberinfo() {
    Type t = typeof(Derived);
    Assert.True(t is MemberInfo);
    // Name resolves via the inherited MemberInfo field (no native getter)
    MemberInfo m = t;
    Assert.Equal("Derived", m.Name);
    Assert.Equal("Derived", t.Name);
    // GetType() instances are MemberInfo too
    Derived d = new Derived();
    Assert.True(d.GetType() is MemberInfo);
}

[Test]
void test_getfields_includes_inherited() {
    Derived d = new Derived();
    FieldInfo[] fields = d.GetType().GetFields();
    bool hasA = false;
    bool hasB = false;
    foreach (var f in fields) {
        if (f.Name == "a") { hasA = true; }
        if (f.Name == "b") { hasB = true; }
    }
    Assert.True(hasA);
    Assert.True(hasB);
}

[Test]
void test_field_type_is_type_object() {
    Derived d = new Derived();
    foreach (var f in d.GetType().GetFields()) {
        if (f.Name == "a") {
            Type ft = f.FieldType;
            Assert.Equal("int", ft.Name);
        }
    }
}

[Test]
void test_basetype() {
    Derived d = new Derived();
    Type t = d.GetType();
    Type bt = t.BaseType;
    Assert.Equal("Base", bt.Name);
}

[Test]
void test_getmethods_add_signature() {
    Derived d = new Derived();
    bool hasAdd = false;
    foreach (var m in d.GetType().GetMethods()) {
        if (m.Name == "Add") {
            hasAdd = true;
            Type rt = m.ReturnType;
            Assert.Equal("int", rt.Name);
            Assert.Equal(2, m.GetParameters().Length);
        }
    }
    Assert.True(hasAdd);
}

[Test]
void test_method_is_static_flag() {
    Derived d = new Derived();
    foreach (var m in d.GetType().GetMethods()) {
        if (m.Name == "Helper") { Assert.True(m.IsStatic); }
        if (m.Name == "Add") { Assert.False(m.IsStatic); }
    }
}

[Test]
void test_getmembers_combines_fields_and_methods() {
    Derived d = new Derived();
    MemberInfo[] members = d.GetType().GetMembers();
    // At least: fields a, b + methods Add, Helper (plus inherited Object methods).
    Assert.True(members.Length >= 4);
}

[Test]
void test_getmembers_includes_properties() {
    // members-include-properties: GetMembers() surfaces PropertyInfo alongside the
    // field/method members (mirrors C#). PropHolder has properties Size + Tag.
    Type t = typeof(PropHolder);
    MemberInfo[] members = t.GetMembers();
    bool sawSizeProp = false;
    bool sawTagProp = false;
    foreach (var m in members) {
        if (m is PropertyInfo) {
            if (m.Name == "Size") { sawSizeProp = true; }
            if (m.Name == "Tag") { sawTagProp = true; }
        }
    }
    Assert.True(sawSizeProp);
    Assert.True(sawTagProp);
}

[Test]
void test_interface_getmethods_declared() {
    // add-interface-member-reflection: typeof(IShape).GetMethods() returns the
    // interface's declared methods with correct signatures (abstract + virtual).
    Type t = typeof(IShape);
    MethodInfo[] methods = t.GetMethods();
    bool sawArea = false;
    bool sawScale = false;
    foreach (var m in methods) {
        if (m.Name == "Area") {
            sawArea = true;
            Assert.Equal("double", m.ReturnType.Name);
            Assert.Equal(0, m.GetParameters().Length);
            Assert.True(m.IsAbstract);
            Assert.True(m.IsVirtual);
        }
        if (m.Name == "Scale") {
            sawScale = true;
            Assert.Equal(1, m.GetParameters().Length);
        }
    }
    Assert.True(sawArea);
    Assert.True(sawScale);
}

[Test]
void test_interface_getmethods_declared_only() {
    // IExtendedShape : IShape — GetMethods returns only IExtendedShape's own method
    // (Reset), NOT inherited IShape methods (aligns with C#; those reached via
    // GetInterfaces() then each interface's GetMethods()).
    Type t = typeof(IExtendedShape);
    MethodInfo[] methods = t.GetMethods();
    bool sawReset = false;
    bool sawArea = false;
    foreach (var m in methods) {
        if (m.Name == "Reset") { sawReset = true; }
        if (m.Name == "Area") { sawArea = true; }
    }
    Assert.True(sawReset);
    Assert.False(sawArea);
}

[Test]
void test_make_generic_type_roundtrip() {
    // plan-generic-reflection G1: typeof(Box<>).MakeGenericType(int) == Box<int>.
    Type def = typeof(Box<int>).GetGenericTypeDefinition();   // open Box<>
    Type made = def.MakeGenericType(typeof(int));
    Type[] gargs = made.GetGenericArguments();
    Assert.Equal(1, gargs.Length);
    Assert.Equal("int", gargs[0].Name);
}

[Test]
void test_make_generic_constraint_satisfied() {
    // Repo<T> where T : IEntity; UserEntity implements IEntity → OK.
    Type def = typeof(Repo<UserEntity>).GetGenericTypeDefinition();
    Type made = def.MakeGenericType(typeof(UserEntity));
    Assert.Equal(1, made.GetGenericArguments().Length);
}

[Test]
void test_make_generic_constraint_violated_throws() {
    // int does NOT implement IEntity → MakeGenericType must throw (Q3 safety).
    Type def = typeof(Repo<UserEntity>).GetGenericTypeDefinition();
    Assert.ThrowsAny(() => def.MakeGenericType(typeof(int)));
}

[Test]
void test_make_generic_wrong_arg_count_throws() {
    Type def = typeof(Box<int>).GetGenericTypeDefinition();   // 1 type param
    Assert.ThrowsAny(() => def.MakeGenericType(typeof(int), typeof(bool)));
}

[Test]
void test_activator_constructed_carries_type_args() {
    // CreateInstance on a constructed generic Type reifies type_args onto the
    // instance → obj.GetType().GetGenericArguments() survives.
    Type made = typeof(Box<int>).GetGenericTypeDefinition().MakeGenericType(typeof(int));
    object o = Activator.CreateInstance(made);
    Type[] gargs = o.GetType().GetGenericArguments();
    Assert.Equal(1, gargs.Length);
    Assert.Equal("int", gargs[0].Name);
}

[Test]
void test_generic_arguments_best_effort() {
    Box<int> box = new Box<int>();
    Type[] args = box.GetType().GetGenericArguments();
    // Monomorphized TypeDesc carries type_args; when present, the first is int.
    // (Best-effort for MVP — see reflection.md.)
    if (args.Length == 1) {
        Assert.Equal("int", args[0].Name);
    }
}

[Test]
void test_getproperties_readwrite() {
    Type t = typeof(PropHolder);
    PropertyInfo[] props = t.GetProperties();
    bool found = false;
    foreach (var p in props) {
        if (p.Name == "Size") {
            found = true;
            Assert.True(p.CanRead);
            Assert.True(p.CanWrite);
            Type pt = p.PropertyType;   // local receiver (chained-getter footgun)
            Assert.Equal("int", pt.Name);
        }
    }
    Assert.True(found);
}

[Test]
void test_getproperties_readonly() {
    Type t = typeof(PropHolder);
    PropertyInfo[] props = t.GetProperties();
    bool found = false;
    foreach (var p in props) {
        if (p.Name == "Tag") {
            found = true;
            Assert.True(p.CanRead);
            Assert.False(p.CanWrite);
            Type pt = p.PropertyType;
            Assert.Equal("string", pt.Name);
        }
    }
    Assert.True(found);
}

[Test]
void test_getproperties_includes_inherited() {
    Type t = typeof(PropChild);
    PropertyInfo[] props = t.GetProperties();
    bool hasInheritedSize = false;
    bool hasOwnActive = false;
    foreach (var p in props) {
        if (p.Name == "Size") { hasInheritedSize = true; }
        if (p.Name == "Active") { hasOwnActive = true; }
    }
    Assert.True(hasInheritedSize);
    Assert.True(hasOwnActive);
}

// add-property-getvalue-setvalue: reflective read/write via get_/set_ accessors.

[Test]
void test_property_getvalue_setvalue_roundtrip() {
    PropHolder ph = new PropHolder();
    Type t = typeof(PropHolder);
    bool checkedSize = false;
    foreach (var p in t.GetProperties()) {
        if (p.Name == "Size") {
            checkedSize = true;
            Assert.Equal(0, (int) p.GetValue(ph));   // default
            p.SetValue(ph, 42);
            Assert.Equal(42, (int) p.GetValue(ph));  // written value read back
        }
    }
    Assert.True(checkedSize);
}

[Test]
void test_property_setvalue_readonly_throws() {
    PropHolder ph = new PropHolder();
    Type t = typeof(PropHolder);
    bool checkedTag = false;
    foreach (var p in t.GetProperties()) {
        if (p.Name == "Tag") {
            checkedTag = true;
            Assert.False(p.CanWrite);
            // read-only property: GetValue works, SetValue raises Std.Exception.
            p.GetValue(ph);
            Assert.ThrowsAny(() => p.SetValue(ph, "x"));
        }
    }
    Assert.True(checkedTag);
}

[Test]
void test_property_getvalue_setvalue_inherited() {
    PropChild pc = new PropChild();
    Type t = typeof(PropChild);
    bool checkedSize = false;
    foreach (var p in t.GetProperties()) {
        if (p.Name == "Size") {   // inherited from PropHolder
            checkedSize = true;
            p.SetValue(pc, 7);
            Assert.Equal(7, (int) p.GetValue(pc));
        }
    }
    Assert.True(checkedSize);
}

[Test]
void test_getproperties_empty_for_no_props() {
    // Base declares only a field (no get_/set_) → no properties.
    Type t = typeof(Base);
    PropertyInfo[] props = t.GetProperties();
    Assert.Equal(0, props.Length);
}

[Test]
void test_type_is_abstract() {
    Type ta = typeof(AbstractThing);
    Assert.True(ta.IsAbstract);
    Assert.False(ta.IsSealed);
    Type tp = typeof(Base);    // plain class
    Assert.False(tp.IsAbstract);
}

[Test]
void test_type_is_sealed() {
    Type ts = typeof(SealedThing);
    Assert.True(ts.IsSealed);
    Assert.False(ts.IsAbstract);
}

[Test]
void test_type_is_value_type() {
    Type tv = typeof(ValueThing);
    Assert.True(tv.IsValueType);
    Assert.False(tv.IsRecord);
    Type tc = typeof(Base);   // plain class
    Assert.False(tc.IsValueType);
}

[Test]
void test_type_is_record() {
    Type tr = typeof(RecordThing);
    Assert.True(tr.IsRecord);
    Assert.False(tr.IsValueType);
}

[Test]
void test_getfields_includes_static() {
    Type t = typeof(FieldHolder);
    FieldInfo[] fields = t.GetFields();
    bool sawInstance = false;
    bool sawStatic = false;
    foreach (var f in fields) {
        if (f.Name == "instanceVal") { sawInstance = true; Assert.False(f.IsStatic); }
        if (f.Name == "staticVal") { sawStatic = true; Assert.True(f.IsStatic); }
    }
    Assert.True(sawInstance);
    Assert.True(sawStatic);
}

[Test]
void test_getfields_hides_autoprop_backing() {
    // hide-autoprop-backing-field: PropHolder declares only auto-properties
    // (Size, Tag) — their synthesized `__prop_*` backing fields must NOT surface
    // in GetFields (mirrors C#'s hidden backing field). The properties are still
    // visible via GetProperties.
    Type t = typeof(PropHolder);
    FieldInfo[] fields = t.GetFields();
    foreach (var f in fields) {
        // no backing field leaks through
        Assert.False(f.Name == "__prop_Size");
        Assert.False(f.Name == "__prop_Tag");
    }
    // PropHolder has no real fields → GetFields is empty once backing fields hide.
    Assert.Equal(0, fields.Length);
}

[Test]
void test_field_custom_attributes() {
    Type t = typeof(TaggedFields);
    FieldInfo[] fields = t.GetFields();
    bool checkedMarked = false;
    foreach (var f in fields) {
        if (f.Name == "marked") {
            checkedMarked = true;
            Std.Attribute[] attrs = f.GetCustomAttributes();
            Assert.Equal(1, attrs.Length);
            FieldTag tag = (FieldTag) f.GetAttribute(typeof(FieldTag));
            Assert.Equal("hot", tag.Note);
        }
        if (f.Name == "unmarked") {
            Std.Attribute[] noneAttrs = f.GetCustomAttributes();
            Assert.Equal(0, noneAttrs.Length);
        }
    }
    Assert.True(checkedMarked);
}

[Test]
void test_param_custom_attributes() {
    Type t = typeof(TaggedParams);
    MethodInfo[] methods = t.GetMethods();
    bool checkedOp = false;
    foreach (var m in methods) {
        if (m.Name == "Op") {
            checkedOp = true;
            ParameterInfo[] ps = m.GetParameters();
            Assert.Equal(3, ps.Length);

            // param 0 (a): [FieldTag("first")]
            Std.Attribute[] a0 = ps[0].GetCustomAttributes();
            Assert.Equal(1, a0.Length);
            FieldTag g0 = (FieldTag) ps[0].GetAttribute(typeof(FieldTag));
            Assert.Equal("first", g0.Note);

            // param 1 (b): none
            Assert.Equal(0, ps[1].GetCustomAttributes().Length);

            // param 2 (c): [FieldTag("third")]
            FieldTag g2 = (FieldTag) ps[2].GetAttribute(typeof(FieldTag));
            Assert.Equal("third", g2.Note);
        }
    }
    Assert.True(checkedOp);
}

// add-enum-type-metadata (unify-type-metadata P1-a): enum 作类型实体 + 反射。
enum Palette {
    Red = 0,
    Green = 5,
    Blue = 6,
}

[Test]
void test_enum_is_enum() {
    Assert.True(typeof(Palette).IsEnum);
    Assert.Equal(false, typeof(Derived).IsEnum);
}

[Test]
void test_enum_get_names_values() {
    string[] names = Enum.GetNames(typeof(Palette));
    Assert.Equal(3, names.Length);
    Assert.Equal("Red", names[0]);
    Assert.Equal("Green", names[1]);
    Assert.Equal("Blue", names[2]);
    long[] vals = Enum.GetValues(typeof(Palette));
    Assert.Equal(3, vals.Length);
    Assert.True(vals[0] == 0);
    Assert.True(vals[1] == 5);
    Assert.True(vals[2] == 6);
}

[Test]
void test_enum_get_name() {
    Assert.Equal("Green", Enum.GetName(typeof(Palette), 5));
    Assert.Equal("", Enum.GetName(typeof(Palette), 99));
}

[Test]
void test_field_visibility() {
    VisibilityHolder h = new VisibilityHolder();
    bool sawPub = false; bool sawPriv = false; bool sawProt = false;
    foreach (var f in h.GetType().GetFields()) {
        if (f.Name == "pubField") { Assert.True(f.IsPublic); Assert.True(!f.IsPrivate); sawPub = true; }
        if (f.Name == "privField") { Assert.True(!f.IsPublic); Assert.True(f.IsPrivate); sawPriv = true; }
        if (f.Name == "protField") { Assert.True(!f.IsPublic); Assert.True(!f.IsPrivate); sawProt = true; }
    }
    Assert.True(sawPub);
    Assert.True(sawPriv);
    Assert.True(sawProt);
}

[Test]
void test_method_visibility() {
    VisibilityHolder h = new VisibilityHolder();
    bool sawPub = false; bool sawPriv = false;
    foreach (var m in h.GetType().GetMethods()) {
        if (m.Name == "PubMethod") { Assert.True(m.IsPublic); Assert.True(!m.IsPrivate); sawPub = true; }
        if (m.Name == "PrivMethod") { Assert.True(!m.IsPublic); Assert.True(m.IsPrivate); sawPriv = true; }
    }
    Assert.True(sawPub);
    Assert.True(sawPriv);
}

[Test]
void test_method_modifiers() {
    // typeof(abstract class) — 抽象类不能实例化，用 typeof 取句柄。
    bool sawArea = false; bool sawPerim = false; bool sawSides = false; bool sawToStr = false;
    foreach (var m in typeof(Shape).GetMethods()) {
        if (m.Name == "Area") { Assert.True(m.IsVirtual); Assert.True(!m.IsAbstract); sawArea = true; }
        if (m.Name == "Perimeter") { Assert.True(m.IsVirtual); Assert.True(m.IsAbstract); sawPerim = true; }
        if (m.Name == "Sides") { Assert.True(!m.IsVirtual); Assert.True(!m.IsAbstract); sawSides = true; }
        // 继承的 virtual extern 方法（Object.ToString）——extern 桩须带 virtual 位（否则误报 false）。
        if (m.Name == "ToString") { Assert.True(m.IsVirtual); Assert.True(!m.IsAbstract); sawToStr = true; }
    }
    Assert.True(sawArea);
    Assert.True(sawPerim);
    Assert.True(sawSides);
    Assert.True(sawToStr);
}

[Test]
void test_override_is_virtual_not_abstract() {
    Square sq = new Square();
    bool sawArea = false;
    foreach (var m in sq.GetType().GetMethods()) {
        if (m.Name == "Area") { Assert.True(m.IsVirtual); Assert.True(!m.IsAbstract); sawArea = true; }
    }
    Assert.True(sawArea);
}

[Test]
void test_param_metadata_optional_and_names() {
    ParamHolder h = new ParamHolder();
    bool sawBlend = false;
    foreach (var m in h.GetType().GetMethods()) {
        if (m.Name == "Blend") {
            ParameterInfo[] ps = m.GetParameters();
            Assert.Equal(4, ps.Length);
            // 参数名权威（SIGS，非 DBUG 猜测）
            Assert.Equal("width", ps[0].Name);
            Assert.Equal("height", ps[1].Name);
            Assert.Equal("label", ps[2].Name);
            Assert.Equal("flag", ps[3].Name);
            // IsOptional：width 必填，其余可选
            Assert.True(!ps[0].IsOptional);
            Assert.True(ps[1].IsOptional);
            Assert.True(ps[2].IsOptional);
            Assert.True(ps[3].IsOptional);
            sawBlend = true;
        }
    }
    Assert.True(sawBlend);
}

[Test]
void test_param_metadata_default_values() {
    ParamHolder h = new ParamHolder();
    foreach (var m in h.GetType().GetMethods()) {
        if (m.Name == "Blend") {
            ParameterInfo[] ps = m.GetParameters();
            Assert.True(ps[0].DefaultValue == null);        // 必填 → 无默认值
            Assert.Equal(10, (int)(long)ps[1].DefaultValue); // i64 默认值
            // 注：`as string` 对 boxed str 是 pre-existing VM 缺口（as_cast 只认 Object/Array/Null）
            // → 用 ToString 对账（值本身正确）。
            object dvs = ps[2].DefaultValue;
            Assert.Equal("hi", dvs.ToString());
            Assert.True((bool)ps[3].DefaultValue);
        }
    }
}

[Test]
void test_param_metadata_is_params() {
    ParamHolder h = new ParamHolder();
    bool sawSum = false;
    foreach (var m in h.GetType().GetMethods()) {
        if (m.Name == "Sum") {
            ParameterInfo[] ps = m.GetParameters();
            Assert.Equal(2, ps.Length);
            Assert.True(!ps[0].IsParams);
            Assert.True(ps[1].IsParams);
            Assert.Equal("rest", ps[1].Name);
            sawSum = true;
        }
    }
    Assert.True(sawSum);
}


[Test]
void test_delegate_metadata() {
    Type t = Type.GetType("Z42CoreReflectionTests.Adder");
    Assert.True(t != null);
    Assert.True(t.IsDelegate);
    Assert.True(!typeof(FieldHolder).IsDelegate);
    bool sawInvoke = false;
    foreach (var m in t.GetMethods()) {
        if (m.Name == "Invoke") {
            sawInvoke = true;
            Assert.True(m.IsVirtual);
            Type rt = m.ReturnType;
            Assert.Equal("int", rt.Name);
            ParameterInfo[] ps = m.GetParameters();
            Assert.Equal(2, ps.Length);
            Assert.Equal("addA", ps[0].Name);
            Assert.Equal("addB", ps[1].Name);
        }
    }
    Assert.True(sawInvoke);
}
