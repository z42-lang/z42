// symmetrize-primitive-api (2026-09-22)：把 primitive API 面补成对称的那一批新增。
//
// enforce-value-type-non-null（同日）：TryParse 全族签名从 `T? TryParse(string)` 改成
// `bool TryParse(string, ref T)` —— 值类型永不可空 ⇒ `T?` 不再存在。「可能没有」的值类型
// 结果按规约走 bool + ref 出参；失败路径写零值（约定，不是编译器保证，故逐条断言）。
// 原则是**每条都带一个对照组**——只断言「成功路径返回值对」会让「失败路径也返回值」
// 这类退化悄悄绿着（见 memory: 静默失败的特性会掩盖别的 bug）。
namespace Z42CoreSymmetrizePrimitiveApiTests;

using Std;
using Std.Test;

// ── 窄整型 TryParse：此前只有 Int32/Int64/Double 有 ──────────────────────────

[Test]
void test_sbyte_tryparse() {
    sbyte ok;
    Assert.Equal(true, SByte.TryParse("-128", ref ok));
    Assert.Equal(-128, (int)ok);
    sbyte bad;
    Assert.Equal(false, SByte.TryParse("128",  ref bad));   // 越上界
    Assert.Equal(false, SByte.TryParse("-129", ref bad));   // 越下界
    Assert.Equal(false, SByte.TryParse("x",    ref bad));   // 格式错
    Assert.Equal(0, (int)bad);                              // 失败写零值
}

[Test]
void test_int16_tryparse() {
    short ok;
    Assert.Equal(true, Int16.TryParse("32767", ref ok));
    Assert.Equal(32767, (int)ok);
    short bad;
    Assert.Equal(false, Int16.TryParse("32768",  ref bad));
    Assert.Equal(false, Int16.TryParse("-32769", ref bad));
}

[Test]
void test_byte_tryparse() {
    byte ok;
    Assert.Equal(true, Byte.TryParse("255", ref ok));
    Assert.Equal(255, (int)ok);
    byte bad;
    Assert.Equal(false, Byte.TryParse("256", ref bad));
    Assert.Equal(false, Byte.TryParse("-1",  ref bad));
}

[Test]
void test_uint16_tryparse() {
    ushort ok;
    Assert.Equal(true, UInt16.TryParse("65535", ref ok));
    Assert.Equal(65535, (int)ok);
    ushort bad;
    Assert.Equal(false, UInt16.TryParse("65536", ref bad));
}

[Test]
void test_uint32_tryparse() {
    uint ok;
    Assert.Equal(true, UInt32.TryParse("4294967295", ref ok));
    Assert.Equal(4294967295L, (long)ok);
    uint bad;
    Assert.Equal(false, UInt32.TryParse("4294967296", ref bad));
    Assert.Equal(false, UInt32.TryParse("-1",         ref bad));
}

[Test]
void test_uint64_tryparse() {
    ulong ok;
    Assert.Equal(true, UInt64.TryParse("12345", ref ok));
    Assert.Equal(12345L, (long)ok);
    ulong bad;
    Assert.Equal(false, UInt64.TryParse("-1",  ref bad));
    Assert.Equal(false, UInt64.TryParse("abc", ref bad));
}

// ── Single：此前连 Parse 都没有 ─────────────────────────────────────────────

[Test]
void test_single_parse_and_tryparse() {
    float v = Single.Parse("1.5");
    Assert.Equal(1.5, (double)v);
    float ok;
    Assert.Equal(true, Single.TryParse("-2.25", ref ok));
    Assert.Equal(-2.25, (double)ok);
    float bad;
    Assert.Equal(false, Single.TryParse("nope", ref bad));
    Assert.ThrowsAny(() => Single.Parse("nope"));
}

[Test]
void test_single_classification() {
    Assert.Equal(true,  Single.IsNaN(Single.NaN));
    Assert.Equal(false, Single.IsNaN(1.0f));
    Assert.Equal(true,  Single.IsInfinity(Single.PositiveInfinity));
    Assert.Equal(true,  Single.IsInfinity(Single.NegativeInfinity));
    Assert.Equal(false, Single.IsInfinity(1.0f));
    Assert.Equal(false, Single.IsInfinity(Single.NaN));          // NaN 不算 ∞
    Assert.Equal(true,  Single.IsPositiveInfinity(Single.PositiveInfinity));
    Assert.Equal(false, Single.IsPositiveInfinity(Single.NegativeInfinity));
    Assert.Equal(true,  Single.IsNegativeInfinity(Single.NegativeInfinity));
    Assert.Equal(true,  Single.IsFinite(1.0f));
    Assert.Equal(false, Single.IsFinite(Single.NaN));
    Assert.Equal(false, Single.IsFinite(Single.PositiveInfinity));
}

// NaN 全序：此前 Single.CompareTo 缺这段，含 NaN 的 float 排序与 double 不一致。
[Test]
void test_single_compareto_nan_total_order() {
    Assert.Equal(0,  Single.NaN.CompareTo(Single.NaN));      // NaN 只等于自己
    Assert.Equal(-1, Single.NaN.CompareTo(1.0f));            // NaN 排在非 NaN 之前
    Assert.Equal(1,  (1.0f).CompareTo(Single.NaN));
    Assert.Equal(-1, (1.0f).CompareTo(2.0f));                // 对照组：普通比较不受影响
    Assert.Equal(1,  (2.0f).CompareTo(1.0f));
    Assert.Equal(0,  (1.0f).CompareTo(1.0f));
}

// 与 Double 逐条对齐（这次补齐的意义就在于两者不再分叉）。
[Test]
void test_single_matches_double_nan_ordering() {
    Assert.Equal(Double.NaN.CompareTo(Double.NaN), Single.NaN.CompareTo(Single.NaN));
    Assert.Equal(Double.NaN.CompareTo(1.0),        Single.NaN.CompareTo(1.0f));
    Assert.Equal((1.0).CompareTo(Double.NaN),      (1.0f).CompareTo(Single.NaN));
}

// ── Boolean / Char 的 Parse / TryParse ──────────────────────────────────────

[Test]
void test_boolean_parse() {
    Assert.Equal(true,  Boolean.Parse("true"));
    Assert.Equal(false, Boolean.Parse("false"));
    Assert.Equal(true,  Boolean.Parse("  TRUE  "));   // 去空白 + 大小写不敏感
    Assert.Equal(false, Boolean.Parse("False"));
    Assert.ThrowsAny(() => Boolean.Parse("yes"));     // 严格契约：非 true/false 即抛
    Assert.ThrowsAny(() => Boolean.Parse(""));
}

[Test]
void test_boolean_tryparse() {
    bool ok;
    Assert.Equal(true, Boolean.TryParse("true", ref ok));
    Assert.Equal(true, ok);
    bool bad;
    Assert.Equal(false, Boolean.TryParse("yes", ref bad));
    Assert.Equal(false, bad);                               // 失败写零值
}

[Test]
void test_char_parse() {
    Assert.Equal('z', Char.Parse("z"));
    Assert.ThrowsAny(() => Char.Parse(""));     // 必须恰好一个字符
    Assert.ThrowsAny(() => Char.Parse("ab"));
}

[Test]
void test_char_tryparse() {
    char ok;
    Assert.Equal(true, Char.TryParse("q", ref ok));
    Assert.Equal('q', ok);
    char bad;
    Assert.Equal(false, Char.TryParse("ab", ref bad));
    Assert.Equal(false, Char.TryParse("",   ref bad));
}

// z42 的 char 是 32 位 Unicode 标量（非 C# 的 16 位 UTF-16 码元）→ 上界 0x10FFFF。
[Test]
void test_char_min_max_value() {
    Assert.Equal(0, (int)Char.MinValue);
    Assert.Equal(1114111, (int)Char.MaxValue);
}

// ── Convert 整数族补齐 + 三处改委托后行为不变 ───────────────────────────────

[Test]
void test_convert_integer_family_complete() {
    Assert.Equal(-128, (int)Convert.ToSByte("-128"));
    Assert.Equal(255,  (int)Convert.ToByte("255"));
    Assert.Equal(-32768, (int)Convert.ToInt16("-32768"));
    Assert.Equal(65535, (int)Convert.ToUInt16("65535"));
    Assert.Equal(4294967295L, (long)Convert.ToUInt32("4294967295"));
    Assert.Equal(12345L, (long)Convert.ToUInt64("12345"));
    // 对照组：越界仍抛（委托到 Parse 后范围检查没丢）。
    Assert.ThrowsAny(() => Convert.ToSByte("128"));
    Assert.ThrowsAny(() => Convert.ToUInt16("65536"));
}

[Test]
void test_convert_delegation_keeps_behavior() {
    Assert.Equal(1.5, (double)Convert.ToSingle("1.5"));
    Assert.Equal(true, Convert.ToBoolean(" TRUE "));
    Assert.Equal('x', Convert.ToChar("x"));
    Assert.ThrowsAny(() => Convert.ToBoolean("maybe"));
    Assert.ThrowsAny(() => Convert.ToChar("xy"));
}

// ── UInt64.ToString：已修（fix-narrow-prim-instance-dispatch）────────────────
[Test]
void test_uint64_tostring_above_i64_max() {
    // 2^63，恰好越过 i64::MAX 一步 —— 修复前打印成 -9223372036854775808。
    Assert.Equal("9223372036854775808", UInt64.Parse("9223372036854775808").ToString());
    // u64::MAX —— 修复前打印成 -1。
    Assert.Equal("18446744073709551615", UInt64.Parse("18446744073709551615").ToString());
}

// 接收者形态要全覆盖：真因是「静态类型丢了」，而显式标注 / 强制转换 / var 推断 / 直接调用
// 这四种形态到达发射端时的 `Z42ClassType.Name()` **拼写不同**（包装名 vs 关键字）。
// 实施中第一版只认关键字，前两种漏修而测试一度「部分绿」—— 故逐形态各钉一条。
[Test]
void test_uint64_tostring_all_receiver_shapes() {
    ulong declared = UInt64.Parse("18446744073709551615");        // 显式类型标注
    var inferred   = UInt64.Parse("18446744073709551615");        // var 推断
    Assert.Equal("18446744073709551615", declared.ToString());
    Assert.Equal("18446744073709551615", inferred.ToString());
    Assert.Equal("18446744073709551615", ((ulong)declared).ToString());   // 强制转换
    Assert.Equal("18446744073709551615", UInt64.Parse("18446744073709551615").ToString());  // 直接调用
}

[Test]
void test_uint64_tostring_lower_half_unchanged() {
    // 对照组：下半区间（<= i64::MAX）本来就对，确保修复没把整条路带偏。
    Assert.Equal("12345", UInt64.Parse("12345").ToString());
    Assert.Equal("9223372036854775807", UInt64.Parse("9223372036854775807").ToString());
}

// ── Single.GetHashCode：已修（同一个真因的第二个症状）──────────────────────
//
// 修复前 `float.GetHashCode()` 实际走的是 `Double.GetHashCode`（64 位折叠），
// Single.z42 里声明的 32 位位模式实现形同虚设。不违反哈希契约（等值仍等哈希），
// 但声明与实际不符，且 `Dictionary<float,…>` 的桶分布用的是另一套。
[Test]
void test_single_gethashcode_uses_single_impl() {
    float f = 1.5f;
    Assert.Equal(BitConverter.SingleToBits(1.5), f.GetHashCode());   // = Single 的 32 位位模式
}

[Test]
void test_double_gethashcode_unchanged() {
    // 对照组：Double 的哈希不受影响（它的运行期反推本来就对）。
    double d = 1.5;
    long bits = BitConverter.DoubleToBits(1.5);
    Assert.Equal((int)(bits ^ (bits >> 32)), d.GetHashCode());
}

// 两者必须**不同** —— 若哪天又塌回同一个实现，这条会红。
[Test]
void test_single_and_double_hash_now_differ() {
    float f = 1.5f;
    double d = 1.5;
    Assert.Equal(false, f.GetHashCode() == d.GetHashCode());
}

// ── 窄整型的其余实例方法：确认静态派发后语义不变（退回对照）─────────────────
[Test]
void test_narrow_int_instance_methods_still_correct() {
    byte b1 = Byte.Parse("42");
    byte b2 = Byte.Parse("42");
    byte b3 = Byte.Parse("43");
    Assert.Equal(true,  b1.Equals(b2));
    Assert.Equal(false, b1.Equals(b3));
    Assert.Equal(0,  b1.CompareTo(b2));
    Assert.Equal(-1, b1.CompareTo(b3));
    Assert.Equal("42", b1.ToString());
    short s1 = Int16.Parse("-1000");
    Assert.Equal("-1000", s1.ToString());
    Assert.Equal(true, s1.Equals(Int16.Parse("-1000")));
    long l1 = Int64.Parse("9999999999");
    Assert.Equal("9999999999", l1.ToString());
}
