// augment-corelib-parity (backlog #4): dogfood coverage for the new O(1)
// HashSet<T> — Add dedup / Contains / Remove / Count / Clear / ToArray and the
// UnionWith / IntersectWith / ExceptWith set operations. ToArray() order is NOT
// guaranteed (capacity scan, hash dependent), so assertions are order-independent
// (membership / sums / counts).
namespace Z42CoreHashSetTests;

using Std;
using Std.Test;
using Std.Collections;

[Test]
void test_add_dedup_and_count() {
    HashSet<int> s = new HashSet<int>();
    Assert.True(s.IsEmpty());
    Assert.True(s.Add(1));
    Assert.True(s.Add(2));
    Assert.True(s.Add(3));
    Assert.False(s.Add(2));   // duplicate -> false, no growth
    Assert.Equal(3, s.Count);
    Assert.False(s.IsEmpty());
}

[Test]
void test_contains_and_remove() {
    HashSet<int> s = new HashSet<int>();
    s.Add(10);
    s.Add(20);
    Assert.True(s.Contains(10));
    Assert.True(s.Contains(20));
    Assert.False(s.Contains(30));
    Assert.True(s.Remove(10));
    Assert.False(s.Contains(10));
    Assert.False(s.Remove(10));   // already gone
    Assert.Equal(1, s.Count);
}

[Test]
void test_string_elements() {
    HashSet<string> s = new HashSet<string>();
    s.Add("a");
    s.Add("bb");
    s.Add("a");   // dup
    Assert.Equal(2, s.Count);
    Assert.True(s.Contains("a"));
    Assert.True(s.Contains("bb"));
    Assert.False(s.Contains("c"));
}

[Test]
void test_grow_preserves_all() {
    // Force several grows (initial capacity 8, load-factor 0.75).
    HashSet<int> s = new HashSet<int>();
    int i = 0;
    while (i < 100) {
        s.Add(i);
        i = i + 1;
    }
    Assert.Equal(100, s.Count);
    int j = 0;
    bool allPresent = true;
    while (j < 100) {
        if (!s.Contains(j)) allPresent = false;
        j = j + 1;
    }
    Assert.True(allPresent);
    Assert.False(s.Contains(100));
}

[Test]
void test_clear_and_toarray() {
    HashSet<int> s = new HashSet<int>();
    s.Add(5);
    s.Add(7);
    s.Add(9);
    int[] arr = s.ToArray();
    Assert.Equal(3, arr.Length);
    int sum = 0;
    int i = 0;
    while (i < arr.Length) {
        sum = sum + arr[i];
        i = i + 1;
    }
    Assert.Equal(21, sum);   // 5+7+9, order-independent
    s.Clear();
    Assert.True(s.IsEmpty());
    Assert.Equal(0, s.ToArray().Length);
}

[Test]
void test_union_with() {
    HashSet<int> s = new HashSet<int>();
    s.Add(1);
    s.Add(2);
    int[] more = new int[3];
    more[0] = 2;   // overlaps
    more[1] = 3;
    more[2] = 4;
    s.UnionWith(more);
    Assert.Equal(4, s.Count);   // {1,2,3,4}
    Assert.True(s.Contains(3));
    Assert.True(s.Contains(4));
}

[Test]
void test_intersect_with() {
    HashSet<int> s = new HashSet<int>();
    s.Add(1);
    s.Add(2);
    s.Add(3);
    s.Add(4);
    int[] keep = new int[3];
    keep[0] = 2;
    keep[1] = 4;
    keep[2] = 9;   // not present, ignored
    s.IntersectWith(keep);
    Assert.Equal(2, s.Count);   // {2,4}
    Assert.True(s.Contains(2));
    Assert.True(s.Contains(4));
    Assert.False(s.Contains(1));
    Assert.False(s.Contains(3));
}

[Test]
void test_except_with() {
    HashSet<int> s = new HashSet<int>();
    s.Add(1);
    s.Add(2);
    s.Add(3);
    int[] drop = new int[2];
    drop[0] = 2;
    drop[1] = 5;   // not present, ignored
    s.ExceptWith(drop);
    Assert.Equal(2, s.Count);   // {1,3}
    Assert.True(s.Contains(1));
    Assert.True(s.Contains(3));
    Assert.False(s.Contains(2));
}
