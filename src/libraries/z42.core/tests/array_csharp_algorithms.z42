// add-array-csharp-algorithms (2026-09-02): Std.Array C# System.Array parity —
// predicate search / binary search / transform (generic static, pure script).
namespace Z42CoreArrayCsharpAlgorithmsTests;

using Std;
using Std.Test;

[Test]
void test_find_and_findlast() {
    int[] xs = new int[]{ 1, 2, 3, 4, 5 };
    Assert.Equal(4, Array.Find<int>(xs, (x) => x > 3));       // first > 3
    Assert.Equal(2, Array.Find<int>(xs, (x) => x % 2 == 0));  // first even
    Assert.Equal(4, Array.FindLast<int>(xs, (x) => x % 2 == 0)); // last even
    Assert.Equal(0, Array.Find<int>(xs, (x) => x > 100));     // no match → default(int)

    string[] ss = new string[]{ "apple", "banana", "cherry" };
    Assert.Equal("banana", Array.Find<string>(ss, (s) => s.Length > 5));
    Assert.Equal("cherry", Array.FindLast<string>(ss, (s) => s.Length > 5));
}

[Test]
void test_findindex_and_findlastindex() {
    int[] xs = new int[]{ 10, 20, 30, 20, 10 };
    Assert.Equal(1, Array.FindIndex<int>(xs, (x) => x == 20));
    Assert.Equal(3, Array.FindLastIndex<int>(xs, (x) => x == 20));
    Assert.Equal(-1, Array.FindIndex<int>(xs, (x) => x == 99));
    Assert.Equal(-1, Array.FindLastIndex<int>(xs, (x) => x == 99));
}

[Test]
void test_findall() {
    int[] xs = new int[]{ 1, 2, 3, 4, 5, 6 };
    int[] evens = Array.FindAll<int>(xs, (x) => x % 2 == 0);
    Assert.Equal(3, evens.Length);
    Assert.Equal(2, evens[0]);
    Assert.Equal(4, evens[1]);
    Assert.Equal(6, evens[2]);
    // no match → zero-length
    int[] none = Array.FindAll<int>(xs, (x) => x > 100);
    Assert.Equal(0, none.Length);
}

[Test]
void test_exists_and_trueforall() {
    int[] xs = new int[]{ 2, 4, 6, 8 };
    Assert.True(Array.Exists<int>(xs, (x) => x == 6));
    Assert.False(Array.Exists<int>(xs, (x) => x == 7));
    Assert.True(Array.TrueForAll<int>(xs, (x) => x % 2 == 0));
    Assert.False(Array.TrueForAll<int>(xs, (x) => x > 3));
    // empty: Exists false, TrueForAll vacuously true
    int[] empty = new int[0];
    Assert.False(Array.Exists<int>(empty, (x) => true));
    Assert.True(Array.TrueForAll<int>(empty, (x) => false));
}

[Test]
void test_binarysearch() {
    int[] xs = new int[]{ 1, 3, 5, 7, 9 };
    Assert.Equal(0, Array.BinarySearch<int>(xs, 1));
    Assert.Equal(2, Array.BinarySearch<int>(xs, 5));
    Assert.Equal(4, Array.BinarySearch<int>(xs, 9));
    // not found → ~insertionPoint
    Assert.Equal(-3, Array.BinarySearch<int>(xs, 4));   // insert at 2 → ~2 = -3
    Assert.Equal(-1, Array.BinarySearch<int>(xs, 0));   // insert at 0 → ~0 = -1
    Assert.Equal(-6, Array.BinarySearch<int>(xs, 10));  // insert at 5 → ~5 = -6
}

[Test]
void test_contains_and_lastindexof() {
    int[] xs = new int[]{ 5, 1, 5, 2, 5 };
    Assert.True(Array.Contains<int>(xs, 2));
    Assert.False(Array.Contains<int>(xs, 9));
    Assert.Equal(4, Array.LastIndexOf<int>(xs, 5));
    Assert.Equal(1, Array.LastIndexOf<int>(xs, 1));
    Assert.Equal(-1, Array.LastIndexOf<int>(xs, 9));
}

[Test]
void test_convertall() {
    int[] xs = new int[]{ 1, 2, 3 };
    int[] doubled = Array.ConvertAll<int, int>(xs, (x) => x * 2);
    Assert.Equal(3, doubled.Length);
    Assert.Equal(2, doubled[0]);
    Assert.Equal(4, doubled[1]);
    Assert.Equal(6, doubled[2]);
    int[] empty = new int[0];
    Assert.Equal(0, Array.ConvertAll<int, int>(empty, (x) => x).Length);
}

[Test]
void test_foreach() {
    int[] xs = new int[]{ 1, 2, 3, 4 };
    int[] sum = new int[1];   // capture array ref to accumulate
    Array.ForEach<int>(xs, (x) => { sum[0] = sum[0] + x; });
    Assert.Equal(10, sum[0]);
}

[Test]
void test_clear() {
    int[] xs = new int[]{ 1, 2, 3, 4, 5 };
    Array.Clear<int>(xs, 1, 2);   // zero indices 1,2
    Assert.Equal(1, xs[0]);
    Assert.Equal(0, xs[1]);
    Assert.Equal(0, xs[2]);
    Assert.Equal(4, xs[3]);
    Assert.Equal(5, xs[4]);
}

[Test]
void test_clear_out_of_range() {
    int[] xs = new int[]{ 1, 2, 3 };
    bool threw = false;
    try {
        Array.Clear<int>(xs, 2, 5);   // 2+5 > 3
    } catch (Exception e) {
        threw = true;
    }
    Assert.True(threw);
}

[Test]
void test_resize() {
    int[] xs = new int[]{ 1, 2, 3 };
    int[] grown = Array.Resize<int>(xs, 5);
    Assert.Equal(5, grown.Length);
    Assert.Equal(1, grown[0]);
    Assert.Equal(3, grown[2]);
    Assert.Equal(0, grown[3]);   // tail default(int)
    Assert.Equal(0, grown[4]);
    // shrink
    int[] shrunk = Array.Resize<int>(xs, 2);
    Assert.Equal(2, shrunk.Length);
    Assert.Equal(1, shrunk[0]);
    Assert.Equal(2, shrunk[1]);
    // original unchanged
    Assert.Equal(3, xs.Length);
    Assert.Equal(3, xs[2]);
}

[Test]
void test_empty() {
    int[] e = Array.Empty<int>();
    Assert.Equal(0, e.Length);
    string[] es = Array.Empty<string>();
    Assert.Equal(0, es.Length);
}
