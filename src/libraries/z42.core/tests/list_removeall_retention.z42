namespace Z42CoreListRemoveAllRetentionTests;

using Std.Collections;
using Std.Harness;

class Item {
    public int Key;
    public Item(int key) { this.Key = key; }
}

struct RefValue {
    public Item Value;
    public RefValue(Item value) { this.Value = value; }
}

WeakHandle AddTarget(List<Item> list, int key) {
    var item = new Item(key);
    list.Add(item);
    return WeakHandle.MakeWeak(item);
}

WeakHandle AddStructTarget(List<RefValue> list) {
    var item = new Item(7);
    list.Add(new RefValue(item));
    return WeakHandle.MakeWeak(item);
}

[Test]
void test_removeall_releases_removed_tail() {
    var list = new List<Item>();
    list.Add(new Item(1));
    var weak = AddTarget(list, 2);
    Assert.Equal(1, list.RemoveAll((Item item) => item.Key == 2));
    GC.ForceCollect();
    Assert.True(WeakHandle.Upgrade(weak) == null);
    Assert.Equal(1, list.Count);
    Assert.Equal(1, list[0].Key);
}

[Test]
void test_removeall_releases_all_targets() {
    var list = new List<Item>();
    var first = AddTarget(list, 1);
    var second = AddTarget(list, 2);
    Assert.Equal(2, list.RemoveAll((Item item) => true));
    GC.ForceCollect();
    Assert.True(WeakHandle.Upgrade(first) == null);
    Assert.True(WeakHandle.Upgrade(second) == null);
    Assert.Equal(0, list.Count);
    list.Add(new Item(9));
    Assert.Equal(9, list[0].Key);
}

[Test]
void test_removeall_releases_struct_reference_leaf() {
    var list = new List<RefValue>();
    var weak = AddStructTarget(list);
    Assert.Equal(1, list.RemoveAll((RefValue item) => true));
    GC.ForceCollect();
    Assert.True(WeakHandle.Upgrade(weak) == null);
    Assert.Equal(0, list.Count);
}

[Test]
void test_removeall_preserves_survivor_order() {
    var list = new List<Item>();
    list.Add(new Item(1));
    list.Add(new Item(2));
    list.Add(new Item(3));
    list.Add(new Item(4));
    Assert.Equal(2, list.RemoveAll((Item item) => item.Key % 2 == 0));
    GC.ForceCollect();
    Assert.Equal(2, list.Count);
    Assert.Equal(1, list[0].Key);
    Assert.Equal(3, list[1].Key);
}

[Test]
void test_removeall_no_matches_keeps_target_alive() {
    var list = new List<Item>();
    var weak = AddTarget(list, 1);
    Assert.Equal(0, list.RemoveAll((Item item) => false));
    GC.ForceCollect();
    Assert.True(WeakHandle.Upgrade(weak) != null);
    Assert.Equal(1, list.Count);
    Assert.Equal(1, list[0].Key);
}

[Test]
void test_removeall_empty_is_repeatable() {
    var list = new List<Item>();
    Assert.Equal(0, list.RemoveAll((Item item) => true));
    Assert.Equal(0, list.RemoveAll((Item item) => false));
    Assert.Equal(0, list.Count);
}
