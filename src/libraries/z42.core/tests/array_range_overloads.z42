// add-array-range-overloads (2026-09-02): Std.Array C# System.Array parity —
// range / offset / paired overloads (generic static, pure script).
namespace Z42CoreArrayRangeOverloadsTests;

using Std;
using Std.Test;

[Test]
void test_sort_range() {
    int[] xs = new int[]{ 5, 4, 3, 2, 1 };
    Array.Sort<int>(xs, 1, 3);   // sort indices 1..3
    Assert.Equal(5, xs[0]);      // outside range, unchanged
    Assert.Equal(2, xs[1]);
    Assert.Equal(3, xs[2]);
    Assert.Equal(4, xs[3]);
    Assert.Equal(1, xs[4]);      // outside range, unchanged
}

[Test]
void test_sort_range_out_of_bounds() {
    int[] xs = new int[]{ 1, 2, 3 };
    bool threw = false;
    try {
        Array.Sort<int>(xs, 2, 5);
    } catch (Exception e) {
        threw = true;
    }
    Assert.True(threw);
}

[Test]
void test_reverse_range() {
    int[] xs = new int[]{ 1, 2, 3, 4, 5 };
    Array.Reverse<int>(xs, 1, 3);
    Assert.Equal(1, xs[0]);
    Assert.Equal(4, xs[1]);
    Assert.Equal(3, xs[2]);
    Assert.Equal(2, xs[3]);
    Assert.Equal(5, xs[4]);
}

[Test]
void test_fill_range() {
    int[] xs = new int[5];
    Array.Fill<int>(xs, 7, 1, 2);
    Assert.Equal(0, xs[0]);
    Assert.Equal(7, xs[1]);
    Assert.Equal(7, xs[2]);
    Assert.Equal(0, xs[3]);
    Assert.Equal(0, xs[4]);
}

[Test]
void test_copy_offset_cross_array() {
    int[] src = new int[]{ 1, 2, 3, 4 };
    int[] dst = new int[4];
    Array.Copy<int>(src, 1, dst, 0, 2);
    Assert.Equal(2, dst[0]);
    Assert.Equal(3, dst[1]);
    Assert.Equal(0, dst[2]);
    Assert.Equal(0, dst[3]);
}

[Test]
void test_copy_offset_overlap_forward() {
    // shift right by one within the same array; must not smear
    int[] a = new int[]{ 1, 2, 3, 4, 5 };
    Array.Copy<int>(a, 0, a, 1, 4);
    Assert.Equal(1, a[0]);
    Assert.Equal(1, a[1]);
    Assert.Equal(2, a[2]);
    Assert.Equal(3, a[3]);
    Assert.Equal(4, a[4]);
}

[Test]
void test_copy_offset_out_of_bounds() {
    int[] src = new int[]{ 1, 2, 3 };
    int[] dst = new int[2];
    bool threw = false;
    try {
        Array.Copy<int>(src, 0, dst, 0, 3);   // 3 > dst.Length
    } catch (Exception e) {
        threw = true;
    }
    Assert.True(threw);
}

[Test]
void test_indexof_startindex() {
    int[] xs = new int[]{ 5, 1, 5, 2, 5 };
    Assert.Equal(2, Array.IndexOf<int>(xs, 5, 1));   // skip index 0
    Assert.Equal(0, Array.IndexOf<int>(xs, 5, 0));
    Assert.Equal(-1, Array.IndexOf<int>(xs, 9, 0));
}

[Test]
void test_indexof_startindex_count() {
    int[] xs = new int[]{ 5, 1, 5, 2, 5 };
    Assert.Equal(-1, Array.IndexOf<int>(xs, 5, 1, 1));   // range [1,2) has no 5
    Assert.Equal(2, Array.IndexOf<int>(xs, 5, 1, 2));    // range [1,3) hits index 2
}

[Test]
void test_lastindexof_startindex() {
    int[] xs = new int[]{ 5, 1, 5, 2, 5 };
    Assert.Equal(2, Array.LastIndexOf<int>(xs, 5, 2));   // backward from 2
    Assert.Equal(0, Array.LastIndexOf<int>(xs, 5, 1));   // backward from 1
    Assert.Equal(-1, Array.LastIndexOf<int>(xs, 9, 4));
}

[Test]
void test_binarysearch_range() {
    // element 0 is a sentinel outside the searched range
    int[] xs = new int[]{ 9, 1, 3, 5, 7, 9 };
    Assert.Equal(3, Array.BinarySearch<int>(xs, 1, 4, 5));   // find 5 in [1,5)
    Assert.Equal(1, Array.BinarySearch<int>(xs, 1, 4, 1));   // find 1 in [1,5)
    // not found within range → ~insertionPoint. Range [1,5) = {1,3,5,7};
    // 4 inserts before 5 (index 3) → ~3 = -4.
    Assert.Equal(-4, Array.BinarySearch<int>(xs, 1, 4, 4));
}

[Test]
void test_binarysearch_comparer() {
    int[] xs = new int[]{ 1, 3, 5, 7, 9 };
    Assert.Equal(2, Array.BinarySearch<int>(xs, 5, (a, b) => a - b));
    Assert.Equal(-3, Array.BinarySearch<int>(xs, 4, (a, b) => a - b));  // ~2
    Assert.Equal(-1, Array.BinarySearch<int>(xs, 0, (a, b) => a - b));  // ~0
}
