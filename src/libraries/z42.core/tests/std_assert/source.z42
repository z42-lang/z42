// Std.Assert（z42.core 的运行期断言）本身的覆盖。
//
// tidy-test-layout (2026-09-06)：从 src/tests/basic/assert.z42 搬来——它测的是
// z42.core 的一个 API，归属就在这里。**保持 Main-based golden 形态、不改写成
// [Test] 单元**：[Test] 文件必须 `using Std.Test`，那会把裸名 `Assert` 绑到
// Std.Test.Assert（抛 TestFailure 的测试框架断言），于是 Std.Assert 反而没人测了。
// 无 using 的 Main 用例经 prelude 拿到的才是 Std.Assert 这一份。
// assert-only（无 stdout）→ 不需要 expected_output.txt。
void Main() {
    // Assert.Equal — primitives
    Assert.Equal(42, 40 + 2);
    Assert.Equal("hello", "hel" + "lo");
    Assert.Equal(true, 1 < 2);

    // Assert.True / Assert.False
    Assert.True(10 > 5);
    Assert.False(3 > 10);

    // Assert.Contains
    Assert.Contains("world", "hello world");

    // Assert.Null / Assert.NotNull
    Assert.Null(null);
    Assert.NotNull("not null");

    // Expression-level assertions
    var x = 6 * 7;
    Assert.Equal(42, x);

    // String computed value
    var greeting = "Hello, " + "World!";
    Assert.Contains("World", greeting);
    Assert.True(greeting.StartsWith("Hello"));
}
