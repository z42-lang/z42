// Spec R5 — z42.core 库本地测试。覆盖 `Std.Assert` 与基础类型行为。
//
// unify-assert-api (2026-09-08)：此前抬头强调「测的是 Std.Assert 而非
// Std.Harness.Assert」——两份 Assert 已合并成一份，该区分不复存在。
namespace Z42CoreTests;

using Std.Harness;

[Test]
void test_string_equality() {
    Assert.Equal("hello", "hel" + "lo");
}

[Test]
void test_string_concat() {
    var s = "abc" + "def";
    Assert.Equal(6, s.Length);
}

[Test]
void test_int_arithmetic() {
    Assert.Equal(7, 3 + 4);
    Assert.Equal(12, 3 * 4);
    Assert.Equal(-1, 3 - 4);
}

[Test]
void test_bool_logic() {
    Assert.True(true);
    Assert.False(false);
    Assert.True(1 == 1);
    Assert.False(1 == 2);
}

[Test]
void test_string_contains() {
    Assert.Contains("ell", "hello world");
    Assert.Contains("world", "hello world");
}

[Test]
void test_null_handling() {
    string? maybe = null;
    Assert.Null(maybe);
    string defined = "x";
    Assert.NotNull(defined);
}

[Test]
void test_array_equal_happy_paths() {
    // 免装箱直传：int[] / long[] / string[] / object[]；null 位只与 null 相等。
    Assert.ArrayEqual(new int[]{ 1, 2, 3 }, new int[]{ 1, 2, 3 });
    Assert.ArrayEqual(new long[]{ 5, 6 }, new long[]{ 5, 6 });
    Assert.ArrayEqual(new string[]{ "a", "b" }, new string[]{ "a", "b" });
    string[] expectedWithNull = new string[]{ "a", null };
    string[] actualWithNull = new string[]{ "a", null };
    Assert.ArrayEqual(expectedWithNull, actualWithNull);
    Assert.ArrayEqual(new int[0], new int[0]);
}

[Test]
void test_array_equal_failures_report_first_mismatch() {
    Assert.Throws("TestFailure", () => {
        Assert.ArrayEqual(new int[]{ 1, 2, 3 }, new int[]{ 1, 9, 3 });
    });
    // 长度不一致先报长度。
    Assert.Throws("TestFailure", () => {
        Assert.ArrayEqual(new int[]{ 1, 2 }, new int[]{ 1, 2, 3 });
    });
    // null 与非 null 不相等。
    Assert.Throws("TestFailure", () => {
        string[] e = new string[]{ null };
        string[] a = new string[]{ "x" };
        Assert.ArrayEqual(e, a);
    });
}

[Test]
void test_array_length() {
    int[] arr = new int[]{ 7, 8, 9 };
    Assert.ArrayLength(arr, 3);
    Assert.Throws("TestFailure", () => {
        Assert.ArrayLength(arr, 2);
    });
}
