// Spec R5 — z42.core 库本地测试。覆盖 `Std.Assert` 与基础类型行为。
//
// unify-assert-api (2026-09-08)：此前抬头强调「测的是 Std.Assert 而非
// Std.Test.Assert」——两份 Assert 已合并成一份，该区分不复存在。
namespace Z42CoreTests;

using Std.Test;

[Test]
void test_string_equality() {
    Assert.Equal("hello", "hel" + "lo");
}

[Test]
void test_string_concat() {
    var s = "abc" + "def";
    Assert.Equal(6, s.Length);
}

[Test]
void test_int_arithmetic() {
    Assert.Equal(7, 3 + 4);
    Assert.Equal(12, 3 * 4);
    Assert.Equal(-1, 3 - 4);
}

[Test]
void test_bool_logic() {
    Assert.True(true);
    Assert.False(false);
    Assert.True(1 == 1);
    Assert.False(1 == 2);
}

[Test]
void test_string_contains() {
    Assert.Contains("ell", "hello world");
    Assert.Contains("world", "hello world");
}

[Test]
void test_null_handling() {
    string? maybe = null;
    Assert.Null(maybe);
    string defined = "x";
    Assert.NotNull(defined);
}
