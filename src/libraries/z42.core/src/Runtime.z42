// Std.Runtime —— VM 运行期入口：动态 zpkg 加载与静态派发。
//
// 这两个 builtin 构成按需工作负载派发的底层：launcher 命名 workload（如
// "z42.workload.ios"），VM 经注册的 ZpkgResolver 解析加载，CallStatic 驱动其固定签名入口点。
//
// 解析是平台透明的：嵌入的 apphost 在 VM 启动时注册适合其平台的 resolver（文件系统搜索、
// Android AssetManager、iOS bundle 等）。z42 代码永远只按逻辑名引用 zpkg。
//
// @warning 实现状态：DEFERRED——`__load_zpkg` / `__call_static` 尚未在 VM corelib 注册。
namespace Std.Runtime;

/// VM 运行期入口：按逻辑名动态加载 zpkg，并按全限定名静态派发固定签名入口点。
public static class Runtime {
    /// 按逻辑名把 z42 包加载进 VM 的类型与函数注册表。幂等：同名重复加载是 no-op。
    /// 名称无法解析、文件非合法 zpkg 或 zbc 版本与运行 VM 不兼容时抛 RuntimeException。
    // 解析顺序（VM 内部，由嵌入 apphost 配置）：已加载缓存 → apphost 注册的 ZpkgResolver
    // → 默认文件系统搜索（<repo>/.z42/workloads/<name>.zpkg → $Z42_HOME/runtimes/<ver>/... →
    // $Z42_HOME/workloads/<name>.zpkg）。
    [Native("__load_zpkg")]
    public static extern void LoadZpkg(string name);

    /// 按全限定名调用 public static 函数，目标必须是精确签名 `(string[])->int`；
    /// 不匹配抛 RuntimeException。典型用于 LoadZpkg 后驱动 workload 入口并返回退出码。
    [Native("__call_static")]
    public static extern int CallStatic(string fqn, string[] args);
}
