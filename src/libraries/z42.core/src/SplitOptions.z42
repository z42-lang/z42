namespace Std;

// `String.Split(separator, options)` 的按位选项标志，对标 BCL `StringSplitOptions`。
// z42 尚无 `enum` 关键字，沿用 `SeekOrigin` / `FileMode` / `AlgoId` 的惯例，以 int
// 常量暴露，可写 `SplitOptions.RemoveEmptyEntries | SplitOptions.TrimEntries`。

/// `String.Split(separator, options)` 的按位选项标志。
public static class SplitOptions {
    /// 不后处理（等价单参 `Split(separator)`）。
    public static int None = 0;

    /// 丢弃长度为 0 的段。适合分隔符相邻/首尾会导致空段的分行、分字段场景。
    public static int RemoveEmptyEntries = 1;

    /// 对每段做 `Trim()`（去首尾空白）。可与 `RemoveEmptyEntries` 组合，一并丢弃
    /// trim 后变空的段。
    public static int TrimEntries = 2;
}
