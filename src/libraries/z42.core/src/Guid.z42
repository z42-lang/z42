namespace Std;

// 由 16 个原始字节背书，值不可变。字节→十六进制布局是顺序的（非 C# 前三组混合端序），
// 但可经 Parse/ToString 往返，且是合法的规范 GUID 串。

/// 128 位全局唯一标识符（C# System.Guid 对标）。
///
/// 值不可变；字符串形式为规范 8-4-4-4-12 小写十六进制（"D"），"N" 为 32 位无连字符形式。
/// `NewGuid()` 生成 RFC 4122 v4（随机）GUID，熵来自 OS。
///
/// @warning z42 struct-default 限制：`default(Guid)` 得 null 值（不是零值），所以必须用
/// `Guid.Empty()` 取全零 GUID；对 `default(Guid)` 调方法会 trap。
public struct Guid {
    private byte[] _bytes;

    /// 由恰好 16 字节构造（防御性拷贝）。
    public Guid(byte[] b) {
        if (b.Length != 16) {
            throw new ArgumentException("Guid requires exactly 16 bytes, got " + b.Length.ToString());
        }
        byte[] c = new byte[16];
        int i = 0;
        while (i < 16) {
            c[i] = b[i];
            i = i + 1;
        }
        _bytes = c;
    }

    /// 全零 GUID（`00000000-0000-0000-0000-000000000000`）。
    public static Guid Empty() {
        return new Guid(new byte[16]);
    }

    /// 生成一个 RFC 4122 v4（随机）GUID，熵来自 OS。
    public static Guid NewGuid() {
        byte[] b = Entropy.GetBytes(16);
        // 字节 6 高四位设 version 4；字节 8 设 variant '10x'。
        b[6] = (byte)(((int)b[6] & 0x0F) | 0x40);
        b[8] = (byte)(((int)b[8] & 0x3F) | 0x80);
        return new Guid(b);
    }

    // ── 解析 ──────────────────────────────────────────────────────────────────

    /// 解析规范 "D" 形式（36 字符，带连字符）或 "N" 形式（32 个十六进制字符）。
    /// 其它长度或非法字符抛 FormatException。
    public static Guid Parse(string s) {
        int len = s.Length;
        byte[] outb = new byte[16];
        if (len == 32) {
            Guid._parseHexInto(s, outb, false);
        } else if (len == 36) {
            Guid._parseHexInto(s, outb, true);
        } else {
            throw new FormatException("Guid string length " + len.ToString() + " invalid (expected 32 or 36): " + s);
        }
        return new Guid(outb);
    }

    /// 不抛异常的解析：成功时写入 `v` 并返回 true。
    ///
    /// 非法输入返回 false 且 `v` 为 `Guid.Empty()`。`Guid` 是 struct ⇒ 不可空，
    /// 故 out 值走 `ref`。
    public static bool TryParse(string s, ref Guid v) {
        try {
            v = Guid.Parse(s);
            return true;
        } catch (Exception e) {
            v = Guid.Empty();
            return false;
        }
    }

    private static void _parseHexInto(string s, byte[] outb, bool dashes) {
        int bi = 0;
        int i = 0;
        while (bi < 16) {
            if (dashes && (bi == 4 || bi == 6 || bi == 8 || bi == 10)) {
                if (s.CharAt(i) != '-') {
                    throw new FormatException("Guid: expected '-' at position " + i.ToString() + ": " + s);
                }
                i = i + 1;
            }
            int hi = Guid._nibble(s.CharAt(i), s);
            int lo = Guid._nibble(s.CharAt(i + 1), s);
            outb[bi] = (byte)((hi << 4) | lo);
            i = i + 2;
            bi = bi + 1;
        }
    }

    private static int _nibble(char c, string whole) {
        if (!(c < '0') && !(c > '9')) { return (int)c - (int)'0'; }
        if (!(c < 'a') && !(c > 'f')) { return (int)c - (int)'a' + 10; }
        if (!(c < 'A') && !(c > 'F')) { return (int)c - (int)'A' + 10; }
        throw new FormatException("Guid: invalid hex character '" + c.ToString() + "' in " + whole);
    }

    // ── 相等 ──────────────────────────────────────────────────────────────────

    /// 按 16 字节值比较相等。
    public bool Equals(Guid other) {
        byte[] a = _bytes;
        byte[] b = other._rawBytes();
        int i = 0;
        while (i < 16) {
            if (a[i] != b[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    private byte[] _rawBytes() { return _bytes; }

    /// 内容哈希码。
    public int GetHashCode() {
        int h = 0;
        int i = 0;
        while (i < 16) {
            h = h * 31 + ((int)_bytes[i] & 0xFF);
            i = i + 1;
        }
        return h;
    }

    // ── 格式化 ────────────────────────────────────────────────────────────────

    /// 规范带连字符的小写形式，如 `"0f8fad5b-d9cb-469f-a165-70867728950e"`。
    public override string ToString() {
        return this._toHex(true);
    }

    /// 按格式串输出："D"（带连字符，默认）或 "N"（32 位无连字符）；大小写不敏感。
    /// 其它格式抛 FormatException。
    public string ToString(string format) {
        if (format == "N" || format == "n") {
            return this._toHex(false);
        }
        if (format == "D" || format == "d" || format == "") {
            return this._toHex(true);
        }
        throw new FormatException("Guid format '" + format + "' not supported (use \"D\" or \"N\")");
    }

    private string _toHex(bool dashes) {
        string digits = "0123456789abcdef";
        int len = 32;
        if (dashes) {
            len = 36;
        }
        char[] outc = new char[len];
        int pos = 0;
        int i = 0;
        while (i < 16) {
            if (dashes && (i == 4 || i == 6 || i == 8 || i == 10)) {
                outc[pos] = '-';
                pos = pos + 1;
            }
            int bv = (int)_bytes[i] & 0xFF;
            outc[pos] = digits.CharAt((bv >> 4) & 0x0F);
            pos = pos + 1;
            outc[pos] = digits.CharAt(bv & 0x0F);
            pos = pos + 1;
            i = i + 1;
        }
        return String.FromChars(outc);
    }
}
