namespace Std.Collections;


// 实现笔记：Sort 为自顶向下归并排序（stable，O(n log n)，一次性分配 scratch 缓冲）；
// 元素全是同一种基元（int 系 / double / char / string）时 `Sort()` 交给原生稳定排序
// （`Array.SortPrimitives`，同序）。

/// 纯源码级泛型动态数组：摊还 O(1) Add / 随机访问，O(n) RemoveAt / Insert / Contains /
/// IndexOf / Remove。对 `T` 无类型约束——相等与比较是**运行期**要求：Contains / IndexOf /
/// Remove 用 `Equals`，`Sort()` 用 `CompareTo`（元素不可比较时在 Sort 处失败）。
public partial class List<T> : IEnumerable<T> {
    T[] items;

    /// 元素个数（公开字段，可读可写）。
    public int Count;
    int capacity;

    /// 新建空列表。
    public List() {
        this.capacity = 4;
        this.items = new T[4];
        this.Count = 0;
    }

    /// 按预期元素数预分配容量，避免后续反复 2× Grow 再分配。`capacity < 1` 视作 1。
    public List(int capacity) {
        int cap = capacity;
        if (cap < 1) cap = 1;
        this.capacity = cap;
        this.items = new T[cap];
        this.Count = 0;
    }

    /// 是否为空。
    public bool IsEmpty() { return this.Count == 0; }

    /// 返回**具体** `ListEnumerator<T>` struct（非 `IEnumerator<T>` 接口）。List 自身
    /// foreach 走索引快路径（Count + get_Item），不经此；本方法服务以接口静态类型 /
    /// 泛型约束持有的调用点。
    public ListEnumerator<T> GetEnumerator() { return new ListEnumerator<T>(this); }

    /// 读写第 `i` 个元素。
    public T this[int i] {
        get { return this.items[i]; }
        set { this.items[i] = value; }
    }

    /// 追加元素。
    public void Add(T item) {
        if (this.Count == this.capacity) this.Grow();
        this.items[this.Count] = item;
        this.Count = this.Count + 1;
    }

    /// 按数组顺序追加整个 `T[]`。
    // 实现：一次性预扩容到最终大小，避免逐元素 Add 触发一串 2× Grow。
    public void AddRange(T[] items) {
        int n = items.Length;
        this.EnsureCapacity(this.Count + n);
        int i = 0;
        while (i < n) {
            this.items[this.Count] = items[i];
            this.Count = this.Count + 1;
            i = i + 1;
        }
    }

    // 确保 `items` 至少能容纳 `min` 个元素；不够则一次再分配（新容量 = max(2×当前容量, min)）。
    void EnsureCapacity(int min) {
        if (min <= this.capacity) return;
        int newCap = this.capacity * 2;
        if (newCap < min) newCap = min;
        T[] bigger = new T[newCap];
        Array.Copy(this.items, bigger, this.Count);
        this.items = bigger;
        this.capacity = newCap;
    }

    /// 返回长度为 Count 的新数组快照（改它不影响原列表）。
    public T[] ToArray() {
        T[] result = new T[this.Count];
        Array.Copy(this.items, result, this.Count);
        return result;
    }

    /// 在 `index` 处插入，其后元素右移。
    public void Insert(int index, T item) {
        if (this.Count == this.capacity) this.Grow();
        Array.Copy(this.items, index, this.items, index + 1, this.Count - index);
        this.items[index] = item;
        this.Count = this.Count + 1;
    }

    /// 删除 `index` 处元素，其后元素左移。
    public void RemoveAt(int index) {
        Array.Copy(this.items, index + 1, this.items, index, this.Count - index - 1);
        this.Count = this.Count - 1;
        this.items[this.Count] = default(T);   // 清尾槽引用（镜像 C# List.RemoveAt）
    }

    /// 删除第一个等于 `item` 的元素；删掉返回 true，找不到返回 false。
    public bool Remove(T item) {
        int i = this.IndexOf(item);
        if (i < 0) return false;
        this.RemoveAt(i);
        return true;
    }

    /// 是否含 `item`（线性查找）。
    public bool Contains(T item) { return this.IndexOf(item) >= 0; }

    /// 首个等于 `item` 的下标，未命中 -1。
    public int IndexOf(T item) {
        int i = 0;
        while (i < this.Count) {
            if (this.items[i].Equals(item)) return i;
            i = i + 1;
        }
        return -1;
    }

    /// 清空列表（Count 归零）。
    // 实现：逐槽清引用（镜像 C# List.Clear 的 Array.Clear），否则已移除对象在槽被覆盖前
    // 仍被 GC 视为可达。
    public void Clear() {
        int i = 0;
        while (i < this.Count) { this.items[i] = default(T); i = i + 1; }
        this.Count = 0;
    }

    /// 升序稳定排序；基元元素走原生稳定排序。
    public void Sort() where T : IComparable {   // `CompareTo` 由方法级 where 细化类级 T 提供
        if (this.Count < 2) return;
        if (Array.SortPrimitives(this.items, this.Count)) return;   // 基元元素：原生稳定排序，同序
        T[] scratch = new T[this.Count];
        this.MergeSort(scratch, 0, this.Count);
    }

    // 用 `scratch` 作合并暂存，把 items[lo, hi) 排为升序。
    void MergeSort(T[] scratch, int lo, int hi) where T : IComparable {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        this.MergeSort(scratch, lo, mid);
        this.MergeSort(scratch, mid, hi);
        // 把两段已排序 run items[lo,mid) + items[mid,hi) 合入 scratch 再拷回；
        // 相等时取左 run 在前 → 稳定。
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (this.items[j].CompareTo(this.items[i]) < 0) {
                scratch[k] = this.items[j];
                j = j + 1;
            } else {
                scratch[k] = this.items[i];
                i = i + 1;
            }
            k = k + 1;
        }
        while (i < mid) { scratch[k] = this.items[i]; i = i + 1; k = k + 1; }
        while (j < hi)  { scratch[k] = this.items[j]; j = j + 1; k = k + 1; }
        int t = lo;
        while (t < hi) { this.items[t] = scratch[t]; t = t + 1; }
    }

    /// 用调用方给定的比较函数排序：`comparison(a, b) < 0` ⇒ a 排在 b 前。同样稳定。
    public void Sort(Func<T, T, int> comparison) {
        if (this.Count < 2) return;
        T[] scratch = new T[this.Count];
        this.MergeSortCmp(scratch, 0, this.Count, comparison);
    }

    // 在 `cmp` 下把 items[lo, hi) 排为升序（与 `MergeSort` 同形，比较器换为三元委托）。
    void MergeSortCmp(T[] scratch, int lo, int hi, Func<T, T, int> cmp) {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        this.MergeSortCmp(scratch, lo, mid, cmp);
        this.MergeSortCmp(scratch, mid, hi, cmp);
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (cmp(this.items[j], this.items[i]) < 0) {
                scratch[k] = this.items[j];
                j = j + 1;
            } else {
                scratch[k] = this.items[i];
                i = i + 1;
            }
            k = k + 1;
        }
        while (i < mid) { scratch[k] = this.items[i]; i = i + 1; k = k + 1; }
        while (j < hi)  { scratch[k] = this.items[j]; j = j + 1; k = k + 1; }
        int t = lo;
        while (t < hi) { this.items[t] = scratch[t]; t = t + 1; }
    }

    /// 原地反转。
    public void Reverse() {
        int i = 0;
        int j = this.Count - 1;
        while (i < j) {
            T tmp = this.items[i];
            this.items[i] = this.items[j];
            this.items[j] = tmp;
            i = i + 1;
            j = j - 1;
        }
    }

    /// 容量翻倍。容量管理入口，正常使用无需调用。
    public void Grow() {
        int newCap = this.capacity * 2;
        T[] bigger = new T[newCap];
        Array.Copy(this.items, bigger, this.Count);
        this.items = bigger;
        this.capacity = newCap;
    }
}
