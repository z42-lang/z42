namespace Std.Collections;

/// `List<T>` 的前向迭代器。`[Record] struct` 值类型：无堆分配，对齐 C# `List<T>.Enumerator`。
///
/// `_pos` = 已产出元素计数（0 初值）。`MoveNext` 先自增再判界、`Current` 读 `_list[_pos-1]`，
/// 等价 C# 的「-1 起、先自增后读」。
///
/// `List<T>` 自身 foreach 走索引快路径（`Count` + `get_Item`），不经本枚举器；本类服务以
/// `IEnumerable<T>` 接口静态类型 / 泛型约束持有的调用点。
[Record] public struct ListEnumerator<T>(
    /// 被枚举的列表。
    List<T> _list) : IEnumerator<T> {
    int _pos;

    /// 前进到下一个元素；无更多返回 false。
    public bool MoveNext() {
        if (this._pos < this._list.Count) {
            this._pos = this._pos + 1;
            return true;
        }
        return false;
    }

    /// 当前元素。
    public T Current {
        get { return this._list[this._pos - 1]; }
    }

    /// 无操作（值类型枚举器，无资源）。
    public void Dispose() { }
}
