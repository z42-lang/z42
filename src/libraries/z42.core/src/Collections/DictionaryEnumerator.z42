namespace Std.Collections;

/// `Dictionary<TKey, TValue>` 的枚举器：按 entries 顺序（= 插入顺序）遍历，跳过 tombstone。
///
/// 首次 `MoveNext` 记下字典的 `_version`；此后字典新增键 / `Clear` / 压实会改变它，下一次
/// `MoveNext` 即抛 `InvalidOperationException`（对齐 C# 的 "Collection was modified"）。
/// 覆盖已有键与 `Remove` 不改 `_version`：entry 原位不动，枚举照常继续（被删项不再产出）。
[Record] public struct DictionaryEnumerator<TKey, TValue>(
    /// 被枚举的字典；版本号 `_ver` 由它驱动失效检测。
    Dictionary<TKey, TValue> _dict) where TKey: IEquatable {
    int _scan;
    int _cur;
    int _ver;
    bool _started;

    /// 前进到下一个存活 entry；无更多返回 false，字典被结构性修改抛 `InvalidOperationException`。
    public bool MoveNext() {
        Dictionary<TKey, TValue> d = this._dict;
        if (!this._started) {
            this._started = true;
            this._ver = d._version;
        } else if (this._ver != d._version) {
            throw new InvalidOperationException("Collection was modified; enumeration operation may not execute.");
        }
        int used = d._used;
        int[] hs = d._hashes;
        while (this._scan < used) {
            int i = this._scan;
            this._scan = i + 1;
            if (hs[i] >= 0) {
                this._cur = i;
                return true;
            }
        }
        return false;
    }

    /// 当前键值对。
    public KeyValuePair<TKey, TValue> Current {
        get { return new KeyValuePair<TKey, TValue>(this._dict._keys[this._cur], this._dict._values[this._cur]); }
    }

    /// 无操作（值类型枚举器，无资源）。
    public void Dispose() { }
}
