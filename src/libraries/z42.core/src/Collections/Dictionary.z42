namespace Std.Collections;

// `Dictionary<TKey, TValue>` — 插入有序的紧凑哈希表（布局与共用操作见 `HashIndex.z42`）。
//
// 遍历（`foreach` / `GetEnumerator` / `Keys()` / `Values()` / `Entries()`）按**插入顺序**：
// 覆盖已有键不改变其位置；`Remove` 后再插入同一键，它排到末尾。摊还 O(1) 平均操作。
// 枚举期间新增键 / `Clear` ⇒ 下一次 `MoveNext` 抛 `InvalidOperationException`；
// 覆盖已有键与 `Remove` 不影响进行中的枚举。
// 约束：TKey 必须 hashable + equatable。primitive TKey 通过 VM builtin 路由 GetHashCode / Equals；
// 用户自定义 TKey 必须实现 IEquatable —— GetHashCode 走 Object 协议。
public class Dictionary<TKey, TValue> where TKey: IEquatable {
    internal int[] _index;      // 索引表：0 = 空，-1 = 已删，否则 entry 下标 + 1；长度 = entries 容量 × 2
    internal int[] _hashes;     // entries：规整后的 hash（≥ 0）；-1 = tombstone
    internal TKey[] _keys;
    internal TValue[] _values;
    internal int _used;         // entries 已用槽数（含 tombstone）
    internal int _version;      // 新增键 / Clear / 压实时递增，枚举器据此检测修改
    public int Count;

    public Dictionary() { this._alloc(8); }

    void _alloc(int cap) {
        this._index = new int[cap * 2];
        this._hashes = new int[cap];
        this._keys = new TKey[cap];
        this._values = new TValue[cap];
        this._used = 0;
        this.Count = 0;
    }

    public bool IsEmpty() { return this.Count == 0; }

    public DictionaryEnumerator<TKey, TValue> GetEnumerator() { return new DictionaryEnumerator<TKey, TValue>(this); }

    // 热路径（索引器读写、ContainsKey）把 hash 规整（= `HashIndex.Mix`）与探测循环就地展开，
    // 不经 `_slotOf`：每层调用的建帧 / 回收成本比探测本身还贵。探测跳过 dummy（e < 0），
    // 先比存储的 hash，不等即跳过 `.Equals()` 派发。
    public TValue this[TKey key] {
        get {
            // 不存在时返回 default (null)；调用方应先 ContainsKey。
            long hl = (long)key.GetHashCode();
            int h = (int)((hl ^ (hl >> 31)) & 0x7FFFFFFFL);
            int[] index = this._index;
            int[] hs = this._hashes;
            int mask = index.Length - 1;
            int s = h & mask;
            int perturb = h;
            int e = index[s];
            while (e != 0) {
                if (e > 0 && hs[e - 1] == h && this._keys[e - 1].Equals(key)) return this._values[e - 1];
                perturb = perturb >> 5;
                s = (s * 5 + perturb + 1) & mask;
                e = index[s];
            }
            return default(TValue);
        }
        set {
            long hl = (long)key.GetHashCode();
            int h = (int)((hl ^ (hl >> 31)) & 0x7FFFFFFFL);
            int[] index = this._index;
            int[] hs = this._hashes;
            int mask = index.Length - 1;
            int s = h & mask;
            int perturb = h;
            int e = index[s];
            while (e != 0) {
                if (e > 0 && hs[e - 1] == h && this._keys[e - 1].Equals(key)) {
                    this._values[e - 1] = value;    // 覆盖：位置不变
                    return;
                }
                perturb = perturb >> 5;
                s = (s * 5 + perturb + 1) & mask;
                e = index[s];
            }
            // 新键追加到 entries 末尾（同 `_append`；就地展开省一次调用，插入热路径上这次调用的
            // 开销约占两成）。
            int i = this._used;
            if (i == hs.Length) {
                this._resize(HashIndex.NextCapacity(this.Count, i));
                index = this._index;
                hs = this._hashes;
                i = this._used;
                s = HashIndex.FreeSlot(index, h);
            }
            hs[i] = h;
            this._keys[i] = key;
            this._values[i] = value;
            index[s] = i + 1;
            this._used = i + 1;
            this.Count = this.Count + 1;
            this._version = this._version + 1;
        }
    }

    public void Set(TKey key, TValue value) { this[key] = value; }

    public TValue Get(TKey key) { return this[key]; }

    // 注：TryGetValue 依赖 `out`，而 out→tuple 迁移正在进行（ref-borrow 程序），
    // 故暂不引入；GetValueOrDefault 覆盖其绝大多数无异常查找场景。

    // 仅当 key 不存在时插入（追加到末尾），返回是否成功插入（已存在则不覆盖、返回 false）。
    // 对标 C# `Dictionary.TryAdd`。
    public bool TryAdd(TKey key, TValue value) {
        int h = HashIndex.Mix(key.GetHashCode());
        int s = this._slotOf(key, h);
        if (this._index[s] != 0) return false;
        this._append(s, h, key, value);
        return true;
    }

    // 返回 key 对应的值，不存在则返回 default(TValue)。对标 C#
    // `Dictionary.GetValueOrDefault(key)` —— 一次探测，无异常。
    public TValue GetValueOrDefault(TKey key) { return this.GetValueOrDefault(key, default(TValue)); }

    // 返回 key 对应的值，不存在则返回调用方给定的 `defaultValue`。对标 C#
    // `Dictionary.GetValueOrDefault(key, defaultValue)`。
    public TValue GetValueOrDefault(TKey key, TValue defaultValue) {
        int e = this._index[this.FindSlot(key)];
        if (e > 0) return this._values[e - 1];
        return defaultValue;
    }

    public bool ContainsKey(TKey key) {
        long hl = (long)key.GetHashCode();
        int h = (int)((hl ^ (hl >> 31)) & 0x7FFFFFFFL);
        int[] index = this._index;
        int[] hs = this._hashes;
        int mask = index.Length - 1;
        int s = h & mask;
        int perturb = h;
        int e = index[s];
        while (e != 0) {
            if (e > 0 && hs[e - 1] == h && this._keys[e - 1].Equals(key)) return true;
            perturb = perturb >> 5;
            s = (s * 5 + perturb + 1) & mask;
            e = index[s];
        }
        return false;
    }

    // 删除：索引槽改成 dummy（-1），entry 置 tombstone 并清掉 key/value 引用（被删对象不再被 GC
    // 视为可达）；其余 entries 原位不动，故相对顺序不变。槽位到下次压实时回收。
    public bool Remove(TKey key) {
        int s = this.FindSlot(key);
        int e = this._index[s];
        if (e == 0) return false;
        int i = e - 1;
        this._index[s] = -1;
        this._hashes[i] = -1;
        this._keys[i] = default(TKey);
        this._values[i] = default(TValue);
        this.Count = this.Count - 1;
        return true;
    }

    // 保留容量：换一组同容量的新数组（VM 原生零初始化，免逐槽清引用）。
    public void Clear() {
        this._alloc(this._hashes.Length);
        this._version = this._version + 1;
    }

    // ── 遍历面：全部按 entries 顺序（= 插入顺序）产出，跳过 tombstone ──

    // 返回长度为 Count 的快照数组（每次调用新建）。无 tombstone 时整段原生拷贝。
    public TKey[] Keys() {
        TKey[] result = new TKey[this.Count];
        int[] hs = this._hashes;
        int used = this._used;
        if (this.Count == used) {
            Array.CopyRange(this._keys, 0, result, 0, used);
            return result;
        }
        int w = 0;
        for (int i = 0; i < used; i++) {
            if (hs[i] >= 0) {
                result[w] = this._keys[i];
                w++;
            }
        }
        return result;
    }

    public TValue[] Values() {
        TValue[] result = new TValue[this.Count];
        int[] hs = this._hashes;
        int used = this._used;
        if (this.Count == used) {
            Array.CopyRange(this._values, 0, result, 0, used);
            return result;
        }
        int w = 0;
        for (int i = 0; i < used; i++) {
            if (hs[i] >= 0) {
                result[w] = this._values[i];
                w++;
            }
        }
        return result;
    }

    public KeyValuePair<TKey, TValue>[] Entries() {
        KeyValuePair<TKey, TValue>[] result = new KeyValuePair<TKey, TValue>[this.Count];
        int[] hs = this._hashes;
        int used = this._used;
        int w = 0;
        for (int i = 0; i < used; i++) {
            if (hs[i] >= 0) {
                result[w] = new KeyValuePair<TKey, TValue>(this._keys[i], this._values[i]);
                w++;
            }
        }
        return result;
    }

    // 返回 key 在索引表中的槽：若 key 存在，该槽指向它的 entry；否则是探测序列上的第一个空槽
    //（即新键应放入的槽）。
    public int FindSlot(TKey key) {
        return this._slotOf(key, HashIndex.Mix(key.GetHashCode()));
    }

    int _slotOf(TKey key, int h) {
        int[] index = this._index;
        int[] hs = this._hashes;
        int mask = index.Length - 1;
        int s = h & mask;
        int perturb = h;
        int e = index[s];
        while (e != 0 && (e < 0 || hs[e - 1] != h || !this._keys[e - 1].Equals(key))) {
            perturb = perturb >> 5;
            s = (s * 5 + perturb + 1) & mask;
            e = index[s];
        }
        return s;
    }

    // entries 容量翻倍（索引表随之翻倍）。
    public void Grow() { this._resize(this._hashes.Length * 2); }

    // 新键追加到 entries 末尾；s 为探测得到的空索引槽。entries 满则先扩容 / 压实再重新找槽。
    void _append(int s, int h, TKey key, TValue value) {
        int slot = s;
        int i = this._used;
        if (i == this._hashes.Length) {
            this._resize(HashIndex.NextCapacity(this.Count, i));
            i = this._used;
            slot = HashIndex.FreeSlot(this._index, h);
        }
        this._hashes[i] = h;
        this._keys[i] = key;
        this._values[i] = value;
        this._index[slot] = i + 1;
        this._used = i + 1;
        this.Count = this.Count + 1;
        this._version = this._version + 1;
    }

    // 把 entries 换到容量 newCap 并压实（去 tombstone、保留相对顺序），重建索引表。
    // newCap 等于当前容量时就地压实。
    void _resize(int newCap) {
        int used = this._used;
        int[] oh = this._hashes;
        TKey[] ok = this._keys;
        TValue[] ov = this._values;
        bool inPlace = newCap == oh.Length;
        int[] nh = oh;
        TKey[] nk = ok;
        TValue[] nv = ov;
        if (!inPlace) {
            nh = new int[newCap];
            nk = new TKey[newCap];
            nv = new TValue[newCap];
        }
        int live = used;
        if (this.Count == used && !inPlace) {
            // 无 tombstone：原生批量拷贝。
            Array.CopyRange(oh, 0, nh, 0, used);
            Array.CopyRange(ok, 0, nk, 0, used);
            Array.CopyRange(ov, 0, nv, 0, used);
        } else {
            // 存活项按原顺序前移（就地时写位置 ≤ 读位置，不会覆盖未读项）。
            live = 0;
            for (int i = 0; i < used; i++) {
                int h = oh[i];
                if (h >= 0) {
                    nh[live] = h;
                    nk[live] = ok[i];
                    nv[live] = ov[i];
                    live++;
                }
            }
            if (inPlace) {
                // 清掉腾出的尾部，释放引用。
                for (int j = live; j < used; j++) {
                    nk[j] = default(TKey);
                    nv[j] = default(TValue);
                }
            }
        }
        this._hashes = nh;
        this._keys = nk;
        this._values = nv;
        this._used = live;
        this._index = HashIndex.Build(nh, live, newCap * 2);
        this._version = this._version + 1;
    }
}
