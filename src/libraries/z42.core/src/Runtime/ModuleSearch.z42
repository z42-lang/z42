namespace Std.Runtime;

/// 当前 VM 解析 zpkg 依赖时使用的实际搜索目录，按优先级排列。
///
/// CLI 启动时按入口包目录解析相对项、展开 probing-paths 通配符并剔除不存在的目录；
/// 嵌入宿主通过加载选项传入目录。显式加载其他位置的包后，查询包含加载器新增的目录。
/// RuntimeConfig.Get("probing-paths") 返回原始配置，本类返回所属 VM 加载器的当前结果。
public static class ModuleSearch {
    /// 返回独立的目录数组快照；修改数组不影响加载器。
    /// 同一 VM 的 worker 共享搜索路径，不同 VM 相互隔离。未安装加载器时返回空数组。
    [Native("__search_dirs")]
    public static extern string[] Dirs();
}
