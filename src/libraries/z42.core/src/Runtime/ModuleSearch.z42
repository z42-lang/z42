namespace Std.Runtime;

/// 本进程解析 zpkg 依赖时会去哪些目录找（**解析后的实际搜索序**）。相对项已按 **entry zpkg
/// 所在目录**解析（不是 cwd）、`probing-paths` 里的 `*` / `**` 已展开、不存在的目录已剔除。
/// 与 `Std.Runtime.RuntimeConfig` 的分工：`RuntimeConfig.Get("probing-paths")` 给原始配置串
/// （未展开、不知道相对谁），本类给解析后的实际搜索序。
public static class ModuleSearch {
    /// 按序的搜索目录。非 app 路径（纯 host 嵌入）→ 空数组。空数组是**有意义的答案**：
    /// 说明这个进程没有任何 zpkg 搜索路径，不是错误。
    [Native("__search_dirs")]
    public static extern string[] Dirs();
}
