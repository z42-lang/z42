// 实现笔记：加载按模块名幂等（first-wins）；被加载 zpkg 自身所在目录并入 VM 搜索目录，
// 依赖闭包自然解析；加载后立即补跑新模块的静态初始化。
namespace Std.Runtime;

using Std.Reflection;   // Activator

/// 把已编译的 zpkg / zbc 并入**当前 VM**，以及按全限定名调用 / 实例化其中的成员。
///
/// 函数与类型变得可调用、可反射。与 `AssemblyLoadContext.Load`（反射投影、只读
/// 枚举）的区别：本类加载的代码并入 root 上下文，**可执行**。
public static class ModuleLoader {
    /// 按路径加载 .zpkg / .zbc（含依赖闭包）。加载失败（文件缺失 / 格式代差 / indexed zpkg
    /// 缺散装 zbc）抛异常。
    public static void Load(string path) {
        ModuleLoader._load(path);
    }

    /// 从内存字节加载（packed zpkg 或裸 zbc，按 magic 区分），零落盘。成功返回 true；畸形字节抛异常。
    [Native("__load_bytecode_in_memory")]
    public static extern bool LoadBytes(byte[] bytes);

    /// 按全限定名调用一个**零参**静态 / 自由函数，返回其（装箱的）结果（void → null）。
    /// 被调函数里抛出的异常保持原类型向外传播。
    [Native("__invoke_static")]
    public static extern object Invoke(string fqn);

    /// 按全限定类型名实例化（无参构造）。
    ///
    /// 类型解析不到返回 null —— 调用方据此给出带上下文的诊断，再用 `as <接口>` 做
    /// 契约校验（接口对不上同样得到 null）。
    public static object Create(string typeFqn) {
        Type t = Type.GetType(typeFqn);
        if (t == null) { return null; }
        return Activator.CreateInstance(t);
    }

    /// 把每个程序放进一个**全新隔离的 VM 上下文**运行，按输入顺序返回各自捕获的 stdout。
    ///
    /// 程序为自包含的 app.zpkg / .zbc，各自拥有独立的堆、静态字段、函数表。
    /// `entries[i]` 是 `paths[i]` 的入口全限定名（"" = 产物内置入口）；`libsDir`
    /// 提供标准库；`jobs` 个上下文并行（<=0 = 按核数，1 = 串行）。
    [Native("__run_goldens_isolated")]
    public static extern string[] RunIsolated(string[] paths, string[] entries, string libsDir, int jobs);

    // 返回值没有意义，丢弃。
    [Native("__load_module")]
    private static extern object _load(string path);
}
