// 实现笔记：native 句柄（ContextId）存于 VM 的 NativeData；本类无数据字段。
namespace Std.Runtime;

/// z42 的加载上下文（对标 dotnet `AssemblyLoadContext`）。把 zpkg 载入可界定边界的上下文：
/// root（core / stdlib / 主程序所在，永驻不可回收）+ collectible（按需创建，可卸载）。
public sealed class AssemblyLoadContext {
    /// 永驻 root 上下文（core / stdlib / 主程序所在），IsCollectible == false。
    // z42 stdlib 无静态属性先例，静态成员一律 extern 方法。
    [Native("__lctx_default")]
    public static extern AssemblyLoadContext Default();

    /// 创建一个可回收（collectible）上下文。
    [Native("__lctx_create_collectible")]
    public static extern AssemblyLoadContext CreateCollectible(string name);

    /// 上下文名字（root 恒为 "root"）。
    [Native("__lctx_name")]
    public extern string Name { get; }

    /// 是否可回收。root → false；CreateCollectible 建的 → true。
    [Native("__lctx_is_collectible")]
    public extern bool IsCollectible { get; }

    /// 把一个 zpkg 载入本上下文，返回其运行时 Assembly 投影。
    [Native("__lctx_load")]
    public extern Std.Reflection.Assembly Load(string zpkgPath);

    /// 本上下文已载入的 assembly 列表。
    [Native("__lctx_assemblies")]
    public extern Std.Reflection.Assembly[] GetAssemblies();

    /// 卸载本上下文：标记为 Unloading，由 GC 惰性回收。root 永驻不可卸载 → 抛
    /// `InvalidOperationException`。fire-and-forget（卸载惰性，不保证立即回收）。
    public void Unload() {
        if (!this.IsCollectible) {
            throw new Std.InvalidOperationException(
                "root AssemblyLoadContext 永驻，不可卸载");
        }
        this.__unload();
    }

    // 标记本上下文为 Unloading（native）。root 检查在上面的 Unload() 里做（抛类型化异常）。
    [Native("__lctx_unload")]
    private extern void __unload();
}
