namespace Std.Runtime;

/// 应用自定义配置属性（**app 自己的**配置，只读）。
///
/// 来自工程 manifest 的 `[properties]` + `[profile.<n>.properties]`，由 `z42c build`
/// 烤进 runtimeconfig.toml 随产物分发。
///
/// 与 `Std.Runtime.RuntimeConfig` 的分工：RuntimeConfig 是 VM 旋钮（有登记表、校验、
/// 五层优先级链）；AppProperties 是 app 自己的配置（VM 不理解不校验，未知 key 是正常
/// 情形，只从 app 侧车来，没有 CLI / env / 用户配置覆盖）。
///
/// 完整 TOML 类型：标量用 `Get` 一次拿到；数组 / 嵌套表用 `Raw()` 取整段 TOML 文本
/// 交给 `Std.Toml` 解析。
public static class AppProperties {
    /// 顶层标量属性；不存在、或该键的值不是标量（数组 / 表）→ null（非标量请用 `Raw()`）。
    /// 整数 / 布尔 / 日期渲染为字符串。
    [Native("__app_prop")]
    public static extern string? Get(string key);

    /// 顶层是否存在该键（值为数组 / 表时同样为 true）。
    [Native("__app_prop_has")]
    public static extern bool Has(string key);

    /// 全部顶层键。
    [Native("__app_prop_names")]
    public static extern string[] Names();

    /// 整段 `[properties]` 的 TOML 文本；没有属性时返回 null（区别于空表）。
    [Native("__app_props_toml")]
    public static extern string? Raw();

    /// 便利包装：取不到（不存在或非标量）时返回 fallback。
    public static string GetOrDefault(string key, string fallback) {
        string? v = Get(key);
        if (v == null) { return fallback; }
        return v;
    }
}
