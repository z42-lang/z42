namespace Std.Runtime;

/// 运行时设置的**只读**查询面。z42vm 把每个旋钮按固定优先级链解析一次，boot 后冻结：
/// `cli (--set / --mode)` > `env (Z42_*)` > `用户配置 (Z42_CONFIG)` > `应用侧车 (Z42_APP_CONFIG)`
/// > `内置默认`。本类给解析后的生效值与来源。**没有 setter**（boot 后物理不可变）；
/// 运行期可调的能力走专门 API（`Std.GC`）。
public static class RuntimeConfig {
    /// 旋钮的生效值（如 "stw"）。未知 key、或该旋钮取内置默认时返回 null。key 用旋钮的配置键
    /// （`gc-mode`），也接受环境变量名（`Z42_GC_MODE`）。
    [Native("__cfg_get")]
    public static extern string? Get(string key);

    /// 生效值来自哪一层："cli" | "env" | "user-config" | "app-config" | "default"。
    /// 未知 key 返回 "unknown"。
    [Native("__cfg_source")]
    public static extern string Source(string key);

    /// 全部旋钮的 key。
    [Native("__cfg_names")]
    public static extern string[] Names();

    /// 扁平转储，每项形如 `"gc-mode=stw|env"`；取默认时 value 段为空。按**第一个** `=`
    /// 和**最后一个** `|` 切分（值本身可能含 `=`）。
    [Native("__cfg_dump")]
    public static extern string[] Dump();

    /// 旋钮的一行说明；未知 key 返回 null。
    [Native("__cfg_describe")]
    public static extern string? Describe(string key);

    /// 该旋钮在**当前 build 与平台**是否存在（如 `jit-profile` 需要 jit feature，interp-only
    /// 的 z42vm 上返回 false）。未知 key 返回 false。
    [Native("__cfg_available")]
    public static extern bool IsAvailable(string key);

    /// 便利包装：取不到时返回 fallback。
    public static string GetOrDefault(string key, string fallback) {
        string? v = Get(key);
        if (v == null) { return fallback; }
        return v;
    }
}
