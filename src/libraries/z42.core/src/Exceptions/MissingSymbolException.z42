namespace Std;

/// 运行时解析不到某个符号（函数 / 类型 / 字段 / 构造器）——通常意味着依赖版本 skew：
/// 编译时依赖新版，运行时加载到的却是缺该符号的旧版。
///
/// 想在缺符号时主动降级而不是收异常，用编译期宏 `available!(X)` 把那条分支保护起来——被保护的分支
/// 会在加载期整块剪掉，其符号永不参与解析，因此不会触发本异常。
public class MissingSymbolException : Exception {
    /// 用消息构造。
    public MissingSymbolException(string message) : base(message) {}

    override string ToString() {
        return "MissingSymbolException: " + this.Message;
    }
}
