namespace Std;
using Std.Reflection;

/// 运行期类型描述符，由 `Object.GetType()` 返回（C# System.Type 对标）。
///
/// 携带 native 句柄指向真实 VM `TypeDesc`；基元（int / long / bool / …）解析到其真实
/// `Std.*` 包装结构体句柄——`typeof(int)` 与 `(5).GetType()` **值相等**（按 FullName，见
/// `operator ==`），Name 为 `Int32`、FullName 为 `Std.Int32`、IsValueType true、成员可枚举。
/// 只有数组返回无句柄的合成体（Name/FullName 已填，成员查询为空）。不能从用户代码构造。
///
/// 注：「相等」是值相等（按 FullName），不是同一个对象——每次 typeof / GetType() 都新建，
/// `ReferenceEquals` 恒为假。
public sealed class Type : MemberInfo {
    /// VM 写入的短名（优先用继承的 `Name` 属性；此处保留给底层 golden 测试与 z42.harness 直读）。
    public string __name;
    /// VM 写入的全限定名（优先用 `FullName` 属性）。
    public string __fullName;

    /// VM 写入：是否数组类型；`__elementName` 存元素类型的 FQ 名。
    ///
    /// `typeof(int[])`、数组字段/参数类型、`arr.GetType()` 为 true；
    /// `GetElementType()` 解析为 `Type`（缺省 null）。
    public bool IsArray;
    /// 数组元素类型的 FQ 名（非数组为 ""）。
    public string __elementName;

    /// VM 写入：定义该类型的 assembly 的 AssemblyId（0 = root）。内部（`__` 前缀），非用户读取。
    public long __asmId;

    /// VM 写入：构造泛型（`typeof(Box<int>)`）的实参 `Type[]`；开放定义与非泛型为 null。
    ///
    /// 非 null 标记该类型为构造类型，故 `IsGenericTypeDefinition` false、
    /// `GetGenericArguments()` 返回这些。
    public Type[] __typeArgs;

    /// 按全限定名解析 Type（如 `"Demo.Point"`）；未知返回 null。补足 typeof(T) / obj.GetType()
    /// 之外的反射查找路径。
    [Native("__type_get_type")]
    public static extern Type GetType(string fqn);

    /// 数组类型的元素类型（`typeof(int[]).GetElementType()` → `typeof(int)`）；非数组为 null。
    [Native("__type_element")]
    public extern Type GetElementType();

    /// 含命名空间的全限定名，如 `"geometry.Circle"`。
    [Native("__type_full_name")]
    public extern string FullName { get; }

    // ── 值相等 ────────────────────────────────────────────────────────────────
    //
    // 身份判据 = FullName。`Type` 在 z42 里的身份就是 FQ 名；数组等无句柄的合成体也有填好的
    // FullName。判空用 Object.ReferenceEquals 而非 `a == null`，否则会递归派发回本运算符。

    /// 按 FullName 比较相等（两侧皆 null 才相等；一侧 null 为不等）。
    public static bool operator ==(Type a, Type b) {
        bool an = Object.ReferenceEquals(a, null);
        bool bn = Object.ReferenceEquals(b, null);
        if (an || bn) { return an && bn; }
        return a.FullName == b.FullName;
    }

    /// 按 FullName 判断不等。
    public static bool operator !=(Type a, Type b) {
        bool an = Object.ReferenceEquals(a, null);
        bool bn = Object.ReferenceEquals(b, null);
        if (an || bn) { return !(an && bn); }
        return a.FullName != b.FullName;
    }

    /// 与 `==` 同一判据（FullName），保证与 GetHashCode 口径一致。
    public override bool Equals(object other) {
        Type t = other as Type;
        if (t == null) { return false; }
        return this.FullName == t.FullName;
    }

    /// FullName 的哈希码。
    public override int GetHashCode() { return this.FullName.GetHashCode(); }

    /// 基类类型；无显式基类的类为 `Std.Object`；`Std.Object` 自身与无句柄 Type（基元/数组）为 null。
    [Native("__type_base")]
    public extern Type BaseType { get; }

    /// 是否为 `abstract` 类型。非 abstract 类与无句柄 Type（基元/数组）为 false。
    [Native("__type_is_abstract")]
    public extern bool IsAbstract { get; }

    /// 是否为 `sealed` 类型。否则 / 无句柄为 false。
    [Native("__type_is_sealed")]
    public extern bool IsSealed { get; }

    /// 是否为值类型（`struct`）。
    [Native("__type_is_value_type")]
    public extern bool IsValueType { get; }

    /// 是否为 `record` 类型。
    [Native("__type_is_record")]
    public extern bool IsRecord { get; }

    /// 是否为 `interface`。class / struct / record / enum / 基元 / 数组为 false。
    [Native("__type_is_interface")]
    public extern bool IsInterface { get; }

    /// 是否为 `enum`。
    [Native("__type_is_enum")]
    public extern bool IsEnum { get; }

    /// enum 的底层整型：z42 一律以 i64（long）背书 → 恒返 typeof(long)。
    ///
    /// 非 enum 抛 Std.Exception（镜像 C#）。
    [Native("__type_enum_underlying")]
    public extern Type GetEnumUnderlyingType();

    // ── 嵌套类型 ──────────────────────────────────────────────────────────────
    // 源码写 `Outer.Inner`；元数据 FQ 名用 `+`（`Ns.Outer+Inner`）承载嵌套关系，反射纯
    // 字符串派生。Name=简单名 `Inner`、FullName=`Ns.Outer+Inner`。

    /// 是否嵌套于另一类型（其 FQ 名含 `+`）。
    [Native("__type_is_nested")]
    public extern bool IsNested { get; }

    /// 直接外层类型（嵌套时），否则 null。`typeof(Outer.Inner).GetDeclaringType()` → typeof(Outer)。
    [Native("__type_declaring_type")]
    public extern Type GetDeclaringType();

    /// 直接嵌套于本类型的类型（不含更深层 / 继承），有序。
    [Native("__type_nested_types")]
    public extern Type[] GetNestedTypes();

    /// 是否为 `delegate` 类型（签名经 GetMethods() 的合成 Invoke 反射）。
    [Native("__type_is_delegate")]
    public extern bool IsDelegate { get; }

    /// 是否为引用类类型（含 `record`）。既非值类型（struct）也非接口；基元/数组/enum 为 false。
    [Native("__type_is_class")]
    public extern bool IsClass { get; }

    /// 是否为泛型类型（含类型参数，如 `Box<T>`）。
    [Native("__type_is_generic")]
    public extern bool IsGenericType { get; }

    /// 是否为泛型**定义**（开放 `Box<>`）而非构造实例化（`Box<int>`）。非泛型为 false。
    [Native("__type_is_generic_definition")]
    public extern bool IsGenericTypeDefinition { get; }

    /// 是否为基元类型（int / long / bool / char / float / double / ...）。`string` 不是基元。
    [Native("__type_is_primitive")]
    public extern bool IsPrimitive { get; }

    // ── 声明可见性 ────────────────────────────────────────────────────────────
    // 类型的声明访问级，取自 zbc 1.33 class-visibility 字节。与 IsNested 组合区分顶层与嵌套；
    // 无句柄 Type（基元/数组）→ Public。

    /// 类型的声明访问级（public / private / protected / internal）。无句柄 Type → Public。
    [Native("__type_visibility")]
    public extern TypeVisibility Visibility { get; }

    // ── C# 对齐的可见性谓词（Visibility × IsNested 的计算属性）─────────────────
    // 完全对齐 C# System.Type 的 6 个 bool 属性；native interop 只用 `__type_visibility`，
    // 这 6 个在纯脚本层派生。

    /// 顶层 public 类型（非嵌套且 public）。
    public bool IsPublic         { get { return this.Visibility == TypeVisibility.Public   && !this.IsNested; } }
    /// 顶层非 public 类型（非嵌套且非 public，即顶层 internal）。
    public bool IsNotPublic      { get { return this.Visibility != TypeVisibility.Public   && !this.IsNested; } }
    /// 嵌套 public。
    public bool IsNestedPublic   { get { return this.Visibility == TypeVisibility.Public   &&  this.IsNested; } }
    /// 嵌套 private。
    public bool IsNestedPrivate  { get { return this.Visibility == TypeVisibility.Private  &&  this.IsNested; } }
    /// 嵌套 protected（C# "family"）。
    public bool IsNestedFamily   { get { return this.Visibility == TypeVisibility.Protected && this.IsNested; } }
    /// 嵌套 internal（C# "assembly"）。
    public bool IsNestedAssembly { get { return this.Visibility == TypeVisibility.Internal &&  this.IsNested; } }

    /// 公开实例字段（含继承；基类在前）。基元 / 数组为空。
    [Native("__type_fields")]
    public extern Std.Reflection.FieldInfo[] GetFields();

    /// 方法（含继承 / 虚方法）。
    [Native("__type_methods")]
    public extern Std.Reflection.MethodInfo[] GetMethods();

    /// 本类型声明的构造器；每个 ConstructorInfo.Invoke(args) 分配并构造新实例。
    ///
    /// 基元 / 数组 / 接口为空。按参数类型的重载选择（GetConstructor(Type[])）未实现——
    /// 枚举后自行查参数。
    [Native("__type_constructors")]
    public extern Std.Reflection.ConstructorInfo[] GetConstructors();

    /// 字段与方法合在一起。
    [Native("__type_members")]
    public extern Std.Reflection.MemberInfo[] GetMembers();

    /// 属性（auto-property + extern getter），由 `get_<X>` / `set_<X>` 访问器约定派生，含继承。
    ///
    /// 基元 / 数组为空。访问器方法仍出现在 GetMethods() 中（C# 对齐）；这是附加的属性视图。
    [Native("__type_properties")]
    public extern Std.Reflection.PropertyInfo[] GetProperties();

    /// 构造泛型的实参（`typeof(Box<int>)` → [int]）。开放定义与非泛型为空。
    [Native("__type_generic_args")]
    public extern Type[] GetGenericArguments();

    /// 构造类型的开放泛型定义（`typeof(Box<int>).GetGenericTypeDefinition()` → `Box<>`）。
    ///
    /// 非泛型抛异常（镜像 C# InvalidOperationException）。
    [Native("__type_generic_definition")]
    public extern Type GetGenericTypeDefinition();

    /// 由开放定义 + 实参在运行期构造泛型；校验实参个数与 `where` 约束。
    ///
    /// `typeof(List<>).MakeGenericType(typeof(int))` → `List<int>`。违反约束抛
    /// Std.Exception（反射是绕过编译期约束检查的逃生门，故自行把关）。
    [Native("__type_make_generic")]
    public extern Type MakeGenericType(params Type[] typeArgs);

    /// 本类型实现的接口（自身声明 + 基类链继承，按名去重）。
    ///
    /// 返回真实接口句柄（IsInterface / FullName 可用）。接口的传递继承（接口继承接口）
    /// 尚未包含。
    [Native("__type_interfaces")]
    public extern Type[] GetInterfaces();

    /// 本类型实现的、给定（简单）名的接口，否则 null。GetInterfaces() 的便利封装。
    public Type? GetInterface(string name) {
        Type[] ifaces = this.GetInterfaces();
        int i = 0;
        while (i < ifaces.Length) {
            Type t = ifaces[i];
            if (t.Name == name) {
                return t;
            }
            i = i + 1;
        }
        return null;
    }

    /// `c` 的实例能否赋给本类型变量：`c` 是 this、派生自 this、或实现接口 `this`。
    ///
    /// 反射形式的 `is`；VM 里比真实类型身份（非字符串）。null → false。
    [Native("__type_is_assignable_from")]
    public extern bool IsAssignableFrom(Type c);

    // ── Load context ──────────────────────────────────────────────────────────

    /// 是否加载进可回收的 AssemblyLoadContext（镜像 .NET Type.IsCollectible）。
    ///
    /// 常驻 root context 的类型（core/stdlib/main 与基元/数组合成体）→ false。
    [Native("__type_is_collectible")]
    public extern bool IsCollectible { get; }

    /// 定义此类型的 assembly（zpkg 运行期投影，镜像 .NET Type.Assembly）。root 类型报合成 root。
    [Native("__type_assembly")]
    public extern Std.Reflection.Assembly Assembly { get; }

    // ── 自定义 attribute ──────────────────────────────────────────────────────

    /// 本类型 attribute 实例的惰性缓存：首次 GetCustomAttributes() 前为 null。
    ///
    /// 之后同一数组（同一批实例）复用（C# 每次调用都新分配，z42 不）。
    public Attribute[] __attrCache;

    /// VM 构建的活 attribute 实例（每个应用一次，按应用顺序）。VM 调用各自编译器合成工厂。
    [Native("__type_custom_attributes")]
    public extern Attribute[] __customAttributes();

    /// 应用于本类型的用户 attribute（活实例）。缓存：首次调用物化，重复调用返回同一批实例。
    public Attribute[] GetCustomAttributes() {
        if (this.__attrCache != null) {
            return this.__attrCache;
        }
        this.__attrCache = this.__customAttributes();
        return this.__attrCache;
    }

    /// 给定类型的单个 attribute，否则 null。按实例运行时类型（FullName）比较，子类 attribute
    /// 也命中。
    public Attribute? GetAttribute(Type attributeType) {
        Attribute[] all = this.GetCustomAttributes();
        int i = 0;
        while (i < all.Length) {
            Attribute a = all[i];
            Type at = a.GetType();
            if (at.FullName == attributeType.FullName) {
                return a;
            }
            i = i + 1;
        }
        return null;
    }
}
