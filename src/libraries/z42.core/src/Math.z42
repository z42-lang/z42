namespace Std;

/// 数学常量与数值函数的静态容器。
///
/// 常量（Pi / E / Tau）与纯脚本辅助函数，加上 libm 的 native 绑定（幂、三角、对数等）。
/// 整数版取独立名字（AbsInt / MaxInt / MinInt / SignInt / ClampInt）：z42 按 arity 消歧、
/// 无法承载两个同 arity 重载，故 int 保持型与 double 版分开命名。
public static class Math {
    // ── 常量 ──────────────────────────────────────────────────────────────────
    /// 圆周率 π。
    public static double Pi  = 3.141592653589793;
    /// 自然常数 e。
    public static double E   = 2.718281828459045;
    /// 圆周率 × 2（τ）。
    public static double Tau = 6.283185307179586;

    // ── 纯脚本辅助 ────────────────────────────────────────────────────────────
    // 命名惯例：保留一个 double 主签名（int 实参经加宽进入），int 保持型用带 Int 后缀的
    // 独立名字，绕开 z42 的 arity-only 重载消歧。

    /// 绝对值。
    public static double Abs(double x) {
        if (x < 0.0) return -x;
        return x;
    }
    /// 绝对值（int 保持型）。
    public static int AbsInt(int x) {
        if (x < 0) return -x;
        return x;
    }
    /// 较大者。
    public static double Max(double a, double b) {
        if (a >= b) return a;
        return b;
    }
    /// 较大者（int 保持型）。
    public static int MaxInt(int a, int b) {
        if (a >= b) return a;
        return b;
    }
    /// 较小者。
    public static double Min(double a, double b) {
        if (a <= b) return a;
        return b;
    }
    /// 较小者（int 保持型）。
    public static int MinInt(int a, int b) {
        if (a <= b) return a;
        return b;
    }

    /// 符号：-1 / 0 / +1。
    public static int Sign(double x) {
        if (x < 0.0) return -1;
        if (x > 0.0) return 1;
        return 0;
    }
    /// 符号（int 保持型）：-1 / 0 / +1。
    public static int SignInt(int x) {
        if (x < 0) return -1;
        if (x > 0) return 1;
        return 0;
    }

    /// 把 `x` 夹到 `[lo, hi]`（假定 lo <= hi）。
    public static double Clamp(double x, double lo, double hi) {
        if (x < lo) return lo;
        if (x > hi) return hi;
        return x;
    }
    /// 把 `x` 夹到 `[lo, hi]`（int 保持型）。
    public static int ClampInt(int x, int lo, int hi) {
        if (x < lo) return lo;
        if (x > hi) return hi;
        return x;
    }

    // 纯脚本辅助，建在下方 native 原语之上。

    /// 向零取整（丢弃小数部分），同 System.Math.Truncate。
    public static double Truncate(double x) {
        if (x < 0.0) return Ceiling(x);
        return Floor(x);
    }
    /// 四舍五入到 `digits` 位小数。放大到整数范围、经单参 Round 后再缩回。
    public static double Round(double x, int digits) {
        double factor = Pow(10.0, (double)digits);
        return Round(x * factor) / factor;
    }

    // ── Native 绑定（libm 必需）─────────────────────────────────────────────
    /// 幂 `base^exp`。
    [Native("__math_pow")]    public static extern double Pow(double base, double exp);
    /// 平方根。
    [Native("__math_sqrt")]   public static extern double Sqrt(double x);
    /// 向下取整（不大于 x 的最大整数）。
    [Native("__math_floor")]  public static extern double Floor(double x);
    /// 向上取整（不小于 x 的最小整数）。
    [Native("__math_ceiling")] public static extern double Ceiling(double x);
    /// 四舍五入到最近的整数。
    [Native("__math_round")]  public static extern double Round(double x);
    /// 自然对数（以 e 为底）。
    [Native("__math_log")]    public static extern double Log(double x);
    /// 常用对数（以 10 为底）。
    [Native("__math_log10")]  public static extern double Log10(double x);
    /// 正弦（弧度）。
    [Native("__math_sin")]    public static extern double Sin(double x);
    /// 余弦（弧度）。
    [Native("__math_cos")]    public static extern double Cos(double x);
    /// 正切（弧度）。
    [Native("__math_tan")]    public static extern double Tan(double x);
    /// 反正切（`atan2(y, x)`，结果在 (-π, π]）。
    [Native("__math_atan2")]  public static extern double Atan2(double y, double x);
    /// 自然指数 `e^x`。
    [Native("__math_exp")]    public static extern double Exp(double x);
    /// 反正弦。
    [Native("__math_asin")]   public static extern double Asin(double x);
    /// 反余弦。
    [Native("__math_acos")]   public static extern double Acos(double x);
    /// 反正切。
    [Native("__math_atan")]   public static extern double Atan(double x);
    /// 双曲正弦。
    [Native("__math_sinh")]   public static extern double Sinh(double x);
    /// 双曲余弦。
    [Native("__math_cosh")]   public static extern double Cosh(double x);
    /// 双曲正切。
    [Native("__math_tanh")]   public static extern double Tanh(double x);
    /// 立方根。
    [Native("__math_cbrt")]   public static extern double Cbrt(double x);
    /// 以 2 为底的对数。
    [Native("__math_log2")]   public static extern double Log2(double x);
}
