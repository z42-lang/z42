namespace Std;

/// 字符串 ↔ 数值 / 布尔 / 字符等类型之间的转换。
///
/// 核心转换（ToInt32 / ToInt64 / ToDouble / ToString）是 VM intrinsics 的 native 绑定；
/// 其余窄化数值 / 布尔 / 字符转换委托到对应基元的 `Parse`，让范围判定只有一处。
public static class Convert {
    /// 解析为 `int`。
    [Native("__int32_parse")]
    public static extern int ToInt32(string s);

    /// 解析为 `long`。
    [Native("__int64_parse")]
    public static extern long ToInt64(string s);

    /// 解析为 `double`。
    [Native("__double_parse")]
    public static extern double ToDouble(string s);

    /// 任意值转字符串。
    [Native("__to_str")]
    public static extern string ToString(object value);

    // ── String → 窄化数值 / bool / char ───────────────────────────────────────
    // 委托到对应基元的 Parse，范围判定与基元保持一致。

    /// 解析为 `sbyte`。
    public static sbyte  ToSByte(string s)  { return SByte.Parse(s); }
    /// 解析为 `byte`。
    public static byte   ToByte(string s)   { return Byte.Parse(s); }
    /// 解析为 `short`。
    public static short  ToInt16(string s)  { return Int16.Parse(s); }
    /// 解析为 `ushort`。
    public static ushort ToUInt16(string s) { return UInt16.Parse(s); }
    /// 解析为 `uint`。
    public static uint   ToUInt32(string s) { return UInt32.Parse(s); }
    /// 解析为 `ulong`。
    public static ulong  ToUInt64(string s) { return UInt64.Parse(s); }

    /// 解析为 `float`。
    public static float ToSingle(string s)  { return Single.Parse(s); }
    /// 解析为 `bool`。
    public static bool  ToBoolean(string s) { return Boolean.Parse(s); }
    /// 解析为 `char`。
    public static char  ToChar(string s)    { return Char.Parse(s); }

    // ── 十六进制编码 ─────────────────────────────────────────────────────────

    /// 把字节编码为小写十六进制字符串（每字节 2 字符，无前缀、无分隔）。
    public static string ToHexStringLower(byte[] bytes) {
        if (bytes.Length == 0) { return ""; }
        string alpha = "0123456789abcdef";
        char[] result = new char[bytes.Length * 2];
        int i = 0;
        while (i < bytes.Length) {
            int b = (int)bytes[i];
            result[i * 2]     = alpha.CharAt((b >> 4) & 0x0F);
            result[i * 2 + 1] = alpha.CharAt(b & 0x0F);
            i = i + 1;
        }
        return String.FromChars(result);
    }

    /// 把 `text` 的 UTF-8 编码字节编码为小写十六进制字符串。
    ///
    /// 等价于 `ToHexStringLower(Utf8.GetBytes(text))`，但不物化中间字节数组。
    [Native("__hex_str")]
    public static extern string ToHexStringLower(string text);
}
