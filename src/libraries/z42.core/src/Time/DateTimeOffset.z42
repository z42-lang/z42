namespace Std.Time;

/// UTC 时刻与固定偏移时区的配对（等价 C# `DateTimeOffset`）。九个日历访问器取的是
/// **本地**（已加偏移）字段。
public sealed class DateTimeOffset {
    private DateTime _utc;
    private TimeZone _tz;

    /// 以 UTC 时刻 + 时区构造；任一参数为 null 抛 `ArgumentNullException`。
    public DateTimeOffset(DateTime utc, TimeZone tz) {
        if (utc == null) {
            throw new ArgumentNullException("DateTimeOffset: utc must not be null");
        }
        if (tz == null) {
            throw new ArgumentNullException("DateTimeOffset: tz must not be null");
        }
        this._utc = utc;
        this._tz  = tz;
    }

    /// 当前时刻在 `tz` 下的 DateTimeOffset。
    public static DateTimeOffset Now(TimeZone tz) {
        return new DateTimeOffset(DateTime.UtcNow(), tz);
    }

    /// 由本地日历分量 + 时区构造；`tz` 为 null 抛 `ArgumentNullException`。
    public static DateTimeOffset FromLocal(int year, int month, int day,
                                           int hour, int minute, int second,
                                           int millisecond, TimeZone tz) {
        if (tz == null) {
            throw new ArgumentNullException("DateTimeOffset.FromLocal: tz must not be null");
        }
        DateTime asUtc = DateTime.Utc(year, month, day, hour, minute, second, millisecond);
        DateTime utc = asUtc.AddMinutes(-tz.OffsetMinutes());
        return new DateTimeOffset(utc, tz);
    }

    /// 解析带**必须**偏移后缀（`Z` / `±HH:MM` / `±HHMM` / `±HH`）的 ISO 8601。
    ///
    /// 缺后缀抛 `FormatException`。
    public static DateTimeOffset Parse(string s) {
        if (s == null || s.Length == 0) {
            throw new FormatException("DateTimeOffset.Parse: empty input");
        }
        int suffixPos = -1;
        char suffixChar = ' ';
        if (s.Length >= 11) {
            int i = s.Length - 1;
            while (i >= 10) {
                char c = s.CharAt(i);
                if (c == 'Z' || c == '+' || c == '-') {
                    suffixPos = i;
                    suffixChar = c;
                    i = -1;
                } else {
                    i = i - 1;
                }
            }
        }
        if (suffixPos < 0) {
            throw new FormatException(
                "DateTimeOffset.Parse: missing offset suffix in '" + s + "'");
        }
        DateTime utc = DateTime.ParseIso8601(s);
        TimeZone tz;
        if (suffixChar == 'Z') {
            tz = TimeZone.Utc();
        } else {
            int sign = (suffixChar == '-') ? -1 : 1;
            string rest = s.Substring(suffixPos + 1, s.Length - (suffixPos + 1));
            int colonPos = -1;
            int j = 0;
            while (j < rest.Length) {
                if (rest.CharAt(j) == ':') { colonPos = j; j = rest.Length; }
                else { j = j + 1; }
            }
            int hh = 0;
            int mm = 0;
            if (colonPos >= 0) {
                hh = DateTimeOffset._parseInt(rest.Substring(0, colonPos), s);
                mm = DateTimeOffset._parseInt(rest.Substring(colonPos + 1, rest.Length - (colonPos + 1)), s);
            } else if (rest.Length == 4) {
                hh = DateTimeOffset._parseInt(rest.Substring(0, 2), s);
                mm = DateTimeOffset._parseInt(rest.Substring(2, 2), s);
            } else if (rest.Length == 2) {
                hh = DateTimeOffset._parseInt(rest, s);
            } else {
                throw new FormatException(
                    "DateTimeOffset.Parse: malformed offset in '" + s + "'");
            }
            tz = TimeZone.FromOffsetMinutes(sign * (hh * 60 + mm));
        }
        return new DateTimeOffset(utc, tz);
    }

    /// 底层 UTC 时刻。
    public DateTime UtcDateTime() { return this._utc; }

    /// 本地墙钟读数（不带偏移信息，塞进一个 DateTime）。
    public DateTime LocalDateTime() {
        return this._utc.AddMinutes(this._tz.OffsetMinutes());
    }

    /// 时区（偏移）。
    public TimeZone Offset() { return this._tz; }

    /// 本地年份。
    public int Year()        { return this.LocalDateTime().Year();        }
    /// 本地月份。
    public int Month()       { return this.LocalDateTime().Month();       }
    /// 本地日。
    public int Day()         { return this.LocalDateTime().Day();         }
    /// 本地时。
    public int Hour()        { return this.LocalDateTime().Hour();        }
    /// 本地分。
    public int Minute()      { return this.LocalDateTime().Minute();      }
    /// 本地秒。
    public int Second()      { return this.LocalDateTime().Second();      }
    /// 本地毫秒。
    public int Millisecond() { return this.LocalDateTime().Millisecond(); }
    /// 本地星期几。
    public int DayOfWeek()   { return this.LocalDateTime().DayOfWeek();   }
    /// 本地一年中的第几天。
    public int DayOfYear()   { return this.LocalDateTime().DayOfYear();   }

    /// 带偏移后缀的 ISO 8601 渲染。
    public string ToIso8601() {
        return this._utc.ToIso8601With(this._tz);
    }

    /// 同 `ToIso8601()`。
    public override string ToString() {
        return this.ToIso8601();
    }

    /// 只比 UTC 时刻（忽略偏移）。
    public bool Equals(DateTimeOffset other) {
        if (other == null) return false;
        return this._utc.Equals(other._utc);
    }

    /// UTC 时刻 + 偏移都相同。
    public bool EqualsExact(DateTimeOffset other) {
        if (other == null) return false;
        if (this._utc.UnixMs() != other._utc.UnixMs()) return false;
        return this._tz.OffsetMinutes() == other._tz.OffsetMinutes();
    }

    /// 是否晚于 `other`。
    public bool IsAfter(DateTimeOffset other)  { return this._utc.IsAfter(other._utc);  }
    /// 是否早于 `other`。
    public bool IsBefore(DateTimeOffset other) { return this._utc.IsBefore(other._utc); }

    /// 与 `other` 的差值。
    public TimeSpan Subtract(DateTimeOffset other) {
        return this._utc.Subtract(other._utc);
    }

    /// 加 TimeSpan。
    public DateTimeOffset Add(TimeSpan span) {
        return new DateTimeOffset(this._utc.Add(span), this._tz);
    }

    /// 减 TimeSpan。
    public DateTimeOffset SubtractSpan(TimeSpan span) {
        return new DateTimeOffset(this._utc.SubtractSpan(span), this._tz);
    }

    static int _parseInt(string s, string original) {
        if (s.Length == 0) {
            throw new FormatException(
                "DateTimeOffset.Parse: empty digit run in offset of '" + original + "'");
        }
        int n = 0;
        int i = 0;
        while (i < s.Length) {
            char c = s.CharAt(i);
            if (c < '0' || c > '9') {
                throw new FormatException(
                    "DateTimeOffset.Parse: non-digit in offset of '" + original + "'");
            }
            n = n * 10 + ((int)c - (int)'0');
            i = i + 1;
        }
        return n;
    }
}
