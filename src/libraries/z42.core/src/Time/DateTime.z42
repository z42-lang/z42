namespace Std.Time;

/// UTC 时刻值，内部单位 Unix epoch 毫秒（i64）。不可变：算术方法返回新对象。
/// `ToString()` 返回 Unix 毫秒数字串；可读输出用 `ToIso8601()`。
public sealed class DateTime {
    private long _unixMs;

    /// 由 Unix 毫秒构造。
    public DateTime(long unixMs) {
        _unixMs = unixMs;
    }

    // 委托 Std.Runtime.Clock.WallMillis()（__time_now_ms 唯一声明点）。
    private static long NowMs() { return Clock.WallMillis(); }

    // ── 工厂方法 ──────────────────────────────────────────────────────────────

    /// 当前 UTC 时刻。
    public static DateTime UtcNow() { return new DateTime(NowMs()); }

    /// 由 Unix 毫秒构造。
    public static DateTime FromUnixMs(long unixMs) {
        return new DateTime(unixMs);
    }

    /// Unix 纪元（1970 年 1 月 1 日 00:00:00 UTC）。
    public static DateTime UnixEpoch() { return new DateTime(0); }

    // ── 访问器 ────────────────────────────────────────────────────────────────

    /// Unix 毫秒。
    public long UnixMs() { return _unixMs; }

    // ── 日历分解 ─────────────────────────────────────────────────────────────
    // 所有访问器均按 UTC 取值；本地时间先 `ToIso8601With(tz)` 投影。

    /// 年份（Gregorian，含公元前返回负数；公历没有 0 年）。
    public int Year() {
        long days = _DateTimeHelpers._floorDiv(_unixMs, 86400000L);
        long[] ymd = _DateTimeHelpers._civilFromDays(days);
        return (int)ymd[0];
    }

    /// 月份，1..12。
    public int Month() {
        long days = _DateTimeHelpers._floorDiv(_unixMs, 86400000L);
        long[] ymd = _DateTimeHelpers._civilFromDays(days);
        return (int)ymd[1];
    }

    /// 日，1..31。
    public int Day() {
        long days = _DateTimeHelpers._floorDiv(_unixMs, 86400000L);
        long[] ymd = _DateTimeHelpers._civilFromDays(days);
        return (int)ymd[2];
    }

    /// 时，0..23（UTC）。
    public int Hour() {
        return (int)(_DateTimeHelpers._floorMod(_unixMs, 86400000L) / 3600000L);
    }

    /// 分，0..59（UTC）。
    public int Minute() {
        return (int)((_DateTimeHelpers._floorMod(_unixMs, 86400000L) / 60000L) % 60L);
    }

    /// 秒，0..59（UTC）。
    public int Second() {
        return (int)((_DateTimeHelpers._floorMod(_unixMs, 86400000L) / 1000L) % 60L);
    }

    /// 毫秒，0..999。
    public int Millisecond() {
        return (int)(_DateTimeHelpers._floorMod(_unixMs, 1000L));
    }

    /// 星期几，0=Sunday .. 6=Saturday（对齐 .NET / JS `getDay()`）。
    // 实现：1970-01-01 是周四 → days mod 7 得 0=Thursday，加 4 归到 Sunday=0。
    public int DayOfWeek() {
        long days = _DateTimeHelpers._floorDiv(_unixMs, 86400000L);
        long shifted = _DateTimeHelpers._floorMod(days + 4L, 7L);
        return (int)shifted;
    }

    /// 一年中的第几天，1..366。
    public int DayOfYear() {
        int y = this.Year();
        long startOfYear = _DateTimeHelpers._daysFromCivil((long)y, 1L, 1L);
        long thisDay = _DateTimeHelpers._floorDiv(_unixMs, 86400000L);
        return (int)(thisDay - startOfYear + 1L);
    }

    /// 是否闰年：能被 4 整除且（不能被 100 整除或能被 400 整除）。
    public static bool IsLeapYear(int year) {
        if (year % 4 != 0) { return false; }
        if (year % 100 != 0) { return true; }
        return year % 400 == 0;
    }

    /// 给定年月的天数。Month 1..12；越界抛 `ArgumentException`。
    public static int DaysInMonth(int year, int month) {
        if (month < 1 || month > 12) {
            throw new ArgumentException(
                "DateTime.DaysInMonth: month must be 1..12, got " + month.ToString());
        }
        if (month == 2) {
            if (DateTime.IsLeapYear(year)) { return 29; }
            return 28;
        }
        // 4、6、9、11 月 = 30 天；其余 31。
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30; }
        return 31;
    }

    /// 由显式日历分量构造 UTC 时刻。越界抛 `ArgumentException`。
    public static DateTime Utc(int year, int month, int day, int hour, int minute, int second, int millis) {
        if (month < 1 || month > 12) {
            throw new ArgumentException("DateTime.Utc: month must be 1..12, got " + month.ToString());
        }
        int dim = DateTime.DaysInMonth(year, month);
        if (day < 1 || day > dim) {
            throw new ArgumentException(
                "DateTime.Utc: day must be 1.." + dim.ToString() + " for " + year.ToString() + "-" + month.ToString() + ", got " + day.ToString());
        }
        if (hour < 0 || hour > 23) {
            throw new ArgumentException("DateTime.Utc: hour must be 0..23, got " + hour.ToString());
        }
        if (minute < 0 || minute > 59) {
            throw new ArgumentException("DateTime.Utc: minute must be 0..59, got " + minute.ToString());
        }
        if (second < 0 || second > 59) {
            throw new ArgumentException("DateTime.Utc: second must be 0..59, got " + second.ToString());
        }
        if (millis < 0 || millis > 999) {
            throw new ArgumentException("DateTime.Utc: millis must be 0..999, got " + millis.ToString());
        }
        long days = _DateTimeHelpers._daysFromCivil((long)year, (long)month, (long)day);
        long ms = days * 86400000L
                + (long)hour * 3600000L
                + (long)minute * 60000L
                + (long)second * 1000L
                + (long)millis;
        return new DateTime(ms);
    }

    /// 给定日期的 UTC 零点。
    public static DateTime UtcDate(int year, int month, int day) {
        return DateTime.Utc(year, month, day, 0, 0, 0, 0);
    }

    /// 加 `days` 天（可为负）。
    public DateTime AddDays(int days) {
        return new DateTime(_unixMs + (long)days * 86400000L);
    }

    /// 加 `hours` 小时。
    public DateTime AddHours(int hours) {
        return new DateTime(_unixMs + (long)hours * 3600000L);
    }

    /// 加 `minutes` 分钟。
    public DateTime AddMinutes(int minutes) {
        return new DateTime(_unixMs + (long)minutes * 60000L);
    }

    /// 加 `seconds` 秒。
    public DateTime AddSeconds(int seconds) {
        return new DateTime(_unixMs + (long)seconds * 1000L);
    }

    /// 加 `millis` 毫秒。
    public DateTime AddMilliseconds(long millis) {
        return new DateTime(_unixMs + millis);
    }

    /// 加 `months` 个日历月；日号截断到目标月最后一天（1 月 31 日 + 1 月 = 2 月 28/29 日）。
    /// 时分秒毫秒原样保留。
    public DateTime AddMonths(int months) {
        int y = this.Year();
        int m = this.Month();
        int d = this.Day();
        int totalMonth = m - 1 + months;   // 0-indexed
        // totalMonth 对 12 向下取整得年增量（处理负数）。
        int yearDelta;
        int newMonthIdx;
        if (totalMonth >= 0) {
            yearDelta = totalMonth / 12;
            newMonthIdx = totalMonth % 12;
        } else {
            yearDelta = -((-totalMonth + 11) / 12);
            newMonthIdx = totalMonth - yearDelta * 12;
        }
        int newYear = y + yearDelta;
        int newMonth = newMonthIdx + 1;
        int dim = DateTime.DaysInMonth(newYear, newMonth);
        int newDay = d;
        if (newDay > dim) { newDay = dim; }
        return DateTime.Utc(newYear, newMonth, newDay,
                            this.Hour(), this.Minute(), this.Second(), this.Millisecond());
    }

    /// 加 `years` 年；闰年 2 月 29 日在非闰年截断为 2 月 28 日。
    public DateTime AddYears(int years) {
        return this.AddMonths(years * 12);
    }

    // ── 算术 ──────────────────────────────────────────────────────────────────

    /// 与 `other` 的差值（TimeSpan）。
    public TimeSpan Subtract(DateTime other) {
        return TimeSpan.FromNanoseconds((_unixMs - other.UnixMs()) * 1000000);
    }

    /// 加 TimeSpan。
    public DateTime Add(TimeSpan span) {
        return new DateTime(_unixMs + span.TotalMilliseconds());
    }

    /// 减 TimeSpan。
    public DateTime SubtractSpan(TimeSpan span) {
        return new DateTime(_unixMs - span.TotalMilliseconds());
    }

    // ── 比较 ──────────────────────────────────────────────────────────────────

    /// 是否晚于 `other`。
    public bool IsAfter(DateTime other)  { return _unixMs >  other.UnixMs(); }
    /// 是否早于 `other`。
    public bool IsBefore(DateTime other) { return _unixMs <  other.UnixMs(); }
    /// 是否同一时刻。
    public bool Equals(DateTime other)   { return _unixMs == other.UnixMs(); }

    /// 返回 Unix 毫秒数字串。
    public override string ToString() {
        return _unixMs.ToString();
    }

    // ── ISO-8601 格式化 ─────────────────────────────────────────────────────

    /// 格式化为 `"YYYY-MM-DDTHH:MM:SS.sssZ"`（毫秒 3 位，UTC `Z`）。
    public string ToIso8601() {
        return this._formatIsoDate() + "T" + this._formatIsoTimeOfDay(true);
    }

    /// 格式化为 `"YYYY-MM-DDTHH:MM:SSZ"`（不带毫秒）。
    public string ToIso8601Basic() {
        return this._formatIsoDate() + "T" + this._formatIsoTimeOfDay(false);
    }

    /// 以给定固定偏移时区渲染本地墙钟时刻，后缀 `±HH:MM`（UTC 为 `Z`）。总是带毫秒。
    public string ToIso8601With(TimeZone tz) {
        long shifted = _unixMs + (long)tz.OffsetMinutes() * 60000L;
        long days = _DateTimeHelpers._floorDiv(shifted, 86400000L);
        long[] ymd = _DateTimeHelpers._civilFromDays(days);
        long msInDay = _DateTimeHelpers._floorMod(shifted, 86400000L);
        long hour = msInDay / 3600000L;
        long min  = (msInDay / 60000L) % 60L;
        long sec  = (msInDay / 1000L) % 60L;
        long ms   = msInDay % 1000L;
        return _DateTimeHelpers._pad4(ymd[0]) + "-" + _DateTimeHelpers._pad2(ymd[1]) + "-" + _DateTimeHelpers._pad2(ymd[2])
            + "T" + _DateTimeHelpers._pad2(hour) + ":" + _DateTimeHelpers._pad2(min) + ":" + _DateTimeHelpers._pad2(sec)
            + "." + _DateTimeHelpers._pad3(ms) + tz.ToOffsetString();
    }

    // ── ISO-8601 解析 ────────────────────────────────────────────────────────

    /// 解析 RFC 3339 / ISO 8601 子集，返回 UTC 时刻。缺时区后缀按 UTC 处理；畸形输入抛
    /// `ArgumentException`。接受的形状：
    ///   YYYY-MM-DD                  → 当天 UTC 零点
    ///   YYYY-MM-DDTHH:MM:SS         → 无后缀按 UTC
    ///   YYYY-MM-DDTHH:MM:SSZ        → UTC 显式
    ///   YYYY-MM-DDTHH:MM:SS.sss     → 1~9 位小数秒，截断到毫秒
    ///   YYYY-MM-DDTHH:MM:SS±HH:MM   → 带偏移
    ///   分隔符 `T` 也可以是单个空格。
    public static DateTime ParseIso8601(string s) {
        if (s == null || s.Length < 10) {
            string shown = "";
            if (s != null) { shown = s; }
            throw new ArgumentException("ParseIso8601: input too short: '" + shown + "'");
        }
        // YYYY-MM-DD
        int year  = _DateTimeHelpers._parseFixed(s, 0, 4, "year");
        _DateTimeHelpers._expect(s, 4, '-');
        int month = _DateTimeHelpers._parseFixed(s, 5, 2, "month");
        _DateTimeHelpers._expect(s, 7, '-');
        int day   = _DateTimeHelpers._parseFixed(s, 8, 2, "day");
        if (month < 1 || month > 12) {
            throw new ArgumentException("ParseIso8601: month out of range: " + month.ToString());
        }
        // 按该月实际天数校验（同 DateTime.Utc）——"2 月 31 日"这种不存在的日期必须被拒，而不是静默滚到下月。
        int dim = DateTime.DaysInMonth(year, month);
        if (day < 1 || day > dim) {
            throw new ArgumentException(
                "ParseIso8601: day out of range (1.." + dim.ToString() + ") for "
                + year.ToString() + "-" + month.ToString() + ": " + day.ToString());
        }

        long days = _DateTimeHelpers._daysFromCivil((long)year, (long)month, (long)day);
        long unixMs = days * 86400000L;

        if (s.Length == 10) {
            // 只有日期——当天 UTC 零点。
            return new DateTime(unixMs);
        }
        // 位置 10 应为 'T' 或空格分隔符。
        char sep = s.CharAt(10);
        if (sep != 'T' && sep != 't' && sep != ' ') {
            throw new ArgumentException(
                "ParseIso8601: expected 'T' or space at position 10, got '" + _DateTimeHelpers._charStr(sep) + "'");
        }
        if (s.Length < 19) {
            throw new ArgumentException("ParseIso8601: truncated time component");
        }
        int hour = _DateTimeHelpers._parseFixed(s, 11, 2, "hour");
        _DateTimeHelpers._expect(s, 13, ':');
        int minute = _DateTimeHelpers._parseFixed(s, 14, 2, "minute");
        _DateTimeHelpers._expect(s, 16, ':');
        int second = _DateTimeHelpers._parseFixed(s, 17, 2, "second");
        if (hour > 23 || minute > 59 || second > 60) {
            throw new ArgumentException(
                "ParseIso8601: time out of range " + hour.ToString() + ":"
                + minute.ToString() + ":" + second.ToString());
        }
        // 秒归到 59——闰秒（60）接受但归入。
        if (second == 60) { second = 59; }
        unixMs = unixMs
            + (long)hour * 3600000L
            + (long)minute * 60000L
            + (long)second * 1000L;

        int pos = 19;

        // 可选小数秒："." 后 1~9 位 → 毫秒（截断）。
        if (pos < s.Length && s.CharAt(pos) == '.') {
            pos = pos + 1;
            int fracStart = pos;
            while (pos < s.Length && _DateTimeHelpers._isDigit(s.CharAt(pos))) { pos = pos + 1; }
            int fracLen = pos - fracStart;
            if (fracLen == 0) {
                throw new ArgumentException("ParseIso8601: '.' not followed by fractional digits");
            }
            // 最多取 3 位作毫秒；更长截断（DateTime 是毫秒分辨率）。
            long ms = 0L;
            int i = 0;
            while (i < 3) {
                if (i < fracLen) {
                    ms = ms * 10L + (long)((int)s.CharAt(fracStart + i) - (int)'0');
                } else {
                    ms = ms * 10L;
                }
                i = i + 1;
            }
            unixMs = unixMs + ms;
        }

        // 可选时区后缀：Z | ±HH:MM | ±HHMM | ±HH
        if (pos >= s.Length) {
            // 无后缀——按 UTC 处理。
            return new DateTime(unixMs);
        }
        char tz = s.CharAt(pos);
        if (tz == 'Z' || tz == 'z') {
            if (pos + 1 != s.Length) {
                throw new ArgumentException(
                    "ParseIso8601: trailing characters after 'Z': '"
                    + s.Substring(pos + 1, s.Length - pos - 1) + "'");
            }
            return new DateTime(unixMs);
        }
        if (tz != '+' && tz != '-') {
            throw new ArgumentException(
                "ParseIso8601: expected 'Z', '+', or '-' at position "
                + pos.ToString() + ", got '" + _DateTimeHelpers._charStr(tz) + "'");
        }
        int sign = (tz == '-') ? -1 : 1;
        pos = pos + 1;
        if (pos + 2 > s.Length) {
            throw new ArgumentException("ParseIso8601: offset truncated");
        }
        int offHours = _DateTimeHelpers._parseFixed(s, pos, 2, "offset hours");
        pos = pos + 2;
        int offMinutes = 0;
        if (pos < s.Length) {
            // 可选 ':' 然后分钟。
            if (s.CharAt(pos) == ':') { pos = pos + 1; }
            if (pos + 2 > s.Length) {
                throw new ArgumentException("ParseIso8601: offset minutes truncated");
            }
            offMinutes = _DateTimeHelpers._parseFixed(s, pos, 2, "offset minutes");
            pos = pos + 2;
        }
        if (pos != s.Length) {
            throw new ArgumentException(
                "ParseIso8601: trailing characters after offset: '"
                + s.Substring(pos, s.Length - pos) + "'");
        }
        if (offHours > 23 || offMinutes > 59) {
            throw new ArgumentException(
                "ParseIso8601: offset out of range "
                + offHours.ToString() + ":" + offMinutes.ToString());
        }
        long offsetMs = (long)sign * ((long)offHours * 3600000L + (long)offMinutes * 60000L);
        // 本地时间 = UTC + offset，故 UTC = 本地 - offset。
        return new DateTime(unixMs - offsetMs);
    }


    // ── 内部实现 ─────────────────────────────────────────────────────────────

    private string _formatIsoDate() {
        long days = _DateTimeHelpers._floorDiv(_unixMs, 86400000L);
        long[] ymd = _DateTimeHelpers._civilFromDays(days);
        return _DateTimeHelpers._pad4(ymd[0]) + "-" + _DateTimeHelpers._pad2(ymd[1]) + "-" + _DateTimeHelpers._pad2(ymd[2]);
    }

    private string _formatIsoTimeOfDay(bool withMillis) {
        long msInDay = _DateTimeHelpers._floorMod(_unixMs, 86400000L);
        long hour = msInDay / 3600000L;
        long min  = (msInDay / 60000L) % 60L;
        long sec  = (msInDay / 1000L) % 60L;
        long ms   = msInDay % 1000L;
        string s = _DateTimeHelpers._pad2(hour) + ":" + _DateTimeHelpers._pad2(min) + ":" + _DateTimeHelpers._pad2(sec);
        if (withMillis) {
            s = s + "." + _DateTimeHelpers._pad3(ms);
        }
        return s + "Z";
    }

}
