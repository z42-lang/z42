namespace Std;

// 2026-05-14 add-platform-os-stdlib: cross-platform OS / architecture
// identity. Two parallel forms:
//   - String constants (Rust-style, matches std::env::consts values)
//   - Kind int + predicates (.NET-style, type-safe)
//
// Both are backed by the same VM builtin; pick whichever fits your code.
//
// 用法：
//   if (Platform.IsMacOS()) { ... }                    // .NET-style
//   if (Platform.OS() == "linux") { ... }              // Rust-style
//   int k = Platform.OSKindValue();                    // for switch-like
//   if (k == OSKind.Windows) { ... }
public static class Platform {
    // String form (matches Rust std::env::consts::OS / ARCH / FAMILY values).
    [Native("__platform_os")]
    public static extern string OS();
    [Native("__platform_arch")]
    public static extern string Arch();
    [Native("__platform_family")]
    public static extern string Family();

    // Enum form. Kind values are listed in OSKind / ArchKind static classes
    // below and must stay in lockstep with src/runtime/src/corelib/platform.rs.
    [Native("__platform_os_kind")]
    public static extern int OSKindValue();
    [Native("__platform_arch_kind")]
    public static extern int ArchKindValue();

    // Convenience predicates (.NET OperatingSystem.IsXxx style).
    // Each routes through OSKindValue() once — callers can cache locally.
    public static bool IsLinux() {
        return OSKindValue() == OSKind.Linux;
    }
    public static bool IsMacOS() {
        return OSKindValue() == OSKind.MacOS;
    }
    public static bool IsWindows() {
        return OSKindValue() == OSKind.Windows;
    }
    public static bool IsAndroid() {
        return OSKindValue() == OSKind.Android;
    }
    public static bool IsIos() {
        return OSKindValue() == OSKind.Ios;
    }
    public static bool IsWasm() {
        return OSKindValue() == OSKind.Wasm;
    }
    public static bool IsFreeBSD() {
        return OSKindValue() == OSKind.FreeBSD;
    }
    public static bool IsUnix() {
        int k = OSKindValue();
        return k == OSKind.Linux
            || k == OSKind.MacOS
            || k == OSKind.Ios
            || k == OSKind.Android
            || k == OSKind.FreeBSD;
    }

    // ── add-exec-profile-matrix (2026-07-31) — runtime capability query ──
    //
    // Capabilities THIS VM binary was compiled with — the ground truth of
    // "what this binary can do", queried at runtime (not guessed from the
    // platform). The exec-profile bench/test harness probes the *target* VM
    // binary with these so each measurement carries its real caps. Backed by
    // __platform_caps / __platform_exec_modes (corelib/platform.rs), which read
    // the same cfg flags used elsewhere.

    // Capability set: "jit" / "native-interop" / "bundled-compression" (cargo
    // features) + "threads" (real OS-thread support, present wherever
    // std::thread exists — everywhere except wasm; not a build feature).
    [Native("__platform_caps")]
    public static extern string[] Capabilities();

    // Execution backends this binary can dispatch: always includes "interp",
    // plus "jit" / "aot" when those features are compiled in.
    // NOTE: an aot-feature build lists "aot" even though AOT execution is still
    // a stub (roadmap M9) — this reports "compiled in", not "runnable".
    [Native("__platform_exec_modes")]
    public static extern string[] ExecModes();

    // Convenience predicates (mirror the IsLinux() style). Each scans the array
    // once — callers doing repeated checks can cache Capabilities()/ExecModes().
    public static bool HasJit() {
        return _contains(Capabilities(), "jit");
    }
    public static bool HasNativeInterop() {
        return _contains(Capabilities(), "native-interop");
    }
    public static bool HasThreads() {
        return _contains(Capabilities(), "threads");
    }
    // Whether the AOT backend is compiled in. AOT execution itself is not
    // implemented yet (M9) — this is "compiled in", not "runnable".
    public static bool HasAot() {
        return _contains(ExecModes(), "aot");
    }

    private static bool _contains(string[] arr, string v) {
        for (int i = 0; i < arr.Length; i = i + 1) {
            if (arr[i] == v) { return true; }
        }
        return false;
    }
}

// OSKind / ArchKind integer constants. Values must match the int returned by
// __platform_os_kind / __platform_arch_kind in
// src/runtime/src/corelib/platform.rs.
public static class OSKind {
    public static int Unknown = 0;
    public static int Linux   = 1;
    public static int MacOS   = 2;
    public static int Windows = 3;
    public static int Android = 4;
    public static int Ios     = 5;
    public static int Wasm    = 6;
    public static int FreeBSD = 7;
}

// .NET-style architecture names (System.Runtime.InteropServices.Architecture).
// Underscore-digit identifiers like `X86_64` confuse the z42 lexer when used
// inside a class body, so we mirror .NET's `X64` / `Arm64` / `Wasm` / `X86`
// names — they are also shorter and more recognisable than the Rust-style
// triple components.
public static class ArchKind {
    public static int Unknown = 0;
    public static int X64     = 1;
    public static int Arm64   = 2;
    public static int Wasm    = 3;
    public static int X86     = 4;
}
