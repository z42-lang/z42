namespace Std;

using Std.Collections;

// 2026-05-07 add-array-base-class (P4-Array v1):
// 所有 T[] 在运行时是 `Std.Array` 的实例。编译器特殊处理 is-a：`Z42ArrayType`
// 视作 `Z42ClassType("Std.Array")` 的子类型；VM 端 `Value::Array` 不携带
// TypeDesc 引用，VCall 通过 `primitive_class_name` 路由到 `Std.Array.<method>`
// 直查 func_index（与 Std.Int32 / Std.String 同款）。
//
// 用户不能 `new Array()` —— `T[]` 通过 `array_new` IR 指令构造。
// 用户不能继承 Array —— `sealed` 阻止派生。
//
// v1 暴露：Length（IR `array_len` 快路径）+ Clone。
//
// Object 协议成员（GetType / Equals / GetHashCode / ToString）**不在此显式声明**：
// 数组接收者在 TypeChecker 走 loose-bind（`Z42ArrayType` 不匹配任何成员解析分支，
// 方法名原样 emit），运行期 VCall 的 primitive/array 派发先查 `Std.Array.<method>`、
// miss 后兜底 `Std.Object.<method>`（interp/exec_vcall.rs + jit/helpers/vcall.rs）。
// 这四个协议方法与 `Std.Object` 绑定同一批 `__obj_*` builtin、无任何数组专属行为，
// 故直接继承基类实现即可（与 Std.Int32 等基元类同款——它们也不重声明这些）。
//
// 后续 spec：静态算法（Sort/IndexOf/...） / IEnumerable 接入 / 协变 /
// 元素类型反射元数据。
public sealed class Array {
    // 字段占位 —— 实际值由 IR `array_len` 直读；TypeChecker 看到 `arr.Length`
    // 时仍 emit FieldGet（VM `Value::Array` 已 hardcoded "Length" 分支返
    // i64 Length）。
    public int Length;

    // 浅拷贝。元素是引用类型 → 共享引用；与 C# `System.Array.Clone()` 语义一致。
    [Native("__array_clone")]
    public extern Object Clone();

    // ── 反射式建/读写（add-array-property-reflection-api）─────────────────────
    // 照搬 C# System.Array：以运行期 Type 建数组、以实例方法读写元素，供反射式
    // (de)serialization 在编译期不知元素类型时操作数组。native 绑既有 builtin。

    // C# `Array.CreateInstance(Type, int)`：以元素类型 + 长度建一维数组（元素为该类型默认值）。
    [Native("__array_create")]
    public static extern Array CreateInstance(Type elementType, int length);

    // C# `object GetValue(int)`：读元素 index（基元装箱为对应包装类，引用元素原样）。
    [Native("__array_get")]
    public extern Object GetValue(int index);

    // C# `void SetValue(object value, int index)`：写 value 到元素 index（value 在前，
    // 与 C# 原生签名一致；native `__array_set` 按 (array, value, index) 读取）。
    [Native("__array_set")]
    public extern void SetValue(Object value, int index);

    // perf-bulk-array-copy：区间批量拷贝原语（对标 C# 非泛型
    // `System.Array.Copy(Array, int, Array, int, int)`）。下面的泛型 `Copy<T>` 只做参数
    // 校验，搬运本身落到这一次 native 调用 —— 原来每个元素都要一次解释执行的
    // ArrayGet + ArraySet。同一数组内区间重叠按 memmove 语义处理。
    // script-first：这是**一个** bulk 原语（同 `__str_to_chars` / `__str_substring`），
    // 算法（校验、边界、重叠方向的语义约定）仍在 script。
    [Native("__array_copy")]
    public static extern void CopyRange(Array source, int sourceIndex, Array destination, int destinationIndex, int length);

    // ── Static algorithms (library-review PR-D, 2026-08-31) ───────────────────
    // 兑现本类顶部注释里预告的「静态算法 Sort/IndexOf/...」。C# `System.Array.*`
    // 对标，纯脚本泛型（同 List<T> 的 CompareTo / Func 比较器模型）。

    // First index of `value` (by `.Equals`), or -1. Mirrors List<T>.IndexOf.
    public static int IndexOf<T>(T[] array, T value) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (array[i].Equals(value)) return i;
        }
        return -1;
    }

    // Copy the first `length` elements of `source` into `destination` (both
    // start at 0). Throws when `length` exceeds either array.
    public static void Copy<T>(T[] source, T[] destination, int length) {
        if (length < 0 || length > source.Length || length > destination.Length) {
            throw new Exception($"Array.Copy: length {length} out of range (src={source.Length}, dst={destination.Length})");
        }
        Array.CopyRange(source, 0, destination, 0, length);
    }

    // Set every element to `value`.
    public static void Fill<T>(T[] array, T value) {
        int n = array.Length;
        for (int i = 0; i < n; i++) { array[i] = value; }
    }

    // Reverse the elements in place.
    public static void Reverse<T>(T[] array) {
        int lo = 0;
        int hi = array.Length - 1;
        while (lo < hi) {
            T t = array[lo];
            array[lo] = array[hi];
            array[hi] = t;
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    // Stable ascending sort by the element's own `CompareTo` (same top-down
    // merge sort as List<T>.Sort — one scratch buffer, O(n log n)).
    public static void Sort<T>(T[] array) {
        int n = array.Length;
        if (n < 2) return;
        T[] scratch = new T[n];
        Array._mergeSort<T>(array, scratch, 0, n);
    }

    static void _mergeSort<T>(T[] a, T[] scratch, int lo, int hi) {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        Array._mergeSort<T>(a, scratch, lo, mid);
        Array._mergeSort<T>(a, scratch, mid, hi);
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (a[j].CompareTo(a[i]) < 0) { scratch[k] = a[j]; j = j + 1; }
            else                          { scratch[k] = a[i]; i = i + 1; }
            k = k + 1;
        }
        while (i < mid) { scratch[k] = a[i]; i = i + 1; k = k + 1; }
        while (j < hi)  { scratch[k] = a[j]; j = j + 1; k = k + 1; }
        int t = lo;
        while (t < hi) { a[t] = scratch[t]; t = t + 1; }
    }

    // Stable ascending sort under a caller-supplied comparator (< 0 ⇒ a before b),
    // mirroring List<T>.Sort(Func<T,T,int>).
    public static void Sort<T>(T[] array, Func<T, T, int> comparison) {
        int n = array.Length;
        if (n < 2) return;
        T[] scratch = new T[n];
        Array._mergeSortCmp<T>(array, scratch, 0, n, comparison);
    }

    // Paired sort (C# System.Array.Sort<TKey,TValue>): sort `keys` ascending by
    // CompareTo, applying the same permutation to `items` in parallel.
    public static void Sort<TKey, TValue>(TKey[] keys, TValue[] items) {
        int n = keys.Length;
        if (n < 2) return;
        TKey[] kScratch = new TKey[n];
        TValue[] vScratch = new TValue[n];
        Array._mergeSortPaired<TKey, TValue>(keys, items, kScratch, vScratch, 0, n);
    }

    static void _mergeSortPaired<TKey, TValue>(TKey[] k, TValue[] v, TKey[] ks, TValue[] vs, int lo, int hi) {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        Array._mergeSortPaired<TKey, TValue>(k, v, ks, vs, lo, mid);
        Array._mergeSortPaired<TKey, TValue>(k, v, ks, vs, mid, hi);
        int i = lo; int j = mid; int m = lo;
        while (i < mid && j < hi) {
            if (k[j].CompareTo(k[i]) < 0) { ks[m] = k[j]; vs[m] = v[j]; j = j + 1; }
            else                          { ks[m] = k[i]; vs[m] = v[i]; i = i + 1; }
            m = m + 1;
        }
        while (i < mid) { ks[m] = k[i]; vs[m] = v[i]; i = i + 1; m = m + 1; }
        while (j < hi)  { ks[m] = k[j]; vs[m] = v[j]; j = j + 1; m = m + 1; }
        int t = lo;
        while (t < hi) { k[t] = ks[t]; v[t] = vs[t]; t = t + 1; }
    }

    static void _mergeSortCmp<T>(T[] a, T[] scratch, int lo, int hi, Func<T, T, int> cmp) {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        Array._mergeSortCmp<T>(a, scratch, lo, mid, cmp);
        Array._mergeSortCmp<T>(a, scratch, mid, hi, cmp);
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (cmp(a[j], a[i]) < 0) { scratch[k] = a[j]; j = j + 1; }
            else                     { scratch[k] = a[i]; i = i + 1; }
            k = k + 1;
        }
        while (i < mid) { scratch[k] = a[i]; i = i + 1; k = k + 1; }
        while (j < hi)  { scratch[k] = a[j]; j = j + 1; k = k + 1; }
        int t = lo;
        while (t < hi) { a[t] = scratch[t]; t = t + 1; }
    }

    // ── C# System.Array parity: predicate search / binary search / transform ──
    // (add-array-csharp-algorithms, 2026-09-02) 纯脚本泛型；委托用 Std.Delegates
    // 的 Predicate<T> / Func<T,R> / Action<T>。真原语（GetValue/SetValue/Clone/
    // CreateInstance/Length）仍 native——这些算法只在其之上组合。

    // First element matching `match`, or default(T). Mirrors System.Array.Find.
    public static T Find<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (match(array[i])) return array[i];
        }
        return default(T);
    }

    // Last element matching `match`, or default(T).
    public static T FindLast<T>(T[] array, Predicate<T> match) {
        int i = array.Length - 1;
        while (i >= 0) {
            if (match(array[i])) return array[i];
            i = i - 1;
        }
        return default(T);
    }

    // Index of first element matching `match`, or -1.
    public static int FindIndex<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (match(array[i])) return i;
        }
        return -1;
    }

    // Index of last element matching `match`, or -1.
    public static int FindLastIndex<T>(T[] array, Predicate<T> match) {
        int i = array.Length - 1;
        while (i >= 0) {
            if (match(array[i])) return i;
            i = i - 1;
        }
        return -1;
    }

    // All elements matching `match`, in order, as a right-sized new array.
    public static T[] FindAll<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        T[] tmp = new T[n];
        int count = 0;
        for (int i = 0; i < n; i++) {
            if (match(array[i])) { tmp[count] = array[i]; count = count + 1; }
        }
        T[] result = new T[count];
        for (int j = 0; j < count; j++) { result[j] = tmp[j]; }
        return result;
    }

    // True iff any element matches `match`.
    public static bool Exists<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (match(array[i])) return true;
        }
        return false;
    }

    // True iff every element matches `match` (vacuously true for empty).
    public static bool TrueForAll<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (!match(array[i])) return false;
        }
        return true;
    }

    // Binary search a `CompareTo`-ascending array. Returns the index of `value`
    // if found; otherwise `~insertionPoint` (a negative value whose bitwise
    // complement is where `value` should go to keep the array sorted) — C#
    // System.Array.BinarySearch semantics.
    public static int BinarySearch<T>(T[] array, T value) {
        int lo = 0;
        int hi = array.Length - 1;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            int c = array[mid].CompareTo(value);
            if (c == 0) return mid;
            if (c < 0) { lo = mid + 1; }
            else       { hi = mid - 1; }
        }
        return ~lo;
    }

    // True iff `value` occurs in `array` (by `.Equals`).
    public static bool Contains<T>(T[] array, T value) {
        return Array.IndexOf<T>(array, value) >= 0;
    }

    // Last index of `value` (by `.Equals`), or -1.
    public static int LastIndexOf<T>(T[] array, T value) {
        int i = array.Length - 1;
        while (i >= 0) {
            if (array[i].Equals(value)) return i;
            i = i - 1;
        }
        return -1;
    }

    // Project each element through `converter` into a new same-length array.
    public static U[] ConvertAll<T, U>(T[] array, Func<T, U> converter) {
        int n = array.Length;
        U[] result = new U[n];
        for (int i = 0; i < n; i++) { result[i] = converter(array[i]); }
        return result;
    }

    // Invoke `action` on each element in order.
    public static void ForEach<T>(T[] array, Action<T> action) {
        int n = array.Length;
        for (int i = 0; i < n; i++) { action(array[i]); }
    }

    // Set `array[index .. index+length)` to default(T). Throws on out-of-range.
    public static void Clear<T>(T[] array, int index, int length) {
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new Exception($"Array.Clear: range [{index}, {index + length}) out of bounds (len={array.Length})");
        }
        for (int i = 0; i < length; i++) { array[index + i] = default(T); }
    }

    // Return a new array of length `newSize`: prefix copied from `array`, any
    // tail filled with default(T); a smaller `newSize` truncates. `array` itself
    // is unchanged (C# uses `ref T[]`; here you assign the result back).
    public static T[] Resize<T>(T[] array, int newSize) {
        if (newSize < 0) {
            throw new Exception($"Array.Resize: newSize {newSize} is negative");
        }
        T[] result = new T[newSize];
        int copy = array.Length;
        if (newSize < copy) { copy = newSize; }
        for (int i = 0; i < copy; i++) { result[i] = array[i]; }
        // fix-generic-array-value-zero-init（方案 C）：泛型 `new T[newSize]` 现在对值类型 T 自动零
        // 初始化尾部（VM 据 ArrayNew 的 type-param 操作数查 type_args 产零值），无需再显式填 default(T)。
        return result;
    }

    // An empty (zero-length) T[].
    public static T[] Empty<T>() {
        return new T[0];
    }

    // ── Range / offset / paired overloads (C# System.Array parity) ────────────

    // Shared bounds check for range overloads: throws when [index, index+length)
    // escapes [0, array.Length).
    static void _checkRange<T>(T[] array, int index, int length) {
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new Exception($"Array: range [{index}, {index + length}) out of bounds (length={array.Length})");
        }
    }

    // Stable ascending sort of the sub-range [index, index+length) by CompareTo.
    // Reuses _mergeSort (already parameterised on absolute [lo, hi)); scratch is
    // full-length so absolute indices line up.
    public static void Sort<T>(T[] array, int index, int length) {
        Array._checkRange<T>(array, index, length);
        if (length < 2) return;
        T[] scratch = new T[array.Length];
        Array._mergeSort<T>(array, scratch, index, index + length);
    }

    // Reverse the sub-range [index, index+length) in place.
    public static void Reverse<T>(T[] array, int index, int length) {
        Array._checkRange<T>(array, index, length);
        int lo = index;
        int hi = index + length - 1;
        while (lo < hi) {
            T t = array[lo];
            array[lo] = array[hi];
            array[hi] = t;
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    // Set `array[startIndex .. startIndex+count)` to `value`.
    public static void Fill<T>(T[] array, T value, int startIndex, int count) {
        Array._checkRange<T>(array, startIndex, count);
        int end = startIndex + count;
        for (int i = startIndex; i < end; i++) { array[i] = value; }
    }

    // Copy `length` elements from `source[sourceIndex..]` to
    // `destination[destinationIndex..]`. Handles overlapping ranges within the
    // same array (copies backward when moving toward higher indices), mirroring
    // C# System.Array.Copy.
    public static void Copy<T>(T[] source, int sourceIndex, T[] destination, int destinationIndex, int length) {
        if (length < 0 || sourceIndex < 0 || destinationIndex < 0
            || sourceIndex + length > source.Length
            || destinationIndex + length > destination.Length) {
            throw new Exception($"Array.Copy: range out of bounds (srcIdx={sourceIndex}, dstIdx={destinationIndex}, len={length}, src={source.Length}, dst={destination.Length})");
        }
        Array.CopyRange(source, sourceIndex, destination, destinationIndex, length);
    }

    // First index of `value` at or after `startIndex` (by `.Equals`), or -1.
    public static int IndexOf<T>(T[] array, T value, int startIndex) {
        int n = array.Length;
        for (int i = startIndex; i < n; i++) {
            if (array[i].Equals(value)) return i;
        }
        return -1;
    }

    // First index of `value` within [startIndex, startIndex+count) (by `.Equals`), or -1.
    public static int IndexOf<T>(T[] array, T value, int startIndex, int count) {
        int end = startIndex + count;
        if (end > array.Length) { end = array.Length; }
        for (int i = startIndex; i < end; i++) {
            if (array[i].Equals(value)) return i;
        }
        return -1;
    }

    // Last index of `value` at or before `startIndex`, searching backward (by `.Equals`), or -1.
    public static int LastIndexOf<T>(T[] array, T value, int startIndex) {
        int i = startIndex;
        while (i >= 0) {
            if (array[i].Equals(value)) return i;
            i = i - 1;
        }
        return -1;
    }

    // Binary search for `value` within the sorted sub-range [index, index+length)
    // by CompareTo. Returns the element index, or ~insertionPoint when absent.
    public static int BinarySearch<T>(T[] array, int index, int length, T value) {
        int lo = index;
        int hi = index + length - 1;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            int c = array[mid].CompareTo(value);
            if (c == 0) return mid;
            if (c < 0) { lo = mid + 1; }
            else       { hi = mid - 1; }
        }
        return ~lo;
    }

    // Binary search for `value` over the whole array under a caller-supplied
    // comparator (`comparison(element, value)` < 0 ⇒ element before value).
    // Returns the element index, or ~insertionPoint when absent.
    public static int BinarySearch<T>(T[] array, T value, Func<T, T, int> comparison) {
        int lo = 0;
        int hi = array.Length - 1;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            int c = comparison(array[mid], value);
            if (c == 0) return mid;
            if (c < 0) { lo = mid + 1; }
            else       { hi = mid - 1; }
        }
        return ~lo;
    }

    // Wrap `array` in a read-only view (对标 C# System.Array.AsReadOnly)。视图按引用包装，
    // 不复制；对底层数组的读通过视图可见，但视图不提供任何变更操作。
    public static ReadOnlyCollection<T> AsReadOnly<T>(T[] array) {
        return new ReadOnlyCollection<T>(array);
    }
}
