namespace Std;

// 2026-05-07 add-array-base-class (P4-Array v1):
// 所有 T[] 在运行时是 `Std.Array` 的实例。编译器特殊处理 is-a：`Z42ArrayType`
// 视作 `Z42ClassType("Std.Array")` 的子类型；VM 端 `Value::Array` 不携带
// TypeDesc 引用，VCall 通过 `primitive_class_name` 路由到 `Std.Array.<method>`
// 直查 func_index（与 Std.Int32 / Std.String 同款）。
//
// 用户不能 `new Array()` —— `T[]` 通过 `array_new` IR 指令构造。
// 用户不能继承 Array —— `sealed` 阻止派生。
//
// v1 暴露：Length（IR `array_len` 快路径）+ Clone。
//
// Object 协议成员（GetType / Equals / GetHashCode / ToString）**不在此显式声明**：
// 数组接收者在 TypeChecker 走 loose-bind（`Z42ArrayType` 不匹配任何成员解析分支，
// 方法名原样 emit），运行期 VCall 的 primitive/array 派发先查 `Std.Array.<method>`、
// miss 后兜底 `Std.Object.<method>`（interp/exec_vcall.rs + jit/helpers/vcall.rs）。
// 这四个协议方法与 `Std.Object` 绑定同一批 `__obj_*` builtin、无任何数组专属行为，
// 故直接继承基类实现即可（与 Std.Int32 等基元类同款——它们也不重声明这些）。
//
// 后续 spec：静态算法（Sort/IndexOf/...） / IEnumerable 接入 / 协变 /
// 元素类型反射元数据。
public sealed class Array {
    // 字段占位 —— 实际值由 IR `array_len` 直读；TypeChecker 看到 `arr.Length`
    // 时仍 emit FieldGet（VM `Value::Array` 已 hardcoded "Length" 分支返
    // i64 Length）。
    public int Length;

    // 浅拷贝。元素是引用类型 → 共享引用；与 C# `System.Array.Clone()` 语义一致。
    [Native("__array_clone")]
    public extern Object Clone();

    // ── 反射式建/读写（add-array-property-reflection-api）─────────────────────
    // 照搬 C# System.Array：以运行期 Type 建数组、以实例方法读写元素，供反射式
    // (de)serialization 在编译期不知元素类型时操作数组。native 绑既有 builtin。

    // C# `Array.CreateInstance(Type, int)`：以元素类型 + 长度建一维数组（元素为该类型默认值）。
    [Native("__array_create")]
    public static extern Array CreateInstance(Type elementType, int length);

    // C# `object GetValue(int)`：读元素 index（基元装箱为对应包装类，引用元素原样）。
    [Native("__array_get")]
    public extern Object GetValue(int index);

    // C# `void SetValue(object value, int index)`：写 value 到元素 index（value 在前，
    // 与 C# 原生签名一致；native `__array_set` 按 (array, value, index) 读取）。
    [Native("__array_set")]
    public extern void SetValue(Object value, int index);

    // ── Static algorithms (library-review PR-D, 2026-08-31) ───────────────────
    // 兑现本类顶部注释里预告的「静态算法 Sort/IndexOf/...」。C# `System.Array.*`
    // 对标，纯脚本泛型（同 List<T> 的 CompareTo / Func 比较器模型）。

    // First index of `value` (by `.Equals`), or -1. Mirrors List<T>.IndexOf.
    public static int IndexOf<T>(T[] array, T value) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (array[i].Equals(value)) return i;
        }
        return -1;
    }

    // Copy the first `length` elements of `source` into `destination` (both
    // start at 0). Throws when `length` exceeds either array.
    public static void Copy<T>(T[] source, T[] destination, int length) {
        if (length < 0 || length > source.Length || length > destination.Length) {
            throw new Exception($"Array.Copy: length {length} out of range (src={source.Length}, dst={destination.Length})");
        }
        for (int i = 0; i < length; i++) { destination[i] = source[i]; }
    }

    // Set every element to `value`.
    public static void Fill<T>(T[] array, T value) {
        int n = array.Length;
        for (int i = 0; i < n; i++) { array[i] = value; }
    }

    // Reverse the elements in place.
    public static void Reverse<T>(T[] array) {
        int lo = 0;
        int hi = array.Length - 1;
        while (lo < hi) {
            T t = array[lo];
            array[lo] = array[hi];
            array[hi] = t;
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    // Stable ascending sort by the element's own `CompareTo` (same top-down
    // merge sort as List<T>.Sort — one scratch buffer, O(n log n)).
    public static void Sort<T>(T[] array) {
        int n = array.Length;
        if (n < 2) return;
        T[] scratch = new T[n];
        Array._mergeSort<T>(array, scratch, 0, n);
    }

    static void _mergeSort<T>(T[] a, T[] scratch, int lo, int hi) {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        Array._mergeSort<T>(a, scratch, lo, mid);
        Array._mergeSort<T>(a, scratch, mid, hi);
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (a[j].CompareTo(a[i]) < 0) { scratch[k] = a[j]; j = j + 1; }
            else                          { scratch[k] = a[i]; i = i + 1; }
            k = k + 1;
        }
        while (i < mid) { scratch[k] = a[i]; i = i + 1; k = k + 1; }
        while (j < hi)  { scratch[k] = a[j]; j = j + 1; k = k + 1; }
        int t = lo;
        while (t < hi) { a[t] = scratch[t]; t = t + 1; }
    }

    // Stable ascending sort under a caller-supplied comparator (< 0 ⇒ a before b),
    // mirroring List<T>.Sort(Func<T,T,int>).
    public static void Sort<T>(T[] array, Func<T, T, int> comparison) {
        int n = array.Length;
        if (n < 2) return;
        T[] scratch = new T[n];
        Array._mergeSortCmp<T>(array, scratch, 0, n, comparison);
    }

    static void _mergeSortCmp<T>(T[] a, T[] scratch, int lo, int hi, Func<T, T, int> cmp) {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        Array._mergeSortCmp<T>(a, scratch, lo, mid, cmp);
        Array._mergeSortCmp<T>(a, scratch, mid, hi, cmp);
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (cmp(a[j], a[i]) < 0) { scratch[k] = a[j]; j = j + 1; }
            else                     { scratch[k] = a[i]; i = i + 1; }
            k = k + 1;
        }
        while (i < mid) { scratch[k] = a[i]; i = i + 1; k = k + 1; }
        while (j < hi)  { scratch[k] = a[j]; j = j + 1; k = k + 1; }
        int t = lo;
        while (t < hi) { a[t] = scratch[t]; t = t + 1; }
    }
}
