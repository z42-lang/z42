namespace Std;

using Std.Collections;

// 所有 `T[]` 在运行时是 `Std.Array` 的实例：编译器把数组类型视作 `Std.Array` 的子类型，
// VM 端 `Value::Array` 不携带 TypeDesc 引用，VCall 按 `Std.Array.<method>` 直查 func_index
// （与 Std.Int32 / Std.String 同款）。
//
// 用户不能 `new Array()`（`T[]` 经 `array_new` IR 指令构造），也不能继承（`sealed`）。
//
// Object 协议成员（GetType / Equals / GetHashCode / ToString）不在此显式声明：数组接收者
// 走 loose-bind，运行期 VCall 先查 `Std.Array.<method>`、miss 后兜底 `Std.Object.<method>`。
// 这四个协议方法与 `Std.Object` 绑定同一批 `__obj_*` builtin、无数组专属行为，直接继承基类
// 即可（与 Std.Int32 等基元类同款）。

/// 所有 `T[]` 的运行时基类。
///
/// 元素读写、克隆与静态算法（Sort / IndexOf / Find / ...）都经此类；用户不能
/// `new Array()`，也不能继承。
public sealed class Array {
    /// 元素个数。实际值由 IR `array_len` 直读，此字段仅为类型检查占位。
    public int Length;

    /// 浅拷贝。元素是引用类型时共享引用（同 C# `System.Array.Clone()`）。
    [Native("__array_clone")]
    public extern Object Clone();

    // ── 反射式建/读写 ─────────────────────────────────────────────────────────
    // 照搬 C# System.Array：以运行期 Type 建数组、以实例方法读写元素，供反射式
    // (de)serialization 在编译期不知元素类型时操作数组。native 绑既有 builtin。

    /// 以元素类型 + 长度建一维数组（元素为该类型默认值）。
    [Native("__array_create")]
    public static extern Array CreateInstance(Type elementType, int length);

    /// 读元素 `index`（基元装箱为对应包装类，引用元素原样）。
    [Native("__array_get")]
    public extern Object GetValue(int index);

    /// 写 `value` 到元素 `index`（`value` 在前，与 C# 原生签名一致）。
    [Native("__array_set")]
    public extern void SetValue(Object value, int index);

    /// 区间批量拷贝原语：`destination[destinationIndex..] = source[sourceIndex..]`（`length` 个）。
    // 脚本侧的泛型 `Copy<T>` 只做参数校验，搬运落到这一次 native 调用；同一数组内区间
    // 重叠按 memmove 语义处理。
    [Native("__array_copy")]
    public static extern void CopyRange(Array source, int sourceIndex, Array destination, int destinationIndex, int length);

    // `Sort()` 的基元快路径：`array[0, count)` 全是同一种基元时原生稳定排序并返回 true；
    // 否则原样不动返回 false，调用方照常跑脚本归并排序。
    [Native("__array_sort_prims")]
    internal static extern bool SortPrimitives(Array array, int count);

    // ── 静态算法 ─────────────────────────────────────────────────────────────
    // C# `System.Array.*` 对标，纯脚本泛型（同 List<T> 的 CompareTo / Func 比较器模型）。

    /// `value` 首次出现的索引（按 `.Equals`），未命中 -1。
    public static int IndexOf<T>(T[] array, T value) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (array[i].Equals(value)) return i;
        }
        return -1;
    }

    /// 把 `source` 前 `length` 个元素拷入 `destination`（都从 0 起）。越界抛异常。
    public static void Copy<T>(T[] source, T[] destination, int length) {
        if (length < 0 || length > source.Length || length > destination.Length) {
            throw new Exception($"Array.Copy: length {length} out of range (src={source.Length}, dst={destination.Length})");
        }
        Array.CopyRange(source, 0, destination, 0, length);
    }

    /// 把每个元素都设为 `value`。
    public static void Fill<T>(T[] array, T value) {
        int n = array.Length;
        for (int i = 0; i < n; i++) { array[i] = value; }
    }

    /// 原地反转元素顺序。
    public static void Reverse<T>(T[] array) {
        int lo = 0;
        int hi = array.Length - 1;
        while (lo < hi) {
            T t = array[lo];
            array[lo] = array[hi];
            array[hi] = t;
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    /// 按元素自身 `CompareTo` 稳定升序排序（自顶向下归并，O(n log n)）。
    public static void Sort<T>(T[] array) where T : IComparable {
        int n = array.Length;
        if (n < 2) return;
        if (Array.SortPrimitives(array, n)) return;
        T[] scratch = new T[n];
        Array._mergeSort<T>(array, scratch, 0, n);
    }

    static void _mergeSort<T>(T[] a, T[] scratch, int lo, int hi) where T : IComparable {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        Array._mergeSort<T>(a, scratch, lo, mid);
        Array._mergeSort<T>(a, scratch, mid, hi);
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (a[j].CompareTo(a[i]) < 0) { scratch[k] = a[j]; j = j + 1; }
            else                          { scratch[k] = a[i]; i = i + 1; }
            k = k + 1;
        }
        while (i < mid) { scratch[k] = a[i]; i = i + 1; k = k + 1; }
        while (j < hi)  { scratch[k] = a[j]; j = j + 1; k = k + 1; }
        int t = lo;
        while (t < hi) { a[t] = scratch[t]; t = t + 1; }
    }

    /// 按调用方提供的比较器（< 0 ⇒ a 在 b 前）稳定升序排序。
    public static void Sort<T>(T[] array, Func<T, T, int> comparison) {
        int n = array.Length;
        if (n < 2) return;
        T[] scratch = new T[n];
        Array._mergeSortCmp<T>(array, scratch, 0, n, comparison);
    }

    /// 成对排序：`keys` 按 `CompareTo` 升序，`items` 同步应用同一置换。
    public static void Sort<TKey, TValue>(TKey[] keys, TValue[] items) where TKey : IComparable {
        int n = keys.Length;
        if (n < 2) return;
        TKey[] kScratch = new TKey[n];
        TValue[] vScratch = new TValue[n];
        Array._mergeSortPaired<TKey, TValue>(keys, items, kScratch, vScratch, 0, n);
    }

    static void _mergeSortPaired<TKey, TValue>(TKey[] k, TValue[] v, TKey[] ks, TValue[] vs, int lo, int hi) where TKey : IComparable {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        Array._mergeSortPaired<TKey, TValue>(k, v, ks, vs, lo, mid);
        Array._mergeSortPaired<TKey, TValue>(k, v, ks, vs, mid, hi);
        int i = lo; int j = mid; int m = lo;
        while (i < mid && j < hi) {
            if (k[j].CompareTo(k[i]) < 0) { ks[m] = k[j]; vs[m] = v[j]; j = j + 1; }
            else                          { ks[m] = k[i]; vs[m] = v[i]; i = i + 1; }
            m = m + 1;
        }
        while (i < mid) { ks[m] = k[i]; vs[m] = v[i]; i = i + 1; m = m + 1; }
        while (j < hi)  { ks[m] = k[j]; vs[m] = v[j]; j = j + 1; m = m + 1; }
        int t = lo;
        while (t < hi) { k[t] = ks[t]; v[t] = vs[t]; t = t + 1; }
    }

    static void _mergeSortCmp<T>(T[] a, T[] scratch, int lo, int hi, Func<T, T, int> cmp) {
        if (hi - lo < 2) return;
        int mid = lo + (hi - lo) / 2;
        Array._mergeSortCmp<T>(a, scratch, lo, mid, cmp);
        Array._mergeSortCmp<T>(a, scratch, mid, hi, cmp);
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (cmp(a[j], a[i]) < 0) { scratch[k] = a[j]; j = j + 1; }
            else                     { scratch[k] = a[i]; i = i + 1; }
            k = k + 1;
        }
        while (i < mid) { scratch[k] = a[i]; i = i + 1; k = k + 1; }
        while (j < hi)  { scratch[k] = a[j]; j = j + 1; k = k + 1; }
        int t = lo;
        while (t < hi) { a[t] = scratch[t]; t = t + 1; }
    }

    // ── C# System.Array 对齐：谓词查找 / 二分 / 变换 ──────────────────────────
    // 纯脚本泛型；委托用 Std.Delegates 的 Predicate<T> / Func<T,R> / Action<T>。
    // 真原语（GetValue/SetValue/Clone/CreateInstance/Length）仍 native——这些算法只在
    // 其之上组合。

    /// 第一个命中 `match` 的元素，未命中返回 default(T)。
    public static T Find<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (match(array[i])) return array[i];
        }
        return default(T);
    }

    /// 最后一个命中 `match` 的元素，未命中返回 default(T)。
    public static T FindLast<T>(T[] array, Predicate<T> match) {
        int i = array.Length - 1;
        while (i >= 0) {
            if (match(array[i])) return array[i];
            i = i - 1;
        }
        return default(T);
    }

    /// 第一个命中 `match` 的元素下标，未命中 -1。
    public static int FindIndex<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (match(array[i])) return i;
        }
        return -1;
    }

    /// 最后一个命中 `match` 的元素下标，未命中 -1。
    public static int FindLastIndex<T>(T[] array, Predicate<T> match) {
        int i = array.Length - 1;
        while (i >= 0) {
            if (match(array[i])) return i;
            i = i - 1;
        }
        return -1;
    }

    /// 所有命中 `match` 的元素（按序，新数组，尺寸恰好）。
    public static T[] FindAll<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        T[] tmp = new T[n];
        int count = 0;
        for (int i = 0; i < n; i++) {
            if (match(array[i])) { tmp[count] = array[i]; count = count + 1; }
        }
        T[] result = new T[count];
        for (int j = 0; j < count; j++) { result[j] = tmp[j]; }
        return result;
    }

    /// 是否存在任一元素命中 `match`。
    public static bool Exists<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (match(array[i])) return true;
        }
        return false;
    }

    /// 是否每个元素都命中 `match`（空数组恒 true）。
    public static bool TrueForAll<T>(T[] array, Predicate<T> match) {
        int n = array.Length;
        for (int i = 0; i < n; i++) {
            if (!match(array[i])) return false;
        }
        return true;
    }

    /// 在按 `CompareTo` 升序的数组中二分查找。命中返回下标；否则返回 `~insertionPoint`
    /// （其按位取反即保持有序的插入位置）。
    public static int BinarySearch<T>(T[] array, T value) where T : IComparable {
        int lo = 0;
        int hi = array.Length - 1;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            int c = array[mid].CompareTo(value);
            if (c == 0) return mid;
            if (c < 0) { lo = mid + 1; }
            else       { hi = mid - 1; }
        }
        return ~lo;
    }

    /// `value` 是否出现在 `array` 中（按 `.Equals`）。
    public static bool Contains<T>(T[] array, T value) {
        return Array.IndexOf<T>(array, value) >= 0;
    }

    /// `value` 最后一次出现的下标（按 `.Equals`），未命中 -1。
    public static int LastIndexOf<T>(T[] array, T value) {
        int i = array.Length - 1;
        while (i >= 0) {
            if (array[i].Equals(value)) return i;
            i = i - 1;
        }
        return -1;
    }

    /// 把每个元素经 `converter` 投影到等长新数组。
    public static U[] ConvertAll<T, U>(T[] array, Func<T, U> converter) {
        int n = array.Length;
        U[] result = new U[n];
        for (int i = 0; i < n; i++) { result[i] = converter(array[i]); }
        return result;
    }

    /// 对每个元素按序执行 `action`。
    public static void ForEach<T>(T[] array, Action<T> action) {
        int n = array.Length;
        for (int i = 0; i < n; i++) { action(array[i]); }
    }

    /// 把 `[index, index+length)` 置为 default(T)。越界抛异常。
    public static void Clear<T>(T[] array, int index, int length) {
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new Exception($"Array.Clear: range [{index}, {index + length}) out of bounds (len={array.Length})");
        }
        for (int i = 0; i < length; i++) { array[index + i] = default(T); }
    }

    /// 返回长度为 `newSize` 的新数组，原数组不变。
    ///
    /// 前缀拷自 `array`，尾部填 default(T)；`newSize` 更小时截断。C# 用 `ref T[]`，
    /// 这里把结果赋回。
    public static T[] Resize<T>(T[] array, int newSize) {
        if (newSize < 0) {
            throw new Exception($"Array.Resize: newSize {newSize} is negative");
        }
        T[] result = new T[newSize];
        int copy = array.Length;
        if (newSize < copy) { copy = newSize; }
        for (int i = 0; i < copy; i++) { result[i] = array[i]; }
        return result;
    }

    /// 一个空（零长）的 `T[]`。
    public static T[] Empty<T>() {
        return new T[0];
    }

    // ── 区间 / 偏移 / 成对重载（C# System.Array 对齐）────────────────────────

    // 区间重载共用的边界检查：`[index, index+length)` 越界即抛。
    static void _checkRange<T>(T[] array, int index, int length) {
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new Exception($"Array: range [{index}, {index + length}) out of bounds (length={array.Length})");
        }
    }

    /// 按 `CompareTo` 稳定升序排序子区间 `[index, index+length)`。
    public static void Sort<T>(T[] array, int index, int length) where T : IComparable {
        Array._checkRange<T>(array, index, length);
        if (length < 2) return;
        T[] scratch = new T[array.Length];
        Array._mergeSort<T>(array, scratch, index, index + length);
    }

    /// 原地反转子区间 `[index, index+length)`。
    public static void Reverse<T>(T[] array, int index, int length) {
        Array._checkRange<T>(array, index, length);
        int lo = index;
        int hi = index + length - 1;
        while (lo < hi) {
            T t = array[lo];
            array[lo] = array[hi];
            array[hi] = t;
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    /// 把 `[startIndex, startIndex+count)` 置为 `value`。
    public static void Fill<T>(T[] array, T value, int startIndex, int count) {
        Array._checkRange<T>(array, startIndex, count);
        int end = startIndex + count;
        for (int i = startIndex; i < end; i++) { array[i] = value; }
    }

    /// 从 `source` 拷 `length` 个元素到 `destination` 的指定偏移处。
    ///
    /// 即 `source[sourceIndex..]` → `destination[destinationIndex..]`。同一数组内
    /// 重叠区间按 memmove 语义（向高索引移动时反向拷贝）。
    public static void Copy<T>(T[] source, int sourceIndex, T[] destination, int destinationIndex, int length) {
        if (length < 0 || sourceIndex < 0 || destinationIndex < 0
            || sourceIndex + length > source.Length
            || destinationIndex + length > destination.Length) {
            throw new Exception($"Array.Copy: range out of bounds (srcIdx={sourceIndex}, dstIdx={destinationIndex}, len={length}, src={source.Length}, dst={destination.Length})");
        }
        Array.CopyRange(source, sourceIndex, destination, destinationIndex, length);
    }

    /// `value` 在 `startIndex` 及其后首次出现的下标（按 `.Equals`），未命中 -1。
    public static int IndexOf<T>(T[] array, T value, int startIndex) {
        int n = array.Length;
        for (int i = startIndex; i < n; i++) {
            if (array[i].Equals(value)) return i;
        }
        return -1;
    }

    /// `value` 在 `[startIndex, startIndex+count)` 内首次出现的下标（按 `.Equals`），未命中 -1。
    public static int IndexOf<T>(T[] array, T value, int startIndex, int count) {
        int end = startIndex + count;
        if (end > array.Length) { end = array.Length; }
        for (int i = startIndex; i < end; i++) {
            if (array[i].Equals(value)) return i;
        }
        return -1;
    }

    /// 从 `startIndex` 起向前找 `value` 最后一次出现的下标（按 `.Equals`），未命中 -1。
    public static int LastIndexOf<T>(T[] array, T value, int startIndex) {
        int i = startIndex;
        while (i >= 0) {
            if (array[i].Equals(value)) return i;
            i = i - 1;
        }
        return -1;
    }

    /// 在有序子区间 `[index, index+length)` 内按 `CompareTo` 二分查找。
    ///
    /// 命中返回 `value` 的下标，否则返回 `~insertionPoint`。
    public static int BinarySearch<T>(T[] array, int index, int length, T value) where T : IComparable {
        int lo = index;
        int hi = index + length - 1;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            int c = array[mid].CompareTo(value);
            if (c == 0) return mid;
            if (c < 0) { lo = mid + 1; }
            else       { hi = mid - 1; }
        }
        return ~lo;
    }

    /// 在调用方比较器下对全数组二分查找。
    ///
    /// 比较器约定：`comparison(element, value)` < 0 ⇒ element 在 value 前。命中返回
    /// 下标，否则返回 `~insertionPoint`。
    public static int BinarySearch<T>(T[] array, T value, Func<T, T, int> comparison) {
        int lo = 0;
        int hi = array.Length - 1;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            int c = comparison(array[mid], value);
            if (c == 0) return mid;
            if (c < 0) { lo = mid + 1; }
            else       { hi = mid - 1; }
        }
        return ~lo;
    }

    /// 把 `array` 包装成只读视图（不复制，按引用包装；视图不提供任何变更操作）。
    public static ReadOnlyCollection<T> AsReadOnly<T>(T[] array) {
        return new ReadOnlyCollection<T>(array);
    }
}
