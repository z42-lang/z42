namespace Std;

/// 多播订阅策略包装器协议：`MulticastAction<T>.Subscribe(ISubscription<Action<T>>)` 走
/// advanced 路径；用户可实现自己的包装器加入新策略（throttle / debounce / dispatcher 等）。
public interface ISubscription<TD> {
    /// 返回被包装的委托；仅在 IsAlive() 为 true 时有定义，调用方先检查 IsAlive。
    TD Get();
    /// 是否仍活跃；invoke 循环据此短路。
    bool IsAlive();
    /// 每次 invoke 后调用；包装器用它更新自身 latch 状态（无状态包装器为 nop）。
    void OnInvoked();
}
