    MulticastPredicate<T1, T2, T3> bus;
    int idx;
    bool isAdvanced;

    /// 构造订阅 token。
    public MulticastPredicateSubscription(MulticastPredicate<T1, T2, T3> bus, int idx, bool isAdvanced) {
        this.bus = bus;
        this.idx = idx;
        this.isAdvanced = isAdvanced;
    }

    /// 取消订阅：把对应通道的 alive[idx] 置 false。
    public void Dispose() {
        if (this.idx >= 0) {
            this.bus.RemoveAt(this.idx, this.isAdvanced);
            this.idx = -1;
        }
    }
}
/// predicate 多播（T1, T2, T3, T4）：实现细节见 `MulticastDelegate<THandler>` 基类。

public sealed class MulticastPredicate<T1, T2, T3, T4> : MulticastDelegate<Func<T1, T2, T3, T4, bool>> {

    /// 构造空的多播总线。

    public MulticastPredicate() : base() { }


    /// 家族退订凭据构造点（覆写基类默认实现）。

    protected override IDisposable NewSubscription(int idx, bool isAdvanced) {

        return new MulticastPredicateSubscription<T1, T2, T3, T4>(this, idx, isAdvanced);

    }

    [Suppress("style.fnLinesHard", "132 body lines；拆分见 code-organization.md")]
    /// 触发所有活跃 handler，收集返回值进 bool[]（strong-first / advanced-after 顺序）。
    ///
    /// `continueOnException = false`（默认）走 fail-fast：首个抛出的异常直接传播。
    /// `continueOnException = true` 时失败位置占 default(bool) = false，多失败聚合抛
    /// MulticastException<bool>。
    public bool[] Invoke(T1 a, T2 b, T3 c, T4 d, bool continueOnException = false) {
        Func<T1, T2, T3, T4, bool>[] snapStrong = this.StrongSnapshot();
        bool[] snapStrongAlive = this.StrongAliveSnapshot();
        ISubscription<Func<T1, T2, T3, T4, bool>>[] snapAdv = this.AdvancedSnapshot();
        bool[] snapAdvAlive = this.AdvancedAliveSnapshot();
        int sn = snapStrong.Length;
        int an = snapAdv.Length;
        int i = 0;

        int total = 0;
        i = 0;
        while (i < sn) {
            if (snapStrongAlive[i]) total = total + 1;
            i = i + 1;
        }
        i = 0;
        while (i < an) {
            if (snapAdvAlive[i] && snapAdv[i].IsAlive()) total = total + 1;
            i = i + 1;
        }

        bool[] result = new bool[total];
        int outIdx = 0;

        // ── fail-fast 路径（continueOnException=false）──
        if (!continueOnException) {
            i = 0;
            while (i < sn) {
                if (snapStrongAlive[i]) {
                    result[outIdx] = snapStrong[i](a, b, c, d);
                    outIdx = outIdx + 1;
                }
                i = i + 1;
            }
            i = 0;
            while (i < an) {
                if (snapAdvAlive[i]) {
                    var w = snapAdv[i];
                    if (w.IsAlive()) {
                        result[outIdx] = w.Get()(a, b, c, d);
                        w.OnInvoked();
                        outIdx = outIdx + 1;
                    }
                }
                i = i + 1;
            }
            return result;
        }

        // ── continueOnException=true 路径 ──
        // 失败位置占 default(bool) = false；多失败聚合抛 MulticastException<bool>。
        Exception[] failExns = new Exception[8];
        int[] failIdx = new int[8];
        int failCap = 8;
        int failCount = 0;

        i = 0;
        while (i < sn) {
            if (snapStrongAlive[i]) {
                try {
                    result[outIdx] = snapStrong[i](a, b, c, d);
                } catch (Exception e) {
                    result[outIdx] = default(bool);
                    if (failCount == failCap) {
                        int newCap = failCap * 2;
                        Exception[] biggerE = new Exception[newCap];
                        int[] biggerI = new int[newCap];
                        int k = 0;
                        while (k < failCount) {
                            biggerE[k] = failExns[k];
                            biggerI[k] = failIdx[k];
                            k = k + 1;
                        }
                        failExns = biggerE;
                        failIdx = biggerI;
                        failCap = newCap;
                    }
                    failExns[failCount] = e;
                    failIdx[failCount] = outIdx;
                    failCount = failCount + 1;
                }
                outIdx = outIdx + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < an) {
            if (snapAdvAlive[i]) {
                var w = snapAdv[i];
                if (w.IsAlive()) {
                    try {
                        result[outIdx] = w.Get()(a, b, c, d);
                        w.OnInvoked();
                    } catch (Exception e) {
                        result[outIdx] = default(bool);
                        if (failCount == failCap) {
                            int newCap = failCap * 2;
                            Exception[] biggerE = new Exception[newCap];
                            int[] biggerI = new int[newCap];
                            int k = 0;
                            while (k < failCount) {
                                biggerE[k] = failExns[k];
                                biggerI[k] = failIdx[k];
                                k = k + 1;
                            }
                            failExns = biggerE;
                            failIdx = biggerI;
                            failCap = newCap;
                        }
                        failExns[failCount] = e;
                        failIdx[failCount] = outIdx;
                        failCount = failCount + 1;
                    }
                    outIdx = outIdx + 1;
                }
            }
            i = i + 1;
        }

        if (failCount > 0) {
            Exception[] trimE = new Exception[failCount];
            int[] trimI = new int[failCount];
            int j = 0;
            while (j < failCount) {
                trimE[j] = failExns[j];
                trimI[j] = failIdx[j];
                j = j + 1;
            }
            throw new MulticastException<bool>(trimE, trimI, total, result);
        }
        return result;
    }

    /// 所有活跃 handler 都返回 true 时返回 true。
    ///
    /// 一旦遇 false 立即返回 false（短路），后续 handler 不调用。空 bus 返回 true
    /// （vacuous truth）。
    public bool All(T1 a, T2 b, T3 c, T4 d) {
        Func<T1, T2, T3, T4, bool>[] snapStrong = this.StrongSnapshot();
        bool[] snapStrongAlive = this.StrongAliveSnapshot();
        ISubscription<Func<T1, T2, T3, T4, bool>>[] snapAdv = this.AdvancedSnapshot();
        bool[] snapAdvAlive = this.AdvancedAliveSnapshot();
        int sn = snapStrong.Length;
        int an = snapAdv.Length;
        int i = 0;

        i = 0;
        while (i < sn) {
            if (snapStrongAlive[i]) {
                if (!snapStrong[i](a, b, c, d)) return false;
            }
            i = i + 1;
        }
        i = 0;
        while (i < an) {
            if (snapAdvAlive[i]) {
                var w = snapAdv[i];
                if (w.IsAlive()) {
                    bool r = w.Get()(a, b, c, d);
                    w.OnInvoked();
                    if (!r) return false;
                }
            }
            i = i + 1;
        }
        return true;
    }

    /// 任一活跃 handler 返回 true 时返回 true。
    ///
    /// 一旦遇 true 立即返回 true（短路）。空 bus 返回 false（vacuous existential）。
    public bool Any(T1 a, T2 b, T3 c, T4 d) {
        Func<T1, T2, T3, T4, bool>[] snapStrong = this.StrongSnapshot();
        bool[] snapStrongAlive = this.StrongAliveSnapshot();
        ISubscription<Func<T1, T2, T3, T4, bool>>[] snapAdv = this.AdvancedSnapshot();
        bool[] snapAdvAlive = this.AdvancedAliveSnapshot();
        int sn = snapStrong.Length;
        int an = snapAdv.Length;
        int i = 0;

        i = 0;
        while (i < sn) {
            if (snapStrongAlive[i]) {
                if (snapStrong[i](a, b, c, d)) return true;
            }
            i = i + 1;
        }
        i = 0;
        while (i < an) {
            if (snapAdvAlive[i]) {
                var w = snapAdv[i];
                if (w.IsAlive()) {
                    bool r = w.Get()(a, b, c, d);
                    w.OnInvoked();
                    if (r) return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

}

public sealed class MulticastPredicateSubscription<T1, T2, T3, T4> : IDisposable {
    MulticastPredicate<T1, T2, T3, T4> bus;
    int idx;
    bool isAdvanced;

    /// 构造订阅 token。
    public MulticastPredicateSubscription(MulticastPredicate<T1, T2, T3, T4> bus, int idx, bool isAdvanced) {
        this.bus = bus;
        this.idx = idx;
        this.isAdvanced = isAdvanced;
    }

    /// 取消订阅：把对应通道的 alive[idx] 置 false。
    public void Dispose() {
        if (this.idx >= 0) {
            this.bus.RemoveAt(this.idx, this.isAdvanced);
            this.idx = -1;
        }
    }
}
