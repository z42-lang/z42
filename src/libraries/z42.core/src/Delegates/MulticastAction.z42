/// 内部订阅 token —— Subscribe 返回它，Dispose 把对应通道的 alive[idx] 置 false。
public sealed class MulticastSubscription : IDisposable {
    MulticastAction bus;
    int idx;
    bool isAdvanced;

    /// 构造订阅 token。
    public MulticastSubscription(MulticastAction bus, int idx, bool isAdvanced) {
        this.bus = bus;
        this.idx = idx;
        this.isAdvanced = isAdvanced;
    }

    /// 取消订阅：把对应通道的 alive[idx] 置 false。
    public void Dispose() {
        if (this.idx >= 0) {
            this.bus.RemoveAt(this.idx, this.isAdvanced);
            this.idx = -1;
        }
    }
}


// ── 2 参变体（feat/multicast-arity-family 机械生成，语义同 1 参原版）──

/// 2 参多播 Action：Invoke 全部触发（与单播 Action<T1, T2> 分离）。
///
/// 双通道（strong 直持 `Action<T1, T2>` / advanced 持 ISubscription 包装）与 COW 快照语义
/// 同 2 参以下的既有家族成员，见 MulticastAction 文件头注释。

public sealed class MulticastAction<T1, T2> {
    // ── strong fast path ──
    Action<T1, T2>[] strong;
    bool[] strongAlive;
    int strongCount;
    int strongCapacity;

    // ── advanced slow path ──
    // 持 ISubscription<Action<T1, T2>> 接口数组；用户传入 OnceRef / CompositeRef /
    // 自定义 wrapper class : ISubscription<Action<T1, T2>> 都能 plug in。
    ISubscription<Action<T1, T2>>[] advanced;
    bool[] advancedAlive;
    int advancedCount;
    int advancedCapacity;

    /// 构造空的多播 Action。
    public MulticastAction() {
        this.strongCapacity = 4;
        this.strong = new Action<T1, T2>[4];
        this.strongAlive = new bool[4];
        this.strongCount = 0;

        this.advancedCapacity = 4;
        this.advanced = new ISubscription<Action<T1, T2>>[4];
        this.advancedAlive = new bool[4];
        this.advancedCount = 0;
    }

    /// 订阅处理器并返回退订凭据。
    /// @hidden
    public IDisposable operator +=(Action<T1, T2> handler) { return this.Subscribe(handler); }

    /// 按处理器身份退订。
    /// @hidden
    public void operator -=(Action<T1, T2> handler) { this.Unsubscribe(handler); }

    /// 裸 handler 订阅，返回退订凭据。也可以用 `+=` 注册。
    public IDisposable Subscribe(Action<T1, T2> handler) {
        if (this.strongCount == this.strongCapacity) this.GrowStrong();
        int idx = this.strongCount;
        this.strong[idx] = handler;
        this.strongAlive[idx] = true;
        this.strongCount = this.strongCount + 1;
        return new MulticastSubscription<T1, T2>(this, idx, false);
    }

    /// ISubscription 包装器订阅 → advanced 慢路径（OnceRef / CompositeRef / 用户自定义包装器）。
    public IDisposable SubscribeAdvanced(ISubscription<Action<T1, T2>> wrapper) {
        if (this.advancedCount == this.advancedCapacity) this.GrowAdvanced();
        int idx = this.advancedCount;
        this.advanced[idx] = wrapper;
        this.advancedAlive[idx] = true;
        this.advancedCount = this.advancedCount + 1;
        return new MulticastSubscription<T1, T2>(this, idx, true);
    }


    /// strong 通道处理器的快照（COW：取之后再订阅 / 退订不影响本数组）。
    ///
    /// advanced 包装通道（OnceRef / WeakRef / 自定义 ISubscription）语义上不可材料化，
    /// 不在列表内——需要枚举包装订阅时在 SubscribeAdvanced 侧自行记账。
    public Action<T1, T2>[] GetInvocationList() {
        int n = 0;
        int i = 0;
        while (i < this.strongCount) { if (this.strongAlive[i]) { n = n + 1; } i = i + 1; }
        Action<T1, T2>[] outA = new Action<T1, T2>[n];
        int k = 0;
        i = 0;
        while (i < this.strongCount) {
            if (this.strongAlive[i]) { outA[k] = this.strong[i]; k = k + 1; }
            i = i + 1;
        }
        return outA;
    }

    /// 当前活跃订阅总数（strong + advanced）。
    public int Count() {
        int c = 0;
        int i = 0;
        while (i < this.strongCount) {
            if (this.strongAlive[i]) c = c + 1;
            i = i + 1;
        }
        i = 0;
        while (i < this.advancedCount) {
            if (this.advancedAlive[i] && this.advanced[i].IsAlive()) c = c + 1;
            i = i + 1;
        }
        return c;
    }

    [Suppress("style.fnLinesHard", "113 body lines；拆分见 code-organization.md")]
    /// 触发所有活跃 handler。
    ///
    /// `continueOnException = false`（默认）走 fail-fast：首个抛出的异常直接传播。
    /// `continueOnException = true` 时所有 handler 均尝试调用，失败者收入 Failures 数组，
    /// 最终抛 MulticastException 聚合诊断。
    public void Invoke(T1 a, T2 b, bool continueOnException = false) {
        // ── strong snapshot ──
        int sn = this.strongCount;
        Action<T1, T2>[] snapStrong = new Action<T1, T2>[sn];
        bool[] snapStrongAlive = new bool[sn];
        int i = 0;
        while (i < sn) {
            snapStrong[i] = this.strong[i];
            snapStrongAlive[i] = this.strongAlive[i];
            i = i + 1;
        }
        // ── advanced snapshot ──
        int an = this.advancedCount;
        ISubscription<Action<T1, T2>>[] snapAdv = new ISubscription<Action<T1, T2>>[an];
        bool[] snapAdvAlive = new bool[an];
        i = 0;
        while (i < an) {
            snapAdv[i] = this.advanced[i];
            snapAdvAlive[i] = this.advancedAlive[i];
            i = i + 1;
        }

        if (!continueOnException) {
            // fail-fast 路径
            i = 0;
            while (i < sn) {
                if (snapStrongAlive[i]) snapStrong[i](a, b);
                i = i + 1;
            }
            i = 0;
            while (i < an) {
                if (snapAdvAlive[i]) {
                    var w = snapAdv[i];
                    if (w.IsAlive()) {
                        w.Get()(a, b);
                        w.OnInvoked();
                    }
                }
                i = i + 1;
            }
            return;
        }

        // continueOnException=true 路径：累积失败索引 + 异常，全跑完后聚合抛
        Exception[] failExns = new Exception[8];
        int[] failIdx = new int[8];
        int failCap = 8;
        int failCount = 0;
        int totalCalled = 0;

        i = 0;
        while (i < sn) {
            if (snapStrongAlive[i]) {
                totalCalled = totalCalled + 1;
                try {
                    snapStrong[i](a, b);
                } catch (Exception e) {
                    if (failCount == failCap) {
                        int newCap = failCap * 2;
                        Exception[] biggerE = new Exception[newCap];
                        int[] biggerI = new int[newCap];
                        int k = 0;
                        while (k < failCount) {
                            biggerE[k] = failExns[k];
                            biggerI[k] = failIdx[k];
                            k = k + 1;
                        }
                        failExns = biggerE;
                        failIdx = biggerI;
                        failCap = newCap;
                    }
                    failExns[failCount] = e;
                    failIdx[failCount] = totalCalled - 1;
                    failCount = failCount + 1;
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < an) {
            if (snapAdvAlive[i]) {
                var w = snapAdv[i];
                if (w.IsAlive()) {
                    totalCalled = totalCalled + 1;
                    try {
                        w.Get()(a, b);
                        w.OnInvoked();
                    } catch (Exception e) {
                        if (failCount == failCap) {
                            int newCap = failCap * 2;
                            Exception[] biggerE = new Exception[newCap];
                            int[] biggerI = new int[newCap];
                            int k = 0;
                            while (k < failCount) {
                                biggerE[k] = failExns[k];
                                biggerI[k] = failIdx[k];
                                k = k + 1;
                            }
                            failExns = biggerE;
                            failIdx = biggerI;
                            failCap = newCap;
                        }
                        failExns[failCount] = e;
                        failIdx[failCount] = totalCalled - 1;
                        failCount = failCount + 1;
                    }
                }
            }
            i = i + 1;
        }

        if (failCount > 0) {
            Exception[] trimE = new Exception[failCount];
            int[] trimI = new int[failCount];
            int j = 0;
            while (j < failCount) {
                trimE[j] = failExns[j];
                trimI[j] = failIdx[j];
                j = j + 1;
            }
            throw new MulticastException(trimE, trimI, totalCalled);
        }
    }

    /// 按 handler 取消订阅（仅扫 strong 通道；advanced 通道用 token-based dispose）。
    ///
    /// 线性扫描 strong[]，每个 alive 槽与 handler 比较，命中置 alive=false；不 break ——
    /// 同 handler 多次 Subscribe 一次 Unsubscribe 全清。未订阅 handler 是 no-op。
    public void Unsubscribe(Action<T1, T2> handler) {
        int i = 0;
        while (i < this.strongCount) {
            if (this.strongAlive[i]) {
                if (Delegate.ReferenceEquals(this.strong[i], handler)) {
                    this.strongAlive[i] = false;
                }
            }
            i = i + 1;
        }
    }

    /// 内部：dispose token 入口，把对应通道的 alive[idx] 置 false。
    public void RemoveAt(int idx, bool isAdvanced) {
        if (isAdvanced) {
            if (idx >= 0 && idx < this.advancedCount) {
                this.advancedAlive[idx] = false;
            }
        } else {
            if (idx >= 0 && idx < this.strongCount) {
                this.strongAlive[idx] = false;
            }
        }
    }

    void GrowStrong() {
        int newCap = this.strongCapacity * 2;
        Action<T1, T2>[] biggerH = new Action<T1, T2>[newCap];
        bool[] biggerA = new bool[newCap];
        int i = 0;
        while (i < this.strongCount) {
            biggerH[i] = this.strong[i];
            biggerA[i] = this.strongAlive[i];
            i = i + 1;
        }
        this.strong = biggerH;
        this.strongAlive = biggerA;
        this.strongCapacity = newCap;
    }

    void GrowAdvanced() {
        int newCap = this.advancedCapacity * 2;
        ISubscription<Action<T1, T2>>[] biggerH = new ISubscription<Action<T1, T2>>[newCap];
        bool[] biggerA = new bool[newCap];
        int i = 0;
        while (i < this.advancedCount) {
            biggerH[i] = this.advanced[i];
            biggerA[i] = this.advancedAlive[i];
            i = i + 1;
        }
        this.advanced = biggerH;
        this.advancedAlive = biggerA;
        this.advancedCapacity = newCap;
    }
}

/// 内部订阅 token —— Subscribe 返回它，Dispose 把对应通道的 alive[idx] 置 false。
public sealed class MulticastSubscription<T1, T2> : IDisposable {
    MulticastAction<T1, T2> bus;
    int idx;
    bool isAdvanced;

    /// 构造订阅 token。
    public MulticastSubscription(MulticastAction<T1, T2> bus, int idx, bool isAdvanced) {
        this.bus = bus;
        this.idx = idx;
        this.isAdvanced = isAdvanced;
    }

    /// 取消订阅：把对应通道的 alive[idx] 置 false。
    public void Dispose() {
        if (this.idx >= 0) {
            this.bus.RemoveAt(this.idx, this.isAdvanced);
            this.idx = -1;
        }
    }
}


