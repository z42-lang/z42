namespace Std;

// 命名独立于 Std.Object：SymbolTable 跳过 Object 跨 CU 导出（synthetic stub），其他 stdlib
// 文件无法用 Object.X 调静态方法。
/// 委托引用相等与拆解工具。
///
/// 运行时 Action<T> / Func<T,R> / Predicate<T> 等委托是 Z42FuncType 值（VM 的 Value::FuncRef /
/// Value::Closure 二者之一）。ReferenceEquals 按各自身份比较：FuncRef 看目标函数相同；
/// Closure 看目标函数相同 + env 的 GC ptr_eq；跨变体不等；非委托值返回 false 不报错。
public static class DelegateOps {
    /// 判断两个委托值是否引用相等。
    [Native("__delegate_eq")]
    public static extern bool ReferenceEquals(object a, object b);

    /// 从委托提取捕获的目标对象（receiver）；无可提取目标返回 null。
    [Native("__delegate_target")]
    public static extern object GetTarget(object delegateValue);

    /// 提取委托的 thunk 函数全限定名。
    [Native("__delegate_fn_name")]
    public static extern string GetFnName(object delegateValue);

    /// 用函数名 + 环境数组重建闭包；env[0] 通常是 receiver 对象。
    [Native("__make_closure")]
    public static extern object MakeClosure(string fnName, object[] env);
}
