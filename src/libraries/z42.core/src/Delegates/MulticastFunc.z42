namespace Std;

/// 多播 Func：一次注册多个 `Func<TArg, TResult>` handler。
///
/// Invoke 收集所有返回值进 `TResult[]`（FIFO，注册顺序 = 调用顺序）。与单播
/// `Func<TArg, TResult>` 分离。
///
/// 双 vec 通道：
///   - strong 通道 —— 直接持 Func<TArg, TResult>，裸 handler `Subscribe(...)` 走此路径。
///   - advanced 通道 —— 持 ISubscription<Func<TArg, TResult>> 包装器（OnceRef / CompositeRef /
///     自定义），invoke 慢路径走 IsAlive + Get + OnInvoked。
///
/// Invoke 时拷贝当前数组遍历副本（COW snapshot）。
public sealed class MulticastFunc<TArg, TResult> {
    // ── strong fast path ──
    Func<TArg, TResult>[] strong;
    bool[] strongAlive;
    int strongCount;
    int strongCapacity;

    // ── advanced slow path ──
    ISubscription<Func<TArg, TResult>>[] advanced;
    bool[] advancedAlive;
    int advancedCount;
    int advancedCapacity;

    /// 构造空的多播 Func。
    public MulticastFunc() {
        this.strongCapacity = 4;
        this.strong = new Func<TArg, TResult>[4];
        this.strongAlive = new bool[4];
        this.strongCount = 0;

        this.advancedCapacity = 4;
        this.advanced = new ISubscription<Func<TArg, TResult>>[4];
        this.advancedAlive = new bool[4];
        this.advancedCount = 0;
    }

    /// 裸 handler 订阅 → strong 快路径（零包装开销）。
    public IDisposable Subscribe(Func<TArg, TResult> handler) {
        if (this.strongCount == this.strongCapacity) this.GrowStrong();
        int idx = this.strongCount;
        this.strong[idx] = handler;
        this.strongAlive[idx] = true;
        this.strongCount = this.strongCount + 1;
        return new MulticastFuncSubscription<TArg, TResult>(this, idx, false);
    }

    /// ISubscription 包装器订阅 → advanced 慢路径（OnceRef / CompositeRef / 用户自定义包装器）。
    public IDisposable SubscribeAdvanced(ISubscription<Func<TArg, TResult>> wrapper) {
        if (this.advancedCount == this.advancedCapacity) this.GrowAdvanced();
        int idx = this.advancedCount;
        this.advanced[idx] = wrapper;
        this.advancedAlive[idx] = true;
        this.advancedCount = this.advancedCount + 1;
        return new MulticastFuncSubscription<TArg, TResult>(this, idx, true);
    }

    /// 当前活跃订阅总数（strong + advanced）。
    public int Count() {
        int c = 0;
        int i = 0;
        while (i < this.strongCount) {
            if (this.strongAlive[i]) c = c + 1;
            i = i + 1;
        }
        i = 0;
        while (i < this.advancedCount) {
            if (this.advancedAlive[i] && this.advanced[i].IsAlive()) c = c + 1;
            i = i + 1;
        }
        return c;
    }

    [Suppress("style.fnLinesHard", "132 body lines；拆分见 code-organization.md")]
    /// 触发所有活跃 handler，收集返回值进 TResult[]（strong-first / advanced-after 顺序）。
    ///
    /// `continueOnException = false`（默认）走 fail-fast：首个抛出的异常直接传播。
    /// `continueOnException = true` 时失败位置占 default(TResult)，多失败聚合抛
    /// MulticastException<TResult>（携带 Results 与失败索引 / 异常并行数组）。
    public TResult[] Invoke(TArg arg, bool continueOnException = false) {
        // ── strong snapshot + fast loop ──
        int sn = this.strongCount;
        Func<TArg, TResult>[] snapStrong = new Func<TArg, TResult>[sn];
        bool[] snapStrongAlive = new bool[sn];
        int i = 0;
        while (i < sn) {
            snapStrong[i] = this.strong[i];
            snapStrongAlive[i] = this.strongAlive[i];
            i = i + 1;
        }

        // ── advanced snapshot + slow loop ──
        int an = this.advancedCount;
        ISubscription<Func<TArg, TResult>>[] snapAdv = new ISubscription<Func<TArg, TResult>>[an];
        bool[] snapAdvAlive = new bool[an];
        i = 0;
        while (i < an) {
            snapAdv[i] = this.advanced[i];
            snapAdvAlive[i] = this.advancedAlive[i];
            i = i + 1;
        }

        // 先统计活跃 handler 总数确定 result 长度
        int total = 0;
        i = 0;
        while (i < sn) {
            if (snapStrongAlive[i]) total = total + 1;
            i = i + 1;
        }
        i = 0;
        while (i < an) {
            if (snapAdvAlive[i] && snapAdv[i].IsAlive()) total = total + 1;
            i = i + 1;
        }

        TResult[] result = new TResult[total];
        int outIdx = 0;

        // ── fail-fast 路径（continueOnException=false）──
        if (!continueOnException) {
            i = 0;
            while (i < sn) {
                if (snapStrongAlive[i]) {
                    result[outIdx] = snapStrong[i](arg);
                    outIdx = outIdx + 1;
                }
                i = i + 1;
            }
            i = 0;
            while (i < an) {
                if (snapAdvAlive[i]) {
                    var w = snapAdv[i];
                    if (w.IsAlive()) {
                        result[outIdx] = w.Get()(arg);
                        w.OnInvoked();
                        outIdx = outIdx + 1;
                    }
                }
                i = i + 1;
            }
            return result;
        }

        // ── continueOnException=true 路径：累积失败 + 占位 default(TResult) ──
        Exception[] failExns = new Exception[8];
        int[] failIdx = new int[8];
        int failCap = 8;
        int failCount = 0;

        i = 0;
        while (i < sn) {
            if (snapStrongAlive[i]) {
                try {
                    result[outIdx] = snapStrong[i](arg);
                } catch (Exception e) {
                    result[outIdx] = default(TResult);
                    if (failCount == failCap) {
                        int newCap = failCap * 2;
                        Exception[] biggerE = new Exception[newCap];
                        int[] biggerI = new int[newCap];
                        int k = 0;
                        while (k < failCount) {
                            biggerE[k] = failExns[k];
                            biggerI[k] = failIdx[k];
                            k = k + 1;
                        }
                        failExns = biggerE;
                        failIdx = biggerI;
                        failCap = newCap;
                    }
                    failExns[failCount] = e;
                    failIdx[failCount] = outIdx;
                    failCount = failCount + 1;
                }
                outIdx = outIdx + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < an) {
            if (snapAdvAlive[i]) {
                var w = snapAdv[i];
                if (w.IsAlive()) {
                    try {
                        result[outIdx] = w.Get()(arg);
                        w.OnInvoked();
                    } catch (Exception e) {
                        result[outIdx] = default(TResult);
                        if (failCount == failCap) {
                            int newCap = failCap * 2;
                            Exception[] biggerE = new Exception[newCap];
                            int[] biggerI = new int[newCap];
                            int k = 0;
                            while (k < failCount) {
                                biggerE[k] = failExns[k];
                                biggerI[k] = failIdx[k];
                                k = k + 1;
                            }
                            failExns = biggerE;
                            failIdx = biggerI;
                            failCap = newCap;
                        }
                        failExns[failCount] = e;
                        failIdx[failCount] = outIdx;
                        failCount = failCount + 1;
                    }
                    outIdx = outIdx + 1;
                }
            }
            i = i + 1;
        }

        if (failCount > 0) {
            Exception[] trimE = new Exception[failCount];
            int[] trimI = new int[failCount];
            int j = 0;
            while (j < failCount) {
                trimE[j] = failExns[j];
                trimI[j] = failIdx[j];
                j = j + 1;
            }
            throw new MulticastException<TResult>(trimE, trimI, total, result);
        }
        return result;
    }

    /// 按 handler 取消订阅（仅扫 strong 通道；advanced 通道用 token-based dispose）。
    public void Unsubscribe(Func<TArg, TResult> handler) {
        int i = 0;
        while (i < this.strongCount) {
            if (this.strongAlive[i]) {
                if (DelegateOps.ReferenceEquals(this.strong[i], handler)) {
                    this.strongAlive[i] = false;
                }
            }
            i = i + 1;
        }
    }

    /// 内部：dispose token 入口，把对应通道的 alive[idx] 置 false。
    public void RemoveAt(int idx, bool isAdvanced) {
        if (isAdvanced) {
            if (idx >= 0 && idx < this.advancedCount) {
                this.advancedAlive[idx] = false;
            }
        } else {
            if (idx >= 0 && idx < this.strongCount) {
                this.strongAlive[idx] = false;
            }
        }
    }

    void GrowStrong() {
        int newCap = this.strongCapacity * 2;
        Func<TArg, TResult>[] biggerH = new Func<TArg, TResult>[newCap];
        bool[] biggerA = new bool[newCap];
        int i = 0;
        while (i < this.strongCount) {
            biggerH[i] = this.strong[i];
            biggerA[i] = this.strongAlive[i];
            i = i + 1;
        }
        this.strong = biggerH;
        this.strongAlive = biggerA;
        this.strongCapacity = newCap;
    }

    void GrowAdvanced() {
        int newCap = this.advancedCapacity * 2;
        ISubscription<Func<TArg, TResult>>[] biggerH = new ISubscription<Func<TArg, TResult>>[newCap];
        bool[] biggerA = new bool[newCap];
        int i = 0;
        while (i < this.advancedCount) {
            biggerH[i] = this.advanced[i];
            biggerA[i] = this.advancedAlive[i];
            i = i + 1;
        }
        this.advanced = biggerH;
        this.advancedAlive = biggerA;
        this.advancedCapacity = newCap;
    }
}

/// 内部订阅 token —— Subscribe 返回它，Dispose 把 alive[idx] 置 false。
public sealed class MulticastFuncSubscription<TArg, TResult> : IDisposable {
    MulticastFunc<TArg, TResult> bus;
    int idx;
    bool isAdvanced;

    /// 构造订阅 token。
    public MulticastFuncSubscription(MulticastFunc<TArg, TResult> bus, int idx, bool isAdvanced) {
        this.bus = bus;
        this.idx = idx;
        this.isAdvanced = isAdvanced;
    }

    /// 取消订阅：把对应通道的 alive[idx] 置 false。
    public void Dispose() {
        if (this.idx >= 0) {
            this.bus.RemoveAt(this.idx, this.isAdvanced);
            this.idx = -1;
        }
    }
}
