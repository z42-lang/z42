                            biggerI[k] = failIdx[k];
                            k = k + 1;
                        }
                        failExns = biggerE;
                        failIdx = biggerI;
                        failCap = newCap;
                    }
                    failExns[failCount] = e;
                    failIdx[failCount] = outIdx;
                    failCount = failCount + 1;
                }
                outIdx = outIdx + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < an) {
            if (snapAdvAlive[i]) {
                var w = snapAdv[i];
                if (w.IsAlive()) {
                    try {
                        result[outIdx] = w.Get()(a, b, c, d);
                        w.OnInvoked();
                    } catch (Exception e) {
                        result[outIdx] = default(TResult);
                        if (failCount == failCap) {
                            int newCap = failCap * 2;
                            Exception[] biggerE = new Exception[newCap];
                            int[] biggerI = new int[newCap];
                            int k = 0;
                            while (k < failCount) {
                                biggerE[k] = failExns[k];
                                biggerI[k] = failIdx[k];
                                k = k + 1;
                            }
                            failExns = biggerE;
                            failIdx = biggerI;
                            failCap = newCap;
                        }
                        failExns[failCount] = e;
                        failIdx[failCount] = outIdx;
                        failCount = failCount + 1;
                    }
                    outIdx = outIdx + 1;
                }
            }
            i = i + 1;
        }

        if (failCount > 0) {
            Exception[] trimE = new Exception[failCount];
            int[] trimI = new int[failCount];
            int j = 0;
            while (j < failCount) {
                trimE[j] = failExns[j];
                trimI[j] = failIdx[j];
                j = j + 1;
            }
            throw new MulticastException<TResult>(trimE, trimI, total, result);
        }
        return result;
    }

}

/// 内部订阅 token —— Subscribe 返回它，Dispose 把对应通道的 alive[idx] 置 false。
public sealed class MulticastFuncSubscription<T1, T2, T3, T4, TResult> : IDisposable {
    MulticastFunc<T1, T2, T3, T4, TResult> bus;
    int idx;
    bool isAdvanced;

    /// 构造订阅 token。
    public MulticastFuncSubscription(MulticastFunc<T1, T2, T3, T4, TResult> bus, int idx, bool isAdvanced) {
        this.bus = bus;
        this.idx = idx;
        this.isAdvanced = isAdvanced;
    }

    /// 取消订阅：把对应通道的 alive[idx] 置 false。
    public void Dispose() {
        if (this.idx >= 0) {
            this.bus.RemoveAt(this.idx, this.isAdvanced);
            this.idx = -1;
        }
    }
}
