namespace Std;

/// CompositeRef 的 mode 标志常量。
// 用 int 常量 + 位运算（z42 enum 暂不支持 [Flags] | 操作）。
public class ModeFlags {
    /// 无标记。
    public static int None = 0;
    /// 一次性标记。
    public static int Once = 1;
    /// 弱引用标记。
    public static int Weak = 2;
}

/// 强引用包装 —— 默认无状态。
///
/// Subscribe(handler) 对应到内部 strong 通道走快路径；用户显式构造 StrongRef 走
/// advanced 通道也合法。
public sealed class StrongRef<TD> : ISubscription<TD> {
    TD handler;

    /// 用 handler 构造强引用包装。
    public StrongRef(TD h) {
        this.handler = h;
    }

    /// 返回被包装的委托。
    public TD Get() {
        return this.handler;
    }

    /// 恒为 true。
    public bool IsAlive() {
        return true;
    }

    /// 无操作（无状态包装器）。
    public void OnInvoked() {
        // nop
    }
}

/// 一次性包装 —— 第一次 OnInvoked 后 IsAlive=false。
public sealed class OnceRef<TD> : ISubscription<TD> {
    TD handler;
    bool consumed;

    /// 用 handler 构造一次性包装。
    public OnceRef(TD h) {
        this.handler = h;
        this.consumed = false;
    }

    /// 返回被包装的委托。
    public TD Get() {
        return this.handler;
    }

    /// 是否尚未被消费。
    public bool IsAlive() {
        return !this.consumed;
    }

    /// 标记为已消费。
    public void OnInvoked() {
        this.consumed = true;
    }
}

/// 组合包装 —— mode flags 累加；融合后只分配一个 CompositeRef 实例。
///
/// Mode.Weak 时 CompositeRef 不强持 handler，而是存 (WeakHandle, fnName)，Get 时重建
/// Closure；否则 weak 会失效。strong 路径继续直接持 handler 走快路径。
public sealed class CompositeRef<TD> : ISubscription<TD> {
    private TD strongHandler;       // 仅 Mode.Weak 未启用 / weak 退化时有效
    /// 组合的 mode flags 位掩码（`ModeFlags` 各值的按位或）。
    public int Modes;
    bool consumed;
    private WeakHandle weakHandle;
    private string fnName;
    bool weakDegraded;

    /// 用 handler 与 mode flags 构造组合包装。
    public CompositeRef(TD h, int modes) {
        this.Modes = modes;
        this.consumed = false;
        this.weakDegraded = true;
        this.weakHandle = null;
        this.fnName = null;
        if ((modes & ModeFlags.Weak) != 0) {
            // Mode.Weak set：尝试拆解 handler 为 (WeakHandle, fnName)
            var target = DelegateOps.GetTarget(h);
            if (target != null) {
                this.weakHandle = WeakHandle.MakeWeak(target);
                this.fnName = DelegateOps.GetFnName(h);
                this.weakDegraded = false;
                // 故意不存 strongHandler —— 与 WeakRef 同款，避免反向锁住 receiver
            } else {
                // 退化 strong：listener 无可弱化目标
                this.strongHandler = h;
            }
        } else {
            // 无 Weak flag：strong path
            this.strongHandler = h;
        }
    }

    /// 累加 mode flag 复用本实例，链式 .AsOnce().AsWeak() 不重复分配（融合）。
    // 构造后追加 Weak 不重新拆解 handler；推荐在 ctor 直接传完整 mode。
    public CompositeRef<TD> WithMode(int additional) {
        this.Modes = this.Modes | additional;
        return this;
    }

    /// 返回 handler；Weak 活跃时经 weakHandle 重建 Closure。
    public TD Get() {
        if ((this.Modes & ModeFlags.Weak) != 0 && !this.weakDegraded) {
            // Weak 活跃路径：upgrade target → 重建 Closure
            var target = WeakHandle.Upgrade(this.weakHandle);
            if (target == null) return null;
            var env = new object[1];
            env[0] = target;
            return (TD)DelegateOps.MakeClosure(this.fnName, env);
        }
        // strong 或 weak 退化：直接返回 strongHandler
        return this.strongHandler;
    }

    /// 是否仍活跃（考虑 consumed 与 weak target）。
    public bool IsAlive() {
        if (this.consumed) return false;
        if ((this.Modes & ModeFlags.Weak) != 0 && !this.weakDegraded) {
            var live = WeakHandle.Upgrade(this.weakHandle);
            return live != null;
        }
        return true;
    }

    /// Once flag 时标记为已消费。
    public void OnInvoked() {
        // Once flag → latch consumed
        if ((this.Modes & ModeFlags.Once) != 0) {
            this.consumed = true;
        }
    }
}

/// 弱引用包装。
///
/// WeakRef 不强持原 handler（那会反向锁住 receiver，因为 Closure 自己强持 env=[receiver]，
/// weak 无效）。相反，构造时拆解 handler 为 WeakHandle + fnName；target 不可弱化时退化 strong。
/// Get 时若 target 还活：用 MakeClosure(fnName, [target]) 重建新 Closure；若 target 已死：
/// 返回 null，IsAlive=false。
public sealed class WeakRef<TD> : ISubscription<TD> {
    private TD degradedHandler;  // 仅 isDegraded=true 时有效
    private WeakHandle weakHandle;
    private string fnName;
    bool isDegraded;

    /// 用 handler 构造弱引用包装。
    public WeakRef(TD h) {
        var target = DelegateOps.GetTarget(h);
        if (target != null) {
            this.weakHandle = WeakHandle.MakeWeak(target);
            this.fnName = DelegateOps.GetFnName(h);
            this.isDegraded = false;
            // degradedHandler 不存 —— 故意不强持原 handler
        } else {
            this.degradedHandler = h;
            this.weakHandle = null;
            this.fnName = null;
            this.isDegraded = true;
        }
    }

    /// target 存活时重建 Closure 返回；否则返回 null（退化时返回 degradedHandler）。
    public TD Get() {
        if (this.isDegraded) return this.degradedHandler;
        var target = WeakHandle.Upgrade(this.weakHandle);
        if (target == null) return null;
        // 重建 Closure：env=[target]，fn_name=同原 handler 的 thunk 名
        var env = new object[1];
        env[0] = target;
        return (TD)DelegateOps.MakeClosure(this.fnName, env);
    }

    /// 是否仍活跃（退化时恒 true）。
    public bool IsAlive() {
        if (this.isDegraded) return true;
        var live = WeakHandle.Upgrade(this.weakHandle);
        return live != null;
    }

    /// 无操作（weak 不维护本地状态）。
    public void OnInvoked() {
        // noop
    }
}
