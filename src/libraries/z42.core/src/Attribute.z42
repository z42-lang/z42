namespace Std;

// Base class for all user-defined attributes (spec: add-attribute-reflection, C3).
//
// A user attribute is an ordinary class deriving from `Attribute` whose name
// MUST end with the `Attribute` suffix (D8 convention, enforced as E0444):
//
//     class RouteAttribute : Attribute {
//         public string Path;
//         public RouteAttribute(string path) { this.Path = path; }
//     }
//
// applied with the suffix stripped from the use-name (`[Route]`, defined as
// `RouteAttribute`):
//
//     [Route("/users")] class UsersController { }
//
// and read back via reflection — `Type.GetCustomAttributes()` /
// `MethodInfo.GetCustomAttributes()` return live instances (the same cached
// instance on repeated calls). The compiler synthesizes a parameterless factory
// per application, so no runtime `Activator`/`Invoke` is involved.
//
// Mirrors C# `System.Attribute`: same `[Use]` ↔ `UseAttribute` suffix mapping,
// but z42 makes the suffix mandatory (hard error, vs C#'s optional CA1710
// warning). Single constructor init path, cached immutable instances. See
// docs/design/language/attributes.md and the attribute-handler-registry design.
public class Attribute {
}
