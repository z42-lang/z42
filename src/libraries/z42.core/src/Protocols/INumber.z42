namespace Std;

// Self-numeric interface (C# 11 static abstract alignment).
// Declares 5 binary arithmetic operators as `static abstract`. Implementers
// (primitive structs, user structs/classes) must provide `static override`
// counterparts. Generic code `where T: INumber` writes `a + b` (or the
// mangled form `T.op_Add(a, b)`) and the compiler dispatches to the concrete
// implementer via value-driven VCall — receiver's runtime class determines
// which `op_Add` to run.
//
// Comparison goes through IComparable; equality through IEquatable.
// Mixed-type arithmetic is not supported (Self + Self → Self only) —— 正因如此，
// 原先的型参 `T` 不携带任何信息（`where T : INumber<T>` 纯是「我指我自己」的样板），
// 已由 `Self` 取代。
public interface INumber {
    static abstract Self op_Add(Self a, Self b);
    static abstract Self op_Subtract(Self a, Self b);
    static abstract Self op_Multiply(Self a, Self b);
    static abstract Self op_Divide(Self a, Self b);
    static abstract Self op_Modulo(Self a, Self b);
}
