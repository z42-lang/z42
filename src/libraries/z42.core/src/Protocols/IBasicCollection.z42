namespace Std;

/// 基础集合契约：集合类型实现此接口表明它有标准的「大小 + 清空」操作。
///
/// 成员说明：
///   - `Count()` — 元素数
///   - `IsEmpty()` — 等价于 `Count() == 0` 的快捷方式
///   - `Clear()` — 清空所有元素；幂等
///   - `AddOne(T)` — 契约层的统一单元素插入，各集合委托其自然 add（Enqueue / Push /
///     AddLast / Add），顺序 / 去重策略由实现决定
public interface IBasicCollection<T> {
    /// 元素数。
    int Count();
    /// 是否为空（等价于 `Count() == 0`）。
    bool IsEmpty();
    /// 清空所有元素；幂等。
    void Clear();
    /// 插入一个元素；顺序 / 去重策略由实现决定。
    void AddOne(T item);
}
