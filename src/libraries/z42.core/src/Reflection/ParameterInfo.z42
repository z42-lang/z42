namespace Std.Reflection;

/// 反射方法参数，对标 C# `System.Reflection.ParameterInfo`（只读子集），由
/// `MethodInfo.GetParameters()` 填充。
public class ParameterInfo {
    /// 参数名。
    public string Name;

    /// 参数的声明类型，如 `typeof(int)`。
    public Std.Type ParameterType;

    /// 在参数列表中的 0 基位置（不含隐式 `this`）。
    public int Position;

    /// 该参数是否有默认值。
    public bool IsOptional;
    /// 该参数是否为 `params` 变长参数。
    public bool IsParams;
    /// 折出的常量默认值（字面量与常量表达式）；折不出的为 null。
    ///
    /// 注意：`DefaultValue == null` 不代表没有默认值，判有无看 `IsOptional`。
    public object? DefaultValue;

    // ── 自定义 attribute ─────────────────────────────────────────────────────

    // 后备方法/函数的全限定名（VM 写入），与 Position 一起用于解析本参数的 attribute 工厂。
    public string __qualified;

    // 缓存的 attribute 实例（缓存理由见 Type.GetCustomAttributes）。
    public Std.Attribute[] __attrCache;

    [Native("__param_custom_attributes")]
    public extern Std.Attribute[] __customAttributes(string qualified, int position);

    /// 本参数上应用的 attribute，以活实例返回；首次调用后缓存。
    public Std.Attribute[] GetCustomAttributes() {
        if (this.__attrCache != null) {
            return this.__attrCache;
        }
        this.__attrCache = this.__customAttributes(this.__qualified, this.Position);
        return this.__attrCache;
    }

    /// 指定类型的单个 attribute，无则返回 null。按实例运行期类型的 FullName 比较，子类 attribute 也匹配。
    public Std.Attribute? GetAttribute(Std.Type attributeType) {
        Std.Attribute[] all = this.GetCustomAttributes();
        int i = 0;
        while (i < all.Length) {
            Std.Attribute a = all[i];
            Std.Type at = a.GetType();
            if (at.FullName == attributeType.FullName) {
                return a;
            }
            i = i + 1;
        }
        return null;
    }
}
