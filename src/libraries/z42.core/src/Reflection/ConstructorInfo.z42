namespace Std.Reflection;

/// 反射构造器，对标 C# `System.Reflection.ConstructorInfo`，由 `Type.GetConstructors()` 枚举。
///
/// 与 `MethodInfo.Invoke`（在既有接收者上调方法）不同，`Invoke` 分配新实例并跑构造体，返回构造
/// 出的对象（带参构造）。构造器永不静态，继承自 MethodBase 的 `IsStatic` 恒为 false。
public class ConstructorInfo : MethodBase {
    /// VM 写入：调用本构造器所构造的类型的规范名（从构造泛型 `Type` 枚举时带实参，如
    /// `Demo.Box<int>`），`Invoke` 按它分配实例。
    public string __owner;

    /// 分配新实例并跑构造体，返回构造出的对象。
    ///
    /// `args` 按声明序映射形参。实参个数不符抛 `Std.Exception`；构造体内的 `throw`
    /// 以原类型传播。
    [Native("__ctor_invoke")]
    public extern object Invoke(object[] args);

    // ── 自定义 attribute ─────────────────────────────────────────────────────

    /// native 门面：取 `qualified` 全限定名对应函数上的 attribute 实例数组（构造器是
    /// 普通函数，与方法共用同一索引通道）。
    [Native("__method_custom_attributes")]
    public extern Std.Attribute[] __customAttributes(string qualified);

    /// 覆写：构造器的成员种类。
    public override MemberTypes MemberType { get { return MemberTypes.Constructor; } }

    /// 覆写：按全限定名取本构造器的 attribute 实例。缓存骨架在 MemberInfo。
    public override Std.Attribute[] __fetchCustomAttributes() {
        return this.__customAttributes(this.__qualified);
    }
}
