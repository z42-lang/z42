namespace Std.Reflection;

/// 反射属性，对标 C# `System.Reflection.PropertyInfo`，由 `Type.GetProperties()` 填充。
///
/// 由 `get_<X>` / `set_<X>` 访问器方法约定在运行时派生（auto-property 降解为字段 + get_/set_ 方法）：
/// getter 使其可读、setter 使其可写，同名 getter + setter 合并为一条。`GetValue` / `SetValue` 经非泛型
/// invoke 路径反射调用访问器。
public class PropertyInfo : MemberInfo {
    /// 属性类型——getter 的返回类型；只写属性取 setter 的值形参类型。
    public Std.Type PropertyType;

    /// 是否有 getter（`get_<Name>`）。
    public bool CanRead;

    /// 是否有 setter（`set_<Name>`）。
    public bool CanWrite;

    /// 是否有公开的实例 getter。
    public bool CanReadPublicInstance;

    /// 是否有公开的实例 setter。
    public bool CanWritePublicInstance;

    /// getter（`get_<Name>`）的全限定名（VM 在 __type_properties 里盖章）；无 getter 时为 null。
    ///
    /// GetValue 据此解析要调的函数。
    public string __getterQualified;
    /// setter（`set_<Name>`）的全限定名；无 setter 时为 null。
    ///
    /// SetValue 据此解析要调的函数。
    public string __setterQualified;

    /// 属性的全限定名（`<声明类>.<属性名>`，VM 写入）。值相等的身份判据（见下方 operator ==）。
    public string __qualified;

    // ── 值相等 ────────────────────────────────────────────────────────────────
    // 与 MethodInfo / FieldInfo 同款（add-field-property-reference）：身份判据是 __qualified。
    // 判空必须用 Object.ReferenceEquals：写 `a == null` 会递归派发回本运算符（栈溢出）。
    /// 按 `__qualified`（声明类全名 + 属性名）判断两个 `PropertyInfo` 是否指向同一属性。
    public static bool operator ==(PropertyInfo a, PropertyInfo b) {
        bool an = Object.ReferenceEquals(a, null);
        bool bn = Object.ReferenceEquals(b, null);
        if (an || bn) { return an && bn; }
        return a.__qualified == b.__qualified;
    }

    /// 不等运算符，等价于 `!(a == b)`。
    public static bool operator !=(PropertyInfo a, PropertyInfo b) {
        bool an = Object.ReferenceEquals(a, null);
        bool bn = Object.ReferenceEquals(b, null);
        if (an || bn) { return !(an && bn); }
        return a.__qualified != b.__qualified;
    }

    /// 值相等：`other` 为 `PropertyInfo` 且 `__qualified` 相同才为真（与 `==` 一致）。
    public override bool Equals(object other) {
        PropertyInfo p = other as PropertyInfo;
        if (Object.ReferenceEquals(p, null)) { return false; }
        return this.__qualified == p.__qualified;
    }

    /// 哈希码取自 `__qualified`，与 Equals 的判据一致。
    public override int GetHashCode() { return this.__qualified.GetHashCode(); }

    /// 经 getter 从 `obj` 读出本属性值。只写属性（无 getter）抛 `Std.Exception`。
    [Native("__property_get_value")]
    public extern object GetValue(object obj);

    /// 经 setter 把 `value` 写入 `obj` 上的本属性。只读属性（无 setter）抛 `Std.Exception`。
    [Native("__property_set_value")]
    public extern void SetValue(object obj, object value);

    // ── 自定义 attribute ─────────────────────────────────────────────────────
    // auto-property 降解为私有后备字段 `__prop_<Name>`，编译器把属性上的 attribute 挂到该字段，故 native
    // 从访问器全限定名（剥掉 get_/set_ 前缀 → 后备字段）解析。纯计算属性（无后备字段）没有 attribute。

    /// 缓存的 attribute 实例（缓存理由见 FieldInfo.GetCustomAttributes）。
    public Std.Attribute[] __attrCache;

    /// native 门面：按访问器全限定名取本属性上的 attribute 实例数组。
    [Native("__property_custom_attributes")]
    public extern Std.Attribute[] __customAttributes(string qualified);

    /// 本属性上应用的 attribute，以活实例返回；首次调用后缓存。用访问器全限定名（getter 优先，否则 setter）解析。
    public Std.Attribute[] GetCustomAttributes() {
        if (this.__attrCache != null) {
            return this.__attrCache;
        }
        string acc = this.__getterQualified;
        if (acc == null) { acc = this.__setterQualified; }
        if (acc == null) {
            this.__attrCache = new Std.Attribute[0];
            return this.__attrCache;
        }
        this.__attrCache = this.__customAttributes(acc);
        return this.__attrCache;
    }

    /// 指定类型的单个 attribute，无则返回 null。按实例运行期类型的 FullName 比较，子类 attribute 也匹配。
    public Std.Attribute? GetAttribute(Std.Type attributeType) {
        Std.Attribute[] all = this.GetCustomAttributes();
        int i = 0;
        while (i < all.Length) {
            Std.Attribute a = all[i];
            Std.Type at = a.GetType();
            if (at.FullName == attributeType.FullName) {
                return a;
            }
            i = i + 1;
        }
        return null;
    }
}
