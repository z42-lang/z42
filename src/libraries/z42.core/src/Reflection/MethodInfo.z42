namespace Std.Reflection;

// Reflected method. Populated by `Type.GetMethods()` (`__type_methods`).
// Mirrors C# `System.Reflection.MethodInfo`. Non-generic `Invoke` lands 0.3.12
// (add-method-invoke-non-generic); generic-method Invoke waits on generic
// instantiation (0.4.x G).
public class MethodInfo : MethodBase {
    // Return type, e.g. typeof(int) / typeof(void). Written by the VM.
    public Std.Type ReturnType;

    // IsStatic is inherited from MethodBase.

    // True for virtual / override / abstract methods (add-method-modifiers, unify
    // P1-c: now authoritative from the declared modifier, not a vtable heuristic).
    public bool IsVirtual;

    // True for abstract methods (add-method-modifiers, unify P1-c). Abstract
    // methods are also virtual (IsVirtual == true).
    public bool IsAbstract;

    // True for a `sealed override` (or the shorthand `sealed`) method — no further
    // override permitted (impl-sealed-semantics-devirt). Sealed methods are also
    // virtual (IsVirtual == true). Written by the VM from METHOD_FLAG_SEALED.
    public bool IsSealed;

    // Member visibility (add-member-visibility, unify P1-b). Written by the VM
    // from the method's declared modifier. A `protected` method reports neither
    // (IsPublic == IsPrivate == false), mirroring C# `IsPublic` / `IsPrivate`.
    public bool IsPublic;
    public bool IsPrivate;

    // __parameters / GetParameters() and __qualified are inherited from MethodBase.

    // ── Custom attributes (C3b add-attribute-reflection-methods) ────────────

    // Cached attribute instances (see Type.GetCustomAttributes for rationale).
    public Std.Attribute[] __attrCache;

    [Native("__method_custom_attributes")]
    public extern Std.Attribute[] __customAttributes(string qualified);

    // User attributes applied to this method, as live instances. Cached.
    public Std.Attribute[] GetCustomAttributes() {
        if (this.__attrCache != null) {
            return this.__attrCache;
        }
        this.__attrCache = this.__customAttributes(this.__qualified);
        return this.__attrCache;
    }

    // The single attribute of the given type, or null if absent. Compares by
    // the instance's runtime type (FullName), so subclass attributes match too.
    public Std.Attribute GetAttribute(Std.Type attributeType) {
        Std.Attribute[] all = this.GetCustomAttributes();
        int i = 0;
        while (i < all.Length) {
            Std.Attribute a = all[i];
            Std.Type at = a.GetType();
            if (at.FullName == attributeType.FullName) {
                return a;
            }
            i = i + 1;
        }
        return null;
    }

    // ── Reflective invocation (add-method-invoke-non-generic, 0.3.12) ───────
    // Invoke this method: `obj` is the receiver for instance methods (ignored —
    // pass null — for static methods); `args` map to the parameters in order.
    // Returns the method's return value (void → null). A `throw` inside the
    // invoked method propagates with its original type (catchable). Non-generic
    // only. The VM reads __qualified / IsStatic from this MethodInfo.
    [Native("__method_invoke")]
    public extern object Invoke(object obj, object[] args);

    // ── Generic-method reflection (add-reflective-invoke, G2) ───────────────
    // Mirrors C# `MethodInfo.{IsGenericMethod,IsGenericMethodDefinition,
    // GetGenericArguments,MakeGenericMethod}`. A method reflected from a generic
    // definition (`Foo<T>()`) is a *definition* (IsGenericMethodDefinition == true);
    // `MakeGenericMethod` binds type arguments and returns a *constructed* MethodInfo
    // (same type, no separate subtype — C# semantics), on which
    // IsGenericMethodDefinition == false and GetGenericArguments() returns the bound
    // arguments. Constructed-MethodInfo.Invoke materializes typeof(T)/new T()/default(T)
    // exactly as a direct `Foo<Arg>()` call.

    // True when this method declares type parameters (definition or constructed).
    // Written by the VM (definition) / MakeGenericMethod (constructed).
    public bool IsGenericMethod;

    // True for an unbound generic method definition; false once type arguments are
    // bound via MakeGenericMethod.
    public bool IsGenericMethodDefinition;

    // Declared type-parameter names (e.g. ["T","U"]); VM-written. Backs
    // GetGenericArguments() for the definition (placeholder Types from these names).
    public string[] __typeParamNames;

    // Bound type arguments (Type[]) set by MakeGenericMethod on the constructed
    // MethodInfo; null on a definition. Threaded into the callee frame by Invoke.
    public Std.Type[] __typeArgs;

    // The method's type parameters (definition) or bound type arguments (constructed).
    [Native("__method_generic_arguments")]
    public extern Std.Type[] GetGenericArguments();

    // Bind type arguments to a generic method definition, returning the constructed
    // MethodInfo. Throws Std.Exception if this method is not a generic definition or
    // the argument count differs from the declared type-parameter count.
    [Native("__method_make_generic")]
    public extern MethodInfo MakeGenericMethod(params Std.Type[] typeArgs);
}
