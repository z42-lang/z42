namespace Std.Reflection;

/// 反射方法，对标 C# `System.Reflection.MethodInfo`，由 `Type.GetMethods()` 填充。
///
/// 泛型方法从泛型定义（`Foo<T>()`）反射时是「定义」（IsGenericMethodDefinition == true）；
/// `MakeGenericMethod` 绑定类型实参后返回「构造后」的 MethodInfo。构造后 Invoke 时方法体内的
/// `typeof(T)` / `new T()` / `default(T)` 与直接写 `Foo<Arg>()` 完全一致。
public class MethodInfo : MethodBase {
    /// 返回类型，如 `typeof(int)` / `typeof(void)`。VM 写入。
    public Std.Type ReturnType;

    // IsStatic 继承自 MethodBase。

    /// 是否为 virtual / override / abstract 方法（三者都走虚派发）。
    public bool IsVirtual;

    /// 是否为 abstract 方法（同时 IsVirtual == true）。
    public bool IsAbstract;

    /// 是否为 `sealed override`（或简写 `sealed`）方法——不允许再 override（同时 IsVirtual == true）。
    public bool IsSealed;

    /// 声明为 public。
    public bool IsPublic;
    /// 声明为 private。`protected` 方法两者皆 false（镜像 C#）。
    public bool IsPrivate;

    // __parameters / GetParameters() / __qualified 继承自 MethodBase。

    // ── 值相等 ────────────────────────────────────────────────────────────────
    // 身份判据是 __qualified（全限定方法名，重载决议后已定）。判空必须用 Object.ReferenceEquals：
    // 写 `a == null` 会递归派发回本运算符（栈溢出）。不驻留：`ReferenceEquals(methodof(X.M), methodof(X.M))` 仍为假。
    /// 按 `__qualified`（全限定方法名）判断两个 `MethodInfo` 是否指向同一方法。
    public static bool operator ==(MethodInfo a, MethodInfo b) {
        bool an = Object.ReferenceEquals(a, null);
        bool bn = Object.ReferenceEquals(b, null);
        if (an || bn) { return an && bn; }
        return a.__qualified == b.__qualified;
    }

    /// 不等运算符，等价于 `!(a == b)`。
    public static bool operator !=(MethodInfo a, MethodInfo b) {
        bool an = Object.ReferenceEquals(a, null);
        bool bn = Object.ReferenceEquals(b, null);
        if (an || bn) { return !(an && bn); }
        return a.__qualified != b.__qualified;
    }

    public override bool Equals(object other) {
        MethodInfo m = other as MethodInfo;
        if (Object.ReferenceEquals(m, null)) { return false; }
        return this.__qualified == m.__qualified;
    }

    public override int GetHashCode() { return this.__qualified.GetHashCode(); }

    // ── 自定义 attribute ─────────────────────────────────────────────────────

    // 缓存的 attribute 实例（缓存理由见 Type.GetCustomAttributes）。
    public Std.Attribute[] __attrCache;

    [Native("__method_custom_attributes")]
    public extern Std.Attribute[] __customAttributes(string qualified);

    /// 本方法上应用的 attribute，以活实例返回；首次调用后缓存。
    public Std.Attribute[] GetCustomAttributes() {
        if (this.__attrCache != null) {
            return this.__attrCache;
        }
        this.__attrCache = this.__customAttributes(this.__qualified);
        return this.__attrCache;
    }

    /// 指定类型的单个 attribute，无则返回 null。按实例运行期类型的 FullName 比较，子类 attribute 也匹配。
    public Std.Attribute? GetAttribute(Std.Type attributeType) {
        Std.Attribute[] all = this.GetCustomAttributes();
        int i = 0;
        while (i < all.Length) {
            Std.Attribute a = all[i];
            Std.Type at = a.GetType();
            if (at.FullName == attributeType.FullName) {
                return a;
            }
            i = i + 1;
        }
        return null;
    }

    /// 调用本方法：实例方法 `obj` 是接收者（静态方法传 `null` 即可）；`args` 按声明序映射形参。
    ///
    /// 返回方法返回值（`void` → null）；被调方法内的 `throw` 以原类型传播。仅限非泛型方法。
    [Native("__method_invoke")]
    public extern object Invoke(object obj, object[] args);

    // ── 泛型方法反射 ─────────────────────────────────────────────────────────

    /// 方法是否声明了类型参数（定义或已构造均为 true）。
    public bool IsGenericMethod;

    /// 是否为未绑定的泛型方法定义；经 `MakeGenericMethod` 绑定实参后为 false。
    public bool IsGenericMethodDefinition;

    // 声明的类型参数名（如 ["T","U"]），VM 写入；定义上 GetGenericArguments() 据此生成占位 Type。
    public string[] __typeParamNames;

    // 构造后 MethodInfo 上由 MakeGenericMethod 绑定的类型实参（Type[]）；定义上为 null。Invoke 时传入被调帧。
    public Std.Type[] __typeArgs;

    /// 方法的类型参数（定义上）或绑定的类型实参（构造后）。
    [Native("__method_generic_arguments")]
    public extern Std.Type[] GetGenericArguments();

    /// 给泛型方法定义绑定类型实参，返回构造后的 MethodInfo。本方法非泛型定义或实参个数不符时抛
    /// `Std.Exception`。
    [Native("__method_make_generic")]
    public extern MethodInfo MakeGenericMethod(params Std.Type[] typeArgs);
}
