namespace Std.Reflection;

/// 反射字段，对标 C# `System.Reflection.FieldInfo`，由 `Type.GetFields()` 填充。
///
/// `GetValue` / `SetValue` 直接读写实例字段的槽（字段即槽、无访问器），是反射式（反）序列化落到
/// 公开字段上的通路。
public class FieldInfo : MemberInfo {
    /// 字段的声明类型，如 `typeof(int)`。VM 写入。
    public Std.Type FieldType;

    /// 是否为静态字段。
    public bool IsStatic;

    /// 从 `obj` 读出本实例字段的值。
    [Native("__field_get_value")]
    public extern object GetValue(object obj);

    /// 把 `value` 写入 `obj` 上的本实例字段。
    [Native("__field_set_value")]
    public extern void SetValue(object obj, object value);

    /// 声明为 public。
    public bool IsPublic;
    /// 声明为 private。`protected` 字段两者皆 false（镜像 C#）。
    public bool IsPrivate;

    // ── 自定义 attribute ─────────────────────────────────────────────────────

    // 字段的全限定名（VM 写入，形如 "<Class>.<Field>"），用于解析本字段的 attribute 工厂。
    public string __qualified;

    // 缓存的 attribute 实例（缓存理由见 Type.GetCustomAttributes）。
    public Std.Attribute[] __attrCache;

    [Native("__field_custom_attributes")]
    public extern Std.Attribute[] __customAttributes(string qualified);

    /// 本字段上应用的 attribute，以活实例返回；首次调用后缓存。
    public Std.Attribute[] GetCustomAttributes() {
        if (this.__attrCache != null) {
            return this.__attrCache;
        }
        this.__attrCache = this.__customAttributes(this.__qualified);
        return this.__attrCache;
    }

    /// 指定类型的单个 attribute，无则返回 null。按实例运行期类型的 FullName 比较，子类 attribute 也匹配。
    public Std.Attribute? GetAttribute(Std.Type attributeType) {
        Std.Attribute[] all = this.GetCustomAttributes();
        int i = 0;
        while (i < all.Length) {
            Std.Attribute a = all[i];
            Std.Type at = a.GetType();
            if (at.FullName == attributeType.FullName) {
                return a;
            }
            i = i + 1;
        }
        return null;
    }
}
