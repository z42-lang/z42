namespace Std;

/// `Std.String` 的 partial 碎片 —— Split / Join / Concat / Format。
///
/// 本碎片持有**整个 Split 家族**（`Split(string)` / `Split(string,int)` / `Split(char[])`）——
/// 同名方法组必须同碎片，见 `String.z42` 头部的碎片归属说明。
public sealed partial class String {
    // ── Split / Join ─────────────────────────────────────────────────────────
    // Split(string) 的扫描与切段走原生 `__str_split`（一次扫描、每段一次分配）；
    // 其余重载（options / char[] 分隔符集合）与 Join / Concat 是脚本。

    /// 按整串分隔符切分（从左到右，相邻/首尾分隔符产生空段）。空分隔符抛异常。
    public string[] Split(string separator) {
        if (separator.Length == 0) {
            throw new Exception("string.Split: separator must not be empty");
        }
        return this._splitRaw(separator);
    }

    // 原生扫描 + 切段：脚本版是逐字符两遍循环，切分恰好是开销全在扫描上的操作。
    [Native("__str_split")] extern string[] _splitRaw(string separator);

    /// 按分隔符切分，再按 `options` 后处理（`SplitOptions.TrimEntries` / `RemoveEmptyEntries`
    /// 的按位或）。
    // 实现：先复用单参 Split 拿原始段，再按 options 后处理（trim / 滤空）。
    public string[] Split(string separator, int options) {
        string[] raw = this.Split(separator);
        bool trim   = (options & SplitOptions.TrimEntries) != 0;
        bool dropEmpty = (options & SplitOptions.RemoveEmptyEntries) != 0;
        if (!trim && !dropEmpty) return raw;

        // Pass 1: trim (if requested) + count keeps
        string[] processed = new string[raw.Length];
        int keep = 0;
        int i = 0;
        while (i < raw.Length) {
            string s = raw[i];
            if (trim) s = s.Trim();
            if (dropEmpty && s.Length == 0) { i = i + 1; continue; }
            processed[keep] = s;
            keep = keep + 1;
            i = i + 1;
        }
        // Pass 2: compact to keep-sized array
        if (keep == raw.Length) return processed;
        string[] result = new string[keep];
        int j = 0;
        while (j < keep) {
            result[j] = processed[j];
            j = j + 1;
        }
        return result;
    }

    /// 按 `separators` 中任一单字符切分；空数组按空白切分。
    public string[] Split(char[] separators) {
        char[] t = this.ToCharArray();
        int n = t.Length;
        bool ws = separators.Length == 0;
        // Pass 1: 数段数（分隔符个数 + 1）
        int count = 1;
        for (int i = 0; i < n; i++) {
            if (String._isSplitSep(t[i], separators, ws)) { count = count + 1; }
        }
        // Pass 2: 切段（相邻/首尾分隔符产生空段，与 Split(string) 一致不滤空）
        string[] result = new string[count];
        int idx = 0;
        int start = 0;
        for (int k = 0; k < n; k++) {
            if (String._isSplitSep(t[k], separators, ws)) {
                result[idx] = this.Substring(start, k - start);
                idx = idx + 1;
                start = k + 1;
            }
        }
        result[idx] = this.Substring(start, n - start);
        return result;
    }

    private static bool _isSplitSep(char c, char[] separators, bool ws) {
        if (ws) return c.IsWhiteSpace();
        int n = separators.Length;
        for (int i = 0; i < n; i++) {
            if (separators[i] == c) return true;
        }
        return false;
    }

    /// 以 `separator` 拼接各段。
    ///
    /// `params` 使 `Join("-", arr)` 与 `Join("-", "a", "b")` 都可用；零实参 → ""。
    // n ≥ 2 走原生 `__str_join`：一次分配完成交错 + 拼接。
    public static string Join(string separator, params string[] values) {
        int n = values.Length;
        if (n == 0) return "";
        if (n == 1) return values[0];
        return String._joinRaw(separator, values);
    }

    // 原生交错 + 拼接，一次分配。
    [Native("__str_join")] static extern string _joinRaw(string separator, string[] values);

    /// 无分隔符逐段拼接；零实参 → ""。
    // `+` 编译为 IR `StrConcatInstr` 指令；n>2 走一次 ConcatParts（避免左折叠 O(n²) 拷贝）。
    public static string Concat(params string[] values) {
        int n = values.Length;
        if (n == 0) return "";
        if (n == 1) return values[0];
        if (n == 2) return values[0] + values[1];
        return String.ConcatParts(values, n);
    }

    /// 把 `{0}` / `{1}` … 替换为对应实参的 `Convert.ToString()`。
    // 单遍扫描替换 {n} token（各实参只字符串化一次）；不支持 {0:F2} 等格式说明符，
    // 越界 token 原样保留，替换非递归。
    public static string Format(string format, params object[] args) {
        int argN = args.Length;
        string[] argStr = new string[argN];
        int a = 0;
        while (a < argN) { argStr[a] = Convert.ToString(args[a]); a = a + 1; }
        int flen = format.Length;

        // pass 1: output length
        int total = 0;
        int i = 0;
        while (i < flen) {
            int endJ = String._fmtToken(format, flen, i, argN);
            if (endJ >= 0) {
                int idx = String._fmtIndex(format, i + 1);
                total = total + argStr[idx].Length;
                i = endJ + 1;
            } else {
                total = total + 1;
                i = i + 1;
            }
        }

        // pass 2: fill
        char[] buf = new char[total];
        int pos = 0;
        i = 0;
        while (i < flen) {
            int endJ = String._fmtToken(format, flen, i, argN);
            if (endJ >= 0) {
                string s = argStr[String._fmtIndex(format, i + 1)];
                int sl = s.Length;
                int k = 0;
                while (k < sl) { buf[pos] = s.CharAt(k); pos = pos + 1; k = k + 1; }
                i = endJ + 1;
            } else {
                buf[pos] = format.CharAt(i);
                pos = pos + 1;
                i = i + 1;
            }
        }
        return String.FromChars(buf);
    }

    // 若 format[start] 起是合法的 `{n}` token（n < argN），返回其右括号下标；否则 -1。
    private static int _fmtToken(string format, int flen, int start, int argN) {
        if (format.CharAt(start) != '{') { return -1; }
        int j = start + 1;
        bool hasDigit = false;
        int idx = 0;
        while (j < flen) {
            int dc = (int)format.CharAt(j);
            if (dc >= 48 && dc <= 57) { idx = idx * 10 + (dc - 48); hasDigit = true; j = j + 1; }
            else { break; }
        }
        if (hasDigit && j < flen && format.CharAt(j) == '}' && idx < argN) { return j; }
        return -1;
    }

    // 从 digitStart（已校验的 `{` 之后）解析十进制索引。
    private static int _fmtIndex(string format, int digitStart) {
        int idx = 0;
        int j = digitStart;
        while (true) {
            int dc = (int)format.CharAt(j);
            if (dc >= 48 && dc <= 57) { idx = idx * 10 + (dc - 48); j = j + 1; }
            else { return idx; }
        }
    }
}
