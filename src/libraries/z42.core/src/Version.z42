namespace Std;

/// 点分四段版本号 `major.minor[.build[.revision]]`（C# System.Version 对标）。
///
/// build / revision 可选；未提供时存 -1 且 ToString 省略。按四段依次比较排序
/// （未设置的 -1 排在任意真实 0+ 之前，同 C#）。
public sealed class Version {
    private int _major;
    private int _minor;
    private int _build;
    private int _revision;

    /// 以 major + minor 构造（build / revision 视为未设置）。
    public Version(int major, int minor) {
        Version._checkNonNeg(major);
        Version._checkNonNeg(minor);
        _major = major;
        _minor = minor;
        _build = -1;
        _revision = -1;
    }

    /// 以 major + minor + build 构造（revision 视为未设置）。
    public Version(int major, int minor, int build) {
        Version._checkNonNeg(major);
        Version._checkNonNeg(minor);
        Version._checkNonNeg(build);
        _major = major;
        _minor = minor;
        _build = build;
        _revision = -1;
    }

    /// 以四段全量构造。
    public Version(int major, int minor, int build, int revision) {
        Version._checkNonNeg(major);
        Version._checkNonNeg(minor);
        Version._checkNonNeg(build);
        Version._checkNonNeg(revision);
        _major = major;
        _minor = minor;
        _build = build;
        _revision = revision;
    }

    private static void _checkNonNeg(int v) {
        if (v < 0) {
            throw new ArgumentException("version component must be non-negative, got " + v.ToString());
        }
    }

    // ── 访问器 ────────────────────────────────────────────────────────────────
    // Build / Revision 在未提供该段时返回 -1（BCL 对齐）。

    /// 主版本号。
    public int Major    { get { return _major; } }
    /// 次版本号。
    public int Minor    { get { return _minor; } }
    /// 构建号（未设置时为 -1）。
    public int Build    { get { return _build; } }
    /// 修订号（未设置时为 -1）。
    public int Revision { get { return _revision; } }

    // ── 解析 ──────────────────────────────────────────────────────────────────

    /// 解析 `"major.minor"` / `"major.minor.build"` / `"major.minor.build.revision"`。
    /// 段数不对或某段非整数 / 为负抛 FormatException。
    public static Version Parse(string s) {
        string[] parts = s.Split(".");
        int n = parts.Length;
        if (n < 2 || n > 4) {
            throw new FormatException("Version string has " + n.ToString() + " components (expected 2-4): " + s);
        }
        int major = Version._parseComponent(parts[0], s);
        int minor = Version._parseComponent(parts[1], s);
        if (n == 2) {
            return new Version(major, minor);
        }
        int build = Version._parseComponent(parts[2], s);
        if (n == 3) {
            return new Version(major, minor, build);
        }
        int revision = Version._parseComponent(parts[3], s);
        return new Version(major, minor, build, revision);
    }

    private static int _parseComponent(string part, string whole) {
        int iv;
        if (!Int32.TryParse(part, ref iv)) {
            throw new FormatException("Version component is not an integer: '" + part + "' in " + whole);
        }
        if (iv < 0) {
            throw new FormatException("Version component is negative: '" + part + "' in " + whole);
        }
        return iv;
    }

    /// 不抛异常的解析：成功返回 Version，任何非法输入返回 null。
    public static Version? TryParse(string s) {
        try {
            return Version.Parse(s);
        } catch (Exception e) {
            return null;
        }
    }

    // ── 比较 ──────────────────────────────────────────────────────────────────

    /// 按 (major, minor, build, revision) 字典序比较，返回 -1 / 0 / 1。
    public int CompareTo(Version other) {
        if (_major != other.Major)       { return Version._cmpInt(_major, other.Major); }
        if (_minor != other.Minor)       { return Version._cmpInt(_minor, other.Minor); }
        if (_build != other.Build)       { return Version._cmpInt(_build, other.Build); }
        if (_revision != other.Revision) { return Version._cmpInt(_revision, other.Revision); }
        return 0;
    }

    private static int _cmpInt(int a, int b) {
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        return 0;
    }

    /// 四段全等比较。
    public bool Equals(Version other) {
        return _major == other.Major
            && _minor == other.Minor
            && _build == other.Build
            && _revision == other.Revision;
    }

    /// 内容哈希码。
    public int GetHashCode() {
        int h = _major;
        h = h * 31 + _minor;
        h = h * 31 + _build;
        h = h * 31 + _revision;
        return h;
    }

    // ── 格式化 ────────────────────────────────────────────────────────────────

    /// `"major.minor[.build[.revision]]"` —— 未设置的尾部段（-1）省略。
    public override string ToString() {
        string s = _major.ToString() + "." + _minor.ToString();
        if (_build >= 0) {
            s = s + "." + _build.ToString();
            if (_revision >= 0) {
                s = s + "." + _revision.ToString();
            }
        }
        return s;
    }
}
