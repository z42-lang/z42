namespace Std;

// ── 测试框架异常类型 ─────────────────────────────────────────────────────────
//
// 这两个异常类型让 z42-test-runner 在 catch 边界上区分测试结果：
//   - `TestFailure` —— `Std.Assert.*` 失败时抛；runner 标记 Failed，附 actual/expected 诊断。
//   - `SkipSignal` —— `Assert.Skip(reason)` 抛（运行时跳过，与 [Skip(...)] 编译时跳过互补）；
//     runner 标记 Skipped。
//   - 任意其他 Std.Exception 子类型 → runner 标记 Failed，提示为未预期错误。
//
// runner 按 `ex.GetType().FullName` 分类（`Std.TestFailure` / `Std.SkipSignal`），与打包在
// 哪个 zpkg 无关。

/// 断言失败的异常：`Std.Assert.*` 失败时抛。runner 据其区分「故意失败」与意外错误。
public class TestFailure : Exception {
    /// 失败的实际值（字符串化）。空字符串表示无值（如 `Assert.Fail("...")`）。
    public string Actual;
    /// 期望的值（字符串化）。空字符串表示纯断言（如 `Assert.True` 失败）。
    public string Expected;
    /// 失败位置（file:line），由 Assert 内部填入；当前留空。
    public string Location;

    /// 仅 message 的构造（适用于显式 `Assert.Fail`）。
    public TestFailure(string message) : base(message) {
        this.Actual   = "";
        this.Expected = "";
        this.Location = "";
    }

    /// 带 actual/expected 的构造（适用于比较类断言）。
    public TestFailure(string message, string actual, string expected) : base(message) {
        this.Actual   = actual;
        this.Expected = expected;
        this.Location = "";
    }

    /// 带 expected/actual 的可读失败串。
    override string ToString() {
        if (this.Expected != "") {
            return $"TestFailure: {this.Message} (expected {this.Expected}, actual {this.Actual})";
        }
        return $"TestFailure: {this.Message}";
    }
}

/// 运行期跳过的信号：`Assert.Skip(reason)` 抛。runner 据其标记 Skipped。
public class SkipSignal : Exception {
    /// 跳过原因（必须非空字符串）。
    public string Reason;

    /// 以跳过原因构造。
    public SkipSignal(string reason) : base(reason) {
        this.Reason = reason;
    }

    /// 带原因的跳过串。
    override string ToString() {
        return $"SkipSignal: {this.Reason}";
    }
}
