//! 核心类型与预导入工具。
//!
//! Std 命名空间随每个脚本隐式可用（隐式 prelude）：根目录的 String / Math / Array /
//! Convert / Guid / Version / Object / Type 等核心类型，以及子目录的 Primitives
//! （Int32 / Double 等）、Delegates（Func / Action 等）、Protocols（IComparable 等）。
//! String 的索引与长度按 Unicode 标量（char）计；数值与位运算走 Math / BitConverter；
//! 反射走 Type / Enum；平台与运行时能力查询走 Platform / OperatingSystem。
//!
//! 一部分成员是 VM 内建 extern intrinsic（标 `[Native]`，如 String.Length / Math.Sqrt /
//! Platform.OS），其余是纯 z42 脚本（如 String.Contains / Math.Abs / Array.Sort）。
//! 本命名空间没有统一的不支持列表；各类型的边界见其成员注释与 stdlib 文档页。
namespace Std;

// String 类分为三个 partial 碎片（本文件 + String.Split.z42 + String.Edit.z42），
// 以守住单文件行数上限。
//
// ⚠️ 碎片归属规则：**同名方法组必须整组落在同一碎片**。方法注册键的 primary 判定是
// 每-碎片的局部状态——「声明序首个同名 → 裸键，其余 → 全签名键」里的「首个」只在
// 本碎片内计数。同名方法分处两碎片时，两边都认为自己是首个而取同一个裸键，后合并者
// 会静默覆盖前者（签名不同，不触发重载冲突），调用方随之派发到错误重载。
// 故 IndexOf×2 / LastIndexOf×2 / Trim×3 / TrimStart×3 / TrimEnd×3 / Substring×2 /
// Equals×2 全在本碎片；Split×3 全在 String.Split.z42；Remove×2 / PadLeft×2 /
// PadRight×2 全在 String.Edit.z42。
//
// 另一条纪律：**新重载必须追加在同名既有重载之后**——primary（= 裸键 = seed 与跨包既有
// 调用的锚点）取声明序首个，插到前面会让 primary 易主、把既有裸键挪走。

/// 内置 `string` 类型的包装类：写 `string s` 声明的值，方法都派发到这里。
///
/// 不可变；索引与长度按 Unicode 标量（`char`）计（字节数用 `ByteLength`）；越界与
/// 非法实参抛可 catch 的 `Std.Exception`。sealed partial，实现 `IComparable` /
/// `IEquatable`。
public sealed partial class String : IComparable, IEquatable {
    // ── Intrinsic core (extern) ──────────────────────────────────────────────

    /// 字符数（Unicode 标量个数），O(n)。需要 O(1) 的字节尺寸用 ByteLength。
    [Native("__str_length")]      public extern int Length     { get; }

    /// UTF-8 字节数，O(1)。
    ///
    /// 非 ASCII 串与 Length 不同（`"你好".Length == 2`，`"你好".ByteLength == 6`）。
    /// 热路径尺寸查询用本属性。
    [Native("__str_byte_length")] public extern int ByteLength { get; }

    /// 第 `index` 个字符（`s[index]` 同）。越界（含负数）抛 IndexOutOfRangeException。
    [Native("__str_char_at")]   public extern char CharAt(int index);

    /// 索引器：等价于 `CharAt(index)`。`foreach (char c in s)` 也经此迭代。
    public char this[int index] { get { return this.CharAt(index); } }

    /// 由 `char[]` 建串。空数组 → 空串。
    [Native("__str_from_chars")] public static extern string FromChars(char[] chars);

    // ── Object 协议覆盖 ───────────────────────────────────────────────────────

    /// 返回自身。
    public string ToString() { return this; }

    /// 值相等比较。
    [Native("__str_equals")]    public extern bool   Equals(object? other);
    /// 值相等比较。
    [Native("__str_equals")]    public extern bool   Equals(string other);
    /// 序数比较，返回负 / 0 / 正。
    [Native("__str_compare_to")] public extern int   CompareTo(string other);
    /// 内容哈希码。
    [Native("__str_hash_code")] public extern int    GetHashCode();

    // ── 脚本侧方法（经 CharAt 循环实现）────────────────────────────────────────

    /// `Length == 0`。
    // 注：当前 auto-property 仅支持 `{ get; [set;] }` 形式（无 body），自定义 body 的
    // property 尚未支持，故按方法形式暴露。
    public bool IsEmpty() {
        return this.Length == 0;
    }

    /// `value` 是否出现在本串中（等价 `IndexOf(value) >= 0`）。
    public bool Contains(string value) {
        return this.IndexOf(value) >= 0;
    }

    /// 是否以 `prefix` 开头。空前缀恒 true。
    public bool StartsWith(string prefix) {
        int pn = prefix.Length;
        if (pn == 0) return true;
        if (pn > this.Length) return false;
        for (int i = 0; i < pn; i++) {
            if (this.CharAt(i) != prefix.CharAt(i)) return false;
        }
        return true;
    }

    /// 是否以 `suffix` 结尾。空后缀恒 true。
    public bool EndsWith(string suffix) {
        int sn = suffix.Length;
        int tn = this.Length;
        if (sn == 0) return true;
        if (sn > tn) return false;
        int offset = tn - sn;
        for (int i = 0; i < sn; i++) {
            if (this.CharAt(offset + i) != suffix.CharAt(i)) return false;
        }
        return true;
    }

    /// `value` 首次出现的索引（标量单位），未命中 -1；`IndexOf("")` → 0。
    // 实现：物化整串 char[] 后朴素 O(n·m) 两指针扫描，ArrayGet 取字符比逐字符
    // CharAt（builtin 派发）快。
    public int IndexOf(string value) {
        char[] h = this.ToCharArray();
        char[] n = value.ToCharArray();
        int tn = h.Length;
        int vn = n.Length;
        if (vn == 0) return 0;
        if (vn > tn) return -1;
        int limit = tn - vn;
        for (int i = 0; i <= limit; i++) {
            bool match = true;
            for (int j = 0; j < vn; j++) {
                if (h[i + j] != n[j]) { match = false; break; }
            }
            if (match) return i;
        }
        return -1;
    }

    /// `value` 首次出现的索引，未命中 -1。
    public int IndexOf(char value) {
        char[] h = this.ToCharArray();
        int n = h.Length;
        for (int i = 0; i < n; i++) {
            if (h[i] == value) return i;
        }
        return -1;
    }

    /// `value` 最后一次出现的索引（标量单位），未命中 -1；`LastIndexOf("")` → Length。
    public int LastIndexOf(string value) {
        char[] h = this.ToCharArray();
        char[] n = value.ToCharArray();
        int tn = h.Length;
        int vn = n.Length;
        if (vn == 0) return tn;
        if (vn > tn) return -1;
        for (int i = tn - vn; i >= 0; i--) {
            bool match = true;
            for (int j = 0; j < vn; j++) {
                if (h[i + j] != n[j]) { match = false; break; }
            }
            if (match) return i;
        }
        return -1;
    }

    /// `value` 最后一次出现的索引，未命中 -1。
    public int LastIndexOf(char value) {
        char[] h = this.ToCharArray();
        for (int i = h.Length - 1; i >= 0; i--) {
            if (h[i] == value) return i;
        }
        return -1;
    }

    /// 替换全部出现的 `oldValue` 为 `newValue`。`oldValue` 为空串抛异常。
    public string Replace(string oldValue, string newValue) {
        if (oldValue.Length == 0) {
            throw new Exception("Replace: oldValue cannot be empty");
        }
        // 一次物化 char[]，在 ArrayGet 视图上两遍扫描（先计数后构建），分摊物化开销。
        char[] t = this.ToCharArray();
        char[] o = oldValue.ToCharArray();
        char[] nw = newValue.ToCharArray();
        int tn = t.Length;
        int on = o.Length;
        int nn = nw.Length;
        // 第一遍：数匹配数算结果长度（core 无 List<T>，不能边扫边追加）。
        int matches = 0;
        int i = 0;
        while (i <= tn - on) {
            bool hit = true;
            for (int j = 0; j < on; j++) {
                if (t[i + j] != o[j]) { hit = false; break; }
            }
            if (hit) { matches = matches + 1; i = i + on; }
            else     { i = i + 1; }
        }
        int resultLen = tn + matches * (nn - on);
        char[] result = new char[resultLen];
        // 第二遍：命中则替换，否则原样拷贝。
        int r = 0;
        int k = 0;
        while (k < tn) {
            bool hit = false;
            if (k <= tn - on) {
                hit = true;
                for (int j = 0; j < on; j++) {
                    if (t[k + j] != o[j]) { hit = false; break; }
                }
            }
            if (hit) {
                for (int j = 0; j < nn; j++) { result[r] = nw[j]; r = r + 1; }
                k = k + on;
            } else {
                result[r] = t[k];
                r = r + 1;
                k = k + 1;
            }
        }
        return String.FromChars(result);
    }

    /// 截取 `[start, Length)`。
    public string Substring(int start) {
        return this.Substring(start, this.Length - start);
    }

    /// 截取 `[start, start+length)`；`start`/`length` 为负或越界抛异常。
    public string Substring(int start, int length) {
        // 边界检查：负 start/length 或越过末尾原本会 trap（new char[-1] / CharAt 越界），
        // 这里显式抛出可读的异常。
        int n = this.Length;
        if (start < 0 || length < 0 || start > n - length) {
            throw new Exception($"Substring: out of range (start={start}, length={length}, Length={n})");
        }
        if (length == 0) return "";
        return this._substringRaw(start, length);
    }

    /// ASCII 小写转换，非 ASCII 字母原样保留。
    public string ToLower() {
        int n = this.Length;
        char[] result = new char[n];
        for (int i = 0; i < n; i++) {
            result[i] = this.CharAt(i).ToLower();
        }
        return String.FromChars(result);
    }

    /// ASCII 大写转换，非 ASCII 字母原样保留。
    public string ToUpper() {
        int n = this.Length;
        char[] result = new char[n];
        for (int i = 0; i < n; i++) {
            result[i] = this.CharAt(i).ToUpper();
        }
        return String.FromChars(result);
    }

    /// 物化成 `char[]`；空串 → 空数组。
    // 一次性 bulk native 原语：一次调用收集整串 char[]，取代逐字符 CharAt（N 次 builtin
    // 派发）。这是让 IndexOf 等算法在脚本里走 arr[i]（ArrayGet）的数组视图原语。
    [Native("__str_to_chars")] public extern char[] ToCharArray();

    // Substring 的原生 bulk 路径：UTF-8 上一次 slice 拷贝；越界由 Rust 侧 bail，
    // 脚本侧 Substring 先做同样的边界检查以保留原诊断文案。
    [Native("__str_substring")] extern string _substringRaw(int start, int length);

    /// 把 `parts[0..count)` 一次拼接；`count` 越界或元素非 string 由 VM 报错。
    [Native("__str_concat_parts")] public static extern string ConcatParts(string[] parts, int count);

    /// 裁掉首尾空白。
    public string Trim() {
        int n = this.Length;
        int s = 0;
        while (s < n && this.CharAt(s).IsWhiteSpace()) { s = s + 1; }
        if (s == n) return "";
        int e = n - 1;
        while (e > s && this.CharAt(e).IsWhiteSpace()) { e = e - 1; }
        return this.Substring(s, e - s + 1);
    }

    /// 裁掉前导空白。
    public string TrimStart() {
        int n = this.Length;
        int s = 0;
        while (s < n && this.CharAt(s).IsWhiteSpace()) { s = s + 1; }
        return this.Substring(s, n - s);
    }

    /// 裁掉尾随空白。
    public string TrimEnd() {
        int n = this.Length;
        if (n == 0) return "";
        int e = n - 1;
        while (e >= 0 && this.CharAt(e).IsWhiteSpace()) { e = e - 1; }
        return this.Substring(0, e + 1);
    }

    // ── Trim 家族的 char / char[] 重载 ───────────────────────────────────────
    // 三组同名重载（Trim / TrimStart / TrimEnd）必须与上面的无参版同碎片，且追加在其后——
    // 无参版是 primary（裸键，seed 锚点），char / char[] 版取全签名键。

    // 判断字符是否在集合中。集合都很小（典型 1–4 个字符），线性扫描比建哈希集便宜；
    // 且 core 不能依赖 z42.collections（后者依赖前者）。
    private static bool _inSet(char[] set, char c) {
        int n = set.Length;
        for (int i = 0; i < n; i++) {
            if (set[i] == c) return true;
        }
        return false;
    }

    /// 裁掉首尾 `trimChar`。
    public string Trim(char trimChar) {
        char[] set = new char[1];
        set[0] = trimChar;
        return this.Trim(set);
    }

    /// 裁掉首尾 `trimChars` 中任一字符；空数组按空白裁。
    public string Trim(char[] trimChars) {
        if (trimChars.Length == 0) return this.Trim();
        char[] t = this.ToCharArray();
        int n = t.Length;
        int s = 0;
        while (s < n && String._inSet(trimChars, t[s])) { s = s + 1; }
        if (s == n) return "";
        int e = n - 1;
        while (e > s && String._inSet(trimChars, t[e])) { e = e - 1; }
        return this.Substring(s, e - s + 1);
    }

    /// 裁掉前导 `trimChar`。
    public string TrimStart(char trimChar) {
        char[] set = new char[1];
        set[0] = trimChar;
        return this.TrimStart(set);
    }

    /// 裁掉前导 `trimChars` 中任一字符；空数组按空白裁。
    public string TrimStart(char[] trimChars) {
        if (trimChars.Length == 0) return this.TrimStart();
        char[] t = this.ToCharArray();
        int n = t.Length;
        int s = 0;
        while (s < n && String._inSet(trimChars, t[s])) { s = s + 1; }
        return this.Substring(s, n - s);
    }

    /// 裁掉尾随 `trimChar`。
    public string TrimEnd(char trimChar) {
        char[] set = new char[1];
        set[0] = trimChar;
        return this.TrimEnd(set);
    }

    /// 裁掉尾随 `trimChars` 中任一字符；空数组按空白裁。
    public string TrimEnd(char[] trimChars) {
        if (trimChars.Length == 0) return this.TrimEnd();
        char[] t = this.ToCharArray();
        int n = t.Length;
        if (n == 0) return "";
        int e = n - 1;
        while (e >= 0 && String._inSet(trimChars, t[e])) { e = e - 1; }
        return this.Substring(0, e + 1);
    }

    // ── 静态辅助（脚本侧）────────────────────────────────────────────────────

    /// `value` 为 null 或空串时为 true。
    public static bool IsNullOrEmpty(string? value) {
        return value == null || value.Length == 0;
    }

    /// `value` 为 null 或全空白时为 true。
    public static bool IsNullOrWhiteSpace(string? value) {
        if (value == null) return true;
        int n = value.Length;
        for (int i = 0; i < n; i++) {
            if (!value.CharAt(i).IsWhiteSpace()) return false;
        }
        return true;
    }
}
