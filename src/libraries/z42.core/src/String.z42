namespace Std;

// String class — wraps the built-in `string` primitive type.
//
// Minimal intrinsic core (extern): Length / CharAt / FromChars / Equals /
// CompareTo / GetHashCode / ToString / Split / Join / Concat / Format.
// All other methods (Contains / StartsWith / EndsWith / IndexOf / Replace /
// Substring / ToLower / ToUpper / Trim* / IsNullOr*) are pure z42 scripts
// that loop via CharAt + primitive char operations, mirroring the C# BCL
// pattern where `string.Length` and `string[i]` are intrinsics and the rest
// is managed code.
//
// 2026-04-24 simplify-string-stdlib: migrated 11 methods from Rust builtins to
// scripts. Index / length / slice semantics uniformly use Unicode scalar (char)
// count — no UTF-8 byte offsets exposed.
// fix-static-class-instance-members (2026-09-01): 曾误标 `static class`——但 String
// 是 primitive `string` 的包装，`s.Length` / `s.Contains(...)` 皆为实例调用，且实现
// IComparable/IEquatable（实例契约）。`static` 与实例成员/接口矛盾（旧 z42c 静默忽略
// class 上的 `static`）。对齐 C# `sealed class System.String`：sealed（禁继承 + 去虚化）。
//
// augment-string-prelude (2026-09-04)：声明 `partial`，把 Split/Join/Concat/Format 移到碎片
// `String.Split.z42`，为补齐 char-based BCL 方法腾出行数（补齐后核心文件会超 500 行硬限）。
//
// ⚠️ 碎片归属规则：**同名方法组必须整组落在同一碎片**。方法注册键的 primary 判定
// （MemberCollector 的 `emittedInst`，见 stabilize-instance-dispatch-keys）是**每-碎片**
// 的局部状态——「声明序首个同名 → 裸键，其余 → 全签名键」里的「首个」只在本碎片内计数。
// 同名方法分处两碎片时，两边都认为自己是首个而取同一个裸键，后合并者在 `ct.Methods` 里
// **静默覆盖**前者（签名不同，不触发 E0433），调用方随之派发到错误重载。
// 故：`Substring`×2 / `Equals`×2 留在本碎片，`Split`×2 整组移到 String.Split.z42。
// （该限制是 partial v1 的 Deferred 项，见 language/partial-types.md。）
public sealed partial class String : IComparable<string>, IEquatable<string> {
    // ── Intrinsic core (extern) ──────────────────────────────────────────────

    // Number of Unicode scalar values (characters) in this string. O(n) —
    // walks UTF-8 bytes. Use `ByteLength` when you need O(1) and byte
    // semantics suffice. review.md C11.1 (2026-05-27).
    [Native("__str_length")]      public extern int Length     { get; }

    // Number of UTF-8 bytes in this string. O(1). Differs from `Length`
    // for non-ASCII strings (`"你好".Length == 2`, `"你好".ByteLength == 6`).
    // Pick `ByteLength` for hot-path size queries (allocation sizing,
    // network framing, hashing); pick `Length` when the count must match
    // user-visible character grouping.
    [Native("__str_byte_length")] public extern int ByteLength { get; }

    // Returns the char at the given scalar index. Traps on out-of-range.
    [Native("__str_char_at")]   public extern char CharAt(int index);

    // Builds a string from a char[] array. Empty array → empty string.
    [Native("__str_from_chars")] public static extern string FromChars(char[] chars);

    // ── Object protocol overrides ────────────────────────────────────────────

    // shrink-primitive-native-interop (2026-08-27): ToString 迁纯脚本 —— 旧
    // __str_to_string 只是原样返回自身（`s.to_owned()`）。Equals(object?) 保留
    // [Native]：__str_equals 是类型宽容的（处理 null / 非 string 装箱值），纯脚本
    // 表达不划算。
    public string ToString() { return this; }
    [Native("__str_equals")]    public extern bool   Equals(object? other);
    [Native("__str_equals")]    public extern bool   Equals(string other);
    [Native("__str_compare_to")] public extern int   CompareTo(string other);
    [Native("__str_hash_code")] public extern int    GetHashCode();

    // ── Script-side methods (loop via CharAt) ────────────────────────────────

    // True when the string contains no characters.
    // Note: 当前 z42 auto-property 仅支持 `{ get; [set;] }` 形式（无 body）。
    // 自定义 body property 推迟，按方法形式 surface。
    public bool IsEmpty() {
        return this.Length == 0;
    }

    // True iff `value` occurs anywhere in `this`.
    public bool Contains(string value) {
        return this.IndexOf(value) >= 0;
    }

    // True iff `this` starts with `prefix`. Empty prefix → always true.
    public bool StartsWith(string prefix) {
        int pn = prefix.Length;
        if (pn == 0) return true;
        if (pn > this.Length) return false;
        for (int i = 0; i < pn; i++) {
            if (this.CharAt(i) != prefix.CharAt(i)) return false;
        }
        return true;
    }

    // True iff `this` ends with `suffix`. Empty suffix → always true.
    public bool EndsWith(string suffix) {
        int sn = suffix.Length;
        int tn = this.Length;
        if (sn == 0) return true;
        if (sn > tn) return false;
        int offset = tn - sn;
        for (int i = 0; i < sn; i++) {
            if (this.CharAt(offset + i) != suffix.CharAt(i)) return false;
        }
        return true;
    }

    // First index of `value` (scalar units), or -1 if not found.
    // Scalar (char-index) IndexOf. Naive O(n·m) two-pointer scan, but over a
    // bulk-materialised char[] (ToCharArray → one __str_to_chars native call)
    // scanned with the ArrayGet opcode — ~9× faster than the old per-char
    // CharAt(builtin) scan (measured: charAt 2128ms → charArr 237ms, interp).
    // Script-first: one array-view primitive, the algorithm stays in script.
    // Contains = IndexOf >= 0 auto-benefits.
    public int IndexOf(string value) {
        char[] h = this.ToCharArray();
        char[] n = value.ToCharArray();
        int tn = h.Length;
        int vn = n.Length;
        if (vn == 0) return 0;
        if (vn > tn) return -1;
        int limit = tn - vn;
        for (int i = 0; i <= limit; i++) {
            bool match = true;
            for (int j = 0; j < vn; j++) {
                if (h[i + j] != n[j]) { match = false; break; }
            }
            if (match) return i;
        }
        return -1;
    }

    // Replace all occurrences of `oldValue` with `newValue`.
    // Throws Exception when oldValue is empty (aligns with C# ArgumentException).
    public string Replace(string oldValue, string newValue) {
        if (oldValue.Length == 0) {
            throw new Exception("Replace: oldValue cannot be empty");
        }
        // char[]-script: bulk-materialise once, scan/build over ArrayGet (whole-
        // string two-pass scan → materialisation amortised; ~9× vs per-char CharAt).
        char[] t = this.ToCharArray();
        char[] o = oldValue.ToCharArray();
        char[] nw = newValue.ToCharArray();
        int tn = t.Length;
        int on = o.Length;
        int nn = nw.Length;
        // Pass 1: count matches to compute result length (no List<T> available:
        // List<T> lives in z42.collections which depends on z42.core).
        int matches = 0;
        int i = 0;
        while (i <= tn - on) {
            bool hit = true;
            for (int j = 0; j < on; j++) {
                if (t[i + j] != o[j]) { hit = false; break; }
            }
            if (hit) { matches = matches + 1; i = i + on; }
            else     { i = i + 1; }
        }
        int resultLen = tn + matches * (nn - on);
        char[] result = new char[resultLen];
        // Pass 2: copy, substituting on hit.
        int r = 0;
        int k = 0;
        while (k < tn) {
            bool hit = false;
            if (k <= tn - on) {
                hit = true;
                for (int j = 0; j < on; j++) {
                    if (t[k + j] != o[j]) { hit = false; break; }
                }
            }
            if (hit) {
                for (int j = 0; j < nn; j++) { result[r] = nw[j]; r = r + 1; }
                k = k + on;
            } else {
                result[r] = t[k];
                r = r + 1;
                k = k + 1;
            }
        }
        return String.FromChars(result);
    }

    // Substring(start): [start, Length).
    public string Substring(int start) {
        return this.Substring(start, this.Length - start);
    }

    // Substring(start, length): [start, start+length).
    public string Substring(int start, int length) {
        // Bounds check: negative start/length or a range past the end used to
        // trap (new char[-1] / CharAt out of range) instead of reporting cleanly.
        int n = this.Length;
        if (start < 0 || length < 0 || start > n - length) {
            throw new Exception($"Substring: out of range (start={start}, length={length}, Length={n})");
        }
        if (length == 0) return "";
        return this._substringRaw(start, length);
    }

    // ASCII-rule lowercase conversion. Non-ASCII letters are unchanged.
    // Locale-sensitive casing deferred to L3 CultureInfo.
    public string ToLower() {
        int n = this.Length;
        char[] result = new char[n];
        for (int i = 0; i < n; i++) {
            result[i] = this.CharAt(i).ToLower();
        }
        return String.FromChars(result);
    }

    // ASCII-rule uppercase conversion.
    public string ToUpper() {
        int n = this.Length;
        char[] result = new char[n];
        for (int i = 0; i < n; i++) {
            result[i] = this.CharAt(i).ToUpper();
        }
        return String.FromChars(result);
    }

    // add-string-tochararray (review §2.6): inverse of FromChars. Materialise
    // the scalar array once and index it O(1) instead of repeated O(n) CharAt
    // walks. Empty string → empty array.
    //
    // Now a BULK native primitive (__str_to_chars): one call collects the whole
    // char[] in Rust, vs the old per-char CharAt loop (N builtin dispatches).
    // This is THE array-view primitive that lets string algorithms (IndexOf,
    // …) run in script over `arr[i]` (ArrayGet opcode) — the C#/Rust "string
    // ops over a char buffer" model — without a native extern per operation.
    [Native("__str_to_chars")] public extern char[] ToCharArray();

    // perf-stdlib-hot-paths：Substring 的原生 bulk 路径——UTF-8 上一次 slice 拷贝（字符索引经 str_meta 的
    // char→byte 表 O(1)），取代此前逐字符 CharAt + FromChars（每字符一次 builtin 派发 + Vec 分配）。
    // 越界由 Rust 侧 bail；脚本侧 Substring 先做同样的边界检查以保留原诊断文案。
    [Native("__str_substring")] extern string _substringRaw(int start, int length);

    // perf-stdlib-hot-paths：把 parts[0..count) 一次拼接（Rust 侧按字节 memcpy），StringBuilder.ToString /
    // Join 的底座——取代逐字符 CharAt 复制。count 越界 / 元素非 string 由 Rust 侧 bail。
    [Native("__str_concat_parts")] public static extern string ConcatParts(string[] parts, int count);

    // Trim leading + trailing whitespace.
    public string Trim() {
        int n = this.Length;
        int s = 0;
        while (s < n && this.CharAt(s).IsWhiteSpace()) { s = s + 1; }
        if (s == n) return "";
        int e = n - 1;
        while (e > s && this.CharAt(e).IsWhiteSpace()) { e = e - 1; }
        return this.Substring(s, e - s + 1);
    }

    public string TrimStart() {
        int n = this.Length;
        int s = 0;
        while (s < n && this.CharAt(s).IsWhiteSpace()) { s = s + 1; }
        return this.Substring(s, n - s);
    }

    public string TrimEnd() {
        int n = this.Length;
        if (n == 0) return "";
        int e = n - 1;
        while (e >= 0 && this.CharAt(e).IsWhiteSpace()) { e = e - 1; }
        return this.Substring(0, e + 1);
    }

    // ── Static helpers (script-side) ─────────────────────────────────────────

    public static bool IsNullOrEmpty(string? value) {
        return value == null || value.Length == 0;
    }

    public static bool IsNullOrWhiteSpace(string? value) {
        if (value == null) return true;
        int n = value.Length;
        for (int i = 0; i < n; i++) {
            if (!value.CharAt(i).IsWhiteSpace()) return false;
        }
        return true;
    }
}
