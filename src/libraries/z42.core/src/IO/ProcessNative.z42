// 执行基座 native 语义层：子进程 spawn / wait / kill / stdio 原语。
//
// 归属规则见 docs/internals/src/stdlib/organization.md「native 语义层 → core」（2026-08-27）。
// 应用层 Process / ProcessHandle（编排、超时、stdio 流）留 z42.io、调这里的 *Native 原语。
// 命名空间保持 Std.IO 不变。native 实现镜像 src/runtime/src/corelib/process.rs。
//
// 失败一律由 VM 直接抛（.NET 口径）：启动失败 → ProcessStartException（: IOException），
// 超时 → ProcessTimeoutException（: TimeoutException），句柄已失效 → ProcessHandleInvalidException
// （: InvalidOperationException），未重定向的 stdin → InvalidOperationException，
// 管道 I/O 错 → IOException。成功结果数组：[exitCode, stdout, stderr, stdoutBytes, stderrBytes]。
namespace Std.IO;

public static class ProcessNative {
    [Native("__process_run_sync")]
    public static extern object[] RunSync(
        string program,
        string[] args,
        string[] envKeys,
        string[] envVals,
        string[] envRemove,
        bool envClear,
        string? cwd,
        int stdinMode,
        byte[]? stdinBytes,
        int stdoutMode,
        string? stdoutPath,
        int stderrMode,
        string? stderrPath,
        long timeoutMs,
        bool ownProcessGroup);   // false → child stays in caller's process group（交互式 tty 透传，见 Process.ShareProcessGroup）

    // 返回句柄槽号。
    [Native("__process_start")]
    public static extern long Start(
        string program,
        string[] args,
        string[] envKeys,
        string[] envVals,
        string[] envRemove,
        bool envClear,
        string? cwd,
        int stdinMode,
        int stdoutMode,
        string? stdoutPath,
        int stderrMode,
        string? stderrPath);

    [Native("__process_which")]
    public static extern string? Which(string name);

    // ── 种子兼容（返回 [KIND, …] 判别数组，由调用方翻成异常）──────────────────
    // STAGE2-DEBT(legacy-process-decls): 种子的 z42.io 不再调 ProcessNative.Run / Spawn 与 ProcessHandleNative 后删掉这两组声明（连同 VM 的 corelib/process_legacy.rs）。
    // 已发布种子的 z42.io 仍调这些；z42.core 总是按当前源预建，与种子的 z42.io 同处一个 libs 目录。

    [Native("__process_run")]
    public static extern object[] Run(
        string program,
        string[] args,
        string[] envKeys,
        string[] envVals,
        string[] envRemove,
        bool envClear,
        string? cwd,
        int stdinMode,
        byte[]? stdinBytes,
        int stdoutMode,
        string? stdoutPath,
        int stderrMode,
        string? stderrPath,
        long timeoutMs,
        bool ownProcessGroup);

    [Native("__process_spawn")]
    public static extern object[] Spawn(
        string program,
        string[] args,
        string[] envKeys,
        string[] envVals,
        string[] envRemove,
        bool envClear,
        string? cwd,
        int stdinMode,
        byte[]? stdinBytes,
        int stdoutMode,
        string? stdoutPath,
        int stderrMode,
        string? stderrPath);
}

// `Spawn()` 出来的子进程句柄（槽号）上的操作。
public static class ChildProcessNative {
    // 消耗句柄（之后再用即 ProcessHandleInvalidException）。
    [Native("__process_wait")]
    public static extern object[] Wait(long slotId);

    // 还在跑 → null；已退出 → 结果数组（并消耗句柄）。
    [Native("__process_try_wait")]
    public static extern object TryWait(long slotId);

    [Native("__process_kill")]
    public static extern void Kill(long slotId, bool force);

    [Native("__process_stdin_write")]
    public static extern void WriteStdin(long slotId, byte[] bytes);

    [Native("__process_stdin_close")]
    public static extern void CloseStdin(long slotId);

    [Native("__process_pid")]
    public static extern long Pid(long slotId);

    // 幂等；子进程仍活着时 kill + reap。
    [Native("__process_close")]
    public static extern void Close(long slotId);

    // 流式读管道（0 = EOF）。
    [Native("__process_stdout_read")]
    public static extern int ReadStdout(long slotId, byte[] buffer, int offset, int count);

    [Native("__process_stderr_read")]
    public static extern int ReadStderr(long slotId, byte[] buffer, int offset, int count);
}

// 种子兼容（见上方 legacy-process-decls 欠账）。
public static class ProcessHandleNative {
    [Native("__process_handle_wait")]
    public static extern object[] Wait(long slotId);

    [Native("__process_handle_try_wait")]
    public static extern object TryWait(long slotId);

    [Native("__process_handle_kill")]
    public static extern object Kill(long slotId, bool force);

    [Native("__process_handle_write_stdin")]
    public static extern object WriteStdin(long slotId, byte[] bytes);

    [Native("__process_handle_close_stdin")]
    public static extern object CloseStdin(long slotId);

    [Native("__process_handle_pid")]
    public static extern object Pid(long slotId);

    [Native("__process_handle_drop")]
    public static extern object Drop(long slotId);

    // add-process-stream-stdio (2026-05-24): streaming pipe reads.
    [Native("__process_handle_read_stdout")]
    public static extern object ReadStdout(long slotId, byte[] buffer, int offset, int count);

    [Native("__process_handle_read_stderr")]
    public static extern object ReadStderr(long slotId, byte[] buffer, int offset, int count);
}
