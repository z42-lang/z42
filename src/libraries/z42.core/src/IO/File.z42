namespace Std.IO;

using Std.Time;

/// 一次性（whole-file）文件操作；需要按块读写时用 z42.io 的 `FileStream`。
///
/// 失败按 .NET 口径抛（都是 `IOException` 或 `Exception` 的子类）：文件不存在 →
/// `FileNotFoundException`；目录（路径的一部分）不存在 → `DirectoryNotFoundException`；
/// 无权限 / 把目录当文件读写 → `UnauthorizedAccessException`；路径过长 → `PathTooLongException`；
/// 其它 OS 错 → `IOException`（消息带路径）；null 实参 → `ArgumentNullException`；空路径 →
/// `ArgumentException`。与 .NET 的出入：`Delete` 删不存在的文件抛 `FileNotFoundException`
/// （.NET 静默）；`Copy` / `Move` 覆盖已存在的目标（.NET 两参版本抛 `IOException`）。
public static class File {
    /// 整读为 `string`（严格 UTF-8）。
    [Native("__file_read_text")]
    public static extern string ReadAllText(string path);

    /// 覆盖写；文件不存在则创建。
    [Native("__file_write_text")]
    public static extern void WriteAllText(string path, string content);

    /// 追加写；文件不存在则创建。
    [Native("__file_append_text")]
    public static extern void AppendAllText(string path, string content);

    /// 一次性读取整个文件为 byte 数组。
    [Native("__file_read_bytes")]
    public static extern byte[] ReadAllBytes(string path);

    /// 一次性写入 byte 数组到文件（已存在则覆盖；不存在则创建）。
    [Native("__file_write_bytes")]
    public static extern void WriteAllBytes(string path, byte[] data);

    /// 原子写文本 —— 崩溃安全：外部观察到的是旧内容或新内容，不会是半截。
    // 实现：先写同目录 tmp 文件，fsync 落盘后 rename 覆盖。比普通写慢（多一次 fsync），
    // 仅关键配置文件使用。
    [Native("__file_write_text_atomic")]
    public static extern void WriteAllTextAtomic(string path, string content);

    /// 原子写 byte 数组 —— 同 `WriteAllTextAtomic` 但二进制 payload。
    [Native("__file_write_bytes_atomic")]
    public static extern void WriteAllBytesAtomic(string path, byte[] data);

    /// 路径上是否有东西（目录也返回 true）。
    [Native("__file_exists")]
    public static extern bool Exists(string path);

    /// 删文件；不存在抛 `FileNotFoundException`。
    [Native("__file_delete")]
    public static extern void Delete(string path);

    /// 拷贝文件；dst 已存在时覆盖。
    [Native("__file_copy")]
    public static extern void Copy(string src, string dst);

    /// 移动文件；dst 已存在时覆盖。
    [Native("__file_move")]
    public static extern void Move(string src, string dst);

    /// 文件最后修改时间（mtime），包装成 `Std.Time.DateTime`。
    ///
    /// 比较用 `IsAfter` / `IsBefore` / `UnixMs()`。文件不存在抛
    /// `FileNotFoundException`。
    public static DateTime GetLastWriteTime(string path) {
        return DateTime.FromUnixMs(LastWriteTimeMs(path));
    }

    [Native("__file_last_write_time_ms")]
    private static extern long LastWriteTimeMs(string path);

    // 在 system temp root（mac /var/folders、linux /tmp、win %TEMP%）创建，命名含
    // nanos + pid + counter 避免并发冲突。**无 RAII / finalizer，调用方自己清理**
    // （`File.Delete` / `Directory.Delete(path, true)`）。

    /// 创建唯一临时目录，返回全路径（`<sysTemp>/prefix.<nanos>.<pid>.<bump>`）。
    [Native("__file_create_temp_dir")]
    public static extern string CreateTempDir(string prefix);

    /// 创建唯一空临时文件，返回全路径。
    ///
    /// 路径形如 `<sysTemp>/prefix.<nanos>.<pid>.<bump><suffix>`；suffix 可为 ""
    /// （无扩展名）。
    [Native("__file_create_temp_file")]
    public static extern string CreateTempFile(string prefix, string suffix);

    /// Unix: `chmod u+x,g+x,o+x`；Windows: no-op（NTFS 由扩展名决定）。
    [Native("__file_make_executable")]
    public static extern void MakeExecutable(string path);

    /// 创建 hard link `dst → src`（跨设备 OS 错误透传）。
    [Native("__file_link")]
    public static extern void Link(string src, string dst);

    /// 创建 symbolic link `dst → src`（Windows 暂未支持）。
    [Native("__file_symlink")]
    public static extern void SymLink(string src, string dst);

    /// 文件字节数（path 是 directory 时抛错）。
    [Native("__file_get_size")]
    public static extern long GetSize(string path);
}
