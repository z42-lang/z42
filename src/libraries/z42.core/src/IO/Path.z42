namespace Std.IO;

// 实现笔记：纯字符串操作，不碰文件系统。内部统一用 `/`；`IsRooted` / `Join` 额外识别
// Windows 根（盘符 `X:\`/`X:/` 与反斜杠），否则 rooted 检测漏判会被二次拼接成
// `…/D:\…`（中间 `:`）→ 原生 create_dir 报 error 123。

/// 纯字符串的路径拼接与解析（`/` 分隔）。不解析符号链接、不要求路径存在。
public static class Path {
    /// 平台分隔符常量（恒为 '/'，对应 BCL `Path.DirectorySeparatorChar`）。
    public static char Separator = '/';

    /// 是否为绝对路径：Unix `/` 开头，或 Windows 根（盘符 `X:\`/`X:/`/`X:` 与 `\` 开头）。
    public static bool IsRooted(string path) {
        if (path.Length == 0) { return false; }
        char c0 = path.CharAt(0);
        if (c0 == '/' || c0 == '\\') { return true; }
        // Windows 盘符根：字母 + ':'（C:\、D:/、E:foo）
        if (path.Length >= 2 && path.CharAt(1) == ':'
            && ((c0 >= 'A' && c0 <= 'Z') || (c0 >= 'a' && c0 <= 'z'))) {
            return true;
        }
        return false;
    }

    [Suppress("style.fnLinesHard", "207 body lines；拆分见 code-organization.md")]
    /// 词法规范化路径，不碰文件系统。
    ///
    /// 折叠重复分隔符、去掉 `.` 段、抵消 `..` 段、去掉尾随 `/`，并把 `\` 统一换成
    /// `/`（不解析符号链接、不要求路径存在）。越过根的 `..` 在根处停住；相对路径开头
    /// 保留不了的 `..` 原样保留；结果为空时返回 `.`（相对）或 `/`（绝对）。
    public static string Normalize(string path) {
        if (path.Length == 0) { return "."; }
        string s = path.Replace("\\", "/");
        bool rooted = s.CharAt(0) == '/';
        // Windows 盘符根（`C:/...`）：前缀原样保留，只规范化其后的部分。
        string prefix = "";
        if (!rooted && s.Length >= 2 && s.CharAt(1) == ':') {
            prefix = s.Substring(0, 2);
            s = s.Substring(2, s.Length - 2);
            if (s.Length > 0 && s.CharAt(0) == '/') { rooted = true; s = s.Substring(1, s.Length - 1); }
        } else if (rooted) {
            s = s.Substring(1, s.Length - 1);
        }
        string[] segs = s.Split("/");
        string[] keep = new string[segs.Length];
        int n = 0;
        int i = 0;
        while (i < segs.Length) {
            string seg = segs[i];
            if (seg.Length == 0 || seg == ".") { /* 折叠 `//` 与 `.` */ }
            else if (seg == "..") {
                if (n > 0 && keep[n - 1] != "..") { n = n - 1; }        // 抵消上一段
                else if (!rooted) { keep[n] = seg; n = n + 1; }          // 相对路径保留前导 `..`
                // rooted 且无可抵消 → 在根处停住，丢弃
            }
            else { keep[n] = seg; n = n + 1; }
            i = i + 1;
        }
        string body = "";
        int j = 0;
        while (j < n) {
            if (j > 0) { body = body + "/"; }
            body = body + keep[j];
            j = j + 1;
        }
        if (rooted) { return prefix + "/" + body; }
        if (body.Length == 0) { return prefix.Length > 0 ? prefix : "."; }
        return prefix + body;
    }

    /// 拼接两段路径：b 是绝对路径则替换 a；否则用 `/` 分隔（a 已有尾随分隔符时不重复）。
    // 保留 2-arg 重载：热路径 + params 的 normal-form 直传目标（非 params 精确 arity 重载优先）。
    public static string Join(string a, string b) {
        if (b.Length == 0) return a;
        if (Path.IsRooted(b)) return b;
        if (a.Length == 0) return b;
        char last = a.CharAt(a.Length - 1);
        if (last == '/' || last == '\\') return a + b;
        return a + "/" + b;
    }

    /// 多段路径拼接：逐段左折叠复用 2-arg 语义（绝对段替换、尾分隔去重）。
    public static string Join(params string[] parts) {
        if (parts.Length == 0) { return ""; }
        string r = parts[0];
        int i = 1;
        while (i < parts.Length) {
            r = Path.Join(r, parts[i]);
            i = i + 1;
        }
        return r;
    }

    // 目录分隔符判定：`/`（POSIX）与 `\`（Windows）都算——否则 Windows 反斜杠绝对路径
    // 会被当成「无分隔符」，父目录解析失败。
    private static bool _isSep(char c) { return c == '/' || c == '\\'; }

    /// 返回路径最后一段（filename）。末尾分隔符被跳过；路径全是分隔符时返回 ""。
    public static string GetFileName(string path) {
        int n = path.Length;
        if (n == 0) return "";
        int end = n;
        while (end > 0 && Path._isSep(path.CharAt(end - 1))) {
            end = end - 1;
        }
        if (end == 0) return "";
        int start = end;
        while (start > 0 && !Path._isSep(path.CharAt(start - 1))) {
            start = start - 1;
        }
        return Path.Slice(path, start, end);
    }

    /// 返回 filename 中最后一个 `.` 之后的部分（不含 `.`）。`.bashrc` / `foo` / "" → ""。
    public static string GetExtension(string path) {
        string name = Path.GetFileName(path);
        int n = name.Length;
        int dot = -1;
        for (int i = n - 1; i > 0; i = i - 1) {
            if (name.CharAt(i) == '.') {
                dot = i;
                break;
            }
        }
        if (dot < 0) return "";
        return Path.Slice(name, dot + 1, n);
    }

    /// 返回 filename 去除最后扩展名（保留 leading dot 的整体名）。
    public static string GetFileNameWithoutExtension(string path) {
        string name = Path.GetFileName(path);
        int n = name.Length;
        int dot = -1;
        for (int i = n - 1; i > 0; i = i - 1) {
            if (name.CharAt(i) == '.') {
                dot = i;
                break;
            }
        }
        if (dot < 0) return name;
        return Path.Slice(name, 0, dot);
    }

    /// 返回路径父目录。无分隔符时返回 ""；根目录返回其分隔符段。
    public static string GetDirectoryName(string path) {
        int n = path.Length;
        if (n == 0) return "";
        int end = n;
        while (end > 0 && Path._isSep(path.CharAt(end - 1))) {
            end = end - 1;
        }
        if (end == 0) return "";
        int sep = end - 1;
        while (sep >= 0 && !Path._isSep(path.CharAt(sep))) {
            sep = sep - 1;
        }
        if (sep < 0) return "";
        int dirEnd = sep;
        while (dirEnd > 0 && Path._isSep(path.CharAt(dirEnd - 1))) {
            dirEnd = dirEnd - 1;
        }
        if (dirEnd == 0) return "/";
        return Path.Slice(path, 0, dirEnd);
    }

    /// 在 dir 下匹配直接子项（不递归）。pattern 支持 `*`（任意序列）与 `?`（单字符），
    /// 大小写敏感，不应含 `/`。返回排好序的全路径数组。
    [Native("__path_glob")]
    public static extern string[] Glob(string dir, string pattern);

    /// 在 dir 下递归找所有匹配 pattern 的文件，返回绝对路径排序数组。
    ///
    /// pattern 支持 `*`（跨 `/`）与 `?`；不带 `/` 时只匹配 basename，带 `/` 时匹配
    /// 相对 dir 的完整子路径。不支持 `**`。
    public static string[] GlobRecursive(string dir, string pattern) {
        if (!Directory.Exists(dir)) return new string[0];
        string[] rels = Directory.EnumerateRecursive(dir);
        // 第一遍：计数。
        int n = 0;
        bool patternHasSlash = _containsChar(pattern, '/');
        int i = 0;
        while (i < rels.Length) {
            if (_matchesGlob(rels[i], pattern, patternHasSlash)) {
                n = n + 1;
            }
            i = i + 1;
        }
        // 第二遍：收集绝对路径。
        string[] hits = new string[n];
        int j = 0;
        i = 0;
        while (i < rels.Length) {
            if (_matchesGlob(rels[i], pattern, patternHasSlash)) {
                hits[j] = Path.Join(dir, rels[i]);
                j = j + 1;
            }
            i = i + 1;
        }
        // 排序保证确定性（EnumerateRecursive 顺序 OS-dependent）。
        _sortStrings(hits);
        return hits;
    }

    // Glob 匹配：pattern 作用于完整相对路径或仅 basename。
    static bool _matchesGlob(string rel, string pattern, bool patternHasSlash) {
        string target;
        if (patternHasSlash) {
            target = rel;
        } else {
            target = Path.GetFileName(rel);
        }
        return _globMatch(target, 0, pattern, 0);
    }

    // 递归 glob 匹配：`*` 匹配任意序列，`?` 匹配单字符；简单回溯即可，非热路径。
    static bool _globMatch(string s, int si, string p, int pi) {
        while (pi < p.Length) {
            char pc = p.CharAt(pi);
            if (pc == '*') {
                // 跳过连续的 *。
                while (pi < p.Length && p.CharAt(pi) == '*') {
                    pi = pi + 1;
                }
                if (pi == p.Length) return true;  // 尾部 * 匹配任意
                // 尝试 s[si..] 的每个位置作为剩余 pattern 的起点。
                while (si <= s.Length) {
                    if (_globMatch(s, si, p, pi)) return true;
                    si = si + 1;
                }
                return false;
            }
            if (si >= s.Length) return false;
            char sc = s.CharAt(si);
            if (pc == '?') {
                si = si + 1; pi = pi + 1; continue;
            }
            if (pc != sc) return false;
            si = si + 1; pi = pi + 1;
        }
        return si == s.Length;
    }

    static bool _containsChar(string s, char c) {
        int i = 0;
        while (i < s.Length) {
            if (s.CharAt(i) == c) return true;
            i = i + 1;
        }
        return false;
    }

    // 简单插入排序（glob 结果集很小，典型 < 200 条）。
    static void _sortStrings(string[] arr) {
        int i = 1;
        while (i < arr.Length) {
            string key = arr[i];
            int j = i - 1;
            while (j >= 0 && _strLess(key, arr[j])) {
                arr[j + 1] = arr[j];
                j = j - 1;
            }
            arr[j + 1] = key;
            i = i + 1;
        }
    }

    static bool _strLess(string a, string b) {
        return a.CompareTo(b) < 0;
    }

    // 内部 helper：切片 [start, end)。
    static string Slice(string s, int start, int end) {
        int len = end - start;
        char[] chars = new char[len];
        for (int i = 0; i < len; i = i + 1) {
            chars[i] = s.CharAt(start + i);
        }
        return String.FromChars(chars);
    }
}
