namespace Std.IO;

/// 标准输出。所有方法都收 `object`——任何类型都能直接传。
///
/// `Console.WriteLine(42)`、`Console.Write(true)` 等，primitive 在 VM 层自动装箱。
public static class Console {
    /// 写 `value` 并换行。
    [Native("__println")]
    public static extern void WriteLine(object value);

    /// 写 `value`，不换行。
    [Native("__print")]
    public static extern void Write(object value);

    /// 从 stdin 读一行（去掉行尾的 `\n` / `\r`）。EOF 与空行都返回 ""。
    [Native("__readline")]
    public static extern string ReadLine();

    /// stdout 是否连接 tty（重定向到管道或文件时 false）。
    [Native("__console_is_terminal")]
    public static extern bool IsTerminal();
}

/// 标准错误。与 `Console` 并列的静态类（等价 C# 的 `Console.Error`，语义相同）。
public static class ConsoleError {
    /// 写 `value` 到 stderr 并换行。
    [Native("__eprintln")]
    public static extern void WriteLine(object value);

    /// 写 `value` 到 stderr，不换行。
    [Native("__eprint")]
    public static extern void Write(object value);

    /// stderr 是否连接 tty（重定向到管道或文件时 false）。
    [Native("__console_error_is_terminal")]
    public static extern bool IsTerminal();
}
