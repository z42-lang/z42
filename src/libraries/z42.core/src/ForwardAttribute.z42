namespace Std;

// `[Forward]` —— 成员转发（add-member-forwarding）。贴在**字段**上，让外层类把该字段的
// 部分成员面提升上来，用组合替代 z42 不支持的多继承：
//
//     class Service {
//         [Forward] private Logger _log;
//         public partial void Log(string m);      // 用户点名要这个；generator 填 body
//     }
//     svc.Log("x");                                // 而不是 svc._log.Log("x")
//
// **生成的是真方法**（不是名字解析改写）——只有真方法才能满足接口、被反射看见、被 IDE 跳转。
//
// 语义边界（详见 docs/book/src/language/member-forwarding.md）：
//   · 不产生子类型、不产生隐式转换 —— `Service` **不是** `Logger`。这条是 D 语言
//     `alias this` 灾难的教训：一旦转发带上隐式转换，它就变成了多继承。
//   · `ToString`/`Equals`/`GetHashCode`/`GetType` 永不转发（转发它们会让外层对象谎报身份）。
//   · 不传递、不递归，只提升一层。
//
// ⚠️ **必须是真实类而不仅是标记名**：字段级 attribute 的合成工厂（`fld$<Class>$<Field>`）
// 会真的被编译，`new ForwardAttribute()` 要求这个类型存在。这同时也是白名单形态
// `[Forward(methodof(...))]` 里的 `methodof` 能被编译期检查的前提。
// **三档共用一个 attribute，由实参形状选档**（generator 读 Attr.Args 的原始 AST 判定）：
//
//   [Forward] Logger _log;                                 ③ 配合 `partial` 声明（用户写签名）
//   [Forward(typeof(ILogger))] Logger _log;                ① 接口面（签名由接口钉死）
//   [Forward(methodof(Logger.Log(string)))] Logger _log;   ② 逐个点名（多个 → 重复贴本 attribute）
//
// 形参是 `object` 而非 `Type`/`MethodInfo` 重载：实测 z42 的构造器**重载决议在两个引用类型
// 之间不工作**（给 `typeof(...)` 却选中 `MethodInfo` 那个重载，报 cannot assign Type to
// MethodInfo）。单 ctor 绕开它，且档位判定本来就在编译期读 AST、不依赖运行期这个字段的静态类型。
public class ForwardAttribute : Attribute {
    public object Target;
    public ForwardAttribute() { this.Target = null; }
    public ForwardAttribute(object target) { this.Target = target; }
}
