namespace Std;

/// 内置 `float` 类型（32 位 IEEE-754 浮点）的包装结构体，实现 IComparable / IEquatable / INumber。
public struct Single : IComparable, IEquatable, INumber {
    /// 最大有限值。
    public static float MaxValue = 3.40282347E+38F;
    /// 最小有限值。
    public static float MinValue = -3.40282347E+38F;
    /// 最小正数。
    public static float Epsilon  = 1.401298464324817E-45F;
    // 特殊值经 IEEE-754 位模式构造（__static_init__ 可调 BitConverter，const 折叠不行）。
    /// 非数值（NaN）。
    public static float NaN              = (float)BitConverter.SingleFromBits(0x7FC00000);
    /// 正无穷。
    public static float PositiveInfinity = (float)BitConverter.SingleFromBits(0x7F800000);
    // 0xFF800000 超出 int 正区间（会被当 long 字面量），用等值的有符号十进制写。
    /// 负无穷。
    public static float NegativeInfinity = (float)BitConverter.SingleFromBits(-8388608);

    /// 解析浮点字符串（经 double 解析后窄化为 float）；失败抛异常，语义同 Double.Parse。
    public static float Parse(string s) { return (float)Double.Parse(s); }

    /// 非抛出解析：成功把值写入 `v` 并返回 true；失败返回 false 且 `v` 置 0.0f。
    public static bool TryParse(string s, ref float v) {
        double d = 0.0;
        bool ok = Double.TryParse(s, ref d);
        v = (float)d;
        return ok;
    }

    /// v 是否为 NaN（NaN 是唯一不等于自身的值）。
    public static bool IsNaN(float v) { return v != v; }
    /// v 是否为正无穷或负无穷。
    // ±∞ 的 v - v 是 NaN（≠ 0）；有限 v 的 v - v 恰为 0。NaN 已被 IsNaN 守卫排除。
    public static bool IsInfinity(float v) {
        return !Single.IsNaN(v) && (v - v) != 0.0f;
    }
    /// v 是否为正无穷。
    public static bool IsPositiveInfinity(float v) { return Single.IsInfinity(v) && v > 0.0f; }
    /// v 是否为负无穷。
    public static bool IsNegativeInfinity(float v) { return Single.IsInfinity(v) && v < 0.0f; }
    /// v 是否为有限值（非 NaN 且非无穷）。
    public static bool IsFinite(float v) { return !Single.IsNaN(v) && !Single.IsInfinity(v); }

    /// 返回字符串表示。
    [Native("__double_to_string")]  public extern string ToString();

    /// 值相等比较（NaN != NaN）。
    public bool Equals(float other) { return this == other; }
    /// 返回哈希码（IEEE-754 位模式的 32 位值）。
    public int GetHashCode() { return BitConverter.SingleToBits(this); }

    /// 比较大小，返回负 / 0 / 正。
    public int CompareTo(float other) {
        // 全序（同 Double）：NaN 只等于自己，且排在所有非 NaN 之前。
        bool thisNaN  = (this != this);
        bool otherNaN = (other != other);
        if (thisNaN || otherNaN) {
            if (thisNaN && otherNaN) return 0;
            if (thisNaN) return -1;
            return 1;
        }
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    /// 加法。
    public static override float op_Add(float a, float b)      { return a + b; }
    /// 减法。
    public static override float op_Subtract(float a, float b) { return a - b; }
    /// 乘法。
    public static override float op_Multiply(float a, float b) { return a * b; }
    /// 除法。
    public static override float op_Divide(float a, float b)   { return a / b; }
    /// 取模。
    public static override float op_Modulo(float a, float b)   { return a % b; }
}
