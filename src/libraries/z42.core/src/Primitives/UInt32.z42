namespace Std;

/// 内置 `uint` 类型（32 位无符号整数）的包装结构体，实现 IComparable / IEquatable / INumber。
public struct UInt32 : IComparable, IEquatable, INumber {
    /// 最大值：4294967295。
    public static uint MaxValue = 4294967295;
    /// 最小值：0。
    public static uint MinValue = 0;

    /// 解析无符号整数字符串；格式错误抛 FormatException，越界抛 OverflowException，null 抛 ArgumentNullException。
    [Native("__uint32_parse")]     public static extern uint Parse(string s);
    // 共用 __int32_* builtin（运行时 Value 存为 i64）。
    /// 返回十进制字符串表示。
    [Native("__int32_to_string")]  public extern string ToString();

    /// 非抛出解析：成功把值写入 `v` 并返回 true；格式错误 / 越界 / null 返回 false 且 `v` 置 0。
    [Native("__uint32_try_parse")] public static extern bool TryParse(string s, ref uint v);

    /// 值相等比较。
    public bool Equals(uint other) { return this == other; }
    /// 返回哈希码。
    public int GetHashCode() { return (int)this; }

    /// 比较大小，返回负 / 0 / 正。
    public int CompareTo(uint other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    /// 加法。
    public static override uint op_Add(uint a, uint b)      { return (uint)(a + b); }
    /// 减法。
    public static override uint op_Subtract(uint a, uint b) { return (uint)(a - b); }
    /// 乘法。
    public static override uint op_Multiply(uint a, uint b) { return (uint)(a * b); }
    /// 除法。
    public static override uint op_Divide(uint a, uint b)   { return (uint)(a / b); }
    /// 取模。
    public static override uint op_Modulo(uint a, uint b)   { return (uint)(a % b); }
}
