namespace Std;

// rename-primitives-to-pascal-case (2026-05-24): primitive struct now named
// `SByte` per BCL convention; source keyword `sbyte` is preserved as alias.
//
// add-narrow-int-primitives (2026-05-15): `sbyte` (signed 8-bit,
// -128..=127). Underlying runtime Value is i64; Parse range-checks input.
// Equals / GetHashCode / ToString share `__int32_*` builtins (Value::I64 storage).
public struct SByte : IComparable, IEquatable, INumber {
    // C# BCL parity. `static` (read via the __static_init__ pass) — scalar
    // primitive structs resolve static members through the wrapper type.
    public static sbyte MaxValue = 127;
    public static sbyte MinValue = -128;

    [Native("__sbyte_parse")]      public static extern sbyte Parse(string s);
    [Native("__int32_to_string")]  public extern string ToString();

    // symmetrize-primitive-api：非抛出解析，成功返回值、任何格式错误/越界返回 `null`
    // （与 Int32/Int64/Double.TryParse 同款；用可空返回替代 C# 的 `out` 参数）。
    public static bool TryParse(string s, ref sbyte v) {
        try { v = SByte.Parse(s); return true; }
        catch (Exception e) { v = 0; return false; }
    }

    // shrink-primitive-native-interop (2026-08-27): Equals/GetHashCode 迁纯脚本。
    public bool Equals(sbyte other) { return this == other; }
    public int GetHashCode() { return (int)this; }

    public int CompareTo(sbyte other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    public static override sbyte op_Add(sbyte a, sbyte b)      { return (sbyte)(a + b); }
    public static override sbyte op_Subtract(sbyte a, sbyte b) { return (sbyte)(a - b); }
    public static override sbyte op_Multiply(sbyte a, sbyte b) { return (sbyte)(a * b); }
    public static override sbyte op_Divide(sbyte a, sbyte b)   { return (sbyte)(a / b); }
    public static override sbyte op_Modulo(sbyte a, sbyte b)   { return (sbyte)(a % b); }
}
