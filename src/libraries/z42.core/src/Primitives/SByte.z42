namespace Std;

// rename-primitives-to-pascal-case (2026-05-24): primitive struct now named
// `SByte` per BCL convention; source keyword `i8` is preserved as alias.
//
// add-narrow-int-primitives (2026-05-15): `i8` / `sbyte` (signed 8-bit,
// -128..=127). Underlying runtime Value is i64; Parse range-checks input.
// Equals / GetHashCode / ToString share `__int32_*` builtins (Value::I64 storage).
public struct SByte : IComparable<i8>, IEquatable<i8>, INumber<i8> {
    // C# BCL parity. `static` (read via the __static_init__ pass) — scalar
    // primitive structs resolve static members through the wrapper type.
    public static i8 MaxValue = 127;
    public static i8 MinValue = -128;

    [Native("__sbyte_parse")]      public static extern i8 Parse(string s);
    [Native("__int32_to_string")]  public extern string ToString();

    // shrink-primitive-native-interop (2026-08-27): Equals/GetHashCode 迁纯脚本。
    public bool Equals(i8 other) { return this == other; }
    public int GetHashCode() { return (int)this; }

    public int CompareTo(i8 other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    public static override i8 op_Add(i8 a, i8 b)      { return (i8)(a + b); }
    public static override i8 op_Subtract(i8 a, i8 b) { return (i8)(a - b); }
    public static override i8 op_Multiply(i8 a, i8 b) { return (i8)(a * b); }
    public static override i8 op_Divide(i8 a, i8 b)   { return (i8)(a / b); }
    public static override i8 op_Modulo(i8 a, i8 b)   { return (i8)(a % b); }
}
