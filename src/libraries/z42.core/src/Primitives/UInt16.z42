namespace Std;

/// 内置 `ushort` 类型（16 位无符号整数）的包装结构体，实现 IComparable / IEquatable / INumber。
public struct UInt16 : IComparable, IEquatable, INumber {
    /// 最大值：65535。
    public static ushort MaxValue = 65535;
    /// 最小值：0。
    public static ushort MinValue = 0;

    /// 解析无符号整数字符串；格式错误抛 FormatException，越界抛 OverflowException，null 抛 ArgumentNullException。
    [Native("__uint16_parse")]     public static extern ushort Parse(string s);
    // 共用 __int32_* builtin（运行时 Value 存为 i64）。
    /// 返回十进制字符串表示。
    [Native("__int32_to_string")]  public extern string ToString();

    /// 非抛出解析：成功把值写入 `v` 并返回 true；格式错误 / 越界 / null 返回 false 且 `v` 置 0。
    [Native("__uint16_try_parse")] public static extern bool TryParse(string s, ref ushort v);

    /// 值相等比较。
    public bool Equals(ushort other) { return this == other; }
    /// 返回哈希码。
    public int GetHashCode() { return (int)this; }

    /// 比较大小，返回负 / 0 / 正。
    public int CompareTo(ushort other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    /// 加法。
    public static override ushort op_Add(ushort a, ushort b)      { return (ushort)(a + b); }
    /// 减法。
    public static override ushort op_Subtract(ushort a, ushort b) { return (ushort)(a - b); }
    /// 乘法。
    public static override ushort op_Multiply(ushort a, ushort b) { return (ushort)(a * b); }
    /// 除法。
    public static override ushort op_Divide(ushort a, ushort b)   { return (ushort)(a / b); }
    /// 取模。
    public static override ushort op_Modulo(ushort a, ushort b)   { return (ushort)(a % b); }
}
