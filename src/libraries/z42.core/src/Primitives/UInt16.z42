namespace Std;

// rename-primitives-to-pascal-case (2026-05-24): primitive struct now named
// `UInt16` per BCL convention; source keyword `ushort` is preserved as alias.
//
// add-narrow-int-primitives (2026-05-15): `ushort` (unsigned 16-bit,
// 0..=65535). Underlying runtime Value is i64; Parse range-checks input.
// Equals / GetHashCode / ToString share `__int32_*` builtins (Value::I64 storage).
public struct UInt16 : IComparable, IEquatable, INumber {
    // C# BCL parity. `static` (read via the __static_init__ pass) — scalar
    // primitive structs resolve static members through the wrapper type.
    public static ushort MaxValue = 65535;
    public static ushort MinValue = 0;

    [Native("__uint16_parse")]     public static extern ushort Parse(string s);
    [Native("__int32_to_string")]  public extern string ToString();

    // symmetrize-primitive-api：非抛出解析，成功返回值、任何格式错误/越界返回 `null`
    // （与 Int32/Int64/Double.TryParse 同款；用可空返回替代 C# 的 `out` 参数）。
    public static bool TryParse(string s, ref ushort v) {
        try { v = UInt16.Parse(s); return true; }
        catch (Exception e) { v = 0; return false; }
    }

    // shrink-primitive-native-interop (2026-08-27): Equals/GetHashCode 迁纯脚本。
    public bool Equals(ushort other) { return this == other; }
    public int GetHashCode() { return (int)this; }

    public int CompareTo(ushort other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    public static override ushort op_Add(ushort a, ushort b)      { return (ushort)(a + b); }
    public static override ushort op_Subtract(ushort a, ushort b) { return (ushort)(a - b); }
    public static override ushort op_Multiply(ushort a, ushort b) { return (ushort)(a * b); }
    public static override ushort op_Divide(ushort a, ushort b)   { return (ushort)(a / b); }
    public static override ushort op_Modulo(ushort a, ushort b)   { return (ushort)(a % b); }
}
