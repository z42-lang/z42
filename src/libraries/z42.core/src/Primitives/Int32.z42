namespace Std;

// rename-primitives-to-pascal-case (2026-05-24): primitive struct now named
// `Int32` per BCL convention; source keyword `int` is preserved as alias.
//
// L3-G4b primitive-as-struct: `int` declared as struct `Int32` (C# BCL parity).
// Semantic type system still uses Z42PrimType("int") for identity; this struct
// is consulted by TypeChecker to answer "does int satisfy IComparable<int>?"
// and by the VM to dispatch methods on Value::I64 receivers.
public struct Int32 : IComparable<int>, IEquatable<int>, INumber<int> {
    [Native("__int32_parse")]      public static extern int Parse(string s);
    [Native("__int32_to_string")]  public extern string ToString();

    // shrink-primitive-native-interop (2026-08-27): Equals/GetHashCode 从 [Native]
    // 迁纯脚本（对齐 wave1-bool-script）。`==` 走 IR eq 指令；int 的 hash 是恒等值
    // （C# Int32.GetHashCode 返回自身）。
    public bool Equals(int other) { return this == other; }
    public int GetHashCode() { return this; }

    // 2026-04-27 wave2-compare-to-script: 脚本实现，用 IR 自带 lt/gt 指令。
    public int CompareTo(int other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    // INumber<int> static override (C# 11 static abstract). VCall passes
    // (receiver, extra) as (a, b); `a + b` is primitive add (skip-overload fast path).
    public static override int op_Add(int a, int b)      { return a + b; }
    public static override int op_Subtract(int a, int b) { return a - b; }
    public static override int op_Multiply(int a, int b) { return a * b; }
    public static override int op_Divide(int a, int b)   { return a / b; }
    public static override int op_Modulo(int a, int b)   { return a % b; }
}
