namespace Std;

// rename-primitives-to-pascal-case (2026-05-24): primitive struct now named
// `Int16` per BCL convention; source keyword `short` is preserved as alias.
//
// add-narrow-int-primitives (2026-05-15): `short` (signed 16-bit,
// -32768..=32767). Underlying runtime Value is i64; Parse range-checks input.
// Equals / GetHashCode / ToString share `__int32_*` builtins (Value::I64 storage).
public struct Int16 : IComparable, IEquatable, INumber {
    // C# BCL parity. `static` (read via the __static_init__ pass) — scalar
    // primitive structs resolve static members through the wrapper type.
    public static short MaxValue = 32767;
    public static short MinValue = -32768;

    [Native("__int16_parse")]      public static extern short Parse(string s);
    [Native("__int32_to_string")]  public extern string ToString();

    // symmetrize-primitive-api：非抛出解析，成功返回值、任何格式错误/越界返回 `null`
    // （与 Int32/Int64/Double.TryParse 同款；用可空返回替代 C# 的 `out` 参数）。
    public static bool TryParse(string s, ref short v) {
        try { v = Int16.Parse(s); return true; }
        catch (Exception e) { v = 0; return false; }
    }

    // shrink-primitive-native-interop (2026-08-27): Equals/GetHashCode 迁纯脚本。
    public bool Equals(short other) { return this == other; }
    public int GetHashCode() { return (int)this; }

    public int CompareTo(short other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    public static override short op_Add(short a, short b)      { return (short)(a + b); }
    public static override short op_Subtract(short a, short b) { return (short)(a - b); }
    public static override short op_Multiply(short a, short b) { return (short)(a * b); }
    public static override short op_Divide(short a, short b)   { return (short)(a / b); }
    public static override short op_Modulo(short a, short b)   { return (short)(a % b); }
}
