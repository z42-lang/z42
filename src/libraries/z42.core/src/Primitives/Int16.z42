namespace Std;

/// 内置 `short` 类型（16 位有符号整数）的包装结构体，实现 IComparable / IEquatable / INumber。
public struct Int16 : IComparable, IEquatable, INumber {
    /// 最大值：32767。
    public static short MaxValue = 32767;
    /// 最小值：-32768。
    public static short MinValue = -32768;

    /// 解析整数字符串。
    ///
    /// 格式错误抛 FormatException，越界抛 OverflowException，null 抛 ArgumentNullException。
    [Native("__int16_parse")]      public static extern short Parse(string s);
    // 共用 __int32_* builtin（运行时 Value 存为 i64）。
    /// 返回十进制字符串表示。
    [Native("__int32_to_string")]  public extern string ToString();

    /// 非抛出解析：成功把值写入 `v` 并返回 true；格式错误 / 越界 / null 返回 false 且 `v` 置 0。
    [Native("__int16_try_parse")] public static extern bool TryParse(string s, ref short v);

    /// 值相等比较。
    public bool Equals(short other) { return this == other; }
    /// 返回哈希码。
    public int GetHashCode() { return (int)this; }

    /// 比较大小，返回负 / 0 / 正。
    public int CompareTo(short other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    /// 加法。
    public static override short op_Add(short a, short b)      { return (short)(a + b); }
    /// 减法。
    public static override short op_Subtract(short a, short b) { return (short)(a - b); }
    /// 乘法。
    public static override short op_Multiply(short a, short b) { return (short)(a * b); }
    /// 除法。
    public static override short op_Divide(short a, short b)   { return (short)(a / b); }
    /// 取模。
    public static override short op_Modulo(short a, short b)   { return (short)(a % b); }
}
