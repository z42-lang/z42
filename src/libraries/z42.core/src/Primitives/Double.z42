namespace Std;

// rename-primitives-to-pascal-case (2026-05-24): primitive struct now named `Double`
// per BCL convention; source keyword `double` is preserved as alias.
//
// L3-G4b primitive-as-struct: `double` declared as a struct (C# BCL parity).
public struct Double : IComparable<double>, IEquatable<double>, INumber<double> {
    // C# BCL parity. Special values via IEEE-754 bit patterns (runtime
    // __static_init__ can call BitConverter, unlike a const-folded literal).
    public static double MaxValue = 1.7976931348623157E+308;
    public static double MinValue = -1.7976931348623157E+308;
    public static double Epsilon  = 4.9406564584124654E-324;
    public static double NaN              = BitConverter.DoubleFromBits(0x7FF8000000000000);
    public static double PositiveInfinity = BitConverter.DoubleFromBits(0x7FF0000000000000);
    public static double NegativeInfinity = BitConverter.DoubleFromBits(0xFFF0000000000000);

    [Native("__double_parse")]      public static extern double Parse(string s);
    [Native("__double_to_string")]  public extern string ToString();

    // Non-throwing parse — see Int32.TryParse. Returns `null` on malformed input.
    public static double? TryParse(string s) {
        try { return Double.Parse(s); }
        catch (Exception e) { return null; }
    }

    // IEEE-754 classification (pure script; no VM intrinsic needed).
    // NaN is the only value not equal to itself.
    public static bool IsNaN(double v) { return v != v; }
    // For ±∞, `v - v` is NaN (≠ 0); for any finite v it is exactly 0. NaN itself
    // is excluded by the IsNaN guard. Avoids needing an ∞ constant (1.0/0.0 may throw).
    public static bool IsInfinity(double v) {
        return !Double.IsNaN(v) && (v - v) != 0.0;
    }
    public static bool IsPositiveInfinity(double v) { return Double.IsInfinity(v) && v > 0.0; }
    public static bool IsNegativeInfinity(double v) { return Double.IsInfinity(v) && v < 0.0; }
    public static bool IsFinite(double v) { return !Double.IsNaN(v) && !Double.IsInfinity(v); }

    // shrink-primitive-native-interop (2026-08-27): Equals/GetHashCode 迁纯脚本。
    // Equals 是原生 `==`（NaN != NaN，与旧 __double_equals 一致）；hash 折叠 IEEE-754
    // 位模式高低 32 位（对齐 C# Double.GetHashCode），位重解释借 BitConverter native。
    public bool Equals(double other) { return this == other; }
    public int GetHashCode() {
        long bits = BitConverter.DoubleToBits(this);
        return (int)(bits ^ (bits >> 32));
    }

    // 2026-04-27 wave2-compare-to-script: NaN 自动落到 return 0
    // (`<` / `>` 对 NaN 都返回 false)，与 Rust `partial_cmp.unwrap_or(0)` 等价。
    public int CompareTo(double other) {
        // Total order (C# semantics) so a List<double> with NaN has a defined
        // Sort: NaN is the only value not equal to itself; it sorts before every
        // non-NaN and compares equal to itself. Plain < / > both return false for
        // NaN, which would otherwise collapse to 0 (== everything) and corrupt sorts.
        bool thisNaN  = (this != this);
        bool otherNaN = (other != other);
        if (thisNaN || otherNaN) {
            if (thisNaN && otherNaN) return 0;
            if (thisNaN) return -1;
            return 1;
        }
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    // INumber<double> static override — primitive float add/sub/mul/div/rem.
    public static override double op_Add(double a, double b)      { return a + b; }
    public static override double op_Subtract(double a, double b) { return a - b; }
    public static override double op_Multiply(double a, double b) { return a * b; }
    public static override double op_Divide(double a, double b)   { return a / b; }
    public static override double op_Modulo(double a, double b)   { return a % b; }
}
