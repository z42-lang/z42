namespace Std;

// rename-primitives-to-pascal-case (2026-05-24): primitive struct now named
// `Boolean` per BCL convention; source keyword `bool` is preserved as alias.
//
// 2026-04-27 wave1-bool-script: 3 个方法从 [Native] 迁纯脚本（BCL/Rust 对标 —
// `bool::Display` / `bool.GetHashCode` 都是常量返回）。`ToString` 输出小写
// `"true" / "false"` 与 Rust 一致（与 BCL `"True"/"False"` 不同）。
public struct Boolean : IEquatable {
    // symmetrize-primitive-api：Boolean 此前既无 Parse 也无 TryParse —— 唯一入口是
    // `Convert.ToBoolean`，与其它基元「X.Parse 为主、Convert.ToX 委托它」的形状相反。
    // 现在把判定搬到这里，`Convert.ToBoolean` 改为委托，单一出处。
    //
    // 语义对齐 C# `Boolean.Parse`：去首尾空白、大小写不敏感的 "true"/"false"；其余抛
    // FormatException（严格契约，不把任意非空串当 true）。
    public static bool Parse(string s) {
        bool v = false;
        if (Boolean.TryParse(s, ref v)) return v;
        if (s == null) throw new ArgumentNullException("Value cannot be null. (Parameter 's')");
        throw new FormatException($"Boolean.Parse: '{s}' is not a valid Boolean");
    }

    // 非抛出：null / 不认识的文本返回 false 且 `v` = false（不经 try/catch）。
    public static bool TryParse(string s, ref bool v) {
        v = false;
        if (s == null) return false;
        string t = s.Trim().ToLower();
        if (t == "true")  { v = true; return true; }
        return t == "false";
    }

    public bool Equals(bool other) {
        return this == other;
    }

    public int GetHashCode() {
        return this ? 1 : 0;
    }

    public string ToString() {
        return this ? "true" : "false";
    }
}
