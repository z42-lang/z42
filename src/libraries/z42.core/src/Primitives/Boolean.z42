namespace Std;

/// 内置 `bool` 类型的包装结构体，实现 IEquatable。
public struct Boolean : IEquatable {
    /// 解析布尔字符串：去首尾空白、大小写不敏感的 "true" / "false"；其余抛
    /// FormatException，null 抛 ArgumentNullException。
    public static bool Parse(string s) {
        bool v = false;
        if (Boolean.TryParse(s, ref v)) return v;
        if (s == null) throw new ArgumentNullException("Value cannot be null. (Parameter 's')");
        throw new FormatException($"Boolean.Parse: '{s}' is not a valid Boolean");
    }

    /// 非抛出解析：null / 不认识的文本返回 false 且 `v` 置 false。
    public static bool TryParse(string s, ref bool v) {
        v = false;
        if (s == null) return false;
        string t = s.Trim().ToLower();
        if (t == "true")  { v = true; return true; }
        return t == "false";
    }

    /// 值相等比较。
    public bool Equals(bool other) {
        return this == other;
    }

    /// 返回哈希码（true → 1，false → 0）。
    public int GetHashCode() {
        return this ? 1 : 0;
    }

    /// 返回小写字符串表示（"true" / "false"，与 BCL 的 "True" / "False" 不同）。
    public string ToString() {
        return this ? "true" : "false";
    }
}
