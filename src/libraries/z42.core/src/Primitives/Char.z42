namespace Std;

// rename-primitives-to-pascal-case (2026-05-24): primitive struct now named `Char`
// per BCL convention; source keyword `char` is preserved as alias.
//
// L3-G4b primitive-as-struct: declares Char's interface conformance.
public struct Char : IComparable<char>, IEquatable<char> {
    [Native("__char_to_string")]      public extern string ToString();

    // shrink-primitive-native-interop (2026-08-27): Equals/GetHashCode 迁纯脚本。
    public bool Equals(char other) { return this == other; }
    public int GetHashCode() { return (int)this; }

    // 2026-04-27 wave2-compare-to-script + add-char-comparison：直接用 char `<`/`>`。
    public int CompareTo(char other) {
        if (this < other) return -1;
        if (this > other) return 1;
        return 0;
    }

    // 2026-04-24 simplify-string-stdlib: primitive helper that backs script-side
    // string operations (Trim). IsWhiteSpace keeps [Native]: Rust
    // `char::is_whitespace()` is genuine Unicode classification (unlike casing
    // below, which is ASCII-only) — a pure-script ASCII version would change
    // Trim's behavior on Unicode whitespace.
    [Native("__char_is_whitespace")]  public extern bool IsWhiteSpace();

    // shrink-primitive-native-interop (2026-08-27): ToLower/ToUpper 迁纯脚本。
    // 旧 __char_to_lower/upper 实为 Rust `to_ascii_lowercase/uppercase`（纯 ASCII），
    // 脚本按 ASCII 规则等价——非 ASCII 字符原样返回，locale-sensitive casing
    // (Turkish I 等) 仍 defer 到 L3 CultureInfo。
    public char ToLower() {
        if (!(this < 'A') && !(this > 'Z')) return (char)((int)this + 32);
        return this;
    }
    public char ToUpper() {
        if (!(this < 'a') && !(this > 'z')) return (char)((int)this - 32);
        return this;
    }

    // add-char-isdigit-isletter (review §2.6): ASCII classification helpers so
    // callers stop hand-rolling `(int)ch < 48 || (int)ch > 57` (BigInt.Parse,
    // Decimal.Parse). ASCII rules only — locale-sensitive classification is
    // deferred to L3 CultureInfo, matching ToLower/ToUpper. Expressed with the
    // supported char `<` / `>` operators (see CompareTo).
    public bool IsDigit() {
        return !(this < '0') && !(this > '9');
    }
    public bool IsLetter() {
        bool lower = !(this < 'a') && !(this > 'z');
        bool upper = !(this < 'A') && !(this > 'Z');
        return lower || upper;
    }

    // augment-corelib-parity (2026-09-02, backlog #10): more ASCII classifiers
    // rounding out System.Char parity. Same ASCII-only rules / L3-CultureInfo
    // deferral as IsDigit/IsLetter/ToLower above.
    public bool IsLetterOrDigit() {
        return this.IsLetter() || this.IsDigit();
    }
    public bool IsUpper() {
        return !(this < 'A') && !(this > 'Z');
    }
    public bool IsLower() {
        return !(this < 'a') && !(this > 'z');
    }
    // ASCII punctuation per Unicode P* categories (matches .NET char.IsPunctuation
    // over U+0000–U+007F): the ASCII symbol chars $ + < = > ^ ` | ~ are category S,
    // NOT punctuation, so they return false.
    public bool IsPunctuation() {
        int c = (int)this;
        if (c >= 33 && c <= 47) return c != 36 && c != 43; // ! " # % & ' ( ) * , - . /  (excl. $ +)
        if (c == 58 || c == 59) return true;               // : ;
        if (c == 63 || c == 64) return true;               // ? @
        if (c >= 91 && c <= 93) return true;               // [ \ ]
        if (c == 95) return true;                          // _
        return c == 123 || c == 125;                       // { }
    }

    // Static forms mirror the C# System.Char static API (`char.IsDigit(c)` etc.);
    // z42's type-based mangling lets them coexist with the instance methods above.
    public static bool IsDigit(char c)         { return c.IsDigit(); }
    public static bool IsLetter(char c)        { return c.IsLetter(); }
    public static bool IsLetterOrDigit(char c) { return c.IsLetterOrDigit(); }
    public static bool IsWhiteSpace(char c)    { return c.IsWhiteSpace(); }
    public static bool IsUpper(char c)         { return c.IsUpper(); }
    public static bool IsLower(char c)         { return c.IsLower(); }
    public static bool IsPunctuation(char c)   { return c.IsPunctuation(); }
    public static char ToUpper(char c)         { return c.ToUpper(); }
    public static char ToLower(char c)         { return c.ToLower(); }
}
