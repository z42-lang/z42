namespace Std;

/// 让 z42 脚本显式控制 GC（触发回收、读堆用量、设上限、取停顿数据、导快照）。
// 实现笔记：底层走 corelib::gc builtins → ctx.heap()。trial-deletion 算法在脚本执行中
// 调用也安全（活对象 tentative > 0 不会被错误断环）。

public static class GC {
    /// 触发环检测与回收（基于 Bacon-Rajan trial-deletion）。GC 被 pause 时本调用是 no-op。
    [Native("__gc_collect")]
    public static extern void Collect();

    /// 当前堆 used_bytes 估算值。
    // RC 模式下普通 Drop 不更新此计数。
    [Native("__gc_used_bytes")]
    public static extern long UsedBytes();

    /// 强制完整 collect 并返回估算的 freed_bytes。与 Collect() 不同，不被 pause 跳过。
    [Native("__gc_force_collect")]
    public static extern long ForceCollect();

    /// 当前 heap 全字段 stats 快照，返回 `Std.HeapStats` 实例。`MaxBytes` 用 `-1` 表示 unlimited。
    [Native("__gc_stats")]
    public static extern HeapStats GetStats();

    /// 显式触发 `target` 的 finalizer 并立即作废该对象。
    ///
    /// RAII 风格即时释放，对齐 .NET `IDisposable.Dispose()` / Java
    /// `AutoCloseable.close()`。返回 true 表示 finalizer 真触发；false 表示对象没注册
    /// finalizer、非堆引用类型、已释放或 null。**调用之后对象不可再用**。
    [Native("__gc_finalize")]
    public static extern bool Finalize(Object target);

    /// 返回 8 元素 `long[]`，第 `i` 项是落入第 `i` 桶的 collect 次数。
    ///
    /// 桶边界（半开区间 `[lower, upper)`，微秒）：0 `[0, 10)` · 1 `[10, 100)` ·
    /// 2 `[100 µs, 1 ms)` · 3 `[1, 10) ms` · 4 `[10, 100) ms` · 5 `[100 ms, 1 s)` ·
    /// 6 `[1, 10) s` · 7 `[10 s, ∞)`。自 heap 创建起累积，跨 GcMode 切换保留（不重置）。
    [Native("__gc_pause_histogram")]
    public static extern long[] PauseHistogram();

    /// 返回 4 元素 `long[]`：`[min_us, max_us, total_us, count]`。
    ///
    /// `count == 0` 时 `min_us` 是哨兵 `-1`，其余三项为 0；读 `min_us` 前先判 `count`。
    [Native("__gc_pause_stats_raw")]
    public static extern long[] PauseStatsRaw();

    /// 把当前堆的对象引用图写成 V8 `.heapsnapshot` JSON 文件，返回写入字节数。
    ///
    /// 文件可被 Chrome DevTools（Memory → Load）加载看 retainer 图 / dominator 树 /
    /// 到根最短路径。路径不可写时抛异常。
    // v1 局限：无 allocation-site 栈回溯；不 stream 大堆（in-memory 一次写）；weak refs 不进图。
    [Native("__gc_write_heap_snapshot")]
    public static extern long WriteHeapSnapshot(string path);

    /// 返回 rolling window 内的所有 pause 样本（µs），按时间从旧到新。
    /// 长度 ≤ `PauseWindowCapacity()`。
    [Native("__gc_recent_pauses")]
    public static extern long[] RecentPauses();

    /// 返回 rolling window 的容量（`Z42_GC_PAUSE_WINDOW` 决定，默认 1024，clamp 到 [1, 65536]）。
    [Native("__gc_pause_window_capacity")]
    public static extern long PauseWindowCapacity();

    /// 设置堆上限（bytes）。传 0 或负数则清除上限（无界）。
    ///
    /// strict OOM 开启时，超过上限的 alloc 抛 `Std.OutOfMemoryException`。
    [Native("__gc_set_max_heap_bytes")]
    public static extern void SetMaxHeapBytes(long bytes);

    /// 开启 / 关闭 strict OOM 模式。
    ///
    /// true = alloc 越过 max_heap_bytes 时抛 OutOfMemoryException；false（默认）= 无限制。
    [Native("__gc_set_strict_oom")]
    public static extern void SetStrictOOM(bool enabled);
}
