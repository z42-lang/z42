// 执行基座 native 语义层：线程原语 + 同步原语的底座 Monitor。高层 API
// （Std.Threading.Thread / Mutex<T> / RwLock<T> / Channel<T>）留在 z42.threading 转纯脚本、
// 调这里的 *Native 原语。命名空间保持 Std.Threading 不变。native 实现镜像
// src/runtime/src/corelib/threading.rs。
namespace Std.Threading;

/// Thread 应用层用的线程原语（__thread_spawn / __thread_sleep / __thread_wait）。
public static class ThreadNative {
    /// 开一条 OS 线程跑 action，返回句柄槽号。
    [Native("__thread_spawn")]
    public static extern long Spawn(object action);

    /// 阻塞当前线程 millis 毫秒。
    [Native("__thread_sleep")]
    public static extern void Sleep(long millis);

    /// 等待线程结束；worker 抛过异常 / panic / 重复 Join → VM 直接抛 `Std.Threading.ThreadException`。
    [Native("__thread_wait")]
    public static extern void Wait(long slotId);
}

// 实现笔记：**原生层不持有任何值**——值是 z42 字段（GC 可见），这里只提供同步。
// 语义：Enter 阻塞且同线程重入抛异常；TryEnter 不阻塞（被任何线程持有即 false）；
// Exit 非持有者抛异常；Wait 原子地释放 → 等一次 Exit 的信号 → 重新持有，**允许伪唤醒**，
// 调用方必须 `while (!条件) Wait(m)`。

/// Mutex / RwLock / Channel 的唯一原生底座。
public static class MonitorNative {
    /// 新建 monitor。
    [Native("__monitor_new")]
    public static extern object New();
    /// 阻塞获取；同线程重入抛异常。
    [Native("__monitor_enter")]
    public static extern void Enter(object monitor);
    /// 非阻塞获取；被任何线程持有即 false。
    [Native("__monitor_try_enter")]
    public static extern bool TryEnter(object monitor);
    /// 释放；非持有者抛异常。
    [Native("__monitor_exit")]
    public static extern void Exit(object monitor);
    /// 原子释放 → 等一次 Exit 信号 → 重新持有（允许伪唤醒）。
    [Native("__monitor_wait")]
    public static extern void Wait(object monitor);
}
