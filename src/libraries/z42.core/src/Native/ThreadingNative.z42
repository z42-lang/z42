// 执行基座 native 语义层：线程原语 + 同步原语的底座 Monitor。
//
// 归属规则见 docs/design/stdlib/organization.md「native 语义层 → core，应用层 →
// 纯脚本能力库」（2026-08-27）：io/net/threading 的 native 语义层并入 core（单一可审计
// native ABI 面），高层 API（Std.Threading.Thread / Mutex<T> / RwLock<T> / Channel<T>）
// 留在 z42.threading 转纯脚本、调这里的 *Native 原语（Mutex / RwLock / Channel 只用 MonitorNative）。命名空间保持 Std.Threading 不变，
// 故 z42.threading 里的调用点无需改动。
//
// native 实现镜像 src/runtime/src/corelib/threading.rs；符号按名在调用期解析，
// 声明在 core 不影响按需加载（见 organization.md 澄清段）。
namespace Std.Threading;

// __thread_spawn / __thread_sleep / __thread_join（Thread 应用层用）。
public static class ThreadNative {
    [Native("__thread_spawn")]
    public static extern long Spawn(object action);

    // add-thread-sleep (2026-05-27)
    [Native("__thread_sleep")]
    public static extern void Sleep(long millis);

    [Native("__thread_join")]
    public static extern object[] Join(long slotId);
}

// store-sync-values-in-heap（2026-09-14）：Mutex / RwLock / Channel 的唯一原生底座。
// **原生层不持有任何值**——值是 z42 字段（GC 可见），这里只提供同步。旧的 MutexNative /
// RwLockNative / ChannelNative 把值存进 Rust 侧容器、GC 看不见，已删除。
// 语义：Enter 阻塞且同线程重入抛异常；TryEnter 不阻塞（被任何线程持有即 false）；
// Exit 非持有者抛异常；Wait 原子地释放 → 等一次 Exit 的信号 → 重新持有，**允许伪唤醒**，
// 调用方必须 `while (!条件) Wait(m)`。机制见 docs/book/src/runtime/sync-primitives.md。
public static class MonitorNative {
    [Native("__monitor_new")]
    public static extern object New();
    [Native("__monitor_enter")]
    public static extern void Enter(object monitor);
    [Native("__monitor_try_enter")]
    public static extern bool TryEnter(object monitor);
    [Native("__monitor_exit")]
    public static extern void Exit(object monitor);
    [Native("__monitor_wait")]
    public static extern void Wait(object monitor);
}
