// 执行基座 native 语义层：TCP / UDP / TLS / DNS socket 原语。高层 API（TcpClient /
// TcpListener / NetworkStream / UdpClient / TlsClient / Dns）留在 z42.net 转纯脚本、调这里的
// *Native 原语。命名空间保持 Std.Net.Sockets 不变。native 实现镜像
// src/runtime/src/corelib/network.rs。
//
// ABI v2：TcpSocketNative / UdpSocketNative / TlsSocketNative / DnsNative.Resolve 返回普通值、
// 失败从 Rust 抛（.NET 口径：SocketException / SocketClosedException / AuthenticationException /
// wasm32 NetUnsupportedException）。返回 [KIND, …] 判别数组的旧类（NetTcpNative / NetTlsNative /
// UdpNative / DnsNative.Lookup）已随种子换代删除；运行时表项与 legacy 实现的挂账在
// builtin_table_ext.rs 的 legacy-net-builtins 条目。
namespace Std.Net.Sockets;

/// TCP socket 的 native 原语，供 z42.net 的 TcpClient / TcpListener 调用。
public static class TcpSocketNative {
    /// 连接 host:port，返回 socket 槽位。timeoutMs <= 0 → 不限时。
    [Native("__tcp_connect")]
    public static extern long Connect(string host, int port, int timeoutMs);

    /// 绑定并监听，返回监听槽位。reuseAddress → bind 之前设 SO_REUSEADDR。
    [Native("__tcp_listen")]
    public static extern long Listen(string host, int port, bool reuseAddress);

    /// 实际监听端口（Listen 传 0 时由 OS 分配）。
    [Native("__tcp_listener_port")]
    public static extern int ListenerPort(long listenerSlotId);

    /// 接受一个连接，返回 socket 槽位。
    [Native("__tcp_accept")]
    public static extern long Accept(long listenerSlotId);

    /// 读入 buffer，返回读到的字节数（0 = 对端已关闭）。
    [Native("__tcp_read")]
    public static extern int Read(long slotId, byte[] buffer, int offset, int count);

    /// 写出 buffer。
    [Native("__tcp_write")]
    public static extern void Write(long slotId, byte[] buffer, int offset, int count);

    /// 关闭 socket。
    [Native("__tcp_close")]
    public static extern void Close(long slotId);

    /// 关闭监听 socket。
    [Native("__tcp_listener_close")]
    public static extern void ListenerClose(long listenerSlotId);

    /// 设置读超时；millis <= 0 清除超时（回到阻塞）。
    [Native("__tcp_set_read_timeout")]
    public static extern void SetReadTimeout(long slotId, int millis);

    /// 设置写超时；millis <= 0 清除超时（回到阻塞）。
    [Native("__tcp_set_write_timeout")]
    public static extern void SetWriteTimeout(long slotId, int millis);

    /// 设置 TCP_NODELAY（禁用 Nagle 算法）。
    [Native("__tcp_set_nodelay")]
    public static extern void SetNoDelay(long slotId, bool enable);

    /// 设置 IP_TTL。
    [Native("__tcp_set_ttl")]
    public static extern void SetTtl(long slotId, int ttl);

    /// 设置监听 socket 的 IP_TTL。
    [Native("__tcp_listener_set_ttl")]
    public static extern void ListenerSetTtl(long listenerSlotId, int ttl);

    /// 设置 SO_KEEPALIVE。
    [Native("__tcp_set_keepalive")]
    public static extern void SetKeepAlive(long slotId, bool enable);

    /// 带调参的 SO_KEEPALIVE。
    [Native("__tcp_set_keepalive_tuned")]
    public static extern void SetKeepAliveTuned(long slotId, bool enable, int idleSecs, int intervalSecs, int probes);
}

/// UDP socket 的 native 原语，供 z42.net 的 UdpClient 调用。
public static class UdpSocketNative {
    /// 绑定 host:port，返回 slot。
    [Native("__udp_bind")]
    public static extern long Bind(string host, int port);

    /// 本地绑定端口。
    [Native("__udp_local_port")]
    public static extern int LocalPort(long slotId);

    /// 向 remoteHost:remotePort 发送数据报。
    [Native("__udp_send")]
    public static extern int Send(long slotId, byte[] buf, int offset, int count, string remoteHost, int remotePort);

    /// 收一个数据报，返回 `[byte[] datagram, string remoteHost, long remotePort]`。
    [Native("__udp_recv")]
    public static extern object[] Receive(long slotId);

    /// 收进调用方缓冲，返回 `[long bytesWritten, string remoteHost, long remotePort]`；
    /// 超出 `count` 的部分截断。
    [Native("__udp_recv_into")]
    public static extern object[] ReceiveInto(long slotId, byte[] buf, int offset, int count);

    /// 关闭 socket。
    [Native("__udp_close")]
    public static extern void Close(long slotId);

    /// 加入 IPv4 组播组。
    [Native("__udp_join_multicast")]
    public static extern void JoinMulticast(long slotId, string groupIp, string ifaceIp);

    /// 离开 IPv4 组播组。
    [Native("__udp_leave_multicast")]
    public static extern void LeaveMulticast(long slotId, string groupIp, string ifaceIp);

    /// 设置 IP_MULTICAST_LOOP。
    [Native("__udp_set_multicast_loop")]
    public static extern void SetMulticastLoop(long slotId, bool enable);

    /// 设置单播 IP_TTL。
    [Native("__udp_set_ttl")]
    public static extern void SetTtl(long slotId, int ttl);

    /// 设置读超时。
    [Native("__udp_set_read_timeout")]
    public static extern void SetReadTimeout(long slotId, int millis);

    /// 设置写超时。
    [Native("__udp_set_write_timeout")]
    public static extern void SetWriteTimeout(long slotId, int millis);
}

/// TLS socket 的 native 原语，供 z42.net 的 TlsClient 调用。
public static class TlsSocketNative {
    /// 连接并完成 TLS 握手，返回 slot。timeoutMs <= 0 → 连接与握手都不限时；> 0 同时约束两者。
    [Native("__tls_connect")]
    public static extern long Connect(string host, int port, int timeoutMs);

    /// 读入 buffer。
    [Native("__tls_read")]
    public static extern int Read(long slotId, byte[] buffer, int offset, int count);

    /// 写出 buffer。
    [Native("__tls_write")]
    public static extern void Write(long slotId, byte[] buffer, int offset, int count);

    /// 关闭 TLS 会话。
    [Native("__tls_close")]
    public static extern void Close(long slotId);

    /// 设置读超时。
    [Native("__tls_set_read_timeout")]
    public static extern void SetReadTimeout(long slotId, int millis);

    /// 设置写超时。
    [Native("__tls_set_write_timeout")]
    public static extern void SetWriteTimeout(long slotId, int millis);
}

/// DNS 解析的 native 原语，供 z42.net 的 Dns 调用。
public static class DnsNative {
    /// 解析出的地址（文本形式，去重）；解析失败抛 `SocketException(HostNotFound)`。
    [Native("__dns_lookup")]
    public static extern string[] Resolve(string host);
}
