namespace Std;

/// 当前进程与机器的具体数值：pid、可执行文件路径、工作目录、主机名、CPU 数、OS 版本串。
///
/// 对标 .NET System.Environment 成员。除 `SetCurrentDirectory` 外，全部成员失败时返回空串 /
/// 兜底值，不抛异常（在意失败与否就判 `.Length == 0`）。
public static class OperatingSystem {
    /// 当前进程 id。wasm 上恒为 0。
    [Native("__system_pid")]
    public static extern int CurrentPid();

    /// 正在运行的 z42vm 二进制的绝对路径；失败为 `""`。
    [Native("__system_exe_path")]
    public static extern string ExecutablePath();

    /// 当前工作目录绝对路径；失败为 `""`。
    [Native("__system_cwd")]
    public static extern string CurrentDirectory();

    /// 设置整个进程的工作目录（此后 Std.IO 的相对路径都跟着变）。失败抛 Std.Exception
    /// （唯一会抛的成员）。
    [Native("__system_set_cwd")]
    public static extern void SetCurrentDirectory(string path);

    /// 主机名；失败为 `""`（Windows 上恒空）。
    [Native("__system_hostname")]
    public static extern string Hostname();

    /// 可用并行度；失败为 1。
    [Native("__system_cpu_count")]
    public static extern int CpuCount();

    /// OS 版本串（格式随 OS 变，只适合打印）；失败为 `""`（wasm 上为 `"wasm"`）。
    [Native("__system_os_version")]
    public static extern string OsVersion();
}
