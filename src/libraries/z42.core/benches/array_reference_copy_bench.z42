namespace Z42CoreArrayReferenceCopyBench;

using Std.Harness;

[Benchmark]
void CopyInts() {
    int[] src = new int[4096];
    int[] dst = new int[4096];
    src[4095] = 5;
    var b = new Bencher(4, 24);
    b.iter(() => {
        Array.CopyRange(src, 0, dst, 0, 4096);
        BenchHelpers.blackBox(dst);
    });
    b.printSummary("copy_range_int_same_4096");
}

[Benchmark]
void CopyStrings() {
    string[] src = new string[4096];
    string[] dst = new string[4096];
    Array.Fill<string>(src, "é");
    var b = new Bencher(4, 24);
    b.iter(() => {
        Array.CopyRange(src, 0, dst, 0, 4096);
        BenchHelpers.blackBox(dst);
    });
    b.printSummary("copy_range_string_same_4096");
}

[Benchmark]
void CopyNarrowStrings() {
    object[] src = new object[4096];
    string[] dst = new string[4096];
    Array.Fill<object>(src, "é");
    var b = new Bencher(4, 24);
    b.iter(() => {
        Array.CopyRange(src, 0, dst, 0, 4096);
        BenchHelpers.blackBox(dst);
    });
    b.printSummary("copy_range_object_to_string_4096");
}
