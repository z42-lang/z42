namespace Z42ConcatUtf8Bench;
using Std.Harness;

void measure(string[] parts, string name) {
    var b = new Bencher(4, 24);
    b.iter(() => { BenchHelpers.blackBox(String.ConcatPartsUtf8(parts, parts.Length)); });
    b.printSummary(name);
}

[Benchmark]
void concat_utf8_large() {
    char[] chars = new char[65536];
    for (int i = 0; i < chars.Length; i = i + 1) { chars[i] = '中'; }
    string text = String.FromChars(chars);
    measure(new string[] { text, text, text }, "concat_utf8_large");
}

[Benchmark]
void concat_utf8_short_parts() {
    string[] parts = new string[4096];
    for (int i = 0; i < parts.Length; i = i + 1) {
        parts[i] = i % 2 == 0 ? "{" : "é";
    }
    measure(parts, "concat_utf8_short_parts");
}
