namespace Z42HashClearBench;
using Std.Collections;
using Std.Harness;

void bench(int capacity, int fill, int repeats, string name) {
    Dictionary<int, string> dict = new Dictionary<int, string>();
    HashSet<int> set = new HashSet<int>();
    for (int i = 0; i < capacity; i++) {
        dict[i] = "value";
        set.Add(i);
    }
    dict.Clear();
    set.Clear();
    var b = new Bencher(4, 24);
    b.iter(() => {
        for (int j = 0; j < repeats; j++) {
            for (int i = 0; i < fill; i++) {
                dict[i] = "value";
                set.Add(i);
            }
            dict.Clear();
            set.Clear();
        }
        Assert.Equal(0, dict.Count);
        Assert.Equal(0, set.Count);
        BenchHelpers.blackBox(dict);
        BenchHelpers.blackBox(set);
    });
    b.printSummary(name);
}

[Benchmark]
void hash_clear_empty_small() { bench(0, 0, 1024, "hash_clear_empty_small"); }
[Benchmark]
void hash_clear_empty_large() { bench(8192, 0, 128, "hash_clear_empty_large"); }
[Benchmark]
void hash_clear_sparse_large() { bench(8192, 4, 128, "hash_clear_sparse_large"); }
[Benchmark]
void hash_clear_dense_small() { bench(8, 8, 128, "hash_clear_dense_small"); }
