// Micro-benchmarks for z42.core hot paths — String ops + List growth. Dogfoods
// the [Benchmark] + Bencher machinery on the most-exercised core primitives.
// Modest sample counts keep the correctness wave fast; run via
// `z42 xtask.zpkg bench stdlib z42.core` (or `z42b bench <compiled.zpkg>`;
// add `--format json` for structured bench_stats).

namespace Z42CoreBench;

using Std.Collections;   // List<T> / Dictionary<K,V> —— 此前漏写；旧的裸 `--emit-zbc` 单文件
                         // 编译不跑文件级 using 检查，改由 z42b 按包编译后 E0436 逮到。
using Std.Harness;

[Benchmark]
void bench_string_concat() {
    string s = "";
    int i = 0;
    while (i < 32) {
        s = s + "ab";
        i = i + 1;
    }
    GC.KeepAlive(s);
}

[Benchmark]
void bench_string_index_of(Bencher b) {
    string hay = "the quick brown fox jumps over the lazy dog, then rests";
    b.iter(() => {
        int r = hay.IndexOf("lazy") + hay.IndexOf("fox") + hay.IndexOf("zzz");
        GC.KeepAlive(r);
    });
}

[Benchmark]
void bench_string_substring(Bencher b) {
    string src = "0123456789abcdefghijklmnopqrstuvwxyz";
    b.iter(() => {
        string acc = "";
        int i = 0;
        while (i < 20) {
            acc = src.Substring(i, 8);
            i = i + 1;
        }
        GC.KeepAlive(acc);
    });
}

[Benchmark]
void bench_string_split(Bencher b) {
    string csv = "a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p";
    b.iter(() => {
        string[] parts = csv.Split(",");
        GC.KeepAlive(parts.Length);
    });
}

[Benchmark]
void bench_list_add_index() {
    var xs = new List<int>();
    int i = 0;
    while (i < 64) {
        xs.Add(i * 2);
        i = i + 1;
    }
    int sum = 0;
    int j = 0;
    while (j < xs.Count) {
        sum = sum + xs[j];
        j = j + 1;
    }
    GC.KeepAlive(sum);
}

// Sort a freshly-scrambled 256-element list each iteration. Exercises the
// merge sort (O(n log n)); the pseudo-scatter `(i*137+89) % 251` keeps the
// input unsorted (and with duplicates) so every run does real work.
[Benchmark]
void bench_list_sort() {
    var xs = new List<int>();
    int i = 0;
    while (i < 256) {
        xs.Add((i * 137 + 89) % 251);
        i = i + 1;
    }
    xs.Sort();
    GC.KeepAlive(xs[0] + xs[255]);
}

// Smoke [Test] — confirms the benchmark bodies actually run (Bencher wired,
// samples honoured), independent of timing.
[Test]
void test_core_bench_bodies_run() {
    var b = new Bencher(1, 3);
    b.iter(() => {
        string s = "x" + "y";
        GC.KeepAlive(s);
    });
    Assert.Equal(3, b.Samples);
    Assert.True(b.TotalNs > 0L);
}

[Benchmark]
void bench_dict_set_get() {
    var d = new Dictionary<string, int>();
    int i = 0;
    while (i < 64) {
        d["key" + i.ToString()] = i * i;
        i = i + 1;
    }
    int hits = 0;
    int j = 0;
    while (j < 64) {
        string k = "key" + j.ToString();
        if (d.ContainsKey(k)) { hits = hits + d[k]; }
        j = j + 1;
    }
    GC.KeepAlive(hits);
}

[Benchmark]
void bench_int_tostring_parse() {
    long acc = 0;
    int i = 0;
    while (i < 64) {
        string s = (i * 7919).ToString();
        acc = acc + long.Parse(s);
        i = i + 1;
    }
    GC.KeepAlive(acc);
}

[Benchmark]
void bench_string_join(Bencher b) {
    string[] parts = new string[16];
    int i = 0;
    while (i < 16) { parts[i] = "seg" + i.ToString(); i = i + 1; }
    b.iter(() => {
        GC.KeepAlive(String.Join(",", parts));
    });
}

[Benchmark]
void bench_string_format() {
    string acc = "";
    int i = 0;
    while (i < 16) {
        acc = String.Format("{0}={1}/{2}", "key" + i.ToString(), i, i * 2);
        i = i + 1;
    }
    GC.KeepAlive(acc);
}
