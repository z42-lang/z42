namespace Z42MethodTypeForwardingBench;
using Std.Harness;

T Zero<T>() { return default(T); }
T Forward<T>() { return Zero<T>(); }

[Benchmark]
void method_type_direct(Bencher b) {
    b.iter(() => {
        int sum = 0;
        for (int i = 0; i < 1024; i = i + 1) { sum = sum + Zero<int>(); }
        Assert.Equal(0, sum);
        GC.KeepAlive(sum);
    });
}

[Benchmark]
void method_type_forwarded(Bencher b) {
    b.iter(() => {
        int sum = 0;
        for (int i = 0; i < 1024; i = i + 1) { sum = sum + Forward<int>(); }
        Assert.Equal(0, sum);
        GC.KeepAlive(sum);
    });
}
