namespace Z42JsonLazyConstructorBindingTests;

using Std.Json;
using Std.Harness;
using Std.Reflection;

class WithOverloads {
    public string Label;
    public string Note = "initial";
    public int Selected;

    public WithOverloads(int unused) { this.Selected = 1; }
    public WithOverloads(int unused, string Label) {
        this.Label = Label;
        this.Selected = 2;
    }
}

[Test]
void test_lazy_type_enumerates_and_invokes_declared_constructors() {
    ConstructorInfo[] ctors = typeof(WithOverloads).GetConstructors();
    Assert.Equal(2, ctors.Length);
    Assert.Equal(1, ctors[0].GetParameters().Length);
    Assert.Equal(2, ctors[1].GetParameters().Length);
    WithOverloads missing = JsonSerializer.Deserialize<WithOverloads>("{\"unused\":0,\"Label\":\"from ctor\"}");
    WithOverloads explicitNull = JsonSerializer.Deserialize<WithOverloads>("{\"unused\":0,\"Label\":null,\"Note\":null}");
    Assert.Equal(2, missing.Selected);
    Assert.Equal("from ctor", missing.Label);
    Assert.Equal("initial", missing.Note);
    Assert.Equal(2, explicitNull.Selected);
    Assert.True(explicitNull.Label == null);
    Assert.True(explicitNull.Note == null);
}
