// add-json-serde (2026-08-22)：对象 → JSON 序列化（含字段/属性、嵌套、数组、[JsonProperty]/[JsonIgnore]）。
namespace Z42JsonSerializeTests;

using Std;
using Std.Test;
using Std.Json;
using Std.Collections;

class Point {
    public int x;
    public int y;
}

// add-collection-serde：List<T> / Dictionary<string,V> 序列化测。
class Bag {
    public string Name;
    public List<int> Nums;
    public Dictionary<string, int> Scores;
}
// List 元素为对象——List<T> 约束 T: IEquatable<T> + IComparable<T>。
class Item : IEquatable<Item>, IComparable<Item> {
    public int id;
    public bool Equals(Item other) { return this.id == other.id; }
    public int GetHashCode() { return this.id; }
    public int CompareTo(Item other) { return this.id - other.id; }
}

class Person {
    public bool Active;               // 字段
    public string Name { get; set; }  // 属性
    public int Age { get; set; }
}

class Renamed {
    [JsonProperty("full_name")] public string Name;
    [JsonIgnore] public int Secret;
    public int Id;
}

class PropTagged {
    [JsonProperty("user_name")] public string Name { get; set; }
    [JsonIgnore] public int Token { get; set; }
    public int Id { get; set; }
}

class Nested {
    public string Title;
    public Point Origin;
}

class WithArray {
    public string Name;
    public int[] Nums;
}

[Test]
void test_serialize_primitive_fields_exact() {
    Point p = new Point();
    p.x = 3; p.y = 4;
    Assert.Equal("{\"x\":3,\"y\":4}", JsonSerializer.Serialize(p));
}

[Test]
void test_serialize_fields_and_properties() {
    Person person = new Person();
    person.Active = true; person.Name = "Alice"; person.Age = 30;
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(person));
    Assert.True(v.Get("Active").AsBool());
    Assert.Equal("Alice", v.Get("Name").AsString());
    Assert.Equal(30L, v.Get("Age").AsLong());
}

[Test]
void test_serialize_field_jsonproperty_and_ignore() {
    Renamed r = new Renamed();
    r.Name = "bob"; r.Secret = 99; r.Id = 7;
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(r));
    Assert.Equal("bob", v.Get("full_name").AsString());   // renamed
    Assert.False(v.ContainsKey("Name"));                   // original name gone
    Assert.False(v.ContainsKey("Secret"));                 // ignored
    Assert.Equal(7L, v.Get("Id").AsLong());
}

[Test]
void test_serialize_property_jsonproperty_and_ignore() {
    // 关键：属性上的 [JsonProperty]/[JsonIgnore]（挂 __prop_X 背后字段的 attr）。
    PropTagged p = new PropTagged();
    p.Name = "kim"; p.Token = 42; p.Id = 5;
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(p));
    Assert.Equal("kim", v.Get("user_name").AsString());   // 属性 renamed
    Assert.False(v.ContainsKey("Name"));
    Assert.False(v.ContainsKey("Token"));                  // 属性 ignored
    Assert.Equal(5L, v.Get("Id").AsLong());
}

[Test]
void test_serialize_nested_object() {
    Nested n = new Nested();
    n.Title = "root";
    n.Origin = new Point();
    n.Origin.x = 1; n.Origin.y = 2;
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(n));
    Assert.Equal("root", v.Get("Title").AsString());
    Assert.Equal(1L, v.Get("Origin").Get("x").AsLong());
    Assert.Equal(2L, v.Get("Origin").Get("y").AsLong());
}

[Test]
void test_serialize_array() {
    WithArray w = new WithArray();
    w.Name = "xs";
    w.Nums = new int[3];
    w.Nums[0] = 10; w.Nums[1] = 20; w.Nums[2] = 30;
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(w));
    Assert.Equal("xs", v.Get("Name").AsString());
    JsonValue arr = v.Get("Nums");
    Assert.Equal(3, arr.Count());
    Assert.Equal(10L, arr.At(0).AsLong());
    Assert.Equal(30L, arr.At(2).AsLong());
}

[Test]
void test_serialize_null_member() {
    Nested n = new Nested();
    n.Title = "t";
    n.Origin = null;
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(n));
    Assert.True(v.Get("Origin").IsNull());
}

[Test]
void test_serialize_pretty_has_newlines() {
    Point p = new Point();
    p.x = 1; p.y = 2;
    Assert.Contains("\n", JsonSerializer.SerializePretty(p));
}

// ── add-collection-serde ────────────────────────────────────────────────────
[Test]
void test_serialize_list_of_int() {
    List<int> nums = new List<int>();
    nums.Add(1); nums.Add(2); nums.Add(3);
    Assert.Equal("[1,2,3]", JsonSerializer.Serialize(nums));
}

[Test]
void test_serialize_empty_list() {
    List<int> nums = new List<int>();
    Assert.Equal("[]", JsonSerializer.Serialize(nums));
}

[Test]
void test_serialize_dict_string_int() {
    Dictionary<string, int> d = new Dictionary<string, int>();
    d["a"] = 1;
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(d));
    Assert.True(v.IsObject());
    Assert.Equal(1, (int)v.Get("a").AsLong());
}

[Test]
void test_serialize_collections_as_fields() {
    Bag b = new Bag();
    b.Name = "xs";
    b.Nums = new List<int>(); b.Nums.Add(10); b.Nums.Add(20);
    b.Scores = new Dictionary<string, int>(); b.Scores["k"] = 5;
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(b));
    Assert.Equal("xs", v.Get("Name").AsString());
    Assert.Equal(2, v.Get("Nums").Count());
    Assert.Equal(10, (int)v.Get("Nums").At(0).AsLong());
    Assert.Equal(5, (int)v.Get("Scores").Get("k").AsLong());
}

[Test]
void test_serialize_list_of_objects() {
    List<Item> items = new List<Item>();
    Item a = new Item(); a.id = 7; items.Add(a);
    JsonValue v = JsonValue.Parse(JsonSerializer.Serialize(items));
    Assert.True(v.IsArray());
    Assert.Equal(7, (int)v.At(0).Get("id").AsLong());
}
