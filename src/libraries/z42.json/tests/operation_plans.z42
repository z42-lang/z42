namespace Std.Json.Tests;
using Std.Harness;
using Std.Collections;

public class PlannedRow { public int Id; public string Label; }
public class PlannedOther { public int Code; }

public class PlannedCtor {
    public string Label;
    public string Note = "initial";
    public PlannedCtor(string Label) { this.Label = Label; }
}

public class ObservePlanAttribute : Attribute {
    public static int Calls;
    public ObservePlanAttribute() {
        ObservePlanAttribute.Calls = ObservePlanAttribute.Calls + 1;
    }
}

public class AttributedPlanRow {
    [ObservePlan] [JsonProperty("id")] public int Id;
    [ObservePlan] [JsonIgnore] public int Secret;
}

[Test]
void test_operation_plans_reuse_matching_types_and_keep_distinct_types() {
    PlannedRow a = new PlannedRow();
    a.Id = 1;
    a.Label = "a";
    PlannedOther b = new PlannedOther();
    b.Code = 9;
    object[] mixed = new object[] { a, b, a };
    Assert.Equal("[{\"Id\":1,\"Label\":\"a\"},{\"Code\":9},{\"Id\":1,\"Label\":\"a\"}]",
        JsonSerializer.Serialize(mixed));

    PlannedCtor[] result = JsonSerializer.Deserialize<PlannedCtor[]>(
        "[{\"Label\":\"a\"},{\"Label\":\"b\",\"Note\":null},{\"Label\":\"c\",\"Note\":\"changed\"}]");
    Assert.Equal("a", result[0].Label);
    Assert.Equal("initial", result[0].Note);
    Assert.Equal("b", result[1].Label);
    Assert.True(result[1].Note == null);
    Assert.Equal("c", result[2].Label);
    Assert.Equal("changed", result[2].Note);
}

[Test]
void test_operation_plans_preserve_attribute_factories_per_object() {
    AttributedPlanRow a = new AttributedPlanRow();
    a.Id = 1;
    a.Secret = 7;
    AttributedPlanRow b = new AttributedPlanRow();
    b.Id = 2;
    b.Secret = 8;
    ObservePlanAttribute.Calls = 0;
    Assert.Equal("[{\"id\":1},{\"id\":2}]", JsonSerializer.Serialize(new AttributedPlanRow[] { a, b }));
    Assert.Equal(4, ObservePlanAttribute.Calls);
    AttributedPlanRow[] rows = JsonSerializer.Deserialize<AttributedPlanRow[]>(
        "[{\"id\":3,\"Secret\":9},{\"id\":4,\"Secret\":9}]");
    Assert.Equal(8, ObservePlanAttribute.Calls);
    Assert.Equal(3, rows[0].Id);
    Assert.Equal(4, rows[1].Id);
    Assert.Equal(0, rows[0].Secret);
}

[Test]
void test_collection_bindings_use_current_container() {
    List<int> emptyList = new List<int>();
    List<int> first = new List<int>();
    List<int> second = new List<int>();
    first.Add(1);
    second.Add(2);
    second.Add(3);
    List<string> labels = new List<string>();
    labels.Add("x");

    Dictionary<string, int> emptyDict = new Dictionary<string, int>();
    Dictionary<string, int> scores = new Dictionary<string, int>();
    Dictionary<string, int> later = new Dictionary<string, int>();
    Dictionary<string, string> notes = new Dictionary<string, string>();
    scores["a"] = 4;
    later["b"] = 5;
    notes["note"] = "y";

    object[] values = new object[] {
        emptyList, first, labels, second, emptyList, emptyDict, scores, notes, later, emptyDict
    };
    Assert.Equal("[[],[1],[\"x\"],[2,3],[],{},{\"a\":4},{\"note\":\"y\"},{\"b\":5},{}]",
        JsonSerializer.Serialize(values));
}
