// Micro-benchmarks for z42.json hot paths (2026-05-31) — dogfoods the
// [Benchmark] + Bencher machinery on parse + scalar access. Modest sample
// counts keep the correctness wave fast; run benchmarks only via
// `z42-test-runner <zbc> --filter bench_`.

namespace Z42JsonBench;

using Std;
using Std.Test;
using Std.Text;
using Std.Json;

// Build a ~KB JSON object literal with `keys` distinct members. Exercises the
// object-build path (Set per key) at a size where the old O(n²) linear-scan
// storage actually shows vs the O(n) key→slot index.
string _bigObjectDoc(int keys) {
    StringBuilder sb = new StringBuilder();
    sb.Append("{");
    int i = 0;
    while (i < keys) {
        if (i > 0) { sb.Append(","); }
        sb.Append("\"key");
        sb.Append(i.ToString());
        sb.Append("\":");
        sb.Append(i.ToString());
        i = i + 1;
    }
    sb.Append("}");
    return sb.ToString();
}

[Benchmark]
void bench_parse_large_object() {
    string doc = _bigObjectDoc(200);          // >1 KB, 200 members
    var b = new Bencher(2, 10);
    b.iter(() => {
        var v = JsonValue.Parse(doc);
        BenchHelpers.blackBox(v.Count());
    });
    b.printSummary("parse_large_object_200");
}

[Benchmark]
void bench_stringify_large_object() {
    var obj = JsonValue.OfObject();
    int i = 0;
    while (i < 200) {
        obj.Set("key" + i.ToString(), JsonValue.OfLong((long)i));
        i = i + 1;
    }
    var b = new Bencher(2, 10);
    b.iter(() => {
        BenchHelpers.blackBox(JsonValue.Stringify(obj));   // WriteObject Get-per-key now O(n)
    });
    b.printSummary("stringify_large_object_200");
}

[Benchmark]
void bench_parse_object() {
    var b = new Bencher(2, 20);
    string doc = "{\"name\":\"alice\",\"age\":30,\"active\":true,\"tags\":[1,2,3]}";
    b.iter(() => {
        var v = JsonValue.Parse(doc);
        BenchHelpers.blackBox(v);
    });
    b.printSummary("parse_object");
}

[Benchmark]
void bench_parse_scalar_access() {
    var b = new Bencher(2, 20);
    b.iter(() => {
        var v = JsonValue.Parse("42");
        long n = v.AsLong();
        BenchHelpers.blackBox(n);
    });
    b.printSummary("parse_scalar_access");
}

[Test]
void test_json_bench_bodies_run() {
    var b = new Bencher(1, 3);
    b.iter(() => {
        var v = JsonValue.Parse("true");
        BenchHelpers.blackBox(v.AsBool());
    });
    Assert.Equal(3, b.Samples);
    Assert.True(b.TotalNs > 0L);
}
