namespace Z42JsonEscapeScanBench;

using Std.Json;
using Std.Harness;

void MeasureJsonEscapeScan(string name, JsonValue value, bool pretty, int iterations) {
    var bench = new Bencher(4, 24);
    bench.iter(() => {
        for (int i = 0; i < iterations; i++) {
            string text = pretty ? JsonValue.StringifyPretty(value) : JsonValue.Stringify(value);
            BenchHelpers.blackBox(text);
        }
    });
    bench.printSummary(name);
}

JsonValue WideObject() {
    JsonValue value = JsonValue.OfObject();
    for (int i = 0; i < 200; i++) {
        value.Set("key" + i.ToString(), JsonValue.OfString("é中😀"));
    }
    return value;
}

string LongText(bool dense) {
    char[] chars = new char[16384];
    for (int i = 0; i < chars.Length; i++) {
        chars[i] = dense && i % 8 == 0 ? '\\' : '中';
    }
    return String.FromChars(chars);
}

[Benchmark]
void json_escape_scan_short() {
    MeasureJsonEscapeScan("json_escape_scan_short", JsonValue.OfString("é中😀"), false, 256);
}

[Benchmark]
void json_escape_scan_wide() {
    MeasureJsonEscapeScan("json_escape_scan_wide", WideObject(), false, 8);
}

[Benchmark]
void json_escape_scan_pretty() {
    JsonValue array = JsonValue.OfArray();
    array.Add(WideObject());
    MeasureJsonEscapeScan("json_escape_scan_pretty", array, true, 8);
}

[Benchmark]
void json_escape_scan_unicode() {
    MeasureJsonEscapeScan("json_escape_scan_unicode", JsonValue.OfString(LongText(false)), false, 4);
}

[Benchmark]
void json_escape_scan_late_escape() {
    MeasureJsonEscapeScan("json_escape_scan_late_escape", JsonValue.OfString(LongText(false) + "\\"), false, 4);
}

[Benchmark]
void json_escape_scan_dense() {
    MeasureJsonEscapeScan("json_escape_scan_dense", JsonValue.OfString(LongText(true)), false, 4);
}
