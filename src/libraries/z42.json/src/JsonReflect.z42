namespace Std.Json;
using Std.Reflection;

// 集合绑定仅在当前遍历内存活；不以 FullName 缓存跨加载上下文的反射对象。
internal static class JsonReflect {
    /// 取构造泛型的类型实参。
    public static Type GenericArg(Type t, int idx) {
        Type[] ga = t.GetGenericArguments();
        if (idx >= 0 && idx < ga.Length) { Type g = ga[idx]; return g; }
        throw new JsonException("Missing collection type argument: " + t.FullName);
    }

    /// 按名称、实例/非泛型形态及完整参数类型绑定唯一 public 方法。
    public static MethodInfo BindMethod(Type t, string name, Type[] parameterTypes) {
        MethodInfo[] ms = t.GetMethods();
        MethodInfo found = null;
        int i = 0;
        while (i < ms.Length) {
            MethodInfo m = ms[i];
            if (m.Name == name && m.IsPublic && !m.IsStatic && !m.IsGenericMethod) {
                ParameterInfo[] ps = m.GetParameters();
                bool matches = ps.Length == parameterTypes.Length;
                int j = 0;
                while (matches && j < ps.Length) {
                    Type pt = (Type)ps[j].ParameterType;
                    matches = pt == parameterTypes[j];
                    j = j + 1;
                }
                if (matches) {
                    if (found != null) throw new JsonException("Ambiguous collection method: " + name);
                    found = m;
                }
            }
            i = i + 1;
        }
        if (found == null) throw new JsonException("Missing collection method: " + name);
        return found;
    }

    /// 读取当前 List 的 Count；每次遍历只调用一次。
    public static int ListCount(object list, Type t) {
        PropertyInfo[] properties = t.GetProperties();
        foreach (PropertyInfo property in properties) {
            if (property.Name == "Count" && property.CanRead) {
                return (int)property.GetValue(list);
            }
        }
        throw new JsonException("Missing collection property: Count");
    }
}
