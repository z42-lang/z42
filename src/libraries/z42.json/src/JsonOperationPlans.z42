namespace Std.Json;
using Std.Collections;
using Std.Reflection;

internal class JsonTypePlan {
    /// 已绑定的字段及属性，null 表示仍需查询。
    public JsonMember[] Members;
    /// 是否已完成构造器选择。
    public bool ConstructorResolved;
    /// 选中的有参构造器，null 表示走默认创建路径。
    public ConstructorInfo Constructor;
    /// 已选有参构造器的参数。
    public ParameterInfo[] Parameters;

    private MethodInfo _listItem;
    private MethodInfo _dictionaryItem;
    // -2 is unknown, -1 requires the DOM's key replacement rules.
    private int _directMemberCount = -2;

    /// 已绑定的字典 Keys 方法。
    public MethodInfo DictionaryKeys;

    /// 绑定非空 List 的索引 getter。
    public MethodInfo GetListItem(Type t) {
        if (this._listItem == null) {
            this._listItem = JsonReflect.BindMethod(t, "get_Item", new Type[] { typeof(int) });
        }
        return this._listItem;
    }

    /// 按实际键类型绑定非空 Dictionary 的索引 getter。
    public MethodInfo GetDictionaryItem(Type t, JsonTypePlan keysPlan, MethodInfo[] methods) {
        if (this._dictionaryItem == null) {
            Type keyType = JsonReflect.GenericArg(t, 0);
            if (methods == null || !Object.ReferenceEquals(this, keysPlan)) {
                methods = t.GetMethods();
            }
            this._dictionaryItem = JsonReflect.BindMethod(methods, "get_Item", new Type[] { keyType });
        }
        return this._dictionaryItem;
    }

    /// 取得可复用的成员，或按当前类型查询。
    public JsonMember[] GetMembers(Type t) {
        if (this.Members != null) { return this.Members; }
        return JsonMembers.Build(t, this);
    }

    /// 返回可直接输出的成员数，负数表示须保留 DOM 对象槽位。
    public int DirectMemberCount(JsonMember[] members) {
        bool cacheable = Object.ReferenceEquals(this.Members, members);
        if (cacheable && this._directMemberCount != -2) { return this._directMemberCount; }
        int count = JsonTypePlan.CountUniqueMembers(members);
        if (cacheable) { this._directMemberCount = count; }
        return count;
    }

    private static int CountUniqueMembers(JsonMember[] members) {
        HashSet<string> seen = null;
        if (members.Length > 8) { seen = new HashSet<string>(); }
        int count = 0;
        for (int i = 0; i < members.Length; i = i + 1) {
            JsonMember member = members[i];
            if (!member.CanRead) { continue; }
            string key = member.JsonKey;
            if (key == null) { return -1; }
            if (seen != null) {
                if (!seen.Add(key)) { return -1; }
            } else {
                for (int j = 0; j < i; j = j + 1) {
                    if (members[j].CanRead && members[j].JsonKey == key) { return -1; }
                }
            }
            count = count + 1;
        }
        return count;
    }

    /// 按现有无参优先和最长签名规则选取构造器。
    public void ResolveConstructor(Type t) {
        ConstructorInfo[] ctors = t.GetConstructors();
        ConstructorInfo selected = null;
        ParameterInfo[] selectedParams = null;
        int mostParams = 0;
        int i = 0;
        while (i < ctors.Length) {
            ConstructorInfo ctor = ctors[i];
            ParameterInfo[] ps = ctor.GetParameters();
            if (ps.Length == 0) {
                this.ConstructorResolved = true;
                return;
            }
            if (ps.Length > mostParams) {
                selected = ctor;
                selectedParams = ps;
                mostParams = ps.Length;
            }
            i = i + 1;
        }
        this.Constructor = selected;
        this.Parameters = selectedParams;
        this.ConstructorResolved = true;
    }
}

internal class JsonOperationPlans {
    private long _revision;
    private Type _lastType;
    private JsonTypePlan _lastPlan;
    private Dictionary<Type, JsonTypePlan> _otherPlans;

    /// 取得当前加载器版本下实际类型的计划。
    public JsonTypePlan For(Type t) {
        long revision = Type.__ReflectionRevision();
        if (revision != this._revision) {
            this._revision = revision;
            this._lastType = null;
            this._lastPlan = null;
            this._otherPlans = null;
        }
        if (revision == 0) { return new JsonTypePlan(); }
        if (this._lastPlan != null && this._lastType.Equals(t)) { return this._lastPlan; }
        JsonTypePlan plan = null;
        if (this._otherPlans != null) {
            plan = this._otherPlans.GetValueOrDefault(t, null);
        } else if (this._lastPlan != null) {
            this._otherPlans = new Dictionary<Type, JsonTypePlan>();
            this._otherPlans.Set(this._lastType, this._lastPlan);
        }
        if (plan == null) {
            plan = new JsonTypePlan();
            if (this._otherPlans != null) { this._otherPlans.Set(t, plan); }
        }
        this._lastType = t;
        this._lastPlan = plan;
        return plan;
    }

    /// 取得可复用的成员，或按当前类型查询。
    public JsonMember[] GetMembers(Type t) {
        return this.For(t).GetMembers(t);
    }
}
