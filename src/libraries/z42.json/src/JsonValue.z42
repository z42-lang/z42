namespace Std.Json;
using Std.IO;
using Std.Collections;

// add-z42-json (2026-05-14)：JSON 值的运行时表示 + 入口点。
//
// 与 Std.Toml.TomlValue 同款 discriminated-union 设计：单 int kind +
// 多个 typed 槽位 + Is*/As* 谓词访问。详见 docs/reference/src/stdlib/json.md。
//
// kind 0=Null 1=Bool 2=Long 3=Double 4=String 5=Array 6=Object
//   （注意 Null 在 JSON 中是 first-class value，与 TOML 不同 —— TOML 无 null）
public class JsonValue {
    // `internal` (not `private`) so the same-package JsonWriter reads the
    // representation directly instead of through a method call per value.
    internal int _kind;
    private bool _bool;
    private long _long;
    private double _double;
    internal string _str;

    // Array storage (kind == 5)
    internal JsonValue[] _arrayItems;
    internal int _arrayCount;

    // Object storage as parallel key/value arrays (kind == 6). The arrays are
    // the source of truth and preserve insertion order (JSON output must be
    // order-stable). Small objects (≤ 8 keys — the common record shape)
    // find a key by a linear scan; past that `_objectIndex` maps key → slot so
    // ContainsKey / Get / Set stay O(1) average and building an n-key object is
    // O(n) rather than O(n²). The index is built on demand, so a small object
    // costs two arrays, not a Dictionary per object.
    internal string[] _objectKeys;
    internal JsonValue[] _objectValues;
    internal int _objectCount;
    private Dictionary<string, int> _objectIndex;   // null until the object exceeds 8 keys

    // ── Public entry points ──────────────────────────────────────────────

    /// Parse JSON text → root value. Throws JsonException with line/column
    /// on syntax error. Empty input is invalid per RFC 8259.
    public static JsonValue Parse(string text) {
        JsonParser p = new JsonParser(text);
        return (JsonValue)p.ParseDocument();
    }

    /// Relaxed (JSON5-style) parse — accepts `//` line comments,
    /// `/* */` block comments, and trailing commas in arrays/objects.
    /// Useful for tooling configs (`tsconfig.json`, `.vscode/settings.json`,
    /// Docker `compose.json`). Other JSON5 features (unquoted keys / hex
    /// literals / single-quoted strings) deferred.
    /// add-json-relaxed (2026-05-25).
    public static JsonValue ParseRelaxed(string text) {
        JsonParser p = JsonParser.Relaxed(text);
        return (JsonValue)p.ParseDocument();
    }

    /// Serialise to canonical compact JSON (no whitespace).
    public static string Stringify(JsonValue v) {
        JsonWriter w = new JsonWriter(false);
        return w.Write(v);
    }

    /// Serialise to pretty-printed JSON (2-space indent + newlines).
    public static string StringifyPretty(JsonValue v) {
        JsonWriter w = new JsonWriter(true);
        return w.Write(v);
    }

    // ── Stream overloads (add-stream-overloads-to-format-parsers, 2026-05-24) ──
    //
    // Thin wrappers over the string variants — Parse(Stream) drains the
    // source via StreamReader (UTF-8), WriteTo(Stream, v) emits via
    // StreamWriter (UTF-8). Neither closes the underlying Stream —
    // caller owns its lifecycle (matches the rest of the Stream
    // ecosystem's convention).

    /// Parse JSON from a UTF-8 byte Stream. Equivalent to
    /// `Parse(new StreamReader(s).ReadToEnd())` but spares the caller
    /// the boilerplate. The source Stream is read to EOF; not closed.
    ///
    /// NOTE: distinct name from `Parse(string)` (not an overload) to
    /// sidestep z42's overload-resolution limitation — the compiler
    /// can't reliably pick between `Parse(string)` and `Parse(Stream)`
    /// for callers passing a `string` (it picks the Stream variant
    /// and complains about type mismatch). Rename can be lifted once
    /// the compiler handles two-different-type-arity-1 overloads.
    public static JsonValue ParseStream(Stream source) {
        StreamReader r = new StreamReader(source);
        string text = r.ReadToEnd();
        JsonParser p = new JsonParser(text);
        return (JsonValue)p.ParseDocument();
    }

    /// Relaxed JSON parse from a UTF-8 byte Stream. Same JSON5-style
    /// liberties as `ParseRelaxed(string)`. add-json-relaxed (2026-05-25).
    public static JsonValue ParseRelaxedStream(Stream source) {
        StreamReader r = new StreamReader(source);
        string text = r.ReadToEnd();
        JsonParser p = JsonParser.Relaxed(text);
        return (JsonValue)p.ParseDocument();
    }

    /// Serialise compact JSON to a Stream as UTF-8 bytes. Does NOT
    /// close `dest` — caller owns its lifecycle. For pretty output use
    /// `WriteToPretty`.
    public static void WriteTo(Stream dest, JsonValue v) {
        StreamWriter w = new StreamWriter(dest);
        w.Write(JsonValue.Stringify(v));
        w.Flush();
    }

    /// Serialise pretty-printed JSON to a Stream as UTF-8 bytes. See
    /// `WriteTo` for lifecycle semantics.
    public static void WriteToPretty(Stream dest, JsonValue v) {
        StreamWriter w = new StreamWriter(dest);
        w.Write(JsonValue.StringifyPretty(v));
        w.Flush();
    }

    // ── Factories ────────────────────────────────────────────────────────

    public static JsonValue OfNull()         { JsonValue v = new JsonValue(); v._kind = 0; return v; }
    public static JsonValue OfBool(bool b)   { JsonValue v = new JsonValue(); v._kind = 1; v._bool = b; return v; }
    public static JsonValue OfLong(long n)   { JsonValue v = new JsonValue(); v._kind = 2; v._long = n; return v; }
    public static JsonValue OfDouble(double d) { JsonValue v = new JsonValue(); v._kind = 3; v._double = d; return v; }
    public static JsonValue OfString(string s) { JsonValue v = new JsonValue(); v._kind = 4; v._str = s; return v; }
    public static JsonValue OfArray() {
        JsonValue v = new JsonValue();
        v._kind = 5;
        v._arrayItems = new JsonValue[4];
        v._arrayCount = 0;
        return v;
    }
    public static JsonValue OfObject() {
        JsonValue v = new JsonValue();
        v._kind = 6;
        v._objectKeys = new string[4];
        v._objectValues = new JsonValue[4];
        v._objectCount = 0;
        v._objectIndex = null;
        return v;
    }

    // ── Predicates ───────────────────────────────────────────────────────

    public bool IsNull()   { return this._kind == 0; }
    public bool IsBool()   { return this._kind == 1; }
    public bool IsLong()   { return this._kind == 2; }
    public bool IsDouble() { return this._kind == 3; }
    public bool IsString() { return this._kind == 4; }
    public bool IsArray()  { return this._kind == 5; }
    public bool IsObject() { return this._kind == 6; }

    public string KindName() {
        int k = this._kind;
        if (k == 0) return "null";
        if (k == 1) return "bool";
        if (k == 2) return "long";
        if (k == 3) return "double";
        if (k == 4) return "string";
        if (k == 5) return "array";
        if (k == 6) return "object";
        return "unknown";
    }

    // ── Accessors (throw on wrong kind) ──────────────────────────────────

    public bool AsBool() {
        if (this._kind != 1) { throw new JsonException("expected bool, got " + this.KindName()); }
        return this._bool;
    }
    public long AsLong() {
        if (this._kind != 2) { throw new JsonException("expected long, got " + this.KindName()); }
        return this._long;
    }
    public double AsDouble() {
        if (this._kind == 2) { return (double)this._long; }   // promote int → double
        if (this._kind != 3) { throw new JsonException("expected number, got " + this.KindName()); }
        return this._double;
    }
    public string AsString() {
        if (this._kind != 4) { throw new JsonException("expected string, got " + this.KindName()); }
        return this._str;
    }

    // ── Object operations (kind == 6) ────────────────────────────────────

    public bool ContainsKey(string key) {
        if (this._kind != 6) { return false; }
        return this._slotOf(key) >= 0;
    }

    public JsonValue Get(string key) {
        if (this._kind != 6) {
            throw new JsonException("JsonGet on non-object value (" + this.KindName() + ")");
        }
        int slot = this._slotOf(key);
        if (slot < 0) {
            throw new JsonException("key not found: " + key);
        }
        return this._objectValues[slot];
    }

    // Slot of `key` in the object arrays, or -1. Linear scan up to 8 keys,
    // one dictionary probe above.
    private int _slotOf(string key) {
        if (this._objectIndex != null) {
            return this._objectIndex.GetValueOrDefault(key, -1);
        }
        string[] keys = this._objectKeys;
        int n = this._objectCount;
        for (int i = 0; i < n; i++) {
            if (keys[i] == key) { return i; }
        }
        return -1;
    }

    // ── 取即检查（取值与存在性测试合成一次）──────────────────────────
    //
    // 为什么要这一对：`ContainsKey(k)` + `Get(k)` 是**两次独立调用**，
    // 「ContainsKey 为真 ⇒ Get 不抛」是调用方手里的不变式，**编译器原理上看不见**。
    // 代价三样：键字面量写两遍（改一处漏一处 ⇒ 编译零诊断、运行期才抛）、
    // 同一个 对象 查两遍、以及「在不在」这件事没有任何编译期表示。
    //
    // 签名取 `bool TryX(ref T)` —— 与 `Int32.TryParse` 那套全仓统一
    // （值类型永不可空，可空返回这条路对 `long` / `bool` 走不通，见 E0476）。
    // 三个文档库（TOML / JSON / YAML）形状一致，见 `Std.Toml.TomlValue.TryGet`。

    /// 取即检查：命中则写入 `value` 并返回 true；未命中返回 false 且**不动** `value`。
    /// 本值不是 object 时返回 false 而**不抛** —— 与 `ContainsKey` 一致。
    public bool TryGet(string key, ref JsonValue value) {
        if (this._kind != 6) { return false; }
        int slot = this._slotOf(key);
        if (slot < 0) { return false; }
        value = this._objectValues[slot];
        return true;
    }

    /// 取即检查 + 取标量：命中则按 `T` 取值写入 `value` 并返回 true；未命中返回 false 且
    /// **不动** `value`（「有就覆盖默认值」一行写完）。
    ///
    /// ⚠️ 命中但**类型不符照抛** `JsonException`，与 `AsString()` / `AsLong()` 一字不差 ——
    /// 「键不在」与「值类型错」是两种失败，把后者吞成 false 会让数据里的类型错**静默退回默认值**。
    ///
    /// 支持的 `T`：`string` / `long` / `double` / `bool` / `JsonValue`（原样取子树）。
    /// 其它 `T` 抛异常：那是**调用方写错了代码**，返回 false 会把它伪装成「键不在」。
    public bool TryGetValue<T>(string key, ref T value) {
        JsonValue v = null;
        if (!this.TryGet(key, ref v)) { return false; }
        Type t = typeof(T);
        if (t == typeof(string))    { object o = v.AsString(); value = (T)o; return true; }
        if (t == typeof(long))      { object o = v.AsLong();   value = (T)o; return true; }
        if (t == typeof(double))    { object o = v.AsDouble(); value = (T)o; return true; }
        if (t == typeof(bool))      { object o = v.AsBool();   value = (T)o; return true; }
        if (t == typeof(JsonValue)) { object o = v;            value = (T)o; return true; }
        throw new JsonException("TryGetValue<" + t.FullName + "> is not supported — "
            + "use string / long / double / bool / JsonValue");
    }

    public void Set(string key, JsonValue v) {
        if (this._kind != 6) {
            throw new JsonException("JsonSet on non-object value (" + this.KindName() + ")");
        }
        int slot = this._slotOf(key);
        if (slot >= 0) {
            this._objectValues[slot] = v;   // overwrite in place, order preserved
            return;
        }
        int n = this._objectCount;
        if (n == this._objectKeys.Length) {
            int newCap = n * 2;
            if (newCap < 4) { newCap = 4; }
            string[] nk = new string[newCap];
            JsonValue[] nv = new JsonValue[newCap];
            for (int j = 0; j < n; j++) {
                nk[j] = this._objectKeys[j];
                nv[j] = this._objectValues[j];
            }
            this._objectKeys = nk;
            this._objectValues = nv;
        }
        this._objectKeys[n] = key;
        this._objectValues[n] = v;
        this._objectCount = n + 1;
        if (this._objectIndex != null) {
            this._objectIndex.Set(key, n);
        } else if (n + 1 > 8) {
            Dictionary<string, int> index = new Dictionary<string, int>();
            for (int j = 0; j <= n; j++) { index.Set(this._objectKeys[j], j); }
            this._objectIndex = index;
        }
    }

    public string[] Keys() {
        if (this._kind != 6) {
            throw new JsonException("ObjectKeys() on non-object value (" + this.KindName() + ")");
        }
        string[] result = new string[this._objectCount];
        int i = 0;
        while (i < this._objectCount) {
            result[i] = this._objectKeys[i];
            i = i + 1;
        }
        return result;
    }

    public int Count() {
        if (this._kind == 5) { return this._arrayCount; }
        if (this._kind == 6) { return this._objectCount; }
        throw new JsonException("JsonCount() on non-collection value (" + this.KindName() + ")");
    }

    // ── Array operations (kind == 5) ─────────────────────────────────────

    public int Length() {
        if (this._kind != 5) {
            throw new JsonException("JsonLength() on non-array value (" + this.KindName() + ")");
        }
        return this._arrayCount;
    }

    public JsonValue At(int i) {
        if (this._kind != 5) {
            throw new JsonException("JsonAt() on non-array value (" + this.KindName() + ")");
        }
        if (i < 0 || i >= this._arrayCount) {
            throw new JsonException("array index out of range");
        }
        return this._arrayItems[i];
    }

    public void Add(JsonValue v) {
        if (this._kind != 5) {
            throw new JsonException("JsonAdd() on non-array value (" + this.KindName() + ")");
        }
        if (this._arrayCount == this._arrayItems.Length) {
            int newCap = this._arrayItems.Length * 2;
            if (newCap < 4) { newCap = 4; }
            JsonValue[] na = new JsonValue[newCap];
            int j = 0;
            while (j < this._arrayCount) { na[j] = this._arrayItems[j]; j = j + 1; }
            this._arrayItems = na;
        }
        this._arrayItems[this._arrayCount] = v;
        this._arrayCount = this._arrayCount + 1;
    }
}
