namespace Std.Json;
using Std.Text;

// RFC 8259 JSON parser (recursive descent).
//
// Hot-path shape: the cursor scans the bulk-materialised `_chars` with **local**
// loops (`char[] cs = this._chars; int p = this._pos; … this._pos = p;`) instead of a
// `Peek()` / `Advance()` / `Eof()` call per character — each of those was a method
// call plus a `_src.Length` call, i.e. several calls per input character. Line /
// column are not tracked while scanning; `Err` derives them from `_pos` (count the
// `\n` before it) only when an error is actually raised.
public sealed class JsonParser {
    private string _src;
    // Bulk-materialised source chars (one `ToCharArray()`): per-char reads are array
    // indexing. `_src` is kept for `Substring`.
    private char[] _chars;
    private int _len;
    private int _pos;
    // When true, also accept JSON5 niceties (`//` + `/* */` comments, trailing commas
    // in arrays/objects, NaN / Infinity). Strict mode is RFC 8259.
    private bool _relaxed;
    // Recursion-depth guard: malicious deeply-nested input (e.g. thousands of `[`)
    // would otherwise blow the VM stack. Capped in ParseValue.
    private int _depth;

    public JsonParser(string src) {
        this._src = src;
        this._chars = src.ToCharArray();
        this._len = this._chars.Length;
        this._pos = 0;
        this._relaxed = false;
        this._depth = 0;
    }

    /// Relaxed-mode parser — JSON5-style `//` / `/* */` comments and
    /// trailing commas in arrays and objects accepted. Unquoted keys /
    /// hex literals / single-quoted strings stay deferred.
    public static JsonParser Relaxed(string src) {
        JsonParser p = new JsonParser(src);
        p._relaxed = true;
        return p;
    }

    public JsonValue ParseDocument() {
        this.SkipWhitespace();
        if (this._pos >= this._len) {
            throw this.Err("empty input (RFC 8259 requires at least one JSON value)");
        }
        JsonValue v = this.ParseValue();
        this.SkipWhitespace();
        if (this._pos < this._len) {
            throw this.Err("unexpected trailing characters after root value");
        }
        return v;
    }

    // ── Cursor helpers (cold paths; hot loops index `_chars` directly) ────

    private char Peek() {
        if (this._pos >= this._len) { return '\0'; }
        return this._chars[this._pos];
    }

    /// Error at the current position. Line / column (1-based) are derived from
    /// `_pos`: line = 1 + newlines before it, column = chars since the last one.
    private JsonException Err(string msg) {
        char[] cs = this._chars;
        int end = this._pos;
        if (end > this._len) { end = this._len; }
        int line = 1;
        int lastNl = -1;
        for (int i = 0; i < end; i++) {
            if (cs[i] == '\n') { line = line + 1; lastNl = i; }
        }
        return new JsonException(msg, line, this._pos - lastNl);
    }

    private void SkipWhitespace() {
        char[] cs = this._chars;
        int n = this._len;
        int p = this._pos;
        while (p < n) {
            char c = cs[p];
            if (c == ' ' || c == '\n' || c == '\r' || c == '\t') {
                p = p + 1;
                continue;
            }
            // Relaxed mode: consume `//` line and `/* */` block comments. A `/` that
            // starts no comment is left for the caller to reject.
            if (this._relaxed && c == '/') {
                this._pos = p;
                this.SkipCommentOrBail();
                if (this._pos == p) { break; }
                p = this._pos;
                continue;
            }
            break;
        }
        this._pos = p;
    }

    /// Skip a `//` or `/* */` comment if one starts at `_pos` (the caller has
    /// peeked the leading `/`); otherwise leave `_pos` unchanged. Throws on an
    /// unterminated block comment.
    private void SkipCommentOrBail() {
        char[] cs = this._chars;
        int n = this._len;
        int p = this._pos + 1;
        if (p >= n) { return; }
        if (cs[p] == '/') {
            // Line comment — consume until EOL or EOF.
            p = p + 1;
            while (p < n && cs[p] != '\n' && cs[p] != '\r') { p = p + 1; }
            this._pos = p;
            return;
        }
        if (cs[p] == '*') {
            // Block comment — consume until `*/`.
            p = p + 1;
            while (p < n) {
                if (cs[p] == '*' && p + 1 < n && cs[p + 1] == '/') {
                    this._pos = p + 2;
                    return;
                }
                p = p + 1;
            }
            this._pos = n;
            throw this.Err("unterminated block comment");
        }
    }

    private string CharToString(char c) {
        char[] arr = new char[1];
        arr[0] = c;
        return String.FromChars(arr);
    }

    // ── Value dispatch ───────────────────────────────────────────────────

    private JsonValue ParseValue() {
        // Depth guard: every nested container recurses through ParseValue, so
        // bounding it here caps total nesting (256). A throw abandons the whole
        // parse, so only the normal return path needs to restore the depth.
        this._depth = this._depth + 1;
        if (this._depth > 256) {
            throw this.Err("nesting too deep (max 256)");
        }
        this.SkipWhitespace();
        if (this._pos >= this._len) { throw this.Err("unexpected end of input"); }
        char c = this._chars[this._pos];
        JsonValue v = null;
        if (c == '"') { v = JsonValue.OfString(this.ParseString()); }
        else if (c == '{') { v = this.ParseObject(); }
        else if (c == '[') { v = this.ParseArray(); }
        else if (c == 't' || c == 'f') { v = this.ParseBool(); }
        else if (c == 'n') { v = this.ParseNull(); }
        else {
            // Relaxed-only: NaN / Infinity / -Infinity / -NaN / +Infinity.
            if (this._relaxed) { v = this.TryParseSpecialFloat(); }
            if (v == null) { v = this.ParseNumber(); }
        }
        this._depth = this._depth - 1;
        return v;
    }

    /// JSON5-style special float literals (`NaN`, `Infinity`, signed forms).
    /// Returns null when the current position is not one of those tokens — the
    /// caller falls through to standard `ParseNumber`.
    private JsonValue TryParseSpecialFloat() {
        bool neg = false;
        int savedPos = this._pos;
        if (this.Peek() == '-') { neg = true; this._pos = this._pos + 1; }
        else if (this.Peek() == '+') { this._pos = this._pos + 1; }
        if (this.TryLiteral("Infinity")) {
            double d = double.Parse("inf");
            if (neg) { d = 0.0 - d; }
            return JsonValue.OfDouble(d);
        }
        if (this.TryLiteral("NaN")) {
            return JsonValue.OfDouble(double.Parse("nan"));
        }
        // Not a special float — rewind so `ParseNumber` sees the original sign.
        this._pos = savedPos;
        return null;
    }

    private JsonValue ParseBool() {
        if (this.TryLiteral("true"))  { return JsonValue.OfBool(true); }
        if (this.TryLiteral("false")) { return JsonValue.OfBool(false); }
        throw this.Err("unrecognised value");
    }

    private JsonValue ParseNull() {
        if (this.TryLiteral("null")) { return JsonValue.OfNull(); }
        throw this.Err("unrecognised value");
    }

    private bool TryLiteral(string lit) {
        int len = lit.Length;
        int p = this._pos;
        if (p + len > this._len) { return false; }
        char[] cs = this._chars;
        for (int i = 0; i < len; i++) {
            if (cs[p + i] != lit.CharAt(i)) { return false; }
        }
        this._pos = p + len;
        return true;
    }

    // ── String ───────────────────────────────────────────────────────────

    private string ParseString() {
        if (this.Peek() != '"') {
            throw this.Err("expected '\"'");
        }
        // Fast path: no escapes before the closing quote → one Substring.
        char[] cs = this._chars;
        int n = this._len;
        int start = this._pos + 1;
        int p = start;
        while (p < n) {
            char c = cs[p];
            if (c == '"') {
                this._pos = p + 1;
                return this._src.Substring(start, p - start);
            }
            if (c == '\\' || (int)c < 32) { break; }
            p = p + 1;
        }
        // Slow path (escape / control char / unterminated): run-flush the ordinary
        // spans as Substrings into a builder, decode escapes in between.
        StringBuilder sb = new StringBuilder();
        int runStart = start;
        this._pos = p;
        while (this._pos < n) {
            char c = cs[this._pos];
            if (c == '"') {
                if (this._pos > runStart) { sb.Append(this._src.Substring(runStart, this._pos - runStart)); }
                this._pos = this._pos + 1;
                return sb.ToString();
            }
            if ((int)c < 32) {
                throw this.Err("unescaped control character in string");
            }
            if (c == '\\') {
                if (this._pos > runStart) { sb.Append(this._src.Substring(runStart, this._pos - runStart)); }
                this._pos = this._pos + 1;
                if (this._pos >= n) { throw this.Err("unterminated escape"); }
                char esc = cs[this._pos];
                this._pos = this._pos + 1;
                if (esc == '"')       { sb.Append("\""); }
                else if (esc == '\\') { sb.Append("\\"); }
                else if (esc == '/')  { sb.Append("/"); }
                else if (esc == 'n')  { sb.Append("\n"); }
                else if (esc == 't')  { sb.Append("\t"); }
                else if (esc == 'r')  { sb.Append("\r"); }
                else if (esc == 'b')  { sb.Append('\b'); }
                else if (esc == 'f')  { sb.Append('\f'); }
                else if (esc == 'u')  { sb.Append(this.ParseUnicodeEscape()); }
                else { throw this.Err("unknown escape: \\" + this.CharToString(esc)); }
                runStart = this._pos;
            } else {
                this._pos = this._pos + 1;
            }
        }
        throw this.Err("unterminated string");
    }

    /// Parse 4-digit hex, return a 1-char string. Handles surrogate pairs
    /// (😀 → single supplementary codepoint).
    private string ParseUnicodeEscape() {
        int v = this.ReadHex4();
        // High surrogate? Look for low surrogate \uDxxx pair.
        if (v >= 0xD800 && v <= 0xDBFF) {
            if (this._pos + 1 < this._len
                && this._chars[this._pos] == '\\'
                && this._chars[this._pos + 1] == 'u') {
                this._pos = this._pos + 2;
                int low = this.ReadHex4();
                if (low >= 0xDC00 && low <= 0xDFFF) {
                    int codepoint = 0x10000 + (v - 0xD800) * 0x400 + (low - 0xDC00);
                    char[] arr = new char[1];
                    arr[0] = (char)codepoint;
                    return String.FromChars(arr);
                }
                throw this.Err("invalid low surrogate after high surrogate");
            }
            throw this.Err("lone high surrogate without low surrogate");
        }
        if (v >= 0xDC00 && v <= 0xDFFF) {
            throw this.Err("lone low surrogate (no preceding high surrogate)");
        }
        char[] arr = new char[1];
        arr[0] = (char)v;
        return String.FromChars(arr);
    }

    private int ReadHex4() {
        int v = 0;
        int i = 0;
        while (i < 4) {
            int d = this.HexDigit(this.Peek());
            if (d < 0) { throw this.Err("invalid hex digit in \\u escape"); }
            v = v * 16 + d;
            this._pos = this._pos + 1;
            i = i + 1;
        }
        return v;
    }

    private int HexDigit(char c) {
        int code = (int)c;
        if (code >= 48 && code <= 57)  { return code - 48; }       // '0'..'9'
        if (code >= 97 && code <= 102) { return 10 + code - 97; }  // 'a'..'f'
        if (code >= 65 && code <= 70)  { return 10 + code - 65; }  // 'A'..'F'
        return -1;
    }

    // ── Number ───────────────────────────────────────────────────────────

    private JsonValue ParseNumber() {
        char[] cs = this._chars;
        int n = this._len;
        int start = this._pos;
        int p = start;
        bool neg = false;
        if (p < n && cs[p] == '-') { neg = true; p = p + 1; }

        // Integer part: 0 or [1-9][0-9]*. Accumulate it as we go — an integer of
        // ≤ 18 digits with no fraction / exponent is the common case and needs no
        // Substring + long.Parse.
        if (p >= n) {
            this._pos = p;
            throw this.Err("invalid number (expected digit)");
        }
        int fc = (int)cs[p];
        long acc = 0L;
        int digits = 0;
        if (fc == 48) {
            p = p + 1;
            digits = 1;
        } else {
            if (fc < 49 || fc > 57) {   // not 1..9
                this._pos = p;
                throw this.Err("invalid number (expected digit)");
            }
            while (p < n) {
                int cc = (int)cs[p];
                if (cc < 48 || cc > 57) { break; }
                acc = acc * 10L + (long)(cc - 48);
                digits = digits + 1;
                p = p + 1;
            }
        }
        bool isFloat = p < n && (cs[p] == '.' || cs[p] == 'e' || cs[p] == 'E');
        if (!isFloat && digits <= 18) {
            this._pos = p;
            return JsonValue.OfLong(neg ? 0L - acc : acc);
        }

        // Fraction
        if (p < n && cs[p] == '.') {
            p = p + 1;
            // Need at least one digit
            if (p >= n || (int)cs[p] < 48 || (int)cs[p] > 57) {
                this._pos = p;
                throw this.Err("invalid number (expected digit after '.')");
            }
            while (p < n && (int)cs[p] >= 48 && (int)cs[p] <= 57) { p = p + 1; }
        }

        // Exponent
        if (p < n && (cs[p] == 'e' || cs[p] == 'E')) {
            p = p + 1;
            if (p < n && (cs[p] == '+' || cs[p] == '-')) { p = p + 1; }
            if (p >= n || (int)cs[p] < 48 || (int)cs[p] > 57) {
                this._pos = p;
                throw this.Err("invalid number (expected digit in exponent)");
            }
            while (p < n && (int)cs[p] >= 48 && (int)cs[p] <= 57) { p = p + 1; }
        }

        this._pos = p;
        string raw = this._src.Substring(start, p - start);
        if (isFloat) {
            return JsonValue.OfDouble(double.Parse(raw));
        }
        // ≥ 19 digits: try i64; on overflow fall back to f64 (lossy — matches
        // serde_json). `raw` is already validated as an integer, so the only way
        // long.Parse fails is overflow → double.Parse always succeeds.
        try {
            return JsonValue.OfLong(long.Parse(raw));
        } catch (Exception e) {
            return JsonValue.OfDouble(double.Parse(raw));
        }
    }

    // ── Object ───────────────────────────────────────────────────────────

    private JsonValue ParseObject() {
        if (this.Peek() != '{') { throw this.Err("expected '{'"); }
        this._pos = this._pos + 1;
        JsonValue obj = JsonValue.OfObject();
        this.SkipWhitespace();
        if (this.Peek() == '}') {
            this._pos = this._pos + 1;
            return obj;
        }
        while (true) {
            this.SkipWhitespace();
            // Relaxed mode: trailing `,` before `}` is allowed.
            if (this._relaxed && this.Peek() == '}') {
                this._pos = this._pos + 1;
                return obj;
            }
            if (this.Peek() != '"') {
                throw this.Err("expected '\"' (object key must be string)");
            }
            string key = this.ParseString();
            this.SkipWhitespace();
            if (this.Peek() != ':') {
                throw this.Err("expected ':' after object key");
            }
            this._pos = this._pos + 1;
            JsonValue val = this.ParseValue();
            obj.Set(key, val);
            this.SkipWhitespace();
            char c = this.Peek();
            if (c == ',') {
                this._pos = this._pos + 1;
                continue;
            }
            if (c == '}') {
                this._pos = this._pos + 1;
                return obj;
            }
            throw this.Err("expected ',' or '}' in object");
        }
        return obj;
    }

    // ── Array ────────────────────────────────────────────────────────────

    private JsonValue ParseArray() {
        if (this.Peek() != '[') { throw this.Err("expected '['"); }
        this._pos = this._pos + 1;
        JsonValue arr = JsonValue.OfArray();
        this.SkipWhitespace();
        if (this.Peek() == ']') {
            this._pos = this._pos + 1;
            return arr;
        }
        while (true) {
            // Relaxed mode: trailing `,` before `]` is allowed.
            if (this._relaxed) {
                this.SkipWhitespace();
                if (this.Peek() == ']') {
                    this._pos = this._pos + 1;
                    return arr;
                }
            }
            JsonValue v = this.ParseValue();
            arr.Add(v);
            this.SkipWhitespace();
            char c = this.Peek();
            if (c == ',') {
                this._pos = this._pos + 1;
                continue;
            }
            if (c == ']') {
                this._pos = this._pos + 1;
                return arr;
            }
            throw this.Err("expected ',' or ']' in array");
        }
        return arr;
    }
}
