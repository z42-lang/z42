namespace Std.Json;

/// JSON 序列化器（紧凑或缩进）。
public sealed class JsonWriter {
    private bool _pretty;

    /// `pretty=true` 输出换行 + 两空格缩进，否则单行紧凑格式。
    public JsonWriter(bool pretty) {
        this._pretty = pretty;
    }

    /// 每次调用写出一个独立 JSON 文档。遍历失败的异常向调用方传播。
    public string Write(JsonValue v) {
        JsonWriteBuffer buffer = new JsonWriteBuffer(this._pretty);
        return buffer.Write(v);
    }
}

// Each buffer belongs to one traversal, including its partial output on failure.
internal class JsonWriteBuffer {
    // Output pieces are collected in a private `string[]` and joined once with
    // `String.ConcatParts` — the same scheme as `StringBuilder`, minus a method call
    // and a length update per piece. Values are read straight from JsonValue's
    // (package-internal) representation instead of through `Is*` / `As*` / `Keys()` /
    // `Get(key)` calls per value.
    private string[] _parts;
    private int _n;
    private bool _pretty;
    private int _depth;
    // One newline prefix for each remainder of an eight-level indentation block.
    private static string[] _indentPrefixes = new string[] {
        "\n", "\n  ", "\n    ", "\n      ", "\n        ", "\n          ", "\n            ", "\n              "
    };

    /// 为单次遍历初始化片段数组和排版配置。
    public JsonWriteBuffer(bool pretty) {
        this._parts = new string[64];
        this._n = 0;
        this._pretty = pretty;
        this._depth = 0;
    }

    /// 遍历一个值并拼接完整文档。每个缓冲实例调用一次。
    public string Write(JsonValue v) {
        this.WriteValue(v);
        return String.ConcatParts(this._parts, this._n);
    }

    /// 遍历一个值并拼接 UTF-8 字节。每个缓冲实例调用一次。
    internal byte[] WriteUtf8(JsonValue v) {
        this.WriteValue(v);
        return String.ConcatPartsUtf8(this._parts, this._n);
    }

    private void Put(string s) {
        int n = this._n;
        if (n == this._parts.Length) {
            string[] bigger = new string[n * 2];
            Array.Copy(this._parts, bigger, n);
            this._parts = bigger;
        }
        this._parts[n] = s;
        this._n = n + 1;
    }

    private void WriteValue(JsonValue v) {
        int k = v._kind;
        if (k == 4) { this.PutQuoted(v._str); return; }
        if (k == 2) { this.Put(v.AsLong().ToString()); return; }
        if (k == 6) { this.WriteObject(v); return; }
        if (k == 5) { this.WriteArray(v); return; }
        if (k == 1) { this.Put(v.AsBool() ? "true" : "false"); return; }
        if (k == 0) { this.Put("null"); return; }
        if (k == 3) { this.Put(v.AsDouble().ToString()); return; }
        throw new JsonException("unknown JsonValue kind in stringify");
    }

    private void WriteArray(JsonValue arr) {
        int n = arr._arrayCount;
        if (n == 0) {
            this.Put("[]");
            return;
        }
        JsonValue[] items = arr._arrayItems;
        this.Put("[");
        this._depth = this._depth + 1;
        for (int i = 0; i < n; i++) {
            if (i > 0) { this.Put(","); }
            if (this._pretty) { this.PutNewlineIndent(); }
            this.WriteValue(items[i]);
        }
        this._depth = this._depth - 1;
        if (this._pretty) { this.PutNewlineIndent(); }
        this.Put("]");
    }

    private void WriteObject(JsonValue obj) {
        int n = obj._objectCount;
        if (n == 0) {
            this.Put("{}");
            return;
        }
        string[] keys = obj._objectKeys;
        JsonValue[] values = obj._objectValues;
        string colon = this._pretty ? ": " : ":";
        this.Put("{");
        this._depth = this._depth + 1;
        for (int i = 0; i < n; i++) {
            if (i > 0) { this.Put(","); }
            if (this._pretty) { this.PutNewlineIndent(); }
            this.PutQuoted(keys[i]);
            this.Put(colon);
            this.WriteValue(values[i]);
        }
        this._depth = this._depth - 1;
        if (this._pretty) { this.PutNewlineIndent(); }
        this.Put("}");
    }

    private void PutNewlineIndent() {
        int depth = this._depth;
        this.Put(JsonWriteBuffer._indentPrefixes[depth & 7]);
        for (int blocks = depth >> 3; blocks > 0; blocks = blocks - 1) { this.Put("                "); }
    }

    // `"s"` with JSON string escapes: control chars and `"` / `\`. Non-ASCII
    // passes through as raw UTF-8 (RFC 8259 §7 allows this). A string with
    // nothing to escape (the usual case) is emitted as-is between the quotes;
    // otherwise ordinary runs are flushed as bulk Substrings between escapes.
    private void PutQuoted(string s) {
        this.Put("\"");
        char[] cs = s.ToCharArray();
        int n = cs.Length;
        int runStart = 0;   // start of the current run of ordinary (unescaped) chars
        for (int i = 0; i < n; i++) {
            int cc = (int)cs[i];
            if (cc >= 32 && cc != 34 && cc != 92) { continue; }
            string esc = "";
            if (cc == 34)      { esc = "\\\""; }
            else if (cc == 92) { esc = "\\\\"; }
            else if (cc == 10) { esc = "\\n"; }
            else if (cc == 9)  { esc = "\\t"; }
            else if (cc == 13) { esc = "\\r"; }
            else if (cc == 8)  { esc = "\\b"; }
            else if (cc == 12) { esc = "\\f"; }
            else               { esc = this.UnicodeEscape(cc); }
            if (i > runStart) { this.Put(s.Substring(runStart, i - runStart)); }
            this.Put(esc);
            runStart = i + 1;
        }
        if (runStart == 0) { this.Put(s); }
        else if (n > runStart) { this.Put(s.Substring(runStart, n - runStart)); }
        this.Put("\"");
    }

    private string UnicodeEscape(int v) {
        string hex = "0123456789ABCDEF";
        char[] arr = new char[6];
        arr[0] = '\\';
        arr[1] = 'u';
        arr[2] = hex.CharAt((v >> 12) & 0xF);
        arr[3] = hex.CharAt((v >> 8) & 0xF);
        arr[4] = hex.CharAt((v >> 4) & 0xF);
        arr[5] = hex.CharAt(v & 0xF);
        return String.FromChars(arr);
    }
}
