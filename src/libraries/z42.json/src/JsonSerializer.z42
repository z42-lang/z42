namespace Std.Json;
using Std.Reflection;

/// 对象 ↔ JSON 序列化：经反射在用户对象与 JSON 文本之间直转。
///
/// 序列化按对象**运行期类型**递归（多态元素随其真实类型）；反序列化按**目标 Type** 递归
/// （JsonBinder）。成员统一由 JsonMembers 提供（字段 + 属性）；[JsonProperty]/[JsonIgnore] 生效。
public static class JsonSerializer {
    /// 把 `value` 序列化为紧凑 JSON 文本（无换行缩进）；null 序列化为 "null"。
    public static string Serialize(object value) {
        return JsonValue.Stringify(JsonSerializer._toJson(value, null));
    }

    /// 同 Serialize，但输出按两层缩进换行的易读格式。
    public static string SerializePretty(object value) {
        return JsonValue.StringifyPretty(JsonSerializer._toJson(value, null));
    }

    /// 解析 `json` 并按 `T` 绑定返回；JSON null / 语法错误按 JsonBinder / JsonParser 语义抛出。
    public static T Deserialize<T>(string json) {
        return (T)JsonBinder.FromJson(typeof(T), JsonValue.Parse(json));
    }

    /// 同泛型版 Deserialize，目标类型运行期给定（多态反序列化入口）。
    public static object Deserialize(Type type, string json) {
        return JsonBinder.FromJson(type, JsonValue.Parse(json));
    }

    // object → JsonValue（按运行期类型分派）。
    private static JsonValue _toJson(object o, JsonOperationPlans plans) {
        if (o == null) { return JsonValue.OfNull(); }
        int scalar = Type.__JsonScalarKind(o);
        if (scalar == 1) { return JsonValue.OfLong((long)(int)o); }
        if (scalar == 2) { return JsonValue.OfLong((long)o); }
        if (scalar == 3) { return JsonValue.OfDouble((double)o); }
        if (scalar == 4) { return JsonValue.OfBool((bool)o); }
        if (scalar == 5) { return JsonValue.OfString((string)o); }
        Type t = (Type)o.GetType();   // 跨包 imported 返回类型须 cast（footgun）
        string fn = t.FullName;
        if (fn == "Std.Int32")   { return JsonValue.OfLong((long)(int)o); }
        if (fn == "Std.Int64")   { return JsonValue.OfLong((long)o); }
        if (fn == "Std.Double")  { return JsonValue.OfDouble((double)o); }
        if (fn == "Std.Boolean") { return JsonValue.OfBool((bool)o); }
        if (fn == "Std.String")  { return JsonValue.OfString((string)o); }
        if (plans == null) { plans = new JsonOperationPlans(); }
        if (t.IsArray) { return JsonSerializer._arrayToJson(o, plans); }
        // add-collection-serde：集合检测**先于**通用对象分派（否则 List/Dict 被当对象遍历内部字段）。
        // fix-type-reflection-names 起构造型泛型 FullName 含实参，故按去实参的**基名**匹配。
        string baseFn = fn;
        int lt = fn.IndexOf("<");
        if (lt >= 0) { baseFn = fn.Substring(0, lt); }
        if (baseFn == "Std.Collections.List")       { return JsonSerializer._listToJson(o, t, plans); }
        if (baseFn == "Std.Collections.Dictionary") { return JsonSerializer._dictToJson(o, t, plans); }
        return JsonSerializer._objectToJson(o, t, plans);
    }

    // List<T> → JSON array（反射 Count + get_Item 遍历，元素按运行期类型递归）。
    private static JsonValue _listToJson(object o, Type t, JsonOperationPlans plans) {
        JsonValue arr = JsonValue.OfArray();
        int n = JsonReflect.ListCount(o, t);
        if (n == 0) { return arr; }
        MethodInfo getter = plans.For(t).GetListItem(t);
        object[] args = new object[1];
        int i = 0;
        while (i < n) {
            args[0] = i;
            arr.Add(JsonSerializer._toJson(getter.Invoke(o, args), plans));
            i = i + 1;
        }
        return arr;
    }

    // Dictionary<string,V> → JSON object（反射 Keys + get_Item，键为字符串）。
    private static JsonValue _dictToJson(object o, Type t, JsonOperationPlans plans) {
        JsonValue obj = JsonValue.OfObject();
        JsonTypePlan plan = plans.For(t);
        MethodInfo[] methods = null;
        if (plan.DictionaryKeys == null) {
            methods = t.GetMethods();
            plan.DictionaryKeys = JsonReflect.BindMethod(methods, "Keys", new Type[0]);
        }
        MethodInfo keysMethod = plan.DictionaryKeys;
        string[] keys = (string[])keysMethod.Invoke(o, new object[0]);
        if (keys.Length == 0) { return obj; }
        JsonTypePlan itemPlan = plans.For(t);
        MethodInfo getter = itemPlan.GetDictionaryItem(t, plan, methods);
        object[] args = new object[1];
        int i = 0;
        while (i < keys.Length) {
            string k = keys[i];
            args[0] = k;
            obj.Set(k, JsonSerializer._toJson(getter.Invoke(o, args), plans));
            i = i + 1;
        }
        return obj;
    }

    private static JsonValue _arrayToJson(object o, JsonOperationPlans plans) {
        JsonValue arr = JsonValue.OfArray();
        Array a = (Array)o;                       // object → Array 下转型（元素以运行期 Type 反射读）
        int n = a.Length;
        int i = 0;
        while (i < n) {
            arr.Add(JsonSerializer._toJson(a.GetValue(i), plans));
            i = i + 1;
        }
        return arr;
    }

    private static JsonValue _objectToJson(object o, Type t, JsonOperationPlans plans) {
        JsonValue obj = JsonValue.OfObject();
        JsonMember[] members = plans.GetMembers(t);
        int i = 0;
        while (i < members.Length) {
            JsonMember m = members[i];
            if (m.CanRead) {
                obj.Set(m.JsonKey, JsonSerializer._toJson(m.Get(o), plans));
            }
            i = i + 1;
        }
        return obj;
    }
}
