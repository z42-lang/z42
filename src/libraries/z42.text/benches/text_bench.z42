// Micro-benchmarks for z42.text hot paths — StringBuilder growth, Levenshtein DP,
// Strings helpers. Baseline data for the 0.4.x perf stream; modest sample counts
// keep the correctness wave fast. Run via `z42 xtask.zpkg bench stdlib z42.text`
// (add `--format json` on z42b for structured bench_stats).

namespace Z42TextBench;

using Std.Harness;
using Std.Text;

[Benchmark]
void bench_stringbuilder_append() {
    var sb = new StringBuilder();
    int i = 0;
    while (i < 128) {
        sb.Append("ab");
        i = i + 1;
    }
    GC.KeepAlive(sb.ToString());
}

[Benchmark]
void bench_stringbuilder_append_char() {
    var b = new Bencher(4, 24);
    b.iter(() => {
        var sb = new StringBuilder();
        for (int i = 0; i < 256; i = i + 1) {
            sb.Append('a').Append('é').Append('中').Append('😀');
        }
        GC.KeepAlive(sb.ToString());
    });
    b.printSummary("stringbuilder_append_char");
}

[Benchmark]
void bench_levenshtein() {
    int d = Levenshtein.Distance("benchmark structures", "benchmark structure!")
          + Levenshtein.Distance("kitten", "sitting");
    GC.KeepAlive(d);
}

[Benchmark]
void bench_strings_repeat_pad() {
    string r = Strings.Repeat("xy", 32);
    string p = Strings.PadLeft("42", 16, '0');
    GC.KeepAlive(r + p);
}

// Smoke [Test] — bench bodies actually run, independent of timing.
[Test]
void test_text_bench_bodies_run() {
    var b = new Bencher(1, 3);
    b.iter(() => {
        var sb = new StringBuilder();
        sb.Append("x");
        GC.KeepAlive(sb.GetLength());
    });
    Assert.Equal(3, b.Samples);
    Assert.True(b.TotalNs > 0L);
}
