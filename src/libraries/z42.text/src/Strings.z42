namespace Std.Text;

// `Std.Text.Strings` —— `Std.String` 上没有的常见字符串 shaping 静态工具。放在 z42.text 而不是 prelude
// 的 `Std.String` 上，是因为 prelude 的每个方法都会进所有脚本的命名空间；这些工具有用但不够通用，按需
// `using Std.Text` 才看到更合适。
public static class Strings {

    /// 左侧补 `fill` 到长度 `width`。`s` 已够长时原样返回，**不截断**。
    ///
    /// 例：`PadLeft("42", 5, '0')` → `"00042"`；`PadLeft("hello", 3, '*')` → `"hello"`。
    public static string PadLeft(string s, int width, char fill) {
        int len = s.Length;
        if (len >= width) return s;
        int needed = width - len;
        char[] buf = new char[width];
        for (int i = 0; i < needed; i++) {
            buf[i] = fill;
        }
        for (int i = 0; i < len; i++) {
            buf[needed + i] = s.CharAt(i);
        }
        return string.FromChars(buf);
    }

    /// 右侧补 `fill` 到长度 `width`。`s` 已够长时原样返回，不截断。
    ///
    /// 例：`PadRight("hi", 5, '.')` → `"hi..."`。
    public static string PadRight(string s, int width, char fill) {
        int len = s.Length;
        if (len >= width) return s;
        char[] buf = new char[width];
        for (int i = 0; i < len; i++) {
            buf[i] = s.CharAt(i);
        }
        for (int i = len; i < width; i++) {
            buf[i] = fill;
        }
        return string.FromChars(buf);
    }

    /// 重复 `s` `count` 次。`count <= 0` 或空 `s` → `""`。
    ///
    /// 例：`Repeat("ab", 3)` → `"ababab"`。
    public static string Repeat(string s, int count) {
        if (count <= 0) {
            return "";
        }
        int srcLen = s.Length;
        if (srcLen == 0) {
            return "";
        }
        int totalLen = srcLen * count;
        char[] buf = new char[totalLen];
        for (int r = 0; r < count; r++) {
            int offset = r * srcLen;
            for (int i = 0; i < srcLen; i++) {
                buf[offset + i] = s.CharAt(i);
            }
        }
        return string.FromChars(buf);
    }

    /// `s` 中第一个出现在 `chars` 里的字符的下标；无匹配返回 `-1`。`chars` 为空数组恒返回 `-1`。
    ///
    /// 例：`IndexOfAny("hello", new char[]{'l', 'x'})` → `2`。
    public static int IndexOfAny(string s, char[] chars) {
        int sLen = s.Length;
        int cLen = chars.Length;
        for (int i = 0; i < sLen; i++) {
            char c = s.CharAt(i);
            for (int j = 0; j < cLen; j++) {
                if (chars[j] == c) {
                    return i;
                }
            }
        }
        return -1;
    }

    /// 从**两端**去掉所有属于 `chars` 的字符。`chars` 为空数组时原样返回。
    ///
    /// 例：`TrimChars("***hi***", new char[]{'*'})` → `"hi"`。
    public static string TrimChars(string s, char[] chars) {
        int len = s.Length;
        int cLen = chars.Length;
        if (cLen == 0) {
            return s;
        }
        int start = 0;
        int end = len;
        while (start < end && ContainsChar(chars, s.CharAt(start))) {
            start = start + 1;
        }
        while (end > start && ContainsChar(chars, s.CharAt(end - 1))) {
            end = end - 1;
        }
        if (start == 0 && end == len) {
            return s;
        }
        return s.Substring(start, end - start);
    }

    // ── 私有辅助 ────────────────────────────────────────────────────────────

    private static bool ContainsChar(char[] chars, char c) {
        int n = chars.Length;
        for (int i = 0; i < n; i++) {
            if (chars[i] == c) {
                return true;
            }
        }
        return false;
    }
}
