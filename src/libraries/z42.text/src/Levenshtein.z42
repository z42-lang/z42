namespace Std.Text;

// Levenshtein 编辑距离 + 相似度。O(|a|·|b|) 时间、O(min(|a|,|b|)) 空间（两行 DP）。
// 用途：命令拼写纠正（"did you mean: status?"）、拼写检查、配置键的容错查找。
public static class Levenshtein {
    /// `a` 变成 `b` 所需的单字符插入 / 删除 / 替换的最少次数。对称；相同字符串返回 `0`，一侧为空时返回另一侧长度。
    public static int Distance(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        if (la == 0) return lb;
        if (lb == 0) return la;
        // 用较短串驱动行宽，最小化分配。
        string s; string t;
        if (la <= lb) { s = a; t = b; } else { s = b; t = a; }
        int ls = s.Length;     // smaller
        int lt = t.Length;     // larger

        // 两个串各物化一次：内层 DP 循环读 s[k-1] O(ls·lt) 次，逐字符 CharAt 会支配开销，
        // 数组下标（ArrayGet）是单指令。
        char[] sarr = s.ToCharArray();
        char[] tarr = t.ToCharArray();

        // 两行：上一行与当前行，下标 0..ls。
        int[] prev = new int[ls + 1];
        int[] cur  = new int[ls + 1];
        int j = 0;
        while (j <= ls) { prev[j] = j; j = j + 1; }

        int i = 1;
        while (i <= lt) {
            cur[0] = i;
            char tc = tarr[i - 1];
            int k = 1;
            while (k <= ls) {
                char sc = sarr[k - 1];
                int subCost = (sc == tc) ? 0 : 1;
                int del = prev[k] + 1;
                int ins = cur[k - 1] + 1;
                int sub = prev[k - 1] + subCost;
                int best = del;
                if (ins < best) best = ins;
                if (sub < best) best = sub;
                cur[k] = best;
                k = k + 1;
            }
            // swap prev <-> cur for next iteration
            int[] tmp = prev;
            prev = cur;
            cur = tmp;
            i = i + 1;
        }
        return prev[ls];
    }

    /// 相似度，落在 `[0.0, 1.0]`：`1.0 - Distance(a, b) / max(len(a), len(b))`。两个空串返回 `1.0`。
    public static double SimilarityRatio(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        int max = la > lb ? la : lb;
        if (max == 0) return 1.0;
        int d = Distance(a, b);
        return 1.0 - (double)d / (double)max;
    }
}
