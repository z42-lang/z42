//! 字符串构建与文本工具。
//!
//! 三个类型：可变字符串缓冲 [`StringBuilder`]、字符串 shaping 静态工具 [`Strings`]、编辑距离静态工具
//! [`Levenshtein`]。`string` 本身的方法（`Substring` / `Split` / `Replace` / `IndexOf` / `CharAt` …）
//! 在 prelude 的 `Std.String` 上，不需要导入本包；正则表达式在 [`Std.Regex.Regex`]，不在本包。
//!
//! ## 不支持
//!
//! - `StringBuilder.Length` 没有 setter（不能用 `sb.Length = 0` 截断 / 补 `'\0'`）；截断用
//!   `Remove(n, Length - n)`，清空用 `Clear()`。
//! - `StringBuilder` 没有容量构造器与 `Capacity` / `EnsureCapacity` / `MaxCapacity`，只有无参构造器。
//! - `StringBuilder` 没有区间重载：`Append(string, start, count)`、`Replace(old, new, start, count)`、
//!   `ToString(start, length)`、`CopyTo` 都没有；也没有 `Replace(char, char)`。
//! - `StringBuilder` 不支持 `foreach`（无 `GetEnumerator()`）。要逐字符处理，先把 `ToCharArray()`
//!   存进局部变量再遍历（直接写在 `foreach` 的 `in` 位置会取到 `null`）。
//! - `Strings` 没有默认 `fill`：`PadLeft` / `PadRight` 必须显式给填充字符。
//! - `Strings` 没有 `TrimStart` / `TrimEnd` / `LastIndexOfAny` / `Join` / `Split` 系列。
//! - `Levenshtein` 没有距离上限剪枝参数，也没有 Damerau–Levenshtein（相邻换位不算一次编辑）。
namespace Std.Text;

// Mutable string builder —— Script-First 实现，基于 z42.core 原语（`string[]` + 手动扩容 +
// `String.FromChars`）。Append 收集进 `string[]` buffer（2× 扩容），ToString 时一次性合并成 char[]
// 再 FromChars，避免每次 Append 都拼接的 O(n²) 开销。不用 `List<string>` 是因为 stdlib 字段类型暂不
// 支持泛型实例化语法。
public class StringBuilder {
    string[] _parts;
    int _count;
    int _capacity;
    int _length;

    /// 无参构造，初始容量 4。
    public StringBuilder() {
        this._capacity = 4;
        this._parts = new string[4];
        this._count = 0;
        this._length = 0;
    }

    // 追加字符串的快速路径：跳过 `Append(object)` 的 `Convert.ToString` 虚分派与装箱。JSON/TOML/YAML
    // 的 run-flush 解析器就是整段 `Substring` 追加，所以按引用存 `string[]`、ToString 时只拷一次最省。
    /// 追加一个字符串。
    public StringBuilder Append(string value) {
        if (this._count == this._capacity) {
            this.Grow();
        }
        this._parts[this._count] = value;
        this._count = this._count + 1;
        this._length = this._length + value.Length;
        return this;
    }

    // 追加单个字符：run-flush 路径上很少见（只有转义字符），每次分配 1 字符串可接受。
    /// 追加一个字符。
    public StringBuilder Append(char value) {
        char[] one = new char[1];
        one[0] = value;
        return this.Append(String.FromChars(one));
    }

    /// 追加任意值，经 `Convert.ToString` 转成字符串再追加。
    public StringBuilder Append(object value) {
        return this.Append(Convert.ToString(value));
    }

    /// 追加 `value` 再追加一个换行。
    public StringBuilder AppendLine(object value) {
        this.Append(value);
        return this.Append("\n");
    }

    /// 只追加一个换行。
    public StringBuilder AppendLine() {
        return this.Append("\n");
    }

    /// 当前字符数。
    public int GetLength() {
        return this._length;
    }

    // ── C# System.Text.StringBuilder 对齐（corelib alignment）────────────────
    // 随机访问与原地编辑（indexer / Insert / Remove / Replace）不直接映射到 `string[]` parts buffer，
    // 所以先 ToString() 物化成单串，再用 _setSingle 重置。每次编辑 O(n)，符合 StringBuilder
    // 「大量 Append、偶尔编辑」的用法。

    /// 当前字符数（只读属性）。
    public int Length {
        get { return this._length; }
    }

    // 按绝对下标随机访问字符。indexer 的 get/set 体只接受单表达式，故委托给 _charAt / _setCharAt。
    /// 按字符位置读写。越界抛 `Exception`。
    public char this[int index] {
        get { return this._charAt(index); }
        set { this._setCharAt(index, value); }
    }

    char _charAt(int index) {
        if (index < 0 || index >= this._length) {
            throw new Exception($"StringBuilder index out of range: {index} (Length={this._length})");
        }
        int remaining = index;
        for (int i = 0; i < this._count; i++) {
            string s = this._parts[i];
            int sn = s.Length;
            if (remaining < sn) return s.CharAt(remaining);
            remaining = remaining - sn;
        }
        // Unreachable given the bounds check above.
        throw new Exception($"StringBuilder index out of range: {index}");
    }

    void _setCharAt(int index, char value) {
        char[] chars = this.ToString().ToCharArray();
        chars[index] = value;
        this._setSingle(String.FromChars(chars));
    }

    // 重置为单个逻辑部分 `s`。`_capacity` 恒 ≥ 4，槽 0 无需扩容即可写。
    void _setSingle(string s) {
        this._parts[0] = s;
        this._count = 1;
        this._length = s.Length;
    }

    /// 清空（`Length` 归 0），保留已分配的容量。
    public StringBuilder Clear() {
        this._count = 0;
        this._length = 0;
        return this;
    }

    /// 在字符位置 `index` 插入；`index == Length` 等同追加。
    public StringBuilder Insert(int index, string value) {
        string cur = this.ToString();
        string result = String.Concat(cur.Substring(0, index), value, cur.Substring(index));
        this._setSingle(result);
        return this;
    }

    /// 在字符位置 `index` 插入一个字符。
    public StringBuilder Insert(int index, char value) {
        char[] one = new char[1];
        one[0] = value;
        return this.Insert(index, String.FromChars(one));
    }

    /// 在字符位置 `index` 插入任意值（经 `Convert.ToString`）。
    public StringBuilder Insert(int index, object value) {
        return this.Insert(index, Convert.ToString(value));
    }

    /// 删除 `[startIndex, startIndex + length)` 区间的字符。
    public StringBuilder Remove(int startIndex, int length) {
        string cur = this.ToString();
        string result = String.Concat(cur.Substring(0, startIndex), cur.Substring(startIndex + length));
        this._setSingle(result);
        return this;
    }

    /// 替换缓冲里全部出现的 `oldValue`。
    public StringBuilder Replace(string oldValue, string newValue) {
        this._setSingle(this.ToString().Replace(oldValue, newValue));
        return this;
    }

    /// 追加 `String.Format(format, args)` 的结果，占位符是 `{0}` / `{1}` 风格。
    /// @param format 含 `{0}` 风格占位符的格式串
    /// @param args 填入占位符的值
    public StringBuilder AppendFormat(string format, params object[] args) {
        return this.Append(String.Format(format, args));
    }

    /// 物化出当前字符串。空缓冲返回 `""`。
    override string ToString() {
        if (this._length == 0) return "";
        return String.ConcatParts(this._parts, this._count);
    }

    // 2× 容量增长（与 List<T>.Grow 一致）。
    void Grow() {
        int newCap = this._capacity * 2;
        string[] bigger = new string[newCap];
        Array.Copy(this._parts, bigger, this._count);
        this._parts = bigger;
        this._capacity = newCap;
    }
}
