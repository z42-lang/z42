// Spec R5 — z42.text 库本地测试。覆盖 StringBuilder 的核心 Append /
// AppendLine / GetLength / ToString 工作流。
namespace Z42TextTests;

using Std.Test;
using Std.Text;

[Test]
void test_empty_builder() {
    var sb = new StringBuilder();
    Assert.Equal(0, sb.GetLength());
    Assert.Equal("", sb.ToString());
}

[Test]
void test_append_single() {
    var sb = new StringBuilder();
    sb.Append("hello");
    Assert.Equal(5, sb.GetLength());
    Assert.Equal("hello", sb.ToString());
}

[Test]
void test_append_multiple() {
    var sb = new StringBuilder();
    sb.Append("a");
    sb.Append("b");
    sb.Append("c");
    Assert.Equal("abc", sb.ToString());
}

[Test]
void test_append_chain() {
    var sb = new StringBuilder();
    sb.Append("x").Append("y").Append("z");
    Assert.Equal("xyz", sb.ToString());
}

[Test]
void test_append_line() {
    var sb = new StringBuilder();
    sb.AppendLine("first");
    sb.AppendLine("second");
    Assert.Equal("first\nsecond\n", sb.ToString());
}

[Test]
void test_grow_beyond_initial_capacity() {
    // Initial capacity is 4; append 10 items to force at least one grow().
    var sb = new StringBuilder();
    for (int i = 0; i < 10; i = i + 1) {
        sb.Append("a");
    }
    Assert.Equal(10, sb.GetLength());
    Assert.Equal("aaaaaaaaaa", sb.ToString());
}

// ── add-parser-run-flush: Append(string) / Append(char) overloads ─────────────

[Test]
void test_append_char() {
    var sb = new StringBuilder();
    sb.Append('h');
    sb.Append('i');
    Assert.Equal(2, sb.GetLength());
    Assert.Equal("hi", sb.ToString());
}

[Test]
void test_append_char_and_string_mixed() {
    // Mirrors the run-flush pattern: string runs interleaved with single chars.
    var sb = new StringBuilder();
    sb.Append("ab").Append('\n').Append("cd").Append('!');
    Assert.Equal(6, sb.GetLength());
    Assert.Equal("ab\ncd!", sb.ToString());
}

[Test]
void test_append_string_overload_matches_object() {
    // The string fast path must produce the same result as the object path.
    var a = new StringBuilder();
    a.Append("hello");             // resolves to Append(string)
    var b = new StringBuilder();
    object o = "hello";
    b.Append(o);                   // resolves to Append(object) → Convert.ToString
    Assert.Equal(a.ToString(), b.ToString());
}

[Test]
void test_append_object_nonstring_still_works() {
    // Non-string/char values still route through Convert.ToString.
    var sb = new StringBuilder();
    sb.Append(42);
    sb.Append(true);
    Assert.Equal("42true", sb.ToString());
}

// ── augment-stringbuilder-depth: C# System.Text.StringBuilder parity ──────────

[Test]
void test_clear_resets_to_empty() {
    var sb = new StringBuilder();
    sb.Append("hello").Append("world");
    sb.Clear();
    Assert.Equal(0, sb.GetLength());
    Assert.Equal("", sb.ToString());
    // Reusable after Clear.
    sb.Append("again");
    Assert.Equal("again", sb.ToString());
}

[Test]
void test_length_property_getter() {
    var sb = new StringBuilder();
    sb.Append("abcd");
    Assert.Equal(4, sb.Length);
    Assert.Equal(sb.GetLength(), sb.Length);
}

[Test]
void test_indexer_get() {
    var sb = new StringBuilder();
    sb.Append("ab").Append("cd");   // spans two parts
    Assert.Equal('a', sb[0]);
    Assert.Equal('c', sb[2]);
    Assert.Equal('d', sb[3]);
}

[Test]
void test_indexer_set() {
    var sb = new StringBuilder();
    sb.Append("abc");
    sb[1] = 'X';
    Assert.Equal("aXc", sb.ToString());
}

[Test]
void test_insert_string_middle() {
    var sb = new StringBuilder();
    sb.Append("held");
    sb.Insert(2, "ooo");
    Assert.Equal("heooold", sb.ToString());
}

[Test]
void test_insert_at_start_and_end() {
    var sb = new StringBuilder();
    sb.Append("mid");
    sb.Insert(0, "pre-");
    sb.Insert(sb.Length, "-post");
    Assert.Equal("pre-mid-post", sb.ToString());
}

[Test]
void test_insert_char_and_object() {
    var sb = new StringBuilder();
    sb.Append("ac");
    sb.Insert(1, 'b');
    Assert.Equal("abc", sb.ToString());
    sb.Insert(0, 42);
    Assert.Equal("42abc", sb.ToString());
}

[Test]
void test_remove_range() {
    var sb = new StringBuilder();
    sb.Append("abcdef");
    sb.Remove(1, 3);   // drop "bcd"
    Assert.Equal("aef", sb.ToString());
    Assert.Equal(3, sb.Length);
}

[Test]
void test_replace_all() {
    var sb = new StringBuilder();
    sb.Append("a.b.c");
    sb.Replace(".", "-");
    Assert.Equal("a-b-c", sb.ToString());
}

[Test]
void test_append_format() {
    var sb = new StringBuilder();
    sb.AppendFormat("{0}+{1}={2}", 1, 2, 3);
    Assert.Equal("1+2=3", sb.ToString());
}

[Test]
void test_edit_chain_returns_this() {
    // Insert / Remove / Replace / Clear all return `this` for chaining.
    var sb = new StringBuilder();
    sb.Append("xyz").Insert(1, "AB").Remove(0, 1).Replace("z", "Z");
    Assert.Equal("AByZ", sb.ToString());
}
