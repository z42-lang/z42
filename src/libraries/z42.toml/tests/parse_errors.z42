// add-z42-toml (2026-05-14)：错误输入 → TomlException。
namespace Z42TomlErrorsTests;

using Std.Test;
using Std.Toml;

[Test]
void test_duplicate_key_rejected() {
    bool caught = false;
    try {
        TomlValue.Parse("name = \"a\"\nname = \"b\"");
    } catch (TomlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_duplicate_section_rejected() {
    bool caught = false;
    try {
        TomlValue.Parse("[foo]\na = 1\n[foo]\nb = 2");
    } catch (TomlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_unterminated_string() {
    bool caught = false;
    try {
        TomlValue.Parse("s = \"unterminated");
    } catch (TomlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_unterminated_section() {
    bool caught = false;
    try {
        TomlValue.Parse("[unclosed\nname = \"x\"");
    } catch (TomlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_missing_value_after_equals() {
    bool caught = false;
    try {
        TomlValue.Parse("name = ");
    } catch (TomlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_error_has_line_info() {
    try {
        // Error on line 3
        TomlValue.Parse("a = 1\nb = 2\nbad =");
    } catch (TomlException e) {
        Assert.True(e.Line >= 1);
        return;
    }
    Assert.True(false);  // should have thrown
}

// fix-parser-depth-limit (2026-07-12, review §2.2 / item 8): pathological deep
// nesting must throw a TomlException, not blow the VM stack (DoS).
[Test]
void test_deep_nesting_rejected() {
    string deep = "x = ";
    int n = 300;                       // > 256 depth cap
    int i = 0;
    while (i < n) { deep = deep + "["; i = i + 1; }
    i = 0;
    while (i < n) { deep = deep + "]"; i = i + 1; }
    bool caught = false;
    try { TomlValue.Parse(deep); } catch (TomlException e) { caught = true; }
    Assert.True(caught);
}

[Test]
void test_moderate_nesting_ok() {
    // 50 levels is under the cap and must still parse cleanly.
    string s = "x = ";
    int n = 50;
    int i = 0;
    while (i < n) { s = s + "["; i = i + 1; }
    s = s + "7";
    i = 0;
    while (i < n) { s = s + "]"; i = i + 1; }
    var t = TomlValue.Parse(s);
    var cur = t.Get("x");
    i = 0;
    while (i < n) { cur = cur.At(0); i = i + 1; }
    Assert.Equal(7L, cur.AsLong());
}

// fix-toml-number-scan (2026-07-12, review §2.2): the number scanner used to let
// malformed shapes through and then throw a bare Parse exception; now they raise
// a TomlException with line/col, and TOML 1.0 leading zeros are rejected.
[Test]
void test_reject_multiple_dots() {
    bool caught = false;
    try { TomlValue.Parse("x = 1.2.3"); } catch (TomlException e) { caught = true; }
    Assert.True(caught);
}

[Test]
void test_reject_multiple_exponents() {
    bool caught = false;
    try { TomlValue.Parse("x = 1e5e5"); } catch (TomlException e) { caught = true; }
    Assert.True(caught);
}

[Test]
void test_reject_leading_zero_int() {
    bool caught = false;
    try { TomlValue.Parse("x = 042"); } catch (TomlException e) { caught = true; }
    Assert.True(caught);
}

[Test]
void test_reject_leading_zero_float() {
    bool caught = false;
    try { TomlValue.Parse("x = 01.5"); } catch (TomlException e) { caught = true; }
    Assert.True(caught);
}

[Test]
void test_accept_valid_zero_forms() {
    // 0 / 0.x / 0ex / -0 stay valid (only redundant leading zeros are rejected).
    Assert.Equal(0L, TomlValue.Parse("x = 0").Get("x").AsLong());
    Assert.EqualApprox(0.5, TomlValue.Parse("x = 0.5").Get("x").AsDouble(), 1e-9);
    Assert.EqualApprox(0.0, TomlValue.Parse("x = 0e0").Get("x").AsDouble(), 1e-9);
    Assert.Equal(42L, TomlValue.Parse("x = 42").Get("x").AsLong());
}
