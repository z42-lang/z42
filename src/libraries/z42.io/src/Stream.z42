//! 流式 I/O、二进制读写与子进程。
//!
//! `Std.IO` 提供统一的字节流抽象（Stream / MemoryStream / FileStream / BufferedStream）、字符读写器
//! （TextReader / TextWriter / StringReader / StringWriter / StreamReader / StreamWriter）、子进程执行
//! （Process / ProcessHandle / Stdio）与终端 ANSI 着色（Ansi）；`Std.IO.Binary` 提供带显式字节序的
//! 二进制数值读写（BinaryReader / BinaryWriter）。
//!
//! ## 不支持
//!
//! - 没有 async：不存在 ReadAsync / WriteAsync 等异步读写。
//! - Stream 本身不实现 Std.IDisposable（只有 Close()）；TextReader / TextWriter 名义实现了 Std.IDisposable。
//! - 没有超时旋钮：ReadTimeout / WriteTimeout 不存在。
//! - BinaryReader / BinaryWriter 没有无符号读写，也没有 Close() / Dispose()，生命周期归底层 Stream。
//! - 子进程不经 shell，Timeout 只管 Run()，Stdio.ToFile 不能用于 stdin。
//! - Ansi 没有 256 色 / truecolor / 背景色，也没有光标定位 / 清屏的生成接口。
namespace Std.IO;


/// 所有字节流的统一基类；是具体类不是抽象类，能力谓词默认 false、核心方法抛 NotSupportedException。
public class Stream {
    // ── 能力谓词 ────────────────────────────────────────────
    // 子类按实现覆写返回 true；基类默认 false。

    /// 是否可读；基类返回 false。
    public virtual bool CanRead()  { return false; }
    /// 是否可写；基类返回 false。
    public virtual bool CanWrite() { return false; }
    /// 是否可定位；基类返回 false。
    public virtual bool CanSeek()  { return false; }

    // ── 核心读写 ────────────────────────────────────────────

    /// 填充 buffer[offset..offset+count]，返回实际写入的字节数（0..count），0 = EOF。
    public virtual int Read(byte[] buffer, int offset, int count) {
        throw new NotSupportedException("Read not supported on this stream");
    }

    /// 写 buffer[offset..offset+count]。
    public virtual void Write(byte[] buffer, int offset, int count) {
        throw new NotSupportedException("Write not supported on this stream");
    }

    /// 读一个字节，返回 0..255；EOF 返回 -1。
    public virtual int ReadByte() {
        byte[] one = new byte[1];
        int n = this.Read(one, 0, 1);
        if (n == 0) { return -1; }
        return (int)one[0] & 0xFF;
    }

    /// 写一个字节。
    public virtual void WriteByte(byte b) {
        byte[] one = new byte[1];
        one[0] = b;
        this.Write(one, 0, 1);
    }

    // ── 生命周期 ────────────────────────────────────────────

    /// 刷新缓冲；基类无缓冲状态，默认空操作。
    public virtual void Flush() {
    }

    /// 释放资源；基类无资源持有，默认空操作。
    public virtual void Close() {
    }

    // ── 位置 / 定位（可选能力）──────────────────────────────

    /// 流的字节长度；基类抛 NotSupportedException。
    public virtual long Length() {
        throw new NotSupportedException("Length not supported on this stream");
    }

    /// 当前读写位置；基类抛 NotSupportedException。
    public virtual long Position() {
        throw new NotSupportedException("Position not supported on this stream");
    }

    /// 把游标移到相对 origin（SeekOrigin.Begin / Current / End）偏移 offset 处，返回新的绝对位置。
    public virtual long Seek(long offset, int origin) {
        throw new NotSupportedException("Seek not supported on this stream");
    }

    // ── 便利方法（组合在 Read / Write 之上）─────────────────

    /// 读到 EOF 为止，返回精确长度的新 byte[]（内部按 4 KB 分块累积）。
    public byte[] ReadAllBytes() {
        if (!this.CanRead()) {
            throw new NotSupportedException("ReadAllBytes: stream not readable");
        }
        byte[] buf = new byte[4096];
        int    total = 0;
        // 累积到可增长缓冲（2 倍几何增长）。
        byte[] acc = new byte[4096];
        while (true) {
            int n = this.Read(buf, 0, buf.Length);
            if (n <= 0) { break; }
            // 需要时扩展累积缓冲。
            if (total + n > acc.Length) {
                int newCap = acc.Length * 2;
                while (newCap < total + n) { newCap = newCap * 2; }
                byte[] grown = new byte[newCap];
                int i = 0;
                while (i < total) { grown[i] = acc[i]; i = i + 1; }
                acc = grown;
            }
            int j = 0;
            while (j < n) {
                acc[total + j] = buf[j];
                j = j + 1;
            }
            total = total + n;
        }
        // 截取为精确大小的返回数组。
        byte[] result = new byte[total];
        int k = 0;
        while (k < total) {
            result[k] = acc[k];
            k = k + 1;
        }
        return result;
    }

    /// 等价 Write(data, 0, data.Length)。
    public void WriteAllBytes(byte[] data) {
        if (!this.CanWrite()) {
            throw new NotSupportedException("WriteAllBytes: stream not writable");
        }
        this.Write(data, 0, data.Length);
    }

    /// 必须凑满 count 字节并作为新 byte[] 返回，否则抛 Std.IO.EndOfStreamException。
    public byte[] ReadExactly(int count) {
        if (!this.CanRead()) {
            throw new NotSupportedException("ReadExactly: stream not readable");
        }
        if (count < 0) {
            throw new ArgumentException("ReadExactly count must be non-negative");
        }
        byte[] result = new byte[count];
        int total = 0;
        while (total < count) {
            int n = this.Read(result, total, count - total);
            if (n <= 0) {
                throw new EndOfStreamException("ReadExactly: unexpected EOF after "
                    + total.ToString() + " of " + count.ToString() + " bytes");
            }
            total = total + n;
        }
        return result;
    }

    /// 把剩余内容全部灌入 dest（默认 4 KB 中转缓冲），两端都不关闭。
    public void CopyTo(Stream dest) {
        this.CopyTo(dest, 4096);
    }

    /// 用指定 bufferSize 的中转缓冲拷贝；bufferSize <= 0 抛 ArgumentException。
    public void CopyTo(Stream dest, int bufferSize) {
        if (!this.CanRead()) {
            throw new NotSupportedException("CopyTo: source stream is not readable");
        }
        if (!dest.CanWrite()) {
            throw new NotSupportedException("CopyTo: destination stream is not writable");
        }
        if (bufferSize <= 0) {
            throw new ArgumentException("CopyTo: bufferSize must be > 0");
        }
        byte[] buf = new byte[bufferSize];
        while (true) {
            int n = this.Read(buf, 0, buf.Length);
            if (n <= 0) { break; }
            dest.Write(buf, 0, n);
        }
    }
}
