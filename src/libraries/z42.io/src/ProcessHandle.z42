namespace Std.IO;

using Std.Encoding;

/// Spawn() 返回的活子进程句柄；实现 Std.IDisposable，一次性的（Wait / Dispose 后即失效）。
public class ProcessHandle : IDisposable {
    private string _program;
    private long _slotId;
    private bool _disposed;
    // 缓存的 Stream 包装，使重复 GetXxxStream() 返回同一个对象。
    private ProcessStdinStream  _stdinStream;
    private ProcessOutputStream _stdoutStream;
    private ProcessOutputStream _stderrStream;

    /// 由 Process.Spawn() 内部构造。
    public ProcessHandle(string program, long slotId) {
        this._program  = program;
        this._slotId   = slotId;
        this._disposed = false;
    }

    /// OS 进程号。
    public long Pid() {
        this.EnsureLive();
        return ChildProcessNative.Pid(this._slotId);
    }

    /// 阻塞到子进程结束，返回 ProcessResult；调用之后句柄即失效。
    public ProcessResult Wait() {
        this.EnsureLive();
        this._disposed = true;
        return ProcessResult.FromNative(this._program, ChildProcessNative.Wait(this._slotId));
    }

    /// 还在跑返回 null，已结束返回 ProcessResult 并使句柄失效。
    public ProcessResult? TryWait() {
        this.EnsureLive();
        object resObj = ChildProcessNative.TryWait(this._slotId);
        if (resObj == null) {
            return null;
        }
        this._disposed = true;   // 已退出：VM 已消耗槽位
        return ProcessResult.FromNative(this._program, (object[])resObj);
    }

    /// 强制终止子进程（当前与 KillForce 行为相同）。
    public void Kill() {
        this.EnsureLive();
        ChildProcessNative.Kill(this._slotId, false);
    }

    /// 强制终止子进程（当前与 Kill 行为相同）。
    public void KillForce() {
        this.EnsureLive();
        ChildProcessNative.Kill(this._slotId, true);
    }

    /// 写子进程 stdin；管道写满阻塞，子进程已关 stdin 抛 IOException。
    public void WriteStdin(byte[] bytes) {
        this.EnsureLive();
        ChildProcessNative.WriteStdin(this._slotId, bytes);
    }

    /// 等价 WriteStdin(Utf8.GetBytes(s))。
    public void WriteStdinString(string s) {
        this.WriteStdin(Utf8.GetBytes(s));
    }

    /// 关闭 stdin，子进程读到 EOF；幂等。
    public void CloseStdin() {
        this.EnsureLive();
        ChildProcessNative.CloseStdin(this._slotId);
    }

    // ── 流式读 ───────────────────────────────────────────────

    /// 阻塞读子进程 stdout，返回实际读到的字节数，0 = EOF。
    public int ReadStdout(byte[] buffer, int offset, int count) {
        this.EnsureLive();
        return ChildProcessNative.ReadStdout(this._slotId, buffer, offset, count);
    }

    /// 阻塞读子进程 stderr，返回实际读到的字节数，0 = EOF。
    public int ReadStderr(byte[] buffer, int offset, int count) {
        this.EnsureLive();
        return ChildProcessNative.ReadStderr(this._slotId, buffer, offset, count);
    }

    // ── Stream 访问器（惰性构造并缓存）───────────────────────

    /// 返回 stdin 的 Stream 包装；重复调用返回同一对象。
    public ProcessStdinStream GetStdinStream() {
        if (this._stdinStream == null) {
            this._stdinStream = new ProcessStdinStream(this);
        }
        return this._stdinStream;
    }

    /// 返回 stdout 的 Stream 包装；重复调用返回同一对象。
    public ProcessOutputStream GetStdoutStream() {
        if (this._stdoutStream == null) {
            this._stdoutStream = new ProcessOutputStream(this, ProcessOutputStream.Stdout);
        }
        return this._stdoutStream;
    }

    /// 返回 stderr 的 Stream 包装；重复调用返回同一对象。
    public ProcessOutputStream GetStderrStream() {
        if (this._stderrStream == null) {
            this._stderrStream = new ProcessOutputStream(this, ProcessOutputStream.Stderr);
        }
        return this._stderrStream;
    }

    /// 幂等；子进程仍活着时会被 kill + reap（不留僵尸）。
    public void Dispose() {
        if (this._disposed) return;
        this._disposed = true;
        ChildProcessNative.Close(this._slotId);
    }

    // ── 内部 ────────────────────────────────────────────────

    private void EnsureLive() {
        if (this._disposed) {
            throw new ProcessHandleInvalidException(this._program);
        }
    }
}
