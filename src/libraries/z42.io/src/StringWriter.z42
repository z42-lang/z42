namespace Std.IO;

using Std.Text;

/// 累积到内部 Std.Text.StringBuilder 的字符写入器。
public class StringWriter {
    private StringBuilder _buf;
    private bool          _closed;

    /// 构造空写入器。
    public StringWriter() {
        this._buf    = new StringBuilder();
        this._closed = false;
    }

    /// initialCapacity 仅为 API 形状兼容的提示，当前被忽略。
    public StringWriter(int initialCapacity) {
        this._buf    = new StringBuilder();
        this._closed = false;
    }

    // ── 写 ───────────────────────────────────────────────────

    /// 追加字符串。
    public void Write(string s) {
        this.EnsureOpen();
        this._buf.Append(s);
    }

    // 没有 Write(char) 重载 —— z42 重载决议目前会混淆单参 string / char；
    // 追加单字符用 Write(c.ToString()) 或 Write(chars, 0, 1)。

    /// 追加字符区间 buffer[offset..offset+count]。
    public void Write(char[] buffer, int offset, int count) {
        this.EnsureOpen();
        if (offset < 0 || count < 0 || offset + count > buffer.Length) {
            throw new ArgumentException("Write: buffer / offset / count out of range");
        }
        if (count == 0) { return; }
        char[] slice;
        if (offset == 0 && count == buffer.Length) {
            slice = buffer;
        } else {
            slice = new char[count];
            int i = 0;
            while (i < count) {
                slice[i] = buffer[offset + i];
                i = i + 1;
            }
        }
        this._buf.Append(String.FromChars(slice));
    }

    // ── WriteLine ────────────────────────────────────────────

    /// 写 "\n"。
    public void WriteLine() {
        this.EnsureOpen();
        this._buf.Append("\n");
    }

    /// 写 s + "\n"。
    public void WriteLine(string s) {
        this.EnsureOpen();
        this._buf.Append(s);
        this._buf.Append("\n");
    }
    // 没有 WriteLine(char) 重载 —— 原因同上面的 Write 重载。

    // ── 快照 / 复位 ──────────────────────────────────────────

    /// 返回当前内容快照，与后续写入无关。
    override string ToString() {
        return this._buf.ToString();
    }

    /// 清空，后续写入从头开始。
    public void Clear() {
        this.EnsureOpen();
        this._buf = new StringBuilder();
    }

    // ── 生命周期 ─────────────────────────────────────────────

    /// 标记关闭（幂等）；关闭后 Write / WriteLine / Clear 抛 InvalidOperationException，ToString() 仍可用。
    public void Close() {
        if (this._closed) { return; }
        this._closed = true;
    }

    // ── 内部 ────────────────────────────────────────────────

    private void EnsureOpen() {
        if (this._closed) {
            throw new InvalidOperationException("StringWriter: writer is closed");
        }
    }
}
