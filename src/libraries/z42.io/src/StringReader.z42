namespace Std.IO;


/// 在一个 string 上做游标式字符读取（char 粒度，不是 Stream 的子类）。
public class StringReader {
    private string _source;
    // 一次性物化源字符（一次 ToCharArray()）使逐字符读取是 O(1) 数组索引；
    // _source 保留用于 .Length / .Substring。
    private char[] _chars;
    private int    _pos;
    private bool   _closed;

    /// 在 source 上构造游标式读取器。
    public StringReader(string source) {
        this._source = source;
        this._chars  = source.ToCharArray();
        this._pos    = 0;
        this._closed = false;
    }

    // ── Peek / 单字符 Read ───────────────────────────────────

    /// 窥视下一个字符码，不前进游标；EOF 返回 -1。
    public int Peek() {
        this.EnsureOpen();
        if (this._pos >= this._source.Length) { return -1; }
        return (int)this._chars[this._pos];
    }

    /// 消费下一个字符码；EOF 返回 -1（游标不变）。
    public int Read() {
        this.EnsureOpen();
        if (this._pos >= this._source.Length) { return -1; }
        int code = (int)this._chars[this._pos];
        this._pos = this._pos + 1;
        return code;
    }

    // ── 批量读 ───────────────────────────────────────────────

    /// 填充 buffer[offset..offset+count]，返回实际填入数，0 = EOF。
    public int Read(char[] buffer, int offset, int count) {
        this.EnsureOpen();
        if (offset < 0 || count < 0 || offset + count > buffer.Length) {
            throw new ArgumentException("Read: buffer / offset / count out of range");
        }
        if (count == 0) { return 0; }
        int remaining = this._source.Length - this._pos;
        if (remaining <= 0) { return 0; }
        int n = count;
        if (n > remaining) { n = remaining; }
        int i = 0;
        while (i < n) {
            buffer[offset + i] = this._chars[this._pos + i];
            i = i + 1;
        }
        this._pos = this._pos + n;
        return n;
    }

    // ── 行读取 ───────────────────────────────────────────────

    /// 读一行（不含终止符）；\n / \r\n / 单独 \r 都终止一行，游标已在 EOF 时返回 null。
    public string? ReadLine() {
        this.EnsureOpen();
        int len = this._source.Length;
        if (this._pos >= len) { return null; }
        int start = this._pos;
        int i = start;
        while (i < len) {
            char c = this._chars[i];
            if (c == '\n') {
                string line = this._source.Substring(start, i - start);
                this._pos = i + 1;
                return line;
            }
            if (c == '\r') {
                string line = this._source.Substring(start, i - start);
                // 消费 \r 之后可选的 \n（CRLF）。
                if (i + 1 < len && this._chars[i + 1] == '\n') {
                    this._pos = i + 2;
                } else {
                    this._pos = i + 1;
                }
                return line;
            }
            i = i + 1;
        }
        // EOF 前没有终止符 —— 返回剩余内容。
        string tail = this._source.Substring(start);
        this._pos = len;
        return tail;
    }

    // ── ReadToEnd ────────────────────────────────────────────

    /// 返回从当前游标到末尾的剩余内容；EOF 返回 ""。
    public string ReadToEnd() {
        this.EnsureOpen();
        if (this._pos >= this._source.Length) { return ""; }
        string rest = this._source.Substring(this._pos);
        this._pos = this._source.Length;
        return rest;
    }

    // ── 生命周期 ─────────────────────────────────────────────

    /// 标记关闭（幂等）；关闭后任何读操作抛 InvalidOperationException。
    public void Close() {
        if (this._closed) { return; }
        this._closed = true;
        // 丢弃源引用以便 GC 回收。
        this._source = "";
        this._chars = new char[0];
    }

    // ── 内部 ────────────────────────────────────────────────

    private void EnsureOpen() {
        if (this._closed) {
            throw new InvalidOperationException("StringReader: reader is closed");
        }
    }
}
