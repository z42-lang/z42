namespace Std.IO;


/// 把小的读 / 写批量化成对内层流大操作的 Stream 包装；单缓冲，同一时刻只服务读或写。
public class BufferedStream : Stream {
    // 单缓冲同一时刻只能处于一种模式。
    private static int MODE_IDLE    = 0;
    private static int MODE_READING = 1;
    private static int MODE_WRITING = 2;

    private Stream _inner;
    private byte[] _buf;
    private int    _mode;
    // 读模式：_readPos = 第一个未消费字节，_readLen = 缓冲内总字节数。
    // 写模式：_writeLen = 待推给内层流的字节数（总是从缓冲 0 起）。
    private int  _readPos;
    private int  _readLen;
    private int  _writeLen;
    private bool _closed;

    /// 用默认 4 KB 缓冲包装内层流。
    public BufferedStream(Stream inner) {
        this._inner    = inner;
        this._buf      = new byte[4096];
        this._mode     = 0;        // MODE_IDLE
        this._readPos  = 0;
        this._readLen  = 0;
        this._writeLen = 0;
        this._closed   = false;
    }

    /// 用指定大小的缓冲包装内层流；bufferSize <= 0 抛 ArgumentException。
    public BufferedStream(Stream inner, int bufferSize) {
        if (bufferSize <= 0) {
            throw new ArgumentException("BufferedStream: bufferSize must be > 0");
        }
        this._inner    = inner;
        this._buf      = new byte[bufferSize];
        this._mode     = 0;
        this._readPos  = 0;
        this._readLen  = 0;
        this._writeLen = 0;
        this._closed   = false;
    }

    // ── 能力 ── 转发给内层流 ───────────────────────────────────

    /// 是否可读；关闭后为 false，否则转发给内层流。
    public override bool CanRead() {
        if (this._closed) { return false; }
        return this._inner.CanRead();
    }

    /// 是否可写；关闭后为 false，否则转发给内层流。
    public override bool CanWrite() {
        if (this._closed) { return false; }
        return this._inner.CanWrite();
    }

    /// 是否可定位；关闭后为 false，否则转发给内层流。
    public override bool CanSeek() {
        if (this._closed) { return false; }
        return this._inner.CanSeek();
    }

    // ── 读 ────────────────────────────────────────────────────

    /// 缓冲读；从写切到读会先 flush 待写字节。
    public override int Read(byte[] buffer, int offset, int count) {
        this.EnsureOpen();
        if (offset < 0 || count < 0 || offset > buffer.Length || count > buffer.Length - offset) {
            throw new ArgumentException("Read: buffer / offset / count out of range");
        }
        if (!this._inner.CanRead()) throw new NotSupportedException("Read: inner stream is not readable");
        if (count == 0) { return 0; }
        // 切到读模式 —— 先 flush 待写字节。
        if (this._mode == 2) {  // MODE_WRITING
            this.FlushWriteBuffer();
        }
        this._mode = 1;  // MODE_READING

        int available = this._readLen - this._readPos;
        if (available <= 0) {
            // 从内层流重新填充。
            // 优化：请求不小于缓冲大小时直接绕过缓冲直读（一次系统调用而不是两次）。
            if (count >= this._buf.Length) {
                this._readPos = 0;
                this._readLen = 0;
                return this._inner.Read(buffer, offset, count);
            }
            int n = this._inner.Read(this._buf, 0, this._buf.Length);
            this._readPos = 0;
            this._readLen = n;
            available = n;
            if (available <= 0) { return 0; }  // EOF
        }
        int take = count;
        if (take > available) { take = available; }
        int i = 0;
        while (i < take) {
            buffer[offset + i] = this._buf[this._readPos + i];
            i = i + 1;
        }
        this._readPos = this._readPos + take;
        return take;
    }

    // ── 写 ────────────────────────────────────────────────────

    /// 缓冲写；从读切写时回退未消费的预读字节。不可定位且仍有未读数据时抛 NotSupportedException。
    public override void Write(byte[] buffer, int offset, int count) {
        this.EnsureOpen();
        if (offset < 0 || count < 0 || offset > buffer.Length || count > buffer.Length - offset) {
            throw new ArgumentException("Write: buffer / offset / count out of range");
        }
        if (!this._inner.CanWrite()) throw new NotSupportedException("Write: inner stream is not writable");
        if (count == 0) { return; }
        if (this._mode == 1) {  // MODE_READING
            this.ClearReadBufferBeforeWrite();
        }
        this._mode = 2;  // MODE_WRITING

        // 直通：大写绕过缓冲（先 flush 已积压的小写以保持顺序）。
        if (count >= this._buf.Length) {
            if (this._writeLen > 0) {
                this.FlushWriteBuffer();
            }
            this._inner.Write(buffer, offset, count);
            return;
        }

        // 剩余缓冲放不下时先 flush。
        if (this._writeLen + count > this._buf.Length) {
            this.FlushWriteBuffer();
        }
        int i = 0;
        while (i < count) {
            this._buf[this._writeLen + i] = buffer[offset + i];
            i = i + 1;
        }
        this._writeLen = this._writeLen + count;
    }

    // ── 位置 / 长度 / 定位 ── flush 后转发 ────────────────────

    /// 提交待写缓冲后返回内层流长度；关闭后抛 InvalidOperationException。
    public override long Length() {
        this.EnsureOpen();
        if (this._mode == 2) { this.FlushWriteBuffer(); }
        return this._inner.Length();
    }

    /// 修正后的当前位置：读模式减去未消费缓冲，写模式加上待写字节。
    public override long Position() {
        this.EnsureOpen();
        long innerPos = this._inner.Position();
        if (this._mode == 1) {  // MODE_READING
            return innerPos - (long)(this._readLen - this._readPos);
        }
        if (this._mode == 2) {  // MODE_WRITING
            return innerPos + (long)this._writeLen;
        }
        return innerPos;
    }

    /// 相对逻辑位置定位；先提交待写数据，成功后清除读缓冲。不可定位时抛 NotSupportedException。
    public override long Seek(long offset, int origin) {
        this.EnsureOpen();
        if (origin != SeekOrigin.Begin && origin != SeekOrigin.Current && origin != SeekOrigin.End) {
            throw new ArgumentException("Seek: unknown origin " + origin.ToString());
        }
        if (!this._inner.CanSeek()) throw new NotSupportedException("Seek: inner stream is not seekable");
        long adjusted = offset;
        if (this._mode == 1 && origin == SeekOrigin.Current) {
            long unread = (long)(this._readLen - this._readPos);
            if (offset < Int64.MinValue + unread) throw new ArgumentOutOfRangeException("Seek: offset underflow");
            adjusted = offset - unread;
        }
        if (this._mode == 2) {  // MODE_WRITING
            this.FlushWriteBuffer();
        }
        long position = this._inner.Seek(adjusted, origin);
        this._readPos = 0;
        this._readLen = 0;
        this._mode    = 0;  // MODE_IDLE
        return position;
    }

    // ── Flush / Close ─────────────────────────────────────────

    /// flush 待写数据并转发给内层流 Flush。
    public override void Flush() {
        if (this._closed) { return; }
        if (this._mode == 2) {  // MODE_WRITING
            this.FlushWriteBuffer();
        }
        this._inner.Flush();
    }

    /// 先 flush 待写数据再关闭，但不关闭内层流（生命周期归调用方）。
    public override void Close() {
        if (this._closed) { return; }
        if (this._mode == 2) {  // MODE_WRITING
            this.FlushWriteBuffer();
        }
        this._closed = true;
        // 故意不调用 this._inner.Close() —— 内层流生命周期归调用方。
    }

    // ── 内部 ─────────────────────────────────────────────────

    private void EnsureOpen() {
        if (this._closed) {
            throw new InvalidOperationException("BufferedStream: stream is closed");
        }
    }

    private void ClearReadBufferBeforeWrite() {
        if (this._readPos < this._readLen) {
            if (!this._inner.CanSeek()) throw new NotSupportedException("Write: unread data on a non-seekable stream");
            this._inner.Seek((long)(this._readPos - this._readLen), SeekOrigin.Current);
        }
        this._readPos = 0;
        this._readLen = 0;
    }

    private void FlushWriteBuffer() {
        if (this._writeLen <= 0) { return; }
        this._inner.Write(this._buf, 0, this._writeLen);
        this._writeLen = 0;
    }
}
