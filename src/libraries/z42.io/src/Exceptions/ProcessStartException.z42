namespace Std.IO;

/// 子进程根本没启动（可执行文件找不到、权限不足、fork/exec 失败等）时抛出；继承 IOException。
public class ProcessStartException : IOException {
    /// 用指定消息构造。
    public ProcessStartException(string message) : base(message) {}

    /// 返回带类型前缀的消息字符串。
    override string ToString() {
        return "ProcessStartException: " + this.Message;
    }
}
