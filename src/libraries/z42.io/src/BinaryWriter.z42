namespace Std.IO.Binary;
using Std.Encoding;

/// 在 Std.IO.Stream 之上提供定长整数、IEEE-754 浮点、varint 与 UTF-8 字符串的显式字节序写入。
public class BinaryWriter {
    private Stream _stream;
    private bool   _ownsStream;

    /// 内部持有可增长 MemoryStream，ToArray() / Clear() 可用。
    public BinaryWriter() {
        this._stream     = new MemoryStream();
        this._ownsStream = true;
    }

    /// 写进已有可写 Stream（静态工厂）；dest 不可写抛 BinaryException，不拥有 dest。
    public static BinaryWriter OverStream(Stream dest) {
        if (!dest.CanWrite()) {
            throw new BinaryException("BinaryWriter: dest stream is not writable");
        }
        BinaryWriter w = new BinaryWriter();
        w._stream     = dest;
        w._ownsStream = false;
        return w;
    }

    // ── 长度 / 快照 ─────────────────────────────────────────

    /// 当前长度（int）；底层不可定位抛 BinaryException。
    public int GetLength() {
        try {
            return (int)this._stream.Length();
        } catch (NotSupportedException e) {
            throw new BinaryException("GetLength: underlying Stream is not seekable");
        }
    }

    /// 返回当前 [0, Length) 的 byte[] 副本；仅默认构造可用。
    public byte[] ToArray() {
        if (!this._ownsStream) {
            throw new BinaryException("ToArray: only valid on default-constructed BinaryWriter (caller-supplied Stream owns its own bytes)");
        }
        MemoryStream m = (MemoryStream)this._stream;
        return m.ToArray();
    }

    /// 复位为空（GetLength() 归 0，后续写入从头开始）；仅默认构造可用。
    public void Clear() {
        if (!this._ownsStream) {
            throw new BinaryException("Clear: only valid on default-constructed BinaryWriter");
        }
        this._stream = new MemoryStream();
    }

    // ── 字节 ─────────────────────────────────────────────────

    /// 写 1 个字节，只写低 8 位。
    public void WriteByte(int b) {
        byte[] buf = new byte[1];
        buf[0] = (byte)(b & 0xFF);
        this._stream.Write(buf, 0, 1);
    }

    /// 写字节数组。
    public void WriteBytes(byte[] data) {
        if (data.Length == 0) { return; }
        this._stream.Write(data, 0, data.Length);
    }

    // ── Int16 ────────────────────────────────────────────────

    /// 写 2 字节小端 int16（高位按宽度截断）。
    public void WriteInt16LE(int v) {
        byte[] buf = new byte[2];
        buf[0] = (byte)(v & 0xFF);
        buf[1] = (byte)((v >> 8) & 0xFF);
        this._stream.Write(buf, 0, 2);
    }

    /// 写 2 字节大端 int16（高位按宽度截断）。
    public void WriteInt16BE(int v) {
        byte[] buf = new byte[2];
        buf[0] = (byte)((v >> 8) & 0xFF);
        buf[1] = (byte)(v & 0xFF);
        this._stream.Write(buf, 0, 2);
    }

    // ── Int32 ────────────────────────────────────────────────

    /// 写 4 字节小端 int32。
    public void WriteInt32LE(int v) {
        byte[] buf = new byte[4];
        buf[0] = (byte)(v & 0xFF);
        buf[1] = (byte)((v >> 8) & 0xFF);
        buf[2] = (byte)((v >> 16) & 0xFF);
        buf[3] = (byte)((v >> 24) & 0xFF);
        this._stream.Write(buf, 0, 4);
    }

    /// 写 4 字节大端 int32。
    public void WriteInt32BE(int v) {
        byte[] buf = new byte[4];
        buf[0] = (byte)((v >> 24) & 0xFF);
        buf[1] = (byte)((v >> 16) & 0xFF);
        buf[2] = (byte)((v >> 8) & 0xFF);
        buf[3] = (byte)(v & 0xFF);
        this._stream.Write(buf, 0, 4);
    }

    // ── Int64 ────────────────────────────────────────────────

    /// 写 8 字节小端 int64。
    public void WriteInt64LE(long v) {
        byte[] buf = new byte[8];
        long mask = 255;
        buf[0] = (byte)(int)(v & mask);
        buf[1] = (byte)(int)((v >> 8) & mask);
        buf[2] = (byte)(int)((v >> 16) & mask);
        buf[3] = (byte)(int)((v >> 24) & mask);
        buf[4] = (byte)(int)((v >> 32) & mask);
        buf[5] = (byte)(int)((v >> 40) & mask);
        buf[6] = (byte)(int)((v >> 48) & mask);
        buf[7] = (byte)(int)((v >> 56) & mask);
        this._stream.Write(buf, 0, 8);
    }

    /// 写 8 字节大端 int64。
    public void WriteInt64BE(long v) {
        byte[] buf = new byte[8];
        long mask = 255;
        buf[0] = (byte)(int)((v >> 56) & mask);
        buf[1] = (byte)(int)((v >> 48) & mask);
        buf[2] = (byte)(int)((v >> 40) & mask);
        buf[3] = (byte)(int)((v >> 32) & mask);
        buf[4] = (byte)(int)((v >> 24) & mask);
        buf[5] = (byte)(int)((v >> 16) & mask);
        buf[6] = (byte)(int)((v >> 8) & mask);
        buf[7] = (byte)(int)(v & mask);
        this._stream.Write(buf, 0, 8);
    }

    // ── 浮点（IEEE-754）──────────────────────────────────────

    // Single 接受 double（宽入窄线），写为 4 字节 f32；超出 f32 精度 / 范围的值在此舍入。
    /// 写 4 字节小端 f32。
    public void WriteSingleLE(double v) { this.WriteInt32LE(BitConverter.SingleToBits(v)); }
    /// 写 4 字节大端 f32。
    public void WriteSingleBE(double v) { this.WriteInt32BE(BitConverter.SingleToBits(v)); }
    /// 写 8 字节小端 f64。
    public void WriteDoubleLE(double v) { this.WriteInt64LE(BitConverter.DoubleToBits(v)); }
    /// 写 8 字节大端 f64。
    public void WriteDoubleBE(double v) { this.WriteInt64BE(BitConverter.DoubleToBits(v)); }

    // ── Varint（protobuf 式 7 位）────────────────────────────

    /// 写 varint 编码的 i64；正数按 ⌈bits/7⌉ 字节，负数固定 10 字节，返回写入字节数。
    public int WriteVarInt64(long v) {
        long u = v;
        long mask7 = 127;     // 0x7F
        long mask8 = 128;     // 0x80
        int n = 0;
        // 每次输出 7 位；用「移位后掩码」模拟无符号右移；上界 10 因为 10 × 7 ≥ 64 覆盖任何 i64。
        bool done = false;
        while (!done) {
            long lo = u & mask7;
            long rest;
            if (u < 0L) {
                // 算术右移保留符号位；移位后掩掉高 7 位以模拟无符号右移。
                rest = (u >> 7) & 144115188075855871L;   // (1<<57) - 1
            } else {
                rest = u >> 7;
            }
            if (rest == 0L) {
                this.WriteByte((int)lo);
                done = true;
            } else {
                this.WriteByte((int)(lo | mask8));
                u = rest;
            }
            n = n + 1;
        }
        return n;
    }

    /// 先 ZigZag 编码再写 varint，小负数保持紧凑（如 -1 / -64 都只占 1 字节），返回写入字节数。
    public int WriteVarSInt64(long v) {
        // ZigZag：(v << 1) XOR (v >> 63 算术)。
        long shifted = v << 1;
        long signExt = v >> 63;
        long u = shifted ^ signExt;
        return this.WriteVarInt64(u);
    }

    // ── 字符串（UTF-8）──────────────────────────────────────

    /// 编码 s 为 UTF-8 字节并写入，返回写入的字节数。
    public int WriteString(string s) {
        byte[] bytes = Utf8.GetBytes(s);
        this.WriteBytes(bytes);
        return bytes.Length;
    }
}
