namespace Std.IO;

/// Run() 与 Wait() / TryWait() 的返回值；字段是公开可写的普通字段。
public class ProcessResult {
    /// 被执行的程序。
    public string Program;
    /// 退出码；被信号杀死时为 128 + 信号号。
    public int    ExitCode;
    /// stdout 的 UTF-8 lossy 解码。
    public string Stdout;
    /// stderr 的 UTF-8 lossy 解码。
    public string Stderr;
    /// stdout 原始字节。
    public byte[] StdoutBytes;
    /// stderr 原始字节。
    public byte[] StderrBytes;

    /// 用各字段构造。
    public ProcessResult(
        string program, int exitCode, string stdout, string stderr,
        byte[] stdoutBytes, byte[] stderrBytes
    ) {
        this.Program     = program;
        this.ExitCode    = exitCode;
        this.Stdout      = stdout;
        this.Stderr      = stderr;
        this.StdoutBytes = stdoutBytes;
        this.StderrBytes = stderrBytes;
    }

    // native 结果数组 [exitCode, stdout, stderr, stdoutBytes, stderrBytes]。
    internal static ProcessResult FromNative(string program, object[] raw) {
        return new ProcessResult(
            program,
            (int)(long)raw[0],
            (string)raw[1],
            (string)raw[2],
            (byte[])raw[3],
            (byte[])raw[4]);
    }

    /// ExitCode != 0 时抛 ProcessExitException，否则返回 this（可链式 .Run().EnsureSuccess()）。
    public ProcessResult EnsureSuccess() {
        if (this.ExitCode != 0) {
            throw new ProcessExitException(this.Program, this.ExitCode, this.Stderr);
        }
        return this;
    }
}
