namespace Z42StreamReaderBench;
using Std.IO;
using Std.Encoding;
using Std.Harness;
using Std.Text;

byte[] payload(int length, bool unicode) {
    char[] chars = new char[length]; int i = 0;
    while (i < length) {
        if (i % 64 == 63) { chars[i] = '\n'; }
        else if (unicode) { chars[i] = '中'; }
        else { chars[i] = 'a'; }
        i = i + 1;
    }
    return Encoding.GetUtf8().GetBytes(String.FromChars(chars));
}
[Benchmark]
void first_line_64k() {
    byte[] data = payload(65536, false); var b = new Bencher(2, 12);
    b.iter(() => { StreamReader r = new StreamReader(new MemoryStream(data)); BenchHelpers.blackBox(r.ReadLine()); r.Close(); });
    b.printSummary("reader_first_line_64k");
}

[Benchmark]
void read_line_ascii_64k(Bencher b) {
    byte[] data = Encoding.GetUtf8().GetBytes("x".PadRight(65536, 'x') + "\n");
    b.iter(() => {
        var reader = new StreamReader(new MemoryStream(data));
        Assert.Equal(65536, reader.ReadLine().Length);
        reader.Close();
    });
}

[Benchmark]
void read_short_crlf_lines(Bencher b) {
    var text = new StringBuilder();
    for (int i = 0; i < 1024; i++) { text.Append("ok\r\n"); }
    byte[] data = Encoding.GetUtf8().GetBytes(text.ToString());
    b.iter(() => {
        var reader = new StreamReader(new MemoryStream(data));
        int count = 0;
        while (reader.ReadLine() != null) { count = count + 1; }
        Assert.Equal(1024, count);
        reader.Close();
    });
}
[Benchmark]
void read_to_end_ascii_64k() {
    byte[] data = payload(65536, false); var b = new Bencher(2, 12);
    b.iter(() => { StreamReader r = new StreamReader(new MemoryStream(data)); BenchHelpers.blackBox(r.ReadToEnd()); r.Close(); });
    b.printSummary("reader_to_end_ascii_64k");
}
[Benchmark]
void read_lines_unicode_16k() {
    byte[] data = payload(16384, true); var b = new Bencher(2, 12);
    b.iter(() => {
        StreamReader r = new StreamReader(new MemoryStream(data)); int total = 0;
        string line = r.ReadLine();
        while (line != null) { total = total + line.Length; line = r.ReadLine(); }
        BenchHelpers.blackBox(total); r.Close();
    });
    b.printSummary("reader_lines_unicode_16k");
}
[Benchmark]
void read_short() {
    byte[] data = Encoding.GetUtf8().GetBytes("hello\n"); var b = new Bencher(2, 20);
    b.iter(() => { StreamReader r = new StreamReader(new MemoryStream(data)); BenchHelpers.blackBox(r.ReadLine()); r.Close(); });
    b.printSummary("reader_short");
}
[Benchmark]
void read_single_characters_4k() {
    byte[] data = payload(4096, true); var b = new Bencher(2, 12);
    b.iter(() => {
        StreamReader r = new StreamReader(new MemoryStream(data)); int total = 0; int c = r.Read();
        while (c >= 0) { total = total + c; c = r.Read(); }
        BenchHelpers.blackBox(total); r.Close();
    });
    b.printSummary("reader_single_unicode_4k");
}

class BytewiseSource : Stream {
    byte[] _data;
    int _pos;
    public BytewiseSource(byte[] data) { this._data = data; }
    public override bool CanRead() { return true; }
    public override int Read(byte[] buffer, int offset, int count) {
        if (count == 0 || this._pos == this._data.Length) { return 0; }
        buffer[offset] = this._data[this._pos]; this._pos = this._pos + 1;
        return 1;
    }
}
[Benchmark]
void read_one_byte_chunks_256() {
    byte[] data = payload(256, true); var b = new Bencher(2, 12);
    b.iter(() => { StreamReader r = new StreamReader(new BytewiseSource(data)); BenchHelpers.blackBox(r.ReadToEnd()); r.Close(); });
    b.printSummary("reader_one_byte_unicode_256");
}
