namespace Std.Yaml;

using Std.IO;
using Std.Time;

// add-z42-yaml (2026-05-24): YAML 值的运行时表示。
//
// Mirror of `Std.Toml.TomlValue` / `Std.Json.JsonValue` — single int
// kind discriminator + typed slots + parallel arrays for sequence /
// mapping storage (z42 class fields don't yet take generic type
// parameters, so `List<YamlValue>` is silently dropped; parallel
// arrays are the established workaround).
//
// Integer / float split into separate slots (not unified as f64) —
// large ints (2^53+) lose precision when stored as f64. Same trade as
// TomlValue.
//
// Kind discriminator (0..=7):
//   0 = Null    (YAML `~` or empty)
//   1 = Bool    (YAML 1.2: `true` / `false` only — no `yes`/`on` foot-gun)
//   2 = Int     (decimal i64; octal / hex deferred — yaml-future-numeric-bases)
//   3 = Float   (f64; `1.5e10` exponent form supported)
//   4 = String  (UTF-8)
//   5 = Sequence (ordered list)
//   6 = Mapping  (ordered key→value, string keys only in v0)
//   7 = Timestamp (ISO 8601; add-yaml-timestamps 2026-05-27)

public class YamlValue {
    private int _kind;
    private bool _bool;
    private long _int;
    private double _float;
    private string _str;
    // Timestamp slot (kind == 7) — add-yaml-timestamps (2026-05-27).
    // Stores both parsed DateTime + raw lexeme so Stringify can reproduce
    // the original offset / precision the parser saw.
    private DateTime _ts;
    private string _tsRaw;

    // Sequence storage (when kind == 5)
    private YamlValue[] _seqItems;
    private int _seqCount;

    // Mapping storage as parallel key/value arrays (when kind == 6)
    private string[] _mapKeys;
    private YamlValue[] _mapValues;
    private int _mapCount;

    // ── Public entry points (parse / stringify) ──────────────────────────

    /// Parse YAML text → root value. Throws YamlException with line/column
    /// on syntax error. Empty input yields a null value. Multi-document
    /// input (`---` separator) is rejected — use `ParseAll` instead.
    public static YamlValue Parse(string text) {
        YamlParser parser = new YamlParser(text);
        return (YamlValue)parser.ParseDocument();
    }

    /// Parse `---`-separated multi-document YAML into an array of values
    /// (kubectl / helm manifest-style). Empty / blank input → empty array.
    /// add-yaml-multi-doc (2026-05-25).
    public static YamlValue[] ParseAll(string text) {
        YamlParser parser = new YamlParser(text);
        return (YamlValue[])parser.ParseAllDocuments();
    }

    /// Serialise a YAML value tree to canonical YAML text (block style).
    /// The output is reasonable for human reading; it is NOT byte-identical
    /// to the original input (comment / quoting style not preserved).
    public static string Stringify(YamlValue root) {
        YamlWriter w = new YamlWriter();
        return w.Write(root);
    }

    // ── Stream overloads (add-stream-overloads-to-format-parsers, 2026-05-24) ──
    //
    // Thin wrappers over the string variants. Neither closes the
    // underlying Stream — caller owns its lifecycle.

    /// Parse YAML from a UTF-8 byte Stream. Distinct name from
    /// `Parse(string)` (not an overload) — see JsonValue.ParseStream
    /// comment for the z42 overload-resolution rationale.
    public static YamlValue ParseStream(Stream source) {
        StreamReader r = new StreamReader(source);
        string text = r.ReadToEnd();
        YamlParser parser = new YamlParser(text);
        return (YamlValue)parser.ParseDocument();
    }

    /// Parse multi-document YAML from a UTF-8 byte Stream.
    /// add-yaml-multi-doc (2026-05-25).
    public static YamlValue[] ParseAllStream(Stream source) {
        StreamReader r = new StreamReader(source);
        string text = r.ReadToEnd();
        YamlParser parser = new YamlParser(text);
        return (YamlValue[])parser.ParseAllDocuments();
    }

    /// Serialise canonical YAML to a Stream as UTF-8 bytes. Does NOT
    /// close `dest`.
    public static void WriteTo(Stream dest, YamlValue root) {
        StreamWriter w = new StreamWriter(dest);
        w.Write(YamlValue.Stringify(root));
        w.Flush();
    }

    // ── Factories ────────────────────────────────────────────────────────

    public static YamlValue OfNull() {
        YamlValue v = new YamlValue();
        v._kind = 0;
        return v;
    }

    public static YamlValue OfBool(bool b) {
        YamlValue v = new YamlValue();
        v._kind = 1;
        v._bool = b;
        return v;
    }

    public static YamlValue OfInt(long n) {
        YamlValue v = new YamlValue();
        v._kind = 2;
        v._int = n;
        return v;
    }

    public static YamlValue OfFloat(double d) {
        YamlValue v = new YamlValue();
        v._kind = 3;
        v._float = d;
        return v;
    }

    public static YamlValue OfString(string s) {
        YamlValue v = new YamlValue();
        v._kind = 4;
        v._str = s;
        return v;
    }

    /// add-yaml-timestamps (2026-05-27): YAML timestamp scalar from DateTime.
    /// `Stringify` will emit `dt.ToIso8601()` (UTC + 3-digit ms). For
    /// round-trip preservation of non-UTC offset / different precision,
    /// use `OfTimestampString(raw)`.
    public static YamlValue OfTimestamp(DateTime dt) {
        YamlValue v = new YamlValue();
        v._kind = 7;
        v._ts = dt;
        v._tsRaw = "";
        return v;
    }

    /// add-yaml-timestamps (2026-05-27): construct from ISO 8601 string,
    /// preserving the raw lexeme for round-trip fidelity. Throws
    /// ArgumentException (from DateTime.ParseIso8601) on malformed input.
    public static YamlValue OfTimestampString(string iso) {
        YamlValue v = new YamlValue();
        v._kind = 7;
        v._ts = DateTime.ParseIso8601(iso);
        v._tsRaw = iso;
        return v;
    }

    public static YamlValue OfSequence() {
        YamlValue v = new YamlValue();
        v._kind = 5;
        v._seqItems = new YamlValue[4];
        v._seqCount = 0;
        return v;
    }

    public static YamlValue OfMapping() {
        YamlValue v = new YamlValue();
        v._kind = 6;
        v._mapKeys = new string[4];
        v._mapValues = new YamlValue[4];
        v._mapCount = 0;
        return v;
    }

    // ── Predicates ───────────────────────────────────────────────────────

    public bool IsNull()      { return this._kind == 0; }
    public bool IsBool()      { return this._kind == 1; }
    public bool IsInt()       { return this._kind == 2; }
    public bool IsFloat()     { return this._kind == 3; }
    public bool IsString()    { return this._kind == 4; }
    public bool IsSequence()  { return this._kind == 5; }
    public bool IsMapping()   { return this._kind == 6; }
    public bool IsTimestamp() { return this._kind == 7; }

    /// Type tag name for diagnostics.
    public string KindName() {
        int k = this._kind;
        if (k == 0) return "null";
        if (k == 1) return "bool";
        if (k == 2) return "int";
        if (k == 3) return "float";
        if (k == 4) return "string";
        if (k == 5) return "sequence";
        if (k == 6) return "mapping";
        if (k == 7) return "timestamp";
        return "unknown";
    }

    // ── Accessors (throw YamlException on wrong kind) ────────────────────

    public bool AsBool() {
        if (this._kind != 1) {
            throw new YamlException("expected bool, got " + this.KindName());
        }
        return this._bool;
    }

    public long AsInt() {
        if (this._kind != 2) {
            throw new YamlException("expected int, got " + this.KindName());
        }
        return this._int;
    }

    public double AsFloat() {
        if (this._kind != 3) {
            throw new YamlException("expected float, got " + this.KindName());
        }
        return this._float;
    }

    public string AsString() {
        if (this._kind != 4) {
            throw new YamlException("expected string, got " + this.KindName());
        }
        return this._str;
    }

    /// add-yaml-timestamps (2026-05-27): DateTime accessor for kind 7.
    public DateTime AsTimestamp() {
        if (this._kind != 7) {
            throw new YamlException("expected timestamp, got " + this.KindName());
        }
        return this._ts;
    }

    /// Raw lexeme of a parsed timestamp (empty when constructed from a
    /// DateTime via `OfTimestamp`). Useful for round-trip preservation.
    public string AsTimestampRaw() {
        if (this._kind != 7) {
            throw new YamlException("expected timestamp, got " + this.KindName());
        }
        return this._tsRaw;
    }

    // ── Sequence operations (only valid when IsSequence()) ──────────────

    public int Length() {
        if (this._kind != 5) {
            throw new YamlException("Length() on non-sequence value (" + this.KindName() + ")");
        }
        return this._seqCount;
    }

    public YamlValue At(int i) {
        if (this._kind != 5) {
            throw new YamlException("At() on non-sequence value (" + this.KindName() + ")");
        }
        if (i < 0 || i >= this._seqCount) {
            throw new YamlException("sequence index out of range");
        }
        return this._seqItems[i];
    }

    public void Add(YamlValue v) {
        if (this._kind != 5) {
            throw new YamlException("Add() on non-sequence value (" + this.KindName() + ")");
        }
        if (this._seqCount == this._seqItems.Length) {
            int newCap = this._seqItems.Length * 2;
            if (newCap < 4) { newCap = 4; }
            YamlValue[] grown = new YamlValue[newCap];
            int j = 0;
            while (j < this._seqCount) { grown[j] = this._seqItems[j]; j = j + 1; }
            this._seqItems = grown;
        }
        this._seqItems[this._seqCount] = v;
        this._seqCount = this._seqCount + 1;
    }

    // ── Mapping operations (only valid when IsMapping()) ────────────────

    public bool ContainsKey(string key) {
        if (this._kind != 6) { return false; }
        int i = 0;
        while (i < this._mapCount) {
            if (this._mapKeys[i] == key) { return true; }
            i = i + 1;
        }
        return false;
    }

    public YamlValue Get(string key) {
        if (this._kind != 6) {
            throw new YamlException("Get on non-mapping value (" + this.KindName() + ")");
        }
        int i = 0;
        while (i < this._mapCount) {
            if (this._mapKeys[i] == key) { return this._mapValues[i]; }
            i = i + 1;
        }
        throw new YamlException("key not found: " + key);
    }

    // ── 取即检查（取值与存在性测试合成一次）──────────────────────────
    //
    // 为什么要这一对：`ContainsKey(k)` + `Get(k)` 是**两次独立调用**，
    // 「ContainsKey 为真 ⇒ Get 不抛」是调用方手里的不变式，**编译器原理上看不见**。
    // 代价三样：键字面量写两遍（改一处漏一处 ⇒ 编译零诊断、运行期才抛）、
    // 同一个 mapping 查两遍、以及「在不在」这件事没有任何编译期表示。
    //
    // 签名取 `bool TryX(ref T)` —— 与 `Int32.TryParse` 那套全仓统一
    // （值类型永不可空，可空返回这条路对 `long` / `bool` 走不通，见 E0476）。
    // 三个文档库（TOML / JSON / YAML）形状一致，见 `Std.Toml.TomlValue.TryGet`。

    /// 取即检查：命中则写入 `value` 并返回 true；未命中返回 false 且**不动** `value`。
    /// 本值不是 mapping 时返回 false 而**不抛** —— 与 `ContainsKey` 一致。
    public bool TryGet(string key, ref YamlValue value) {
        if (this._kind != 6) { return false; }
        int i = 0;
        while (i < this._mapCount) {
            if (this._mapKeys[i] == key) { value = this._mapValues[i]; return true; }
            i = i + 1;
        }
        return false;
    }

    /// 取即检查 + 取标量：命中则按 `T` 取值写入 `value` 并返回 true；未命中返回 false 且
    /// **不动** `value`（「有就覆盖默认值」一行写完）。
    ///
    /// ⚠️ 命中但**类型不符照抛** `YamlException`，与 `AsString()` / `AsInt()` 一字不差。
    ///
    /// 支持的 `T`：`string` / `long`（`AsInt`）/ `double`（`AsFloat`）/ `bool` /
    /// `DateTime`（`AsTimestamp`）/ `YamlValue`（原样取子树）。其它 `T` 抛异常。
    ///
    /// ⚠️ 这里 `long` 走 `AsInt`、`double` 走 `AsFloat` —— YAML 的访问器名与 TOML / JSON
    /// **不同名但同语义**（`AsInt` 返回的是 i64）。按 **z42 类型**选重载，别按访问器名字猜。
    public bool TryGetValue<T>(string key, ref T value) {
        YamlValue v = null;
        if (!this.TryGet(key, ref v)) { return false; }
        Type t = typeof(T);
        if (t == typeof(string))    { object o = v.AsString();    value = (T)o; return true; }
        if (t == typeof(long))      { object o = v.AsInt();       value = (T)o; return true; }
        if (t == typeof(double))    { object o = v.AsFloat();     value = (T)o; return true; }
        if (t == typeof(bool))      { object o = v.AsBool();      value = (T)o; return true; }
        if (t == typeof(DateTime))  { object o = v.AsTimestamp(); value = (T)o; return true; }
        if (t == typeof(YamlValue)) { object o = v;               value = (T)o; return true; }
        throw new YamlException("TryGetValue<" + t.FullName + "> is not supported — "
            + "use string / long / double / bool / DateTime / YamlValue");
    }

    public void Set(string key, YamlValue v) {
        if (this._kind != 6) {
            throw new YamlException("Set on non-mapping value (" + this.KindName() + ")");
        }
        int i = 0;
        while (i < this._mapCount) {
            if (this._mapKeys[i] == key) {
                this._mapValues[i] = v;
                return;
            }
            i = i + 1;
        }
        if (this._mapCount == this._mapKeys.Length) {
            int newCap = this._mapKeys.Length * 2;
            if (newCap < 4) { newCap = 4; }
            string[] nk = new string[newCap];
            YamlValue[] nv = new YamlValue[newCap];
            int j = 0;
            while (j < this._mapCount) {
                nk[j] = this._mapKeys[j];
                nv[j] = this._mapValues[j];
                j = j + 1;
            }
            this._mapKeys = nk;
            this._mapValues = nv;
        }
        this._mapKeys[this._mapCount] = key;
        this._mapValues[this._mapCount] = v;
        this._mapCount = this._mapCount + 1;
    }

    /// Snapshot of current mapping keys (insertion order).
    public string[] Keys() {
        if (this._kind != 6) {
            throw new YamlException("Keys() on non-mapping value (" + this.KindName() + ")");
        }
        string[] result = new string[this._mapCount];
        int i = 0;
        while (i < this._mapCount) {
            result[i] = this._mapKeys[i];
            i = i + 1;
        }
        return result;
    }

    public int Count() {
        if (this._kind == 5) { return this._seqCount; }
        if (this._kind == 6) { return this._mapCount; }
        throw new YamlException("Count() on non-collection value (" + this.KindName() + ")");
    }

    /// Recursively copy `this`. Scalars are immutable so the same instance
    /// could safely be shared, but to keep clone semantics uniform we always
    /// produce a fresh YamlValue. Used by anchor / alias resolution where
    /// mutation of one alias must not leak to others. add-yaml-anchors-aliases
    /// (2026-05-25).
    public YamlValue DeepClone() {
        if (this._kind == 0) { return YamlValue.OfNull(); }
        if (this._kind == 1) { return YamlValue.OfBool(this._bool); }
        if (this._kind == 2) { return YamlValue.OfInt(this._int); }
        if (this._kind == 3) { return YamlValue.OfFloat(this._float); }
        if (this._kind == 4) { return YamlValue.OfString(this._str); }
        if (this._kind == 7) {
            YamlValue v = new YamlValue();
            v._kind  = 7;
            v._ts    = this._ts;
            v._tsRaw = this._tsRaw;
            return v;
        }
        if (this._kind == 5) {
            YamlValue seq = YamlValue.OfSequence();
            int i = 0;
            while (i < this._seqCount) {
                YamlValue child = this._seqItems[i];
                YamlValue childClone = child.DeepClone();
                seq.Add(childClone);
                i = i + 1;
            }
            return seq;
        }
        // Mapping (kind == 6)
        YamlValue m = YamlValue.OfMapping();
        int j = 0;
        while (j < this._mapCount) {
            YamlValue v = this._mapValues[j];
            YamlValue vClone = v.DeepClone();
            m.Set(this._mapKeys[j], vClone);
            j = j + 1;
        }
        return m;
    }
}
