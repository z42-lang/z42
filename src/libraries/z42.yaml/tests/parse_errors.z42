// add-z42-yaml (2026-05-24): malformed input → YamlException.
namespace Z42YamlParseErrorsTests;

using Std;
using Std.Test;
using Std.Yaml;

[Test]
void test_tab_in_indentation_throws() {
    bool caught = false;
    try {
        // 1 tab + content
        YamlValue.Parse("a:\n\tb: 1\n");
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_unterminated_double_quote_throws() {
    bool caught = false;
    try {
        YamlValue.Parse("\"no end");
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_unterminated_single_quote_throws() {
    bool caught = false;
    try {
        YamlValue.Parse("'no end");
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_unterminated_flow_sequence_throws() {
    bool caught = false;
    try {
        YamlValue.Parse("[1, 2, 3");
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_unterminated_flow_mapping_throws() {
    bool caught = false;
    try {
        YamlValue.Parse("{a: 1");
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_duplicate_mapping_key_throws() {
    bool caught = false;
    try {
        YamlValue.Parse("name: alice\nname: bob\n");
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_unknown_escape_in_double_quote_throws() {
    bool caught = false;
    try {
        YamlValue.Parse("\"\\q\"");
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_accessor_type_mismatch_throws() {
    YamlValue v = YamlValue.Parse("42");
    bool caught = false;
    try {
        v.AsString();  // it's an int, not a string
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

[Test]
void test_missing_key_throws() {
    YamlValue v = YamlValue.Parse("name: alice\n");
    bool caught = false;
    try {
        v.Get("nonexistent");
    } catch (YamlException e) {
        caught = true;
    }
    Assert.True(caught);
}

// fix-yaml-parser-depth-limit (2026-07-16, review §2.2 / item 8): deep nesting
// (block or flow) must throw a YamlException, not blow the VM stack (DoS).
[Test]
void test_deep_flow_nesting_rejected() {
    string deep = "";
    int n = 300;                       // > 256 depth cap
    int i = 0;
    while (i < n) { deep = deep + "["; i = i + 1; }
    i = 0;
    while (i < n) { deep = deep + "]"; i = i + 1; }
    bool caught = false;
    try { YamlValue.Parse(deep); } catch (YamlException e) { caught = true; }
    Assert.True(caught);
}

[Test]
void test_moderate_flow_nesting_ok() {
    // 100 levels is under the cap and must still parse + drill cleanly.
    string s = "";
    int n = 100;
    int i = 0;
    while (i < n) { s = s + "["; i = i + 1; }
    s = s + "1";
    i = 0;
    while (i < n) { s = s + "]"; i = i + 1; }
    YamlValue v = YamlValue.Parse(s);
    Assert.True(v.IsSequence());
    YamlValue cur = v;
    i = 0;
    while (i < n) { cur = cur.At(0); i = i + 1; }
    Assert.Equal(1L, cur.AsInt());
}
