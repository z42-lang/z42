// requires-caps: socket-listen
// TlsClient failures, as .NET's SslStream (thrown by the VM from Rust): the transport failing
// during the handshake is IOException; the TCP connect failing is SocketException. (A rejected
// certificate — AuthenticationException — needs a TLS server; the VM's Rust tests cover it.)
namespace Z42NetTlsExceptionsTests;

using Std.IO;
using Std.Net.Sockets;
using Std.Harness;

[Test]
void test_silent_peer_handshake_timeout_is_io_exception() {
    var server = new TcpListener();
    server.Bind("127.0.0.1", 0);   // TCP completes via the backlog; no TLS reply ever comes
    bool caught = false;
    try {
        var c = new TlsClient();
        c.Connect("127.0.0.1", server.LocalPort(), 150);
    } catch (IOException e) {
        caught = e.Message.StartsWith("Unable to read data from the transport connection: ");
    }
    server.Stop();
    Assert.True(caught);
}

[Test]
void test_tls_connect_refused_is_socket_exception() {
    var l = new TcpListener();
    l.Bind("127.0.0.1", 0);
    int port = l.LocalPort();
    l.Stop();
    bool caught = false;
    try {
        var c = new TlsClient();
        c.Connect("127.0.0.1", port, 1000);
    } catch (SocketException e) {
        caught = e.SocketErrorCode == SocketError.ConnectionRefused;
    }
    Assert.True(caught);
}

[Test]
void test_closed_tls_client_stream_is_object_disposed() {
    var c = new TlsClient();
    c.Dispose();
    bool caught = false;
    try {
        c.GetStream();
    } catch (ObjectDisposedException e) {
        caught = true;
    }
    Assert.True(caught);
}
