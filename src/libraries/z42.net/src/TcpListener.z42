namespace Std.Net.Sockets;


/// 同步阻塞的 TCP 服务端，对应 .NET 的 `TcpListener`。
public class TcpListener : IDisposable {
    private long _slotId;
    private bool _started;
    private bool _stopped;
    private int  _localPort;
    private string _bindHost;
    // 预 bind 的 SO_REUSEADDR 开关：POSIX 要求在 bind 前设置，故先记录、Bind 时再消费。
    private bool _reuseAddress;

    /// 构造未绑定实例；随后 `Bind(host, port)` 开始监听。
    public TcpListener() {
        this._slotId   = -1;
        this._started  = false;
        this._stopped  = false;
        this._localPort = 0;
        this._bindHost  = "";
        this._reuseAddress = false;
    }

    /// 等价于 `new TcpListener()` 后 `Bind(host, port)` 的静态工厂。
    public static TcpListener Create(string host, int port) {
        var l = new TcpListener();
        l.Bind(host, port);
        return l;
    }

    /// 绑定到 `host:port` 并开始监听；port 0 表示由 OS 分配端口（事后用 `LocalPort()` 查询）。
    public void Bind(string host, int port) {
        if (this._stopped) {
            throw new SocketClosedException();
        }
        if (this._started) {
            throw new InvalidOperationException("TcpListener already bound");
        }
        // 只有用户启用了 REUSEADDR 才走带选项的 builtin。
        long slotId = TcpSocketNative.Listen(host, port, this._reuseAddress);
        this._slotId    = slotId;
        this._localPort = TcpSocketNative.ListenerPort(slotId);
        this._bindHost  = host;
        this._started   = true;
    }

    /// 设置 SO_REUSEADDR（只能在 `Bind` 之前调用）；Bind 之后再调抛 `InvalidOperationException`。
    public void SetReuseAddress(bool enable) {
        if (this._started) {
            throw new InvalidOperationException(
                "SetReuseAddress: TcpListener already bound — call before Bind()");
        }
        this._reuseAddress = enable;
    }

    /// BCL 兼容的空操作；`Bind` 已经原子地完成了 bind + listen。
    public void Start() {
        if (!this._started) {
            throw new InvalidOperationException("Start() called before Bind()");
        }
        // 故意留空 —— bind+listen 在 Bind 里原子完成。
    }

    /// 阻塞直到有对端连接，返回包装已接受 socket 的 `TcpClient`。
    public TcpClient AcceptTcpClient() {
        if (this._stopped) {
            throw new SocketClosedException();
        }
        if (!this._started) {
            throw new InvalidOperationException("AcceptTcpClient() called before Bind()");
        }
        long sockSlot = TcpSocketNative.Accept(this._slotId);
        return new TcpClient(sockSlot, true);
    }

    /// 本地绑定端口 —— 用 port 0 绑定时查询 OS 分配到的端口。
    public int LocalPort() {
        return this._localPort;
    }

    /// 返回绑定主机。
    public string BindHost() {
        return this._bindHost;
    }

    /// 设置监听 socket 的 IP_TTL（Bind 之后调用）。
    public void SetTtl(int ttl) {
        if (this._stopped) { throw new SocketClosedException(); }
        if (!this._started) {
            throw new InvalidOperationException("TcpListener.SetTtl called before Start");
        }
        TcpSocketNative.ListenerSetTtl(this._slotId, ttl);
    }

    /// 停止接受并释放监听 socket；幂等。
    public void Stop() {
        this.Dispose();
    }

    /// 释放监听 socket；幂等。
    public void Dispose() {
        if (this._stopped) return;
        this._stopped = true;
        if (this._started) {
            TcpSocketNative.ListenerClose(this._slotId);
            this._started = false;
        }
    }
}
