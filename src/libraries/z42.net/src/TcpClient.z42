//! 同步阻塞的网络类型。
//!
//! 网络栈：原始 socket（TCP / UDP）、TLS 客户端、HTTP/1.1 客户端与服务端、
//! WebSocket 客户端与服务端、DNS 解析、`IPAddress` / `IPEndPoint`。全部是同步阻塞
//! API——没有 async/await，没有非阻塞 socket，没有 selector；并发靠
//! `Std.Threading.Thread`（`HttpServer` 自带线程化与线程池两个入口）。超时以
//! `SetReadTimeout` / `SetWriteTimeout` / `SetConnectTimeout` 这类毫秒级 setter 表达，
//! 不是每次调用的参数；`millis <= 0` 表示清除超时（回到无限阻塞）。
//!
//! wasm32 目标上所有 socket 操作抛 `NetUnsupportedException`。
//!
//! ## 不支持
//!
//! - async/await、非阻塞 socket、selector/epoll：一切都是阻塞调用 + 线程
//! - HTTP/2、HTTP/3：只有 HTTP/1.1
//! - 服务端 TLS：`HttpServer` 只跑明文 http；没有 `TlsListener`
//! - `wss://`：WebSocket 客户端只接 `ws://`
//! - WebSocket 服务端收消息：客户端帧带掩码，服务端解析不支持
//! - HTTPS 的流式响应体：`SendStreaming` 遇 `https://` 抛 `NotSupportedException`
//! - HTTPS 连接池：keep-alive 池只覆盖明文连接
//! - 客户端证书 / 自定义证书校验 / 系统信任库：只信内置 Mozilla 根集
//! - URL 里的 IPv6 字面量：`http://[::1]/` 解析失败
//! - URL 里的 userinfo：`http://u:p@h/` 抛 `NotSupportedException`
//! - IPv6 zone id：`fe80::1%en0` 解析失败
//! - `IPEndPoint` 作为 socket 参数：所有 socket API 收的是 `(host, port)`
//! - DNS 的记录类型查询与超时控制：只有 `GetHostAddresses`
//! - HTTP 服务端的路由、keep-alive、流式请求体、WebSocket upgrade
//! - 代理（HTTP_PROXY / SOCKS）
//! - wasm32 上的任何 socket：抛 `NetUnsupportedException`
namespace Std.Net.Sockets;


/// 同步阻塞的 TCP 客户端，对应 .NET 的 `TcpClient`。
public class TcpClient : IDisposable {
    private long _slotId;
    private bool _connected;
    private bool _disposed;
    private NetworkStream _stream;
    private string _remoteHost;
    private int _remotePort;
    // _connectTimeoutMs > 0 时下一次 Connect 走带超时的 builtin；0 = 无预设。
    private int _connectTimeoutMs;

    public TcpClient() {
        this._slotId    = -1;
        this._connected = false;
        this._disposed  = false;
        this._stream    = null;
        this._remoteHost = "";
        this._remotePort = 0;
        this._connectTimeoutMs = 0;
    }

    /// 等价于 `new TcpClient()` 后再 `Connect(host, port)` 的静态工厂。
    public static TcpClient ConnectTo(string host, int port) {
        var c = new TcpClient();
        c.Connect(host, port);
        return c;
    }

    /// 建立到 `host:port` 的 TCP 连接，阻塞直到握手完成或失败。
    /// 连接被拒 / DNS 失败 / 网络不可达抛 `SocketException`。
    public void Connect(string host, int port) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (this._connected) {
            throw new InvalidOperationException("TcpClient already connected");
        }
        // 调过 SetConnectTimeout(>0) 后走带超时的 builtin。
        long slotId = TcpSocketNative.Connect(host, port, this._connectTimeoutMs);
        this._slotId     = slotId;
        this._connected  = true;
        this._remoteHost = host;
        this._remotePort = port;
    }

    /// 设置下一次 `Connect` 的超时（毫秒）；`millis <= 0` 清除超时。
    /// 只作用于紧随其后的一次 Connect；该值在同一实例上跨重连持续有效。
    public void SetConnectTimeout(int millis) {
        this._connectTimeoutMs = millis;
    }

    /// 返回该连接的字节流 `NetworkStream`；惰性创建并缓存，重复调用返回同一实例。
    public NetworkStream GetStream() {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._connected) {
            throw new InvalidOperationException("TcpClient not connected — call Connect first");
        }
        if (this._stream == null) {
            this._stream = new NetworkStream(this._slotId);
        }
        return this._stream;
    }

    /// 返回连接的远端主机。
    public string RemoteHost() {
        return this._remoteHost;
    }

    /// 返回连接的远端端口。
    public int RemotePort() {
        return this._remotePort;
    }

    /// 设置读超时（毫秒）；`millis <= 0` 清除超时。
    public void SetReadTimeout(int millis) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._connected) {
            throw new InvalidOperationException("TcpClient not connected — call Connect first");
        }
        TcpSocketNative.SetReadTimeout(this._slotId, millis);
    }

    /// 设置写超时（毫秒）；`millis <= 0` 清除超时。
    public void SetWriteTimeout(int millis) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._connected) {
            throw new InvalidOperationException("TcpClient not connected — call Connect first");
        }
        TcpSocketNative.SetWriteTimeout(this._slotId, millis);
    }

    /// 设置 TCP_NODELAY（禁用 Nagle 算法）。
    public void SetNoDelay(bool enable) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._connected) {
            throw new InvalidOperationException("TcpClient not connected — call Connect first");
        }
        TcpSocketNative.SetNoDelay(this._slotId, enable);
    }

    /// 设置 IP_TTL（跳数限制），`ttl` 通常在 [1, 255]。
    public void SetTtl(int ttl) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._connected) {
            throw new InvalidOperationException("TcpClient not connected — call Connect first");
        }
        TcpSocketNative.SetTtl(this._slotId, ttl);
    }

    /// 开启或关闭 SO_KEEPALIVE（使用系统默认的 idle / interval / probe 参数）。
    public void SetKeepAlive(bool enable) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._connected) {
            throw new InvalidOperationException("TcpClient not connected — call Connect first");
        }
        TcpSocketNative.SetKeepAlive(this._slotId, enable);
    }

    /// 带调参的 SO_KEEPALIVE；`enable == true` 时三个调参值都必须 >= 1。
    public void SetKeepAlive(bool enable, int idleSecs, int intervalSecs, int probes) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._connected) {
            throw new InvalidOperationException("TcpClient not connected — call Connect first");
        }
        TcpSocketNative.SetKeepAliveTuned(this._slotId, enable,
            idleSecs, intervalSecs, probes);
    }

    /// 关闭 socket 并释放底层 fd；幂等。之后的操作抛 `SocketClosedException`。
    public void Dispose() {
        if (this._disposed) return;
        this._disposed = true;
        if (this._stream != null) {
            this._stream.MarkClosed();
        }
        if (this._connected) {
            TcpSocketNative.Close(this._slotId);
            this._connected = false;
        }
    }

    /// `Dispose()` 的别名，对齐 .NET 的 `TcpClient.Close()`。
    public void Close() {
        this.Dispose();
    }

    // 供 `TcpListener.AcceptTcpClient` 使用的内部构造：listener 已从
    // __tcp_accept 拿到 slot id，直接包成已连接的 TcpClient。
    public TcpClient(long slotId, bool fromAccept) {
        this._slotId    = slotId;
        this._connected = true;
        this._disposed  = false;
        this._stream    = null;
        this._remoteHost = "<accepted>";
        this._remotePort = 0;
    }
}
