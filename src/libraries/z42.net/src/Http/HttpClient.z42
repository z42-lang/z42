namespace Std.Net.Http;

using Std.IO;
using Std.Compression;
using Std.Crypto;
using Std.Encoding;
using Std.Net.Sockets;

/// HTTP/1.1 客户端（基于 TCP，https 走 TLS）；支持 keep-alive、超时、重定向、自动解压与 cookie。
public class HttpClient : IDisposable {
    private string    _userAgent;
    private CookieJar _cookieJar;
    private int       _maxRedirects;
    private int       _timeoutMs;
    private bool      _autoDecompress;
    // TCP 连接复用池。
    private bool         _keepAlive;
    private string[]     _poolKeys;
    private TcpClient[]  _poolClients;
    private int          _poolCount;
    private int          _poolCapacity;

    /// 构造默认配置的客户端（所有开关默认关闭）。
    public HttpClient() {
        this._userAgent      = "z42-http/0.1";
        this._cookieJar      = null;
        this._maxRedirects   = 0;
        this._timeoutMs      = 0;
        this._autoDecompress = false;
        this._keepAlive      = false;
        this._poolCapacity   = 8;
        this._poolKeys       = new string[this._poolCapacity];
        this._poolClients    = new TcpClient[this._poolCapacity];
        this._poolCount      = 0;
    }

    /// 启用 TCP 连接复用（HTTP/1.1 keep-alive）；按 host:port 缓存连接（上限 8 条），陈旧连接失败静默重试一次。
    public void SetKeepAlive(bool enable) {
        this._keepAlive = enable;
        if (!enable) { this._closeAllPooled(); }
    }

    /// 是否启用 keep-alive。
    public bool GetKeepAlive() { return this._keepAlive; }

    /// 释放所有池化连接；幂等。之后仍可继续使用（后续请求另开新 socket）。
    public void Dispose() { this._closeAllPooled(); }

    private void _closeAllPooled() {
        int i = 0;
        while (i < this._poolCount) {
            TcpClient c = this._poolClients[i];
            if (c != null) {
                try { c.Dispose(); } catch (Exception e) { /* swallow */ }
            }
            this._poolKeys[i] = null;
            this._poolClients[i] = null;
            i = i + 1;
        }
        this._poolCount = 0;
    }

    private TcpClient _takeFromPool(string key) {
        int i = 0;
        while (i < this._poolCount) {
            if (this._poolKeys[i] == key) {
                TcpClient c = this._poolClients[i];
                int last = this._poolCount - 1;
                if (i != last) {
                    this._poolKeys[i]    = this._poolKeys[last];
                    this._poolClients[i] = this._poolClients[last];
                }
                this._poolKeys[last]    = null;
                this._poolClients[last] = null;
                this._poolCount = last;
                return c;
            }
            i = i + 1;
        }
        return null;
    }

    private void _returnToPool(string key, TcpClient client) {
        int i = 0;
        while (i < this._poolCount) {
            if (this._poolKeys[i] == key) {
                try { this._poolClients[i].Dispose(); } catch (Exception e) { /* swallow */ }
                this._poolClients[i] = client;
                return;
            }
            i = i + 1;
        }
        if (this._poolCount >= this._poolCapacity) {
            try { this._poolClients[0].Dispose(); } catch (Exception e) { /* swallow */ }
            int j = 1;
            while (j < this._poolCount) {
                this._poolKeys[j - 1]    = this._poolKeys[j];
                this._poolClients[j - 1] = this._poolClients[j];
                j = j + 1;
            }
            this._poolCount = this._poolCount - 1;
        }
        this._poolKeys[this._poolCount]    = key;
        this._poolClients[this._poolCount] = client;
        this._poolCount = this._poolCount + 1;
    }

    /// 启用透明解压：发 `Accept-Encoding: gzip, br`，并把 gzip / brotli 响应体解进 `Body`。
    public void SetAutoDecompress(bool enable) {
        this._autoDecompress = enable;
    }

    /// 是否启用自动解压。
    public bool GetAutoDecompress() {
        return this._autoDecompress;
    }

    /// 设置读写超时（毫秒）；`millis <= 0` 禁用（默认 0 = 不超时）。
    public void SetTimeout(int millis) {
        this._timeoutMs = millis;
    }

    /// 返回当前超时（毫秒）。
    public int GetTimeout() {
        return this._timeoutMs;
    }

    /// 启用 3xx 自动跟随；`maxRedirects` 为跳数上限，0 禁用。301/302/303 转 GET，307/308 保留方法与 body。
    public void SetMaxRedirects(int maxRedirects) {
        this._maxRedirects = maxRedirects;
    }

    /// 返回重定向上限。
    public int GetMaxRedirects() {
        return this._maxRedirects;
    }

    /// 设置加到出站请求上的 User-Agent 头。
    public void SetUserAgent(string userAgent) {
        this._userAgent = userAgent;
    }

    /// 挂载 cookie jar，自动吃 Set-Cookie 并自动带 Cookie 头；传 null 禁用（默认）。
    public void SetCookieJar(CookieJar jar) {
        this._cookieJar = jar;
    }

    /// 返回当前 cookie jar（未设置为 null）。
    public CookieJar? GetCookieJar() {
        return this._cookieJar;
    }

    /// 便捷 GET。
    public HttpResponse Get(string url) {
        var req = new HttpRequest(HttpMethod.Get, url);
        return this.Send(req);
    }

    /// 便捷 POST（byte[] body + 显式 Content-Type）。
    public HttpResponse Post(string url, byte[] body, string contentType) {
        var req = new HttpRequest(HttpMethod.Post, url);
        req.SetHeader("Content-Type", contentType);
        req.SetBody(body);
        return this.Send(req);
    }

    /// 便捷 POST（string body，UTF-8 编码 + 显式 Content-Type）。
    public HttpResponse PostString(string url, string body, string contentType) {
        return this.Post(url, Utf8.GetBytes(body), contentType);
    }

    /// 发送任意 `HttpRequest`，返回解析后的 `HttpResponse`。
    ///
    /// 设置了 `SetMaxRedirects(n > 0)` 时会自动跟随 3xx 至多 n 跳。
    public HttpResponse Send(HttpRequest request) {
        HttpRequest cur = request;
        int hops = 0;
        // 每次外层 Send 只做一次 Digest 401 重试；计数放这里避免并发调用互相覆盖。
        int digestAttempts = 0;
        while (true) {
            HttpResponse resp = this._sendOnce(cur);
            // Digest 认证：在重定向逻辑之前处理 401 challenge。
            // 只尝试一次 —— 第二次 401 说明凭据错（或 realm/nonce 被拒），直接把 401 交给调用方。
            if (resp.StatusCode == 401
                && cur.DigestUser.Length > 0
                && digestAttempts < 2) {
                string challenge = resp.Headers.Get("WWW-Authenticate");
                string digestPart = HttpClient._extractDigestChallenge(challenge);
                if (digestPart != null) {
                    // 第二次 401 时，只在服务器显式 stale=true 才重试；否则凭据错误，重试无意义。
                    if (digestAttempts >= 1) {
                        if (!HttpClient._digestChallengeIsStale(digestPart)) {
                            return resp;
                        }
                    }
                    HttpUrl u = HttpUrl.Parse(cur.Url);
                    string authHeader = HttpClient._buildDigestAuthHeader(
                        digestPart, cur.Method, u.Path,
                        cur.DigestUser, cur.DigestPassword,
                        cur.Body);
                    cur.Headers.Set("Authorization", authHeader);
                    digestAttempts = digestAttempts + 1;
                    continue;
                }
            }
            // Auto-follow disabled? Return immediately.
            if (this._maxRedirects <= 0) return resp;
            // Decide if this response should be followed.
            int code = resp.StatusCode;
            bool shouldFollow = code == 301 || code == 302 || code == 303
                             || code == 307 || code == 308;
            if (!shouldFollow) return resp;
            string location = resp.Headers.Get("Location");
            if (location == null || location.Length == 0) {
                // No Location → cannot follow, return as-is.
                return resp;
            }
            hops = hops + 1;
            if (hops > this._maxRedirects) {
                throw new HttpException(
                    "Exceeded redirect limit (" + Int32.ToString(this._maxRedirects)
                    + ") at " + cur.Url);
            }
            string nextUrl = HttpClient._resolveRedirectUrl(cur.Url, location);
            string nextMethod = cur.Method;
            byte[] nextBody = cur.Body;
            // 301/302/303 → switch method to GET per RFC 7231 §6.4. Drop body.
            // 307/308 → preserve method + body.
            if (code == 301 || code == 302 || code == 303) {
                nextMethod = HttpMethod.Get;
                nextBody = null;
            }
            HttpRequest next = new HttpRequest(nextMethod, nextUrl);
            if (nextBody != null) {
                next.SetBody(nextBody);
            }
            // Copy non-host-specific headers. Host header gets re-derived; we
            // intentionally drop Authorization on cross-host hops to avoid
            // credential leakage (per common HTTP client convention; not
            // strict RFC 7231 but matches `curl --location` default).
            HttpUrl oldUrlParsed = HttpUrl.Parse(cur.Url);
            HttpUrl newUrlParsed = HttpUrl.Parse(nextUrl);
            string oldHost = oldUrlParsed.Host;
            string newHost = newUrlParsed.Host;
            bool crossHost = oldHost.ToLower() != newHost.ToLower();
            int i = 0;
            int n = cur.Headers.Count();
            while (i < n) {
                string name = cur.Headers.GetNameAt(i);
                string lower = name.ToLower();
                if (lower != "host" && lower != "content-length" && lower != "cookie") {
                    if (crossHost && lower == "authorization") {
                        // skip
                    } else {
                        next.Headers.Add(name, cur.Headers.GetValueAt(i));
                    }
                }
                i = i + 1;
            }
            cur = next;
        }
        // Unreachable.
        return null;
    }

    // 把重定向 Location 相对当前请求 URL 解析为绝对 URL（支持绝对 URL、绝对路径与相对路径）。
    static string _resolveRedirectUrl(string currentUrl, string location) {
        if (HttpClient._startsWithStr(location, "http://")
            || HttpClient._startsWithStr(location, "https://")) {
            return location;
        }
        HttpUrl base_ = HttpUrl.Parse(currentUrl);
        string portStr = "";
        if (base_.Port != 80) portStr = ":" + Int32.ToString(base_.Port);
        if (location.Length > 0 && location.CharAt(0) == '/') {
            // Absolute path
            return base_.Scheme + "://" + base_.Host + portStr + location;
        }
        // Relative — strip last path component of base, append location.
        string basePath = base_.Path;
        int lastSlash = -1;
        int i = 0;
        while (i < basePath.Length) {
            if (basePath.CharAt(i) == '/') lastSlash = i;
            i = i + 1;
        }
        string parent;
        if (lastSlash < 0) {
            parent = "/";
        } else {
            char[] buf = new char[lastSlash + 1];
            int j = 0;
            while (j <= lastSlash) {
                buf[j] = basePath.CharAt(j);
                j = j + 1;
            }
            parent = String.FromChars(buf);
        }
        return base_.Scheme + "://" + base_.Host + portStr + parent + location;
    }

    static bool _startsWithStr(string s, string prefix) {
        if (s.Length < prefix.Length) return false;
        int i = 0;
        while (i < prefix.Length) {
            if (s.CharAt(i) != prefix.CharAt(i)) return false;
            i = i + 1;
        }
        return true;
    }

    // ── Digest 认证（RFC 7616 / RFC 2617）───────────────────────────────
    // challenge 解析 + 响应构造。

    // 从 WWW-Authenticate 头里取 `Digest <params>` 部分；没有 Digest scheme 返回 null。
    static string _extractDigestChallenge(string header) {
        if (header == null) { return null; }
        // Trim leading whitespace; find "Digest " token (case-insensitive).
        string lower = header.ToLower();
        int idx = HttpClient._indexOfStr(lower, "digest", 0);
        if (idx < 0) { return null; }
        // Must be at start or after a comma/space (avoid matching e.g.
        // a realm value that happens to contain "digest").
        if (idx > 0) {
            char prev = header.CharAt(idx - 1);
            if (prev != ' ' && prev != '\t' && prev != ',') { return null; }
        }
        // Skip past "Digest" + whitespace.
        int p = idx + 6;
        while (p < header.Length
               && (header.CharAt(p) == ' ' || header.CharAt(p) == '\t')) {
            p = p + 1;
        }
        if (p >= header.Length) { return ""; }
        // The rest is the param list, possibly with trailing other-scheme
        // challenges. We don't try to split further — Digest params end at
        // the end of the header for v0 (multi-scheme stacking is rare).
        return header.Substring(p, header.Length - p);
    }

    // 把 Digest 参数列表 tokenize 成并行的 names / values 数组（引号值去外引号）。
    static object[] _parseDigestParams(string params_) {
        string[] names  = new string[16];
        string[] values = new string[16];
        int count = 0;
        int p = 0;
        while (p < params_.Length) {
            // Skip whitespace + commas
            while (p < params_.Length
                   && (params_.CharAt(p) == ' '
                       || params_.CharAt(p) == '\t'
                       || params_.CharAt(p) == ',')) {
                p = p + 1;
            }
            if (p >= params_.Length) break;
            // Read key (up to '=' or end)
            int keyStart = p;
            while (p < params_.Length && params_.CharAt(p) != '='
                   && params_.CharAt(p) != ',') {
                p = p + 1;
            }
            string key = HttpClient._trimSpaces(
                params_.Substring(keyStart, p - keyStart)).ToLower();
            if (p >= params_.Length || params_.CharAt(p) != '=') {
                // Malformed bare token — skip.
                continue;
            }
            p = p + 1;  // consume '='
            // Read value: quoted-string or token until comma
            string value;
            if (p < params_.Length && params_.CharAt(p) == '"') {
                p = p + 1;
                int valStart = p;
                while (p < params_.Length && params_.CharAt(p) != '"') {
                    // RFC quoted-string allows \" but real-world Digest
                    // challenges never contain embedded quotes; treat
                    // backslash literally for simplicity.
                    p = p + 1;
                }
                value = params_.Substring(valStart, p - valStart);
                if (p < params_.Length) p = p + 1;  // closing quote
            } else {
                int valStart = p;
                while (p < params_.Length && params_.CharAt(p) != ',') {
                    p = p + 1;
                }
                value = HttpClient._trimSpaces(
                    params_.Substring(valStart, p - valStart));
            }
            if (count == names.Length) {
                // Grow
                string[] newNames  = new string[names.Length * 2];
                string[] newValues = new string[values.Length * 2];
                int i = 0;
                while (i < count) {
                    newNames[i]  = names[i];
                    newValues[i] = values[i];
                    i = i + 1;
                }
                names = newNames;
                values = newValues;
            }
            names[count]  = key;
            values[count] = value;
            count = count + 1;
        }
        // Pack down to exact size (so caller's .Length is meaningful).
        string[] outNames  = new string[count];
        string[] outValues = new string[count];
        int j = 0;
        while (j < count) {
            outNames[j]  = names[j];
            outValues[j] = values[j];
            j = j + 1;
        }
        object[] pair = new object[2];
        pair[0] = outNames;
        pair[1] = outValues;
        return pair;
    }

    // 按名字（大小写不敏感）查参数；缺省返回 ""。
    static string _digestParamGet(string[] names, string[] values, string key) {
        string lower = key.ToLower();
        int i = 0;
        while (i < names.Length) {
            if (names[i] == lower) { return values[i]; }
            i = i + 1;
        }
        return "";
    }

    // 按配置算法做 hex 哈希；algo 为 "md5" 或 "sha-256"。
    static string _digestHashHex(string algo, string input) {
        if (algo == "sha-256") {
            return Sha256.HashStringHex(input);
        }
        // Default + explicit MD5
        return Md5.HashStringHex(input);
    }

    // 解析后的 challenge 是否含 stale=true（大小写不敏感）；表示旧 nonce 已轮换、应换新值重试。
    static bool _digestChallengeIsStale(string challengeParams) {
        object[] parsed = HttpClient._parseDigestParams(challengeParams);
        string[] names  = (string[])parsed[0];
        string[] values = (string[])parsed[1];
        string stale = HttpClient._digestParamGet(names, values, "stale").ToLower();
        return stale == "true";
    }

    // qop=auth-int 时对 body 做字节级哈希的变体（空字节[]按各算法的"空输入"约定哈希）。
    static string _digestHashHexBytes(string algo, byte[] input) {
        if (algo == "sha-256") {
            return Hex.Encode(Sha256.Hash(input));
        }
        return Hex.Encode(Md5.Hash(input));
    }

    // 构造 `Authorization: Digest ...` 头值；不支持的算法抛 HttpProtocolException。
    // 服务器 qop 只含 auth-int 时，body 参与 HA2 = H(method:uri:H(body))。
    static string _buildDigestAuthHeader(
            string challengeParams,
            string method,
            string uri,
            string user,
            string password,
            byte[] body) {
        object[] parsed = HttpClient._parseDigestParams(challengeParams);
        string[] names  = (string[])parsed[0];
        string[] values = (string[])parsed[1];

        string realm  = HttpClient._digestParamGet(names, values, "realm");
        string nonce  = HttpClient._digestParamGet(names, values, "nonce");
        string opaque = HttpClient._digestParamGet(names, values, "opaque");
        string qop    = HttpClient._digestParamGet(names, values, "qop");
        string algo   = HttpClient._digestParamGet(names, values, "algorithm").ToLower();
        if (algo.Length == 0) { algo = "md5"; }

        if (algo != "md5" && algo != "sha-256") {
            throw new HttpProtocolException(
                "unsupported Digest algorithm '" + algo
                + "' (v0 supports MD5 + SHA-256 only)");
        }

        // qop may be comma-separated list (e.g. "auth,auth-int"). Prefer
        // `auth` if listed; otherwise fall back to `auth-int`. If neither
        // is recognised, reject.
        string qopSelected = "auth";
        if (qop.Length > 0) {
            bool hasAuth = false;
            bool hasAuthInt = false;
            int p = 0;
            while (p < qop.Length) {
                int start = p;
                while (p < qop.Length && qop.CharAt(p) != ',') { p = p + 1; }
                string token = HttpClient._trimSpaces(
                    qop.Substring(start, p - start)).ToLower();
                if (token == "auth") hasAuth = true;
                if (token == "auth-int") hasAuthInt = true;
                if (p < qop.Length) p = p + 1;
            }
            if (!hasAuth && !hasAuthInt) {
                throw new HttpProtocolException(
                    "unrecognised Digest qop '" + qop + "'");
            }
            if (hasAuth) {
                qopSelected = "auth";
            } else {
                qopSelected = "auth-int";
            }
        }

        // HA1 = H(user:realm:password)
        string ha1 = HttpClient._digestHashHex(algo,
            user + ":" + realm + ":" + password);

        // HA2 depends on qop:
        //   qop=auth (or absent): HA2 = H(method:uri)
        //   qop=auth-int:         HA2 = H(method:uri:H(body))
        string ha2;
        if (qopSelected == "auth-int") {
            byte[] bodyBytes = (body == null) ? new byte[0] : body;
            string bodyHash = HttpClient._digestHashHexBytes(algo, bodyBytes);
            ha2 = HttpClient._digestHashHex(algo,
                method + ":" + uri + ":" + bodyHash);
        } else {
            ha2 = HttpClient._digestHashHex(algo, method + ":" + uri);
        }

        // cnonce = 16 random bytes as hex (32 chars)
        byte[] rnd = SecureRandom.GetBytes(16);
        string cnonce = Hex.Encode(rnd);

        // nc: 8-hex monotonic; v0 always restarts at 00000001 per Send
        string nc = "00000001";

        // response = H(HA1:nonce:nc:cnonce:qop:HA2)
        string response;
        if (qop.Length > 0) {
            response = HttpClient._digestHashHex(algo,
                ha1 + ":" + nonce + ":" + nc + ":" + cnonce + ":" + qopSelected + ":" + ha2);
        } else {
            // Legacy RFC 2069 (no qop). response = H(HA1:nonce:HA2)
            response = HttpClient._digestHashHex(algo, ha1 + ":" + nonce + ":" + ha2);
        }

        // Build header. Algorithm + opaque echoed back verbatim when present.
        string h = "Digest username=\"" + user + "\""
                 + ", realm=\"" + realm + "\""
                 + ", nonce=\"" + nonce + "\""
                 + ", uri=\"" + uri + "\""
                 + ", response=\"" + response + "\"";
        if (algo == "sha-256") {
            h = h + ", algorithm=SHA-256";
        }
        // MD5 default: include explicit algorithm only if server sent it
        // (some servers reject when echoed back; others require it).
        // v0: echo when server sent any algorithm at all.
        if (algo == "md5"
            && HttpClient._digestParamGet(names, values, "algorithm").Length > 0) {
            h = h + ", algorithm=MD5";
        }
        if (qop.Length > 0) {
            h = h + ", qop=" + qopSelected
                  + ", nc=" + nc
                  + ", cnonce=\"" + cnonce + "\"";
        }
        if (opaque.Length > 0) {
            h = h + ", opaque=\"" + opaque + "\"";
        }
        return h;
    }

    // 从 from 开始的子串查找；未找到返回 -1。
    static int _indexOfStr(string s, string needle, int from) {
        if (needle.Length == 0) return from;
        int limit = s.Length - needle.Length;
        int i = from;
        while (i <= limit) {
            bool match = true;
            int k = 0;
            while (k < needle.Length) {
                if (s.CharAt(i + k) != needle.CharAt(k)) { match = false; break; }
                k = k + 1;
            }
            if (match) return i;
            i = i + 1;
        }
        return -1;
    }

    /// 发送请求并以流式返回响应（body 留在 `BodyStream`，不缓冲）；只支持 http://。
    public HttpResponse SendStreaming(HttpRequest request) {
        HttpUrl url = HttpUrl.Parse(request.Url);
        // 流式 over TLS 尚未支持；_HttpBodyStream 持有 TcpClient 负责释放，
        // https 流式 body 还无法成帧，直接失败而不是明文连到 443。
        if (url.Scheme == "https") {
            throw new NotSupportedException(
                "SendStreaming over https is not supported yet (TLS streaming-body is a follow-up); use Send/Get which buffers the body, or fetch over http://");
        }
        // Inject required headers (same as _sendOnce).
        if (!request.Headers.Contains("Host")) {
            request.Headers.Set("Host", HttpClient._hostHeaderFor(url));
        }
        if (!request.Headers.Contains("User-Agent")) {
            request.Headers.Set("User-Agent", this._userAgent);
        }
        if (!request.Headers.Contains("Connection")) {
            // Streaming responses never get pooled — emit close.
            request.Headers.Set("Connection", "close");
        }
        if (request.Body != null) {
            request.Headers.Set("Content-Length", Int32.ToString(request.Body.Length));
        }
        byte[] reqBytes = HttpClient._serialiseRequest(request, url);
        var client = new TcpClient();
        client.Connect(url.Host, url.Port);
        if (this._timeoutMs > 0) {
            client.SetReadTimeout(this._timeoutMs);
            client.SetWriteTimeout(this._timeoutMs);
        }
        var stream = client.GetStream();
        stream.Write(reqBytes, 0, reqBytes.Length);
        _HttpResponseHead head = HttpClient._readResponseHead(stream);
        // Build a framing-aware BodyStream.
        Stream bodyStream = HttpClient._buildBodyStream(client, stream, head.Reader, head.Headers);
        HttpResponse resp = new HttpResponse(head.StatusCode, head.ReasonPhrase, head.Headers, new byte[0]);
        resp.BodyStream = bodyStream;
        return resp;
    }

    static Stream _buildBodyStream(object client, Stream stream, object lr, HttpHeaders headers) {
        string te = headers.Get("Transfer-Encoding");
        if (te != null && te.ToLower() == "chunked") {
            return _HttpBodyStream.OfChunked(client, stream, lr);
        }
        string cl = headers.Get("Content-Length");
        if (cl != null) {
            int len;
            try {
                len = Int32.Parse(cl);
            } catch (Exception e) {
                throw new HttpProtocolException("invalid Content-Length: '" + cl + "'");
            }
            return _HttpBodyStream.OfLength(client, stream, lr, len);
        }
        return _HttpBodyStream.OfEof(client, stream, lr);
    }

    // 单次发送（不含重定向处理），供 Send 与测试使用。
    private HttpResponse _sendOnce(HttpRequest request) {
        HttpUrl url = HttpUrl.Parse(request.Url);

        // Inject required headers (don't clobber if user already set).
        if (!request.Headers.Contains("Host")) {
            request.Headers.Set("Host", HttpClient._hostHeaderFor(url));
        }
        if (!request.Headers.Contains("User-Agent")) {
            request.Headers.Set("User-Agent", this._userAgent);
        }
        if (!request.Headers.Contains("Connection")) {
            if (this._keepAlive) {
                request.Headers.Set("Connection", "keep-alive");
            } else {
                request.Headers.Set("Connection", "close");
            }
        }
        if (this._autoDecompress && !request.Headers.Contains("Accept-Encoding")) {
            // 广告两种编码，由服务器挑选；同质量时支持 brotli 则用 brotli。
            request.Headers.Set("Accept-Encoding", "gzip, br");
        }
        if (request.Body != null) {
            request.Headers.Set("Content-Length", Int32.ToString(request.Body.Length));
        }
        // Auto-cookie emit if a jar is attached and the user hasn't set
        // Cookie manually. http:// scheme is `secure = false`.
        if (this._cookieJar != null && !request.Headers.Contains("Cookie")) {
            long now = HttpClient._unixNow();
            bool isSecure = url.Scheme == "https";
            string cookieHdr = this._cookieJar.CookieHeaderFor(url.Host, url.Path, isSecure, now);
            if (cookieHdr.Length > 0) {
                request.Headers.Set("Cookie", cookieHdr);
            }
        }

        // Serialise request → byte[]
        byte[] reqBytes = HttpClient._serialiseRequest(request, url);

        // https 走 TLS 传输；body 完全缓冲（与 TCP 路径一致），每次请求新开连接、用完即弃。
        if (url.Scheme == "https") {
            return this._sendOverTls(url, reqBytes);
        }

        string poolKey = url.Host + ":" + Int32.ToString(url.Port);
        var resp = HttpClient._initialResp();
        TcpClient client = null;
        bool fromPool = false;
        if (this._keepAlive) {
            client = this._takeFromPool(poolKey);
            fromPool = client != null;
        }
        // First attempt — may fail if the pooled connection was closed
        // by the server during idle. One silent retry with a fresh socket.
        bool succeeded = false;
        int attempt = 0;
        while (!succeeded && attempt < 2) {
            if (client == null) {
                client = new TcpClient();
                client.Connect(url.Host, url.Port);
                fromPool = false;
            }
            if (this._timeoutMs > 0) {
                client.SetReadTimeout(this._timeoutMs);
                client.SetWriteTimeout(this._timeoutMs);
            }
            var stream = client.GetStream();
            try {
                stream.Write(reqBytes, 0, reqBytes.Length);
                resp = HttpClient._readResponse(stream);
                succeeded = true;
            } catch (Exception e) {
                try { client.Dispose(); } catch (Exception e2) { /* swallow */ }
                client = null;
                if (!fromPool || attempt == 1) { throw e; }
                fromPool = false;
                attempt = attempt + 1;
            }
        }
        // Pool or dispose based on Connection header.
        bool serverWantsClose = false;
        string respConn = resp.Headers.Get("Connection");
        if (respConn != null && respConn.ToLower() == "close") {
            serverWantsClose = true;
        }
        if (this._keepAlive && !serverWantsClose) {   // ⚠️ 不能用 `using`：所有权有条件转移（入池 or 释放）
            this._returnToPool(poolKey, client);
        } else {
            try { client.Dispose(); } catch (Exception e) { /* swallow */ }
        }
        this._postProcessResponse(resp, url);
        return resp;
    }

    // TCP 与 TLS 两条缓冲路径共用的响应后处理：自动解压 body、把 Set-Cookie 吃进 jar。
    private void _postProcessResponse(HttpResponse resp, HttpUrl url) {
        // 自动解压：在 cookie / 下游观察者看到 body 之前解 gzip；同一路径也解 brotli。
        if (this._autoDecompress) {
            // HttpHeaders.Get returns null when header absent — a server
            // that ignored our Accept-Encoding sends back identity bytes
            // and no Content-Encoding at all. Pre-brotli code crashed on
            // `.ToLower()` here; null-check fix landed with the brotli
            // wiring since the same path is now exercised more broadly.
            string encRaw = resp.Headers.Get("Content-Encoding");
            if (encRaw != null && resp.Body != null && resp.Body.Length > 0) {
                string enc = encRaw.ToLower();
                if (enc == "gzip") {
                    try {
                        byte[] decoded = Gzip.Decompress(resp.Body);
                        resp.Body = decoded;
                    } catch (Exception e) {
                        throw new HttpException(
                            "auto-decompress: gzip decode failed: " + e.Message);
                    }
                } else if (enc == "br") {
                    try {
                        byte[] decoded = Brotli.Decompress(resp.Body);
                        resp.Body = decoded;
                    } catch (Exception e) {
                        throw new HttpException(
                            "auto-decompress: brotli decode failed: " + e.Message);
                    }
                }
            }
        }

        // Auto-cookie ingest if jar attached. Inlined here (rather than via
        // CookieJar.IngestSetCookieHeaders) because passing `HttpHeaders` or
        // `HttpResponse` across files triggers z42's cross-file class-token
        // mismatch. We iterate headers locally and call jar.Add(...) which
        // takes a Cookie (constructed inline in this file).
        if (this._cookieJar != null) {
            long now = HttpClient._unixNow();
            int hi = 0;
            int hn = resp.Headers.Count();
            while (hi < hn) {
                string name = resp.Headers.GetNameAt(hi);
                if (name.ToLower() == "set-cookie") {
                    string raw = resp.Headers.GetValueAt(hi);
                    Cookie c = CookieJar._parseSetCookie(raw, url.Host, url.Path, now);
                    if (c != null) {
                        this._cookieJar.Add(c);
                    }
                }
                hi = hi + 1;
            }
        }
    }

    // 缓冲式 https 发送：新开 TLS 连接、写序列化请求、读完整响应后释放连接。
    private HttpResponse _sendOverTls(HttpUrl url, byte[] reqBytes) {
        var client = new TlsClient();
        client.Connect(url.Host, url.Port, this._timeoutMs);
        var resp = HttpClient._initialResp();
        try {
            if (this._timeoutMs > 0) {
                client.SetReadTimeout(this._timeoutMs);
                client.SetWriteTimeout(this._timeoutMs);
            }
            Stream stream = client.GetStream();
            stream.Write(reqBytes, 0, reqBytes.Length);
            resp = HttpClient._readResponse(stream);
        } catch (Exception e) {
            try { client.Dispose(); } catch (Exception e2) { /* swallow */ }
            throw e;
        }
        try { client.Dispose(); } catch (Exception e) { /* swallow */ }
        this._postProcessResponse(resp, url);
        return resp;
    }

    // `Host` 请求头的值：仅当端口非 scheme 默认（http 80 / https 443）时才带 :port。
    static string _hostHeaderFor(HttpUrl url) {
        bool nonDefault;
        if (url.Scheme == "https") {
            nonDefault = url.Port != 443;
        } else {
            nonDefault = url.Port != 80;
        }
        if (nonDefault) {
            return url.Host + ":" + Int32.ToString(url.Port);
        }
        return url.Host;
    }

    // `var resp = ...` 初始化占位：z42 的 var 推断需要同文件表达式来正确绑定类型 token。
    static HttpResponse _initialResp() {
        return new HttpResponse(0, "", new HttpHeaders(), new byte[0]);
    }

    // 取 Unix 毫秒；用 FQN Clock.WallMillis 而非 `using Std.Time;`，避免把
    // Stopwatch.Stop 引入作用域与 HttpServer.Stop 在名称解析下冲突。
    static long _timeNowMs() { return Clock.WallMillis(); }

    static long _unixNow() {
        return HttpClient._timeNowMs() / 1000L;
    }

    // ── Request serialisation ───────────────────────────────────────────

    static byte[] _serialiseRequest(HttpRequest request, HttpUrl url) {
        // Status line: "METHOD path_and_query HTTP/1.1\r\n"
        string head = request.Method + " " + url.PathAndQuery() + " HTTP/1.1\r\n";
        int i = 0;
        int n = request.Headers.Count();
        while (i < n) {
            head = head + request.Headers.GetNameAt(i) + ": " + request.Headers.GetValueAt(i) + "\r\n";
            i = i + 1;
        }
        head = head + "\r\n";
        byte[] headBytes = Utf8.GetBytes(head);
        if (request.Body == null || request.Body.Length == 0) {
            return headBytes;
        }
        // Combine head + body
        byte[] all = new byte[headBytes.Length + request.Body.Length];
        int k = 0;
        while (k < headBytes.Length) { all[k] = headBytes[k]; k = k + 1; }
        int b = 0;
        while (b < request.Body.Length) { all[headBytes.Length + b] = request.Body[b]; b = b + 1; }
        return all;
    }

    // ── Response parsing ─────────────────────────────────────────────────

    // Parse status line + headers; leave body in the stream. Returns
    // the head with the line-reader (which may have read-ahead bytes
    // belonging to the body — body readers must drain via DrainBuffered
    // before pulling from the stream directly).
    static _HttpResponseHead _readResponseHead(Stream stream) {
        _LineReader lr = new _LineReader(stream);
        string statusLine = lr.ReadLine();
        if (statusLine == null) {
            throw new HttpProtocolException("unexpected EOF reading status line");
        }
        int sp1 = HttpClient._indexOfChar(statusLine, ' ', 0);
        if (sp1 < 0) {
            throw new HttpProtocolException("malformed status line: '" + statusLine + "'");
        }
        string version = HttpClient._substring(statusLine, 0, sp1);
        if (!HttpClient._startsWith(version, "HTTP/1.")) {
            throw new HttpProtocolException("unsupported HTTP version: '" + version + "'");
        }
        int sp2 = HttpClient._indexOfChar(statusLine, ' ', sp1 + 1);
        string codeStr;
        string reason;
        if (sp2 < 0) {
            codeStr = HttpClient._substring(statusLine, sp1 + 1, statusLine.Length);
            reason  = "";
        } else {
            codeStr = HttpClient._substring(statusLine, sp1 + 1, sp2);
            reason  = HttpClient._substring(statusLine, sp2 + 1, statusLine.Length);
        }
        int statusCode;
        try {
            statusCode = Int32.Parse(codeStr);
        } catch (Exception e) {
            throw new HttpProtocolException("invalid status code: '" + codeStr + "'");
        }
        var headers = new HttpHeaders();
        while (true) {
            string line = lr.ReadLine();
            if (line == null) {
                throw new HttpProtocolException("unexpected EOF in headers");
            }
            if (line.Length == 0) break;
            int colon = HttpClient._indexOfChar(line, ':', 0);
            if (colon < 0) {
                throw new HttpProtocolException("malformed header line: '" + line + "'");
            }
            string name  = HttpClient._substring(line, 0, colon);
            string value = HttpClient._trimSpaces(HttpClient._substring(line, colon + 1, line.Length));
            headers.Add(name, value);
        }
        return new _HttpResponseHead(statusCode, reason, headers, lr);
    }

    static HttpResponse _readResponse(Stream stream) {
        _LineReader lr = new _LineReader(stream);

        // Status line
        string statusLine = lr.ReadLine();
        if (statusLine == null) {
            throw new HttpProtocolException("unexpected EOF reading status line");
        }
        // "HTTP/1.1 200 OK"
        int sp1 = HttpClient._indexOfChar(statusLine, ' ', 0);
        if (sp1 < 0) {
            throw new HttpProtocolException("malformed status line: '" + statusLine + "'");
        }
        string version = HttpClient._substring(statusLine, 0, sp1);
        if (!HttpClient._startsWith(version, "HTTP/1.")) {
            throw new HttpProtocolException("unsupported HTTP version: '" + version + "'");
        }
        int sp2 = HttpClient._indexOfChar(statusLine, ' ', sp1 + 1);
        string codeStr;
        string reason;
        if (sp2 < 0) {
            codeStr = HttpClient._substring(statusLine, sp1 + 1, statusLine.Length);
            reason  = "";
        } else {
            codeStr = HttpClient._substring(statusLine, sp1 + 1, sp2);
            reason  = HttpClient._substring(statusLine, sp2 + 1, statusLine.Length);
        }
        int statusCode;
        try {
            statusCode = Int32.Parse(codeStr);
        } catch (Exception e) {
            throw new HttpProtocolException("invalid status code: '" + codeStr + "'");
        }

        // Headers
        var headers = new HttpHeaders();
        while (true) {
            string line = lr.ReadLine();
            if (line == null) {
                throw new HttpProtocolException("unexpected EOF in headers");
            }
            if (line.Length == 0) break;   // empty line = end of headers
            int colon = HttpClient._indexOfChar(line, ':', 0);
            if (colon < 0) {
                throw new HttpProtocolException("malformed header line: '" + line + "'");
            }
            string name  = HttpClient._substring(line, 0, colon);
            string value = HttpClient._trimSpaces(HttpClient._substring(line, colon + 1, line.Length));
            headers.Add(name, value);
        }

        // Body
        string te = headers.Get("Transfer-Encoding");
        byte[] body;
        if (te != null && te.ToLower() == "chunked") {
            body = HttpClient._readChunkedBody(stream, lr);
        } else {
            string cl = headers.Get("Content-Length");
            if (cl != null) {
                int len;
                try {
                    len = Int32.Parse(cl);
                } catch (Exception e) {
                    throw new HttpProtocolException("invalid Content-Length: '" + cl + "'");
                }
                body = HttpClient._readExactly(stream, lr, len);
            } else {
                // No Content-Length, no chunked → read until EOF.
                body = HttpClient._readToEnd(stream, lr);
            }
        }

        return new HttpResponse(statusCode, reason, headers, body);
    }

    // chunked body 解码：累进到一个可增长的 byte[]（z42 不支持 List<byte[]> 字段类型）。
    static byte[] _readChunkedBody(Stream stream, _LineReader lr) {
        byte[] body  = new byte[4096];
        int    used  = 0;
        while (true) {
            string sizeLine = lr.ReadLine();
            if (sizeLine == null) {
                throw new HttpProtocolException("unexpected EOF in chunked body");
            }
            // chunk-size may have extensions: "1a;foo=bar" — strip after ';'
            int semi = HttpClient._indexOfChar(sizeLine, ';', 0);
            string sizeStr;
            if (semi < 0) {
                sizeStr = sizeLine;
            } else {
                sizeStr = HttpClient._substring(sizeLine, 0, semi);
            }
            int size = HttpClient._parseHex(sizeStr);
            if (size < 0) {
                throw new HttpProtocolException("invalid chunk size: '" + sizeStr + "'");
            }
            if (size == 0) {
                // Trailing headers (may be empty) — read until empty line.
                while (true) {
                    string t = lr.ReadLine();
                    if (t == null || t.Length == 0) break;
                }
                break;
            }
            // Ensure capacity for `size` more bytes.
            while (used + size > body.Length) {
                int newCap = body.Length * 2;
                if (newCap < used + size) newCap = used + size;
                byte[] grown = new byte[newCap];
                int j = 0;
                while (j < used) { grown[j] = body[j]; j = j + 1; }
                body = grown;
            }
            byte[] chunk = HttpClient._readExactly(stream, lr, size);
            int k = 0;
            while (k < size) {
                body[used + k] = chunk[k];
                k = k + 1;
            }
            used = used + size;
            // Each chunk is followed by CRLF; consume the empty line.
            lr.ReadLine();
        }
        // Trim body to actual used length.
        byte[] result = new byte[used];
        int i = 0;
        while (i < used) { result[i] = body[i]; i = i + 1; }
        return result;
    }

    // 从 stream 精确读 n 字节（先取 lr 里已缓冲的字节）；过早 EOF 抛 HttpProtocolException。
    static byte[] _readExactly(Stream stream, _LineReader lr, int n) {
        byte[] buf = new byte[n];
        int filled = 0;
        // First drain any bytes already buffered in the line reader.
        filled = lr.DrainBuffered(buf, 0, n);
        while (filled < n) {
            int got = stream.Read(buf, filled, n - filled);
            if (got == 0) {
                throw new HttpProtocolException(
                    "unexpected EOF: needed " + Int32.ToString(n) + " bytes, got " + Int32.ToString(filled));
            }
            filled = filled + got;
        }
        return buf;
    }

    // 读到 EOF —— 用于既无 Content-Length 也无 Transfer-Encoding 的响应。
    static byte[] _readToEnd(Stream stream, _LineReader lr) {
        // Start with whatever is buffered in lr + grow.
        byte[] buf = new byte[4096];
        int filled = lr.DrainBuffered(buf, 0, buf.Length);
        while (true) {
            if (filled == buf.Length) {
                byte[] grown = new byte[buf.Length * 2];
                int j = 0;
                while (j < buf.Length) { grown[j] = buf[j]; j = j + 1; }
                buf = grown;
            }
            int got = stream.Read(buf, filled, buf.Length - filled);
            if (got == 0) break;
            filled = filled + got;
        }
        byte[] result = new byte[filled];
        int k = 0;
        while (k < filled) { result[k] = buf[k]; k = k + 1; }
        return result;
    }

    // ── String helpers ───────────────────────────────────────────────────

    static int _indexOfChar(string s, char c, int start) {
        int i = start;
        while (i < s.Length) {
            if (s.CharAt(i) == c) return i;
            i = i + 1;
        }
        return -1;
    }

    static string _substring(string s, int start, int end) {
        if (start >= end) return "";
        char[] buf = new char[end - start];
        int i = 0;
        while (i < end - start) {
            buf[i] = s.CharAt(start + i);
            i = i + 1;
        }
        return String.FromChars(buf);
    }

    static bool _startsWith(string s, string prefix) {
        if (s.Length < prefix.Length) return false;
        int i = 0;
        while (i < prefix.Length) {
            if (s.CharAt(i) != prefix.CharAt(i)) return false;
            i = i + 1;
        }
        return true;
    }

    static string _trimSpaces(string s) {
        int start = 0;
        while (start < s.Length && (s.CharAt(start) == ' ' || s.CharAt(start) == '\t')) {
            start = start + 1;
        }
        int end = s.Length;
        while (end > start && (s.CharAt(end - 1) == ' ' || s.CharAt(end - 1) == '\t')) {
            end = end - 1;
        }
        return HttpClient._substring(s, start, end);
    }

    static int _parseHex(string s) {
        if (s == null || s.Length == 0) return -1;
        // Accumulate in long: a chunk-size header of 8+ hex digits overflows i32
        // and would wrap to a negative / garbage length (RFC 7230 chunked
        // framing). Reject sizes past int.MaxValue instead of wrapping.
        long result = 0;
        int i = 0;
        while (i < s.Length) {
            int ch = (int)s.CharAt(i);
            int digit;
            if (ch >= 48 && ch <= 57) {
                digit = ch - 48;
            } else if (ch >= 97 && ch <= 102) {
                digit = ch - 97 + 10;
            } else if (ch >= 65 && ch <= 70) {
                digit = ch - 65 + 10;
            } else {
                return -1;
            }
            result = result * 16 + (long)digit;
            if (result > 2147483647L) {
                return -1;
            }
            i = i + 1;
        }
        return (int)result;
    }
}

// ── 响应头载体（内部）───────────────────────────────────────────────────

/// 响应头解析结果载体（内部）：`_readResponseHead` 的类元组返回值。
///
/// 让 SendStreaming 能把 line-reader 及其缓冲字节交给 `_HttpBodyStream`；
/// z42 无元组字面量，用 public class 作载体。
public class _HttpResponseHead {
    /// HTTP 状态码（如 200）。
    public int         StatusCode;
    /// 状态行的 reason-phrase（如 `OK`）；无短语时为空串。
    public string      ReasonPhrase;
    /// 按线序解析出的响应头集合（可含重复名，如 Set-Cookie）。
    public HttpHeaders Headers;
    /// 读头所用的行读取器；预读缓冲可能已含 body 首字节，交给 `_HttpBodyStream` 排干。
    public _LineReader Reader;

    /// 逐字段装配（由 `_readResponseHead` 构造）。
    public _HttpResponseHead(int statusCode, string reasonPhrase, HttpHeaders headers, _LineReader reader) {
        this.StatusCode   = statusCode;
        this.ReasonPhrase = reasonPhrase;
        this.Headers      = headers;
        this.Reader       = reader;
    }
}

// ── 行读取器（内部）─────────────────────────────────────────────────────

/// 从字节流读 CRLF 结尾行的读取器（内部）；容忍纯 LF 结尾。
///
/// 多余字节缓存在内部留待下次读；头解析完后，调用方用 `DrainBuffered` 取回
/// 已从 socket 预读的 body 字节。
public class _LineReader {
    private Stream _stream;
    private byte[] _buf;
    private int    _bufStart;
    private int    _bufEnd;
    // Per-line accumulator (z42 不允许 generic field types like List<int>;
    // use raw growable char[] instead).
    private char[] _line;
    private int    _lineLen;

    /// 基于 `stream` 读行（内部 4096 字节预读缓冲）。
    public _LineReader(Stream stream) {
        this._stream   = stream;
        this._buf      = new byte[4096];
        this._bufStart = 0;
        this._bufEnd   = 0;
        this._line     = new char[256];
        this._lineLen  = 0;
    }

    /// 读一行（不含行尾 CRLF/LF）；EOF 无字节返回 null，空行返回空串。
    public string ReadLine() {
        this._lineLen = 0;
        bool any = false;
        while (true) {
            if (this._bufStart >= this._bufEnd) {
                if (!this._refill()) {
                    if (!any) return null;
                    return this._finishLine();
                }
            }
            int b = (int)this._buf[this._bufStart];
            this._bufStart = this._bufStart + 1;
            any = true;
            if (b == 10) {   // LF — end of line
                return this._finishLine();
            }
            if (b == 13) {   // CR — peek next for LF; skip both
                if (this._bufStart >= this._bufEnd) {
                    this._refill();   // may EOF — line still complete
                }
                if (this._bufStart < this._bufEnd && (int)this._buf[this._bufStart] == 10) {
                    this._bufStart = this._bufStart + 1;
                }
                return this._finishLine();
            }
            if (this._lineLen == this._line.Length) {
                char[] grown = new char[this._line.Length * 2];
                int i = 0;
                while (i < this._lineLen) { grown[i] = this._line[i]; i = i + 1; }
                this._line = grown;
            }
            this._line[this._lineLen] = (char)b;
            this._lineLen = this._lineLen + 1;
        }
        return this._finishLine();
    }

    /// 把预读缓冲里至多 `count` 字节拷到 `dest[offset..]`，返回实际拷贝数。
    public int DrainBuffered(byte[] dest, int offset, int count) {
        int available = this._bufEnd - this._bufStart;
        int toCopy;
        if (available < count) { toCopy = available; } else { toCopy = count; }
        int i = 0;
        while (i < toCopy) {
            dest[offset + i] = this._buf[this._bufStart + i];
            i = i + 1;
        }
        this._bufStart = this._bufStart + toCopy;
        return toCopy;
    }

    // Refill internal buffer; returns false on EOF.
    private bool _refill() {
        this._bufStart = 0;
        int got = this._stream.Read(this._buf, 0, this._buf.Length);
        this._bufEnd = got;
        return got > 0;
    }

    private string _finishLine() {
        char[] chars = new char[this._lineLen];
        int i = 0;
        while (i < this._lineLen) {
            chars[i] = this._line[i];
            i = i + 1;
        }
        return String.FromChars(chars);
    }
}
