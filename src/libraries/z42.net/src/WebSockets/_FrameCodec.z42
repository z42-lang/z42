namespace Std.Net.WebSockets;

using Std.IO;

// RFC 6455 §5 帧编解码器（内部）。
// 帧头布局（网络字节序）：FIN/RSV/opcode、MASK + 7 位长度，必要时扩展长度（16/64 位），
// 客户端出站必须带掩码（MASK=1），服务端出站不得带掩码；7 位长度 0-125 内联，126/127 走扩展长度。
public static class _FrameCodec {

    // ── Opcodes (RFC 6455 §5.2) ──────────────────────────────────────────
    public static int OpContinuation = 0;
    public static int OpText         = 1;
    public static int OpBinary       = 2;
    public static int OpClose        = 8;
    public static int OpPing         = 9;
    public static int OpPong         = 10;

    // 编码单帧（FIN=1、无分片、客户端掩码）；RSV1 保持清零，见 EncodeFrameRsv1。
    public static byte[] EncodeFrame(int opcode, byte[] payload, int payloadLen, byte[] maskingKey) {
        return _FrameCodec._encodeFrameInternal(opcode, payload, payloadLen, maskingKey, false);
    }

    // 客户端→服务端压缩帧：同 EncodeFrame 但置 RSV1（RFC 7692 §7.2.3）。
    public static byte[] EncodeFrameRsv1(int opcode, byte[] payload, int payloadLen, byte[] maskingKey) {
        return _FrameCodec._encodeFrameInternal(opcode, payload, payloadLen, maskingKey, true);
    }

    static byte[] _encodeFrameInternal(int opcode, byte[] payload, int payloadLen, byte[] maskingKey, bool rsv1) {
        if (maskingKey == null || maskingKey.Length != 4) {
            throw new WebSocketProtocolException("masking key must be 4 bytes");
        }
        // 头大小：2（基础）+ 0/2/8（扩展长度）+ 4（掩码）= 6/8/14
        int extLenBytes;
        int hdrLen2;   // 7 位 / 16 位 / 64 位长度字段用到的字节
        if (payloadLen < 126) {
            extLenBytes = 0;
            hdrLen2     = payloadLen;
        } else if (payloadLen < 65536) {
            extLenBytes = 2;
            hdrLen2     = 126;
        } else {
            extLenBytes = 8;
            hdrLen2     = 127;
        }
        int totalLen = 2 + extLenBytes + 4 + payloadLen;
        byte[] frame = new byte[totalLen];
        // 字节 0：FIN=1 + RSV1（可选）+ RSV2/3=0 + opcode（4 位）
        int b0 = 0x80 | (opcode & 0x0F);
        if (rsv1) { b0 = b0 | 0x40; }
        frame[0] = (byte)b0;
        // 字节 1：MASK=1 + 7 位长度字段
        frame[1] = (byte)(0x80 | hdrLen2);
        int off = 2;
        if (extLenBytes == 2) {
            frame[off]     = (byte)((payloadLen >> 8) & 0xFF);
            frame[off + 1] = (byte)(payloadLen & 0xFF);
            off = off + 2;
        } else if (extLenBytes == 8) {
            // 64 位大端长度；z42 int = i32 最大 2^31-1，故高 4 字节恒为 0。
            int i = 0;
            while (i < 4) {
                frame[off + i] = (byte)0;
                i = i + 1;
            }
            frame[off + 4] = (byte)((payloadLen >> 24) & 0xFF);
            frame[off + 5] = (byte)((payloadLen >> 16) & 0xFF);
            frame[off + 6] = (byte)((payloadLen >> 8)  & 0xFF);
            frame[off + 7] = (byte)(payloadLen & 0xFF);
            off = off + 8;
        }
        // 掩码键
        frame[off]     = maskingKey[0];
        frame[off + 1] = maskingKey[1];
        frame[off + 2] = maskingKey[2];
        frame[off + 3] = maskingKey[3];
        off = off + 4;
        // 掩码后的 payload
        int j = 0;
        while (j < payloadLen) {
            byte raw    = payload[j];
            byte mask   = maskingKey[j & 3];
            frame[off + j] = (byte)((int)raw ^ (int)mask);
            j = j + 1;
        }
        return frame;
    }

    // 服务端帧编码器：RFC 6455 §5.1 要求服务端出站不得掩码；布局同 EncodeFrame 但 MASK 清零。
    public static byte[] EncodeServerFrame(int opcode, byte[] payload, int payloadLen) {
        return _FrameCodec._encodeServerFrameInternal(opcode, payload, payloadLen, false);
    }

    // 服务端→客户端压缩帧：同 EncodeServerFrame 但置 RSV1（RFC 7692 §7.2.3）。
    public static byte[] EncodeServerFrameRsv1(int opcode, byte[] payload, int payloadLen) {
        return _FrameCodec._encodeServerFrameInternal(opcode, payload, payloadLen, true);
    }

    static byte[] _encodeServerFrameInternal(int opcode, byte[] payload, int payloadLen, bool rsv1) {
        int extLenBytes;
        int hdrLen2;
        if (payloadLen < 126) {
            extLenBytes = 0;
            hdrLen2     = payloadLen;
        } else if (payloadLen < 65536) {
            extLenBytes = 2;
            hdrLen2     = 126;
        } else {
            extLenBytes = 8;
            hdrLen2     = 127;
        }
        int totalLen = 2 + extLenBytes + payloadLen;
        byte[] frame = new byte[totalLen];
        // 字节 0：FIN=1 + RSV1（可选）+ RSV2/3=0 + opcode（4 位）
        int b0 = 0x80 | (opcode & 0x0F);
        if (rsv1) { b0 = b0 | 0x40; }
        frame[0] = (byte)b0;
        // 字节 1：MASK=0 + 7 位长度字段
        frame[1] = (byte)(hdrLen2);
        int off = 2;
        if (extLenBytes == 2) {
            frame[off]     = (byte)((payloadLen >> 8) & 0xFF);
            frame[off + 1] = (byte)(payloadLen & 0xFF);
            off = off + 2;
        } else if (extLenBytes == 8) {
            int i = 0;
            while (i < 4) { frame[off + i] = (byte)0; i = i + 1; }
            frame[off + 4] = (byte)((payloadLen >> 24) & 0xFF);
            frame[off + 5] = (byte)((payloadLen >> 16) & 0xFF);
            frame[off + 6] = (byte)((payloadLen >> 8)  & 0xFF);
            frame[off + 7] = (byte)(payloadLen & 0xFF);
            off = off + 8;
        }
        // payload 不掩码直接写。
        int j = 0;
        while (j < payloadLen) {
            frame[off + j] = payload[j];
            j = j + 1;
        }
        return frame;
    }

    // 解码入站帧；带掩码的服务端帧按 RFC §5.1 抛协议违规。
    public static _DecodedFrame ReadFrame(Stream stream) {
        // 读 2 个基础字节
        byte[] hdr = _FrameCodec._readExactly(stream, 2);
        int b0 = (int)hdr[0] & 0xFF;
        int b1 = (int)hdr[1] & 0xFF;
        bool fin    = (b0 & 0x80) != 0;
        bool rsv1   = (b0 & 0x40) != 0;
        int  opcode = b0 & 0x0F;
        bool mask   = (b1 & 0x80) != 0;
        int  len7   = b1 & 0x7F;
        // 服务端出站不得掩码（RFC §5.1）
        if (mask) {
            throw new WebSocketProtocolException("server frame is masked (RFC 6455 §5.1 violation)");
        }
        long payloadLen;
        if (len7 < 126) {
            payloadLen = (long)len7;
        } else if (len7 == 126) {
            byte[] ext = _FrameCodec._readExactly(stream, 2);
            payloadLen = (((long)ext[0] & 0xFF) << 8) | ((long)ext[1] & 0xFF);
        } else {
            byte[] ext = _FrameCodec._readExactly(stream, 8);
            payloadLen = 0L;
            int i = 0;
            while (i < 8) {
                payloadLen = (payloadLen << 8) | ((long)ext[i] & 0xFF);
                i = i + 1;
            }
        }
        if (payloadLen < 0L || payloadLen > 2147483640L) {
            // 上限到 z42 i32 长度；超大 payload v0 不支持。
            throw new WebSocketProtocolException("frame payload too large for v0");
        }
        int payLen32 = (int)payloadLen;
        byte[] payload = _FrameCodec._readExactly(stream, payLen32);
        return new _DecodedFrame(fin, opcode, payload, rsv1);
    }

    static byte[] _readExactly(Stream stream, int n) {
        byte[] buf = new byte[n];
        int got = 0;
        while (got < n) {
            int r = stream.Read(buf, got, n - got);
            if (r == 0) {
                throw new WebSocketProtocolException(
                    "unexpected EOF: needed " + Int32.ToString(n) + " bytes, got " + Int32.ToString(got));
            }
            got = got + r;
        }
        return buf;
    }
}

// 解码后的入站帧视图（内部），由 _FrameCodec.ReadFrame 返回。
public class _DecodedFrame {
    public bool   Fin;
    public int    Opcode;
    public byte[] Payload;
    public bool   Rsv1;     // per-message-deflate 压缩 payload 标志

    public _DecodedFrame(bool fin, int opcode, byte[] payload, bool rsv1) {
        this.Fin     = fin;
        this.Opcode  = opcode;
        this.Payload = payload;
        this.Rsv1    = rsv1;
    }
}
