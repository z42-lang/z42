namespace Std.Net.WebSockets;

/// WebSocket 消息类型常量（值即 RFC 6455 §5.2 opcode）。
public static class WebSocketMessageType {
    /// 文本消息（0x1）。
    public static int Text   = 1;
    /// 二进制消息（0x2）。
    public static int Binary = 2;
    /// 关闭帧（0x8）。
    public static int Close  = 8;
    /// Ping（0x9）。
    public static int Ping   = 9;
    /// Pong（0xA）。
    public static int Pong   = 10;
}
