namespace Std.Net.WebSockets;

using Std.IO;
using Std.Encoding;
using Std.Compression;
using Std.Net.Sockets;

/// 每个客户端的连接句柄，由 `WebSocketServer.Accept` 返回；提供与 `WebSocketClient` 对称的帧收发 API。
public class WebSocketConnection : IDisposable {
    private TcpClient _tcp;
    private Stream    _stream;
    private int       _state;
    // per-message-deflate 开关：开启时出站 Text/Binary 帧压缩（raw deflate 去尾 00-00-FF-FF）并置 RSV1。
    private bool      _permessageDeflate;

    /// 由 `WebSocketServer.Accept` 构造（握手已完成）。
    public WebSocketConnection(TcpClient tcp, Stream stream) {
        this._tcp                = tcp;
        this._stream             = stream;
        this._state              = WebSocketState.Open;
        this._permessageDeflate  = false;
    }

    /// 返回当前连接状态。
    public int State() { return this._state; }

    /// 启用 / 禁用 per-message-deflate（RFC 7692）；双方必须一致，否则对端会拒绝带 RSV1 的帧。
    public void SetPermessageDeflate(bool enable) { this._permessageDeflate = enable; }

    /// 是否启用 per-message-deflate。
    public bool GetPermessageDeflate() { return this._permessageDeflate; }

    /// 发送 UTF-8 文本帧。
    public void SendText(string text) {
        this._ensureOpen();
        byte[] payload = Utf8.GetBytes(text);
        if (this._permessageDeflate) {
            byte[] compressed = WebSocketConnection._deflateStripTail(payload);
            byte[] frame = _FrameCodec.EncodeServerFrameRsv1(_FrameCodec.OpText,
                                                             compressed, compressed.Length);
            this._stream.Write(frame, 0, frame.Length);
        } else {
            byte[] frame = _FrameCodec.EncodeServerFrame(_FrameCodec.OpText,
                                                         payload, payload.Length);
            this._stream.Write(frame, 0, frame.Length);
        }
    }

    /// 发送 `data[0..length]` 的二进制帧。
    public void SendBinary(byte[] data, int length) {
        this._ensureOpen();
        if (this._permessageDeflate) {
            byte[] slice;
            if (length == data.Length) {
                slice = data;
            } else {
                slice = new byte[length];
                int i = 0;
                while (i < length) { slice[i] = data[i]; i = i + 1; }
            }
            byte[] compressed = WebSocketConnection._deflateStripTail(slice);
            byte[] frame = _FrameCodec.EncodeServerFrameRsv1(_FrameCodec.OpBinary,
                                                             compressed, compressed.Length);
            this._stream.Write(frame, 0, frame.Length);
        } else {
            byte[] frame = _FrameCodec.EncodeServerFrame(_FrameCodec.OpBinary,
                                                         data, length);
            this._stream.Write(frame, 0, frame.Length);
        }
    }

    /// 发送 ping 控制帧（payload 需 ≤ 125 字节，RFC §5.5）。
    public void SendPing(byte[] payload, int length) {
        this._ensureOpen();
        if (length > 125) {
            throw new WebSocketProtocolException(
                "ping payload must be ≤ 125 bytes (got " + length.ToString() + ")");
        }
        byte[] frame = _FrameCodec.EncodeServerFrame(_FrameCodec.OpPing,
                                                     payload, length);
        this._stream.Write(frame, 0, frame.Length);
    }

    /// 阻塞读下一个入站消息；Ping 自动回 Pong，Close 切状态并返回 Close 类型消息。
    public WebSocketMessage Receive() {
        if (this._state == WebSocketState.Closed) {
            throw new InvalidOperationException("WebSocketConnection already closed");
        }
        while (true) {
            _DecodedFrame f = _FrameCodec.ReadFrame(this._stream);
            int op = f.Opcode;
            if (op == _FrameCodec.OpText) {
                byte[] payload = f.Payload;
                if (f.Rsv1) {
                    if (!this._permessageDeflate) {
                        throw new WebSocketProtocolException(
                            "received RSV1 frame but per-message-deflate not enabled");
                    }
                    payload = WebSocketConnection._inflateAppendTail(payload);
                }
                return new WebSocketMessage(WebSocketMessageType.Text, payload);
            }
            if (op == _FrameCodec.OpBinary) {
                byte[] payload = f.Payload;
                if (f.Rsv1) {
                    if (!this._permessageDeflate) {
                        throw new WebSocketProtocolException(
                            "received RSV1 frame but per-message-deflate not enabled");
                    }
                    payload = WebSocketConnection._inflateAppendTail(payload);
                }
                return new WebSocketMessage(WebSocketMessageType.Binary, payload);
            }
            if (op == _FrameCodec.OpPing) {
                // 自动回同 payload 的 Pong（RFC §5.5.3）。
                byte[] pong = _FrameCodec.EncodeServerFrame(_FrameCodec.OpPong,
                                                            f.Payload, f.Payload.Length);
                this._stream.Write(pong, 0, pong.Length);
                continue;
            }
            if (op == _FrameCodec.OpPong) {
                // 忽略主动发来的 pong（RFC §5.5.3），继续循环。
                continue;
            }
            if (op == _FrameCodec.OpClose) {
                this._state = WebSocketState.Closed;
                return new WebSocketMessage(WebSocketMessageType.Close, f.Payload);
            }
            // 保留 / 未知控制帧。
            throw new WebSocketProtocolException(
                "received unsupported opcode " + op.ToString());
        }
        return null;  // unreachable
    }

    /// 发带状态码（如 1000 正常关闭）+ UTF-8 reason 的 Close 控制帧；之后本地视为已关闭。
    public void Close(int statusCode, string reason) {
        if (this._state == WebSocketState.Closed) return;
        byte[] reasonBytes = Utf8.GetBytes(reason);
        byte[] payload = new byte[2 + reasonBytes.Length];
        payload[0] = (byte)((statusCode >> 8) & 0xFF);
        payload[1] = (byte)(statusCode & 0xFF);
        int i = 0;
        while (i < reasonBytes.Length) {
            payload[2 + i] = reasonBytes[i];
            i = i + 1;
        }
        byte[] frame = _FrameCodec.EncodeServerFrame(_FrameCodec.OpClose,
                                                     payload, payload.Length);
        this._stream.Write(frame, 0, frame.Length);
        this._state = WebSocketState.Closed;
    }

    /// 释放底层 TCP socket；幂等。
    public void Dispose() {
        if (this._state != WebSocketState.Closed) {
            this._state = WebSocketState.Closed;
        }
        if (this._tcp != null) {
            this._tcp.Dispose();
            this._tcp = null;
        }
    }

    void _ensureOpen() {
        if (this._state == WebSocketState.Closed) {
            throw new InvalidOperationException("WebSocketConnection: already closed");
        }
    }

    // ── per-message-deflate helpers (RFC 7692 §7.2.1 / §7.2.2) ───────────────
    //
    // 压缩帧的线上格式是 RFC 1951 raw deflate，发送方去掉同步刷新尾 00 00 FF FF，
    // 接收方在 inflate 前把它补回。

    static byte[] _deflateStripTail(byte[] data) {
        byte[] compressed = Deflate.Compress(data);
        // 尾 4 字节 00 00 FF FF 存在才剥；否则按原样发出（接收方 inflate 会干净地报错）。
        if (compressed.Length >= 4
            && (int)compressed[compressed.Length - 4] == 0
            && (int)compressed[compressed.Length - 3] == 0
            && ((int)compressed[compressed.Length - 2] & 0xFF) == 0xFF
            && ((int)compressed[compressed.Length - 1] & 0xFF) == 0xFF) {
            byte[] stripped = new byte[compressed.Length - 4];
            int i = 0;
            while (i < stripped.Length) { stripped[i] = compressed[i]; i = i + 1; }
            return stripped;
        }
        return compressed;
    }

    static byte[] _inflateAppendTail(byte[] data) {
        byte[] withTail = new byte[data.Length + 4];
        int i = 0;
        while (i < data.Length) { withTail[i] = data[i]; i = i + 1; }
        withTail[data.Length]     = (byte)0x00;
        withTail[data.Length + 1] = (byte)0x00;
        withTail[data.Length + 2] = (byte)0xFF;
        withTail[data.Length + 3] = (byte)0xFF;
        return Deflate.Decompress(withTail);
    }
}
