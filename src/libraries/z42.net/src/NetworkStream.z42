namespace Std.Net.Sockets;

using Std.IO;

/// TCP socket 之上的字节流，`Std.IO.Stream` 的子类，由 `TcpClient.GetStream()` 给出。
public class NetworkStream : Stream {
    private long _slotId;
    private bool _closed;

    public NetworkStream(long slotId) {
        this._slotId = slotId;
        this._closed = false;
    }

    // ── Capability overrides ─────────────────────────────────────────────

    /// 始终可读（关闭后为 false）。
    override bool CanRead() {
        return !this._closed;
    }

    /// 始终可写（关闭后为 false）。
    override bool CanWrite() {
        return !this._closed;
    }

    /// 恒为 false。
    override bool CanSeek() {
        return false;
    }

    // ── Core I/O ─────────────────────────────────────────────────────────

    /// 部分读：返回读到的字节数，0 表示对端关闭；socket 错误包成 `IOException`。
    override int Read(byte[] buffer, int offset, int count) {
        this.EnsureOpen();
        if (count == 0) return 0;
        // socket 失败以 IOException 抛出，InnerException 为原 SocketException。
        try {
            return TcpSocketNative.Read(this._slotId, buffer, offset, count);
        } catch (SocketException e) {
            throw new IOException("Unable to read data from the transport connection: " + e.Message + ".", e);
        }
    }

    /// 阻塞写，全部字节写出后返回。
    override void Write(byte[] buffer, int offset, int count) {
        this.EnsureOpen();
        if (count == 0) return;
        try {
            TcpSocketNative.Write(this._slotId, buffer, offset, count);
        } catch (SocketException e) {
            throw new IOException("Unable to write data to the transport connection: " + e.Message + ".", e);
        }
    }

    // ── Lifecycle ────────────────────────────────────────────────────────

    /// 标记本流已关闭；幂等。底层 fd 由 `TcpClient.Dispose()` 释放。
    override void Close() {
        // 幂等；之后 Read/Write 经 EnsureOpen 抛 SocketClosedException。
        this._closed = true;
    }

    // ── Internal accessor for owning TcpClient ───────────────────────────

    // 供 `TcpClient.Dispose` 调用：即使用户仍持有缓存引用，也能翻转流的 _closed 位。
    public void MarkClosed() {
        this._closed = true;
    }

    // ── Internals ────────────────────────────────────────────────────────

    private void EnsureOpen() {
        if (this._closed) {
            throw new SocketClosedException();
        }
    }
}
