namespace Std.Net.Sockets;

using Std.IO;

/// TLS 会话之上的字节流（rustls 客户端侧），`NetworkStream` 的 TLS 版。
public class TlsStream : Stream {
    private long _slotId;
    private bool _closed;

    /// 以底层 TLS 会话的 slot 句柄包装流；初始为打开状态。
    public TlsStream(long slotId) {
        this._slotId = slotId;
        this._closed = false;
    }

    /// 关闭后为 false，否则 true。
    override bool CanRead() {
        return !this._closed;
    }

    /// 关闭后为 false，否则 true。
    override bool CanWrite() {
        return !this._closed;
    }

    /// 恒为 false。
    override bool CanSeek() {
        return false;
    }

    /// 从 TLS 会话读字节；0 表示对端关闭。
    override int Read(byte[] buffer, int offset, int count) {
        this.EnsureOpen();
        if (count == 0) return 0;
        return TlsSocketNative.Read(this._slotId, buffer, offset, count);
    }

    /// 阻塞写，全部字节加密并刷出后返回。
    override void Write(byte[] buffer, int offset, int count) {
        this.EnsureOpen();
        if (count == 0) return;
        // 阻塞写：每字节都加密 + flush 后才返回；失败由 VM 抛 IOException。
        TlsSocketNative.Write(this._slotId, buffer, offset, count);
    }

    /// 标记本流已关闭；幂等。
    override void Close() {
        this._closed = true;
    }

    // 供 TlsClient.Dispose 调用：即使用户仍持有缓存引用，也翻转 _closed 位。
    /// 翻转 _closed 位使本流失效；幂等，底层会话由 TlsClient.Dispose 释放。
    public void MarkClosed() {
        this._closed = true;
    }

    private void EnsureOpen() {
        if (this._closed) {
            throw new SocketClosedException();
        }
    }
}

/// 同步阻塞的 TLS 客户端；证书校验始终开启（rustls + 内置 Mozilla 根集，SNI = 连接主机）。
public class TlsClient : IDisposable {
    private long      _slotId;
    private bool      _connected;
    private bool      _disposed;
    private TlsStream _stream;
    private string    _remoteHost;
    private int       _remotePort;

    /// 构造未连接实例；随后 `Connect(host, port, timeoutMs)` 建立会话。
    public TlsClient() {
        this._slotId     = -1;
        this._connected  = false;
        this._disposed   = false;
        this._stream     = null;
        this._remoteHost = "";
        this._remotePort = 0;
    }

    /// 建立到 `host:port` 的 TCP 连接并完成 TLS 握手；`timeoutMs > 0` 同时约束两者。
    public void Connect(string host, int port, int timeoutMs) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (this._connected) {
            throw new InvalidOperationException("TlsClient already connected");
        }
        long slotId = TlsSocketNative.Connect(host, port, timeoutMs);
        this._slotId     = slotId;
        this._connected  = true;
        this._remoteHost = host;
        this._remotePort = port;
    }

    /// 返回该会话的字节流（具体类型为 `TlsStream`）；惰性创建并缓存。
    public Stream GetStream() {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._connected) {
            throw new InvalidOperationException("TlsClient not connected — call Connect first");
        }
        if (this._stream == null) {
            this._stream = new TlsStream(this._slotId);
        }
        return this._stream;
    }

    /// 返回连接的远端主机。
    public string RemoteHost() {
        return this._remoteHost;
    }

    /// 返回连接的远端端口。
    public int RemotePort() {
        return this._remotePort;
    }

    /// 设置读超时（毫秒）；`millis <= 0` 清除超时。
    public void SetReadTimeout(int millis) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._connected) {
            throw new InvalidOperationException("TlsClient not connected — call Connect first");
        }
        TlsSocketNative.SetReadTimeout(this._slotId, millis);
    }

    /// 设置写超时（毫秒）；`millis <= 0` 清除超时。
    public void SetWriteTimeout(int millis) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._connected) {
            throw new InvalidOperationException("TlsClient not connected — call Connect first");
        }
        TlsSocketNative.SetWriteTimeout(this._slotId, millis);
    }

    /// 关闭会话并释放底层 fd；幂等。
    public void Dispose() {
        if (this._disposed) return;
        this._disposed = true;
        if (this._stream != null) {
            this._stream.MarkClosed();
        }
        if (this._connected) {
            TlsSocketNative.Close(this._slotId);
            this._connected = false;
        }
    }

    /// `Dispose()` 的别名，对齐 `TcpClient.Close()`。
    public void Close() {
        this.Dispose();
    }
}
