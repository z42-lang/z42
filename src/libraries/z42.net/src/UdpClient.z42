namespace Std.Net.Sockets;


/// 同步阻塞的 UDP（数据报）socket，对应 .NET 的 `UdpClient`。
public class UdpClient : IDisposable {
    private long   _slotId;
    private bool   _bound;
    private bool   _disposed;
    private int    _localPort;
    private string _bindHost;
    // 连接模式的默认远端地址（存于对象内，底层仍用 sendto/recvfrom，无内核级 connected 状态）。
    private bool   _connected;
    private string _remoteHost;
    private int    _remotePort;
    // 最近一次 ReceiveInto 的对端地址（Receive 自带返回值，无需共享状态）。
    private string _lastRxHost;
    private int    _lastRxPort;

    public UdpClient() {
        this._slotId     = -1;
        this._bound      = false;
        this._disposed   = false;
        this._localPort  = 0;
        this._bindHost   = "";
        this._connected  = false;
        this._remoteHost = "";
        this._remotePort = 0;
        this._lastRxHost = "";
        this._lastRxPort = 0;
    }

    /// 绑定到 `host:port`；port 0 由 OS 分配临时端口（事后用 `LocalPort()` 查询）。
    public void Bind(string host, int port) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (this._bound) {
            throw new InvalidOperationException("UdpClient already bound");
        }
        long slotId = UdpSocketNative.Bind(host, port);
        this._slotId    = slotId;
        this._localPort = UdpSocketNative.LocalPort(slotId);
        this._bindHost  = host;
        this._bound     = true;
    }

    /// 向 `remoteHost:remotePort` 发送 `data[0..length]` 的数据报，返回发送字节数。
    /// 若尚未 Bind，则自动绑定到 ("0.0.0.0", 0)。
    public int Send(byte[] data, int length, string remoteHost, int remotePort) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._bound) {
            // 首次 Send 自动绑定到临时端口。
            this.Bind("0.0.0.0", 0);
        }
        return UdpSocketNative.Send(this._slotId, data, 0, length, remoteHost, remotePort);
    }

    /// 阻塞直到收到一个数据报，返回数据报及其发送方地址。
    public UdpReceiveResult Receive() {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._bound) {
            throw new InvalidOperationException("UdpClient.Receive() called before Bind()");
        }
        object[] raw = UdpSocketNative.Receive(this._slotId);
        // `new UdpReceiveResult(...)` 必须与返回类型声明在同一文件里，
        // 否则 z42 的跨文件类型解析会产生两个不同的类 token。
        byte[] buf  = (byte[])raw[0];
        string host = (string)raw[1];
        int    port = (int)(long)raw[2];
        return new UdpReceiveResult(buf, host, port);
    }

    /// 设置默认远端地址，供后续 `SendConnected` 使用；不调用 OS 的 connect(2)。
    public void Connect(string remoteHost, int remotePort) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        this._remoteHost = remoteHost;
        this._remotePort = remotePort;
        this._connected  = true;
    }

    /// 清除默认远端地址；幂等。
    public void Disconnect() {
        this._connected  = false;
        this._remoteHost = "";
        this._remotePort = 0;
    }

    /// 是否已 Connect 且未 Disconnect。
    public bool IsConnected() {
        return this._connected;
    }

    /// 向 `Connect` 设置的远端发送 `data[0..length]`；未 Connect 抛 `InvalidOperationException`。
    public int SendConnected(byte[] data, int length) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._connected) {
            throw new InvalidOperationException(
                "UdpClient.SendConnected called before Connect()");
        }
        return this.Send(data, length, this._remoteHost, this._remotePort);
    }

    /// 向已连接的远端发送整个 `data` 数组。
    public int SendConnected(byte[] data) {
        return this.SendConnected(data, data.Length);
    }

    /// 把数据报收进调用方缓冲 `buf[offset..offset+count)`，省一次分配；返回写入字节数。
    /// 对端地址通过 `LastReceiveHost` / `LastReceivePort` 读取。
    public int ReceiveInto(byte[] buf, int offset, int count) {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._bound) {
            throw new InvalidOperationException("UdpClient.ReceiveInto() called before Bind()");
        }
        object[] raw = UdpSocketNative.ReceiveInto(this._slotId, buf, offset, count);
        int n = (int)(long)raw[0];
        this._lastRxHost = (string)raw[1];
        this._lastRxPort = (int)(long)raw[2];
        return n;
    }

    /// 把数据报收满整个 `buf`（offset 0、count buf.Length）。
    public int ReceiveIntoFull(byte[] buf) {
        return this.ReceiveInto(buf, 0, buf.Length);
    }

    /// 最近一次 `ReceiveInto*` 的对端主机（成功接收前为空）。
    public string LastReceiveHost() { return this._lastRxHost; }

    /// 最近一次 `ReceiveInto*` 的对端端口（成功接收前为 0）。
    public int    LastReceivePort() { return this._lastRxPort; }

    // ── 组播 ────────────────────────────────────────────────────────────

    /// 加入 IPv4 组播组；`ifaceIp` 传 "0.0.0.0" 表示由 OS 选择接口。
    public void JoinMulticastGroup(string groupIp, string ifaceIp) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._bound) {
            throw new InvalidOperationException("JoinMulticastGroup before Bind");
        }
        UdpSocketNative.JoinMulticast(this._slotId, groupIp, ifaceIp);
    }

    /// 加入 IPv4 组播组，接口交给 OS（0.0.0.0）。
    public void JoinMulticastGroup(string groupIp) {
        this.JoinMulticastGroup(groupIp, "0.0.0.0");
    }

    /// 离开之前加入的 IPv4 组播组。
    public void LeaveMulticastGroup(string groupIp, string ifaceIp) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._bound) {
            throw new InvalidOperationException("LeaveMulticastGroup before Bind");
        }
        UdpSocketNative.LeaveMulticast(this._slotId, groupIp, ifaceIp);
    }

    /// 离开 IPv4 组播组，接口交给 OS（0.0.0.0）。
    public void LeaveMulticastGroup(string groupIp) {
        this.LeaveMulticastGroup(groupIp, "0.0.0.0");
    }

    /// 设置 IP_MULTICAST_LOOP（本 socket 发出的组播是否回环到本机）。
    public void SetMulticastLoop(bool enable) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._bound) {
            throw new InvalidOperationException("SetMulticastLoop before Bind");
        }
        UdpSocketNative.SetMulticastLoop(this._slotId, enable);
    }

    /// 设置单播发送的 IP_TTL。
    public void SetTtl(int ttl) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._bound) {
            throw new InvalidOperationException("SetTtl before Bind");
        }
        UdpSocketNative.SetTtl(this._slotId, ttl);
    }

    /// 设置读超时（毫秒）；`millis <= 0` 清除超时。需先 Bind。
    public void SetReadTimeout(int millis) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._bound) {
            throw new InvalidOperationException("SetReadTimeout before Bind");
        }
        UdpSocketNative.SetReadTimeout(this._slotId, millis);
    }

    /// 设置写超时（毫秒）；`millis <= 0` 清除超时。需先 Bind。
    public void SetWriteTimeout(int millis) {
        if (this._disposed) { throw new SocketClosedException(); }
        if (!this._bound) {
            throw new InvalidOperationException("SetWriteTimeout before Bind");
        }
        UdpSocketNative.SetWriteTimeout(this._slotId, millis);
    }

    /// 本地绑定端口（用 port 0 绑定时查询 OS 分配到的端口）。
    public int LocalPort() {
        if (this._disposed) {
            throw new SocketClosedException();
        }
        if (!this._bound) {
            throw new InvalidOperationException("UdpClient.LocalPort() called before Bind()");
        }
        return this._localPort;
    }

    /// 返回绑定主机。
    public string BindHost() {
        return this._bindHost;
    }

    /// 关闭 socket；幂等。之后的操作抛 `SocketClosedException`。
    public void Dispose() {
        if (this._disposed) return;
        this._disposed = true;
        if (this._bound) {
            UdpSocketNative.Close(this._slotId);
            this._bound = false;
        }
    }

    /// `Dispose()` 的别名，对齐 .NET 的 `UdpClient.Close()`。
    public void Close() {
        this.Dispose();
    }
}
