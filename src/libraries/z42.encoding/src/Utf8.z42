namespace Std.Encoding;

/// UTF-8 编解码：string 与 byte[] 双向转换，严格拒绝非法编码。
public static class Utf8 {
    /// 把字符串现有 UTF-8 存储复制到独立字节数组。
    public static byte[] GetBytes(string s) {
        int total = s.ByteLength;
        byte[] result = new byte[total];
        if (total > 0) { s.CopyUtf8To(0, result, 0, total); }
        return result;
    }

    /// 从字节数组的独立快照构造字符串；非法 UTF-8 抛 FormatException。
    public static string GetString(byte[] bytes) {
        int count = bytes.Length;
        if (count == 0) { return ""; }
        return String.FromUtf8(bytes, 0, count);
    }
}
