namespace Std.Diagnostics;

/// VM 运行时累计计数快照（由 VM 直接填充，用户不能 new）。
public class RuntimeCounters {
    // ── 运行时 counter（counters.rs RuntimeCounters） ──

    /// 调用的 builtin 函数次数（`__str_length` / `__print` / …）。
    public long BuiltinCalls        { get; }

    /// 派发的 native FFI 调用次数（用户 `[Native]` extern 方法）。
    public long NativeCalls         { get; }

    /// JIT 编译的方法数（tier-up 编译触发）。
    public long JitMethodsCompiled  { get; }

    /// 累计 JIT 编译墙钟时间（微秒）；per-compile span 计时未接线时为 0。
    public long JitCompileUsTotal   { get; }

    /// mixed-mode：interp 帧把已编译 callee 路由到其 native code 的次数（>0 = mixed-mode 生效）。
    public long JitNativeFromInterp { get; }

    /// 抛出的用户异常数（`throw` + VM 抬升的算术/类型错误）。
    public long ExceptionsThrown    { get; }

    /// 被 `try/catch` 捕获的异常数。
    public long ExceptionsCaught    { get; }

    // ── 堆派生（gc::HeapStats） ──

    /// 自堆创建以来累计的对象 alloc 次数（HeapStats.allocations SoT）。
    public long Allocations         { get; }

    /// generational minor（young-gen）回收次数。
    public long MinorCollections    { get; }

    /// major（whole-heap）回收次数。
    public long MajorCollections    { get; }

    /// 累计回收字节数。
    public long ReclaimedBytes      { get; }
}
