// zpkg 组装/写入单测（port-z42c-zpkg-build BP-5）。
// 全文件 byte-identical 对真 C# CLI 由 xtask e2e 承担（TSIG/IMPL follow-up 后升级为全等）。
namespace Z42cProjectZpkgTests;

using Std;
using Std.Test;
using Z42.Project;
using Z42.IR;
using Z42.IR.BinaryFormat;   // 此前漏写（using 不作用于子命名空间）—— 旧的裸 `--emit-zbc`
                             // 单文件编译不跑文件级 using 检查，本次按包编译后 E0436 逮到。

ZbcFileZ _mod(string ns, string fname) {
    string[] exports = new string[1];
    exports[0] = fname;
    string[] pool = new string[1];
    IrClassDesc[] classes = new IrClassDesc[0];
    IrFunction[] fns = new IrFunction[0];
    var irm = new IrModule(ns, pool, 1, classes, 0, fns, 0);
    return new ZbcFileZ("a.z42", "HASH", ns, exports, 1, irm);
}

// A u16 rendered little-endian as 4 lowercase hex chars — the shape ToHex()
// produces for one 2-byte header field.
string _hexU16le(int v) {
    string digits = "0123456789abcdef";
    int lo = v % 256;
    int hi = (v / 256) % 256;
    return digits.Substring(lo / 16, 1) + digits.Substring(lo % 16, 1)
         + digits.Substring(hi / 16, 1) + digits.Substring(hi % 16, 1);
}

[Test]
void test_sha256_hex_form() {
    // SHA256("abc") 标准向量（"sha256:" 前缀 + 小写——真 C# CLI 字节实测形态，port-z42c-tsig 校准）
    Assert.Equal("sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
                 ZpkgBuilder.Sha256Hex("abc"));
}

[Test]
void test_entry_autodetect_priority() {
    // FQ .Main 优先于裸 main
    var e1 = new ZpkgExportZ[2];
    e1[0] = new ZpkgExportZ("main", "func");
    e1[1] = new ZpkgExportZ("Demo.Main", "func");
    Assert.Equal("Demo.Main", ZpkgBuilder.AutoDetectEntry(e1, 2));
    // 仅裸 main
    var e2 = new ZpkgExportZ[1];
    e2[0] = new ZpkgExportZ("main", "func");
    Assert.Equal("main", ZpkgBuilder.AutoDetectEntry(e2, 1));
    // 同级歧义
    var e3 = new ZpkgExportZ[2];
    e3[0] = new ZpkgExportZ("A.Main", "func");
    e3[1] = new ZpkgExportZ("B.Main", "func");
    Assert.Equal("<ambiguous>", ZpkgBuilder.AutoDetectEntry(e3, 2));
    // 无候选
    Assert.Equal("", ZpkgBuilder.AutoDetectEntry(new ZpkgExportZ[0], 0));
}

[Test]
void test_build_packed_namespaces_and_exports() {
    var mods = new ZbcFileZ[2];
    mods[0] = _mod("Demo", "Demo.F");    // 已 FQ → 幂等不再加前缀
    mods[1] = _mod("Demo", "G");         // 短名 → 限定为 Demo.G
    ZpkgFileZ z = ZpkgBuilder.BuildPacked("p", "0.1.0", false, false, "", mods, 2);
    Assert.Equal(1, z.NsCount);                       // 同 ns 去重
    Assert.Equal("Demo", z.Namespaces[0]);
    Assert.Equal("Demo.F", z.Exports[0].Symbol);
    Assert.Equal("Demo.G", z.Exports[1].Symbol);
    Assert.Equal("", z.Entry);                        // lib 无 entry
}

[Test]
void test_write_packed_header() {
    var mods = new ZbcFileZ[1];
    mods[0] = _mod("Demo", "Demo.Main");
    ZpkgFileZ z = ZpkgBuilder.BuildPacked("p", "0.1.0", true, false, "", mods, 1);
    Assert.Equal("Demo.Main", z.Entry);               // exe 自动检测
    string hex = ZpkgWriterZ.WritePacked(z, false).ToHex();
    // Header layout: "ZPK\0" magic | major u16 LE | minor u16 LE | flags u16 LE
    // | secCount u32 LE. secCount 6 since drop-tsig-expt removed the EXPT section.
    //
    // The version fields are DERIVED from ZpkgWriterZ.Major/.Minor, never spelled
    // out: this assertion carried the literal minor 0x21 (33) while the format had
    // bumped to 43, and never went red because the whole unit was undiscovered
    // until 2026-09-06 (see _discoverTestUnits). Deriving them keeps the test
    // asserting the header *shape*, which is what it is for, and takes it off
    // version-bumping.md's manual-sync list.
    Assert.Equal("5a504b00", hex.Substring(0, 8));                     // magic
    Assert.Equal(_hexU16le(ZpkgWriterZ.Major), hex.Substring(8, 4));   // major
    Assert.Equal(_hexU16le(ZpkgWriterZ.Minor), hex.Substring(12, 4));  // minor
    Assert.Equal("0300", hex.Substring(16, 4));                        // flags Packed|Exe
    Assert.Equal("06000000", hex.Substring(20, 8));                    // secCount
}


// ── 版本失配不再静默（warn-on-zpkg-version-mismatch）──────────────────────────
// 改前这里是一条光秃秃的 `return null`：依赖包被整包跳过，而「跳过」不会失败——它在很远的地方
// 以满屏 `undefined: <Type>` 浮出来。本测试盯的是「**报过了**」这件事本身（stderr 文本抓不到，
// 就用去重计数器作证），以及去重真的生效：同一个旧版本只算一次、不同旧版本各算一次。
byte[] _skewHeader(int minor) {
    byte[] d = new byte[16];
    d[0] = (byte)90; d[1] = (byte)80; d[2] = (byte)75; d[3] = (byte)0;   // "ZPK\0"
    d[4] = (byte)0;  d[5] = (byte)0;                                      // major = 0
    d[6] = (byte)(minor % 256); d[7] = (byte)(minor / 256);               // minor (u16 LE)
    return d;
}

[Test]
void version_skew_is_reported_once_per_version() {
    int before = ZpkgReader.SkewWarningCount();
    int stale = ZpkgWriterZ.Minor + 1;

    Assert.Null(ZpkgReader.Open(_skewHeader(stale), "stale-a.zpkg"));
    Assert.Equal(before + 1, ZpkgReader.SkewWarningCount());

    // 同一个旧版本的第二个包：仍跳过，但**不再重复报**（一个过期 libs 目录有几十个同代包）。
    Assert.Null(ZpkgReader.Open(_skewHeader(stale), "stale-b.zpkg"));
    Assert.Equal(before + 1, ZpkgReader.SkewWarningCount());

    // 另一个旧版本：另算一条。
    Assert.Null(ZpkgReader.Open(_skewHeader(stale + 1), "stale-c.zpkg"));
    Assert.Equal(before + 2, ZpkgReader.SkewWarningCount());
}

[Test]
void matching_version_does_not_warn() {
    int before = ZpkgReader.SkewWarningCount();
    // 版本对得上但段数为 0 → 不是版本失配那条路径，不该产生告警。
    byte[] ok = _skewHeader(ZpkgWriterZ.Minor);
    ok[8] = (byte)1;    // flags: packed
    Assert.NotNull(ZpkgReader.Open(ok, "fresh.zpkg"));
    Assert.Equal(before, ZpkgReader.SkewWarningCount());
}

// ── DEPS 往返：写进去的依赖文件名，读得回来（add-deployment-model 批 2 support）──────────
//
// `ReadDependencies` 的生产调用方 = `_bundleExeDeps`（#849，按 DEPS 段建传递闭包）。
// （原注写「今天没有生产调用方」—— 那是 support 阶段的事实，消费落地后没跟着改。）
// 正因为没人用，写错了也不会有任何东西变红 —— 等到 use 那一轮才发现解码是歪的，届时要同时
// 怀疑「闭包逻辑」和「解码」两处。往返测试把解码**现在**就钉住。
//
// 顺带守住段布局本身：`u32 count` + 每项 `u32 fileIdx` / `u16 nsCount` / `u32[] nsIdx`。
//
// 🔴 **多命名空间的那项必须排在前面**。初稿把它放在最后 —— 把「按 nsCount 跳过」改成
// 「恒跳 1 个」注入进去，测试**照样绿**：最后一项跳错多少都无所谓，后面没有东西要读了。
// 多 ns 的项排在前面，跳错才会让**后一项的文件名读错位**，断言才抓得住。
// ⭐ 「故意构造了一个复杂输入」不等于那个复杂度真的被验到了。
[Test]
void test_deps_roundtrip_reads_file_names() {
    var mods = new ZbcFileZ[1];
    mods[0] = _mod("Demo", "Demo.Main");
    var deps = new ZpkgDepZ[2];
    string[] ns0 = new string[3]; ns0[0] = "Std.IO"; ns0[1] = "Std.Net"; ns0[2] = "Std.Text";
    deps[0] = new ZpkgDepZ("z42.io.zpkg", ns0, 3);     // 多 ns 在前 —— 跳错就会带歪下一项
    string[] ns1 = new string[1]; ns1[0] = "Std";
    deps[1] = new ZpkgDepZ("z42.core.zpkg", ns1, 1);
    ZpkgFileZ z = ZpkgBuilder.BuildPackedD("p", "0.1.0", false, false, "", mods, 1, deps, 2);

    ZpkgInfo info = ZpkgReader.Open(ZpkgWriterZ.WritePacked(z, false).ToBytes(), "p.zpkg");
    Assert.NotNull(info);
    string[] got = ZpkgReader.ReadDependencies(info);
    Assert.Equal(2, got.Length);
    Assert.Equal("z42.io.zpkg", got[0]);
    Assert.Equal("z42.core.zpkg", got[1]);   // 读错 nsCount 跳法 → 这里错位
}

[Test]
void test_deps_roundtrip_empty_when_no_deps() {
    // **对照**：没有依赖的包读出空数组，而不是崩或读出垃圾。
    var mods = new ZbcFileZ[1];
    mods[0] = _mod("Demo", "Demo.Main");
    ZpkgFileZ z = ZpkgBuilder.BuildPacked("p", "0.1.0", false, false, "", mods, 1);
    ZpkgInfo info = ZpkgReader.Open(ZpkgWriterZ.WritePacked(z, false).ToBytes(), "p.zpkg");
    Assert.NotNull(info);
    Assert.Equal(0, ZpkgReader.ReadDependencies(info).Length);
}
