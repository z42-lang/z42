// 可增长字节缓冲（port-z42c-zbc-writer ZW-1A-1）。镜像 C# BinaryWriter 的 LE 定宽写入。
// 缓冲是 `byte[]`（GC 堆里 packed 1 B/槽）。移植期曾用 `int[]`「规避 z42 byte 型不确定性」——
// 那早已不成立（`Utf8.GetBytes` 就返回 byte[]），代价是 4 倍内存 + 4 倍 memcpy 量，且 ToBytes
// 还要逐元素转换。ToHex 出小写 hex 供 golden 断言。
// LE 拆字节用位运算。ASCII 字符串字节直写（标识符皆 ASCII；非 ASCII UTF-8 延后 ZW-1E）。
namespace Z42.IR.BinaryFormat;

using Std;

public sealed class ByteWriter {
    private byte[] _buf;
    private int    _len;
    public ByteWriter() { this._buf = new byte[64]; this._len = 0; }

    public int Len() { return this._len; }

    // 容量守卫在**每次写入**上都要过一遍，而真正扩容只有 O(log n) 次 —— 所以守卫本身内联在
    // 各 Write* 里（`_len + k > _buf.Length` 一个比较），只有真要扩容才调 `_grow`。
    // 原来 `_ensure(k)` 是一次 z42 方法调用/字节，profile 上 self 2.96%，几乎全是这层转调。
    private void _grow(int need) {
        int cap = this._buf.Length;
        while (cap < need) { cap = cap * 2; }
        byte[] bigger = new byte[cap];
        Array.Copy(this._buf, bigger, this._len);   // bulk 原语；原来逐元素解释执行
        this._buf = bigger;
    }

    public void WriteU8(int v) {
        if (this._len + 1 > this._buf.Length) { this._grow(this._len + 1); }
        this._buf[this._len] = (byte)(v & 0xFF);
        this._len = this._len + 1;
    }

    // ensure-once + 直写（去 2 次 WriteU8 方法调用 + 2 次 _ensure）。字节序等价。
    public void WriteU16(int v) {
        if (this._len + 2 > this._buf.Length) { this._grow(this._len + 2); }
        int p = this._len;
        this._buf[p]     = (byte)(v & 0xFF);
        this._buf[p + 1] = (byte)((v >> 8) & 0xFF);
        this._len = p + 2;
    }

    public void WriteU32(int v) {
        if (this._len + 4 > this._buf.Length) { this._grow(this._len + 4); }
        int p = this._len;
        this._buf[p]     = (byte)(v & 0xFF);
        this._buf[p + 1] = (byte)((v >> 8) & 0xFF);
        this._buf[p + 2] = (byte)((v >> 16) & 0xFF);
        this._buf[p + 3] = (byte)((v >> 24) & 0xFF);
        this._len = p + 4;
    }

    public void WriteI64(long v) {
        if (this._len + 8 > this._buf.Length) { this._grow(this._len + 8); }
        int p = this._len;
        int i = 0;
        while (i < 8) {
            this._buf[p + i] = (byte)((v >> (i * 8)) & 0xFFL);
            i = i + 1;
        }
        this._len = p + 8;
    }

    // 无符号 LEB128 变长整数（STRS segment-dict：段长 / 段数 / 段索引，恒非负）。
    // 每字节低 7 位数据、最高位为「后续续」标志。负值防御性钳到 0（调用点均传非负）。
    public void WriteVarint(int v) {
        int u = v;
        if (u < 0) { u = 0; }
        int b = u & 0x7F;
        u = u >> 7;
        while (u != 0) {
            this.WriteU8(b | 0x80);
            b = u & 0x7F;
            u = u >> 7;
        }
        this.WriteU8(b);
    }

    // 串原始字节（无长度前缀；用于 STRS data / section tag）。**UTF-8 编码**——
    // z42 char = Unicode scalar（CharAt 遍历 Length 个 scalar），逐 scalar emit UTF-8 字节序列，
    // 字节数与 `ByteLength`（STRS 长度表/WriteStr 前缀）一致。ZW-1E 补：原 `WriteAsciiBytes` 按
    // `CharAt & 0xFF` 每 scalar 写 1 字节，遇多字节 UTF-8（如 banner 的 `—`=U+2014=3 字节）与
    // ByteLength 错位 → STRS 数据整体漂移、串损坏（z42c.driver banner 实证）。ASCII 子集等价不变。
    public void WriteUtf8Bytes(string s) {
        int n = s.Length;
        // ASCII 快路径：标识符/多数串全 ASCII → 一次 ensure(n) 覆盖纯 ASCII 情形 + 直写，去 per-char
        // WriteU8 调用。内联容量守卫 `_len >= _buf.Length`（纯 ASCII 恒不触发；混入多字节 scalar
        // 经 WriteU8 自行扩容后可能耗尽预留 → 守卫兜底），保正确。多字节分支仍走 WriteU8（自扩容）。
        if (this._len + n > this._buf.Length) { this._grow(this._len + n); }
        int i = 0;
        while (i < n) {
            int cp = (int)s.CharAt(i);
            if (cp < 128) {
                if (this._len >= this._buf.Length) { this._grow(this._len + 1); }
                this._buf[this._len] = (byte)cp;
                this._len = this._len + 1;
            } else if (cp < 2048) {
                this.WriteU8(192 | (cp >> 6));
                this.WriteU8(128 | (cp & 63));
            } else if (cp < 65536) {
                this.WriteU8(224 | (cp >> 12));
                this.WriteU8(128 | ((cp >> 6) & 63));
                this.WriteU8(128 | (cp & 63));
            } else {
                this.WriteU8(240 | (cp >> 18));
                this.WriteU8(128 | ((cp >> 12) & 63));
                this.WriteU8(128 | ((cp >> 6) & 63));
                this.WriteU8(128 | (cp & 63));
            }
            i = i + 1;
        }
    }

    // 内联串（NSPC）：u16 字节长 + UTF-8 字节。ASCII → ByteLength == Length。
    public void WriteStr(string s) {
        this.WriteU16(s.ByteLength);
        this.WriteUtf8Bytes(s);
    }

    // 回填 4 字节 LE（directory offset patch）。
    public void Patch32(int pos, int v) {
        this._buf[pos]     = (byte)(v & 0xFF);
        this._buf[pos + 1] = (byte)((v >> 8) & 0xFF);
        this._buf[pos + 2] = (byte)((v >> 16) & 0xFF);
        this._buf[pos + 3] = (byte)((v >> 24) & 0xFF);
    }

    // 追加另一缓冲全部字节。**批量**：一次 ensure + 紧凑内联拷贝 + 一次性 bump（原实现逐字节
    // WriteU8：每字节 2 次解释执行方法调用 WriteU8+_ensure，packed zpkg 多级嵌套 AppendWriter 使
    // 每字节重复复制 3-4 层 → 序列化占单包编译 ~51%）。other 字节已 & 0xFF，直拷等价。
    public void AppendWriter(ByteWriter other) {
        int m = other._len;
        if (this._len + m > this._buf.Length) { this._grow(this._len + m); }
        Array.Copy(other._buf, 0, this._buf, this._len, m);   // bulk 原语；packed zpkg 多级嵌套下每字节要复制 3-4 层
        this._len = this._len + m;
    }

    // byte[]（File.WriteAllBytes 写盘；driver --emit-zbc）。
    public byte[] ToBytes() {
        byte[] r = new byte[this._len];
        Array.Copy(this._buf, r, this._len);   // 同元素类型 ⇒ 原语直接 memcpy（原来逐元素转换）
        return r;
    }

    // 小写 hex（golden-hex 断言；规避 byte[] 比较）。
    public string ToHex() {
        string digits = "0123456789abcdef";
        string s = "";
        int i = 0;
        while (i < this._len) {
            int b = (int)this._buf[i];
            s = s + digits.Substring((b >> 4) & 0xF, 1) + digits.Substring(b & 0xF, 1);
            i = i + 1;
        }
        return s;
    }
}
