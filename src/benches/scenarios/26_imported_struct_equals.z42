// tier: gate
// Covers direct synthesized Equals on a closed generic struct imported from z42.core.
// Compare 500,000 pairs with alternating equality. Expected output: 250000.
namespace Bench.ImportedStructEquals;

using Std.IO;

void Main() {
    ValueTuple2<int, int> left = (1, 2);
    ValueTuple2<int, int> equal = (1, 2);
    ValueTuple2<int, int> different = (1, 3);
    int count = 0;
    for (int i = 0; i < 500000; i = i + 1) {
        ValueTuple2<int, int> right = equal;
        if ((i & 1) == 1) { right = different; }
        if (left.Equals(right)) { count = count + 1; }
    }
    Console.WriteLine(count);
}
