// z42b 命令处理层（build / publish / export；test / bench 见 builder_test.z42）。
//
// 每个 verb 是薄编排：解析参数 → ManifestLoader.Load → 构造 Target → _orchestrate
// （builder.z42）。动词语义见 platform-export-lifecycle.md：
//   build   平台无关 app.zpkg（Mode="" → tail 全 no-op）
//   publish 一路到 Package（Mode=Publish；--rid 选平台）
//   export  到 GenerateProject 停（Mode=Export；仅 ios/android）
//   test    host + 平台上跑 [Test]（取代 Rust test-runner）—— 待 retire-test-runner（反射前置）
//   bench   跑 [Benchmark]（Bencher）—— 同上
namespace Z42Builder;

using Std;
using Std.IO;
using Std.Cli;
using Std.Toml;
using Z42.Build;
using Z42.Build.Project;

// ── 工程清单定位 ───────────────────────────────────────────────────────────────

// 命令给出的工程清单：给了就用（须存在；给目录则看该目录）；没给就从当前目录向上找
// （ManifestLocator，与 z42 run / z42c build 同一规则）。失败打印原因并返回 ""。
string _locateManifest(string verb, string given) {
    if (given.Length > 0) {
        if (Directory.Exists(given)) {
            ManifestLocation inDir = ManifestLocator.FindIn(given);
            if (inDir.Kind == ManifestLocateKind.Project) { return inDir.ManifestPath; }
            ConsoleError.WriteLine(ManifestLocator.ErrorText(inDir, given));
            return "";
        }
        if (File.Exists(given)) { return given; }
        ConsoleError.WriteLine("z42 " + verb + ": manifest not found: " + given);
        return "";
    }
    string cwd = Environment.GetCurrentDirectory();
    ManifestLocation loc = ManifestLocator.FindUp(cwd);
    if (loc.Kind == ManifestLocateKind.Project) { return loc.ManifestPath; }
    if (loc.Kind == ManifestLocateKind.Workspace) {
        ConsoleError.WriteLine("z42 " + verb + ": `" + loc.ManifestPath + "` is a workspace; run it in a member directory");
        return "";
    }
    ConsoleError.WriteLine(ManifestLocator.ErrorText(loc, cwd));
    return "";
}

// ── build / publish / export：共用 _runVerb（仅 Mode 不同）──────────────────────

int _cmdBuild(ParseResult r)   { return _runVerb(r, ""); }
int _cmdPublish(ParseResult r) { return _runVerb(r, BuildMode.Publish); }
int _cmdExport(ParseResult r)  { return _runVerb(r, BuildMode.Export); }

// 构建产出：退出码 + dist zpkg 路径（Dist="" 表示无 dist——Export 模式、app.zpkg 缺失或
// dep-bundle 失败）。compile-then-test（builder_test._runModule）取 Dist 续跑 [Test]；
// _runVerb 取 Rc 返回。auto-property + 隐式默认 ctor（对齐本 codebase 的 TestUnit/DepBundle）。
class BuildOutcome {
    public int    Rc   { get; set; }
    public string Dist { get; set; }
}

// 编译一个工程 → BuildOutcome。build（mode=""）/ publish 产 dist/<name>.zpkg；export 只
// orchestrate 到 GenerateProject、不产 dist。诊断在此打印。_runVerb 与 compile-then-test
// 共用同一份 orchestrate + dist 组装（单一真相；无 target 按 _locateManifest 向上找）。
BuildOutcome _buildProject(ParseResult r, string mode) {
    BuildOutcome o = new BuildOutcome();
    o.Dist = "";
    string tomlPath = _locateManifest(mode.Length > 0 ? mode : "build", r.GetPositional(0));
    if (tomlPath.Length == 0) {
        o.Rc = 2;
        return o;
    }
    ProjectManifest m = ManifestLoader.Load(tomlPath);
    string sourceDir = Path.GetDirectoryName(tomlPath);
    if (sourceDir.Length == 0) { sourceDir = "."; }
    Target t = _makeTarget(r, mode);
    if (t.Rid.Length == 0) {
        ConsoleError.WriteLine("z42b: unsupported host (" + Platform.OS() + "/" + Platform.Arch() + "); pass --rid");
        o.Rc = 2;
        return o;
    }
    // `[build] hooks`（projDir 相对目录，"" = 无）——ManifestLoader 未建模该键，
    // 沿 builder_publish 的 TomlValue 直读先例（z42.project 面零改动）。
    TomlValue toml = TomlValue.Parse(File.ReadAllText(tomlPath));
    string hooksRel = _pubTomlStr(toml, "build", "hooks", "");
    int rc = _orchestrate(m, t, sourceDir, hooksRel);
    if (rc != 0) { o.Rc = rc; return o; }
    if (mode != BuildMode.Export) {
        Dirs dirs = _computeDirs(m, sourceDir, t.Profile);
        string builtZpkg = Path.Join(dirs.Intermediate, "app.zpkg");
        if (File.Exists(builtZpkg)) {
            Directory.Create(dirs.Dist);
            string distZpkg = Path.Join(dirs.Dist, m.Project.Name + ".zpkg");
            File.Copy(builtZpkg, distZpkg);
            // fix-call-arity-skew 抓出的调用点 bug：此处一直少传第 4 个实参 `noBuild`（无默认值），编译器却没报
            // （实参不足的诊断缺失，另行登记），运行期它静默为 Null ⇒ 当 false 用 ⇒「依赖缺失就现编」。
            // 显式传 false，行为与此前逐字一致；新的运行期签名判定正是因这一处少传而拒绝派发。
            rc = _pubBundleProjectDeps(tomlPath, toml, dirs.Dist, false);
            if (rc == 0) { o.Dist = distZpkg; }
        }
    }
    o.Rc = rc;
    return o;
}

int _runVerb(ParseResult r, string mode) {
    // export 需显式 --rid（无 host 默认形态）——前置校验，保持原 exit code 2。
    if (mode == BuildMode.Export) {
        string rid = r.GetOption("rid");
        if (rid.Length == 0) {
            ConsoleError.WriteLine("z42b export: --rid required (ios-arm64 / android-arm64 / browser-wasm)");
            return 2;
        }
    }
    return _buildProject(r, mode).Rc;
}

// 从 CLI 选项构造 Target。--rid 缺省 = host RID；profile 由 --release 决定。
Target _makeTarget(ParseResult r, string mode) {
    string rid = r.GetOption("rid");
    if (rid.Length == 0) { rid = _hostRid(); }
    string family = _familyOfRid(rid);
    string profile = r.GetFlag("release") ? "release" : "debug";
    return new Target(rid, family, profile, mode);
}
