namespace Z42Builder;

using Std.IO;
using Z42.Build;
using Z42.Package;

// The renamed main, its FILE payload and same-stem runtime configuration form
// one deployment. Keeping a receipt also retires a removed runtime sidecar.
void _pubStageApp(string zpkgSrc, string dstZpkg) {
    string sourceDir = Path.GetDirectoryName(zpkgSrc);
    string targetDir = Path.GetDirectoryName(dstZpkg);
    if (Path.Normalize(zpkgSrc) == Path.Normalize(dstZpkg)) { return; }
    DeploymentCopies copies = new DeploymentCopies(targetDir, Path.GetFileName(zpkgSrc), ".z42-publish-app-");
    byte[] bytes = File.ReadAllBytes(zpkgSrc);
    ZpkgInfo info = ZpkgReader.Open(bytes, zpkgSrc);
    if (info == null) { throw new Exception("cannot read publish app: " + zpkgSrc); }
    copies.Add(Path.GetFileName(dstZpkg), zpkgSrc, bytes);
    if (!info.Packed) {
        foreach (var rel in ZpkgReader.ReadIndexedZbcRels(info)) {
            string source = Path.Join(sourceDir, rel);
            copies.Add(rel, source, File.ReadAllBytes(source));
        }
    }
    string sidecar = _pubSidecarOf(zpkgSrc);
    if (File.Exists(sidecar)) {
        copies.Add(Path.GetFileName(_pubSidecarOf(dstZpkg)), sidecar, File.ReadAllBytes(sidecar));
    }
    copies.Apply();
}

// The apphost and launcher discover runtime configuration by the payload stem.
string _pubSidecarOf(string zpkg) {
    string dir = Path.GetDirectoryName(zpkg);
    string name = Path.GetFileNameWithoutExtension(zpkg) + ".runtimeconfig.toml";
    return dir.Length > 0 ? Path.Join(dir, name) : name;
}
