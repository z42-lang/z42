// `z42 new <name> [--lib] [--path <dir>]` —— 创建工程骨架。
// 生成 z42.toml + 源文件模板 + .gitignore + README.md。模板两种：exe（默认）/ lib。
// 测试不单设模板：任何工程的 `tests/*.z42` 都会被 `z42 test` 自动发现。
namespace Z42Builder;

using Std;
using Std.IO;
using Std.Cli;

int _cmdNew(ParseResult r) {
    string name = r.GetPositional(0);
    if (name.Length == 0) {
        ConsoleError.WriteLine("z42 new: missing project name (usage: z42 new <name>)");
        return 2;
    }
    if (!_isValidProjectName(name)) {
        ConsoleError.WriteLine("z42 new: invalid project name `" + name + "`");
        ConsoleError.WriteLine("  use lowercase letters, digits, `-`, `_` or `.`, starting with a letter or digit (e.g. `my-app`)");
        return 2;
    }
    string kind = r.GetFlag("lib") ? "lib" : "exe";

    string parent = r.GetOption("path");
    string dir = parent.Length > 0 ? Path.Join(parent, name) : name;
    if (File.Exists(dir) || (Directory.Exists(dir) && Directory.Enumerate(dir).Length > 0)) {
        ConsoleError.WriteLine("z42 new: `" + dir + "` already exists and is not empty");
        return 1;
    }

    Directory.Create(dir);
    File.WriteAllText(Path.Join(dir, "z42.toml"), _tomlTemplate(name, kind));
    File.WriteAllText(Path.Join(dir, ".gitignore"), _gitignoreTemplate());
    File.WriteAllText(Path.Join(dir, "README.md"), _readmeTemplate(name, kind));
    string srcDir = Path.Join(dir, "src");
    Directory.Create(srcDir);
    if (kind == "exe") { File.WriteAllText(Path.Join(srcDir, "Main.z42"), _exeSource(name)); }
    else               { File.WriteAllText(Path.Join(srcDir, "Lib.z42"), _libSource(name)); }

    Console.WriteLine("Created " + _kindNoun(kind) + " project `" + name + "` in " + dir + "/");
    Console.WriteLine("");
    Console.WriteLine("  cd " + dir);
    Console.WriteLine("  " + _nextCommand(kind));
    return 0;
}

// [a-z0-9][a-z0-9._-]*
bool _isValidProjectName(string name) {
    int i = 0;
    while (i < name.Length) {
        char c = name.CharAt(i);
        bool ok = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
        if (i > 0 && (c == '-' || c == '_' || c == '.')) { ok = true; }
        if (!ok) { return false; }
        i = i + 1;
    }
    return name.Length > 0;
}

string _kindNoun(string kind) { return kind == "lib" ? "library" : "executable"; }

string _nextCommand(string kind) { return kind == "lib" ? "z42 build" : "z42 run"; }

// ── 模板 ─────────────────────────────────────────────────────────────────────

string _tomlTemplate(string name, string kind) {
    string s = "";
    s = s + "[project]\n";
    s = s + "name = \"" + name + "\"\n";
    s = s + "version = \"0.1.0\"\n";
    s = s + "kind = \"" + kind + "\"\n";
    s = s + "\n";
    s = s + "[sources]\n";
    s = s + "include = [\"src/**/*.z42\"]\n";
    return s;
}

string _exeSource(string name) {
    // 入口是自由函数 `void Main()`（按此自动探测；C# 式 `static void Main` 放在类里不会被识别）。
    string s = "";
    s = s + "namespace " + _nsOf(name) + ";\n";
    s = s + "\n";
    s = s + "using Std.IO;\n";
    s = s + "\n";
    s = s + "void Main() {\n";
    s = s + "    Console.WriteLine(\"Hello, World!\");\n";
    s = s + "}\n";
    return s;
}

string _libSource(string name) {
    string s = "";
    s = s + "namespace " + _nsOf(name) + ";\n";
    s = s + "\n";
    s = s + "public static class Greeter {\n";
    s = s + "    public static string Hello(string who) {\n";
    s = s + "        return \"Hello, \" + who + \"!\";\n";
    s = s + "    }\n";
    s = s + "}\n";
    return s;
}

string _gitignoreTemplate() {
    return "/artifacts/\n/dist/\n";
}

string _readmeTemplate(string name, string kind) {
    string s = "";
    s = s + "# " + name + "\n";
    s = s + "\n";
    s = s + "```sh\n";
    if (kind == "exe") { s = s + "z42 run      # build and run\n"; }
    s = s + "z42 build    # build only\n";
    s = s + "z42 test     # run the tests in tests/\n";
    s = s + "z42 clean    # remove build output\n";
    s = s + "```\n";
    return s;
}

// ── 辅助 ─────────────────────────────────────────────────────────────────────

// 工程名 → PascalCase 命名空间（"my-app" → "MyApp"）。
string _nsOf(string name) {
    string r = "";
    bool up = true;
    int i = 0;
    while (i < name.Length) {
        string c = name.Substring(i, 1);
        if (c == "-" || c == "_" || c == ".") { up = true; }
        else {
            r = r + (up ? c.ToUpper() : c);
            up = false;
        }
        i = i + 1;
    }
    // 命名空间不能以数字开头（"2048" → "App2048"）。
    if (r.Length == 0 || (r.CharAt(0) >= '0' && r.CharAt(0) <= '9')) { return "App" + r; }
    return r;
}
