// z42b device driver — iOS run (z42b-device-run Slice 3, PR-2).
//
//   --run    xcodebuild test -scheme Z42VM on a simulator — ONE boot runs BOTH
//            Z42VMTests (R1–R7) and Z42EmbeddedTests (the embedded corpus)
//            (design D3). Sim UDID via `xcrun simctl` (Z42_IOS_DEST overrides);
//            the "Test Case … passed/failed" lines → junit.xml. Double-read:
//            the XCTest cases self-assert; z42b relays the verdict + junit.
//
// The prebuilt Z42VM.xcframework and the Resources/embedded corpus are already in the
// host project (orchestrator + --stage-only); z42b builds no native code.
//
// z42b writes its own junit (Z42Xtask's shared _writeJUnitReport is unreachable
// from here) — same XML shape; the directory comes from --report-dir (the orchestrator
// decides where reports live), so CI's report consumer is unchanged.
namespace Z42Builder;

using Std.IO;
using Std.Cli;

// Run a prepared Process inheriting the parent's stdio (live streaming; return
// exit code). Mirrors xtask's `_exec`. Used for builds whose stdout must not be captured
// (a captured pipe can deadlock configure scripts); the `xcodebuild test` RUN itself
// keeps capturing — it needs the stdout to parse junit.
int _execInherit(Process p) {
    return p.Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit()).Run().ExitCode;
}

// `xcodebuild test -scheme Z42VM -destination <sim>` at the platform crate — ONE
// simulator boot runs Z42VMTests (R1–R7) + Z42EmbeddedTests (embedded corpus).
// Z42_IOS_DEST overrides the destination; default = first available iPhone sim.
int _runIosXcodebuild(string reportDir, string here) {
    string dest = Environment.GetEnvironmentVariable("Z42_IOS_DEST", "");
    if (dest.Length == 0) {
        string udid = _firstSimulatorUdid();
        if (udid.Length == 0) {
            ConsoleError.WriteLine("z42b: no iOS Simulator available (xcrun simctl list devices available)"); return 1;
        }
        dest = "id=" + udid;
    }
    Console.WriteLine("z42b: xcodebuild test -scheme Z42VM -destination '" + dest + "' (iOS Simulator R1–R7 + embedded)");
    ProcessResult res = new Process("xcodebuild").Arg("test")
        .Arg("-scheme").Arg("Z42VM")
        .Arg("-destination").Arg(dest)
        .WorkingDirectory(here).Run();
    _writeIosJUnit(reportDir, res.Stdout);
    if (res.ExitCode != 0) {
        // Surface the failing test-case lines (xcodebuild is verbose).
        foreach (var line in _iosLines(res.Stdout)) {
            if (line.IndexOf("' failed") >= 0 || line.IndexOf(" error:") >= 0) { ConsoleError.WriteLine(line.Trim()); }
        }
    }
    return res.ExitCode;
}

// First available iPhone simulator UDID (first parenthesised group on the line).
string _firstSimulatorUdid() {
    ProcessResult r = new Process("xcrun").Arg("simctl").Arg("list").Arg("devices").Arg("available").Run();
    foreach (var line in _iosLines(r.Stdout)) {
        string t = line.Trim();
        if (!t.StartsWith("iPhone")) { continue; }
        int lp = t.IndexOf("(");
        if (lp < 0) { continue; }
        int rp = t.IndexOf(")");
        if (rp <= lp) { continue; }
        return t.Substring(lp + 1, rp - lp - 1);
    }
    return "";
}

// Parse xcodebuild `Test Case '-[<Suite> testX]' passed/failed` lines →
// junit.xml (<--report-dir>/junit.xml). Same XML shape as Z42Xtask's shared
// _writeJUnitReport; z42b re-implements it inline (that helper is unreachable here).
void _writeIosJUnit(string reportDir, string stdout) {
    int tests = 0;
    int failures = 0;
    string body = "";
    foreach (var line in _iosLines(stdout)) {
        string t = line.Trim();
        if (t.IndexOf("Test Case '") < 0) { continue; }
        bool passed = t.IndexOf("' passed") >= 0;
        bool failed = t.IndexOf("' failed") >= 0;
        if (!passed && !failed) { continue; }
        tests = tests + 1;
        string name = _xcCaseName(t);
        if (passed) {
            body = body + "  <testcase name=\"" + name + "\" classname=\"ios.Z42VMTests\"/>\n";
        } else {
            failures = failures + 1;
            body = body + "  <testcase name=\"" + name + "\" classname=\"ios.Z42VMTests\">\n"
                 + "    <failure message=\"" + _xmlEscape("failed") + "\"/>\n  </testcase>\n";
        }
    }
    string xml = "<testsuites tests=\"" + tests + "\" failures=\"" + failures + "\">\n"
               + "<testsuite name=\"ios.Z42VMTests\" tests=\"" + tests + "\" failures=\"" + failures + "\">\n"
               + body + "</testsuite>\n</testsuites>\n";
    if (reportDir.Length == 0) {
        Console.WriteLine("z42b: no --report-dir given — junit.xml not written (" + tests + " cases, " + failures + " failed)");
        return;
    }
    Directory.Create(reportDir);
    File.WriteAllText(Path.Join(reportDir, "junit.xml"), xml);
    Console.WriteLine("z42b: junit.xml (" + tests + " cases, " + failures + " failed)");
}

// Extract the test method name from `... '-[Z42VMTests testFoo]' ...`.
string _xcCaseName(string line) {
    int b = line.IndexOf("-[");
    int e = line.IndexOf("]");
    if (b < 0 || e <= b) { return "case"; }
    string inner = line.Substring(b + 2, e - b - 2);   // "Z42VMTests testFoo"
    int sp = inner.IndexOf(" ");
    if (sp >= 0) { return inner.Substring(sp + 1); }
    return inner;
}

// stdout → lines, CRLF-normalised (mirrors Z42Xtask _stdoutLines).
string[] _iosLines(string s) {
    return s.Replace("\r\n", "\n").Split("\n");
}

string _xmlEscape(string s) {
    string o = s;
    o = o.Replace("&", "&amp;");
    o = o.Replace("<", "&lt;");
    o = o.Replace(">", "&gt;");
    o = o.Replace("\"", "&quot;");
    return o;
}
