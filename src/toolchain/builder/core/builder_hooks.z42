// z42b — 项目 build hook 动态注入（wire-z42b：build-hook 终章）。
//
// manifest `[build] hooks = "<dir>"`（projDir 相对）→ 用注入的同一 ICompiler 把该目录
// 编成 <name>.hooks.zpkg → ModuleLoader.Load → Type.GetType("Build.ProjectHooks")
// → Activator → as BuildHooks。约定：hook 源声明 `namespace Build;` + `class
// ProjectHooks : BuildHooks`，override 需要的钩子（BeforeAssets 等）。
//
// 复用 dynamic-component-registration 的组件注入模式（_hostCompiler 同款三段：
// Load → GetType → as-cast）——零代码生成、零子进程。旧「生成一次性 driver 源码」
// 设计（_runWithProjectBuild 骨架）被本机制取代：hook 类直接注入进 z42b 自己的
// Pipeline，无需为项目生成/编译/运行一个专属 driver。
//
// 编译面：合成一份 lib 清单（名 = <proj>.hooks、include = `**/*.z42`）随请求传入，直接编 hooks 目录
// （drop-legacy-compile-request：此前旧的平铺字段编译面固定 kind=exe，hook 目录没有 Main 会被判
// "no Main() found"，只好拷到 staging 目录再附一个合成的 no-op `Main()`——lib 清单下这些都不需要了）。
namespace Z42Builder;

using Std.IO;
using Std.Reflection;
using Std.Test;
using Z42.Build;
using Z42.Project;   // ManifestLoader：hooks 的合成清单

// 编译并实例化项目 hooks。失败（目录缺失 / 编译错 / 类型不符 / 加载异常）→ 打诊断、返回 null（L1「空值 +
// 调用方检查」idiom）。调用方一律把 null 判为**构建失败**（fail-build-on-hooks-error）：清单既然声明了 hooks，
// 就不许静默降级成「无 hook」——此前那样构建照样退 0，publish 产物会悄悄缺少 hook 该产出的东西。
//   hooksDir  hook 源目录（已解析为可用路径）
//   interDir  hook 产物落点（<pkgName>.zpkg 写这里）
//   pkgName   hook 包名（约定 <proj>.hooks）
BuildHooks _loadProjectHooks(string hooksDir, string interDir, string pkgName) {
    if (!Directory.Exists(hooksDir)) {
        ConsoleError.WriteLine("z42b: [build] hooks dir not found: " + hooksDir);
        return null;
    }
    ICompiler comp = _hostCompiler();

    // deps：Z42_LIBS（stdlib）+ **本进程加载编译器的那个目录**里的 zpkg（add-sdk-libs：analyzer / hooks 自动
    // 看见 SDK 库）。hook 要继承 `Z42.Build.BuildHooks`，而 `z42.build` 不在 shipped libs/、在编译器目录 ——
    // 此前只给 Z42_LIBS，**装好的 SDK 里 hooks 一律编不过**（`E0494: 命名空间 Z42.Build 不存在`）；开发树里能用
    // 只因 Z42_LIBS 碰巧是混装了编译器包的 alllibs（`build toolchain` 期间不是，同样落空）。
    // 用 `_findCompilerZpkg()` 的目录而不是另找一处：hook 编译看到的 `z42.build` 就是本进程已加载、
    // 运行期 `as BuildHooks` 要对上的那一份（类型同一性）。编译器目录排在 libs 之后：它里面的 stdlib 副本
    // 按 basename 先到先得被 libs 的那份压住，只有编译器域的包真正从这里解析。
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS", "");
    string[] libDeps = (libs.Length > 0) ? Path.Glob(libs, "*.zpkg") : new string[0];
    string compilerZpkg = _findCompilerZpkg();
    string[] sdkDeps = compilerZpkg.Length > 0 ? Path.Glob(Path.GetDirectoryName(compilerZpkg), "*.zpkg") : new string[0];
    string[] deps = new string[libDeps.Length + sdkDeps.Length];
    int di = 0;
    while (di < libDeps.Length) { deps[di] = libDeps[di]; di = di + 1; }
    int si = 0;
    while (si < sdkDeps.Length) { deps[libDeps.Length + si] = sdkDeps[si]; si = si + 1; }

    string outZpkg = Path.Join(interDir, pkgName + ".zpkg");
    CompileRequest req = new CompileRequest(hooksDir, outZpkg, deps, "release", false, false, "lib", new string[0], 0);
    req.PackageName = pkgName;
    req.Manifest = ManifestLoader.ParseText("[project]\nname = \"" + pkgName + "\"\nversion = \"0.0.0\"\nkind = \"lib\"\n\n"
        + "[sources]\ninclude = [\"**/*.z42\"]\n");
    CompileResult res = comp.Compile(req);
    if (!res.Ok) {
        ConsoleError.WriteLine("z42b: hooks compile failed (" + hooksDir + "):");
        ConsoleError.WriteLine(res.Diagnostics);
        return null;
    }

    try {
        ModuleLoader.Load(res.Zpkg);
        Type t = Type.GetType("Build.ProjectHooks");
        if (t == null) {
            ConsoleError.WriteLine("z42b: hooks loaded but Build.ProjectHooks not found — hook source must declare `namespace Build;` + `class ProjectHooks : BuildHooks`");
            return null;
        }
        object o = Activator.CreateInstance(t);
        BuildHooks h = o as BuildHooks;
        if (h == null) {
            ConsoleError.WriteLine("z42b: Build.ProjectHooks does not extend Z42.Build.BuildHooks");
            return null;
        }
        return h;
    } catch (Exception e) {
        ConsoleError.WriteLine("z42b: hooks load failed (" + e.Message + ")");
        return null;
    }
}
