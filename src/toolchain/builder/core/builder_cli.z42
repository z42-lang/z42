// z42b CLI 路由 —— Std.Cli 嵌套 router（对照 launcher_cli.z42）。
//
// 用户经 `z42 <verb>` 到达 new / test / bench / clean / publish（launcher 转发），故这些命令的
// 帮助名写 `z42 <verb>`；build / export 只供编排方（xtask）直接调用，保留 `z42b` 名。
// 编译器经 _hostCompiler 运行时动态注入（见 builder.z42）；test/bench 处理见 builder_test.z42。
namespace Z42Builder;

using Std;
using Std.IO;
using Std.Cli;
using Z42.Build.Project;   // ManifestLoader / BuildLayout（clean）

// exe 入口。standalone（`z42vm z42.builder.zbc -- <verb> ...`）与 launcher 透传
// （`z42 <verb> ...`）都经 Environment.GetCommandLineArgs() 拿到动词起的 argv。
void Main() {
    Environment.Exit(_runBuilder(Environment.GetCommandLineArgs()));
}

// 入口：launcher 透传的 argv（已去掉 `z42` 前缀的动词起）。
int _runBuilder(string[] argv) {
    if (argv.Length == 0) { Console.WriteLine(_builderRoot().HelpText()); return 0; }

    SubcommandRouter root = _builderRoot();
    CommandResolution res;
    try { res = root.Resolve(argv); }
    catch (CliException e) {
        ConsoleError.WriteLine("z42b: " + e.Message);
        return 2;
    }
    if (res.IsHelp())    { Console.WriteLine(res.HelpText()); return 0; }
    if (res.IsUnknown()) { ConsoleError.WriteLine(res.ErrorMessage()); return 2; }
    return _dispatchBuilder(res);
}

SubcommandRouter _builderRoot() {
    SubcommandRouter root = new SubcommandRouter("z42b", "z42 build orchestrator");

    // new / build / publish / export（编译器动态注入）。
    ArgParser newP = new ArgParser("z42 new", "create a new project");
    newP.AddOptionalPositional("name", "project name (lowercase letters, digits, `-`, `_`, `.`)");
    newP.AddFlag("lib", "", "library project (default: executable)");
    newP.AddOption("path", "", "directory to create the project in (default: current dir)", "");
    root.Add("new", "create a new project", newP);

    ArgParser build = new ArgParser("z42b build", "compile to a platform-agnostic app.zpkg");
    build.AddOptionalPositional("project", "<manifest> (default: the nearest z42.toml)");
    build.AddOption("rid", "", "target RID (default: host)", "");
    build.AddFlag("release", "", "release profile (default: debug)");
    root.Add("build", "compile to a platform-agnostic app.zpkg", build);

    ArgParser pub = new ArgParser("z42b publish", "produce a release deployable (desktop apphost)");
    pub.AddOptionalPositional("project", "<project.z42.toml>");
    pub.AddOption("rid", "", "target RID (desktop; run via `z42 publish` to default to host)", "");
    pub.AddOption("output", "", "output dir (overrides [platform.desktop].publish_dir)", "");
    pub.AddFlag("self-contained", "", "embed the z42 runtime (self-contained app; no external z42vm); "
        + "static/dynamic link via [platform.desktop] link");
    pub.AddFlag("no-build", "", "deploy the already-built zpkg as-is (default: run z42c first, "
        + "which rebuilds only what changed)");
    root.Add("publish", "produce a release deployable", pub);

    ArgParser exp = new ArgParser("z42b export", "generate a native IDE project (ios/android)");
    exp.AddOptionalPositional("project", "<project.z42.toml>");
    exp.AddOption("rid", "", "target RID (ios-arm64 / android-arm64 / browser-wasm)", "");
    exp.AddFlag("release", "", "release profile (default: debug)");
    root.Add("export", "generate a native IDE project", exp);

    // test / bench — 反射式运行器（functional；取代 Rust z42-test-runner）。
    // target 双形态：已编译产物直跑 / 工程 toml（或默认 z42.toml）→ compile-then-test
    // （add-z42b-compile-then-test）；--release 供后者选 build profile（默认 debug）。
    ArgParser test = new ArgParser("z42 test", "build the project and run its [Test] units");
    test.AddOptionalPositional("target", "<manifest|file.zpkg|file.zbc|bundle.json> (default: the nearest z42.toml)");
    test.AddOption("filter", "", "test name substring filter (reserved)", "");
    test.AddOption("format", "", "output format: pretty|json", "pretty");
    test.AddOption("name", "", "only build+run the [[test]] target with this name (default: all)", "");
    test.AddOption("filter", "", "only targets whose name contains this substring", "");
    test.AddOption("rid", "", "target RID: host (default, in-process) | device (assemble deployable)", "");
    test.AddOption("out", "", "device RID: output dir for the assembled {app,libs,bundle} deployable", "");
    // Device RID sub-steps (z42b-device-run Slice 3). Default (no flag) on a device
    // RID = build+deploy+run full pipeline; the flags select individual steps for
    // CI / debug. --stage-only preserves the ②b behaviour (assemble deployable only).
    test.AddFlag("build", "", "device RID: run the native platform build (wasm-pack / xcframework / cargo-ndk)");
    test.AddFlag("run", "", "device RID: deploy + run on the device/emulator, collect the report");
    test.AddFlag("stage-only", "", "device RID: only assemble the {app,libs,bundle} deployable (no build/run)");
    // --build-root: repo root, so the per-platform driver can locate the native
    // platform crate (src/toolchain/workload/<plat>/…) for --build/--run. The fleet
    // orchestrator (xtask) knows the repo layout and passes it; z42b owns the build
    // invocation logic. Required for --build/--run on a device RID.
    test.AddOption("build-root", "", "device RID --build/--run: repo root for locating the native platform crate", "");
    test.AddOption("node-bin", "", "device RID --run: hermetic node bin dir (provisioned by xtask) to prepend to PATH", "");
    test.AddFlag("release", "", "compile-then-test: release profile (default: debug)");
    // --list：只列目标名（一行一个），不编不跑。给**编排方**用 —— xtask 靠它拿到单元清单后
    // 并行拉起 `z42b test <toml> --name <unit>`，从此不必自带一套发现规则（两套规则各自漂移
    // 正是 #580 查出的那三处分歧的来源）。
    test.AddFlag("list", "", "只列出 test 目标名（一行一个），不编译不运行");
    // --reuse-parent：父包 dist 已在就不重建。编排方（xtask）每个库先不带它跑一个目标把父包建好，
    // 其余目标并行时带上 —— 进程内编译器无增量，不带的话 N 个目标就把父包全量重编 N 遍。
    test.AddFlag("reuse-parent", "", "父包 dist 已存在则直接复用、不重建（编排方已先建好父包时用）");
    root.Add("test", "run [Test] in a compiled module, project, or test-bundle", test);

    ArgParser bench = new ArgParser("z42 bench", "build the project and run its [Benchmark] units");
    bench.AddOptionalPositional("target", "<manifest|file.zpkg|file.zbc> (default: the nearest z42.toml)");
    bench.AddOption("filter", "", "benchmark name substring filter (reserved)", "");
    bench.AddOption("format", "", "output format: pretty|json (json adds bench_stats)", "pretty");
    bench.AddOption("name", "", "only build+run the [[bench]] target with this name (default: all)", "");
    bench.AddOption("filter", "", "only targets whose name contains this substring", "");
    bench.AddOption("rid", "", "compile-then-test: target RID (default: host)", "");
    bench.AddFlag("release", "", "compile-then-test: release profile (default: debug)");
    bench.AddFlag("list", "", "只列出 bench 目标名（一行一个），不编译不运行");
    bench.AddFlag("reuse-parent", "", "父包 dist 已存在则直接复用、不重建（编排方已先建好父包时用）");
    root.Add("bench", "run [Benchmark] in a compiled module or project", bench);

    // clean — remove a project's build artifacts (moved out of z42c: the compiler
    // only compiles; artifact lifecycle belongs to the orchestrator z42b).
    ArgParser clean = new ArgParser("z42 clean", "remove the project's build output (dist, cache, artifacts)");
    clean.AddOptionalPositional("project", "<manifest|dir> (default: the nearest z42.toml)");
    root.Add("clean", "remove build output", clean);

    return root;
}

// `z42 clean [<manifest|dir>]` —— 删除工程的构建产物（debug + release 两个 profile）。
// 删什么由 BuildLayout 决定（与 z42c 写产物同一规则）：dist 目录、cache 目录、generated 目录；
// output_dir 未显式配置时它是工程独占的 `<工程>/artifacts/`，整个删除。显式配置的 output_dir
// 可能与别的工程共享（如仓库级 artifacts/），只删解析出的子目录，不删 output_dir 本身。
int _cmdClean(ParseResult r) {
    string toml = _locateManifest("clean", r.GetPositional(0));
    if (toml.Length == 0) { return 2; }
    ProjectManifest pm = ManifestLoader.Load(toml);
    string projDir = Path.GetDirectoryName(toml);
    if (projDir.Length == 0) { projDir = "."; }
    string[] dirs = new string[8];
    int n = 0;
    bool[] profiles = new bool[2];
    profiles[0] = false; profiles[1] = true;
    int pi = 0;
    while (pi < 2) {
        BuildLayout l = BuildLayout.Resolve(pm, projDir, profiles[pi]);
        n = _cleanAdd(dirs, n, l.DistDir);
        if (l.OutputDirConfigured) {
            n = _cleanAdd(dirs, n, l.CacheDir);
            n = _cleanAdd(dirs, n, l.GeneratedDir);
        } else {
            n = _cleanAdd(dirs, n, Path.Join(l.ProjectDir, "artifacts"));
        }
        pi = pi + 1;
    }
    int removed = 0;
    int i = 0;
    while (i < n) {
        if (Directory.Exists(dirs[i])) {
            Directory.Delete(dirs[i], true);
            Console.WriteLine("removed " + dirs[i]);
            removed = removed + 1;
        }
        i = i + 1;
    }
    if (removed == 0) { Console.WriteLine("nothing to clean"); }
    return 0;
}

// 去重追加（"" 跳过）。
int _cleanAdd(string[] dirs, int n, string d) {
    if (d.Length == 0) { return n; }
    int i = 0;
    while (i < n) { if (dirs[i] == d) { return n; } i = i + 1; }
    dirs[n] = d;
    return n + 1;
}

// ── dispatch ──────────────────────────────────────────────────────────────

int _dispatchBuilder(CommandResolution res) {
    string[] p = res.Path();
    if (p.Length == 0) { return 0; }
    ParseResult r = res.Result();
    string top = p[0];
    if (top == "test")  { return _cmdTest(r); }
    if (top == "bench") { return _cmdBench(r); }
    if (top == "clean") { return _cmdClean(r); }
    if (top == "publish") { return _cmdPublishZ42b(r); }   // move-publish-to-z42b
    // wire-z42b 2b：build/new/export 编排（编译器经 _hostCompiler 运行时动态注入）。
    if (top == "build")  { return _cmdBuild(r); }
    if (top == "new")    { return _cmdNew(r); }
    if (top == "export") { return _cmdExport(r); }
    ConsoleError.WriteLine("z42b " + top + ": unknown verb");
    return 2;
}
