// z42b — 构建编排器（build orchestrator）。wire-z42b 2b 已接入编译。
//
// 职责：读 z42.toml/--rid → 构造 z42.build 管线（注入 编译器 + workload + hooks）→ 跑。
//   build   → tail no-op（产平台无关 app.zpkg）
//   export  → 跑到 GenerateProject 停（原生 IDE 工程，ios/android）
//   publish → 一路到 Package（可分发件 apphost/.ipa/.aab/wasm）
//
// 关键设计（与 z42c 共享编译实现，见 z42.build/src/ICompiler.z42）：
//   Compile 头相位经 z42.build 的 `ICompiler` 接口**在进程内**调编译器库——和独立 z42c
//   CLI 调的是同一份实现，**不 fork z42c 子进程**。实现由 _hostCompiler **运行时动态注入**
//   （加载 programs/z42c/z42c.pipeline.zpkg 反射实例化 Z42cCompiler——z42b 编译期零 z42c 依赖，
//   见 dynamic-component-registration design）。_selectWorkload 暂返 WorkloadBase（平台 workload 后续）。
// 命令层在 builder_commands.z42 / builder_new.z42；CLI 路由在 builder_cli.z42。
namespace Z42Builder;

using Std;
using Std.IO;
using Std.Runtime;   // ModuleSearch（VM 已解析的 zpkg 搜索序）
using Std.Test;
using Std.Reflection;
using Z42.Build;
using Z42.Build.Project;

// 编排入口：命令层解析出 manifest + target + sourceDir（+ manifest `[build] hooks`
// 相对目录，"" = 无）后调本函数。全在进程内组合 —— 零子进程、零代码生成。
//
// hooks（wire-z42b build-hook 终章）：声明了 hooks 目录 → _loadProjectHooks
// （builder_hooks.z42：编译 + 动态注入 ProjectHooks）→ 挂到 p.Hooks。旧「探测 build/
// 目录 → 生成一次性 driver 源码」设计被动态注入取代（也修掉了隐式探测会把 xtask 的
// scripts/build/ 源码目录误判为 hook 目录的坑——hooks 只认 manifest 显式声明）。
int _orchestrate(ProjectManifest manifest, Target target, string sourceDir, string hooksRel) {
    return _orchestrate(manifest, target, sourceDir, hooksRel, "");
}

// parentPkg（z42b-owns-test-targets）：非空 → 本次是该包的测试/bench 目标，透传给编译器
// ⇒ 加载父包时按同包待遇（其 internal 可见）。
// free-function-overloads 阶段 2（use）：以下三个 `_orchestrate` 是同名重载（arity 4/5/6，逐层
// 加参数、默认透传）——阶段 1 的 support 已随 nightly 发布，此处兑现真正 use（此前因语言不支持
// 自由函数重载而被迫分名 _orchestrateFor/_orchestrateWith）。
int _orchestrate(ProjectManifest manifest, Target target, string sourceDir, string hooksRel,
                 string parentPkg) {
    return _orchestrate(manifest, target, sourceDir, hooksRel, parentPkg, "");
}

// extraDepDir（z42b-owns-test-targets）：除 Z42_LIBS 外再供一个 zpkg 目录 —— 测试目标要依赖
// **刚建好的父包**，而父包的 dist 不在 Z42_LIBS 里。
int _orchestrate(ProjectManifest manifest, Target target, string sourceDir, string hooksRel,
                 string parentPkg, string extraDepDir) {
    string[] one = new string[1];
    one[0] = extraDepDir;
    return _orchestrate(manifest, target, sourceDir, hooksRel, parentPkg, one, 1);
}

// extraDepDirs（path 依赖闭包，2026-09-26）：闭包成员的 dist 目录列表，叶子在前。
int _orchestrate(ProjectManifest manifest, Target target, string sourceDir, string hooksRel,
                 string parentPkg, string[] extraDepDirs, int extraN) {
    Pipeline p = new Pipeline();
    p.ParentPkg = parentPkg;
    p.Compiler = _hostCompiler();                  // 共享 z42c 编译实现（ICompiler），in-process
    p.Workload = _selectWorkload(target.Family);   // 标准平台 workload 库

    Dirs dirs = _computeDirs(manifest, sourceDir, target.Profile);
    if (hooksRel.Length > 0) {
        BuildHooks h = _loadProjectHooks(
            Path.Join(sourceDir, hooksRel),
            Path.Join(dirs.Intermediate, "hooks"),
            manifest.Project.Name + ".hooks");
        if (h != null) { p.Hooks = h; }
        // null → 诊断已打印；hooks 编不过不阻塞主构建（保守降级为无 hook）
    }

    PipelineContext ctx = new PipelineContext();
    ctx.Project     = manifest.Project;
    ctx.Manifest    = manifest;
    ctx.Target      = target;
    ctx.Dirs        = dirs;
    ctx.Inputs      = _initialInputs(manifest, extraDepDirs, extraN);
    ctx.WorkloadDir = "";                          // 实现期：选中 workload 的安装目录
    return p.Run(ctx);
}

// ── 注入点 ───────────────────────────────────────────────────────────────────

// 共享编译实现入口（wire-z42b 2b，dynamic-component-registration）：**运行时动态注入**——
// z42b 编译期只依赖 z42.build 的 ICompiler 接口（零 z42c 编译期依赖，独立 exe +
// stdlib-only 可构建不破）；此处经 ModuleLoader.Load 把编译器组件 zpkg（z42c.pipeline，
// 含 Z42cCompiler : ICompiler）加载进 live VM → 反射实例化 → 接口 cast 注入。
// 与 z42c.driver CLI 共享同一编译实现（PackageCompile 核心），不 fork z42c 子进程。
// 换/升级编译器 = 替换 zpkg，本文件零改动。组件缺失（runtime-only SDK）→ NoCompiler 兜底。
ICompiler _hostCompiler() {
    string zpkg = _findCompilerZpkg();
    if (zpkg.Length == 0) {
        ConsoleError.WriteLine("z42b: compiler component not found (Z42_HOME/programs/z42c, SDK via Z42_PORTABLE_VM, or dev artifacts) — build verbs unavailable");
        return new NoCompiler();
    }
    try {
        ModuleLoader.Load(zpkg);
        Type t = Type.GetType("Z42.Pipeline.Z42cCompiler");
        if (t == null) {
            ConsoleError.WriteLine("z42b: Z42cCompiler type not resolvable after loading " + zpkg);
            return new NoCompiler();
        }
        object o = Activator.CreateInstance(t);
        ICompiler c = o as ICompiler;
        if (c == null) {
            ConsoleError.WriteLine("z42b: loaded Z42cCompiler does not satisfy ICompiler (component/interface version mismatch?)");
            return new NoCompiler();
        }
        return c;
    } catch (Exception e) {
        ConsoleError.WriteLine("z42b: compiler component load failed (" + e.Message + "); falling back to NoCompiler");
        return new NoCompiler();
    }
}

// 定位编译器组件 zpkg（z42c.pipeline.zpkg；其 6 个 z42c.* 兄弟须与之同目录——ModuleLoader
// 依赖闭包按 entry-dir + Z42_LIBS 解析）。探测序：
//   ① Z42_HOME/programs/z42c/（SDK 安装态；launcher 转发时已设）
//   ② Z42_PORTABLE_VM 反推 SDK 根（<sdk>/bin/z42vm → <sdk>/programs/z42c/）
//   ③ 开发树 artifacts/build/compiler/z42c.driver/release/dist/（exe 自包含 bundle，7 兄弟共存）
string _findCompilerZpkg() {
    // ① **VM 已解析的 zpkg 搜索序**（add-deployment-model 批 5 use，#832）。
    //    `ModuleSearch.Dirs()` 给的是结果——相对项已按 entry zpkg 解析、`probing-paths` 的通配符
    //    已展开、不存在的已剔除。位置由清单的 `[profile.<n>.runtime] probing-paths` 声明，
    //    **代码里不再出现 `programs/z42c/` 这个路径**：位置变了只改清单。
    string[] msDirs = ModuleSearch.Dirs();
    int msI = 0;
    while (msI < msDirs.Length) {
        string pm = Path.Join(msDirs[msI], "z42c.pipeline.zpkg");
        if (File.Exists(pm)) { return pm; }
        msI = msI + 1;
    }
    // ② **开发树兜底**：编译器 member 的 exe 自包含 bundle（7 兄弟共存）。
    //
    // 🔴 为什么这一档还留着硬编码：`probing-paths` 是**平台分隔符**分隔的（unix `:` /
    // windows `;`），跨平台清单里写多条必然在某个平台上错 —— 初稿配了两条，
    // `package-host(windows-x64)` 当场红在 `no compiler injected`。而单条覆盖不了两种布局：
    // 开发树里 z42b 的 entry-dir 是 `artifacts/build/toolchain/builder/`，SDK 里是
    // `programs/z42b/`，相对路径结构完全不同。
    //
    // 取舍：**SDK 布局（会变、要可配）走清单的 probing-paths；开发树路径（仓库内约定、不会变）
    // 留这一档硬编码**。等 `probing-paths` 支持 TOML 数组（跨平台无歧义，需清单模型改动 ⇒ 又一轮
    // support）之后，这一档也搬进清单，届时代码里就一条路径都没有了。
    //
    // ⚠️ 只靠 `ModuleSearch.Dirs()` 末项的 `libs` 兜底**不够**：开发树里两个场景的 Z42_LIBS
    // 不同——`test targets` 指 alllibs（含编译器包，命中），而 `build toolchain` 期间 z42b 编
    // z42i 的 hooks 时不含（落空）。后者在 macOS 只降级为无 hook，在 Windows 的 package-host
    // 里是硬失败：**同一个洞，两个平台不同后果**。
    string p3 = "artifacts/build/compiler/z42c.driver/release/dist/z42c.pipeline.zpkg";
    if (File.Exists(p3)) { return p3; }
    // 找不到 = **这个部署形态不带编译能力**，不是"路径没配对"。
    //
    // 2026-09-26（批 5 use）：此处原有四档硬编码探测（Z42_HOME/programs/z42c → Z42_PORTABLE_VM
    // 反推 SDK 根 → 开发树 artifacts 路径 → Z42_LIBS），且 `ReplCompilerHost` 里还有**第二份**
    // 几乎相同的实现（注释自陈「探测序同 builder.z42」）。位置改成由清单的 `probing-paths`
    // 声明后全部删除——**代码里不再出现 `programs/z42c/`**。
    // 实证：把那三档全部断掉、只留上面这一档，`xtask test targets` 的 compile-then-test 照常通过。
    return "";
}

// 按平台族选标准 workload（实现期接各 *.workload 库的 : WorkloadBase 子类）。
WorkloadBase _selectWorkload(string family) {
    // 实现期：ios→iOSWorkload / android→AndroidWorkload / desktop→DesktopWorkload / wasm→WasmWorkload
    return new WorkloadBase();    // no-op 兜底
}

// ── 目录布局 / 输入 ───────────────────────────────────────────────────────────

// 目录布局（镜像 docs/reference/src/toolchain/z42-toml.md 默认：output_dir = artifacts/<name>/<profile>）。
// Source 只读；写仅落 Cache / Intermediate / Dist。[build] 段显式值优先。
Dirs _computeDirs(ProjectManifest m, string sourceDir, string profile) {
    // cache-dir-layout：[build] 里的相对路径按 toml 所在目录（sourceDir）解析、并展开 ${output_dir} / ${profile}
    //（与 z42.project `BuildLayout` 与 z42b publish `_pubResolveZpkg` 同口径）。此前原样使用 ⇒ 相对进程 cwd，
    // 且 `dist_dir = "${output_dir}"` 这类模板会被当成字面目录名。
    string outBase;
    if (m.Build.HasOutputDir) { outBase = _dirsResolve(m.Build.OutputDir, sourceDir, "", profile); }
    else {
        string artifacts = Path.Join(sourceDir, "artifacts");
        outBase = Path.Join(Path.Join(artifacts, m.Project.Name), profile);
    }
    string cache = m.Build.HasCacheDir ? _dirsResolve(m.Build.CacheDir, sourceDir, outBase, profile) : Path.Join(outBase, ".cache");
    string inter = Path.Join(outBase, "build");
    string dist  = m.Build.HasDistDir  ? _dirsResolve(m.Build.DistDir, sourceDir, outBase, profile) : Path.Join(outBase, "dist");
    return new Dirs(sourceDir, cache, inter, dist);
}

// `[build]` 目录配置 → 可用路径：展开模板；仍相对则相对 sourceDir。
string _dirsResolve(string raw, string sourceDir, string outBase, string profile) {
    string v = raw.Replace("${profile}", profile);
    if (outBase.Length > 0) { v = v.Replace("${output_dir}", outBase); }
    if (Path.IsRooted(v) || (outBase.Length > 0 && v.StartsWith(outBase))) { return v; }
    return Path.Join(sourceDir, v);
}

// compile 相位前的初始输入（wire-z42b 2b）：Deps = Z42_LIBS 下 manifest 声明依赖的 zpkg
// 路径（MVP 单源 Z42_LIBS；workspace 兄弟 dist 多源解析归 wire-z42b-future-deps-resolve）。
// Z42cCompiler 由这些路径的父目录集推导 LibsDirs（design D3）。
Inputs _initialInputs(ProjectManifest m) { return _initialInputs(m, ""); }

// free-function-overloads 阶段 2（use）：同名重载（2 参版，附加 extraDepDir）——此前因不支持
// 自由函数重载而分名 _initialInputsWith。
// path 依赖闭包（2026-09-26）：闭包有 N 个成员，每个成员的 dist 都要进依赖扫描面 ⇒ 需要
// **多个**额外目录，而 1 参版只收一个（那是「父包 dist」一个用例留下的形状）。
Inputs _initialInputs(ProjectManifest m, string[] extraDepDirs, int extraN) {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS", "");
    string[] baseDeps = (libs.Length > 0) ? Path.Glob(libs, "*.zpkg") : new string[0];
    string[] acc = baseDeps;
    int k = 0;
    while (k < extraN) {
        string d = extraDepDirs[k];
        k = k + 1;
        if (d.Length == 0) { continue; }
        string[] extra = Path.Glob(d, "*.zpkg");
        string[] all = new string[acc.Length + extra.Length];
        int i = 0; while (i < acc.Length) { all[i] = acc[i]; i = i + 1; }
        int j = 0; while (j < extra.Length) { all[acc.Length + j] = extra[j]; j = j + 1; }
        acc = all;
    }
    if (acc.Length == 0) { return new Inputs("", "", new string[0]); }
    return new Inputs("", "", acc);
}

Inputs _initialInputs(ProjectManifest m, string extraDepDir) {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS", "");
    if (libs.Length == 0 && extraDepDir.Length == 0) { return new Inputs("", "", new string[0]); }
    // 镜像 z42c CLI 的 Z42_LIBS 语义：整目录全部 zpkg 供扫（stdlib 恒可用——prelude/Std.IO
    // 无需在 app 的 toml 里显式声明；非 stdlib 依赖仍受 DepIndex 白名单约束，见 Z42cCompiler）。
    string[] baseDeps = (libs.Length > 0) ? Path.Glob(libs, "*.zpkg") : new string[0];
    if (extraDepDir.Length == 0) { return new Inputs("", "", baseDeps); }
    // 追加 extraDepDir 下的 zpkg（父包 dist）。
    string[] extra = Path.Glob(extraDepDir, "*.zpkg");
    string[] all = new string[baseDeps.Length + extra.Length];
    int i = 0; while (i < baseDeps.Length) { all[i] = baseDeps[i]; i = i + 1; }
    int j = 0; while (j < extra.Length) { all[baseDeps.Length + j] = extra[j]; j = j + 1; }
    return new Inputs("", "", all);
}

// ── RID / family 辅助（镜像 launcher 的 _hostRid / _ridCategory）──────────────

// host RID（os-arch）。不支持的平台返 ""。
string _hostRid() {
    string os = Platform.OS();
    string arch = Platform.Arch();
    string a = "";
    if (arch == "aarch64") { a = "arm64"; }
    else if (arch == "x86_64") { a = "x64"; }
    else { return ""; }
    if (os == "macos" || os == "linux" || os == "windows") { return os + "-" + a; }
    return "";
}

// RID 前缀 → 平台族（TargetFamily.*）；未知返 ""。
string _familyOfRid(string rid) {
    if (rid.StartsWith("macos-") || rid.StartsWith("linux-") || rid.StartsWith("windows-")) {
        return TargetFamily.Desktop;
    }
    if (rid.StartsWith("ios-") || rid.StartsWith("iossim-")) { return TargetFamily.iOS; }
    if (rid.StartsWith("android-")) { return TargetFamily.Android; }
    if (rid == "browser-wasm") { return TargetFamily.Wasm; }
    return "";
}
