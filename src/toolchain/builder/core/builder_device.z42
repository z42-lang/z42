// z42b device driver — device-RID deploy + run (z42b-device-run Slice 3).
//
// z42b is the single-target EXECUTOR. On a device RID (browser-wasm / ios / android)
// it assembles the {app,libs,bundle} deployable and runs it on the device, collecting
// the report. It does NOT build native code: the platform runtime is a PREBUILT runtime pack
// (the same `z42-runtime-<ver>-<rid>` layout `z42 workload install` lays under
// `<SDK>/runtimes/<rid>/<ver>/`) that z42b beds into the host project — z42b never invokes
// cargo / wasm-pack / cargo-ndk and knows no repo layout. The pack comes from env Z42_RUNTIME_DIR
// (any directory: an SDK install, a CI package dir, a local build), defaulting to the runtime
// pack installed in the SDK. Everything else is handed in explicitly too (--out, --project,
// --report-dir, --node-bin, Z42_LIBS, …).
//
// z42b can't BE the in-browser/in-sim runner (it runs on a z42vm on the host), so
// "run" = spawn the platform-native driver (playwright / xcodebuild / gradlew) on
// the host, inject the staged deployable, and read the report back. The native
// tooling (node / browsers / Xcode / NDK) is PROVISIONED by the orchestrator.
//
// Sub-steps (flags; default on a device RID = stage+run):
//   --stage-only   assemble the deployable dir and bed the runtime pack into the host project
//   --run          run on the device (deployable + native runtime were already placed)
namespace Z42Builder;

using Std.IO;
using Std.Cli;

// Entry from _runModule when target=.json and rid is a device RID. Reads the
// build/run/stage-only flags and drives the matching per-platform steps.
int _runDevice(ParseResult r, string manifestPath, string rid) {
    bool wantStage = r.GetFlag("stage-only");
    bool wantRun   = r.GetFlag("run");
    // Default (no sub-step flag) = stage + run.
    if (!wantStage && !wantRun) { wantStage = true; wantRun = true; }

    string outDir = r.GetOption("out");
    // --project: 宿主外壳（Playwright 页面 / SwiftPM 包 / Gradle 工程）所在目录，--run 在这里启动平台驱动。
    string project = r.GetOption("project");
    string libs    = Environment.GetEnvironmentVariable("Z42_LIBS", "");

    if (!_isDeviceRid(rid)) {
        ConsoleError.WriteLine("z42b test: unknown --rid '" + rid
            + "' (host | browser-wasm | ios-arm64 | iossim-arm64 | android-arm64 | android-x64)");
        return 2;
    }
    if (!File.Exists(manifestPath)) {
        ConsoleError.WriteLine("z42b test: bundle manifest not found: " + manifestPath); return 2;
    }
    if (wantRun && project.Length == 0) {
        ConsoleError.WriteLine("z42b test --rid " + rid + " --run: --project <host project dir> required"); return 2;
    }

    // stage: platform-agnostic (shared Slice 2 assembler), then bed the prebuilt runtime pack.
    if (wantStage) {
        int sc = _stageFor(r, manifestPath, rid, outDir, libs);
        if (sc != 0) { return sc; }
        string rt = _resolveRuntimeDir(rid);
        if (rt.Length == 0) {
            ConsoleError.WriteLine("z42b test --rid " + rid + ": no runtime pack — set Z42_RUNTIME_DIR=<dir> or install one "
                + "under the SDK (<SDK>/runtimes/" + rid + "/<ver>/, via `z42 workload install`)");
            return 2;
        }
        int bc = _bedRuntime(rid, rt, project, outDir);
        if (bc != 0) { return bc; }
    }
    if (!wantRun) { return 0; }

    // run: spawn the platform-native driver.
    if (rid == "browser-wasm") { return _runWasmPlaywright(r, project, outDir); }
    if (rid == "ios-arm64" || rid == "iossim-arm64") { return _runIosXcodebuild(r.GetOption("report-dir"), project); }
    if (rid == "android-arm64" || rid == "android-x64") { return _runAndroidGradle(project); }
    ConsoleError.WriteLine("z42b test --rid " + rid + ": device run not wired for this rid");
    return 2;
}

// Spawn `npx playwright test --config playwright.embedded.config.ts` in the wasm
// tests dir. node bin (hermetic, from xtask) via --node-bin prepended to PATH;
// browser cache via Z42_PW_BROWSERS. Exit code = the device run verdict.
// `outDir`（`--out`）非空 ⇒ 经 Z42_WASM_DEPLOY 告诉 playwright 配置 deployable 在哪（此前配置里写死了
// `artifacts/build/wasm-test`，布局一挪就断——tidy-test-output-dirs）。
int _runWasmPlaywright(ParseResult r, string host, string outDir) {
    string testsDir = Path.Join(host, "tests");
    string nodeBin  = r.GetOption("node-bin");
    string browsers = Environment.GetEnvironmentVariable("Z42_PW_BROWSERS", "");
    string npx = (nodeBin.Length > 0) ? Path.Join(nodeBin, "npx") : "npx";

    Console.WriteLine("z42b: npx playwright test --config playwright.embedded.config.ts");
    Process pw = new Process(npx).Arg("playwright").Arg("test")
        .Arg("--config").Arg("playwright.embedded.config.ts").Arg("--reporter=list")
        .WorkingDirectory(testsDir);
    if (nodeBin.Length > 0) {
        string oldPath = Environment.GetEnvironmentVariable("PATH", "");
        pw = pw.Env("PATH", nodeBin + ":" + oldPath);
    }
    if (browsers.Length > 0) { pw = pw.Env("PLAYWRIGHT_BROWSERS_PATH", browsers); }
    if (outDir.Length > 0) { pw = pw.Env("Z42_WASM_DEPLOY", outDir); }
    ProcessResult res = pw.Run();
    if (res.Stdout.Length > 0) { Console.Write(res.Stdout); }
    if (res.Stderr.Length > 0) { ConsoleError.WriteLine(res.Stderr); }
    return res.ExitCode;
}

// The runtime pack for `rid`: env Z42_RUNTIME_DIR if set, else the highest version installed under
// <SDK home>/runtimes/<rid>/. "" when neither exists.
string _resolveRuntimeDir(string rid) {
    string env = Environment.GetEnvironmentVariable("Z42_RUNTIME_DIR", "");
    if (env.Length > 0) { return env; }
    string home = _sdkHome();
    if (home.Length == 0) { return ""; }
    string byRid = Path.Join(Path.Join(home, "runtimes"), rid);
    if (!Directory.Exists(byRid)) { return ""; }
    string[] vers = Directory.Enumerate(byRid);
    Array.Sort(vers);
    for (int i = vers.Length - 1; i >= 0; i = i - 1) {
        string d = Path.Join(byRid, vers[i]);
        if (Directory.Exists(d)) { return d; }
    }
    return "";
}

// Bed the prebuilt runtime pack into where the platform driver expects it. Layout contract = the
// runtime pack's own (`z42 workload install` beds the same files into the workload project):
//   browser-wasm : <rt>/pkg-web/{z42_wasm.js,z42_wasm_bg.wasm}   → <out>/   (browser-fetched, not via VFS)
//   ios          : <rt>/native/Z42VM.xcframework                 → <project>/Z42VM.xcframework
//   android      : <rt>/native/*.so                              → <project>/z42vm/src/main/jniLibs/<abi>/
int _bedRuntime(string rid, string rt, string project, string outDir) {
    if (rid == "browser-wasm") {
        string pkg = Path.Join(rt, "pkg-web");
        foreach (var f in new string[] { "z42_wasm.js", "z42_wasm_bg.wasm" }) {
            string src = Path.Join(pkg, f);
            if (!File.Exists(src)) { ConsoleError.WriteLine("z42b: runtime pack missing " + src); return 1; }
            File.Copy(src, Path.Join(outDir, f));
        }
        Console.WriteLine("z42b: wasm runtime ← " + pkg);
        return 0;
    }
    if (project.Length == 0) {
        ConsoleError.WriteLine("z42b test --rid " + rid + ": --project <host project dir> required to bed the runtime pack"); return 2;
    }
    if (rid == "ios-arm64" || rid == "iossim-arm64") {
        string xcf = Path.Join(Path.Join(rt, "native"), "Z42VM.xcframework");
        if (!Directory.Exists(xcf)) { ConsoleError.WriteLine("z42b: runtime pack missing " + xcf); return 1; }
        string dst = Path.Join(project, "Z42VM.xcframework");
        if (Directory.Exists(dst)) { Directory.Delete(dst, true); }
        _copyDirTree(xcf, dst);
        Console.WriteLine("z42b: ios runtime ← " + xcf);
        return 0;
    }
    string abi = _androidRidAbi(rid);
    if (abi.Length == 0) { ConsoleError.WriteLine("z42b: no runtime bedding for rid " + rid); return 2; }
    string nat = Path.Join(rt, "native");
    string so = Path.Join(nat, "libz42_platform_android.so");
    if (!File.Exists(so)) { ConsoleError.WriteLine("z42b: runtime pack missing " + so); return 1; }
    string jni = Path.Join(Path.Join(project, "z42vm/src/main/jniLibs"), abi);
    Directory.Create(jni);
    foreach (var f in Directory.Enumerate(nat)) {
        if (f.EndsWith(".so")) { File.Copy(Path.Join(nat, f), Path.Join(jni, f)); }
    }
    Console.WriteLine("z42b: android runtime ← " + nat + " → jniLibs/" + abi + "/");
    return 0;
}

// android RID → gradle ABI directory name. "" for anything else.
string _androidRidAbi(string rid) {
    if (rid == "android-arm64") { return "arm64-v8a"; }
    if (rid == "android-x64")   { return "x86_64"; }
    return "";
}

// Recursive directory copy (stdlib has no Directory.Copy). Every entry is copied, so enumeration
// order doesn't matter.
void _copyDirTree(string src, string dst) {
    Directory.Create(dst);
    foreach (var name in Directory.Enumerate(src)) {
        string s = Path.Join(src, name);
        string d = Path.Join(dst, name);
        if (Directory.Exists(s)) { _copyDirTree(s, d); } else { File.Copy(s, d); }
    }
}

// stage-only path for any device rid (delegates to the shared Slice 2 assembler).
int _stageFor(ParseResult r, string manifestPath, string rid, string outDir, string libs) {
    if (outDir.Length == 0) {
        ConsoleError.WriteLine("z42b test --rid " + rid + ": --out <dir> required"); return 2;
    }
    string agent = _ensureAgent();
    if (agent.Length == 0) { return 1; }
    if (libs.Length == 0 || !Directory.Exists(libs)) {
        ConsoleError.WriteLine("z42b test --rid " + rid + ": Z42_LIBS (flat stdlib dir) required"); return 2;
    }
    return _stageDeployable(Path.GetDirectoryName(manifestPath), agent, libs, outDir, (rid == "browser-wasm"));
}

// ── test-agent resolution: dogfood `z42 workload install test` (design D4) ────
//
// The on-device test agent (z42.testagent.zpkg) is no longer an in-tree --agent
// handed over by xtask; it is the PUBLISHED `test` workload payload (Change C).
// z42b resolves it from the installed workload, dogfooding the install mechanism:
//   1. home = Z42_HOME | reverse(Z42_PORTABLE_VM) (<sdk>/bin/z42vm → <sdk>).
//   2. scan <home>/runtimes/<ver>/workloads/test/z42.testagent.zpkg (any version).
//   3. absent → spawn `<home>/z42 workload install test [--from Z42_WORKLOAD_SRC]`
//      (offline archive dir in CI; omit --from for a network install), then re-scan.
// Returns the agent zpkg path, or "" (error already reported) on failure.
string _ensureAgent() {
    string home = _sdkHome();
    if (home.Length == 0) {
        ConsoleError.WriteLine("z42b test: cannot locate SDK home (set Z42_HOME or Z42_PORTABLE_VM) to resolve the test workload agent");
        return "";
    }
    string agent = _findInstalledAgent(home);
    if (agent.Length > 0) { return agent; }

    // Not installed → dogfood `z42 workload install test`.
    string launcher = Path.Join(home, "z42");
    if (!File.Exists(launcher)) {
        ConsoleError.WriteLine("z42b test: launcher not found at " + launcher + "; install the test workload first (z42 workload install test)");
        return "";
    }
    string src = Environment.GetEnvironmentVariable("Z42_WORKLOAD_SRC", "");
    Console.WriteLine("z42b: test workload not installed → z42 workload install test"
        + (src.Length > 0 ? (" --from " + src) : " (network)"));
    Process p = new Process(launcher).Arg("workload").Arg("install").Arg("test");
    if (src.Length > 0) { p = p.Arg("--from").Arg(src); }
    ProcessResult res = p.Run();
    if (res.Stdout.Length > 0) { Console.Write(res.Stdout); }
    if (res.Stderr.Length > 0) { ConsoleError.WriteLine(res.Stderr); }
    if (res.ExitCode != 0) { ConsoleError.WriteLine("z42b: z42 workload install test failed"); return ""; }

    agent = _findInstalledAgent(home);
    if (agent.Length == 0) {
        ConsoleError.WriteLine("z42b: test workload installed but z42.testagent.zpkg not found under "
            + home + "/runtimes/*/workloads/test/");
    }
    return agent;
}

// SDK home: Z42_HOME wins; else reverse-derive from Z42_PORTABLE_VM
// (<sdk>/bin/z42vm → <sdk>). "" if neither is set.
string _sdkHome() {
    string h = Environment.GetEnvironmentVariable("Z42_HOME", "");
    if (h.Length > 0) { return h; }
    string pv = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM", "");
    if (pv.Length > 0) {
        string bin = Path.GetDirectoryName(pv);
        if (bin.Length > 0) {
            string sdk = Path.GetDirectoryName(bin);
            if (sdk.Length > 0) { return sdk; }
        }
    }
    return "";
}

// Scan <home>/runtimes/<ver>/workloads/test/z42.testagent.zpkg for any installed
// version. Versions sorted (common-pitfalls §1: deterministic first-match, no
// reliance on FS enumeration order). "" if none installed.
string _findInstalledAgent(string home) {
    string runtimes = Path.Join(home, "runtimes");
    if (!Directory.Exists(runtimes)) { return ""; }
    string[] vers = Directory.Enumerate(runtimes);
    // 数组没有实例方法 Sort()；`vers.Sort()` 会被编成对数组接收者的虚调用，运行期即
    // `VCall: expected object, got Array`（装了 test workload、runtimes/ 存在时才走到这里）。
    Array.Sort(vers);
    for (int i = 0; i < vers.Length; i = i + 1) {
        string cand = Path.Join(Path.Join(Path.Join(Path.Join(runtimes, vers[i]),
            "workloads"), "test"), "z42.testagent.zpkg");
        if (File.Exists(cand)) { return cand; }
    }
    return "";
}
