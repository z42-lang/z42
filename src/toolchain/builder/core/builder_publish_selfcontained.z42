// Self-contained desktop publishing: host executable and complete runtime closure.
namespace Z42Builder;
using Std.IO;
using Std.Cli;
using Std.Toml;
using Z42.Build;

int _pubDesktopSelfContained(ParseResult r, TomlValue toml, string tomlPath, string projName, string rid) {
    bool isWin = rid.StartsWith("windows-");
    string link = _pubPlatform(toml, "desktop", "link", "static");
    if (link != "static" && link != "dynamic") {
        ConsoleError.WriteLine("z42b publish: [platform.desktop] link must be static|dynamic (got '" + link + "')");
        return 2;
    }
    string host     = Environment.GetEnvironmentVariable("Z42_EMBED_APPHOST", "");
    string libsSrc  = Environment.GetEnvironmentVariable("Z42_EMBED_LIBS", "");
    string dylibSrc = Environment.GetEnvironmentVariable("Z42_EMBED_DYLIB", "");
    // Auto-provision from the project's [build] hooks when env is unset — the
    // hook builds + registers the embed apphost (per link) + stdlib libs
    // (+ dynamic libz42), mirroring the spawn path's apphost-stub. So
    // `z42 publish --self-contained` works out-of-box in this repo (dev) and via
    // the desktop workload (user), no manual env.
    if (host.Length == 0 || libsSrc.Length == 0 || (link == "dynamic" && dylibSrc.Length == 0)) {
        Output[] hookOuts = _pubRunHooks(toml, tomlPath, projName, rid);
        if (hookOuts == null) { return 1; }   // 声明了 hooks 却失败：诊断已打印（fail-build-on-hooks-error）
        if (host.Length == 0)    { host    = _pubFindOutput(hookOuts, "embed-apphost-" + link); }
        if (libsSrc.Length == 0) { libsSrc = _pubFindOutput(hookOuts, "embed-libs"); }
        if (link == "dynamic" && dylibSrc.Length == 0) { dylibSrc = _pubFindOutput(hookOuts, "embed-dylib"); }
    }
    if (host.Length == 0 || !File.Exists(host)) {
        ConsoleError.WriteLine("z42b publish --self-contained: embed apphost not available (ships with the desktop workload).");
        ConsoleError.WriteLine("       run: z42 workload install desktop   (dev: set Z42_EMBED_APPHOST)");
        return 1;
    }
    if (libsSrc.Length == 0 || !Directory.Exists(libsSrc)) {
        ConsoleError.WriteLine("z42b publish --self-contained: stdlib libs dir not available (dev: set Z42_EMBED_LIBS).");
        return 1;
    }
    if (link == "dynamic" && (dylibSrc.Length == 0 || !File.Exists(dylibSrc))) {
        ConsoleError.WriteLine("z42b publish --self-contained --link=dynamic: libz42 shared lib not available (dev: set Z42_EMBED_DYLIB).");
        return 1;
    }

    // build app.zpkg（依赖 zpkg 由 z42c 一并 colocate 进 dist，同上）
    string zpkgSrc = _pubEnsureBuilt(tomlPath, toml, projName, r.GetFlag("no-build"));
    if (zpkgSrc.Length == 0) { return 1; }
    string distDir = Path.GetDirectoryName(zpkgSrc);

    // output app dir (same resolution as the spawn path's `root`)
    string publishDir = r.GetOption("output");
    if (publishDir.Length == 0) { publishDir = _pubPlatform(toml, "desktop", "publish_dir", ""); }
    string projDir = Path.GetDirectoryName(tomlPath);
    string appDir;
    if (publishDir.Length == 0) { appDir = _pubDefaultPublishDir(tomlPath, toml, projName); }
    else { appDir = (projDir.Length > 0) ? Path.Join(projDir, publishDir) : publishDir; }
    DeploymentCopies appPlan = _pubPlanApp(zpkgSrc, Path.Join(appDir, "app.zpkg"));
    string libsOut = Path.Join(appDir, "libs");
    DeploymentCopies depsPlan = _pubPlanDistDeps(distDir, projName, libsOut, "");
    _pubValidatePayload(appPlan, depsPlan);
    Directory.Create(appDir);

    // exe = prebuilt embed apphost; app.zpkg + libs/ beside it
    string exe = Path.Join(appDir, isWin ? (projName + ".exe") : projName);
    File.Copy(host, exe);
    if (!isWin) { new Process("chmod").Arg("+x").Arg(exe).Run(); }   // File.Copy drops the mode bit
    if (appPlan != null) { appPlan.Apply(); }
    Directory.Create(libsOut);
    foreach (var p in Path.Glob(libsSrc, "*.zpkg")) {               // stdlib
        File.Copy(p, Path.Join(libsOut, Path.GetFileName(p)));
    }
    if (depsPlan != null) { depsPlan.Apply(); }
    if (link == "dynamic") {
        _pubCopyRuntimeClosure(dylibSrc, appDir, rid);
    }
    Console.WriteLine("z42 publish (" + rid + ", self-contained/" + link + ") → " + appDir);
    Console.WriteLine("✅ self-contained app ready: " + exe);
    return 0;
}


void _pubCopyRuntimeClosure(string runtime, string appDir, string rid) {
    string source = Path.GetDirectoryName(runtime);
    string prefix = rid.StartsWith("windows-") ? "" : "lib";
    string suffix = rid.StartsWith("windows-") ? ".dll" : (rid.StartsWith("macos-") ? ".dylib" : ".so");
    foreach (var stem in new string[]{ "z42", "z42_interp", "z42_jit", "z42_compression" }) {
        string name = prefix + stem + suffix;
        string file = Path.Join(source, name);
        if (!File.Exists(file)) { throw new Exception("runtime dependency missing: " + file); }
        File.Copy(file, Path.Join(appDir, name));
    }
    string[] std = Path.Glob(source, prefix + "std-*" + suffix);
    if (std.Length != 1) { throw new Exception("runtime requires one matching shared Rust std: " + source); }
    File.Copy(std[0], Path.Join(appDir, Path.GetFileName(std[0])));
}
