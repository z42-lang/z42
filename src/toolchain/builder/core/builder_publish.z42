// z42b publish — desktop apphost publish (moved from launcher_export.z42 by
// move-publish-to-z42b). z42b owns the deploy verb; the launcher only forwards
// `z42 publish` here (mirroring test/bench), pre-resolving the desktop workload
// apphost stub and passing it via `Z42_APPHOST_TEMPLATE` (Decision 3.5) so this
// module needs NO installed-runtime/workload resolution.
//
// Layout: `[platform.desktop]` `bin`/`payload` place the apphost binary + payload
// zpkg at explicit relative paths under the deploy root (add-package-layout-config);
// unset → legacy flat (apphost at root/<name>, embed built zpkg in place).
//
// build-if-needed (move-publish-to-z42b stage 3): if the expected zpkg is missing,
// `_pubEnsureBuilt` compiles it via z42c, then publish produces the apphost — so
// `z42 publish` alone does build+deploy. When the zpkg already exists (xtask
// assembly path), no compile runs and bytes stay controlled. Stage 1 ships the
// resolve-or-error form; stage 3 adds the z42c spawn.
namespace Z42Builder;

using Std;
using Std.IO;
using Std.Toml;
using Z42.Build;
// apphost patching is inlined in builder_apphost.z42 (_pubProduceApphost) so z42b
// stays on stdlib-only deps and still builds in the test-runner context. NOT
// `using Z42.Workload.Desktop` (that workload isn't in Z42_LIBS there).

// Entry from builder_cli dispatch (`z42b publish <toml> [--rid <rid>] [--output <dir>]`).
int _cmdPublishZ42b(ParseResult r) {
    string rid = r.GetOption("rid");
    if (rid.Length == 0) {
        ConsoleError.WriteLine("z42b publish: --rid required (run via `z42 publish` to default to host)");
        return 2;
    }
    if (_pubRidCategory(rid) != "desktop") {
        ConsoleError.WriteLine("z42b publish: " + _pubRidCategory(rid)
            + " deployable not yet implemented (B5) — only desktop (apphost) is supported.");
        return 2;
    }
    return _pubDesktop(r, rid);
}

// desktop apphost publish for `rid`. Emits <root>/<bin> (apphost) + optional
// <root>/<payload> (copied zpkg); the apphost embeds the zpkg path relative to itself.
int _pubDesktop(ParseResult r, string rid) {
    string tomlPath = r.GetPositional(0);
    if (tomlPath.Length == 0 || !tomlPath.EndsWith(".toml")) {
        ConsoleError.WriteLine("usage: z42b publish <project.z42.toml> [--rid <rid>] [--output <dir>]");
        return 2;
    }
    if (!File.Exists(tomlPath)) {
        ConsoleError.WriteLine("z42b publish: not found: " + tomlPath);
        return 1;
    }
    TomlValue toml = TomlValue.Parse(File.ReadAllText(tomlPath));
    string projName = _pubTomlStr(toml, "project", "name", "");
    if (projName.Length == 0) {
        ConsoleError.WriteLine("z42b publish: [project].name missing in " + tomlPath);
        return 1;
    }
    // apphost-gate (gate-apphost-on-config): only `[platform.desktop] apphost = true`
    // makes publish emit an apphost. publish_dir / --output are output LOCATION only.
    if (!_pubPlatformBool(toml, "desktop", "apphost", false)) {
        ConsoleError.WriteLine("z42b publish: " + tomlPath + " is not configured to publish a desktop apphost — "
            + "add `apphost = true` under [platform.desktop]");
        return 2;
    }

    // --self-contained (embed-workload-publish): produce a SELF-CONTAINED app that
    // embeds the z42 runtime (links libz42, runs in-process via z42_host_run_app),
    // vs the default apphost that spawns an external z42vm. Static/dynamic link per
    // `[platform.desktop] link`. Distinct output shape (app dir: exe + app.zpkg +
    // libs/), so it takes its own path and returns before the spawn-stub logic.
    if (r.GetFlag("self-contained")) {
        return _pubDesktopSelfContained(r, toml, tomlPath, projName, rid);
    }

    // apphost stub 解析序（wire-z42b build-hook 终章）：
    //   ① 项目 hook 产出：`[build] hooks` 声明 → 动态注入 ProjectHooks → BeforeAssets
    //      登记 kind="apphost-stub" 的 Output（如本仓 xtask：hook 现场 cargo 编 apphost
    //      → 免装 desktop workload，去掉下载依赖）
    //   ② Z42_APPHOST_TEMPLATE：launcher 解析已装 workload 传入（Decision 3.5）
    //   ③ 皆无 → 报错提示 workload install / hook 两条路。
    string stub = _pubHookApphostStub(toml, tomlPath, projName, rid);
    if (stub.Length == 0) {
        stub = Environment.GetEnvironmentVariable("Z42_APPHOST_TEMPLATE") ?? "";
    }
    if (stub.Length == 0 || !File.Exists(stub)) {
        ConsoleError.WriteLine("z42b publish: desktop apphost not available (the apphost ships with the desktop workload).");
        ConsoleError.WriteLine("       run: z42 workload install desktop");
        ConsoleError.WriteLine("       (publish via `z42 publish` so the launcher resolves the installed workload apphost;");
        ConsoleError.WriteLine("        or declare `[build] hooks` with a ProjectHooks that registers an apphost-stub output.)");
        return 1;
    }

    string publishDir = r.GetOption("output");
    if (publishDir.Length == 0) { publishDir = _pubPlatformStr(toml, "desktop", "publish_dir", ""); }
    bool isWin = rid.StartsWith("windows-");
    string projDir = Path.GetDirectoryName(tomlPath);
    // `root` = the deploy root that bin/payload are relative to.
    // unset → ${output_dir}/publish (project.md [build] defaults; keeps publish
    // out of the source tree — the old project-dir default leaked z42/programs/).
    string root;
    if (publishDir.Length == 0) { root = _pubDefaultPublishDir(tomlPath, toml, projName); }
    else { root = (projDir.Length > 0) ? Path.Join(projDir, publishDir) : publishDir; }

    // (unify-run-modes P5) multi-exe publish: a manifest with N `[[exe]]` targets
    // → N apphosts, each embedding `dist/<exe.name>.zpkg` (produced by P3) and named
    // `<exe.name>`. Reuses the per-zpkg apphost patcher (D-exe5 — payload unchanged;
    // one apphost ↔ one zpkg). The first `_pubEnsureBuilt` compiles the whole project
    // (every exe's zpkg); the rest just resolve. Multi-exe ignores `[platform.desktop]`
    // bin/payload (a single-value layout can't name N apps) → emit to `root/<exe.name>`.
    // No `[[exe]]` → falls through to the existing single-app path below (non-breaking).
    string[] exeNames = _pubExes(toml);
    if (exeNames.Length > 0) {
        bool bundled = false;
        int xi = 0;
        while (xi < exeNames.Length) {
            string exName = exeNames[xi];
            string exZpkg = _pubEnsureBuilt(tomlPath, toml, exName);
            if (exZpkg.Length == 0) { return 1; }
            if (!bundled) {   // deps are shared across exes in the one dist/ — bundle once
                int bc2 = _pubBundleProjectDeps(tomlPath, toml, Path.GetDirectoryName(exZpkg));
                if (bc2 != 0) { return bc2; }
                bundled = true;
            }
            string exOut = Path.Join(root, isWin ? (exName + ".exe") : exName);
            string exOutDir = Path.GetDirectoryName(exOut);
            if (exOutDir.Length > 0) { Directory.Create(exOutDir); }
            Console.WriteLine("z42 publish (" + rid + ") → " + exOut);
            int prc2 = _pubProduceApphost(exZpkg, exOut, stub, rid);
            if (prc2 != 0) { return prc2; }
            Console.WriteLine("✅ apphost ready: " + exOut);
            xi = xi + 1;
        }
        return 0;
    }

    // build-if-needed: ensure the expected zpkg exists (compile via z42c if missing).
    string zpkgSrc = _pubEnsureBuilt(tomlPath, toml, projName);
    if (zpkgSrc.Length == 0) { return 1; }   // ensure failed (compile error / still missing)

    // Colocate non-stdlib transitive deps into dist/ so `z42 run dist/<name>.zpkg` works.
    string distDir = Path.GetDirectoryName(zpkgSrc);
    int brc = _pubBundleProjectDeps(tomlPath, toml, distDir);
    if (brc != 0) { return brc; }

    // deploy layout (add-package-layout-config): optional bin/payload.
    string binRel     = _pubPlatformStr(toml, "desktop", "bin", "");
    string payloadRel = _pubPlatformStr(toml, "desktop", "payload", "");

    string outPath;
    if (binRel.Length > 0) {
        outPath = Path.Join(root, binRel);
        if (isWin && !outPath.EndsWith(".exe")) { outPath = outPath + ".exe"; }
    } else {
        outPath = Path.Join(root, isWin ? (projName + ".exe") : projName);
    }

    // payload zpkg: if set, copy the built zpkg + colocated deps into the layout
    // so the subtree is self-contained. If unset, embed the built zpkg in place.
    string appZpkg = zpkgSrc;
    if (payloadRel.Length > 0) {
        appZpkg = Path.Join(root, payloadRel);
        string payloadDir = Path.GetDirectoryName(appZpkg);
        if (payloadDir.Length > 0) { Directory.Create(payloadDir); }
        File.Copy(zpkgSrc, appZpkg);
        _pubCopyDistDeps(distDir, projName, payloadDir);
    }

    string outDir = Path.GetDirectoryName(outPath);
    if (outDir.Length > 0) { Directory.Create(outDir); }
    Console.WriteLine("z42 publish (" + rid + ") → " + outPath);
    int prc = _pubProduceApphost(appZpkg, outPath, stub, rid);
    if (prc != 0) { return prc; }
    Console.WriteLine("✅ apphost ready: " + outPath);
    return 0;
}

// Self-contained desktop publish (embed-workload-publish): copy the PREBUILT
// embed apphost + stage app.zpkg + libs so the app embeds the z42 runtime
// (runs in-process via z42_host_run_app), no external z42vm. `link` (static |
// dynamic, from [platform.desktop] link) selects which prebuilt host; dynamic
// also ships libz42.<dyn> beside the exe. The embed apphost + stdlib + (dynamic)
// shared lib are provisioned by the desktop workload; this repo's dev flow
// supplies them via env (Z42_EMBED_APPHOST / Z42_EMBED_LIBS / Z42_EMBED_DYLIB),
// mirroring the spawn stub's Z42_APPHOST_TEMPLATE.
//
// Output app dir layout: <appDir>/{<projName>[.exe], app.zpkg, libs/*.zpkg
// [, libz42.<dyn>]}. The embed apphost resolves these relative to its own path.
int _pubDesktopSelfContained(ParseResult r, TomlValue toml, string tomlPath, string projName, string rid) {
    bool isWin = rid.StartsWith("windows-");
    string link = _pubPlatformStr(toml, "desktop", "link", "static");
    if (link != "static" && link != "dynamic") {
        ConsoleError.WriteLine("z42b publish: [platform.desktop] link must be static|dynamic (got '" + link + "')");
        return 2;
    }
    string host     = Environment.GetEnvironmentVariable("Z42_EMBED_APPHOST") ?? "";
    string libsSrc  = Environment.GetEnvironmentVariable("Z42_EMBED_LIBS") ?? "";
    string dylibSrc = Environment.GetEnvironmentVariable("Z42_EMBED_DYLIB") ?? "";
    if (host.Length == 0 || !File.Exists(host)) {
        ConsoleError.WriteLine("z42b publish --self-contained: embed apphost not available (ships with the desktop workload).");
        ConsoleError.WriteLine("       run: z42 workload install desktop   (dev: set Z42_EMBED_APPHOST)");
        return 1;
    }
    if (libsSrc.Length == 0 || !Directory.Exists(libsSrc)) {
        ConsoleError.WriteLine("z42b publish --self-contained: stdlib libs dir not available (dev: set Z42_EMBED_LIBS).");
        return 1;
    }
    if (link == "dynamic" && (dylibSrc.Length == 0 || !File.Exists(dylibSrc))) {
        ConsoleError.WriteLine("z42b publish --self-contained --link=dynamic: libz42 shared lib not available (dev: set Z42_EMBED_DYLIB).");
        return 1;
    }

    // build app.zpkg + colocate non-stdlib transitive deps into dist/
    string zpkgSrc = _pubEnsureBuilt(tomlPath, toml, projName);
    if (zpkgSrc.Length == 0) { return 1; }
    string distDir = Path.GetDirectoryName(zpkgSrc);
    int brc = _pubBundleProjectDeps(tomlPath, toml, distDir);
    if (brc != 0) { return brc; }

    // output app dir (same resolution as the spawn path's `root`)
    string publishDir = r.GetOption("output");
    if (publishDir.Length == 0) { publishDir = _pubPlatformStr(toml, "desktop", "publish_dir", ""); }
    string projDir = Path.GetDirectoryName(tomlPath);
    string appDir;
    if (publishDir.Length == 0) { appDir = _pubDefaultPublishDir(tomlPath, toml, projName); }
    else { appDir = (projDir.Length > 0) ? Path.Join(projDir, publishDir) : publishDir; }
    Directory.Create(appDir);

    // exe = prebuilt embed apphost; app.zpkg + libs/ beside it
    string exe = Path.Join(appDir, isWin ? (projName + ".exe") : projName);
    File.Copy(host, exe, true);
    if (!isWin) { new Process("chmod").Arg("+x").Arg(exe).Run(); }   // File.Copy drops the mode bit
    File.Copy(zpkgSrc, Path.Join(appDir, "app.zpkg"), true);
    string libsOut = Path.Join(appDir, "libs");
    Directory.Create(libsOut);
    foreach (var p in Path.Glob(libsSrc, "*.zpkg")) {               // stdlib
        File.Copy(p, Path.Join(libsOut, Path.GetFileName(p)), true);
    }
    _pubCopyDistDeps(distDir, projName, libsOut);                    // + app's transitive deps
    if (link == "dynamic") {
        File.Copy(dylibSrc, Path.Join(appDir, Path.GetFileName(dylibSrc)), true);
    }
    Console.WriteLine("z42 publish (" + rid + ", self-contained/" + link + ") → " + appDir);
    Console.WriteLine("✅ self-contained app ready: " + exe);
    return 0;
}

// ── helpers (minimal toml/path set, mirrored from launcher; Decision 4) ─────────

// rid → platform category (desktop / ios / android / wasm); "" if unknown.
string _pubRidCategory(string rid) {
    if (rid.StartsWith("macos-") || rid.StartsWith("linux-") || rid.StartsWith("windows-")) { return "desktop"; }
    if (rid.StartsWith("ios-") || rid.StartsWith("iossim-")) { return "ios"; }
    if (rid.StartsWith("android-")) { return "android"; }
    if (rid == "browser-wasm") { return "wasm"; }
    return "";
}

// Read root.[section].[key] as a string (string and long values).
// `[[exe]]` target names (unify-run-modes P5). Mirrors ManifestLoader._parseExes
// but TomlValue-direct to keep builder_publish stdlib-only (no z42.project dep).
// Empty array if no `[[exe]]`. Two passes → exact-size array (no trim helper).
string[] _pubExes(TomlValue toml) {
    if (!toml.IsTable() || !toml.ContainsKey("exe")) { return new string[0]; }
    TomlValue arr = toml.Get("exe");
    if (!arr.IsArray()) { return new string[0]; }
    int n = arr.Length();
    int cnt = 0;
    int i = 0;
    while (i < n) {
        TomlValue e = arr.At(i);
        if (e.IsTable() && e.ContainsKey("name") && e.Get("name").IsString()) { cnt = cnt + 1; }
        i = i + 1;
    }
    string[] names = new string[cnt];
    int k = 0;
    i = 0;
    while (i < n) {
        TomlValue e = arr.At(i);
        if (e.IsTable() && e.ContainsKey("name") && e.Get("name").IsString()) {
            names[k] = e.Get("name").AsString();
            k = k + 1;
        }
        i = i + 1;
    }
    return names;
}

string _pubTomlStr(TomlValue root, string section, string key, string dflt) {
    if (!root.ContainsKey(section)) { return dflt; }
    TomlValue s = root.Get(section);
    if (!s.IsTable() || !s.ContainsKey(key)) { return dflt; }
    TomlValue v = s.Get(key);
    if (v.IsString()) { return v.AsString(); }
    if (v.IsLong())   { return v.AsLong().ToString(); }
    return dflt;
}

// Read root.platform.[platform].[key] as a string.
string _pubPlatformStr(TomlValue root, string platform, string key, string dflt) {
    if (!root.ContainsKey("platform")) { return dflt; }
    TomlValue pt = root.Get("platform");
    if (!pt.IsTable() || !pt.ContainsKey(platform)) { return dflt; }
    TomlValue p = pt.Get(platform);
    if (!p.IsTable() || !p.ContainsKey(key)) { return dflt; }
    TomlValue v = p.Get(key);
    if (v.IsString()) { return v.AsString(); }
    if (v.IsLong())   { return v.AsLong().ToString(); }
    return dflt;
}

// Read a bool key under [platform.<platform>] (e.g. `apphost = true`).
bool _pubPlatformBool(TomlValue root, string platform, string key, bool dflt) {
    if (!root.ContainsKey("platform")) { return dflt; }
    TomlValue pt = root.Get("platform");
    if (!pt.IsTable() || !pt.ContainsKey(platform)) { return dflt; }
    TomlValue p = pt.Get(platform);
    if (!p.IsTable() || !p.ContainsKey(key)) { return dflt; }
    TomlValue v = p.Get(key);
    if (v.IsBool()) { return v.AsBool(); }
    return dflt;
}

// Ensure the expected zpkg exists, returning its path ("" on failure). build-if-needed
// (move-publish-to-z42b): if the zpkg is missing, compile it via z42c, then re-check
// — so `z42 publish` alone does build+deploy. When the zpkg already exists (the xtask
// assembly path), NO compile runs and the bytes stay controlled by the caller. If
// z42c can't be located, degrade to a build-first hint (the pre-build-if-needed form).
string _pubEnsureBuilt(string tomlPath, TomlValue toml, string projName) {
    string zpkgSrc = _pubResolveZpkg(tomlPath, toml, projName);
    if (File.Exists(zpkgSrc)) { return zpkgSrc; }

    string z42c = _pubFindZ42c();
    if (z42c.Length == 0) {
        ConsoleError.WriteLine("z42b publish: built zpkg not found: " + zpkgSrc
            + "  (build it first: z42 build " + tomlPath + ")");
        return "";
    }
    Console.WriteLine("z42b publish: zpkg not built — compiling via z42c first…");
    ProcessResult pr = new Process(z42c).Arg("build").Arg(tomlPath).Arg("--release")
        .Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit()).Run();
    if (pr.ExitCode != 0) {
        ConsoleError.WriteLine("z42b publish: z42c build failed (rc=" + pr.ExitCode.ToString() + ")");
        return "";
    }
    if (!File.Exists(zpkgSrc)) {
        ConsoleError.WriteLine("z42b publish: zpkg still missing after build: " + zpkgSrc);
        return "";
    }
    return zpkgSrc;
}

// Locate the SDK's `bin/z42c` apphost from Z42_PORTABLE_VM (<home>/bin/z42vm →
// <home>/bin/z42c). "" if not resolvable (then publish degrades to a build-first
// hint). The apphost colocates the driver's siblings + resolves stdlib itself.
string _pubFindZ42c() {
    string vm = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM") ?? "";
    if (vm.Length == 0) { return ""; }
    string home = Path.GetDirectoryName(Path.GetDirectoryName(vm));   // <home>/bin/z42vm → <home>
    if (home.Length == 0) { return ""; }
    string z42c = Path.Join(home, "bin/z42c");
    if (!File.Exists(z42c)) { z42c = z42c + ".exe"; }
    if (!File.Exists(z42c)) { return ""; }
    return z42c;
}

// Default publish root when neither --output nor [platform.desktop].publish_dir is
// set: ${output_dir}/publish. output_dir resolves like _pubResolveZpkg — explicit
// [build].output_dir first, then the enclosing workspace's [workspace.build]
// template, else the project dir (so the bare default is <projDir>/publish, never
// the project dir itself).
string _pubDefaultPublishDir(string tomlPath, TomlValue toml, string name) {
    string projDir = Path.GetDirectoryName(tomlPath);
    string outDir = _pubTomlStr(toml, "build", "output_dir", "");
    if (outDir.Length > 0) {
        string outAbs = (projDir.Length > 0) ? Path.Join(projDir, outDir) : outDir;
        return Path.Join(outAbs, "publish");
    }
    string wsRoot = _pubFindWorkspaceRoot(tomlPath);
    if (wsRoot.Length > 0) {
        string wsOutDir = _pubWorkspaceOutputDir(wsRoot, name);
        if (wsOutDir.Length > 0) { return Path.Join(Path.Join(wsRoot, wsOutDir), "publish"); }
    }
    return (projDir.Length > 0) ? Path.Join(projDir, "publish") : "publish";
}

// Resolve the built zpkg via the same dist_dir logic as the launcher used.
// Workspace members that omit their own [build] section (the common case —
// see z42c.core/z42c.semantics/... tomls) inherit `[workspace.build] output_dir`
// from the enclosing z42.workspace.toml instead of falling back to a
// project-relative "dist/" (which does not match where `z42c build --workspace`
// actually writes the zpkg — add-package-layout-config dependency bundling
// exposed this: bundling failed to locate z42c.semantics's zpkg without it).
string _pubResolveZpkg(string tomlPath, TomlValue toml, string name) {
    string projDir = Path.GetDirectoryName(tomlPath);
    string outDir  = _pubTomlStr(toml, "build", "output_dir", "");
    string distDir = _pubTomlStr(toml, "build", "dist_dir", "");
    if (outDir.Length == 0 && distDir.Length == 0) {
        string wsRoot = _pubFindWorkspaceRoot(tomlPath);
        if (wsRoot.Length > 0) {
            string wsOutDir = _pubWorkspaceOutputDir(wsRoot, name);
            if (wsOutDir.Length > 0) {
                return Path.Join(Path.Join(wsRoot, wsOutDir), "dist/" + name + ".zpkg");
            }
        }
    }
    string distRel;
    if (distDir.Length > 0) { distRel = distDir.Replace("${output_dir}", outDir); }
    else if (outDir.Length > 0) { distRel = Path.Join(outDir, "dist"); }
    else { distRel = "dist"; }
    string base = (projDir.Length > 0) ? Path.Join(projDir, distRel) : distRel;
    return Path.Join(base, name + ".zpkg");
}

// `[workspace.build] output_dir` template resolved for `name` at profile
// "release" (mirrors _pubEnsureBuilt's hardcoded `z42c build --release`).
// "" if the workspace declares no such template.
string _pubWorkspaceOutputDir(string wsRoot, string name) {
    string wsToml = Path.Join(wsRoot, "z42.workspace.toml");
    if (!File.Exists(wsToml)) { return ""; }
    TomlValue toml = TomlValue.Parse(File.ReadAllText(wsToml));
    if (!toml.ContainsKey("workspace")) { return ""; }
    TomlValue ws = toml.Get("workspace");
    if (!ws.IsTable() || !ws.ContainsKey("build")) { return ""; }
    TomlValue wb = ws.Get("build");
    if (!wb.IsTable() || !wb.ContainsKey("output_dir")) { return ""; }
    TomlValue v = wb.Get("output_dir");
    if (!v.IsString()) { return ""; }
    string tmpl = v.AsString();
    tmpl = tmpl.Replace("${project_name}", name);
    tmpl = tmpl.Replace("${profile}", "release");
    return tmpl;
}

// ── project-kind (workspace-sibling) dependency bundling (add-package-layout-config) ──
//
// z42.toml `[dependencies]` mixes stdlib deps ("z42.io") and, inside a workspace,
// sibling project deps ("z42c.core") using identical syntax. There is no `Kind`
// field distinguishing them (confirmed: DepScan / DepEntry have none). We derive
// "is this a project dep" by cross-referencing against the enclosing workspace's
// `z42.workspace.toml` `default-members` list — the same source `_compilerMembers`
// (xtask) already reads. z42b must stay stdlib-only (test-runner build context),
// so this is hand-rolled TOML walking, NOT a dependency on z42c.project/pipeline.

// Walk up from `tomlPath`'s directory looking for a sibling `z42.workspace.toml`.
// "" if this project isn't inside a workspace (all its deps are then stdlib).
string _pubFindWorkspaceRoot(string tomlPath) {
    string dir = Path.GetDirectoryName(tomlPath);
    while (dir.Length > 0) {
        if (File.Exists(Path.Join(dir, "z42.workspace.toml"))) { return dir; }
        string parent = Path.GetDirectoryName(dir);
        if (parent.Length == 0 || parent == dir) { return ""; }
        dir = parent;
    }
    return "";
}

// `[workspace] default-members` list from `<wsRoot>/z42.workspace.toml`.
string[] _pubWorkspaceMembers(string wsRoot) {
    string wsToml = Path.Join(wsRoot, "z42.workspace.toml");
    if (!File.Exists(wsToml)) { return new string[0]; }
    TomlValue toml = TomlValue.Parse(File.ReadAllText(wsToml));
    if (!toml.ContainsKey("workspace")) { return new string[0]; }
    TomlValue ws = toml.Get("workspace");
    if (!ws.IsTable() || !ws.ContainsKey("default-members")) { return new string[0]; }
    TomlValue arr = ws.Get("default-members");
    string[] xs = new string[arr.Count()];
    int i = 0;
    while (i < arr.Count()) {
        TomlValue v = arr.At(i);
        xs[i] = v.IsString() ? v.AsString() : "";
        i = i + 1;
    }
    return xs;
}

// This project's own `[dependencies]` key names ("" if the section is missing).
string[] _pubDepNames(TomlValue toml) {
    if (!toml.ContainsKey("dependencies")) { return new string[0]; }
    TomlValue deps = toml.Get("dependencies");
    if (!deps.IsTable()) { return new string[0]; }
    return deps.Keys();
}

bool _pubContains(string[] xs, int count, string v) {
    int i = 0;
    while (i < count) {
        if (xs[i] == v) { return true; }
        i = i + 1;
    }
    return false;
}

// Member dir/toml convention: `<wsRoot>/<name>/<name>.z42.toml` (mirrors the
// convention xtask's `_compilerMembers` callers already assume).
string _pubMemberTomlPath(string wsRoot, string name) {
    return Path.Join(Path.Join(wsRoot, name), name + ".z42.toml");
}

// Transitive closure of `tomlPath`'s workspace-sibling (non-stdlib) dependency
// names — BFS over `[dependencies]` restricted to names that resolve to a
// workspace member. Empty if not inside a workspace or no such deps.
string[] _pubProjectDepNames(string tomlPath, TomlValue toml) {
    string wsRoot = _pubFindWorkspaceRoot(tomlPath);
    if (wsRoot.Length == 0) { return new string[0]; }
    string[] members = _pubWorkspaceMembers(wsRoot);
    if (members.Length == 0) { return new string[0]; }
    string ownName = _pubTomlStr(toml, "project", "name", "");

    string[] closure = new string[members.Length];
    int closureCount = 0;
    string[] queue = new string[members.Length];
    int qTail = 0;

    string[] seed = _pubDepNames(toml);
    int si = 0;
    while (si < seed.Length) {
        string d = seed[si];
        if (d != ownName && _pubContains(members, members.Length, d) && !_pubContains(closure, closureCount, d)) {
            queue[qTail] = d; qTail = qTail + 1;
            closure[closureCount] = d; closureCount = closureCount + 1;
        }
        si = si + 1;
    }

    int qHead = 0;
    while (qHead < qTail) {
        string name = queue[qHead]; qHead = qHead + 1;
        string memberToml = _pubMemberTomlPath(wsRoot, name);
        if (!File.Exists(memberToml)) { continue; }
        TomlValue mt = TomlValue.Parse(File.ReadAllText(memberToml));
        string[] mdeps = _pubDepNames(mt);
        int mi = 0;
        while (mi < mdeps.Length) {
            string d = mdeps[mi];
            if (d != ownName && _pubContains(members, members.Length, d) && !_pubContains(closure, closureCount, d)) {
                queue[qTail] = d; qTail = qTail + 1;
                closure[closureCount] = d; closureCount = closureCount + 1;
            }
            mi = mi + 1;
        }
    }

    string[] result = new string[closureCount];
    int ri = 0;
    while (ri < closureCount) { result[ri] = closure[ri]; ri = ri + 1; }
    return result;
}

// build-if-needed each workspace-sibling dependency of `tomlPath`, then copy its
// zpkg into `payloadDir`. 0 on success.
//
// .zsym sidecars are intentionally NOT bundled here (User decision 2026-07-01,
// add-package-layout-config task ④): the desktop SDK's programs/z42c/ tree has
// never shipped debug-symbol sidecars for the driver's siblings, and this bundler
// backs xtask's byte/file-identical packaging refactor — adding new files would
// break that hard acceptance bar. Offline symbolication of the SDK's own bundled
// z42c.* is not a served use case today; revisit as a deliberate opt-in if that
// changes.
// 通用「间接依赖复制」（fix-repl-sdk-layout）：把本组件声明依赖的**传递闭包**中「**不在 shipped
// `libs/`（框架）**」的 zpkg colocate 进 payloadDir（app 的 entry-dir），使运行期无需扫散落目录即
// 解析间接依赖（参 .NET `dotnet publish` 复制非-framework 闭包）。框架（stdlib + 一切已 ship 进 libs/
// 的库）不复制——由共享 libs/ 提供、省体积。
//
// 关键分类（勿混）：
//  · **复制判定** = 「不在 shipped libs/」（Z42_LIBS 目录无同名 zpkg）。**不能**用「是否 src/libraries
//    成员」——否则 launcher 的 z42.workload.*（非 src/libraries、也不在 libs/）会漏拷。
//  · **递归穿透** = 除**真·stdlib 成员**（src/libraries 下有同名目录，只依赖框架）外，一律递归——
//    这样才能穿透「已 ship 进 libs/ 却越界依赖非框架」的 lib（如 z42.scripting 在 libs/ 却依赖 z42c.*），
//    触达其隐藏的传递非框架依赖（z42c.*）。
//
// 取代原「仅同-workspace 成员」逻辑（跟不进跨-workspace 传递链，z42i 因此丢 z42c.*）。
int _pubBundleProjectDeps(string tomlPath, TomlValue toml, string payloadDir) {
    string srcRoot = _pubSrcRoot(tomlPath);
    string libsDir = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    string ownName = _pubTomlStr(toml, "project", "name", "");
    string[] seen  = new string[1024]; int seenN = 0;
    string[] queue = new string[1024]; int qh = 0; int qt = 0;
    // seed：直接声明依赖。
    string[] direct = _pubDepNames(toml);
    int di = 0;
    while (di < direct.Length) {
        string d = direct[di]; di = di + 1;
        if (d != ownName && !_pubContains(seen, seenN, d)) { seen[seenN] = d; seenN = seenN + 1; queue[qt] = d; qt = qt + 1; }
    }
    while (qh < qt) {
        string name = queue[qh]; qh = qh + 1;
        // 真·stdlib 成员：框架、只依赖框架 → 不复制、不递归（省遍历）。
        if (srcRoot.Length > 0 && Directory.Exists(Path.Join(Path.Join(srcRoot, "libraries"), name))) { continue; }
        // 定位依赖 toml（读它的依赖以递归 + resolve zpkg）。
        string depTomlPath = (srcRoot.Length > 0) ? _pubLocateDepToml(srcRoot, name) : "";
        if (depTomlPath.Length == 0) { continue; }   // 无源 toml → 保守跳过，不阻断 publish。
        TomlValue depToml = TomlValue.Parse(File.ReadAllText(depTomlPath));
        // 复制判定：不在 shipped libs/ 才复制。
        bool inLibs = (libsDir.Length > 0) && File.Exists(Path.Join(libsDir, name + ".zpkg"));
        if (!inLibs) {
            string depZpkg = _pubEnsureBuilt(depTomlPath, depToml, name);
            if (depZpkg.Length == 0) { return 1; }
            string dst = Path.Join(payloadDir, name + ".zpkg");
            if (depZpkg != dst && !File.Exists(dst)) { File.Copy(depZpkg, dst); }
        }
        // 递归本依赖的依赖（穿透越界 lib）。
        string[] sub = _pubDepNames(depToml);
        int si = 0;
        while (si < sub.Length) {
            string s = sub[si]; si = si + 1;
            if (s != ownName && !_pubContains(seen, seenN, s)) { seen[seenN] = s; seenN = seenN + 1; queue[qt] = s; qt = qt + 1; }
        }
    }
    return 0;
}

// Copy non-app zpkgs from distDir into targetDir (used by publish to populate
// payload from already-colocated dist/).
void _pubCopyDistDeps(string distDir, string projName, string targetDir) {
    string[] entries = Directory.Enumerate(distDir);
    string mainZpkg = projName + ".zpkg";
    int i = 0;
    while (i < entries.Length) {
        string name = entries[i];
        if (name.EndsWith(".zpkg") && name != mainZpkg) {
            string src = Path.Join(distDir, name);
            string dst = Path.Join(targetDir, name);
            if (src != dst && !File.Exists(dst)) { File.Copy(src, dst); }
        }
        i = i + 1;
    }
}

// src 根：从 tomlPath 上溯，找同时含 libraries/ 与 compiler/ 的目录。
string _pubSrcRoot(string tomlPath) {
    string dir = Path.GetDirectoryName(tomlPath);
    while (dir.Length > 0) {
        if (Directory.Exists(Path.Join(dir, "libraries")) && Directory.Exists(Path.Join(dir, "compiler"))) { return dir; }
        string parent = Path.GetDirectoryName(dir);
        if (parent.Length == 0 || parent == dir) { return ""; }
        dir = parent;
    }
    return "";
}

// 在 src 根下按名定位依赖 toml：先直查常见布局 <area>/<name>/<name>.z42.toml（libraries/compiler），
// 再递归搜 toolchain（布局多样：scripting/、<comp>/core/），最后递归兜底 libraries/compiler。
string _pubLocateDepToml(string srcRoot, string name) {
    string fname = name + ".z42.toml";
    string[] areas = new string[]{ "libraries", "compiler" };
    int a = 0;
    while (a < areas.Length) {
        string p = Path.Join(Path.Join(Path.Join(srcRoot, areas[a]), name), fname);
        if (File.Exists(p)) { return p; }
        a = a + 1;
    }
    string r = _pubFindFileRec(Path.Join(srcRoot, "toolchain"), fname);
    if (r.Length > 0) { return r; }
    r = _pubFindFileRec(Path.Join(srcRoot, "libraries"), fname);
    if (r.Length > 0) { return r; }
    return _pubFindFileRec(Path.Join(srcRoot, "compiler"), fname);
}

// 递归找 dir 下名为 fname 的文件（子目录深度优先）。
string _pubFindFileRec(string dir, string fname) {
    if (!Directory.Exists(dir)) { return ""; }
    string direct = Path.Join(dir, fname);
    if (File.Exists(direct)) { return direct; }
    string[] entries = Directory.Enumerate(dir);
    int i = 0;
    while (i < entries.Length) {
        // Directory.Enumerate 返回 **basename**（非全路径）——须与 dir 拼接才能 Directory.Exists /
        // 递归（否则相对 CWD 判定恒 false，toolchain/ 下的 z42.scripting 永远搜不到 → 其传递依赖
        // z42c.* 不被 colocate → z42i shipped 求值报 undefined Lexer.Tokenize）。fix-pubfindfilerec-basename。
        string full = Path.Join(dir, entries[i]);
        if (Directory.Exists(full)) {
            string r = _pubFindFileRec(full, fname);
            if (r.Length > 0) { return r; }
        }
        i = i + 1;
    }
    return "";
}

// ── 项目 hook 产出 apphost stub（wire-z42b build-hook 终章）─────────────────────
//
// `[build] hooks = "<dir>"` 声明 → _loadProjectHooks（builder_hooks.z42：编译 + 动态
// 注入 ProjectHooks）→ 构造受限 ctx → BeforeAssets(ctx) → 取 ctx.Outputs() 中
// kind=="apphost-stub" 的登记路径。无 hooks 声明 / hook 未登记 / 文件不存在 → ""
// （调用方落回 Z42_APPHOST_TEMPLATE）。
//
// hook 中间产物落点：[build] output_dir（projDir 相对）之下的 hooks/；无 output_dir
// 则 <projDir>/artifacts/<name>/hooks/（镜像 _computeDirs 默认布局）。
string _pubHookApphostStub(TomlValue toml, string tomlPath, string projName, string rid) {
    string hooksRel = _pubTomlStr(toml, "build", "hooks", "");
    if (hooksRel.Length == 0) { return ""; }
    string projDir = Path.GetDirectoryName(tomlPath);
    if (projDir.Length == 0) { projDir = "."; }
    string hooksDir = Path.Join(projDir, hooksRel);

    string outBase = _pubTomlStr(toml, "build", "output_dir", "");
    string baseDir;
    if (outBase.Length > 0) { baseDir = Path.Join(projDir, outBase); }
    else { baseDir = Path.Join(Path.Join(projDir, "artifacts"), projName); }
    string interDir = Path.Join(baseDir, "hooks");

    BuildHooks h = _loadProjectHooks(hooksDir, interDir, projName + ".hooks");
    if (h == null) { return ""; }

    PipelineContext ctx = new PipelineContext();
    ctx.Target = new Target(rid, TargetFamily.Desktop, "release", BuildMode.Publish);
    ctx.Dirs   = new Dirs(projDir, "", interDir, interDir);
    try { h.BeforeAssets(ctx); }
    catch (Exception e) {
        ConsoleError.WriteLine("z42b publish: project hook BeforeAssets failed (" + e.Message + ")");
        return "";
    }
    Output[] outs = ctx.Outputs();
    int i = 0;
    while (i < outs.Length) {
        if (outs[i].Kind == "apphost-stub" && File.Exists(outs[i].Path)) { return outs[i].Path; }
        i = i + 1;
    }
    ConsoleError.WriteLine("z42b publish: project hooks ran but registered no usable apphost-stub output — falling back to the workload apphost");
    return "";
}
