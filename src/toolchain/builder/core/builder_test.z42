// z42b test / bench — reflective [Test]/[Benchmark] runner (retire-test-runner).
//
// Replaces the Rust z42-test-runner. A compiled test/bench module (.zbc / .zpkg)
// is loaded into the live VM by Std.Test.ModuleLoader and its TIDX
// [Test] / [Benchmark] free functions are run by reflection via
// Std.Test.Runner.RunModule, which exits 0 (all passed) / 1 (any failure).
//
// Execution mode (interp / jit) is inherited from the z42vm hosting this program
// (`z42vm --mode <mode> z42.builder.zbc -- test <artifact>`): the loaded test
// functions execute under the same VM and mode.
namespace Z42Builder;

using Std;
using Std.IO;
using Std.Cli;
using Std.Test;
using Std.Json;
using Z42.Build;
using Z42.Build.Project;   // ProjectManifest / ManifestLoader（z42b-owns-test-targets：按目标建/跑）

int _cmdTest(ParseResult r)  { return _runModule(r, "test"); }
int _cmdBench(ParseResult r) { return _runModule(r, "bench"); }

// Resolve the target → RunModule. RunModule runs both [Test] and [Benchmark]
// (mirroring the retired Rust runner), so test / bench share this path — a
// compiled artifact contains only the relevant category of entries.
//
// Two target forms (add-z42b-compile-then-test — unify-test-pipeline stage ②):
//   • <file.zbc|.zpkg>          → run the already-compiled module directly
//                                 (exactly how xtask drives the corpus).
//   • <project.z42.toml> / none → compile-then-test: build the project via the
//                                 injected in-process compiler (_buildProject,
//                                 wire-z42b-host-build), then run its dist zpkg.
//                                 Empty target defaults to z42.toml (mirrors build).
int _runModule(ParseResult r, string verb) {
    string target = r.GetPositional(0);
    // Output format: pretty (default, human-readable) | json (structured report
    // with per-benchmark bench_stats) — rebuild-bench-structured-output.
    string format = r.GetOption("format");
    if (format.Length == 0) { format = "pretty"; }
    string rid = r.GetOption("rid");

    // A `.json` target = a test-bundle manifest (assembled by the fleet
    // orchestrator xtask). z42b is the single-bundle EXECUTOR
    // (unify-test-pipeline ②b): host runs it in-process, sharing the same
    // Std.Test.BundleRunner core the on-device agent uses.
    //   --rid host (or empty) → run the bundle in-process (Slice 1).
    //   --rid <device>        → build + deploy + run on the device (Slice 3,
    //                           builder_device._runDevice); --stage-only keeps the
    //                           ②b assemble-only behaviour.
    if (target.EndsWith(".json")) {
        if (rid.Length == 0 || rid == "host") {
            return _runBundleHost(target, format);
        }
        return _runDevice(r, target, rid);
    }

    // Already-compiled artifact → run as-is (dep closure resolved from VM search dirs).
    if (target.EndsWith(".zbc") || target.EndsWith(".zpkg")) {
        return Runner.RunModule(target, format);
    }
    // Otherwise treat as a project manifest (empty → z42.toml): compile then run
    // the produced dist zpkg through the same reflective Runner path. Build
    // diagnostics/exit-code come from _buildProject; a missing manifest surfaces
    // there as rc 2.
    // z42b-owns-test-targets（阶段 ③）：manifest 若声明了 dev target（`[[test]]`/`[[bench]]` 或
    // `[tests]`/`[bench]` 段的 glob），**按目标编译 + 运行**，而不是编译项目自身。
    // 目标在内存里派生 manifest（不落文件），父包身份直达编译器 ⇒ 测试可见父包 internal。
    // `--name` 选一个；不给则全部。未声明任何目标 → 回落到「编译项目自身」的既有行为
    // （独立测试工程就是这个形态：项目自己的源里就是测试）。
    return _runDevTargets(r, verb, format);
}

// 解析 → 逐个建 + 跑。任一非零 → 整体非零（继续跑完其余，一次看全）。
int _runDevTargets(ParseResult r, string verb, string format) {
    string tomlPath = r.GetPositional(0);
    if (tomlPath.Length == 0) { tomlPath = "z42.toml"; }
    if (!File.Exists(tomlPath)) {
        ConsoleError.WriteLine("z42b " + verb + ": project manifest not found: " + tomlPath);
        return 2;
    }
    ProjectManifest m = ManifestLoader.Load(tomlPath);
    string kind = (verb == "bench") ? "bench" : "test";
    string nameFilter = r.GetOption("name");
    string substrFilter = r.GetOption("filter");   // 子串筛一批（零命中是正常结果，不报错）

    string projDir = Path.GetDirectoryName(tomlPath);
    if (projDir.Length == 0) { projDir = "."; }
    DevTarget[] targets = _resolveDevTargetsF(m, kind, nameFilter, substrFilter, projDir);
    if (targets.Length == 0) {
        if (substrFilter.Length > 0 && nameFilter.Length == 0) {
            Console.WriteLine("z42b " + verb + ": no " + kind + " target matched --filter `"
                + substrFilter + "` (nothing to run)");
            return 0;
        }
        if (nameFilter.Length > 0) {
            // 点名却没命中：**报错并列出可选名**，绝不静默跑零个然后返回 0
            // （那正是 #571 要根除的「没跑 == 全过」）。
            ConsoleError.WriteLine("z42b " + verb + ": no " + kind + " target named `" + nameFilter + "`");
            DevTarget[] all = _resolveDevTargets(m, kind, "", projDir);
            if (all.Length == 0) {
                ConsoleError.WriteLine("  (this manifest declares no " + kind + " targets at all)");
            } else {
                string names = "";
                int i = 0;
                while (i < all.Length) { names = names + (i > 0 ? ", " : "") + all[i].Name; i = i + 1; }
                ConsoleError.WriteLine("  available: " + names);
            }
            return 2;
        }
        // 未声明任何目标 → 回落到既有「编译项目自身再跑」的行为。
        BuildOutcome b0 = _buildProject(r, "");
        if (b0.Rc != 0) { return b0.Rc; }
        if (b0.Dist.Length == 0) {
            ConsoleError.WriteLine("z42b " + verb + ": build produced no runnable artifact");
            return 1;
        }
        return Runner.RunModule(b0.Dist, format);
    }

    int worst = 0;
    int ti = 0;
    while (ti < targets.Length) {
        DevTarget t = targets[ti];
        Console.WriteLine("\n── " + kind + " target: " + t.Name + " ──");
        int rc = _runOneDevTarget(r, m, t, kind, tomlPath, format);
        if (rc != 0 && worst == 0) { worst = rc; }
        ti = ti + 1;
    }
    return worst;
}


// 建一个目标并跑它。派生 manifest 只活在内存里 —— 不写任何临时 toml（这正是本变更要消除的
// 那条「伪造文件 → 落盘 → 读回来」往返；身份就是在那一步丢的）。
int _runOneDevTarget(ParseResult r, ProjectManifest m, DevTarget t, string kind,
                     string tomlPath, string format) {
    string sourceDir = Path.GetDirectoryName(tomlPath);
    if (sourceDir.Length == 0) { sourceDir = "."; }
    Target tgt = _makeTarget(r, "");
    if (tgt.Rid.Length == 0) {
        ConsoleError.WriteLine("z42b: unsupported host (" + Platform.OS() + "/" + Platform.Arch() + "); pass --rid");
        return 2;
    }
    // 每目标独立的产物/缓存根 —— 防两个目标的 source.zbc 互相覆盖（xtask 旧路径同款隔离）。
    string outRoot = Path.Join(Path.Join(sourceDir, "artifacts"), kind + "-targets");
    ProjectManifest derived = _deriveTargetManifest(m, t, kind, outRoot);

    // ① 先建**父包本体** —— 测试目标依赖它（`Api` 之类来自父包的公开面）。父包 dist 不在
    //    Z42_LIBS 里，故作为 extraDepDir 供给。注意这也正是「不双编译」的体现：父包只建一次，
    //    所有目标共用它的产物。
    string parentDist = _buildParentForTargets(m, tgt, sourceDir);
    if (parentDist.Length == 0) { return 1; }

    // ② 父包身份：交给进程内编译器 ⇒ 测试可见父包 internal
    //    （Pipeline.ParentPkg → CompileRequest.ParentPkg → CompileInputs.ParentPkg）。
    int rc = _orchestrateWith(derived, tgt, sourceDir, "", m.Project.Name, parentDist);
    if (rc != 0) { return rc; }

    Dirs dirs = _computeDirs(derived, sourceDir, tgt.Profile);
    string built = Path.Join(dirs.Intermediate, "app.zpkg");
    if (!File.Exists(built)) {
        ConsoleError.WriteLine("z42b " + kind + ": target `" + t.Name + "` produced no runnable artifact");
        return 1;
    }
    Directory.Create(dirs.Dist);
    string dist = Path.Join(dirs.Dist, derived.Project.Name + ".zpkg");
    File.Copy(built, dist);
    // 父包 zpkg **并置**到测试产物旁：Runner 把测试产物加载进 live VM 后，其依赖按 VM 搜索目录
    // 解析 —— 父包的 dist 不在 Z42_LIBS 里，不并置就会在运行期撞 `undefined function <父包>.X`
    // （编译期已通过，因为编译期依赖是经 extraDepDir 显式供给的）。
    string[] parentPkgs = Path.Glob(parentDist, "*.zpkg");
    int pi = 0;
    while (pi < parentPkgs.Length) {
        string dstp = Path.Join(dirs.Dist, Path.GetFileName(parentPkgs[pi]));
        if (!File.Exists(dstp)) { File.Copy(parentPkgs[pi], dstp); }
        pi = pi + 1;
    }

    if (!t.Harness) {
        // harness=false：自驱 Main、退出码判定 —— 刀二收编，先明确拒绝而不是假装跑过。
        ConsoleError.WriteLine("z42b " + kind + ": target `" + t.Name
            + "` uses harness=false (self-driving Main); not yet supported by z42b (slice 2)");
        return 2;
    }
    return Runner.RunModule(dist, format);
}

// Slice 1 (host): run a test-bundle manifest IN-PROCESS. Parse manifest.json →
// BundleCase[] (z42.test stays JSON-free, so the parse lives here), run via the
// shared Std.Test.BundleRunner (goldens isolated + compared, units shared-VM),
// render in `format`, and return an exit code. No desktop testhost / agent spawn
// on the host — z42b already runs on a z42vm and calls z42.test directly.
int _runBundleHost(string manifestPath, string format) {
    if (!File.Exists(manifestPath)) {
        ConsoleError.WriteLine("z42b test: bundle manifest not found: " + manifestPath);
        return 2;
    }
    string dir = Path.GetDirectoryName(manifestPath);
    BundleCase[] cases = _parseBundleManifest(manifestPath);
    TestResult[] all = BundleRunner.RunBundle(cases, dir, "");
    if (format == "json") {
        Console.WriteLine(TestReport.toJson("bundle", all));
    } else {
        _renderBundlePretty(all);
    }
    return BundleRunner.ExitCode(all);
}

// Parse a bundle manifest (`{cases:[{name,zbc[,entry][,expected]}]}`) into
// BundleCase[]. `entry` present → golden; absent → unit (Entry null). Mirrors the
// on-device agent's adapter — the JSON glue is per-host; the execution is shared.
BundleCase[] _parseBundleManifest(string manifestPath) {
    JsonValue m = JsonValue.Parse(File.ReadAllText(manifestPath));
    JsonValue cases = m.Get("cases");
    int n = cases.Count();
    BundleCase[] outp = new BundleCase[n];
    for (int i = 0; i < n; i = i + 1) {
        JsonValue c = cases.At(i);
        string name = c.Get("name").AsString();
        string zbc = c.Get("zbc").AsString();
        string entry = c.ContainsKey("entry") ? c.Get("entry").AsString() : null;
        string expected = c.ContainsKey("expected") ? c.Get("expected").AsString() : null;
        outp[i] = new BundleCase(name, zbc, entry, expected);
    }
    return outp;
}

// Pretty rendering of an aggregated bundle result (json mode uses TestReport.toJson).
void _renderBundlePretty(TestResult[] all) {
    int passed = 0; int failed = 0; int skipped = 0;
    for (int i = 0; i < all.Length; i = i + 1) {
        TestResult t = all[i];
        if (t.Status == "passed") {
            passed = passed + 1;
            Console.WriteLine("  PASS " + t.Name);
        } else if (t.Status == "failed") {
            failed = failed + 1;
            Console.WriteLine("  FAIL " + t.Name + ((t.Reason != null) ? (": " + t.Reason) : ""));
        } else {
            skipped = skipped + 1;
            Console.WriteLine("  SKIP " + t.Name);
        }
    }
    Console.WriteLine("");
    Console.WriteLine("  Result: " + passed.ToString() + " passed, "
        + failed.ToString() + " failed, " + skipped.ToString() + " skipped");
}

// Device deploy/build/run dispatch now lives in builder_device.z42 (_runDevice,
// z42b-device-run Slice 3). The shared assembler _stageDeployable (below) is called
// from there. _isDeviceRid stays here (used by both files, same namespace).
bool _isDeviceRid(string rid) {
    return rid == "browser-wasm" || rid == "ios-arm64" || rid == "iossim-arm64"
        || rid == "android-arm64" || rid == "android-x64";
}

// Stage destDir/{app,libs,bundle}: the test-agent app.zpkg, all flat stdlib zpkgs,
// and the bundle (manifest + case files). For wasm, also emit files.json (a sorted
// {vfs,url} list of every staged file — the browser fetch-list). Deterministic:
// libs/bundle enumerations are sorted before staging (common-pitfalls §1).
int _stageDeployable(string bundleDir, string agent, string libs, string destDir, bool wasm) {
    if (Directory.Exists(destDir)) { Directory.Delete(destDir, true); }
    Directory.Create(destDir);
    string files = "";

    // app/ — the test-agent.
    string appDir = Path.Join(destDir, "app"); Directory.Create(appDir);
    File.Copy(agent, Path.Join(appDir, "z42.testagent.zpkg"), true);
    files = _appendFileEntry(files, "/app/z42.testagent.zpkg", "app/z42.testagent.zpkg");

    // libs/ — all flat stdlib zpkgs (every agent + case dep resolves from here).
    string libsOut = Path.Join(destDir, "libs"); Directory.Create(libsOut);
    foreach (var z in _sortedDir(libs)) {
        if (!z.EndsWith(".zpkg")) { continue; }
        File.Copy(Path.Join(libs, z), Path.Join(libsOut, z), true);
        files = _appendFileEntry(files, "/libs/" + z, "libs/" + z);
    }

    // bundle/ — manifest.json + every case zbc/zpkg/expected.
    string bundleOut = Path.Join(destDir, "bundle"); Directory.Create(bundleOut);
    foreach (var f in _sortedDir(bundleDir)) {
        File.Copy(Path.Join(bundleDir, f), Path.Join(bundleOut, f), true);
        files = _appendFileEntry(files, "/bundle/" + f, "bundle/" + f);
    }

    if (wasm) {
        File.WriteAllText(Path.Join(destDir, "files.json"), "[\n" + files + "\n]\n");
    }
    Console.WriteLine("z42b: staged deployable → " + destDir + (wasm ? " (+files.json)" : ""));
    return 0;
}

// Append one files.json `{vfs,url}` entry (comma-separated). Mirrors the layout the
// wasm test-host's run.js consumes.
string _appendFileEntry(string acc, string vfs, string url) {
    string e = "  {\"vfs\": \"" + vfs + "\", \"url\": \"" + url + "\"}";
    if (acc.Length == 0) { return e; }
    return acc + ",\n" + e;
}

// Enumerate a dir, sorted (ordinal) for deterministic staging / files.json order.
string[] _sortedDir(string dir) {
    string[] names = Directory.Enumerate(dir);
    int n = names.Length;
    for (int i = 1; i < n; i = i + 1) {
        string key = names[i];
        int j = i - 1;
        while (j >= 0 && names[j].CompareTo(key) > 0) {
            names[j + 1] = names[j];
            j = j - 1;
        }
        names[j + 1] = key;
    }
    return names;
}

// 建父包本体一次（多目标共用），返回其 dist 目录；失败返 ""。
string _buildParentForTargets(ProjectManifest m, Target tgt, string sourceDir) {
    int rc = _orchestrate(m, tgt, sourceDir, "");
    if (rc != 0) {
        ConsoleError.WriteLine("z42b: failed to build parent package `" + m.Project.Name + "`");
        return "";
    }
    Dirs dirs = _computeDirs(m, sourceDir, tgt.Profile);
    string built = Path.Join(dirs.Intermediate, "app.zpkg");
    if (!File.Exists(built)) {
        ConsoleError.WriteLine("z42b: parent package `" + m.Project.Name + "` produced no artifact");
        return "";
    }
    Directory.Create(dirs.Dist);
    string dist = Path.Join(dirs.Dist, m.Project.Name + ".zpkg");
    File.Copy(built, dist);
    return dirs.Dist;
}
