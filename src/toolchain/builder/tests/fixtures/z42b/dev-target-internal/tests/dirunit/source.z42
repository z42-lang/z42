// 目录单元的入口文件：[Test] 方法住这里，参考数据住兄弟文件 vectors.z42。
// 两个文件共享同一 namespace，**必须一起编** —— 这正是「一文件一单元」表达不了、
// 必须有目录单元的原因（真实先例：z42.crypto/tests/secp256k1）。
namespace DtInternalDirUnitTests;

using Dt.Internal;
using Std.Harness;

[Test]
void test_dir_unit_sees_sibling_file() {
    // Fixtures 来自 vectors.z42。编不进来的话这里是「未定义符号」而不是断言失败。
    Assert.Equal(7, DirUnitVectors.Seven());
    Assert.Equal(14, DirUnitVectors.Fourteen());
}

// 目录单元同样是父包的测试目标 → 照样看得见 internal。
[Test]
void test_dir_unit_sees_parent_internal() {
    Hidden h = new Hidden(DirUnitVectors.Seven());
    Assert.Equal(14, h.Doubled());
}

// `[ShouldThrow<E>]` 的期望类型只经这条 attribute 的反射工厂（`typeof(E)`）引用 —— 打包成 zpkg
// 后它必须仍能被 runner 读回并匹配。本用例把 zpkg 这条路钉住。
[Test]
[ShouldThrow<TestFailure>]
void test_should_throw_survives_zpkg_packaging() {
    Assert.Fail("这条必须被 [ShouldThrow<TestFailure>] 接住");
}
