namespace Z42.Workload.Ios;

using Std.IO;

/// Assembles the SwiftPM adapter from an unpacked iOS Runtime's native directory.
public static class IosRuntime {
    public static int BuildSwiftPackageFramework(string nativeDir, string output) {
        string temp = Directory.CreateTempDir("z42-ios-runtime");
        try {
            string archive = Path.Join(temp, "libz42-default.a");
            int code = new Process("libtool").Arg("-static").Arg("-o").Arg(archive)
                .Arg(Path.Join(nativeDir, "libz42.a"))
                .Arg(Path.Join(nativeDir, "libz42_compression.a"))
                .Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit()).Run().ExitCode;
            if (code != 0) { return code; }
            return new Process("xcodebuild").Arg("-create-xcframework")
                .Arg("-library").Arg(archive)
                .Arg("-headers").Arg(Path.Join(nativeDir, "include"))
                .Arg("-output").Arg(output)
                .Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit()).Run().ExitCode;
        } finally { Directory.Delete(temp, true); }
    }
}
