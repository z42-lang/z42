// z42 test-agent (add-embedded-app-run, 2026-08-02).
//
// The SINGLE, platform-independent on-device test runner. Packaged as an
// app.zpkg and embedded (via z42-host::run_app → z42::app::run) into every
// platform's test host (desktop self-contained / wasm / iOS / android). Because
// it is z42 bytecode, ALL platforms run the exact same runner — no per-language
// re-implementation (retires the 4× R1–R7 native drivers).
//
// It is a thin front for Std.Test.Runner.RunModule: receive a command (which
// test module + output format), run it, emit the structured report. z42b is the
// BUILD tool; this is the RUN tool — same Runner, different host.
//
// Command (one-shot, via forwarded `-- <args>`):
//   <target-zbc-path> [format] [out-path]
//     format   = "json" (default) | "pretty" | "tap"
//     out-path = optional. When given, the JSON report is WRITTEN to this file
//                instead of stdout. Desktop omits it → report to stdout (the
//                harness captures the process stdout). Embedded hosts with no
//                process stdout (wasm / iOS / Android, add-wasm-testhost G6)
//                pass a VFS/temp path and read the file back — one agent, every
//                platform, differing only in how the report is retrieved.
namespace Z42.TestHost.Agent;

using Std;
using Std.IO;
using Std.Test;
using Std.Json;

void Main() {
    string[] args = Environment.GetCommandLineArgs();
    if (args.Length < 1) {
        ConsoleError.WriteLine("test-agent: usage: <target.zbc|manifest.json> [format=json|pretty|tap] [out-path]");
        return;
    }
    string target = args[0];
    string format = "json";
    if (args.Length >= 2) { format = args[1]; }
    string outPath = "";
    if (args.Length >= 3) { outPath = args[2]; }

    // A `.json` target = a test-bundle manifest → run ALL its cases, aggregating
    // into one report (wire-embedded-testhost G3). Otherwise a single module.
    if (target.EndsWith(".json")) {
        string report = _runBundleReport(target);
        _emit(report, outPath);
    } else if (outPath != "") {
        // Single module, file output: capture results → aggregate JSON → file.
        TestResult[] rs = Runner.RunModuleResults(target);
        _emit(TestReport.toJson(target, rs), outPath);
    } else {
        // Single module, stdout: RunModule discovers [Test]/[Benchmark], runs
        // them, and renders `format` directly to stdout (json → one object).
        Runner.RunModule(target, format);
    }
}

// Route the report to a file (embedded hosts) or stdout (desktop harness).
void _emit(string report, string outPath) {
    if (outPath != "") {
        File.WriteAllText(outPath, report);
    } else {
        Console.WriteLine(report);
    }
}

// Bundle mode: read manifest `{cases:[…]}` and RETURN ONE aggregate TestReport.
// Two case kinds (mature-embed-testhost P1):
//   golden — `{name, zbc, entry, expected}` : a whole program; run in a FRESH
//            isolated VM (RunGoldensIsolated → per-case VmContext, no collision),
//            compare captured stdout to `expected` (a sibling file). Batched.
//   unit   — `{name, zbc}` : a [Test] module; run via Runner.RunModuleResults
//            (shared VM — units are namespaced, collision-free by design).
// z42 has no jagged arrays → grow result arrays manually.
string _runBundleReport(string manifestPath) {
    string dir = Path.GetDirectoryName(manifestPath);
    JsonValue m = JsonValue.Parse(File.ReadAllText(manifestPath));
    JsonValue cases = m.Get("cases");
    int n = cases.Count();

    // Pass 1: count goldens (case has "entry") vs units.
    int gN = 0;
    for (int i = 0; i < n; i = i + 1) {
        if (cases.At(i).ContainsKey("entry")) { gN = gN + 1; }
    }

    TestResult[] all = new TestResult[0];

    // Goldens: gather → RunGoldensIsolated (batched, isolated) → compare.
    if (gN > 0) {
        string[] gPaths = new string[gN];
        string[] gEntries = new string[gN];
        string[] gNames = new string[gN];
        string[] gExpected = new string[gN];
        int gi = 0;
        for (int i = 0; i < n; i = i + 1) {
            JsonValue c = cases.At(i);
            if (!c.ContainsKey("entry")) { continue; }
            gPaths[gi] = Path.Join(dir, c.Get("zbc").AsString());
            gEntries[gi] = c.Get("entry").AsString();
            gNames[gi] = c.Get("name").AsString();
            string exp = "";
            if (c.ContainsKey("expected")) {
                string ep = Path.Join(dir, c.Get("expected").AsString());
                if (File.Exists(ep)) { exp = File.ReadAllText(ep); }
            }
            gExpected[gi] = exp;
            gi = gi + 1;
        }
        string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
        string[] outs = ModuleLoader.RunGoldensIsolated(gPaths, gEntries, libs);
        TestResult[] gr = new TestResult[gN];
        for (int i = 0; i < gN; i = i + 1) {
            string got = _stripNl(outs[i]);
            string want = _stripNl(gExpected[i]);
            if (got == want) {
                gr[i] = new TestResult(gNames[i], "passed", false, null, null);
            } else {
                gr[i] = new TestResult(gNames[i], "failed", false,
                    "stdout mismatch: want [" + _oneLine(want) + "] got [" + _oneLine(got) + "]", null);
            }
        }
        all = _concat(all, gr);
    }

    // Units: shared-VM [Test] modules.
    for (int i = 0; i < n; i = i + 1) {
        JsonValue c = cases.At(i);
        if (c.ContainsKey("entry")) { continue; }
        TestResult[] rs = Runner.RunModuleResults(Path.Join(dir, c.Get("zbc").AsString()));
        all = _concat(all, rs);
    }

    return TestReport.toJson("bundle", all);
}

// Grow: return a ++ b (z42 has no jagged arrays / built-in concat here).
TestResult[] _concat(TestResult[] a, TestResult[] b) {
    TestResult[] merged = new TestResult[a.Length + b.Length];
    for (int i = 0; i < a.Length; i = i + 1) { merged[i] = a[i]; }
    for (int i = 0; i < b.Length; i = i + 1) { merged[a.Length + i] = b[i]; }
    return merged;
}

// Strip trailing newlines only (mirror the host golden runner's
// _stripTrailingNewlines — NOT a full trim, so trailing spaces still matter).
string _stripNl(string s) {
    int e = s.Length;
    while (e > 0) {
        string ch = s.Substring(e - 1, 1);
        if (ch == "\n" || ch == "\r") { e = e - 1; } else { break; }
    }
    return s.Substring(0, e);
}

// First line (for a compact mismatch reason).
string _oneLine(string s) {
    int nl = s.IndexOf("\n");
    string head = (nl >= 0) ? s.Substring(0, nl) : s;
    if (head.Length > 80) { head = head.Substring(0, 80) + "…"; }
    return head;
}
