// z42 test-agent (add-embedded-app-run, 2026-08-02).
//
// The SINGLE, platform-independent on-device test runner. Packaged as an
// app.zpkg and embedded (via z42-host::run_app → z42::app::run) into every
// platform's test host (desktop self-contained / wasm / iOS / android). Because
// it is z42 bytecode, ALL platforms run the exact same runner — no per-language
// re-implementation (retires the 4× R1–R7 native drivers).
//
// It is a thin front for Std.Test.Runner.RunModule: receive a command (which
// test module + output format), run it, emit the structured report. z42b is the
// BUILD tool; this is the RUN tool — same Runner, different host.
//
// Command (one-shot, via forwarded `-- <args>`):
//   <target-zbc-path> [format]      format = "json" (default) | "pretty" | "tap"
// The report (json → one JSON object) goes to stdout; the harness captures it.
// A future persistent-agent form will accept commands on a live channel.
namespace Z42.TestHost.Agent;

using Std;
using Std.IO;
using Std.Test;
using Std.Json;

void Main() {
    string[] args = Environment.GetCommandLineArgs();
    if (args.Length < 1) {
        ConsoleError.WriteLine("test-agent: usage: <target.zbc|manifest.json> [format=json|pretty|tap]");
        return;
    }
    string target = args[0];
    string format = "json";
    if (args.Length >= 2) { format = args[1]; }
    // A `.json` target = a test-bundle manifest → run ALL its cases, aggregating
    // into one report (wire-embedded-testhost G3). Otherwise a single module.
    if (target.EndsWith(".json")) {
        _runBundle(target);
    } else {
        // RunModule discovers [Test]/[Benchmark], runs them, renders `format`
        // (json → one JSON object on stdout). Its int return is a convenience;
        // the authoritative result is the emitted report the harness parses.
        Runner.RunModule(target, format);
    }
}

// Bundle mode: read manifest `{cases:[{name,zbc}]}` (zbc paths relative to the
// manifest dir), run each module via RunModuleResults, and emit ONE aggregate
// TestReport JSON. z42 has no jagged arrays → grow the result array manually.
void _runBundle(string manifestPath) {
    string dir = Path.GetDirectoryName(manifestPath);
    JsonValue m = JsonValue.Parse(File.ReadAllText(manifestPath));
    JsonValue cases = m.Get("cases");
    int n = cases.Count();
    TestResult[] all = new TestResult[0];
    for (int i = 0; i < n; i = i + 1) {
        string zbc = Path.Join(dir, cases.At(i).Get("zbc").AsString());
        TestResult[] rs = Runner.RunModuleResults(zbc);
        TestResult[] merged = new TestResult[all.Length + rs.Length];
        for (int a = 0; a < all.Length; a = a + 1) { merged[a] = all[a]; }
        for (int b = 0; b < rs.Length; b = b + 1) { merged[all.Length + b] = rs[b]; }
        all = merged;
    }
    Console.WriteLine(TestReport.toJson("bundle", all));
}
