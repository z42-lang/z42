// z42i —— z42 交互式 REPL 入口（add-z42-repl 阶段 3）。
//
// read-eval-print 循环：Std.Repl.ReadBlock 读括号平衡多行块 → `.` 元指令 or Script.Eval 求值 →
// 打印结果（null 抑制）。`-c "expr"` 单次求值后退出。求值引擎 = z42.scripting
// （编译每轮源 → 内存加载 → 反射调用；跨轮 var carry-forward）。
namespace Z42Interactive;

using Std;
using Std.IO;
using Std.Collections;
using Std.Scripting;
using Std.Repl;

void Main() {
    string[] argv = Environment.GetCommandLineArgs();
    int ci = _indexOf(argv, "-c");
    if (ci >= 0 && ci + 1 < argv.Length) {
        ScriptState s0 = Script.Create();
        EvalResult r0 = Script.Eval(s0, argv[ci + 1]);
        if (!r0.Success) { ConsoleError.WriteLine(r0.Error); Environment.Exit(1); }
        if (r0.HasValue && r0.Value != null) { Console.WriteLine(_fmt(r0.Value)); }
        return;
    }

    Console.WriteLine("z42 REPL — 输入 z42 代码即时求值；. 前缀为元指令（.help / .exit）。");
    ScriptState s = Script.Create();
    Repl.SetCompleter("Std.Scripting.replComplete");   // Tab → 作用域补全（会话变量 / 声明名）
    while (true) {
        Completer.SetActive(s);   // 每轮把当前会话交给补全器（.reset 会重建 s → 必须重设）
        string line = Repl.ReadBlock(">>> ", "... ");   // 括号平衡多行块（未闭合 (){}[] → 续读）
        if (line == null) { Console.WriteLine(""); break; }   // Ctrl-D / EOF
        string t = line.Trim();
        if (t.Length == 0) { continue; }
        if (t.StartsWith(".")) {
            if (t == ".exit" || t == ".quit") { break; }
            else if (t == ".help") { _help(); }
            else if (t == ".vars") { _vars(s); }
            else if (t == ".types") { _types(s); }
            else if (t == ".usings") { _usings(s); }
            else if (t.StartsWith(".using ")) { _addUsing(s, t); }   // 追加一个 using（注意在 .usings 之后判）
            else if (t == ".version") { Console.WriteLine(Script.FormatVersion()); }
            else if (t == ".clear") { _clear(); }
            else if (t == ".reset") {
                // 清空变量/using/声明，回到空白会话。保持 Counter 单调递增——VM 已加载的
                // Repl.R{N} 模块仍在进程内，归零会让新一轮 R1 与旧 R1 撞名，故承接旧计数继续往后。
                int keep = s.Counter;
                s = Script.Create();
                s.Counter = keep;
                Console.WriteLine("会话已重置（变量 / using / 声明已清空）。");
            }
            else { Console.WriteLine("unknown command '" + t + "'; try .help"); }
            continue;
        }
        EvalResult r = Script.Eval(s, line);
        if (!r.Success) { Console.Write(r.Error); }
        else if (r.HasValue && r.Value != null) { Console.WriteLine(_fmt(r.Value)); }
    }
}

string _fmt(object v) { return "" + v; }   // MVP：ToString via concat（null 已在调用点抑制）

int _indexOf(string[] a, string x) {
    int i = 0;
    while (i < a.Length) { if (a[i] == x) { return i; } i = i + 1; }
    return 0 - 1;
}

void _help() {
    Console.WriteLine("z42 REPL:");
    Console.WriteLine("  .help          显示帮助");
    Console.WriteLine("  .exit / .quit  退出（或 Ctrl-D）");
    Console.WriteLine("  .reset         清空会话（变量 / using / 声明）");
    Console.WriteLine("  .clear         清屏（不清会话状态）");
    Console.WriteLine("  .vars          列出会话变量");
    Console.WriteLine("  .types         列出会话内声明的类型");
    Console.WriteLine("  .usings        列出生效的 using");
    Console.WriteLine("  .using <ns>    追加一个 using <ns>;");
    Console.WriteLine("  .version       显示 zbc / zpkg 格式版本");
    Console.WriteLine("提示：未闭合的 (){}[] 会自动进入多行续读（... 提示符）；可定义 fn / class 并在后续轮使用。");
}

void _vars(ScriptState s) {
    // #34 后：List<string>.ToArray() 跨包正确返回 string[]（不再需 ScriptState 侧绕过访问器）。
    string[] vs = s.VarNames.ToArray();
    if (vs.Length == 0) { Console.WriteLine("  (无会话变量)"); return; }
    int i = 0;
    while (i < vs.Length) { Console.WriteLine("  " + vs[i]); i = i + 1; }
}

void _types(ScriptState s) {
    string[] ts = s.DeclTypeNames.ToArray();
    if (ts.Length == 0) { Console.WriteLine("  (无会话类型)"); return; }
    int i = 0;
    while (i < ts.Length) { Console.WriteLine("  " + ts[i]); i = i + 1; }
}

void _usings(ScriptState s) {
    string[] us = s.Usings.ToArray();
    int i = 0;
    while (i < us.Length) { Console.WriteLine("  using " + us[i] + ";"); i = i + 1; }
}

// .using <ns> —— 复用 Script.Eval 的 `using X;` 累积路径（含去重）。
void _addUsing(ScriptState s, string t) {
    string ns = t.Substring(7, t.Length - 7).Trim();   // ".using " 占 7 字符
    if (ns.Length == 0) { Console.WriteLine("用法: .using <namespace>"); return; }
    Script.Eval(s, "using " + ns + ";");
    Console.WriteLine("已添加 using " + ns + ";");
}

// .clear —— ANSI 清屏 + 光标归位。z42 词法器不支持 \x1b/\u 转义，故用 (char)27 构造 ESC。
// 非终端（管道/重定向）下跳过，避免污染输出。
void _clear() {
    if (!Console.IsTerminal()) { return; }
    char[] e = new char[1]; e[0] = (char)27;   // ESC；String.FromChars 是 char→string 的既定 idiom
    string esc = String.FromChars(e);
    Console.Write(esc + "[2J" + esc + "[H");
}
