// REPL 缩进感知键位策略测试（add-repl-indent-editing + add-repl-tab-grid-snap + add-repl-rbrace-floor）。
// 直接调纯函数 ReplEditing.KeyEdit——与 rustyline 键位回调 replKeyEdit 完全同一策略（Rust 侧 parse_action
// 只把 dedent/insert:/replace: 译成 redo-免疫的 Cmd，无判断）。动作串用 [..] 包裹渲染（尾随空格可见、
// 不被 trim）；[] = 空串（走该键默认行为）。
namespace ReplEditingTest;

using Std;
using Std.IO;
using Std.Repl;   // ReplEditing.KeyEdit（split-z42-repl：ReplEditing 迁 Std.Repl）

void Main() {
    // 退格（add-repl-rbrace-floor）：整行纯空白 + 光标行尾 + 缩进错位（col%4≠0）→ floor 到前制表位
    // （replace:<缩进>，错位一键归正）；对齐缩进（col%4==0）floor 恒等删一级 → 仍走 Dedent；光标在缩进
    // 中段 / 光标后有内容 → 也 Dedent、不碰光标后内容；非空白前缀 → 默认删 1 字符。
    Console.WriteLine("== backspace ==");
    _show("bs align4",  "backspace", "    ", 4);           // dedent（对齐）
    _show("bs align8",  "backspace", "        ", 8);       // dedent（对齐）
    _show("bs shallow2","backspace", "  ", 2);             // replace:（错位 col2 → floor 0）
    _show("bs mis6",    "backspace", "      ", 6);         // replace:（错位 col6 → floor 4）
    _show("bs nonspace","backspace", "  x", 3);            // default（有内容）
    _show("bs col0",    "backspace", "", 0);               // default
    _show("bs word",    "backspace", "ab", 2);             // default
    _show("bs multi",   "backspace", "foo(\n    ", 9);     // dedent（末行 4 空格，对齐）
    _show("bs midindent","backspace", "    ", 2);          // dedent（光标在缩进中段，非行尾）

    // Tab：全空白前缀 → grid-snap ceil 到下制表位，补 (next_stop - col) 空格（Insert，光标正确、
    // 零 kill-ring 污染）；有词 → 默认（补全）。这是本 change 的唯一新行为（升级 #253 的定量一级）。
    Console.WriteLine("== tab ==");
    _show("tab col0",  "tab", "", 0);                      // insert 4 (→4)
    _show("tab col2",  "tab", "  ", 2);                    // insert 2 (ceil 2→4，非 #253 的 →6)
    _show("tab align4","tab", "    ", 4);                  // insert 4 (→8)
    _show("tab col6",  "tab", "      ", 6);                // insert 2 (ceil 6→8)
    _show("tab col1",  "tab", " ", 1);                     // insert 3 (ceil 1→4)
    _show("tab word",  "tab", "  foo", 5);                 // default（补全）
    _show("tab word0", "tab", "foo", 3);                   // default
    _show("tab multi", "tab", "x(\n  ", 5);                // insert 2（末行 2 空格 ceil →4）

    // }（rbrace，add-repl-rbrace-floor）：整行纯空白 + 光标行尾 → dedent 一级后落 }（replace:<缩进>}，
    // 目标 = max(0, floorToStop(col)-4)）；col==0（无级可退）/ 光标非行尾 / 有内容 → 默认插入 }（[]）。
    Console.WriteLine("== rbrace ==");
    _show("rb align8", "rbrace", "        ", 8);            // replace:    }（8 → 4 + }）
    _show("rb align4", "rbrace", "    ", 4);                // replace:}（4 → 0 + }）
    _show("rb mis6",   "rbrace", "      ", 6);             // replace:}（floorToStop6=4，4-4=0 + }）
    _show("rb col0",   "rbrace", "", 0);                   // default（无级可退，插入 }）
    _show("rb nonspace","rbrace", "  x", 3);               // default（有内容，插入 }）
    _show("rb midws",  "rbrace", "        ", 4);           // default（光标缩进中段，非行尾）
    _show("rb multi",  "rbrace", "if (x) {\n        ", 17); // replace:    }（末行 8 → 4 + }）

    // Enter（add-repl-multiline-editing）：对**整块缓冲** line 判完整性。写完 → "accept"（提交；
    // Rust 侧再按光标是否在缓冲末尾兜底 accept_in_the_middle:false，故 KeyEdit 对完整块不看光标）；
    // 没写完 → "newline:"+续行缩进（按光标前文本未闭合括号层数，复用 Completeness.ContinuationIndent）。
    // 注：本用例编译需同包携 ReplEditing.z42 + Completeness.z42 副本 + z42c.syntax/z42c.core 依赖。
    Console.WriteLine("== enter ==");
    _show("en complete",       "enter", "1 + 1", 5);                      // accept
    _show("en complete-mid",   "enter", "1 + 1", 2);                      // accept（KeyEdit 不 gate 光标）
    _show("en open-brace",     "enter", "class C {", 9);                  // newline:4（depth1）
    _show("en open-paren",     "enter", "foo(", 4);                       // newline:4
    _show("en nested2",        "enter", "foo(\n    bar(", 13);           // newline:8（depth2）
    _show("en missing-operand","enter", "1 +", 3);                        // newline:（depth0，裸换行）
    _show("en complete-multi", "enter", "class C {\n    int x;\n}", 22); // accept
}

void _show(string label, string key, string line, int pos) {
    string r = ReplEditing.KeyEdit(key, line, pos);
    Console.WriteLine(label + " -> [" + r + "]");
}
