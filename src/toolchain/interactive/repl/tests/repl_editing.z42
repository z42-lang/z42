// REPL 缩进感知键位策略（z42.repl 的 ReplEditing.KeyEdit）。直接调纯函数 KeyEdit —— 与 rustyline 键位回调
// replKeyEdit 是同一策略（Rust 侧 parse_action 只把 dedent / insert: / replace: / newline: 译成 Cmd，不做判断）。
// 返回值：""= 走该键默认行为；"dedent"；"insert:<文本>"；"replace:<整行新缩进>"；"accept"；"newline:<续行缩进>"。
namespace ReplEditingTests;

using Std.Repl;

void expectEdit(string expected, string key, string line, int pos) {
    Assert.Equal(expected, ReplEditing.KeyEdit(key, line, pos));
}

// 退格：整行纯空白 + 光标行尾 + 缩进错位（col%4≠0）→ floor 到前一个制表位（replace:<缩进>）；对齐缩进
// （col%4==0）删一级 → dedent；光标在缩进中段 / 光标后有内容 → 也 dedent；非空白前缀 → 默认删 1 字符。
[Test]
void test_backspace() {
    expectEdit("dedent",       "backspace", "    ", 4);   // bs align4：dedent（对齐）
    expectEdit("dedent",       "backspace", "        ", 8);   // bs align8：dedent（对齐）
    expectEdit("replace:",     "backspace", "  ", 2);   // bs shallow2：replace:（错位 col2 → floor 0）
    expectEdit("replace:    ", "backspace", "      ", 6);   // bs mis6：replace:（错位 col6 → floor 4）
    expectEdit("",             "backspace", "  x", 3);   // bs nonspace：default（有内容）
    expectEdit("",             "backspace", "", 0);   // bs col0：default
    expectEdit("",             "backspace", "ab", 2);   // bs word：default
    expectEdit("dedent",       "backspace", "foo(\n    ", 9);   // bs multi：dedent（末行 4 空格，对齐）
    expectEdit("dedent",       "backspace", "    ", 2);   // bs midindent：dedent（光标在缩进中段，非行尾）
}

// Tab：全空白前缀 → ceil 到下一个制表位，补 (next_stop - col) 个空格（insert:）；有词 → 默认（补全）。
[Test]
void test_tab() {
    expectEdit("insert:    ", "tab", "", 0);   // tab col0：insert 4 (→4)
    expectEdit("insert:  ",   "tab", "  ", 2);   // tab col2：insert 2 (ceil 2→4)
    expectEdit("insert:    ", "tab", "    ", 4);   // tab align4：insert 4 (→8)
    expectEdit("insert:  ",   "tab", "      ", 6);   // tab col6：insert 2 (ceil 6→8)
    expectEdit("insert:   ",  "tab", " ", 1);   // tab col1：insert 3 (ceil 1→4)
    expectEdit("",            "tab", "  foo", 5);   // tab word：default（补全）
    expectEdit("",            "tab", "foo", 3);   // tab word0：default
    expectEdit("insert:  ",   "tab", "x(\n  ", 5);   // tab multi：insert 2（末行 2 空格 ceil →4）
}

// }：整行纯空白 + 光标行尾 → 退一级后落 }（replace:<缩进>}，目标 = max(0, floorToStop(col) - 4)）；
// col==0（无级可退）/ 光标非行尾 / 有内容 → 默认插入 }。
[Test]
void test_rbrace() {
    expectEdit("replace:    }", "rbrace", "        ", 8);   // rb align8：replace:    }（8 → 4 + }）
    expectEdit("replace:}",     "rbrace", "    ", 4);   // rb align4：replace:}（4 → 0 + }）
    expectEdit("replace:}",     "rbrace", "      ", 6);   // rb mis6：replace:}（floorToStop6=4，4-4=0 + }）
    expectEdit("",              "rbrace", "", 0);   // rb col0：default（无级可退，插入 }）
    expectEdit("",              "rbrace", "  x", 3);   // rb nonspace：default（有内容，插入 }）
    expectEdit("",              "rbrace", "        ", 4);   // rb midws：default（光标缩进中段，非行尾）
    expectEdit("replace:    }", "rbrace", "if (x) {\n        ", 17);   // rb multi：replace:    }（末行 8 → 4 + }）
}

// Enter：对整块缓冲判完整性。写完 → accept（KeyEdit 不看光标，光标是否在末尾由 Rust 侧兜底）；没写完 →
// newline:<续行缩进>，按光标前未闭合括号层数（Completeness.ContinuationIndent）。
[Test]
void test_enter() {
    expectEdit("accept",           "enter", "1 + 1", 5);   // en complete：accept
    expectEdit("accept",           "enter", "1 + 1", 2);   // en complete-mid：accept（KeyEdit 不 gate 光标）
    expectEdit("newline:    ",     "enter", "class C {", 9);   // en open-brace：newline:4（depth1）
    expectEdit("newline:    ",     "enter", "foo(", 4);   // en open-paren：newline:4
    expectEdit("newline:        ", "enter", "foo(\n    bar(", 13);   // en nested2：newline:8（depth2）
    expectEdit("newline:",         "enter", "1 +", 3);   // en missing-operand：newline:（depth0，裸换行）
    expectEdit("accept",           "enter", "class C {\n    int x;\n}", 22);   // en complete-multi：accept
}
