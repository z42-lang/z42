// z42d CLI 路由 —— Std.Cli 嵌套 router（对照 builder_cli.z42 / launcher_cli.z42）。
//
// 已实现：doc / symbolicate / install。fmt / dbg / prof / lint 只登记了命令面，dispatch 打 "planned"，
// 引擎按 roadmap 分期落地。
namespace Z42Devtools;

using Std.IO;
using Std.Cli;

// exe 入口。standalone（`z42vm z42.devtools.zbc -- <verb> ...`）与 launcher 透传
// （`z42 <verb> ...`）都经 Environment.GetCommandLineArgs() 拿到动词起的 argv。
void Main() {
    Environment.Exit(_runDevtools(Environment.GetCommandLineArgs()));
}

// 入口：launcher 透传的 argv（已去掉 `z42` 前缀的动词起）。
int _runDevtools(string[] argv) {
    if (argv.Length == 0) { Console.WriteLine(_devtoolsRoot().HelpText()); return 0; }

    SubcommandRouter root = _devtoolsRoot();
    CommandResolution res;
    try { res = root.Resolve(argv); }
    catch (CliException e) {
        ConsoleError.WriteLine("z42d: " + e.Message);
        return 2;
    }
    if (res.IsHelp())    { Console.WriteLine(res.HelpText()); return 0; }
    if (res.IsUnknown()) { ConsoleError.WriteLine(res.ErrorMessage()); return 2; }
    return _dispatchDevtools(res);
}

SubcommandRouter _devtoolsRoot() {
    SubcommandRouter root = new SubcommandRouter("z42d", "z42 developer toolchain");

    // fmt — code formatter（planned；roadmap 0.2.4 → 0.4.x，原独立 z42-fmt 收编于此）。
    ArgParser fmt = new ArgParser("z42d fmt", "format z42 source (planned)");
    fmt.AddOptionalPositional("path", "file or directory (default: current dir)");
    root.Add("fmt", "format z42 source files", fmt);

    // doc — 符号查询：签名、doc 注释、file:line（引擎在 z42.doc）。
    ArgParser doc = new ArgParser("z42d doc", "look up a symbol: signature, doc comment and file:line");
    doc.AddOptionalPositional("symbol", "Doc ID, qualified-name suffix (Random.NextIntRange) or short name");
    doc.AddFlag("members", "m", "outline a type or namespace: one line per member");
    doc.AddOption("search", "s", "search names and summaries instead of resolving a symbol", "");
    doc.AddFlag("private", "", "include private members in outlines and search results");
    doc.AddOption("pkg", "", "only index this package", "");
    doc.AddOption("root", "", "index root (default: enclosing git repository, else nearest project)", "");
    doc.AddFlag("json", "", "print matching entries as JSON");
    doc.AddOption("format", "", "render markdown instead of querying (mdbook)", "");
    doc.AddOption("out", "", "output directory for --format", "");
    doc.AddOption("page", "", "resolve the code references in a book page (markdown) to file:line", "");
    doc.AddOption("docs", "", "reverse lookup: which book pages / READMEs reference this symbol", "");
    root.Add("doc", "look up symbols and their documentation", doc);

    // dbg — debugger（planned；前端在本目录 + VM 断点/单步钩子住 runtime/，DAP 0.8.x）。
    ArgParser dbg = new ArgParser("z42d dbg", "debug a z42 program (planned)");
    dbg.AddOptionalPositional("target", "<app.zpkg> | <project.z42.toml>");
    root.Add("dbg", "debug a z42 program (breakpoints/step)", dbg);

    // prof — profiler front-end（planned；roadmap 0.4.4 Pv4/Pc4 profiling 门控）。
    ArgParser prof = new ArgParser("z42d prof", "profile a z42 program (planned)");
    prof.AddOptionalPositional("target", "<app.zpkg> | <project.z42.toml>");
    root.Add("prof", "profile runtime / compile performance", prof);

    // lint — static analysis（planned；roadmap 0.7.x，原独立 z42-lint）。
    ArgParser lint = new ArgParser("z42d lint", "static analysis / lint (planned)");
    lint.AddOptionalPositional("project", "<project.z42.toml>");
    root.Add("lint", "static analysis", lint);

    // symbolicate — offline stack-trace symbolication (add-offline-symbolication).
    // Reads a release-stripped crash trace (`at <fn> +0x<off>`) + archived `.zsym`
    // symbols (repeatable `--syms <file|dir>`, dirs searched recursively — cf.
    // Breakpad symbol path / `addr2line -e`) → rewrites frames to file:line:col.
    ArgParser sym = new ArgParser("z42d symbolicate", "offline-symbolicate a stripped crash trace using .zsym symbols");
    sym.AddPositional("trace", "crash-trace file (`at <fn> +0x<off>` frames)");
    sym.AddRepeatedOption("syms", "s", "path to a .zsym file or a directory of .zsym (repeatable; dirs searched recursively)");
    root.Add("symbolicate", "resolve a stripped crash trace via .zsym symbols", sym);

    // install — 把 SDK 自带的编辑器集成资产装进用户的编辑器（unify-editor-install）。
    // 资产随 SDK 分发（<sdk>/editors/<target>/），所以装了 SDK 就能用，不需要仓库。
    ArgParser inst = new ArgParser("z42d install", "install editor integration from this SDK");
    inst.AddPositional("target", "editor to set up (vscode)");
    root.Add("install", "install editor integration (vscode)", inst);

    return root;
}

// ── dispatch ──────────────────────────────────────────────────────────────

int _dispatchDevtools(CommandResolution res) {
    string[] p = res.Path();
    if (p.Length == 0) { return 0; }
    string top = p[0];
    // symbolicate — first real z42d subcommand (add-offline-symbolication).
    if (top == "symbolicate") {
        ParseResult pr = res.Result();
        string trace = pr.GetPositional(0);
        string[] syms = pr.GetRepeatedOption("syms");
        return Symbolicate.Run(trace, syms, syms.Length);
    }
    if (top == "doc") { return DocCommand.Run(res.Result()); }
    // install — 编辑器集成（unify-editor-install）。
    if (top == "install") {
        return EditorInstall.Run(res.Result().GetPositional(0));
    }
    // scaffold：其余子命令尚未实现，统一报 planned。各工具实现期替换为真实处理。
    ConsoleError.WriteLine("z42d " + top + ": planned — not yet implemented "
        + "(developer toolchain scaffold; see src/toolchain/devtools/README.md)");
    return 1;
}
