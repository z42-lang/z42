// z42 launcher core (add-z42-launcher, 2026-06-02).
//
// All launcher logic lives here in z42 ("z42-first"); only the tiny native
// trampoline (../src) stays Rust. Run by the bundled launcher runtime via:
//     z42vm launcher.zpkg -- <user argv>
// so GetCommandLineArgs() returns exactly the user's argv (phase 0).
//
// P1 commands (local, no network): run / link / list / default / which / info.
// Layout managed under $Z42_HOME (default ~/.z42):
//     runtimes/<ver>/        a runtime: contains z42vm (+ libs/), OR a
//                            link.txt redirect to a dir that does.
//     config.toml            `default = "<ver>"`

namespace Z42Launcher;

using Std;
using Std.IO;
using Std.Toml;
using Std.Cli;
using Z42.Build.Project;   // ManifestLoader / ProjectManifest / ExeTarget — `z42 run <dir>` (P4)

// migrate-xtask-launcher-to-std-cli (2026-06-10): Main delegates to the Std.Cli
// nested router in launcher_cli.z42 (_runLauncher). The command tree, per-level
// `-h` help, and unknown-command errors live there; the apphost shorthand
// (`z42 app.zpkg`) and `run` passthrough are handled before Resolve. Handlers
// below read their args from a Std.Cli ParseResult (except _cmdRun, raw).
void Main() {
    _runLauncher(Environment.GetCommandLineArgs());
}

// ── layout helpers ──────────────────────────────────────────────────────────

string _home() {
    // z42 has no flow-narrowing for `string?`; coerce via `??` then check.
    string h = Environment.GetEnvironmentVariable("Z42_HOME") ?? "";
    if (h.Length > 0) { return h; }
    // Portable install: Z42_PORTABLE_VM = <sdk>/bin/z42vm → home = <sdk>/.
    string portableVm = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM") ?? "";
    if (portableVm.Length > 0) {
        string binDir = Path.GetDirectoryName(portableVm);
        if (binDir.Length > 0) {
            string pkgRoot = Path.GetDirectoryName(binDir);
            if (pkgRoot.Length > 0) { return pkgRoot; }
            return binDir;
        }
    }
    string home = Environment.GetEnvironmentVariable("HOME") ?? "";
    if (home.Length > 0) { return Path.Join(home, ".z42"); }
    return ".z42";
}

string _runtimesDir() { return Path.Join(_home(), "runtimes"); }
string _configPath()  { return Path.Join(_home(), "config.toml"); }

// Versions = subdirectory names under runtimes/.
string[] _installedVersions() {
    string dir = _runtimesDir();
    if (!Directory.Exists(dir)) { return new string[0]; }
    string[] entries = Directory.Enumerate(dir);
    string[] names = new string[entries.Length];
    int n = 0;
    int i = 0;
    while (i < entries.Length) {
        string leaf = Path.GetFileName(entries[i]);
        if (leaf.Length > 0) { names[n] = leaf; n = n + 1; }
        i = i + 1;
    }
    return _trimArr(names, n);
}

// Resolve a version's runtime directory: a `link.txt` redirect wins, else
// the runtimes/<ver>/ directory itself. Returns null if not installed.
string? _runtimeDir(string ver) {
    string baseDir = Path.Join(_runtimesDir(), ver);
    string link = Path.Join(baseDir, "link.txt");
    if (File.Exists(link)) {
        return File.ReadAllText(link).Trim();
    }
    if (Directory.Exists(baseDir)) { return baseDir; }
    return null;
}

// z42vm binary inside a runtime dir: <dir>/z42vm or <dir>/bin/z42vm.
// Windows binaries carry a .exe suffix (the native trampoline + launcher-env.sh
// both bundle z42vm.exe) — match it here too, else `z42 link`/`run`/`which`
// can't find the VM on Windows. (fix CI: regen-golden Windows step.)
string? _vmPath(string dir) {
    string vmname = Platform.IsWindows() ? "z42vm.exe" : "z42vm";
    string direct = Path.Join(dir, vmname);
    if (File.Exists(direct)) { return direct; }
    string nested = Path.Join(Path.Join(dir, "bin"), vmname);
    if (File.Exists(nested)) { return nested; }
    return null;
}

// stdlib libs dir inside a runtime dir, if present.
string? _libsPath(string dir) {
    string libs = Path.Join(dir, "libs");
    if (Directory.Exists(libs)) { return libs; }
    return null;
}

// ── config (default version) ────────────────────────────────────────────────

string? _defaultVersion() {
    string p = _configPath();
    if (!File.Exists(p)) { return null; }
    // `default = "<ver>"` — parsed via Std.Toml (was a hand-rolled quote scan;
    // unify-run-modes P1 folds it onto the one TOML parser).
    TomlValue t = TomlValue.Parse(File.ReadAllText(p));
    if (t.IsTable() && t.ContainsKey("default")) {
        TomlValue v = t.Get("default");
        if (v.IsString()) { return v.AsString(); }
    }
    return null;
}

void _setDefaultVersion(string ver) {
    Directory.Create(_home());
    File.WriteAllText(_configPath(), "default = \"" + ver + "\"\n");
}

// ── version resolution (run path) ────────────────────────────────────────────
// Order: explicit --runtime  >  default  >  sole installed  >  error.

string _resolveVersion(string? explicitVer) {
    string ev = explicitVer ?? "";
    if (ev.Length > 0) { return ev; }
    string def = _defaultVersion() ?? "";
    if (def.Length > 0) { return def; }
    string[] installed = _installedVersions();
    if (installed.Length == 1) { return installed[0]; }
    if (installed.Length == 0) {
        ConsoleError.WriteLine("z42: no runtime installed. `z42 link <dir> --as <ver>` first.");
    } else {
        ConsoleError.WriteLine("z42: multiple runtimes installed; pass --runtime <ver> or `z42 default <ver>`.");
    }
    Environment.Exit(2);
    return "";
}

// ── commands ──────────────────────────────────────────────────────────────

void _cmdInfo() {
    Console.WriteLine("Z42_HOME:  " + _home());
    Console.WriteLine("runtimes:  " + _runtimesDir());
    Console.WriteLine("default:   " + (_defaultVersion() ?? "(none)"));
    string[] vs = _installedVersions();
    Console.WriteLine("installed: " + vs.Length.ToString());
    // bundle-launcher-in-release: portable packages run apps with a bundled
    // runtime (no ~/.z42 install).
    string portableVm = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM") ?? "";
    if (portableVm.Length > 0) {
        Console.WriteLine("portable:  " + portableVm);
    }
}

void _cmdList(ParseResult r) {
    string[] vs = _installedVersions();
    if (vs.Length == 0) { Console.WriteLine("(no runtimes installed)"); }
    else {
        string def = _defaultVersion() ?? "";
        int i = 0;
        while (i < vs.Length) {
            string mark = (def == vs[i]) ? " (default)" : "";
            Console.WriteLine(vs[i] + mark);
            i = i + 1;
        }
    }
    // --workloads: also list installed platform workloads (shared with `workload list`).
    if (r.GetFlag("workloads")) {
        Console.WriteLine("");
        Console.WriteLine("workloads:");
        if (!_listInstalledWorkloads()) { Console.WriteLine("(no workloads installed)"); }
    }
}

void _cmdDefault(ParseResult r) {
    string ver = r.GetPositional(0);
    if (ver.Length == 0) {
        Console.WriteLine(_defaultVersion() ?? "(none)");
        return;
    }
    if (_runtimeDir(ver) == null) {
        ConsoleError.WriteLine("z42: runtime `" + ver + "` not installed (see `z42 list`).");
        Environment.Exit(2);
        return;
    }
    _setDefaultVersion(ver);
    Console.WriteLine("default → " + ver);
}

// z42 link <dir> --as <ver>
void _cmdLink(ParseResult r) {
    string dir = r.GetPositional(0);
    string ver = r.GetOption("as");
    if (dir.Length == 0 || ver.Length == 0) {
        ConsoleError.WriteLine("usage: z42 link <runtime-dir> --as <ver>");
        Environment.Exit(2);
        return;
    }
    if (_vmPath(dir) == null) {
        ConsoleError.WriteLine("z42: no z42vm found under `" + dir + "` (expected <dir>/z42vm or <dir>/bin/z42vm).");
        Environment.Exit(2);
        return;
    }
    string baseDir = Path.Join(_runtimesDir(), ver);
    Directory.Create(baseDir);
    File.WriteAllText(Path.Join(baseDir, "link.txt"), dir);
    Console.WriteLine("linked `" + ver + "` → " + dir);
}

void _cmdWhich(ParseResult r) {
    string verOpt = r.GetOption("runtime");
    string? ver = verOpt.Length > 0 ? verOpt : null;
    string portableVm = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM") ?? "";
    if (portableVm.Length > 0 && (ver ?? "").Length == 0) {
        Console.WriteLine(portableVm);
        return;
    }
    string resolved = _resolveVersion(ver);
    string? dirOpt = _runtimeDir(resolved);
    if (dirOpt == null) {
        ConsoleError.WriteLine("z42: runtime `" + resolved + "` not installed.");
        Environment.Exit(2);
        return;
    }
    string dir = dirOpt ?? "";
    Console.WriteLine(_vmPath(dir) ?? ("(z42vm missing in " + dir + ")"));
}

// z42 run [--runtime V] <app.zpkg> [-- <app args>]
void _cmdRun(string[] rest) {
    string? ver = _flagValue(rest, "--runtime");
    string? binOpt = _flagValue(rest, "--bin");   // (P4) select an [[exe]] target
    string app = "";
    string[] appArgs = new string[0];
    int i = 0;
    while (i < rest.Length) {
        string a = rest[i];
        if (a == "--runtime") { i = i + 2; continue; }   // skip flag + value
        if (a == "--bin") { i = i + 2; continue; }        // skip flag + value (P4)
        if (a == "--") { appArgs = _tail(rest, i + 1); break; }
        if (app.Length == 0) { app = a; }
        i = i + 1;
    }
    if (app.Length == 0) {
        ConsoleError.WriteLine("usage: z42 run [--runtime <ver>] [--bin <name>] <app.zpkg | project-dir | project.z42.toml> [-- <args>]");
        Environment.Exit(2);
        return;
    }

    // (unify-run-modes P4) source-project run: if `app` is a directory or a
    // *.z42.toml manifest (not a compiled .zpkg/.zbc), build it via z42c then run
    // the produced zpkg. `--bin <name>` picks among multiple [[exe]] targets.
    // On any error the helper prints the message; we exit non-zero.
    if (_isSourceProject(app)) {
        string built = _buildAndResolveRun(app, binOpt ?? "");
        if (built.Length == 0) { Environment.Exit(1); return; }
        app = built;
    }

    // <app>.runtimeconfig.toml (unify-run-modes P1; was .json) declares the
    // runtime version pin (top-level `version`, launcher-consumed) and a
    // `[runtime]` knob table (gc-mode / log / ... — consumed by z42vm itself
    // via Z42_CONFIG, see below; replaces the old configProperties→env inject).
    string rcPath = _runtimeConfigPath(app);
    bool hasCfg = File.Exists(rcPath);
    TomlValue cfg = TomlValue.OfTable();
    if (hasCfg) { cfg = TomlValue.Parse(File.ReadAllText(rcPath)); }
    // Effective version: --runtime > runtimeconfig `version`.
    string effVer = ver ?? "";
    if (effVer.Length == 0 && hasCfg && cfg.IsTable() && cfg.ContainsKey("version")) {
        TomlValue vv = cfg.Get("version");
        if (vv.IsString()) { effVer = vv.AsString(); }
    }

    // Portable mode (bundle-launcher-in-release): the trampoline set
    // Z42_PORTABLE_VM/_LIBS to the package's own bundled runtime. Use it
    // directly when no version was pinned (flag or runtimeconfig).
    string portableVm = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM") ?? "";
    string vm = "";
    string libs = "";
    if (portableVm.Length > 0 && effVer.Length == 0) {
        vm = portableVm;
        libs = Environment.GetEnvironmentVariable("Z42_PORTABLE_LIBS") ?? "";
    } else {
        string resolved = _resolveVersion(effVer);
        string? dirOpt = _runtimeDir(resolved);
        if (dirOpt == null) {
            ConsoleError.WriteLine("z42: runtime `" + resolved + "` not installed (see `z42 list`).");
            Environment.Exit(2);
            return;
        }
        string dir = dirOpt ?? "";
        string? vmOpt = _vmPath(dir);
        if (vmOpt == null) {
            ConsoleError.WriteLine("z42: z42vm missing in runtime `" + resolved + "` (" + dir + ").");
            Environment.Exit(2);
            return;
        }
        vm = vmOpt ?? "";
        libs = _libsPath(dir) ?? "";
    }

    Process proc = new Process(vm)
        .Arg(app)
        .Stdin(Stdio.Inherit())
        .Stdout(Stdio.Inherit())
        .Stderr(Stdio.Inherit());
    if (libs.Length > 0) { proc = proc.Env("Z42_LIBS", libs); }
    // Point z42vm at the sidecar so it resolves the `[runtime]` knob table
    // itself (unify-run-modes P1 — replaces the old configProperties→env
    // injection with VM-side [runtime] resolution, P0). Respect an explicit
    // user Z42_CONFIG (env wins over the sidecar pointer).
    if (hasCfg) {
        string existingCfg = Environment.GetEnvironmentVariable("Z42_CONFIG") ?? "";
        if (existingCfg.Length == 0) { proc = proc.Env("Z42_CONFIG", rcPath); }
    }
    // Forward the program's own args after `--`.
    if (appArgs.Length > 0) {
        proc = proc.Arg("--");
        int j = 0;
        while (j < appArgs.Length) { proc = proc.Arg(appArgs[j]); j = j + 1; }
    }
    ProcessResult r = proc.Run();
    Environment.Exit(r.ExitCode);
}


void _cmdUninstall(ParseResult r) {
    string ver = r.GetPositional(0);
    if (ver.Length == 0) {
        ConsoleError.WriteLine("usage: z42 uninstall <version>");
        Environment.Exit(2);
        return;
    }
    string dir = Path.Join(_runtimesDir(), ver);
    if (!Directory.Exists(dir)) {
        ConsoleError.WriteLine("z42: `" + ver + "` not installed.");
        Environment.Exit(2);
        return;
    }
    Directory.Delete(dir, true);
    Console.WriteLine("uninstalled " + ver);
}

// Help is generated by the Std.Cli router (launcher_cli.z42 :: _launcherRoot);
// the former hand-written _help() is removed.
// Network commands (_cmdInstall / _cmdSelfUpdate) and their helpers live in
// launcher_network.z42 (split to stay within the 500-line file limit).

// ── small array/flag utils ───────────────────────────────────────────────────

string[] _tail(string[] arr, int start) {
    if (start >= arr.Length) { return new string[0]; }
    int n = arr.Length - start;
    string[] outArr = new string[n];
    int j = 0;
    while (j < n) { outArr[j] = arr[start + j]; j = j + 1; }
    return outArr;
}

string[] _trimArr(string[] arr, int n) {
    string[] outArr = new string[n];
    int j = 0;
    while (j < n) { outArr[j] = arr[j]; j = j + 1; }
    return outArr;
}

string? _flagValue(string[] arr, string flag) {
    int i = 0;
    while (i < arr.Length) {
        if (arr[i] == flag && i + 1 < arr.Length) { return arr[i + 1]; }
        i = i + 1;
    }
    return null;
}

// ── source-project run (unify-run-modes P4) ──────────────────────────────────

// A run target that is *source to build*, not a compiled artifact: a directory,
// or a manifest file — both `z42.toml` (Cargo-style) and `<name>.z42.toml` are
// accepted. `.zpkg`/`.zbc` are compiled → run directly.
bool _isSourceProject(string app) {
    if (app.EndsWith(".zpkg") || app.EndsWith(".zbc")) { return false; }
    if (app.EndsWith("z42.toml")) { return true; }   // z42.toml or <name>.z42.toml
    return Directory.Exists(app);
}

// Build the source project (via z42c) then resolve the zpkg to run:
//   - no `[[exe]]`      → the single `dist/<project.name>.zpkg`
//   - `[[exe]]` + --bin → `dist/<bin>.zpkg` (validated against declared targets)
//   - `[[exe]]`, no --bin → error listing the targets (no default-run yet — P3
//     首切边界，default-run 占 stdlib 锁后置)
// Returns "" (after printing an error) on any failure.
// 首切边界：默认 dist（`<projDir>/dist`）；`[build].dist_dir` 覆盖 + workspace/本地依赖
// 拓扑构建后置。
string _buildAndResolveRun(string app, string binName) {
    // `app` may be a manifest file (`z42.toml` / `<name>.z42.toml`) or a directory.
    string manifest = app.EndsWith("z42.toml") ? app : _findProjectToml(app);
    if (manifest.Length == 0) {
        ConsoleError.WriteLine("z42 run: no z42.toml / <name>.z42.toml manifest found in " + app);
        return "";
    }
    // Build via z42c. Its progress ("wrote -> …") goes to stdout — route it to
    // null so it does NOT pollute the program's own stdout (cargo-run-like: build
    // noise stays off the program's output stream). Errors go to stderr (Inherit).
    string z42c = Path.Join(_home(), "bin/z42c");
    if (!File.Exists(z42c)) { z42c = z42c + ".exe"; }
    if (!File.Exists(z42c)) {
        ConsoleError.WriteLine("z42 run: z42c not found (SDK bin/z42c) — reinstall the SDK");
        return "";
    }
    int bc = new Process(z42c).Arg("build").Arg(manifest)
        .Stdin(Stdio.Inherit()).Stdout(Stdio.Null()).Stderr(Stdio.Inherit())
        .Run().ExitCode;
    if (bc != 0) {
        ConsoleError.WriteLine("z42 run: build failed (" + manifest + ")");
        return "";
    }

    ProjectManifest pm = ManifestLoader.Load(manifest);
    string projDir = Path.GetDirectoryName(manifest);
    string distDir = Path.Join(projDir, "dist");

    if (pm.ExeCount == 0) {
        string single = Path.Join(distDir, pm.Project.Name + ".zpkg");
        if (!File.Exists(single)) {
            ConsoleError.WriteLine("z42 run: build produced no " + single);
            return "";
        }
        return single;
    }
    // multi-exe: must pick one.
    if (binName.Length == 0) {
        ConsoleError.WriteLine("z42 run: project declares multiple [[exe]] targets; select one with --bin <name>:");
        _listExes(pm);
        return "";
    }
    bool found = false;
    int j = 0;
    while (j < pm.ExeCount) { if (pm.Exes[j].Name == binName) { found = true; } j = j + 1; }
    if (!found) {
        ConsoleError.WriteLine("z42 run: --bin " + binName + " is not a declared [[exe]] target; valid:");
        _listExes(pm);
        return "";
    }
    string binZpkg = Path.Join(distDir, binName + ".zpkg");
    if (!File.Exists(binZpkg)) {
        ConsoleError.WriteLine("z42 run: build produced no " + binZpkg);
        return "";
    }
    return binZpkg;
}

void _listExes(ProjectManifest pm) {
    int i = 0;
    while (i < pm.ExeCount) { ConsoleError.WriteLine("    - " + pm.Exes[i].Name); i = i + 1; }
}

// The manifest directly in `dir` (source-project run target). Prefers a bare
// `dir/z42.toml` (Cargo-style, as most fixtures/projects use), else the top-level
// `*.z42.toml`. "" if none.
string _findProjectToml(string dir) {
    string bare = Path.Join(dir, "z42.toml");
    if (File.Exists(bare)) { return bare; }
    string[] tomls = Path.GlobRecursive(dir, "*.z42.toml");
    if (tomls.Length == 0) { return ""; }
    int i = 0;
    while (i < tomls.Length) {
        if (Path.GetDirectoryName(tomls[i]) == dir) { return tomls[i]; }
        i = i + 1;
    }
    return tomls[0];
}

// `<dir>/<name>.runtimeconfig.toml` next to the app (.NET-style sidecar;
// unify-run-modes P1 migrated the format JSON→TOML).
string _runtimeConfigPath(string app) {
    string dir = Path.GetDirectoryName(app);
    string fname = Path.GetFileNameWithoutExtension(app) + ".runtimeconfig.toml";
    return dir.Length > 0 ? Path.Join(dir, fname) : fname;
}
