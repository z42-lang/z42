// z42 launcher core —— `z42` 命令（SDK 根目录下的 apphost 以同址 bin/z42vm 运行本程序）。
//
// 命令面与路由在 launcher_cli.z42；本文件放 SDK 布局解析、`run`、`version`。
// SDK 布局（见 docs/design/runtime/launcher.md）：
//     z42                     本程序的 apphost
//     bin/{z42vm,z42c,...}    运行时与工具
//     programs/<tool>/        各工具的 zpkg
//     libs/                   标准库
//     manifest.toml           [package] version / rid / build-date
//     runtimes/<ver>/workloads/<wl>/   已安装的 workload（z42 workload install）

namespace Z42Launcher;

using Std;
using Std.IO;
using Std.Toml;
using Std.Cli;
using Std.Crypto;          // Sha256 —— 单文件运行的缓存目录按源路径取哈希
using Z42.Build.Project;   // ManifestLocator / ManifestLoader / BuildLayout —— `z42 run <工程>`

void Main() {
    _runLauncher(Environment.GetCommandLineArgs());
}

// ── SDK 布局 ────────────────────────────────────────────────────────────────

// SDK 根目录：Z42_HOME > apphost 注入的 Z42_PORTABLE_VM（<sdk>/bin/z42vm）反推 > ~/.z42。
string _home() {
    string h = Environment.GetEnvironmentVariable("Z42_HOME") ?? "";
    if (h.Length > 0) { return h; }
    string portableVm = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM") ?? "";
    if (portableVm.Length > 0) {
        string binDir = Path.GetDirectoryName(portableVm);
        if (binDir.Length > 0) {
            string pkgRoot = Path.GetDirectoryName(binDir);
            if (pkgRoot.Length > 0) { return pkgRoot; }
            return binDir;
        }
    }
    string home = Environment.GetEnvironmentVariable("HOME") ?? "";
    if (home.Length == 0) { home = Environment.GetEnvironmentVariable("USERPROFILE") ?? ""; }
    if (home.Length > 0) { return Path.Join(home, ".z42"); }
    return ".z42";
}

// SDK 自带的 z42vm 与标准库目录（apphost 已注入时直接用注入值）。
string _sdkVm() {
    string vm = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM") ?? "";
    if (vm.Length > 0) { return vm; }
    return _sdkBin("z42vm");
}

string _sdkLibs() {
    string libs = Environment.GetEnvironmentVariable("Z42_PORTABLE_LIBS") ?? "";
    if (libs.Length > 0) { return libs; }
    return Path.Join(_home(), "libs");
}

// <sdk>/bin/<name>（Windows 带 .exe）。
string _sdkBin(string name) {
    string p = Path.Join(Path.Join(_home(), "bin"), name);
    if (Platform.IsWindows()) { return p + ".exe"; }
    return p;
}

string _runtimesDir() { return Path.Join(_home(), "runtimes"); }

// runtimes/ 下的版本目录名（workload 按版本安装在 runtimes/<ver>/workloads/）。
string[] _installedVersions() {
    string dir = _runtimesDir();
    if (!Directory.Exists(dir)) { return new string[0]; }
    string[] entries = Directory.Enumerate(dir);
    string[] names = new string[entries.Length];
    int n = 0;
    int i = 0;
    while (i < entries.Length) {
        string leaf = Path.GetFileName(entries[i]);
        if (leaf.Length > 0) { names[n] = leaf; n = n + 1; }
        i = i + 1;
    }
    return _trimArr(names, n);
}

// ── version ─────────────────────────────────────────────────────────────────

// `z42 --version` / `z42 -V` / `z42 version`：`z42 <version> (<rid>, <build-date>)`。
// 数据来自 SDK 的 manifest.toml；从源码树直接组装的 SDK 没有它 → `z42 (dev build)`。
void _cmdVersion() {
    string mf = Path.Join(_home(), "manifest.toml");
    if (!File.Exists(mf)) { Console.WriteLine("z42 (dev build)"); return; }
    TomlValue t = TomlValue.Parse(File.ReadAllText(mf));
    string ver = _tomlStr(t, "package", "version");
    string rid = _tomlStr(t, "package", "rid");
    string date = _tomlStr(t, "package", "build-date");
    if (date.Length > 10) { date = date.Substring(0, 10); }
    Console.WriteLine("z42 " + ver + " (" + rid + ", " + date + ")");
}

string _tomlStr(TomlValue root, string section, string key) {
    if (!root.IsTable() || !root.ContainsKey(section)) { return ""; }
    TomlValue s = root.Get(section);
    if (!s.IsTable() || !s.ContainsKey(key)) { return ""; }
    TomlValue v = s.Get(key);
    return v.IsString() ? v.AsString() : "";
}

// ── run ─────────────────────────────────────────────────────────────────────

void _printRunHelp() {
    Console.WriteLine("z42 run — build and run a project, or run a compiled app");
    Console.WriteLine("");
    Console.WriteLine("usage: z42 run [options] [<file.z42> | <project-dir> | <manifest> | <app.zpkg>] [-- <program args>]");
    Console.WriteLine("");
    Console.WriteLine("Without a target, the nearest z42.toml in the current directory or its parents is");
    Console.WriteLine("built (only what changed) and run.");
    Console.WriteLine("");
    Console.WriteLine("A single .z42 file is compiled and run directly — build artifacts go to the cache,");
    Console.WriteLine("nothing is written next to your source. A single file can only use the standard");
    Console.WriteLine("library; to declare dependencies, create a project with `z42 new`.");
    Console.WriteLine("");
    Console.WriteLine("options:");
    Console.WriteLine("  --bin <name>             pick one of the project's [[exe]] targets");
    Console.WriteLine("  --mode <interp|jit|aot>  execution mode");
    Console.WriteLine("  --config <file>          runtime config file");
    Console.WriteLine("  --set <key>=<value>      set a runtime setting for this run (repeatable)");
    Console.WriteLine("  -h, --help               show this help");
}

// z42 run [options] [<target>] [-- <program args>]
void _cmdRun(string[] rest) {
    string? binOpt = _flagValue(rest, "--bin");
    string? cfgOpt = _flagValue(rest, "--config");
    string? modeOpt = _flagValue(rest, "--mode");
    string app = "";
    string[] appArgs = new string[0];
    // `--set k=v` 可重复。launcher **只透传**：key 合法性 / 类型诊断全归 z42vm（旋钮登记表在那边）。
    string[] setBuf = new string[64];
    int setN = 0;
    int i = 0;
    while (i < rest.Length) {
        string a = rest[i];
        if (a == "-h" || a == "--help") { _printRunHelp(); return; }
        if (a == "--bin" || a == "--config" || a == "--mode") { i = i + 2; continue; }
        if (a == "--set") {
            if (i + 1 < rest.Length && setN < setBuf.Length) { setBuf[setN] = rest[i + 1]; setN = setN + 1; }
            i = i + 2;
            continue;
        }
        if (a == "--") { appArgs = _tail(rest, i + 1); break; }
        // 未识别的选项：报错，不猜（`--` 之后的一切归程序，不走这里）。
        if (a.StartsWith("-")) {
            ConsoleError.WriteLine("z42 run: unknown option `" + a + "`");
            ConsoleError.WriteLine("  (program arguments go after `--`; see `z42 run --help`)");
            Environment.Exit(2);
            return;
        }
        if (app.Length == 0) { app = a; }
        else {
            ConsoleError.WriteLine("z42 run: unexpected argument `" + a + "` (program arguments go after `--`)");
            Environment.Exit(2);
            return;
        }
        i = i + 1;
    }

    // 单文件源码：合成清单后走同一条工程构建路径。
    if (app.EndsWith(".z42")) {
        if (binOpt != null && binOpt.Length > 0) {
            ConsoleError.WriteLine("z42 run: --bin does not apply to a single file (a single file has one entry)");
            Environment.Exit(2);
            return;
        }
        string sfManifest = _synthSingleFileManifest(app);
        if (sfManifest.Length == 0) { Environment.Exit(2); return; }
        string sfBuilt = _buildAndResolveRun(sfManifest, "");
        if (sfBuilt.Length == 0) { Environment.Exit(1); return; }
        app = sfBuilt;
    }
    // 源码工程（目录 / 清单 / 未给目标）：先构建，再运行产物。
    else if (app.Length == 0 || _isSourceProject(app)) {
        string manifest = _resolveRunManifest(app);
        if (manifest.Length == 0) { Environment.Exit(2); return; }
        string built = _buildAndResolveRun(manifest, binOpt ?? "");
        if (built.Length == 0) { Environment.Exit(1); return; }
        app = built;
    }

    // <app>.runtimeconfig.toml：z42c 按 [profile.*] 烤出的运行时设置侧车，经 Z42_APP_CONFIG 交给 z42vm。
    string rcPath = _runtimeConfigPath(app);
    string vm = _sdkVm();
    if (!File.Exists(vm)) {
        ConsoleError.WriteLine("z42: runtime not found at " + vm + " — reinstall z42");
        Environment.Exit(2);
        return;
    }
    Process proc = new Process(vm);
    if (modeOpt != null && modeOpt.Length > 0) { proc = proc.Arg("--mode").Arg(modeOpt); }
    int si = 0;
    while (si < setN) { proc = proc.Arg("--set").Arg(setBuf[si]); si = si + 1; }
    proc = proc.Arg(app)
        .Stdin(Stdio.Inherit())
        .Stdout(Stdio.Inherit())
        .Stderr(Stdio.Inherit())
        .Env("Z42_LIBS", _sdkLibs());
    // 两个独立的配置文件层：Z42_CONFIG = 用户配置（--config 或用户自己 export 的）；
    // Z42_APP_CONFIG = 应用侧车。z42vm 逐 key 叠加、用户层赢。
    if (cfgOpt != null && cfgOpt.Length > 0) { proc = proc.Env("Z42_CONFIG", cfgOpt); }
    if (File.Exists(rcPath)) { proc = proc.Env("Z42_APP_CONFIG", rcPath); }
    if (appArgs.Length > 0) {
        proc = proc.Arg("--");
        int j = 0;
        while (j < appArgs.Length) { proc = proc.Arg(appArgs[j]); j = j + 1; }
    }
    Environment.Exit(proc.Run().ExitCode);
}

// 待构建的源码目标：目录，或清单文件（`z42.toml` / `<name>.z42.toml`）。`.zpkg`/`.zbc` 直接运行。
// 单文件（`.z42`）走 `_synthSingleFileManifest`，不经过这里。
bool _isSourceProject(string app) {
    if (app.EndsWith(".zpkg") || app.EndsWith(".zbc")) { return false; }
    if (app.EndsWith("z42.toml")) { return true; }
    return Directory.Exists(app);
}

// ── 单文件运行 ───────────────────────────────────────────────────────────────
//
// `z42 run hello.z42` 在缓存目录里合成一份最小清单，之后**完全复用工程 run 路径**——增量缓存、
// 入口自动检测、runtimeconfig 侧车、`--mode` / `--set` / `--config` 透传全部照旧。
//
// 这样做而不是另写一条单文件编译路径，是为了让 `z42 run hello.z42` 与「把同一段代码建成工程再跑」
// 的语义**由构造保证一致**（同一条 z42c 代码路径），而不是靠测试去追平两套实现。
//
// 🔴 源文件绝不复制进缓存目录：复制后所有诊断的位置都会指向缓存路径，读者无法回到自己的文件。
// 清单里 include 的是源文件**绝对路径**（SourceDiscovery 对 rooted 字面路径直通），诊断呈现则由
// z42c 按当前工作目录相对化 → 读者看到的就是自己敲的 `hello.z42`。

// `<SDK 根>/cache`，可用 Z42_CACHE_DIR 覆盖。
string _cacheRoot() {
    string c = Environment.GetEnvironmentVariable("Z42_CACHE_DIR") ?? "";
    if (c.Length > 0) { return c; }
    return Path.Join(_home(), "cache");
}

// 文件名 → 合法工程名（`[a-z0-9][a-z0-9._-]*`，与 `z42 new` 同规则）。
string _sanitizeProjectName(string stem) {
    string s = stem.ToLower();
    string r = "";
    int i = 0;
    while (i < s.Length) {
        char ch = s.CharAt(i);
        bool ok = (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9')
                  || ch == '.' || ch == '-' || ch == '_';
        r = r + (ok ? ch.ToString() : "-");
        i = i + 1;
    }
    if (r.Length == 0) { return "script"; }
    char first = r.CharAt(0);
    bool firstOk = (first >= 'a' && first <= 'z') || (first >= '0' && first <= '9');
    if (!firstOk) { r = "z" + r; }
    return r;
}

// 为单文件源码合成清单，返回清单路径；失败时打印原因并返回 ""。
//
// 缓存目录按**源文件绝对路径**取哈希（不读内容）——同一文件反复改动仍落同一条目，增量才生效。
// 清单每次重写（成本可忽略），避免用户移动文件后清单陈旧。
string _synthSingleFileManifest(string srcPath) {
    if (!File.Exists(srcPath)) {
        ConsoleError.WriteLine("z42 run: file not found: " + srcPath);
        return "";
    }
    string abs = Path.IsRooted(srcPath)
        ? srcPath
        : Path.Join(Environment.GetCurrentDirectory(), srcPath);
    abs = abs.Replace("\\", "/");

    string name = _sanitizeProjectName(Path.GetFileNameWithoutExtension(srcPath));
    string dir = Path.Join(Path.Join(_cacheRoot(), "run"), Sha256.HashStringHex(abs));
    Directory.Create(dir);

    string toml = "# 由 `z42 run " + Path.GetFileName(srcPath) + "` 自动生成，请勿手工编辑。\n"
        + "# 源文件：" + abs + "\n"
        + "[project]\n"
        + "name    = \"" + name + "\"\n"
        + "version = \"0.0.0\"\n"
        + "kind    = \"exe\"\n"
        + "\n"
        + "[sources]\n"
        + "include = [\"" + abs + "\"]\n";
    string manifest = Path.Join(dir, "z42.toml");
    File.WriteAllText(manifest, toml);
    return manifest;
}

// 目标 → 工程清单路径。未给目标：从当前目录向上找；给了目录：只看该目录。
// 失败时打印原因并返回 ""。
string _resolveRunManifest(string app) {
    if (app.EndsWith("z42.toml")) {
        if (File.Exists(app)) { return app; }
        ConsoleError.WriteLine("z42 run: manifest not found: " + app);
        return "";
    }
    string start = app.Length > 0 ? app : ".";
    ManifestLocation loc = app.Length > 0 ? ManifestLocator.FindIn(app) : ManifestLocator.FindUp(start);
    if (loc.Kind == ManifestLocateKind.Project) { return loc.ManifestPath; }
    if (loc.Kind == ManifestLocateKind.Workspace) {
        ConsoleError.WriteLine("z42 run: `" + loc.ManifestPath + "` is a workspace; run one of its members:");
        ConsoleError.WriteLine("  z42 run <member-dir>");
        return "";
    }
    ConsoleError.WriteLine(ManifestLocator.ErrorText(loc, start));
    return "";
}

// 构建工程（z42c build --quiet：只留诊断，进度行不混进程序输出），再定位要运行的 zpkg：
//   - 无 [[exe]]        → <dist>/<project.name>.zpkg
//   - [[exe]] + --bin   → <dist>/<bin>.zpkg（须是已声明的目标）
//   - [[exe]] 无 --bin  → 报错并列出目标
// 任一失败打印原因并返回 ""。
string _buildAndResolveRun(string manifest, string binName) {
    string z42c = _sdkBin("z42c");
    if (!File.Exists(z42c)) {
        ConsoleError.WriteLine("z42 run: compiler not found at " + z42c + " — reinstall z42");
        return "";
    }
    int bc = new Process(z42c).Arg("build").Arg(manifest).Arg("--quiet")
        .Stdin(Stdio.Inherit()).Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit())
        .Run().ExitCode;
    if (bc != 0) { return ""; }   // z42c 已打印诊断

    ProjectManifest pm = ManifestLoader.Load(manifest);
    string projDir = Path.GetDirectoryName(manifest);
    if (projDir.Length == 0) { projDir = "."; }
    string distDir = BuildLayout.Resolve(pm, projDir, false).DistDir;

    string target = pm.Project.Name;
    if (pm.ExeCount > 0) {
        if (binName.Length == 0) {
            ConsoleError.WriteLine("z42 run: the project has several [[exe]] targets; pick one with --bin <name>:");
            _listExes(pm);
            return "";
        }
        bool found = false;
        int j = 0;
        while (j < pm.ExeCount) { if (pm.Exes[j].Name == binName) { found = true; } j = j + 1; }
        if (!found) {
            ConsoleError.WriteLine("z42 run: --bin " + binName + " is not a declared [[exe]] target; valid:");
            _listExes(pm);
            return "";
        }
        target = binName;
    }
    string zpkg = Path.Join(distDir, target + ".zpkg");
    if (!File.Exists(zpkg)) {
        ConsoleError.WriteLine("z42 run: build produced no " + zpkg);
        return "";
    }
    return zpkg;
}

void _listExes(ProjectManifest pm) {
    int i = 0;
    while (i < pm.ExeCount) { ConsoleError.WriteLine("    - " + pm.Exes[i].Name); i = i + 1; }
}

// `<dir>/<name>.runtimeconfig.toml`（与 app 同目录的侧车）。
string _runtimeConfigPath(string app) {
    string dir = Path.GetDirectoryName(app);
    string fname = Path.GetFileNameWithoutExtension(app) + ".runtimeconfig.toml";
    return dir.Length > 0 ? Path.Join(dir, fname) : fname;
}

// ── small array/flag utils ───────────────────────────────────────────────────

string[] _tail(string[] arr, int start) {
    if (start >= arr.Length) { return new string[0]; }
    int n = arr.Length - start;
    string[] outArr = new string[n];
    int j = 0;
    while (j < n) { outArr[j] = arr[start + j]; j = j + 1; }
    return outArr;
}

string[] _trimArr(string[] arr, int n) {
    string[] outArr = new string[n];
    int j = 0;
    while (j < n) { outArr[j] = arr[j]; j = j + 1; }
    return outArr;
}

string? _flagValue(string[] arr, string flag) {
    int i = 0;
    while (i < arr.Length) {
        if (arr[i] == flag && i + 1 < arr.Length) { return arr[i + 1]; }
        i = i + 1;
    }
    return null;
}
