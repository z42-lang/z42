// z42 launcher CLI 层：命令树（Std.Cli SubcommandRouter）+ 路由。
//
// 命令分三类：
//   - launcher 自己实现：run / version / help / publish / export / workload
//   - 原样转发给工具：build → z42c；new / test / bench / clean → z42b；repl → z42i
//     （转发命令的参数与帮助由对应工具负责；这里注册只为让 `z42 --help` 列出它们）
//   - 简写：`z42 <app.zpkg|.zbc|.z42> [-- args]` ≡ `z42 run <app>`（`.z42` = 单文件源码）
namespace Z42Launcher;

using Std;
using Std.IO;
using Std.Cli;

void _runLauncher(string[] argv) {
    if (argv.Length == 0) { Console.WriteLine(_launcherRoot().HelpText()); return; }
    string c0 = argv[0];

    if (c0 == "--version" || c0 == "-V" || c0 == "version") { _cmdVersion(); return; }
    if (c0 == "help") { _cmdHelp(_tail(argv, 1)); return; }
    if (c0.EndsWith(".zpkg") || c0.EndsWith(".zbc") || c0.EndsWith(".z42")) { _cmdRun(argv); return; }
    // run 的 `-- <program args>` 尾巴过不了严格的 ArgParser，走原样解析。
    if (c0 == "run") { _cmdRun(_tail(argv, 1)); return; }
    if (c0 == "new" || c0 == "test" || c0 == "bench" || c0 == "clean") {
        Environment.Exit(_forwardZ42b(argv));
        return;
    }
    if (c0 == "build") { Environment.Exit(_forwardZ42c(argv)); return; }
    if (c0 == "repl") { Environment.Exit(_forwardRepl(_tail(argv, 1))); return; }

    SubcommandRouter root = _launcherRoot();
    CommandResolution res;
    try { res = root.Resolve(argv); }
    catch (CliException e) {
        ConsoleError.WriteLine("z42: " + e.Message);
        Environment.Exit(2);
        return;
    }
    if (res.IsHelp())    { Console.WriteLine(res.HelpText()); return; }
    if (res.IsUnknown()) {
        ConsoleError.WriteLine(res.ErrorMessage());
        ConsoleError.WriteLine("run `z42 --help` to see all commands");
        Environment.Exit(2);
        return;
    }
    _dispatchLauncher(res);
}

// `z42 help [<command> ...]` ≡ `z42 [<command> ...] --help`。
void _cmdHelp(string[] cmd) {
    if (cmd.Length == 0) { Console.WriteLine(_launcherRoot().HelpText()); return; }
    string[] argv = new string[cmd.Length + 1];
    int i = 0;
    while (i < cmd.Length) { argv[i] = cmd[i]; i = i + 1; }
    argv[cmd.Length] = "--help";
    _runLauncher(argv);
}

SubcommandRouter _launcherRoot() {
    SubcommandRouter root = new SubcommandRouter("z42", "the z42 toolchain");

    // 转发命令：只登记名字与一句话说明（参数 / 帮助由工具自己给）。
    root.Add("new", "create a new project", _fwdParser("z42 new", "create a new project"));
    root.Add("build", "compile the current project", _fwdParser("z42 build", "compile the current project"));

    ArgParser runP = new ArgParser("z42 run", "build and run the current project");
    runP.AllowExtras();
    root.Add("run", "build and run the current project", runP);

    root.Add("test", "run the project's tests", _fwdParser("z42 test", "run the project's tests"));
    root.Add("bench", "run the project's benchmarks", _fwdParser("z42 bench", "run the project's benchmarks"));
    root.Add("clean", "remove build output", _fwdParser("z42 clean", "remove build output"));
    root.Add("repl", "start the interactive REPL", _fwdParser("z42 repl", "start the interactive REPL"));

    // Platform deploy commands take `--rid <rid>` (its category selects the platform).
    ArgParser pub = new ArgParser("z42 publish", "produce a deployable app (--rid selects the platform)");
    pub.AddOptionalPositional("project", "<manifest> (default: the nearest z42.toml)");
    pub.AddOption("rid", "", "target RID (default: host; e.g. macos-arm64 / ios-arm64)", "");
    pub.AddOption("output", "", "output dir (overrides [platform.*].publish_dir)", "");
    pub.AddFlag("no-build", "", "deploy the already-built zpkg as-is (default: compile first, "
        + "rebuilding only what changed)");
    pub.AddFlag("self-contained", "", "embed the z42 runtime (self-contained app; no external z42vm); "
        + "static/dynamic link via [platform.desktop] link");
    root.Add("publish", "produce a deployable app", pub);

    ArgParser exp = new ArgParser("z42 export", "generate a native IDE project (--rid selects the platform)");
    exp.AddOptionalPositional("project", "<manifest> (default: the nearest z42.toml)");
    exp.AddOption("rid", "", "target RID (e.g. ios-arm64 / android-arm64 / browser-wasm)", "");
    exp.AddOption("output", "", "output directory", "");
    exp.AddOption("sdk-ver", "", "platform SDK version to use", "");
    exp.AddOption("bundle-id", "", "iOS CFBundleIdentifier (ios only)", "");
    exp.AddOption("app-id", "", "Android application ID (android only)", "");
    exp.AddOption("entry", "", "wasm entry point e.g. Hello.Main (wasm only)", "");
    root.Add("export", "generate a native IDE project (ios / android / wasm)", exp);

    root.AddRouter("workload", "install / list / uninstall platform workloads", _workloadRouter());

    root.Add("version", "show version information", new ArgParser("z42 version", "show version information"));
    root.Add("help", "show help for a command", _fwdParser("z42 help", "show help for a command"));
    return root;
}

ArgParser _fwdParser(string name, string desc) {
    ArgParser p = new ArgParser(name, desc);
    p.AllowExtras();
    return p;
}

SubcommandRouter _workloadRouter() {
    SubcommandRouter w = new SubcommandRouter("z42 workload", "install / list / uninstall platform workloads");

    ArgParser inst = new ArgParser("z42 workload install", "install a workload (platform tooling + runtime, or a capability like test)");
    inst.AddPositional("workload", "<ios|android|wasm|desktop|test>");
    inst.AddOption("from", "", "local tooling package dir (omit for manifest network install)", "");
    inst.AddOption("runtime", "", "local runtime pack dir", "");
    inst.AddOption("base-url", "", "manifest root for network install (default: GitHub releases)", "");
    inst.AddOption("version", "", "version (default: from package manifest; required for network)", "");
    inst.AddOption("rid", "", "runtime RID (default: from runtime dir name)", "");
    w.Add("install", "install a workload", inst);

    w.Add("list", "list installed workloads", new ArgParser("z42 workload list", "list installed workloads"));

    ArgParser rm = new ArgParser("z42 workload uninstall", "uninstall an installed workload");
    rm.AddPositional("workload", "<wl>");
    rm.AddOption("version", "", "version (default: all)", "");
    w.Add("uninstall", "uninstall an installed workload", rm);

    return w;
}

void _dispatchLauncher(CommandResolution res) {
    string[] p = res.Path();
    if (p.Length == 0) { return; }
    ParseResult r = res.Result();
    string top = p[0];
    if (top == "publish") { _cmdPublish(r); return; }
    if (top == "export")  { _cmdExport(r);  return; }
    if (top == "workload" && p.Length >= 2) {
        string sub = p[1];
        if (sub == "install")   { _cmdWorkloadInstall(r);   return; }
        if (sub == "list")      { _cmdWorkloadList(r);      return; }
        if (sub == "uninstall") { _cmdWorkloadUninstall(r); return; }
    }
}

// ── 转发 ─────────────────────────────────────────────────────────────────────

// new / test / bench / clean → z42b：`z42vm programs/z42b/z42.builder.zpkg -- <argv>`，继承 stdio 与退出码。
int _forwardZ42b(string[] argv) { return _forwardZ42bEnv(argv, "", ""); }

// 同上，附带一个额外环境变量（publish 用它传预解析的 apphost stub：Z42_APPHOST_TEMPLATE）。
int _forwardZ42bEnv(string[] argv, string extraKey, string extraVal) {
    string builder = Path.Join(_home(), "programs/z42b/z42.builder.zpkg");
    if (!File.Exists(builder)) {
        ConsoleError.WriteLine("z42: z42b not found at " + builder + " — reinstall z42");
        return 2;
    }
    Process proc = new Process(_sdkVm()).Arg(builder).Arg("--")
        .Stdin(Stdio.Inherit()).Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit());
    int i = 0;
    while (i < argv.Length) { proc = proc.Arg(argv[i]); i = i + 1; }
    proc = proc.Env("Z42_LIBS", _sdkLibs());
    if (extraKey.Length > 0) { proc = proc.Env(extraKey, extraVal); }
    return proc.Run().ExitCode;
}

// build → SDK 的 bin/z42c（apphost，自带兄弟包与 stdlib 解析）。argv 以 "build" 开头。
int _forwardZ42c(string[] argv) {
    string z42c = _sdkBin("z42c");
    if (!File.Exists(z42c)) {
        ConsoleError.WriteLine("z42: z42c not found at " + z42c + " — reinstall z42");
        return 2;
    }
    Process proc = new Process(z42c)
        .Stdin(Stdio.Inherit()).Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit());
    int i = 0;
    while (i < argv.Length) { proc = proc.Arg(argv[i]); i = i + 1; }
    return proc.Run().ExitCode;
}

// `z42 repl` 帮助。repl 不经 router（`-h` 若不在这里拦住，z42i 会忽略它直接启动 REPL）。
// 选项与 _forwardRepl 的 launcher 级参数（--mode / --config / --set）及 z42i 自己的 `-c` 保持一致。
void _printReplHelp() {
    Console.WriteLine("z42 repl — start the interactive REPL");
    Console.WriteLine("");
    Console.WriteLine("usage: z42 repl [--mode <interp|jit|aot>] [--config <file>] [--set <key>=<value>]... [-c <expr>]");
    Console.WriteLine("");
    Console.WriteLine("options:");
    Console.WriteLine("  --mode <interp|jit|aot>  execution mode (default: jit)");
    Console.WriteLine("  --config <file>          runtime config file");
    Console.WriteLine("  --set <key>=<value>      set a runtime setting for this session (repeatable)");
    Console.WriteLine("  -c <expr>                evaluate <expr>, print the result, and exit");
    Console.WriteLine("  -h, --help               show this help");
    Console.WriteLine("");
    Console.WriteLine("meta-commands (inside the REPL, prefixed with `.`):");
    Console.WriteLine("  .help    list meta-commands            .usings         show active usings");
    Console.WriteLine("  .vars    show bound variables          .using <ns>     add a using");
    Console.WriteLine("  .types   show declared types           .version        show version");
    Console.WriteLine("  .clear   clear the screen              .reset          reset session state");
    Console.WriteLine("  .exit / .quit  quit the REPL (or Ctrl-D)");
}

// repl → z42i：`z42vm [--mode m] [--set k=v]... programs/z42i/z42.interactive.zpkg -- <argv>`。
// z42c.* 已 colocate 进 z42i 的 entry-dir（programs/z42i/），Z42_LIBS 只需单个 libs/ 目录
// （VM 按单路径解析；用 `:` 拼多段在 Windows 上会被盘符冒号截断）。
int _forwardRepl(string[] argv) {
    // `-h`/`--help` → 帮助；跳过 `-c` 的值，使 `z42 repl -c "-h"` 求值而不是显示帮助。
    int hi = 0;
    while (hi < argv.Length) {
        if (argv[hi] == "-c") { hi = hi + 2; continue; }
        if (argv[hi] == "-h" || argv[hi] == "--help") { _printReplHelp(); return 0; }
        hi = hi + 1;
    }
    string z42i = Path.Join(_home(), "programs/z42i/z42.interactive.zpkg");
    if (!File.Exists(z42i)) {
        ConsoleError.WriteLine("z42: REPL not found at " + z42i + " — reinstall z42");
        return 2;
    }
    string? cfgOpt = _flagValue(argv, "--config");
    string? modeOpt = _flagValue(argv, "--mode");
    // `--set k=v` 可重复：收集全部，并从传给 z42i 的参数里剥净。
    string[] setBuf = new string[64];
    int setN = 0;
    string[] z42iArgs = _stripFlag(_stripFlag(argv, "--config"), "--mode");
    int k = 0;
    while (k < z42iArgs.Length) {
        if (z42iArgs[k] == "--set" && k + 1 < z42iArgs.Length && setN < setBuf.Length) {
            setBuf[setN] = z42iArgs[k + 1]; setN = setN + 1;
        }
        k = k + 1;
    }
    int sr = 0;
    while (sr < setN) { z42iArgs = _stripFlag(z42iArgs, "--set"); sr = sr + 1; }
    Process proc = new Process(_sdkVm());
    if (modeOpt != null && modeOpt.Length > 0) { proc = proc.Arg("--mode").Arg(modeOpt); }
    int sf = 0;
    while (sf < setN) { proc = proc.Arg("--set").Arg(setBuf[sf]); sf = sf + 1; }
    // ShareProcessGroup：REPL 交互式驱动 tty；留在新（后台）进程组里拿不到控制终端
    // （没有 `>>>` 提示符，读 tty 触发 SIGTTIN）。
    proc = proc.Arg(z42i).Arg("--")
        .Stdin(Stdio.Inherit()).Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit())
        .ShareProcessGroup();
    int i = 0;
    while (i < z42iArgs.Length) { proc = proc.Arg(z42iArgs[i]); i = i + 1; }
    proc = proc.Env("Z42_LIBS", _sdkLibs());
    if (cfgOpt != null && cfgOpt.Length > 0) { proc = proc.Env("Z42_CONFIG", cfgOpt); }
    return proc.Run().ExitCode;
}

// `argv` 去掉 `flag` 及其后一个值。
string[] _stripFlag(string[] argv, string flag) {
    string[] tmp = new string[argv.Length];
    int n = 0;
    int i = 0;
    while (i < argv.Length) {
        if (argv[i] == flag) { i = i + 2; continue; }
        tmp[n] = argv[i]; n = n + 1; i = i + 1;
    }
    return _trimArr(tmp, n);
}
