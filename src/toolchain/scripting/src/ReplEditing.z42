// REPL 缩进感知键位策略（add-repl-indent-editing）。**决策逻辑在此**——Rust 侧
// （z42vm corelib/repl_editing.rs）只做 policy-free 的适配壳：取 line/pos + 键名，回调这里
// 的自由函数 replKeyEdit，再把返回的「动作串」翻译成 rustyline Cmd。与 Tab 补全的
// Repl.SetCompleter/replComplete 同款重入模式。
//
// 契约：string replKeyEdit(string key, string line, int pos)
//   key ∈ { "backspace", "tab" }
//   返回动作串（Rust 照译成 redo-免疫的 rustyline 命令，见 repl_editing.rs::parse_action）：
//     ""              → 该键默认行为（Tab 落回补全、退格删 1 字符）
//     "dedent"        → Cmd::Dedent(WholeLine)：去一级缩进（indent_size=4，见 repl.rs），kill-ring-free
//     "insert:<text>" → Cmd::Insert(1, text)：光标处补 text（纯空格），kill-ring-free、redo-免疫（text 在 payload）
//
// Tab 网格吸附（add-repl-tab-grid-snap，升级 #253 的定量一级）：Tab 从「恒加一级(indent_size)」
// 改为「ceil 到下制表位」，补 (next_stop - col) 个空格（col=2 → 4 而非旧的 → 6）。用 Insert 补
// delta：光标停在补入空格之后（正确）、不污染 kill-ring。退格仍走 #253 的 Dedent(WholeLine)（去一级）。
//
// 为何退格不做「floor 到前制表位」、} 不自动回退（均 Deferred，见 design Deferred 段）：二者需
// 「删变量个空格/删一级+插}」的整行替换 Cmd::Replace(WholeLine, text)。Replace 虽 redo-免疫
// （WholeLine 无计数），但 rustyline 的 edit_insert_text 插入后不推进光标 → 光标归位行首，破坏
// } 之后继续输入（} else {）。这是 rustyline 局限，需 patch edit_insert_text 才能光标正确，故延后。
// （这也修正 #253「须 patch rustyline」的判据：redo-免疫无需 patch，但删+插的光标正确需要。）
//
// 「当前逻辑行光标前」= 从末个 '\n' 之后到 pos 的子串；col = 其长度。仅当该前缀**全为空格**
// 时才介入（纯缩进行）——有词/有内容一律走默认键行为，绝不干扰正常编辑与补全。
namespace Std.Scripting;

using Std;

public static class ReplEditing {
    // 当前逻辑行光标前子串（末个 '\n' 之后到 pos）。pos 假定 ≤ line.Length。
    private static string LinePrefix(string line, int pos) {
        int start = 0;
        int i = 0;
        while (i < pos) {
            if (line.CharAt(i) == '\n') { start = i + 1; }
            i = i + 1;
        }
        return line.Substring(start, pos - start);
    }

    // 子串是否全为空格。
    private static bool AllSpaces(string s) {
        int i = 0;
        while (i < s.Length) {
            if (s.CharAt(i) != ' ') { return false; }
            i = i + 1;
        }
        return true;
    }

    // n 个空格（n≥0）。
    private static string _spaces(int n) {
        string s = "";
        int i = 0;
        while (i < n) { s = s + " "; i = i + 1; }
        return s;
    }

    // 主策略：给定键名 + 当前行 + 光标位，返回动作串。纯函数、无副作用、可 [Test]。
    public static string KeyEdit(string key, string line, int pos) {
        string prefix = ReplEditing.LinePrefix(line, pos);
        int col = prefix.Length;
        bool ws = ReplEditing.AllSpaces(prefix);

        if (key == "backspace") {
            // 光标前全是空格且非空 → 去一级缩进（Dedent，删 indent_size，光标正确、零 kill-ring
            // 污染）；否则默认删 1 字符。（floor 到前制表位属 Deferred，见头注/design。）
            if (ws && col > 0) { return "dedent"; }
            return "";
        }
        if (key == "tab") {
            // 全空白前缀（含 col==0，无词可补）→ ceil 到下制表位，补 (next_stop - col) 个空格
            // （Insert：光标停在补入之后、零污染）；有词 → 默认（补全）。
            if (ws) {
                int next = ((col / 4) + 1) * 4;
                return "insert:" + ReplEditing._spaces(next - col);
            }
            return "";
        }
        return "";
    }
}

// rustyline 键位回调（契约见 corelib/repl_editing.rs）。经 Repl.SetKeyEditor 注册。
string replKeyEdit(string key, string line, int pos) {
    return ReplEditing.KeyEdit(key, line, pos);
}
