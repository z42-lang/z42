// REPL Tab 补全（add-completion-query-api）。数据源全部 **REPL 自持**、不经 compiler 的
// `CompletionQuery`（那层是 LSP 共享内核）：
//   · 会话变量 `VarNames` + 声明名 `DeclNames`（`ScriptState`）；
//   · 导入世界 `CachedScan`（`DepScanResult`）——各命名空间的导出类型 / 接口 / 枚举 / 自由函数名 +
//     类型的 public 静态成员（`Exported[].Classes/Interfaces/Enums/Functions`）；
//   · 会话变量 live 值的实例成员（`Repl.MemberNames` 运行期反射）。
//
// 三种上下文（按光标前缀 token 判）：
//   ① `var.mem`（var 是会话变量）→ live 值实例成员（D2；零副作用）。
//   ② `Type.mem`（Type 是导入/声明的类型或枚举）→ CachedScan 里该类型的 public 静态成员 / 枚举成员。
//   ③ 裸标识符 `pre` → 作用域候选（会话变量 + 声明名 + 导入类型/枚举/自由函数名）。
//
// rustyline Tab 经 `Std.Repl.Repl.SetCompleter` 注册的自由函数 `replComplete` 回调本模块
// （机制见 z42vm `corelib/repl.rs`）。契约：`string[] replComplete(string line, int pos)`。
namespace Std.Scripting;

using Std;
using Std.Collections;
using Std.Repl;      // Repl.MemberNames（会话变量 obj. 实例成员反射）
using Z42.Pipeline;  // DepScanResult（CachedScan）
using Z42.IR;        // ExportedModuleZ / ExportedClassZ / ExportedEnumZ …（导入世界枚举）
using Z42.Syntax;    // Lexer（关键字表权威源，KeywordCount/KeywordNameAt）

// 当前活跃会话句柄。宿主每轮 read 前 `SetActive(s)`（`.reset` 会重建 `ScriptState` → 必须重设）。
public static class Completer {
    private static ScriptState Active;
    public static void SetActive(ScriptState s) { Completer.Active = s; }
    public static ScriptState GetActive() { return Completer.Active; }
}

// rustyline Tab 回调。两种上下文（按光标前缀 token 判）：
//   ① `recv.mem`——`recv` 是会话变量 → 对其 **live 值**反射列成员（D2；零副作用，见 corelib/repl.rs）。
//   ② 裸标识符 `pre` → 作用域候选（会话变量 + 声明的函数/类型）。
// 均按当前前缀过滤 + 去重。任意非会话变量 receiver 的 `expr.` Phase 1 不补（需静态类型推断，defer）。
string[] replComplete(string line, int pos) {
    ScriptState s = Completer.GetActive();
    if (s == null) { return new string[0]; }

    // .using <ns 前缀> —— 命名空间名补全（add-repl-ns-completion-err-map）。返回「下一段」候选，
    // 由 _wordStart（停在 '.'）给出的最后一段作替换区间——段候选正好替换它（"Std.C"→"Std.Collections"）。
    if (pos >= 7 && line.StartsWith(".using ")) { return _namespaceComplete(s, line, pos); }

    int wordStart = _wordStart(line, pos);
    string word = line.Substring(wordStart, pos - wordStart);

    // 成员访问：word 前紧邻一个 '.'，且 '.' 前是标识符（receiver）。
    if (wordStart > 0 && line.CharAt(wordStart - 1) == '.') {
        int dotPos = wordStart - 1;
        int rStart = _wordStart(line, dotPos);
        string receiver = line.Substring(rStart, dotPos - rStart);
        if (receiver.Length == 0) { return new string[0]; }
        // ① 会话变量 → live 实例成员
        if (_isSessionVar(s, receiver)) { return _memberComplete(s, receiver, word); }
        // ② 导入/声明的类型或枚举 → CachedScan 里的 public 静态成员 / 枚举成员
        return _typeStaticMembers(s, receiver, word);
    }

    // ③ 作用域候选：会话变量 + 声明名（空前缀也列，数量少）+ 导入类型/枚举/自由函数名（仅前缀非空，避免刷屏）。
    List<string> cands = new List<string>();
    int i = 0;
    while (i < s.VarNames.Count)  { _addCand(cands, s.VarNames[i],  word); i = i + 1; }
    i = 0;
    while (i < s.DeclNames.Count) { _addCand(cands, s.DeclNames[i], word); i = i + 1; }
    if (word.Length > 0) {
        _addImportedNames(cands, s, word);        // 已 reconcile 世界的类型/枚举/自由函数名
        _addIndexedTypeNames(cands, s, word);     // + ns 索引已知但尚未 reconcile 的类型名（修 Bug 1a）
        _addKeywords(cands, word);                // + z42 语言关键字（while/return/using/...）
    }
    return cands.ToArray();
}

// .using 上下文命名空间名补全（add-repl-ns-completion-err-map）。ns-so-far = ".using " 后到 pos；
// 按 `DepScanResult.NsNames`（全量 ns）前缀匹配，返回 prefixNs（最后一个 '.' 及之前）之后到下一个 '.'
// 的**段**候选——替换区间是 _wordStart 给的最后一段，段候选正好替换它（"Std.C"→"Std.Collections"、
// "Std." → 空段位插入 "Collections"）。去重 + 前缀过滤。scan 未就绪 → 空。
string[] _namespaceComplete(ScriptState s, string line, int pos) {
    DepScanResult sc = s.CachedScan;
    if (sc == null) { return new string[0]; }
    string nsSoFar = line.Substring(7, pos - 7);   // ".using " 占 7 字符
    int lastDot = 0 - 1;
    int k = 0;
    while (k < nsSoFar.Length) { if (nsSoFar.CharAt(k) == '.') { lastDot = k; } k = k + 1; }
    string prefixNs = "";
    string lastSeg = nsSoFar;
    if (lastDot >= 0) {
        prefixNs = nsSoFar.Substring(0, lastDot + 1);
        lastSeg = nsSoFar.Substring(lastDot + 1, nsSoFar.Length - lastDot - 1);
    }
    List<string> cands = new List<string>();
    int i = 0;
    while (i < sc.NsCount) {
        string ns = sc.NsNames[i];
        if (ns.Length > prefixNs.Length && ns.StartsWith(prefixNs)) {
            string rest = ns.Substring(prefixNs.Length, ns.Length - prefixNs.Length);
            int nd = rest.IndexOf(".");
            string seg = nd < 0 ? rest : rest.Substring(0, nd);
            _addCand(cands, seg, lastSeg);
        }
        i = i + 1;
    }
    return cands.ToArray();
}

// add-repl-history-keyword-completion：z42 语言关键字补全。关键字表以 z42c.syntax 的 `Lexer` 为
// **权威源**（`KeywordCount`/`KeywordNameAt`，构造即 `_initKeywords`）——不硬编码、零漂移，新增关键字
// 自动纳入。仅前缀非空时补（空前缀不刷屏 ~85 个关键字）；`_addCand` 前缀过滤 + 去重。
void _addKeywords(List<string> cands, string prefix) {
    if (prefix.Length == 0) { return; }
    Lexer lx = new Lexer("", "<repl>");
    int n = lx.KeywordCount();
    int i = 0;
    while (i < n) { _addCand(cands, lx.KeywordNameAt(i), prefix); i = i + 1; }
}

// fix-repl-completion-span-and-index（Bug 1a）：`_addImportedNames` 只列**已 reconcile** 的
// `Exported[]`——`Console` 等没被引用/执行过的类型不在里面 → 补不出。ns 索引（`TypeShort`/`TypeNs`，
// #101 type→ns）在 prewarm 就记全了每个 ns 的类型短名，这里据它补出「索引已知」的类型名，按**活跃
// using** 过滤（避免列出未 import 的 ns 的类型）。`_addCand` 去重，与 `Exported` 重叠无害。
// 索引空（`TypeMapCount==0`，冷缓存/非惰性路径）→ 无候选，退化为仅 `Exported`（不坏）。
void _addIndexedTypeNames(List<string> cands, ScriptState s, string prefix) {
    DepScanResult sc = s.CachedScan;
    if (sc == null) { return; }
    int i = 0;
    while (i < sc.TypeMapCount) {
        if (_nsActive(s, sc.TypeNs[i])) { _addCand(cands, sc.TypeShort[i], prefix); }
        i = i + 1;
    }
}

// ns 是否在当前会话活跃（prelude 免-using 的 Std/Std.Runtime + 累积 usings）。
bool _nsActive(ScriptState s, string ns) {
    if (ns == "Std" || ns == "Std.Runtime") { return true; }
    int i = 0;
    while (i < s.Usings.Count) { if (s.Usings[i] == ns) { return true; } i = i + 1; }
    return false;
}

// fix-repl-completion-span-and-index（Bug 1b）：`Type.` 成员补全前，若该类型仅存在于 ns 索引、
// 尚未 reconcile 进 `Exported`（没执行过）→ 对声明它的活跃 ns 按需 reconcile 一次（复用 E0401
// 恢复同款 `ReconcileCandidatesInNs`），使其静态成员随即可补。Tab 触发、一次性 ~150ms，可接受。
void _ensureReconciled(ScriptState s, DepScanResult sc, string typeName) {
    int mi = 0;
    while (mi < sc.ExportedCount) {
        ExportedModuleZ m = sc.Exported[mi];
        int ci = 0;
        while (ci < m.ClassCount) { if (m.Classes[ci].Name == typeName) { return; } ci = ci + 1; }
        int ei = 0;
        while (ei < m.EnumCount)  { if (m.Enums[ei].Name  == typeName) { return; } ei = ei + 1; }
        mi = mi + 1;
    }
    string[] one = new string[1]; one[0] = typeName;
    int t = 0;
    while (t < sc.TypeMapCount) {
        if (sc.TypeShort[t] == typeName && _nsActive(s, sc.TypeNs[t])) {
            DepScan.ReconcileCandidatesInNs(sc, sc.TypeNs[t], one, 1);
            return;
        }
        t = t + 1;
    }
}

// ③ 导入世界的顶层可命名符号：各命名空间的类 / 接口 / 枚举 / 自由函数名（裸名，前缀过滤 + 去重）。
void _addImportedNames(List<string> cands, ScriptState s, string prefix) {
    DepScanResult sc = s.CachedScan;
    if (sc == null) { return; }   // 首轮 eval 前尚未建 scan
    int mi = 0;
    while (mi < sc.ExportedCount) {
        ExportedModuleZ m = sc.Exported[mi];
        int c = 0;
        while (c < m.ClassCount)     { _addCand(cands, m.Classes[c].Name,    prefix); c = c + 1; }
        int f = 0;
        while (f < m.InterfaceCount) { _addCand(cands, m.Interfaces[f].Name, prefix); f = f + 1; }
        int e = 0;
        while (e < m.EnumCount)      { _addCand(cands, m.Enums[e].Name,      prefix); e = e + 1; }
        int gi = 0;
        while (gi < m.FunctionCount) { _addCand(cands, _cleanName(m.Functions[gi].Name), prefix); gi = gi + 1; }
        mi = mi + 1;
    }
}

// ② `Type.` 静态成员：CachedScan 里名为 typeName 的类的 public 静态方法/字段，或枚举的成员。
string[] _typeStaticMembers(ScriptState s, string typeName, string prefix) {
    List<string> cands = new List<string>();
    DepScanResult sc = s.CachedScan;
    if (sc == null) { return cands.ToArray(); }
    _ensureReconciled(s, sc, typeName);   // Bug 1b：未 reconcile 的类型先按需 reconcile，成员才补得出
    int mi = 0;
    while (mi < sc.ExportedCount) {
        ExportedModuleZ m = sc.Exported[mi];
        int ci = 0;
        while (ci < m.ClassCount) {
            ExportedClassZ cl = m.Classes[ci];
            if (cl.Name == typeName) {
                int j = 0;
                while (j < cl.MethodCount) {
                    ExportedMethodZ mm = cl.Methods[j];
                    if (mm.IsStatic && mm.Visibility == "public") { _addCand(cands, _cleanName(mm.Name), prefix); }
                    j = j + 1;
                }
                int fj = 0;
                while (fj < cl.FieldCount) {
                    ExportedFieldZ fd = cl.Fields[fj];
                    if (fd.IsStatic && fd.Visibility == "public") { _addCand(cands, fd.Name, prefix); }
                    fj = fj + 1;
                }
            }
            ci = ci + 1;
        }
        int ei = 0;
        while (ei < m.EnumCount) {
            ExportedEnumZ en = m.Enums[ei];
            if (en.Name == typeName) {
                int k = 0;
                while (k < en.MemberCount) { _addCand(cands, en.Members[k].Name, prefix); k = k + 1; }
            }
            ei = ei + 1;
        }
        mi = mi + 1;
    }
    return cands.ToArray();
}

// 会话变量 obj. 成员补全：构静态字段 FQN → Repl.MemberNames 反射 live 值类型成员 → 前缀过滤。
string[] _memberComplete(ScriptState s, string receiver, string prefix) {
    string vr = s.VarsRound.ToString();
    string key = "Repl.R" + vr + ".Vars" + vr + "." + receiver;   // 见 loader.rs 静态字段 FQN 约定
    string[] members = Repl.MemberNames(key);
    List<string> cands = new List<string>();
    int i = 0;
    while (i < members.Length) { _addCand(cands, members[i], prefix); i = i + 1; }
    return cands.ToArray();
}

bool _isSessionVar(ScriptState s, string name) {
    int i = 0;
    while (i < s.VarNames.Count) { if (s.VarNames[i] == name) { return true; } i = i + 1; }
    return false;
}

// 去派发 mangle：导出方法/自由函数名带 `$arity$type…` 重载后缀（如 `WriteLine$1$object`）；
// 补全展示源名——截到首个 `$`。类型/字段/枚举成员名本就是干净的（无 `$`，原样返回）。
string _cleanName(string name) {
    int d = name.IndexOf("$");
    if (d < 0) { return name; }
    return name.Substring(0, d);
}

// 前缀匹配 + 去重后加入候选。
void _addCand(List<string> cands, string name, string prefix) {
    if (!name.StartsWith(prefix)) { return; }
    int j = 0;
    while (j < cands.Count) { if (cands[j] == name) { return; } j = j + 1; }
    cands.Add(name);
}

// 标识符词（字母 / 数字 / `_`）在 pos 处的起始下标；无标识符字符则返回 pos（空词）。
int _wordStart(string line, int pos) {
    int start = pos;
    while (start > 0) {
        char c = line.CharAt(start - 1);
        bool ident = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if (ident) { start = start - 1; } else { break; }
    }
    return start;
}
