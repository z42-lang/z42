// REPL Tab 补全（add-completion-query-api）。数据源全部 **REPL 自持**、不经 compiler 的
// `CompletionQuery`（那层是 LSP 共享内核）：
//   · 会话变量 `VarNames` + 声明名 `DeclNames`（`ScriptState`）；
//   · 导入世界（opaque `CachedScan` 句柄）——经 `IReplCompiler` 门面查询各命名空间的导出类型/接口/
//     枚举/自由函数名 + 类型的 public 静态成员（sink-repl-compile-facade：世界遍历住编译器实现侧，
//     scripting 只拿最终候选串 + 做前缀过滤/去重）；
//   · 会话变量 live 值的实例成员（`Engine.MemberNames` 运行期反射）。
//
// 三种上下文（按光标前缀 token 判）：
//   ① `var.mem`（var 是会话变量）→ live 值实例成员（D2；零副作用）。
//   ② `Type.mem`（Type 是导入/声明的类型或枚举）→ 门面 StaticMembersOf（该类型 public 静态成员/枚举成员）。
//   ③ 裸标识符 `pre` → 作用域候选（会话变量 + 声明名 + 门面 ScopeTypeNames 导入类型/枚举/自由函数名）。
//
// rustyline Tab 经 `Std.Repl.Repl.SetCompleter` 注册的自由函数 `replComplete` 回调本模块
// （机制见 z42vm `corelib/repl.rs`）。契约：`string[] replComplete(string line, int pos)`。
namespace Std.Scripting;

using Std;
using Std.Collections;
using Z42.Syntax;    // Lexer（关键字表权威源，KeywordCount/KeywordNameAt）——前端已是 stdlib
using Z42.Build;     // IReplCompiler（ReplCompilerHost.Get() 返回类型；补全查询经门面）

// 当前活跃会话句柄。宿主每轮 read 前 `SetActive(s)`（`.reset` 会重建 `ScriptState` → 必须重设）。
public static class Completer {
    private static ScriptState Active;
    public static void SetActive(ScriptState s) { Completer.Active = s; }
    public static ScriptState GetActive() { return Completer.Active; }
}

// rustyline Tab 回调。两种上下文（按光标前缀 token 判）：
//   ① `recv.mem`——`recv` 是会话变量 → 对其 **live 值**反射列成员（D2；零副作用，见 corelib/repl.rs）。
//   ② 裸标识符 `pre` → 作用域候选（会话变量 + 声明的函数/类型）。
// 均按当前前缀过滤 + 去重。任意非会话变量 receiver 的 `expr.` Phase 1 不补（需静态类型推断，defer）。
string[] replComplete(string line, int pos) {
    ScriptState s = Completer.GetActive();
    if (s == null) { return new string[0]; }

    // .using <ns 前缀> —— 命名空间名补全（add-repl-ns-completion-err-map）。返回「下一段」候选，
    // 由 _wordStart（停在 '.'）给出的最后一段作替换区间——段候选正好替换它（"Std.C"→"Std.Collections"）。
    if (pos >= 7 && line.StartsWith(".using ")) { return _namespaceComplete(s, line, pos); }

    int wordStart = _wordStart(line, pos);
    string word = line.Substring(wordStart, pos - wordStart);

    // 成员访问：word 前紧邻一个 '.'，且 '.' 前是标识符（receiver）。
    if (wordStart > 0 && line.CharAt(wordStart - 1) == '.') {
        int dotPos = wordStart - 1;
        int rStart = _wordStart(line, dotPos);
        string receiver = line.Substring(rStart, dotPos - rStart);
        if (receiver.Length == 0) { return new string[0]; }
        // ① 会话变量 → live 实例成员
        if (_isSessionVar(s, receiver)) { return _memberComplete(s, receiver, word); }
        // ② 导入/声明的类型或枚举 → CachedScan 里的 public 静态成员 / 枚举成员
        return _typeStaticMembers(s, receiver, word);
    }

    // ③ 作用域候选：会话变量 + 声明名（空前缀也列，数量少）+ 导入类型/枚举/自由函数名（仅前缀非空，避免刷屏）。
    List<string> cands = new List<string>();
    int i = 0;
    while (i < s.VarNames.Count)  { _addCand(cands, s.VarNames[i],  word); i = i + 1; }
    i = 0;
    while (i < s.DeclNames.Count) { _addCand(cands, s.DeclNames[i], word); i = i + 1; }
    if (word.Length > 0) {
        // 门面 ScopeTypeNames = 已 reconcile 顶层符号 ∪ 活跃 ns 内索引类型短名（原 _addImportedNames +
        // _addIndexedTypeNames 世界遍历合入编译器实现侧）。前缀过滤/去重仍在此侧 _addCand。
        if (s.CachedScan != null) {
            string[] activeNs = _activeNsArray(s);
            string[] scope = ReplCompilerHost.Get().ScopeTypeNames(s.CachedScan, activeNs, activeNs.Length);
            int si = 0;
            while (si < scope.Length) { _addCand(cands, scope[si], word); si = si + 1; }
        }
        _addKeywords(cands, word);                // + z42 语言关键字（while/return/using/...）
    }
    return cands.ToArray();
}

// .using 上下文命名空间名补全（add-repl-ns-completion-err-map）。ns-so-far = ".using " 后到 pos；
// 按门面 `NamespaceNames`（全量 ns）前缀匹配，返回 prefixNs（最后一个 '.' 及之前）之后到下一个 '.'
// 的**段**候选——替换区间是 _wordStart 给的最后一段，段候选正好替换它（"Std.C"→"Std.Collections"、
// "Std." → 空段位插入 "Collections"）。去重 + 前缀过滤。scan 未就绪 → 空。
string[] _namespaceComplete(ScriptState s, string line, int pos) {
    if (s.CachedScan == null) { return new string[0]; }
    string[] nsNames = ReplCompilerHost.Get().NamespaceNames(s.CachedScan);   // 门面：世界全部 ns 名
    string nsSoFar = line.Substring(7, pos - 7);   // ".using " 占 7 字符
    int lastDot = 0 - 1;
    int k = 0;
    while (k < nsSoFar.Length) { if (nsSoFar.CharAt(k) == '.') { lastDot = k; } k = k + 1; }
    string prefixNs = "";
    string lastSeg = nsSoFar;
    if (lastDot >= 0) {
        prefixNs = nsSoFar.Substring(0, lastDot + 1);
        lastSeg = nsSoFar.Substring(lastDot + 1, nsSoFar.Length - lastDot - 1);
    }
    List<string> cands = new List<string>();
    int i = 0;
    while (i < nsNames.Length) {
        string ns = nsNames[i];
        if (ns.Length > prefixNs.Length && ns.StartsWith(prefixNs)) {
            string rest = ns.Substring(prefixNs.Length, ns.Length - prefixNs.Length);
            int nd = rest.IndexOf(".");
            string seg = nd < 0 ? rest : rest.Substring(0, nd);
            _addCand(cands, seg, lastSeg);
        }
        i = i + 1;
    }
    return cands.ToArray();
}

// add-repl-history-keyword-completion：z42 语言关键字补全。关键字表以 z42c.syntax 的 `Lexer` 为
// **权威源**（`KeywordCount`/`KeywordNameAt`，构造即 `_initKeywords`）——不硬编码、零漂移，新增关键字
// 自动纳入。仅前缀非空时补（空前缀不刷屏 ~85 个关键字）；`_addCand` 前缀过滤 + 去重。
void _addKeywords(List<string> cands, string prefix) {
    if (prefix.Length == 0) { return; }
    Lexer lx = new Lexer("", "<repl>");
    int n = lx.KeywordCount();
    int i = 0;
    while (i < n) { _addCand(cands, lx.KeywordNameAt(i), prefix); i = i + 1; }
}

// 活跃 ns 集（供门面按 ns 过滤索引类型 / 定位待 reconcile 类型的声明 ns）：累积 usings + prelude
// 免-using 的 Std/Std.Runtime（原 _nsActive 策略——now 组成数组一次性传门面）。
string[] _activeNsArray(ScriptState s) {
    List<string> ns = new List<string>();
    int i = 0;
    while (i < s.Usings.Count) { ns.Add(s.Usings[i]); i = i + 1; }
    ns.Add("Std");
    ns.Add("Std.Runtime");
    return ns.ToArray();
}

// ② `Type.` 静态成员：门面 StaticMembersOf 列名为 typeName 的类的 public 静态方法/字段或枚举成员
// （sink-repl-compile-facade：按需 reconcile + 世界遍历住编译器实现侧；含原 Bug 1b 的按需 reconcile）。
// 本侧只做前缀过滤 + 去重。scan 未就绪 → 空。
string[] _typeStaticMembers(ScriptState s, string typeName, string prefix) {
    List<string> cands = new List<string>();
    if (s.CachedScan == null) { return cands.ToArray(); }
    string[] activeNs = _activeNsArray(s);
    string[] members = ReplCompilerHost.Get().StaticMembersOf(s.CachedScan, typeName, activeNs, activeNs.Length);
    int i = 0;
    while (i < members.Length) { _addCand(cands, members[i], prefix); i = i + 1; }
    return cands.ToArray();
}

// 会话变量 obj. 成员补全：构静态字段 FQN → Engine.MemberNames 反射 live 值类型成员 → 前缀过滤。
string[] _memberComplete(ScriptState s, string receiver, string prefix) {
    string vr = s.VarsRound.ToString();
    string key = "Repl.R" + vr + ".Vars" + vr + "." + receiver;   // 见 loader.rs 静态字段 FQN 约定
    string[] members = Engine.MemberNames(key);
    List<string> cands = new List<string>();
    int i = 0;
    while (i < members.Length) { _addCand(cands, members[i], prefix); i = i + 1; }
    return cands.ToArray();
}

bool _isSessionVar(ScriptState s, string name) {
    int i = 0;
    while (i < s.VarNames.Count) { if (s.VarNames[i] == name) { return true; } i = i + 1; }
    return false;
}

// 前缀匹配 + 去重后加入候选。
void _addCand(List<string> cands, string name, string prefix) {
    if (!name.StartsWith(prefix)) { return; }
    int j = 0;
    while (j < cands.Count) { if (cands[j] == name) { return; } j = j + 1; }
    cands.Add(name);
}

// 标识符词（字母 / 数字 / `_`）在 pos 处的起始下标；无标识符字符则返回 pos（空词）。
int _wordStart(string line, int pos) {
    int start = pos;
    while (start > 0) {
        char c = line.CharAt(start - 1);
        bool ident = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if (ident) { start = start - 1; } else { break; }
    }
    return start;
}
