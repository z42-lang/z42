// Script.Eval —— REPL 编译+执行层（scripting-charter Form B）。
//
// 流程：分类输入（using / var 声明 / 表达式）→ build 每轮源（D7 唯一命名空间 Repl.R{N} +
// carry-forward Vars{N} 类）→ IrDump.ParseAll → PackageCompile.Compile → ZpkgWriterZ.ToBytes
// → Engine.LoadBytes（内存加载）→ Engine.Invoke（自由函数 Eval{N}）→ EvalResult。
// 编译失败不推进会话（错误恢复）。
//
// 状态模型（D7 + D8）：会话变量提升为 Vars{N} 类静态字段；每轮 carry 前轮全部变量
// （`public static var v = Vars{prev}.v;`），新变量追加；用户对变量的裸引用经 Rewriter
// 改写成 `Vars{N}.v`。依赖已合并的 infer-var-field-types（跨轮 carry 的 var 字段类型正确）。
namespace Std.Scripting;

using Std;
using Std.IO;
using Std.Collections;
using Z42.Syntax;
using Z42.Semantics;
using Z42.Pipeline;
using Z42.IR;
using Z42.Project;

// 分类结果（内部）。
public class ParsedInput {
    public bool IsVarDecl;
    public string VarName;
    public string InitExpr;
    public ParsedInput() { this.IsVarDecl = false; this.VarName = ""; this.InitExpr = ""; }
}

public static class Script {
    // 新建空会话。从 Z42_LIBS 派生编译依赖目录；DeclaredDeps 留空 → DepScan 放行全部包。
    public static ScriptState Create() {
        ScriptState s = new ScriptState();
        // 会话磁盘目录：每轮 zpkg 落盘于此，供后续轮编译期 carry-forward 引用。
        s.SessionDir = Directory.CreateTempDir("z42repl");
        // LibsDirs = Z42_LIBS 各目录 + 会话目录。DeclaredDeps 留空 → DepScan 放行全部包。
        string libs = Environment.GetEnvironmentVariable("Z42_LIBS");
        string[] envDirs = new string[0];
        if (libs != null && libs.Length > 0) { envDirs = libs.Split(":"); }
        string[] dirs = new string[envDirs.Length + 1];
        int i = 0;
        while (i < envDirs.Length) { dirs[i] = envDirs[i]; i = i + 1; }
        dirs[envDirs.Length] = s.SessionDir;
        s.LibsDirs = dirs; s.LibsDirsN = dirs.Length;
        return s;
    }

    public static EvalResult Eval(ScriptState state, string input) {
        string trimmed = input.Trim();

        // ── using 声明：累积（去重），不编译 ──
        if (trimmed.StartsWith("using ")) {
            string nsName = trimmed.Substring(6, trimmed.Length - 6).Trim();
            if (nsName.EndsWith(";")) { nsName = nsName.Substring(0, nsName.Length - 1).Trim(); }
            bool seen = false;
            int sk = 0;
            while (sk < state.Usings.Count) { if (state.Usings[sk] == nsName) { seen = true; } sk = sk + 1; }
            if (!seen) { state.Usings.Add(nsName); }
            return new EvalResult(true, false, null, "", state);
        }

        int n = state.Counter + 1;
        string ns = "Repl.R" + n.ToString();
        string efn = "Eval" + n.ToString();
        string cls = "Vars" + n.ToString();

        ParsedInput p = Script._classify(trimmed);
        bool needVars = (state.VarNames.Count > 0) || p.IsVarDecl;

        // ── build prelude（namespace + usings + carry-forward Vars 类）──
        string prelude = "namespace " + ns + ";\n";
        int u = 0;
        while (u < state.Usings.Count) { prelude = prelude + "using " + state.Usings[u] + ";\n"; u = u + 1; }
        if (needVars && state.VarsRound > 0) {
            prelude = prelude + "using Repl.R" + state.VarsRound.ToString() + ";\n";
        }
        if (needVars) {
            string carryCls = "Vars" + state.VarsRound.ToString();
            prelude = prelude + "public static class " + cls + " {\n";
            int vi = 0;
            while (vi < state.VarNames.Count) {
                string vn = state.VarNames[vi];
                prelude = prelude + "  public static var " + vn + " = " + carryCls + "." + vn + ";\n";
                vi = vi + 1;
            }
            if (p.IsVarDecl) {
                string initR = Rewriter.Rewrite(p.InitExpr, state.VarNames, cls);
                prelude = prelude + "  public static var " + p.VarName + " = " + initR + ";\n";
            }
            prelude = prelude + "}\n";
        }

        // 用户输入对变量的裸引用 → 本轮 cls（有变量时）
        string rewritten = input;
        if (needVars) { rewritten = Rewriter.Rewrite(input, state.VarNames, cls); }

        // ── 编译（表达式优先；非声明失败 → 回退纯语句，支持 void 调用/赋值）──
        CompileArtifacts art;
        bool hasValue = true;
        if (p.IsVarDecl) {
            art = Script._compileBody(state, n, prelude, efn, "return (" + cls + "." + p.VarName + ");");
        } else {
            art = Script._compileBody(state, n, prelude, efn, "return (" + rewritten + ");");
            if (art.ErrorCount > 0) {
                CompileArtifacts artS = Script._compileBody(state, n, prelude, efn, rewritten + "; return null;");
                if (artS.ErrorCount == 0) { art = artS; hasValue = false; }
            }
        }
        if (art.ErrorCount > 0) {
            string err = "";
            int di = 0;
            while (di < art.Cms[0].DiagCount) { err = err + art.Cms[0].DiagMsgs[di] + "\n"; di = di + 1; }
            return new EvalResult(false, false, null, err, state);   // 会话不推进
        }

        // ── bytes → 落盘（供后续轮 carry-forward 编译期引用）→ 内存加载 → invoke ──
        byte[] bytes = ZpkgWriterZ.WritePacked(art.Z, false).ToBytes();
        File.WriteAllBytes(Path.Join(state.SessionDir, "repl_r" + n.ToString() + ".zpkg"), bytes);
        Engine.LoadBytes(bytes);
        object result = Engine.Invoke(ns + "." + efn);

        // ── 推进会话状态 ──
        state.Counter = n;
        if (needVars) { state.VarsRound = n; }
        if (p.IsVarDecl) {
            bool dup = false;
            int dk = 0;
            while (dk < state.VarNames.Count) { if (state.VarNames[dk] == p.VarName) { dup = true; } dk = dk + 1; }
            if (!dup) { state.VarNames.Add(p.VarName); }
        }
        object retVal = null;
        if (hasValue) { retVal = result; }
        return new EvalResult(true, hasValue, retVal, "", state);
    }

    // 用给定 eval body 编译本轮包（表达式/语句两种 body 复用）。
    private static CompileArtifacts _compileBody(ScriptState state, int n, string prelude, string efn, string body) {
        string src = prelude + "public static object " + efn + "() { " + body + " }\n";
        string[] texts = new string[1]; texts[0] = src;
        string[] files = new string[1]; files[0] = "repl_r" + n.ToString() + ".z42";
        CompilationUnit[] cus = IrDump.ParseAll(texts, files, 1);
        CompileInputs inp = new CompileInputs();
        inp.Texts = texts; inp.Files = files;
        string[] hashes = new string[1]; hashes[0] = ZpkgBuilder.Sha256Hex(src);
        inp.SrcHashes = hashes; inp.SrcCount = 1;
        inp.Cus = cus; inp.CachedMods = null; inp.CachedMetas = null;
        inp.Name = "repl_r" + n.ToString(); inp.Version = "0.0.0"; inp.Kind = "lib";
        inp.HasEntry = false; inp.Entry = ""; inp.IsRelease = false;
        inp.LibsDirs = state.LibsDirs; inp.LibsDirsN = state.LibsDirsN;
        inp.DeclaredDeps = state.DeclaredDeps; inp.DepCount = state.DepCount;
        return PackageCompile.Compile(inp);
    }

    // 分类：识别变量声明 `var x = ...` / `T x = ...`（token 级）。否则视为表达式。
    private static ParsedInput _classify(string trimmed) {
        ParsedInput p = new ParsedInput();
        Lexer lx = new Lexer(trimmed, "<repl>");
        lx.Tokenize();
        if (lx.TokenCount() < 3) { return p; }
        Token t0 = lx.TokenAt(0);
        Token t1 = lx.TokenAt(1);
        Token t2 = lx.TokenAt(2);
        bool isDecl = false;
        // `var x =`  或  `T x =`（T=标识符类型名）
        if (t0.Kind == TokenKind.Var && t1.Kind == TokenKind.Identifier && t2.Kind == TokenKind.Eq) { isDecl = true; }
        else if (t0.Kind == TokenKind.Identifier && t1.Kind == TokenKind.Identifier && t2.Kind == TokenKind.Eq) { isDecl = true; }
        if (!isDecl) { return p; }
        p.IsVarDecl = true;
        p.VarName = t1.Text;
        // init = `=` 之后到末尾（去尾 `;`）
        int eqEnd = t2.Span.End;
        string init = trimmed.Substring(eqEnd, trimmed.Length - eqEnd).Trim();
        if (init.EndsWith(";")) { init = init.Substring(0, init.Length - 1).Trim(); }
        p.InitExpr = init;
        return p;
    }
}
