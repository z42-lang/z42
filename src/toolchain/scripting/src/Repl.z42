// REPL native bindings（add-z42-repl 阶段 2）。行编辑 = Std.Repl.Repl；
// 脚本引擎内部原语（内存加载 / 反射调用）= Std.Scripting.Engine。均由 z42vm builtin 承载。
namespace Std.Repl;

using Std;

// 交互式行编辑器（rustyline，见 z42vm corelib/repl.rs）。EOF/Ctrl-D → null。
public static class Repl {
    // 读一行（历史 / emacs 键 / Ctrl-D），编辑缓冲预填 initial（空串 = 全新行；缩进串 = 自动
    // 缩进的续行，光标落在缩进后可编辑）。返回 null 表示 EOF（调用方据此退出）。
    // 多行累积 + 完整性判定 + 续行缩进计算已全部上移脚本层（sink-repl-indent-to-script，承接
    // add-repl-parser-completeness）：parser 权威判完整、Std.Scripting.Completeness 用既有 Lexer
    // 算缩进；本原语退化成「读一行、用给定串预填」——native 侧不再留任何括号状态机。
    [Native("__repl_readline")]
    public static extern string ReadLine(string prompt, string initial);

    // 注册 Tab 补全的自由函数 FQN（契约 `string[] f(string line, int pos)`）；空串清除。
    // rustyline Completer 在每次 Tab 回调它取候选（见 z42vm corelib/repl.rs）。add-completion-query-api。
    [Native("__repl_set_completer")]
    public static extern void SetCompleter(string fqn);

    // 读会话变量活值（静态字段 FQN = `Repl.R{N}.Vars{N}.{var}`）的运行时类型成员名（字段/方法/属性）。
    // 零副作用（读已存静态字段，不重求值）。null / 基元 / 未加载 → 空。add-completion-query-api 阶段 3b。
    [Native("__repl_member_names")]
    public static extern string[] MemberNames(string staticFieldFqn);
}
