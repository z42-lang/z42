// 驱动测试：REPL 支持 target-typed new（add-target-typed-new）。
// `A a = new()` 省略构造类名——REPL 保留声明类型发静态字段（Classifier.DeclType +
// Script 发 `public static <type>`），使声明类型能作 target-typed new 的目标。
// 直接驱动 Std.Scripting.Script.Eval 跨轮，与 expected_output.txt 对账。
// 经 warm-z42c 回路运行（Z42_LIBS = z42.scripting + z42c.* + stdlib）。
namespace ReplTargetTypedNewTest;

using Std;
using Std.IO;
using Std.Scripting;

void Main() {
    ScriptState s = Script.Create();

    // 类声明（无参 + 双参 ctor）
    _step(s, "class Pt { public int x; public int y; public Pt() {} public Pt(int a, int b) { this.x = a; this.y = b; } }");
    // target-typed new：无参（目标 = 声明类型 Pt）
    _step(s, "Pt p0 = new();");
    _step(s, "p0.x");                       // 0（默认）
    // target-typed new：带 ctor 实参
    _step(s, "Pt p = new(3, 4);");
    _step(s, "p.x");                        // 3
    _step(s, "p.y");                        // 4
    // target-typed new：对象初始化器
    _step(s, "Pt q = new() { x = 9 };");
    _step(s, "q.x");                        // 9
    // var 无法推断目标 → E0437
    _step(s, "var bad = new();");
    // 注：会话变量重赋值 `p = new(..)` 是 pre-existing REPL 限制（对显式 `new Pt(..)` 同样失败，
    // 与 target-typed new 无关，另行修），故本用例不覆盖。
}

// 打印一步结果：失败 → 错误文本（去空白）；有值 → 值；否则 → "ok"。
void _step(ScriptState s, string input) {
    EvalResult r = Script.Eval(s, input);
    if (!r.Success) { Console.WriteLine(r.Error.Trim()); return; }
    if (r.HasValue && r.Value != null) { Console.WriteLine("" + r.Value); return; }
    Console.WriteLine("ok");
}
