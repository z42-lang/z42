// TsigReconcile 归一化对账单测（reconcile-tsig-from-runtime-sections / unify P2）。
// 全 29 包端到端对账由 driver verb `reconcile-tsig` 覆盖（本地手工 + follow-up CI gate）；
// 本单测钉住 TsigReconcile.Compare 的**归一化判据**（易回归的横切逻辑）：可见性 internal≈public、
// 类型双拼写 canon（byte↔u8 / nullable 擦除 / unknown≈类）、方法子集语义（oracle ⊆ rebuilt）。
namespace Z42cProjectReconcileTests;

using Std;
using Std.Test;
using Z42.Project;
using Z42.IR;

// 构造单类单模块（供对比）。
ExportedModuleZ[] _mod(ExportedClassZ c) {
    ExportedClassZ[] cs = new ExportedClassZ[1]; cs[0] = c;
    ExportedModuleZ m = new ExportedModuleZ("Std", cs, 1,
        new ExportedInterfaceZ[0], 0, new ExportedEnumZ[0], 0,
        new ExportedFuncZ[0], 0, new ExportedDelegateZ[0], 0);
    ExportedModuleZ[] r = new ExportedModuleZ[1]; r[0] = m;
    return r;
}

ExportedClassZ _cls(ExportedFieldZ[] fields, int fc, ExportedMethodZ[] methods, int mc) {
    return new ExportedClassZ("Foo", true, "Object", fields, fc, methods, mc, new string[0], 0);
}

[Test]
void test_visibility_internal_eq_public() {
    // oracle 字段 internal（SymbolCollector 默认）vs rebuilt public（TYPE u8=0）→ 归一化相等。
    ExportedFieldZ[] fo = new ExportedFieldZ[1]; fo[0] = new ExportedFieldZ("x", "i32", "internal", false);
    ExportedFieldZ[] fr = new ExportedFieldZ[1]; fr[0] = new ExportedFieldZ("x", "i32", "public", false);
    string[] d = TsigReconcile.Compare(_mod(_cls(fo, 1, new ExportedMethodZ[0], 0)),
                                       _mod(_cls(fr, 1, new ExportedMethodZ[0], 0)));
    Assert.Equal(0, d.Length);
}

[Test]
void test_type_spelling_canon() {
    // byte↔u8、Std.Type↔Type（短名）、unknown≈类：字段类型双拼写归一。
    ExportedFieldZ[] fo = new ExportedFieldZ[2];
    fo[0] = new ExportedFieldZ("a", "byte", "public", false);
    fo[1] = new ExportedFieldZ("b", "Type", "public", false);
    ExportedFieldZ[] fr = new ExportedFieldZ[2];
    fr[0] = new ExportedFieldZ("a", "u8", "public", false);
    fr[1] = new ExportedFieldZ("b", "unknown", "public", false);
    string[] d = TsigReconcile.Compare(_mod(_cls(fo, 2, new ExportedMethodZ[0], 0)),
                                       _mod(_cls(fr, 2, new ExportedMethodZ[0], 0)));
    Assert.Equal(0, d.Length);
}

[Test]
void test_method_subset_extra_setter_ok() {
    // oracle 只有 get_X（TSIG 漏报 private set）；rebuilt 有 get_X + set_X（SIGS 齐全）→ 子集通过。
    ExportedMethodZ[] mo = new ExportedMethodZ[1];
    mo[0] = new ExportedMethodZ("get_X", "i32", "public", false, false, false, 0, new ExportedParamZ[0], 0);
    ExportedMethodZ[] mr = new ExportedMethodZ[2];
    mr[0] = new ExportedMethodZ("get_X", "i32", "public", false, false, false, 0, new ExportedParamZ[0], 0);
    ExportedParamZ[] sp = new ExportedParamZ[1]; sp[0] = new ExportedParamZ("p0", "i32");
    mr[1] = new ExportedMethodZ("set_X", "void", "private", false, false, false, 1, sp, 1);
    string[] d = TsigReconcile.Compare(_mod(_cls(new ExportedFieldZ[0], 0, mo, 1)),
                                       _mod(_cls(new ExportedFieldZ[0], 0, mr, 2)));
    Assert.Equal(0, d.Length);
}

[Test]
void test_method_missing_flagged() {
    // rebuilt 缺 oracle 的方法 → 必须报差异（子集语义只放行「多出」，不放行「缺失」）。
    ExportedMethodZ[] mo = new ExportedMethodZ[1];
    mo[0] = new ExportedMethodZ("Bar", "i32", "public", false, false, false, 0, new ExportedParamZ[0], 0);
    string[] d = TsigReconcile.Compare(_mod(_cls(new ExportedFieldZ[0], 0, mo, 1)),
                                       _mod(_cls(new ExportedFieldZ[0], 0, new ExportedMethodZ[0], 0)));
    Assert.True(d.Length > 0);
}
