namespace Check.App;

int Twice(int a) { return a + a; }

class Counter {
    int v;
    public int Bump(int d) { v = v + d; return v; }
}

void Main() {
    var c = new Counter();
    c.Bump(20);
    c.Bump(1);
    int x = Twice(c.Bump(0));
    int ok = 0;
    if (x == 42) { ok = 1; }
    int dummy = 100 / ok;
}
