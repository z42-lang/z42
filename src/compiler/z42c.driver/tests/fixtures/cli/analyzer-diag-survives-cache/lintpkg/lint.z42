namespace E2eLint;

using Z42.Syntax;
using Z42.Core;

public class E2eNoEmptyCatchAnalyzer : Analyzer {
    public DiagRule[] SupportedRules() { DiagRule[] r = new DiagRule[1]; r[0] = E2eNoEmptyCatchAnalyzer._rule(); return r; }
    public int[] ObservedKinds() { int[] k = new int[1]; k[0] = SyntaxKind.CatchClause; return k; }
    public void OnSyntaxNode(int kind, object node, DiagSink diags) {
        if (kind == SyntaxKind.CatchClause) {
            CatchClause c = node as CatchClause;
            if (c.Body is BlockStmt) { BlockStmt b = c.Body as BlockStmt; if (b.Count == 0) { diags.Report(E2eNoEmptyCatchAnalyzer._rule(), c.Span); } }
        }
    }
    static DiagRule _rule() { return new DiagRule("Z9002", "empty catch", "empty catch swallows exception", "Correctness", AnalyzerSeverity.Warning, true); }
}
