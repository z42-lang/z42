// `[plugins]` 条目 → 插件 zpkg，以及插件身份指纹。
//
// 四种条目形态（与 `[dependencies]` 同构，另加单文件）：
//   · `x = "1.0"`（无 path）：在 libsDirs 里找 `<name>.zpkg`；
//   · `x = { path = "x.zpkg" }`：现成产物，直接用（相对清单目录）；
//   · `x = { path = "../x" }`：定位该工程 manifest → 校验它确是插件工程 → **由 z42c 代建** → 取其 dist 的 `<name>.zpkg`；
//   · `x = { path = "hook.z42" }`（单文件）：合成最小插件清单（`PluginSynth.Synth`，落消费方 cache 目录）→ 与工程条目同一条代建路。一个源文件、零依赖的插件（hook 插件全是这个形态）免写 z42.toml；带 `[dependencies]` 的插件仍用完整工程形态（单文件写不出依赖）。
// 拿到 zpkg 后读头：名字须与条目一致，头里须有插件能力位（`PluginCaps`）——没有就是普通库，报错，不留到
// 加载后才发现「一个 handler 都没有」。z42c 只收**编译器侧**（analyzer / generator 位）的插件；只带 hook 位的
// 归 z42b，这里跳过。
//
// 🔴 **代建结果不并入消费方 libsDirs**（与 `[dependencies]` 的 path 闭包刻意不同）：插件只活在编译器进程里，
// 把它的 dist 并进依赖目录就等于让编译期扩展对运行期代码可见。故这里只把单个 zpkg 路径交出去。
//
// 代建用消费方的 isRelease/optSet，但 **libsDirs 一律不继承**（传 count=0）：插件工程自己会走它自己的
// path 依赖闭包 + Z42_LIBS + 编译器域解析域（`CompilerDomain.Dirs()`，按插件工程生效）。
namespace Z42.Driver;

using Std.IO;
using Z42.Package;
using Z42.Project;

// 解析结果：Code==0 → 编译器侧插件的 Names / Paths（并行、按清单顺序，供指纹与 CompileInputs 共用）；
// Code!=0 → 解析失败，诊断已打印，调用方直接返回该退出码。
public sealed class PluginZpkgs {
    public string[] Names;
    public string[] Paths;
    public int      Count;
    public int      Code;
    public PluginZpkgs(string[] names, string[] paths, int count, int code) {
        this.Names = names; this.Paths = paths; this.Count = count; this.Code = code;
    }
}

// 返回 false = 失败（诊断已打印）；成功 → names/paths 填编译器侧插件（并行、清单序）。数组输出而非
// PluginZpkgs 类型：进程内一旦加载过插件（probing 目录扫描把 driver dist 副本注册成重名包），任何
// 自定义类型的按名实例化都会被 VM 拒——显式与携带两条路径统一走数组（E0601 同源的混合域防御）。
bool _resolvePluginZpkgs(ProjectManifest pm, string projectDir, string consumerToml,
                         string[] libsDirs, int libsDirsN,
                         bool isRelease, bool noIncremental, int cliAdd, int cliRemove,
                         ref string[] names, ref string[] paths) {
    string[] locNames = new string[pm.PluginCount > 0 ? pm.PluginCount : 1];
    string[] locPaths = new string[pm.PluginCount > 0 ? pm.PluginCount : 1];
    int n = 0;
    int ai = 0;
    while (ai < pm.PluginCount) {
        DepEntry e = pm.Plugins[ai];
        ai = ai + 1;
        string got = "";
        if (e.IncludeCount > 0) {
            // 源集条目（plugins-include-form，对齐 [tests]）：合成最小清单后与工程条目同一条代建路。
            got = _pluginFromProject(pm, e, projectDir, consumerToml, isRelease, noIncremental, cliAdd, cliRemove);
        } else if (e.Path.Length == 0) {
            got = _pluginFromLibs(e.Name, libsDirs, libsDirsN);
        } else if (e.Path.EndsWith(".zpkg")) {
            got = _pluginFromZpkgFile(e.Name, e.Path, projectDir);
        } else {
            got = _pluginFromProject(pm, e, projectDir, consumerToml, isRelease, noIncremental, cliAdd, cliRemove);
        }
        if (got.Length == 0) { return false; }
        int caps = _checkPluginZpkg(e.Name, got);
        if (caps < 0) { return false; }
        if (PluginCaps.ForCompiler(caps)) { locNames[n] = e.Name; locPaths[n] = got; n = n + 1; }
    }
    if (n > 0) {
        string[] n2 = new string[n];
        string[] p2 = new string[n];
        int x = 0;
        while (x < n) { n2[x] = locNames[x]; p2[x] = locPaths[x]; x = x + 1; }
        names = n2; paths = p2;
    }
    return true;
}

// 读插件 zpkg 的头与 META（判据与措辞共用 z42.package 的 `PluginZpkg.Inspect`）：通过 → 能力位；否则打印诊断返回 -1。
int _checkPluginZpkg(string name, string zpkgPath) {
    PluginInspection pi = PluginZpkg.Inspect(zpkgPath, name);
    if (pi.Error.Length > 0) { ConsoleError.WriteLine("z42c build: " + pi.Error); return -1; }
    return pi.Caps;
}

// path 条目 → 插件工程清单路径（带清单目录 = 定位；免清单单文件/目录 = PluginSynth 合成，落消费方
// cache 目录）；失败打印诊断返回 ""。三形态：`.z42` 单文件（include = 源文件绝对路径）、无清单目录
//（include = <abs>/**/*.z42 递归全收；一个源都没有 ⇒ 明确报错，不静默合成出「no sources matched」）、
// 带清单目录（判据委托 `ManifestLocator.FindIn`——裸 `z42.toml` 优先，同 `PathDepPlan._resolveDepToml`）。
// path 条目（工程目录 / 免清单目录 / 单文件源码）+ 源集条目（include/exclude）→ 插件工程清单路径
//（带清单目录 = 定位；免清单 = PluginSynth 合成，落消费方 cache 目录）；失败打印诊断返回 ""。
string _pluginToml(ProjectManifest pm, DepEntry e, string projectDir, bool isRelease) {
    string aname = e.Name;
    string cacheDir = BuildLayout.Resolve(pm, projectDir, isRelease).CacheDir;
    if (e.IncludeCount > 0) {
        // 源集与 path 互斥：都写时源集静默赢会让人以为 path 也生效。
        if (e.Path.Length > 0) {
            ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 同时写了 include 与 path——二者互斥："
                + "源码集用 include/exclude（相对本工程目录），插件工程用 path。");
            return "";
        }
        string stoml = PluginSynth.SynthSet(cacheDir, aname, projectDir, e.Include, e.IncludeCount, e.Exclude, e.ExcludeCount);
        if (stoml.Length == 0) {
            ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的源集 include 一个 .z42 都没匹配到——"
                + "检查 glob（须以文件模式收尾，如 `hooks/**/*.z42`）。");
        }
        return stoml;
    }
    string adir = Path.Join(projectDir, e.Path);
    if (e.Path.EndsWith(".z42")) {
        string asrc = Path.IsRooted(e.Path) ? e.Path : adir;
        if (!File.Exists(asrc)) {
            ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的 path 指向 " + asrc + "，文件不存在。");
            return "";
        }
        string ftoml = PluginSynth.SynthFile(cacheDir, aname, asrc);
        if (ftoml.Length == 0) {
            ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的单文件插件清单合成失败（源文件 " + asrc
                + "，落点在消费方 cache 目录）。");
        }
        return ftoml;
    }
    ManifestLocation aloc = ManifestLocator.FindIn(adir);
    if (aloc.Kind == ManifestLocateKind.Project) { return aloc.ManifestPath; }
    if (aloc.Kind == ManifestLocateKind.NotFound && Directory.Exists(adir)) {
        string dtoml = PluginSynth.SynthDir(cacheDir, aname, adir);
        if (dtoml.Length == 0) {
            ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的 path 指向 " + adir
                + "，那里既没有工程清单，也没有任何 .z42 源文件——目录条目要么是插件工程（带清单），"
                + "要么至少放一个 .z42 源（免清单全收）。");
        }
        return dtoml;
    }
    ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的 path 指向 " + adir
        + "，那里没有单个工程清单"
        + (aloc.Kind == ManifestLocateKind.Ambiguous ? "（同层有多份 *.z42.toml）"
           : (aloc.Kind == ManifestLocateKind.Workspace ? "（那是一个 workspace）"
              : "（目录不存在）")) + "。");
    return "";
}

// path 条目（工程目录 / 免清单目录 / 单文件源码）+ 源集条目：定位（或合成）→ 校验 kind → 代建 →
// dist 里的 `<name>.zpkg`。失败打印诊断并返回 ""。
string _pluginFromProject(ProjectManifest pm, DepEntry e, string projectDir, string consumerToml,
                          bool isRelease, bool noIncremental, int cliAdd, int cliRemove) {
    string aname = e.Name;
    string atoml = _pluginToml(pm, e, projectDir, isRelease);
    if (atoml.Length == 0) { return ""; }
    // 自指 → 无限递归。消费方自己就是插件工程时最容易写出来（`path = "."`）。
    if (_samePath(atoml, consumerToml)) {
        ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的 path 指回本工程自身（"
            + atoml + "）——插件不能挂在自己身上。");
        return "";
    }
    ProjectManifest apm = ManifestLoader.Load(atoml);
    // `[plugins]` 只收插件工程。放进来的若是普通库，失败模式是「加载成功、什么都不做」——一个静默空转。
    if (!apm.Project.IsPlugin()) {
        ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 指向的工程 " + atoml
            + " 是 kind = \"" + apm.Project.Kind + "\"，不是 \"plugin\"。"
            + "插件工程须声明 kind = \"plugin\"——它决定该工程能否引用编译器契约包，也决定它不会被链入目标产物。");
        return "";
    }
    if (apm.Project.Name != aname) {
        ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的 path 指向的工程名是 `"
            + apm.Project.Name + "`——两者须一致（同 [dependencies] 的 path 依赖约定）。");
        return "";
    }
    // 代建（插件是宿主进程要加载的东西，恒按本机构建；z42c 无目标 rid 概念，天然如此）。
    int bc = _build(atoml, isRelease, "", "", new string[0], 0, noIncremental, cliAdd, cliRemove, false, null, "");   // [plugins] 条目禁 internal（环），恒空
    if (bc != 0) {
        ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的工程构建失败（见上）。");
        return "";
    }
    string adistDir = BuildLayout.Resolve(apm, Path.GetDirectoryName(atoml), isRelease).DistDir;
    string cand = Path.Join(adistDir, aname + ".zpkg");
    if (!File.Exists(cand)) {
        ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 构建后仍未见 " + cand + "。");
        return "";
    }
    return cand;
}

// path 条目（`.zpkg` 产物）：相对清单目录；不存在 → 诊断返回 ""。名字与能力位由 `_checkPluginZpkg` 校验。
string _pluginFromZpkgFile(string aname, string apath, string projectDir) {
    string cand = Path.IsRooted(apath) ? apath : Path.Join(projectDir, apath);
    if (!File.Exists(cand)) {
        ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 的 path 指向 " + cand + "，文件不存在。");
        return "";
    }
    return cand;
}

// 名字条目：**插件目录**里找 `<name>.zpkg`——刻意不查 libsDirs（那是运行期解析域：NSPC 前缀兜底、
// glob 追加、包枚举都把里面的东西当普通库，插件混进去会污染它们，unify-plugin-packages 的查找域分离）。
// 查找序：`Z42_PLUGINS`（显式，形态同 Z42_LIBS 的单目录）→ 各 libsDir 的**同级** `plugins/`
// （SDK 布局：libs 的同级即 <sdk>/plugins；开发树的 dist 目录通常没有这个同级，名字条目本就面向分发态）。
// 失败打印诊断（含**找过哪些目录**）并返回 ""。
string[] _pluginSearchDirs(string[] libsDirs, int libsDirsN) {
    // 查找域规则唯一定义在 z42.project 的 `PluginDirs.Search()`（Z42_PLUGINS → Z42_HOME/plugins，
    // 刻意不含 libs 同级 plugins/——理由见上注与 PluginDirs 头注）；driver / z42b / pipeline 三处共用。
    return PluginDirs.Search();
}

// ── [dependencies] 插件分流（deps-plugin-routing）──────────────────────────────
// `[dependencies]` 条目按 zpkg 头自述分流：lib（普通运行期依赖，照旧）或 **plugin**（加载进
// 工具链进程：不进 libsDirs / 不链入产物 / 不参与 bundle——z42c 只收编译器侧位，hook 位归 z42b）。
// 判据是构造保证的：能力位只在 kind = "plugin" 构建时写头（`PackageCompile._derivePluginCaps`
// 有 kind 门），lib/exe 恒 0 ⇒ 「头里标着插件」⇔「它就是插件包」。
//
// 解析规则（名字条目）：
//   · libsDirs 里先看：命中且是插件 ⇒ **报错**（插件包混进运行期解析域——查找域分离的不变量，
//     不静默放行也不静默改道）；命中且不是插件 ⇒ 普通依赖，不归这里管。
//   · libsDirs 没有 → 插件目录（PluginDirs.Search()）找 `<name>.zpkg`：命中且是插件 ⇒ 分流；
//     命中但不是插件 / 哪都没有 ⇒ 留给 `_verifyDeclaredDeps` 报「未找到」（错误信息在用户熟悉的地方）。
// path 条目：`.zpkg` 直连（开包验插件位；`.zpkg` path 的存在性/包名校验由 `_zpkgRefDirs` 先行，
// 那里同时负责**不把**插件包的目录并进 libsDirs）；工程目录条目不归这里——`PathDepBuild`
// 对 kind = "plugin" 的拒绝保持不变（源码形态的插件引用属于 [plugins]）。
//
// 返回 false = 失败（诊断已打印）；成功 → names/paths 为**全部**插件位（编译器侧过滤由调用方做，
// 同 `_resolvePluginZpkgs` 的口径）。
bool _pluginDepZpkgs(ProjectManifest pm, string projectDir, string[] libsDirs, int libsDirsN,
                     ref string[] names, ref string[] paths) {
    string[] locNames = new string[pm.DepCount > 0 ? pm.DepCount : 1];
    string[] locPaths = new string[pm.DepCount > 0 ? pm.DepCount : 1];
    int n = 0;
    int i = 0;
    while (i < pm.DepCount) {
        DepEntry e = pm.Deps[i];
        i = i + 1;
        if (e.Path.Length == 0) {
            // 名字条目：libs 先（命中插件 = 污染，报错），插件目录后。
            string f = e.Name + ".zpkg";
            int d = 0;
            string libsHit = "";
            while (d < libsDirsN) {
                string cand = Path.Join(libsDirs[d], f);
                if (File.Exists(cand)) { libsHit = cand; break; }
                d = d + 1;
            }
            if (libsHit.Length > 0) {
                ZpkgInfo info = null;
                try { info = ZpkgReader.Open(File.ReadAllBytes(libsHit), libsHit); } catch (Exception ex) { info = null; }
                if (info != null && PluginCaps.IsPlugin(info.PluginCaps)) {
                    ConsoleError.WriteLine("z42c build: [dependencies] `" + e.Name + "`（" + libsHit
                        + "）是插件包（" + PluginCaps.Describe(info.PluginCaps) + "）——插件包不进运行期解析域："
                        + "把它移到插件目录（Z42_PLUGINS / <sdk>/plugins）后按名依赖，或改写到 [plugins] 段。");
                    return false;
                }
                continue;   // 普通库（或读不开——留给存在性校验报）
            }
            string got = _pluginLookup(e.Name, libsDirs, libsDirsN, true);   // 安静：找不到不是这里的错
            if (got.Length == 0) { continue; }
            ZpkgInfo pi = null;
            try { pi = ZpkgReader.Open(File.ReadAllBytes(got), got); } catch (Exception ex) { pi = null; }
            if (pi == null || !PluginCaps.IsPlugin(pi.PluginCaps)) { continue; }   // 插件目录里的非插件：不认领
            locNames[n] = e.Name; locPaths[n] = got; n = n + 1;
        } else if (e.Path.EndsWith(".zpkg")) {
            string full = Path.IsRooted(e.Path) ? e.Path : Path.Join(projectDir, e.Path);
            ZpkgInfo pi = null;
            try { pi = ZpkgReader.Open(File.ReadAllBytes(full), full); } catch (Exception ex) { pi = null; }
            if (pi == null || !PluginCaps.IsPlugin(pi.PluginCaps)) { continue; }   // 普通 .zpkg 依赖照旧
            locNames[n] = e.Name; locPaths[n] = full; n = n + 1;
        }
    }
    if (n > 0) {
        string[] n2 = new string[n];
        string[] p2 = new string[n];
        int x = 0;
        while (x < n) { n2[x] = locNames[x]; p2[x] = locPaths[x]; x = x + 1; }
        names = n2; paths = p2;
    }
    return true;
}

string _pluginFromLibs(string aname, string[] libsDirs, int libsDirsN) {
    return _pluginLookup(aname, libsDirs, libsDirsN, false);
}

// 安静版查找（lenient 阶段用）：找不到返回 "" 不打印——尽力而为的语义不该刷屏。
string _pluginLookup(string aname, string[] libsDirs, int libsDirsN, bool quiet) {
    string azfile = aname + ".zpkg";
    string[] dirs = _pluginSearchDirs(libsDirs, libsDirsN);
    int d = 0;
    while (d < dirs.Length) {
        string cand = Path.Join(dirs[d], azfile);
        if (File.Exists(cand)) { return cand; }
        d = d + 1;
    }
    string searched = "";
    int sd = 0;
    while (sd < dirs.Length) {
        searched = searched + (sd > 0 ? ", " : "") + dirs[sd];
        sd = sd + 1;
    }
    if (dirs.Length == 0) { searched = "(无插件目录——未设 Z42_PLUGINS / Z42_HOME/plugins)"; }
    if (!quiet) {
        ConsoleError.WriteLine("z42c build: [plugins] `" + aname + "` 未在插件目录找到 " + azfile
            + "；已查找：" + searched
            + "。插件目录与依赖目录（libs）刻意分开：普通库放 libs、插件放 plugins（或 Z42_PLUGINS）。"
            + "也可改用 `{ path = \"...\" }`（指向插件工程目录让 z42c 代建，或直接指向 .zpkg / 单个 .z42 源文件）。");
    }
    return "";
}

// 插件身份指纹：按插件名稳定序（禁依赖清单声明顺序碰巧）拼「名:zpkg 内容指纹」，揉进每个文件的源 hash ⇒
// 「换了 generator 但源没变」也令所有缓存失效（产物纳入指纹）。只含编译器侧插件——hook 不影响编译产物。
// 无编译器侧插件 → `""`（源 hash 不揉入 → 自举 byte-identical）。
string _pluginFingerprint(string[] names, string[] paths) {
    if (names == null || names.Length == 0) { return ""; }
    int p = 0;
    while (p < names.Length) {
        int min = p; int q = p + 1;
        while (q < names.Length) { if (names[q].CompareTo(names[min]) < 0) { min = q; } q = q + 1; }
        if (min != p) {
            string t = names[p]; names[p] = names[min]; names[min] = t;
            string tp = paths[p]; paths[p] = paths[min]; paths[min] = tp;
        }
        p = p + 1;
    }
    string acc = "";
    int i = 0;
    while (i < names.Length) {
        if (File.Exists(paths[i])) {
            acc = acc + names[i] + ":" + _bytesFp(File.ReadAllBytes(paths[i])) + ";";
        } else {
            acc = acc + names[i] + ":missing;";
        }
        i = i + 1;
    }
    return acc;
}

// ── 携带解析（1c 自动导入）────────────────────────────────────────────────────
// 消费方闭包里 lib 的 PLGS 段 → 自动并入生效集。规则：
//   · 只走**真在闭包里**的包（声明的名条目 + path 闭包；传递经各 dep zpkg 的 DEPS 段 BFS）——
//     躺在 libs 目录里但没被依赖的包，携带不生效；
//   · 显式 [plugins] 赢携带；同名携带先到先得（BFS 序：声明序 → 各 DEPS 段序）；
//   · `[plugins] "x" = false` 把携带的 x 摘掉；
//   · 按名在插件目录解析；找到但版本与携带钉的不符 → 报错点名携带者（不静默用旧版）；
//     找不到 → 报错点名携带者（携带是发布承诺，缺件即失败）。
// 返回与 _resolvePluginZpkgs 同形：编译器侧（analyzer / generator 位）插件；无携带 → Count == 0。
// 失败 → Code != 0（诊断已打印）。
// 返回 false = 失败（诊断已打印）；成功且无携带 → names 置 null。数组输出避免在 Main 的新路径上
// 使用 PluginZpkgs 类型（夹具域里 driver 双载时自定义类型按名实例化会被拒——E0601 同源）。
bool _resolveCarriedPlugins(ProjectManifest pm, string[] libsDirs, int libsDirsN, ref string[] names, ref string[] paths,
                            bool wsMember) {
    // workspace 成员构建（仓库自举）不做携带解析：受众是测试单元与用户工程；自举进程的解析域
    // 混着种子/成员两代编译器包，插件加载链会触发双代注册。
    if (wsMember) { return true; }
    // 编译器域消费方（z42c.* 成员 / SDK 契约与编排包）不做携带解析：工具链自举是内景，不是用户场景，
    // 且自举进程的 flat 里躺着上一代 driver——携带插件一旦加载，其编译器域依赖链会把旧代 driver
    // 拉进同一进程（双代注册、类型按名实例化被拒）。库包携带只在用户工程 / stdlib 成员上生效。
    if (_isToolchainProject(pm.Project.Name)) { return true; }
    // 插件工程自身也不做携带：它是被加载物、不是 lint 受众；显式 [plugins] 的 path 代建会嵌套构建
    // 插件工程——在那里加载别的插件会把宿主进程搞成混合域（见上）。
    if (pm.Project.IsPlugin()) { return true; }
    // 闭包 BFS 的名字队列：0 层 = 消费方声明的依赖（清单序）。
    // 两阶段（harness-as-plugin 定案）：
    //   阶段一「声明闭包」——0 层 = 清单声明的依赖，传递经 DEPS。携带是**硬承诺**：缺件/版本不符报错
    //   （点名携带方）。这是 1c 的语义，plugin-carry-missing 等夹具钉着它。
    //   阶段二「ambient 标准库」——0 层 = 解析域里的标准库包（免声明、总是可见，W0610 口径），携带
    //   **尽力而为**：缺件/版本不符静默跳过——插件世界不完整的环境（只配了自己那颗插件的开发夹具）
    //   不该被 harness 的携带判死。z42.harness → z42.harness.lint 经此到达每个测试工程。
    string[] queue = new string[192];
    int qn = 0;
    int i = 0;
    while (i < pm.DepCount && qn < 192) { queue[qn] = pm.Deps[i].Name; qn = qn + 1; i = i + 1; }
    // path 闭包成员也在解析域里（dists 已并入 libsDirs；名字来自闭包计划）——由调用方透传更准确，
    // 但 path 依赖同样出现在 pm.Deps（path 条目也写 [dependencies]）⇒ 0 层已覆盖。
    string[] visitedPkg = new string[128];
    int vn = 0;
    // 去重名集：显式 [plugins] 的名先占位（显式赢携带）。
    string[] taken = new string[128 + pm.PluginCount];
    int tn = 0;
    i = 0;
    while (i < pm.PluginCount) { taken[tn] = pm.Plugins[i].Name; tn = tn + 1; i = i + 1; }
    string[] rnames = new string[64];
    string[] rpaths = new string[64];
    int rn = 0;
    int qi = 0;
    while (qi < qn) {
        string dep = queue[qi];
        qi = qi + 1;
        if (dep == pm.Project.Name) { continue; }   // 自身不算自己的闭包（[plugins.export] 不自用）
        bool seen = false;
        int v = 0;
        while (v < vn) { if (visitedPkg[v] == dep) { seen = true; break; } v = v + 1; }
        if (seen || vn >= 192) { continue; }
        visitedPkg[vn] = dep; vn = vn + 1;
        string zpath = _findDepZpkg(dep, libsDirs, libsDirsN);
        if (zpath.Length == 0) { continue; }   // 声明了但解析不到：E0497/依赖解析的职责，不在携带层重复报
        ZpkgInfo info = null;
        try { info = ZpkgReader.Open(File.ReadAllBytes(zpath), zpath); } catch (Exception ex) { info = null; }
        if (info == null) { continue; }
        // 传递：把该包自己的 DEPS 入队（按段序，确定性）。
        string[] trans = ZpkgReader.ReadDependencies(info);
        int t = 0;
        while (t < trans.Length && qn < 128) { queue[qn] = trans[t]; qn = qn + 1; t = t + 1; }
        // 携带方是消费方自己（含 <parent>.test.<unit> 这类派生名——父包的测试单元）⇒ 携带按
        // lenient 处理：export 声明的受众是「别的工程」，不是携带者自己的测试单元硬承诺。
        bool selfCarry = pm.Project.Name == dep || pm.Project.Name.StartsWith(dep + ".");
        if (!_carryOne(pm, dep, info, libsDirs, libsDirsN, taken, ref tn, rnames, rpaths, ref rn, selfCarry)) { return false; }
    }
    // 阶段二：ambient 标准库（软失败）——抽到 _carryAmbientPhase。
    _carryAmbientPhase(pm, libsDirs, libsDirsN, visitedPkg, ref vn, taken, ref tn, rnames, rpaths, ref rn);
    if (rn > 0) {
        string[] rn2 = new string[rn];
        string[] rp2 = new string[rn];
        int x = 0;
        while (x < rn) { rn2[x] = rnames[x]; rp2[x] = rpaths[x]; x = x + 1; }
        names = rn2; paths = rp2;
    }
    return true;
}

// 在依赖目录里按名找 zpkg（闭包 BFS 的定位器；不做插件目录查找——那是 _pluginFromLibs 的职责）。
string _findDepZpkg(string name, string[] libsDirs, int libsDirsN) {
    string f = name + ".zpkg";
    int d = 0;
    while (d < libsDirsN) {
        string cand = Path.Join(libsDirs[d], f);
        if (File.Exists(cand)) { return cand; }
        d = d + 1;
    }
    return "";
}

// 一个依赖 zpkg 的携带条目逐条并入。失败（缺件 / 版本不符）→ false（诊断点名携带方）。
bool _carryOne(ProjectManifest pm, string dep, ZpkgInfo info, string[] libsDirs, int libsDirsN,
               string[] taken, ref int tn, string[] rnames, string[] rpaths, ref int rn, bool lenient) {
    int c = 0;
    while (c < info.CarriedCount) {
        PluginCarryZ carry = info.Carried[c];
        c = c + 1;
        string pname = carry.Name;
        if (pname == pm.Project.Name) { continue; }   // 携带者就是自己（z42.harness.lint 经 ambient 引到自身）——export 不自用
        bool skip = false;
        int d = 0;
        while (d < pm.PluginDisableCount) { if (pm.PluginDisables[d] == pname) { skip = true; break; } d = d + 1; }
        if (skip) { continue; }
        int k = 0;
        while (k < tn) { if (taken[k] == pname) { skip = true; break; } k = k + 1; }
        if (skip) { continue; }
        string got = _pluginLookup(pname, libsDirs, libsDirsN, lenient);
        if (got.Length == 0) {
            if (lenient) { continue; }
            ConsoleError.WriteLine("z42c build: 依赖 `" + dep + "` 携带插件 `" + pname + "`（" + carry.Version
                + "），但插件目录里没有 " + pname + ".zpkg——携带是发布承诺：把该插件放进插件目录"
                + "（Z42_PLUGINS / Z42_HOME/plugins），或用 [plugins] `" + pname + "` = false 关闭它。");
            return false;
        }
        ZpkgInfo pi = null;
        try { pi = ZpkgReader.Open(File.ReadAllBytes(got), got); } catch (Exception ex) { pi = null; }
        if (pi == null || pi.Version != carry.Version) {
            if (lenient) { continue; }
            ConsoleError.WriteLine("z42c build: 依赖 `" + dep + "` 携带插件 `" + pname + "` 钉的是 "
                + carry.Version + "，插件目录里那份是 " + (pi == null ? "?" : pi.Version)
                + "——版本对不齐（不静默用别的版本）。重装匹配版本，或与携带方同步升级。");
            return false;
        }
        taken[tn] = pname; tn = tn + 1;
        if (PluginCaps.ForCompiler(pi.PluginCaps) && rn < 64) { rnames[rn] = pname; rpaths[rn] = got; rn = rn + 1; }
    }
    return true;
}

// 工具链内部工程（自举域）不做携带：消费方是 z42c.* / SDK 契约与编排包及其内嵌工程（前缀
// 匹配，如 z42.builder.hooks、xtask.hooks）。自举进程解析域混着种子/成员两代编译器包，插件
// 加载链会触发双代注册；库包携带只面向测试单元与用户工程。
bool _isToolchainProject(string name) {
    string[] roots = new string[9];
    roots[0] = "z42c."; roots[1] = "z42.build"; roots[2] = "z42.project"; roots[3] = "z42.package";
    roots[4] = "z42.doc"; roots[5] = "z42.scripting"; roots[6] = "z42.repl"; roots[7] = "z42.builder"; roots[8] = "xtask";
    int i = 0;
    while (i < roots.Length) {
        if (name == roots[i] || name.StartsWith(roots[i] + ".")) { return true; }
        i = i + 1;
    }
    return false;
}

// 环境域标准库集：解析域里各目录的 *.zpkg 名（去重、按名排序——确定性）。这些包免声明、总是可见，
// 它们的 PLGS 携带对每个消费方生效（harness-as-plugin：z42.harness → z42.harness.lint）。
string[] _ambientStdlib(string[] libsDirs, int libsDirsN) {
    string[] acc = new string[64];
    int n = 0;
    int d = 0;
    while (d < libsDirsN && n < 64) {
        string[] files = Path.Glob(libsDirs[d], "*.zpkg");
        int f = 0;
        while (f < files.Length && n < 64) {
            string nm = Path.GetFileName(files[f]);
            nm = nm.Substring(0, nm.Length - 5);
            // 编译器域包不作携带载体：z42c.* 前缀 + SDK 契约/编排包（z42.build 等）。它们不面向
            // 用户工程分发，且冷自举时 flat 里躺着种子代 driver——打开它会把双代 driver 拉进
            // 同一进程（类型按名实例化被拒）。携带只对库包有意义。
            if (nm.StartsWith("z42c.") || nm == "z42.build" || nm == "z42.project" || nm == "z42.package"
                || nm == "z42.doc" || nm == "z42.scripting" || nm == "z42.repl") { f = f + 1; continue; }

            bool has = false;
            int k = 0;
            while (k < n) { if (acc[k] == nm) { has = true; break; } k = k + 1; }
            if (!has) { acc[n] = nm; n = n + 1; }
            f = f + 1;
        }
        d = d + 1;
    }
    int i2 = 1;
    while (i2 < n) {
        string x = acc[i2];
        int j = i2 - 1;
        while (j >= 0 && acc[j].CompareTo(x) > 0) { acc[j + 1] = acc[j]; j = j - 1; }
        acc[j + 1] = x;
        i2 = i2 + 1;
    }
    string[] r = new string[n];
    i2 = 0;
    while (i2 < n) { r[i2] = acc[i2]; i2 = i2 + 1; }
    return r;
}

// 阶段二：ambient 标准库携带（名字序、已在阶段一访问过的跳过、缺件静默——见 _resolveCarriedPlugins 头注）。
void _carryAmbientPhase(ProjectManifest pm, string[] libsDirs, int libsDirsN,
                        string[] visitedPkg, ref int vn, string[] taken, ref int tn,
                        string[] rnames, string[] rpaths, ref int rn) {
    string[] ambient = _ambientStdlib(libsDirs, libsDirsN);
    int ai = 0;
    while (ai < ambient.Length) {
        string dep = ambient[ai];
        ai = ai + 1;
        if (dep == pm.Project.Name) { continue; }
        bool seen = false;
        int v = 0;
        while (v < vn) { if (visitedPkg[v] == dep) { seen = true; break; } v = v + 1; }
        if (seen || vn >= 192) { continue; }
        visitedPkg[vn] = dep; vn = vn + 1;
        string zpath = _findDepZpkg(dep, libsDirs, libsDirsN);
        if (zpath.Length == 0) { continue; }
        ZpkgInfo info = null;
        try { info = ZpkgReader.Open(File.ReadAllBytes(zpath), zpath); } catch (Exception ex) { info = null; }
        if (info == null) { continue; }
        _carryOne(pm, dep, info, libsDirs, libsDirsN, taken, ref tn, rnames, rpaths, ref rn, true);
    }
}
