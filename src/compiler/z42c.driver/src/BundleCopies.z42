namespace Z42.Driver;

using Std.IO;
using Std.Crypto;
using Std.Encoding;
using Z42.IR;

// Paths in a receipt and in an indexed package must stay relative to dist.
bool _bundlePayloadRel(string rel) {
    if (rel.Length == 0 || Path.IsRooted(rel) || Path.Normalize(rel) != rel
        || rel.IndexOf("\\") >= 0 || rel.IndexOf(":") >= 0 || rel.IndexOf("\t") >= 0
        || rel.IndexOf("\n") >= 0 || rel.IndexOf("\r") >= 0 || rel.StartsWith("../")) { return false; }
    return rel.EndsWith(".zpkg") || rel.EndsWith(".zsym") || rel.EndsWith(".zbc");
}

public sealed class BundleCopy {
    public string Source;
    public string Hash;
    public BundleCopy(string source, string hash) { this.Source = source; this.Hash = hash; }
}

// A receipt is scoped to the project even when multiple executables share dist.
public sealed class BundleCopies {
    private string _dist;
    private string _receipt;
    private StrMap _planned;
    private StrMap _protected;

    public BundleCopies(string dist, string project, StrMap ownFiles) {
        this._dist = dist;
        this._receipt = ".z42-deps-" + _bytesHexZ(Blake3.HashLen(Utf8.GetBytes(project), 16));
        this._planned = new StrMap();
        this._protected = ownFiles;
    }

    public void Add(string rel, string source, byte[] bytes) {
        if (!_bundlePayloadRel(rel)) { throw new Exception("unsafe deployment payload path: " + rel); }
        if (this._protected.ContainsKey(rel)) { throw new Exception("deployment payload collides with project output: " + rel); }
        this._planned.Put(rel, new BundleCopy(source, this._hash(bytes)));
    }

    public void Keep(string rel) { this._protected.Put(rel, ""); }

    private string _hash(byte[] bytes) { return _bytesHexZ(Blake3.HashLen(bytes, 16)); }

    private string _fileHash(string path) {
        if (!File.Exists(path) || Directory.Exists(path)) { return ""; }
        return this._hash(File.ReadAllBytes(path));
    }

    private StrMap _read(string body) {
        StrMap result = new StrMap();
        if (body.Length == 0) { return result; }
        if (!body.StartsWith("Z42-DEPS1\n")) { throw new Exception("invalid dependency copy receipt"); }
        foreach (var line in body.Split("\n")) {
            if (line.Length == 0 || line == "Z42-DEPS1") { continue; }
            string[] row = line.Split("\t");
            if (row.Length != 2 || !_bundlePayloadRel(row[0]) || row[1].Length == 0) {
                throw new Exception("invalid dependency copy receipt entry");
            }
            result.Put(row[0], row[1]);
        }
        return result;
    }

    private string _readText(string path) {
        return File.Exists(path) ? File.ReadAllText(path) : "";
    }

    private bool _owns(StrMap receipt, string rel, string hash) {
        if (hash.Length == 0 || !receipt.ContainsKey(rel)) { return false; }
        string recorded = receipt.Get(rel) as string;
        foreach (var entry in recorded.Split(",")) { if (entry == hash) { return true; } }
        return false;
    }

    private string _serialize(StrMap entries) {
        if (entries.Count() == 0) { return ""; }
        string body = "Z42-DEPS1\n";
        foreach (var rel in entries.Keys()) { body = body + rel + "\t" + (entries.Get(rel) as string) + "\n"; }
        return body;
    }

    private StrMap _otherOwners() {
        StrMap owners = new StrMap();
        foreach (var name in Directory.Enumerate(this._dist)) {
            if (!name.StartsWith(".z42-deps-") || name == this._receipt) { continue; }
            StrMap receipt = this._read(this._readText(Path.Join(this._dist, name)));
            foreach (var rel in receipt.Keys()) {
                string current = receipt.Get(rel) as string;
                if (owners.ContainsKey(rel)) { current = (owners.Get(rel) as string) + "," + current; }
                owners.Put(rel, current);
            }
        }
        return owners;
    }

    public void Apply() {
        string path = Path.Join(this._dist, this._receipt);
        string oldBody = this._readText(path);
        StrMap previous = this._read(oldBody);
        StrMap next = new StrMap();
        StrMap journal = this._read(oldBody);
        StrMap writes = new StrMap();
        StrMap others = null;
        foreach (var rel in this._planned.Keys()) {
            BundleCopy copy = this._planned.Get(rel) as BundleCopy;
            string current = this._fileHash(Path.Join(this._dist, rel));
            bool owned = this._owns(previous, rel, current);
            if (current == copy.Hash && !owned) {
                if (others == null) { others = this._otherOwners(); }
                if (!this._owns(others, rel, current)) { continue; }
                journal.Put(rel, copy.Hash);
            }
            next.Put(rel, copy.Hash);
            if (current != copy.Hash) {
                writes.Put(rel, copy);
                journal.Put(rel, owned ? current + "," + copy.Hash : copy.Hash);
            }
        }
        string journalBody = this._serialize(journal);
        if (journalBody != oldBody) { File.WriteAllTextAtomic(path, journalBody); }
        this._copy(writes);
        this._retire(previous, others);
        string nextBody = this._serialize(next);
        if (nextBody != journalBody) {
            if (nextBody.Length == 0) { File.Delete(path); }
            else { File.WriteAllTextAtomic(path, nextBody); }
        }
    }

    private void _copy(StrMap writes) {
        foreach (var rel in writes.Keys()) {
            BundleCopy copy = writes.Get(rel) as BundleCopy;
            byte[] bytes = File.ReadAllBytes(copy.Source);
            if (this._hash(bytes) != copy.Hash) { throw new Exception("dependency changed while deploying: " + copy.Source); }
            string target = Path.Join(this._dist, rel);
            Directory.Create(Path.GetDirectoryName(target));
            File.WriteAllBytesAtomic(target, bytes);
        }
    }

    private void _retire(StrMap previous, StrMap others) {
        foreach (var rel in previous.Keys()) {
            if (this._planned.ContainsKey(rel) || this._protected.ContainsKey(rel)) { continue; }
            string target = Path.Join(this._dist, rel);
            if (!this._owns(previous, rel, this._fileHash(target))) { continue; }
            if (others == null) { others = this._otherOwners(); }
            if (!others.ContainsKey(rel)) { File.Delete(target); }
        }
    }
}
