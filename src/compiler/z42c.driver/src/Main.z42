// z42c driver — 自举编译器 CLI 入口（= z42c）。增量解锁命令；绝不 fallback 到 C# z42c.dll。
// 已实现：
//   z42c --dump-tokens <file.z42>          词法 token 流（z42c 自有格式）
//   z42c --dump-ast    <file.z42>          AST s-expression
//   z42c --dump-bound  <file.z42>          类型检查后的 Bound 树（含类型注解 + 诊断数）
//   z42c --emit-zbc    <file.z42> <out> [--opt-all]   编译到 .zbc（ZW-1A/1B opcode 子集；无 DBUG）
//                                          --opt-all = 按 release 全优化编（golden 的 opt_all sidecar 用）
//   z42c build         <project.z42.toml>  编译整包 → dist/<name>.zpkg
// 注：z42c 只编译，不跑测试。`test` / `bench` 是构建编排（build+run+report），宿主 = z42b
//     （编排器），runner 逻辑住 z42.test 库。见 docs/design/toolchain/build-orchestrator.md
//     Decision #9 + retire-test-runner spec。
namespace Z42.Driver;

using Z42.Core;      // LanguageFeatures —— [syntax] 解出的语法特性开关
using Std.IO;
using Z42.Syntax;
using Z42.Semantics;
using Z42.Package;
using Z42.IR;
using Z42.Project;
using Z42.Pipeline;

// 进程 exit code 契约（compiler-review §三/P2-4：原 0/1/2 魔数无契约、语义靠各函数自觉）。
// z42 受限写法：static class + int 常量（同 TokenKind 模式）。
static class ExitCode {
    public static int Ok = 0;          // 成功
    public static int BuildError = 1;  // 编译/构建失败（诊断已输出）
    public static int UsageError = 2;  // 命令行/工程文件用法错误（参数缺失、无 toml、无 workspace）
}

// parallelize-package-compile ★①：per-file 源读取 + SHA-256 并行（解释执行的 SHA-256 是 CPU 热点，
// D8 增量差价主项）。每文件独立读文本 + 算 hash，写自己的 _texts[i]/_hashes[i] → 确定性、可并行。
// handlerFp 循环前算好（与文件无关），Run 内只读。
sealed class SrcReadHashTask : IParallelBody {
    string[] _srcs; string[] _texts; string[] _hashes; string _handlerFp;
    public SrcReadHashTask(string[] srcs, string[] texts, string[] hashes, string handlerFp) {
        this._srcs = srcs; this._texts = texts; this._hashes = hashes; this._handlerFp = handlerFp;
    }
    public void Run(int i) {
        string t = File.ReadAllText(this._srcs[i]);
        this._texts[i] = t;
        string hin = t;
        if (this._handlerFp.Length > 0) { hin = hin + "\n#z42c-handler-fp:" + this._handlerFp; }
        this._hashes[i] = ZpkgBuilder.SourceHashHex(hin);
    }
}

void Main() {
    string[] argv = Environment.GetCommandLineArgs();
    // 无 file 参数的动词在 argv≥2 守卫之前分发。
    if (argv.Length >= 1 && argv[0] == "--dump-keywords") {
        Console.Write(DumpTool.DumpKeywords());
        return;
    }
    if (argv.Length >= 1 && argv[0] == "build") {
        Environment.Exit(_cmdBuild(argv));   // 参数解析 + 清单定位见 BuildCommand.z42
        return;
    }
    if (argv.Length < 2) {
        _usage();
        return;
    }
    string cmd  = argv[0];
    string file = argv[1];
    if (cmd == "--emit-zbc") {
        if (argv.Length < 3) {
            ConsoleError.WriteLine("z42c: --emit-zbc requires <file.z42> <out.zbc>");
            Environment.Exit(ExitCode.UsageError);
            return;
        }
        string ezText = File.ReadAllText(file);
        // replace-csharp Phase C：跨包 dep 解析（Z42_LIBS）→ 调 stdlib 的源（golden 等）emit 正确 FQ
        // 函数名（否则 `<error>` → 运行期 undefined function）。无 Z42_LIBS → 回落无依赖单文件 emit。
        string ezEnv = Environment.GetEnvironmentVariable("Z42_LIBS", "");
        DependencyIndex ezIndex = null;
        ImportedSymbols ezImported = null;
        if (ezEnv.Length > 0) {
            string[] ezDirs = new string[1]; ezDirs[0] = ezEnv;
            DepScanResult ezScan = DepScan.ScanDirs(ezDirs, 1, "", new string[0], 0, null);
            string[] ezUsings = IrDump.ExtractUsings(ezText, file);
            ezImported = ImportedSymbolLoader.Load(
                ezScan.Exported, ezScan.ExportedPkg, ezScan.ExportedCount, ezUsings, ezUsings.Length);
            ezIndex = ezScan.Index;
        }
        // `--opt-all`（fix-ref-param-escape）：本例按**真实 release 全优化**编（Opt.All）。
        // golden 的 `opt_all` sidecar 用它——逃逸分析 / 内联 / loop-alloc-reuse 这几个 pass 在
        // emit-zbc 默认集里是关的（会改 golden 字节，见 IrDump.EmitZbcDefaultOpt），不给这条路
        // 就没有任何 golden 能跑到它们。
        int ezOpt = IrDump.EmitZbcDefaultOpt();
        int ezAi = 3;
        while (ezAi < argv.Length) {
            if (argv[ezAi] == "--opt-all") { ezOpt = Opt.All; }
            else {
                ConsoleError.WriteLine("z42c: --emit-zbc: unknown option '" + argv[ezAi] + "'");
                Environment.Exit(ExitCode.UsageError);
                return;
            }
            ezAi = ezAi + 1;
        }
        CompiledModuleZ ezCm = IrDump.BuildModuleDOpt(ezText, file, ezIndex, ezImported, ezOpt);
        if (ezCm.ErrorCount > 0) {
            ConsoleError.WriteLine("z42c: " + ezCm.ErrorCount.ToString() + " error(s) in " + file);
            int ezDi = 0;
            while (ezDi < ezCm.DiagCount) { ConsoleError.WriteLine("  " + ezCm.DiagMsgs[ezDi]); ezDi = ezDi + 1; }
            Environment.Exit(ExitCode.BuildError);
            return;
        }
        // 同上：无错但有 warning 时也要说话（此前同样被 ErrorCount 罩住）。
        int ezWi = 0;
        while (ezWi < ezCm.DiagCount) { ConsoleError.WriteLine("  " + ezCm.DiagMsgs[ezWi]); ezWi = ezWi + 1; }
        File.WriteAllBytes(argv[2], IrDump.ZbcBytesOf(ezCm));
        return;
    }
    if (cmd == "--dump-ir") { Console.WriteLine(IrDump.DumpModule(File.ReadAllText(file))); return; }
    if (cmd != "--dump-tokens" && cmd != "--dump-ast" && cmd != "--dump-bound") {
        ConsoleError.WriteLine("z42c: unknown command '" + cmd + "'");
        _usage();
        Environment.Exit(ExitCode.UsageError);
        return;
    }
    string src = File.ReadAllText(file);
    if (cmd == "--dump-tokens")     { Console.WriteLine(DumpTool.DumpTokens(src)); }
    else if (cmd == "--dump-ast")   { Console.WriteLine(DumpTool.DumpAst(src)); }
    else                            { Console.WriteLine(SemanticDump.DumpAll(src)); }
}

// 诊断/警告里呈现的源文件名——与**读取**用的路径分离（CompileInputs 本就是 Files / Texts 两个字段）。
//
// 为什么需要：单文件运行（`z42 run hello.z42`）的合成清单住在缓存目录，`[sources].include` 写的是
// 源文件**绝对路径**，原样打出来就是 `/Users/me/code/hello.z42(3,5): E0401: …`——既与工程模式的
// `./src/Main.z42` 不一致，也让学习手册的会话脚本跨机器不可复现（门禁在示例目录里重放比对）。
//
// 规则：相对路径原样返回（工程模式恒等，现有输出逐字不变）；绝对路径在当前工作目录之下 → 相对化，
// 否则保持绝对（不生成 `../../..` 这种比绝对路径更难读的形式，与 rustc / clang / tsc 一致）。
//
// 不影响产物字节：写 zpkg 前 `_stabilizeSourceIdentity` 已把 `m.SourceFile` 按
// `IncrementalBuild.Rel(projectDir, …)` 相对化并清空 SourceHash（可复现 build_id 的既有机制）。
string[] _displaySrcs(string[] srcs) {
    string cwd = Environment.GetCurrentDirectory().Replace("\\", "/");
    if (cwd.Length > 1 && cwd.EndsWith("/")) { cwd = cwd.Substring(0, cwd.Length - 1); }
    string prefix = cwd + "/";
    string[] outArr = new string[srcs.Length];
    int i = 0;
    while (i < srcs.Length) {
        string s = srcs[i];
        if (!Path.IsRooted(s)) { outArr[i] = s; }
        else {
            string n = s.Replace("\\", "/");
            if (cwd.Length > 0 && n.StartsWith(prefix) && n.Length > prefix.Length) {
                outArr[i] = n.Substring(prefix.Length, n.Length - prefix.Length);
            }
            else { outArr[i] = s; }
        }
        i = i + 1;
    }
    return outArr;
}

// `z42c build <toml>`：manifest → 源发现 → 逐文件编译 → packed zpkg → dist/<name>.zpkg。
// MVP：单工程/packed/无增量（镜像 C# PackageCompiler.BuildTarget 关键路径）。
// cacheDirOverride：workspace 构建由 WsPlan 给出成员 cache 目录（成员 toml 通常无 [build]，按单工程解析会落进
// 源码树）；"" = 按本工程 manifest 解析（BuildLayout）。
// tier：解析**分档**（见 z42c.pipeline 的 WsTier.z42）——成员 dist 只答成员包、外部档只答
// 非成员包，外加「拓扑序排在本成员之后的成员整个不可见」。null = 非 workspace 路径，全可见。
int _build(string tomlPath, bool isRelease, string outputDirOverride, string cacheDirOverride, string[] libsDirsOverride, int libsDirsCount, bool noIncremental, int cliAdd, int cliRemove, bool fix, WsTier tier) {
    ProjectManifest pm = ManifestLoader.Load(tomlPath);
    // 旋钮名校验（compiler-checks-knob-names）：manifest 的 `[profile.*]` 有问题不值得等
    // 一趟全量编译，放在编译前 fail fast。旧形状（直接写键）致命；未知旋钮名只 warn。
    int pkc = _validateProfileKnobs(pm);
    if (pkc != 0) { return pkc; }
    // `deploy` 声明校验（add-deployment-model 批 4.3）：与旋钮名校验同款——**清单有问题不等一趟
    // 全量编译**。放在这里而不是 `_bundleExeDeps` 里，是因为那个只在 exe 分支跑：lib / analyzer
    // 工程写错的 `deploy` 会被整条跳过 ⇒「配了以为生效」。
    int dvc = _validateDeployDecls(pm);
    if (dvc != 0) { return dvc; }
    string projectDir = Path.GetDirectoryName(tomlPath);
    if (projectDir == "") { projectDir = "."; }
    // fix-hooks-source-scan 阶段2：有效 exclude = `[sources].exclude` ++（`[build] hooks` 目录，若声明）。
    // hooks 由 z42b 单独编（`[build] hooks` → ModuleLoader.Load），不该被 app 的 `**/*.z42` glob 扫进
    // app zpkg——否则多一个跨包死类 `ProjectHooks : Z42.Build.BuildHooks`（base 非构建期依赖 → own-only
    // → vtable fixup 假警报刷屏）。目录形式的排除用 `<dir>/**`（SourceDiscovery._matchesExclude 前缀语义）。
    int baseExcN = pm.Sources.ExcludeCount;
    int effExcN = pm.Build.HasHooks ? baseExcN + 1 : baseExcN;
    string[] effExc = new string[effExcN];
    int exi = 0;
    while (exi < baseExcN) { effExc[exi] = pm.Sources.Exclude[exi]; exi = exi + 1; }
    if (pm.Build.HasHooks) { effExc[baseExcN] = pm.Build.HooksDir + "/**"; }
    string[] srcs = SourceDiscovery.DiscoverWithExclude(projectDir, pm.Sources.Include, pm.Sources.IncludeCount, effExc, effExcN);
    if (srcs.Length == 0) {
        ConsoleError.WriteLine("z42c build: no sources matched [sources].include");
        return ExitCode.BuildError;
    }
    string[] dispSrcs = _displaySrcs(srcs);   // 只用于诊断呈现；读取 / 缓存键 / 产物一律仍用 srcs
    // ── 跨包依赖（CI-4）：libsDirs 扫描 → DepIndex + nsMap + TSIG 池；usings 聚合决定激活集 ──
    // workspace build 传 libsDirsOverride：Milestone 1 = [flat dist]（单元素）；
    // Milestone 2 = 全成员 dist 列表（per-member 布局，解析兄弟）+ Z42_LIBS（外部 stdlib）。
    // 单工程留空 → 回落 Z42_LIBS env（单目录）。
    string[] libsDirs;
    int libsDirsN;
    if (libsDirsCount > 0) {
        libsDirs = libsDirsOverride;
        libsDirsN = libsDirsCount;
    } else {
        // ── 编译期依赖解析面 vs driver 自身运行期加载面（2026-09-27）───────────────────────
        //
        // `Z42_LIBS` 被**两件事**共用：① VM 给 driver 自己加载 `z42.package` / `z42.project` 这些
        // 运行期自依赖；② driver 编译当前工程时解析它的 `[dependencies]`。平时一致，所以没人
        // 察觉；但**自举期这两件事要的是不同版本**：
        //   · driver 是上一代二进制，运行期要的是**它自己那代**的库；
        //   · 而它正在编译的源码，要解析的是**当前源**新建出来的库。
        // 两者挤在一个变量里 ⇒ 改名/删符号这类变更无路可走：把新库放进去，driver 自己先死；
        // 放旧库进去，编译看不见新符号；两份都放，编译器判 `E0606`（同 FQN 来自两个包）。
        //
        // ⇒ `--compile-libs` 只喂 ②**编译期**解析，未给则回落 `Z42_LIBS`（行为逐字不变）。
        // 做成旗标而非环境变量的理由见 `CompileLibsOpt` 头注。
        if (CompileLibsOpt.Count() > 0) {
            libsDirs = CompileLibsOpt.Dirs(); libsDirsN = CompileLibsOpt.Count();
        } else {
            string env = Environment.GetEnvironmentVariable("Z42_LIBS", "");
            if (env.Length > 0) { libsDirs = new string[1]; libsDirs[0] = env; libsDirsN = 1; }
            else { libsDirs = new string[0]; libsDirsN = 0; }
        }
    }
    // ── path 依赖闭包（add-path-dependencies 阶段2 use）——实现见 PathDepBuild.z42 `_buildPathDepClosure`。
    string[] closureNames = new string[0];
    int closureN = 0;
    // fix-path-dep-closure-scope：workspace per-member 成员（tier.MembersN > 0）**也**解析闭包——此前只有
    // top-level（libsDirsCount==0）解析，而 workspace 调用总是带 libsDirs 进来 ⇒ 成员指向 workspace **外**的
    // path 依赖永远不代建。闭包**子建**（tier == null、count>0）仍跳过：那里的相对路径未必解得开。
    bool wsMember = tier != null && tier.MembersN > 0;
    if (libsDirsCount == 0 || wsMember) {
        PathClosureOut pco = _buildPathDepClosure(tomlPath, isRelease, noIncremental, cliAdd, cliRemove, libsDirs, libsDirsN,
                                                  wsMember ? tier : null);
        if (pco.Rc != 0) { return pco.Rc; }
        closureNames = pco.Names; closureN = pco.NamesN;
        libsDirs = pco.LibsDirs; libsDirsN = pco.LibsDirsN;
    }
    // ── `[dependencies]` 的 zpkg 产物引用（add-deployment-model）──
    // `path` 指向 `.zpkg` 文件 ⇒ 不代建，把它**所在目录**并入解析域（helper 在 ExeDeps.z42）。
    // 放在 path 闭包之后、编译器域解析域之前：vendored 产物优先级与 path 闭包同级，都排在
    // 框架（Z42_LIBS）之前——「我显式指定的那一份」应当压过「碰巧同名的框架包」。
    {
        string[] zrefs0 = _zpkgRefDirs(pm, projectDir);
        if (zrefs0 == null) { return ExitCode.BuildError; }
        // 🔴 **编译器域目录必须排在框架之后，不能排在前面**（relocate-compiler-domain-libs 实测）。
        //
        // `<sdk>/programs/z42c/` 是 driver 的**自包含闭包** —— 里面除了编译器域包，还躺着整套
        // stdlib 的副本。把它放在 `Z42_LIBS` 之前，`z42.core` 等就会**先在那儿命中**，于是
        // `_bundleExeDeps` 按「不是从 shipped libs/ 找到的 ⇒ 私有」把**整套 stdlib 拷进用户工程
        // 的输出目录**（实测：引用一个编译器域包，dist 从 1 个 zpkg 变成十几个；
        // 同工程不引用编译器域包时只有 1 个）。
        //
        // 手写的 vendored zpkg 引用仍排在框架**之前**（那是「我显式指定的这一份要压过碰巧同名的
        // 框架包」的原意）；编译器域目录不需要这条优先级 —— 它里面的编译器域包按构造不存在于
        // shipped `libs/`，放最后一样命中，而 stdlib 则继续从框架解析（⇒ 不复制）。
        string[] dom = CompilerDomain.Dirs();
        string[] zrefs = new string[zrefs0.Length];
        string[] zdom = new string[zrefs0.Length];
        int zn = 0;
        int zdn = 0;
        int zi = 0;
        while (zi < zrefs0.Length) {
            bool isDom = false;
            int dj = 0;
            while (dj < dom.Length) { if (dom[dj] == zrefs0[zi]) { isDom = true; } dj = dj + 1; }
            if (isDom) { zdom[zdn] = zrefs0[zi]; zdn = zdn + 1; } else { zrefs[zn] = zrefs0[zi]; zn = zn + 1; }
            zi = zi + 1;
        }
        if (zdn > 0) {
            string[] withD = new string[libsDirsN + zdn];
            int wi2 = 0;
            while (wi2 < libsDirsN) { withD[wi2] = libsDirs[wi2]; wi2 = wi2 + 1; }
            int dk = 0;
            while (dk < zdn) { withD[libsDirsN + dk] = zdom[dk]; dk = dk + 1; }
            libsDirs = withD; libsDirsN = libsDirsN + zdn;
        }
        if (zn > 0) {
            // ⚠️ 用 `zn`（有效个数）而不是 `zrefs.Length`（分配长度）—— 拆分后数组是按上界分配的，
            // 用 Length 会把尾部空槽也当成目录混进解析域。
            string[] withZ = new string[libsDirsN + zn];
            int zk = 0;
            while (zk < zn) { withZ[zk] = zrefs[zk]; zk = zk + 1; }
            int wi2 = 0;
            while (wi2 < libsDirsN) { withZ[zn + wi2] = libsDirs[wi2]; wi2 = wi2 + 1; }
            libsDirs = withZ; libsDirsN = libsDirsN + zn;
        }
    }
    // ── SDK 库的可见性（add-sdk-libs；规则与实现见 z42c.pipeline 的 SdkLibs.z42）────────────────────
    // exe / lib：按名声明的 SDK 库（+ 传递闭包）可见；analyzer：编译器目录里的 SDK 库全部可见（编译期扩展的
    // 契约包在那里）。不放行的并入扫描 tier 的 Hidden。放行集为空（绝大多数工程，含 z42c 自建）⇒ 不追加目录、
    // tier 原样 ⇒ 自举 byte-identical。此前这里只有「kind = analyzer ⇒ 并入整个编译器目录」一条。
    SdkLibPlan sdkPlan = SdkLibs.Plan(pm, libsDirs, libsDirsN, pm.Project.Kind == "analyzer");
    if (sdkPlan.DirsN > 0) {
        libsDirs = SdkLibs.AppendDirs(libsDirs, libsDirsN, sdkPlan);
        libsDirsN = libsDirsN + sdkPlan.DirsN;
    }
    // 只用于扫描与缓存身份；`tier` 本身的 workspace 语义（成员 / 闭包代建 / packed / generated）不受影响。
    WsTier scanTier = SdkLibs.MergeTier(tier, sdkPlan);
    // ── `[analyzers]` handler zpkg 解析（add-package-roles 批 2）────────────────────────────
    // 必须在指纹之前：path 条目由 z42c **代建**，不先建就没有 zpkg 可指纹，「改了 analyzer 源码但
    // 消费方源没变」就不会失效缓存 —— 那正是 PR4e 指纹要堵的洞，只是换 path 条目后会重新漏。
    // 解析结果同时喂指纹与 CompileInputs（此前两处各按名扫一遍 libsDirs）。
    // 无 `[analyzers]`（含 z42c 自建）→ 不进此块、指纹 `""` → 自举 byte-identical。
    string[] azPaths = null;
    if (pm.AnalyzerCount > 0) {
        HandlerZpkgs hz = _resolveHandlerZpkgs(pm, projectDir, tomlPath, libsDirs, libsDirsN,
                                               isRelease, noIncremental, cliAdd, cliRemove);
        if (hz.Code != 0) { return hz.Code; }
        azPaths = hz.Paths;
    }
    // attribute-handler-registry PR4e：handler（[analyzers] zpkg）身份指纹并入增量指纹（design red-line ②
    // 「产物纳入指纹」，helper 在 BuildPaths.z42）——揉进每个文件源 hash，则「换 generator 但源没变」也令所有
    // 缓存失效。空（无 [analyzers]，含 z42c 自建）→ `""` → `text+""==text` → 源 hash 不变 → 自举 byte-identical。
    string handlerFp = _handlerFingerprint(pm, azPaths);
    // 源文本读入 + 源 hash（probe / ZbcFileZ / meta 三处复用；SHA-256 解释执行曾是 D8 增量差价主项）。
    // parallelize-package-compile ★①：per-file 读+哈希并行（各写独立槽，确定性）。
    string[] texts = new string[srcs.Length];
    string[] srcHashes = new string[srcs.Length];
    ParallelFor.Run(srcs.Length, ParallelConfig.Jobs(srcs.Length),
        new SrcReadHashTask(srcs, texts, srcHashes, handlerFp));
    // exe 判定：显式 kind=exe，或声明了 `[[exe]]` 多目标（unify-run-modes P3）。
    bool isExe = pm.Project.Kind == "exe" || pm.ExeCount > 0;
    // pack 决议（add-indexed-zpkg-min-patch）：[project].pack 显式 > 内置默认
    //（debug→false=indexed / release→true=packed）。[profile] 层随 profiles 延后线
    //（z42c 尚未解析 profile 段）；`[[exe]]` 多目标已由本函数下方多产物分支消费。
    // indexed 为开发态：与 release strip 冲突即拦。
    bool isPacked = pm.Project.HasPack ? pm.Project.Pack : isRelease;
    // fix-flat-workspace-packed：flat workspace（`--workspace --output-dir`，全部成员共用一个 dist；
    // 判据同 WsTier 的定义 `MemberDirs == 0`）一律 packed。indexed 的散装 zbc 按**工程内相对路径**落在
    // dist 下 ⇒ 两个成员都有 `x.z42` 时后者覆盖前者（前一个包加载到别人的代码），`_cleanOrphanZbc`
    // 还会把「不属于本包」的 zbc——也就是别的成员的——当孤儿删掉。显式 `pack = false` 在这里无解，报错。
    bool sharedFlatDist = tier != null && tier.MemberDirs == 0 && outputDirOverride.Length > 0;
    if (sharedFlatDist) {
        if (pm.Project.HasPack && !pm.Project.Pack) {
            ConsoleError.WriteLine("z42c build: " + tomlPath + ": pack=false (indexed) is incompatible with a flat workspace"
                + " build (--workspace --output-dir): members share one dist and their loose .zbc files would collide;"
                + " drop `pack = false`, or build without --output-dir (per-member layout)");
            return ExitCode.UsageError;
        }
        isPacked = true;
    }
    // fix-path-dep-closure-scope：path 依赖的**闭包代建**（调用约定：tier == null 且带 libsDirs）默认 packed。
    // 它的产物是给消费方用的依赖，要被 exe 装配进 dist；indexed 主文件的散装 zbc 装配不过去（落在 dist
    // 根下会与消费方自己的 zbc 撞名）⇒ 此前 debug 构建的 exe 只要有 path 依赖，运行期就
    // `undefined function`。indexed 的最小 patch 好处只属于正在开发的那个包，依赖用不上。显式 `pack` 照旧优先。
    if (tier == null && libsDirsCount > 0 && !pm.Project.HasPack) { isPacked = true; }
    if (!isPacked && isRelease) {
        ConsoleError.WriteLine("z42c build: pack=false (indexed) is dev-mode only and incompatible with --release strip; build without --release or set pack=true");
        return ExitCode.UsageError;
    }
    string distDir = outputDirOverride.Length > 0 ? outputDirOverride : BuildLayout.Resolve(pm, projectDir, isRelease).DistDir;
    // 文件级增量（add-file-level-incremental）：种子 + token 保守边闭包 + cached 读回。
    // 全命中 → 完全跳过重编/重写（沿用 preserved 路径）；部分命中 → 失效子集重编、
    // 其余 IrModule 从 cache 读回（meta 残留已回填）。单工程 --output-dir 平铺不走（workspace 成员走，见下）。
    IncrPrep prep = null;
    // `[build] incremental = false` 关增量（wire-build-incremental）。此前这个键**被解析进
    // BuildConfig.Incremental 就再没人读过**——`docs/reference/src/toolchain/z42-toml.md:223/242` 明文
    // 承诺「基于 source hash 跳过未改动文件，默认 true」，当时的 workspace 示例
    // 也真的在 preset 里写它，但写 false 不会有任何效果。**一个看起来正经、实则从不生效的旋钮**，
    // 比没有这个旋钮更坏：用户以为自己关掉了。
    //
    // 优先级：CLI `--no-incremental` 是显式一次性覆盖，**永远压过 manifest**；manifest 里的
    // false 则是该工程的常设选择。两者任一为「关」即关。
    bool incrOff = noIncremental || !pm.Build.Incremental;
    // 依赖身份（add-dep-identity-to-cache-key）：编译要扫的依赖 zpkg 的 BLID/内容哈希。probe 比对、cache 写入共用
    // 同一个值——libsDirs 此处已是最终形态（含 path 依赖闭包的 dist）；DepScanCache memo 使编译期扫描零重读。
    // `[optimize]` / `[syntax]` / `[lints]` 决议 —— 与 z42b（BuildSession）共用 `ManifestKnobs.Resolve`
    // （unify-driver-knobs：此前两份逐项相同的实现并存，改一份须同步另一份）。每个 workspace 成员各走一遍本函数
    // ⇒ 每个成员用自己的 manifest。优化集：CLI > toml > profile 默认；未知优化名 / 语法特性名报错、不静默忽略。
    // pack 用上面 driver 自己的判断（有 flat workspace / 闭包子建两种角色，且已先行拦截）⇒ 这里 forcePacked=false，
    // Resolve 的 pack 报错不会再触发。⚠️ 必须解在 `depsId` **之前** —— 优化集要并进包级缓存身份，见下。
    KnobResult kn = ManifestKnobs.Resolve(pm, tomlPath, isRelease, cliAdd, cliRemove, false);
    if (kn.ErrorCount > 0) {
        int ke = 0;
        while (ke < kn.ErrorCount) { ConsoleError.WriteLine("z42c: " + kn.Errors[ke]); ke = ke + 1; }
        return ExitCode.UsageError;
    }
    int effOptSet = kn.OptSet;
    LanguageFeatures feats = kn.Features;
    string depsId = DepIdentity.Of(libsDirs, libsDirsN, pm.Project.Name, scanTier);
    // wire-optimize-manifest：**优化集并进包级缓存身份**。它此前不在任何 cache key 里——那时无害
    // （`[optimize]` 整段被忽略，optSet 只由 CLI/profile 决定，而这两者不会在「源没变」时悄悄变）。
    // 接线之后就有害了：改一行 toml 不碰源码 ⇒ probe 全命中 ⇒ **旋钮全量构建生效、增量构建被忽略**
    // （实测：改成 `inline=false` 后 `cached: 1/1`、产物仍 960 字节）。那种「有时生效」比「从不
    // 生效」更难查。并进这里而不是新加一行 meta：`depsId` 本就是「包级身份，不符即整包全量」，
    // 优化集确实属于同一维度，且零签名改动（下游四处原样继承）。
    depsId = depsId + "|opt" + effOptSet.ToString();
    // 🔴 **特性集也必须进包级缓存身份**，同上一行的理由：改一行 toml 不碰源码 ⇒ probe 全命中
    // ⇒ 旋钮「全量生效、增量被忽略」。只折**被 toml 显式改动过的**那些（默认 profile 不进 key，
    // 免得将来给 profile 加特性就把所有人的缓存作废）。
    int sd = 0;
    while (sd < pm.SyntaxCount) {
        depsId = depsId + "|syn:" + pm.SyntaxNames[sd] + "=" + (pm.SyntaxValues[sd] ? "1" : "0");
        sd = sd + 1;
    }
    // 🔴 **清单自身的身份也必须进包级缓存身份**（fix-cache-key-manifest-inputs）。
    //
    // 这是 `|opt` / `|syn:` 同一族的第三、四次：**「只改 toml、源码一字未动」恰好全命中缓存
    // ⇒ 早退 preserved ⇒ 改动没进产物，而构建报成功**。前两次的处置是在 preserved 路径上各打
    // 一个补偿补丁（上方 `_writeRuntimeConfigSidecar` 与 `_bundleExeDeps` 就是那两个），
    // 这次改为**扩键**——补偿补丁只能救已知的那一个产出物，扩键才是「缓存键涵盖全部影响
    // 产物的输入」这条前置条件本身。
    //
    // 逐项为什么在这里（都是**会进产物字节或会改诊断**的输入，而此前一项都不在任何 key 里）：
    //   · Name / Version / Entry —— `ZpkgWriterZ._buildMeta` 把三者写进 zpkg 的 META 段。
    //     `DepIdentity.Of` 的 `excludeName` 只用来**把自身排除出依赖集**，不进哈希 ⇒ 连改包名
    //     都不失效。实测形态：改 `[project].version` 重建，报 `no changes; preserved`，
    //     **发布出去的 zpkg 里还是旧版本号**。
    //   · Kind —— `exe` / `lib` / `analyzer` 决定 zpkg 头的 FlagExe 与装配路径。
    //   · 声明依赖名单 —— `DepScan` 拿它当过滤白名单、`E0497`（用了没声明）据它发码、DEPS 段
    //     据它写。按名依赖删掉一条**不改变 libsDirs 里 zpkg 的集合与内容** ⇒ `DepIdentity.Of`
    //     不变 ⇒ 全命中 ⇒ DEPS 段陈旧（#849 的传递闭包据此建）+ 本该报的 E0497 静默消失。
    //   · isRelease —— 默认 cache 目录模板含 `${profile}`，所以通常被目录隔开；但 manifest
    //     可以把 `cache_dir` 配成不含 `${profile}` 的路径，那时两个 profile 共用一份条目。
    //
    // 代价：本次提交后全仓所有包的既有缓存条目一次性失效（键变了 ⇒ 当 fresh），此后自愈。
    // 依赖名单按**清单顺序**折入：重排 `[dependencies]` 会多触发一次全量，而漏失效是错产物
    // ——过度失效是安全方向（同 `DepIdentity` 不按 declaredDeps 过滤那条的取舍）。
    depsId = depsId + "|mf:" + pm.Project.Name + "@" + pm.Project.Version
           + "/" + pm.Project.Kind
           + "/" + (pm.Project.HasEntry ? pm.Project.Entry : "-")
           + "/" + (isRelease ? "rel" : "dbg");
    int mdi = 0;
    while (mdi < pm.DepCount) {
        depsId = depsId + "|dep:" + pm.Deps[mdi].Name;
        mdi = mdi + 1;
    }
    // workspace-read-cache：workspace 成员（cacheDirOverride 非空）也 probe。单工程 `--output-dir`（自举预建 build-libs 等）
    // 仍不 probe——那条路径没有 workspace 布局给出的 cache 目录，dist 是临时拼的平铺目录。
    // 实际生效的 cache 目录：workspace 成员由 WsPlan 给出，否则按本工程 manifest 解析。probe / indexed dist 读回 /
    // 写 cache 三处必须是同一个目录（此前 indexed dist 固定按 manifest 解析，workspace 一读 cache 就读错位置）。
    string effCacheDir = cacheDirOverride.Length > 0 ? cacheDirOverride : BuildLayout.Resolve(pm, projectDir, isRelease).CacheDir;
    // fix-output-dir-aux-outputs：单工程 `--output-dir`（非 workspace）**不写 cache**。这条路径本就不 probe
    // （见上），cache 写了也永远不读；而按 manifest 解析的 cache 目录落在**工程目录旁**（成员 toml 无 [build]
    // ⇒ `<proj>/artifacts/<profile>/.cache`）—— xtask 自举预建 6 个自依赖库、测试夹具每跑一轮都在源码树里
    // 留一份。不改写到 `<dir>/.cache`：自举预建的 `<dir>` 是 stdlib flat（= Z42_LIBS = 进 SDK 的 libs/），
    // 往里放 cache 目录有被整目录拷进包的风险。indexed dist 的「cached 字节原样复制」只在增量开启时消费，
    // 本路径不开，故不受影响。
    bool writeCache = !(outputDirOverride.Length > 0 && cacheDirOverride.Length == 0);
    if ((outputDirOverride.Length == 0 || cacheDirOverride.Length > 0) && !incrOff) {
        string probeCache = effCacheDir;
        string lastZpkg = Path.Join(distDir, pm.Project.Name + ".zpkg");
        // preserved 跳过要求 dist 主文件的 pack 模式与本次决议一致（packed↔indexed 切换
        // 时布局必须重投影，不能拿旧模式的 dist 当"未变"——add-indexed-zpkg-min-patch）。
        // 多目标（ExeCount>0）不走 preserved：其产物是 dist/<exe>.zpkg（非 <Name>.zpkg），
        // 增量 preserved 尚未建模多产物（unify-run-modes P3）。
        // fix-incr-allcached-cache-drop：这三个条件必须**在 probe 之前**就算好并交给 Prepare——
        // 它据此决定「全命中」时是走廉价早退（调用方马上要 preserved，不需要 IrModule），还是照常
        // 把 64 份 cached zbc 读回来。此前 Prepare 无条件早退、返回 Cus=null + 全 null 的 cached[]，
        // 于是「全命中但不能 preserved」（dist 被清 / pack 模式切换 / 多 exe）会落进 Main 的全量
        // parse 分支、cachedMods 全 null → **缓存整份作废、全部重编**（实测 xtask 3.7s vs 应有 2.25s；
        // 多 exe 工程更是永远全量）。
        // fix-analyzer-diags-preserved：有 `[analyzers]` 的工程也不走 preserved。analyzer 诊断与
        // `[lints]` 决策**不进任何缓存**（PackageCompile 每次构建重跑，快照刻意取在它之前），
        // 早退 = analyzer 没跑 ⇒ 第二次构建警告消失、只改 `[lints]`（升 error / WAE）仍 exit 0。
        // 代价只落在带 analyzer 的工程：全命中时多一次装配 + analyzer 遍历（cached CU 不重做 typecheck）。
        bool canPreserve = pm.ExeCount == 0 && pm.AnalyzerCount == 0
            && File.Exists(lastZpkg) && _distModeMatches(lastZpkg, isPacked);
        prep = IncrementalDriver.Prepare(srcs, dispSrcs, texts, srcHashes, srcs.Length, projectDir, probeCache, depsId, canPreserve, feats);
        BuildLog.ProgressErr("cached: " + (srcs.Length - prep.Plan.FreshCount).ToString() + "/" + srcs.Length.ToString() + " files");
        if (canPreserve && prep.Plan.AllCached) {
            if (isExe) {
                int sbc = _bundleExeDeps(pm, closureNames, closureN, distDir, libsDirs, libsDirsN);
                if (sbc != 0) { return sbc; }
                // 🔴 侧车必须在 preserved 路径上也重写。`[profile.<n>.runtime]` 的旋钮与
                // `[properties]` **不进源 hash**（它们不影响编译产物），于是「只改了运行时
                // 配置、源码一字未动」恰好全命中缓存 ⇒ 早退 ⇒ 侧车留在上一次的值：用户改了
                // 旋钮、构建报成功、产物里还是旧配置。实测复现（把 probing-paths 从
                // `../../shared` 改成 `../../CHANGED`，重建后侧车仍是 `../../shared`）。
                // 写出是幂等的（值没变就写回同样的字节），代价是一次 TOML 序列化。
                int rcp = _writeRuntimeConfigSidecar(pm, distDir, pm.Project.Name, isRelease);
                if (rcp != 0) { return rcp; }
            }
            // 🔴 警告必须在 preserved 路径上也打印（warnings-survive-cache），理由与上面侧车
            // 那条**一模一样**：早退跳过了用户仍然需要看见的东西。实测：带 W0700 的工程连续
            // 构建三次，只有第 ① 次打印，第 ②③ 次 `cached: N/N` 起彻底消失——而源码一字未改、
            // 缺陷还在。「连着构建两次」恰恰是最常见的工作方式，所以这一格比部分增量那格更常被撞到。
            // 诊断此刻已经在手（`prep.Plan.Metas[*].Diags`，v7 meta 起随条目回放），不需要编译。
            int pwi = 0;
            while (pwi < srcs.Length) {
                CacheMeta pm2 = prep.Plan.Metas[pwi];
                if (pm2 != null && pm2.DiagCount > 0) {
                    ConsoleError.WriteLine("z42c build: " + pm2.DiagCount.ToString() + " warning(s) in " + dispSrcs[pwi]);
                    int pwd = 0;
                    while (pwd < pm2.DiagCount) { ConsoleError.WriteLine("  " + pm2.Diags[pwd]); pwd = pwd + 1; }
                }
                pwi = pwi + 1;
            }
            BuildLog.Progress("no changes; preserved -> " + BuildLayout.Display(lastZpkg));
            return ExitCode.Ok;
        }
    }
    // ── ⑦ parse-all（增量复用 prep.Cus / 全量 ParseAllTk）：cus 喂编译核心，metaIdents 供 ⑬ cache ──
    int i = 0;
    CompilationUnit[] cus;
    NameListZ[] metaIdents = null;
    NameSurfacesZ[] metaSurfaces = null;
    if (prep != null && prep.Cus != null) {
        cus = prep.Cus;
        metaIdents = prep.Idents;
        metaSurfaces = prep.Surfaces;
    } else {
        // 全量路径（--no-incremental / 增量未启 / workspace）：parse 时捕获标识符供 meta 写盘
        //（D8 修正——零第二遍 lex）。cache-dir-layout：cache 恒落盘 → 恒捕获。
        bool[] want = new bool[srcs.Length];
        int wi = 0;
        while (wi < srcs.Length) { want[wi] = true; wi = wi + 1; }
        ParsedPkg pk = IncrementalDriver.ParseAllTk(texts, dispSrcs, srcs.Length, want, feats);
        cus = pk.Cus;
        metaIdents = pk.Idents;
        metaSurfaces = pk.Surfaces;
    }
    // ── 编译核心（PackageCompile：⑥依赖解析 → ⑧包级编译 → ⑩组装；extract-compile-pipeline-api）──
    //    落盘 / 诊断呈现 / 增量 probe / cache 落盘留本 CLI；核心只吃内存源 + 依赖目录 + manifest 派生标量。
    string[] declaredDeps = new string[pm.DepCount];
    int ddi = 0;
    while (ddi < pm.DepCount) { declaredDeps[ddi] = pm.Deps[ddi].Name; ddi = ddi + 1; }
    // 🔴 声明了却**不存在**的依赖此前零诊断：`DepScan` 拿 declaredDeps 只当**过滤白名单**
    // （「只索引 stdlib + 声明依赖」），名字对不上任何 zpkg 就只是少激活一个包 —— 编译照常成功。
    // 于是清单里把包名拼错（或依赖了一个根本没 build 的库），得到的不是「找不到依赖 X」，而是
    // 一堆**位置在别处**的 `E0443 undefined type` / `E0401 undefined`，从症状反推不回清单。
    // 判据与 `_bundleExeDeps` / `[analyzers]` 解析同款：libsDirs 里有没有 `<name>.zpkg`。
    // 摸底：全仓 233 个 z42 包的 [dependencies] 无一条落空（落空的 24 条全在 Cargo.toml）⇒ 判红零误伤。
    int dvi = 0;
    while (dvi < pm.DepCount) {
        string dname = declaredDeps[dvi];
        string dfile = dname + ".zpkg";
        bool dfound = false;
        int dd = 0;
        while (dd < libsDirsN) {
            if (File.Exists(Path.Join(libsDirs[dd], dfile))) { dfound = true; break; }
            dd = dd + 1;
        }
        if (!dfound) {
            string dsearched = "";
            int ds = 0;
            while (ds < libsDirsN) {
                dsearched = dsearched + (ds > 0 ? ", " : "") + libsDirs[ds];
                ds = ds + 1;
            }
            if (libsDirsN == 0) { dsearched = "(无依赖目录——未设 Z42_LIBS，清单也无 path 依赖)"; }
            ConsoleError.WriteLine("z42c build: [dependencies] `" + dname + "` 未找到 " + dfile
                + "；已查找：" + dsearched
                + "。检查包名拼写，或先构建该依赖（path 依赖由 z42c 代建，名字须与其 [project].name 一致）。");
            return ExitCode.BuildError;
        }
        dvi = dvi + 1;
    }
    IrModule[] cachedMods = prep != null ? prep.Cached : null;
    CachedNsMeta[] cachedMetas = null;
    if (cachedMods != null && prep != null && prep.Plan != null) {
        cachedMetas = new CachedNsMeta[srcs.Length];
        int mi = 0;
        while (mi < srcs.Length) {
            if (prep.Plan.Metas[mi] != null) {
                cachedMetas[mi] = new CachedNsMeta(prep.Plan.Metas[mi].UsedDepNs, prep.Plan.Metas[mi].UsedDepNsCount);
                // warnings-survive-cache：cached CU 的诊断也随 meta 回来（否则警告只在冷构建可见）。
                cachedMetas[mi].Diags = prep.Plan.Metas[mi].Diags;
                cachedMetas[mi].DiagCount = prep.Plan.Metas[mi].DiagCount;
            }
            mi = mi + 1;
        }
    }
    CompileInputs cin = new CompileInputs();
    // 🔴 cin.Files 必须是**真实路径**，不能换成显示名：它直接成为 `ZbcFileZ.SourceFile`
    // （PackageCompile.z42 `string rel = files[i]`）进而进入 zpkg，由 `_stabilizeSourceIdentity`
    // 按 projectDir 相对化来保证「同一份源换目录编出的字节相同」。换成 cwd 相对的显示名后，
    // 那次相对化会因前缀不匹配而失效 ⇒ 可复现 build_id 判红（GREEN 实测抓到）。
    // 显示名只走 Parser（诊断位置）与下面两处呈现，不进产物。
    cin.Texts = texts; cin.Files = srcs; cin.SrcHashes = srcHashes; cin.SrcCount = srcs.Length;
    cin.Cus = cus; cin.CachedMods = cachedMods; cin.CachedMetas = cachedMetas;
    cin.Name = pm.Project.Name; cin.Version = pm.Project.Version; cin.Kind = pm.Project.Kind;
    cin.HasEntry = pm.Project.HasEntry; cin.Entry = pm.Project.Entry;
    cin.IsRelease = isRelease;
    cin.Fix = fix;         // PR7-wire：`--fix` → _runAnalyzers 传 6-参 Run，analyzer 携修复就地重写源
    cin.Features = feats;   // add-l0-protocol-table：喂给解析器的语法特性门
    cin.OptSet = effOptSet;   // wire-optimize-manifest：上方已按 CLI > toml > profile 解出
    cin.LibsDirs = libsDirs; cin.LibsDirsN = libsDirsN;
    cin.Tier = scanTier;
    // add-sdk-libs：放行的 SDK 库（传递闭包 / analyzer 免声明）也算已声明 —— DepIndex 要索引它们、E0497 要放行。
    string[] declaredAll = SdkLibs.ExtendDeclared(declaredDeps, pm.DepCount, sdkPlan);
    cin.DeclaredDeps = declaredAll; cin.DepCount = declaredAll.Length;
    // fix-crosspkg-ns-reachability：走到这里就是**真的读了一份 manifest**（`pm`）⇒ 执行依赖契约（E0497）。
    // REPL / 单测 / 裸 emit 不经本函数，保持默认 false——它们没有「声明」可依据。
    // 单文件同样走这里，但 launcher 已把 SDK libs 写进它的合成清单，故自然放行。
    cin.EnforceDeclaredDeps = true;
    // attribute-handler-registry PR3a-load：`[analyzers]` 段声明的 handler zpkg → 加载进编译器、
    // 编译期运行、**不链入目标产物**（D9）。路径已在上方 `_resolveHandlerZpkgs` 一次解析完（名字条目
    // 走 libsDirs、path 条目已代建），此处只挂上去。z42c 自建无 [analyzers] → azPaths 为 null → 不进
    // 此块 → 自举 gen1==gen2 逐字节不动。
    if (azPaths != null) {
        cin.AnalyzerZpkgs = azPaths; cin.AnalyzerZpkgCount = pm.AnalyzerCount;
        // attribute-handler-registry PR4d：同一 `[analyzers]` 段 zpkg 也承载 generator（D9 单段覆盖两类，
        // User 2026-08-22 裁决）——PackageCompile 直接从 AnalyzerZpkgs 经 GeneratorLoader 发现
        // `: Generator`/`: ModuleGenerator`（只含 analyzer 的 zpkg → 发现 0 个 generator，反之亦然）。**不设
        // 独立字段**：避免 driver 引用 CompileInputs 新字段成新跨成员符号、撞 F2 冷启动 stale-cache。
    }
    // attribute-handler-registry PR3b：[lints] 中性字段 → LintConfig 决策器（severity 覆盖 +
    // EnabledByDefault 门 + warnings-as-errors）。仅 analyzer 运行时消费；z42c 自建无 [lints] →
    // LintCount==0 && !WAE → 空配置（等价 null）→ 逐字节不动。
    cin.Lints = kn.Lints;   // null = 无 [lints]（等价空配置）
    CompileArtifacts art = PackageCompile.Compile(cin);
    CompiledModuleZ[] cms = art.Cms;
    // ⑨ 诊断呈现（逐文件，首个有错即报并返回——与抽取前逐字一致）
    // 🔴 循环上界必须是 **art.CmCount 而不是 srcs.Length**（fix-generated-cu-errors-invisible）：
    // generator 产出后 `cms` 是 **union**（用户 CU + 生成 CU），比 `srcs` 长。按 `srcs.Length`
    // 迭代 ⇒ **生成 CU 里的编译错误一条也不会被检查**：既不打印、也不返回 BuildError，
    // 于是带着 `art.Z == null`（错误路径 PackageCompile 就是这么返回的）继续往下走，
    // 最终在 `ZpkgWriterZ._buildSectionList` 里 `zpkg.NsCount` 撞 Null 崩掉 ——
    // 一条本该是「编译错误 + 文件名 + 行号」的诊断，变成一句看不懂的 FieldGet 崩溃。
    // **任何 generator 的产出编译失败都会踩这条**，不限某个具体 generator。
    //
    // 生成 CU 没有真实源文件名 → 标 `<generated>`；原先那样索引 `srcs[ei]` 正是越界读。
    if (art.ErrorCount > 0) {
        int ei = 0;
        while (ei < art.CmCount) {
            CompiledModuleZ cm = cms[ei];
            if (cm.ErrorCount > 0) {
                string origin = ei < dispSrcs.Length ? dispSrcs[ei] : "<generated>";
                ConsoleError.WriteLine("z42c build: " + cm.ErrorCount.ToString() + " error(s) in " + origin);
                int di = 0;
                while (di < cm.DiagCount) { ConsoleError.WriteLine("  " + cm.DiagMsgs[di]); di = di + 1; }
                return ExitCode.BuildError;
            }
            ei = ei + 1;
        }
        // 有错但逐 CU 都没认领 —— 也绝不能往下走（下游拿 art.Z==null 会崩成 FieldGet）。
        ConsoleError.WriteLine("z42c build: " + art.ErrorCount.ToString()
            + " error(s), but no compilation unit reported them (this is a z42c bug)");
        return ExitCode.BuildError;
    }
    // ⑩ 警告呈现（report-crosspkg-duplicate-type）。
    //
    // 🔴 在此之前，**两个诊断打印点都被 `ErrorCount > 0` 罩着** ⇒ z42c 从不单独打印任何 warning：
    // 一个文件若只有 warning 没有 error，`DiagMsgs` 里装着它、却一个字也不会出现在终端。
    // 于是 W0700（switch 不穷尽）/ W0603 / W0604 / deprecated 这些码**一直是哑的**——
    // 「从不打印的门 = 没有门」，与本 change 要修的是同一族毛病。
    //
    // 打开它的代价实测为 **0**：stdlib 25 个包 + z42c 自建全跑一遍，共 0 条 warning
    // （量法是临时给这里加打印再全量构建）。warning 不改退出码，只出 stderr。
    // 🔴 循环上界与上面的错误循环同口径：**`art.CmCount` 而不是 `srcs.Length`**
    // （warnings-survive-cache）。上面那条在 fix-generated-cu-errors-invisible 里已经改过并写明
    // 理由，这一条当时没跟着改 ⇒ **generator 产出的 CU 里的警告一条也不会打印**。
    // 少一格不像错误那格会崩（越界读），所以它更安静、也更容易一直留着。
    // 生成 CU 没有真实源文件名 → 标 `<generated>`，与错误那格逐字一致。
    if (art.ErrorCount == 0) {
        int wi = 0;
        while (wi < art.CmCount) {
            CompiledModuleZ wcm = cms[wi];
            if (wcm.DiagCount > 0) {
                string worigin = wi < dispSrcs.Length ? dispSrcs[wi] : "<generated>";
                ConsoleError.WriteLine("z42c build: " + wcm.DiagCount.ToString() + " warning(s) in " + worigin);
                int wd = 0;
                while (wd < wcm.DiagCount) { ConsoleError.WriteLine("  " + wcm.DiagMsgs[wd]); wd = wd + 1; }
            }
            wi = wi + 1;
        }
    }
    // ⑪ entry 校验（单产物 exe 专属）。多目标（ExeCount>0）用各自 [[exe]].entry 显式指定，
    // 共享编译的自动探测 ambiguous/missing 与其无关 → 跳过（unify-run-modes P3）。
    if (isExe && pm.ExeCount == 0 && art.EntryStatus == "ambiguous") {
        ConsoleError.WriteLine("z42c build: multiple Main candidates; set [project].entry explicitly");
        return ExitCode.BuildError;
    }
    if (isExe && pm.ExeCount == 0 && art.EntryStatus == "missing") {
        ConsoleError.WriteLine("z42c build: kind=exe but no Main() found");
        return ExitCode.BuildError;
    }
    // generator 产出的源码落盘（wire-generated-dir）。
    //
    // 选 Generator 路线（生成**源码**而非直接造 AST/IR）的理由就是「以后可以支持调试」——
    // 栈帧里出现 `__gen$…z42` 时背后得有一个真文件可以打开。配的是「写到哪」不是「写不写」，
    // 故默认恒落盘；没用 generator 的包 GenCount==0，一个字节都不写。
    if (art.GenCount > 0) {
        string genDir = BuildLayout.Resolve(pm, projectDir, isRelease).GeneratedDir;
        // fix-output-dir-aux-outputs：单工程 `--output-dir <dir>` 把 generated 一并收进 `<dir>/generated/<name>`
        // （此前按 manifest 解析 ⇒ 落工程目录旁）。显式 `generated_dir = ""`（不落盘）照旧尊重。
        // workspace 构建（tier != null）不在此列：per-member / flat 两种布局的 generated 归属另议。
        if (genDir != "" && outputDirOverride.Length > 0 && tier == null) {
            genDir = Path.Join(Path.Join(outputDirOverride, "generated"), pm.Project.Name);
        }
        if (genDir != "") {
            // 🔴 落盘目录**必须在 `[sources] include` 扫描范围之外**：否则下一次构建会把生成的
            // partial 碎片当成**用户源码再编一遍** —— 同一个类出现两份带同名成员的碎片，直接踩
            // 「跨碎片重载 → 静默覆盖」（partial-types.md）：用户自己的方法被吃掉、调用点报出
            // 一条看不懂的假类型错。这个配置配错的后果是「你的方法静默消失」，所以**报错拒绝**、
            // 不只是 warn。默认值在 artifacts/ 之下，天然安全。
            string absProjG = Path.IsRooted(projectDir) ? projectDir
                : Path.Join(Environment.GetCurrentDirectory(), projectDir);
            if (genDir.StartsWith(Path.Join(absProjG, "src"))) {
                ConsoleError.WriteLine("z42c build: [build] generated_dir (" + genDir
                    + ") is inside the source tree; generated fragments would be re-compiled as user "
                    + "sources on the next build and silently shadow your own members. Point it outside "
                    + "[sources].include (the default is <output_dir>/generated)");
                return ExitCode.BuildError;
            }
            Directory.Create(genDir);
            int gi = 0;
            while (gi < art.GenCount) {
                if (art.GenTexts[gi] != "") {
                    File.WriteAllText(Path.Join(genDir, art.GenFiles[gi]), art.GenTexts[gi]);
                }
                gi = gi + 1;
            }
        }
    }
    ZpkgFileZ z = art.Z;
    ZbcFileZ[] mods = art.Mods;
    // union 模块数（含 generator 产出的 CU）——indexed dist 的循环上界必须用它，不能用 srcs.Length，
    // 否则带 generator 的工程崩在 WriteIndexedMain 的越界上（见 IndexedDist.z42 头注）。
    int modN = art.ModCount;
    if (isPacked) { _stabilizeSourceIdentity(z, projectDir); }   // 可复现 build_id（BuildPaths.z42）
    Directory.Create(distDir);
    // ── 多 exe 多产物（unify-run-modes P3）：一个 manifest 声明 N 个 [[exe]] → N 个
    //    dist/<name>.zpkg。[sources] 已在上方编译一次；此处按 exe 重烤 name/entry（共享
    //    字节，只改 META）后各写一份，复用现有单入口烘焙链。非破坏：ExeCount==0 落到下方
    //    未改动的单产物路径（z42c 自身源无 [[exe]] → 自举 gen1==gen2 不受扰）。
    //    首切：exe 专属 src 子集 + 增量 preserved 后置，多 exe 一律全量、共享 [sources]。
    if (pm.ExeCount > 0) {
        int xi = 0;
        while (xi < pm.ExeCount) {
            ExeTarget ex = pm.Exes[xi];
            if (ex.SrcCount > 0) {
                ConsoleError.WriteLine("z42c build: [[exe]] `" + ex.Name + "` 声明了独立 `src` 子集——per-exe 源集尚未支持（当前所有 exe 共享 [sources]）；移除 `src` 或拆成独立工程");
                return ExitCode.UsageError;
            }
            if (ex.Entry.Length == 0) {
                ConsoleError.WriteLine("z42c build: [[exe]] `" + ex.Name + "` 缺少 `entry`（全限定 Main 函数名）");
                return ExitCode.UsageError;
            }
            z.Name = ex.Name;      // 产物文件名 + 包内标识
            z.IsExe = true;
            z.Entry = ex.Entry;    // 重烤 baked entry
            if (!isPacked) {
                string idxCacheX = effCacheDir;
                int ircX = _writeIndexedDist(distDir, idxCacheX, projectDir, srcs, z, mods, modN, prep);
                if (ircX != 0) { return ircX; }
            } else {
                ZpkgWriteResult wresX = ZpkgWriterZ.WritePackedWithSidecar(z, isRelease);
                string outX = Path.Join(distDir, ex.Name + ".zpkg");
                File.WriteAllBytes(outX, wresX.Main);
                BuildLog.Progress("wrote -> " + BuildLayout.Display(outX));
                if (wresX.HasSidecar) {
                    string symX = Path.Join(distDir, ex.Name + ".zsym");
                    File.WriteAllBytes(symX, wresX.Sidecar);
                    BuildLog.Progress("wrote -> " + BuildLayout.Display(symX));
                }
            }
            // 运行配置侧车（complete-runtime-settings P5）：每个产物一份。
            int rcx = _writeRuntimeConfigSidecar(pm, distDir, ex.Name, isRelease);
            if (rcx != 0) { return rcx; }
            xi = xi + 1;
        }
        // 依赖 bundling 一次（各 exe 共享同一 dist）。
        int mbc = _bundleExeDeps(pm, closureNames, closureN, distDir, libsDirs, libsDirsN);
        if (mbc != 0) { return mbc; }
        // 多 exe 同样落 cache（cache-dir-layout：此前此分支提前 return，从不写 cache）。
        if (writeCache) { _writeBuildCache(pm, projectDir, isRelease, cacheDirOverride, srcs, texts, srcHashes, cms, mods, prep, metaIdents, metaSurfaces, depsId, feats, art.CuDiags); }
        return ExitCode.Ok;
    }
    string outPath = Path.Join(distDir, pm.Project.Name + ".zpkg");
    if (!isPacked) {
        // indexed（开发态，add-indexed-zpkg-min-patch）：散装自包含 zbc（字节稳定投影）
        // + FILE 目录主文件。cache 目录供 cached 文件字节原样复制（增量未启时不消费）。
        string idxCache = effCacheDir;
        int irc = _writeIndexedDist(distDir, idxCache, projectDir, srcs, z, mods, modN, prep);
        if (irc != 0) { return irc; }
    } else {
        // release → strip-symbols：主 zpkg（MODS dbug_len=0 + BLID）+ .zsym sidecar（split-debug）。
        ZpkgWriteResult wres = ZpkgWriterZ.WritePackedWithSidecar(z, isRelease);
        File.WriteAllBytes(outPath, wres.Main);
        BuildLog.Progress("wrote -> " + BuildLayout.Display(outPath));
        if (wres.HasSidecar) {
            string symPath = Path.Join(distDir, pm.Project.Name + ".zsym");
            File.WriteAllBytes(symPath, wres.Sidecar);
            BuildLog.Progress("wrote -> " + BuildLayout.Display(symPath));
        }
    }
    // 运行配置侧车（complete-runtime-settings P5）：只对 exe 产物；无 [profile.*]
    // 旋钮时不产文件（非破坏——从前没有侧车的工程 dist 内容逐字节不变）。
    if (isExe) {
        int rc1 = _writeRuntimeConfigSidecar(pm, distDir, pm.Project.Name, isRelease);
        if (rc1 != 0) { return rc1; }
    }
    // cache 落盘（cache-dir-layout：不论是否增量都落盘，helper 见 BuildCache.z42）。
    if (writeCache) { _writeBuildCache(pm, projectDir, isRelease, cacheDirOverride, srcs, texts, srcHashes, cms, mods, prep, metaIdents, metaSurfaces, depsId, feats, art.CuDiags); }
    // 自包含 exe（.NET bin/ 式）：把非标准库依赖 zpkg 复制进 dist，使 exe 可从自身目录运行。
    if (isExe) {
        int bc = _bundleExeDeps(pm, closureNames, closureN, distDir, libsDirs, libsDirsN);
        if (bc != 0) { return bc; }
    }
    return ExitCode.Ok;
}

// 自包含 exe 依赖复制（镜像 z42b publish `_pubBundleProjectDeps`）。把 exe 直接声明的
void _usage() {
    Console.WriteLine("z42c (self-host) 0.1.0 — bootstrap (lex/parse/typecheck front-end)");
    Console.WriteLine("usage:");
    Console.WriteLine("  z42c --dump-keywords                   keyword table (one per line)");
    Console.WriteLine("  z42c --dump-tokens <file.z42>          token stream");
    Console.WriteLine("  z42c --dump-ast    <file.z42>          AST s-expression");
    Console.WriteLine("  z42c --dump-bound  <file.z42>          type-checked Bound tree");
    Console.WriteLine("  z42c --dump-ir     <file.z42>          .zasm-like IR text");
    Console.WriteLine("  z42c --emit-zbc    <file.z42> <out> [--opt-all]   compile to .zbc (subset)");
    Console.WriteLine("  z42c build         [<manifest>]        build a project (see `z42c build --help`)");
    Console.WriteLine("  (clean / test / bench are run by z42b, not z42c — the compiler only compiles)");
}
