// z42c driver —— path 依赖闭包的代建（`_buildPathDepClosure`）。从 Main.z42 `_build` 逐行搬出的**纯移动**
// （Main.z42 贴 886 行硬上限；code-organization.md），同包同 namespace，调用方 `_build` 一处。
namespace Z42.Driver;

using Std;
using Std.IO;
using Z42.Project;

// 闭包代建的结果（z42 函数只能返回一个值）：Rc != 0 = 失败（诊断已打印）；Names = 闭包成员名单（交给
// `_bundleExeDeps`）；LibsDirs = 消费方新的解析域（闭包为空时原样返回入参）。
public sealed class PathClosureOut {
    public int      Rc;
    public string[] Names;    public int NamesN;
    public string[] LibsDirs; public int LibsDirsN;
    public PathClosureOut(string[] libsDirs, int libsDirsN) {
        this.Rc = 0; this.Names = new string[0]; this.NamesN = 0;
        this.LibsDirs = libsDirs; this.LibsDirsN = libsDirsN;
    }
}

// ── path 依赖闭包（add-path-dependencies 阶段2 use）──
// top-level build（libsDirsCount==0）才解析：沿 `dep = { path = "..." }` 边建传递闭包
// （叶子在前），逐个 `_build` 并累积其 dist，最后并入消费方 libsDirs。workspace / 闭包子建
// 传 libsDirsOverride（count>0）→ 已由调用方组装好 libsDirs，跳过（叶子无 path 依赖，闭包空）。
// fix-path-dep-closure：闭包成员名单抄出来交给 `_bundleExeDeps`——exe 的 dist 必须装
// **整个闭包**，不只直接依赖（否则 path 依赖链深度 >1 运行期就找不到传递包）。
// ⚠️ **不在 `_bundleExeDeps` 里重算**：非 top-level 子建（libsDirsCount>0）本就跳过解析，
// 那里的相对路径未必解得开——实测会抛 `No such file or directory`（e2e `buildclos` 抢到）。
PathClosureOut _buildPathDepClosure(string tomlPath, bool isRelease, bool noIncremental, int cliAdd, int cliRemove,
                                    string[] libsDirs, int libsDirsN) {
    PathClosureOut o = new PathClosureOut(libsDirs, libsDirsN);
    // 🔴 `PathDepPlan.Resolve` 会**抛**（依赖成环 / 目录里不是恰一份 manifest）。此前无人
    // 接住 ⇒ 用户拿到的是带 z42c 内部栈帧的 `uncaught exception`，而异常消息里那句话本身
    // 是好的。同 #807 修掉的 `Pipeline.Compile`：真因已知却被一层无关噪音盖住。
    // 落点已从 `z42c.pipeline` 搬到 `z42.project`（零编译器依赖，且 z42b 也要用它）。
    // `Z42.Pipeline` 那层同名转发（曾为种子 ABI 保留）已于 2026-09-29 删除 ——
    // 保留**全限定**写法：它现在只是明示落点，不再是消歧。
    Z42.Project.PathDepClosure closure;
    try {
        closure = Z42.Project.PathDepPlan.Resolve(tomlPath);
    } catch (Exception e) {
        ConsoleError.WriteLine(e.Message);
        o.Rc = ExitCode.BuildError; return o;
    }
    if (closure.Count > 0) {
        o.Names = new string[closure.Count];
        string baseLib = Environment.GetEnvironmentVariable("Z42_LIBS", "");
        string[] accum = new string[closure.Count];
        int accN = 0;
        int ci = 0;
        while (ci < closure.Count) {
            string depToml = closure.Tomls[ci];
            ci = ci + 1;
            ProjectManifest depPm = ManifestLoader.Load(depToml);
            // 双向校验之二（add-package-roles 批 2）：编译期扩展不得出现在 `[dependencies]`。
            // 它只在编译器进程里活、永不链入产物；写进依赖等于让**运行期**代码引用一个不会到场的包。
            // 名字条目查不出来（zpkg 不记 kind，不为一条校验动格式）——path 条目手上有 manifest，
            // 这也正是用户自建 analyzer 的实际写法。
            if (depPm.Project.Kind == "analyzer") {
                ConsoleError.WriteLine("z42c build: [dependencies] `" + depPm.Project.Name
                    + "` 是 kind = \"analyzer\" 的编译期扩展工程，不能作运行期依赖。"
                    + "改法：把它挪进 [analyzers] 段（同样支持 `{ path = \"...\" }`）。");
                o.Rc = ExitCode.BuildError; return o;
            }
            string depDir = Path.GetDirectoryName(depToml);
            if (depDir.Length == 0) { depDir = "."; }
            string depDist = BuildLayout.Resolve(depPm, depDir, isRelease).DistDir;
            // 该成员的 libsDirs override = 已建闭包成员 dist（post-order → 其依赖已在内）+ Z42_LIBS。
            string[] depOverride = new string[accN + 1];
            int oi = 0;
            while (oi < accN) { depOverride[oi] = accum[oi]; oi = oi + 1; }
            int depOverrideN = accN;
            if (baseLib.Length > 0) { depOverride[depOverrideN] = baseLib; depOverrideN = depOverrideN + 1; }
            int dbc = _build(depToml, isRelease, "", "", depOverride, depOverrideN, noIncremental, cliAdd, cliRemove, false, null);
            if (dbc != 0) { o.Rc = dbc; return o; }
            accum[accN] = depDist; accN = accN + 1;
            o.Names[o.NamesN] = depPm.Project.Name; o.NamesN = o.NamesN + 1;
        }
        // 消费方 libsDirs = 闭包全 dist + Z42_LIBS。
        string[] merged = new string[accN + 1];
        int mi = 0;
        while (mi < accN) { merged[mi] = accum[mi]; mi = mi + 1; }
        int mergedN = accN;
        if (baseLib.Length > 0) { merged[mergedN] = baseLib; mergedN = mergedN + 1; }
        o.LibsDirs = merged; o.LibsDirsN = mergedN;
    }
    return o;
}
