// 文件级增量的 driver 侧编排（add-file-level-incremental 阶段 4；Main._build 调用）。
// 职责：token/定义名提取（D3 保守边输入）→ ProbeFiles+Close → cached zbc 读回 +
// meta 残留回填（D5a：块 label / 模块池原序 / TIDX idx）→ 失败降级 fresh（含其
// 依赖方重闭包）→ fresh 落 cache（zbc + meta + 包级源清单）。
// Main.z42 只留编排调用（500 行硬限）；本文件承载全部增量细节。
namespace Z42.Driver;

using Std;
using Std.IO;
using Z42.Syntax;
using Z42.Semantics;
using Z42.Project;
using Z42.IR;
using Z42.IR.BinaryFormat;
using Z42.Pipeline;

// 增量准备结论：plan + 复用的 CU + cached IrModule（残留已回填；Fresh[i] 处 null）
// + fresh 行的标识符集（parse 时捕获，WriteMetas 消费——零第二遍 lex，D8 修正）。
public sealed class IncrPrep {
    public IncrFilePlan       Plan;
    public CompilationUnit[]  Cus;
    public IrModule[]         Cached;
    public NameListZ[]        Idents;
    public NameSurfacesZ[]    Surfaces;   // fresh 行的名字级声明面（WriteMetas 消费）；其余 null
    public IncrPrep(IncrFilePlan plan, CompilationUnit[] cus, IrModule[] cached) {
        this.Plan = plan; this.Cus = cus; this.Cached = cached;
        this.Idents = null;
        this.Surfaces = null;
    }
}

// parse-all 产物束：CU + 按需捕获的标识符集与声明面指纹（want[i] 为真才提取）。
public sealed class ParsedPkg {
    public CompilationUnit[] Cus;
    public NameListZ[]       Idents;
    public NameSurfacesZ[]   Surfaces;
    public ParsedPkg(CompilationUnit[] cus, NameListZ[] idents, NameSurfacesZ[] surfaces) {
        this.Cus = cus; this.Idents = idents; this.Surfaces = surfaces;
    }
}

public static class IncrementalDriver {

    // 全文件 parse（+ AttributeSynth，镜像 IrDump.ParseAll）+ 按需标识符 / 声明面捕获：
    // want[i] 为真的文件从 Parser 已 lex 的 token 流提取标识符集与声明面指纹（D8 修正——
    // 全链路零第二遍 lex）；want == null → 全不捕获（workspace 等不落 cache 的路径）。
    // 声明面指纹取 **RunAst 之前**的 raw CU（合成成员无真实 token 区间，见 SurfaceHash.z42）。
    public static ParsedPkg ParseAllTk(string[] texts, string[] srcs, int n, bool[] want) {
        CompilationUnit[] cus = new CompilationUnit[n];
        NameListZ[] idents = new NameListZ[n];
        NameSurfacesZ[] surfaces = new NameSurfacesZ[n];
        int i = 0;
        while (i < n) {
            var pp = new Parser(texts[i], srcs[i]);
            CompilationUnit raw = pp.ParseCompilationUnit();
            if (want != null && want[i]) {
                idents[i] = IncrementalDriver._identsOf(pp.Tokens());
                surfaces[i] = SurfaceHash.Of(raw, pp.Tokens());
            }
            cus[i] = HandlerRegistry.RunAst(raw);   // attribute-handler-registry：AST-phase 单一入口（内建 Generator + store-meta 合成）
            i = i + 1;
        }
        return new ParsedPkg(cus, idents, surfaces);
    }

    // 全流程：种子 → parse-all（顺手捕获 fresh 行标识符）→ 闭包 → cached 读回+回填
    //（失败降级 fresh + 重闭包）。noIncremental / workspace 路径由调用方拦截，不进本函数。
    //
    // canPreserve = 调用方**已经确认**「一旦全命中就直接沿用上次 dist、不再装配」（dist 主文件在、
    // pack 模式一致、非多 exe）。只有此时全命中才可以廉价早退——因为调用方压根不会用到 IrModule。
    // canPreserve=false 时**必须走完整路径**把 cached zbc 读回来：调用方还要装配一次 dist，
    // 拿不到 IrModule 就只能全部重编，缓存白存（fix-incr-allcached-cache-drop 修的正是这条）。
    public static IncrPrep Prepare(string[] srcs, string[] texts, string[] hashes, int n,
                                   string projectDir, string cacheDir, bool canPreserve) {
        IncrFilePlan plan = IncrementalBuild.ProbeFiles(srcs, hashes, n, projectDir, cacheDir);
        IrModule[] cached = new IrModule[n];
        if (plan.AllCached && canPreserve) { return new IncrPrep(plan, null, cached); }   // 调用方马上 preserved → 不必读回

        // 降级前留存 meta 引用（Close/降级会把 Metas[i] 置 null，而其 token 集是该行
        // 之后写回 meta 时的零成本来源——源未变，token 集不变）。
        CacheMeta[] metas0 = new CacheMeta[n];
        int i = 0;
        while (i < n) { metas0[i] = plan.Metas[i]; i = i + 1; }

        ParsedPkg pk = IncrementalDriver.ParseAllTk(texts, srcs, n, plan.Fresh);
        CompilationUnit[] cus = pk.Cus;
        bool incrDebug = (Environment.GetEnvironmentVariable("Z42_INCR_DEBUG") ?? "") == "1";

        // 闭包三份输入（incr-name-level-invalidation）。**cached 行一律从上次 meta 取**——源未变，
        // 这三样都不变，零重算（D8 教训：为闭包对全部文件多走一遍 lex，增量会反比全量慢）。
        NameListZ[] tokens = new NameListZ[n];      // 全部标识符（含体内）—— 失效判据
        NameListZ[] surfIdents = new NameListZ[n];  // 声明面标识符 —— 传播判据
        NameListZ[] names = new NameListZ[n];       // 本文件定义的名字
        i = 0;
        while (i < n) {
            if (plan.Fresh[i]) {
                // 种子失效行：token 集 Close 用不到（只查 !Fresh 行），给空表省内存。
                tokens[i] = new NameListZ(new string[0], 0);
                if (pk.Surfaces[i] != null) {
                    surfIdents[i] = new NameListZ(pk.Surfaces[i].SurfIdents, pk.Surfaces[i].SurfIdentCount);
                    names[i] = new NameListZ(pk.Surfaces[i].Names, pk.Surfaces[i].Count);
                } else if (plan.Prev[i] != null) {
                    surfIdents[i] = new NameListZ(plan.Prev[i].SurfIdents, plan.Prev[i].SurfIdentCount);
                    names[i] = new NameListZ(plan.Prev[i].NsNames, plan.Prev[i].NsCount);
                }
            } else {
                tokens[i] = new NameListZ(plan.Metas[i].Tokens, plan.Metas[i].TokenCount);
                surfIdents[i] = new NameListZ(plan.Metas[i].SurfIdents, plan.Metas[i].SurfIdentCount);
                names[i] = new NameListZ(plan.Metas[i].NsNames, plan.Metas[i].NsCount);
            }
            i = i + 1;
        }

        // 种子已变名字：逐名字 diff 当前指纹 vs 上次 meta（新增 / 删除 / 指纹变 三者都算变）。
        // 没有上次条目（首建 / 换 meta 版本）→ 该文件当前全部名字计入，保守。
        NameListZ seedChanged = IncrementalDriver._seedChangedNames(plan, pk.Surfaces, n, srcs, projectDir, incrDebug);
        IncrementalBuild.Close(plan, srcs, projectDir, tokens, surfIdents, names, seedChanged);

        // cached 读回 + 残留回填；任一失败 → 该文件 fresh + 重闭包（依赖方连带失效）。
        bool stable = false;
        while (!stable) {
            stable = true;
            i = 0;
            while (i < n) {
                if (!plan.Fresh[i] && cached[i] == null) {
                    string rel = IncrementalBuild.Rel(projectDir, srcs[i]);
                    IrModule m = null;
                    try {
                        byte[] zbc = File.ReadAllBytes(CacheStore.ZbcPath(cacheDir, rel));
                        m = ZbcReader.Read(zbc);
                    } catch (Exception e) { m = null; }
                    if (m != null && !IncrementalDriver._applyResidue(m, plan.Metas[i])) { m = null; }
                    if (m == null) {
                        ConsoleError.WriteLine("  [degrade/unreadable-cache] " + rel + " -> fresh");
                        plan.Fresh[i] = true; plan.FreshCount = plan.FreshCount + 1;
                        // 降级只因 zbc 读不回来——源、声明面均未变 → 不引入任何已变名字
                        //（否则「缓存坏一个」会退化成全包重编）。重跑闭包只为让**已有**的已变名字
                        // 波及到本行新暴露的依赖方。
                        plan.Metas[i] = null;
                        IncrementalBuild.Close(plan, srcs, projectDir, tokens, surfIdents, names, seedChanged);
                        stable = false;
                    } else {
                        cached[i] = m;
                    }
                }
                if (plan.Fresh[i] && cached[i] != null) { cached[i] = null; }   // 降级波及后清残影
                i = i + 1;
            }
        }
        plan.AllCached = plan.FreshCount == 0;
        // fresh 行标识符汇总（WriteMetas 消费）：种子 fresh = parse 时捕获；闭包/降级
        // 转 fresh 的行源未变 → 从留存 meta 取（零 lex）。两者皆无 → WriteMetas 兜底 lex。
        NameListZ[] idents = new NameListZ[n];
        i = 0;
        while (i < n) {
            if (plan.Fresh[i]) {
                if (pk.Idents[i] != null) { idents[i] = pk.Idents[i]; }
                else if (metas0[i] != null) { idents[i] = new NameListZ(metas0[i].Tokens, metas0[i].TokenCount); }
            }
            i = i + 1;
        }
        // 同款来源规则给名字级声明面：种子 fresh = parse 时算的；闭包/降级转 fresh 的行源未变
        // → 沿用上次 meta 里的值（零重算）。两者皆无 → WriteMetas 兜底重算。
        NameSurfacesZ[] surfaces = new NameSurfacesZ[n];
        i = 0;
        while (i < n) {
            if (plan.Fresh[i]) {
                if (pk.Surfaces[i] != null) { surfaces[i] = pk.Surfaces[i]; }
                else if (metas0[i] != null) {
                    surfaces[i] = new NameSurfacesZ(metas0[i].NsNames, metas0[i].NsHashes, metas0[i].NsCount,
                                                   metas0[i].SurfIdents, metas0[i].SurfIdentCount);
                }
            }
            i = i + 1;
        }
        IncrPrep prep = new IncrPrep(plan, cus, cached);
        prep.Idents = idents;
        prep.Surfaces = surfaces;
        return prep;
    }

    // fresh 文件落 cache（zbc 由 Main._writeCacheZbc 已写）：meta（hash/ns/usedDepNs +
    // 残留 pool/labels）+ 包级源清单。任何写失败由调用方 try/catch 吞（cache 非致命）。
    public static void WriteMetas(string cacheDir, string projectDir, string[] srcs, string[] texts,
                                  string[] hashes, int n, CompiledModuleZ[] cms, ZbcFileZ[] mods,
                                  IncrFilePlan plan, NameListZ[] idents, NameSurfacesZ[] surfaces) {
        string[] rels = new string[n];
        int i = 0;
        while (i < n) {
            rels[i] = IncrementalBuild.Rel(projectDir, srcs[i]);
            if (plan == null || plan.Fresh[i]) {
                CacheMeta m = new CacheMeta(rels[i]);
                m.SourceHash = hashes[i];
                m.Namespace = mods[i].Namespace;
                m.UsedDepNs = cms[i].UsedDepNs; m.UsedDepNsCount = cms[i].UsedDepNsCount;
                // parse 时已捕获（D8 修正）；无捕获（异常路径）才兜底 lex 一次。
                NameListZ tk = (idents != null && idents[i] != null)
                    ? idents[i] : IncrementalDriver._tokensOf(texts[i], srcs[i]);
                m.Tokens = tk.Items; m.TokenCount = tk.Count;
                // 名字级声明面：parse 时已算（或从上次 meta 沿用）；无捕获（异常路径 / 全量
                // 且未落 want）才兜底重 parse 一次。
                NameSurfacesZ ns = (surfaces != null && surfaces[i] != null)
                    ? surfaces[i] : IncrementalDriver._surfaceOfText(texts[i], srcs[i]);
                m.NsNames = ns.Names; m.NsHashes = ns.Hashes; m.NsCount = ns.Count;
                m.SurfIdents = ns.SurfIdents; m.SurfIdentCount = ns.SurfIdentCount;
                IrModule irm = cms[i].Module;
                string[] pool = new string[irm.StringCount > 1 ? irm.StringCount - 1 : 0];
                int p = 1;
                while (p < irm.StringCount) { pool[p - 1] = irm.StringPool[p]; p = p + 1; }
                m.Pool = pool; m.PoolCount = pool.Length;
                string[] fl = new string[irm.FuncCount];
                int f = 0;
                while (f < irm.FuncCount) {
                    IrFunction fd = irm.Functions[f];
                    string line = "";
                    int b = 0;
                    while (b < fd.BlockCount) {
                        if (b > 0) { line = line + " "; }
                        line = line + CacheStore.HexEnc(fd.Blocks[b].Label);
                        b = b + 1;
                    }
                    fl[f] = line;
                    f = f + 1;
                }
                m.FnLabels = fl; m.FnLabelsCount = irm.FuncCount;
                CacheStore.Save(cacheDir, m);
            }
            i = i + 1;
        }
        CacheStore.SaveSrcList(cacheDir, rels, n);
    }

    // ── 残留回填（D5a）：占位 label → 真实 label；模块池 → meta 原序；TIDX idx 重映射 ──

    private static bool _applyResidue(IrModule irm, CacheMeta meta) {
        if (meta == null) { return false; }
        if (meta.FnLabelsCount != irm.FuncCount) { return false; }
        // ① 块 label + 终结符/异常表引用改名。
        int f = 0;
        while (f < irm.FuncCount) {
            IrFunction fd = irm.Functions[f];
            string[] parts = meta.FnLabels[f].Split(" ");
            if (parts.Length != fd.BlockCount) { return false; }
            string[] real = new string[fd.BlockCount];
            int b = 0;
            while (b < fd.BlockCount) { real[b] = CacheStore.HexDec(parts[b]); b = b + 1; }
            b = 0;
            while (b < fd.BlockCount) {
                IrBlock blk = fd.Blocks[b];
                blk.Label = real[b];
                if (blk.HasTerm) {
                    if (blk.Term is BrTerm) {
                        BrTerm t = blk.Term as BrTerm;
                        t.Label = IncrementalDriver._renameBl(t.Label, real, fd.BlockCount);
                    }
                    if (blk.Term is BrCondTerm) {
                        BrCondTerm t = blk.Term as BrCondTerm;
                        t.TrueLabel = IncrementalDriver._renameBl(t.TrueLabel, real, fd.BlockCount);
                        t.FalseLabel = IncrementalDriver._renameBl(t.FalseLabel, real, fd.BlockCount);
                    }
                }
                b = b + 1;
            }
            int x = 0;
            while (x < fd.ExcCount) {
                IrExcEntry e = fd.ExcTable[x];
                e.TryStart = IncrementalDriver._renameBl(e.TryStart, real, fd.BlockCount);
                e.TryEnd = IncrementalDriver._renameBl(e.TryEnd, real, fd.BlockCount);
                e.CatchLabel = IncrementalDriver._renameBl(e.CatchLabel, real, fd.BlockCount);
                x = x + 1;
            }
            f = f + 1;
        }
        // ② 模块池 → meta 原序；ConstStr / TIDX idx 按串值重映射（池条目唯一）。
        string[] newPool = new string[meta.PoolCount + 1];
        newPool[0] = "";
        StrMap poolIdx = new StrMap();
        int p = 0;
        while (p < meta.PoolCount) {
            newPool[p + 1] = meta.Pool[p];
            poolIdx.Put(meta.Pool[p], new IntBoxZ(p + 1));
            p = p + 1;
        }
        f = 0;
        while (f < irm.FuncCount) {
            IrFunction fd = irm.Functions[f];
            int b = 0;
            while (b < fd.BlockCount) {
                IrBlock blk = fd.Blocks[b];
                int k = 0;
                while (k < blk.InstrCount) {
                    if (blk.Instrs[k] is ConstStrInstr) {
                        ConstStrInstr cs = blk.Instrs[k] as ConstStrInstr;
                        int ni = IncrementalDriver._poolLookup(poolIdx, irm, cs.Idx);
                        if (ni < 0) { return false; }
                        cs.Idx = ni;
                    }
                    k = k + 1;
                }
                b = b + 1;
            }
            f = f + 1;
        }
        int e2 = 0;
        while (e2 < irm.TestCount) {
            IrTestEntry t = irm.TestIndex[e2];
            t.SkipReasonStrIdx = IncrementalDriver._poolRemapOrZero(poolIdx, irm, t.SkipReasonStrIdx);
            t.SkipPlatformStrIdx = IncrementalDriver._poolRemapOrZero(poolIdx, irm, t.SkipPlatformStrIdx);
            t.SkipFeatureStrIdx = IncrementalDriver._poolRemapOrZero(poolIdx, irm, t.SkipFeatureStrIdx);
            t.ExpectedThrowTypeIdx = IncrementalDriver._poolRemapOrZero(poolIdx, irm, t.ExpectedThrowTypeIdx);
            int tc = 0;
            while (tc < t.TestCaseCount) {
                t.TestCases[tc].ArgReprStrIdx = IncrementalDriver._poolRemapOrZero(poolIdx, irm, t.TestCases[tc].ArgReprStrIdx);
                tc = tc + 1;
            }
            e2 = e2 + 1;
        }
        irm.StringPool = newPool;
        irm.StringCount = meta.PoolCount + 1;
        return true;
    }

    // 占位 "entry"/"block_N" → real[N]；N==blockCount（TryEnd 哨兵）与其它文本原样保留。
    private static string _renameBl(string ph, string[] real, int blockCount) {
        if (ph == "entry") { return real[0]; }
        if (ph.StartsWith("block_")) {
            int v = 0;
            bool ok = ph.Length > 6;
            int i = 6;
            while (i < ph.Length) {
                char ch = ph.CharAt(i);
                if (ch < '0' || ch > '9') { ok = false; i = ph.Length; }
                else { v = v * 10 + ((int)ch - 48); i = i + 1; }
            }
            if (ok && v < blockCount) { return real[v]; }
        }
        return ph;
    }

    // 读回件当前池 idx → 串 → meta 池 idx；找不到 → -1（残留与 zbc 不一致，降级）。
    private static int _poolLookup(StrMap poolIdx, IrModule irm, int curIdx) {
        if (curIdx <= 0 || curIdx >= irm.StringCount) { return 0 - 1; }
        string v = irm.StringPool[curIdx];
        if (!poolIdx.ContainsKey(v)) { return 0 - 1; }
        return (poolIdx.Get(v) as IntBoxZ).Value;
    }
    private static int _poolRemapOrZero(StrMap poolIdx, IrModule irm, int curIdx) {
        if (curIdx <= 0) { return 0; }
        int ni = IncrementalDriver._poolLookup(poolIdx, irm, curIdx);
        if (ni < 0) { return 0; }
        return ni;
    }

    // ── D3 保守边输入 ────────────────────────────────────────────────────────────

    // 标识符 token 集（去重；Lexer 只取 Identifier——关键字/字面量/符号天然排除）。
    // 兜底路径（正常路径 = parse 时经 Parser.Tokens() 捕获，见 ParseAllTk）。
    // 种子已变名字集：逐名字 diff「当前源算出的指纹」vs「上次 meta 里的指纹」。
    // 三种情况都算变：**新增**的名字（上次没有）、**删除**的名字（上次有、这次没有）、
    // 指纹**不同**的名字。没有上次条目（首建 / 换 meta 版本）→ 该文件当前全部名字保守计入。
    // 只有**种子**失效行（源 hash 真的变了）才可能引入已变名字：闭包/降级转 fresh 的行源未变，
    // 它们的名字要不要计入由 Close 的「声明面提到已变名字才继续传」那条规则决定。
    private static NameListZ _seedChangedNames(IncrFilePlan plan, NameSurfacesZ[] surfaces, int n,
                                               string[] srcs, string projectDir, bool debug) {
        StrMap seen = new StrMap();
        string[] items = new string[16];
        int cnt = 0;
        int i = 0;
        while (i < n) {
            NameSurfacesZ cur = surfaces[i];
            if (plan.Fresh[i] && cur != null) {
                CacheMeta prev = plan.Prev[i];
                StrMap prevH = new StrMap();
                if (prev != null) {
                    int p = 0;
                    while (p < prev.NsCount) { prevH.Put(prev.NsNames[p], prev.NsHashes[p]); p = p + 1; }
                }
                StrMap curH = new StrMap();
                int k = 0;
                while (k < cur.Count) { curH.Put(cur.Names[k], cur.Hashes[k]); k = k + 1; }
                k = 0;
                while (k < cur.Count) {
                    bool diff = prev == null || !prevH.ContainsKey(cur.Names[k])
                             || (prevH.Get(cur.Names[k]) as string) != cur.Hashes[k];
                    if (diff && !seen.ContainsKey(cur.Names[k])) {
                        seen.Put(cur.Names[k], cur);
                        cnt = IncrementalDriver._add(items, cnt, cur.Names[k]); items = IncrementalDriver._last;
                        if (debug) {
                            ConsoleError.WriteLine("  [name-changed] " + IncrementalBuild.Rel(projectDir, srcs[i])
                                + " :: " + cur.Names[k]);
                        }
                    }
                    k = k + 1;
                }
                if (prev != null) {
                    int q = 0;
                    while (q < prev.NsCount) {
                        if (!curH.ContainsKey(prev.NsNames[q]) && !seen.ContainsKey(prev.NsNames[q])) {
                            seen.Put(prev.NsNames[q], cur);
                            cnt = IncrementalDriver._add(items, cnt, prev.NsNames[q]); items = IncrementalDriver._last;
                            if (debug) {
                                ConsoleError.WriteLine("  [name-removed] " + IncrementalBuild.Rel(projectDir, srcs[i])
                                    + " :: " + prev.NsNames[q]);
                            }
                        }
                        q = q + 1;
                    }
                }
            }
            i = i + 1;
        }
        return new NameListZ(items, cnt);
    }

    private static NameListZ _tokensOf(string text, string file) {
        var lx = new Lexer(text, file);
        lx.Tokenize();
        return IncrementalDriver._identsOf(lx);
    }

    // 声明面指纹的兜底重算（需要 AST 定体边界 → 重 parse 一次；正常路径走 ParseAllTk 的捕获）。
    private static NameSurfacesZ _surfaceOfText(string text, string file) {
        var pp = new Parser(text, file);
        CompilationUnit raw = pp.ParseCompilationUnit();
        return SurfaceHash.Of(raw, pp.Tokens());
    }

    // 从已 lex 的 token 流提取标识符去重集（零额外 lex）。
    private static NameListZ _identsOf(Lexer lx) {
        StrMap seen = new StrMap();
        string[] items = new string[16];
        int n = 0;
        int i = 0;
        while (i < lx.TokenCount()) {
            Token t = lx.TokenAt(i);
            if (t.Kind == TokenKind.Identifier && !seen.ContainsKey(t.Text)) {
                seen.Put(t.Text, t);
                if (n == items.Length) {
                    string[] b = new string[items.Length * 2];
                    int k = 0; while (k < n) { b[k] = items[k]; k = k + 1; }
                    items = b;
                }
                items[n] = t.Text; n = n + 1;
            }
            i = i + 1;
        }
        return new NameListZ(items, n);
    }



    // 追加（扩容经 _last 旁路返回新数组；z42 无 ref 参）。
    private static string[] _last = null;
    private static int _add(string[] items, int n, string v) {
        if (n == items.Length) {
            string[] b = new string[items.Length * 2];
            int k = 0; while (k < n) { b[k] = items[k]; k = k + 1; }
            items = b;
        }
        items[n] = v;
        IncrementalDriver._last = items;
        return n + 1;
    }
}

// int 装箱（StrMap value 用；z42 object 槽放原生 int 不便）。
public sealed class IntBoxZ {
    public int Value;
    public IntBoxZ(int v) { this.Value = v; }
}

// 单文件 fullMode .zbc 落盘到 cache（自 Main.z42 迁入，500 行硬限；镜像 C# BuildTarget
// 的 cache 写出：`<cache>/<rel 去 .z42 换 .zbc>`）。仅单工程模式调用。
void _writeCacheZbc(string cacheDir, string projectDir, string src, IrModule irm) {
    // Normalize separators before stripping the projectDir prefix: on Windows `src`
    // may use `\` while the prefix is built with `/`, so an un-normalized StartsWith
    // fails → `rel` stays an absolute path (drive letter) → malformed zbcPath →
    // File.WriteAllBytes "cannot find the path specified" (os error 3).
    string rel = src.Replace("\\", "/");
    string projFwd = projectDir.Replace("\\", "/");
    string prefix = projFwd.EndsWith("/") ? projFwd : projFwd + "/";
    if (rel.StartsWith(prefix)) { rel = rel.Substring(prefix.Length); }
    if (rel.EndsWith(".z42")) { rel = rel.Substring(0, rel.Length - 4); }
    string zbcPath = Path.Join(cacheDir, rel + ".zbc");
    string parent = Path.GetDirectoryName(zbcPath);
    if (parent.Length > 0) { Directory.Create(parent); }
    File.WriteAllBytes(zbcPath, ZbcWriter.Write(irm).ToBytes());
}
