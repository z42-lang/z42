// z42c driver —— exe 依赖 bundling 的**种子名单**（`BundleSeed` / `_bundleSeed`）。
// 从 `_bundleExeDeps` 拆出（retire-member-dep-decls 顺带）：那个函数在 fn-lines 棘轮基线上，
// 且种子来源从两处长到三处，值得有自己的家。
namespace Z42.Driver;

using Std.IO;
using Z42.Package;
using Z42.Project;

// Each source member retains its declaring policy and resolved input domain.
public sealed class BundleDomain {
    public ProjectManifest Manifest;
    public string[] Dirs;
    public int Count;
    public BundleDomain(ProjectManifest manifest) { this.Manifest = manifest; }

    public string Deploy(string name) {
        int i = 0;
        while (i < this.Manifest.DepCount) {
            DepEntry dep = this.Manifest.Deps[i];
            if (dep.Name == name) { return dep.Deploy; }
            i = i + 1;
        }
        return "";
    }
}

public sealed class BundleItem {
    public string Name;
    public string Deploy;
    public bool SdkSkip;
    public BundleDomain Domain;
    public BundleItem(string name, string deploy, bool sdkSkip, BundleDomain domain) {
        this.Name = name; this.Deploy = deploy; this.SdkSkip = sdkSkip; this.Domain = domain;
    }
}

public sealed class BundleSeed {
    public BundleItem[] Items;
    public int N;
    public bool NeedsSdk;
    public BundleSeed(int cap) { this.Items = new BundleItem[cap + 8]; }

    public int IndexOf(string name) {
        int i = 0;
        while (i < this.N) {
            if (this.Items[i].Name == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public void Add(string name, string deploy, bool sdkSkip) {
        if (this.IndexOf(name) < 0) { this.Append(new BundleItem(name, deploy, sdkSkip, null)); }
    }

    public void Append(BundleItem item) {
        if (this.N == this.Items.Length) {
            BundleItem[] next = new BundleItem[this.N * 2];
            Array.Copy(this.Items, next, this.N);
            this.Items = next;
        }
        this.Items[this.N] = item;
        this.N = this.N + 1;
    }
}

// 待拷名单 = ① 直接声明的依赖（pm.Deps）∪ ② **本包刚写出的 zpkg 的 DEPS 段** ；path 构建闭包只提供解析目录，不是部署根
// （fix-path-dep-closure 那份），去重。
//
// ② 是 retire-member-dep-decls 引入：workspace 成员清单不再声明同 workspace 依赖（WS032，经成员 dist
// 自动解析），z42c.driver 这样的成员 exe 原本靠 `[dependencies]` 那批条目当种子把兄弟包拷进自身 dist——
// 条目删了，种子改从**产物自述**取：zpkg 的 DEPS 段由编译期 usings 生成，比清单声明更真（声明了没用的
// 不再捆绑，用了没声明的不再漏）。顺带补上 `_bundleExeDeps` 尾注记的老缺口——「按名引用的依赖没有
// 传递闭包」的第一跳（app 自己 import 了谁）从这里就有，后续跳仍由复制循环里的 DEPS BFS 走。
BundleSeed _bundleSeed(ProjectManifest pm, string distDir, PathClosureOut closure,
                       string[] routedDeps, int routedN) {
    BundleSeed s = new BundleSeed(pm.DepCount);
    int pi = 0;
    while (pi < pm.DepCount) {
        // deps-plugin-routing：分流成插件的 [dependencies] 条目不链入产物——不播种。
        bool routed = false;
        int rk = 0;
        while (rk < routedN) { if (routedDeps[rk] == pm.Deps[pi].Name) { routed = true; break; } rk = rk + 1; }
        if (!routed) { s.Add(pm.Deps[pi].Name, pm.Deps[pi].Deploy, false); }
        pi = pi + 1;
    }
    _seedOwnDeps(pm, distDir, s);
    return s;
}

// 本包各 main（[project].name + [[exe]] 目标）刚落盘的 zpkg → DEPS 段的包名（去 `.zpkg` 后缀、排除
// 本包名）并入名单。zpkg 还没写出来 / 读不开 ⇒ 跳过（bundle 在产物写出后才跑，正常路径必然可读；
// 防御的是手拼 dist 的边界）。
void _seedOwnDeps(ProjectManifest pm, string distDir, BundleSeed s) {
    string[] mains = new string[pm.ExeCount + 1];
    mains[0] = pm.Project.Name;
    int e = 0;
    while (e < pm.ExeCount) { mains[e + 1] = pm.Exes[e].Name; e = e + 1; }
    int k = 0;
    while (k < mains.Length) {
        string p = Path.Join(distDir, mains[k] + ".zpkg");
        k = k + 1;
        if (!File.Exists(p)) { continue; }
        ZpkgInfo zi = null;
        try { zi = ZpkgReader.Open(File.ReadAllBytes(p), p); } catch (Exception ex) { zi = null; }
        if (zi == null) { continue; }
        string[] deps = ZpkgReader.ReadDependencies(zi);
        int d = 0;
        while (d < deps.Length) {
            string df = deps[d];
            d = d + 1;
            if (!df.EndsWith(".zpkg")) { continue; }   // DEPS 段存文件名（同 ExeDeps / SdkLibs 的约定）
            string dn = df.Substring(0, df.Length - 5);
            if (dn != pm.Project.Name) { s.Add(dn, "", true); }
        }
    }
}
