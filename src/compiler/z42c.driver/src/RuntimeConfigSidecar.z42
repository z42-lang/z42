// z42c driver —— `dist/<name>.runtimeconfig.toml` 侧车生成。
//
// 工程 manifest 的 `[profile.<n>]` 里除构建期键（pack/strip/optimize/debug）之外的
// 键，是**运行时**旋钮；build 把它们烤进产物旁的侧车，launcher 运行时经
// `Z42_APP_CONFIG` 交给 z42vm，落在优先级链的「应用配置」层：
//
//     cli (--set/--mode) > env (Z42_*) > 用户配置 (Z42_CONFIG) > 应用侧车 > 默认
//
// 对齐 dotnet：`<app>.runtimeconfig.json` 由 SDK 在**构建时**从项目属性生成并与
// 产物一起进 bin/，不是运行时拼的。放在 driver（而非 launcher）是因为侧车必须与
// 产物 1:1——放 launcher 就只有 `z42 run <dir>` 路径会产，`z42 build` 单跑和
// `z42 publish` 打包时产物不自洽。
//
// 此前 launcher 是把 `[profile.debug].mode` 注入成 `Z42_MODE` 环境变量的，于是
// 工程 profile 实际落在 **env 层**、反过来压过用户的配置文件；而且只能带 mode
// 一个旋钮。complete-runtime-settings P5（2026-09-05）改掉了这条。
namespace Z42.Driver;

using Std;
using Std.IO;
using Z42.Build.Project;

// 生成标记头：再次 build 靠它区分「自己上次产的」与「用户手写的」。
static class RcSidecar {
    public static string Marker = "# generated by z42c build — do not edit";
}

// 写 `<distDir>/<name>.runtimeconfig.toml`。
//
// 返回 ExitCode.Ok（含"什么都没写"）或 ExitCode.BuildError（撞上用户手写文件）。
//
// **没有 `[profile.<n>]`、或该 profile 没声明任何运行时旋钮 → 不产文件**：产一个
// 空 `[runtime]` 表既无意义，又会让"从前没有侧车"的工程凭空多出一个产物。
int _writeRuntimeConfigSidecar(ProjectManifest pm, string distDir, string name, bool isRelease) {
    string profName = isRelease ? "release" : "debug";
    string[] knobs = _profileKnobsOf(pm, profName);
    string path = Path.Join(distDir, name + ".runtimeconfig.toml");
    if (knobs.Length == 0) {
        return ExitCode.Ok;
    }
    // 用户手写的同名侧车不覆盖——那是他自己的运行配置，静默覆盖等于吃掉他的设置。
    if (File.Exists(path)) {
        string existing = File.ReadAllText(path);
        if (!existing.StartsWith(RcSidecar.Marker)) {
            ConsoleError.WriteLine("z42c build: " + path + " 已存在且不是 z42c 生成的——");
            ConsoleError.WriteLine("  它会被 `[profile." + profName + "]` 的旋钮覆盖。把手写内容移到");
            ConsoleError.WriteLine("  manifest 的 `[profile." + profName + "]`，或删掉该文件。");
            return ExitCode.BuildError;
        }
    }
    string body = RcSidecar.Marker + "\n";
    body = body + "# source: [profile." + profName + "] of " + pm.Project.Name + "\n";
    body = body + "[runtime]\n";
    int i = 0;
    while (i < knobs.Length) {
        int eq = knobs[i].IndexOf("=");
        if (eq > 0) {
            string k = knobs[i].Substring(0, eq);
            string v = knobs[i].Substring(eq + 1, knobs[i].Length - eq - 1);
            body = body + k + " = " + _tomlScalar(v) + "\n";
        }
        i = i + 1;
    }
    File.WriteAllText(path, body);
    Console.WriteLine("wrote -> " + path);
    return ExitCode.Ok;
}

// 指定 profile 声明的运行时旋钮（扁平 "key=value"）；无该 profile → 空。
string[] _profileKnobsOf(ProjectManifest pm, string profName) {
    int i = 0;
    while (i < pm.ProfileCount) {
        if (pm.Profiles[i].Name == profName) { return pm.Profiles[i].Knobs; }
        i = i + 1;
    }
    return new string[0];
}

// 布尔与纯整数原样写（TOML 标量），其余加引号。z42vm 侧两种都收
// （`toml_scalar_to_string` 把 string/int/float/bool 一律转成字符串再喂给各
// `parse_*`），这里只是让生成的文件读起来像人写的。
string _tomlScalar(string v) {
    if (v == "true" || v == "false") { return v; }
    if (v.Length > 0 && _allDigits(v)) { return v; }
    return "\"" + v + "\"";
}

bool _allDigits(string s) {
    int i = 0;
    while (i < s.Length) {
        if (!s.CharAt(i).IsDigit()) { return false; }
        i = i + 1;
    }
    return true;
}
