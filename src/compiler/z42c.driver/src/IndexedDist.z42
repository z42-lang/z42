// indexed dist 投影（add-indexed-zpkg-min-patch；自 IncrementalCompilation.z42 拆出守 500 行硬限）。
// 散装 zbc = cache/内存字节原样落盘 + FILE 目录主文件；详见各函数注释。
namespace Z42.Driver;

using Std.IO;
using Std.Crypto;
using Z42.Package;
using Z42.IR;
using Z42.IR.BinaryFormat;
using Z42.Pipeline;
using Z42.Project;   // BuildLayout.Display —— 进度行里的路径相对当前目录呈现

// ── indexed dist 投影（add-indexed-zpkg-min-patch）────────────────────────────
// 散装 zbc = cache（cached 行）/ 内存（fresh 行）字节**原样落盘**；与 dist 现有字节相等
// 则不触碰——「未变文件 zbc 字节 + mtime 不动」的最小 patch 硬保证。主文件 = FILE 目录
//（每次重写，User 裁定可变）。孤儿 .zbc（源清单缩减残留）按当前文件集 diff 清除。
// 🔴 `n` 必须是 **union 模块数（art.ModCount）而不是 srcs.Length**：generator 产出的 CU
// （AddSource 新 CU / Augment 的 synthetic partial 碎片）排在用户 CU 之后，`z` 携带的是 union
// 文件表。按 srcs.Length 截断 ⇒ `WriteIndexedMain` 拿 z.Files（union 长）去索引 zbcHashes/srcRels
// （srcs 长）⇒ **array index out of bounds，一条看不懂的内部崩溃**，而不是任何诊断。
// 凡用了 generator 的工程，debug（indexed）构建必踩；`--release`（packed）路径不经此函数故无事。
// 同族先例：Main.z42 的诊断呈现循环上界曾同样误用 srcs.Length（fix-generated-cu-errors-invisible）。
// 生成 CU 无真实源文件 → 文件名取 `mods[i].SourceFile`（用户 CU 位置与 srcs[i] 逐字相同 ⇒ 无
// generator 时产物字节不动；生成 CU 位置是引擎合成名，如 `__gen$Foo$augment.z42` / AddSource hint）。
int _writeIndexedDist(string distDir, string cacheDir, string projectDir, string[] srcs,
                      ZpkgFileZ z, ZbcFileZ[] mods, int n, IncrPrep prep) {
    string[] zbcHashes = new string[n];
    string[] rels = new string[n];
    string[] srcRels = new string[n];
    int srcN = srcs.Length;
    int i = 0;
    while (i < n) {
        string relSrc = IncrementalBuild.Rel(projectDir, mods[i].SourceFile);
        srcRels[i] = relSrc;
        string stem = relSrc.EndsWith(".z42") ? relSrc.Substring(0, relSrc.Length - 4) : relSrc;
        rels[i] = stem + ".zbc";
        byte[] bytes;
        // 生成 CU（i >= srcN）没有缓存条目（union 一律 fresh 编译，见 PackageCompile）——
        // `prep.Plan.Fresh` 只有 srcs 长，越界读即崩。
        if (i < srcN && prep != null && !prep.Plan.Fresh[i]) {
            bytes = File.ReadAllBytes(CacheStore.ZbcPath(cacheDir, relSrc));   // cache SoT 原样
        } else {
            bytes = ZbcWriter.Write(mods[i].Module).ToBytes();
        }
        zbcHashes[i] = _bytesHexZ(Blake3.HashLen(bytes, 16));
        string dst = Path.Join(distDir, rels[i]);
        bool needWrite = true;
        if (File.Exists(dst)) {
            byte[] cur = File.ReadAllBytes(dst);
            if (_bytesEqZ(cur, bytes)) { needWrite = false; }   // 相等不触碰（mtime 保持）
        }
        if (needWrite) {
            string parent = Path.GetDirectoryName(dst);
            if (parent.Length > 0) { Directory.Create(parent); }
            File.WriteAllBytes(dst, bytes);
        }
        i = i + 1;
    }
    byte[] main = ZpkgIndexedWriter.WriteIndexedMain(z, zbcHashes, srcRels).ToBytes();
    string output = Path.Join(distDir, z.Name + ".zpkg");
    _cleanOrphanZbc(output, distDir, rels);
    File.WriteAllBytes(output, main);
    BuildLog.Progress("wrote -> " + BuildLayout.Display(Path.Join(distDir, z.Name + ".zpkg")) + " (indexed, " + n.ToString() + " zbc)");
    return 0;
}

// The prior FILE table identifies this package's outputs. Other loose files can
// belong to a bundled dependency or to another package sharing this directory.
void _cleanOrphanZbc(string output, string distDir, string[] rels) {
    if (!File.Exists(output)) { return; }
    ZpkgInfo previous = ZpkgReader.Open(File.ReadAllBytes(output), output);
    if (previous == null || previous.Packed) { return; }
    StrMap keep = new StrMap();
    foreach (var rel in rels) { keep.Put(rel, ""); }
    foreach (var rel in ZpkgReader.ReadIndexedZbcRels(previous)) {
        if (keep.ContainsKey(rel) || !_bundlePayloadRel(rel) || !rel.EndsWith(".zbc")) { continue; }
        string path = Path.Join(distDir, rel);
        if (File.Exists(path) && !Directory.Exists(path)) { File.Delete(path); }
    }
}

string _bytesHexZ(byte[] b) {
    string ds = "0123456789abcdef";
    string r = "";
    int i = 0;
    while (i < b.Length) {
        int v = (int)b[i];
        r = r + ds.Substring((v >> 4) & 0xF, 1) + ds.Substring(v & 0xF, 1);
        i = i + 1;
    }
    return r;
}

bool _bytesEqZ(byte[] a, byte[] b) {
    if (a.Length != b.Length) { return false; }
    int i = 0;
    while (i < a.Length) {
        if ((int)a[i] != (int)b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

