// CLI reporting and layout around the shared cache writer.
namespace Z42.Driver;
using Std.IO;
using Z42.Core;
using Z42.Package;
using Z42.Project;
using Z42.Pipeline;
using Z42.Emission;

void _writeBuildCache(ProjectManifest pm, string projectDir, bool isRelease, string cacheDirOverride,
    string[] srcs, string[] texts, string[] hashes, CompiledModuleZ[] cms, ZbcFileZ[] mods,
    IncrPrep prep, NameListZ[] idents, NameSurfacesZ[] surfaces, string depsId,
    LanguageFeatures feats, CuDiagSnapshot[] cuDiags) {
    string cacheDir = cacheDirOverride.Length > 0 ? cacheDirOverride : BuildLayout.Resolve(pm, projectDir, isRelease).CacheDir;
    string error = IncrementalCacheWriter.Write(cacheDir, projectDir, srcs, texts, hashes, cms, mods,
        prep, idents, surfaces, depsId, feats, cuDiags);
    if (error != "") { ConsoleError.WriteLine("cache write skipped (non-fatal): " + error); }
    else { BuildLog.ProgressErr("cache -> " + BuildLayout.Display(cacheDir) + " (" + srcs.Length.ToString() + " files)"); }
}
