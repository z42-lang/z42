// z42c driver —— exe 产物的兄弟包依赖 bundling（`_bundleExeDeps` / `_srcRoot`）。
// refactor-split-driver-main（complete-runtime-settings P5 前置，2026-09-05）：
// `Main.z42` 长期 636 行、在 line-limit 棘轮基线上，任何增长都会让 `xtask test lines`
// 变红。本文件是从它逐行搬出的**纯移动**（无逻辑改动），同包同 namespace，调用方
// 不变；搬完 Main.z42 回到 500 行硬限之下、可从基线剔除。
namespace Z42.Driver;

using Std;
using Std.IO;
using Z42.Project;
using Z42.Build.Project;
using Z42.IR;          // ZpkgReader / ZpkgInfo（产物引用的包名校验）

// **非框架**依赖的已构建 zpkg（+ .zsym）复制进 exe 的 dist。运行时 z42vm 的依赖搜索序
// = [entry-zpkg 目录, Z42_LIBS]，故 exe 从自身 dist 即可解析私有依赖，框架包仍走 Z42_LIBS。
// fix-path-dep-closure：**path 依赖的整个闭包**都要搬，不只直接依赖。
//
// 此前这里只遍历 `pm.Deps`，头注写着「仅直接依赖……传递闭包记 Deferred，
// exe 应直接声明全部所需兄弟」——**那个理由站不住**：`app → acme.web → acme.util` 时
// app 根本没引用过 `Acme.Util` 的任何符号（是 `acme.web` 内部在用），要求它声明一个
// 自己不用的包，正是包管理器存在的意义所在。征状：编译期正常（闭包 dist 已并进
// libsDirs），运行期 `MissingSymbolException: type \`Acme.Util.Helper\``——`app/dist/` 里只有
// `acme.web.zpkg`。⇒ **path 依赖链深度超过 1 就不可用。**
//
// ⭐ 这条藏了一个月的原因：`add-path-dependencies` 的 e2e（阶段 2.5）只造了
// **1 层**（`lib foo + exe bar`），而深度 1 时「直接依赖」恰好等于「闭包」——
// 又一个「测试写了但抓不到 bug」的样本（同 `static_abstract_operator` 挑中单字段 `Money`）。
//
// 闭包名单由 `_build` 透下来（top-level 分支算过的那份），**不在这里重算**——
// 非 top-level 子建（`libsDirsCount>0`）本就跳过解析，那个语境下重算会抛
// `No such file or directory`（初稿这么写过，被 e2e `buildclos` 当场抳下）。
int _bundleExeDeps(ProjectManifest pm, string[] closureNames, int closureN, string distDir, string[] libsDirs, int libsDirsN) {
    // 复制判定（add-deployment-model 批 1）：**在不在 shipped `libs/`**（= `Z42_LIBS`）。
    // 在 → 框架，运行期从 libs/ 解析，不复制；不在 → 私有，复制进 dist。
    //
    // 这条与 publisher 的 `_pubBundleProjectDeps` 现在**真的**是同一条了。此前两边各写各的、
    // 而注释互相声称一致：这里原本用「`<srcRoot>/libraries/<name>` 存在 ⇒ 真-stdlib」，
    // 🔴 而 `_srcRoot` 靠向上找「同时含 libraries/ 与 compiler/ 的目录」——**用户机器上恒为空**
    // ⇒ 整条判据退化成 `dep.StartsWith("z42.")`：**按名字前缀猜一个包是不是框架**。于是一个
    // 确实躺在框架目录里、但名字不像 `z42.*` 的包，会被当成私有依赖复制进**每一个**用到它的
    // exe 的 dist；反方向同样能踩（用户自己的库叫 `z42.foo` 就被当成 stdlib）。
    //
    // 为什么 `Z42_LIBS` 可靠而 srcRoot 不可靠：前者是「这台机器上的框架在哪」这个**运行期
    // 事实**，用户机器与 repo 内都成立；后者是「我在不在 z42 的源码树里」，只有开发时成立。
    //
    // 🔴 但判据不能写成「这个名字在 Z42_LIBS 里存在吗」—— 那条在**构建期 Z42_LIBS 混装了
    // 非框架包**时会失真，而 CI 的 bench A/B 正是这么拼环境的（`.ab-base-alllibs` = stdlib +
    // 全部 compiler member）。那样 `z42c.pipeline` 会被判成框架而不复制，于是 `z42c.driver`
    // 的**自包含 bundle 缺件**，z42b 的 `_findCompilerZpkg` 探测③（找 driver dist 里的
    // pipeline 副本）落空 ⇒ `no compiler injected`。实测踩到过，本地看不见——本地
    // `build compiler` 的 Z42_LIBS 指向不含编译器包的 stdlib flat dist。
    //
    // ⇒ 判据用**它是从哪个目录找到的**：`libsDirs` 的顺序本来就是 `[私有 dist…, Z42_LIBS]`
    //（path 闭包 dist / workspace 成员 dist 在前）。从 shipped libs/ 找到 ⇒ 框架，运行期也从
    // 那儿解析、不复制；从更靠前的目录找到 ⇒ **本次构建产出的私有包**，复制。
    // 顺带把「判是不是框架」和「去哪拷」合并成一次查找，不再扫两遍。
    string shippedLibs = Environment.GetEnvironmentVariable("Z42_LIBS", "");
    // 待拷名单 = 直接依赖 ∪ **path 依赖闭包全体**（去重，fix-path-dep-closure）。
    // 闭包成员恒为私有包（按路径引入、其 dist 不在 Z42_LIBS）⇒ 判据自然判出「拷」，
    // 不需要再单独记「这一项是不是 path 依赖」——那份平行数组随判据统一一起退休。
    string[] names = new string[pm.DepCount + 8];
    int nameN = 0;
    int pi = 0;
    while (pi < pm.DepCount) {
        names[nameN] = pm.Deps[pi].Name;
        nameN = nameN + 1;
        pi = pi + 1;
    }
    int ci = 0;
    while (ci < closureN) {
        string cn = closureNames[ci];
        ci = ci + 1;
        bool dup = false;
        int q = 0;
        while (q < nameN) { if (names[q] == cn) { dup = true; } q = q + 1; }
        if (dup) { continue; }
        if (nameN == names.Length) {
            string[] nb = new string[names.Length * 2];
            int k = 0;
            while (k < nameN) { nb[k] = names[k]; k = k + 1; }
            names = nb;
        }
        names[nameN] = cn; nameN = nameN + 1;
    }
    int i = 0;
    while (i < nameN) {
        string dep = names[i];
        i = i + 1;
        string zname = dep + ".zpkg";
        bool copied = false;
        int d = 0;
        while (d < libsDirsN) {
            string cand = Path.Join(libsDirs[d], zname);
            if (File.Exists(cand)) {
                // 从 shipped libs/ 找到 ⇒ 框架，不复制（运行期同样从那儿解析）。
                if (shippedLibs.Length > 0 && libsDirs[d] == shippedLibs) {
                    copied = true;
                    d = libsDirsN;
                    continue;
                }
                string dst = Path.Join(distDir, zname);
                if (cand != dst) {
                    if (File.Exists(dst)) { File.Delete(dst); }
                    File.Copy(cand, dst);
                    string sym = Path.Join(libsDirs[d], dep + ".zsym");
                    if (File.Exists(sym)) {
                        string symDst = Path.Join(distDir, dep + ".zsym");
                        if (File.Exists(symDst)) { File.Delete(symDst); }
                        File.Copy(sym, symDst);
                    }
                }
                copied = true;
                d = libsDirsN;   // break
            } else {
                d = d + 1;
            }
        }
        if (!copied) {
            ConsoleError.WriteLine("z42c build: exe dep '" + dep
                + "' zpkg 未在 libs 目录找到（先建兄弟包 / 用 --workspace / path 依赖）");
            return ExitCode.BuildError;
        }
    }
    return ExitCode.Ok;
}

// 🔴 **剩下的缺口：按名引用的依赖没有传递闭包。**
// `path` 依赖的闭包已由 fix-path-dep-closure 搬齐（上面那份 `closureNames`）；**按名**引用的
// 依赖（`"foo" = "1.0"`）若自己还依赖别的非框架包，那一层今天不会被搬。
// 做不到的原因很具体：建闭包要知道「某个依赖自己依赖了谁」，而 z42 侧 today 读不出 zpkg 的
// DEPS 段（只有 Rust 侧 `zbc_reader/zpkg.rs` 解码它）。靠源码树的 toml 去找是 publisher 今天
// 的做法，而那条路**在 repo 外整个失效**（`srcRoot == ""` ⇒ 每个依赖都 continue，零复制零递归）
// —— 把它搬过来等于把一个更大的毛病也搬过来。
// ⇒ 正解是先给 z42 侧补 zpkg DEPS 解码（support 先行、卡一个 nightly）。
// 见 `docs/spec/changes/add-deployment-model/tasks.md` 批 2。

// `z42c build --workspace [--output-dir <flat>] [--release]`：从 CWD 向上找
// z42.workspace.toml → 成员拓扑序 → 逐成员 build。
// Milestone 1（显式 --output-dir <flat>）：全成员产物落该 flat dir（= 各成员 libsDir，
// deps-first 解析兄弟）。产物 zpkg 与 C# `build --workspace` byte-identical（字节与
// 目录无关）。注意：flat dir 须含 stdlib 依赖（调用方 seed Z42_LIBS 内容）。

// ── `[dependencies]` 的 zpkg 产物引用（add-deployment-model）──────────────────────────────
//
// `path` 有两种形态，对标 C# 的两种引用：
//   · 指向**工程目录**（其中恰一份 `*.z42.toml`）= `<ProjectReference>` —— z42c 代建整个闭包；
//   · 指向 **`.zpkg` 文件** = `<Reference HintPath="...dll">` —— 已经是产物，不建、直接用。
//
// 产物引用的三条语义：
//   ① 不代建（`PathDepPlan` 按扩展名跳过它，不进闭包）；
//   ② **它所在目录并入 libsDirs** —— 这样它自己的兄弟依赖也解析得到（zpkg 的依赖按文件名
//      在 libsDirs 里找），与「把 zpkg 连同兄弟一起 vendored 进一个目录」的实际用法对齐；
//   ③ 运行期自包含**不需要额外做任何事**：`_bundleExeDeps` 的判据是「从哪个目录找到的」，
//      vendored 目录不是 shipped `libs/` ⇒ 自动复制进 exe 的 dist。
//
// ⚠️ 判据 `_isZpkgRef` 是 `PathDepPlan.IsZpkgRef` 的**第二份**，理由见那里的注释（跨成员符号）。
bool _isZpkgRef(string path) {
    int n = path.Length;
    if (n < 5) { return false; }
    string tail = path.Substring(n - 5, 5);
    return tail == ".zpkg" || tail == ".ZPKG";
}

// 收集 `[dependencies]` 里的 zpkg 产物引用，校验后返回它们**所在目录**（去重，声明序）。
// 失败（文件不存在 / 包名对不上）→ 打印诊断并返回 null，调用方据此返回 BuildError。
//
// 🔴 **包名必须与 key 一致**：指错文件是最容易犯的错（拷贝粘贴改了目录忘了改名），而 zpkg
// 头里就有 `[project].name`，校验是零成本的。不校验的话，错误会推迟到「符号找不到」——
// 位置在别处、原因说不清，正是本 change 一路在消灭的那种诊断。
string[] _zpkgRefDirs(ProjectManifest pm, string projectDir) {
    string[] dirs = new string[pm.DepCount];
    int n = 0;
    int i = 0;
    while (i < pm.DepCount) {
        string dep = pm.Deps[i].Name;
        string p = pm.Deps[i].Path;
        i = i + 1;
        if (p.Length == 0 || !_isZpkgRef(p)) { continue; }
        string full = Path.IsRooted(p) ? p : Path.Join(projectDir, p);
        if (!File.Exists(full)) {
            ConsoleError.WriteLine("z42c build: [dependencies] `" + dep + "` 的 path 指向 " + full
                + "，但该文件不存在。（`path` 以 .zpkg 结尾 = 直接引用一个已构建的产物；"
                + "要让 z42c 代建，请指向包含 *.z42.toml 的**工程目录**。）");
            return null;
        }
        ZpkgInfo info = ZpkgReader.Open(File.ReadAllBytes(full), full);
        if (info == null) {
            ConsoleError.WriteLine("z42c build: [dependencies] `" + dep + "` 指向的 " + full
                + " 不是可读的 packed zpkg（格式版本不符，或它是 indexed 布局的主文件）。");
            return null;
        }
        if (info.Name != dep) {
            ConsoleError.WriteLine("z42c build: [dependencies] `" + dep + "` 指向的 zpkg 里写的包名是 `"
                + info.Name + "`——两者须一致。改清单里的 key，或指向正确的文件。");
            return null;
        }
        string dir = Path.GetDirectoryName(full);
        if (dir.Length == 0) { dir = "."; }
        bool dup = false;
        int q = 0;
        while (q < n) { if (dirs[q] == dir) { dup = true; } q = q + 1; }
        if (!dup) { dirs[n] = dir; n = n + 1; }
    }
    string[] r = new string[n];
    int k = 0;
    while (k < n) { r[k] = dirs[k]; k = k + 1; }
    return r;
}
