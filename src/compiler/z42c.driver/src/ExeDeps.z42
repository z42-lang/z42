// z42c driver —— exe 产物的兄弟包依赖 bundling（`_bundleExeDeps` / `_srcRoot`）。
// refactor-split-driver-main（complete-runtime-settings P5 前置）：
// `Main.z42` 长期 636 行、在 line-limit 棘轮基线上，任何增长都会让 `xtask check lines`
// 变红。本文件是从它逐行搬出的**纯移动**（无逻辑改动），同包同 namespace，调用方
// 不变；搬完 Main.z42 回到 500 行硬限之下、可从基线剔除。
namespace Z42.Driver;

using Std.IO;
using Std.Collections;
using Z42.Build;
using Z42.Package;
using Z42.Project;
using Z42.IR;          // ZpkgReader / ZpkgInfo（产物引用的包名校验）
using Z42.Pipeline;    // CompilerDomain（编译器域解析域，与 BuildSession 共用）

// Keep the compile domain unchanged. Resolve deployment edges of source members
// with vendored inputs in the same domain that compiled the member.
int _bundleExeDeps(BundleSeed seed, PathClosureOut closure, ProjectManifest pm, string distDir,
                   string[] libsDirs, int libsDirsN, WsTier tier) {
    string[] frameworkDirs = _extLibDirs();
    StrMap ownZbc = _ownLooseZbc(pm, distDir);
    StrMap copiedZbc = new StrMap();
    DeploymentCopies copies = new DeploymentCopies(distDir, pm.Project.Name, ".z42-deps-");
    foreach (var rel in ownZbc.Keys()) { copies.Keep(rel); }
    copies.Keep(pm.Project.Name + ".zpkg");
    copies.Keep(pm.Project.Name + ".zsym");
    int entry = 0;
    while (entry < pm.ExeCount) {
        copies.Keep(pm.Exes[entry].Name + ".zpkg");
        copies.Keep(pm.Exes[entry].Name + ".zsym");
        entry = entry + 1;
    }
    StrMap memberDomains = closure == null ? null : closure.BundleDomains;
    List<string> selected = new List<string>();
    int i = 0;
    while (i < seed.N) {
        BundleItem item = seed.Items[i];
        i = i + 1;
        if (item.Deploy == "shared") { continue; }
        string file = item.Name + ".zpkg";
        string dir = _bundleFindDir(item.Domain, libsDirs, libsDirsN, file);
        if (item.Deploy == "sdk") {
            if (dir.Length == 0 || !_isCompilerDomainDir(dir)) {
                ConsoleError.WriteLine("z42c build: [dependencies] `" + item.Name
                    + "` 写了 deploy = \"sdk\"，但它不是 SDK 库 —— deploy = \"sdk\" 只适用于 SDK 的 programs/z42c/ 里的包。");
                return ExitCode.BuildError;
            }
            seed.NeedsSdk = true;
            continue;
        }
        if (dir.Length == 0) {
            ConsoleError.WriteLine("z42c build: exe dep '" + item.Name
                + "' zpkg 未在 libs 目录找到（先建兄弟包 / 用 --workspace / path 依赖）");
            return ExitCode.BuildError;
        }
        if (item.Deploy != "copy" && _inDirs(frameworkDirs, dir)) { continue; }
        if (item.SdkSkip && _isCompilerDomainDir(dir) && !_bundleMemberDir(tier, libsDirs, dir)) { continue; }
        string candidate = Path.Join(dir, file);
        byte[] bytes = File.ReadAllBytes(candidate);
        ZpkgInfo info = ZpkgReader.Open(bytes, candidate);
        int rc = _planExeDependency(item.Name, dir, distDir, info, bytes, ownZbc, copiedZbc, copies);
        if (rc != ExitCode.Ok) { return rc; }
        selected.Add(file);
        if (info != null) {
            BundleDomain domain = item.Domain;
            if (memberDomains != null) {
                BundleDomain sourceDomain = memberDomains.Get(_normPath(candidate)) as BundleDomain;
                if (sourceDomain != null) { domain = sourceDomain; }
            }
            if (!_queueExeDependencies(seed, ZpkgReader.ReadDependencies(info), domain, i, libsDirs, libsDirsN)) {
                return ExitCode.BuildError;
            }
        }
    }
    copies.Apply();
    _writeRuntimeSelections(pm, distDir, selected.ToArray());
    return ExitCode.Ok;
}

void _writeRuntimeSelections(ProjectManifest pm, string distDir, string[] selected) {
    if (pm.ExeCount == 0) { RuntimeDeployment.Write(distDir, pm.Project.Name + ".zpkg", selected); return; }
    int ex = 0;
    while (ex < pm.ExeCount) {
        RuntimeDeployment.Write(distDir, pm.Exes[ex].Name + ".zpkg", selected);
        ex = ex + 1;
    }
}

bool _bundleMemberDir(WsTier tier, string[] libsDirs, string dir) {
    if (tier == null) { return false; }
    int d = 0;
    while (d < tier.MemberDirs) {
        if (libsDirs[d] == dir) { return true; }
        d = d + 1;
    }
    return false;
}

string _bundleFindDir(BundleDomain domain, string[] dirs, int count, string file) {
    if (domain != null) { return _firstDirHaving(domain.Dirs, domain.Count, file); }
    return _firstDirHaving(dirs, count, file);
}

int _planExeDependency(string name, string dir, string distDir, ZpkgInfo info, byte[] bytes,
                       StrMap ownZbc, StrMap copiedZbc, DeploymentCopies copies) {
    string file = name + ".zpkg";
    string source = Path.Join(dir, file);
    string symbols = name + ".zsym";
    if (_samePath(dir, distDir)) {
        copies.Keep(file);
        copies.Keep(symbols);
        if (info != null && !info.Packed) {
            foreach (var rel in ZpkgReader.ReadIndexedZbcRels(info)) { copies.Keep(rel); }
        }
        return ExitCode.Ok;
    }
    if (info != null && !info.Packed) {
        int rc = _bundleLooseZbc(name, dir, distDir, ZpkgReader.ReadIndexedZbcRels(info), ownZbc, copiedZbc, copies);
        if (rc != ExitCode.Ok) { return rc; }
    }
    copies.Add(file, source, bytes);
    string symSource = Path.Join(dir, symbols);
    if (File.Exists(symSource)) { copies.Add(symbols, symSource, File.ReadAllBytes(symSource)); }
    return ExitCode.Ok;
}

bool _queueExeDependencies(BundleSeed seed, string[] deps, BundleDomain domain, int cursor, string[] dirs, int count) {
    int i = 0;
    while (i < deps.Length) {
        string file = deps[i];
        i = i + 1;
        if (!_isZpkgRef(file)) { continue; }
        string name = file.Substring(0, file.Length - 5);
        int previous = seed.IndexOf(name);
        if (previous < 0) {
            string deploy = domain == null ? "" : domain.Deploy(name);
            seed.Append(new BundleItem(name, deploy, false, domain));
            continue;
        }
        BundleItem existing = seed.Items[previous];
        // A shared edge cuts only its own branch. A later private edge may
        // still require the same package; promote once so cycles stay bounded.
        if ((existing.Deploy == "shared" || existing.Deploy == "sdk")
            && domain != existing.Domain) {
            string incoming = domain == null ? "" : domain.Deploy(name);
            if (incoming != "shared" && incoming != "sdk") {
                if (!_compatibleBundleSources(existing, domain, dirs, count, file)) { return false; }
                existing.Deploy = incoming;
                existing.Domain = domain;
                existing.SdkSkip = false;
                if (previous < cursor) { seed.Append(existing); }
                continue;
            }
        }
        if (existing.Domain != domain && !_compatibleBundleSources(existing, domain, dirs, count, file)) { return false; }
        // A copied package's closure takes precedence over the own-DEPS SDK skip.
        if (existing.SdkSkip) {
            existing.SdkSkip = false;
            if (previous < cursor) { seed.Append(existing); }
        }
    }
    return true;
}

bool _compatibleBundleSources(BundleItem existing, BundleDomain domain, string[] dirs, int count, string file) {
    string left = _bundleFindDir(existing.Domain, dirs, count, file);
    string right = _bundleFindDir(domain, dirs, count, file);
    if (left.Length == 0 || right.Length == 0 || _samePath(left, right)) { return true; }
    ConsoleError.WriteLine("z42c build: conflicting runtime sources for " + file + ": "
        + Path.Join(left, file) + " and " + Path.Join(right, file));
    return false;
}

// `deploy` 声明的合法性（add-deployment-model 批 4.3）。由 `_build` 在**编译之前**调用 ——
// 与 `_validateProfileKnobs` 同款「清单有问题不等一趟全量编译」。
//
// 为什么不留在 `_bundleExeDeps` 里：那个函数**只在 exe 分支跑**。于是
//   · `kind = "lib"` 工程里写 `deploy = "Copy"`（大写 typo）→ 整条校验从未执行 ⇒ 静默无效；
//   · 插件工程（`kind = "plugin"`）里写任何 `deploy` → 它永不链入运行期产物，这个键在那儿没有意义。
// 两者都是本 change 一路在消灭的那个形状：**配了，没报错，就是不生效**。
//
// `[plugins]` 条目同理 —— 插件 zpkg 加载进工具链进程运行、**永不随产物走**，所以那里的 `deploy` 也无从
// 生效。它与 `[dependencies]` 共用 `DepEntry`，键因此写得出来。
int _validateDeployDecls(ProjectManifest pm) {
    bool isPlugin = pm.Project.IsPlugin();
    int i = 0;
    while (i < pm.DepCount) {
        DepEntry d = pm.Deps[i];
        i = i + 1;
        if (d.Deploy.Length == 0) { continue; }
        if (isPlugin) {
            ConsoleError.WriteLine("z42c build: [dependencies] `" + d.Name + "` 写了 deploy = \""
                + d.Deploy + "\"，但本工程是插件工程（kind = \"" + pm.Project.Kind + "\"）—— 插件永不链入运行期产物，"
                + "它的依赖也就没有「部署到哪」这件事。删掉该键。");
            return ExitCode.BuildError;
        }
        int rc = _chkDeployValue("[dependencies]", d.Name, d.Deploy);
        if (rc != 0) { return rc; }
    }
    int a = 0;
    while (a < pm.PluginCount) {
        DepEntry h = pm.Plugins[a];
        a = a + 1;
        if (h.Deploy.Length == 0) { continue; }
        ConsoleError.WriteLine("z42c build: [plugins] `" + h.Name + "` 写了 deploy = \""
            + h.Deploy + "\"，但插件 zpkg 只加载进工具链进程运行，永不随产物走 —— "
            + "deploy 在这里没有意义。删掉该键。");
        return ExitCode.BuildError;
    }
    return ExitCode.Ok;
}

// 取值只认两个。写错了（`Copy` / `static` / typo）若当成未声明静默走默认判据，就又是一个
// 「配了以为生效」。`section` 用来把错误指回用户写它的那张表。
int _chkDeployValue(string section, string name, string value) {
    if (value == "copy" || value == "shared" || value == "sdk") { return ExitCode.Ok; }
    ConsoleError.WriteLine("z42c build: " + section + " `" + name + "` 的 deploy = \"" + value
        + "\" 不是合法取值。只接受 \"copy\"（复制进 exe 的 dist，私有）、"
        + "\"shared\"（不复制，运行期从 probing-paths 解析）"
        + "或 \"sdk\"（SDK 库专用：不复制，运行期从所在 SDK 解析）；省略 = 由默认规则决定"
        + "（在 shipped libs/ 里的不复制，其余复制）。");
    return ExitCode.BuildError;
}

bool _inDirs(string[] dirs, string dir) {
    int i = 0;
    while (i < dirs.Length) { if (dirs[i] == dir) { return true; } i = i + 1; }
    return false;
}

// 名字是否在清单 `[dependencies]` 里声明过（deploy 值无关——这里只区分「声明的默认面」与
// own-DEPS / 闭包播种的未声明条目，见 _bundleExeDeps 的 SDK 域跳过分支）。
bool _declaredByName(ProjectManifest pm, string name) {
    int i = 0;
    while (i < pm.DepCount) { if (pm.Deps[i].Name == name) { return true; } i = i + 1; }
    return false;
}

// libsDirs 里第一个含 `file` 的目录；没有 ⇒ ""。
string _firstDirHaving(string[] libsDirs, int n, string file) {
    int i = 0;
    while (i < n) {
        if (File.Exists(Path.Join(libsDirs[i], file))) { return libsDirs[i]; }
        i = i + 1;
    }
    return "";
}

bool _isCompilerDomainDir(string dir) {
    string[] dom = CompilerDomain.Dirs();
    int i = 0;
    while (i < dom.Length) { if (dom[i] == dir) { return true; } i = i + 1; }
    return false;
}

// 清单里有没有 `deploy = "sdk"` 的依赖（侧车据此补 `${Z42_HOME}/programs/z42c`）。
bool _hasSdkDeploy(ProjectManifest pm) {
    int i = 0;
    while (i < pm.DepCount) { if (pm.Deps[i].Deploy == "sdk") { return true; } i = i + 1; }
    return false;
}

// ── `[dependencies]` 的 zpkg 产物引用（add-deployment-model）──────────────────────────────
//
// `path` 有两种形态，对标 C# 的两种引用：
//   · 指向**工程目录**（其中恰一份 `*.z42.toml`）= `<ProjectReference>` —— z42c 代建整个闭包；
//   · 指向 **`.zpkg` 文件** = `<Reference HintPath="...dll">` —— 已经是产物，不建、直接用。
//
// 产物引用的三条语义：
//   ① 不代建（`PathDepPlan` 按扩展名跳过它，不进闭包）；
//   ② **它所在目录并入 libsDirs** —— 这样它自己的兄弟依赖也解析得到（zpkg 的依赖按文件名
//      在 libsDirs 里找），与「把 zpkg 连同兄弟一起 vendored 进一个目录」的实际用法对齐；
//   ③ 运行期自包含**不需要额外做任何事**：`_bundleExeDeps` 的判据是「从哪个目录找到的」，
//      vendored 目录不是 shipped `libs/` ⇒ 自动复制进 exe 的 dist。
//
// ⚠️ 判据 `_isZpkgRef` 是 `PathDepPlan.IsZpkgRef` 的**第二份**，理由见那里的注释（跨成员符号）。
bool _isZpkgRef(string path) {
    int n = path.Length;
    if (n < 5) { return false; }
    string tail = path.Substring(n - 5, 5);
    return tail == ".zpkg" || tail == ".ZPKG";
}

// 收集 `[dependencies]` 里的 zpkg 产物引用，校验后返回它们**所在目录**（去重，声明序）。
// 失败（文件不存在 / 包名对不上）→ 打印诊断并返回 null，调用方据此返回 BuildError。
//
// 🔴 **包名必须与 key 一致**：指错文件是最容易犯的错（拷贝粘贴改了目录忘了改名），而 zpkg
// 头里就有 `[project].name`，校验是零成本的。不校验的话，错误会推迟到「符号找不到」——
// 位置在别处、原因说不清，正是本 change 一路在消灭的那种诊断。
// `[dependencies]` 的 `path` **不支持宏**。返回 false = 已打印诊断、调用方应中止。
//
// 曾有过唯一一个宏 `${compiler_libs}`（编译器域包所在目录，relocate-compiler-domain-libs 引入），
// add-sdk-libs 用「SDK 库按名声明」取代它：`"z42c.syntax" = "*"`（exe 在 SDK 上运行、不复制时加
// `deploy = "sdk"`）—— 位置由工具链按 `CompilerDomain.Dirs()` 找，清单里不再写路径。宏随之删除（W0609 退役）。
//
// 🔴 **仍然显式拦截 `${`**，而不是让它落到「文件不存在」：旧清单里的 `${compiler_libs}/x.zpkg` 会被当成
// 字面相对路径，报一句离原因很远的「该文件不存在: …/${compiler_libs}/x.zpkg」。这里当场说清该怎么改。
bool _rejectDepPathMacro(string depName, string p) {
    if (p.IndexOf("${") < 0) { return true; }
    if (p.IndexOf("${compiler_libs}") >= 0) {
        ConsoleError.WriteLine("z42c build: [dependencies] `" + depName + "` 用了 `${compiler_libs}` 路径宏，该宏已删除。"
            + "SDK 库按名声明即可：`\"" + depName + "\" = \"*\"`（exe 要在 SDK 上运行、不复制时再加 `deploy = \"sdk\"`）。");
    } else {
        ConsoleError.WriteLine("z42c build: [dependencies] `" + depName + "` 的 path 里有宏 `" + p
            + "` —— 依赖路径不支持宏，请写相对清单目录的路径或绝对路径。");
    }
    return false;
}

string[] _zpkgRefDirs(ProjectManifest pm, string projectDir) {
    string[] dirs = new string[pm.DepCount];
    int n = 0;
    int i = 0;
    while (i < pm.DepCount) {
        string dep = pm.Deps[i].Name;
        string p = pm.Deps[i].Path;
        i = i + 1;
        if (p.Length == 0) { continue; }
        if (!_rejectDepPathMacro(dep, p)) { return null; }   // 诊断已打印（任何 path 依赖都查，不只 .zpkg）
        if (!_isZpkgRef(p)) { continue; }
        string full = Path.IsRooted(p) ? p : Path.Join(projectDir, p);
        if (!File.Exists(full)) {
            ConsoleError.WriteLine("z42c build: [dependencies] `" + dep + "` 的 path 指向 " + full
                + "，但该文件不存在。（`path` 以 .zpkg 结尾 = 直接引用一个已构建的产物；"
                + "要让 z42c 代建，请指向包含 *.z42.toml 的**工程目录**。）");
            return null;
        }
        ZpkgInfo info = ZpkgReader.Open(File.ReadAllBytes(full), full);
        if (info == null) {
            ConsoleError.WriteLine("z42c build: [dependencies] `" + dep + "` 指向的 " + full
                + " 不是可读的 packed zpkg（格式版本不符，或它是 indexed 布局的主文件）。");
            return null;
        }
        if (info.Name != dep) {
            ConsoleError.WriteLine("z42c build: [dependencies] `" + dep + "` 指向的 zpkg 里写的包名是 `"
                + info.Name + "`——两者须一致。改清单里的 key，或指向正确的文件。");
            return null;
        }
        // deps-plugin-routing：插件包不进运行期解析域——它的目录**不**并入 libsDirs（NSPC / glob /
        // 包枚举会把里面的东西当普通库）。编译器侧加载走 `_pluginDepZpkgs` 的直连分流。
        if (PkgKind.IsPluginPkg(info.PkgKind, info.PluginCaps)) { continue; }
        string dir = Path.GetDirectoryName(full);
        if (dir.Length == 0) { dir = "."; }
        bool dup = false;
        int q = 0;
        while (q < n) { if (dirs[q] == dir) { dup = true; } q = q + 1; }
        if (!dup) { dirs[n] = dir; n = n + 1; }
    }
    string[] r = new string[n];
    int k = 0;
    while (k < n) { r[k] = dirs[k]; k = k + 1; }
    return r;
}

// 本 dist 里本包（及 `[[exe]]` 各目标）的 indexed 主文件引用的散装 zbc 相对路径集合。
StrMap _ownLooseZbc(ProjectManifest pm, string distDir) {
    StrMap own = new StrMap();
    string[] mains = new string[pm.ExeCount + 1];
    mains[0] = pm.Project.Name;
    int e = 0;
    while (e < pm.ExeCount) { mains[e + 1] = pm.Exes[e].Name; e = e + 1; }
    int k = 0;
    while (k < mains.Length) {
        string p = Path.Join(distDir, mains[k] + ".zpkg");
        k = k + 1;
        if (!File.Exists(p)) { continue; }
        ZpkgInfo zi = ZpkgReader.Open(File.ReadAllBytes(p), p);
        if (zi == null) { continue; }
        string[] rels = ZpkgReader.ReadIndexedZbcRels(zi);
        int r = 0;
        while (r < rels.Length) { own.Put(rels[r], "1"); r = r + 1; }
    }
    return own;
}

// 把 indexed 依赖 `dep` 的散装 zbc 从 fromDir 拷到 distDir（保持相对路径）。与本包自己的 zbc、或本轮另一个
// 依赖的 zbc 撞名 ⇒ 报错（同一路径只能有一份，加载器按路径找）。
int _bundleLooseZbc(string dep, string fromDir, string distDir, string[] rels, StrMap ownZbc, StrMap copiedZbc, DeploymentCopies copies) {
    int r = 0;
    while (r < rels.Length) {
        string rel = rels[r];
        r = r + 1;
        string owner = "";
        if (ownZbc.ContainsKey(rel)) { owner = "this package"; }
        else if (copiedZbc.ContainsKey(rel)) { owner = "dependency `" + (copiedZbc.Get(rel) as string) + "`"; }
        if (owner.Length > 0) {
            ConsoleError.WriteLine("z42c build: cannot bundle indexed (dev-mode) dependency `" + dep + "`: its loose file `"
                + rel + "` collides with the one from " + owner + " in " + distDir
                + ". Rename one of the source files, or build `" + dep + "` packed (`pack = true` in its [project]).");
            return ExitCode.BuildError;
        }
        if (!_bundlePayloadRel(rel) || !rel.EndsWith(".zbc")) {
            ConsoleError.WriteLine("z42c build: unsafe indexed dependency payload path: " + rel);
            return ExitCode.BuildError;
        }
        string src = Path.Join(fromDir, rel);
        if (!File.Exists(src)) {
            ConsoleError.WriteLine("z42c build: indexed dependency `" + dep + "` is missing its loose file `" + src
                + "` (its dist is incomplete — rebuild it)");
            return ExitCode.BuildError;
        }
        copies.Add(rel, src, File.ReadAllBytes(src));
        copiedZbc.Put(rel, dep);
    }
    return 0;
}
