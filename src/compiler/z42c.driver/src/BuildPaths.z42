// 构建辅助（pack 模式守卫 / handler 指纹 / 可复现 build_id；自 Main.z42 拆出守 500 行硬限）。
// dist / cache / generated 目录的解析在 z42.project 的 BuildLayout（launcher / z42b 共用）。
namespace Z42.Driver;

using Std;
using Std.IO;
using Z42.Project;
using Z42.Build.Project;
using Z42.Pipeline;

// dist 主文件的 pack 模式位（header flags bit0）是否与本次 pack 决议一致。
// 读不出（缺文件/太短）按不一致处理 → 走重投影。
bool _distModeMatches(string zpkgPath, bool isPacked) {
    try {
        byte[] d = File.ReadAllBytes(zpkgPath);
        if (d.Length < 10) { return false; }
        int flags = (int)d[8] | (((int)d[9]) << 8);
        bool filePacked = (flags & 1) != 0;
        return filePacked == isPacked;
    } catch (Exception e) {
        return false;
    }
}

// _writeCacheZbc（单文件 fullMode .zbc 落盘）已迁 IncrementalDriver.z42（500 行硬限）。

// attribute-handler-registry PR4e：handler（[analyzers] 段）身份指纹——按 analyzer 名稳定序（common-pitfalls
// §1）拼「名:zpkg 内容指纹」。无 [analyzers] → `""`（源 hash 不揉入 → 自举 byte-identical）。generator 换了
// （zpkg 内容变）→ 指纹变 → 揉进源 hash 的每个文件都失效 → 全量重编（design red-line ②「产物纳入指纹」）。
// zpkg 路径由 `_resolveHandlerZpkgs` 先行解析（add-package-roles 批 2：path 条目已代建完毕）——
// 指纹与 CompileInputs 吃**同一份**路径，不再各自按名去 libsDirs 里找一遍。
string _handlerFingerprint(ProjectManifest pm, string[] azPaths) {
    if (pm.AnalyzerCount == 0) { return ""; }
    // 稳定序：analyzer 名选择排序（禁依赖 manifest 声明顺序碰巧）。
    string[] names = new string[pm.AnalyzerCount];
    string[] paths = new string[pm.AnalyzerCount];
    int i = 0;
    while (i < pm.AnalyzerCount) {
        names[i] = pm.Analyzers[i].Name;
        paths[i] = (azPaths != null && i < azPaths.Length && azPaths[i] != null) ? azPaths[i] : "";
        i = i + 1;
    }
    int p = 0;
    while (p < names.Length) {
        int min = p; int q = p + 1;
        while (q < names.Length) { if (names[q].CompareTo(names[min]) < 0) { min = q; } q = q + 1; }
        if (min != p) {
            string t = names[p]; names[p] = names[min]; names[min] = t;
            string tp = paths[p]; paths[p] = paths[min]; paths[min] = tp;
        }
        p = p + 1;
    }
    string acc = "";
    i = 0;
    while (i < names.Length) {
        if (paths[i].Length > 0 && File.Exists(paths[i])) {
            byte[] bytes = File.ReadAllBytes(paths[i]);
            acc = acc + names[i] + ":" + _bytesFp(bytes) + ";";
        } else {
            acc = acc + names[i] + ":missing;";
        }
        i = i + 1;
    }
    return acc;
}

// byte[] 内容指纹：长度 + 溢出安全的模多项式滚动哈希（z42 int≡Int32；base 31、模 33554393 使
// `h*31+255 < 2^31` 不溢出）。长度 + 滚动哈希双要素 → 内容变几乎必变指纹（用于缓存失效，宁多编不漏）。
string _bytesFp(byte[] b) {
    int h = 0;
    int i = 0;
    while (i < b.Length) {
        h = (h * 31 + (((int)b[i]) & 255)) % 33554393;
        i = i + 1;
    }
    return b.Length.ToString() + "_" + h.ToString();
}


// 可复现 build_id（reproducible-build-id）：packed 产物写盘前，把 MODS 头的 SourceFile 改成项目相对路径、
// SourceHash 置空。二者进 zpkg 主体 → 参与 build_id，但运行期与编译器都不读（增量判定走 .meta）：
// 绝对路径让「同一份源换个目录编」字节不同，源哈希让「只改注释/空白」字节不同。
// SourceFile 的契约本就是「项目相对路径」（PackageTypes.z42），此前 PackageCompile 传的是发现到的原样路径。
void _stabilizeSourceIdentity(ZpkgFileZ z, string projectDir) {
    int i = 0;
    while (i < z.ModuleCount) {
        ZbcFileZ m = z.Modules[i];
        m.SourceFile = IncrementalBuild.Rel(projectDir, m.SourceFile);
        m.SourceHash = "";
        i = i + 1;
    }
}

// ── 编译期扩展的解析域（add-package-roles 批 1）────────────────────────────
//
// `kind = "analyzer"` 的工程要 `[dependencies]` 到编译器的契约包（`z42c.semantics` 的
// `Generator`/`ModuleGenerator`/`GenSink`/`GenTarget`），而这些 zpkg **不在** `libs/` ——
// 那正是 proposal 记下的症状：契约在 SDK 目录里、却不在解析器会去看的地方，于是插件作者
// 拿到的是一句位置在别处的 `E0443 undefined type: ModuleGenerator`，没有任何东西诊断它。
//
// 本函数返回该解析域目录（存在者为准，按探测序；一个都没有 → 空数组，调用方照旧只看 libs/）。
// 探测序镜像 `ReplCompilerHost._findCompilerZpkg`（scripting 定位编译器组件的同款三档）：
//   ① Z42_HOME/compiler-libs/                  —— SDK 安装态
//   ② Z42_PORTABLE_VM 反推 SDK 根 → <sdk>/compiler-libs/
//   ③ 开发树：自 Z42_LIBS 上溯到 artifacts/build/ → compiler/z42c.semantics/release/dist/
//      （仓库内开发无 SDK；driver 手里没有仓库根，Z42_LIBS 是唯一可靠的锚点）
//
// **只对 analyzer 工程生效**：普通工程的 libsDirs 不含它，编译器域包对普通用户仍不可见
// （role 维度的「compile-time 不进 runtime 解析域」这条，在 kind 这一侧先落一半）。
string[] _compilerLibsDirs() {
    string[] found = new string[4];
    int n = 0;
    string home = Environment.GetEnvironmentVariable("Z42_HOME", "");
    if (home.Length > 0) {
        string p1 = Path.Join(home, "compiler-libs");
        if (Directory.Exists(p1)) { found[n] = p1; n = n + 1; }
    }
    string pv = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM", "");
    if (pv.Length > 0) {
        string sdk = Path.GetDirectoryName(Path.GetDirectoryName(pv));
        string p2 = Path.Join(sdk, "compiler-libs");
        if (Directory.Exists(p2) && !_clContains(found, n, p2)) { found[n] = p2; n = n + 1; }
    }
    // ③ 开发树：Z42_LIBS = <root>/artifacts/build/libraries/dist/release → 上溯 3 级得
    //    <root>/artifacts/build，再拼 compiler/z42c.semantics/release/dist。布局若变则目录
    //    不存在、自然跳过（不猜、不报错——这只是开发便利档，SDK 态走 ①②）。
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS", "");
    if (libs.Length > 0) {
        string buildDir = Path.GetDirectoryName(Path.GetDirectoryName(Path.GetDirectoryName(libs)));
        if (buildDir.Length > 0) {
            string p3 = Path.Join(buildDir, Path.Join("compiler", Path.Join("z42c.semantics", Path.Join("release", "dist"))));
            if (Directory.Exists(p3) && !_clContains(found, n, p3)) { found[n] = p3; n = n + 1; }
        }
    }
    string[] r = new string[n];
    int i = 0;
    while (i < n) { r[i] = found[i]; i = i + 1; }
    return r;
}

bool _clContains(string[] a, int count, string x) {
    int i = 0;
    while (i < count) { if (a[i] == x) { return true; } i = i + 1; }
    return false;
}

// ── [analyzers] 条目 → handler zpkg 路径（add-package-roles 批 2）──────────────────────────
// 解析结果：Code==0 → Paths（与 pm.Analyzers **同序**，供指纹与 CompileInputs 共用）；
// Code!=0 → 解析失败，诊断已打印，调用方直接返回该退出码。
// （z42 无 Result/out：用小载体回传「值 + 退出码」，好过让调用方从 null 反推该报哪一种错。）
public sealed class HandlerZpkgs {
    public string[] Paths;
    public int      Code;
    public HandlerZpkgs(string[] paths, int code) { this.Paths = paths; this.Code = code; }
}

// `[analyzers]` 两种条目形态（与 `[dependencies]` 同构，add-package-roles 批 2）：
//   · `x = "1.0"`（无 path）：在 libsDirs 里找 `<name>.zpkg` —— 既有行为，要求用户先把产物摆进依赖目录。
//   · `x = { path = "../x" }`：定位该工程 manifest → 校验它确是 `kind = "analyzer"` → **由 z42c 代建**
//     → 取其 dist 的 `<name>.zpkg`。这条是「用户自定义 analyzer/generator」从纸面变可用的关键：
//     此前 path 被显式拒绝（更早是**静默忽略**），用户只能手工把 zpkg 拷进 SDK libs 目录。
//
// 🔴 **代建结果不并入消费方 libsDirs**（与 `[dependencies]` 的 path 闭包**刻意不同**）：handler 是
// 编译期扩展，加载进编译器进程、不链入目标产物（D9）。把它的 dist 混进 libsDirs 就等于让 analyzer
// 包对消费方的**普通代码**可见 —— 解析域隔离当场破掉。故这里只把单个 zpkg 路径交出去。
//
// 代建用消费方的 isRelease/optSet，但 **libsDirs 一律不继承**（传 count=0）：analyzer 工程自己会走
// 它自己的 path 依赖闭包 + Z42_LIBS + compiler-libs 解析域（批 1 接线按 `kind == "analyzer"` 生效）。
HandlerZpkgs _resolveHandlerZpkgs(ProjectManifest pm, string projectDir, string consumerToml,
                                  string[] libsDirs, int libsDirsN,
                                  bool isRelease, bool noIncremental, int optSet) {
    string[] paths = new string[pm.AnalyzerCount];
    int ai = 0;
    while (ai < pm.AnalyzerCount) {
        string aname = pm.Analyzers[ai].Name;
        string apath = pm.Analyzers[ai].Path;
        if (apath.Length > 0) {
            string got = _handlerFromPath(aname, apath, projectDir, consumerToml, isRelease, noIncremental, optSet);
            if (got.Length == 0) { return new HandlerZpkgs(null, ExitCode.BuildError); }
            paths[ai] = got;
        } else {
            string got = _handlerFromLibs(aname, libsDirs, libsDirsN);
            if (got.Length == 0) { return new HandlerZpkgs(null, ExitCode.BuildError); }
            paths[ai] = got;
        }
        ai = ai + 1;
    }
    return new HandlerZpkgs(paths, 0);
}

// path 条目：定位 → 校验 kind → 代建 → dist 里的 `<name>.zpkg`。失败打印诊断并返回 ""。
string _handlerFromPath(string aname, string apath, string projectDir, string consumerToml,
                        bool isRelease, bool noIncremental, int optSet) {
    string adir = Path.Join(projectDir, apath);
    string[] manifests = Path.Glob(adir, "*.z42.toml");
    if (manifests.Length != 1) {
        ConsoleError.WriteLine("z42c build: [analyzers] `" + aname + "` 的 path 指向 " + adir
            + "，期望恰 1 份 *.z42.toml，实得 " + manifests.Length.ToString() + "。");
        return "";
    }
    string atoml = manifests[0];
    // 自指 → 无限递归。消费方自己就是 analyzer 时最容易写出来（`path = "."`）。
    if (_samePath(atoml, consumerToml)) {
        ConsoleError.WriteLine("z42c build: [analyzers] `" + aname + "` 的 path 指回本工程自身（"
            + atoml + "）——analyzer 不能是自己的 handler。");
        return "";
    }
    ProjectManifest apm = ManifestLoader.Load(atoml);
    // 双向校验之一（add-package-roles 批 2）：`[analyzers]` 只收编译期扩展工程。
    // 放进来的若是普通库，失败模式是「加载成功、发现 0 个 handler、什么都不做」——一个静默空转。
    if (apm.Project.Kind != "analyzer") {
        ConsoleError.WriteLine("z42c build: [analyzers] `" + aname + "` 指向的工程 " + atoml
            + " 是 kind = \"" + apm.Project.Kind + "\"，不是 \"analyzer\"。"
            + "编译期扩展（analyzer / generator 本体）须声明 kind = \"analyzer\"——"
            + "它决定该工程能否引用编译器契约包，也决定它不会被链入目标产物。");
        return "";
    }
    if (apm.Project.Name != aname) {
        ConsoleError.WriteLine("z42c build: [analyzers] `" + aname + "` 的 path 指向的工程名是 `"
            + apm.Project.Name + "`——两者须一致（同 [dependencies] 的 path 依赖约定）。");
        return "";
    }
    // 代建（handler 是宿主进程要加载的东西，恒按本机构建；z42c 无目标 rid 概念，天然如此）。
    int bc = _build(atoml, isRelease, "", "", new string[0], 0, noIncremental, optSet, false, null);
    if (bc != 0) {
        ConsoleError.WriteLine("z42c build: [analyzers] `" + aname + "` 的工程构建失败（见上）。");
        return "";
    }
    string adistDir = BuildLayout.Resolve(apm, Path.GetDirectoryName(atoml), isRelease).DistDir;
    string cand = Path.Join(adistDir, aname + ".zpkg");
    if (!File.Exists(cand)) {
        ConsoleError.WriteLine("z42c build: [analyzers] `" + aname + "` 构建后仍未见 " + cand + "。");
        return "";
    }
    return cand;
}

// 名字条目：libsDirs 里找 `<name>.zpkg`。失败打印诊断（含**找过哪些目录**）并返回 ""。
string _handlerFromLibs(string aname, string[] libsDirs, int libsDirsN) {
    string azfile = aname + ".zpkg";
    int d = 0;
    while (d < libsDirsN) {
        string cand = Path.Join(libsDirs[d], azfile);
        if (File.Exists(cand)) { return cand; }
        d = d + 1;
    }
    string searched = "";
    int sd = 0;
    while (sd < libsDirsN) {
        searched = searched + (sd > 0 ? ", " : "") + libsDirs[sd];
        sd = sd + 1;
    }
    if (libsDirsN == 0) { searched = "(无依赖目录——未设 Z42_LIBS，清单也无 path 依赖)"; }
    ConsoleError.WriteLine("z42c build: [analyzers] `" + aname + "` 未在依赖目录找到 " + azfile
        + "；已查找：" + searched
        + "。改法：把该工程的 zpkg 放进依赖目录，或在 [analyzers] 里改用 `{ path = \"...\" }` 让 z42c 代建。");
    return "";
}

// 两个 manifest 路径是否指同一文件（相对 → 绝对 + 折叠 "."/".."；镜像 PathDepPlan._norm，
// 不跨包调它：driver 引用 pipeline 的**新**符号 = 新跨成员符号，卡一个 nightly）。
bool _samePath(string a, string b) { return _normPath(a) == _normPath(b); }

string _normPath(string p) {
    string abs = Path.IsRooted(p) ? p : Path.Join(Environment.GetCurrentDirectory(), p);
    string[] segs = abs.Replace("\\", "/").Split("/");   // Windows 反斜杠一并归一
    string[] stack = new string[segs.Length];
    int sp = 0;
    int i = 0;
    while (i < segs.Length) {
        string s = segs[i];
        i = i + 1;
        if (s.Length == 0 || s == ".") { continue; }
        if (s == "..") { if (sp > 0) { sp = sp - 1; } continue; }
        stack[sp] = s; sp = sp + 1;
    }
    string outp = "";
    int j = 0;
    while (j < sp) { outp = outp + "/" + stack[j]; j = j + 1; }
    return outp;
}
