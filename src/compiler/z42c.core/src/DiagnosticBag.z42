// 编译期诊断收集器：累积多条 error/warning 再统一报告。镜像 C# `DiagnosticBag`。
//
// z42 暂不支持「类字段带泛型参数」—— `private List<Diagnostic> items;` 的类型参数
// 会被 parser 静默丢弃（取出元素退化为无约束 T，无法调 .IsError()）。沿用 stdlib
// 既有模式（TomlValue._arrayItems / Process._args）：`T[] + int count` 并行数组
// （typed array 的元素访问会正确单态化为 Diagnostic）。详见 self-hosting.md 受限写法。
//
// 渲染（PrintAll / Pretty / 颜色 / 文件读取）暂不移植——driver 子系统需要时补。
namespace Z42.Core;

public sealed class DiagnosticBag {
    private Diagnostic[] _items;
    private int _count;
    // 「读到 EOF 还缺 token」= 可恢复的不完整（不是写错、是没写完）。REPL 完整性探针据此续读。
    // 分两个标志，因为「缺 ;」的续读语义按入口不同：
    //   _incompleteAtEof     —— 缺闭合符 / 操作数 / 名字（{ } ) ] / 表达式）。任何入口都算没写完。
    //   _incompleteSemiAtEof —— 仅缺语句结尾 `;`。声明入口（void foo()）算没写完要续读；
    //                           表达式/语句入口（REPL 的 `42` 无分号）不算——由 Completeness 按入口取舍。
    private bool _incompleteAtEof;
    private bool _incompleteSemiAtEof;

    public DiagnosticBag() {
        this._items = new Diagnostic[4];
        this._count = 0;
        this._incompleteAtEof = false;
        this._incompleteSemiAtEof = false;
    }

    // parser 在「期待 token 但当前已是 EOF」的报错点调用，标记本次 parse 因输入未写完而失败。
    public void MarkIncompleteAtEof() { this._incompleteAtEof = true; }
    public bool IsIncompleteAtEof() { return this._incompleteAtEof; }
    // 专指「仅缺语句结尾 `;`」，与上面分开（REPL 表达式无分号 → 表达式入口不当续读）。
    public void MarkIncompleteSemiAtEof() { this._incompleteSemiAtEof = true; }
    public bool IsIncompleteSemiAtEof() { return this._incompleteSemiAtEof; }

    public void Add(Diagnostic d) {
        if (this._count == this._items.Length) { this.Grow(); }
        this._items[this._count] = d;
        this._count = this._count + 1;
    }

    public void Error(string code, string message, Span span) {
        this.Add(Diagnostic.Error(code, message, span));
    }
    public void Warning(string code, string message, Span span) {
        this.Add(Diagnostic.Warning(code, message, span));
    }
    public void Info(string code, string message, Span span) {
        this.Add(Diagnostic.Info(code, message, span));
    }

    // 把另一个 bag 的诊断条目追加进来（仅 items，不复制 incomplete 标志——那些是本 bag 语义）。
    // 用途：Parser 收尾把 Lexer 的诊断（E0101/E0102/E0103）并入自身 bag，让 lexer 错端到端上浮。
    public void MergeFrom(DiagnosticBag other) {
        int i = 0;
        while (i < other._count) {
            this.Add(other._items[i]);
            i = i + 1;
        }
    }

    public int Count() { return this._count; }

    /// 回滚到之前 Count() 的快照——speculative 解析失败时丢弃期间产生的诊断
    /// （如泛型调用歧义消解 `名<T>(` 试解析失败后回退为 `<` 比较）。n >= 当前 count 无副作用。
    public void TruncateTo(int n) { if (n >= 0 && n < this._count) { this._count = n; } }

    /// 返回第 i 条诊断（调用方按 0 <= i < Count() 迭代）。
    public Diagnostic Get(int i) { return this._items[i]; }

    public int ErrorCount() {
        int n = 0;
        int i = 0;
        while (i < this._count) {
            if (this._items[i].IsError()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    public bool HasErrors() {
        int i = 0;
        while (i < this._count) {
            if (this._items[i].IsError()) { return true; }
            i = i + 1;
        }
        return false;
    }

    public bool HasWarnings() {
        int i = 0;
        while (i < this._count) {
            if (this._items[i].IsWarning()) { return true; }
            i = i + 1;
        }
        return false;
    }

    private void Grow() {
        int newCap = this._items.Length * 2;
        Diagnostic[] bigger = new Diagnostic[newCap];
        int i = 0;
        while (i < this._count) {
            bigger[i] = this._items[i];
            i = i + 1;
        }
        this._items = bigger;
    }
}
