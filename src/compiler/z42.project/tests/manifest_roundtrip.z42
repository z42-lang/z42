// z42.project ManifestLoader 首个 GREEN（converge-onto-z42-project 阶段 1）：
// .z42.toml → **组合式** ProjectManifest / WorkspaceManifest 模型 round-trip。
namespace Z42ProjectRoundtripTests;

using Z42.Project;

[Test]
void test_project_manifest_roundtrip() {
    string toml = "[project]\nname = \"demo\"\nversion = \"1.2.3\"\nkind = \"exe\"\nentry = \"Main\"\n\n[sources]\ninclude = [\"src/**/*.z42\"]\nexclude = [\"src/gen/**\"]\n\n[build]\nhooks = \"hooks\"\n\n[dependencies]\n\"z42.core\" = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    // [project] → 组合式 m.Project.*
    Assert.Equal("demo", m.Project.Name);
    Assert.Equal("1.2.3", m.Project.Version);
    Assert.Equal("exe", m.Project.Kind);
    Assert.Equal(true, m.Project.HasEntry);
    Assert.Equal("Main", m.Project.Entry);
    // [sources] → 组合式 m.Sources.*
    Assert.Equal(1, m.Sources.IncludeCount);
    Assert.Equal("src/**/*.z42", m.Sources.Include[0]);
    Assert.Equal(1, m.Sources.ExcludeCount);
    Assert.Equal("src/gen/**", m.Sources.Exclude[0]);
    // [build] hooks → BuildConfig.HasHooks / HooksDir（fix-hooks-source-scan 阶段1）
    Assert.Equal(true, m.Build.HasHooks);
    Assert.Equal("hooks", m.Build.HooksDir);
    // [dependencies] → 顶层 m.Deps
    Assert.Equal(1, m.DepCount);
    Assert.Equal("z42.core", m.Deps[0].Name);
    Assert.Equal("0.1.0", m.Deps[0].Version);
}

[Test]
void test_workspace_manifest_roundtrip() {
    string toml = "[workspace]\nmembers = [\"*\"]\ndefault_members = [\"a\", \"b\"]\n\n[workspace.build]\noutput_dir = \"out/${member_name}\"\ncache_dir = \"${output_dir}/cache\"\n";
    WorkspaceManifest w = ManifestLoader.ParseWorkspaceText(toml);
    Assert.Equal(1, w.MemberCount);
    Assert.Equal("*", w.Members[0]);
    Assert.Equal(2, w.DefaultCount);
    Assert.Equal("a", w.DefaultMembers[0]);
    Assert.Equal("b", w.DefaultMembers[1]);
    Assert.Equal(true, w.HasOutputDir);
    Assert.Equal("out/${member_name}", w.OutputDir);   // 路径模板原样保留
    Assert.Equal("${output_dir}/cache", w.CacheDir);
}

// ── [optimize] 逐 pass 具名开关（add-compiler-inlining；解析 support 侧，消费受两-nightly 纪律）──
[Test]
void test_optimize_section_parsed() {
    // 用真实带连字符的 pass 名（与编译器 Opt.ByName 串一致）验证连字符裸键解析。
    string toml = "[project]\nname = \"o\"\nversion = \"0.1.0\"\n\n[optimize]\ninline = true\nconst-fold = false\ncopy-prop = true\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(3, m.OptimizeCount);
    // 键序不保证 → 按名查
    bool sawInline = false; bool sawCf = false; bool sawCp = false;
    int i = 0;
    while (i < m.OptimizeCount) {
        if (m.OptimizeNames[i] == "inline")     { sawInline = true; Assert.Equal(true,  m.OptimizeValues[i]); }
        if (m.OptimizeNames[i] == "const-fold") { sawCf     = true; Assert.Equal(false, m.OptimizeValues[i]); }
        if (m.OptimizeNames[i] == "copy-prop")  { sawCp     = true; Assert.Equal(true,  m.OptimizeValues[i]); }
        i = i + 1;
    }
    Assert.True(sawInline);
    Assert.True(sawCf);
    Assert.True(sawCp);
}

[Test]
void test_optimize_section_absent_empty() {
    string toml = "[project]\nname = \"o\"\nversion = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.OptimizeCount);   // 缺 [optimize] → 空（消费方回落 profile 默认）
}

// ── [analyzers] 编译期 handler zpkg 引用（attribute-handler-registry D9）───────
[Test]
void test_analyzers_section_parsed() {
    // [analyzers] 值同 [dependencies]（版本串），复用 _parseDeps → DepEntry。
    string toml = "[project]\nname = \"a\"\nversion = \"0.1.0\"\n\n[analyzers]\n\"demo.noemptycatch\" = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(1, m.AnalyzerCount);
    Assert.Equal("demo.noemptycatch", m.Analyzers[0].Name);
    Assert.Equal("0.1.0", m.Analyzers[0].Version);
}

[Test]
void test_analyzers_section_absent_empty() {
    string toml = "[project]\nname = \"a\"\nversion = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.AnalyzerCount);   // 缺 [analyzers] → 空（无外部 handler 加载）
}

// ── [lints] 诊断规则开关 / severity 覆盖（attribute-handler-registry PR3b）──────
[Test]
void test_lints_section_parsed() {
    // 逐规则 severity 串搬为中性 name/severity 对；warnings_as_errors 拎成独立 bool。
    string toml = "[project]\nname = \"l\"\nversion = \"0.1.0\"\n\n[lints]\nZ9002 = \"warning\"\nZ9100 = \"error\"\n\"webgen.*\" = \"none\"\nwarnings_as_errors = true\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(3, m.LintCount);   // warnings_as_errors 不计入逐规则表
    Assert.True(m.LintWarningsAsErrors);
    bool sawW = false; bool sawE = false; bool sawWild = false;
    int i = 0;
    while (i < m.LintCount) {
        if (m.LintNames[i] == "Z9002")     { sawW = true; Assert.Equal("warning", m.LintSeverities[i]); }
        if (m.LintNames[i] == "Z9100")     { sawE = true; Assert.Equal("error",   m.LintSeverities[i]); }
        if (m.LintNames[i] == "webgen.*")  { sawWild = true; Assert.Equal("none",  m.LintSeverities[i]); }
        i = i + 1;
    }
    Assert.True(sawW);
    Assert.True(sawE);
    Assert.True(sawWild);
}

[Test]
void test_lints_section_absent_empty() {
    string toml = "[project]\nname = \"l\"\nversion = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.LintCount);   // 缺 [lints] → 空
    Assert.Equal(false, m.LintWarningsAsErrors);
}

[Test]
void test_lints_warnings_as_errors_only() {
    // 仅 warnings_as_errors、无逐规则条目 → LintCount 0、WAE true。
    string toml = "[project]\nname = \"l\"\nversion = \"0.1.0\"\n\n[lints]\nwarnings_as_errors = true\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.LintCount);
    Assert.True(m.LintWarningsAsErrors);
}

// `[build] generated_dir`（add-member-forwarding）：generator 产出源码的落盘目录。
// 「没配置」与「显式配空串」是**两回事** —— 前者用默认值 `<output_dir>/generated`（恒落盘），
// 后者表示**不落盘**。HasGeneratedDir 就是用来区分这两者的，不能只看字符串是否为空。
[Test]
void test_build_generated_dir_parsed() {
    string toml = "[project]\nname = \"p\"\nversion = \"0.1.0\"\nkind = \"lib\"\n"
                + "[build]\ngenerated_dir = \"out/gen\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(true, m.Build.HasGeneratedDir);
    Assert.Equal("out/gen", m.Build.GeneratedDir);
}

[Test]
void test_build_generated_dir_absent_is_not_empty_string() {
    string toml = "[project]\nname = \"p\"\nversion = \"0.1.0\"\nkind = \"lib\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(false, m.Build.HasGeneratedDir);   // ⇒ 走默认 <output_dir>/generated
}

[Test]
void test_build_generated_dir_explicit_empty_means_off() {
    string toml = "[project]\nname = \"p\"\nversion = \"0.1.0\"\nkind = \"lib\"\n"
                + "[build]\ngenerated_dir = \"\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(true, m.Build.HasGeneratedDir);    // 配了
    Assert.Equal("", m.Build.GeneratedDir);         // 且是空 ⇒ 不落盘
}

// ── 未知键审计（ManifestKeys）：写错的键收集成错误行，不再静默忽略 ─────────────
[Test]
void test_known_keys_audit_clean() {
    string toml = "[project]\nname = \"k\"\nversion = \"0.1.0\"\nkind = \"exe\"\nentry = \"Main\"\npack = true\n"
                + "description = \"d\"\nauthors = [\"a\", \"b\"]\nlicense = \"MIT\"\n"
                + "[sources]\ninclude = [\"src/**/*.z42\"]\nexclude = []\n"
                + "[build]\noutput_dir = \"o\"\ncache_dir = \"c\"\ndist_dir = \"d\"\nincremental = false\nhooks = \"h\"\ngenerated_dir = \"g\"\n"
                + "[dependencies]\n\"z42.core\" = \"0.1.0\"\n\"x\" = { version = \"1\", path = \"../x\", deploy = \"sdk\" }\n"
                + "[tests]\ninclude = [\"tests/*.z42\"]\nauto = false\n[tests.dependencies]\n\"z42.test\" = \"0.1.0\"\n"
                + "[[test]]\nname = \"t\"\nharness = false\nentry = \"M\"\ninclude = [\"t.z42\"]\ntest = true\n"
                + "[[exe]]\nname = \"e\"\nentry = \"M\"\ninclude = [\"e.z42\"]\n"
                + "[platform.desktop]\napphost = true\npublish_dir = \"p\"\nbin = \"bin/k\"\npayload = \"k.zpkg\"\nlink = \"dynamic\"\n"
                + "[platform.wasm]\ntitle = \"w\"\n"
                + "[native.foo]\ndir = \"prebuilt\"\n"
                + "[lints]\nZ9002 = \"error\"\nwarnings_as_errors = true\n"
                + "[optimize]\ninline = false\n[syntax]\ncontrol_flow = true\n"
                + "[profile.release.runtime]\ngc-mode = \"x\"\n[properties]\nanything = 1\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.UnknownKeys.Length);
    Assert.Equal(0, m.DeprecatedKeys.Length);
    Assert.Equal("d", m.Project.Description);
    Assert.Equal(2, m.Project.Authors.Length);
    Assert.Equal("MIT", m.Project.License);
    Assert.Equal("dynamic", m.Platform.Desktop.Link);
    Assert.True(m.LintWarningsAsErrors);
}

[Test]
void test_unknown_keys_collected_per_section() {
    string toml = "[project]\nname = \"k\"\nversion = \"0.1.0\"\nentyr = \"Main\"\n"
                + "[build]\noutput-dir = \"o\"\n"
                + "[dependencies]\n\"x\" = { version = \"1\", paht = \"../x\" }\n"
                + "[[exe]]\nname = \"e\"\nsrc = [\"e.z42\"]\n"
                + "[platform.desktop]\nicno = \"i\"\n"
                + "[packge]\nname = \"p\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(6, m.UnknownKeys.Length);
    string all = "";
    int i = 0;
    while (i < m.UnknownKeys.Length) { all = all + m.UnknownKeys[i] + "\n"; i = i + 1; }
    Assert.True(all.Contains("unknown key `packge` in top level"));
    Assert.True(all.Contains("unknown key `entyr` in [project]"));
    Assert.True(all.Contains("unknown key `output-dir` in [build] (known: output_dir, "));
    Assert.True(all.Contains("unknown key `paht` in [dependencies.x]"));
    Assert.True(all.Contains("unknown key `src` in [[exe]]"));
    Assert.True(all.Contains("unknown key `icno` in [platform.desktop]"));
}

// 改过名的键（阶段 1）：旧名仍生效，只进 DeprecatedKeys（警告），不进 UnknownKeys（错误）。
[Test]
void test_renamed_keys_still_honored_and_deprecated() {
    string toml = "[project]\nname = \"k\"\nversion = \"0.1.0\"\n[lints]\nwarnings-as-errors = true\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.UnknownKeys.Length);
    Assert.Equal(1, m.DeprecatedKeys.Length);
    Assert.Equal("key `warnings-as-errors` in [lints] is deprecated, rename it to `warnings_as_errors`"
        + " (the old spelling will be rejected in a future release)", m.DeprecatedKeys[0]);
    Assert.Equal(0, m.LintCount);   // 旧键不被当成规则名
    Assert.True(m.LintWarningsAsErrors);
    WorkspaceManifest w = ManifestLoader.ParseWorkspaceText("[workspace]\nmembers = [\"*\"]\ndefault-members = [\"a\"]\n");
    Assert.Equal(0, w.UnknownKeys.Length);
    Assert.Equal(1, w.DeprecatedKeys.Length);
    Assert.Equal("key `default-members` in [workspace] is deprecated, rename it to `default_members`"
        + " (the old spelling will be rejected in a future release)", w.DeprecatedKeys[0]);
    Assert.Equal(1, w.DefaultCount);
    Assert.Equal("a", w.DefaultMembers[0]);
}

[Test]
void test_renamed_keys_new_spelling_wins() {
    // 新旧两个都写 → 新名的值生效（与键的先后无关），旧名仍报警告。
    string toml = "[project]\nname = \"k\"\nversion = \"0.1.0\"\n[lints]\nwarnings_as_errors = false\nwarnings-as-errors = true\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(false, m.LintWarningsAsErrors);
    Assert.Equal(0, m.UnknownKeys.Length);
    Assert.Equal(1, m.DeprecatedKeys.Length);
    WorkspaceManifest w = ManifestLoader.ParseWorkspaceText(
        "[workspace]\nmembers = [\"*\"]\ndefault-members = [\"old\"]\ndefault_members = [\"new1\", \"new2\"]\n");
    Assert.Equal(2, w.DefaultCount);
    Assert.Equal("new1", w.DefaultMembers[0]);
    Assert.Equal(1, w.DeprecatedKeys.Length);
    // 只写新名：不警告。
    ProjectManifest n = ManifestLoader.ParseText("[project]\nname = \"k\"\nversion = \"0.1.0\"\n[lints]\nwarnings_as_errors = true\n");
    Assert.Equal(0, n.DeprecatedKeys.Length);
    Assert.True(n.LintWarningsAsErrors);
}

[Test]
void test_workspace_unknown_keys_collected() {
    string toml = "[workspace]\nmembers = [\"*\"]\n[workspace.project]\nversion = \"0.1.0\"\n"
                + "[workspace.build]\noutput_dir = \"o\"\ndist_dir = \"d\"\n"
                + "[workspace.dependencies]\n\"x\" = { path = \"x\", features = [] }\n";
    WorkspaceManifest w = ManifestLoader.ParseWorkspaceText(toml);
    Assert.Equal(3, w.UnknownKeys.Length);
    Assert.Equal("unknown key `project` in [workspace] (known: members, exclude, default_members, build, dependencies)", w.UnknownKeys[0]);
    Assert.Equal("unknown key `dist_dir` in [workspace.build] (known: output_dir, cache_dir)", w.UnknownKeys[1]);
    Assert.Equal("unknown key `features` in [workspace.dependencies.x] (known: version, path, deploy)", w.UnknownKeys[2]);
}
