// unify-plugin-packages：`[plugins]` 的解析层。z42.project 只搬条目（DepEntry 三形态：名字 /
// 工程目录 / .zpkg 产物，同 [dependencies] 的取值面）；按位分流、读头校验、代建在 z42c / z42b
// 消费侧（各自的夹具覆盖）。旧段名 [analyzers] 已删除（1b）。
namespace Z42ProjectPluginTests;

using Z42.Project;
using Std.Harness;

[Test]
void test_plugins_string_entry() {
    // 名字条目 → Path 为 ""（按名在插件目录找 <name>.zpkg）。
    string toml = "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n\n[plugins]\n\"demo.lint\" = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(1, m.PluginCount);
    Assert.Equal("demo.lint", m.Plugins[0].Name);
    Assert.Equal("0.1.0", m.Plugins[0].Version);
    Assert.Equal("", m.Plugins[0].Path);
}

[Test]
void test_plugins_project_path_entry() {
    // 工程目录条目（目录里有插件清单，消费方代建）→ Path 原样保留。
    string toml = "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n\n[plugins]\n\"demo.gen\" = { path = \"../gen\" }\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(1, m.PluginCount);
    Assert.Equal("demo.gen", m.Plugins[0].Name);
    Assert.Equal("../gen", m.Plugins[0].Path);
}

[Test]
void test_plugins_zpkg_path_entry() {
    // .zpkg 条目（现成产物，消费方读头校验）→ Path 以 .zpkg 结尾，解析层不做后缀判断。
    string toml = "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n\n[plugins]\n\"demo.local\" = { path = \"../x.zpkg\" }\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(1, m.PluginCount);
    Assert.Equal("demo.local", m.Plugins[0].Name);
    Assert.Equal("../x.zpkg", m.Plugins[0].Path);
}

[Test]
void test_kind_plugin_is_plugin() {
    // kind = "plugin" 判插件工程（IsPlugin；决定 SDK 契约包免声明可见、不链入产物、能力位推导）。
    // 旧名 "analyzer" 已删除（1b）：由 kind 校验（unknown kind）兜住。
    string toml = "[project]\nname = \"demo\"\nversion = \"0.1.0\"\nkind = \"plugin\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.True(m.Project.IsPlugin());
    Assert.Equal("plugin", m.Project.Kind);

}

[Test]
void test_lib_is_not_plugin() {
    // lib / exe 不是插件工程——身份由 kind 决定，不由「是否实现了契约」决定。
    string toml = "[project]\nname = \"demo\"\nversion = \"0.1.0\"\nkind = \"lib\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.False(m.Project.IsPlugin());
}

[Test]
void test_no_plugins_section() {
    // 没写任何段 → 空数组（不是 null）。
    string toml = "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n";
    ProjectManifest m = ManifestLoader.ParseText(toml);
    Assert.Equal(0, m.PluginCount);
}
