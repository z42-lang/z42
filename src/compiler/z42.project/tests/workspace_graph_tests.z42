namespace Z42ProjectWorkspaceGraphTests;

using Z42.Project;
using Std.Harness;
using Std.IO;

WorkspaceMembers _members() {
    string[] names = new string[4];
    names[0] = "a"; names[1] = "b"; names[2] = "c"; names[3] = "d";
    return new WorkspaceMembers(new string[4], names, new string[0], new int[4], new int[4], 4);
}

WorkspaceGraph _graph(string rows) {
    WorkspaceManifest ws = ManifestLoader.ParseWorkspaceText("[workspace.build.graph]\n" + rows);
    Assert.Equal(0, ws.UnknownKeys.Length);
    return ws.Graph;
}

void _reject(string rows, string expected) {
    string message = "";
    try { _graph(rows).Bind(_members()); }
    catch (Exception e) { message = e.Message; }
    Assert.True(message.Contains(expected));
}

[Test]
void test_explicit_graph_diamond_binds_once_in_dependency_order() {
    WorkspaceMembers m = _graph("a=['b','c']\nb=['d']\nc=['d']\nd=[]\n").Bind(_members());
    int[] order = WorkspacePlan.TopoOrder(m);
    Assert.Equal(4, order.Length);
    Assert.Equal("d", m.Names[order[0]]);
    Assert.Equal("a", m.Names[order[3]]);
    Assert.Equal(2, m.DepLen[0]);
    Assert.Equal(4, m.DepFlat.Length);
}

[Test]
void test_explicit_graph_rejects_missing_unknown_duplicate_and_self_edges() {
    _reject("a=[]\nb=[]\nc=[]\n", "every discovered member");
    _reject("a=['outside']\nb=[]\nc=[]\nd=[]\n", "unknown prerequisite");
    _reject("a=['b','b']\nb=[]\nc=[]\nd=[]\n", "duplicate prerequisite");
    _reject("a=['a']\nb=[]\nc=[]\nd=[]\n", "self dependency");
    _reject("a=[]\nb=[]\nc=[]\noutside=[]\n", "missing member");
}

[Test]
void test_explicit_graph_rejects_cycles_and_malformed_rows() {
    _reject("a=['b']\nb=['a']\nc=[]\nd=[]\n", "circular member dependency");
    _reject("a=1\nb=[]\nc=[]\nd=[]\n", "expected an array");
    _reject("a=[1]\nb=[]\nc=[]\nd=[]\n", "prerequisite must be a string");
}

[Test]
void test_explicit_graph_cannot_drop_manifest_prerequisite() {
    WorkspaceMembers m = _members();
    m.DepFlat = new string[1]; m.DepFlat[0] = "b";
    m.DepLen[0] = 1; m.DepOff[1] = 1; m.DepOff[2] = 1; m.DepOff[3] = 1;
    string message = "";
    try { _graph("a=[]\nb=[]\nc=[]\nd=[]\n").Bind(m); }
    catch (Exception e) { message = e.Message; }
    Assert.True(message.Contains("omits declared prerequisite"));
}

[Test]
void test_legacy_workspace_has_no_explicit_graph() {
    WorkspaceManifest ws = ManifestLoader.ParseWorkspaceText("[workspace]\nmembers=['*']\n");
    Assert.True(ws.Graph == null);
    Assert.Equal(0, ws.UnknownKeys.Length);
}

[Test]
void test_package_tasks_claim_shared_leaf_once_and_wait_for_both_branches() {
    PackageTaskState state = new PackageTaskState(_graph("a=['b','c']\nb=['d']\nc=['d']\nd=[]\n").Bind(_members()));
    Assert.Equal(3, state.TakeReady());
    Assert.Equal(-1, state.TakeReady());
    state.Complete(3, true);
    Assert.Equal(1, state.TakeReady());
    Assert.Equal(2, state.TakeReady());
    Assert.Equal(-1, state.TakeReady());
    state.Complete(2, true);
    Assert.Equal(-1, state.TakeReady());
    state.Complete(1, true);
    Assert.Equal(0, state.TakeReady());
    state.Complete(0, true);
    Assert.True(state.IsComplete());
    Assert.Equal(-1, state.TakeReady());
}

[Test]
void test_package_tasks_failure_blocks_dependents_but_drains_running_sibling() {
    PackageTaskState state = new PackageTaskState(_graph("a=['b','c']\nb=['d']\nc=['d']\nd=[]\n").Bind(_members()));
    state.TakeReady(); state.Complete(3, true);
    state.TakeReady(); state.TakeReady();
    state.Complete(1, false);
    Assert.Equal("failed", state.Status(1));
    Assert.Equal("blocked", state.Status(0));
    Assert.Equal("running", state.Status(2));
    Assert.False(state.IsComplete());
    Assert.Equal(-1, state.TakeReady());
    state.Complete(2, true);
    Assert.True(state.IsComplete());
}

[Test]
void test_package_tasks_reject_completion_without_claim_or_duplicate_completion() {
    string[] one = new string[1]; one[0] = "leaf";
    PackageTaskState state = new PackageTaskState(new WorkspaceMembers(one, one, new string[0], new int[1], new int[1], 1));
    string message = "";
    try { state.Complete(0, true); } catch (Exception e) { message = e.Message; }
    Assert.True(message.Contains("requires a running task"));
    Assert.Equal(0, state.TakeReady()); state.Complete(0, true);
    message = "";
    try { state.Complete(0, true); } catch (Exception e) { message = e.Message; }
    Assert.True(message.Contains("requires a running task"));
    Assert.True(state.IsComplete());
}

[Test]
void test_package_tasks_snapshot_graph_and_propagate_leaf_failure() {
    WorkspaceMembers graph = _graph("a=['b','c']\nb=['d']\nc=['d']\nd=[]\n").Bind(_members());
    PackageTaskState state = new PackageTaskState(graph);
    graph.DepFlat[0] = "unrelated"; graph.Names[3] = "renamed";
    Assert.Equal(3, state.TakeReady()); state.Complete(3, false);
    Assert.True(state.IsComplete());
    Assert.Equal("blocked", state.Status(0));
    Assert.Equal("blocked", state.Status(1));
    Assert.Equal("blocked", state.Status(2));
    Assert.Equal(-1, state.TakeReady());
}

[Test]
void test_package_graph_selection_requires_prerequisite_closure() {
    WorkspaceMembers graph = _graph("a=['b','c']\nb=['d']\nc=['d']\nd=[]\n").Bind(_members());
    string[] selected = new string[1]; selected[0] = "d";
    PackageTaskState state = new PackageTaskState(WorkspaceGraph.Select(graph, selected, 1));
    Assert.Equal(1, state.Count());
    Assert.Equal(0, state.TakeReady()); state.Complete(0, true);
    Assert.True(state.IsComplete());
    selected[0] = "a";
    string message = "";
    try { WorkspaceGraph.Select(graph, selected, 1); } catch (Exception e) { message = e.Message; }
    Assert.True(message.Contains("omits a prerequisite"));
}

[Test]
void test_package_graph_prerequisites_include_transitive_shared_leaf() {
    WorkspaceMembers graph = _graph("a=['b','c']\nb=['d']\nc=['d']\nd=[]\n").Bind(_members());
    bool[] needed = WorkspaceGraph.Prerequisites(graph, 0);
    Assert.False(needed[0]);
    Assert.True(needed[1] && needed[2] && needed[3]);
    needed = WorkspaceGraph.Prerequisites(graph, 3);
    Assert.False(needed[0] || needed[1] || needed[2] || needed[3]);
}

void _ownershipRejected(string first, string second) {
    string[] roots = new string[2]; roots[0] = first; roots[1] = second;
    int[] owners = new int[2]; owners[0] = 0; owners[1] = 1;
    string message = "";
    try { OutputOwnership.Validate(roots, owners); } catch (Exception e) { message = e.Message; }
    Assert.True(message.Contains("directories overlap"));
}

[Test]
void test_output_ownership_allows_own_cache_and_removes_probe_files() {
    string root = File.CreateTempDir("package-output-test");
    try {
        string[] roots = new string[3];
        roots[0] = Path.Join(root, "a"); roots[1] = Path.Join(root, "a/cache"); roots[2] = Path.Join(root, "b");
        int[] owners = new int[3]; owners[0] = 0; owners[1] = 0; owners[2] = 1;
        OutputOwnership.Validate(roots, owners);
        Assert.Equal(3, Directory.EnumerateRecursive(root).Length);
    } finally { Directory.Delete(root, true); }
}

[Test]
void test_output_ownership_rejects_nested_and_lexically_aliased_roots() {
    string root = File.CreateTempDir("package-output-alias");
    try {
        _ownershipRejected(Path.Join(root, "a"), Path.Join(root, "a/child"));
        _ownershipRejected(Path.Join(root, "a/../b"), Path.Join(root, "b"));
        string[] entries = Directory.EnumerateRecursive(root);
        int i = 0;
        while (i < entries.Length) {
            Assert.False(Path.GetFileName(entries[i]).StartsWith(".package-ownership")); i = i + 1;
        }
    } finally { Directory.Delete(root, true); }
}

[Test]
[Skip(platform: "windows", reason: "File.SymLink is not supported by the Windows filesystem API")]
void test_output_ownership_rejects_symlink_to_another_tasks_descendant() {
    string root = File.CreateTempDir("package-output-symlink");
    try {
        string parent = Path.Join(root, "real");
        Directory.Create(Path.Join(parent, "child"));
        string alias = Path.Join(root, "alias");
        File.SymLink(Path.Join(parent, "child"), alias);
        _ownershipRejected(parent, alias);
    } finally { Directory.Delete(root, true); }
}

[Test]
[Skip(platform: "windows", reason: "File.SymLink is not supported by the Windows filesystem API")]
void test_output_ownership_bounds_alias_cycles_and_detects_shared_subtree() {
    string root = File.CreateTempDir("package-output-cycle");
    try {
        string a = Path.Join(root, "a"); string b = Path.Join(root, "b");
        string shared = Path.Join(root, "shared");
        Directory.Create(a); Directory.Create(b); Directory.Create(shared);
        File.SymLink(a, Path.Join(a, "cycle"));
        string[] own = new string[1]; own[0] = a;
        OutputOwnership.Validate(own, new int[1]);
        File.SymLink(shared, Path.Join(a, "shared"));
        File.SymLink(shared, Path.Join(b, "shared"));
        _ownershipRejected(a, b);
    } finally { Directory.Delete(root, true); }
}
