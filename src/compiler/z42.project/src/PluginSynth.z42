// 免清单插件条目（`[plugins]`）→ 合成最小插件清单。
//
// 「免清单」三种形态（对齐 tests：单文件测试 / 目录测试单元 / 源集 glob；`z42 run` 的单文件工程）：
//   · 源集（推荐，plugins-include-form）：`x = { include = ["hooks/**/*.z42"], exclude = [...] }`
//     —— include/exclude 相对消费方工程目录，与 [tests] 同键同语义（SynthSet）；
//   · 单文件：`x = { path = "hook.z42" }`（#1400；被源集形态取代，弃用中）；
//   · 目录：  `x = { path = "hooks/" }`（目录里没有工程清单 ⇒ 递归全收；同被源集形态取代）。
// 零依赖的插件（hook 几乎全是）不必手写 z42.toml——在消费方的构建树里合成一份最小清单
//（kind = "plugin"），之后**完全复用工程条目的代建路**（z42c `PluginRefs._pluginFromProject` /
// z42c.pipeline `BuildSession._buildPluginProject` / z42b `builder_hooks`）。需要清单能力
//（`[dependencies]` / `version` / include-exclude 精细控制——源集条目已自带 include/exclude）的
// 插件用完整工程形态（`path = "../gen"`）——目录里有清单时清单优先（配置存在即生效）。
//
// 与 launcher 的 `_synthSingleFileManifest` 同一套约定：
//   · 源文件**绝不复制**——include 写绝对路径（`SourceDiscovery` 对 rooted 直通），诊断指回
//     读者自己的文件，增量缓存也按真源生效；
//   · 清单每次重写（成本可忽略）——免得源移动/改名后清单陈旧；
//   · 合成目录按源绝对路径取指纹——同一插件反复构建落同一条目，代建的增量才有效。
// 落点由调用方给（z42c = 消费方 cache 目录 ⇒ 随消费方缓存一起清；z42b = hook interDir），本函数不选家。
namespace Z42.Project;

using Std.IO;

public static class PluginSynth {

    // 单文件条目 → 合成清单；失败（源文件不存在 / 写不进 baseDir）返回 ""（不打印，由调用方出诊断）。
    public static string SynthFile(string baseDir, string pluginName, string srcPath) {
        if (srcPath.Length == 0 || !File.Exists(srcPath)) { return ""; }
        return PluginSynth._write(baseDir, pluginName, PluginSynth._abs(srcPath));
    }

    // 免清单目录条目 → 合成清单（include = `<abs>/**/*.z42` 递归全收）；目录不存在或里面一个
    // .z42 都没有 → ""（不静默空——那是「配错目录」与「真空插件」不可区分的最坏失败形态）。
    public static string SynthDir(string baseDir, string pluginName, string srcDir) {
        if (srcDir.Length == 0 || !Directory.Exists(srcDir)) { return ""; }
        if (Path.GlobRecursive(srcDir, "*.z42").Length == 0) { return ""; }
        return PluginSynth._write(baseDir, pluginName, PluginSynth._abs(srcDir) + "/**/*.z42");
    }

    // 源集条目（plugins-include-form，对齐 [tests]）→ 合成清单：include/exclude 相对消费方工程目录
    // （srcRoot）的 glob，rebase 成绝对模式后原样写进合成清单（rooted 字面 / rooted 前缀 /**/ /
    // **/ 前缀三类展开都成立）。先按 srcRoot 试展开——零命中即 ""（不静默空），且诊断能在调用方
    // 指回消费方写的 pattern，而不是 cache 里的合成路径。
    public static string SynthSet(string baseDir, string pluginName, string srcRoot,
                                  string[] include, int includeN, string[] exclude, int excludeN) {
        string root = PluginSynth._abs(srcRoot);
        string[] inc = new string[includeN];
        int i = 0;
        while (i < includeN) { inc[i] = PluginSynth._rebase(root, include[i]); i = i + 1; }
        string[] exc = new string[excludeN];
        i = 0;
        while (i < excludeN) { exc[i] = PluginSynth._rebase(root, exclude[i]); i = i + 1; }
        if (SourceDiscovery.DiscoverWithExclude(root, inc, inc.Length, exc, exc.Length).Length == 0) { return ""; }
        return PluginSynth._writeSet(baseDir, pluginName, inc, inc.Length, exc, exc.Length);
    }

    // 消费方相对 pattern → 绝对 pattern（rooted 原样，其余接到 srcRoot 下；分隔符归一为 /）。
    private static string _rebase(string root, string pattern) {
        string p = pattern.Replace("\\", "/");
        if (Path.IsRooted(p)) { return p; }
        while (p.StartsWith("./")) { p = p.Substring(2, p.Length - 2); }
        return root + "/" + p;
    }

    // 统一写盘：目录 = `<baseDir>/plugin-synth/<name>-<指纹>/z42.toml`。
    private static string _write(string baseDir, string pluginName, string includePattern) {
        string dir = Path.Join(Path.Join(baseDir, "plugin-synth"), pluginName + "-" + PluginSynth._pathFp(includePattern));
        try {
            Directory.Create(dir);
            string toml = "# 由 [plugins] 免清单条目自动生成，请勿手工编辑。\n"
                + "# 源：" + includePattern + "\n"
                + "[project]\n"
                + "name    = \"" + pluginName + "\"\n"
                + "version = \"0.0.0\"\n"
                + "kind    = \"plugin\"\n"
                + "\n"
                + "[sources]\n"
                + "include = [\"" + includePattern + "\"]\n";
            string manifest = Path.Join(dir, "z42.toml");
            File.WriteAllText(manifest, toml);
            return manifest;
        } catch (Exception ex) {
            return "";
        }
    }

    // 源集条目的写盘（include/exclude 多模式；指纹取全部模式拼接——同一插件改源集 ⇒ 换合成目录）。
    private static string _writeSet(string baseDir, string pluginName, string[] inc, int incN,
                                    string[] exc, int excN) {
        string joined = "";
        int i = 0;
        while (i < incN) { joined = joined + (i > 0 ? ";" : "") + inc[i]; i = i + 1; }
        string dir = Path.Join(Path.Join(baseDir, "plugin-synth"), pluginName + "-" + PluginSynth._pathFp(joined));
        try {
            Directory.Create(dir);
            string toml = "# 由 [plugins] 源集条目自动生成，请勿手工编辑。\n"
                + "[project]\n"
                + "name    = \"" + pluginName + "\"\n"
                + "version = \"0.0.0\"\n"
                + "kind    = \"plugin\"\n"
                + "\n"
                + "[sources]\n"
                + "include = [" + PluginSynth._tomlList(inc, incN) + "]\n"
                + (excN > 0 ? "exclude = [" + PluginSynth._tomlList(exc, excN) + "]\n" : "");
            string manifest = Path.Join(dir, "z42.toml");
            File.WriteAllText(manifest, toml);
            return manifest;
        } catch (Exception ex) {
            return "";
        }
    }

    private static string _tomlList(string[] a, int n) {
        string s = "";
        int i = 0;
        while (i < n) { s = s + (i > 0 ? ", " : "") + "\"" + a[i] + "\""; i = i + 1; }
        return s;
    }

    private static string _abs(string p) {
        string abs = Path.IsRooted(p) ? p : Path.Join(Environment.GetCurrentDirectory(), p);
        return abs.Replace("\\", "/");
    }

    // include 模式指纹（与 z42c `_bytesFp` 同款散列强度，够选目录用）：长度 + 字符串哈希。
    private static string _pathFp(string s) {
        int h = 0;
        int i = 0;
        while (i < s.Length) {
            h = (h * 31 + (((int)s.CharAt(i)) & 255)) % 33554393;
            i = i + 1;
        }
        return s.Length.ToString() + "_" + h.ToString();
    }
}
