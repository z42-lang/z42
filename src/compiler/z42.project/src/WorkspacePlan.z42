// Workspace 成员规划：成员发现 + 依赖拓扑序 + per-member 布局 + `default_members` 选取。
//
// 放在 z42.project 而非编译器包：z42b 刻意零编译器程序依赖，`z42c build --workspace` 与
// `z42b build/test/bench/clean`（workspace 根）共用这一份实现（同 `PathDepPlan`）。
//
// 受限自举子集：无交错数组 → flat 平行数组。拓扑序按 member 名 Ordinal 逐轮扫描、依赖就绪即发射（确定性）。
namespace Z42.Project;

using Std.IO;

// 成员发现结果：flat 平行数组。
//   Tomls[i] / Names[i] = 成员 i 的 manifest 路径 / [project].name
//   成员 i 的 workspace 内依赖名 = DepFlat[DepOff[i] .. DepOff[i]+DepLen[i]]
public sealed class WorkspaceMembers {
    public string[] Tomls;
    public string[] Names;
    public string[] DepFlat;
    public int[]    DepOff;
    public int[]    DepLen;
    public int      Count;
    public WorkspaceMembers(string[] tomls, string[] names, string[] depFlat,
                            int[] depOff, int[] depLen, int count) {
        this.Tomls = tomls; this.Names = names; this.DepFlat = depFlat;
        this.DepOff = depOff; this.DepLen = depLen; this.Count = count;
    }
}

// 拓扑序的 per-member 构建计划。
//   Tomls[i] / Names[i] = 成员 i 的 manifest 路径 / [project].name（叶子在前）
//   DistDirs[i]  = 成员 i 的 dist 目录（[workspace.build].output_dir 模板展开 + "/dist"）
//   CacheDirs[i] = 成员 i 的 cache 目录（[workspace.build].cache_dir，缺省 "${output_dir}/.cache"）
//   Selected[i]  = 成员 i 是被选中的目标；false = 只因被选中成员（传递）依赖而入计划，需先建、不作目标
public sealed class WorkspaceLayoutPlan {
    public string[] Tomls;
    public string[] Names;
    public string[] DistDirs;
    public string[] CacheDirs;
    public bool[]   Selected;
    public int      Count;
    public WorkspaceLayoutPlan(string[] tomls, string[] names, string[] distDirs, string[] cacheDirs,
                               bool[] selected, int count) {
        this.Tomls = tomls; this.Names = names; this.DistDirs = distDirs; this.CacheDirs = cacheDirs;
        this.Selected = selected; this.Count = count;
    }

    // 被选中（作目标）的成员数。
    public int SelectedCount() {
        int n = 0;
        int i = 0;
        while (i < this.Count) { if (this.Selected[i]) { n = n + 1; } i = i + 1; }
        return n;
    }
}

public static class WorkspacePlan {

    // 不认识的键（ManifestKeys.AuditWorkspace 收集）→ 抛出，消息由调用方原样呈现（同成员缺失 / 环）。
    public static void RejectUnknownKeys(WorkspaceManifest ws, string wsToml) {
        if (ws.UnknownKeys.Length == 0) { return; }
        string msg = "";
        int i = 0;
        while (i < ws.UnknownKeys.Length) {
            if (i > 0) { msg = msg + "\n"; }
            msg = msg + wsToml + ": " + ws.UnknownKeys[i];
            i = i + 1;
        }
        throw new Exception(msg);
    }

    // wsToml → 拓扑序的**全部**成员 manifest 路径（叶子在前；环 / 缺成员 / 重名 → 抛）。
    public static string[] Plan(string wsToml) {
        WorkspaceManifest ws = ManifestLoader.LoadWorkspace(wsToml);
        WorkspacePlan.RejectUnknownKeys(ws, wsToml);
        WorkspaceMembers m = WorkspacePlan.DiscoverMembers(WorkspacePlan._dirOf(wsToml), ws);
        int[] order = WorkspacePlan.TopoOrder(m);
        string[] ordered = new string[m.Count];
        int i = 0;
        while (i < m.Count) { ordered[i] = m.Tomls[order[i]]; i = i + 1; }
        return ordered;
    }

    // 拓扑序的**全部**成员 + 每成员 dist / cache 目录（`z42c build --workspace` 的 per-member 布局）。
    // 未声明 [workspace.build].output_dir 时用默认模板（WorkspaceLayout.OutputTemplate）。
    // profile = "release" / "debug"（${profile} 替换）。
    public static WorkspaceLayoutPlan PlanLayout(string wsToml, string profile) {
        return WorkspacePlan._layout(wsToml, profile, false);
    }

    // 同 `PlanLayout`，但目标只取 `default_members` 选中的成员（z42b 在 workspace 根的默认集合）：
    //   · 没写或写成 `[]` → 全部成员（同 cargo）；
    //   · 选中成员（传递）依赖的 workspace 成员也进计划、排在它前面，`Selected = false`（要先建、不作目标）；
    //   · 条目 = 成员目录（相对 workspace 根）或成员的 [project].name；匹配不到任何成员 → 抛 WS031。
    public static WorkspaceLayoutPlan PlanDefault(string wsToml, string profile) {
        return WorkspacePlan._layout(wsToml, profile, true);
    }

    // 只能落地一个工程的命令（publish / export / run）在 workspace 根：`default_members` 恰选中一个成员
    // → 它的清单路径；否则抛，消息列出选中的成员清单（调用方加命令前缀呈现）。
    public static string SingleDefault(string wsToml) {
        WorkspaceLayoutPlan p = WorkspacePlan.PlanDefault(wsToml, "debug");
        int n = p.SelectedCount();
        string msg = "`" + wsToml + "` is a workspace and default_members selects " + n.ToString()
            + " members; pass one of them:";
        string only = "";
        int i = 0;
        while (i < p.Count) {
            if (p.Selected[i]) { only = p.Tomls[i]; msg = msg + "\n  " + p.Tomls[i]; }
            i = i + 1;
        }
        if (n == 1) { return only; }
        throw new Exception(msg);
    }

    private static WorkspaceLayoutPlan _layout(string wsToml, string profile, bool defaultOnly) {
        WorkspaceManifest ws = ManifestLoader.LoadWorkspace(wsToml);
        WorkspacePlan.RejectUnknownKeys(ws, wsToml);
        string wsDir = WorkspacePlan._dirOf(wsToml);
        WorkspaceMembers m = WorkspacePlan.DiscoverMembers(wsDir, ws);
        int[] order = WorkspacePlan.TopoOrder(m);
        bool[] pick = defaultOnly ? WorkspacePlan.SelectDefault(wsDir, ws, m) : null;
        bool[] need = pick == null ? null : WorkspacePlan._withDeps(m, pick);
        string[] tomls = new string[m.Count];
        string[] names = new string[m.Count];
        string[] dists = new string[m.Count];
        string[] caches = new string[m.Count];
        bool[] selected = new bool[m.Count];
        int n = 0;
        int i = 0;
        while (i < m.Count) {
            int idx = order[i];
            i = i + 1;
            if (need != null && !need[idx]) { continue; }
            selected[n] = pick == null || pick[idx];
            string toml = m.Tomls[idx];
            string name = m.Names[idx];
            string memberDir = WorkspacePlan._dirOf(toml);
            // 成员布局的唯一实现在 WorkspaceLayout（unify-build-layout）——单独构建成员 / path 依赖代建 /
            // 产物查询（BuildLayout.Resolve）用的是同一套规则。
            string outAbs = WorkspaceLayout.MemberOutputDir(ws, wsDir, memberDir, name, profile);
            tomls[n] = toml;
            names[n] = name;
            dists[n] = Path.Join(outAbs, "dist");
            caches[n] = WorkspaceLayout.MemberCacheDir(ws, wsDir, memberDir, name, profile, outAbs);
            n = n + 1;
        }
        return new WorkspaceLayoutPlan(tomls, names, dists, caches, selected, n);
    }

    // pick ∪ 它们在 workspace 内的传递依赖（按成员索引）。
    private static bool[] _withDeps(WorkspaceMembers m, bool[] pick) {
        bool[] need = new bool[m.Count];
        int i = 0;
        while (i < m.Count) { need[i] = pick[i]; i = i + 1; }
        bool changed = true;
        while (changed) {
            changed = false;
            int a = 0;
            while (a < m.Count) {
                if (need[a]) {
                    int j = 0;
                    while (j < m.DepLen[a]) {
                        int d = WorkspacePlan.IndexOfName(m.Names, m.Count, m.DepFlat[m.DepOff[a] + j]);
                        j = j + 1;
                        if (d >= 0 && !need[d]) { need[d] = true; changed = true; }
                    }
                }
                a = a + 1;
            }
        }
        return need;
    }

    // `default_members` → 按成员索引的选中位图。没写 / `[]` → 全选。
    // 条目先按成员目录（相对 wsDir，`/` 分隔，可带 `./`）匹配，再按 [project].name；都不中 → 抛 WS031。
    public static bool[] SelectDefault(string wsDir, WorkspaceManifest ws, WorkspaceMembers m) {
        bool[] pick = new bool[m.Count];
        int di = 0;
        if (ws.DefaultCount == 0) {
            while (di < m.Count) { pick[di] = true; di = di + 1; }
            return pick;
        }
        string[] rels = new string[m.Count];
        int r = 0;
        while (r < m.Count) {
            rels[r] = WorkspacePlan._relTo(wsDir, WorkspacePlan._dirOf(m.Tomls[r]));
            r = r + 1;
        }
        while (di < ws.DefaultCount) {
            string want = WorkspacePlan._normRel(ws.DefaultMembers[di]);
            di = di + 1;
            int hit = WorkspacePlan.IndexOfName(rels, m.Count, want);
            if (hit < 0) { hit = WorkspacePlan.IndexOfName(m.Names, m.Count, want); }
            if (hit < 0) {
                throw new Exception("workspace: default_members entry `" + ws.DefaultMembers[di - 1]
                    + "` matches no member (WS031); members: " + String.Join(", ", WorkspacePlan._sortedNames(m)));
            }
            pick[hit] = true;
        }
        return pick;
    }

    // 成员发现（fix-workspace-member-discovery）：按 `[workspace] members` 逐条展开（缺省 = `["*"]`），
    // 再按 `exclude` 剔除，清单经 `ManifestLocator.FindIn` 定位（认 `z42.toml` 与 `<name>.z42.toml`）。
    //   · 展开：段内 `*` / `?` 通配（逐段匹配子目录）；显式路径（无通配）必须存在且恰有一份清单，否则抛；
    //     通配展开出的目录没有清单就跳过（`members = ["*"]` 会扫到 artifacts/ 之类）。清单有歧义一律抛（WS005）。
    //   · `exclude`：按成员相对 wsDir 的路径做段级 glob（`PathGlob`）。
    //   · 去重 + Ordinal 排序（确定性，common-pitfalls §1）。
    public static WorkspaceMembers DiscoverMembers(string wsDir, WorkspaceManifest ws) {
        string[] pats = ws.Members;
        int patN = ws.MemberCount;
        if (patN == 0) { pats = new string[1]; pats[0] = "*"; patN = 1; }
        string[] rels = new string[8];
        int relN = 0;
        int pi = 0;
        while (pi < patN) {
            string pat = WorkspacePlan._normRel(pats[pi]);
            pi = pi + 1;
            string[] segs = PathGlob.Split(pat);
            bool explicitPath = true;
            int si = 0;
            while (si < segs.Length) { if (PathGlob.HasWildcard(segs[si])) { explicitPath = false; } si = si + 1; }
            string[] found = WorkspacePlan._expandMemberPattern(wsDir, segs);
            if (explicitPath && found.Length == 0) {
                throw new Exception("workspace: member `" + pats[pi - 1] + "` does not exist under " + wsDir);
            }
            int fi = 0;
            while (fi < found.Length) {
                if (WorkspacePlan.IndexOfName(rels, relN, found[fi]) < 0) {
                    rels = WorkspacePlan._push(rels, relN, found[fi]);
                    relN = relN + 1;
                }
                fi = fi + 1;
            }
        }
        string[] sorted = new string[relN];
        int ri = 0; while (ri < relN) { sorted[ri] = rels[ri]; ri = ri + 1; }
        sorted = WorkspacePlan.SortStrings(sorted);
        // 第一遍：收集 member toml + name。
        string[] tomls = new string[relN];
        string[] names = new string[relN];
        int count = 0;
        int e = 0;
        while (e < relN) {
            string rel = sorted[e];
            e = e + 1;
            if (WorkspacePlan._excludedMember(rel, ws)) { continue; }
            string dir = Path.Join(wsDir, rel);
            ManifestLocation loc = ManifestLocator.FindIn(dir);
            if (loc.Kind == ManifestLocateKind.Ambiguous) {
                throw new Exception("workspace: member directory `" + rel + "` has more than one manifest (WS005): "
                    + String.Join(", ", loc.Candidates));
            }
            if (loc.Kind != ManifestLocateKind.Project) { continue; }   // 无清单（通配扫到的普通目录）/ 嵌套 workspace
            ProjectManifest pm = ManifestLoader.Load(loc.ManifestPath);
            tomls[count] = loc.ManifestPath;
            names[count] = pm.Project.Name;
            count = count + 1;
        }
        WorkspacePlan.CheckUniqueNames(tomls, names, count);
        // 第二遍：每 member 的 workspace 内依赖（flat）。
        string[] depFlat = new string[count * count];   // 上界：每对一条边
        int[]    depOff  = new int[count];
        int[]    depLen  = new int[count];
        int flat = 0;
        int i = 0;
        while (i < count) {
            ProjectManifest pm = ManifestLoader.Load(tomls[i]);
            depOff[i] = flat;
            int len = 0;
            int d = 0;
            while (d < pm.DepCount) {
                string dn = pm.Deps[d].Name;
                d = d + 1;
                // 仅保留指向本 workspace 内成员的边。
                if (WorkspacePlan.IndexOfName(names, count, dn) >= 0) {
                    depFlat[flat] = dn;
                    flat = flat + 1;
                    len = len + 1;
                }
            }
            depLen[i] = len;
            i = i + 1;
        }
        return new WorkspaceMembers(tomls, names, depFlat, depOff, depLen, count);
    }

    // WS001：成员逻辑名 = [project].name，产物按包名落盘——重名成员会静默互相覆盖，必须拦下。
    public static void CheckUniqueNames(string[] tomls, string[] names, int count) {
        int i = 1;
        while (i < count) {
            int j = WorkspacePlan.IndexOfName(names, i, names[i]);   // 只在 [0, i) 里找
            if (j >= 0) {
                throw new Exception("workspace: duplicate member name `" + names[i] + "` (WS001): "
                    + tomls[j] + ", " + tomls[i]);
            }
            i = i + 1;
        }
    }

    // O(N²) 拓扑：按 member 名 Ordinal 逐轮扫描，「全部依赖已发射」即发射（同一轮内也可连发）。
    // 无进展但未全发射 → 环。返回成员索引（叶子在前）。
    public static int[] TopoOrder(WorkspaceMembers m) {
        int n = m.Count;
        bool[] done = new bool[n];
        int[]  order = new int[n];
        int    oc = 0;
        // 预排序的成员索引（按 name Ordinal）—— 保证就绪集发射序确定。
        int[] byName = WorkspacePlan.IndicesByName(m.Names, n);
        while (oc < n) {
            bool progress = false;
            int k = 0;
            while (k < n) {
                int idx = byName[k];
                k = k + 1;
                if (done[idx]) { continue; }
                if (WorkspacePlan._allDepsDone(m, idx, done)) {
                    order[oc] = idx;
                    oc = oc + 1;
                    done[idx] = true;
                    progress = true;
                }
            }
            if (!progress) {
                throw new Exception("workspace: circular member dependency");
            }
        }
        return order;
    }

    // names[0..count) 中 name 的索引；无 → -1。
    public static int IndexOfName(string[] names, int count, string name) {
        int i = 0;
        while (i < count) {
            if (names[i] == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // 0..n-1 按 names[i] Ordinal 升序的索引数组（插入排序，n 小）。
    public static int[] IndicesByName(string[] names, int n) {
        int[] idx = new int[n];
        int i = 0;
        while (i < n) { idx[i] = i; i = i + 1; }
        int a = 1;
        while (a < n) {
            int cur = idx[a];
            int b = a - 1;
            while (b >= 0 && names[cur].CompareTo(names[idx[b]]) < 0) {
                idx[b + 1] = idx[b];
                b = b - 1;
            }
            idx[b + 1] = cur;
            a = a + 1;
        }
        return idx;
    }

    // 字符串数组 Ordinal 升序（插入排序，确定性；z42 string.CompareTo 是 Ordinal）。
    public static string[] SortStrings(string[] arr) {
        int n = arr.Length;
        string[] r = new string[n];
        int i = 0;
        while (i < n) { r[i] = arr[i]; i = i + 1; }
        int a = 1;
        while (a < n) {
            string cur = r[a];
            int b = a - 1;
            while (b >= 0 && cur.CompareTo(r[b]) < 0) {
                r[b + 1] = r[b];
                b = b - 1;
            }
            r[b + 1] = cur;
            a = a + 1;
        }
        return r;
    }

    // 成员 idx 的全部 workspace 内依赖是否都已发射。
    private static bool _allDepsDone(WorkspaceMembers m, int idx, bool[] done) {
        int off = m.DepOff[idx];
        int len = m.DepLen[idx];
        int j = 0;
        while (j < len) {
            int di = WorkspacePlan.IndexOfName(m.Names, m.Count, m.DepFlat[off + j]);
            j = j + 1;
            if (di >= 0 && !done[di]) { return false; }
        }
        return true;
    }

    // 一条 members 模式 → 命中的成员目录（相对 wsDir，`/` 分隔）。逐段扩张：字面段直接拼（存在才留），
    // 通配段枚举子目录后逐个 `PathGlob.MatchSeg`。
    private static string[] _expandMemberPattern(string wsDir, string[] segs) {
        string[] frontier = new string[1]; frontier[0] = "";
        int fn = 1;
        int si = 0;
        while (si < segs.Length) {
            string seg = segs[si];
            si = si + 1;
            string[] next = new string[8];
            int nn = 0;
            int fi = 0;
            while (fi < fn) {
                string baseRel = frontier[fi];
                fi = fi + 1;
                string baseDir = baseRel.Length == 0 ? wsDir : Path.Join(wsDir, baseRel);
                if (!PathGlob.HasWildcard(seg)) {
                    string cand = baseRel.Length == 0 ? seg : baseRel + "/" + seg;
                    if (Directory.Exists(Path.Join(wsDir, cand))) { next = WorkspacePlan._push(next, nn, cand); nn = nn + 1; }
                    continue;
                }
                if (!Directory.Exists(baseDir)) { continue; }
                string[] entries = WorkspacePlan.SortStrings(Directory.Enumerate(baseDir));
                int ei = 0;
                while (ei < entries.Length) {
                    // `Directory.Enumerate` 返回**条目名**，不是路径——拿名字直接 `Directory.Exists`
                    // 只在 cwd 恰好是 workspace 根时才对。
                    string name = Path.GetFileName(entries[ei]);
                    ei = ei + 1;
                    string full = Path.Join(baseDir, name);
                    if (!Directory.Exists(full)) { continue; }
                    if (!PathGlob.MatchSeg(name, 0, seg, 0)) { continue; }
                    string cand = baseRel.Length == 0 ? name : baseRel + "/" + name;
                    next = WorkspacePlan._push(next, nn, cand); nn = nn + 1;
                }
            }
            frontier = next; fn = nn;
        }
        string[] r = new string[fn];
        int k = 0; while (k < fn) { r[k] = frontier[k]; k = k + 1; }
        return r;
    }

    private static bool _excludedMember(string rel, WorkspaceManifest ws) {
        int i = 0;
        while (i < ws.ExcludeCount) {
            if (PathGlob.Match(rel, WorkspacePlan._normRel(ws.Exclude[i]))) { return true; }
            i = i + 1;
        }
        return false;
    }

    // 清单里写的相对路径 → `/` 分隔、去掉前导 `./` 与尾随 `/`。
    private static string _normRel(string p) {
        string s = p.Replace("\\", "/");
        if (s.StartsWith("./")) { s = s.Substring(2, s.Length - 2); }
        while (s.Length > 1 && s.EndsWith("/")) { s = s.Substring(0, s.Length - 1); }
        return s;
    }

    // memberDir 相对 wsDir 的路径（`/` 分隔）。两者都由 DiscoverMembers 经 Path.Join(wsDir, rel) 拼出，
    // 前缀必然对得上；对不上（不该发生）就原样返回，按名匹配兜底。
    private static string _relTo(string wsDir, string memberDir) {
        string b = wsDir.Replace("\\", "/");
        string d = memberDir.Replace("\\", "/");
        if (b == "." && !d.StartsWith("/")) { return WorkspacePlan._normRel(d); }
        if (d.StartsWith(b + "/")) { return d.Substring(b.Length + 1, d.Length - b.Length - 1); }
        return d;
    }

    private static string _dirOf(string path) {
        string d = Path.GetDirectoryName(path);
        return d.Length == 0 ? "." : d;
    }

    private static string[] _sortedNames(WorkspaceMembers m) {
        string[] a = new string[m.Count];
        int i = 0; while (i < m.Count) { a[i] = m.Names[i]; i = i + 1; }
        return WorkspacePlan.SortStrings(a);
    }

    private static string[] _push(string[] a, int n, string v) {
        if (n == a.Length) {
            string[] b = new string[a.Length * 2];
            int k = 0; while (k < n) { b[k] = a[k]; k = k + 1; }
            a = b;
        }
        a[n] = v;
        return a;
    }
}
