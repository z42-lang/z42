namespace Z42.Project;

// 受限自举子集写法：sealed class + 构造函数；无 record / 无泛型 / 无 nullable。
// 类型名对齐 z42c.project（DepEntry / WorkspaceManifest），便于日后 z42c 直接引用本库。

/// `[dependencies]` / `[workspace.dependencies]` 的一项。Version "*" = 任意。
/// Path 非空 = 本地路径依赖（`{ path = "../foo" }`），源在相对 manifest 目录的 Path 处；
/// Path 为 "" = 名字依赖，按名走 Z42_LIBS 解析。（消费逻辑在 z42c driver，PR-2 落地。）
public sealed class DepEntry {
    public string Name;
    public string Version;
    public string Path;
    /// `deploy` —— 这个依赖**运行期从哪儿来**（add-deployment-model 批 4 support）。
    ///
    ///   `"copy"`   构建期复制进 exe 的 dist，私有、不共享；
    ///   `"shared"` 不复制，运行期从 `probing-paths` 声明的目录解析；
    ///   `""`       未声明 —— 由默认规则决定（在不在 shipped `libs/`）。
    ///
    /// ⚠️ **构造后赋值、不进 ctor 签名**：ctor 是种子 ABI 的一部分，加参数会让上一版 z42c
    /// 编不动当前源码。同 `Pipeline.ParentPkg` / `ProjectManifest` 的那几个「构造后填」字段。
    ///
    /// 🔴 **support 阶段：本字段今天无人消费**（z42c 不读它）⇒ 产物逐字节不变、可立即合并。
    /// ✅ 阶段 2 已落地（#848）：`_validateDeployDecls` 校验取值、`_bundleExeDeps` 按它决定复制。
    ///    （原注写「消费要等它随 nightly 进种子之后」，消费落地后没跟着改。）
    public string Deploy;
    /// `internal`（plugin-internal-access）：**宿主侧授权**——`[plugins.export]` 的 path 条目声明后，
    /// 该插件的代建编译以宿主为 ParentPkg（宿主 internal 对它可见，与测试单元同机制）。
    /// 仅 export 条目合法（[plugins] 条目的插件跑在宿主自己的编译里，先于宿主构建，构成环）。
    /// 构造后赋值：ctor 签名是种子 ABI，不动。
    public bool   Internal;
    /// `[plugins]` 源集条目（plugins-include-form，对齐 [tests]）：include/exclude 是相对**消费方**
    /// 工程目录的源码 glob（须以文件模式收尾，如 `hooks/**/*.z42` / `hooks/hook.z42`）。
    /// IncludeCount > 0 = 源集条目（PluginSynth 合成最小清单，include 的源集自动排除出消费方源
    /// 发现——显式分区）；与 path 互斥。[plugins.export] 不收源集条目（携带钉精确版本，要真工程）。
    /// 构造后赋值：ctor 签名是种子 ABI，不动。
    public string[] Include;
    public int      IncludeCount;
    public string[] Exclude;
    public int      ExcludeCount;
    public DepEntry(string name, string version, string path) {
        this.Name = name;
        this.Version = version;
        this.Path = path;
        this.Deploy = "";
    }
}
