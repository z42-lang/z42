namespace Z42.Project;

/// `[project]` 段。工程配置确定，字段固定、不开放任意键。
public sealed class ProjectInfo {
    public string Name;        // kebab-case；.zpkg 文件名 + 依赖引用名
    public string Version;     // SemVer
    public string Kind;        // "exe" | "lib" | "plugin"（插件：加载进工具链进程运行；旧名 "analyzer" 已删除）
    // 显式入口：清单里**没有**这个键（`[project] entry` 报错，z42c 自动检测唯一 `Main()`）；只供程序化构造的
    // 派生清单用（z42b 的 `[[test]] harness = false` 目标把目标自己的 `entry` 透到这里）。
    public bool   HasEntry;
    public string Entry;       // 仅 HasEntry 有效（否则自动探测）
    public bool   HasPack;
    public bool   Pack;        // [project].pack；仅 HasPack 有效，否则 isPacked = isRelease
    // （此处原注释写着「[profile.*].pack 最低优先级回退」——那个回退**从未实现**，
    //  `Profile.Pack` 解析后从无人读；restructure-profile-sections 已删该死字段。）
    // 纯元数据（不参与构建，只供展示 / 打包描述）。构造后赋值：ctor 签名是种子 ABI，不动。
    public string   Description;
    public string[] Authors;
    public string   License;
    public ProjectInfo(string name, string version, string kind,
                       bool hasEntry, string entry, bool hasPack, bool pack) {
        this.Name = name; this.Version = version; this.Kind = kind;
        this.HasEntry = hasEntry; this.Entry = entry;
        this.HasPack = hasPack; this.Pack = pack;
        this.Description = ""; this.Authors = new string[0]; this.License = "";
    }

    /// 插件工程（`kind = "plugin"`）：产物加载进工具链进程运行，永不链入目标程序。
    public bool IsPlugin() { return this.Kind == "plugin"; }
}
