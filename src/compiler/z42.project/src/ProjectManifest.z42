namespace Z42.Project;

using Std.Toml;

/// `z42.toml` 的完整类型化模型（单项目）。z42c 与 z42.build 共同依赖的唯一真相。
///
/// 受限自举子集写法：sealed class + 构造函数、bool HasX 替 nullable、array+count 替泛型。
/// 各段随 schema 增长在对应记录补字段；本根只做聚合。
/// workspace 清单（`[workspace]`）单独解析，见 `WorkspaceManifest`。
public sealed class ProjectManifest {
    public ProjectInfo Project;        // [project]
    public Sources     Sources;        // [sources]
    public BuildConfig Build;          // [build]
    public Profile[]   Profiles;       // [profile.*]
    public int         ProfileCount;
    public DepEntry[]  Deps;           // [dependencies]
    public int         DepCount;
    public ExeTarget[] Exes;           // [[exe]]（单 exe 时 ExeCount == 0）
    public int         ExeCount;
    public PlatformSet Platform;       // [platform.*]
    // ── dev 目标（test / bench / example；release 构建忽略）──────────────────
    public TargetSection TestsSection;   // [tests]
    public TargetSection BenchSection;   // [bench]
    public TargetSection ExampleSection; // [example]
    public RunTarget[] Tests;          // [[test]]
    public int         TestCount;
    public RunTarget[] Benches;        // [[bench]]
    public int         BenchCount;
    public RunTarget[] Examples;       // [[example]]
    public int         ExampleCount;
    // ── [optimize] 逐 pass 具名开关（add-compiler-inlining）───────────────────
    // 中性 name/value 对（如 inline=true / const-fold=false）；消费方（z42c.driver）按名映射到编译器
    // 的 Opt 位（Opt.ByName）建 tomlBits/tomlMask 交 Opt.Resolve。z42.project **不**耦合 Opt 位值。
    // 可变公字段（默认空，ManifestLoader 构造后填），避免撑大已 20 参的构造函数。
    public string[] OptimizeNames; public bool[] OptimizeValues; public int OptimizeCount;
    // ── [syntax] 语法特性开关（add-l0-protocol-table 批 1）────────────────────
    // 中性 name/value 对（如 `control_flow = false`）；消费方（z42c.driver）按名喂给
    // `LanguageFeatures`、解析器据此发 E0301。z42.project **不**认识特性名的语义，只搬运
    // —— 同 OptimizeNames / LintNames 的形态。可变公字段（默认空，ManifestLoader 构造后填）。
    // 🔴 未知特性名由**消费方**报错、不静默忽略（同 `Opt.ByName` 的口径）：这里只搬。
    public string[] SyntaxNames; public bool[] SyntaxValues; public int SyntaxCount;
    // ── [analyzers]：种子 ABI 残留（与 `Plugins` 同一份内容）────────────────────
    // 上一版 z42c 是已编译的二进制，运行期按名访问当前源码编出的本类字段——这对字段改名即断链。新代码一律读
    // 末尾的 `Plugins`。
    // STAGE2-DEBT(legacy-plugin-keys): 种子的 z42c.driver 不再读 pm.Analyzers / AnalyzerCount 后删掉这两个字段；同一步把仓内清单的 [analyzers] / kind = "analyzer" / [build] hooks 迁到 [plugins] / kind = "plugin" 并删掉这三个旧写法。
    public DepEntry[] Analyzers; public int AnalyzerCount;
    // ── [lints] 诊断规则开关 / severity 覆盖（attribute-handler-registry PR3b）─────
    // 中性 key/severity 字符串对（如 `Z9002="warning"` / `"webgen.*"="none"`）——z42.project **不**
    // 认识规则 Id / severity 语义，只搬运；消费方（z42c 的 LintConfig）解释成每规则最终 severity
    // （EnabledByDefault + 覆盖 + 通配 + warnings_as_errors）。`warnings_as_errors` 布尔单独拎出。
    // 可变公字段（默认空，ManifestLoader 构造后填），同 OptimizeNames 模式。
    public string[] LintNames; public string[] LintSeverities; public int LintCount;
    public bool LintWarningsAsErrors;
    // ── [native.<name>] 本包携带的私有 native 库（add-native-dep-config）─────────
    // 每项 = 逻辑名；实际文件名平台派生 <prefix><name><suffix>（NativeSpec）。消费方（z42b publish
    // 的 _pubBundleProjectNativeDeps）沿 path-dep 闭包读本段，跑 dep 的 ProvideNative、按目标 rid 平铺
    // 进 payload。z42.project 只搬名字、不产/不解析文件。可变公字段（默认空，ManifestLoader 构造后填）。
    public NativeSpec[] Natives; public int NativeCount;
    // ── [properties] 应用自定义配置属性（add-app-properties）─────────────────
    // **不是运行时旋钮**：z42.project 与 VM 都不理解它的含义，只搬运。基表对所有 profile
    // 共用，`[profile.<n>.properties]` 逐 key 浅覆盖它；build 把合并结果烤进侧车的
    // `[properties]` 段，运行时经 `Std.Runtime.AppProperties` 只读。原样保留 TomlValue
    // 以支持完整 TOML 类型（数组 / 嵌套表）。可变公字段（默认空表，ManifestLoader 填）。
    public TomlValue Properties;
    // ── 未知键（ManifestKeys.AuditProject）────────────────────────────────────────
    // 每项一行现成的文本（不含清单路径）。z42.project 只收集，消费方（ManifestKnobs.Resolve）报错。
    // 可变公字段（默认空，ManifestLoader 构造后填）。
    public string[] UnknownKeys;
    // ── [plugins] 插件 zpkg 引用 ─────────────────────────────────────────────
    // 独立引用段：插件（analyzer / generator / hook）加载进工具链进程运行、不链入目标程序，与
    // [dependencies] 物理分开。中性 DepEntry：Path 空 = 按名在依赖目录找 `<name>.zpkg`；Path 以 `.zpkg`
    // 结尾 = 现成产物；否则 = 插件工程目录（代建）。插件包提供哪几类由 zpkg 头的能力位说明，消费方
    // （z42c 取 analyzer / generator，z42b 取 hook）按位分流。旧段名 `[analyzers]` 的条目排在前面一并收进来
    // （同名重复由 ManifestKnobs 报错）。可变公字段（默认空，ManifestLoader 构造后填）。
    // 🔴 种子 ABI：新字段**追加在类的最末尾**、不进 ctor 签名。
    public DepEntry[] Plugins; public int PluginCount;
    public ProjectManifest(ProjectInfo project, Sources sources, BuildConfig build,
                           Profile[] profiles, int profileCount,
                           DepEntry[] deps, int depCount,
                           ExeTarget[] exes, int exeCount,
                           PlatformSet platform,
                           TargetSection testsSection, TargetSection benchSection,
                           TargetSection exampleSection,
                           RunTarget[] tests, int testCount,
                           RunTarget[] benches, int benchCount,
                           RunTarget[] examples, int exampleCount) {
        this.Project = project; this.Sources = sources; this.Build = build;
        this.Profiles = profiles; this.ProfileCount = profileCount;
        this.Deps = deps; this.DepCount = depCount;
        this.Exes = exes; this.ExeCount = exeCount;
        this.Platform = platform;
        this.TestsSection = testsSection; this.BenchSection = benchSection;
        this.ExampleSection = exampleSection;
        this.Tests = tests; this.TestCount = testCount;
        this.Benches = benches; this.BenchCount = benchCount;
        this.Examples = examples; this.ExampleCount = exampleCount;
        this.OptimizeNames = new string[0]; this.OptimizeValues = new bool[0]; this.OptimizeCount = 0;
        this.SyntaxNames = new string[0]; this.SyntaxValues = new bool[0]; this.SyntaxCount = 0;
        this.Analyzers = new DepEntry[0]; this.AnalyzerCount = 0;
        this.LintNames = new string[0]; this.LintSeverities = new string[0]; this.LintCount = 0;
        this.LintWarningsAsErrors = false;
        this.Natives = new NativeSpec[0]; this.NativeCount = 0;
        this.Properties = TomlValue.OfTable();
        this.UnknownKeys = new string[0];
        this.Plugins = new DepEntry[0]; this.PluginCount = 0;
    }

    /// 本工程源发现的有效 exclude：`[sources].exclude`，再加上住在工程目录里的插件源码目录——
    /// `[build] hooks` 目录与指向工程内目录的 `[plugins]` path 条目。插件由工具链单独构建、加载进
    /// 宿主进程，不该被 app 的 `**/*.z42` 扫进 app zpkg（否则多出一个跨包死类，vtable fixup 刷屏）。
    /// 目录排除写成 `<dir>/**`（SourceDiscovery 的前缀语义）；指到工程目录外（`..` 开头 / 绝对路径）
    /// 或指向 `.zpkg` 产物的条目与源发现无关，跳过。
    public string[] EffectiveSourceExcludes() {
        string[] acc = new string[this.Sources.ExcludeCount + 1 + this.PluginCount];
        int n = 0;
        int i = 0;
        while (i < this.Sources.ExcludeCount) { acc[n] = this.Sources.Exclude[i]; n = n + 1; i = i + 1; }
        if (this.Build.HasHooks) { acc[n] = this.Build.HooksDir + "/**"; n = n + 1; }
        int p = 0;
        while (p < this.PluginCount) {
            string dir = ProjectManifest._inProjectDir(this.Plugins[p].Path);
            if (dir.Length > 0) { acc[n] = dir + "/**"; n = n + 1; }
            p = p + 1;
        }
        string[] r = new string[n];
        int k = 0;
        while (k < n) { r[k] = acc[k]; k = k + 1; }
        return r;
    }

    // path 条目若指向工程目录内的一个目录 → 规范化后的相对目录（去掉 `./` 前缀与尾 `/`）；否则 ""。
    private static string _inProjectDir(string path) {
        string d = path.Replace("\\", "/");
        while (d.StartsWith("./")) { d = d.Substring(2); }
        while (d.EndsWith("/")) { d = d.Substring(0, d.Length - 1); }
        if (d.Length == 0 || d == "." || d.StartsWith("/") || d.StartsWith("..") || d.EndsWith(".zpkg")) { return ""; }
        if (d.Length >= 2 && d.Substring(1, 1) == ":") { return ""; }   // Windows 盘符绝对路径
        return d;
    }
}
