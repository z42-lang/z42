// 统一转换分类器单测（add-conversion-classifier PR1）：种类标签 + 宽松门布尔投影。
namespace Z42cSemanticsConversionTests;

using Std;
using Std.Test;
using Z42.Semantics;

// 便捷：分类 prim 对（无需 symbols 上下文）。
int _kind(string from, string to) {
    var f = new Z42PrimType(from);
    var t = new Z42PrimType(to);
    return Conversion.Classify(f, t, new SymbolTable()).Kind;
}

bool _implicitOk(string from, string to) {
    var f = new Z42PrimType(from);
    var t = new Z42PrimType(to);
    return Conversion.Classify(f, t, new SymbolTable()).ImplicitOkPermissive();
}

[Test]
void test_numeric_widening_implicit() {
    Assert.Equal(ConvKind.ImplicitNumeric, _kind("int", "long"));    // int→long
    Assert.Equal(ConvKind.ImplicitNumeric, _kind("int", "double"));  // int→double（32<53 无损）
    Assert.Equal(ConvKind.ImplicitNumeric, _kind("byte", "int"));    // byte→int
    Assert.Equal(ConvKind.ImplicitNumeric, _kind("short", "long"));  // short→long
    Assert.Equal(ConvKind.ImplicitNumeric, _kind("float", "double")); // float→double
    Assert.Equal(ConvKind.ImplicitNumeric, _kind("char", "int"));    // char→int
}

[Test]
void test_numeric_narrowing_explicit() {
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("long", "int"));    // long→int 窄化
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("int", "byte"));    // int→byte 窄化
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("double", "int"));  // double→int 窄化
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("int", "char"));    // int→char 窄化
}

[Test]
void test_lossy_float_explicit() {   // 比 C# 严：整数→浮点丢尾数精度 → 显式
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("int", "float"));    // 31>24 有损
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("uint", "float"));   // 32>24 有损
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("long", "float"));   // 有损
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("long", "double"));  // 63>53 有损
    Assert.Equal(ConvKind.ExplicitNumeric, _kind("ulong", "double")); // 有损
    // 无损浮点仍隐式：
    Assert.Equal(ConvKind.ImplicitNumeric, _kind("uint", "double"));  // 32<53 无损
}

[Test]
void test_identity() {
    Assert.Equal(ConvKind.Identity, _kind("int", "int"));   // 同型
    Assert.Equal(ConvKind.Identity, _kind("byte", "u8"));   // 别名归一
    Assert.Equal(ConvKind.Identity, _kind("int?", "int"));  // 剥 nullable
    Assert.Equal(ConvKind.Identity, _kind("string", "string"));
    Assert.Equal(ConvKind.Identity, _kind("bool", "bool"));
}

[Test]
void test_box_unbox_direction() {
    Assert.Equal(ConvKind.Boxing,   _kind("int", "object"));   // 值 → object
    Assert.Equal(ConvKind.Boxing,   _kind("bool", "object"));
    Assert.Equal(ConvKind.Unboxing, _kind("object", "int"));   // object → 值
    Assert.Equal(ConvKind.ImplicitRef, _kind("string", "object")); // string 是引用 → 上转非装箱
}

[Test]
void test_none_and_absorb() {
    Assert.Equal(ConvKind.None, _kind("int", "string"));  // 不相关
    Assert.Equal(ConvKind.None, _kind("bool", "int"));    // bool↔数值 禁止
    var err = new Z42ErrorType();
    var i = new Z42PrimType("int");
    Assert.Equal(ConvKind.Absorb, Conversion.Classify(i, err, new SymbolTable()).Kind);
    Assert.Equal(ConvKind.Absorb, Conversion.Classify(err, i, new SymbolTable()).Kind);
}

[Test]
void test_class_ref_conversions() {
    var syms = new SymbolTable();
    var foo = new Z42ClassType("Foo", false, "");
    var bar = new Z42ClassType("Bar", true, "Foo");   // Bar : Foo
    syms.Classes.Put("Foo", foo);
    syms.Classes.Put("Bar", bar);
    // 上转 派生→基 → ImplicitRef
    Assert.Equal(ConvKind.ImplicitRef, Conversion.Classify(bar, foo, syms).Kind);
    // 下转 基→派生 → ExplicitRef
    Assert.Equal(ConvKind.ExplicitRef, Conversion.Classify(foo, bar, syms).Kind);
    // 同名 → Identity
    Assert.Equal(ConvKind.Identity, Conversion.Classify(foo, new Z42ClassType("Foo", false, ""), syms).Kind);
}

[Test]
void test_class_interface_conversion() {
    var syms = new SymbolTable();
    var iface = new Z42InterfaceType("IShape");
    var circle = new Z42ClassType("Circle", false, "");
    circle.AddInterfaceName("IShape");
    syms.Interfaces.Put("IShape", iface);
    syms.Classes.Put("Circle", circle);
    Assert.Equal(ConvKind.ImplicitRef, Conversion.Classify(circle, iface, syms).Kind); // 类→接口 上转
}

[Test]
void test_permissive_projection() {   // PR1 宽松门：ExplicitNumeric 仍放行；Unboxing/ExplicitRef/None 不放行
    Assert.Equal(true,  _implicitOk("int", "long"));   // ImplicitNumeric
    Assert.Equal(true,  _implicitOk("int", "byte"));   // ExplicitNumeric（PR1 宽松放行）
    Assert.Equal(true,  _implicitOk("int", "float"));  // ExplicitNumeric（有损，PR1 仍放行）
    Assert.Equal(true,  _implicitOk("int", "object")); // Boxing
    Assert.Equal(false, _implicitOk("object", "int")); // Unboxing 不放行
    Assert.Equal(false, _implicitOk("int", "string")); // None 不放行
    Assert.Equal(false, _implicitOk("bool", "int"));   // None 不放行
}

// ════ tighten-implicit-conversions（PR2）：收紧门 + 常量例外 + E0439 ═══════════════

bool _implicitStrict(string from, string to) {
    var f = new Z42PrimType(from);
    var t = new Z42PrimType(to);
    return Conversion.Classify(f, t, new SymbolTable()).ImplicitOk();
}

[Test]
void test_strict_projection() {   // PR2 收紧门：ExplicitNumeric 不再放行（窄化/有损浮点）
    Assert.Equal(true,  _implicitStrict("int", "long"));    // ImplicitNumeric 仍放行
    Assert.Equal(true,  _implicitStrict("int", "double"));  // 无损拓宽仍放行
    Assert.Equal(false, _implicitStrict("int", "byte"));    // 窄化不放行
    Assert.Equal(false, _implicitStrict("long", "int"));    // 窄化不放行
    Assert.Equal(false, _implicitStrict("int", "float"));   // 有损浮点不放行
    Assert.Equal(true,  _implicitStrict("int", "object"));  // Boxing 仍放行
}

// 窄化（非常量）→ E0439：存在显式转换却用于隐式上下文。
[Test]
void test_gate_narrowing_nonconst_rejected() {
    string src = "class C { void M(int x) { byte b = x; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0439", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_gate_long_to_int_nonconst_rejected() {
    string src = "class C { void M(long y) { int n = y; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0439", SemanticDump.FirstErrorCode(src));
}

// 有损浮点（int→float，无常量例外）→ E0439。
[Test]
void test_gate_lossy_float_nonconst_rejected() {
    string src = "class C { void M(int x) { float f = x; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0439", SemanticDump.FirstErrorCode(src));
}

// C# 常量在范围内例外：byte b = 48; 合法（0 错）。
[Test]
void test_gate_const_in_range_ok() {
    string src = "class C { void M() { byte b = 48; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// 越界常量 → E0439（byte b = 300; 越界）。
[Test]
void test_gate_const_out_of_range_rejected() {
    string src = "class C { void M() { byte b = 300; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0439", SemanticDump.FirstErrorCode(src));
}

// 负常量在范围内例外：sbyte s = -1; 合法。
[Test]
void test_gate_negative_const_in_range_ok() {
    string src = "class C { void M() { sbyte s = -1; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// 无损拓宽（int→double / int→long）隐式仍合法。
[Test]
void test_gate_widening_still_implicit() {
    string src = "class C { void M() { double d = 5; long l = 5; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// 拓宽赋值插 ConvertInstr：`double d = 5` 的 init 被包成 convert 节点（int→double 表示转换）。
[Test]
void test_widening_emits_convert_node() {
    string src = "class C { void M() { double d = 5; } }";
    Assert.Equal("(block (decl d :double (convert (lit-int 5 :int) :double)))",
                 SemanticDump.DumpBody(src, "C.M"));
}
