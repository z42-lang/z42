// define-null-check-marks：标了 `?` 的形参，解引用前必须先检查空值 → E0478。
//
// 设计立场（User 定的）：**默认可空、按需从严**。`?` 不是「这里可能是 null」的描述，
// 而是「**请编译器在这里强制检查**」的请求；不标 = 不强制 ⇒ 存量代码一行不用改。
// 逃生口只有窄化，**没有 `!` 那样的「我保证」后缀**——那正是 C# 里让问题逃掉的口子。
//
// ⚠️ **本组最要紧的性质仍是「该报的都报」**（同 definite_assignment_tests 的理由）：
// 全仓只有 7 处引用类型 `?` 标注，构建全绿既可能是窄化写得对、也可能是 pass 没接通，
// 只有下面的阴性用例能分辨。
namespace Z42cSemanticsNullCheckMarksTests;

using Std;
using Std.Test;
using Z42.Semantics;

// ── 基础：标了就强制、没标就不管 ──────────────────────────────────

[Test]
void test_marked_param_deref_errors() {
    string src = "namespace N; class C { static int M(string? s) { return s.Length; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

// 对照组 —— 这条是整个设计的支点：**不标 `?` 就完全不受检**，
// 所以存量代码的迁移成本是零。它变红就说明「按需从严」塌成了「全局强制」。
[Test]
void test_unmarked_param_is_not_checked() {
    string src = "namespace N; class C { static int M(string s) { return s.Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 窄化：`if (s != null)` ────────────────────────────────────────

[Test]
void test_narrow_by_if_not_null_ok() {
    string src = "namespace N; class C { static int M(string? s) { if (s != null) { return s.Length; } return 0; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_narrow_reversed_operands_ok() {
    string src = "namespace N; class C { static int M(string? s) { if (null != s) { return s.Length; } return 0; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 阴性对照：检查了却在**另一支**里用，仍要报——否则「窄化」退化成「出现过 null 比较即放行」。
[Test]
void test_deref_in_else_branch_errors() {
    string src = "namespace N; class C { static int M(string? s) { if (s != null) { return 1; } return s.Length; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

// ── 窄化：早返回守卫（`?` 形参最主要的检查写法）────────────────────

[Test]
void test_early_return_guard_ok() {
    string src = "namespace N; class C { static int M(string? s) { if (s == null) { return 0; } return s.Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_early_throw_guard_ok() {
    // ⚠️ 语义层测试的源码串里 `Std.Exception` 解析不到（无 using）——用本地类，
    // 先例见 typecheck_tests.z42 的 `class E { }`（同一个坑踩过一次了）。
    string src = "namespace N; class E { } class C { static int M(string? s) "
        + "{ if (s == null) { throw new E(); } return s.Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 阴性对照：守卫体**落得下来**（不是必定退出）⇒ 后面仍可能是 null，必须报。
// 这条钉的是 `AlwaysReturns` 真的参与了判断，而不是「见到 `if (s == null)` 就放行」。
[Test]
void test_non_exiting_guard_still_errors() {
    string src = "namespace N; class C { static int M(string? s) { if (s == null) { s = null; } return s.Length; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

// ── 短路求值自带的窄化 ────────────────────────────────────────────
//
// `String.IsNullOrEmpty` 就是这个形状。实现时这里先误报过一次 —— 按 D3
// （误报 = 漏了一种结构，不是「规则太严」）补的短路窄化。

[Test]
void test_or_else_short_circuit_ok() {
    string src = "namespace N; class C { static bool M(string? s) { return s == null || s.Length == 0; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_and_also_short_circuit_ok() {
    string src = "namespace N; class C { static bool M(string? s) { return s != null && s.Length > 0; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 阴性对照：短路方向反了就不成立（`&&` 的左边为假时右边不求值，
// 但 `s == null && s.Length > 0` 的右边恰恰只在 s **是** null 时才到达）。
[Test]
void test_wrong_short_circuit_direction_errors() {
    string src = "namespace N; class C { static bool M(string? s) { return s == null && s.Length > 0; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_ternary_narrowing_ok() {
    string src = "namespace N; class C { static int M(string? s) { return s != null ? s.Length : 0; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 各类解引用位置都算义务点 ──────────────────────────────────────

[Test]
void test_method_call_receiver_errors() {
    string src = "namespace N; class C { static string M(string? s) { return s.Trim(); } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_indexer_target_errors() {
    string src = "namespace N; class C { static int M(int[]? a) { return a[0]; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_foreach_collection_errors() {
    string src = "namespace N; class C { static int M(int[]? a) { int n = 0; foreach (int v in a) { n = n + v; } return n; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

// 对照组：**比较**不是解引用 —— 检查空值本身不能被自己判红。
[Test]
void test_null_comparison_is_not_a_deref() {
    string src = "namespace N; class C { static bool M(string? s) { return s == null; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 对照组：整体传递（不解引用）也不算义务点。
[Test]
void test_passing_along_is_not_a_deref() {
    string src = "namespace N; class C { static void Sink(string? t) {} static void M(string? s) { C.Sink(s); } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 值类型不受影响（`int?` 由 E0476 在更早的阶段就拒了）───────────

[Test]
void test_value_type_question_mark_still_e0476() {
    string src = "namespace N; class C { static int M(int? v) { return 0; } }";
    Assert.Equal("E0476", SemanticDump.FirstErrorCode(src));
}

// ── 返回值标记：调用结果可能为 null ────────────────────────────────
//
// 与形参那半的关键差别：**调用结果没有名字可窄化**，所以逃生口是「先存进局部」。

[Test]
void test_nullable_return_deref_errors() {
    string src = "namespace N; class C { static string? F() { return null; }"
        + " static int M() { return C.F().Length; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_nullable_return_via_local_checked_ok() {
    string src = "namespace N; class C { static string? F() { return null; }"
        + " static int M() { string v = C.F(); if (v != null) { return v.Length; } return 0; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 阴性对照：存进局部但**没检查**照样要报——否则「存进局部」就成了免检通行证。
[Test]
void test_nullable_return_via_local_unchecked_errors() {
    string src = "namespace N; class C { static string? F() { return null; }"
        + " static int M() { string v = C.F(); return v.Length; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

// 对照组：返回类型没标 `?` ⇒ 调用结果完全不受检。
[Test]
void test_unmarked_return_is_not_checked() {
    string src = "namespace N; class C { static string F() { return \"x\"; }"
        + " static int M() { return C.F().Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 重新赋一个已知非空的值 ⇒ 义务解除。
[Test]
void test_reassign_clears_obligation() {
    string src = "namespace N; class C { static string? F() { return null; }"
        + " static int M() { string v = C.F(); v = \"x\"; return v.Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ⭐ 回归：**没标 `?` 的局部赋 `null` 不得建立义务**。
// 实施时这里误报过——`z42.net/HttpClient` 的 `TcpClient client = null;`（随后在循环里赋真值）。
// 让 `null` 字面量本身建立事实，等于偷偷开了**悲观档**，而那是设计里明确不做的一档。
[Test]
void test_plain_local_assigned_null_is_not_checked() {
    string src = "namespace N; class C { static int M(bool c) { string v = null;"
        + " if (c) { v = \"x\"; } return v.Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── E0479：可空值不得从未标 `?` 的返回类型漏出去 ───────────────────

[Test]
void test_return_marked_param_from_unmarked_return_errors() {
    string src = "namespace N; class C { static string M(string? s) { return s; } }";
    Assert.Equal("E0479", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_return_nullable_call_from_unmarked_return_errors() {
    string src = "namespace N; class C { static string? F() { return null; }"
        + " static string M() { return C.F(); } }";
    Assert.Equal("E0479", SemanticDump.FirstErrorCode(src));
}

// 修法一：把义务传给调用方。
[Test]
void test_return_marked_param_from_marked_return_ok() {
    string src = "namespace N; class C { static string? M(string? s) { return s; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 修法二：在这里先检查。
[Test]
void test_return_after_narrowing_ok() {
    string src = "namespace N; class C { static string M(string? s) {"
        + " if (s == null) { return \"\"; } return s; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 对照组：`return null;` 字面量**本身不报** —— 那是反向推导（D8）的活，
// 是「建议加 `?`」不是「这里有错」，混进 E0479 会让两件事分不开。
[Test]
void test_bare_null_literal_return_is_not_e0479() {
    string src = "namespace N; class C { static string M() { return null; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 字段 / 属性：强制快照（E0484，design §D4 的规则 (a)）──────────────────
//
// 字段与形参分成两码，是因为**修法不同**：形参就地 `if (s != null)` 就够了，字段不行。
// 字段不是一个「值」，是一个**每次读都重新求值的位置** —— `if (this.F != null) { this.F.M(); }`
// 里的两个 `this.F` 是两次独立的读：别的线程能在中间写；`F` 若是属性还是两次真调用，
// 返回值可以不同。所以字段永不就地窄化，修法是先快照到局部。
//
// ⚠️ 本组的支点是 `test_field_in_place_check_still_errors` —— 它一旦变绿，
// 「强制快照」就塌回了「调用即失效」那一档（Q1 实测里被否掉的那档）。

[Test]
void test_marked_field_deref_errors() {
    string src = "namespace N; class C { string? F; int M() { return this.F.Length; } }";
    Assert.Equal("E0484", SemanticDump.FirstErrorCode(src));
}

// 对照组：不标 `?` 的字段完全不受检（同形参那条支点，存量代码零迁移）。
[Test]
void test_unmarked_field_is_not_checked() {
    string src = "namespace N; class C { string F; int M() { return this.F.Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ⭐ 规则 (a) 的定义性用例：**就地检查不算数**。
[Test]
void test_field_in_place_check_still_errors() {
    string src = "namespace N; class C { string? F; int M() {"
        + " if (this.F != null) { return this.F.Length; } return 0; } }";
    Assert.Equal("E0484", SemanticDump.FirstErrorCode(src));
}

// 唯一的修法：快照到局部，检查那个局部（局部是个值，检查一次就永远成立）。
[Test]
void test_field_snapshot_then_check_ok() {
    string src = "namespace N; class C { string? F; int M() {"
        + " string v = this.F; if (v != null) { return v.Length; } return 0; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 阴性对照：快照了但**没检查**，义务只是转移到局部上，照样要报（E0478 那半接住）。
[Test]
void test_field_snapshot_without_check_errors() {
    string src = "namespace N; class C { string? F; int M() {"
        + " string v = this.F; return v.Length; } }";
    Assert.Equal("E0478", SemanticDump.FirstErrorCode(src));
}

// 标记从**接收者的类型**上查，不是「当前类」——`other.F` 与 `this.F` 走同一条路。
[Test]
void test_marked_field_on_other_object_errors() {
    string src = "namespace N; class C { public string? F; }"
        + " class D { static int M(C c) { return c.F.Length; } }";
    Assert.Equal("E0484", SemanticDump.FirstErrorCode(src));
}

// 属性同理 —— D4 的第一条理由（「会被读两次」）说的正是属性。
[Test]
void test_marked_property_deref_errors() {
    string src = "namespace N; class C { string? P { get; set; } int M() { return this.P.Length; } }";
    Assert.Equal("E0484", SemanticDump.FirstErrorCode(src));
}

// 字段的可空性会经 `return` 漏给**未标 `?`** 的返回类型 → 仍是 E0479 那半的活。
[Test]
void test_return_marked_field_from_unmarked_return_errors() {
    string src = "namespace N; class C { string? F; string M() { return this.F; } }";
    Assert.Equal("E0479", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_return_marked_field_from_marked_return_ok() {
    string src = "namespace N; class C { string? F; string? M() { return this.F; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── D7：override / 接口实现的 `?` 方向一致性（E0489）─────────────────
//
// 规则是**加严可以、放松不行**：
//   返回类型 —— 实现方**去** `?` 允许（承诺更强），**加** `?` 禁止（经基类/接口调用的人没义务查）
//   形参     —— 实现方**加** `?` 允许（自己查得更多），**去** `?` 禁止（契约说「都会查」，它不查）
//
// ⚠️ 这组用例是本半部**唯一**的接通性证据：全仓现有 `?` 标记只有 43 处、D7 真实命中为 0，
// 构建全绿既可能是规则对、也可能是检查根本没跑（同本文件开头记的那条理由）。

// 返回类型：派生**加** `?` 而基类没标 → 洞（经基类调用的人不会查）
[Test]
void test_override_adds_nullable_return_errors() {
    string src = "namespace N; class B { public virtual string M() { return \"x\"; } }\n"
        + "class D : B { public override string? M() { return null; } }";
    Assert.Equal("E0489", SemanticDump.FirstErrorCode(src));
}

// 返回类型：派生**去** `?` —— 承诺更强，合法
[Test]
void test_override_drops_nullable_return_ok() {
    string src = "namespace N; class B { public virtual string? M() { return null; } }\n"
        + "class D : B { public override string M() { return \"x\"; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 形参：基类标 `?`（契约 = 任何实现都会查），派生**去掉** → 洞
[Test]
void test_override_drops_nullable_param_errors() {
    string src = "namespace N; class B { public virtual int M(string? s) { return 0; } }\n"
        + "class D : B { public override int M(string s) { return 1; } }";
    Assert.Equal("E0489", SemanticDump.FirstErrorCode(src));
}

// 形参：基类没标，派生**加** `?` —— 只是对自己更严，合法
[Test]
void test_override_adds_nullable_param_ok() {
    string src = "namespace N; class B { public virtual int M(string s) { return 0; } }\n"
        + "class D : B { public override int M(string? s) { return 1; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 两端一致 —— 无误报守卫
[Test]
void test_override_same_marks_ok() {
    string src = "namespace N; class B { public virtual string? M(string? s) { return null; } }\n"
        + "class D : B { public override string? M(string? s) { return null; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 接口：实现方给返回类型**加** `?` 而接口没标 → 洞
[Test]
void test_iface_impl_adds_nullable_return_errors() {
    string src = "namespace N; interface I { string M(); }\n"
        + "class C : I { public string? M() { return null; } }";
    Assert.Equal("E0489", SemanticDump.FirstErrorCode(src));
}

// 接口：接口形参标 `?`，实现方**去掉** → 洞
[Test]
void test_iface_impl_drops_nullable_param_errors() {
    string src = "namespace N; interface I { int M(string? s); }\n"
        + "class C : I { public int M(string s) { return 0; } }";
    Assert.Equal("E0489", SemanticDump.FirstErrorCode(src));
}

// 接口：实现方**加** `?` 形参 —— 合法（无误报守卫）
[Test]
void test_iface_impl_adds_nullable_param_ok() {
    string src = "namespace N; interface I { int M(string s); }\n"
        + "class C : I { public int M(string? s) { return 0; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── D5：`Expect("理由")` —— 唯一显式逃生口（E0490）─────────────────
//
// 它与 C# 的 `!` 的全部区别在那个参数：`!` 纯编译期擦除，`Expect` 运行期真检查 +
// 把「为什么你认为它非空」留在代码里。⇒ 理由必须是**非空字符串字面量**。

[Test]
void test_expect_clears_param_obligation() {
    string src = "namespace N; class C { static int M(string? s) { return s.Expect(\"caller always passes one\").Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 阴性：没有理由 → E0490（不是「悄悄放行」，也不是退回 E0478）
[Test]
void test_expect_without_reason_errors() {
    string src = "namespace N; class C { static int M(string? s) { return s.Expect().Length; } }";
    Assert.Equal("E0490", SemanticDump.FirstErrorCode(src));
}

// 阴性：理由不是字面量 —— 运行期拼出来的字符串在 review 时读不到，等于没写
[Test]
void test_expect_non_literal_reason_errors() {
    string src = "namespace N; class C { static int M(string? s, string why) { return s.Expect(why).Length; } }";
    Assert.Equal("E0490", SemanticDump.FirstErrorCode(src));
}

// 阴性：空理由 —— `Expect("")` 等于把它还原成 C# 的 `!`，那正是要避开的东西
[Test]
void test_expect_empty_reason_errors() {
    string src = "namespace N; class C { static int M(string? s) { return s.Expect(\"\").Length; } }";
    Assert.Equal("E0490", SemanticDump.FirstErrorCode(src));
}

// 字段那半：`Expect` 同样是逃生口（字段只被读一次，安全）
[Test]
void test_expect_on_marked_field_ok() {
    string src = "namespace N; class C { string? F; int M() { return this.F.Expect(\"filled in ctor\").Length; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 返回值那半：`Expect` 的结果不再可空 ⇒ 可以漏给未标 `?` 的返回类型
[Test]
void test_expect_result_may_return_from_unmarked() {
    string src = "namespace N; class C { static string M(string? s) { return s.Expect(\"checked upstream\"); } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 🛡 无误报守卫一：**真实成员优先**。全仓已有 `TomlParser.Expect(char, string)`，
// intrinsic 抢赢会让它静默改变行为 —— 那是最坏的一类回归，方向是刻意选的。
[Test]
void test_user_declared_expect_member_wins() {
    string src = "namespace N; class P { void Expect(char c, string what) { } "
        + "void Use() { this.Expect('[', \"'['\"); } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 🛡 无误报守卫二：确定赋值（E0407）不受 `Expect` 影响 —— 两件事不同源。
// `Expect` 解除的是**空检查**义务，不是「这个局部赋过值没有」。
[Test]
void test_expect_does_not_mask_definite_assignment() {
    string src = "namespace N; class C { static int M() { string s; return s.Expect(\"nope\").Length; } }";
    Assert.Equal("E0407", SemanticDump.FirstErrorCode(src));
}
