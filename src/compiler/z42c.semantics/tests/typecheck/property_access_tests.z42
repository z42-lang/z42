// 属性访问契约单测（fix-autoprop-getonly-backing-write）。
// 背景：属性以**源名** X 登记 FieldSymbol 供类型检查，存储却是合成后备字段 `__prop_X`。这个落差
// 此前没被下游消费 → 无 setter 的赋值按源名发 field_set（写进不存在的字段）、裸 ident 读发
// field_get 源名（恒 Null）。本文件锁住两条契约：
//   ① 赋值合法性（E0452）：get-only auto-property 仅 ctor 内经 `this` 可写；计算属性任何位置不可写。
//   ② 裸名与 `this.` 前缀同义（运行期行为由 e2e src/tests/classes/auto_property_access.z42 钉住）。
namespace Z42cSemanticsPropertyAccessTests;

using Std;
using Std.Test;
using Z42.Semantics;

// ── get-only auto-property：ctor 内经 this 写，合法 ────────────────
[Test]
void test_getonly_autoprop_write_in_ctor_ok() {
    string src = "namespace D; class C { public string L { get; } public C(string s) { this.L = s; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── get-only auto-property：ctor 内裸名写，同样合法（与 this. 同义）──
[Test]
void test_getonly_autoprop_bare_write_in_ctor_ok() {
    string src = "namespace D; class C { public string L { get; } C(string s) { L = s; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── get-only auto-property：普通方法内写 → E0452 ──────────────────
[Test]
void test_getonly_autoprop_write_in_method_errors() {
    string src = "namespace D; class C { public string L { get; } C() { } void M(string s) { this.L = s; } }";
    Assert.Equal("E0452", SemanticDump.FirstErrorCode(src));
}

// ── get-only auto-property：类外写 → E0452 ───────────────────────
[Test]
void test_getonly_autoprop_write_from_outside_errors() {
    string src = "namespace D; class C { public string L { get; } public C(string s) { this.L = s; } }"
        + " void Main() { var c = new C(\"a\"); c.L = \"b\"; }";
    Assert.Equal("E0452", SemanticDump.FirstErrorCode(src));
}

// ── 计算属性（有 get 体、无存储）：ctor 内也不可写 → E0452 ─────────
[Test]
void test_computed_property_write_in_ctor_errors() {
    string src = "namespace D; class C { public int N { get { return 42; } } C() { this.N = 1; } }";
    Assert.Equal("E0452", SemanticDump.FirstErrorCode(src));
}

// ── 读写 auto-property：处处可写，无诊断（不回归）────────────────
[Test]
void test_readwrite_autoprop_write_anywhere_ok() {
    string src = "namespace D; class C { public int W { get; set; } public C(int w) { this.W = w; } void M() { this.W = 9; } }"
        + " void Main() { var c = new C(1); c.W = 2; }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 读写 auto-property 裸名写：无诊断 ────────────────────────────
[Test]
void test_readwrite_autoprop_bare_write_ok() {
    string src = "namespace D; class C { public int W { get; set; } C(int w) { W = w; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 普通字段不受影响：readonly 仍走 E0415、非 readonly 处处可写 ────
[Test]
void test_plain_field_unaffected() {
    string src = "namespace D; class C { public int F; C() { } void M() { this.F = 1; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_readonly_field_still_e0415() {
    string src = "namespace D; class C { public readonly int F; C() { this.F = 1; } void M() { this.F = 2; } }";
    Assert.Equal("E0415", SemanticDump.FirstErrorCode(src));
}

// ── fix-iface-property-setter：接口 `{ get; set; }` 属性满足性 ─────────────────────────
// 此前 `_fillInterface` 只为接口属性建 get_X ⇒ 接口 setter 契约整段丢失：getter-only 实现静默通过。
// 补 set_X 符号后，满足性校验（InheritanceResolver._checkOneIfaceMethod，MangleKey 含名 ⇒ get_X/set_X
// 独立契约）自动要求实现方补齐 setter。

// 实现补齐 get+set → 无诊断（不回归）。
[Test]
void test_iface_property_getset_impl_complete_ok() {
    string src = "namespace D; interface I { string L { get; set; } } class C : I { public string L { get; set; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 接口要 set 但实现只给 getter → E0412（本 change 新增的强制；修前静默通过）。
[Test]
void test_iface_property_missing_setter_e0412() {
    string src = "namespace D; interface I { string L { get; set; } } class C : I { public string L { get; } }";
    Assert.Equal("E0412", SemanticDump.FirstErrorCode(src));
}

// getter-only 接口属性 → 不要求 setter，getter-only 实现合法（不回归）。
[Test]
void test_iface_property_getonly_no_setter_required_ok() {
    string src = "namespace D; interface I { string L { get; } } class C : I { public string L { get; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 实现用显式 get_N/set_N 方法也满足接口 `{ get; set; }` 契约（与 auto-property 等价）。
[Test]
void test_iface_property_getset_explicit_methods_ok() {
    string src = "namespace D; interface I { int N { get; set; } } class C : I { public int get_N() { return 0; } public void set_N(int v) { } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── add-property-custom-setter：自定义属性 setter `set { ... }` / `set => e;` ─────────────
// 此前 parser 只支持计算 getter + auto setter，`set { ... }` 被当类型报 E0443 级联。

// 两半都带体（计算 get + 自定义 set）→ 无诊断。
[Test]
void test_property_custom_getset_bodied_ok() {
    string src = "namespace D; class C { int _x; public int P { get { return this._x; } set { this._x = value; } } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 表达式体 setter `set => e;` → 无诊断。
[Test]
void test_property_expr_bodied_setter_ok() {
    string src = "namespace D; class C { int _x; public int P { get { return this._x; } set => this._x = value; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 混合 auto get + 带体 set → E0474（本 change 新增禁令）。
[Test]
void test_property_mixed_autoget_bodiedset_e0474() {
    string src = "namespace D; class C { int _x; public int P { get; set { this._x = value; } } }";
    Assert.Equal("E0474", SemanticDump.FirstErrorCode(src));
}

// 混合 带体 get + auto set → E0474（方向相反同样禁）。
[Test]
void test_property_mixed_bodiedget_autoset_e0474() {
    string src = "namespace D; class C { int _x; public int P { get { return this._x; } set; } }";
    Assert.Equal("E0474", SemanticDump.FirstErrorCode(src));
}

// 两半都 auto `{ get; set; }` → 无诊断（不回归）。
[Test]
void test_property_both_auto_no_e0474() {
    string src = "namespace D; class C { public int P { get; set; } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// 自定义 setter 里 `value` 隐式参可用（体内用 value + 1，证 value 已进作用域并有类型）。
[Test]
void test_property_custom_setter_value_in_scope() {
    string src = "namespace D; class C { int _x; public int P { get { return this._x; } set { this._x = value + 1; } } }";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}
