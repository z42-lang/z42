// report-crosspkg-duplicate-type：同一个 **FQN** 被多个包声明 → E0601；本包遮蔽导入 → E0606。
//
// 🔴 **这组用例是这两个码唯一的门**：全仓 657 个 stdlib 类型实测**跨包同 FQN = 0**（本 change
// 写这条诊断时扫过），所以它在真实代码上永远不响。没有本文件，实现对错都恒绿。
// 每条正例都做过退回对照（撤掉 `ImportedSymbolLoader` 的 `ClassPkgAll` 累积后必须变 0 条）。
//
// 🔴 **跨包负例此前没有自动门**——`src/tests/README.md` 白纸黑字记着这个缺口：「跨包 / 多文件的
// 期望报错今天仍靠手工验证 fixture + README 描述步骤，**没有自动门**」。下面的 `dupImports`
// 就是补上的那条原语：用 `IrDump.ExtractExports` 把源码合成 `ExportedModuleZ`（= 一个依赖包的
// 导出面），配上**包名**喂给 `ImportedSymbolLoader.Load`，即可在单测里造出任意跨包形状。
// 它不依赖磁盘上的 .zpkg，故可复用于任何「跨包期望报错」的用例。
namespace Z42cSemanticsCrossPkgDuplicateTests;

using Std;
using Std.Test;
using Z42.Semantics;
using Z42.Syntax;
using Z42.Core;
using Z42.IR;

// ⚠️ 辅助函数一律带 `dup` 前缀：同一测试单元（`typecheck` 工程 `include = ["**/*.z42"]`）里所有
// 文件的自由函数共享一个平坦命名空间，且 z42 自由函数**不按参数类型重载**（见 bare_name 那组的注）。

// 把 N 份源码合成 N 个「依赖包的导出面」。nss[i] / pkgs[i] 与 srcs[i] 平行。
// 同一个包的多个模块 = 多个条目共用同一个 pkgs[i]（用来验「同包不误报」）。
ImportedSymbols dupImports(string[] srcs, string[] nss, string[] pkgs, string[] usings) {
    ExportedModuleZ[] ems = new ExportedModuleZ[srcs.Length];
    int i = 0;
    while (i < srcs.Length) {
        ems[i] = IrDump.ExtractExports(srcs[i], "dep" + i.ToString() + ".z42", nss[i]);
        i = i + 1;
    }
    return ImportedSymbolLoader.Load(ems, pkgs, srcs.Length, usings, usings.Length);
}

// 消费方单 CU 编译（带 imported）→ 全部诊断消息。
string[] dupDiags(string mainSrc, ImportedSymbols imp) {
    string[] srcs = new string[1];  srcs[0] = mainSrc;
    string[] files = new string[1]; files[0] = "main.z42";
    CompiledModuleZ[] cms = IrDump.BuildPackage(srcs, files, 1, null, imp, false);
    string[] all = new string[16];
    int n = 0;
    int i = 0;
    while (i < cms.Length) {
        CompiledModuleZ cm = cms[i];
        int j = 0;
        while (j < cm.DiagCount) {
            if (n == all.Length) {
                string[] bigger = new string[all.Length * 2];
                int z = 0; while (z < n) { bigger[z] = all[z]; z = z + 1; }
                all = bigger;
            }
            all[n] = cm.DiagMsgs[j]; n = n + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    string[] r = new string[n];
    i = 0; while (i < n) { r[i] = all[i]; i = i + 1; }
    return r;
}

int dupCount(string[] msgs, string code) {
    int n = 0;
    int i = 0;
    while (i < msgs.Length) { if (msgs[i].Contains(code)) { n = n + 1; } i = i + 1; }
    return n;
}

// 两个**不同的包**各声明 Demo.Dup.Widget（真·同 FQN）。
ImportedSymbols dupTwoPkgs() {
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Dup;\npublic class Widget { public int A() { return 1; } }";
    srcs[1] = "namespace Demo.Dup;\npublic class Widget { public int B() { return 2; } }";
    string[] nss  = new string[2]; nss[0] = "Demo.Dup";     nss[1] = "Demo.Dup";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha";  pkgs[1] = "demo.beta";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    return dupImports(srcs, nss, pkgs, us);
}

// ── 正例 ──────────────────────────────────────────────────────────────────────

[Test]
void crosspkg_duplicate_reports_at_use_site() {
    // 使用位（`new Widget()`）。退回对照：撤掉 ClassPkgAll 累积 → 0 条。
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { public int go() { var w = new Widget(); return 0; } }",
                          dupTwoPkgs());
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void crosspkg_duplicate_reports_at_declaration_site() {
    // 声明位（字段类型）——与 E0456 的声明位补齐（#562）同一组落点。
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { Widget w; }", dupTwoPkgs());
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void crosspkg_duplicate_reports_on_qualified_name_too() {
    // 🔴 与 E0456 的关键差别：限定写法**不能**消歧 —— 重复的是 FQN 本身。
    // 若谁把这条按 E0456 的写法加一句「限定名 = 已消歧」的早返回，本条立刻变红。
    string[] d = dupDiags("namespace App;\nclass C { Demo.Dup.Widget w; }", dupTwoPkgs());
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void local_type_shadowing_import_errors() {
    // 本包声明 Demo.Dup.Widget，另有**一个**依赖包也声明它 → E0606。
    // 🔴 曾写成 warning，理由是「本地恒赢是既定规则、不是猜」——**那个理由是错的**：规则明确
    // ≠ 结果可接受。被遮蔽那份根本指不了，失败形态与 E0601 一样（去调它才有的成员 → 「no method
    // X on Widget」答非所问）。且冲突的两份里有一份是本包自己写的 ⇒ 改名随时可以 ⇒ error 可行动。
    string[] srcs = new string[1];
    srcs[0] = "namespace Demo.Dup;\npublic class Widget { public int A() { return 1; } }";
    string[] nss  = new string[1]; nss[0] = "Demo.Dup";
    string[] pkgs = new string[1]; pkgs[0] = "demo.alpha";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] d = dupDiags("namespace Demo.Dup;\nclass Widget { public int L() { return 9; } }\nclass C { Widget w; }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(true, dupCount(d, "E0606") >= 1);
    Assert.Equal(0, dupCount(d, "E0601"));   // 只有一个导入来源 → 不是「多包互撞」，归 E0606
}

[Test]
void local_interface_shadowing_import_errors() {
    // 接口这半边必须与类对称：E0601 经 `PkgCheckFqn` 本就覆盖接口，若 E0606 只查 `ClassesByFqn`，
    // 「本地接口遮蔽导入接口」会单独哑掉。退回对照：把 ShadowedImportMsg 的 InterfacesByFqn 分支
    // 撤掉 → 本条变红、上面那条类的照绿（正是不对称哑门的形状）。
    string[] srcs = new string[1];
    srcs[0] = "namespace Demo.Dup;\npublic interface IThing { int Tag(); }";
    string[] nss  = new string[1]; nss[0] = "Demo.Dup";
    string[] pkgs = new string[1]; pkgs[0] = "demo.alpha";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] d = dupDiags("namespace Demo.Dup;\npublic interface IThing { int Tag(); }\nclass C { IThing t; }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(true, dupCount(d, "E0606") >= 1);
}

// ── report-crosspkg-duplicate-function：自由函数 / 静态调用位 ──────────────────────
//
// 🔴 自由函数比类更糊：`ImportedSymbols.Functions` 的键是**裸名**（`ExportedFuncZ.Name` 就是
// `md.Name`，从来没有 ns 前缀），连 FQN 视图都没有 ⇒ 同名者无论同不同 ns 都撞同一个键、
// first-wins，且**没有任何写法能指到输的那份**（自由函数只有裸名一种调用形态）。
// 实测修前：两个包各声明 `Demo.Dup.helper` → 编译零诊断、字母序靠前的赢；分居两 ns 且都
// `using` 了也一样静默选一份；连运行期都不会 warn（输的那个包因惰性加载压根没被载入）。

// 多 CU 消费方 + imported（自由函数用例要两个 CU：一个声明本包那份、一个 using 后调用）。
string[] dupDiags2(string[] srcs, string[] files, ImportedSymbols imp) {
    CompiledModuleZ[] cms = IrDump.BuildPackage(srcs, files, srcs.Length, null, imp, false);
    string[] all = new string[16];
    int n = 0;
    int i = 0;
    while (i < cms.Length) {
        CompiledModuleZ cm = cms[i];
        int j = 0;
        while (j < cm.DiagCount) {
            if (n == all.Length) {
                string[] bigger = new string[all.Length * 2];
                int z = 0; while (z < n) { bigger[z] = all[z]; z = z + 1; }
                all = bigger;
            }
            all[n] = cm.DiagMsgs[j]; n = n + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    string[] r = new string[n];
    i = 0; while (i < n) { r[i] = all[i]; i = i + 1; }
    return r;
}

// 两个包在**同一个 ns** 各声明一个同名自由函数。
ImportedSymbols dupTwoPkgFuncs() {
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Dup;\npublic int helper() { return 1; }";
    srcs[1] = "namespace Demo.Dup;\npublic int helper() { return 2; }";
    string[] nss  = new string[2]; nss[0] = "Demo.Dup";     nss[1] = "Demo.Dup";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha";  pkgs[1] = "demo.beta";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    return dupImports(srcs, nss, pkgs, us);
}

[Test]
void crosspkg_duplicate_free_function_errors() {
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { public int go() { return helper(); } }",
                          dupTwoPkgFuncs());
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void same_bare_free_function_in_two_visible_namespaces_is_ambiguous() {
    // 分居两个 ns、两个都 using → 裸名歧义（E0456，与类那侧同码同口径）。
    // 这条是类那侧**没有对应物**的形状：类有 ClassesByFqn 兜底，自由函数没有。
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Alpha;\npublic int helper() { return 1; }";
    srcs[1] = "namespace Demo.Beta;\npublic int helper() { return 2; }";
    string[] nss  = new string[2]; nss[0] = "Demo.Alpha";  nss[1] = "Demo.Beta";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha"; pkgs[1] = "demo.beta";
    string[] us   = new string[2]; us[0] = "Demo.Alpha";   us[1] = "Demo.Beta";
    string[] d = dupDiags("namespace App;\nusing Demo.Alpha;\nusing Demo.Beta;\nclass C { public int go() { return helper(); } }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(true, dupCount(d, "E0456") >= 1);
}

[Test]
void local_free_function_shadowing_import_errors() {
    // 本包在共享 ns 里也声明了同名自由函数 → E0606（被遮那份指不了）。
    // 两个 CU：一个声明本包那份，一个 using 后调用 —— 单 CU 造不出这个形状。
    string[] srcs = new string[1];
    srcs[0] = "namespace Demo.Dup;\npublic int helper() { return 1; }";
    string[] nss  = new string[1]; nss[0] = "Demo.Dup";
    string[] pkgs = new string[1]; pkgs[0] = "demo.alpha";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] csrcs = new string[2];
    csrcs[0] = "namespace Demo.Dup;\npublic int helper() { return 9; }";
    csrcs[1] = "namespace App;\nusing Demo.Dup;\nclass C { public int go() { return helper(); } }";
    string[] files = new string[2]; files[0] = "local.z42"; files[1] = "main.z42";
    string[] d = dupDiags2(csrcs, files, dupImports(srcs, nss, pkgs, us));
    Assert.Equal(true, dupCount(d, "E0606") >= 1);
}

[Test]
void static_call_on_duplicated_type_errors() {
    // 🔴 这是 report-crosspkg-duplicate-type 的**覆盖漏洞**：E0601/E0606 挂在 `_chkTypeRef` 上，
    // 而**静态调用不走它** —— `Util.go()` 里的 `Util` 只经 `GetClass` 取类。实测修前零诊断。
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Dup;\npublic static class Util { public static int go() { return 1; } }";
    srcs[1] = "namespace Demo.Dup;\npublic static class Util { public static int go() { return 2; } }";
    string[] nss  = new string[2]; nss[0] = "Demo.Dup";     nss[1] = "Demo.Dup";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha";  pkgs[1] = "demo.beta";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { public int go() { return Util.go(); } }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void free_function_from_one_package_is_not_duplicate() {
    // 负例：只有一个来源 → 不报（最常见的正常情形，误报这条等于全仓皆红）。
    string[] srcs = new string[1];
    srcs[0] = "namespace Demo.Dup;\npublic int helper() { return 1; }";
    string[] nss  = new string[1]; nss[0] = "Demo.Dup";
    string[] pkgs = new string[1]; pkgs[0] = "demo.alpha";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { public int go() { return helper(); } }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(0, dupCount(d, "E0601"));
    Assert.Equal(0, dupCount(d, "E0606"));
    Assert.Equal(0, dupCount(d, "E0456"));
}

[Test]
void free_function_in_invisible_namespace_is_not_ambiguous() {
    // 负例：两份分居两 ns，但消费方只 using 了其中一个 ⇒ 另一个不可见 ⇒ 不歧义。
    // 判据若漏掉可见性过滤，这条立刻变红（而真实工程里「同名但我没 using」极常见）。
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Alpha;\npublic int helper() { return 1; }";
    srcs[1] = "namespace Demo.Beta;\npublic int helper() { return 2; }";
    string[] nss  = new string[2]; nss[0] = "Demo.Alpha";  nss[1] = "Demo.Beta";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha"; pkgs[1] = "demo.beta";
    string[] us   = new string[2]; us[0] = "Demo.Alpha";   us[1] = "Demo.Beta";
    string[] d = dupDiags("namespace App;\nusing Demo.Alpha;\nclass C { public int go() { return helper(); } }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(0, dupCount(d, "E0456"));
    Assert.Equal(0, dupCount(d, "E0601"));
}

// ── harden-crosspkg-gates：把「引用形态」的覆盖面补齐 ─────────────────────────────
//
// E0601/E0606 挂在 `_chkTypeRef` 上，而那条路只覆盖 new / 局部变量 / 类型实参 / 模式 / catch。
// 逐形态实测后发现两条还漏着（都零诊断）：**ns 限定的静态调用**（走独立的 qualified 分支）
// 与**静态成员读**（`Cfg.N`，走 BoundStaticGet 那条，压根不是「调用」）。
//
// ⚠️ 量这张覆盖表时我的探针骗过我一次：它只 grep E0601/E0606/E0456，于是把
// `E0401`（`Demo.Ns.Cfg.N` 这种写法本就不受支持）显示成「零诊断」，害我以为还有第三个洞。
// **判定「有没有报」要抓任何诊断码，不能只抓自己关心的那几个。**

[Test]
void ns_qualified_static_call_on_duplicated_type_errors() {
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Dup;\npublic static class Util { public static int go() { return 1; } }";
    srcs[1] = "namespace Demo.Dup;\npublic static class Util { public static int go() { return 2; } }";
    string[] nss  = new string[2]; nss[0] = "Demo.Dup";     nss[1] = "Demo.Dup";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha";  pkgs[1] = "demo.beta";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { public int go() { return Demo.Dup.Util.go(); } }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void static_field_read_on_duplicated_type_errors() {
    // 静态成员**读**不是调用，走 BoundStaticGet 那条独立路径 —— 此前零诊断，而它读到的是
    // 哪个包的那份完全是撞出来的。
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Dup;\npublic static class Cfg { public static int N = 1; }";
    srcs[1] = "namespace Demo.Dup;\npublic static class Cfg { public static int N = 2; }";
    string[] nss  = new string[2]; nss[0] = "Demo.Dup";     nss[1] = "Demo.Dup";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha";  pkgs[1] = "demo.beta";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { public int go() { return Cfg.N; } }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void static_member_on_unique_type_is_not_duplicate() {
    // 负例：只有一个来源的静态成员读 —— 新加的两处检查若判据写错，全仓静态成员访问都会假红。
    string[] srcs = new string[1];
    srcs[0] = "namespace Demo.Dup;\npublic static class Cfg { public static int N = 1; }";
    string[] nss  = new string[1]; nss[0] = "Demo.Dup";
    string[] pkgs = new string[1]; pkgs[0] = "demo.alpha";
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { public int go() { return Cfg.N; } }",
                          dupImports(srcs, nss, pkgs, us));
    Assert.Equal(0, dupCount(d, "E0601"));
    Assert.Equal(0, dupCount(d, "E0606"));
}

// ── enum：本族里唯一「静默错**值**」的形态 ────────────────────────────────────────
//
// 同名 enum 在两个包里**成员顺序可以不同**（`{Red,Green}` vs `{Green,Red}`），而
// `EnumConsts` 是**裸键**（`Enum.Member`）⇒ first-wins ⇒ `Color.Green` 静默折成另一个包的
// 那个**整数值**（实测 1 vs 0）。其它形态错的是「绑到哪一份」，这条错的是「算出什么数」。
//
// 两个洞是分开的、修法也不同：
//   · **类型注解位**（`Color c;`）——根因是 `_mergeImportedEnums` **从不并 `EnumTypeNs`** ⇒
//     导入 enum 的 `Z42ClassType.Enum(name)` 恒 Namespace=""、`Fqn()` 退化成裸名，与
//     `ClassPkgAll` 的 `ns.Name` 对不上。补上那张表，既有的 `_chkTypeRefPkg` 自然点亮，**无需新检查**。
//   · **常量读**（`Color.Green`）——它绑成 `BoundLitInt`，压根不经任何类型引用检查 ⇒ 必须在
//     那条分支上单独判（`ChkEnumOrigins`）。

// 🔴 **enum 不能用 `dupImports` 造**：`ExportedTypeExtractor.Extract` **从不抽取源码里的 enum**
// （那一行硬编码 `BuiltinTypeDefs._builtinEnums()`）—— 真实跨包 enum 是 `TsigReconcile` 从 zbc 的
// TYPE 段重建的。我第一版照搬 `dupImports` 写这两条用例，结果**用例红、而真实三包 e2e 是绿的**，
// 差点回头去"修"一个并不存在的实现问题。故此处**手工构造** `ExportedEnumZ` 直连 loader；
// 真实 TSIG 那条路由 e2e fixture `cross-zpkg/dup_enum_crosspkg` 守着。
ImportedSymbols dupEnumImports(int pkgCount) {
    ExportedModuleZ[] ems = new ExportedModuleZ[pkgCount];
    string[] pkgs = new string[pkgCount];
    int k = 0;
    while (k < pkgCount) {
        // 成员顺序**故意相反** —— 这正是「静默错值」的来源（Green 一边 1、一边 0）
        ExportedEnumMemberZ[] mem = new ExportedEnumMemberZ[2];
        if (k == 0) { mem[0] = new ExportedEnumMemberZ("Red", 0); mem[1] = new ExportedEnumMemberZ("Green", 1); }
        else        { mem[0] = new ExportedEnumMemberZ("Green", 0); mem[1] = new ExportedEnumMemberZ("Red", 1); }
        ExportedEnumZ[] ens = new ExportedEnumZ[1];
        ens[0] = new ExportedEnumZ("Color", mem, 2);
        ems[k] = new ExportedModuleZ("Demo.Dup",
            new ExportedClassZ[0], 0,
            new ExportedInterfaceZ[0], 0,
            ens, 1,
            new ExportedFuncZ[0], 0,
            new ExportedDelegateZ[0], 0);
        pkgs[k] = k == 0 ? "demo.alpha" : "demo.beta";
        k = k + 1;
    }
    string[] us = new string[1]; us[0] = "Demo.Dup";
    return ImportedSymbolLoader.Load(ems, pkgs, pkgCount, us, 1);
}

[Test]
void duplicated_enum_constant_read_errors() {
    // 本族里唯一「静默错**值**」的形态：EnumConsts 是裸键（`Enum.Member`）⇒ first-wins，
    // 而两包成员顺序可不同 ⇒ `Color.Green` 静默折成另一个包的那个整数。
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { public int go() { return (int)Color.Green; } }",
                          dupEnumImports(2));
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void duplicated_enum_type_annotation_errors() {
    // 退回对照：撤掉 `_mergeImportedEnums` 里并 `EnumTypeNs` 那段 → 本条变绿（= 修前的静默）。
    // 根因就是那张表没并：导入 enum 的 Namespace 恒空 ⇒ Fqn() 退化成裸名 ⇒ 与 ClassPkgAll 对不上。
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { Color c; }", dupEnumImports(2));
    Assert.Equal(true, dupCount(d, "E0601") >= 1);
}

[Test]
void enum_from_one_package_is_not_duplicate() {
    // 负例：单一来源的 enum —— 判据写错的话，全仓每一次 enum 常量读都会假红。
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { Color c; public int go() { return (int)Color.Green; } }",
                          dupEnumImports(1));
    Assert.Equal(0, dupCount(d, "E0601"));
    Assert.Equal(0, dupCount(d, "E0606"));
}
// ── 负例（必须不报；每条都是一个真实的误报风险）────────────────────────────────

[Test]
void same_short_name_in_different_namespaces_is_not_duplicate() {
    // 同短名、不同 ns ⇒ FQN 不同 ⇒ 不是重复（那归 E0456 管）。误报这条会把
    // `type_identity_fqn` 那种完全合法的跨包布局判死。
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Alpha;\npublic class Widget { public int A() { return 1; } }";
    srcs[1] = "namespace Demo.Beta;\npublic class Widget { public int B() { return 2; } }";
    string[] nss  = new string[2]; nss[0] = "Demo.Alpha";  nss[1] = "Demo.Beta";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha"; pkgs[1] = "demo.beta";
    string[] us   = new string[1]; us[0] = "Demo.Alpha";
    string[] d = dupDiags("namespace App;\nusing Demo.Alpha;\nclass C { Widget w; }", dupImports(srcs, nss, pkgs, us));
    Assert.Equal(0, dupCount(d, "E0601"));
}

[Test]
void same_fqn_from_one_package_is_not_duplicate() {
    // 同一个包的**两个模块**（真实形态：partial 类拆两个文件）⇒ 来源包只有一个 ⇒ 不报。
    // 包内重复由 E0458 在**生产方**管，消费方不该跟着报第二遍。
    string[] srcs = new string[2];
    srcs[0] = "namespace Demo.Dup;\npublic class Widget { public int A() { return 1; } }";
    srcs[1] = "namespace Demo.Dup;\npublic class Other { public int B() { return 2; } }";
    string[] nss  = new string[2]; nss[0] = "Demo.Dup";    nss[1] = "Demo.Dup";
    string[] pkgs = new string[2]; pkgs[0] = "demo.alpha"; pkgs[1] = "demo.alpha";   // 同一个包
    string[] us   = new string[1]; us[0] = "Demo.Dup";
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { Widget w; }", dupImports(srcs, nss, pkgs, us));
    Assert.Equal(0, dupCount(d, "E0601"));
}

[Test]
void unreferenced_duplicate_is_silent() {
    // 使用位语义（对标 C# CS0433）：两个依赖包撞了、但本包**一行都没引用**它 → 不报。
    // 否则下游用户会被两个第三方依赖的冲突挡死，而他既没用到也修不了。
    string[] d = dupDiags("namespace App;\nusing Demo.Dup;\nclass C { int n; }", dupTwoPkgs());
    Assert.Equal(0, dupCount(d, "E0601"));
    Assert.Equal(0, dupCount(d, "E0606"));
}
