// 泛型 `where` 约束的校验单测（complete-where-constraints）。
//
// 为什么这个文件必须存在：`where T : IFoo` 长期「写了等于没写」——不报错也不校验，比不支持
// 更糟（不支持会报错，假实现让使用者以为拿到了类型保护）。根因之一是**没有任何门盯着它**：
// 负例语料原在 `src/tests/errors/`，2026-05-12 搬进 C# 测试项目 `z42.Tests/Fixtures/`，
// 2026-06-26 C# 编译器移除时随之蒸发。自举迁移只搬了「能编过」的正例。
//
// 载体沿用既有机制（`SemanticDump` + `[Test]`，由 `xtask test compiler` stage 驱动），
// 不另造第二套：`ConstraintChecker` 与 `TypeChecker` 共用同一个 `DiagnosticBag`
// （TypeChecker.z42 构造 + 驱动 Resolve；校验落在 ConstructTyper 的 `new` 点与
// MemberResolver 的显式型参调用点），故约束诊断对 `SemanticDump` 天然可见。
//
// 断言口径：`FirstErrorCode` 返回**首条诊断**的码（不分 error/warning），空串 = 一条诊断都没有。
// 故「满足约束」的正例断言 `""`，比只断言 ErrorCount==0 更严——后者看不见 warning。
namespace Z42cSemanticsConstraintTests;

using Std;
using Std.Test;
using Z42.Semantics;

// ── 接口约束：非泛型接口 ────────────────────────────────────────────────────

[Test]
void test_interface_constraint_satisfied_reports_nothing() {
    string src = "interface IFoo { }\n"
        + "class C : IFoo { }\n"
        + "class Box<T> where T : IFoo { }\n"
        + "class Use { void f() { var b = new Box<C>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_interface_constraint_violated_is_reported() {
    // D 不实现 IFoo。此前**静默通过**——本用例就是那条静默的门。
    string src = "interface IFoo { }\n"
        + "class D { }\n"
        + "class Box<T> where T : IFoo { }\n"
        + "class Use { void f() { var b = new Box<D>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

// ── 泛型接口约束：ArgCount 过滤曾把这一整类丢弃 ─────────────────────────────

[Test]
void test_generic_interface_constraint_satisfied() {
    // 全仓真实约束绝大多数长这样（IEquatable<T> / IComparable<T> / INumber<T>）。
    // `_fillBundle` 此前的 `nt.ArgCount == 0` 条件在接口判定**之前**就整条丢弃它们，
    // 这才是接口约束全体静默的直接原因。
    string src = "interface IEq<T> { }\n"
        + "class F : IEq<F> { }\n"
        + "class Bag<T> where T : IEq<T> { }\n"
        + "class Use { void f() { var b = new Bag<F>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_generic_interface_constraint_violated_is_reported() {
    string src = "interface IEq<T> { }\n"
        + "class G { }\n"
        + "class Bag<T> where T : IEq<T> { }\n"
        + "class Use { void f() { var b = new Bag<G>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

// ── 接口继承闭包：`class C : IDerived` 满足 `where T : IBase` ────────────────

[Test]
void test_inherited_interface_satisfies_base_interface_constraint() {
    // 符号表此前**根本不记接口继承**（传递闭包只在 IR 发射期由 ClassDescBuilder._expandIfaces
    // 算），`Implements("E","IB")` 返回 false → 误报。Z42InterfaceType.BaseNames + Implements
    // 走 BFS 后应满足。
    string src = "interface IB { }\n"
        + "interface ID : IB { }\n"
        + "class E : ID { }\n"
        + "class Box<T> where T : IB { }\n"
        + "class Use { void f() { var b = new Box<E>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_two_level_interface_inheritance_closure() {
    // 三层：IC : IB : IA，class 只声明 IC → 仍应满足 `where T : IA`。
    string src = "interface IA { }\n"
        + "interface IB : IA { }\n"
        + "interface IC : IB { }\n"
        + "class H : IC { }\n"
        + "class Box<T> where T : IA { }\n"
        + "class Use { void f() { var b = new Box<H>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_unrelated_interface_still_violates() {
    // 闭包不能过度放宽：J 实现 IC（→IB→IA），但约束要 IZ，仍须报。
    string src = "interface IA { }\n"
        + "interface IB : IA { }\n"
        + "interface IC : IB { }\n"
        + "interface IZ { }\n"
        + "class J : IC { }\n"
        + "class Box<T> where T : IZ { }\n"
        + "class Use { void f() { var b = new Box<J>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

// ── 基类链上的接口 ──────────────────────────────────────────────────────────

[Test]
void test_interface_from_base_class_satisfies() {
    string src = "interface IFoo { }\n"
        + "class Base : IFoo { }\n"
        + "class Derived : Base { }\n"
        + "class Box<T> where T : IFoo { }\n"
        + "class Use { void f() { var b = new Box<Derived>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 泛型类内部转发：型参作实参时不得误报 ────────────────────────────────────

[Test]
void test_type_param_forwarded_as_arg_is_not_reported() {
    // `Outer<T>` 内部 `new Box<T>()`——此处 T 未解析，无从判定；它的约束由 Outer 自己的
    // 实例化点校验。若这里报错，每个泛型类的内部转发都会误报。
    string src = "interface IFoo { }\n"
        + "class Box<T> where T : IFoo { }\n"
        + "class Outer<T> where T : IFoo { void f() { var b = new Box<T>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 多接口约束：`where T : IFoo + IBar`（z42 用 + 分隔） ────────────────────

[Test]
void test_multiple_interface_constraints_all_checked() {
    string src = "interface IFoo { }\n"
        + "interface IBar { }\n"
        + "class OnlyFoo : IFoo { }\n"
        + "class Box<T> where T : IFoo + IBar { }\n"
        + "class Use { void f() { var b = new Box<OnlyFoo>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_multiple_interface_constraints_satisfied() {
    string src = "interface IFoo { }\n"
        + "interface IBar { }\n"
        + "class Both : IFoo, IBar { }\n"
        + "class Box<T> where T : IFoo + IBar { }\n"
        + "class Use { void f() { var b = new Box<Both>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 方法级 where（显式写类型实参才校验，见 Deferred inferred-method-args） ──

[Test]
void test_method_level_interface_constraint_violated() {
    string src = "interface IFoo { }\n"
        + "class K { }\n"
        + "class Use {\n"
        + "    void g<T>(T x) where T : IFoo { }\n"
        + "    void f() { K k = new K(); this.g<K>(k); }\n"
        + "}\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_method_level_interface_constraint_satisfied() {
    string src = "interface IFoo { }\n"
        + "class L : IFoo { }\n"
        + "class Use {\n"
        + "    void g<T>(T x) where T : IFoo { }\n"
        + "    void f() { L l = new L(); this.g<L>(l); }\n"
        + "}\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── `where T : enum`（PR-2） ────────────────────────────────────────────────
//
// parser 此前**没有** enum 特判：`enum` 落进 `_parseType()` 兜底变成 `NamedType("enum")`，
// 语义层查不到同名类/接口 → 整条静默丢弃。

[Test]
void test_enum_constraint_satisfied() {
    string src = "enum Color { Red, Green }\n"
        + "class Box<T> where T : enum { }\n"
        + "class Use { void f() { var b = new Box<Color>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_enum_constraint_violated_by_class() {
    string src = "class NotAnEnum { }\n"
        + "class Box<T> where T : enum { }\n"
        + "class Use { void f() { var b = new Box<NotAnEnum>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_enum_constraint_violated_by_primitive() {
    // 基元不是 enum（运行期判据 td.is_enum()，int 不满足）。
    string src = "class Box<T> where T : enum { }\n"
        + "class Use { void f() { var b = new Box<int>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

// ── `where T : new()`（PR-2） ───────────────────────────────────────────────
//
// 语义照抄运行期 generics.rs：基元满足；类须非 abstract 且有可零实参调用的 ctor；
// **完全没有显式 ctor = 默认构造 = 满足**。

[Test]
void test_new_constraint_no_explicit_ctor_satisfies() {
    // 一个 ctor 都没声明 → 默认构造 → 满足（这条最容易被写反）。
    string src = "class Plain { }\n"
        + "class Box<T> where T : new() { }\n"
        + "class Use { void f() { var b = new Box<Plain>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_new_constraint_explicit_noarg_ctor_satisfies() {
    string src = "class HasNoArg { public HasNoArg() { } }\n"
        + "class Box<T> where T : new() { }\n"
        + "class Use { void f() { var b = new Box<HasNoArg>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_new_constraint_only_arg_ctor_violates() {
    // 声明了 ctor 但没有一个能零实参调用 → 不满足。
    string src = "class NeedsArg { public NeedsArg(int x) { } }\n"
        + "class Box<T> where T : new() { }\n"
        + "class Use { void f() { var b = new Box<NeedsArg>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_new_constraint_all_default_params_satisfies() {
    // 形参全带默认值 → 可零实参调用 → 满足（复用 ConstructTyper 的同款判据）。
    string src = "class AllDefault { public AllDefault(int x = 1) { } }\n"
        + "class Box<T> where T : new() { }\n"
        + "class Use { void f() { var b = new Box<AllDefault>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_new_constraint_primitive_satisfies() {
    string src = "class Box<T> where T : new() { }\n"
        + "class Use { void f() { var b = new Box<int>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 组合：多个 special 同时生效 ─────────────────────────────────────────────

[Test]
void test_struct_and_new_combined() {
    string src = "class Ref { }\n"
        + "class Box<T> where T : struct + new() { }\n"
        + "class Use { void f() { var b = new Box<Ref>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

// ── 诊断质量（PR-4） ────────────────────────────────────────────────────────

[Test]
void test_misspelled_constraint_name_reports_E0443() {
    // 拼错约束名此前**完全静默**——写错名字等于没写约束，而使用者以为约束生效了。
    string src = "interface IFoo { }\n"
        + "class Box<T> where T : IFooo { }\n";
    Assert.Equal("E0443", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_where_on_unknown_type_param_reports() {
    string src = "interface IFoo { }\n"
        + "class Box<T> where U : IFoo { }\n";
    Assert.Equal("E0401", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_and_struct_conflict_reports() {
    string src = "class Box<T> where T : class + struct { }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_constraint_diagnostic_carries_real_span() {
    // 此前全程 _noSpan() → 诊断恒指向 `<sem> 0:0`，使用者拿到一条不知道看哪行的错误。
    // 约束声明在第 2 行 → Span 的行号必须是 2，不能是 0/1。
    string src = "interface IFoo { }\n"
        + "class Box<T> where T : IFooo { }\n";
    Assert.Equal("2", SemanticDump.FirstErrorPos(src).Split(":")[0]);
}

[Test]
void test_violation_span_points_at_instantiation_site() {
    // 违反约束的诊断应指向**实例化点**（第 4 行的 `new Box<D>()`），而非声明处。
    string src = "interface IFoo { }\n"
        + "class D { }\n"
        + "class Box<T> where T : IFoo { }\n"
        + "class Use { void f() { var b = new Box<D>(); } }\n";
    Assert.Equal("4", SemanticDump.FirstErrorPos(src).Split(":")[0]);
}

// ── 接口声明上的 where：此前整条不进约束模型（add-associated-types PR-1）──────────
//
// `ConstraintChecker.Resolve` 的条件曾是 `Kind == "class" || "struct"`，于是
// `interface INumber<T> where T : INumber<T>` 这类声明的 where **完全静默**：
// 型参写错、约束名拼错、class+struct 互斥，一律不报。下面三条就是那三处静默的门。

[Test]
void test_interface_where_unknown_type_param_reports() {
    string src = "interface IFoo { }\n"
        + "interface IBox<T> where U : IFoo { }\n";
    Assert.Equal("E0401", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_interface_where_unknown_constraint_name_reports() {
    string src = "interface IBox<T> where T : IShoww { }\n";
    Assert.Equal("E0443", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_interface_where_class_struct_conflict_reports() {
    string src = "interface IBox<T> where T : class + struct { }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_interface_where_satisfiable_reports_nothing() {
    // 放宽到接口后不得引入误报：合法的接口 where（含 F-bounded 自引用，全仓 INumber 的形态）应零诊断。
    string src = "interface IEq<T> { }\n"
        + "interface IBox<T> where T : IEq<T> { }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

// ── 约束键：同短名多 arity 不得串味（SymbolTable.ConstraintKey）────────────────
//
// `ClassConstraints` 的键此前恒裸名，而 `Classes` 是条件 arity-mangle（`Name$N`）。
// 同短名多 arity 的泛型类因此在约束表里 **last-wins 互相覆盖**——`Foo<T>` 的实例化
// 会被拿去校验 `Foo<T,U>` 的约束。三处（写入/查询/导入）统一走 ConstraintKey 后消失。

[Test]
void test_same_name_different_arity_constraints_do_not_bleed() {
    // Foo<T,U> 只要求 T : class（D 满足）；Foo<T> 要求 T : IFoo（D 不满足）。
    // `new Foo<D, D>()` 应当零诊断。
    //
    // ⚠️ 声明序是这条用例的**关键**，不要「顺手」调换：修前两者共用裸名键 "Foo"，last-wins ⇒
    // 后声明的 Foo<T> 的 {T:IFoo} 覆盖赢家，`new Foo<D,D>()` 会被拿去比 IFoo → 凭空 E0402。
    // 若把 Foo<T> 写在前面，赢家变成 {T:class}，这条用例修前修后都绿 —— 就成了空测试。
    string src = "interface IFoo { }\n"
        + "class D { }\n"
        + "class Foo<T, U> where T : class { }\n"
        + "class Foo<T> where T : IFoo { }\n"
        + "class Use { void f() { var b = new Foo<D, D>(); } }\n";
    Assert.Equal("", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_same_name_different_arity_still_reports_real_violation() {
    // 与上一条对偶：一元的那个仍须报错，证明键分离不是把校验整个关掉了。
    string src = "interface IFoo { }\n"
        + "class D { }\n"
        + "class Foo<T> where T : IFoo { }\n"
        + "class Foo<T, U> where T : class { }\n"
        + "class Use { void f() { var b = new Foo<D>(); } }\n";
    Assert.Equal("E0402", SemanticDump.FirstErrorCode(src));
}
