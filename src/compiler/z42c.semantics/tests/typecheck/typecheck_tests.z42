// z42c.semantics TypeChecker 单测（1A-4b）：源 → bound s-expr（含类型注解）+ 错误用例诊断计数。
namespace Z42cSemanticsTypeCheckTests;

using Std;
using Std.Test;
using Z42.Semantics;

[Test]
void test_bind_var_infer_and_return() {
    // var 推断 + 标识符解析 + return 类型检查
    string src = "class C { int Get() { var x = 5; return x; } }";
    Assert.Equal("(block (decl x :int (lit-int 5 :int)) (return (ident x :int)))",
                 SemanticDump.DumpBody(src, "C.Get"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_explicit_type_and_assign() {
    string src = "class C { void M() { int n = 3; n = 7; } }";
    Assert.Equal("(block (decl n :int (lit-int 3 :int)) (expr (assign (ident n :int) (lit-int 7 :int) :int)))",
                 SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_field_in_scope() {
    // 实例方法可见字段（this 上下文）
    string src = "class Box { int value; int Get() { return value; } }";
    Assert.Equal("(block (return (ident value :int)))", SemanticDump.DumpBody(src, "Box.Get"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_free_func_call() {
    string src = "int Helper() { return 1; } int Main() { return Helper(); }";
    Assert.Equal("(block (return (call Helper :int)))", SemanticDump.DumpBody(src, "Main"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_error_return_type_mismatch() {
    string src = "class C { int Bad() { return \"hi\"; } }";   // string 不可赋给 int
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    // 诊断指向表达式（"hi" 在 1:30）——span 链验证（add-z42c-source-spans）
    Assert.Equal("1:30", SemanticDump.FirstErrorPos(src));
}

[Test]
void test_error_undefined_ident() {
    string src = "class C { int M() { return missing; } }";   // 未定义标识符（error 吸收，仅 1 条）
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_error_undefined_func() {
    string src = "class C { int M() { return Nope(); } }";    // 未声明函数
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

// ── target-typed new（add-target-typed-new）：目标类型可推断则成功，否则 E0437 ──

[Test]
void test_target_typed_new_var_ok() {
    // A a = new()：目标 = 声明类型 A → 绑成 (new C)，无错
    string src = "class C { } class D { void M() { C c = new(); } }";
    Assert.Equal("(block (decl c :C (new C :C)))", SemanticDump.DumpBody(src, "D.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_target_typed_new_var_needs_type() {
    // var a = new()：目标类型不可推断 → E0437
    string src = "class C { } class D { void M() { var x = new(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0437", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_target_typed_new_overload_ambiguous() {
    // F(new())：F 有两个 arity-1 重载 → 无类型无法决议 → E0437
    string src = "class A { } class B { } class C { void F(A a) { } void F(B b) { } void M() { this.F(new()); } }";
    Assert.Equal("E0437", SemanticDump.FirstErrorCode(src));
}

// ── 1B：运算 + 控制流端到端 ──────────────────────────────────────────────────────

[Test]
void test_arithmetic() {
    string src = "class C { int Add(int a, int b) { return a + b; } }";
    Assert.Equal("(block (return (bin + (ident a :int) (ident b :int) :int)))",
                 SemanticDump.DumpBody(src, "C.Add"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_numeric_widening() {
    // double / int → double（拓宽表）；double 可赋给 double 返回
    string src = "class C { double Half(double d) { return d / 2; } }";
    Assert.Equal("(block (return (bin / (ident d :double) (lit-int 2 :int) :double)))",
                 SemanticDump.DumpBody(src, "C.Half"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_comparison_yields_bool() {
    string src = "class C { bool Lt(int a, int b) { return a < b; } }";
    Assert.Equal("(block (return (bin < (ident a :int) (ident b :int) :bool)))",
                 SemanticDump.DumpBody(src, "C.Lt"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_logical_and_bitwise() {
    string and = "class C { bool A(bool x, bool y) { return x && y; } }";
    Assert.Equal("(block (return (bin && (ident x :bool) (ident y :bool) :bool)))",
                 SemanticDump.DumpBody(and, "C.A"));
    Assert.Equal(0, SemanticDump.ErrorCount(and));
    string bits = "class C { int O(int a, int b) { return a | b; } }";
    Assert.Equal("(block (return (bin | (ident a :int) (ident b :int) :int)))",
                 SemanticDump.DumpBody(bits, "C.O"));
    Assert.Equal(0, SemanticDump.ErrorCount(bits));
}

[Test]
void test_unary() {
    string neg = "class C { int N(int x) { return -x; } }";
    Assert.Equal("(block (return (unary - (ident x :int) :int)))",
                 SemanticDump.DumpBody(neg, "C.N"));
    Assert.Equal(0, SemanticDump.ErrorCount(neg));
    string not = "class C { bool F(bool b) { return !b; } }";
    Assert.Equal("(block (return (unary ! (ident b :bool) :bool)))",
                 SemanticDump.DumpBody(not, "C.F"));
    Assert.Equal(0, SemanticDump.ErrorCount(not));
}

[Test]
void test_if_while_break_continue() {
    string src = "class C { void Run(int n) { while (n < 3) { if (n == 0) { break; } continue; } } }";
    Assert.Equal(
        "(block (while (bin < (ident n :int) (lit-int 3 :int) :bool) (block (if (bin == (ident n :int) (lit-int 0 :int) :bool) (block (break))) (continue))))",
        SemanticDump.DumpBody(src, "C.Run"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_error_operator_type_mismatch() {
    // string - int：`-` 要求 numeric 操作数，左 string 不符
    string src = "class C { int Bad(string s) { return s - 1; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_error_non_bool_condition() {
    // if 条件须 bool，int 不符
    string src = "class C { void M(int n) { if (n) { } } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_error_break_outside_loop() {
    string src = "class C { void M() { break; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

// ── ctor arity 校验（E0426，防实参数不符被 fall-through 静默按位截断）───────────
[Test]
void test_error_ctor_too_many_args() {
    // 1 参 ctor 传 2 实参 → 无重载接受 → E0426（防 ManifestLoader 式 16→12 静默截断）
    string src = "class C { int x; C(int a) { this.x = a; } void M() { var c = new C(1, 2); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0426", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_error_ctor_too_few_args() {
    // 1 参 ctor 传 0 实参（无默认）→ E0426
    string src = "class C { int x; C(int a) { this.x = a; } void M() { var c = new C(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0426", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_ctor_correct_arity_ok() {
    // 精确匹配 → 无 E0426
    string src = "class C { int x; C(int a) { this.x = a; } void M() { var c = new C(5); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_ctor_params_variadic_ok() {
    // params ctor 接受任意 ≥ 定长部分实参 → 无 E0426
    string src = "class P { P(params int[] xs) { } void M() { var p = new P(1, 2, 3); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_ctor_default_arg_ok() {
    // 带默认尾参：少传可接受 → 无 E0426
    string src = "class C { int x; C(int a, int b = 9) { this.x = a; } void M() { var c = new C(5); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 1C-1：成员字段访问 + 继承 ──────────────────────────────────────────────
[Test]
void test_member_field_access() {
    string src = "class Box { int value; int Get() { return this.value; } }";
    Assert.Equal("(block (return (member (ident this :Box) value :int)))",
                 SemanticDump.DumpBody(src, "Box.Get"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_inherited_field_access() {
    // this.x 来自 Base（继承字段，走 base 链查找）
    string src = "class Base { protected int x; } class Derived : Base { int y; int Sum() { return this.x + this.y; } }";
    Assert.Equal("(block (return (bin + (member (ident this :Derived) x :int) (member (ident this :Derived) y :int) :int)))",
                 SemanticDump.DumpBody(src, "Derived.Sum"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_subclass_assignable_to_base() {
    // return Derived 给 Base 形参 → subclass→base 可赋（IsSubclassOf）
    string src = "class Base { } class Derived : Base { } class C { Base Pick(Derived d) { return d; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_unrelated_class_not_assignable() {
    string src = "class A { } class B { } class C { A Bad(B b) { return b; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));   // B 不是 A 的子类
}

[Test]
void test_field_not_found_error() {
    string src = "class Box { int value; int M() { return this.missing; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));   // no field missing
}

// ── 1C-2：实例 + 静态方法调用 ──────────────────────────────────────────────
[Test]
void test_instance_method_call() {
    // this.Helper() 实例调用（同类方法，base 链查找）
    string src = "class C { int Helper() { return 1; } int Use() { return this.Helper(); } }";
    Assert.Equal("(block (return (call-inst (ident this :C) Helper :int)))",
                 SemanticDump.DumpBody(src, "C.Use"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_instance_call_on_param() {
    string src = "class Box { public int Get() { return 7; } } class C { int Read(Box b) { return b.Get(); } }";
    Assert.Equal("(block (return (call-inst (ident b :Box) Get :int)))",
                 SemanticDump.DumpBody(src, "C.Read"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_static_method_call() {
    // Math.Square(...) 静态调用（裸类名 target）
    string src = "class Math { public static int Square(int n) { return n; } } class C { int Use() { return Math.Square(4); } }";
    Assert.Equal("(block (return (call-static Math Square$1$i32 (lit-int 4 :int) :int)))",
                 SemanticDump.DumpBody(src, "C.Use"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_inherited_method_call() {
    // 继承方法调用（this.BaseM() 在 Base 定义）
    string src = "class Base { protected int BaseM() { return 0; } } class Derived : Base { int Use() { return this.BaseM(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_error_no_such_method() {
    string src = "class Box { } class C { int M(Box b) { return b.Nope(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));   // no method Nope on Box
}

// ── 1D-1：is / as / new ────────────────────────────────────────────────────
[Test]
void test_is_expr() {
    string src = "class C { bool Check(object o) { return o is C; } }";
    Assert.Equal("(block (return (is (ident o :object) C :bool)))", SemanticDump.DumpBody(src, "C.Check"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_as_cast() {
    string src = "class Base { } class Derived : Base { } class C { Derived Down(Base b) { return b as Derived; } }";
    Assert.Equal("(block (return (cast (ident b :Base) :Derived)))", SemanticDump.DumpBody(src, "C.Down"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_new_no_args() {
    string src = "class Box { } class C { Box Make() { return new Box(); } }";
    Assert.Equal("(block (return (new Box :Box)))", SemanticDump.DumpBody(src, "C.Make"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_new_with_args() {
    string src = "class Point { } class C { Point Make() { return new Point(1, 2); } }";
    Assert.Equal("(block (return (new Point (lit-int 1 :int) (lit-int 2 :int) :Point)))", SemanticDump.DumpBody(src, "C.Make"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_new_unknown_type_error() {
    // `new` 未定义类型 → E0443（fix-undefined-type-diagnostic：与其它类型注解位置统一，
    // 单一 choke point CheckTypeRef 报，不再另发 E0401 双重报错）
    string src = "class C { object Make() { return new Nonexistent(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));   // 未定义类型（仅 E0443）
    Assert.Equal("E0443", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_undefined_type_in_declaration_signature_positions_reported() {
    // 🔒 **这条守的是 harness 本身**，不是某条语义规则。
    //
    // 上一条注释里「与其它类型注解位置统一」这句话，在 2026-09-06 之前只对**表达式位置**成立：
    // 声明签名位置（方法返回类型 / 形参类型 / 字段类型 / 基类表）的 E0443 由 **SymbolCollector
    // 相位**的 `_chkTypeRef` 发出，而 `SemanticDump` 只把 **TypeChecker** 的诊断收进 bag、
    // 把 collector 那份整个丢掉 ⇒ 下面这三行以前全部返回 ""。
    //
    // 危害不是「少报一条」：凡以「签名位置写坏类型应当报错」为断言的用例，**无论实现对错都恒绿**
    // ——即空测试。add-associated-types PR-2 为 `Self` 写的头一批用例整批撞上（把支持改动全退回后
    // 仍 7/7 全绿），这才把洞挖出来。修在 `SemanticDump._model` 的 `diags.MergeFrom(sc.Diags)`。
    Assert.Equal("E0443", SemanticDump.FirstErrorCode("class C { Undef f() { return null; } }"));
    Assert.Equal("E0443", SemanticDump.FirstErrorCode("class C { void f(Undef x) { } }"));
    Assert.Equal("E0443", SemanticDump.FirstErrorCode("class C { public Undef x; }"));
    Assert.Equal("E0443", SemanticDump.FirstErrorCode("class C : Undef { }"));
}

// ── 1D-2：数组类型 + 索引 ──────────────────────────────────────────────────
[Test]
void test_array_index() {
    string src = "class C { int First(int[] xs) { return xs[0]; } }";
    Assert.Equal("(block (return (index (ident xs :int[]) (lit-int 0 :int) :int)))",
                 SemanticDump.DumpBody(src, "C.First"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_array_type_assign() {
    // int[] 字段 + 同型赋值（数组类型不变性）
    string src = "class C { void M(int[] a) { int[] b = a; } }";
    Assert.Equal("(block (decl b :int[] (ident a :int[])))", SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_index_on_non_array_error() {
    string src = "class C { int M(int x) { return x[0]; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));   // int 不是数组
}

// ── 1E：三目 + ?? ──────────────────────────────────────────────────────────
[Test]
void test_ternary() {
    string src = "class C { int Max(int a, int b) { return a > b ? a : b; } }";
    Assert.Equal("(block (return (cond (bin > (ident a :int) (ident b :int) :bool) (ident a :int) (ident b :int) :int)))",
                 SemanticDump.DumpBody(src, "C.Max"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_ternary_widen_branches() {
    // 分支 int / double → double（公共类型取较宽）
    string src = "class C { double Pick(bool f, int a, double b) { return f ? a : b; } }";
    Assert.Equal("(block (return (cond (ident f :bool) (ident a :int) (ident b :double) :double)))",
                 SemanticDump.DumpBody(src, "C.Pick"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_null_coalesce() {
    string src = "class C { string Pick(string a, string b) { return a ?? b; } }";
    Assert.Equal("(block (return (bin ?? (ident a :string) (ident b :string) :string)))",
                 SemanticDump.DumpBody(src, "C.Pick"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_ternary_non_bool_cond_error() {
    string src = "class C { int M(int x) { return x ? 1 : 2; } }";   // x 非 bool 条件
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

// ── 2A-1：泛型类（类型形参 resolve）──────────────────────────────────────────
[Test]
void test_generic_class_field_return() {
    string src = "class Box<T> { T value; T Get() { return this.value; } }";
    Assert.Equal("(block (return (member (ident this :Box) value :T)))", SemanticDump.DumpBody(src, "Box.Get"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_generic_class_param_assign() {
    string src = "class Box<T> { T val; void Set(T v) { this.val = v; } }";
    Assert.Equal("(block (expr (assign (member (ident this :Box) val :T) (ident v :T) :T)))",
                 SemanticDump.DumpBody(src, "Box.Set"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_generic_multi_param() {
    string src = "class Pair<K, V> { K key; V val; K GetKey() { return this.key; } }";
    Assert.Equal("(block (return (member (ident this :Pair) key :K)))", SemanticDump.DumpBody(src, "Pair.GetKey"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_generic_param_mismatch_error() {
    // K 字段赋 V 值 → 不同型参不可赋
    string src = "class Pair<K, V> { K key; void Bad(V v) { this.key = v; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

// ── 2A-2a：泛型方法（自身型参）──────────────────────────────────────────────
[Test]
void test_generic_method() {
    string src = "class C { U Identity<U>(U x) { return x; } }";
    Assert.Equal("(block (return (ident x :U)))", SemanticDump.DumpBody(src, "C.Identity"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_generic_method_in_generic_class() {
    // 类型参 T + 方法型参 U 同在 scope
    string src = "class Box<T> { T val; U Conv<U>(U u) { return u; } }";
    Assert.Equal("(block (return (ident u :U)))", SemanticDump.DumpBody(src, "Box.Conv"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_generic_free_func() {
    string src = "T Echo<T>(T x) { return x; }";
    Assert.Equal("(block (return (ident x :T)))", SemanticDump.DumpBody(src, "Echo"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 2A-2b：泛型实例化 Box<int>（经参数/返回——局部 var-decl 泛型类型是 syntax gap）──────
[Test]
void test_generic_instantiation_param() {
    string src = "class Box<T> { } class C { Box<int> Pass(Box<int> a) { return a; } }";
    Assert.Equal("(block (return (ident a :Box<int>)))", SemanticDump.DumpBody(src, "C.Pass"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_generic_instantiation_mismatch() {
    // 返回 Box<int> 给 Box<string> ret → 不变性错误
    string src = "class Box<T> { } class C { Box<string> Bad(Box<int> a) { return a; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_nested_instantiation() {
    string src = "class Box<T> { } class C { Box<Box<int>> Pass(Box<Box<int>> a) { return a; } }";
    Assert.Equal("(block (return (ident a :Box<Box<int>>)))", SemanticDump.DumpBody(src, "C.Pass"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 2B：where 约束求解（可行子集：base-class / class / struct / 型参引用 + 互斥）──────────

[Test]
void test_constraint_base_class_ok() {
    // where T : Animal，实参 Cat（Animal 子类）→ 满足
    string src = "class Animal { } class Cat : Animal { } class Box<T> where T : Animal { } class C { void M() { var b = new Box<Cat>(); } }";
    Assert.Equal("(block (decl b :Box<Cat> (new Box<Cat> :Box<Cat>)))", SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_constraint_base_class_violation() {
    // where T : Animal，实参 int（非 class）→ 违反
    string src = "class Animal { } class Box<T> where T : Animal { } class C { void M() { var b = new Box<int>(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_constraint_class() {
    string ok = "class Foo { } class Box<T> where T : class { } class C { void M() { var b = new Box<Foo>(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(ok));
    string bad = "class Box<T> where T : class { } class C { void M() { var b = new Box<int>(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(bad));   // int 非引用类型
}

[Test]
void test_constraint_struct() {
    string ok = "class Box<T> where T : struct { } class C { void M() { var b = new Box<int>(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(ok));
    string bad = "class Foo { } class Box<T> where T : struct { } class C { void M() { var b = new Box<Foo>(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(bad));   // Foo 非值类型
}

[Test]
void test_constraint_type_param_ref() {
    // where V : K —— V 实参须可赋给 K 实参
    string ok = "class Animal { } class Cat : Animal { } class Pair<K, V> where V : K { } class C { void M() { var p = new Pair<Animal, Cat>(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(ok));    // V=Cat 可赋 K=Animal
    string bad = "class Animal { } class Cat : Animal { } class Pair<K, V> where V : K { } class C { void M() { var p = new Pair<Cat, Animal>(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(bad));   // V=Animal 不可赋 K=Cat
}

[Test]
void test_constraint_class_struct_conflict() {
    // 声明期互斥：class + struct（z42 用 + 分隔多约束）
    string src = "class Box<T> where T : class + struct { }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_constraint_unknown_type_param() {
    // where 引用未声明的型参 Q
    string src = "class Box<T> where Q : class { }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_constraint_unconstrained_any_arg() {
    // 无 where 的泛型类 → 任意实参均可（不触发约束校验）
    string src = "class Box<T> { } class C { void M() { var b = new Box<int>(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 实例跨包（port-z42c-instance-import IC-3）────────────────────────────────
[Test]
void test_prim_receiver_loose_binding() {
    // prim receiver 方法调用不再报错（松绑定；包装类不在本单测符号域 → ret Unknown 吸收）
    string src = "class C { void M(string s) { s.Substring(0, 2); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── char 字面量（port-z42c-char）──────────────────────────────────────────────
[Test]
void test_char_literal_typecheck() {
    string src = "class C { bool M() { char a = 'A'; return a == 'B'; } }";
    Assert.Equal("(block (decl a :char (lit-char A :char)) (return (bin == (ident a :char) (lit-char B :char) :bool)))",
                 SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── try/catch/throw（port-z42c-try）─────────────────────────────────────────
[Test]
void test_try_catch_finally_bind() {
    string src = "class E { } class C { int M() { int r = 0; try { throw new E(); } catch (E ex) { r = 1; } finally { r = r + 1; } return r; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_catch_var_in_scope() {
    // catch 变量类型 = 解析的异常类；体内可用
    string src = "class E { public int Code; } class C { int M() { try { return 1; } catch (E ex) { return ex.Code; } } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── interface（port-z42c-interface）─────────────────────────────────────────
[Test]
void test_interface_assignability() {
    string src = "interface IA { int F(); } class C : IA { public int F() { return 1; } } class D { } class U { IA Get(C c) { return c; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
    // 未实现类 → 不可赋
    string bad = "interface IA { int F(); } class D { } class U { IA Get(D d) { return d; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(bad));
}

[Test]
void test_interface_dispatch_bind() {
    string src = "interface IA { int F(); } class C : IA { public int F() { return 1; } } class U { int Use(IA a) { return a.F(); } }";
    Assert.Equal("(block (return (call-inst (ident a :IA) F :int)))",
                 SemanticDump.DumpBody(src, "U.Use"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── lambda（port-z42c-closures）─────────────────────────────────────────────
[Test]
void test_lambda_infer_and_capture() {
    // expected 推导 + 捕获记录（k 捕获 → cap-ident）
    string src = "class C { int M() { int k = 3; Func<int, int> f = x => x * k; return k; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_indirect_call_bind() {
    string src = "class C { int M(Func<int, int> f) { return f(2); } }";
    Assert.Equal("(block (return (call-ind (ident f :Func<int, int>) :int)))",
                 SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── arr.Length（port-z42c-package-symbols PS-2）──────────────────────────────
[Test]
void test_array_length() {
    string src = "class C { int M(int[] xs) { return xs.Length; } }";
    Assert.Equal("(block (return (member (ident xs :int[]) Length :int)))",
                 SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 静态字段/数组创建（port-z42c-statics-arrays）─────────────────────────────
[Test]
void test_static_field_read() {
    string src = "static class S { public static int X = 5; } class C { int M() { return S.X; } }";
    Assert.Equal("(block (return (static-get S.X :int)))", SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_array_new() {
    string src = "class C { int M() { int[] xs = new int[3]; return xs.Length; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 整型字面量越界 → long（镜像 C# TypeChecker.Exprs；G18-literal-typing）──────
// 值 > int.MaxValue（或 < int.MinValue）→ 类型 long，否则 int。z42c.project
// `0xFFFFFFFFL` mask 的 REGT tag i32-vs-i64 残差由此修复（dual-build MODS delta 0）。
[Test]
void test_int_literal_in_range_is_int() {
    // int.MaxValue 整好（2147483647）不越界 → int
    string src = "class C { long M() { return 2147483647; } }";
    Assert.Equal("(block (return (lit-int 2147483647 :int)))", SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_int_literal_hex_suffix_over_range_is_long() {
    // 0xFFFFFFFFL = 4294967295 > int.MaxValue → long（剥 L 后缀解析十六进制）
    string src = "class C { long M() { return 0xFFFFFFFFL; } }";
    Assert.Equal("(block (return (lit-int 0xFFFFFFFFL :long)))", SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_int_literal_decimal_over_range_is_long() {
    // 2147483648 = int.MaxValue + 1 → long（十进制越界路径）
    string src = "class C { long M() { return 2147483648; } }";
    Assert.Equal("(block (return (lit-int 2147483648 :long)))", SemanticDump.DumpBody(src, "C.M"));
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 重复重载签名（add-type-based-overloads 根因修复）──────────────────────
// 静态同 (name,arity) 重载经 Canon 归一后撞出同一 mangled RegKey，此前被 SymbolCollector
// first-wins 静默吞掉第二个方法体、零诊断；现报 E0408 duplicate declaration。
[Test]
void test_error_duplicate_overload_type_alias_collision() {
    // int 与 i32 是同一基本类型的两种拼写（PrimModel.Canon 归一）→ 签名键碰撞
    string src = "class C { static void F(int a) { } static void F(i32 a) { } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_error_duplicate_overload_nullable_collision() {
    // Canon 剥 nullable 后 string 与 string? 同键 → 签名键碰撞
    string src = "class C { static void G(string a) { } static void G(string? a) { } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_distinct_static_overloads_no_duplicate_error() {
    // 真正不同的形参类型（int vs string）不应被误判为重复
    string src = "class C { static void H(int a) { } static void H(string a) { } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 实例方法 type-based 重载扩展（add-type-based-overloads D7，阶段 8）────────
// 豁免名单外的实例方法同样做碰撞检测；豁免名单内（协议方法）不检测、不误报；
// 操作符（op_*）走既有静态决议路径（8.1a：_bindBinary 迁移到 _resolveOverload）。
[Test]
void test_error_duplicate_instance_overload_type_alias_collision() {
    // int 与 i32 同一基本类型两种拼写 → 实例方法签名键碰撞，豁免名单外须报错
    string src = "class C { void F(int a) { } void F(i32 a) { } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_error_duplicate_instance_overload_nullable_collision() {
    // Canon 剥 nullable 后 string 与 string? 同键 → 实例方法签名键碰撞
    string src = "class C { void G(string a) { } void G(string? a) { } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_distinct_instance_overloads_no_duplicate_error() {
    // 真正不同的形参类型（int vs string）不应被误判为重复
    string src = "class C { void H(int a) { } void H(string a) { } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_protocol_exempt_equals_no_duplicate_error() {
    // Equals 属协议豁免名单（DependencyIndex._isProtocol 排除，非 VM 硬编码）——
    // 即使同 arity 不同类型也不参与 mangle、不做碰撞检测（沿用 first-wins 现状，不引入新行为）
    string src = "class C { bool Equals(object o) { return false; } bool Equals(string s) { return true; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_protocol_exempt_get_item_no_duplicate_error() {
    // get_Item 属协议豁免名单（TypeChecker 自身用字面量字符串查找，mangle 会致查找落空）
    string src = "class C { int get_Item(int i) { return i; } int get_Item(string s) { return 0; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_operator_overload_multi_arity_dispatch_selects_correct_overload() {
    // 验证 8.1a：_bindBinary 迁移到 _resolveOverload 前，同 arity 多重载操作符
    // （op_Add(Vec,Vec) 与 op_Add(Vec,int)）因旧 _overloadKey 只产生 arity-only 键
    // （查不到 mangled 注册键）而派发失败；迁移后应正确按实参类型选中对应重载。
    string src = "class Vec { public static Vec operator +(Vec a, Vec b) { return a; } " +
                 "public static Vec operator +(Vec a, int b) { return a; } } " +
                 "class C { Vec AddVV(Vec a, Vec b) { return a + b; } " +
                 "Vec AddVI(Vec a, int b) { return a + b; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
    Assert.Equal("(block (return (call-static Vec op_Add$2$Vec$Vec (ident a :Vec) (ident b :Vec) :Vec)))",
                 SemanticDump.DumpBody(src, "C.AddVV"));
    Assert.Equal("(block (return (call-static Vec op_Add$2$Vec$i32 (ident a :Vec) (ident b :int) :Vec)))",
                 SemanticDump.DumpBody(src, "C.AddVI"));
}

[Test]
void test_duplicate_free_function_reports_error_not_crash() {
    // 顶层同名自由函数**不重载**（`SymbolTable.Functions` 名唯一键；重载 mangling 仅类方法）。
    // 曾使 `ExportedTypeExtractor._extractFunc` 用错-arity 符号索引 `md.Params` → FieldGet null 崩。
    // 现由 `TypeChecker._checkDuplicateFreeFunctions` 报清晰 duplicate 诊断（不再崩）。
    string src = "int foo(int a) { return a; } int foo(int a, int b) { return a + b; }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
}

[Test]
void test_unique_free_function_no_false_positive() {
    // 唯一名自由函数不受 duplicate 检查影响（守护 false-positive）。
    string src = "int bar(int a) { return a; } int baz(int a, int b) { return a + b; }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_parse_diags_surface_in_error_count() {
    // fix-parse-diags-dropped 回归：parse 错误必须计入编译错误数（此前 Parser 的
    // DiagnosticBag 被丢弃——`string impl` 参数名脱轨解析后 typecheck 恰好不报错
    // → 静默 miscompile：方法被无声吞掉、构建成功）。`impl` 是保留关键字。
    string src = "class C { string Rep(string impl) { return \"x\"; } }";
    Assert.True(SemanticDump.ErrorCount(src) > 0);
}

[Test]
void test_keyword_param_name_targeted_diag() {
    // 关键字占参数名 → 单条精准诊断 + 解析不脱轨（同类后续方法不受级联污染）。
    string src = "class C { int A(string impl) { return 1; } int B() { return 2; } }";
    Assert.True(SemanticDump.ErrorCount(src) > 0);
    // B 未被级联撕毁：bound 树仍可取到其方法体。
    Assert.Equal("(block (return (lit-int 2 :int)))", SemanticDump.DumpBody(src, "C.B"));
}

// ── readonly 字段不变性强制（add-readonly-fields-opt）───────────────────────
[Test]
void test_readonly_ctor_assign_ok() {
    // readonly 字段在声明类 ctor 内经 this 赋值 → 合法。
    string src = "class C { readonly int x; C(int a) { this.x = a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}
[Test]
void test_readonly_initializer_ok() {
    // 字段初始化器（注入 ctor）→ 合法。
    string src = "class C { readonly int x = 5; }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}
[Test]
void test_readonly_method_assign_error() {
    // 非 ctor 方法内 `this.x = ` 写 readonly → E0415。
    string src = "class C { readonly int x; C(int a){ this.x=a; } void set(int a) { this.x = a; } }";
    Assert.True(SemanticDump.ErrorCount(src) > 0);
}
[Test]
void test_readonly_bare_method_assign_error() {
    // 裸 `x = ` 写 readonly（隐式 this）在非 ctor 方法内 → E0415。
    string src = "class C { readonly int x; C(int a){ this.x=a; } void set(int a) { x = a; } }";
    Assert.True(SemanticDump.ErrorCount(src) > 0);
}
[Test]
void test_readonly_cross_object_ctor_error() {
    // ctor 内经**另一对象**（非 this）写 readonly → E0415（只允许 this.<field>）。
    string src = "class C { readonly int x; C(C other) { other.x = 1; } }";
    Assert.True(SemanticDump.ErrorCount(src) > 0);
}
[Test]
void test_nonreadonly_method_assign_ok() {
    // 非 readonly 字段方法内赋值 → 合法（不误伤普通字段）。
    string src = "class C { int x; void set(int a) { this.x = a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── const 强制诊断（add-const-keyword；E0416–E0419）──────────────────────────────
// 注：const 字段的 E0416/E0417 属**收集期**（SymbolCollector）诊断 → 在 collect_tests.z42 覆盖
// （SemanticDump 只跑类型检查期，不含收集期 bag）。此处覆盖类型检查期的赋值 / 引用诊断。
[Test]
void test_const_field_assign_error() {
    // 对 const 字段赋值 → E0418
    string src = "class C { const int X = 1; void set() { C.X = 5; } }";
    Assert.Equal("E0418", SemanticDump.FirstErrorCode(src));
}
[Test]
void test_const_local_assign_error() {
    // 对 const 局部赋值 → E0418
    string src = "void f() { const int n = 1; n = 2; }";
    Assert.Equal("E0418", SemanticDump.FirstErrorCode(src));
}
[Test]
void test_const_bad_ref_error() {
    // const 初始化器引用非 const（普通局部）→ E0419
    string src = "void f() { int z = 3; const int Y = z; }";
    Assert.Equal("E0419", SemanticDump.FirstErrorCode(src));
}
[Test]
void test_const_valid_no_error() {
    // 合法 const：字段引用已定义 const + 局部 const + 混用于普通表达式 → 无错。
    string src = "class C { public const int A = 10; const int B = A * 2; } void f() { const int n = 8; int y = n + C.A; }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}
