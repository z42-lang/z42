// 经派生类访问基类静态成员（reject-derived-static-access）：E0401，消息点名声明类。
//
// 参考手册 static-members.md：经派生类名限定的 `Derived.baseStatic` 不支持，应写 `Base.x`；派生类体内的
// **短名**沿基类链查找（`M()` / `T`，按声明类发射）。此前 `B.M()` 编译通过、运行期 MissingSymbolException；
// `B.T` / `A.Nope` 报与实情无关的 E0436（「请 using 本文件自己的 ns」）。
// 阴性对照：`A.T` / `A.M()`、Color Color（类名同时是当前类的静态字段）、枚举成员都照常。
namespace Z42cSemanticsDerivedStaticAccessTests;

using Z42.Semantics;
using Z42.Emission;

string[] dsDiags(string src) {
    string[] srcs = new string[1]; srcs[0] = src;
    string[] files = new string[1]; files[0] = "f0.z42";
    CompiledModuleZ[] cms = IrDump.BuildPackage(srcs, files, 1, null, null, false);
    string[] r = new string[cms[0].DiagCount];
    int j = 0;
    while (j < cms[0].DiagCount) { r[j] = cms[0].DiagMsgs[j]; j = j + 1; }
    return r;
}

int dsCount(string src, string needle) {
    string[] msgs = dsDiags(src);
    int n = 0;
    int i = 0;
    while (i < msgs.Length) { if (msgs[i].Contains(needle)) { n = n + 1; } i = i + 1; }
    return n;
}

int dsErrors(string src) {
    string[] msgs = dsDiags(src);
    int n = 0;
    int i = 0;
    while (i < msgs.Length) { if (msgs[i].Contains("E0") || msgs[i].Contains("E1")) { n = n + 1; } i = i + 1; }
    return n;
}

string dsWrap(string body) {
    return "namespace P;\nclass A { public static int T = 7; public static int M() { return 1; } public static int Prop { get { return 3; } } }\n"
        + "class B : A { }\n" + body;
}

// ── 报错 ──────────────────────────────────────────────

[Test]
void test_static_method_via_derived_name_reports_E0401() {
    string src = dsWrap("void F() { int x = B.M(); }\n");
    Assert.Equal(1, dsCount(src, "E0401"));
    Assert.Equal(1, dsCount(src, "declared on base class `A`"));
}

[Test]
void test_ns_qualified_static_method_via_derived_name_reports_E0401() {
    Assert.Equal(1, dsCount(dsWrap("void F() { int x = P.B.M(); }\n"), "declared on base class `A`"));
}

// 派生类体内的短名沿基类链查找（nested-and-base-name-lookup）：裸调基类静态方法、裸读基类静态字段 / 属性都合法。
[Test]
void test_bare_base_static_in_derived_body_is_fine() {
    Assert.Equal(0, dsErrors(dsWrap("class C : A { int G() { return M() + T + Prop; } }\n")));
}

[Test]
void test_static_field_via_derived_name_reports_E0401_not_E0436() {
    string src = dsWrap("void F() { int x = B.T; }\n");
    Assert.Equal(1, dsCount(src, "declared on base class `A`"));
    Assert.Equal(0, dsCount(src, "E0436"));
}

[Test]
void test_static_property_via_derived_name_reports_E0401() {
    Assert.Equal(1, dsCount(dsWrap("void F() { int x = B.Prop; }\n"), "declared on base class `A`"));
}

[Test]
void test_static_field_write_via_derived_name_reports_E0401() {
    Assert.Equal(1, dsCount(dsWrap("void F() { B.T = 3; }\n"), "declared on base class `A`"));
}

[Test]
void test_missing_static_member_reports_E0401_not_E0436() {
    string src = dsWrap("void F() { int x = A.Nope; }\n");
    Assert.Equal(1, dsCount(src, "no static member `Nope` on `A`"));
    Assert.Equal(0, dsCount(src, "E0436"));
}

// ── 不报 ──────────────────────────────────────────────

[Test]
void test_access_through_declaring_class_is_fine() {
    Assert.Equal(0, dsErrors(dsWrap("void F() { int x = A.T + A.M() + A.Prop; A.T = 2; }\n")));
}

[Test]
void test_own_static_on_derived_is_fine() {
    string src = "namespace P;\nclass A { }\nclass B : A { public static int T = 1; public static int M() { return 2; } }\nvoid F() { int x = B.T + B.M(); }\n";
    Assert.Equal(0, dsErrors(src));
}

[Test]
void test_color_color_static_field_receiver_is_fine() {
    // 类名 `Foo` 同时是当前类的静态字段：`Foo.Bar` 读的是那个字段的实例成员。
    string src = "namespace P;\nclass Foo { public int Bar; }\nclass Q { static Foo Foo = new Foo(); int M() { return Foo.Bar; } }\n";
    Assert.Equal(0, dsErrors(src));
}

[Test]
void test_enum_member_access_is_fine() {
    string src = "namespace P;\nenum Color { Red }\nclass Q { int M() { return (int)Color.Red; } }\n";
    Assert.Equal(0, dsErrors(src));
}
