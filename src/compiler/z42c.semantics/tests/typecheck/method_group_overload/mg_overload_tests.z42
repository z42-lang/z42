// feat/method-group-target-typed：重载方法组 + 目标委托类型的消解单测（负例）。
// 正向链路（实例/静态/return/赋值位 + 交叉）由 e2e `src/tests/delegates/method_group_overload` 覆盖
//（SemanticDump 片段不带 stdlib，正向无从写）。这里钉：
//   · 有目标但无精确匹配 → E0477（与自由函数 E0477 同码，消息点名类与候选）
//   · 无目标（var）静态重载 → 仍 E0425（v1 边界，提示 lambda 包装）
//   · 实例 type-based 重载无目标 → 绑 primary、转换失败 E0402（既有行为，非歧义报错）
namespace Z42cSemanticsMethodGroupOverloadTests;

using Z42.Semantics;
using Std.Harness;

[Test]
void test_no_matching_overload_with_target_is_e0477() {
    string src = "class C { public int F(int x) { return x; } public string F(string s) { return s; } "
        + "void M() { (long) -> long f = this.F; } }";
    Assert.Equal("E0477", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_no_match_message_names_class_and_candidates() {
    string src = "class C { public int F(int x) { return x; } public string F(string s) { return s; } "
        + "void M() { (long) -> long f = this.F; } }";
    Assert.True(SemanticDump.FirstErrorMessage(src).Contains("`C.F`"));
}

[Test]
void test_static_overload_without_target_still_e0425() {
    string src = "class A { public static int F(int x) { return x; } public static long F(long x) { return x; } "
        + "void M() { var f = A.F; } }";
    Assert.Equal("E0425", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_static_overload_no_match_with_target_is_e0477() {
    string src = "class A { public static int F(int x) { return x; } public static string F(string s) { return s; } "
        + "void M() { (long) -> long f = A.F; } }";
    Assert.Equal("E0477", SemanticDump.FirstErrorCode(src));
}
