// z42c.semantics AnalyzerDriver 单测（attribute-handler-registry PR3a）。
//
// 验证编译期 analyzer 驱动机制：一个测试内 analyzer（实现 Z42.Syntax.Analyzer 契约，Register 里用
// lambda 注册 OnSyntaxNode——这是 user code，lambda 合法）经 AnalyzerDriver.Run 遍历 parse 出的
// CompilationUnit，命中的回调把诊断汇入 DiagnosticBag。证驱动的 store/invoke delegate + AST 遍历
// 分派 + DiagSink→DiagnosticBag 映射全链，无需外部 zpkg 加载（那是后续增量）。
namespace Z42cSemanticsAnalyzerTests;

using Std;
using Std.Test;
using Z42.Syntax;
using Z42.Semantics;
using Z42.Core;

// 测试用 analyzer：报告空 catch（吞异常）。类名带 Analyzer 后缀（D8/E0445）。visitor 模型——声明
// ObservedKinds=CatchClause，driver 对每个 catch 调 OnSyntaxNode，内部 as-cast + 报告。无 delegate/lambda。
class NoEmptyCatchAnalyzer : Analyzer {
    public DiagRule[] SupportedRules() {
        DiagRule[] rules = new DiagRule[1];
        rules[0] = NoEmptyCatchAnalyzer._rule();
        return rules;
    }
    public int[] ObservedKinds() {
        int[] k = new int[1];
        k[0] = SyntaxKind.CatchClause;
        return k;
    }
    public void OnSyntaxNode(int kind, object node, DiagSink diags) {
        if (kind == SyntaxKind.CatchClause) {
            CatchClause c = node as CatchClause;
            if (c.Body is BlockStmt) {
                BlockStmt b = c.Body as BlockStmt;
                if (b.Count == 0) { diags.Report(NoEmptyCatchAnalyzer._rule(), c.Span); }
            }
        }
    }
    static DiagRule _rule() {
        return new DiagRule("Z9002", "empty catch", "empty catch swallows exception",
            "Correctness", AnalyzerSeverity.Warning, true);
    }
}

// 跑 analyzer over src（可带 [lints] 决策器；null → LintConfig.Empty()），返回诊断袋。
DiagnosticBag _runCfg(Analyzer a, string src, LintConfig cfg) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    var bag = new DiagnosticBag();
    Analyzer[] arr = new Analyzer[1];
    arr[0] = a;
    AnalyzerDriver.Run(arr, 1, cu, bag, cfg);
    return bag;
}

// 无 [lints] 覆盖（默认级 + EnabledByDefault）。
DiagnosticBag _run(Analyzer a, string src) {
    return _runCfg(a, src, null);
}

// 构造单条 `Id = sev` 覆盖的 LintConfig。
LintConfig _cfg1(string id, string sev, bool wae) {
    string[] keys = new string[1]; keys[0] = id;
    string[] sevs = new string[1]; sevs[0] = sev;
    return new LintConfig(keys, sevs, 1, wae);
}

// 报告 Z9003（默认禁用 EnabledByDefault=false）的 analyzer——验 EnabledByDefault 门 + 显式开启。
class OffByDefaultAnalyzer : Analyzer {
    public DiagRule[] SupportedRules() {
        DiagRule[] rules = new DiagRule[1];
        rules[0] = OffByDefaultAnalyzer._rule();
        return rules;
    }
    public int[] ObservedKinds() {
        int[] k = new int[1]; k[0] = SyntaxKind.CatchClause; return k;
    }
    public void OnSyntaxNode(int kind, object node, DiagSink diags) {
        if (kind == SyntaxKind.CatchClause) {
            CatchClause c = node as CatchClause;
            if (c.Body is BlockStmt) {
                BlockStmt b = c.Body as BlockStmt;
                if (b.Count == 0) { diags.Report(OffByDefaultAnalyzer._rule(), c.Span); }
            }
        }
    }
    static DiagRule _rule() {
        return new DiagRule("Z9003", "opt-in catch", "opt-in lint",
            "Style", AnalyzerSeverity.Warning, false);   // EnabledByDefault=false
    }
}

string _emptyCatchSrc() { return "class C { void M() { try { risky(); } catch (Error e) { } } }"; }

int _sevOf(DiagnosticBag bag, string code) {
    int i = 0;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == code) { return bag.Get(i).Severity; }
        i = i + 1;
    }
    return -1;
}

bool _hasCode(DiagnosticBag bag, string code) {
    int i = 0;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == code) { return true; }
        i = i + 1;
    }
    return false;
}

[Test]
void test_empty_catch_reported() {
    // 空 catch → analyzer 报 Z9002
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { void M() { try { risky(); } catch (Error e) { } } }");
    Assert.Equal(true, _hasCode(bag, "Z9002"));
}

[Test]
void test_nonempty_catch_not_reported() {
    // 非空 catch → 不报
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { void M() { try { risky(); } catch (Error e) { log(e); } } }");
    Assert.Equal(false, _hasCode(bag, "Z9002"));
}

[Test]
void test_no_try_no_report() {
    // 无 try/catch → analyzer 无触发点，零诊断
    var bag = _run(new NoEmptyCatchAnalyzer(), "class C { void M() { risky(); } }");
    Assert.Equal(false, _hasCode(bag, "Z9002"));
}

[Test]
void test_reported_severity_is_warning() {
    // Z9002 默认级 Warning → 映射进 DiagnosticBag 为 DiagnosticSeverity.Warning
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { void M() { try { risky(); } catch (Error e) { } } }");
    int i = 0;
    bool found = false;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == "Z9002") {
            Assert.Equal(DiagnosticSeverity.Warning, bag.Get(i).Severity);
            found = true;
        }
        i = i + 1;
    }
    Assert.Equal(true, found);
}

// ── PR3b：[lints] severity 决策（LintConfig.Resolve）────────────────────────────

[Test]
void test_lints_override_to_error() {
    // [lints] Z9002 = "error" → 默认 Warning 升为 Error
    var bag = _runCfg(new NoEmptyCatchAnalyzer(), _emptyCatchSrc(), _cfg1("Z9002", "error", false));
    Assert.Equal(true, _hasCode(bag, "Z9002"));
    Assert.Equal(DiagnosticSeverity.Error, _sevOf(bag, "Z9002"));
}

[Test]
void test_lints_none_suppresses() {
    // [lints] Z9002 = "none" → 整条抑制，不进 bag
    var bag = _runCfg(new NoEmptyCatchAnalyzer(), _emptyCatchSrc(), _cfg1("Z9002", "none", false));
    Assert.Equal(false, _hasCode(bag, "Z9002"));
}

[Test]
void test_lints_warnings_as_errors() {
    // warnings-as-errors + 无逐规则覆盖 → 默认 Warning 规则升为 Error
    LintConfig cfg = new LintConfig(new string[0], new string[0], 0, true);
    var bag = _runCfg(new NoEmptyCatchAnalyzer(), _emptyCatchSrc(), cfg);
    Assert.Equal(DiagnosticSeverity.Error, _sevOf(bag, "Z9002"));
}

[Test]
void test_lints_wildcard_suppresses() {
    // 前缀通配 "Z9*" = "none" → 抑制 Z9002
    var bag = _runCfg(new NoEmptyCatchAnalyzer(), _emptyCatchSrc(), _cfg1("Z9*", "none", false));
    Assert.Equal(false, _hasCode(bag, "Z9002"));
}

[Test]
void test_disabled_by_default_not_reported() {
    // EnabledByDefault=false + 无覆盖 → 抑制
    var bag = _runCfg(new OffByDefaultAnalyzer(), _emptyCatchSrc(), null);
    Assert.Equal(false, _hasCode(bag, "Z9003"));
}

[Test]
void test_disabled_by_default_enabled_via_lints() {
    // EnabledByDefault=false，但 [lints] Z9003 = "warning" 显式打开 → 报
    var bag = _runCfg(new OffByDefaultAnalyzer(), _emptyCatchSrc(), _cfg1("Z9003", "warning", false));
    Assert.Equal(true, _hasCode(bag, "Z9003"));
    Assert.Equal(DiagnosticSeverity.Warning, _sevOf(bag, "Z9003"));
}

// ── PR3c：局部抑制 `#suppress`/`#restore`（字节区间）+ `[Suppress]`（声明活跃栈）─────────────

int _countCode(DiagnosticBag bag, string code) {
    int i = 0; int n = 0;
    while (i < bag.Count()) { if (bag.Get(i).Code == code) { n = n + 1; } i = i + 1; }
    return n;
}

[Test]
void test_suppress_pragma_region_suppresses() {
    // `#suppress Z9002` … `#restore Z9002` 圈住空 catch → 抑制
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { void M() { #suppress Z9002 \"gen code\" try { risky(); } catch (Error e) { } #restore Z9002 } }");
    Assert.Equal(false, _hasCode(bag, "Z9002"));
}

[Test]
void test_suppress_pragma_outside_reported() {
    // 空 catch 在 `#restore` 之后（区间外）→ 仍报
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { void M() { #suppress Z9002 \"g\" #restore Z9002 try { risky(); } catch (Error e) { } } }");
    Assert.Equal(true, _hasCode(bag, "Z9002"));
}

[Test]
void test_suppress_pragma_wrong_id_not_suppressed() {
    // `#suppress Z9999`（不同 Id）不抑制 Z9002
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { void M() { #suppress Z9999 try { risky(); } catch (Error e) { } #restore Z9999 } }");
    Assert.Equal(true, _hasCode(bag, "Z9002"));
}

[Test]
void test_suppress_pragma_unclosed_to_eof() {
    // `#suppress Z9002` 无 `#restore` → 延伸到 EOF，抑制其后所有 Z9002
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { void M() { #suppress Z9002 try { risky(); } catch (Error e) { } } }");
    Assert.Equal(false, _hasCode(bag, "Z9002"));
}

[Test]
void test_suppress_attr_on_method_suppresses() {
    // `[Suppress("Z9002")]` 贴方法 → 该方法内空 catch 抑制
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { [Suppress(\"Z9002\")] void M() { try { risky(); } catch (Error e) { } } }");
    Assert.Equal(false, _hasCode(bag, "Z9002"));
}

[Test]
void test_suppress_attr_scoped_to_decl() {
    // `[Suppress]` 只作用于所贴方法：M 抑制、N 不抑制 → 恰 1 条 Z9002
    var bag = _run(new NoEmptyCatchAnalyzer(),
        "class C { [Suppress(\"Z9002\")] void M() { try { risky(); } catch (Error e) { } }"
        + " void N() { try { risky(); } catch (Error e) { } } }");
    Assert.Equal(1, _countCode(bag, "Z9002"));
}

// SuppressionSet 直接单测（字节区间 + 活跃栈判定）。
[Test]
void test_suppression_set_region() {
    var s = new SuppressionSet();
    s.AddRegion("Z9002", 10, 20);
    Assert.Equal(true, s.IsSuppressed("Z9002", 10));    // 下界含
    Assert.Equal(true, s.IsSuppressed("Z9002", 19));
    Assert.Equal(false, s.IsSuppressed("Z9002", 20));   // 上界排他
    Assert.Equal(false, s.IsSuppressed("Z9002", 5));    // 区间外
    Assert.Equal(false, s.IsSuppressed("Z9999", 15));   // Id 不匹配
}

[Test]
void test_suppression_set_active_stack() {
    var s = new SuppressionSet();
    s.PushActive("Z9002");
    Assert.Equal(true, s.IsSuppressed("Z9002", 0));     // 活跃栈命中（位置无关）
    Assert.Equal(false, s.IsSuppressed("Z9003", 0));
    s.PopActive(1);
    Assert.Equal(false, s.IsSuppressed("Z9002", 0));    // 弹出后不再抑制
}

// ── add-deprecated-directive（PR5）：use-site 弃用告警（直接在 typecheck 相位发 "deprecated" Warning）──
// 零格式-bump（[Deprecated] 经 attr-ref 哨兵持久化）；AccessChecker 在 use-site 解析到弃用符号即发告警到
// _diags，#suppress 经 TypeChecker._curSuppress（cu.SuppressRegions）局部抑制。[lints]/WAE 治理 Deferred
// （接 LintConfig 到 typecheck 需 pipeline→semantics 新跨成员符号，撞 F2 冷启动；见 design.md）。

// 驱动 typecheck → 返回 diags（弃用告警直接进袋）。
DiagnosticBag _depDiags(string src) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    var symbols = new SymbolCollector().Collect(cu);
    var diags = new DiagnosticBag();
    new TypeChecker(diags).Infer(cu, symbols);
    return diags;
}

string _depMethodSrc() {
    return "class A { [Deprecated(\"use g\")] int f() { return 1; } int g() { return this.f(); } }";
}

[Test]
void test_deprecated_method_use_warns() {
    // 调用 [Deprecated] 方法 → 至少 1 条 "deprecated" Warning
    var bag = _depDiags(_depMethodSrc());
    Assert.Equal(true, _hasCode(bag, "deprecated"));
    Assert.Equal(0, bag.ErrorCount());   // Warning 不阻断编译
}

[Test]
void test_not_deprecated_no_warning() {
    // 无 [Deprecated] → 无 "deprecated" 告警
    var bag = _depDiags("class A { int f() { return 1; } int g() { return this.f(); } }");
    Assert.Equal(false, _hasCode(bag, "deprecated"));
}

[Test]
void test_deprecated_suppress_pragma() {
    // `#suppress deprecated` 圈住调用点 → 抑制
    string src = "class A { [Deprecated(\"x\")] int f() { return 1; }"
        + " int g() { #suppress deprecated int r = this.f(); #restore deprecated return r; } }";
    var bag = _depDiags(src);
    Assert.Equal(false, _hasCode(bag, "deprecated"));
}

[Test]
void test_deprecated_class_new_warns() {
    // new [Deprecated] 类 → 类级 use-site 告警
    string src = "[Deprecated] class D { } class U { int g() { var d = new D(); return 1; } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "deprecated"));
}
