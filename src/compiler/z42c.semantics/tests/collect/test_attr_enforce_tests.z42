// enforce-test-attr-placement —— `[Test]`/`[Benchmark]`/`[Setup]`/`[Teardown]` 的位置 + 签名强制
// （DeclEnforcer._passTestAttrEnforce）。逐条覆盖 spec R1–R7：
//   specs/test-attribute-placement/spec.md（docs/spec/changes/enforce-test-attr-placement/）
//
// 补回的是自举迁移中丢失的 TestAttributeValidator（E0911/E0912/E0915 三码此前定义齐全、零引用）。
namespace Z42cSemanticsTestAttrEnforceTests;

using Std;
using Std.Test;
using Z42.Syntax;
using Z42.Semantics;
using Z42.Core;

// 单 CU 收集期诊断（同 collect_tests.collectDiags；本文件自带一份避免跨文件耦合）。
DiagnosticBag teDiags(string src) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    var coll = new SymbolCollector();
    coll.Collect(cu);
    return coll.Diags;
}

bool teHas(DiagnosticBag d, string code) {
    int i = 0;
    while (i < d.Count()) { if (d.Get(i).Code == code) { return true; } i = i + 1; }
    return false;
}

// 某码的诊断条数（R7「R2+R3 并发报出」用）。
int teCount(DiagnosticBag d, string code) {
    int n = 0; int i = 0;
    while (i < d.Count()) { if (d.Get(i).Code == code) { n = n + 1; } i = i + 1; }
    return n;
}

// 首条 `code` 诊断的消息（断言消息含允许集 / 被贴声明形态）。
string teMsg(DiagnosticBag d, string code) {
    int i = 0;
    while (i < d.Count()) { if (d.Get(i).Code == code) { return d.Get(i).Message; } i = i + 1; }
    return "";
}

// ── R1 零接收者 ─────────────────────────────────────────────────────────────

[Test]
void test_r1_free_function_ok() {
    Assert.Equal(false, teHas(teDiags("[Test] void t() { }"), "E0911"));
}

[Test]
void test_r1_static_method_ok() {
    Assert.Equal(false, teHas(teDiags("class T { [Test] public static void t() { } }"), "E0911"));
}

[Test]
void test_r1_instance_method_error() {
    var d = teDiags("class MathTests { [Test] void test_add() { } }");
    Assert.Equal(true, teHas(d, "E0911"));
    var m = teMsg(d, "E0911");
    // 消息须带允许集 + 被贴声明的形态和限定名 + 修复提示
    Assert.Equal(true, m.Contains("free function or a `static` method"));
    Assert.Equal(true, m.Contains("instance method `MathTests.test_add`"));
    Assert.Equal(true, m.Contains("add `static`"));
}

// 嵌套类型：NestedFlatten 先把 Inner 提升为顶层（名 `Outer+Inner`）但仍留在 Outer.Members，
// 故本 pass 必须跳过嵌套类型成员，否则同一声明报两次。限定名还原为源码拼法 `Outer.Inner`。
[Test]
void test_r1_nested_class_instance_method_error() {
    var d = teDiags("class Outer { class Inner { [Test] void t() { } } }");
    Assert.Equal(true, teHas(d, "E0911"));
    Assert.Equal(1, teCount(d, "E0911"));   // 不重复报
    Assert.Equal(true, teMsg(d, "E0911").Contains("instance method `Outer.Inner.t`"));
}

[Test]
void test_r1_impl_block_instance_method_error() {
    var d = teDiags("interface Tr { } class Target { } impl Tr for Target { [Test] void t() { } }");
    Assert.Equal(true, teHas(d, "E0911"));
    Assert.Equal(true, teMsg(d, "E0911").Contains("instance method `Target.t`"));
}

[Test]
void test_r1_constructor_error() {
    var d = teDiags("class Foo { [Test] public Foo() { } }");
    Assert.Equal(true, teHas(d, "E0911"));
    Assert.Equal(true, teMsg(d, "E0911").Contains("constructor `Foo.Foo`"));
}

// R1 违规后不再报 R2–R5：贴错位置时只报一条。
[Test]
void test_r1_short_circuits_signature_checks() {
    // 实例方法 + 有返回值 + 有参数 —— 只应报 R1 那一条
    var d = teDiags("class C { [Test] int t(int x) { return x; } }");
    Assert.Equal(1, teCount(d, "E0911"));
    Assert.Equal(true, teMsg(d, "E0911").Contains("free function or a `static` method"));
}

// ── R2 返回 void ────────────────────────────────────────────────────────────

[Test]
void test_r2_non_void_return_error() {
    var d = teDiags("[Test] int t() { return 1; }");
    Assert.Equal(true, teHas(d, "E0911"));
    var m = teMsg(d, "E0911");
    Assert.Equal(true, m.Contains("must return `void`"));
    Assert.Equal(true, m.Contains("`int`"));
}

// ── R3 无参数 ───────────────────────────────────────────────────────────────

[Test]
void test_r3_with_parameter_error() {
    var d = teDiags("[Test] void t(int x) { }");
    Assert.Equal(true, teHas(d, "E0911"));
    Assert.Equal(true, teMsg(d, "E0911").Contains("must take no parameters"));
}

// ── R4 非泛型 ───────────────────────────────────────────────────────────────

[Test]
void test_r4_generic_method_error() {
    var d = teDiags("[Test] void t<T>() { }");
    Assert.Equal(true, teHas(d, "E0911"));
    Assert.Equal(true, teMsg(d, "E0911").Contains("generic method"));
}

// ── R5 有方法体 ─────────────────────────────────────────────────────────────

[Test]
void test_r5_no_body_error() {
    var d = teDiags("class C { [Test] public static extern void t(); }");
    Assert.Equal(true, teHas(d, "E0911"));
    Assert.Equal(true, teMsg(d, "E0911").Contains("method body"));
}

// ── R6 诊断码按 kind attr 分派 ──────────────────────────────────────────────

[Test]
void test_r6_benchmark_uses_e0912() {
    var d = teDiags("class C { [Benchmark] void b() { } }");
    Assert.Equal(true, teHas(d, "E0912"));
    Assert.Equal(false, teHas(d, "E0911"));
}

[Test]
void test_r6_setup_uses_e0915() {
    var d = teDiags("class C { [Setup] void s() { } }");
    Assert.Equal(true, teHas(d, "E0915"));
}

[Test]
void test_r6_teardown_uses_e0915() {
    var d = teDiags("class C { [Teardown] void s() { } }");
    Assert.Equal(true, teHas(d, "E0915"));
}

// 多个 kind attr 同贴 → 按首个出现者定码，只报一次。
[Test]
void test_r6_first_kind_attr_wins() {
    var d = teDiags("class C { [Test] [Benchmark] void t() { } }");
    Assert.Equal(1, teCount(d, "E0911"));
    Assert.Equal(0, teCount(d, "E0912"));
}

// ── R7 不越界 ───────────────────────────────────────────────────────────────

// 修饰类 attribute 单独出现 → 本 pass 不管（孤儿修饰归 Out of Scope）。
[Test]
void test_r7_modifier_attr_alone_not_checked() {
    var d = teDiags("class C { [Skip(reason: \"x\")] void f() { } }");
    Assert.Equal(false, teHas(d, "E0911"));
    Assert.Equal(false, teHas(d, "E0912"));
    Assert.Equal(false, teHas(d, "E0915"));
}

// kind attr 贴在非方法声明上 → 本 pass 不管（Inner 非 MethodDecl）。
[Test]
void test_r7_attr_on_class_not_checked() {
    Assert.Equal(false, teHas(teDiags("[Test] class Foo { }"), "E0911"));
}

[Test]
void test_r7_attr_on_field_not_checked() {
    Assert.Equal(false, teHas(teDiags("class C { [Test] int f; }"), "E0911"));
}

// R2–R5 可并发报出：位置合法但同时「有返回值」+「有参数」→ 两条。
[Test]
void test_r7_signature_violations_reported_together() {
    var d = teDiags("[Test] int t(int x) { return x; }");
    Assert.Equal(2, teCount(d, "E0911"));
}

// ── 相位回归（design §3.2）：form-2 benchmark 必须编译通过 ────────────────────
// [Benchmark] void f(Bencher b) 是**合法**写法，BenchmarkDesugar 会脱糖成零参 wrapper。
// 本 pass 若被移到 RunAst 之前，这条会红 —— 它是相位约束的哨兵。
[Test]
void test_phase_form2_benchmark_survives_desugar() {
    var p = new Parser("class Bencher { } [Benchmark] void b(Bencher bb) { }", "t.z42");
    var cu = HandlerRegistry.RunAst(p.ParseCompilationUnit());
    var coll = new SymbolCollector();
    coll.Collect(cu);
    Assert.Equal(false, teHas(coll.Diags, "E0912"));
}

// ════════════════════════════════════════════════════════════════════════════
// complete-test-attr-arg-checks —— 实参语义（E0913 / E0914 / E0917）
// 逐条对应 specs/test-attribute-args/spec.md 的 A1–A6。
// ════════════════════════════════════════════════════════════════════════════

// ── A1 [Skip] 的 reason 必填且非空 ──────────────────────────────────────────

[Test]
void test_a1_skip_missing_reason() {
    Assert.Equal(true, teHas(teDiags("[Test] [Skip] void t() { }"), "E0914"));
}

[Test]
void test_a1_skip_empty_reason() {
    Assert.Equal(true, teHas(teDiags("[Test] [Skip(reason: \"\")] void t() { }"), "E0914"));
}

[Test]
void test_a1_skip_with_reason_ok() {
    Assert.Equal(false, teHas(teDiags("[Test] [Skip(reason: \"flaky\")] void t() { }"), "E0914"));
}

// ── A2 [Skip] / [Ignore] 必须与 kind attr 同贴 ──────────────────────────────

[Test]
void test_a2_skip_orphan() {
    var d = teDiags("[Skip(reason: \"x\")] void t() { }");
    Assert.Equal(true, teHas(d, "E0914"));
    Assert.Equal(true, teMsg(d, "E0914").Contains("requires `[Test]`"));
}

[Test]
void test_a2_ignore_orphan() {
    Assert.Equal(true, teHas(teDiags("[Ignore] void t() { }"), "E0914"));
}

[Test]
void test_a2_ignore_with_benchmark_ok() {
    Assert.Equal(false, teHas(teDiags("[Benchmark] [Ignore] void b() { }"), "E0914"));
}

// ── A3 [Timeout] 的 milliseconds 必填且为正 ─────────────────────────────────

[Test]
void test_a3_timeout_missing_arg() {
    Assert.Equal(true, teHas(teDiags("[Test] [Timeout] void t() { }"), "E0917"));
}

[Test]
void test_a3_timeout_zero() {
    var d = teDiags("[Test] [Timeout(milliseconds: 0)] void t() { }");
    Assert.Equal(true, teHas(d, "E0917"));
    Assert.Equal(true, teMsg(d, "E0917").Contains("positive"));
}

[Test]
void test_a3_timeout_positive_ok() {
    Assert.Equal(false, teHas(teDiags("[Test] [Timeout(milliseconds: 5000)] void t() { }"), "E0917"));
}

// ── A4 [ShouldThrow] 必须带类型实参 ─────────────────────────────────────────

[Test]
void test_a4_shouldthrow_bare() {
    var d = teDiags("[Test] [ShouldThrow] void t() { }");
    Assert.Equal(true, teHas(d, "E0913"));
    Assert.Equal(true, teMsg(d, "E0913").Contains("type argument"));
}

// ── A5 E 必须（传递地）派生 Exception ───────────────────────────────────────

[Test]
void test_a5_non_exception_type() {
    var d = teDiags("class Plain { } [Test] [ShouldThrow<Plain>] void t() { }");
    Assert.Equal(true, teHas(d, "E0913"));
    Assert.Equal(true, teMsg(d, "E0913").Contains("Exception"));
}

[Test]
void test_a5_direct_subclass_ok() {
    var src = "class Exception { } class MyError : Exception { } [Test] [ShouldThrow<MyError>] void t() { }";
    Assert.Equal(false, teHas(teDiags(src), "E0913"));
}

[Test]
void test_a5_transitive_subclass_ok() {
    var src = "class Exception { } class A : Exception { } class B : A { } [Test] [ShouldThrow<B>] void t() { }";
    Assert.Equal(false, teHas(teDiags(src), "E0913"));
}

[Test]
void test_a5_exception_itself_ok() {
    Assert.Equal(false, teHas(teDiags("class Exception { } [Test] [ShouldThrow<Exception>] void t() { }"), "E0913"));
}

// 刻意保守：符号表里解析不到就不报（跨包 / 表不完整时会误伤，宁可漏报不误报）。
[Test]
void test_a5_unresolvable_type_not_reported() {
    Assert.Equal(false, teHas(teDiags("[Test] [ShouldThrow<Nonexistent>] void t() { }"), "E0913"));
}

// ── A6 不越界 ───────────────────────────────────────────────────────────────

// 非测试 attribute 上的同名命名参不受影响。
[Test]
void test_a6_non_test_attr_with_same_named_args() {
    var d = teDiags("[Doc(reason: \"\", milliseconds: 0)] void t() { }");
    Assert.Equal(false, teHas(d, "E0914"));
    Assert.Equal(false, teHas(d, "E0917"));
}

// 位置违规时不叠加实参诊断（沿用 R1 短路）。
[Test]
void test_a6_position_error_short_circuits_arg_checks() {
    var d = teDiags("class C { [Test] [Skip] void t() { } }");
    Assert.Equal(true, teHas(d, "E0911"));
    Assert.Equal(false, teHas(d, "E0914"));
}

// ════════════════════════════════════════════════════════════════════════════
// enforce-attribute-const-args —— store-meta attribute 的实参须编译期常量（E0500）
//
// 修前**零检查**：`[Tag(K.Make())]`（方法调用）与 `[Num(K.Mutable)]`（可变静态字段）都放行，
// 而 attribute 工厂是**首次反射查询**时才跑的 ⇒ 读回的元数据取决于谁先查、以及那一刻的
// 可变状态。白名单（User 裁决）＝常量 + enum 成员 + const 字段 + typeof + methodof + 数组。
// ════════════════════════════════════════════════════════════════════════════

// 被检查的 attribute 声明 + 一个提供 const / 可变静态 / 方法的宿主类。
string acPrelude() {
    return "class TagAttribute : Std.Attribute { public string V; public TagAttribute(string v) { this.V = v; } } "
         + "class NumAttribute : Std.Attribute { public int N; public NumAttribute(int n) { this.N = n; } } "
         + "class ArrAttribute : Std.Attribute { public int[] A; public ArrAttribute(int[] a) { this.A = a; } } "
         + "class K { public const int MAX = 7; public static int Mutable = 1; public static string Make() { return \"m\"; } } "
         + "enum Color { Red, Green } ";
}

// ── 放行：字面量 / 常量表达式 / enum 成员 / const 字段 / typeof / methodof / 数组 ──

[Test]
void test_e0500_literal_ok() {
    Assert.Equal(false, teHas(teDiags(acPrelude() + "[Tag(\"x\")] class C { }"), "E0500"));
}

[Test]
void test_e0500_const_expression_ok() {
    Assert.Equal(false, teHas(teDiags(acPrelude() + "[Num(1 + 2 * 3)] class C { }"), "E0500"));
    Assert.Equal(false, teHas(teDiags(acPrelude() + "[Num(-5)] class C { }"), "E0500"));
    Assert.Equal(false, teHas(teDiags(acPrelude() + "[Tag(\"a\" + \"b\")] class C { }"), "E0500"));
}

[Test]
void test_e0500_enum_member_ok() {
    Assert.Equal(false, teHas(teDiags(acPrelude()
        + "class KindAttribute : Std.Attribute { public Color C; public KindAttribute(Color c) { this.C = c; } } "
        + "[Kind(Color.Green)] class C { }"), "E0500"));
}

[Test]
void test_e0500_const_field_ok() {
    // 限定名 `K.MAX`，以及**同类内**的裸名 `MAX`。
    Assert.Equal(false, teHas(teDiags(acPrelude() + "[Num(K.MAX)] class C { }"), "E0500"));
    Assert.Equal(false, teHas(teDiags(acPrelude() + "[Num(K.MAX + 1)] class C { }"), "E0500"));
    Assert.Equal(false, teHas(teDiags(acPrelude()
        + "class H { public const int LIMIT = 3; [Num(LIMIT)] public int f; }"), "E0500"));
}

[Test]
void test_e0500_typeof_and_methodof_ok() {
    Assert.Equal(false, teHas(teDiags(acPrelude()
        + "class TyAttribute : Std.Attribute { public Std.Type T; public TyAttribute(Std.Type t) { this.T = t; } } "
        + "[Ty(typeof(K))] class C { }"), "E0500"));
    // methodof 在 attribute 实参位是本特性的招牌用例（src/tests/attributes/methodof_in_attribute.z42）。
    Assert.Equal(false, teHas(teDiags(acPrelude()
        + "class HAttribute : Std.Attribute { public Std.Reflection.MethodInfo M; public HAttribute(Std.Reflection.MethodInfo m) { this.M = m; } } "
        + "[H(methodof(K.Make))] class C { }"), "E0500"));
}

[Test]
void test_e0500_array_of_constants_ok() {
    Assert.Equal(false, teHas(teDiags(acPrelude() + "[Arr(new int[]{1, 2, K.MAX})] class C { }"), "E0500"));
}

// ── 拒绝：方法调用 / 可变静态字段 / new 对象 / lambda ────────────────────────

[Test]
void test_e0500_method_call_rejected() {
    Assert.Equal(true, teHas(teDiags(acPrelude() + "[Tag(K.Make())] class C { }"), "E0500"));
}

[Test]
void test_e0500_mutable_static_field_rejected() {
    // 与 `K.MAX` 语法**完全相同**（`A.B`）—— 判据必须问「那个字段是不是 const」，
    // 只看形状的实现会把这一格放过去。
    Assert.Equal(true, teHas(teDiags(acPrelude() + "[Num(K.Mutable)] class C { }"), "E0500"));
}

[Test]
void test_e0500_object_creation_rejected() {
    Assert.Equal(true, teHas(teDiags(acPrelude() + "[Tag(new K())] class C { }"), "E0500"));
}

[Test]
void test_e0500_array_with_non_constant_element_rejected() {
    Assert.Equal(true, teHas(teDiags(acPrelude() + "[Arr(new int[]{1, K.Mutable})] class C { }"), "E0500"));
}

// ── 载体覆盖：方法 / 字段 / 属性 / 形参上的 attribute 同样受检 ────────────────

[Test]
void test_e0500_all_carriers_checked() {
    Assert.Equal(true, teHas(teDiags(acPrelude()
        + "class C { [Tag(K.Make())] public void m() { } }"), "E0500"));
    Assert.Equal(true, teHas(teDiags(acPrelude()
        + "class C { [Tag(K.Make())] public int f; }"), "E0500"));
    Assert.Equal(true, teHas(teDiags(acPrelude()
        + "class C { [Tag(K.Make())] public int P { get; set; } }"), "E0500"));
    Assert.Equal(true, teHas(teDiags(acPrelude()
        + "class C { public void m([Tag(K.Make())] int x) { } }"), "E0500"));
    // 顶层函数（反射拿不到它的 MethodInfo，但实参照样会被执行）。
    Assert.Equal(true, teHas(teDiags(acPrelude() + "[Tag(K.Make())] void f() { }"), "E0500"));
}

// ── 命名实参走的是 AssignExpr 载体，值那一侧同样受检 ────────────────────────

[Test]
void test_e0500_named_argument_value_checked() {
    Assert.Equal(true, teHas(teDiags(acPrelude()
        + "class RouteAttribute : Std.Attribute { public string P; public string M; "
        + "public RouteAttribute(string p, string m = \"GET\") { this.P = p; this.M = m; } } "
        + "[Route(\"/u\", m: K.Make())] class C { }"), "E0500"));
}

// ── 阴性对照：directive / test 家族不归本门管 ───────────────────────────────

[Test]
void test_e0500_directive_attrs_exempt() {
    // `[Native]` / `[Deprecated]` / `[Record]` / `[Test]` 各有自己的实参规则，不合成工厂。
    var d = teDiags(acPrelude() + "class C { [Native(\"__x\")] public extern int m(); }");
    Assert.Equal(false, teHas(d, "E0500"));
    Assert.Equal(false, teHas(teDiags("[Test] void t() { }"), "E0500"));
}
