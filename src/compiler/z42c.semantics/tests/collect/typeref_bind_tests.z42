// enforce-fqn-name-identity **B3** —— 名字 → 名义身份句柄（`TypeRef`）的绑定。
//
// 覆盖 `SymbolTable.BindTypeRefs`（跑在 `InternAllTypes()` 之后）把
// `Z42ClassType.InterfaceNames[i]` / `Z42InterfaceType.BaseNames[i]` 解析成 `TypeIntern` 的 id，
// 写进平行的 `Interfaces[i]` / `Bases[i]`。
//
// ⚠️ 用例**必须带 `namespace`**：不带的话 `Fqn()` 退化成短名，FQ 与短名分不开、断言恒绿
// = 空门。阶段 0 的 0.5 项就是为这个立的（既有用例源码都没有 namespace）。
//
// ⚠️ **覆盖范围**：本文件的 `collect()` 走 `SymbolCollector.Collect`（三个挂载点之一）。
// 另两处（`CollectAll` / `CollectWithImports`）要多 CU / 导入上下文才压得到，由 stdlib 自举
// 与 cross-zpkg 端到端兜 —— 三处漏挂任一处，那条路上的句柄会全是 0 且**静默**
// （见 `parallel-pass-sequences-miss-new-hook`）。
//
// 单独成文件而不是追加进 `collect_tests.z42`：后者已 854 行，逼近 886 行硬限。
namespace Z42cSemanticsTypeRefBindTests;

using Std;

using Std.Test;
using Z42.Syntax;
using Z42.Semantics;

SymbolTable collect(string src) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    return new SymbolCollector().Collect(cu);
}

// 类实现的接口绑上了句柄，且句柄指回同一个接口对象。
[Test]
void test_class_iface_ref_bound() {
    var t = collect("namespace Demo; interface IA { } class Foo : IA { }");
    var foo = t.GetClass("Foo");
    var ia = t.GetInterface("Demo.IA");
    Assert.Equal(1, foo.InterfaceCount);
    Assert.Equal(true, foo.Interfaces != null && foo.Interfaces.Length > 0);
    Assert.Equal(true, foo.Interfaces[0] != 0);                // 绑上了（0 = 未绑定）
    Assert.Equal(true, t.Intern.At(foo.Interfaces[0]) == ia);  // 句柄指回同一个对象
    Assert.Equal(ia.TypeId, foo.Interfaces[0]);
}

// 接口的父接口链同样绑上句柄（`BaseNames` 那根轴 —— 与类那根是两条搬运路）。
[Test]
void test_iface_base_ref_bound() {
    var t = collect("namespace Demo; interface IBase { } interface IDer : IBase { }");
    var der = t.GetInterface("Demo.IDer");
    var bas = t.GetInterface("Demo.IBase");
    Assert.Equal(true, der.BaseCount > 0);
    Assert.Equal(true, der.Bases != null && der.Bases.Length > 0);
    Assert.Equal(bas.TypeId, der.Bases[0]);
}

// 🔴 门：在表里查得到、句柄却仍是 0 ⇒ 绑定 pass 漏跑。正常收集后必须为空。
// 这道门只挑**矛盾**的那种；合法的「看不见所以绑不到」不算，否则会对正常工程狂叫。
[Test]
void test_no_unbound_iface_ref_after_collect() {
    var t = collect("namespace Demo; interface IBase { } interface IDer : IBase { } class Foo : IDer { }");
    Assert.Equal("", t.FirstUnboundIfaceRef());
}

// 🔴 **0（未绑定）不得参与相等判定** —— 句柄化独有的陷阱：
// 目标与实现方两边都绑不到时 `0 == 0` 会撞成假阳性，而「绑不到」是**合法状态**
// （消费方不必看得见它实现的每个接口）。用一个根本不存在的接口名做探针：
// 它 `_refOfIface` 得 0，若 0 参与判定就会与任何未绑定槽相等。
[Test]
void test_zero_ref_never_matches() {
    var t = collect("namespace Demo; interface IA { } class Foo : IA { }");
    Assert.Equal(false, t.Implements("Foo", "INotDeclaredAnywhere"));
    Assert.Equal(false, t.Implements("Foo", "Demo.INotDeclaredAnywhere"));
    // 对照：真实现的那个仍判 true，短名与 FQN 两种拼写都要认
    Assert.Equal(true, t.Implements("Foo", "IA"));
    Assert.Equal(true, t.Implements("Foo", "Demo.IA"));
}

// 句柄化不改变传递闭包的答案（`Foo : IDer : IBase` ⇒ Foo 实现 IBase）。
// 这条同时压住 `Implements` 的 BFS 种子与 `_anyInterfaceDerivesFrom` 的父链展开两段。
[Test]
void test_transitive_still_holds_with_refs() {
    var t = collect("namespace Demo; interface IBase { } interface IDer : IBase { } class Foo : IDer { }");
    Assert.Equal(true, t.Implements("Foo", "Demo.IBase"));
    Assert.Equal(true, t.Implements("Foo", "IBase"));
    Assert.Equal(false, t.Implements("Foo", "Demo.INope"));
}

// 绑定是幂等的：`BindTypeRefs` 在多轮收集里会被反复调，已绑定的槽不得被改写。
[Test]
void test_bind_is_idempotent() {
    var t = collect("namespace Demo; interface IA { } class Foo : IA { }");
    var foo = t.GetClass("Foo");
    int before = foo.Interfaces[0];
    t.BindTypeRefs();
    Assert.Equal(before, foo.Interfaces[0]);
}

// ── B4：类的基类那根轴（`BaseName` → `Base`）────────────────────────────────

// 基类绑上了句柄，且句柄指回同一个类对象。
[Test]
void test_class_base_ref_bound() {
    var t = collect("namespace Demo; class A { } class B : A { }");
    var b = t.GetClass("B");
    var a = t.GetClass("A");
    Assert.Equal(true, b.HasBase);
    Assert.Equal(true, b.Base != 0);
    Assert.Equal(a.TypeId, b.Base);
    Assert.Equal(true, t.Intern.At(b.Base) == a);
}

// 沿 base 链的判定：两层继承，短名与 FQN 两种拼写都要认。
[Test]
void test_is_subclass_of_with_refs() {
    var t = collect("namespace Demo; class A { } class B : A { } class C : B { }");
    Assert.Equal(true, t.IsSubclassOf("C", "B"));
    Assert.Equal(true, t.IsSubclassOf("B", "A"));
    Assert.Equal(false, t.IsSubclassOf("A", "C"));
    // 🔴🔴 下面两条是 **B4 修好的一个静默错值**，不是「保持原状」的回归门。
    // `BaseName` 从不经过归一 pass（那个 pass 只归一接口那两根轴）⇒ 它存的是**源码里写的短名**。
    // B4 之前实测（探针跑在不带 B4 的编译器上）：
    //   `B4PROBE B.BaseName=A | C<:B(short)=T | C<:Demo.A(fqn)=F | B<:Demo.A(fqn)=F`
    // —— 同一个继承关系，换成 FQN 拼写就答 **false**，与 B2 那两条「导入边界剥 ns」同族。
    // 句柄化后两种拼写解析到同一个 id ⇒ 都答 true。**撤掉 B4 这两条就会红。**
    Assert.Equal(true, t.IsSubclassOf("C", "Demo.A"));
    Assert.Equal(true, t.IsSubclassOf("B", "Demo.A"));
}

// 🔴 0（未绑定）不得参与判定 —— 同 B3 那条，换成基类轴再压一遍：
// 一个根本不存在的类名 `_refOfClass` 得 0，若 0 参与判定就会与任何未绑定的 `Base` 相等。
[Test]
void test_base_zero_ref_never_matches() {
    var t = collect("namespace Demo; class A { } class B : A { }");
    Assert.Equal(false, t.IsSubclassOf("B", "ANotDeclaredAnywhere"));
    Assert.Equal(false, t.IsSubclassOf("B", "Demo.ANotDeclaredAnywhere"));
    Assert.Equal(true, t.IsSubclassOf("B", "A"));
}

// 门覆盖基类轴：正常收集后不得有「查得到却没绑」的基类。
[Test]
void test_no_unbound_base_ref_after_collect() {
    var t = collect("namespace Demo; class A { } class B : A { } class C : B { }");
    Assert.Equal("", t.FirstUnboundIfaceRef());
}

// ── A4：base 链走查**脱离名字** ────────────────────────────────────────────
//
// 入口按名字查一次，之后每跳走 `ct.Base` 句柄（数组索引、零字符串哈希）。
// 这条守的是**那条路还在**：整条链上每一层都必须绑上句柄，否则走查会退回按名字查
// （功能上仍对、但性能收益没了，而那是**静默**的 —— 没有任何断言会红）。
[Test]
void test_base_chain_is_fully_handle_linked() {
    var t = collect("namespace Demo; class A { } class B : A { } class C : B { } class D : C { }");
    // 从 D 起沿 Base 句柄一路走到 A，全程不碰名字表
    var cur = t.GetClass("D");
    int hops = 0;
    while (cur != null && cur.HasBase) {
        Assert.Equal(true, cur.Base != 0);          // ← 断链就会红
        cur = t.Intern.At(cur.Base) as Z42ClassType;
        hops = hops + 1;
    }
    Assert.Equal(3, hops);                           // D→C→B→A
    Assert.Equal(true, cur != null);
    Assert.Equal("A", cur.Name());                   // 走到链顶
    // 判定结果与走查一致
    Assert.Equal(true, t.IsSubclassOf("D", "Demo.A"));
    Assert.Equal(true, t.IsSubclassOf("D", "B"));
    Assert.Equal(false, t.IsSubclassOf("A", "D"));
}

// 接口那半边同样沿 base 链收集（`Implements` 的种子来自各层的 `Interfaces`）。
// 这条压的是「A4 换成句柄走查后，**继承来的**接口仍被收集到」。
[Test]
void test_implements_collects_inherited_ifaces_via_handles() {
    var t = collect("namespace Demo; interface IA { } class A : IA { } class B : A { } class C : B { }");
    Assert.Equal(true, t.Implements("C", "Demo.IA"));   // 隔两层继承拿到
    Assert.Equal(true, t.Implements("B", "IA"));
    Assert.Equal(false, t.Implements("C", "Demo.INope"));
}
