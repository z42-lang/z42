// enforce-fqn-name-identity **B3** —— 名字 → 名义身份句柄（`TypeRef`）的绑定。
//
// 覆盖 `SymbolTable.BindTypeRefs`（跑在 `InternAllTypes()` 之后）把
// `Z42ClassType.InterfaceNames[i]` / `Z42InterfaceType.BaseNames[i]` 解析成 `TypeIntern` 的 id，
// 写进平行的 `Interfaces[i]` / `Bases[i]`。
//
// ⚠️ 用例**必须带 `namespace`**：不带的话 `Fqn()` 退化成短名，FQ 与短名分不开、断言恒绿
// = 空门。阶段 0 的 0.5 项就是为这个立的（既有用例源码都没有 namespace）。
//
// ⚠️ **覆盖范围**：本文件的 `collect()` 走 `SymbolCollector.Collect`（三个挂载点之一）。
// 另两处（`CollectAll` / `CollectWithImports`）要多 CU / 导入上下文才压得到，由 stdlib 自举
// 与 cross-zpkg 端到端兜 —— 三处漏挂任一处，那条路上的句柄会全是 0 且**静默**
// （见 `parallel-pass-sequences-miss-new-hook`）。
//
// 单独成文件而不是追加进 `collect_tests.z42`：后者已 854 行，逼近 886 行硬限。
namespace Z42cSemanticsTypeRefBindTests;


using Z42.Syntax;
using Z42.IR;        // StrMap（`Methods` 的类型）
using Z42.Semantics;
using Z42.Core;     // DiagnosticBag（A5b-2b-3 的 sealed 用例）

SymbolTable collect(string src) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    return new SymbolCollector().Collect(cu);
}

// ⚠️ `Collect` **不**播 `Object` 骨架 —— 只有 `CollectWithImports` / `CollectAll` 播
// （`_seedObjectStub` 只挂在那两处）。要压 `Object` 的身份就得走这条。
// `imported = null` 是合法输入：三个 `_merge*` 都对 null 早返回。
SymbolTable collectWithObjectStub(string src) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    return new SymbolCollector().CollectWithImports(cu, null);
}

// 类实现的接口绑上了句柄，且句柄指回同一个接口对象。
[Test]
void test_class_iface_ref_bound() {
    var t = collect("namespace Demo; interface IA { } class Foo : IA { }");
    var foo = t.GetClass("Foo");
    var ia = t.GetInterface("Demo.IA");
    Assert.Equal(1, foo.InterfaceCount);
    Assert.Equal(true, foo.Interfaces != null && foo.Interfaces.Length > 0);
    Assert.Equal(true, foo.Interfaces[0] != 0);                // 绑上了（0 = 未绑定）
    Assert.Equal(true, t.Intern.At(foo.Interfaces[0]) == ia);  // 句柄指回同一个对象
    Assert.Equal(ia.TypeId, foo.Interfaces[0]);
}

// 接口的父接口链同样绑上句柄（`BaseNames` 那根轴 —— 与类那根是两条搬运路）。
[Test]
void test_iface_base_ref_bound() {
    var t = collect("namespace Demo; interface IBase { } interface IDer : IBase { }");
    var der = t.GetInterface("Demo.IDer");
    var bas = t.GetInterface("Demo.IBase");
    Assert.Equal(true, der.BaseCount > 0);
    Assert.Equal(true, der.Bases != null && der.Bases.Length > 0);
    Assert.Equal(bas.TypeId, der.Bases[0]);
}

// 🔴 门：在表里查得到、句柄却仍是 0 ⇒ 绑定 pass 漏跑。正常收集后必须为空。
// 这道门只挑**矛盾**的那种；合法的「看不见所以绑不到」不算，否则会对正常工程狂叫。
[Test]
void test_no_unbound_iface_ref_after_collect() {
    var t = collect("namespace Demo; interface IBase { } interface IDer : IBase { } class Foo : IDer { }");
    Assert.Equal("", t.FirstUnboundIfaceRef());
}

// 🔴 **0（未绑定）不得参与相等判定** —— 句柄化独有的陷阱：
// 目标与实现方两边都绑不到时 `0 == 0` 会撞成假阳性，而「绑不到」是**合法状态**
// （消费方不必看得见它实现的每个接口）。用一个根本不存在的接口名做探针：
// 它 `_refOfIface` 得 0，若 0 参与判定就会与任何未绑定槽相等。
[Test]
void test_zero_ref_never_matches() {
    var t = collect("namespace Demo; interface IA { } class Foo : IA { }");
    Assert.Equal(false, t.Implements("Foo", "INotDeclaredAnywhere"));
    Assert.Equal(false, t.Implements("Foo", "Demo.INotDeclaredAnywhere"));
    // 对照：真实现的那个仍判 true，短名与 FQN 两种拼写都要认
    Assert.Equal(true, t.Implements("Foo", "IA"));
    Assert.Equal(true, t.Implements("Foo", "Demo.IA"));
}

// 句柄化不改变传递闭包的答案（`Foo : IDer : IBase` ⇒ Foo 实现 IBase）。
// 这条同时压住 `Implements` 的 BFS 种子与 `_anyInterfaceDerivesFrom` 的父链展开两段。
[Test]
void test_transitive_still_holds_with_refs() {
    var t = collect("namespace Demo; interface IBase { } interface IDer : IBase { } class Foo : IDer { }");
    Assert.Equal(true, t.Implements("Foo", "Demo.IBase"));
    Assert.Equal(true, t.Implements("Foo", "IBase"));
    Assert.Equal(false, t.Implements("Foo", "Demo.INope"));
}

// 绑定是幂等的：`BindTypeRefs` 在多轮收集里会被反复调，已绑定的槽不得被改写。
[Test]
void test_bind_is_idempotent() {
    var t = collect("namespace Demo; interface IA { } class Foo : IA { }");
    var foo = t.GetClass("Foo");
    int before = foo.Interfaces[0];
    t.BindTypeRefs();
    Assert.Equal(before, foo.Interfaces[0]);
}

// ── B4：类的基类那根轴（`BaseName` → `Base`）────────────────────────────────

// 基类绑上了句柄，且句柄指回同一个类对象。
[Test]
void test_class_base_ref_bound() {
    var t = collect("namespace Demo; class A { } class B : A { }");
    var b = t.GetClass("B");
    var a = t.GetClass("A");
    Assert.Equal(true, b.HasBase);
    Assert.Equal(true, b.Base != 0);
    Assert.Equal(a.TypeId, b.Base);
    Assert.Equal(true, t.Intern.At(b.Base) == a);
}

// 沿 base 链的判定：两层继承，短名与 FQN 两种拼写都要认。
[Test]
void test_is_subclass_of_with_refs() {
    var t = collect("namespace Demo; class A { } class B : A { } class C : B { }");
    Assert.Equal(true, t.IsSubclassOf("C", "B"));
    Assert.Equal(true, t.IsSubclassOf("B", "A"));
    Assert.Equal(false, t.IsSubclassOf("A", "C"));
    // 🔴🔴 下面两条是 **B4 修好的一个静默错值**，不是「保持原状」的回归门。
    // `BaseName` 从不经过归一 pass（那个 pass 只归一接口那两根轴）⇒ 它存的是**源码里写的短名**。
    // B4 之前实测（探针跑在不带 B4 的编译器上）：
    //   `B4PROBE B.BaseName=A | C<:B(short)=T | C<:Demo.A(fqn)=F | B<:Demo.A(fqn)=F`
    // —— 同一个继承关系，换成 FQN 拼写就答 **false**，与 B2 那两条「导入边界剥 ns」同族。
    // 句柄化后两种拼写解析到同一个 id ⇒ 都答 true。**撤掉 B4 这两条就会红。**
    Assert.Equal(true, t.IsSubclassOf("C", "Demo.A"));
    Assert.Equal(true, t.IsSubclassOf("B", "Demo.A"));
}

// 🔴 0（未绑定）不得参与判定 —— 同 B3 那条，换成基类轴再压一遍：
// 一个根本不存在的类名 `_refOfClass` 得 0，若 0 参与判定就会与任何未绑定的 `Base` 相等。
[Test]
void test_base_zero_ref_never_matches() {
    var t = collect("namespace Demo; class A { } class B : A { }");
    Assert.Equal(false, t.IsSubclassOf("B", "ANotDeclaredAnywhere"));
    Assert.Equal(false, t.IsSubclassOf("B", "Demo.ANotDeclaredAnywhere"));
    Assert.Equal(true, t.IsSubclassOf("B", "A"));
}

// 门覆盖基类轴：正常收集后不得有「查得到却没绑」的基类。
[Test]
void test_no_unbound_base_ref_after_collect() {
    var t = collect("namespace Demo; class A { } class B : A { } class C : B { }");
    Assert.Equal("", t.FirstUnboundIfaceRef());
}

// ── A4：base 链走查**脱离名字** ────────────────────────────────────────────
//
// 入口按名字查一次，之后每跳走 `ct.Base` 句柄（数组索引、零字符串哈希）。
// 这条守的是**那条路还在**：整条链上每一层都必须绑上句柄，否则走查会退回按名字查
// （功能上仍对、但性能收益没了，而那是**静默**的 —— 没有任何断言会红）。
[Test]
void test_base_chain_is_fully_handle_linked() {
    var t = collect("namespace Demo; class A { } class B : A { } class C : B { } class D : C { }");
    // 从 D 起沿 Base 句柄一路走到 A，全程不碰名字表
    var cur = t.GetClass("D");
    int hops = 0;
    while (cur != null && cur.HasBase) {
        Assert.Equal(true, cur.Base != 0);          // ← 断链就会红
        cur = t.Intern.At(cur.Base) as Z42ClassType;
        hops = hops + 1;
    }
    Assert.Equal(3, hops);                           // D→C→B→A
    Assert.Equal(true, cur != null);
    Assert.Equal("A", cur.Name());                   // 走到链顶
    // 判定结果与走查一致
    Assert.Equal(true, t.IsSubclassOf("D", "Demo.A"));
    Assert.Equal(true, t.IsSubclassOf("D", "B"));
    Assert.Equal(false, t.IsSubclassOf("A", "D"));
}

// ── A5b-1：合成的 `Object` 骨架必须带**真身份** ────────────────────────────
//
// 🔴 这条守的是「同一个 `Object` 只有一个名义身份」。
// `_seedObjectStub` 造的骨架代表的就是 `Std.Object`，但它此前**既没有 `Namespace`**
// （`Z42ClassType` 的构造函数把它默认成 `""`、由注册方覆写，而那里从没写过）
// **也不进 `ClassesByFqn`** ⇒ `Fqn()` 退化成裸 `Object`，与真·导入的 `Std.Object`
// 成了两个不同的对象、两个不同的 intern id。
//
// 实测规模（全量 `build stdlib`，探针）：`fqn=Object` **4975** 次 · `fqn=Std.Object` **887** 次。
// 在「句柄即身份」的模型下 `_sameRef` 会判这两个不是同一个类型。
//
// ⭐ 第三条断言顺带压住 `GetClass` 的 **FQN 分支** —— 实测全量构建里那条分支
// **21,078 次一次都没命中过**（调用方从不喂 FQN 进来）。这里至少让它有一个真消费方。
[Test]
void test_object_stub_carries_prelude_identity() {
    var t = collectWithObjectStub("namespace Demo; class A { }");
    var obj = t.GetClass("Object");
    Assert.Equal(true, obj != null);
    Assert.Equal("Std.Object", obj.Fqn());                 // ← 修前是裸 "Object"
    Assert.Equal(true, t.GetClass("Std.Object") == obj);   // ← 修前 FQN 视图里根本没有它
    Assert.Equal(true, obj.TypeId != 0);                   // 且已 intern（InternAllTypes 排在桩之后）
}

// ── A5b-2：同短名跨 ns 时，**两份都要有成员** ──────────────────────────────
//
// 🔴 这条守的是一个**「两边一起错、错得一致」所以谁也发现不了**的缺陷：
// `MemberCollector._fillClass` 此前用 `table.Classes.Get(key)` 直接摸**裸名表**
// （后来者覆盖、只活一份），而 `DeclBinder._bindClass` 用 `symbols.GetClass(...)`。
// 两边口径相同时一起解析到赢家 ⇒ 输家那份 `Z42ClassType` **一个成员都没有**，
// 而没有任何断言会红 —— 直到 `GetClass` 改成作用域感知，不一致才炸成
// `FieldGet: ... got Null`（`ns_same_short_name` e2e 实测）。
//
// ⚠️ 既有的 `ns_same_short_name` 用例**发现不了「一起错」**，只在一侧变对时才红。
// 所以这里补一条**正面**断言：两份各自都要查得到、且各自都要有自己的成员。
SymbolTable collectTwoNs(string a, string b) {
    var pa = new Parser(a, "a.z42"); var cua = pa.ParseCompilationUnit();
    var pb = new Parser(b, "b.z42"); var cub = pb.ParseCompilationUnit();
    CompilationUnit[] cus = new CompilationUnit[2]; cus[0] = cua; cus[1] = cub;
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    return new SymbolCollector().CollectAll(cus, files, 2, null);
}

[Test]
void test_same_short_name_across_ns_both_get_members() {
    var t = collectTwoNs("namespace A; public class Foo { public int V; public int Ga() { return 1; } }",
                         "namespace B; public class Foo { public int V; public int Gb() { return 2; } }");
    var fa = t.GetClass("A.Foo");
    var fb = t.GetClass("B.Foo");
    Assert.Equal(true, fa != null);
    Assert.Equal(true, fb != null);
    Assert.Equal(false, fa == fb);                      // 两个**不同**的名义类型
    Assert.Equal("A.Foo", fa.Fqn());
    Assert.Equal("B.Foo", fb.Fqn());
    // 🔴 核心：**各自都有自己的成员**。修前输家那份是空壳（方法表里什么都没有）。
    Assert.Equal(true, fa.Methods.ContainsKey("Ga"));
    Assert.Equal(true, fb.Methods.ContainsKey("Gb"));
    // 且不会串味：A 的那份不该有 B 的方法
    Assert.Equal(false, fa.Methods.ContainsKey("Gb"));
    Assert.Equal(false, fb.Methods.ContainsKey("Ga"));
    // 句柄也各自独立（B1/B3 的身份轴）
    Assert.Equal(true, fa.TypeId != 0 && fb.TypeId != 0);
    Assert.Equal(false, fa.TypeId == fb.TypeId);
}

// 接口那半边同样沿 base 链收集（`Implements` 的种子来自各层的 `Interfaces`）。
// 这条压的是「A4 换成句柄走查后，**继承来的**接口仍被收集到」。
[Test]
void test_implements_collects_inherited_ifaces_via_handles() {
    var t = collect("namespace Demo; interface IA { } class A : IA { } class B : A { } class C : B { }");
    Assert.Equal(true, t.Implements("C", "Demo.IA"));   // 隔两层继承拿到
    Assert.Equal(true, t.Implements("B", "IA"));
    Assert.Equal(false, t.Implements("C", "Demo.INope"));
}

// ── A5b-2b-3：基类名按**声明方的作用域**绑句柄，不是撞裸名表的赢家 ──────────────────────
//
// 🔴 `BaseName` 存的是源码里写的短名，此前由 `BindTypeRefs._bindClassBase` 在**根表**（无作用域）上
// `GetClass(短名)` 绑句柄 ⇒ 外围 ns 那一步形同虚设，落到裸名表的赢家（本地 last-wins）。
// 同包两个 ns 各有一个 `Base` 时，`A.D : Base` 可能绑到 `B.Base` —— 而 A4 之后基类链走查
// **只认句柄** ⇒ `A.Base x = new D();` 报 E0402，且**报不报取决于文件顺序**（实测：b.z42 排在
// a.z42 之后才红；改名让 b 排前就绿）。两种文件序都压一遍，锁住「与顺序无关」。

SymbolTable collectAll2(string a, string b) {
    CompilationUnit[] cus = new CompilationUnit[2];
    cus[0] = new Parser(a, "a.z42").ParseCompilationUnit();
    cus[1] = new Parser(b, "b.z42").ParseCompilationUnit();
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    return new SymbolCollector().CollectAll(cus, files, 2, null);
}

string srcA() { return "namespace A; public class Base { } public class D : Base { }"; }
string srcB() { return "namespace B; public class Base { }"; }

[Test]
void test_base_binds_in_declaring_namespace_either_file_order() {
    var t1 = collectAll2(srcA(), srcB());   // B 后到 ⇒ 裸名表赢家是 B.Base ← 修前这一序绑错
    Assert.Equal("A.Base", t1.BaseOf(t1.GetClass("A.D")).Fqn());
    Assert.Equal(true, t1.IsSubclassOf("A.D", "A.Base"));
    Assert.Equal(false, t1.IsSubclassOf("A.D", "B.Base"));
    var t2 = collectAll2(srcB(), srcA());   // A 后到 ⇒ 赢家碰巧是对的那份
    Assert.Equal("A.Base", t2.BaseOf(t2.GetClass("A.D")).Fqn());
    Assert.Equal(true, t2.IsSubclassOf("A.D", "A.Base"));
}

// 端到端口径：修前这条报 `E0402 cannot assign D to Base`。
[Test]
void test_derived_assigns_to_own_namespace_base_despite_same_named_base_elsewhere() {
    string[] srcs = new string[3];
    srcs[0] = srcA();
    srcs[1] = srcB();
    srcs[2] = "namespace App; using A; void Main() { A.Base x = new D(); }";
    string[] files = new string[3]; files[0] = "a.z42"; files[1] = "b.z42"; files[2] = "main.z42";
    CompiledModuleZ[] cms = IrDump.BuildPackage(srcs, files, 3, null, null, false);
    int n = 0;
    int i = 0;
    while (i < cms.Length) {
        int j = 0;
        while (j < cms[i].DiagCount) { if (cms[i].DiagMsgs[j].IndexOf("E0402") >= 0) { n = n + 1; } j = j + 1; }
        i = i + 1;
    }
    Assert.Equal(0, n);
}

// sealed 检查同一个洞的另一条路：`_passSealedEnforce` 此前按 `table.Classes.ContainsKey(BaseName)` 直接读
// **短名表**（绕过 `BaseOf`，A5a 的自检 grep 只匹配 `GetClass/HasClass` 抓不到）⇒ `B.Base` 是 sealed 时，
// `A.D : A.Base` 被误报 E0427。收敛到 `BaseOf` 后走句柄。
[Test]
void test_sealed_same_named_base_elsewhere_is_not_inherited() {
    CompilationUnit[] cus = new CompilationUnit[2];
    cus[0] = new Parser(srcA(), "a.z42").ParseCompilationUnit();
    cus[1] = new Parser("namespace B; public sealed class Base { }", "b.z42").ParseCompilationUnit();
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    var coll = new SymbolCollector();
    coll.CollectAll(cus, files, 2, null);
    int n = 0;
    int i = 0;
    while (i < coll.Diags.Count()) { if (coll.Diags.Get(i).Code == "E0427") { n = n + 1; } i = i + 1; }
    Assert.Equal(0, n);
}
