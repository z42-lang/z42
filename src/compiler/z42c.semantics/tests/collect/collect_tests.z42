// z42c.semantics SymbolCollector 单测（1A-3）：源 → parse → 符号表（类字段/方法签名 + 顶层 func）。
namespace Z42cSemanticsCollectTests;

using Std;
using Std.Test;
using Z42.Syntax;
using Z42.Semantics;
using Z42.Core;   // add-partial-types：DiagnosticBag/Diagnostic（合并校验断言）

SymbolTable collect(string src) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    return new SymbolCollector().Collect(cu);
}

[Test]
void test_collect_class_members() {
    var table = collect("class Box { private int value; public int Get() { return value; } }");
    Assert.Equal(true, table.HasClass("Box"));
    var box = table.GetClass("Box");
    Assert.Equal(true, box.Fields.ContainsKey("value"));
    var f = box.Fields.Get("value") as FieldSymbol;
    Assert.Equal("int", f.FieldType.Name());
    Assert.Equal("private", f.Visibility);
    Assert.Equal(true, box.Methods.ContainsKey("Get"));
    var m = box.Methods.Get("Get") as MethodSymbol;
    Assert.Equal("()->int", m.Signature.Dump());
    Assert.Equal("public", m.Visibility);
}

[Test]
void test_collect_method_signature_and_static() {
    var table = collect("class Calc { public static int Add(int a, int b) { return a + b; } }");
    var calc = table.GetClass("Calc");
    // 方案A 静态-only：静态方法全签名 mangle → 注册键为 Add$2$i32$i32（非裸 Add）。
    var m = calc.Methods.Get("Add$2$i32$i32") as MethodSymbol;
    Assert.Equal("(int,int)->int", m.Signature.Dump());
    Assert.Equal(true, m.IsStatic);
    Assert.Equal("Calc", m.ContainingTypeName);
}

[Test]
void test_collect_top_level_func() {
    var table = collect("int Add(int a, int b) { return a + b; }");
    Assert.Equal(true, table.HasFunc("Add"));
    var m = table.GetFunc("Add");
    Assert.Equal("(int,int)->int", m.Signature.Dump());
}

[Test]
void test_resolve_class_field_type() {
    // 字段类型为兄弟类（两阶段 stub 保证可解析）
    var table = collect("class Node { } class List { private Node head; }");
    var list = table.GetClass("List");
    var f = list.Fields.Get("head") as FieldSymbol;
    Assert.Equal("Node", f.FieldType.Name());        // 解析到 Z42ClassType
}

// G18 回归：TSIG 继承成员展开（镜像 C# ct.Fields/ct.Methods merge=base∪own）。
// 此前 z42c 只导出自有成员 → 跨包对账 TSIG −598 + 方法序/flags 偏离；gate fixture 无
// base-virtual-override 故未暴露。守护字段继承（祖先在前）+ 方法合并（override 保留祖先位、
// 新方法追加）+ override→flags 0（去 virtual）。
[Test]
void test_tsig_inherited_fields_and_method_merge() {
    string src = "class Base { public int Tag; public virtual string Dump() { return \"b\"; } } "
               + "class Derived : Base { public int Extra; public Derived(int e) { Extra = e; } public override string Dump() { return \"d\"; } }";
    // Base：自有 Tag；方法 Object 四 + 自有 virtual Dump（v）。
    // Derived：继承 Tag 在前、自有 Extra 在后；方法 Object 四 + 继承位 Dump（override→无 v）+ 追加 ctor Derived。
    Assert.Equal(
        "Base(Object) F:[Tag:int] M:[ToString/v,Equals/v,GetHashCode/v,GetType,Dump/v]\n"
      + "Derived(Base) F:[Tag:int,Extra:int] M:[ToString/v,Equals/v,GetHashCode/v,GetType,Dump,Derived]",
        SemanticDump.DumpExports(src));
}

// G18d/G18h 回归：TSIG 全用规范名（byte→u8 等），镜像 C# TypeToString(resolved)——
// 方法返回/参数**与字段一致**走规范名（z42c.project ZpkgReader.Data:byte[] → TSIG u8[] 实证）。
// 区别于 TYPE/SIGS 段用源拼写（byte[]，G18f/g）。
[Test]
void test_tsig_all_canonical_field_and_method() {
    string src = "class W { public byte[] data; public byte[] ToBytes(short n) { return data; } }";
    Assert.Equal("u8[]", SemanticDump.ExportMethodRet(src, "W", "ToBytes"));   // 方法返回规范名
    Assert.Equal("u8[]", SemanticDump.ExportFieldType(src, "W", "data"));      // G18h：字段也规范名
}

// G18d 回归：nullable 在方法签名规范名下结构保留（string? 不被 sig.Name() 擦除为 string）。
[Test]
void test_tsig_method_nullable_return_preserved() {
    string src = "class N { public string? Find(int k) { return null; } }";
    Assert.Equal("string?", SemanticDump.ExportMethodRet(src, "N", "Find"));
}

// G18g 回归：TYPE 段（IrClassDesc）字段类型源拼写（byte[]，非规范 u8[]）——同顶层 SIGS，
// 区别于 TSIG 方法签名规范名（G18d）。int[]（非次要别名）不变。
[Test]
void test_type_section_field_source_spelling() {
    string src = "class W { public byte[] data; public int[] nums; }";
    Assert.Equal("byte[]", SemanticDump.TypeFieldName(src, "W", "data"));
    Assert.Equal("int[]", SemanticDump.TypeFieldName(src, "W", "nums"));
}

// G18 回归：多级继承字段链（topmost 祖先字段最前）+ static 字段不参与继承合并。
[Test]
void test_tsig_multilevel_inheritance_and_static_field() {
    string src = "class A { public int a; } "
               + "class B : A { public int b; public static int counter; } "
               + "class C : B { public int c; }";
    // C 实例字段链：a(A) → b(B) → c(C)；B.counter 是 static 仅在 B 自身（不继承到 C）。
    Assert.Equal(
        "A(Object) F:[a:int] M:[ToString/v,Equals/v,GetHashCode/v,GetType]\n"
      + "B(A) F:[a:int,b:int,counter:int(s)] M:[ToString/v,Equals/v,GetHashCode/v,GetType]\n"
      + "C(B) F:[a:int,b:int,c:int] M:[ToString/v,Equals/v,GetHashCode/v,GetType]",
        SemanticDump.DumpExports(src));
}

// ── add-partial-types: 跨碎片合并（多 CU CollectAll）───────────────────────────
SymbolTable pmergeTable(string a, string b) {
    var pa = new Parser(a, "a.z42"); var cua = pa.ParseCompilationUnit();
    var pb = new Parser(b, "b.z42"); var cub = pb.ParseCompilationUnit();
    CompilationUnit[] cus = new CompilationUnit[2]; cus[0] = cua; cus[1] = cub;
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    return new SymbolCollector().CollectAll(cus, files, 2, null);
}
DiagnosticBag pmergeDiags(string a, string b) {
    var pa = new Parser(a, "a.z42"); var cua = pa.ParseCompilationUnit();
    var pb = new Parser(b, "b.z42"); var cub = pb.ParseCompilationUnit();
    CompilationUnit[] cus = new CompilationUnit[2]; cus[0] = cua; cus[1] = cub;
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    var coll = new SymbolCollector();
    coll.CollectAll(cus, files, 2, null);
    return coll.Diags;
}
bool hasCode(DiagnosticBag d, string code) {
    int i = 0;
    while (i < d.Count()) { if (d.Get(i).Code == code) { return true; } i = i + 1; }
    return false;
}

// add-const-keyword：单 CU 收集期诊断（const 字段求值 / 缺初始化）。
DiagnosticBag collectDiags(string src) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    var coll = new SymbolCollector();
    coll.Collect(cu);
    return coll.Diags;
}
[Test]
void test_const_field_missing_init_error() {
    // const 缺初始化器 → E0416（收集期）
    Assert.Equal(true, hasCode(collectDiags("class C { const int X; }"), "E0416"));
}
[Test]
void test_const_field_nonconstant_init_error() {
    // 非编译期常量初始化器（函数调用）→ E0417（收集期）
    Assert.Equal(true, hasCode(collectDiags("int g() { return 1; } class C { const int X = g(); }"), "E0417"));
}
[Test]
void test_const_field_valid_no_error() {
    // 合法 const 字段（含引用已定义 const 的表达式）→ 无收集期错。
    Assert.Equal(false, hasCode(collectDiags("class C { const int A = 10; const int B = A * 2; }"), "E0416"));
    Assert.Equal(false, hasCode(collectDiags("class C { const int A = 10; const int B = A * 2; }"), "E0417"));
}

[Test]
void test_partial_merge_fields_and_methods() {
    var t = pmergeTable(
        "partial class Foo { public int X; public int GetX() { return this.X; } }",
        "partial class Foo { public int Y; public int GetY() { return this.Y; } }");
    Assert.Equal(true, t.HasClass("Foo"));
    var foo = t.GetClass("Foo");
    Assert.Equal(true, foo.Fields.ContainsKey("X"));
    Assert.Equal(true, foo.Fields.ContainsKey("Y"));
    Assert.Equal(true, foo.Methods.ContainsKey("GetX"));
    Assert.Equal(true, foo.Methods.ContainsKey("GetY"));
    Assert.Equal(true, foo.IsPartial);
    Assert.Equal("a.z42", foo.PartialMainFile);   // 首碎片=主碎片（Ordinal 最小）
}

[Test]
void test_partial_missing_modifier_reports_E0430() {
    var d = pmergeDiags(
        "partial class Foo { public int X; }",
        "class Foo { public int Y; }");
    Assert.Equal(true, hasCode(d, "E0430"));
}

[Test]
void test_partial_kind_mismatch_reports_E0431() {
    var d = pmergeDiags(
        "partial class Foo { public int X; }",
        "partial struct Foo { public int Y; }");
    Assert.Equal(true, hasCode(d, "E0431"));
}

[Test]
void test_partial_base_conflict_reports_E0432() {
    var d = pmergeDiags(
        "partial class Foo : Base { public int X; }",
        "partial class Foo : Other { public int Y; }");
    Assert.Equal(true, hasCode(d, "E0432"));
}

[Test]
void test_partial_duplicate_member_reports_E0433() {
    var d = pmergeDiags(
        "partial class Foo { public int X; }",
        "partial class Foo { public int X; }");
    Assert.Equal(true, hasCode(d, "E0433"));
}

[Test]
void test_partial_interfaces_union() {
    var t = pmergeTable(
        "interface IA { } interface IB { } partial class Foo : IA { public int X; }",
        "partial class Foo : IB { public int Y; }");
    var foo = t.GetClass("Foo");
    bool hasIA = false; bool hasIB = false;
    int i = 0;
    while (i < foo.InterfaceCount) {
        if (foo.InterfaceNames[i] == "IA") { hasIA = true; }
        if (foo.InterfaceNames[i] == "IB") { hasIB = true; }
        i = i + 1;
    }
    Assert.Equal(true, hasIA);
    Assert.Equal(true, hasIB);
}

[Test]
void test_partial_method_paired_registers_impl() {
    var t = pmergeTable(
        "partial class Foo { partial int M(int n); }",
        "partial class Foo { partial int M(int n) { return n; } }");
    var foo = t.GetClass("Foo");
    Assert.Equal(true, foo.Methods.ContainsKey("M"));   // 实现注册
    var d = pmergeDiags(
        "partial class Foo { partial int M(int n); }",
        "partial class Foo { partial int M(int n) { return n; } }");
    Assert.Equal(false, hasCode(d, "E0434"));           // 签名一致 → 无错
}

[Test]
void test_partial_method_erased_when_no_impl() {
    var t = pmergeTable(
        "partial class Foo { partial void OnInit(); }",
        "partial class Foo { public int X; }");
    var foo = t.GetClass("Foo");
    Assert.Equal(false, foo.Methods.ContainsKey("OnInit"));   // 无实现 → 擦除（不注册）
}

[Test]
void test_partial_method_sig_mismatch_reports_E0434() {
    var d = pmergeDiags(
        "partial class Foo { partial int M(int a); }",
        "partial class Foo { partial int M(string a) { return 0; } }");
    Assert.Equal(true, hasCode(d, "E0434"));
}

[Test]
void test_partial_interface_merge_methods() {
    var t = pmergeTable(
        "partial interface IFoo { int A(); }",
        "partial interface IFoo { int B(); }");
    Assert.Equal(true, t.HasInterface("IFoo"));
    var ifoo = t.GetInterface("IFoo");
    Assert.Equal(true, ifoo.Methods.ContainsKey("A"));
    Assert.Equal(true, ifoo.Methods.ContainsKey("B"));
    Assert.Equal(true, ifoo.IsPartial);
}
