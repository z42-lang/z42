// 语义层的指令 / 宏诊断：`[Deprecated]` use-site 告警（含 `#suppress` 局部抑制）、caller 宏 `name!()`（E0450）、
// `available!(X)`。都在 typecheck 相位直接发，不经 analyzer。
namespace Z42cSemanticsDirectiveTests;

using Z42.Syntax;
using Z42.Semantics;
using Z42.Core;
using Std.Harness;

bool _hasCode(DiagnosticBag bag, string code) {
    int i = 0;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == code) { return true; }
        i = i + 1;
    }
    return false;
}

// ── add-deprecated-directive（PR5）：use-site 弃用告警（直接在 typecheck 相位发 "deprecated" Warning）──
// 零格式-bump（[Deprecated] 经 attr-ref 哨兵持久化）；AccessChecker 在 use-site 解析到弃用符号即发告警到
// _diags，#suppress 经 TypeChecker._curSuppress（cu.SuppressRegions）局部抑制。[lints]/WAE 治理 Deferred
// （接 LintConfig 到 typecheck 需 pipeline→semantics 新跨成员符号，撞 F2 冷启动；见 design.md）。

// 驱动 typecheck → 返回 diags（弃用告警直接进袋）。
DiagnosticBag _depDiags(string src) {
    var p = new Parser(src, "t.z42");
    var cu = p.ParseCompilationUnit();
    var symbols = new SymbolCollector().Collect(cu);
    var diags = new DiagnosticBag();
    new TypeChecker(diags).Infer(cu, symbols);
    return diags;
}

string _depMethodSrc() {
    return "class A { [Deprecated(\"use g\")] int f() { return 1; } int g() { return this.f(); } }";
}

[Test]
void test_deprecated_method_use_warns() {
    // 调用 [Deprecated] 方法 → 至少 1 条 "deprecated" Warning
    var bag = _depDiags(_depMethodSrc());
    Assert.Equal(true, _hasCode(bag, "deprecated"));
    Assert.Equal(0, bag.ErrorCount());   // Warning 不阻断编译
}

[Test]
void test_not_deprecated_no_warning() {
    // 无 [Deprecated] → 无 "deprecated" 告警
    var bag = _depDiags("class A { int f() { return 1; } int g() { return this.f(); } }");
    Assert.Equal(false, _hasCode(bag, "deprecated"));
}

[Test]
void test_deprecated_suppress_pragma() {
    // `#suppress deprecated` 圈住调用点 → 抑制
    string src = "class A { [Deprecated(\"x\")] int f() { return 1; }"
        + " int g() { #suppress deprecated int r = this.f(); #restore deprecated return r; } }";
    var bag = _depDiags(src);
    Assert.Equal(false, _hasCode(bag, "deprecated"));
}

[Test]
void test_deprecated_class_new_warns() {
    // new [Deprecated] 类 → 类级 use-site 告警
    string src = "[Deprecated] class D { } class U { int g() { var d = new D(); return 1; } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "deprecated"));
}

// ── fix-free-function-attrs：**自由函数**（顶层 func）上的 `[Deprecated]` ─────────────────
// 此前 MemberCollector 收顶层函数时从不问 HasDeprecated（只有类方法 / 字段 / 类三处问），
// 且 MemberResolver 的自由函数调用分支没有 use-site 检查 ⇒ 同包调用点零告警。
// 跨包那半（ExportedFuncZ 搬运）由 cross-zpkg/deprecated_free_function 把门。

[Test]
void test_deprecated_free_function_use_warns() {
    // 调用 [Deprecated] 自由函数 → 至少 1 条 "deprecated" Warning
    var bag = _depDiags("[Deprecated(\"use g\")] int f() { return 1; } int g() { return f(); }");
    Assert.Equal(true, _hasCode(bag, "deprecated"));
    Assert.Equal(0, bag.ErrorCount());   // Warning 不阻断编译
}

[Test]
void test_not_deprecated_free_function_no_warning() {
    // 无 [Deprecated] 的自由函数 → 无告警（防「凡自由函数调用都报」的过度触发）
    var bag = _depDiags("int f() { return 1; } int g() { return f(); }");
    Assert.Equal(false, _hasCode(bag, "deprecated"));
}

[Test]
void test_deprecated_free_function_overload_selectivity() {
    // #731 起自由函数可按参数类型重载 ⇒ 弃用告警必须只认**被选中的那个重载**。
    // 这条钉住 use-site 检查的位置：它在重载决议**之后**。若挪到决议之前（按名字拿候选就查），
    // `ov("abc")` 会因为同名的 `ov(int)` 带 [Deprecated] 而误报。
    string src = "[Deprecated(\"x\")] int ov(int a) { return a; } int ov(string s) { return s.Length; }";
    var noWarn = _depDiags(src + " int useStr() { return ov(\"abc\"); }");
    Assert.Equal(false, _hasCode(noWarn, "deprecated"));   // 选中没弃用的 ov(string) → 不报
    var warn = _depDiags(src + " int useInt() { return ov(1); }");
    Assert.Equal(true, _hasCode(warn, "deprecated"));      // 选中弃用的 ov(int) → 报
}

[Test]
void test_deprecated_free_function_ns_qualified_warns() {
    // `Demo.freeF()`（ns 限定）是自由函数调用的**第二条入口**（`_bindMemberCall` 的
    // fix-namespace-qualified-free-call 分支），与裸名那条各走各的。两处都得查，
    // 否则限定写法静默绕过——实测确认过这个漏。
    string src = "namespace Demo; [Deprecated(\"x\")] int f() { return 1; } int g() { return Demo.f(); }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "deprecated"));
}

[Test]
void test_deprecated_free_function_suppress_pragma() {
    // `#suppress deprecated` 对自由函数调用点同样生效（与类方法同一条抑制通道）
    string src = "[Deprecated(\"x\")] int f() { return 1; }"
        + " int g() { #suppress deprecated int r = f(); #restore deprecated return r; }";
    var bag = _depDiags(src);
    Assert.Equal(false, _hasCode(bag, "deprecated"));
}

// ── attribute-handler-registry PR6b：编译期 caller 宏（`name!()`）诊断 E0450 ────────────
// 宏经 parser 译成 IdentExpr("$macro:<name>") 哨兵；DeclBinder 定义侧校验名字白名单 + 参数类型，
// ExprTyper 检测非参数默认值位的误用。合法 caller 宏无诊断（注入延到调用点，见 e2e caller_macros）。

[Test]
void test_caller_macro_valid_no_error() {
    // 合法：caller 宏在正确类型的参数默认值位 → 无 E0450
    string src = "class L { string m(string s = caller_member!(), int n = caller_line!()) { return s; } }";
    var bag = _depDiags(src);
    Assert.Equal(false, _hasCode(bag, "E0450"));
}

[Test]
void test_caller_macro_wrong_param_type() {
    // caller_member!() 要求 string 参数——用在 int 参数上 → E0450
    string src = "class L { void m(int x = caller_member!()) { } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "E0450"));
}

[Test]
void test_caller_macro_unknown_name() {
    // 未知宏名 → E0450
    string src = "class L { void m(string s = frobnicate!()) { } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "E0450"));
}

[Test]
void test_caller_macro_misused_in_body() {
    // caller 宏出现在普通表达式位（非参数默认值）→ E0450
    string src = "class L { void m() { string x = caller_member!(); } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "E0450"));
}

// ── add-symbol-availability-macro：`available!(X)` 诊断 ──────────────────────────────────
// available 是**表达式位**宏（与 caller 族相反），故位置校验按 MacroRegistry.PositionOf 分流。
// 编译期语义 = 「X 必须存在」；运行期是否存在由 VM 加载期判定，与本组诊断无关。

[Test]
void test_available_valid_no_error() {
    // 合法：类型 + 唯一静态方法两种形态，均在表达式位 → 无诊断
    string src = "class H { static int A() { return 1; } } "
               + "class L { bool m() { return available!(H) && available!(H.A); } }";
    var bag = _depDiags(src);
    Assert.Equal(false, _hasCode(bag, "E0450"));
    Assert.Equal(false, _hasCode(bag, "E1101"));
    Assert.Equal(false, _hasCode(bag, "E1102"));
    Assert.Equal(false, _hasCode(bag, "E0401"));
}

[Test]
void test_available_undefined_symbol() {
    // 目标编译期不存在 → E0401（防拼写错误 / 重构失配；不是「运行期缺失」那回事）
    string src = "class L { bool m() { return available!(NoSuchType); } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "E0401"));
}

[Test]
void test_available_undefined_member() {
    // 类在但方法不在 → E0401
    string src = "class H { static int A() { return 1; } } "
               + "class L { bool m() { return available!(H.Nope); } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "E0401"));
}

[Test]
void test_available_ambiguous_overload() {
    // 重载 → E1101（v1 不支持签名消歧，design D3）
    string src = "class H { static int A() { return 1; } static int A(int x) { return x; } } "
               + "class L { bool m() { return available!(H.A); } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "E1101"));
}

[Test]
void test_available_bad_argument() {
    // 参数不是符号引用（字面量）→ E1102
    string src = "class L { bool m() { return available!(42); } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "E1102"));
}

[Test]
void test_available_misused_as_param_default() {
    // 表达式位宏出现在参数默认值位 → E0450（且文案是「位置不对」而非「不认识」——
    // 判据已从 KindOf 迁到 PositionOf，见 MacroRegistry）
    string src = "class L { void m(bool b = available!(L)) { } }";
    var bag = _depDiags(src);
    Assert.Equal(true, _hasCode(bag, "E0450"));
}
