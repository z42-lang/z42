// enforce-access-control：访问权限强制（private/protected/internal）单测。
// 违规经 AccessChecker → TypeChecker._diags emit E0404 → SemanticDump.ErrorCount/FirstErrorCode 可见
// （区别于 SymbolCollector.Diags，那类不计入 ErrorCount）。
namespace Z42cSemanticsAccessControlTests;

using Std;
using Std.Test;
using Z42.Semantics;

// ── private ──

[Test]
void test_private_field_cross_class_denied() {
    // 类外（另一类）读 private 字段 → E0404
    string src = "class A { private int a; } class B { int Get(A x) { return x.a; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_private_field_same_class_ok() {
    // 声明类内经 this 访问 private → 放行
    string src = "class A { private int a; int Get() { return this.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_private_field_other_instance_same_class_ok() {
    // 同类其它实例的 private（class-based，非 instance-based）→ 放行
    string src = "class A { private int a; int Get(A o) { return o.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_private_not_inherited_open() {
    // 派生类经 this 访问基类 private → E0404（private 不随继承开放）
    string src = "class B { private int q; } class D : B { int Get() { return this.q; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_private_method_cross_class_denied() {
    string src = "class A { private int f() { return 1; } } class B { int Get(A x) { return x.f(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

// ── protected ──

[Test]
void test_protected_from_derived_ok() {
    string src = "class B { protected int p; } class D : B { int Get() { return this.p; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_protected_from_unrelated_denied() {
    string src = "class B { protected int p; } class U { int Get(B b) { return b.p; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

// ── 默认成员可见性 = private（default-member-private，最小封闭作用域）──

[Test]
void test_no_modifier_member_is_private() {
    // 无修饰符成员默认 private（封闭层=类）→ 另一类访问 → E0404（access-control.md）
    string src = "class A { int a; } class B { int Get(A x) { return x.a; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_no_modifier_member_same_class_ok() {
    // 无修饰符成员同类内访问 → 放行（private=类文本）
    string src = "class A { int a; int Get() { return this.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── internal（显式，同包放行；跨包由手工验证覆盖）──

[Test]
void test_explicit_internal_same_package_ok() {
    string src = "class A { internal int a; } class B { int Get(A x) { return x.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 无修饰符自由函数默认 internal（顶层，封闭层=模块）→ 同包调用放行 ──

[Test]
void test_free_function_default_internal_callable() {
    string src = "int helper() { return 1; } int Main() { return helper(); }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 组合访问修饰符 → E0405（不允许组合）──

[Test]
void test_combined_access_modifiers_rejected() {
    string src = "class A { protected internal int x; }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0405", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_combined_private_protected_rejected() {
    string src = "class A { private protected int x; }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0405", SemanticDump.FirstErrorCode(src));
}

// ── public ──

[Test]
void test_public_field_cross_class_ok() {
    string src = "class A { public int a; } class B { int Get(A x) { return x.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_public_method_cross_class_ok() {
    string src = "class A { public int f() { return 1; } } class B { int Get(A x) { return x.f(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 静态成员 ──

[Test]
void test_static_private_field_cross_class_denied() {
    string src = "class A { private static int s; } class B { int Get() { return A.s; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_static_private_method_cross_class_denied() {
    string src = "class A { private static int f() { return 1; } } class B { int Get() { return A.f(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

// ── enforce-class-access：类级访问强制（体引用点 → TypeChecker._diags → ErrorCount 可见） ──

[Test]
void test_class_new_private_nested_from_outside_denied() {
    // 类外 new 一个 private 嵌套类 → E0404
    string src = "class Outer { private class Inner { } } void f() { var n = new Outer.Inner(); }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_new_private_nested_from_outer_ok() {
    // 外层类内 new 自己的 private 嵌套类 → 放行
    string src = "class Outer { private class Inner { } void mk() { var n = new Inner(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_class_new_public_nested_from_outside_ok() {
    // public 嵌套类类外 new → 放行
    string src = "class Outer { public class Inner { } } void f() { var n = new Outer.Inner(); }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_class_is_private_nested_from_outside_denied() {
    // 类外 `is` private 嵌套类 → E0404
    string src = "class Outer { private class Inner { } } void f(object o) { var b = o is Outer.Inner; }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_var_private_nested_from_outside_denied() {
    // 类外局部变量声明为 private 嵌套类型 → E0404
    string src = "class Outer { private class Inner { } } void f() { Outer.Inner x = null; }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_protected_nested_from_derived_ok() {
    // 派生类内 new 基类的 protected 嵌套类 → 放行
    string src = "class Outer { protected class Inner { } } class Sub : Outer { void mk() { var n = new Outer.Inner(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_class_protected_nested_from_unrelated_denied() {
    // 无关类内 new 一个 protected 嵌套类 → E0404
    string src = "class Outer { protected class Inner { } } class U { void mk() { var n = new Outer.Inner(); } }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_internal_toplevel_same_package_ok() {
    // 无修饰符顶层类默认 internal；同包引用 → 放行（跨包 deny 由 cross-zpkg / imported 覆盖）
    string src = "class Secret { } void f() { var s = new Secret(); }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 顶层声明拒绝 private/protected（complete-class-access-control ③，E0442，parser 声明期）──

[Test]
void test_toplevel_private_class_denied() {
    // 顶层类标 private → E0442（模块作用域下 private 无意义）
    string src = "private class Foo { }";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_toplevel_protected_interface_denied() {
    string src = "protected interface I { }";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_toplevel_protected_enum_denied() {
    string src = "protected enum E { A, B }";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_toplevel_private_function_denied() {
    string src = "private void f() { }";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_toplevel_internal_class_ok() {
    // 顶层 internal（显式）合法
    string src = "internal class A { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_toplevel_public_class_ok() {
    string src = "public class B { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_toplevel_default_class_ok() {
    // 无修饰符顶层 → 默认 internal，合法（不报 E0442）
    string src = "class C { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_nested_private_class_not_toplevel_rejected() {
    // 嵌套 private 类合法（经 MemberParser，不走顶层检查）→ 无 E0442
    string src = "class Outer { private class Inner { } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 接口类型可见性（complete-class-access-control ④，同包嵌套接口引用；跨包 internal 见 cross-zpkg fixture）──
// 注：用**局部变量**声明引用接口类型（StmtBinder → TypeChecker._diags，SemanticDump 计数）；方法**参数**
// 类型的引用检查走 SymbolCollector.Diags（不计入 ErrorCount，见 semanticdump 坑），跨包 param 场景由
// cross-zpkg/interface_internal_access fixture 手工验证覆盖。

[Test]
void test_iface_private_nested_from_outside_denied() {
    // 无关自由函数引用另一类的 private 嵌套接口（局部变量类型）→ E0404
    string src = "class Outer { private interface I { int F(); } } void f() { Outer.I x = null; }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_iface_private_nested_from_outer_ok() {
    // 外层类内引用自己的 private 嵌套接口 → 放行
    string src = "class Outer { private interface I { int F(); } void use() { Outer.I x = null; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_iface_public_nested_from_outside_ok() {
    // public 嵌套接口跨作用域引用 → 放行
    string src = "class Outer { public interface I { int F(); } } void f() { Outer.I x = null; }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_iface_internal_toplevel_same_package_ok() {
    // 无修饰符顶层接口默认 internal；同包引用 → 放行（跨包 deny 由 cross-zpkg fixture 覆盖）
    string src = "interface Handler { int H(); } void f() { Handler h = null; }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}
