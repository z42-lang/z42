// enforce-access-control：访问权限强制（private/protected/internal）单测。
// 违规经 AccessChecker → TypeChecker._diags emit E0404 → SemanticDump.ErrorCount/FirstErrorCode 可见
// （区别于 SymbolCollector.Diags，那类不计入 ErrorCount）。
namespace Z42cSemanticsAccessControlTests;

using Z42.Semantics;
using Z42.Symbols;   // access-top-scope：ImportedSymbols / Z42FuncType / Z42ClassType / StrBox（跨包直构用例）
using Std.Harness;

// ── private ──

[Test]
void test_private_field_cross_class_denied() {
    // 类外（另一类）读 private 字段 → E0404
    string src = "class A { private int a; } class B { int Get(A x) { return x.a; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_private_field_same_class_ok() {
    // 声明类内经 this 访问 private → 放行
    string src = "class A { private int a; int Get() { return this.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_private_field_other_instance_same_class_ok() {
    // 同类其它实例的 private（class-based，非 instance-based）→ 放行
    string src = "class A { private int a; int Get(A o) { return o.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_private_not_inherited_open() {
    // 派生类经 this 访问基类 private → E0404（private 不随继承开放）
    string src = "class B { private int q; } class D : B { int Get() { return this.q; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_private_method_cross_class_denied() {
    string src = "class A { private int f() { return 1; } } class B { int Get(A x) { return x.f(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

// ── protected ──

[Test]
void test_protected_from_derived_ok() {
    string src = "class B { protected int p; } class D : B { int Get() { return this.p; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_protected_from_unrelated_denied() {
    string src = "class B { protected int p; } class U { int Get(B b) { return b.p; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

// ── 默认成员可见性 = private（default-member-private，最小封闭作用域）──

[Test]
void test_no_modifier_member_is_private() {
    // 无修饰符成员默认 private（封闭层=类）→ 另一类访问 → E0404（access-control.md）
    string src = "class A { int a; } class B { int Get(A x) { return x.a; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_no_modifier_member_same_class_ok() {
    // 无修饰符成员同类内访问 → 放行（private=类文本）
    string src = "class A { int a; int Get() { return this.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── internal（显式，同包放行；跨包由手工验证覆盖）──

[Test]
void test_explicit_internal_same_package_ok() {
    string src = "class A { internal int a; } class B { int Get(A x) { return x.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 无修饰符自由函数默认 internal（顶层，封闭层=模块）→ 同包调用放行 ──

[Test]
void test_free_function_default_internal_callable() {
    string src = "int helper() { return 1; } int Main() { return helper(); }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 组合访问修饰符 → E0405（不允许组合）──

[Test]
void test_combined_access_modifiers_rejected() {
    string src = "class A { protected internal int x; }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0405", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_combined_private_protected_rejected() {
    string src = "class A { private protected int x; }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0405", SemanticDump.FirstErrorCode(src));
}

// ── public ──

[Test]
void test_public_field_cross_class_ok() {
    string src = "class A { public int a; } class B { int Get(A x) { return x.a; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_public_method_cross_class_ok() {
    string src = "class A { public int f() { return 1; } } class B { int Get(A x) { return x.f(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 静态成员 ──

[Test]
void test_static_private_field_cross_class_denied() {
    string src = "class A { private static int s; } class B { int Get() { return A.s; } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_static_private_method_cross_class_denied() {
    string src = "class A { private static int f() { return 1; } } class B { int Get() { return A.f(); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

// ── enforce-class-access：类级访问强制（体引用点 → TypeChecker._diags → ErrorCount 可见） ──

[Test]
void test_class_new_private_nested_from_outside_denied() {
    // 类外 new 一个 private 嵌套类 → E0404
    string src = "class Outer { private class Inner { } } void f() { var n = new Outer.Inner(); }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_new_private_nested_from_outer_ok() {
    // 外层类内 new 自己的 private 嵌套类 → 放行
    string src = "class Outer { private class Inner { } void mk() { var n = new Inner(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_class_new_public_nested_from_outside_ok() {
    // public 嵌套类类外 new → 放行
    string src = "class Outer { public class Inner { } } void f() { var n = new Outer.Inner(); }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_class_is_private_nested_from_outside_denied() {
    // 类外 `is` private 嵌套类 → E0404
    string src = "class Outer { private class Inner { } } void f(object o) { var b = o is Outer.Inner; }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_var_private_nested_from_outside_denied() {
    // 类外局部变量声明为 private 嵌套类型 → E0404
    string src = "class Outer { private class Inner { } } void f() { Outer.Inner x = null; }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_protected_nested_from_derived_ok() {
    // 派生类内 new 基类的 protected 嵌套类 → 放行
    string src = "class Outer { protected class Inner { } } class Sub : Outer { void mk() { var n = new Outer.Inner(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_class_protected_nested_from_unrelated_denied() {
    // 无关类内 new 一个 protected 嵌套类 → E0404
    string src = "class Outer { protected class Inner { } } class U { void mk() { var n = new Outer.Inner(); } }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_class_internal_toplevel_same_package_ok() {
    // 无修饰符顶层类默认 internal；同包引用 → 放行（跨包 deny 由 cross-zpkg / imported 覆盖）
    string src = "class Secret { } void f() { var s = new Secret(); }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 顶层声明修饰符（access-top-scope 后的形状：class/struct/interface 放行 private/protected；
//    enum/delegate/顶层函数维持 E0442；protected 无 ns 声明期拒绝）──

[Test]
void test_toplevel_private_class_ok() {
    // access-top-scope：顶层 private = 文件作用域，同文件（单测单一源）合法
    string src = "private class Foo { public int F() { return 1; } } void f() { var x = new Foo(); }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_toplevel_protected_interface_denied() {
    string src = "protected interface I { }";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_toplevel_protected_enum_denied() {
    string src = "protected enum E { A, B }";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_toplevel_private_function_denied() {
    string src = "private void f() { }";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_toplevel_internal_class_ok() {
    // 顶层 internal（显式）合法
    string src = "internal class A { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_toplevel_public_class_ok() {
    string src = "public class B { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_toplevel_default_class_ok() {
    // 无修饰符顶层 → 默认 internal，合法（不报 E0442）
    string src = "class C { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_nested_private_class_not_toplevel_rejected() {
    // 嵌套 private 类合法（经 MemberParser，不走顶层检查）→ 无 E0442
    string src = "class Outer { private class Inner { } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 接口类型可见性（complete-class-access-control ④，同包嵌套接口引用；跨包 internal 见 cross-zpkg fixture）──
// 注：用**局部变量**声明引用接口类型（StmtBinder → TypeChecker._diags，SemanticDump 计数）；方法**参数**
// 类型的引用检查走 SymbolCollector.Diags（不计入 ErrorCount，见 semanticdump 坑），跨包 param 场景由
// cross-zpkg/interface_internal_access fixture 手工验证覆盖。

[Test]
void test_iface_private_nested_from_outside_denied() {
    // 无关自由函数引用另一类的 private 嵌套接口（局部变量类型）→ E0404
    string src = "class Outer { private interface I { int F(); } } void f() { Outer.I x = null; }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_iface_private_nested_from_outer_ok() {
    // 外层类内引用自己的 private 嵌套接口 → 放行
    string src = "class Outer { private interface I { int F(); } void use() { Outer.I x = null; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_iface_public_nested_from_outside_ok() {
    // public 嵌套接口跨作用域引用 → 放行
    string src = "class Outer { public interface I { int F(); } } void f() { Outer.I x = null; }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_iface_internal_toplevel_same_package_ok() {
    // 无修饰符顶层接口默认 internal；同包引用 → 放行（跨包 deny 由 cross-zpkg fixture 覆盖）
    string src = "interface Handler { int H(); } void f() { Handler h = null; }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 不一致可访问性（complete-class-access-control ②，E0441，暴露更低可见性类型）──
// declVis 用**有效可访问性** min(成员, 外层类)：`public class` 才使 public 成员真正 public。

[Test]
void test_inconsistent_public_field_internal_type_denied() {
    // public 类的 public 字段暴露 internal 类型 → E0441
    string src = "public class Api { public Secret s; } class Secret { }";
    Assert.Equal("E0441", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_inconsistent_public_method_return_internal_denied() {
    // public 方法返回 internal 类 → E0441
    string src = "public class Api { public Secret Get() { return null; } } class Secret { }";
    Assert.Equal("E0441", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_inconsistent_public_base_internal_denied() {
    // public 类继承 internal 基类 → E0441
    string src = "public class Derived : Base { } class Base { }";
    Assert.Equal("E0441", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_inconsistent_internal_member_private_nested_denied() {
    // internal 方法（有效 internal）返回 private 嵌套类 → E0441（签名引用嵌套类型须限定名 Api.Node）
    string src = "public class Api { internal Api.Node Peek() { return null; } class Node { } }";
    Assert.Equal("E0441", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_consistent_public_exposes_public_ok() {
    // public 成员暴露 public 类型 → 放行
    string src = "public class Api { public Helper h; } public class Helper { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_effective_vis_internal_class_public_member_ok() {
    // internal 类的 public 字段暴露 internal 类型：有效可访问性 = internal，不算泄漏 → 放行（防误报）
    string src = "internal class C { public Secret s; } class Secret { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_private_member_exposes_internal_ok() {
    // private 成员（有效 private，rank 最低）暴露任意 → 放行
    string src = "public class Api { private Secret s; } class Secret { }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

// ── 构造器（enforce-ctor-visibility）──
// 修前构造器可见性从不检查：`new` 与 `: base` / `: this` 都不调 CheckAccess。

[Test]
void test_ctor_default_private_denied_outside() {
    // 无修饰符构造器 = private；类外 new → E0404
    string src = "class C { C(int a) { } } class U { void M() { var c = new C(1); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_ctor_private_static_factory_ok() {
    string src = "class C { private C() { } public static C Make() { return new C(); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_ctor_protected_base_init_ok_new_denied() {
    string ok = "class B { protected B(int x) { } } class D : B { public D() : base(1) { } }";
    Assert.Equal(0, SemanticDump.ErrorCount(ok));
    string bad = "class B { protected B(int x) { } } class U { void M() { var b = new B(1); } }";
    Assert.Equal(1, SemanticDump.ErrorCount(bad));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(bad));
}

[Test]
void test_ctor_private_base_init_denied() {
    string src = "class B { B(int x) { } } class D : B { public D() : base(1) { } }";
    Assert.Equal(1, SemanticDump.ErrorCount(src));
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_ctor_this_init_private_ok() {
    string src = "class C { C(int a) { } public C() : this(1) { } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_ctor_public_ok() {
    string src = "class C { public C(int a) { } } class U { void M() { var c = new C(1); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_primary_ctor_is_public() {
    // 主构造器对齐 C#：public。否则元组 / 记录在类外无法构造（元组需 stdlib，由 src/tests/tuples 覆盖）。
    string src = "class P(int X); struct S(int Y); class U { void M() { var p = new P(1); var s = new S(2); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_ctor_target_typed_and_object_initializer_checked() {
    string tt = "class C { C(int a) { } } class U { void M() { C c = new(1); } }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(tt));
    string oi = "class C { public int F; C(int a) { } } class U { void M() { var c = new C(1) { F = 2 }; } }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(oi));
}

// ── access-top-scope：顶层 private=文件作用域 / protected=本包∩同名命名空间 ──────────────
// 跨文件用例走 SemanticDump 多文件口径（同包多 CU）；单文件内（`<input>`）天然同文件/同 ns。

[Test]
void test_top_private_same_file_all_forms_ok() {
    // 同文件体引用（局部/var/new/私有字段）放行；签名暴露另测（E0441 边界）
    string src = "private class Node { public int V; } class Holder { Node n = new Node(); "
               + "int Make() { var x = new Node(); Node y = x; return y.V; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_top_private_same_file_signature_exposure_denied() {
    // 同文件 internal 类的 public 成员签名暴露 file-private 类型 → E0441（设计裁决：越出文件的
    // 签名一律拒，哪怕同文件声明——否则模块元数据暴露一个别的文件不可名状的类型）
    string src = "private class Node { } class Holder { public Node Make() { return new Node(); } }";
    Assert.Equal("E0441", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_top_private_cross_file_denied() {
    // 跨文件引用 file-private 类 → E0404（引用点 sp.File 与声明 DeclFile 不同）
    string[] srcs = new string[2];
    srcs[0] = "private class Helper { public int F() { return 1; } }";
    srcs[1] = "class User { void M() { var h = new Helper(); } }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_private_same_name_other_file_same_ns_denied_by_dup() {
    // 两个文件各写一个同 ns 同名 file-private 类 → 既有 E0458 重复声明兜底（不静默 last-wins）
    string[] srcs = new string[2];
    srcs[0] = "namespace App; private class H { }";
    srcs[1] = "namespace App; private class H { }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0458"));
}

[Test]
void test_top_private_static_member_cross_file_denied() {
    // 跨文件走静态属主路径（X.M()）同样过门（CheckTopScopeOwner）
    string[] srcs = new string[2];
    srcs[0] = "private class Cfg { public static int V = 1; }";
    srcs[1] = "class User { int M() { return Cfg.V; } }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_private_nested_public_leak_denied() {
    // file-private 外层类 + public 嵌套类：跨文件引用 Outer.Inner 经祖先链门拒绝
    string[] srcs = new string[2];
    srcs[0] = "private class Outer { public class Inner { } }";
    srcs[1] = "class User { void M() { var x = new Outer.Inner(); } }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_private_repl_session_shared() {
    // REPL 各轮（repl_r0/repl_r1）折叠为同一会话作用域：跨轮引用放行
    string[] srcs = new string[2];
    srcs[0] = "private class SessionHelper { public int F() { return 1; } }";
    srcs[1] = "class User { void M() { var h = new SessionHelper(); } }";
    string[] files = new string[2]; files[0] = "repl_r0"; files[1] = "repl_r1";
    Assert.Equal(0, SemanticDump.ErrorCountMulti(srcs, files));
}

[Test]
void test_top_protected_requires_namespace() {
    // protected 是命名空间作用域：无 ns 声明的文件写顶层 protected → E0442（空 ns 等价 internal，声明期拒绝）
    string src = "protected class Foo { }";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_top_protected_same_ns_ok() {
    // 同 ns 跨文件引用 protected 类 → 放行（partial 类碎片场景的本命用例）
    string[] srcs = new string[2];
    srcs[0] = "namespace App; protected class Helper { public int F() { return 1; } }";
    srcs[1] = "namespace App; class Big { int M() { return new Helper().F(); } }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.Equal(0, SemanticDump.ErrorCountMulti(srcs, files));
}

[Test]
void test_top_protected_other_ns_denied() {
    // 异 ns（同包）引用 protected 类 → E0404
    string[] srcs = new string[2];
    srcs[0] = "namespace App; protected class Helper { public int F() { return 1; } }";
    srcs[1] = "namespace Other; class User { void M() { var h = new App.Helper(); } }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_protected_global_ns_user_denied() {
    // 使用点在全局 ns（无 namespace 声明）→ 不同 ns → E0404
    string[] srcs = new string[2];
    srcs[0] = "namespace App; protected class Helper { }";
    srcs[1] = "class User { void M() { var h = new App.Helper(); } }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_protected_interface_same_ns_ok() {
    // 接口对称：同 ns 引用 protected 接口放行；异 ns 拒
    string[] srcs = new string[3];
    srcs[0] = "namespace App; protected interface IHelper { int F(); }";
    srcs[1] = "namespace App; class C : IHelper { public int F() { return 1; } }";
    srcs[2] = "namespace Other; class D { void M() { App.IHelper x = null; } }";
    string[] files = new string[3]; files[0] = "a.z42"; files[1] = "b.z42"; files[2] = "c.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_private_not_exported_protected_exported() {
    // 导出面：file-private 类不进 zpkg 导出；protected 照常导出（DumpExports 只看本包声明）
    string src = "namespace App; private class Hidden { } protected class Shared { public int F() { return 1; } }";
    string dump = SemanticDump.DumpExports(src);
    Assert.False(dump.Contains("Hidden"));
    Assert.True(dump.Contains("Shared"));
}

// ── access-top-scope ②：enum / delegate 与类一致（private=文件、protected=本包∩同名 ns）──

[Test]
void test_top_private_enum_same_file_ok() {
    string src = "private enum Hue { Red, Green } class U { int M() { Hue h = Hue.Red; return (int)h; } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_top_private_enum_cross_file_denied() {
    string[] srcs = new string[2];
    srcs[0] = "private enum Hue { Red, Green }";
    srcs[1] = "class U { void M() { Hue h = Hue.Red; } }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_private_enum_signature_exposure_denied() {
    // internal 类的 public 成员签名暴露 file-private enum → E0441（同 file-private 类的边界）
    string src = "private enum Hue { Red } class U { public Hue Get() { return Hue.Red; } }";
    Assert.Equal("E0441", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_top_protected_enum_same_ns_ok_other_ns_denied() {
    string[] srcs = new string[3];
    srcs[0] = "namespace App; protected enum Tone { Low, High }";
    srcs[1] = "namespace App; class Ok { void M() { Tone t = Tone.Low; } }";
    srcs[2] = "namespace Other; class Bad { void M() { App.Tone t = App.Tone.Low; } }";
    string[] files = new string[3]; files[0] = "a.z42"; files[1] = "b.z42"; files[2] = "c.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_nested_private_enum_denied() {
    // 嵌套显式 private enum：外部类文本之外引用 → E0404（与嵌套 private 类同语义）
    string src = "class Outer { private enum E { A } } void g() { Outer.E x = Outer.E.A; }";
    Assert.Equal("E0404", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_top_private_delegate_same_file_ok() {
    string src = "private delegate int Op(int x); class U { int M(Op f) { return f(1); } }";
    Assert.Equal(0, SemanticDump.ErrorCount(src));
}

[Test]
void test_top_private_delegate_cross_file_denied() {
    string[] srcs = new string[2];
    srcs[0] = "private delegate int Op(int x);";
    srcs[1] = "class U { int M(Op f) { return 0; } }";
    string[] files = new string[2]; files[0] = "a.z42"; files[1] = "b.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_private_delegate_signature_exposure_denied() {
    string src = "private delegate void Op(); public class U { public Op Get() { return null; } }";
    Assert.Equal("E0441", SemanticDump.FirstErrorCode(src));
}

[Test]
void test_top_protected_delegate_same_ns_ok_other_ns_denied() {
    string[] srcs = new string[3];
    srcs[0] = "namespace App; protected delegate int Op(int x);";
    srcs[1] = "namespace App; class Ok { int M(Op f) { return f(1); } }";
    srcs[2] = "namespace Other; class Bad { int M(App.Op f) { return 0; } }";
    string[] files = new string[3]; files[0] = "a.z42"; files[1] = "b.z42"; files[2] = "c.z42";
    Assert.True(SemanticDump.HasErrorCodeMulti(srcs, files, "E0404"));
}

[Test]
void test_top_protected_delegate_requires_namespace() {
    string src = "protected delegate void Op();";
    Assert.Equal("E0442", SemanticDump.FirstErrorCode(src));
}

// ── access-top-scope ③：跨包（经 ImportedSymbols 直构，免 zpkg 文件；镜像 TsigReconcile 重建形态）──

[Test]
void test_top_private_delegate_cross_pkg_denied() {
    // 依赖包重建的 file-private delegate（DeclImported）：跨包引用 → E0404（同名 ns 也不放行）
    var imp = new ImportedSymbols();
    Z42FuncType dft = new Z42FuncType(new Z42Type[0], 0, Z42ClassType.Builtin("void"));
    dft.DeclVis = "private"; dft.DeclName = "Op"; dft.DeclNs = ""; dft.DeclImported = true;
    imp.DelegatesByFqn.Put("Op", dft);
    string src = "class U { void M(Op f) { } }";
    Assert.True(SemanticDump.HasErrorCodeImp(src, imp, "E0404"));
}

[Test]
void test_top_protected_delegate_cross_pkg_denied() {
    // 依赖包重建的 ns-protected delegate：即使消费文件声明**同名 ns**，跨包仍拒（IsImported 判据）
    var imp = new ImportedSymbols();
    Z42FuncType dft = new Z42FuncType(new Z42Type[0], 0, Z42ClassType.Builtin("void"));
    dft.DeclVis = "protected"; dft.DeclName = "Op"; dft.DeclNs = "App"; dft.DeclImported = true;
    imp.DelegatesByFqn.Put("App.Op", dft);
    string src = "namespace App; class U { void M(Op f) { } }";
    Assert.True(SemanticDump.HasErrorCodeImp(src, imp, "E0404"));
}

[Test]
void test_top_private_enum_cross_pkg_denied() {
    // 依赖包重建的 file-private enum（"imp:" 前缀 → IsImported）：跨包引用 → E0404
    var imp = new ImportedSymbols();
    imp.EnumTypeNamesByFqn.Put("Hue", "enum");
    imp.EnumTypeVisByFqn.Put("Hue", "private");
    imp.EnumConsts.Put("Hue.Red", new StrBox("0"));
    string src = "class U { void M(Hue h) { } }";
    Assert.True(SemanticDump.HasErrorCodeImp(src, imp, "E0404"));
}

[Test]
void test_imported_public_enum_still_ok() {
    // 无显式新档位的导入 enum（无 EnumTypeVis 条目）→ 合成默认 public，行为与修前逐字一致
    var imp = new ImportedSymbols();
    imp.EnumTypeNamesByFqn.Put("Hue", "enum");
    imp.EnumConsts.Put("Hue.Red", new StrBox("0"));
    string src = "class U { void M(Hue h) { } }";
    var diags = Z42.Semantics.FrontEnd.Check(src, "<input>", imp).Diags;
    Assert.Equal(0, diags.ErrorCount());
}
