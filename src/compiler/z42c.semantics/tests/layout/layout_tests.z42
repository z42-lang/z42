// add-struct-value-semantics P1 阶段 1：StructLayout 字节布局计算单测。
// 覆盖：基元布局 / 对齐填充 / 引用叶子（string=ArcString、class=GcRef 带种类）/ 嵌套展平 /
// 嵌套引用叶子偏移平移 / 递归自含值字段环检测（ABI 见 design.md 子决策 #2）。
namespace Z42cSemanticsLayoutTests;
using Z42.IR;
using Std;
using Std.Test;
using Z42.Semantics;

// 构造一个只含 struct 类型定义的 defs map。
StructFieldsDef _mkDef(string[] names, string[] types, int n) {
    var d = new StructFieldsDef();
    int i = 0;
    while (i < n) { d.Add(names[i], types[i]); i = i + 1; }
    return d;
}

// 在 layout 的直接字段里查某字段的 byte offset（找不到返回 -1）。
int _fieldOff(StructLayoutInfo info, string name) {
    int i = 0;
    while (i < info.FieldCount) {
        if (info.FieldNames[i] == name) { return info.FieldOffsets[i]; }
        i = i + 1;
    }
    return 0 - 1;
}

[Test]
void test_layout_simple_prims() {
    // struct P { x:int; y:int; } → size 8, align 4, offsets 0/4, 无引用叶子。
    var defs = new StrMap();
    defs.Put("P", _mkDef(new string[]{"x", "y"}, new string[]{"int", "int"}, 2));
    var sl = new StructLayout(defs);
    var p = sl.LayoutOf("P");
    Assert.Equal(8, p.Size);
    Assert.Equal(4, p.Align);
    Assert.Equal(0, _fieldOff(p, "x"));
    Assert.Equal(4, _fieldOff(p, "y"));
    Assert.Equal(0, p.RefLeafCount);
    Assert.Equal("", sl.ErrorType);
}

[Test]
void test_layout_alignment_padding() {
    // struct Q { b:bool; n:int; } → b@0(1B), n@4(对齐填充), size 8, align 4。
    var defs = new StrMap();
    defs.Put("Q", _mkDef(new string[]{"b", "n"}, new string[]{"bool", "int"}, 2));
    var sl = new StructLayout(defs);
    var q = sl.LayoutOf("Q");
    Assert.Equal(0, _fieldOff(q, "b"));
    Assert.Equal(4, _fieldOff(q, "n"));   // 从 offset 1 对齐到 4
    Assert.Equal(8, q.Size);
    Assert.Equal(4, q.Align);
}

[Test]
void test_layout_reference_leaves_typed() {
    // struct Box { tag:int; s:string; obj:Widget; } → 引用叶子带种类：s=ArcString、obj=GcRef。
    var defs = new StrMap();
    defs.Put("Box", _mkDef(new string[]{"tag", "s", "obj"}, new string[]{"int", "string", "Widget"}, 3));
    var sl = new StructLayout(defs);
    var b = sl.LayoutOf("Box");
    Assert.Equal(0,  _fieldOff(b, "tag"));   // int @0
    Assert.Equal(8,  _fieldOff(b, "s"));     // string 16B align8 → 从 4 对齐到 8
    Assert.Equal(24, _fieldOff(b, "obj"));   // GcRef @24
    Assert.Equal(40, b.Size);                // alignUp(40, 8)
    Assert.Equal(8,  b.Align);
    // 引用叶子：2 个，s=(8, ArcString)、obj=(24, GcRef)。
    Assert.Equal(2, b.RefLeafCount);
    Assert.Equal(8,  b.RefLeafOffsets[0]);
    Assert.Equal(StructLeafKind.ArcString, b.RefLeafKinds[0]);
    Assert.Equal(24, b.RefLeafOffsets[1]);
    Assert.Equal(StructLeafKind.GcRef, b.RefLeafKinds[1]);
}

[Test]
void test_layout_nested_struct() {
    // struct P{x:int;y:int;}(8B); struct Line{a:P;b:P;} → a@0, b@8, size 16。
    var defs = new StrMap();
    defs.Put("P", _mkDef(new string[]{"x", "y"}, new string[]{"int", "int"}, 2));
    defs.Put("Line", _mkDef(new string[]{"a", "b"}, new string[]{"P", "P"}, 2));
    var sl = new StructLayout(defs);
    var line = sl.LayoutOf("Line");
    Assert.Equal(0,  _fieldOff(line, "a"));
    Assert.Equal(8,  _fieldOff(line, "b"));
    Assert.Equal(16, line.Size);
    Assert.Equal(4,  line.Align);
    Assert.Equal(0,  line.RefLeafCount);   // P 无引用叶子
}

[Test]
void test_layout_nested_ref_flatten() {
    // struct R{name:string;}(16B, 引用叶子@0); struct Pair{first:R;second:R;} → 引用叶子平移到 0 和 16。
    var defs = new StrMap();
    defs.Put("R", _mkDef(new string[]{"name"}, new string[]{"string"}, 1));
    defs.Put("Pair", _mkDef(new string[]{"first", "second"}, new string[]{"R", "R"}, 2));
    var sl = new StructLayout(defs);
    var pair = sl.LayoutOf("Pair");
    Assert.Equal(0,  _fieldOff(pair, "first"));
    Assert.Equal(16, _fieldOff(pair, "second"));
    Assert.Equal(32, pair.Size);
    Assert.Equal(2,  pair.RefLeafCount);
    Assert.Equal(0,  pair.RefLeafOffsets[0]);
    Assert.Equal(StructLeafKind.ArcString, pair.RefLeafKinds[0]);
    Assert.Equal(16, pair.RefLeafOffsets[1]);
    Assert.Equal(StructLeafKind.ArcString, pair.RefLeafKinds[1]);
}

[Test]
void test_build_from_symbols_struct_vs_class() {
    // BuildFromSymbols 只收 IsStruct 的类；非 struct 类不进 defs（其字段视为 GcRef 引用叶子）。
    var table = new SymbolTable();
    var p = new Z42ClassType("P", false, "");
    p.IsStruct = true;
    p.AddOwnField("x", "int", "public");
    p.AddOwnField("y", "int", "public");
    table.Classes.Put("P", p);
    var w = new Z42ClassType("Widget", false, "");   // 非 struct（默认 IsStruct=false）
    table.Classes.Put("Widget", w);
    var sl = StructLayout.BuildFromSymbols(table);
    Assert.Equal(true,  sl.IsStructType("P"));
    Assert.Equal(false, sl.IsStructType("Widget"));
    var lp = sl.LayoutOf("P");
    Assert.Equal(8, lp.Size);
    Assert.Equal(0, lp.RefLeafCount);
    Assert.Equal("", sl.ErrorType);
}

[Test]
void test_build_from_symbols_ref_field() {
    // struct Box { n:int; w:Widget; } —— Widget 非 struct → GcRef 引用叶子。
    var table = new SymbolTable();
    var box = new Z42ClassType("Box", false, "");
    box.IsStruct = true;
    box.AddOwnField("n", "int", "public");
    box.AddOwnField("w", "Widget", "public");
    table.Classes.Put("Box", box);
    table.Classes.Put("Widget", new Z42ClassType("Widget", false, ""));
    var sl = StructLayout.BuildFromSymbols(table);
    var lb = sl.LayoutOf("Box");
    Assert.Equal(0,  _fieldOff(lb, "n"));    // int @0
    Assert.Equal(8,  _fieldOff(lb, "w"));    // Widget 16B align8 → 从 4 对齐到 8
    Assert.Equal(24, lb.Size);
    Assert.Equal(1,  lb.RefLeafCount);
    Assert.Equal(8,  lb.RefLeafOffsets[0]);
    Assert.Equal(StructLeafKind.GcRef, lb.RefLeafKinds[0]);
}

// ── unify-object-byte-layout PR-1：对象全字段布局（8B 引用）单测 ──────────────────

[Test]
void test_object_layout_prims() {
    // 非-struct class W { x:int; y:int; } → 对象布局 x@0, y@4, size 8, 无引用叶子。
    var table = new SymbolTable();
    var w = new Z42ClassType("W", false, "");   // 非 struct → 进 classDefs → 有对象布局
    w.AddOwnField("x", "int", "public");
    w.AddOwnField("y", "int", "public");
    table.Classes.Put("W", w);
    var sl = StructLayout.BuildFromSymbols(table);
    Assert.Equal(true, sl.HasObjectLayout("W"));
    var ol = sl.ObjectLayoutOf("W");
    Assert.Equal(2, ol.FieldCount);
    Assert.Equal(0, _fieldOff(ol, "x"));
    Assert.Equal(4, _fieldOff(ol, "y"));
    Assert.Equal(8, ol.Size);
    Assert.Equal(0, ol.RefLeafCount);
}

[Test]
void test_object_layout_8byte_reference() {
    // 关键：class B { n:int; s:string; obj:W; } → 引用叶子按 **8B** 算（终点 C# 布局）：
    // n@0(4B), s@8(string 8B ref, align8 从 4→8), obj@16(W 8B ref), size 24。
    // 对比 struct 版（16B 引用）会是 s@8、obj@24、size 40 —— 8B 收窄在此体现。
    var table = new SymbolTable();
    var b = new Z42ClassType("B", false, "");
    b.AddOwnField("n", "int", "public");
    b.AddOwnField("s", "string", "public");
    b.AddOwnField("obj", "W", "public");
    table.Classes.Put("B", b);
    table.Classes.Put("W", new Z42ClassType("W", false, ""));   // 非 struct → GcRef 8B
    var sl = StructLayout.BuildFromSymbols(table);
    var ol = sl.ObjectLayoutOf("B");
    Assert.Equal(0,  _fieldOff(ol, "n"));    // int @0
    Assert.Equal(8,  _fieldOff(ol, "s"));    // string 8B align8 → 从 4 对齐到 8
    Assert.Equal(16, _fieldOff(ol, "obj"));  // W 引用 8B @16
    Assert.Equal(24, ol.Size);               // 8B 引用 → 24（16B 引用会是 40）
    Assert.Equal(8,  ol.Align);
    // 引用叶子（8B 位图）：s=(8, ArcString)、obj=(16, GcRef)。
    Assert.Equal(2,  ol.RefLeafCount);
    Assert.Equal(8,  ol.RefLeafOffsets[0]);
    Assert.Equal(StructLeafKind.ArcString, ol.RefLeafKinds[0]);
    Assert.Equal(16, ol.RefLeafOffsets[1]);
    Assert.Equal(StructLeafKind.GcRef, ol.RefLeafKinds[1]);
}

[Test]
void test_object_layout_inline_struct_flattened_8byte() {
    // class C { tag:int; pt:P; } 其中 struct P { name:string; k:int; }（内联 struct 字段扁平进对象布局）。
    // P 8B 引用展平：name@0(8B ref), k@8 → P size 16。对象 C：tag@0(4), pt@8(align8 从 4→8)，pt 内 name@8、k@16。
    // 对象 size = 8 + 16 = 24。引用叶子：pt.name 平移到 8 = (8, ArcString)。
    var table = new SymbolTable();
    var p = new Z42ClassType("P", false, "");
    p.IsStruct = true;
    p.AddOwnField("name", "string", "public");
    p.AddOwnField("k", "int", "public");
    table.Classes.Put("P", p);
    var c = new Z42ClassType("C", false, "");
    c.AddOwnField("tag", "int", "public");
    c.AddOwnField("pt", "P", "public");   // 内联 struct 字段
    table.Classes.Put("C", c);
    var sl = StructLayout.BuildFromSymbols(table);
    var ol = sl.ObjectLayoutOf("C");
    Assert.Equal(0, _fieldOff(ol, "tag"));   // int @0
    Assert.Equal(8, _fieldOff(ol, "pt"));    // struct P 扁平嵌入 @8（align8）
    Assert.Equal(24, ol.Size);               // 8 + P(16) = 24
    // 引用叶子：P.name 平移到 pt@8 + name@0 = 8。
    Assert.Equal(1, ol.RefLeafCount);
    Assert.Equal(8, ol.RefLeafOffsets[0]);
    Assert.Equal(StructLeafKind.ArcString, ol.RefLeafKinds[0]);
}

[Test]
void test_object_layout_struct_has_none() {
    // struct 类型不进对象布局（走 struct 块）：ObjectLayoutOf 返回空、HasObjectLayout=false。
    var table = new SymbolTable();
    var p = new Z42ClassType("P", false, "");
    p.IsStruct = true;
    p.AddOwnField("x", "int", "public");
    p.AddOwnField("y", "int", "public");
    table.Classes.Put("P", p);
    var sl = StructLayout.BuildFromSymbols(table);
    Assert.Equal(false, sl.HasObjectLayout("P"));   // struct → 无对象布局
    Assert.Equal(0, sl.ObjectLayoutOf("P").FieldCount);
}

[Test]
void test_layout_cycle_detection() {
    // struct Node { next:Node; } —— 递归自含值字段（无限大小）→ ErrorType 置位。
    var defs = new StrMap();
    defs.Put("Node", _mkDef(new string[]{"next"}, new string[]{"Node"}, 1));
    var sl = new StructLayout(defs);
    var node = sl.LayoutOf("Node");   // 触发环检测；返回空布局，仅验 ErrorType 置位
    Assert.Equal(0, node.Size);
    Assert.Equal("Node", sl.ErrorType);
}
