// complete-generic-instantiation S1：泛型体单调化的编译器侧门。
namespace Z42cSemanticsGenericSpecializationTests;

using Z42.Semantics;

// ── 单调化不得因递归泛型挂死 ──────────────────────────────────────────────
//
// complete-generic-instantiation S1：特化按 `(泛型体, 具体实参)` 建工作项。递归泛型
// （`Rec<T>` 调 `Rec<G<T>>`）让类型实参逐层加深 ⇒ 工作项无限增长 ⇒ **编译器 100% CPU
// 不返回**，用户拿到的不是诊断而是一个挂死的进程。实测：S1 实施后确实挂死（45 秒未返回），
// 而 main 在同一段源码上秒级报 E0402。
//
// 两道防线：① 本 CU 有类型错误 ⇒ 完全不做特化（`IrGen.HasTypeErrors`）——病态源码的
// codegen 产物本就无意义，跳过让诊断正常输出；② 工作表的防御性上限（`SpecializationCap`），
// 兜住未来可能出现的「良型但无界」的情形。
//
// ⚠️ 本测试的失败形态是**挂起**而非判红（真挂死时整个套件会卡住，靠 CI 超时暴露）。
// 这是这类缺陷能设的最直接的门 —— 没有它，回归只会在某个用户的机器上表现为「编译器卡住了」。
[Test]
void test_recursive_generic_does_not_hang() {
    // 形参是裸 T，实参每层包一层：源码在今天的类型检查器下是 E0402，但**工作项的增长**
    // 与类型检查是否通过无关 —— 特化发生在 codegen，而 codegen 在有诊断时照常跑。
    string src = "namespace D; [Record] struct Loc<A, B>(A Item1, B Item2);\n"
               + "void Rec<T>(T v, int d) { if (d <= 0) { return; } Rec<Loc<T, int>>(new Loc<T, int>(v, d), d - 1); }\n"
               + "void Main() { Rec<int>(1, 3); }";
    string dump = IrDump.DumpModule(src);
    Assert.Equal(true, dump.Length > 0);   // 能走到这一行就说明没挂死
}

// ── 良型的无界展开：报 E0503，不再让编译器崩溃 ───────────────────────────
//
// 值类型实例化各有一份代码（布局不同），所以 `struct Rec<T>` 里用到 `Rec<Rec<T>>` 时，编 `Rec<int>`
// 就得先编 `Rec<Rec<int>>`，再编 `Rec<Rec<Rec<int>>>`……没有尽头。类型检查完全合法，只有展开时才看得出来
// （Rust 同样在单态化阶段报这一类）。此前撞上限后抛一个未捕获异常、打出整段栈。

bool gsHasCode(CompiledModuleZ cm, string code) {
    int i = 0;
    while (i < cm.DiagCount) { if (cm.DiagMsgs[i].Contains(code)) { return true; } i = i + 1; }
    return false;
}

string gsMsg(CompiledModuleZ cm, string code) {
    int i = 0;
    while (i < cm.DiagCount) { if (cm.DiagMsgs[i].Contains(code)) { return cm.DiagMsgs[i]; } i = i + 1; }
    return "";
}

[Test]
void test_recursive_struct_generic_reports_e0503() {
    string src = "namespace D;\n"
               + "struct Rec<T> { public T V; public Rec<Rec<T>> Next() { return new Rec<Rec<T>>(); } }\n"
               + "void Main() { Rec<int> r = new Rec<int>(); var n = r.Next(); }\n";
    CompiledModuleZ cm = IrDump.BuildModuleD(src, "rec.z42", null, null);
    Assert.Equal(true, cm.ErrorCount > 0);
    Assert.Equal(true, gsHasCode(cm, "E0503"));
    string m = gsMsg(cm, "E0503");
    Assert.Equal(true, m.Contains("`Rec`"));      // 点名是哪个泛型
    Assert.Equal(true, m.Contains("rec.z42(2,"));  // 报在它的声明处
    Assert.Equal(true, m.Contains("nested more than 100 levels"));   // 深度上限先到：百来项内失败，不攒满 2000
}

// 同一形状换成 class：引用类型实例化共用一份代码，展开有界，必须照常编过 —— 这条锁住
// 「只在真的展不完时才报」，不能退化成一条静态的「禁止递归泛型」规则。
[Test]
void test_recursive_class_generic_still_compiles() {
    string src = "namespace D;\n"
               + "class Rec<T> { public Rec<Rec<T>> Next() { return new Rec<Rec<T>>(); } }\n"
               + "void Main() { Rec<int> r = new Rec<int>(); var n = r.Next(); }\n";
    CompiledModuleZ cm = IrDump.BuildModuleD(src, "recc.z42", null, null);
    Assert.Equal(0, cm.ErrorCount);
}
