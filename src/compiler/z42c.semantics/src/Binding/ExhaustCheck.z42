// switch 穷尽性诊断（模式匹配 C）。封闭域（bool / enum）的 switch（语句 + 表达式）未覆盖全部情形
// 且无无条件兜底臂时报 warning W0700。**落 binder 语义阶段**（非 analyzer 框架——后者跑 AST 层拿不到
// 类型/SymbolTable）：subject 类型 + enum 成员表在此已知，直接经 _tc._diags.Warning 上报。
//
// 可行域（User 6.5 裁决）：
//   bool —— 覆盖 true ∧ false，或有兜底。
//   enum —— 常量臂整数值集 ⊇ EnumConsts 全成员整数值集，或有兜底（enum 成员名 bind 期已丢失、降级
//            BoundLitInt → 按**整数值**比对；别名成员同值天然合并）。
//   sealed —— 不可行（z42 sealed=不可继承 final，非封闭子类集，且无反向子类索引）→ out-of-scope。
//
// 无条件兜底 = 任一臂无 pattern（default），或 pattern 恒匹配（通配 / 裸绑定）且无守卫。带守卫臂不计覆盖。
namespace Z42.Semantics;

using Z42.IR;
using Z42.Core;

public sealed class ExhaustChecker {
    private TypeChecker _tc;
    public ExhaustChecker(TypeChecker tc) { this._tc = tc; }

    // switch 语句穷尽性
    internal void CheckStmt(BoundSwitch sw, TypeEnv env) {
        int i = 0;
        while (i < sw.CaseCount) {
            BoundSwitchCase c = sw.Cases[i];
            if (this._isUncond(c.HasPattern, c.Pattern, c.Guard)) { return; }   // 有兜底 → 穷尽
            i = i + 1;
        }
        StrMap covered = new StrMap();
        i = 0;
        while (i < sw.CaseCount) {
            BoundSwitchCase c = sw.Cases[i];
            if (c.Guard == null && c.HasPattern) { this._collect(c.Pattern, covered); }
            i = i + 1;
        }
        this._report(sw.Subject.Type(), covered, env, sw.Span);
    }

    // switch 表达式穷尽性
    internal void CheckExpr(BoundSwitchExpr sw, TypeEnv env) {
        int i = 0;
        while (i < sw.ArmCount) {
            BoundSwitchArm a = sw.Arms[i];
            if (this._isUncond(a.HasPattern, a.Pattern, a.Guard)) { return; }
            i = i + 1;
        }
        StrMap covered = new StrMap();
        i = 0;
        while (i < sw.ArmCount) {
            BoundSwitchArm a = sw.Arms[i];
            if (a.Guard == null && a.HasPattern) { this._collect(a.Pattern, covered); }
            i = i + 1;
        }
        this._report(sw.Subject.Type(), covered, env, sw.Span);
    }

    // 无条件兜底：无 pattern（default），或 pattern 恒匹配（通配 / 裸绑定）且无守卫。
    private bool _isUncond(bool hasPattern, BoundPattern pat, BoundExpr guard) {
        if (guard != null) { return false; }
        if (!hasPattern) { return true; }
        if (pat is BoundWildcardPattern) { return true; }
        if (pat is BoundBindingPattern) { return true; }
        return false;
    }

    // 收集一个 pattern 覆盖的常量值（进 covered 集，key=值域前缀 + 值文本）；or-模式递归各 alt。
    private void _collect(BoundPattern pat, StrMap covered) {
        if (pat is BoundConstantPattern) {
            string k = this._constKey((pat as BoundConstantPattern).Value);
            if (k != "") { covered.TryAdd(k, k); }
            return;
        }
        if (pat is BoundOrPattern) {
            BoundOrPattern op = pat as BoundOrPattern;
            int i = 0;
            while (i < op.Count) { this._collect(op.Alts[i], covered); i = i + 1; }
            return;
        }
        // add-internal-hierarchy-exhaustiveness：类型模式覆盖一个类（`case Circle c:` / `case Circle(r):`
        // / `case Circle{R:r}:`）→ 以 "t:"+类型键 入 covered，供封闭层次穷尽判定。`case Base b:` 命中基类
        // → 吞整棵子树（_isTypeCovered 处理）。前缀 "t:" 与常量键 "b:"/"i:" 天然隔离。
        if (pat is BoundTypePattern) {
            string tn = this._patTypeKey((pat as BoundTypePattern).BoundType, (pat as BoundTypePattern).TypeName);
            if (tn != "") { covered.TryAdd("t:" + tn, tn); }
            return;
        }
        if (pat is BoundPositionalPattern) {
            string tn = this._patTypeKey((pat as BoundPositionalPattern).Type, (pat as BoundPositionalPattern).TypeName);
            if (tn != "") { covered.TryAdd("t:" + tn, tn); }
            return;
        }
        if (pat is BoundPropertyPattern) {
            BoundPropertyPattern pp = pat as BoundPropertyPattern;
            if (pp.HasType) {
                string tn = this._patTypeKey(pp.Type, pp.TypeName);
                if (tn != "") { covered.TryAdd("t:" + tn, tn); }
            }
            return;
        }
        // 其它 pattern（范围 / 关系 …）不覆盖单一常量值/类名 → 忽略（保守，可能过报）。
    }

    // 类型模式的类型键：解析到类时用它的 FQN（同包不同 ns 的同短名类是两个类，按短名记会把两者都算「已覆盖」）；
    // 其它解析结果用 Name()，没解析出来回落语法 TypeName（由 _isTypeCovered 按作用域再解析）。
    private string _patTypeKey(Z42Type t, string fallback) {
        if (t is Z42ClassType) { return (t as Z42ClassType).Fqn(); }
        if (t != null) { return t.Name(); }
        return fallback;
    }

    // 常量 BoundExpr → 覆盖集 key。整数 / 枚举成员（降级 BoundLitInt）→ "i:<文本>"；bool → "b:true/false"。
    private string _constKey(BoundExpr v) {
        if (v is BoundLitInt) { return "i:" + (v as BoundLitInt).Text; }
        if (v is BoundLitBool) { if ((v as BoundLitBool).Value) { return "b:true"; } return "b:false"; }
        return "";
    }

    private void _report(Z42Type subjType, StrMap covered, TypeEnv env, Span sp) {
        string tn = subjType.Name();
        // ── bool ──────────────────────────────────────────────
        if (PrimModel.Canon(tn) == "bool") {
            bool hasT = covered.ContainsKey("b:true");
            bool hasF = covered.ContainsKey("b:false");
            if (!hasT || !hasF) {
                string miss = "";
                if (!hasT) { miss = "true"; }
                if (!hasF) { if (miss != "") { miss = miss + ", "; } miss = miss + "false"; }
                this._tc._diags.Warning(DiagnosticCodes.SwitchNotExhaustive, "switch on bool is not exhaustive: missing " + miss + " (add the missing case or a default)", sp);
            }
            return;
        }
        // ── enum ──────────────────────────────────────────────
        string ek = (subjType is Z42ClassType) ? SymbolTable.DeclKey((subjType as Z42ClassType).Namespace, tn) : tn;   // enum 表键（FQN）
        if (env.Symbols.EnumTypes.ContainsKey(ek)) {
            string[] keys = env.Symbols.EnumConsts.Keys();
            string prefix = ek + ".";
            int missing = 0;
            string missNames = "";
            int i = 0;
            while (i < keys.Length) {
                string key = keys[i];
                // 余下部分不含 `.`：ns `A.Color` 里的 enum `X`（键 `A.Color.X.M`）不是 enum `A.Color` 的成员
                if (this._startsWith(key, prefix) && key.Substring(prefix.Length, key.Length - prefix.Length).IndexOf('.') < 0) {
                    StrBox vb = env.Symbols.EnumConsts.Get(key) as StrBox;
                    if (vb != null) {
                        string vk = "i:" + vb.Value;
                        if (!covered.ContainsKey(vk)) {
                            missing = missing + 1;
                            if (missNames != "") { missNames = missNames + ", "; }
                            missNames = missNames + tn + "." + key.Substring(prefix.Length, key.Length - prefix.Length);   // 消息写短名
                        }
                    }
                }
                i = i + 1;
            }
            if (missing > 0) {
                this._tc._diags.Warning(DiagnosticCodes.SwitchNotExhaustive, "switch on enum " + tn + " is not exhaustive: missing " + missNames + " (add the missing case(s) or a default)", sp);
            }
            return;
        }
        // ── 封闭（非 public）类层次 ──────────────────────────────
        // add-internal-hierarchy-exhaustiveness：subject 静态类型是「非 public 类」（internal/private/
        // protected）时，别的包命名不了它 → 无法跨包继承/switch → 该基类的全部子类 + 全部 switch 必同处
        // 本包 ⟹ 本包可见子类集 = 完整子类集，穷尽判定健全。枚举 subtree 里的具体（非 abstract）本地类，
        // 每个都须被某类型模式覆盖（含 `case Base/AbstractMid:` 吞子树），缺则 W0700。
        this._reportClosedHierarchy(tn, covered, env, sp);
        // 其它类型（public/开放域）→ 不检查。
    }

    private void _reportClosedHierarchy(string tn, StrMap covered, TypeEnv env, Span sp) {
        Z42ClassType baseCt = env.Symbols.GetClass(tn);
        if (baseCt == null) { return; }                        // 非 class（接口/枚举/基元）→ 不查
        if (baseCt.IsImported) { return; }                     // imported（跨包可见）→ 非本包封闭
        if (baseCt.Visibility == "public") { return; }         // public → 开放世界，下游可扩展，不健全
        if (baseCt.IsStruct) { return; }                       // struct 值类型无继承层次
        if (baseCt.GenericParamCount > 0 || baseCt.HasArityMangle) { return; }  // 泛型封闭层次 defer

        // 遍历全部类（FQN 视图，按 FQN 排序 ⇒ 缺失名单的先后确定）；子类关系按对象判（`IsSubclassOfType`），
        // 不按短名再解析一遍 —— 同包别的 ns 里的子类不在本 CU 作用域内，按名字查不到。
        Z42ClassType[] all = env.Symbols.SortedClasses();
        int subCount = 0;              // 严格子类数（判定是否真为层次，非孤立类）
        int missing = 0;
        string missNames = "";
        int i = 0;
        while (i < all.Length) {
            Z42ClassType ct = all[i];
            if (ct != null && !ct.IsImported) {
                bool isStrictSub = ct != baseCt && env.Symbols.IsSubclassOfType(ct, baseCt);
                if (isStrictSub) { subCount = subCount + 1; }
                bool inSubtree = ct == baseCt || isStrictSub;
                // 必须覆盖集 = subtree 里的具体（可实例化）类；abstract 类恒无运行期实例 → 排除。
                if (inSubtree && !ct.IsAbstract) {
                    if (!this._isTypeCovered(ct, covered, env)) {
                        missing = missing + 1;
                        if (missNames != "") { missNames = missNames + ", "; }
                        // 名单写短名；子类不在基类的 ns 里时写全名 —— 那个短名在 switch 处可能指别的类。
                        missNames = missNames + (ct.Namespace == baseCt.Namespace ? ct.Name() : ct.Fqn());
                    }
                }
            }
            i = i + 1;
        }
        // 仅当确是封闭层次（≥1 子类）才报——孤立的非 public 类不当作 sum type，避免误报。
        if (subCount >= 1 && missing > 0) {
            this._tc._diags.Warning(DiagnosticCodes.SwitchNotExhaustive, "switch on closed type " + tn + " is not exhaustive: missing " + missNames + " (add the missing case(s) or a default)", sp);
        }
    }

    // 具体类 concrete 是否被某类型模式覆盖：直接命中 "t:"+concrete，或被某祖先类型模式吞（`case Base b:`
    // / `case AbstractMid:` 覆盖整棵子树 → concrete IsSubclassOf 该模式类型）。
    // 模式的类型键先按 FQN 取类、取不到再按本 CU 作用域解析，然后按对象判子类关系（`concrete` 本身就是对象）。
    private bool _isTypeCovered(Z42ClassType concrete, StrMap covered, TypeEnv env) {
        if (covered.ContainsKey("t:" + concrete.Fqn())) { return true; }
        string[] ks = covered.Keys();
        int i = 0;
        while (i < ks.Length) {
            string k = ks[i];
            if (this._startsWith(k, "t:")) {
                string tkey = k.Substring(2, k.Length - 2);
                Z42ClassType pt = env.Symbols.ClassesByFqn.Get(tkey) as Z42ClassType;
                if (pt == null) { pt = env.Symbols.GetClass(tkey); }
                if (env.Symbols.IsSubclassOfType(concrete, pt)) { return true; }
            }
            i = i + 1;
        }
        return false;
    }


    private bool _startsWith(string s, string prefix) {
        if (s.Length < prefix.Length) { return false; }
        return s.Substring(0, prefix.Length) == prefix;
    }
}
