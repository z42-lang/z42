// simplify-ref-parameters：调用点修饰符与形参的对称性检查。
//
// 从 OverloadBinder 拆出来——它是个独立关注点（修饰符对称 vs 类型可转），
// 而且 OverloadBinder 已经贴着 886 行硬限（code-organization.md）。
namespace Z42.Semantics;

using Z42.Core;
using Z42.Symbols;

public static class RefArgCheck {

    // 调用点修饰符必须与形参对称。这条修的是 `fix-silent-semantic-gaps` 剩余缺口里排第一的那个：
    // `void Inc(ref int x)` 配 `Inc(v)` 此前**编译通过且写入静默丢失**（callee 改的是自己的
    // 形参寄存器，出口 copy-out 没有 caller 的 lvalue 可写回）。反向（形参无 `ref`、实参写了）
    // 同样报——那会白取一次地址，而且读代码的人会以为有写回，等于「按引用与否由调用点决定」。
    //
    // 导入签名的 `ref` 信息由包中的完备性标记确认。HasRefInfo 为假时，跳过对称性检查。
    public static void CheckSymmetry(TypeChecker tc, BoundExpr[] args, int i, Z42FuncType sig) {
        if (sig == null) { return; }
        if (!sig.HasRefInfo()) { return; }
        if (args[i] == null) { return; }
        bool paramRef = sig.IsRefParam(i);
        bool argRef = args[i] is BoundRefArg;
        if (paramRef && argRef) {
            RefArgCheck.CheckStorage(tc, args[i] as BoundRefArg, sig.ParamTypes[i], false);
            return;
        }
        if (!paramRef && !argRef) { return; }
        Span sp = args[i].Span;
        if (paramRef) {
            tc._diags.Error(DiagnosticCodes.RefArgModifierMissing,
                "argument " + (i + 1).ToString() + " must be passed with `ref` — the parameter is `ref`, "
                + "and without it the callee's write is silently lost", sp);
        } else {
            tc._diags.Error(DiagnosticCodes.RefArgModifierUnexpected,
                "argument " + (i + 1).ToString() + " must not be passed with `ref` — the parameter is not `ref`", sp);
        }
    }
    // Successful argument adaptation returns in parameter order without going through CheckSymmetry.
    internal static void CheckAdaptedSlots(TypeChecker tc, BoundExpr[] args, Z42FuncType sig) {
        if (sig == null || !sig.HasRefInfo()) { return; }
        int i = 0;
        while (i < args.Length && i < sig.ParamCount) {
            if (sig.IsRefParam(i) && args[i] is BoundRefArg) {
                RefArgCheck.CheckStorage(tc, args[i] as BoundRefArg, sig.ParamTypes[i], false);
            }
            i = i + 1;
        }
    }

    // The address register is Unknown; only the lvalue identifies the writable storage.
    // Inline declarations and discards do not have a previously declared type.
    internal static Z42Type ArgumentType(BoundExpr arg) {
        var address = arg as BoundRefArg;
        if (address == null) { return arg == null ? null : arg.Type(); }
        if (address.Inner == null || address.IsVarDecl || address.IsDiscard) { return null; }
        return address.Inner.Type();
    }

    internal static bool MatchesStorage(Z42Type source, Z42Type target, bool sameScope) {
        if (!sameScope && !IfaceSlotKeys.IsClosed(target)) { return true; }
        string sourceKey = LayoutKey.Of(source);
        string targetKey = LayoutKey.Of(target);
        return sourceKey == "" || targetKey == "" || sourceKey == targetKey;
    }

    internal static void CheckStorage(TypeChecker tc, BoundRefArg arg, Z42Type target, bool sameScope) {
        Z42Type source = RefArgCheck.ArgumentType(arg);
        if (!RefArgCheck.MatchesStorage(source, target, sameScope)) {
            tc._diags.Error(DiagnosticCodes.TypeMismatch,
                "ref argument has type " + Z42Type.DiagName(source)
                + " but the writable parameter requires " + Z42Type.DiagName(target), arg.Span);
        }
    }

    internal static void CheckResolvedGenericSlots(TypeChecker tc, BoundExpr[] args, int count,
                                                    Z42FuncType raw, Z42FuncType resolved) {
        if (raw == null || resolved == null || !raw.HasRefInfo()) { return; }
        for (int i = 0; i < count && i < raw.ParamCount; i = i + 1) {
            if (raw.IsRefParam(i) && args[i] is BoundRefArg
                && Conversion._hasGenericParam(raw.ParamTypes[i])
                && Conversion._hasGenericParam(resolved.ParamTypes[i])) {
                RefArgCheck.CheckStorage(tc, args[i] as BoundRefArg, resolved.ParamTypes[i], true);
            }
        }
    }

    // Keep the original candidates when no mode fits so binding can report the
    // modifier error on the selected signature.
    public static MethodSymbol[] MatchingOverloads(MethodSymbol[] methods, BoundExpr[] args, int count) {
        int keep = 0;
        foreach (var method in methods) {
            if (RefArgCheck._matches(method.Signature, args, count)) { keep = keep + 1; }
        }
        if (keep == 0 || keep == methods.Length) { return methods; }
        MethodSymbol[] filtered = new MethodSymbol[keep];
        int i = 0;
        foreach (var method in methods) {
            if (RefArgCheck._matches(method.Signature, args, count)) {
                filtered[i] = method;
                i = i + 1;
            }
        }
        return filtered;
    }

    private static bool _matches(Z42FuncType sig, BoundExpr[] args, int count) {
        if (sig == null || !sig.HasRefInfo()) { return true; }
        int i = 0;
        while (i < count) {
            if (sig.IsRefParam(i) != (args[i] is BoundRefArg)) { return false; }
            if (i < sig.ParamCount && sig.IsRefParam(i) && !RefArgCheck.MatchesStorage(
                RefArgCheck.ArgumentType(args[i]), sig.ParamTypes[i], false)) { return false; }
            i = i + 1;
        }
        return true;
    }

}
