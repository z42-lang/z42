// add-target-typed-funcref-resolution：自由函数取引用的 target-typed 重载消解（与 ExprTyper 主文件同一个类，
// partial 拆分只为守 code-organization 行数上限）。入口在主文件 `BindWithTarget` 的 `IdentExpr + Z42FuncType`
// 分支；此处放消解本体 + 实参延迟谓词。消解语义 = **精确全签名**（`Z42FuncType.IsAssignableTo` 逐位相等、无变型）：
// z42 委托相容即精确相等，故合法目标唯一 = 签名与委托精确相等的那个重载。发射用选中重载的 RegKey
// （primary=裸键、非-primary=mangle 键），LoadFn 与 free-call 走同一 func_index。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.Core;
using Z42.Symbols;

public sealed partial class ExprTyper {

    // 给定裸标识符 + 目标委托类型，在同名自由函数重载间按精确全签名消解。返回 null ⇒ 非自由函数名，交回普通绑定。
    private BoundExpr _bindFuncRefTargeted(IdentExpr id, Z42FuncType target, TypeEnv env) {
        if (env.LookupVar(id.Name) != null) { return null; }          // 局部变量（含委托变量读）→ 普通绑定
        string ns = env.Symbols.ResolveFuncNs(id.Name);
        if (ns == null) { return null; }                              // 非自由函数名 → 普通绑定
        this._tc.NoteFuncRef(env.Symbols, id.Name, ns, id.Span);   // 函数引用（有目标委托类型）：ns + 归属包 + E0497
        MethodSymbol[] cands = env.Symbols.GetFuncCandidates(ns, id.Name);
        if (cands.Length <= 1) {
            // 无重载：现状即走此（经 _bindIdent），此处 target 在场同样直接取用（相容由后续 CheckImplicitConvert 校验）。
            MethodSymbol only = env.Symbols.GetFuncIn(ns, id.Name);
            if (only == null) { return null; }
            return new BoundFuncRef(id.Name, ns, !only.HasDecl, only.Signature, only.RegKey, id.Span);
        }
        // 多重载：按目标委托签名精确过滤。
        MethodSymbol chosen = null;
        int nmatch = 0;
        int i = 0;
        while (i < cands.Length) {
            Z42FuncType csig = cands[i].Signature as Z42FuncType;
            if (csig != null && csig.IsAssignableTo(target)) { chosen = cands[i]; nmatch = nmatch + 1; }
            i = i + 1;
        }
        if (nmatch == 1) {
            return new BoundFuncRef(id.Name, ns, !chosen.HasDecl, chosen.Signature, chosen.RegKey, id.Span);
        }
        if (nmatch == 0) {
            this._tc._diags.Error(DiagnosticCodes.FuncRefNoMatchingOverload,
                "no overload of free function `" + id.Name + "` matches target delegate type `"
                + target.Name() + "`; candidates: " + this._funcCandSigs(cands), id.Span);
        } else {
            // ≥2 精确匹配：仅泛型基类替换后同签名可达。
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous reference to overloaded free function `" + id.Name + "` for target delegate type `"
                + target.Name() + "`; candidates: " + this._funcCandSigs(cands), id.Span);
        }
        return new BoundError("unresolved funcref " + id.Name, new Z42ErrorType(), id.Span);
    }

    // 候选签名列表（诊断用逃生口，参 methodof 的 E0459/E0460）。
    private string _funcCandSigs(MethodSymbol[] cands) {
        string s = "";
        int i = 0;
        while (i < cands.Length) {
            if (i > 0) { s = s + ", "; }
            s = s + (cands[i].Signature == null ? cands[i].Name : cands[i].Signature.Name());
            i = i + 1;
        }
        return s;
    }

    // 实参位上的裸名是否**重载自由函数**（须延迟到重载决议后按形参委托签名消解）。只延迟**重载**的（≥2 候选）——
    // 单份 funcref 实参保持急切绑定 ⇒ 既有代码零行为变化、字节中性（同 IsNamedArg 保守判据）。局部变量优先。
    public static bool IsOverloadedFuncRefArg(Expr e, TypeEnv env) {
        if (e is IdentExpr) {
            string nm = (e as IdentExpr).Name;
            if (env.LookupVar(nm) != null) { return false; }
            string ns = env.Symbols.ResolveFuncNs(nm);
            if (ns == null) { return false; }
            return env.Symbols.GetFuncCandidates(ns, nm).Length > 1;
        }
        // feat/method-group-arg-deferral：**重载方法组实参**（`Run(obj.M)` / `Run(C.F)`）同款
        // 延迟——回填位经 `BindWithTarget` 的 MemberExpr 分支（#1901）按形参委托签名精确选中。
        // 只认无需绑定 receiver 即可数出候选的两种形态：target 是裸类名（静态组）或 IdentExpr
        // 收者且类型为非内建类（实例组，局部/形参）。复杂 receiver / 基类链上的重载保持急切
        // 绑定——探测性绑定会引发重复诊断，宁窄勿滥（同 IsNamedArg 的保守判据纪律）。
        if (e is MemberExpr) {
            MemberExpr me = e as MemberExpr;
            if (!(me.Target is IdentExpr)) { return false; }
            IdentExpr tid = me.Target as IdentExpr;
            Z42ClassType ct = null;
            bool wantStatic = false;
            Z42Type vt = env.LookupVar(tid.Name);
            if (vt == null) {
                ct = env.Symbols.GetClass(tid.Name); wantStatic = true;   // 静态组：裸类名
            } else if ((vt is Z42ClassType) && !vt.IsBuiltinType()) {
                ct = vt as Z42ClassType;                                   // 实例组：类收者局部/形参
            }
            if (ct == null) { return false; }
            return MemberResolver._ownMethodsOfKind(ct, me.Name, wantStatic) >= 2;
        }
        return false;
    }

    // feat/method-group-target-typed：**重载方法组 + 目标委托类型** → 按精确全签名消解（镜像上面的
    // 自由函数消解）。覆盖实例 `obj.M`（候选 = _collectInstanceOverloads，含基链、按有效签名去重）
    // 与静态 `C.F`（MemberResolver.ResolveStaticMethodGroupTargeted）。≤1 候选返回 null——单方法
    // 路径普通绑定已正确（相容由 CheckImplicitConvert 校验）；≥2 时 0 匹配报 E0477、恰一命中构造
    // 方法组节点并带**发射键**（thunk VCall / LoadFn 据此定向到非-primary 重载）。
    // 覆盖位 = BindWithTarget 的调用面（声明 / 赋值 / return / 初始化器）；实参位不延迟——
    // 重载方法组作实参仍按普通绑定报 E0425/E0401，参考手册保持记载。
    private BoundExpr _bindMethodGroupTargeted(MemberExpr m, Z42FuncType target, TypeEnv env) {
        // 静态形态一：target 是裸类名（非变量、可解析为类）。
        if (m.Target is IdentExpr) {
            IdentExpr tid = m.Target as IdentExpr;
            if (env.LookupVar(tid.Name) == null) {
                Z42ClassType sct = env.Symbols.GetClass(tid.Name);
                if (sct != null) {
                    return this._tc._member.ResolveStaticMethodGroupTargeted(sct, tid.Name, m.Name, target, m.Span, env);
                }
            }
        }
        // 静态形态二：target 是类型路径（ns 全限定 `Ns.C.F` / 嵌套 `Outer.Inner.F`）——
        // `_nestedTypeKey` 认出的按声明类走静态消解；否则它不是类型路径，继续实例形态
        //（不先绑 target：`Ns.C` 作表达式会报 undefined，抢掉 `_bindNestedStaticMember` 的路）。
        string nk = this._tc._member._nestedTypeKey(m.Target, env);
        if (nk != "") {
            Z42ClassType sct = env.Symbols.GetClass(nk);
            if (sct != null) {
                return this._tc._member.ResolveStaticMethodGroupTargeted(sct, nk, m.Name, target, m.Span, env);
            }
        }
        // 实例形态：target 绑定后是（非内建）类收者；绑错（error）→ null 交回普通绑定。
        BoundExpr recv = this._bindExpr(m.Target, env);
        if (recv is BoundError || recv.Type() is Z42ErrorType) { return null; }
        Z42ClassType ct = recv.Type() as Z42ClassType;
        if (ct == null || recv.Type().IsBuiltinType()) { return null; }
        MethodSymbol[] cands = this._tc._overload._collectInstanceOverloads(env.Symbols, ct, m.Name);
        if (cands.Length < 2) { return null; }
        MethodSymbol chosen = null;
        int nmatch = 0;
        int i = 0;
        while (i < cands.Length) {
            Z42FuncType csig = cands[i].Signature as Z42FuncType;
            if (csig != null && csig.IsAssignableTo(target)) { chosen = cands[i]; nmatch = nmatch + 1; }
            i = i + 1;
        }
        if (nmatch != 1) {
            if (nmatch == 0) {
                this._tc._diags.Error(DiagnosticCodes.FuncRefNoMatchingOverload,
                    "no overload of `" + ct.Name() + "." + m.Name + "` matches target delegate type `"
                    + target.Name() + "`; candidates: " + this._funcCandSigs(cands), m.Span);
            } else {
                this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                    "ambiguous reference to overloaded `" + ct.Name() + "." + m.Name + "` for target delegate type `"
                    + target.Name() + "`; candidates: " + this._funcCandSigs(cands), m.Span);
            }
            return new BoundError("unresolved method group " + m.Name, new Z42ErrorType(), m.Span);
        }
        this._tc._access.CheckAccess(chosen.Visibility, chosen.ContainingTypeName, env, env.Symbols, "method", m.Name, m.Span);
        this._tc._access.CheckDeprecatedM(chosen, m.Name, m.Span);
        BoundMethodGroup g = new BoundMethodGroup(recv, ct.Name(), m.Name, chosen.Signature, m.Span);
        g.OwnerCt = ct;
        g.MethodKey = chosen.CallKey();
        return g;
    }

}
