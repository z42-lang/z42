// 类型操作表达式类型绑定簇（refactor-exprtyper-concern-split：从 ExprTyper 按职责抽出）。
// 承载 (T)x 显式转换、x as T、typeof(T)、x is T 的类型绑定（含用户转换 lower、访问性检查
// _chkTypeRef、is-pattern 变量声明、方法级 typeof 具体化）。共享 TypeChecker（同一 _tc）；
// 递归子表达式 _bindExpr 经父反向引用 _et 委回 ExprTyper。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.Core;
using Z42.Symbols;

public sealed class TypeOpTyper {
    private TypeChecker _tc;
    private ExprTyper _et;   // 反向引用：递归 _bindExpr 委回 ExprTyper
    public TypeOpTyper(TypeChecker tc, ExprTyper et) { this._tc = tc; this._et = et; }

    // make-ref-hard-cast-checked：这次 `(T)x` 是不是需要**运行期受检**的引用转换？
    //
    // `ExplicitRef`（基→派生）之外，`Classify` 给 `None` 而又不可证必败（必败的已报 E0424）的
    // 引用目标同样是要在运行期核对的转换：从 `object` / 接口下转、`Array` → `T[]`、类 → 其泛型子类
    // 实例化、基链相关但实参无从代换的实例化、`object` → 数组。`Conversion.IsRefTarget` 排除值类型
    // 目标（`(int)o` / `(P2)o` 是**拆箱**，另有其路：基元走 ConvertInstr，blob struct 走 `_emitConvert`
    // 的拆箱臂）与 string（ConvertInstr 按目标 IrType.Str 核）。
    private static bool _isCheckedRefCast(ConvResult ur, Z42Type from, Z42Type to) {
        if (to is Z42GenericParamType) { return !(from is Z42GenericParamType && from.Name() == to.Name()); }
        if (ur.Kind == ConvKind.ExplicitRef) { return true; }
        if (ur.Kind != ConvKind.None) { return false; }
        return Conversion.IsRefTarget(to);
    }

    // 显式转换在任何运行期值上都不可能成功 ⇒ E0424（C# CS0030 / CS0039）。判据见 `Conversion.ProvablyFails`。
    private bool _rejectImpossibleCast(ConvResult ur, Z42Type from, Z42Type to, SymbolTable syms, string op, Span sp) {
        if (ur.Kind != ConvKind.None) { return false; }
        if (!Conversion.ProvablyFails(from, to, syms)) { return false; }
        this._tc._diags.Error(DiagnosticCodes.IllegalCast,
            op + ": `" + TypeNameResolver.SurfaceTypeName(from) + "` can never be a `"
            + TypeNameResolver.SurfaceTypeName(to)
            + "` — the types are unrelated, so the conversion would fail for every value", sp);
        return true;
    }

    internal BoundExpr _bindCastExpr(CastExpr cx, TypeEnv env) {
            BoundExpr operand = this._et._bindExpr(cx.E, env);
            Z42Type target = env.ResolveType(cx.Type);
            this._tc._chkTypeRef(target, env, cx.Type.Span);   // enforce-class-access：cast 目标类型引用
            this._tc.ChkAmbiguousBareNameT(env.Symbols, cx.Type, cx.Type.Span);   // add-bare-name-ambiguity-diagnostic：E0456
            // add-user-conversions：显式 (T)x 接受 implicit 与 explicit 用户转换 → lower 成 op_Implicit/op_Explicit 调用。
            // 数值/引用 cast（非用户转换）维持 BoundConvert，codegen 不变。
            ConvResult ur = Conversion.Classify(operand.Type(), target, env.Symbols);
            if ((ur.Kind == ConvKind.UserImplicit || ur.Kind == ConvKind.UserExplicit) && ur.Method != null) {
                return TypeChecker._lowerUserConv(operand, ur);
            }
            // add-user-conversions ③：无任何转换但存在中间类型 A→B→C → 提示写 (C)(B)x（仅存在用户转换时才可能触发）。
            if (ur.Kind == ConvKind.None) {
                string via = this._tc._suggestVia(operand.Type(), target, env.Symbols);
                if (via != "") {
                    this._tc._diags.Error(DiagnosticCodes.TypeMismatch,
                        "cannot convert '" + operand.Type().Name() + "' to '" + target.Name()
                        + "'; a conversion through '" + via + "' exists — write (" + target.Name() + ")(" + via + ")x", cx.Span);
                    return new BoundError("no conversion", new Z42ErrorType(), cx.Span);
                }
            }
            if (this._rejectImpossibleCast(ur, operand.Type(), target, env.Symbols, "cannot cast", cx.Span)) {
                return new BoundError("impossible cast", new Z42ErrorType(), cx.Span);
            }
            BoundConvert bc = new BoundConvert(operand, target, cx.Span);
            // make-ref-hard-cast-checked：引用**下**转（基→派生）此前在发射层**一条指令都不发**
            // ⇒ `(B)o`（o 其实是 A）不抛、返回非 null，错类型的对象原样流下去，到很远的地方才崩。
            // 值类型那半 #746 已修（null→NullReferenceException / 类型不符→InvalidCastException），
            // 引用这半一直欠着。判据就是 `ExplicitRef`，**只在这条（用户写的 cast）路上置位**。
            bc.CheckedRefCast = TypeOpTyper._isCheckedRefCast(ur, operand.Type(), target);
            return bc;
    }

    internal BoundExpr _bindAsExpr(AsExpr ax, TypeEnv env) {
            BoundExpr operand = this._et._bindExpr(ax.E, env);
            // 目标名用 AST 原始类型名（镜像 `is` → BoundIsExpr.TypeName）：imported 接口/内建类
            // ResolveType 得 Unknown → "<unknown>" 会致 as_cast 目标失配（跨包接口 `as` 恒 null）。
            string tn;
            if (ax.Type is NamedType) { tn = (ax.Type as NamedType).Name; }
            else { tn = env.ResolveType(ax.Type).Name(); }
            Z42Type asTarget = env.ResolveType(ax.Type);
            this._tc._chkTypeRef(asTarget, env, ax.Type.Span);   // enforce-class-access：as 目标类型引用
            this._tc.ChkAmbiguousBareNameT(env.Symbols, ax.Type, ax.Type.Span);   // add-bare-name-ambiguity-diagnostic：E0456
            ConvResult ur = Conversion.Classify(operand.Type(), asTarget, env.Symbols);
            if (this._rejectImpossibleCast(ur, operand.Type(), asTarget, env.Symbols, "`as` never succeeds", ax.Span)) {
                return new BoundError("impossible as", new Z42ErrorType(), ax.Span);
            }
            return new BoundCast(operand, asTarget, tn, ax.Span);
    }

    internal BoundExpr _bindTypeofExpr(TypeofExpr tox, TypeEnv env) {
            Z42Type toTarget = env.ResolveType(tox.Type);
            this._tc._chkTypeRef(toTarget, env, tox.Type.Span);   // enforce-class-access：typeof 目标类型引用
            this._tc.ChkAmbiguousBareNameT(env.Symbols, tox.Type, tox.Type.Span);   // add-bare-name-ambiguity-diagnostic：E0456
            // 结果类型 = Std.Type（反射 Type 类；Name/GetFields/FullName 等成员据此解析）。
            Z42Type toType = env.ResolveType(NamedType.Synth("Type", new TypeExpr[0], 0, tox.Span));
            // AST 原始名（typeof-delegate）：delegate 目标解析成结构化 Z42FuncType 丢 FQ 名，
            // 发射时用它 QualifyClass 回 FQ delegate 名。
            string targetName = (tox.Type is NamedType) ? (tox.Type as NamedType).Name : "";
            BoundTypeof bto = new BoundTypeof(toTarget, targetName, toType, tox.Span);
            // add-generic-methods：方法级 typeof(T) → 发 MethodTypeArgInsn 具体化（读 frame 槽）。
            // fix-class-level-typeof：否则试类级 → 发 `__class_type_arg(this, idx)`（读 instance.type_args）。
            //
            // **顺序即「就近优先」，不能颠倒**：方法级先查，同名时遮蔽类级。与 `_bindDefault`
            // / `_bindArrayNew` 的既有口径逐字一致（`default(T)` / `new T[n]` 也是这个顺序）。
            if (toTarget is Z42GenericParamType) {
                int mIdx = env.MethodParamIndexOf(toTarget.Name());
                if (mIdx >= 0) { bto.IsMethodLevel = true; bto.MethodParamIndex = mIdx; }
                else {
                    int cIdx = env.ClassParamIndexOf(toTarget.Name());
                    // 🔴 **实例语境判据不可省**：类级载体是 `regs[0].instance.type_args`，而
                    // **静态帧的 reg0 是第一个实参、不是 this**。不查语境就会把
                    // `static string S(Box<int> o) { return typeof(T).FullName; }` 解析成实参
                    // `o` 的型参（实测 `default(T)` 在这一形态下今天就产 `0` 而非 `null` ——
                    // 那是既有的静默 bug，本变更不把它搬进 typeof）。
                    // 判据沿用 `MemberResolver.Bare` 判实例语境的同一条，不自创机制。
                    // 落不到类级 ⇒ 维持既有 TypeofInstr（占位名），行为逐字不变。
                    if (cIdx >= 0 && env.LookupVar("this") != null) {
                        bto.IsClassLevel = true; bto.ClassParamIndex = cIdx;
                    }
                }
            }
            return bto;
    }

    // methodof(Type.Member[(签名)]) → Std.Reflection.MethodInfo（add-method-reference）。
    //
    // **重载决议全部在这里收口**——落到 IR 时只剩一个已消歧的 qualified 名。这是本特性的
    // 全部价值所在：零匹配与多匹配**都报错，绝不静默择一**。静默择一会把本特性要根治的
    // 「函数名/签名改了，引用点悄悄绑到别处」原样搬回来。
    //
    // 匹配用 `OverloadResolver.TypeKey`（**派发口径**，键推导的 SoT）而非 `SurfaceTypeName`
    // （那是 TSIG 导出口径）：两侧都过 TypeKey ⇒ 落在同一套字母表，且就是运行期真正用的键。
    // 诊断展示反过来用 `SurfaceTypeName`（人读的表面拼写）。
    [Suppress("style.fnLinesHard", "101 body lines；拆分见 code-organization.md")]
    internal BoundExpr _bindMethodOfExpr(MethodOfExpr mx, TypeEnv env) {
            // 结果类型用 **FQ 名**解析：`Std.Reflection.MethodInfo` 无需 using、也无需声明依赖
            // （标准库既定设计，实测通过）。短名 `MethodInfo` 会强迫用户写 using，与 typeof 不对称。
            Z42Type resultT = env.ResolveType(NamedType.Synth("Std.Reflection.MethodInfo", new TypeExpr[0], 0, mx.Span));
            // 语法层已就 `methodof(Logger)`（缺 `.Member`）报过 E0462 —— 不再追加一条
            // 「没有名为 `` 的方法」的噪声。一个错误一条诊断。
            if (mx.Member == "") { return new BoundError("methodof malformed", new Z42ErrorType(), mx.Span); }
            Z42Type ownerT = env.ResolveType(new NamedType(mx.OwnerName, new TypeExpr[0], 0, mx.OwnerSpan));
            if (!(ownerT is Z42ClassType)) {
                this._tc._diags.Error(DiagnosticCodes.UndefinedType,
                    "methodof: undefined type `" + mx.OwnerName + "`", mx.OwnerSpan);
                return new BoundError("methodof owner unresolved", new Z42ErrorType(), mx.Span);
            }
            Z42ClassType ownerCt = ownerT as Z42ClassType;
            this._tc._chkTypeRef(ownerT, env, mx.OwnerSpan);   // enforce-class-access：owner 类型引用

            // ── 指不了的方法（v1 明确报错，不假装支持）──────────────────────────────
            // 运算符与转换**根本没有名字**：源码里是 `operator +` / `implicit operator T`，
            // `op_*` 是编译器造的内部名。这条检查必须**先于候选收集**——运算符压根不进
            // `ct.Methods`（实测 `methodof(Vec.op_Addition)` 的 available 列表里没有它），
            // 否则会先撞上「没有这个方法」，给出的诊断答非所问。
            if (TypeOpTyper._startsWith(mx.Member, "op_")) {
                this._tc._diags.Error(DiagnosticCodes.MethodOfUnreferenceable,
                    "methodof: cannot reference an operator or conversion (`" + mx.Member
                    + "`) — operators have no source-level name, and `op_*` is a compiler-internal "
                    + "spelling that is not part of the language. Wrap the operator in a named "
                    + "method and reference that instead", mx.MemberSpan);
                return new BoundError("methodof unreferenceable", new Z42ErrorType(), mx.Span);
            }

            // ── 候选收集：沿继承链，含 imported（TSIG 已把继承方法展平进各派生类 Methods）──
            // 迭代 StrMap 前**必须按键排序**：hash 顺序非确定，而候选序决定诊断文案的列出顺序
            // （加载顺序确定性规则）。派生类先走 ⇒ override 的那份先入表，基类同 RegKey 不再重复收。
            MethodSymbol[] cands = new MethodSymbol[8];
            string[] candKeys = new string[8];
            string[] candOwnerFq = new string[8];
            int cc = 0;
            Z42ClassType cur = ownerCt;
            int hops = 0;
            while (cur != null) {
                string[] keys = cur.Methods.Keys();
                TypeOpTyper._sortStr(keys);
                int i = 0;
                while (i < keys.Length) {
                    MethodSymbol ms = cur.Methods.Get(keys[i]) as MethodSymbol;
                    if (ms != null && ms.Name == mx.Member) {
                        string rk = ms.RegKey;
                        if (rk == "") { rk = keys[i]; }
                        if (!TypeOpTyper._hasStr(candKeys, cc, rk)) {
                            if (cc == cands.Length) {
                                MethodSymbol[] nb = new MethodSymbol[cands.Length * 2];
                                string[] kb = new string[cands.Length * 2];
                                string[] ob = new string[cands.Length * 2];
                                Array.Copy(cands, nb, cc); Array.Copy(candKeys, kb, cc); Array.Copy(candOwnerFq, ob, cc);
                                cands = nb; candKeys = kb; candOwnerFq = ob;
                            }
                            cands[cc] = ms; candKeys[cc] = rk; candOwnerFq[cc] = cur.Fqn(); cc = cc + 1;
                        }
                    }
                    i = i + 1;
                }
                if (!cur.HasBase) { break; }
                cur = env.Symbols.BaseOf(cur);   // A5：走句柄
                hops = SymbolTable.NextBaseHop(hops);
            }

            if (cc == 0) {
                this._tc._diags.Error(DiagnosticCodes.MethodOfTargetNotFound,
                    "methodof: type `" + ownerCt.Fqn() + "` has no method named `" + mx.Member + "`"
                    + TypeOpTyper._availableNames(ownerCt, env), mx.MemberSpan);
                return new BoundError("methodof target not found", new Z42ErrorType(), mx.Span);
            }

            // ── 签名消歧 ────────────────────────────────────────────────────────────
            MethodSymbol chosen = null;
            string chosenKey = "";
            string chosenOwnerFq = "";
            if (mx.HasParamList) {
                Z42Type[] want = new Z42Type[mx.ParamCount];
                int i = 0;
                while (i < mx.ParamCount) { want[i] = env.ResolveType(mx.ParamTypes[i]); i = i + 1; }
                int matched = 0;
                int mi = 0;
                while (mi < cc) {
                    if (TypeOpTyper._sigMatches(cands[mi], want, mx.ParamCount)) {
                        matched = matched + 1;
                        if (chosen == null) { chosen = cands[mi]; chosenKey = candKeys[mi]; chosenOwnerFq = candOwnerFq[mi]; }
                    }
                    mi = mi + 1;
                }
                if (matched == 0) {
                    this._tc._diags.Error(DiagnosticCodes.MethodOfTargetNotFound,
                        "methodof: no overload of `" + ownerCt.Fqn() + "." + mx.Member + "` takes ("
                        + TypeOpTyper._typeListText(want, mx.ParamCount) + ")"
                        + TypeOpTyper._overloadList(cands, cc), mx.MemberSpan);
                    return new BoundError("methodof no matching overload", new Z42ErrorType(), mx.Span);
                }
                if (matched > 1) {
                    // 泛型基类替换后同签名（Lippert 的第一类）会落到这里——参数类型列表也分不开。
                    this._tc._diags.Error(DiagnosticCodes.MethodOfAmbiguous,
                        "methodof: parameter type list ("
                        + TypeOpTyper._typeListText(want, mx.ParamCount) + ") matches "
                        + matched.ToString() + " overloads of `" + ownerCt.Fqn() + "." + mx.Member
                        + "` — they became identical after generic base substitution, so no parameter "
                        + "list can separate them" + TypeOpTyper._overloadList(cands, cc), mx.MemberSpan);
                    return new BoundError("methodof ambiguous", new Z42ErrorType(), mx.Span);
                }
            } else {
                if (cc > 1) {
                    this._tc._diags.Error(DiagnosticCodes.MethodOfAmbiguous,
                        "methodof: `" + ownerCt.Fqn() + "." + mx.Member + "` has " + cc.ToString()
                        + " overloads — add a parameter type list to pick one, e.g. `methodof("
                        + mx.OwnerName + "." + mx.Member + "("
                        + TypeOpTyper._sigParamText(cands[0]) + "))`"
                        + TypeOpTyper._overloadList(cands, cc), mx.MemberSpan);
                    return new BoundError("methodof needs signature", new Z42ErrorType(), mx.Span);
                }
                chosen = cands[0]; chosenKey = candKeys[0]; chosenOwnerFq = candOwnerFq[0];
            }

            return new BoundMethodOf(mx.OwnerName, ownerCt, chosenOwnerFq, chosenKey, chosen, resultT, mx.Span);
    }

    // fieldof(Type.Field) / propertyof(Type.Prop) → Std.Reflection.FieldInfo / PropertyInfo
    // （add-field-property-reference）。镜像 _bindMethodOfExpr，但**没有签名消歧**——
    // 字段与属性无重载，名字即身份；歧义面只剩「名字解析到哪一份」。
    //
    // 🔴 **第一个同名符号即终点（own-wins）**：`_passInheritFields` 把基类实例字段展平进派生类
    // Fields 表时已按 own-wins 去重，静态字段不展平——沿基链**派生优先**取第一个命中，与字段
    // 访问解析（`derivedObj.F` 看到的那份）同一口径。命中后**不再**往基类找同名的另一份：
    // 找了就会与访问语义分叉。命中符号的**族别**不符（fieldof 撞属性 / propertyof 撞字段）报
    // E0507/E0509 并给出**正确的关键字**——这正是「写错族」而不是「不存在」。
    //
    // 跨包属性走**访问器回落**：TSIG 不带属性名字段，属性以 `get_X`/`set_X` 访问器方法过界
    // （`BindStaticMember` 对静态属性的同一条约定）。本地类有 IsProp 的 FieldSymbol，导入类
    // 只能在 Methods 里认访问器——运行期 `__propertyof` 正是按访问器派生 PropertyInfo 的，
    // 两端同一口径。
    [Suppress("style.fnLinesHard", "78 body lines；候选走查与声明类定位一体两面的判定，拆分见 code-organization.md")]
    internal BoundExpr _bindFieldOfExpr(FieldOfExpr fx, TypeEnv env) {
            // 结果类型用 **FQ 名**解析（同 methodof：无需 using、无需声明依赖）。
            string rn = fx.IsProperty ? "Std.Reflection.PropertyInfo" : "Std.Reflection.FieldInfo";
            Z42Type resultT = env.ResolveType(NamedType.Synth(rn, new TypeExpr[0], 0, fx.Span));
            // 语法层已就缺 `.Member` / 带类型实参 / 带参数列表报过 E0508 —— 不再追加噪声。
            if (fx.Member == "") { return new BoundError("memberof malformed", new Z42ErrorType(), fx.Span); }
            string kw = fx.IsProperty ? "propertyof" : "fieldof";
            Z42Type ownerT = env.ResolveType(new NamedType(fx.OwnerName, new TypeExpr[0], 0, fx.OwnerSpan));
            if (!(ownerT is Z42ClassType)) {
                this._tc._diags.Error(DiagnosticCodes.UndefinedType,
                    kw + ": undefined type `" + fx.OwnerName + "`", fx.OwnerSpan);
                return new BoundError("memberof owner unresolved", new Z42ErrorType(), fx.Span);
            }
            Z42ClassType ownerCt = ownerT as Z42ClassType;
            this._tc._chkTypeRef(ownerT, env, fx.OwnerSpan);   // enforce-class-access：owner 类型引用

            // ── 沿基链找第一个同名符号（派生优先 = own-wins，见抬头）─────────────────
            FieldSymbol hit = null;
            Z42ClassType hitAt = null;
            Z42ClassType cur = ownerCt;
            int hops = 0;
            while (cur != null) {
                FieldSymbol fs = cur.Fields.Get(fx.Member) as FieldSymbol;
                if (fs != null) { hit = fs; hitAt = cur; break; }
                if (!cur.HasBase) { break; }
                cur = env.Symbols.BaseOf(cur);   // A5：走句柄
                hops = SymbolTable.NextBaseHop(hops);
            }
            if (hit == null) {
                // 跨包属性回落：导入类的 Fields 表只有 __prop_ 后备字段，属性身份在 Methods 里
                //（get_/set_ 访问器，TSIG 展平同方法）。派生优先，第一个命中的类即运行期
                // `__propertyof` 能解析出 PropertyInfo 的那份（其方法表已并继承访问器）。
                if (fx.IsProperty) {
                    Z42ClassType acc = TypeOpTyper._findAccessorProp(ownerCt, fx.Member, env);
                    if (acc != null) {
                        return new BoundFieldOf(fx.OwnerName, ownerCt, acc.Fqn(), fx.Member, null, true, resultT, fx.Span);
                    }
                }
                string code = fx.IsProperty ? DiagnosticCodes.PropertyOfTargetNotFound : DiagnosticCodes.FieldOfTargetNotFound;
                this._tc._diags.Error(code,
                    kw + ": type `" + ownerCt.Fqn() + "` has no " + (fx.IsProperty ? "property" : "field")
                    + " named `" + fx.Member + "`" + TypeOpTyper._availableMemberNames(ownerCt, env, fx.IsProperty), fx.MemberSpan);
                return new BoundError("memberof target not found", new Z42ErrorType(), fx.Span);
            }
            // 跨族点名：给**正确的关键字**，而不是一句空泛的「不存在」。
            if (hit.IsProp != fx.IsProperty) {
                string other = fx.IsProperty ? "fieldof" : "propertyof";
                string kind = fx.IsProperty ? "a field" : "a property";
                string code = fx.IsProperty ? DiagnosticCodes.PropertyOfTargetNotFound : DiagnosticCodes.FieldOfTargetNotFound;
                this._tc._diags.Error(code,
                    kw + ": `" + fx.Member + "` on `" + ownerCt.Fqn() + "` is " + kind
                    + " — write `" + other + "(" + fx.OwnerName + "." + fx.Member + ")` instead", fx.MemberSpan);
                return new BoundError("memberof wrong kind", new Z42ErrorType(), fx.Span);
            }
            // const 字段编译期折叠、无槽（ClassDescBuilder 不进字段元数据）⇒ 运行期无从物化。
            // 与 E0461「运算符指不了」同位：说清**为什么**，而非含糊的「不存在」。
            if (!fx.IsProperty && hit.IsConst) {
                this._tc._diags.Error(DiagnosticCodes.FieldOfTargetNotFound,
                    "fieldof: `" + fx.Member + "` is a `const` field — consts are compile-time folded and have "
                    + "no runtime slot, so there is no FieldInfo to reference (GetFields never lists it either); "
                    + "reference the constant value directly instead", fx.MemberSpan);
                return new BoundError("fieldof const", new Z42ErrorType(), fx.Span);
            }

            // ── 声明类定位：实例字段会被 TSIG 展平进派生类 Fields 表（导入类尤甚，那里的
            // ContainingTypeName 记的是**被装载的类**、不是真声明者）——自有字段有序表
            // OwnFieldNames 才是「本类声明了它」的权威信号（本地=MemberCollector 自有条目；
            // 导入=TSIG own-only 导出）。不在自有表 ⇒ 沿基链找第一个自有声明；找不到退回
            // 命中层 Fqn()（运行期 __fieldof 自会沿基链兜底存储，只是 attribute 解析在那
            // 个退化形态下可能落空）。属性不走这条：OwnFieldNames 记的是 `__prop_X` 后备名、
            // 不是源名 X，拿它判属性会误伤「基类有同名字段」的形态；本地属性恒由本类声明。
            string declFq = hitAt.Fqn();
            if (!fx.IsProperty && !hit.IsStatic && !TypeOpTyper._ownFieldHas(hitAt, hit.Name)) {
                Z42ClassType up = hitAt;
                int uhops = 0;
                while (up != null) {
                    if (TypeOpTyper._ownFieldHas(up, hit.Name)) { declFq = up.Fqn(); break; }
                    if (!up.HasBase) { break; }
                    up = env.Symbols.BaseOf(up);
                    uhops = SymbolTable.NextBaseHop(uhops);
                }
            }
            return new BoundFieldOf(fx.OwnerName, ownerCt, declFq, fx.Member, hit, fx.IsProperty, resultT, fx.Span);
    }

    // 类的自有实例字段表（OwnFieldNames，声明序）里是否声明了 `name`。静态不入此表
    //（MemberCollector/ImportedSymbolLoader 同口径）——静态从不展平，无须它判。
    private static bool _ownFieldHas(Z42ClassType ct, string name) {
        int i = 0;
        while (i < ct.OwnFieldCount) {
            if (ct.OwnFieldNames[i] == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // 目标压根不存在时，列出该类型沿基链**同族**成员名（去重、排序、最多 12 个）——
    // 与 methodof 的 _availableNames 同一张逃生口约定。字段族排除 const（fieldof 永远
    // 指不了它，列出来只会引出第二个错误）与 `__prop_` 后备（不是源码名字）。属性族在
    // 导入类上没有 IsProp 符号——回落到访问器方法名（get_/set_ 前缀，arity 与运行期
    // accumulate_property 同口径），跨包诊断才有逃生口。
    private static string _availableMemberNames(Z42ClassType ct, TypeEnv env, bool wantProp) {
        string[] names = new string[32];
        int n = 0;
        Z42ClassType cur = ct;
        int hops = 0;
        while (cur != null) {
            string[] keys = cur.Fields.Keys();
            TypeOpTyper._sortStr(keys);
            int i = 0;
            while (i < keys.Length) {
                FieldSymbol fs = cur.Fields.Get(keys[i]) as FieldSymbol;
                if (fs != null && fs.IsProp == wantProp && !fs.IsConst
                    && !TypeOpTyper._startsWith(fs.Name, "__prop_") && !TypeOpTyper._hasStr(names, n, fs.Name)) {
                    if (n == names.Length) {
                        string[] b = new string[names.Length * 2];
                        Array.Copy(names, b, n);
                        names = b;
                    }
                    names[n] = fs.Name; n = n + 1;
                }
                i = i + 1;
            }
            if (!cur.HasBase) { break; }
            cur = env.Symbols.BaseOf(cur);   // A5：走句柄
            hops = SymbolTable.NextBaseHop(hops);
        }
        if (n == 0 && wantProp) { n = TypeOpTyper._accessorPropNames(ct, env, names, n); }
        if (n == 0) { return ""; }
        string[] shown = new string[n];
        Array.Copy(names, shown, n);
        TypeOpTyper._sortStr(shown);
        string s = "\n  available " + (wantProp ? "properties" : "fields") + ":";
        int j = 0;
        while (j < n && j < 12) { s = s + " " + shown[j]; j = j + 1; }
        if (n > 12) { s = s + " … (" + n.ToString() + " total)"; }
        return s;
    }

    // 导入类的属性名收集：沿基链扫 get_/set_ 访问器（Signature 不含 this ⇒ getter 零参、
    // setter 一参），剥前缀得属性名。派生优先去重（override 的 getter 先入表）。
    private static int _accessorPropNames(Z42ClassType ct, TypeEnv env, string[] names, int n) {
        Z42ClassType cur = ct;
        int hops = 0;
        while (cur != null) {
            string[] keys = cur.Methods.Keys();
            TypeOpTyper._sortStr(keys);
            int i = 0;
            while (i < keys.Length) {
                MethodSymbol ms = cur.Methods.Get(keys[i]) as MethodSymbol;
                if (ms != null && ms.Signature != null) {
                    string pn = TypeOpTyper._accessorPropName(ms);
                    if (pn != "" && !TypeOpTyper._hasStr(names, n, pn)) {
                        if (n == names.Length) {
                            string[] b = new string[names.Length * 2];
                            Array.Copy(names, b, n);
                            names = b;
                        }
                        names[n] = pn; n = n + 1;
                    }
                }
                i = i + 1;
            }
            if (!cur.HasBase) { break; }
            cur = env.Symbols.BaseOf(cur);   // A5：走句柄
            hops = SymbolTable.NextBaseHop(hops);
        }
        return n;
    }

    // `get_X`（零参）/ `set_X`（一参）→ 属性名 X；其余（普通方法恰叫 get_/set_ 前缀）→ ""。
    private static string _accessorPropName(MethodSymbol ms) {
        string nm = ms.Name;
        int pc = ms.Signature.ParamCount;
        if (TypeOpTyper._startsWith(nm, "get_") && pc == 0) { return nm.Substring(4, nm.Length - 4); }
        if (TypeOpTyper._startsWith(nm, "set_") && pc == 1) { return nm.Substring(4, nm.Length - 4); }
        return "";
    }

    // 跨包属性回落的走查：沿基链找第一个声明 `get_<name>`（零参）或 `set_<name>`（一参）
    // 访问器的类（Signature 不含 this，口径与 _accessorPropName / 运行期一致）。
    private static Z42ClassType _findAccessorProp(Z42ClassType ct, string name, TypeEnv env) {
        Z42ClassType cur = ct;
        int hops = 0;
        while (cur != null) {
            MethodSymbol g = cur.Methods.Get("get_" + name) as MethodSymbol;
            if (g != null && g.Signature != null && g.Signature.ParamCount == 0) { return cur; }
            MethodSymbol s = cur.Methods.Get("set_" + name) as MethodSymbol;
            if (s != null && s.Signature != null && s.Signature.ParamCount == 1) { return cur; }
            if (!cur.HasBase) { break; }
            cur = env.Symbols.BaseOf(cur);   // A5：走句柄
            hops = SymbolTable.NextBaseHop(hops);
        }
        return null;
    }

    // ── methodof 诊断/匹配用的小工具（纯叶子，无状态）────────────────────────────
    // 形参签名是否与用户给的类型列表逐位相等（派发口径 TypeKey；见 _bindMethodOfExpr 抬头）。
    private static bool _sigMatches(MethodSymbol ms, Z42Type[] want, int wantCount) {
        if (ms.Signature == null) { return false; }
        if (ms.Signature.ParamCount != wantCount) { return false; }
        int i = 0;
        while (i < wantCount) {
            if (OverloadResolver.TypeKey(ms.Signature.ParamTypes[i]) != OverloadResolver.TypeKey(want[i])) { return false; }
            i = i + 1;
        }
        return true;
    }

    // 诊断展示用（表面拼写，人读的那套；区别于匹配用的 TypeKey）。
    private static string _typeListText(Z42Type[] ts, int n) {
        string s = "";
        int i = 0;
        while (i < n) { if (i > 0) { s = s + ", "; } s = s + TypeNameResolver.SurfaceTypeName(ts[i]); i = i + 1; }
        return s;
    }

    private static string _sigParamText(MethodSymbol ms) {
        if (ms.Signature == null) { return ""; }
        return TypeOpTyper._typeListText(ms.Signature.ParamTypes, ms.Signature.ParamCount);
    }

    // 逃生口：把该名字下**全部**候选连签名列出来，用户照着补参数类型列表即可。
    // Swift 的 `@derivative(of:)` 没留这一步，用户撞上 ambiguous 只能干瞪眼。
    //
    // ⑦ span 地基的第二个消费方：本地候选**附上声明位置**（`ms.Decl.Span`），让「去哪儿看」
    // 也有答案。跨包候选没有 Decl —— 而且跨包元数据里**本来就不带源位置**（TSIG 只有签名），
    // 所以那里如实留空、不编一个假位置出来。
    private static string _overloadList(MethodSymbol[] cands, int cc) {
        string s = "\n  candidates:";
        int i = 0;
        while (i < cc) {
            s = s + "\n    " + cands[i].Name + "(" + TypeOpTyper._sigParamText(cands[i]) + ")";
            MethodSymbol ms = cands[i];
            if (ms.HasDecl && ms.Decl != null) {
                s = s + "   [declared at " + ms.Decl.Span.Line.ToString() + ":" + ms.Decl.Span.Column.ToString() + "]";
            }
            i = i + 1;
        }
        return s;
    }

    // 目标方法压根不存在时，列出该类型上**可用的方法名**（去重、排序、最多 12 个）。
    private static string _availableNames(Z42ClassType ct, TypeEnv env) {
        string[] names = new string[32];
        int n = 0;
        Z42ClassType cur = ct;
        int hops = 0;
        while (cur != null) {
            string[] keys = cur.Methods.Keys();
            TypeOpTyper._sortStr(keys);
            int i = 0;
            while (i < keys.Length) {
                MethodSymbol ms = cur.Methods.Get(keys[i]) as MethodSymbol;
                if (ms != null && !TypeOpTyper._startsWith(ms.Name, "op_") && !TypeOpTyper._hasStr(names, n, ms.Name)) {
                    if (n == names.Length) {
                        string[] b = new string[names.Length * 2];
                        Array.Copy(names, b, n);
                        names = b;
                    }
                    names[n] = ms.Name; n = n + 1;
                }
                i = i + 1;
            }
            if (!cur.HasBase) { break; }
            cur = env.Symbols.BaseOf(cur);   // A5：走句柄
            hops = SymbolTable.NextBaseHop(hops);
        }
        if (n == 0) { return ""; }
        string[] shown = new string[n];
        Array.Copy(names, shown, n);
        TypeOpTyper._sortStr(shown);
        string s = "\n  available methods:";
        int j = 0;
        while (j < n && j < 12) { s = s + " " + shown[j]; j = j + 1; }
        if (n > 12) { s = s + " … (" + n.ToString() + " total)"; }
        return s;
    }

    private static bool _hasStr(string[] a, int n, string v) {
        int i = 0;
        while (i < n) { if (a[i] == v) { return true; } i = i + 1; }
        return false;
    }

    private static bool _startsWith(string s, string pre) {
        if (s.Length < pre.Length) { return false; }
        int i = 0;
        while (i < pre.Length) { if (s.CharAt(i) != pre.CharAt(i)) { return false; } i = i + 1; }
        return true;
    }

    // 插入排序（候选量极小；诊断列出顺序必须确定，见加载顺序确定性规则）。
    private static void _sortStr(string[] a) {
        int i = 1;
        while (i < a.Length) {
            string k = a[i];
            int j = i - 1;
            while (j >= 0 && a[j].CompareTo(k) > 0) { a[j + 1] = a[j]; j = j - 1; }   // CompareTo 是 Ordinal
            a[j + 1] = k;
            i = i + 1;
        }
    }

    internal BoundExpr _bindIsExpr(IsExpr ix, TypeEnv env) {
            BoundExpr operand = this._et._bindExpr(ix.E, env);
            // 用 AST 原始类型名（镜像 C# bin.Right ident → QualifyClassName），不用 resolved 类型：
            // Array/Object 等内建类 ResolveType 得 Unknown → "<unknown>"，致 is_instance 失配。
            string tn;
            if (ix.Type is NamedType) { tn = (ix.Type as NamedType).Name; }
            else { tn = env.ResolveType(ix.Type).Name(); }
            this._tc._chkTypeRef(env.ResolveType(ix.Type), env, ix.Type.Span);   // enforce-class-access：is 目标类型引用
            this._tc.ChkAmbiguousBareNameT(env.Symbols, ix.Type, ix.Type.Span);   // add-bare-name-ambiguity-diagnostic：E0456
            // is-pattern 绑定：声明变量（narrowed 类型）使 true 分支可用（同 env，_bindIf 先绑 cond 再绑 then）。
            if (ix.BindName != "") { this._tc.DefineLocal(env, ix.BindName, env.ResolveType(ix.Type), ix.Span); }
            BoundIsExpr bie = new BoundIsExpr(operand, tn, ix.BindName, ix.Span);
            bie.TargetType = env.ResolveType(ix.Type);   // P2：发射端据此算实例化身份名（`TypeName` 丢实参）
            return bie;
    }

    // `x is <structural pattern>`（模式匹配核心 A1）：绑定模式（同 env，绑定漏入 true 分支，同 _bindIf 语义）。
    internal BoundExpr _bindIsPatternExpr(IsPatternExpr ix, TypeEnv env) {
            BoundExpr operand = this._et._bindExpr(ix.E, env);
            BoundPattern pat = this._tc._pattern.Bind(ix.Pat, operand.Type(), env);
            return new BoundIsPatternExpr(operand, pat, ix.Span);
    }
}
