// enforce-access-control：成员访问可见性校验（private / protected / internal）。
// 持 TypeChecker 反向引用取 _diags（与 MemberResolver 同款 mediator）。违规 emit E0404，不阻断绑定。
//
// 语义（镜像 C#）：
//   public    — 不校验。
//   private   — 仅声明类文本内可访问（CurrentClass()==declClass；含同类其它实例；派生类不可访问基类 private）。
//   protected — 声明类 + 派生类可访问（沿 CurrentClass 基链上溯能到 declClass；跨包派生天然支持）。
//   internal  — 同包可访问；跨包不可（声明类 IsImported==true → deny）。
//   默认可见性（default-member-private）：无修饰符的**成员**（字段 / 方法 / 构造器 / 属性 / 索引器）是 private，
//   顶层类型 / 自由函数是 internal；主构造器由 parser 标为 public。
//   enforce-ctor-visibility 起构造器也经本函数检查（`new` / 初始化子句），此前从不检查。
//
// 名字形式：CurrentClass() 与 FieldSymbol/MethodSymbol.ContainingTypeName 均为**短名**，直接可比。
namespace Z42.Semantics;

using Z42.Core;

public sealed class AccessChecker {
    private TypeChecker _tc;
    public AccessChecker(TypeChecker tc) { this._tc = tc; }

    // 校验从 env 当前上下文访问「declClass 的 vis 成员」是否允许；违规 emit E0404。
    // vis: 成员 Visibility；declClass: 声明该成员的类短名；kind: "field"/"method"/"property"（消息用）。
    public void CheckAccess(string vis, string declClass, TypeEnv env, SymbolTable symbols,
                            string kind, string name, Span sp) {
        if (vis == "public") { return; }
        if (declClass == "") { return; }   // 声明类未知（prim/接口/泛型形参松绑路径不入此函数，兜底放行不误报）
        if (vis == "private") {
            // 声明类自身，或嵌套在它里面的类型（任意深度，`Outer+Inner` 访问 `Outer` 的 private —— 同 C#）。
            string pc = env.CurrentClass();
            if (pc == declClass || pc.StartsWith(declClass + "+")) { return; }
            this._deny("private", kind, name, declClass, false, sp);
            return;
        }
        if (vis == "protected") {
            if (this._currentDerivesFrom(declClass, env, symbols)) { return; }
            this._deny("protected", kind, name, declClass, false, sp);
            return;
        }
        // internal（含无修饰符默认）：声明类本包 → OK；imported（跨包）→ deny。
        Z42ClassType dc = symbols.GetClass(declClass);
        if (dc == null) { return; }          // 未知声明类 → 保守当本地，放行（绝不误报）
        if (!dc.IsImported) { return; }      // 本包声明 → 同包可访问
        this._deny("internal", kind, name, declClass, true, sp);
    }

    // CurrentClass() 或它的任一外层类型（嵌套类型共享外层的访问权，同 C#）==declClass，或沿其基链上溯能到
    // declClass（含隐式 Object，镜像 _findField）。
    private bool _currentDerivesFrom(string declClass, TypeEnv env, SymbolTable symbols) {
        string scope = env.CurrentClass();
        while (scope != "") {
            if (this._derivesFrom(scope, declClass, symbols)) { return true; }
            int lp = scope.LastIndexOf('+');
            scope = lp < 0 ? "" : scope.Substring(0, lp);
        }
        return false;
    }

    private bool _derivesFrom(string start, string declClass, SymbolTable symbols) {
        string cur = start;
        bool more = true;
        while (more) {
            // 导入类的 `BaseName` 是 FQ（TsigReconcile 原样搬运）⇒ 按短名比（declClass 是短名）。
            if (cur == declClass || SymbolTable.ShortNameOf(cur) == declClass) { return true; }
            Z42ClassType ct = symbols.GetClass(cur);
            if (ct == null) { more = false; }
            else if (ct.HasBase) { cur = ct.BaseName; }
            else if (cur != "Object" && symbols.HasClass("Object")) { cur = "Object"; }   // 隐式继承 Object
            else { more = false; }
        }
        return false;
    }

    private void _deny(string vis, string kind, string name, string declClass, bool crossPkg, Span sp) {
        string msg = "cannot access " + vis + " " + kind + " `" + name + "` of `" + declClass + "`";
        if (crossPkg) { msg = msg + " from another package"; }
        this._tc._diags.Error(DiagnosticCodes.AccessViolation, msg, sp);
    }

    // ── add-deprecated-directive（PR5）：use-site 弃用检测 ────────────────────────────────────
    // 解析到某符号后调；若其带 `[Deprecated]`，记一条 hit 到当前 CU（相位错配：检测在 typecheck、治理
    // 在 PackageCompile._runDeprecation，届时按 [lints]/WAE/#suppress 决定最终 severity/抑制）。不直接进 bag。
    public void CheckDeprecatedM(MethodSymbol m, string name, Span sp) {
        if (m != null && m.IsDeprecated) { this._recordDep(name, m.DeprecationMsg, sp); }
    }
    public void CheckDeprecatedF(FieldSymbol f, string name, Span sp) {
        if (f != null && f.IsDeprecated) { this._recordDep(name, f.DeprecationMsg, sp); }
    }
    public void CheckDeprecatedT(Z42ClassType t, Span sp) {
        if (t != null && t.IsDeprecated) { this._recordDep(t.Name(), t.DeprecationMsg, sp); }
    }
    // 直接发 use-site 弃用告警到 _diags（code "deprecated"，Warning 级，不阻断编译）。#suppress 局部抑制
    // 用 TypeChecker 每-CU 建的 _curSuppress（源自 cu.SuppressRegions，PR3c 既有；语义内、F2 安全——不改
    // z42c.syntax 跨成员面）。**[lints]/warnings_as_errors 治理留 Deferred**：接 LintConfig 到 typecheck 相位
    // 需 pipeline→semantics 新跨成员符号（撞 F2 冷启动 stale-cache），待 F2 修复/staged 后补。见 design.md。
    private void _recordDep(string name, string msg, Span sp) {
        if (this._tc._curSuppress != null && this._tc._curSuppress.IsSuppressed("deprecated", sp.Start)) { return; }
        string m = "`" + name + "` 已弃用（deprecated）";
        if (msg != "") { m = m + "：" + msg; }
        this._tc._diags.Warning("deprecated", m, sp);
    }

}