// IrGen 无状态低层助手（compiler-review P1-3 收官）——纯谓词/数组增长/元数据填充集中 static class。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;

public static class IrGenFacts {

    public static int _irTypeTag(TypeExpr te) {
        if (te is NamedType) {
            string nm = (te as NamedType).Name;
            if (nm == "int" || nm == "uint") { return IrType.I32; }
            if (nm == "long" || nm == "ulong") { return IrType.I64; }
            if (nm == "bool") { return IrType.Bool; }
            if (nm == "float") { return IrType.F32; }
            if (nm == "double") { return IrType.F64; }
            if (nm == "byte" || nm == "sbyte" || nm == "short" || nm == "ushort") { return IrType.I32; }
            if (nm == "string") { return IrType.Str; }
            if (nm == "char") { return IrType.Char; }
            if (nm == "void") { return IrType.Void; }
            return IrType.Ref;   // class / interface / opaque named → Ref（镜像 C#）
        }
        if (te is ArrayType) { return IrType.Ref; }   // T[] → Ref
        return IrType.Unknown;
    }

    public static IrFunction[] _pushFunc(IrFunction[] arr, int count, IrFunction irf) {
        if (count == arr.Length) {
            IrFunction[] bigger = new IrFunction[arr.Length * 2];
            int k = 0; while (k < count) { bigger[k] = arr[k]; k = k + 1; }
            arr = bigger;
        }
        arr[count] = irf;
        return arr;
    }

    public static IrClassDesc[] _pushClass(IrClassDesc[] arr, int count, IrClassDesc cd) {
        if (count == arr.Length) {
            IrClassDesc[] bigger = new IrClassDesc[arr.Length * 2];
            int k = 0; while (k < count) { bigger[k] = arr[k]; k = k + 1; }
            arr = bigger;
        }
        arr[count] = cd;
        return arr;
    }

    public static int _visCode(string mods) {
        if (IrGenFacts._hasWord(mods, "private"))   { return 1; }
        if (IrGenFacts._hasWord(mods, "protected")) { return 2; }
        return 0;   // public（显式或默认）
    }

    public static int _methodFlags(string mods) {
        int f = 0;
        if (IrGenFacts._hasWord(mods, "virtual") || IrGenFacts._hasWord(mods, "override") || IrGenFacts._hasWord(mods, "abstract")) { f = f | 1; }
        if (IrGenFacts._hasWord(mods, "abstract")) { f = f | 2; }
        return f;
    }

    public static void _fillParamMeta(IrFunction irf, MethodDecl md, bool isInstance) {
        int off = 0; if (isInstance) { off = 1; }
        int total = md.ParamCount + off;
        string[] names = new string[total];
        int[] kinds = new int[total];
        long[] vals = new long[total];
        string[] strs = new string[total];
        if (isInstance) { names[0] = "this"; kinds[0] = 0; vals[0] = 0; strs[0] = ""; }
        int minArg = md.ParamCount;   // 逻辑：默认全必填
        bool foundDefault = false;
        int p = 0;
        while (p < md.ParamCount) {
            names[p + off] = md.Params[p].Name;
            int kind = 0; long v = 0; string sv = "";
            Expr d = md.Params[p].Default;
            if (d != null) {
                if (!foundDefault) { minArg = p; foundDefault = true; }   // 首个默认值下标 = 必填数
                if (d is NullLitExpr) { kind = 1; }
                else if (d is IntLitExpr) { kind = 2; v = ZbcInstr._parseIntLit((d as IntLitExpr).Value); }
                else if (d is CharLitExpr) { kind = 2; v = (long)(int)(d as CharLitExpr).Value; }
                else if (d is BoolLitExpr) { kind = 4; if ((d as BoolLitExpr).Value) { v = 1; } }
                else if (d is FloatLitExpr) { kind = 3; v = ZbcInstr.DoubleToBits(Convert.ToDouble(IrGenFacts._stripFloatSuffix((d as FloatLitExpr).Value))); }
                else if (d is StringLitExpr) { kind = 5; sv = Lexer.DecodeString((d as StringLitExpr).Raw); }
                // 非字面量 → kind 0
            }
            kinds[p + off] = kind; vals[p + off] = v; strs[p + off] = sv;
            p = p + 1;
        }
        int paramsFrom = 255;
        if (md.ParamCount > 0 && md.Params[md.ParamCount - 1].IsParams) { paramsFrom = md.ParamCount - 1; }
        irf.MinArg = minArg; irf.ParamsFrom = paramsFrom;
        irf.ParamNames = names; irf.ParamDefaultKinds = kinds; irf.ParamDefaultVals = vals; irf.ParamDefaultStrs = strs;
    }

    public static string _stripFloatSuffix(string t) {
        int n = t.Length;
        if (n > 0) {
            char last = t.CharAt(n - 1);
            if (last == 'f' || last == 'F' || last == 'd' || last == 'D') { return t.Substring(0, n - 1); }
        }
        return t;
    }

    public static long _parseEnumVal(string s) {
        long r = 0;
        int i = 0;
        bool neg = false;
        if (s.Length > 0 && s.CharAt(0) == '-') { neg = true; i = 1; }
        while (i < s.Length) {
            int d = (int)s.CharAt(i) - 48;
            r = r * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { r = 0 - r; }
        return r;
    }

    public static Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { AttributedDecl ad = d as AttributedDecl; return ad.Inner; }
        return d;
    }

    public static bool _hasWord(string s, string word) {
        int n = s.Length;
        int start = 0;
        int i = 0;
        while (i <= n) {
            if (i == n || s.CharAt(i) == ' ') {
                if (i > start) {
                    string tok = s.Substring(start, i - start);
                    if (tok == word) { return true; }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

}