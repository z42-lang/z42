// IrGen 无状态低层助手（compiler-review P1-3 收官）——纯谓词/数组增长/元数据填充集中 static class。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;
using Z42.IR.BinaryFormat;

public static class IrGenFacts {

    public static int _irTypeTag(TypeExpr te) {
        if (te is NamedType) {
            string nm = (te as NamedType).Name;
            if (nm == "int" || nm == "uint") { return IrType.I32; }
            if (nm == "long" || nm == "ulong") { return IrType.I64; }
            if (nm == "bool") { return IrType.Bool; }
            if (nm == "float") { return IrType.F32; }
            if (nm == "double") { return IrType.F64; }
            if (nm == "byte" || nm == "sbyte" || nm == "short" || nm == "ushort") { return IrType.I32; }
            if (nm == "string") { return IrType.Str; }
            if (nm == "char") { return IrType.Char; }
            if (nm == "void") { return IrType.Void; }
            return IrType.Ref;   // class / interface / opaque named → Ref（镜像 C#）
        }
        if (te is ArrayType) { return IrType.Ref; }   // T[] → Ref
        return IrType.Unknown;
    }

    public static IrFunction[] _pushFunc(IrFunction[] arr, int count, IrFunction irf) {
        if (count == arr.Length) {
            IrFunction[] bigger = new IrFunction[arr.Length * 2];
            int k = 0; while (k < count) { bigger[k] = arr[k]; k = k + 1; }
            arr = bigger;
        }
        arr[count] = irf;
        return arr;
    }

    public static IrClassDesc[] _pushClass(IrClassDesc[] arr, int count, IrClassDesc cd) {
        if (count == arr.Length) {
            IrClassDesc[] bigger = new IrClassDesc[arr.Length * 2];
            int k = 0; while (k < count) { bigger[k] = arr[k]; k = k + 1; }
            arr = bigger;
        }
        arr[count] = cd;
        return arr;
    }

    // 可见性 int 编码：0=public / 1=private / 2=protected / 3=internal。dflt = 无修饰符默认，按位置传入
    // （default-member-private：成员 1=private / 顶层自由函数 3=internal，镜像 access-control.md 最小封闭作用域）。
    public static int _visCode(string mods, int dflt) {
        if (IrGenFacts._hasWord(mods, "private"))   { return 1; }
        if (IrGenFacts._hasWord(mods, "protected")) { return 2; }
        if (IrGenFacts._hasWord(mods, "public"))    { return 0; }
        if (IrGenFacts._hasWord(mods, "override"))  { return 0; }   // enforce-access-control：override 继承基类(public)可见性
        return dflt;
    }

    // enforce-class-access：类声明可见性编码（0=public/1=private/2=protected/3=internal）。位置默认镜像
    // 「最小封闭作用域」：嵌套类（isNested）→ private、顶层类 → internal；显式修饰符优先。SymbolCollector /
    // ClassDescBuilder / ExportedTypeExtractor 三处共用此单一真相，避免默认逻辑漂移。类不参与 override 继承。
    public static int classVisCode(string mods, bool isNested) {
        if (IrGenFacts._hasWord(mods, "public"))    { return 0; }
        if (IrGenFacts._hasWord(mods, "private"))   { return 1; }
        if (IrGenFacts._hasWord(mods, "protected")) { return 2; }
        if (IrGenFacts._hasWord(mods, "internal"))  { return 3; }
        if (isNested) { return 1; }   // 嵌套类默认 private
        return 3;                     // 顶层类默认 internal
    }
    // 类可见性 int → string（与 TsigReconcile._visStr 对齐；semantics 侧本地字符串化）。
    public static string classVisStr(int code) {
        if (code == 1) { return "private"; }
        if (code == 2) { return "protected"; }
        if (code == 3) { return "internal"; }
        return "public";
    }
    // 便捷：直接从 Mods + 是否嵌套算可见性字符串（Z42ClassType.Visibility / ExportedClassZ.Visibility 本地面）。
    public static string classVis(string mods, bool isNested) {
        return IrGenFacts.classVisStr(IrGenFacts.classVisCode(mods, isNested));
    }

    public static int _methodFlags(string mods) {
        int f = 0;
        // impl-sealed-semantics-devirt：sealed 方法必是 override（简写 `sealed` == `sealed override`）→ 亦置
        // virtual 位（bit0），确保裸 `sealed` 无 override 词时虚派发位仍正确。
        if (IrGenFacts._hasWord(mods, "virtual") || IrGenFacts._hasWord(mods, "override") || IrGenFacts._hasWord(mods, "abstract") || IrGenFacts._hasWord(mods, "sealed")) { f = f | 1; }
        if (IrGenFacts._hasWord(mods, "abstract")) { f = f | 2; }
        if (IrGenFacts._hasWord(mods, "sealed"))   { f = f | 4; }   // bit2=sealed（METHOD_FLAG_SEALED，zbc 1.30）
        return f;
    }

    public static void _fillParamMeta(IrFunction irf, MethodDecl md, bool isInstance) {
        int off = 0; if (isInstance) { off = 1; }
        int total = md.ParamCount + off;
        string[] names = new string[total];
        int[] kinds = new int[total];
        long[] vals = new long[total];
        string[] strs = new string[total];
        if (isInstance) { names[0] = "this"; kinds[0] = 0; vals[0] = 0; strs[0] = ""; }
        int minArg = md.ParamCount;   // 逻辑：默认全必填
        bool foundDefault = false;
        int p = 0;
        while (p < md.ParamCount) {
            names[p + off] = md.Params[p].Name;
            // PR6：SIGS default_kind 已退休——参数默认值的唯一真相源是 param attr-ref `$Default`
            // 哨兵（ConstBlob，ClassDescBuilder._paramAttrRefs 写、Rust 反射读、跨包 OverloadBinder 注入）。
            // 此处只保留 minArg（首个默认值下标 = 必填数，喂 IsOptional）；kind/val/str 恒写 0/""。
            if (md.Params[p].Default != null && !foundDefault) { minArg = p; foundDefault = true; }
            kinds[p + off] = 0; vals[p + off] = 0; strs[p + off] = "";
            p = p + 1;
        }
        int paramsFrom = 255;
        if (md.ParamCount > 0 && md.Params[md.ParamCount - 1].IsParams) { paramsFrom = md.ParamCount - 1; }
        irf.MinArg = minArg; irf.ParamsFrom = paramsFrom;
        irf.ParamNames = names; irf.ParamDefaultKinds = kinds; irf.ParamDefaultVals = vals; irf.ParamDefaultStrs = strs;
    }

    public static string _stripFloatSuffix(string t) {
        int n = t.Length;
        if (n > 0) {
            char last = t.CharAt(n - 1);
            if (last == 'f' || last == 'F' || last == 'd' || last == 'D') { return t.Substring(0, n - 1); }
        }
        return t;
    }

    public static long _parseEnumVal(string s) {
        long r = 0;
        int i = 0;
        bool neg = false;
        if (s.Length > 0 && s.CharAt(0) == '-') { neg = true; i = 1; }
        while (i < s.Length) {
            int d = (int)s.CharAt(i) - 48;
            r = r * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { r = 0 - r; }
        return r;
    }

    public static Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { AttributedDecl ad = d as AttributedDecl; return ad.Inner; }
        return d;
    }

    /// 修饰符串里是否含 `word` 这个**空格分隔的整词**。z42c 里有 75 处调用（全部传
    /// "static"/"abstract"/... 这类字面量），是本项目的规范实现，另外三处（SymbolCollector /
    /// ExportedTypeExtractor / TypeFactsTc）都转发到这里。
    ///
    /// perf：四份旧实现各有各的浪费 —— 两份逐字符 `CharAt`（每字符一次 builtin 分发）再
    /// `Substring` 出 token 比较；一份 `Split(" ")` 分配数组 + 每个 token 一个子串；一份
    /// `(" "+mods+" ").IndexOf(" "+w+" ")` 每次拼两个新串。这里一次 `ToCharArray` 物化，
    /// 之后全是 ArrayGet：不切子串、不建数组。
    ///
    /// 语义：对**非空** word 与四份旧实现逐条一致（整词匹配；空 token 永不匹配非空 word）。
    public static bool _hasWord(string s, string word) {
        int wn = word.Length;
        if (wn == 0) { return false; }
        int n = s.Length;
        if (wn > n) { return false; }
        // 扫描面物化一次（原来两份实现是每字符一次 `CharAt` builtin 分发）；`word` 侧不物化
        // ——只有 token 长度与两侧边界都对上时才逐字符比，实测每次调用至多比一两个 token。
        char[] cs = s.ToCharArray();
        int start = 0;
        int i = 0;
        while (i <= n) {
            if (i == n || cs[i] == ' ') {
                if (i - start == wn) {
                    int j = 0;
                    while (j < wn && cs[start + j] == word.CharAt(j)) { j = j + 1; }
                    if (j == wn) { return true; }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }

}