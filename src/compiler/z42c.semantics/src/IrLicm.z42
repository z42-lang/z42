// IrLicm —— 循环不变量外提（LICM，Opt.Licm；"全部做" 优化程序 4/4）。
//
// 把自然循环体内**纯（IsPure）且循环不变**的计算提到循环 pre-header（每次进循环只算一次）。
// interp 收益大头（循环主导运行时）。设计见 docs/book/src/runtime/optimization-pipeline.md。
//
// ── 机制（保守 v1）───────────────────────────────────────────────────────────────────
//   ① CFG：从各块终结子取后继（Br→1 / BrCond→2 / Ret·Throw→0），反转得前驱（predMat 位阵）。
//   ② 支配：迭代数据流 `dom[b] = {b} ∪ (∩ dom[preds])`（entry=Blocks[0]）。
//   ③ 回边：边 b→h 且 h 支配 b → 自然循环，header=h；循环体 = h + 从 latch 反向可达（不过 h）的块。
//   ④ pre-header（保守）：h 的**唯一**循环外前驱 `ph` 且 `ph` 终结子 = `br h`（只跳 h）→ 干净 pre-header；
//      否则**跳过该循环**（不做 CFG 手术造 pre-header，避风险）。
//   ⑤ 不变量：循环体内 IsPure 指令，其**每个读操作数**要么在循环外定义、要么由已判定不变的指令定义
//      （不动点迭代）。IsPure 白名单已排除 Div/Rem（除零陷阱）/ FieldGet·ArrayGet（NPE/越界）/ Call·*Set
//      （副作用）→ 提到「可能零迭代」的 pre-header 也安全（纯值、不触发陷阱/副作用）。
//   ⑥ 外提：不变指令按程序序移到 pre-header 终结子之前（依赖序保留），从循环体删除。
//   单赋值 temp → 定义唯一、pre-header 支配循环 → 提前定义仍支配所有使用点，正确。
namespace Z42.Semantics;

using Z42.IR;

public sealed class IrLicm {

    public static void Run(IrFunction f) {
        int n = f.BlockCount;
        if (n < 2) { return; }   // 无循环可能
        // 有异常表（try/catch/finally）→ 跳过：CFG 仅从 Br/BrCond/Ret 终结子建，**不含异常隐式边**
        // （受保护区→handler/finally），支配/循环分析会错 → 误提 → miscompile（event/multicast/finally/
        //  div-by-zero 等 e2e 曾中招）。异常边入 CFG 后再放开。
        if (f.ExcCount != 0) { return; }
        // ① 后继（s0/s1；-1=无）
        int[] s0 = new int[n];
        int[] s1 = new int[n];
        int b = 0;
        while (b < n) { s0[b] = -1; s1[b] = -1; b = b + 1; }
        b = 0;
        while (b < n) {
            IrBlock blk = f.Blocks[b];
            if (blk.HasTerm) {
                if (blk.Term is BrTerm) { s0[b] = IrLicm._idx(f, (blk.Term as BrTerm).Label); }
                else if (blk.Term is BrCondTerm) {
                    BrCondTerm bc = blk.Term as BrCondTerm;
                    s0[b] = IrLicm._idx(f, bc.TrueLabel);
                    s1[b] = IrLicm._idx(f, bc.FalseLabel);
                }
            }
            b = b + 1;
        }
        // 前驱位阵 predMat[b*n+p] = p 是 b 的前驱
        bool[] predMat = new bool[n * n];
        b = 0;
        while (b < n) {
            if (s0[b] >= 0 && s0[b] < n) { predMat[s0[b] * n + b] = true; }
            if (s1[b] >= 0 && s1[b] < n) { predMat[s1[b] * n + b] = true; }
            b = b + 1;
        }
        // ② 支配（迭代数据流）
        bool[] dom = IrLicm._computeDom(n, predMat);
        // ③ 循环 header（回边目标 h：某边 b→h 且 h 支配 b）。每个 header 处理一次，循环体**并**其所有回边
        //    的自然循环体（多回边=多 latch 时，单回边体不完整会漏掉别 latch 侧的定义 → 误判可提 → miscompile）。
        bool[] isHeader = new bool[n];
        b = 0;
        while (b < n) {
            if (s0[b] >= 0 && s0[b] < n && dom[b * n + s0[b]]) { isHeader[s0[b]] = true; }
            if (s1[b] >= 0 && s1[b] < n && dom[b * n + s1[b]]) { isHeader[s1[b]] = true; }
            b = b + 1;
        }
        int h = 0;
        while (h < n) {
            if (isHeader[h]) {
                bool[] inLoop = IrLicm._loopBody(n, h, s0, s1, predMat, dom);
                IrLicm._tryPreheaderHoist(f, n, h, inLoop, predMat, dom);
            }
            h = h + 1;
        }
    }

    // 自然循环体（**并** header h 的所有回边）：{h} ∪ 从各 latch 反向可达（不过 h）。
    private static bool[] _loopBody(int n, int h, int[] s0, int[] s1, bool[] predMat, bool[] dom) {
        bool[] inLoop = new bool[n];
        inLoop[h] = true;
        int[] stack = new int[n + 1];
        int top = 0;
        // 各 latch：b→h 且 h 支配 b（b==h 的自循环不入栈 → 体={h}，不误拉 pre-header）
        int b = 0;
        while (b < n) {
            if ((s0[b] == h || s1[b] == h) && dom[b * n + h] && b != h && !inLoop[b]) {
                inLoop[b] = true; stack[top] = b; top = top + 1;
            }
            b = b + 1;
        }
        while (top > 0) {
            top = top - 1;
            int p = stack[top];
            int q = 0;
            while (q < n) {
                if (predMat[p * n + q] && q != h && !inLoop[q]) { inLoop[q] = true; stack[top] = q; top = top + 1; }
                q = q + 1;
            }
        }
        return inLoop;
    }

    // ④ pre-header 保守判定（h 唯一循环外前驱 + 该前驱 `br h`）+ ⑤⑥ 不变量分析 + 外提。
    private static void _tryPreheaderHoist(IrFunction f, int n, int h, bool[] inLoop, bool[] predMat, bool[] dom) {
        int ph = -1;
        int cnt = 0;
        int r = 0;
        while (r < n) {
            if (predMat[h * n + r] && !inLoop[r]) { cnt = cnt + 1; ph = r; }
            r = r + 1;
        }
        if (cnt != 1) { return; }
        IrBlock phb = f.Blocks[ph];
        if (!phb.HasTerm) { return; }
        if (!(phb.Term is BrTerm)) { return; }
        if (IrLicm._idx(f, (phb.Term as BrTerm).Label) != h) { return; }
        IrLicm._hoistInvariants(f, n, inLoop, ph, h, dom);
    }

    // 不变量分析 + 外提到 pre-header。
    private static void _hoistInvariants(IrFunction f, int n, bool[] inLoop, int ph, int h, bool[] dom) {
        int rc = f.MaxReg + 2;
        // defInLoop[reg] = 该 reg 在**被 header 支配的任一块**中定义（= 循环支配域，**含**异常/多出口退出块——
        // 后者被「latch 反向可达」的循环体排除，但仍受 header 支配。用 header 支配域而非反向可达体，
        // 才不漏掉退出块里的定义 → 否则误判操作数「循环外」→ 外提到 pre-header 时该操作数未定义（miscompile
        // ：TopoOrder 嵌套循环+throw 的 undefined register 即此因）。所有真循环块都受 header 支配 ⊆ 支配域，
        // 故此判定对不变性**保守安全**（可能少提循环外后继块的定义，但绝不误提）。
        bool[] defInLoop = new bool[rc];
        // defsGlobal[reg] = 全函数定义次数。仅提**单赋值**（==1）指令：多定义命名局部若被提，会丢掉环内
        // 某次赋值 → 后续迭代值错（miscompile）。单赋值 temp 提前定义仍支配所有使用点，安全。
        int[] defsGlobal = new int[rc];
        int b = 0;
        while (b < n) {
            bool headerDom = dom[b * n + h];   // b 受 header 支配 → 属循环支配域
            IrBlock blk = f.Blocks[b];
            int ii = 0;
            while (ii < blk.InstrCount) {
                int d = IrOptInfo.DstId(blk.Instrs[ii]);
                if (d >= 0 && d < rc) {
                    defsGlobal[d] = defsGlobal[d] + 1;
                    if (headerDom) { defInLoop[d] = true; }
                }
                ii = ii + 1;
            }
            b = b + 1;
        }
        // invariantReg：其定义指令外提（IsPure + **所有操作数在循环外定义**）。
        // v1 只提「操作数全外部」的指令 → 被提指令互不依赖 → 任意序（程序序）外提皆安全；
        // 链式不变量（依赖被提结果）留给后续 pass 或再跑一遍（提后 defBlock 变外部）。
        bool[] invariantReg = new bool[rc];
        b = 0;
        while (b < n) {
            if (inLoop[b]) {
                IrBlock blk = f.Blocks[b];
                int ii = 0;
                while (ii < blk.InstrCount) {
                    IrInstr ins = blk.Instrs[ii];
                    int d = IrOptInfo.DstId(ins);
                    if (d >= 0 && d < rc && defsGlobal[d] == 1 && IrOptInfo.IsPure(ins)
                        && IrLicm._operandsExternal(ins, defInLoop, rc)) {
                        invariantReg[d] = true;
                    }
                    ii = ii + 1;
                }
            }
            b = b + 1;
        }
        // 收集外提指令（程序序）+ 从循环体删除
        IrInstr[] hoist = new IrInstr[8];
        int hc = 0;
        bool any = false;
        b = 0;
        while (b < n) {
            if (inLoop[b]) {
                IrBlock blk = f.Blocks[b];
                int keep = 0;
                int ii = 0;
                while (ii < blk.InstrCount) {
                    if (!IrLicm._isHoisted(blk.Instrs[ii], invariantReg, rc)) { keep = keep + 1; }
                    ii = ii + 1;
                }
                if (keep != blk.InstrCount) {
                    IrInstr[] nw = new IrInstr[keep];
                    int j = 0;
                    ii = 0;
                    while (ii < blk.InstrCount) {
                        if (IrLicm._isHoisted(blk.Instrs[ii], invariantReg, rc)) {
                            hoist = IrLicm._push(hoist, hc, blk.Instrs[ii]); hc = hc + 1;
                        } else {
                            nw[j] = blk.Instrs[ii]; j = j + 1;
                        }
                        ii = ii + 1;
                    }
                    blk.Instrs = nw;
                    blk.InstrCount = keep;
                    any = true;
                }
            }
            b = b + 1;
        }
        if (!any) { return; }
        // 插入 pre-header 终结子之前（append 到指令尾）
        IrBlock phb = f.Blocks[ph];
        IrInstr[] merged = new IrInstr[phb.InstrCount + hc];
        int k = 0;
        while (k < phb.InstrCount) { merged[k] = phb.Instrs[k]; k = k + 1; }
        int t = 0;
        while (t < hc) { merged[phb.InstrCount + t] = hoist[t]; t = t + 1; }
        phb.Instrs = merged;
        phb.InstrCount = phb.InstrCount + hc;
    }

    // 指令是否被判定外提（dst 在 invariantReg）。
    private static bool _isHoisted(IrInstr ins, bool[] invariantReg, int rc) {
        int d = IrOptInfo.DstId(ins);
        return d >= 0 && d < rc && invariantReg[d];
    }

    // 指令每个读操作数是否都**不在循环内定义**（→ 循环不变）。
    private static bool _operandsExternal(IrInstr ins, bool[] defInLoop, int rc) {
        int[] counts = new int[rc];
        IrOptInfo.AddReads(counts, ins);
        int r = 0;
        while (r < rc) {
            if (counts[r] > 0 && r < rc && defInLoop[r]) { return false; }   // 操作数在循环内定义 → 非不变
            r = r + 1;
        }
        return true;
    }

    // 块 label → 索引（线性；-1=未找到）。
    private static int _idx(IrFunction f, string label) {
        int b = 0;
        while (b < f.BlockCount) {
            if (f.Blocks[b].Label == label) { return b; }
            b = b + 1;
        }
        return -1;
    }

    // ② 支配：dom[b*n+x] = x 支配 b。迭代 `dom[b] = {b} ∪ (∩ dom[preds])`，entry=0。
    private static bool[] _computeDom(int n, bool[] predMat) {
        bool[] dom = new bool[n * n];
        // entry：仅被自身支配
        dom[0] = true;
        int b = 1;
        while (b < n) {
            int x = 0;
            while (x < n) { dom[b * n + x] = true; x = x + 1; }   // 其余：全集
            b = b + 1;
        }
        bool changed = true;
        while (changed) {
            changed = false;
            b = 1;
            while (b < n) {
                bool[] inter = new bool[n];
                int x = 0;
                while (x < n) { inter[x] = true; x = x + 1; }
                bool hasPred = false;
                int p = 0;
                while (p < n) {
                    if (predMat[b * n + p]) {
                        hasPred = true;
                        int y = 0;
                        while (y < n) { inter[y] = inter[y] && dom[p * n + y]; y = y + 1; }
                    }
                    p = p + 1;
                }
                if (hasPred) {
                    inter[b] = true;
                    int y = 0;
                    while (y < n) {
                        if (dom[b * n + y] != inter[y]) { dom[b * n + y] = inter[y]; changed = true; }
                        y = y + 1;
                    }
                }
                b = b + 1;
            }
        }
        return dom;
    }

    private static IrInstr[] _push(IrInstr[] arr, int count, IrInstr x) {
        if (count >= arr.Length) {
            IrInstr[] nw = new IrInstr[arr.Length * 2 + 8];
            int i = 0;
            while (i < count) { nw[i] = arr[i]; i = i + 1; }
            arr = nw;
        }
        arr[count] = x;
        return arr;
    }
}
