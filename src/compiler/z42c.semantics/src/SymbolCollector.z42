// 符号收集（port-z42c-semantics 1A-3，Pass 0）。CompilationUnit AST → SymbolTable。
// 两阶段：A 先建类 stub（注册名字，使成员类型可解析兄弟类）→ B 填字段/方法签名 + 顶层 func。
// 1A 范围：class/struct（字段 + 方法签名，跳 ctor[1D] / property[后续]）+ 顶层 func。
//
// 本类是 **hub**：3 个编排入口（CollectWithImports / CollectAll / Collect）顺序调用各簇 pass +
// imported 符号种子 + 共享叶子辅助（_unwrap/_vis/_hasWord/_chkTypeRef/_methodSymbol/_mergeParams +
// 静态 IsProtocolExempt/_isConvOp）+ partial 状态（_partialDecls/_partialImpls）。实际 pass 分入 4 簇
// （refactor-symbolcollector-concern-split，同 ExprEmitter/ExprTyper/FunctionEmitter hub+spoke 模型）：
//   StubCollector       —— Pass A 骨架：interface/enum/class stub/delegate 注册
//   MemberCollector     —— Pass B 成员填充：字段/方法/属性/索引器 + regKey mangle + const + 转换运算符
//   InheritanceResolver —— 基链解析：override regKey 对齐 + sealed 强制 + 继承字段 + impl-block 合并
//   DeclEnforcer        —— 声明良构约束：D8 后缀强制（attribute/analyzer/generator）+ partial 校验
// 每簇持 _sc 反向引用、经 _sc 访问共享辅助/状态（零簇间边，所有跨簇流量过 hub）。
namespace Z42.Semantics;
using Z42.IR;   // StrMap 统一到 z42c.ir（compiler-review §4.1）

using Z42.Syntax;
using Z42.Core;   // add-partial-types：DiagnosticBag/DiagnosticCodes/Span（partial 合并校验）

public sealed class SymbolCollector {
    // add-partial-types：partial 合并的包级诊断（CollectAll 收集，BuildPackageCus 按 Span.File 分发到各文件）。
    // 单文件 Collect/CollectWithImports 路径也复用（同文件多 partial 碎片合并同样走这套）。
    public DiagnosticBag Diags;
    // partial method 配对追踪：canonical sig key "Cls#Name(pt,…)" → MethodDecl。decl-only 擦除，impl 需匹配 decl。
    internal StrMap _partialDecls;
    internal StrMap _partialImpls;
    private StubCollector       _stub;      // Pass A：骨架 stub
    private MemberCollector     _member;    // Pass B：成员填充
    private InheritanceResolver _inherit;   // 基链解析（override/sealed/继承字段/impl）
    private DeclEnforcer        _enforce;   // 声明良构约束（后缀 D8 + partial 校验）

    public SymbolCollector() {
        this.Diags = new DiagnosticBag();
        this._partialDecls = new StrMap();
        this._partialImpls = new StrMap();
        this._stub = new StubCollector(this);
        this._member = new MemberCollector(this);
        this._inherit = new InheritanceResolver(this);
        this._enforce = new DeclEnforcer(this);
    }

    // imported 符号先 seed，本地声明覆盖（CI-4；镜像 C# SymbolCollector.Collect：MergeImported
    // 在成员收集前——使本地类**字段/方法类型**能解析为兄弟包 imported 类，而非降级 Unknown）。
    // 顺序：本地 interface/class stub → seed imported（guard 跳本地同名，local-wins）→ 成员解析。
    // 接口必须在 _passClassStubs 之前 seed（基表判别：_passClassStubs 查 table.Interfaces 区分 iface vs class base）。
    public SymbolTable CollectWithImports(CompilationUnit cu, ImportedSymbols imported) {
        var t = new SymbolTable();
        NestedFlatten.Flatten(cu);   // add-nested-types：嵌套类型提升为顶层（幂等）
        this._stub._passInterfaces(t, cu, "");
        this._stub._passEnums(t, cu);
        this._mergeImportedEnums(t, imported);
        this._mergeImportedInterfaces(t, imported);
        this._stub._passClassStubs(t, cu, "");   // 单-CU 路径（dump/test）：无 partial 主碎片跟踪
        this._mergeImports(t, imported);
        this._seedObjectStub(t);   // imported Type 已入表后；GetType 返回真实 Type 类（链式 getter 分派）
        this._stub._passDelegates(t, cu);
        this._member._passMembers(t, cu);
        this._inherit._passFixupOverrides(t, cu);   // add-type-based-overloads D7：override 同 arity 重载 regKey 对齐（阶段 8 修复）
        this._inherit._passSealedEnforce(t, cu);    // impl-sealed-semantics-devirt：sealed 继承/override 强制
        this._enforce._passAttributeSuffixEnforce(cu);   // attribute-handler-registry PR2：`: Attribute` 类名后缀强制（D8）
        this._enforce._passAnalyzerSuffixEnforce(cu);    // attribute-handler-registry PR3a：`: Analyzer` 类名后缀强制（D8）
        this._enforce._passGeneratorSuffixEnforce(cu);   // attribute-handler-registry PR4a：`: Generator` 类名后缀强制（D8）
        this._inherit._passImpls(t, cu);   // port-z42c-impl-block：deps 路径同样须并 impl 方法入 target.Methods，
                                  // 否则 _bindImpl 的 ms=null → "this" 不入 env → `this.field` 绑成 undefined → emit const.null
        this._inherit._passInheritFields(t, cu);
        return t;
    }

    // imported 接口骨架 seed（_passClassStubs 前调用；local 同名接口已由 _passInterfaces 注册，local-wins）。
    // G18-import：IBasicCollection 等跨包接口须在 _passClassStubs 前进 table.Interfaces，否则被误当 class base。
    private void _mergeImportedInterfaces(SymbolTable table, ImportedSymbols imported) {
        if (imported == null) { return; }
        string[] ifs = imported.Interfaces.Keys();
        int i = 0;
        while (i < ifs.Length) {
            if (!table.Interfaces.ContainsKey(ifs[i])) { table.Interfaces.Put(ifs[i], imported.Interfaces.Get(ifs[i])); }
            i = i + 1;
        }
    }

    // Object stub seed（镜像 C# SymbolCollector.CollectClasses）：CU 未自声明 Object 时，
    // 预注册 Object 骨架 + 四协议方法（ToString/Equals/GetHashCode/GetType），使
    // `obj.GetType()` / 链式 `obj.GetType().BaseType.Name` 在消费端解析出真实返回类型。
    // 关键：GetType 返回类型解析为 imported `Type` 类（若已在表中），否则 Unknown——
    // 否则 GetType 返回 Unknown → 链式 getter 退化为 FieldGet → 运行期 FieldGet on Null。
    // 必须在 imported 类（含 Type）合并入表后调用。stdlib 编 z42.core 时自声明 Object → 跳过。
    private void _seedObjectStub(SymbolTable table) {
        if (table.Classes.ContainsKey("Object")) { return; }   // 本地自声明 Object（z42.core）→ local-wins
        Z42ClassType obj = new Z42ClassType("Object", false, "");
        Z42Type getTypeRet = new Z42UnknownType();
        if (table.Classes.ContainsKey("Type")) { getTypeRet = table.GetClass("Type"); }
        Z42Type objParam = Z42ClassType.Builtin("object");
        Z42Type[] noParams = new Z42Type[0];
        Z42Type[] eqParams = new Z42Type[1]; eqParams[0] = objParam;
        obj.Methods.Put("ToString", new MethodSymbol("ToString", "public",
            new Z42FuncType(noParams, 0, Z42ClassType.Builtin("string")), false, "Object", false, null));
        obj.Methods.Put("Equals", new MethodSymbol("Equals", "public",
            new Z42FuncType(eqParams, 1, Z42ClassType.Builtin("bool")), false, "Object", false, null));
        obj.Methods.Put("GetHashCode", new MethodSymbol("GetHashCode", "public",
            new Z42FuncType(noParams, 0, Z42ClassType.Builtin("int")), false, "Object", false, null));
        obj.Methods.Put("GetType", new MethodSymbol("GetType", "public",
            new Z42FuncType(noParams, 0, getTypeRet), false, "Object", false, null));
        table.Classes.Put("Object", obj);
    }

    // imported 枚举 seed（imported `EnumType.Member` 常量解析；local 同名枚举 local-wins）。
    // 必须在 typecheck 前进表，否则跨包枚举常量 `GCHandleType.Weak` 绑成 undefined → emit const.null。
    private void _mergeImportedEnums(SymbolTable table, ImportedSymbols imported) {
        if (imported == null) { return; }
        string[] ets = imported.EnumTypeNames.Keys();
        int i = 0;
        while (i < ets.Length) {
            if (!table.EnumTypes.ContainsKey(ets[i])) { table.EnumTypes.Put(ets[i], "enum"); }
            i = i + 1;
        }
        string[] ecs = imported.EnumConsts.Keys();
        i = 0;
        while (i < ecs.Length) {
            if (!table.EnumConsts.ContainsKey(ecs[i])) { table.EnumConsts.Put(ecs[i], imported.EnumConsts.Get(ecs[i])); }
            i = i + 1;
        }
    }

    // imported 符号 seed（local stub 已注册的同名跳过，local-wins；镜像 C# MergeImported + 本地覆盖）。
    // 必须在 _passMembers 前调用：成员（字段/方法签名）类型解析依赖 imported 类已在表中（G18）。
    private void _mergeImports(SymbolTable table, ImportedSymbols imported) {
        if (imported == null) { return; }
        string[] cls = imported.Classes.Keys();
        int i = 0;
        while (i < cls.Length) {
            if (!table.Classes.ContainsKey(cls[i])) { table.Classes.Put(cls[i], imported.Classes.Get(cls[i])); }
            i = i + 1;
        }
        string[] fns = imported.Functions.Keys();
        i = 0;
        while (i < fns.Length) {
            if (!table.Functions.ContainsKey(fns[i])) { table.Functions.Put(fns[i], imported.Functions.Get(fns[i])); }
            i = i + 1;
        }
        // add-associated-types PR-1：导入类的 where 约束 seed（跨包约束校验的落地点）。
        // **只在该键上的赢家确实是导入类时才 seed**：上面的类循环是 local-wins，本地同名类若压根没有
        // where 子句，把导入类的约束挂到这个键上会让本地 `Foo<int>` 被拿去校验**另一个包**的 Foo 的
        // 约束 → 凭空报错。ConstraintChecker.Resolve 在 CollectAll **之后**才跑，本地有 where 的类会
        // 覆写同键条目，故「本地有 where」的情形天然 local-wins，无需在此特殊处理。
        string[] cks = imported.Constraints.Keys();
        i = 0;
        while (i < cks.Length) {
            Z42ClassType winner = table.Classes.Get(cks[i]) as Z42ClassType;
            if (winner != null && winner.IsImported && !table.ClassConstraints.ContainsKey(cks[i])) {
                table.ClassConstraints.Put(cks[i], imported.Constraints.Get(cks[i]));
            }
            i = i + 1;
        }
    }

    // 全包合并收集（PS-1）：多 CU 同表（接口 stub 全包 → 类 stub 全包 → 成员/函数全包）。
    // 语义等价 C# sibling-exports（其逐文件+缓存导出形态为增量编译服务）。同名冲突 first-wins（诊断挂账）。
    public SymbolTable CollectAll(CompilationUnit[] cus, string[] files, int cuCount, ImportedSymbols imported) {
        var table = new SymbolTable();
        int nf = 0;
        while (nf < cuCount) { NestedFlatten.Flatten(cus[nf]); nf = nf + 1; }   // add-nested-types（幂等，每 cu）
        int c = 0;
        while (c < cuCount) { this._stub._passInterfaces(table, cus[c], files[c]); c = c + 1; }
        c = 0;
        while (c < cuCount) { this._stub._passEnums(table, cus[c]); c = c + 1; }
        this._mergeImportedEnums(table, imported);
        // imported 接口必须在 _passClassStubs 前 seed（基表判别：查 table.Interfaces 区分 iface vs class base）。
        this._mergeImportedInterfaces(table, imported);
        c = 0;
        while (c < cuCount) { this._stub._passClassStubs(table, cus[c], files[c]); c = c + 1; }
        this._enforce._passValidatePartial(cus, files, cuCount);   // add-partial-types：全部标 partial / Kind 一致 / 嵌套 partial 校验
        // seed imported classes + funcs（成员解析前；G18：兄弟包 imported 类字段/方法类型可解析为 Z42ClassType 而非 Unknown）。
        this._mergeImports(table, imported);
        this._seedObjectStub(table);   // imported Type 已入表后；GetType 返回真实 Type 类（链式 getter 分派）
        c = 0;
        while (c < cuCount) { this._stub._passDelegates(table, cus[c]); c = c + 1; }
        c = 0;
        while (c < cuCount) { this._member._passMembers(table, cus[c]); c = c + 1; }
        this._enforce._passResolvePartialMethods();   // add-partial-types：partial method 实现↔声明配对校验（decl-only 已在 _fillClass 擦除）
        // add-type-based-overloads D7（阶段 8 修复）：override 方法 regKey 对齐——必须在所有 CU 的
        // _passMembers 全部跑完后再做（跨 CU base/derived 声明序不保证 base 先行，见 _findVirtualOrigin）。
        c = 0;
        while (c < cuCount) { this._inherit._passFixupOverrides(table, cus[c]); c = c + 1; }
        c = 0;
        while (c < cuCount) { this._inherit._passSealedEnforce(table, cus[c]); c = c + 1; }   // impl-sealed-semantics-devirt
        c = 0;
        while (c < cuCount) { this._enforce._passAttributeSuffixEnforce(cus[c]); c = c + 1; }   // attribute-handler-registry PR2（D8 后缀）
        c = 0;
        while (c < cuCount) { this._enforce._passAnalyzerSuffixEnforce(cus[c]); c = c + 1; }   // attribute-handler-registry PR3a（D8 analyzer 后缀）
        c = 0;
        while (c < cuCount) { this._enforce._passGeneratorSuffixEnforce(cus[c]); c = c + 1; }   // attribute-handler-registry PR4a（D8 generator 后缀）
        // impl-block merge (port-z42c-impl-block)：成员收集后，把 `impl Trait for Target`
        // 的方法并入 target.Methods + Trait 并入 target.InterfaceNames（target 可本地或
        // imported；_mergeImports 已 seed）。镜像 C# SymbolCollector.CollectImpls。
        c = 0;
        while (c < cuCount) { this._inherit._passImpls(table, cus[c]); c = c + 1; }
        c = 0;
        while (c < cuCount) { this._inherit._passInheritFields(table, cus[c]); c = c + 1; }
        return table;
    }

    public SymbolTable Collect(CompilationUnit cu) {
        var table = new SymbolTable();
        NestedFlatten.Flatten(cu);   // add-nested-types：嵌套类型提升为顶层（幂等）
        this._stub._passInterfaces(table, cu, "");
        this._stub._passEnums(table, cu);
        this._stub._passClassStubs(table, cu, "");   // 单-CU 路径：无 partial 主碎片跟踪
        this._stub._passDelegates(table, cu);
        this._member._passMembers(table, cu);
        this._inherit._passFixupOverrides(table, cu);   // add-type-based-overloads D7：override regKey 对齐（阶段 8 修复）
        this._inherit._passSealedEnforce(table, cu);    // impl-sealed-semantics-devirt：sealed 继承/override 强制
        this._enforce._passAttributeSuffixEnforce(cu);   // attribute-handler-registry PR2：`: Attribute` 类名后缀强制（D8）
        this._enforce._passAnalyzerSuffixEnforce(cu);    // attribute-handler-registry PR3a：`: Analyzer` 类名后缀强制（D8）
        this._enforce._passGeneratorSuffixEnforce(cu);   // attribute-handler-registry PR4a：`: Generator` 类名后缀强制（D8）
        this._inherit._passImpls(table, cu);   // port-z42c-impl-block
        this._inherit._passInheritFields(table, cu);
        return table;
    }

    internal Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { AttributedDecl ad = d as AttributedDecl; return ad.Inner; }
        return d;
    }

    // add-type-based-overloads D7：实例方法协议豁免名单——这些名字被 Rust VM / TypeChecker 自身按
    // 裸字符串字面量硬编码查找（见 design.md D7 逐名核实表），mangle 会断查找，永不参与实例 mangle。
    // ToString=VM dispatch.rs/jit value.rs 硬编码；Equals/GetHashCode/GetType=DependencyIndex._isProtocol
    // 因 Object 全员继承排除跨包裸名索引；get_Item/set_Item=TypeChecker 自身字面量查找。
    // 不含 op_*：操作符是静态方法，走既有静态 mangle 规则，不受此名单约束（见 D7 2026-07-01 订正）。
    // public：TypeChecker._checkDuplicateStaticOverloads 泛化后同样需要跳过这批名字（单一豁免名单来源）。
    public static bool IsProtocolExempt(string name) {
        return name == "ToString" || name == "Equals" || name == "GetHashCode" || name == "GetType"
            || name == "get_Item" || name == "set_Item";
    }

    // add-user-conversions：转换运算符方法名（op_Implicit / op_Explicit）。
    public static bool _isConvOp(string name) { return name == "op_Implicit" || name == "op_Explicit"; }

    // ── 方法注册（唯一入口）─────────────────────────────────────────────────
    // unify-regkey-source-of-truth：**把「算键」与「写键」绑成一个不可分割的动作。**
    //
    // 此前注册散在两处、各写各的，于是 `InheritanceResolver._passImpls` 只做了
    // `target.Methods.Put(md.Name, sym)` 而**忘了写 md.RegKey** —— impl-block 方法的
    // RegKey 因此恒为空串，逼得全部消费点都得挂「退回裸名」的兜底。走本入口后，
    // 「注册了却没填 RegKey」在结构上不可能发生。
    //
    // 读侧的对应物是 `OverloadResolver.MethodKeyOf`（解析键的唯一实现）。unify-regkey-phase2 起
    // 它**不再回落**、空 RegKey 直接抛 —— 即：任何新的方法注册路径都必须走本入口，否则编译期炸。
    //
    // 注：调用方各自决定 `key` —— `MemberCollector._fillClass` 用 primary/非-primary 规则算，
    // `InheritanceResolver._passImpls` 恒用裸名（**impl 方法不参与 primary/非-primary**，
    // 把它并入会 rekey 既有键 + 需格式 bump，是独立的语义扩展，本变更明确不做）。
    public static void RegisterMethod(Z42ClassType ct, MethodDecl md, MethodSymbol sym, string key) {
        sym.RegKey = key;
        md.RegKey  = key;
        ct.Methods.Put(key, sym);
    }

    // tp/tpc = 类的活跃类型形参；与方法自身型参（md.TypeParams，2A-2）合并后解析签名。
    internal MethodSymbol _methodSymbol(SymbolTable table, MethodDecl md, string containing, string[] tp, int tpc) {
        int mtpc = md.TypeParams.Count;
        string[] all = this._mergeParams(tp, tpc, md.TypeParams.Names, mtpc);
        int allc = tpc + mtpc;
        Z42Type[] ps = new Z42Type[md.ParamCount];
        int k = 0;
        while (k < md.ParamCount) { ps[k] = table.ResolveTypeP(md.Params[k].Type, all, allc); this._chkTypeRef(ps[k], containing, table, md.Params[k].Type.Span); k = k + 1; }   // enforce-class-access：方法参数类型引用
        Z42Type ret = table.ResolveTypeP(md.RetType, all, allc);
        if (!md.IsCtor) { this._chkTypeRef(ret, containing, table, md.RetType.Span); }   // enforce-class-access：方法返回类型引用（ctor RetType 是占位空名，跳过）
        if (md.IsCtor) { ret = new Z42VoidType(); }   // 构造器返回 void（RetType 是占位空名）
        var sig = new Z42FuncType(ps, md.ParamCount, ret);
        // add-params-varargs：末参标记 params → 记录变长起点（parser 已保证仅末参合法）。
        if (md.ParamCount > 0 && md.Params[md.ParamCount - 1].IsParams) { sig.ParamsFrom = md.ParamCount - 1; }
        var ms = new MethodSymbol(md.Name, this._vis(md.Mods, (containing == "" ? "internal" : "private")), sig, this._hasWord(md.Mods, "static"), containing, true, md);
        ms.IsSealed = this._hasWord(md.Mods, "sealed");   // impl-sealed-semantics-devirt：本地方法级 sealed
        ms.TypeParamCount = mtpc;   // add-array-paired-sort：方法级泛型形参个数，供泛型 arity 重载过滤
        return ms;
    }



    private string[] _mergeParams(string[] a, int ac, string[] b, int bc) {
        string[] r = new string[ac + bc];
        int i = 0;
        while (i < ac) { r[i] = a[i]; i = i + 1; }
        int j = 0;
        while (j < bc) { r[ac + j] = b[j]; j = j + 1; }
        return r;
    }

    // default-member-private：无修饰符默认可见性 = 最小封闭作用域（access-control.md）。
    // 成员（字段/方法/构造器/属性/索引器/嵌套类）默认 `private`（封闭层=类）；顶层类型/自由函数默认
    // `internal`（封闭层=模块）。故 dflt 由调用点按位置传入（成员 "private" / 顶层 "internal"）。
    // enforce-class-access：收集期（声明签名位置）类型引用访问校验——字段/属性/索引器/方法参·返回/基类·接口。
    // 委托静态 AccessChecker.CheckTypeRef，emit 到本 collector 的 Diags（收集期 diag bag）。cls=声明这些签名的类。
    internal void _chkTypeRef(Z42Type t, string cls, SymbolTable table, Span sp) {
        AccessChecker.CheckTypeRef(t, cls, table, this.Diags, sp);
    }

    internal string _vis(string mods, string dflt) {
        if (this._hasWord(mods, "public"))    { return "public"; }
        if (this._hasWord(mods, "private"))   { return "private"; }
        if (this._hasWord(mods, "protected")) { return "protected"; }
        if (this._hasWord(mods, "internal"))  { return "internal"; }
        // enforce-access-control：override 继承被覆写基方法的可见性；只能覆写 virtual/abstract 成员
        // （基类契约，通常 public），故无显式修饰符的 override 视为 public（镜像 C# override 须匹配基类可见性）。
        if (this._hasWord(mods, "override"))  { return "public"; }
        return dflt;
    }

    // mods 空格分隔；逐 token 比较（不依赖 String.Contains，避免子串误命中）。
    // 转发到规范实现（IrGenFacts._hasWord）——原本是本文件自己的逐字符 CharAt + Substring 版。
    internal bool _hasWord(string s, string word) { return IrGenFacts._hasWord(s, word); }
}
