// 符号收集（port-z42c-semantics 1A-3，Pass 0）。CompilationUnit AST → SymbolTable。
// 两阶段：A 先建类 stub（注册名字，使成员类型可解析兄弟类）→ B 填字段/方法签名 + 顶层 func。
// 1A 范围：class/struct（字段 + 方法签名，跳 ctor[1D] / property[后续]）+ 顶层 func。
namespace Z42.Semantics;
using Z42.IR;   // StrMap 统一到 z42c.ir（compiler-review §4.1）

using Z42.Syntax;

public sealed class SymbolCollector {
    // imported 符号先 seed，本地声明覆盖（CI-4；镜像 C# SymbolCollector.Collect：MergeImported
    // 在成员收集前——使本地类**字段/方法类型**能解析为兄弟包 imported 类，而非降级 Unknown）。
    // 顺序：本地 interface/class stub → seed imported（guard 跳本地同名，local-wins）→ 成员解析。
    // 接口必须在 _passClassStubs 之前 seed（基表判别：_passClassStubs 查 table.Interfaces 区分 iface vs class base）。
    public SymbolTable CollectWithImports(CompilationUnit cu, ImportedSymbols imported) {
        var t = new SymbolTable();
        this._passInterfaces(t, cu);
        this._passEnums(t, cu);
        this._mergeImportedEnums(t, imported);
        this._mergeImportedInterfaces(t, imported);
        this._passClassStubs(t, cu);
        this._mergeImports(t, imported);
        this._seedObjectStub(t);   // imported Type 已入表后；GetType 返回真实 Type 类（链式 getter 分派）
        this._passDelegates(t, cu);
        this._passMembers(t, cu);
        this._passFixupOverrides(t, cu);   // add-type-based-overloads D7：override 同 arity 重载 regKey 对齐（阶段 8 修复）
        this._passImpls(t, cu);   // port-z42c-impl-block：deps 路径同样须并 impl 方法入 target.Methods，
                                  // 否则 _bindImpl 的 ms=null → "this" 不入 env → `this.field` 绑成 undefined → emit const.null
        this._passInheritFields(t, cu);
        return t;
    }

    // imported 接口骨架 seed（_passClassStubs 前调用；local 同名接口已由 _passInterfaces 注册，local-wins）。
    // G18-import：IBasicCollection 等跨包接口须在 _passClassStubs 前进 table.Interfaces，否则被误当 class base。
    private void _mergeImportedInterfaces(SymbolTable table, ImportedSymbols imported) {
        if (imported == null) { return; }
        string[] ifs = imported.Interfaces.Keys();
        int i = 0;
        while (i < ifs.Length) {
            if (!table.Interfaces.ContainsKey(ifs[i])) { table.Interfaces.Put(ifs[i], imported.Interfaces.Get(ifs[i])); }
            i = i + 1;
        }
    }

    // Object stub seed（镜像 C# SymbolCollector.CollectClasses）：CU 未自声明 Object 时，
    // 预注册 Object 骨架 + 四协议方法（ToString/Equals/GetHashCode/GetType），使
    // `obj.GetType()` / 链式 `obj.GetType().BaseType.Name` 在消费端解析出真实返回类型。
    // 关键：GetType 返回类型解析为 imported `Type` 类（若已在表中），否则 Unknown——
    // 否则 GetType 返回 Unknown → 链式 getter 退化为 FieldGet → 运行期 FieldGet on Null。
    // 必须在 imported 类（含 Type）合并入表后调用。stdlib 编 z42.core 时自声明 Object → 跳过。
    private void _seedObjectStub(SymbolTable table) {
        if (table.Classes.ContainsKey("Object")) { return; }   // 本地自声明 Object（z42.core）→ local-wins
        Z42ClassType obj = new Z42ClassType("Object", false, "");
        Z42Type getTypeRet = new Z42UnknownType();
        if (table.Classes.ContainsKey("Type")) { getTypeRet = table.GetClass("Type"); }
        Z42Type objParam = new Z42PrimType("object");
        Z42Type[] noParams = new Z42Type[0];
        Z42Type[] eqParams = new Z42Type[1]; eqParams[0] = objParam;
        obj.Methods.Put("ToString", new MethodSymbol("ToString", "public",
            new Z42FuncType(noParams, 0, new Z42PrimType("string")), false, "Object", false, null));
        obj.Methods.Put("Equals", new MethodSymbol("Equals", "public",
            new Z42FuncType(eqParams, 1, new Z42PrimType("bool")), false, "Object", false, null));
        obj.Methods.Put("GetHashCode", new MethodSymbol("GetHashCode", "public",
            new Z42FuncType(noParams, 0, new Z42PrimType("int")), false, "Object", false, null));
        obj.Methods.Put("GetType", new MethodSymbol("GetType", "public",
            new Z42FuncType(noParams, 0, getTypeRet), false, "Object", false, null));
        table.Classes.Put("Object", obj);
    }

    // imported 枚举 seed（imported `EnumType.Member` 常量解析；local 同名枚举 local-wins）。
    // 必须在 typecheck 前进表，否则跨包枚举常量 `GCHandleType.Weak` 绑成 undefined → emit const.null。
    private void _mergeImportedEnums(SymbolTable table, ImportedSymbols imported) {
        if (imported == null) { return; }
        string[] ets = imported.EnumTypeNames.Keys();
        int i = 0;
        while (i < ets.Length) {
            if (!table.EnumTypes.ContainsKey(ets[i])) { table.EnumTypes.Put(ets[i], "enum"); }
            i = i + 1;
        }
        string[] ecs = imported.EnumConsts.Keys();
        i = 0;
        while (i < ecs.Length) {
            if (!table.EnumConsts.ContainsKey(ecs[i])) { table.EnumConsts.Put(ecs[i], imported.EnumConsts.Get(ecs[i])); }
            i = i + 1;
        }
    }

    // imported 符号 seed（local stub 已注册的同名跳过，local-wins；镜像 C# MergeImported + 本地覆盖）。
    // 必须在 _passMembers 前调用：成员（字段/方法签名）类型解析依赖 imported 类已在表中（G18）。
    private void _mergeImports(SymbolTable table, ImportedSymbols imported) {
        if (imported == null) { return; }
        string[] cls = imported.Classes.Keys();
        int i = 0;
        while (i < cls.Length) {
            if (!table.Classes.ContainsKey(cls[i])) { table.Classes.Put(cls[i], imported.Classes.Get(cls[i])); }
            i = i + 1;
        }
        string[] fns = imported.Functions.Keys();
        i = 0;
        while (i < fns.Length) {
            if (!table.Functions.ContainsKey(fns[i])) { table.Functions.Put(fns[i], imported.Functions.Get(fns[i])); }
            i = i + 1;
        }
    }

    // 全包合并收集（PS-1）：多 CU 同表（接口 stub 全包 → 类 stub 全包 → 成员/函数全包）。
    // 语义等价 C# sibling-exports（其逐文件+缓存导出形态为增量编译服务）。同名冲突 first-wins（诊断挂账）。
    public SymbolTable CollectAll(CompilationUnit[] cus, int cuCount, ImportedSymbols imported) {
        var table = new SymbolTable();
        int c = 0;
        while (c < cuCount) { this._passInterfaces(table, cus[c]); c = c + 1; }
        c = 0;
        while (c < cuCount) { this._passEnums(table, cus[c]); c = c + 1; }
        this._mergeImportedEnums(table, imported);
        // imported 接口必须在 _passClassStubs 前 seed（基表判别：查 table.Interfaces 区分 iface vs class base）。
        this._mergeImportedInterfaces(table, imported);
        c = 0;
        while (c < cuCount) { this._passClassStubs(table, cus[c]); c = c + 1; }
        // seed imported classes + funcs（成员解析前；G18：兄弟包 imported 类字段/方法类型可解析为 Z42ClassType 而非 Unknown）。
        this._mergeImports(table, imported);
        this._seedObjectStub(table);   // imported Type 已入表后；GetType 返回真实 Type 类（链式 getter 分派）
        c = 0;
        while (c < cuCount) { this._passDelegates(table, cus[c]); c = c + 1; }
        c = 0;
        while (c < cuCount) { this._passMembers(table, cus[c]); c = c + 1; }
        // add-type-based-overloads D7（阶段 8 修复）：override 方法 regKey 对齐——必须在所有 CU 的
        // _passMembers 全部跑完后再做（跨 CU base/derived 声明序不保证 base 先行，见 _findVirtualOrigin）。
        c = 0;
        while (c < cuCount) { this._passFixupOverrides(table, cus[c]); c = c + 1; }
        // impl-block merge (port-z42c-impl-block)：成员收集后，把 `impl Trait for Target`
        // 的方法并入 target.Methods + Trait 并入 target.InterfaceNames（target 可本地或
        // imported；_mergeImports 已 seed）。镜像 C# SymbolCollector.CollectImpls。
        c = 0;
        while (c < cuCount) { this._passImpls(table, cus[c]); c = c + 1; }
        c = 0;
        while (c < cuCount) { this._passInheritFields(table, cus[c]); c = c + 1; }
        return table;
    }

    // impl-block 收集（port-z42c-impl-block，镜像 C# CollectImpls）：
    // 解析 target（NamedType→已注册类）+ trait（接口名）→ 把方法并入 target.Methods、
    // trait 并入 target.InterfaceNames。严格校验（接口方法齐备/arity）留待后续。
    private void _passImpls(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = cu.Decls[i];
            if (d is ImplDecl) {
                ImplDecl implD = d as ImplDecl;
                string targetName = "";
                if (implD.TargetType is NamedType) { targetName = (implD.TargetType as NamedType).Name; }
                if (targetName != "" && table.HasClass(targetName)) {
                    Z42ClassType target = table.GetClass(targetName);
                    string traitName = "";
                    if (implD.TraitType is NamedType) { traitName = (implD.TraitType as NamedType).Name; }
                    if (traitName != "") { target.AddInterfaceName(traitName); }
                    int m = 0;
                    while (m < implD.MethodCount) {
                        if (implD.Methods[m] is MethodDecl) {
                            MethodDecl md = implD.Methods[m] as MethodDecl;
                            target.Methods.Put(md.Name, this._methodSymbol(table, md, targetName, new string[0], 0));
                            target.AddOwnMethod(md.Name, this._hasWord(md.Mods, "virtual"), false);
                        }
                        m = m + 1;
                    }
                }
            }
            i = i + 1;
        }
    }

    public SymbolTable Collect(CompilationUnit cu) {
        var table = new SymbolTable();
        this._passInterfaces(table, cu);
        this._passEnums(table, cu);
        this._passClassStubs(table, cu);
        this._passDelegates(table, cu);
        this._passMembers(table, cu);
        this._passFixupOverrides(table, cu);   // add-type-based-overloads D7：override regKey 对齐（阶段 8 修复）
        this._passImpls(table, cu);   // port-z42c-impl-block
        this._passInheritFields(table, cu);
        return table;
    }

    // 继承字段合并（_passMembers 后）：把基类链上的实例字段并入派生类 Fields（own-wins，跳 static）。
    // Z42ClassType.Fields 供 binder env（裸 ident → 字段类型）+ FunctionEmitter（裸 ident → field_get reg0）
    // 读取；此前仅含自有字段 → 派生类裸访问继承字段（`name = n`）解析失败 → 写入幻影局部 → 运行期 null。
    // _classDesc 用 AST c.Members 发 TYPE 段字段，不读此表 → 合并不污染字段布局。
    private void _passInheritFields(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct" || c.Kind == "record") {
                    string ctKey = c.Name;
                    if (c.TypeParams.Count > 0) { string mk = c.Name + "$" + c.TypeParams.Count.ToString(); if (table.Classes.ContainsKey(mk)) { ctKey = mk; } }
                    Z42ClassType ct = table.Classes.Get(ctKey) as Z42ClassType;
                    if (ct != null) {
                        Z42ClassType cur = ct;
                        while (cur != null && cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName)) {
                            Z42ClassType baseCt = table.Classes.Get(cur.BaseName) as Z42ClassType;
                            if (baseCt == null) { cur = null; }
                            else {
                                string[] bfns = baseCt.Fields.Keys();
                                int k = 0;
                                while (k < bfns.Length) {
                                    FieldSymbol bfs = baseCt.Fields.Get(bfns[k]) as FieldSymbol;
                                    if (bfs != null && !bfs.IsStatic && !ct.Fields.ContainsKey(bfns[k])) {
                                        ct.Fields.Put(bfns[k], bfs);
                                    }
                                    k = k + 1;
                                }
                                cur = baseCt;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // add-type-based-overloads D7（阶段 8 修复，2026-07-01）：override 方法 regKey 对齐。
    //
    // 根因：_fillClass 的 mangle 决策（wantMangle）只看**当前类自身**的 arityDup——若 Base 声明两个
    // 同 arity 重载（如 Handle(int)/Handle(string)）会 mangle 出 Handle$1$i32/Handle$1$string；但
    // Derived 若只 override 其中一个，Derived 本地只有一个 Handle（arityDup=1）→ 不 mangle → 注册成裸
    // 名 "Handle"。VM 侧 vtable 合并（TypeDesc::derive_simple_method_name / merge_with_base）按 regKey
    // 字符串裸匹配 slot——两端 regKey 不一致 ⟹ Derived 的 override 落进一个**新**槽位，Base 的
    // Handle$1$i32 槽位原样保留 ⟹ 虚派发仍打到 Base 实现（override 语义失效）。
    //
    // 修复：override 方法必须复用"最初声明该虚方法"的那层（非 override 的 virtual 声明，或 imported
    // 基类——无 AST Decl 视为终点）所采用的 regKey，而非依本地 arityDup 独立决策。走 AST Decl.Mods 逐层
    // 上溯（而非依赖 baseCt.Methods 是否已被本 pass 修正），使结果与 _fillClass 的跨 CU 处理顺序无关。
    private void _passFixupOverrides(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct" || c.Kind == "record") {
                    string ctKey = c.Name;
                    if (c.TypeParams.Count > 0) { string mk = c.Name + "$" + c.TypeParams.Count.ToString(); if (table.Classes.ContainsKey(mk)) { ctKey = mk; } }
                    Z42ClassType ct = table.Classes.Get(ctKey) as Z42ClassType;
                    if (ct != null && ct.HasBase) {
                        int j = 0;
                        while (j < c.MemberCount) {
                            Decl mem = this._unwrap(c.Members[j]);
                            if (mem is MethodDecl) {
                                MethodDecl md = mem as MethodDecl;
                                if (this._hasWord(md.Mods, "override")) {
                                    MethodSymbol localSym = ct.Methods.Get(md.RegKey) as MethodSymbol;
                                    if (localSym != null) {
                                        MethodSymbol origin = this._findVirtualOrigin(table, ct,
                                            localSym.Name, localSym.Signature.ParamTypes, localSym.Signature.ParamCount);
                                        if (origin != null && origin.RegKey != md.RegKey) {
                                            localSym.RegKey = origin.RegKey;
                                            md.RegKey = origin.RegKey;
                                            ct.Methods.Put(origin.RegKey, localSym);   // 旧裸键留存亦无害——
                                            // OverloadsOf 按 Name 收集，_collectOverloads 再按 RegKey 去重，
                                            // 两键指向同一（已改写 RegKey 的）对象时天然合并为一个候选。
                                        }
                                    }
                                }
                            }
                            j = j + 1;
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // 沿 base 链逐层上溯，找到（name, paramTypes）对应虚方法**最初**（非 override）声明所在层的
    // MethodSymbol，返回其 RegKey 作为权威键。imported 基类方法无 AST Decl（HasDecl=false）→ 视为终点
    // （其 RegKey 即该 imported 包编译时已定案的键，无需也无法继续上溯）。全链找不到匹配 → 返回 null
    // （不改写，保留 _fillClass 的本地决策——理论上不应发生，`override` 必然对应某个虚方法声明）。
    private MethodSymbol _findVirtualOrigin(SymbolTable table, Z42ClassType ct, string name, Z42Type[] paramTypes, int paramCount) {
        string wantCanon = OverloadResolver.MangleKey(name, paramTypes, paramCount);
        Z42ClassType cur = ct;
        MethodSymbol lastMatch = null;
        bool more = cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName);
        while (more) {
            Z42ClassType baseCt = table.Classes.Get(cur.BaseName) as Z42ClassType;
            if (baseCt == null) {
                more = false;
            } else {
                MethodSymbol matchHere = null;
                string[] keys = baseCt.Methods.Keys();
                int k = 0;
                while (k < keys.Length) {
                    MethodSymbol sym = baseCt.Methods.Get(keys[k]) as MethodSymbol;
                    if (sym != null && sym.Name == name) {
                        string symCanon = OverloadResolver.MangleKey(sym.Name, sym.Signature.ParamTypes, sym.Signature.ParamCount);
                        if (symCanon == wantCanon) { matchHere = sym; }
                    }
                    k = k + 1;
                }
                if (matchHere != null) {
                    lastMatch = matchHere;
                    bool matchIsOverride = matchHere.HasDecl && matchHere.Decl != null && this._hasWord(matchHere.Decl.Mods, "override");
                    if (!matchIsOverride) { more = false; }
                    else { cur = baseCt; more = cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName); }
                } else {
                    cur = baseCt; more = cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName);
                }
            }
        }
        return lastMatch;
    }

    // Pass A-1：枚举类型 + 成员常量（先于类 stub——成员类型解析可能用到枚举）。
    // 用户 delegate → Z42FuncType（委托类型即函数类型）。非泛型注册；泛型暂跳（运行期擦除）。
    // _passClassStubs 后调用，使签名 prim/类类型可解析。
    private void _passDelegates(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is DelegateDecl) {
                DelegateDecl dd = d as DelegateDecl;
                if (dd.TypeParams.Count == 0 && !table.Delegates.ContainsKey(dd.Name)) {
                    Z42Type[] ps = new Z42Type[dd.ParamCount];
                    int p = 0;
                    while (p < dd.ParamCount) { ps[p] = table.ResolveType(dd.Params[p].Type); p = p + 1; }
                    table.Delegates.Put(dd.Name, new Z42FuncType(ps, dd.ParamCount, table.ResolveType(dd.RetType)));
                }
            }
            i = i + 1;
        }
    }

    private void _passEnums(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is EnumDecl) {
                EnumDecl ed = d as EnumDecl;
                table.EnumTypes.Put(ed.Name, "enum");
                long cur = 0;
                int mi = 0;
                while (mi < ed.MemberCount) {
                    EnumMember em = ed.Members[mi];
                    if (em.HasValue) { cur = this._parseEnumVal(em.Value); }
                    table.EnumConsts.Put(ed.Name + "." + em.Name, new StrBox(cur.ToString()));
                    cur = cur + 1;
                    mi = mi + 1;
                }
            }
            i = i + 1;
        }
    }

    private long _parseEnumVal(string s) {
        long r = 0;
        int i = 0;
        bool neg = false;
        if (s.Length > 0 && s.CharAt(0) == '-') { neg = true; i = 1; }
        while (i < s.Length) {
            int d = (int)s.CharAt(i) - 48;
            r = r * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { r = 0 - r; }
        return r;
    }

    // Pass A0：接口 stub（先于类——基表判别要查 Interfaces）（port-z42c-interface）
    private void _passInterfaces(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "interface") {
                    table.Interfaces.Put(c.Name, new Z42InterfaceType(c.Name));
                }
            }
            i = i + 1;
        }
    }

    // Pass A：类 stub（基表判别：接口入 InterfaceNames，类→base）
    private void _passClassStubs(SymbolTable table, CompilationUnit cu) {
        // ── Pre-scan：检测同 CU 内同名不同 arity 的类，泛型版需 arity-mangle（镜像 C# NeedsMangle 逻辑）。
        // firstArityMap[name] = 首次见到的 arity（字符串）；multiArityMap[name] = "1" 若有多个不同 arity。
        StrMap firstArityMap = new StrMap();
        StrMap multiArityMap = new StrMap();
        int pi = 0;
        while (pi < cu.DeclCount) {
            Decl pd = this._unwrap(cu.Decls[pi]);
            if (pd is ClassDecl) {
                ClassDecl pc = pd as ClassDecl;
                if (pc.Kind == "class" || pc.Kind == "struct" || pc.Kind == "record") {
                    string arStr = pc.TypeParams.Count.ToString();
                    if (firstArityMap.ContainsKey(pc.Name)) {
                        StrBox fa = firstArityMap.Get(pc.Name) as StrBox;
                        if (fa.Value != arStr) { multiArityMap.Put(pc.Name, "1"); }
                    } else {
                        firstArityMap.Put(pc.Name, new StrBox(arStr));
                    }
                }
            }
            pi = pi + 1;
        }
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct" || c.Kind == "record") {
                    bool hasBase = false;
                    string baseName = "";
                    string[] ifaces = new string[c.BaseCount];
                    int ifc = 0;
                    int b = 0;
                    while (b < c.BaseCount) {
                        string bn = c.Bases[b].Dump();
                        // 泛型接口查表用裸名（"IComparable<char>" → "IComparable"），
                        // 存储也用裸名（镜像 C# ExportedTypeExtractor ifaceList.Select(i => i.Name)）。
                        string bnLookup = bn;
                        int ltIdx = bn.IndexOf("<");
                        if (ltIdx >= 0) { bnLookup = bn.Substring(0, ltIdx); }
                        if (table.Interfaces.ContainsKey(bnLookup)) { ifaces[ifc] = bnLookup; ifc = ifc + 1; }
                        else if (!hasBase) { hasBase = true; baseName = bn; }
                        b = b + 1;
                    }
                    bool needsMangle = c.TypeParams.Count > 0 && multiArityMap.ContainsKey(c.Name);
                    string key = needsMangle ? c.Name + "$" + c.TypeParams.Count.ToString() : c.Name;
                    Z42ClassType ct = new Z42ClassType(c.Name, hasBase, baseName);
                    ct.InterfaceNames = ifaces;
                    ct.InterfaceCount = ifc;
                    if (needsMangle) { ct.HasArityMangle = true; ct.ArityMangleCount = c.TypeParams.Count; }
                    table.Classes.Put(key, ct);
                }
            }
            i = i + 1;
        }
    }

    // Pass B：成员 + 顶层 func
    private void _passMembers(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct" || c.Kind == "record") { this._fillClass(table, c); }
                else if (c.Kind == "interface") { this._fillInterface(table, c); }
            } else if (d is MethodDecl) {
                MethodDecl m = d as MethodDecl;            // 顶层 func（IsFree）
                table.Functions.Put(m.Name, this._methodSymbol(table, m, "", new string[0], 0));
            }
            i = i + 1;
        }
    }

    private Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { AttributedDecl ad = d as AttributedDecl; return ad.Inner; }
        return d;
    }

    // 接口方法签名（体可无；签名同类方法解析）（port-z42c-interface）。
    private void _fillInterface(SymbolTable table, ClassDecl c) {
        Z42InterfaceType it = table.Interfaces.Get(c.Name) as Z42InterfaceType;
        string[] tp = c.TypeParams.Names;    // 接口类型形参（泛型接口 IFoo<T>：T 列入 paramNames 解析签名）
        int tpc = c.TypeParams.Count;
        int j = 0;
        while (j < c.MemberCount) {
            Decl mem = this._unwrap(c.Members[j]);
            if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                it.Methods.Put(md.Name, this._methodSymbol(table, md, c.Name, tp, tpc));
            } else if (mem is PropertyDecl) {
                // 接口属性 getter → get_X 方法符号（镜像 C# IEnumerator<T>.Current → get_Current）。
                PropertyDecl pd = mem as PropertyDecl;
                if (pd.HasGet) {
                    string gkey = "get_" + pd.Name;
                    Z42Type gret = table.ResolveTypeP(pd.Type, tp, tpc);
                    Z42Type[] gps = new Z42Type[0];
                    it.Methods.Put(gkey, new MethodSymbol(gkey, "public", new Z42FuncType(gps, 0, gret), false, c.Name, false, null));
                }
            }
            j = j + 1;
        }
    }

    // add-type-based-overloads D7：实例方法协议豁免名单——这些名字被 Rust VM / TypeChecker 自身按
    // 裸字符串字面量硬编码查找（见 design.md D7 逐名核实表），mangle 会断查找，永不参与实例 mangle。
    // ToString=VM dispatch.rs/jit value.rs 硬编码；Equals/GetHashCode/GetType=DependencyIndex._isProtocol
    // 因 Object 全员继承排除跨包裸名索引；get_Item/set_Item=TypeChecker 自身字面量查找。
    // 不含 op_*：操作符是静态方法，走既有静态 mangle 规则，不受此名单约束（见 D7 2026-07-01 订正）。
    // public：TypeChecker._checkDuplicateStaticOverloads 泛化后同样需要跳过这批名字（单一豁免名单来源）。
    public static bool IsProtocolExempt(string name) {
        return name == "ToString" || name == "Equals" || name == "GetHashCode" || name == "GetType"
            || name == "get_Item" || name == "set_Item";
    }

    private void _fillClass(SymbolTable table, ClassDecl c) {
        // Arity-mangle：泛型类若已以 Name$N 键注册，优先取该 CT（镜像 C# TryGetClassFor）。
        string ctKey = c.Name;
        if (c.TypeParams.Count > 0) { string mk = c.Name + "$" + c.TypeParams.Count.ToString(); if (table.Classes.ContainsKey(mk)) { ctKey = mk; } }
        Z42ClassType ct = table.Classes.Get(ctKey) as Z42ClassType;
        string[] tp = c.TypeParams.Names;     // 类型形参（泛型类；非泛型 Count=0）
        int tpc = c.TypeParams.Count;
        // GS3：预扫描检测本地重载（同名多 arity 方法）——镜像 C# methodNameCount[(Name, IsStatic)]>1 判断。
        // 重载方法注册为 Name$arity 键；unique 方法保留 bare 键（不影响 7 包 byte-identical 门）。
        StrMap seenInst   = new StrMap();   // 实例方法首次见
        StrMap seenSt     = new StrMap();   // 静态方法首次见
        StrMap ovldInst   = new StrMap();   // 实例方法重载（>1 arity）
        StrMap ovldSt     = new StrMap();   // 静态方法重载
        // add-type-based-overloads：同 (name,arity) ≥2 重载检测（type-based）。键 name$arity，值 "1"=见过 / "2"=重复。
        StrMap arityDup   = new StrMap();
        int pi = 0;
        while (pi < c.MemberCount) {
            Decl pmem = this._unwrap(c.Members[pi]);
            if (pmem is MethodDecl) {
                MethodDecl pmd = pmem as MethodDecl;
                bool pst = this._hasWord(pmd.Mods, "static");
                if (pst) {
                    if (seenSt.ContainsKey(pmd.Name)) { ovldSt.Put(pmd.Name, "1"); }
                    else { seenSt.Put(pmd.Name, "1"); }
                } else {
                    if (seenInst.ContainsKey(pmd.Name)) { ovldInst.Put(pmd.Name, "1"); }
                    else { seenInst.Put(pmd.Name, "1"); }
                }
                string ak = pmd.Name + "$" + pmd.ParamCount.ToString();
                if (arityDup.ContainsKey(ak)) { arityDup.Put(ak, "2"); }   // ≥2 → type-based 重载
                else { arityDup.Put(ak, "1"); }
            }
            pi = pi + 1;
        }
        int j = 0;
        while (j < c.MemberCount) {
            Decl mem = this._unwrap(c.Members[j]);
            if (mem is FieldDecl) {
                FieldDecl fd = mem as FieldDecl;
                Z42Type ft = table.ResolveTypeP(fd.Type, tp, tpc);
                bool fstatic = this._hasWord(fd.Mods, "static");
                ct.Fields.Put(fd.Name, new FieldSymbol(fd.Name, this._vis(fd.Mods), ft, fstatic, c.Name));
                if (this._hasWord(fd.Mods, "event")) { ct.EventFields.Put(fd.Name, "1"); }   // add-event-keyword-multicast

                // G18：实例字段记有序元数据（声明序 + TSIG 规范拼写）供 TSIG 继承字段展开；static 不入（C# 不继承合并 static）。
                // 用 resolved Z42Type.Name() 镜像 C# TypeToString(sym.Type)：接口→裸名、Predicate<T>→Func<T,bool>、
                // Func/Action 规范化；Unknown/Error → AST fallback（imported 包 interface 未进 ImportedSymbols 时降级）。
                if (!fstatic) { string fsp = (ft is Z42UnknownType || ft is Z42ErrorType) ? ExportedTypeExtractor.TsigTypeName(fd.Type) : ft.Name(); ct.AddOwnField(fd.Name, fsp, this._vis(fd.Mods)); }
            } else if (mem is PropertyDecl) {
                // 属性作为字段处理（type-checking 用；auto-property { get;/set; } 等同只读/读写字段）。
                PropertyDecl pd = mem as PropertyDecl;
                Z42Type pft = table.ResolveTypeP(pd.Type, tp, tpc);
                bool pfstatic = this._hasWord(pd.Mods, "static");
                ct.Fields.Put(pd.Name, new FieldSymbol(pd.Name, this._vis(pd.Mods), pft, pfstatic, c.Name));
                // 镜像 C# SynthesizeClassAutoProp：后备字段名 __prop_X（非源名 X），供 TSIG 导出匹配。
                // extern/native 属性无后备字段；后备字段 vis 固定 private（C# 合成行为）。
                bool pfExtern = this._hasWord(pd.Mods, "extern");
                if (!pfstatic && !pfExtern) { string pfsp = (pft is Z42UnknownType || pft is Z42ErrorType) ? ExportedTypeExtractor.TsigTypeName(pd.Type) : pft.Name(); ct.AddOwnField("__prop_" + pd.Name, pfsp, "private"); }
                // get_X / set_X accessor 方法符号（IrGen 发 builtin stub 或编译体；镜像 C# SynthesizeClassAutoProp）。
                string pvis = this._vis(pd.Mods);
                Z42Type[] getPs0 = new Z42Type[0];
                if (pd.HasGet) {
                    ct.Methods.Put("get_" + pd.Name, new MethodSymbol("get_" + pd.Name, pvis,
                        new Z42FuncType(getPs0, 0, pft), pfstatic, c.Name, false, null));
                }
                if (pd.HasSet) {
                    Z42Type[] setPs0 = new Z42Type[1];
                    setPs0[0] = pft;
                    ct.Methods.Put("set_" + pd.Name, new MethodSymbol("set_" + pd.Name, pvis,
                        new Z42FuncType(setPs0, 1, new Z42VoidType()), pfstatic, c.Name, false, null));
                }
            } else if (mem is IndexerDecl) {
                // get_Item / set_Item accessor 方法符号（IndexerDecl lowering；镜像 C# IndexerDecl → get_Item/set_Item）。
                IndexerDecl id = mem as IndexerDecl;
                Z42Type idRet = table.ResolveTypeP(id.RetType, tp, tpc);
                bool idStatic = this._hasWord(id.Mods, "static");
                string idvis = this._vis(id.Mods);
                if (id.HasGet) {
                    Z42Type[] getPs1 = new Z42Type[id.ParamCount];
                    int qi0 = 0;
                    while (qi0 < id.ParamCount) { getPs1[qi0] = table.ResolveTypeP(id.Params[qi0].Type, tp, tpc); qi0 = qi0 + 1; }
                    ct.Methods.Put("get_Item", new MethodSymbol("get_Item", idvis,
                        new Z42FuncType(getPs1, id.ParamCount, idRet), idStatic, c.Name, false, null));
                }
                if (id.HasSet) {
                    Z42Type[] setPs1 = new Z42Type[id.ParamCount + 1];
                    int qi1 = 0;
                    while (qi1 < id.ParamCount) { setPs1[qi1] = table.ResolveTypeP(id.Params[qi1].Type, tp, tpc); qi1 = qi1 + 1; }
                    setPs1[id.ParamCount] = idRet;
                    ct.Methods.Put("set_Item", new MethodSymbol("set_Item", idvis,
                        new Z42FuncType(setPs1, id.ParamCount + 1, new Z42VoidType()), idStatic, c.Name, false, null));
                }
            } else if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                // ctor（G11）也收集为方法（名=类名，ret void）：使 TypeChecker 能绑其体、IrGen 能发 `<Class>.<Class>` 函数。
                // GS3：重载方法注册 Name$arity；unique 方法 bare name（镜像 C# SymbolCollector.Classes.cs regName 逻辑）。
                // add-type-based-overloads：同 (name,arity) ≥2（type-based 重载）→ Name$arity$typesig 消歧。
                bool mst = this._hasWord(md.Mods, "static");
                bool isOvld = mst ? ovldSt.ContainsKey(md.Name) : ovldInst.ContainsKey(md.Name);
                MethodSymbol msym = this._methodSymbol(table, md, c.Name, tp, tpc);
                string aritK = md.Name + "$" + md.ParamCount.ToString();
                string regName = md.Name;
                // add-type-based-overloads：静态方法 type-mangle 无条件启用（编译期决议 → emit 精确签名键 → 安全）。
                // D7（2026-07-01）：实例方法同样启用 mangle，但协议豁免名单内的名字（ToString/Equals/
                // GetHashCode/GetType/get_Item/set_Item）永不 mangle——它们被 VM/TypeChecker 按裸字符串
                // 字面量硬编码查找，mangle 会断查找（见 _isProtocolExempt 注释 + design.md D7）。
                bool wantMangle = arityDup.ContainsKey(aritK) && arityDup.Get(aritK) == "2"
                    && (mst || !SymbolCollector.IsProtocolExempt(md.Name));
                if (wantMangle) {
                    regName = OverloadResolver.MangleKey(md.Name, msym.Signature.ParamTypes, msym.Signature.ParamCount);
                } else if (isOvld) {
                    regName = aritK;
                }
                msym.RegKey = regName;
                md.RegKey = regName;          // 单一真相源：body 绑定 / IrGen 复用此键（type-based 重载消歧）
                ct.Methods.Put(regName, msym);
            }
            j = j + 1;
        }
    }

    // tp/tpc = 类的活跃类型形参；与方法自身型参（md.TypeParams，2A-2）合并后解析签名。
    private MethodSymbol _methodSymbol(SymbolTable table, MethodDecl md, string containing, string[] tp, int tpc) {
        int mtpc = md.TypeParams.Count;
        string[] all = this._mergeParams(tp, tpc, md.TypeParams.Names, mtpc);
        int allc = tpc + mtpc;
        Z42Type[] ps = new Z42Type[md.ParamCount];
        int k = 0;
        while (k < md.ParamCount) { ps[k] = table.ResolveTypeP(md.Params[k].Type, all, allc); k = k + 1; }
        Z42Type ret = table.ResolveTypeP(md.RetType, all, allc);
        if (md.IsCtor) { ret = new Z42VoidType(); }   // 构造器返回 void（RetType 是占位空名）
        var sig = new Z42FuncType(ps, md.ParamCount, ret);
        // add-params-varargs：末参标记 params → 记录变长起点（parser 已保证仅末参合法）。
        if (md.ParamCount > 0 && md.Params[md.ParamCount - 1].IsParams) { sig.ParamsFrom = md.ParamCount - 1; }
        return new MethodSymbol(md.Name, this._vis(md.Mods), sig, this._hasWord(md.Mods, "static"), containing, true, md);
    }

    private string[] _mergeParams(string[] a, int ac, string[] b, int bc) {
        string[] r = new string[ac + bc];
        int i = 0;
        while (i < ac) { r[i] = a[i]; i = i + 1; }
        int j = 0;
        while (j < bc) { r[ac + j] = b[j]; j = j + 1; }
        return r;
    }

    private string _vis(string mods) {
        if (this._hasWord(mods, "public"))    { return "public"; }
        if (this._hasWord(mods, "private"))   { return "private"; }
        if (this._hasWord(mods, "protected")) { return "protected"; }
        if (this._hasWord(mods, "internal"))  { return "internal"; }
        return "internal";
    }

    // mods 空格分隔；逐 token 比较（不依赖 String.Contains，避免子串误命中）。
    private bool _hasWord(string s, string word) {
        int n = s.Length;
        int start = 0;
        int i = 0;
        while (i <= n) {
            if (i == n || s.CharAt(i) == ' ') {
                if (i > start) {
                    string tok = s.Substring(start, i - start);
                    if (tok == word) { return true; }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }
}
