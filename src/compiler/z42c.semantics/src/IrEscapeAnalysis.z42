// IrEscapeAnalysis —— 逃逸分析驱动的栈上分配（add-escape-analysis-stack-alloc）。
//
// 目标：证明某个 ObjNew / ArrayNew / ArrayNewLit 的结果**不逃逸创建它的函数帧**，据此置
// StackAlloc=true。interp 遇该标志在帧局部 arena 分配（绕过 GC，帧退出即释放；JIT 忽略、照常堆分配）。
//
// 设计（见 docs/book/src/runtime/escape-analysis-stack-alloc.md）：
//   - **流不敏感 may-escape 过近似（CFG-free）**：逃逸是「该 reg 的**任一**使用是否到达逃逸汇点」，
//     与控制流顺序无关的 may 问题 → 线性扫全函数即安全过近似，无需 CFG / 支配域（区别于 LICM）。
//   - **角色感知逃逸汇点规则表**（`_markEscaping`，可扩展核心）：逐指令按操作数**角色**分类——
//     escaping（返回 / 存字段·数组·静态的值 / 传任何调用含 receiver / throw / 闭包捕获 / ToString /
//     as-cast 别名 / 取址）标记逃逸；neutral（读自身字段·数组·长度 / is-check / 算术等消费值）跳过。
//     **铁律：完整镜像 IrOptInfo.AddReads 的读枚举**——漏一个 escaping 操作数 = 漏判逃逸 = 悬垂栈引用。
//     加精度只需改本表的分类，引擎（下面两趟）不动。
//   - **copy 传递闭包**（Pass B 不动点）：`dst = copy src`，dst 逃逸 ⇒ src 逃逸（对象经 copy 流出）。
//   - **对象额外前提：ctor 不泄漏 this**（`_ctorLeaksThis`，单函数摘要、不递归）：new 会带 this 调 ctor，
//     若 ctor 把 this 存静态 / 传给别的调用 / 返回 → 泄漏 → 该对象不合格。跨包 / 找不到 ctor → 保守判泄漏。
//   - **仅标单赋值 temp**（defs==1）：多定义命名局部保守不标（对齐 copy-prop/CSE 的稳定性口径）。
//
// 独立性（OptSet D2）：本 pass 自行从当前 IR 重算 esc/defs，不依赖其它 pass 先跑。
namespace Z42.Semantics;

using Z42.IR;

public sealed class IrEscapeAnalysis {

    // ctor this-泄漏摘要缓存（按 ctor FQ 名）——同一 ctor 在多处 new，只算一次。
    private string[] _ctorNames;
    private bool[]   _ctorLeaks;
    private int      _ctorCacheCount;

    public IrEscapeAnalysis() {
        this._ctorNames = new string[0];
        this._ctorLeaks = new bool[0];
        this._ctorCacheCount = 0;
    }

    // 模块级入口：逐函数标记不逃逸分配。
    public static void Run(IrModule m) {
        IrEscapeAnalysis ea = new IrEscapeAnalysis();
        int fi = 0;
        while (fi < m.FuncCount) {
            ea._markFunc(m, m.Functions[fi]);
            fi = fi + 1;
        }
    }

    // 对一个函数：算逃逸集 + 单赋值集，给不逃逸的分配置 StackAlloc。
    private void _markFunc(IrModule m, IrFunction f) {
        bool[] esc  = IrEscapeAnalysis._computeEscaped(f);
        int[]  defs = IrEscapeAnalysis._computeDefs(f);
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock b = f.Blocks[bi];
            int ii = 0;
            while (ii < b.InstrCount) {
                IrInstr ins = b.Instrs[ii];
                if (ins is ArrayNewInstr) {
                    ArrayNewInstr a = ins as ArrayNewInstr;
                    if (IrEscapeAnalysis._ok(esc, defs, a.Dst.Id)) { a.StackAlloc = true; }
                }
                if (ins is ArrayNewLitInstr) {
                    ArrayNewLitInstr a = ins as ArrayNewLitInstr;
                    if (IrEscapeAnalysis._ok(esc, defs, a.Dst.Id)) { a.StackAlloc = true; }
                }
                if (ins is ObjNewInstr) {
                    ObjNewInstr o = ins as ObjNewInstr;
                    if (IrEscapeAnalysis._ok(esc, defs, o.Dst.Id) && !this._ctorLeaksThis(m, o.CtorName)) {
                        o.StackAlloc = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }

    // 合格：单赋值 temp 且不逃逸。
    private static bool _ok(bool[] esc, int[] defs, int id) {
        if (id < 0 || id >= esc.Length || id >= defs.Length) { return false; }
        return (!esc[id]) && defs[id] == 1;
    }

    // ── 逃逸集：Pass A 直接汇点 + Pass B copy 传递闭包 ────────────────────────────────────
    private static bool[] _computeEscaped(IrFunction f) {
        int n = f.MaxReg + 2;
        bool[] esc = new bool[n];
        // Pass A：逐指令 / 终结子标记 escaping-角色操作数。
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock b = f.Blocks[bi];
            int ii = 0;
            while (ii < b.InstrCount) {
                IrEscapeAnalysis._markEscaping(esc, b.Instrs[ii]);
                ii = ii + 1;
            }
            if (b.HasTerm) { IrEscapeAnalysis._markTermEscaping(esc, b.Term); }
            bi = bi + 1;
        }
        // Pass B：copy 传递闭包 —— dst 逃逸 ⇒ src 逃逸（链式，跑到不动点）。
        bool changed = true;
        while (changed) {
            changed = false;
            bi = 0;
            while (bi < f.BlockCount) {
                IrBlock b = f.Blocks[bi];
                int ii = 0;
                while (ii < b.InstrCount) {
                    if (b.Instrs[ii] is CopyInstr) {
                        CopyInstr c = b.Instrs[ii] as CopyInstr;
                        int d = c.Dst.Id; int s = c.Src.Id;
                        if (d >= 0 && d < n && s >= 0 && s < n && esc[d] && (!esc[s])) {
                            esc[s] = true; changed = true;
                        }
                    }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
        }
        return esc;
    }

    // 逃逸汇点规则表（可扩展核心）——完整镜像 IrOptInfo.AddReads 的读枚举，逐操作数分类。
    // 标记的是 escaping-角色操作数；neutral-角色（读自身字段/数组/长度、is-check、算术消费）不标；
    // Copy.Src 由 Pass B 传递。**规则表覆盖 AddReads 全部有读操作数的指令**（保证不漏 escaping 用）。
    private static void _markEscaping(bool[] esc, IrInstr ins) {
        // 调用：所有实参（VCall / CallIndirect 另含 receiver / callee）逃逸 —— callee 可能捕获。
        if (ins is CallInstr)        { CallInstr i = ins as CallInstr; IrEscapeAnalysis._markArgs(esc, i.Args, i.ArgCount); return; }
        if (ins is BuiltinInstr)     { BuiltinInstr i = ins as BuiltinInstr; IrEscapeAnalysis._markArgs(esc, i.Args, i.ArgCount); return; }
        if (ins is CallNativeInstr)  { CallNativeInstr i = ins as CallNativeInstr; IrEscapeAnalysis._markArgs(esc, i.Args, i.ArgCount); return; }
        if (ins is VCallInstr)       { VCallInstr i = ins as VCallInstr; IrEscapeAnalysis._mark(esc, i.Obj); IrEscapeAnalysis._markArgs(esc, i.Args, i.ArgCount); return; }
        if (ins is CallIndirectInstr){ CallIndirectInstr i = ins as CallIndirectInstr; IrEscapeAnalysis._mark(esc, i.Callee); IrEscapeAnalysis._markArgs(esc, i.Args, i.ArgCount); return; }
        if (ins is ObjNewInstr)      { ObjNewInstr i = ins as ObjNewInstr; IrEscapeAnalysis._markArgs(esc, i.Args, i.ArgCount); return; }        // 作为别的 new 的 ctor 实参
        if (ins is MkClosInstr)      { MkClosInstr i = ins as MkClosInstr; IrEscapeAnalysis._markArgs(esc, i.Captures, i.CaptureCount); return; }
        // 存储：被存进对象/静态/数组的**值**逃逸；target/array/index 是 neutral（不泄露被写容器本身）。
        if (ins is FieldSetInstr)    { FieldSetInstr i = ins as FieldSetInstr; IrEscapeAnalysis._mark(esc, i.Val); return; }
        if (ins is StaticSetInstr)   { StaticSetInstr i = ins as StaticSetInstr; IrEscapeAnalysis._mark(esc, i.Val); return; }
        if (ins is ArraySetInstr)    { ArraySetInstr i = ins as ArraySetInstr; IrEscapeAnalysis._mark(esc, i.Val); return; }
        if (ins is ArrayNewLitInstr) { ArrayNewLitInstr i = ins as ArrayNewLitInstr; IrEscapeAnalysis._markArgs(esc, i.Elems, i.ElemCount); return; }
        // 别名 / 调用用户码：as-cast 结果别名 Obj；ToStr 调 ToString(this)；取址泄漏引用。
        if (ins is AsCastInstr)      { AsCastInstr i = ins as AsCastInstr; IrEscapeAnalysis._mark(esc, i.Obj); return; }
        if (ins is ToStrInstr)       { ToStrInstr i = ins as ToStrInstr; IrEscapeAnalysis._mark(esc, i.Src); return; }
        if (ins is LoadLocalAddrInstr){ LoadLocalAddrInstr i = ins as LoadLocalAddrInstr; IrEscapeAnalysis._mark(esc, i.Slot); return; }
        // IsInstance.Obj：`is`-check 本不泄露引用（严格说 neutral），但标 ESCAPE 是**有意收窄
        // 运行时触达面**——如此栈对象在 interp 只会经历 FieldGet/FieldSet（+ Eq 走 PartialEq），
        // 运行时无需为 IsInstance 补 StackObject 分支，减少改动面/风险。代价：`p is T` 的 p 不栈分配
        // （少量覆盖损失）。放宽 = 运行时补 IsInstance 的栈对象分支后移除本行。
        if (ins is IsInstanceInstr)  { IsInstanceInstr i = ins as IsInstanceInstr; IrEscapeAnalysis._mark(esc, i.Obj); return; }
        // Convert.Src：标 ESCAPE **有意收窄运行时触达面**——引用类型的恒等 convert（如 `(int[])arr`
        // / `(object)o` 的 identity 分支）会到 `convert_value`，那里只 match `Value::Array/Object` 不认
        // 栈变体 → 若栈句柄流到即 bail。数值 convert 的操作数是基元（标了也无害，基元不栈分配）。故此
        // 栈句柄只会经历 FieldGet/FieldSet/ArrayGet/Set/Len（+ Eq 走 PartialEq），运行时已全覆盖。
        if (ins is ConvertInstr)     { ConvertInstr i = ins as ConvertInstr; IrEscapeAnalysis._mark(esc, i.Src); return; }
        // 其余皆 neutral（不标）：Copy(Pass B) / FieldGet.Obj / ArrayGet / ArrayLen /
        //   算术·比较·位·移位·一元·StrConcat 的操作数（皆基元/字符串，引用不流入）/ ArrayNew.Size /
        //   Const* / StaticGet / LoadFn / Typeof / DefaultOf —— 均消费值或读自身，不泄露引用。
    }

    // 终结子：返回值 / throw 值逃逸；BrCond.Cond（bool）、Br（无读）neutral。
    private static void _markTermEscaping(bool[] esc, IrTerminator t) {
        if (t is RetTerm)   { RetTerm r = t as RetTerm; if (r.HasReg) { IrEscapeAnalysis._mark(esc, r.Reg); } return; }
        if (t is ThrowTerm) { ThrowTerm th = t as ThrowTerm; IrEscapeAnalysis._mark(esc, th.Reg); return; }
    }

    // ── ctor this-泄漏单函数摘要（不递归）────────────────────────────────────────────────
    private bool _ctorLeaksThis(IrModule m, string ctorName) {
        int ci = 0;
        while (ci < this._ctorCacheCount) {
            if (this._ctorNames[ci] == ctorName) { return this._ctorLeaks[ci]; }
            ci = ci + 1;
        }
        bool leaks = IrEscapeAnalysis._computeCtorLeaks(m, ctorName);
        this._cachePut(ctorName, leaks);
        return leaks;
    }

    private static bool _computeCtorLeaks(IrModule m, string ctorName) {
        IrFunction f = IrEscapeAnalysis._findFunc(m, ctorName);
        if (f == null) { return true; }        // 跨包 / 找不到 ctor 体 → 保守判泄漏（不见即逃逸）。
        if (f.IsStatic) { return true; }        // ctor 无 this（不应发生）→ 保守。
        bool[] esc = IrEscapeAnalysis._computeEscaped(f);
        // this = reg 0（FunctionEmitter：Locals["this"] = TypedReg(0, Ref)）。
        if (0 < esc.Length) { return esc[0]; }
        return true;
    }

    // 按 FQ 名解析同模块函数（镜像 IrInline._findFunc）；找不到返回 null。
    private static IrFunction _findFunc(IrModule m, string name) {
        int i = 0;
        while (i < m.FuncCount) {
            if (m.Functions[i].Name == name) { return m.Functions[i]; }
            i = i + 1;
        }
        return null;
    }

    // ── 辅助 ─────────────────────────────────────────────────────────────────────────
    // 写计数（复用 IrOptInfo.AddDef 权威 Dst 枚举）。
    private static int[] _computeDefs(IrFunction f) {
        int[] defs = new int[f.MaxReg + 2];
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock b = f.Blocks[bi];
            int ii = 0;
            while (ii < b.InstrCount) { IrOptInfo.AddDef(defs, b.Instrs[ii]); ii = ii + 1; }
            bi = bi + 1;
        }
        return defs;
    }

    private static void _mark(bool[] esc, TypedReg r) {
        if (r.Id >= 0 && r.Id < esc.Length) { esc[r.Id] = true; }
    }
    private static void _markArgs(bool[] esc, TypedReg[] args, int count) {
        int i = 0;
        while (i < count) { IrEscapeAnalysis._mark(esc, args[i]); i = i + 1; }
    }

    private void _cachePut(string name, bool leaks) {
        if (this._ctorCacheCount == this._ctorNames.Length) {
            int ncap = this._ctorNames.Length * 2;
            if (ncap < 4) { ncap = 4; }
            string[] nn = new string[ncap];
            bool[]   nl = new bool[ncap];
            int i = 0;
            while (i < this._ctorCacheCount) { nn[i] = this._ctorNames[i]; nl[i] = this._ctorLeaks[i]; i = i + 1; }
            this._ctorNames = nn; this._ctorLeaks = nl;
        }
        this._ctorNames[this._ctorCacheCount] = name;
        this._ctorLeaks[this._ctorCacheCount] = leaks;
        this._ctorCacheCount = this._ctorCacheCount + 1;
    }
}
