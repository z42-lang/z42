// IrEscapeAnalysis —— 逃逸分析驱动的栈上分配（add-escape-analysis-stack-alloc）。
//
// 目标：证明某个 ObjNew / ArrayNew / ArrayNewLit 的结果**不逃逸创建它的函数帧**，据此置
// StackAlloc=true。interp 遇该标志在帧局部 arena 分配（绕过 GC，帧退出即释放；JIT 忽略、照常堆分配）。
//
// 设计（见 docs/book/src/runtime/escape-analysis-stack-alloc.md）：
//   - **流不敏感 may-escape 过近似（CFG-free）**：逃逸是「该 reg 的**任一**使用是否到达逃逸汇点」，
//     与控制流顺序无关的 may 问题 → 线性扫全函数即安全过近似，无需 CFG / 支配域（区别于 LICM）。
//   - **角色感知逃逸汇点规则表**（`_markEscaping`，可扩展核心）：逐指令按操作数**角色**分类——
//     escaping（返回 / 存字段·数组·静态的值 / throw / 闭包捕获 / ToString / as-cast 别名 / 取址）标记逃逸；
//     neutral（读自身字段·数组·长度 / is-check / 算术等消费值）跳过。
//     **安全底线（unify-ir-operand-access）**：规则表未显式列出的指令走保守兜底——经统一操作数接口把
//     全部读操作数标逃逸；neutral 指令必须显式登记。新增指令忘了登记 = 少一次栈分配机会，而非悬垂栈引用。
//   - **跨过程参数逃逸摘要**（add-crossproc-escape-summary）：`CallInstr`/`ObjNew` 的实参**不再一律逃逸**，
//     而是按 callee 的参数逃逸摘要（`IrEscapeSummary` 算的模块不动点 `ParamEscapeTable`）逐个判——callee
//     不让参数 i 逃逸 → 该实参不逃逸。无摘要（跨包/无体/VCall/CallIndirect/builtin/闭包）→ 保守全标。
//   - **copy 传递闭包**（Pass B 不动点）：`dst = copy src`，dst 逃逸 ⇒ src 逃逸。
//   - **对象额外前提：ctor 不泄漏 this**（= 摘要 `table[ctor][0]`，this=参数槽 0；原 `_ctorLeaksThis` 并入此）。
//   - **仅标单赋值 temp**（defs==1）：多定义命名局部保守不标。
namespace Z42.Semantics;

using Z42.IR;

public sealed class IrEscapeAnalysis {

    // 模块级入口：先算跨过程参数逃逸摘要（模块不动点），再逐函数用摘要标不逃逸分配。
    public static void Run(IrModule m) {
        ParamEscapeTable table = IrEscapeSummary.Compute(m);
        int fi = 0;
        while (fi < m.FuncCount) {
            IrEscapeAnalysis._markFunc(m, m.Functions[fi], table);
            fi = fi + 1;
        }
    }

    // 对一个函数：算逃逸集（用摘要解析 call 实参）+ 单赋值集，给不逃逸的分配置 StackAlloc。
    private static void _markFunc(IrModule m, IrFunction f, ParamEscapeTable table) {
        bool[] esc  = IrEscapeAnalysis.ComputeEscapedRegs(m, f, table);
        int[]  defs = IrRegCounts.Defs(f);
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock b = f.Blocks[bi];
            int ii = 0;
            while (ii < b.InstrCount) {
                IrInstr ins = b.Instrs[ii];
                if (ins is ArrayNewInstr) {
                    ArrayNewInstr a = ins as ArrayNewInstr;
                    if (IrEscapeAnalysis._ok(esc, defs, a.Dst.Id)) { a.StackAlloc = true; }
                }
                if (ins is ArrayNewLitInstr) {
                    ArrayNewLitInstr a = ins as ArrayNewLitInstr;
                    if (IrEscapeAnalysis._ok(esc, defs, a.Dst.Id)) { a.StackAlloc = true; }
                }
                if (ins is ObjNewInstr) {
                    ObjNewInstr o = ins as ObjNewInstr;
                    if (IrEscapeAnalysis._ok(esc, defs, o.Dst.Id)
                        && !IrEscapeAnalysis._ctorThisEscapes(m, table, o.CtorName)) {
                        o.StackAlloc = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }

    // 合格：单赋值 temp 且不逃逸。
    private static bool _ok(bool[] esc, int[] defs, int id) {
        if (id < 0 || id >= esc.Length || id >= defs.Length) { return false; }
        return (!esc[id]) && defs[id] == 1;
    }

    // ── 逃逸集：Pass A 直接汇点（吃摘要）+ Pass B copy 传递闭包 ──────────────────────────
    // public：IrEscapeSummary.Compute 的不动点每轮对每函数调它（用当前摘要），_markFunc 用收敛后摘要再调一次。
    public static bool[] ComputeEscapedRegs(IrModule m, IrFunction f, ParamEscapeTable table) {
        int n = f.MaxReg + 2;
        bool[] esc = new bool[n];
        // Pass A：逐指令 / 终结子标记 escaping-角色操作数。
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock b = f.Blocks[bi];
            int ii = 0;
            while (ii < b.InstrCount) {
                IrEscapeAnalysis._markEscaping(m, table, esc, b.Instrs[ii]);
                ii = ii + 1;
            }
            if (b.HasTerm) { IrEscapeAnalysis._markTermEscaping(esc, b.Term); }
            bi = bi + 1;
        }
        // Pass B：copy 传递闭包 —— dst 逃逸 ⇒ src 逃逸（链式，跑到不动点）。
        bool changed = true;
        while (changed) {
            changed = false;
            bi = 0;
            while (bi < f.BlockCount) {
                IrBlock b = f.Blocks[bi];
                int ii = 0;
                while (ii < b.InstrCount) {
                    if (b.Instrs[ii] is CopyInstr) {
                        CopyInstr c = b.Instrs[ii] as CopyInstr;
                        int d = c.Dst.Id; int s = c.Src.Id;
                        if (d >= 0 && d < n && s >= 0 && s < n && esc[d] && (!esc[s])) {
                            esc[s] = true; changed = true;
                        }
                    }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
        }
        return esc;
    }

    // 逃逸汇点规则表（可扩展核心）——逐指令按操作数**角色**分类：escaping 标记、neutral 跳过。
    // 顺序即优先级：① 有摘要的静态调用 → ② 显式 neutral 白名单 → ③ 部分汇点（只标特定角色）→
    // ④ 兜底：**全部读操作数逃逸**（统一操作数接口 ReadAt；覆盖无摘要调用 / 存储 / 别名 / 未来新增指令）。
    private static void _markEscaping(IrModule m, ParamEscapeTable table, bool[] esc, IrInstr ins) {
        // ① 静态直接调用：实参**按 callee 摘要**逐个判（args[i]→callee 参数槽 i）。无摘要→全标。
        if (ins is CallInstr)        { CallInstr i = ins as CallInstr; IrEscapeAnalysis._markCallArgs(m, table, esc, i.Func, i.Args, i.ArgCount, 0); return; }
        // ObjNew：实参是 ctor 实参**不含 this**（运行时前置）→ args[i]→ctor 参数槽 i+1。无摘要→全标。
        if (ins is ObjNewInstr)      { ObjNewInstr i = ins as ObjNewInstr; IrEscapeAnalysis._markCallArgs(m, table, esc, i.CtorName, i.Args, i.ArgCount, 1); return; }
        // ② 显式 neutral（消费值但不让其逃逸）：copy（Pass B 传递闭包处理）/ 读自身字段·数组·长度 /
        //    二元算术·比较·位·移位·串拼接 / 一元 neg·not·bit_not / ArrayNew.Size / struct 句柄操作数
        //    （StructRef 非 ObjNew 逃逸候选）。仅定义 Dst 的指令（Const*/StaticGet/LoadFn/Typeof/DefaultOf/
        //    MethodTypeArg/MethodDefault/StructAlloc）无读操作数，兜底自然不标。
        if (ins is CopyInstr || ins is IrBinInstr || ins is NegInstr || ins is NotInstr || ins is BitNotInstr
            || ins is FieldGetInstr || ins is ArrayGetInstr || ins is ArrayLenInstr || ins is ArrayNewInstr
            || ins is StructCopyInstr || ins is StructFieldGetPrimInstr) { return; }
        // ③ 部分汇点：被存进对象/数组/struct blob 的**值**逃逸；target/array/index/base 是 neutral
        //    （StructFieldSetPrim 对称 FieldSet——含引用叶子时防止存进 struct 的对象被误栈分配→悬垂）。
        if (ins is FieldSetInstr)          { IrEscapeAnalysis._mark(esc, (ins as FieldSetInstr).Val); return; }
        if (ins is ArraySetInstr)          { IrEscapeAnalysis._mark(esc, (ins as ArraySetInstr).Val); return; }
        if (ins is StructFieldSetPrimInstr){ IrEscapeAnalysis._mark(esc, (ins as StructFieldSetPrimInstr).Val); return; }
        // ④ 兜底：全部读操作数逃逸。覆盖——无可靠摘要的调用形式（Builtin / CallNative / VCall 动态派发 /
        //    CallIndirect）、MkClos 闭包捕获、ArrayNewLit 元素、StaticSet 值、AsCast 别名、ToStr 调 ToString(this)、
        //    LoadLocalAddr 取址泄漏；IsInstance.Obj / Convert.Src 标 ESCAPE **有意收窄运行时触达面**（非逃逸语义
        //    所需，见 escape-analysis book「运行时触达面」；放宽需运行时补 StackObject 分支）；以及未来新增指令。
        int n = ins.ReadCount();
        int k = 0;
        while (k < n) { IrEscapeAnalysis._mark(esc, ins.ReadAt(k)); k = k + 1; }
    }

    // 静态调用/ObjNew 的实参按 callee 摘要标逃逸。paramOffset：CallInstr=0（args[i]→槽 i）、ObjNew=1（→槽 i+1）。
    // callee 找不到 / 无体 / Lookup=null（跨包）/ 实参越出摘要长度（varargs）→ 该实参**保守标逃逸**。
    private static void _markCallArgs(IrModule m, ParamEscapeTable table, bool[] esc,
                                      string calleeName, TypedReg[] args, int argCount, int paramOffset) {
        bool[] pe = null;
        IrFunction callee = IrEscapeAnalysis._findFunc(m, calleeName);
        if (callee != null && callee.BlockCount > 0) { pe = table.Lookup(calleeName); }
        int i = 0;
        while (i < argCount) {
            int slot = i + paramOffset;
            bool leaks = true;   // 默认保守
            if (pe != null && slot >= 0 && slot < pe.Length) { leaks = pe[slot]; }
            if (leaks) { IrEscapeAnalysis._mark(esc, args[i]); }
            i = i + 1;
        }
    }

    // 对象合格前提：ctor 不泄漏 this（= 摘要参数槽 0）。跨包/无体/静态(无 this)/无摘要 → 保守判泄漏。
    private static bool _ctorThisEscapes(IrModule m, ParamEscapeTable table, string ctorName) {
        IrFunction ctor = IrEscapeAnalysis._findFunc(m, ctorName);
        if (ctor == null || ctor.BlockCount == 0 || ctor.IsStatic) { return true; }
        bool[] pe = table.Lookup(ctorName);
        if (pe == null || pe.Length == 0) { return true; }
        return pe[0];
    }

    // 终结子：返回值 / throw 值逃逸；BrCond.Cond（bool）、Br（无读）neutral。
    private static void _markTermEscaping(bool[] esc, IrTerminator t) {
        if (t is RetTerm)   { RetTerm r = t as RetTerm; if (r.HasReg) { IrEscapeAnalysis._mark(esc, r.Reg); } return; }
        if (t is ThrowTerm) { ThrowTerm th = t as ThrowTerm; IrEscapeAnalysis._mark(esc, th.Reg); return; }
    }

    // 按 FQ 名解析同模块函数（镜像 IrInline._findFunc）；找不到返回 null。
    private static IrFunction _findFunc(IrModule m, string name) {
        int i = 0;
        while (i < m.FuncCount) {
            if (m.Functions[i].Name == name) { return m.Functions[i]; }
            i = i + 1;
        }
        return null;
    }

    private static void _mark(bool[] esc, TypedReg r) {
        if (r.Id >= 0 && r.Id < esc.Length) { esc[r.Id] = true; }
    }
}
