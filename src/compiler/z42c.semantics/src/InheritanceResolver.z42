// 符号收集基链解析簇：从 SymbolCollector 分出。override regKey 对齐 + sealed 强制 + 继承字段合并
// + impl-block 合并——均在成员填充后跑、依赖 base 链遍历。共享辅助 + 编排入口留 hub，经 _sc 委回。
namespace Z42.Semantics;
using Z42.IR;
using Z42.Syntax;
using Z42.Core;

public sealed class InheritanceResolver {
    private SymbolCollector _sc;   // hub 反向引用：共享辅助 + partial 状态 + 编排
    public InheritanceResolver(SymbolCollector sc) { this._sc = sc; }

    // impl-block 收集（port-z42c-impl-block，镜像 C# CollectImpls）：
    // 解析 target（NamedType→已注册类）+ trait（接口名）→ 把方法并入 target.Methods、
    // trait 并入 target.InterfaceNames。
    // 接口成员齐备性校验分两条路：**声明接口**（`class C : I`）由 `_checkIfaceMembersComplete`
    // 在 `_passSealedEnforce` 内走 AST `c.Bases` 校验；**impl 块接口**（`impl I for C`）不在
    // `c.Bases` 里、由本 pass 并进 `InterfaceNames`，故其齐备性由独立的 `_passImplIfaceComplete`
    // 在本 pass **之后**校验（fix-iface-self-completeness-gaps A2）。两条路互不重叠、各查各的。
    internal void _passImpls(SymbolTable table, CompilationUnit cu) {
        table.CurrentAliases = SymbolTable.BuildAliases(cu);   // add-type-alias
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = cu.Decls[i];
            if (d is ImplDecl) {
                ImplDecl implD = d as ImplDecl;
                string targetName = "";
                if (implD.TargetType is NamedType) { targetName = (implD.TargetType as NamedType).Name; }
                if (targetName != "" && table.HasClass(targetName)) {
                    Z42ClassType target = table.GetClass(targetName);
                    string traitName = "";
                    if (implD.TraitType is NamedType) { traitName = (implD.TraitType as NamedType).Name; }
                    if (traitName != "") { target.AddInterfaceName(traitName); }
                    int m = 0;
                    while (m < implD.MethodCount) {
                        if (implD.Methods[m] is MethodDecl) {
                            MethodDecl md = implD.Methods[m] as MethodDecl;
                            // unify-regkey-source-of-truth：走单一注册入口。此处原先只 Put、
                            // **不写 md.RegKey** —— impl-block 方法的 RegKey 因此恒为空串，
                            // 逼得所有消费点挂「退回裸名」兜底。键仍是裸 md.Name（impl 方法不参与
                            // primary/非-primary），与兜底算出的值逐字相同 → 字节中性。
                            SymbolCollector.RegisterMethod(target, md,
                                this._sc._methodSymbol(table, md, targetName, new string[0], 0), md.Name);
                            target.AddOwnMethod(md.Name, this._sc._hasWord(md.Mods, "virtual"), false);
                        }
                        m = m + 1;
                    }
                }
            }
            i = i + 1;
        }
    }

    // fix-iface-self-completeness-gaps A2：impl 块（`impl Trait for Target`）补的接口，其成员齐备性
    // 此前**从不校验**——`_checkIfaceMembersComplete`（`_passSealedEnforce` 内、走 AST `c.Bases`）看不到
    // impl 块给的接口：trait 由 `_passImpls` 并进 `ct.InterfaceNames`，而这些接口根本不在 target 的
    // `c.Bases` 里。⇒ `impl I for C {}`（空/缺成员）被静默接受，等同没实现却编得过（真洞）。
    // 本 pass 必须在 `_passImpls`（并 trait + impl 方法入 target.Methods）**之后**跑：迭代每个 ImplDecl、
    // 按 trait 名解析接口、复用 `_checkOneIfaceMembers` 校验 target 是否补齐其成员（含 static/返回/可见性，
    // 与声明接口同一口径）。声明接口路径（`c.Bases`）不经过这里、行为逐字不变——本 pass 纯**追加** impl
    // 块覆盖，两条路互不重叠、无双报。跨包（导入）接口的 kind/可见性/返回在 `_checkOneIfaceMethod` 里
    // 与本包接口**同样校验**（fix-imported-iface-static-fidelity 后：static 位由 zbc 1.41 wire 承载、
    // 可见性查本地实现方——均可靠，原 `it.IsImported` 早退守卫已删）。
    // 泛型 impl trait（`impl IFoo<int> for C`）此处只按裸名解析——与 `_passImpls` 自身一致（它也只处理
    // `TraitType is NamedType`），类型实参匹配是跨包/泛型接口约束的独立议题，不在本 change。
    internal void _passImplIfaceComplete(SymbolTable table, CompilationUnit cu) {
        table.CurrentAliases = SymbolTable.BuildAliases(cu);   // add-type-alias（与 _passImpls 同）
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = cu.Decls[i];
            if (d is ImplDecl) {
                ImplDecl implD = d as ImplDecl;
                if (implD.TargetType is NamedType && implD.TraitType is NamedType) {
                    string targetName = (implD.TargetType as NamedType).Name;
                    string traitName = (implD.TraitType as NamedType).Name;
                    if (targetName != "" && traitName != "" && table.HasClass(targetName)) {
                        Z42ClassType ct = table.GetClass(targetName);
                        Z42InterfaceType it = table.GetInterface(traitName);
                        if (ct != null && it != null) {
                            this._checkOneIfaceMembers(table, ct, targetName, implD.Span, it);
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // 继承字段合并（_passMembers 后）：把基类链上的实例字段并入派生类 Fields（own-wins，跳 static）。
    // Z42ClassType.Fields 供 binder env（裸 ident → 字段类型）+ FunctionEmitter（裸 ident → field_get reg0）
    // 读取；此前仅含自有字段 → 派生类裸访问继承字段（`name = n`）解析失败 → 写入幻影局部 → 运行期 null。
    // _classDesc 用 AST c.Members 发 TYPE 段字段，不读此表 → 合并不污染字段布局。
    internal void _passInheritFields(SymbolTable table, CompilationUnit cu) {
        table.CurrentAliases = SymbolTable.BuildAliases(cu);   // add-type-alias
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct") {
                    string ctKey = c.Name;
                    if (c.TypeParams.Count > 0) { string mk = c.Name + "$" + c.TypeParams.Count.ToString(); if (table.Classes.ContainsKey(mk)) { ctKey = mk; } }
                    Z42ClassType ct = table.Classes.Get(ctKey) as Z42ClassType;
                    if (ct != null) {
                        Z42ClassType cur = ct;
                        // fix-inherited-typeparam-field-type：`curInst` = **把 `cur` 看成从 `ct` 出发
                        // 实例化出来的样子**。ct 自身是定义（其型参就是它自己的），故起点为 null。
                        // 每上一层就把「本层写给基类的实参」与已积累的代换**组合**一次
                        // ⇒ 任意深度的 `Deep : DInt : GBox<int>` 都能把 `T` 换到底。
                        // 组合手法照 `InterfaceClosure.BaseAt`（那边是接口侧的同一件事）。
                        Z42InstantiatedType curInst = null;
                        int depth = 0;
                        while (cur != null && cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName) && depth < 32) {
                            Z42ClassType baseCt = table.Classes.Get(cur.BaseName) as Z42ClassType;
                            if (baseCt == null) { cur = null; }
                            else {
                                Z42InstantiatedType baseInst = this._baseInstOf(table, cur, curInst);
                                string[] bfns = baseCt.Fields.Keys();
                                int k = 0;
                                while (k < bfns.Length) {
                                    FieldSymbol bfs = baseCt.Fields.Get(bfns[k]) as FieldSymbol;
                                    if (bfs != null && !bfs.IsStatic && !ct.Fields.ContainsKey(bfns[k])) {
                                        ct.Fields.Put(bfns[k], this._substField(bfs, baseInst));
                                    }
                                    k = k + 1;
                                }
                                curInst = baseInst;
                                cur = baseCt;
                                depth = depth + 1;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // `cur` 写给它基类的实参，**换算到 ct 的视角**；没写实参 / 解析不出泛型实例化 → null（不代换）。
    //
    // ⚠️ 判「有没有实参」用 AST 的 `ArgCount`，**不用** `baseCt.GenericParamCount` ——
    // 后者只说基类是泛型定义，说不了这一处**写没写**实参（`class D : GBox` 也命中它）。
    // 这条坑接口侧已经记过一次（`InterfaceClosure.BaseAt` 抬头）。
    private Z42InstantiatedType _baseInstOf(SymbolTable table, Z42ClassType cur, Z42InstantiatedType curInst) {
        TypeExpr bref = cur.BaseRef;
        if (bref == null) { return null; }
        if (bref is NamedType) { if ((bref as NamedType).ArgCount == 0) { return null; } }
        // 在 `cur` **自己的型参上下文**里解析：`class Sub<U> : GBox<U>` 的 `U` 要认成 Sub 的型参，
        // 否则它会解析成一个不存在的类型。
        Z42Type bt = table.ResolveTypeP(bref, cur.GenericParamNames, cur.GenericParamCount);
        if (!(bt is Z42InstantiatedType)) { return null; }
        Z42InstantiatedType bi = bt as Z42InstantiatedType;
        // 组合：`cur` 本身已经是被实例化看待的（`Deep : DInt : GBox<int>` 走到第二层时），
        // 就把它的实参代进去 —— `_substGeneric` 对 Z42InstantiatedType 正是逐实参递归。
        if (curInst != null) {
            Z42Type composed = MemberResolver._substGeneric(bi, curInst);
            if (composed is Z42InstantiatedType) { bi = composed as Z42InstantiatedType; }
        }
        return bi;
    }

    // 基类字段搬进派生类时按 `baseInst` 代换字段类型。**必须产出新的 FieldSymbol** ——
    // 原对象被基类的 Fields 表共享，就地改会把基类自己的字段类型也改掉
    //（`GBox<int>` 与 `GBox<string>` 两个派生类会互相污染）。
    //
    // 不代换就原样返回同一个对象（零额外分配，且保持既有行为不劣化）：
    // 无实参 / 代换后是 Unknown（形参名不在基类形参表里，例如种子旧 TSIG 没带 GenericParamNames）
    // ⇒ 宁可留着原类型，也不要把它降成 Unknown。
    private FieldSymbol _substField(FieldSymbol bfs, Z42InstantiatedType baseInst) {
        if (baseInst == null) { return bfs; }
        Z42Type ft = MemberResolver._substGeneric(bfs.FieldType, baseInst);
        if (ft == null || ft is Z42UnknownType) { return bfs; }
        if (ft.Name() == bfs.FieldType.Name()) { return bfs; }
        FieldSymbol ns = new FieldSymbol(bfs.Name, bfs.Visibility, ft, bfs.IsStatic, bfs.ContainingTypeName);
        ns.IsReadonly = bfs.IsReadonly;
        ns.IsConst = bfs.IsConst; ns.ConstVal = bfs.ConstVal;
        ns.IsDeprecated = bfs.IsDeprecated; ns.DeprecationMsg = bfs.DeprecationMsg;
        ns.SetterVis = bfs.SetterVis;
        ns.IsNullable = bfs.IsNullable;   // define-null-check-marks：`?` 标记跟着字段走
        return ns;
    }

    // add-type-based-overloads D7（阶段 8 修复，2026-07-01）：override 方法 regKey 对齐。
    //
    // 根因：_fillClass 的 mangle 决策（wantMangle）只看**当前类自身**的 arityDup——若 Base 声明两个
    // 同 arity 重载（如 Handle(int)/Handle(string)）会 mangle 出 Handle$1$i32/Handle$1$string；但
    // Derived 若只 override 其中一个，Derived 本地只有一个 Handle（arityDup=1）→ 不 mangle → 注册成裸
    // 名 "Handle"。VM 侧 vtable 合并（TypeDesc::derive_simple_method_name / merge_with_base）按 regKey
    // 字符串裸匹配 slot——两端 regKey 不一致 ⟹ Derived 的 override 落进一个**新**槽位，Base 的
    // Handle$1$i32 槽位原样保留 ⟹ 虚派发仍打到 Base 实现（override 语义失效）。
    //
    // 修复：override 方法必须复用"最初声明该虚方法"的那层（非 override 的 virtual 声明，或 imported
    // 基类——无 AST Decl 视为终点）所采用的 regKey，而非依本地 arityDup 独立决策。走 AST Decl.Mods 逐层
    // 上溯（而非依赖 baseCt.Methods 是否已被本 pass 修正），使结果与 _fillClass 的跨 CU 处理顺序无关。
    internal void _passFixupOverrides(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct") {
                    string ctKey = c.Name;
                    if (c.TypeParams.Count > 0) { string mk = c.Name + "$" + c.TypeParams.Count.ToString(); if (table.Classes.ContainsKey(mk)) { ctKey = mk; } }
                    Z42ClassType ct = table.Classes.Get(ctKey) as Z42ClassType;
                    if (ct != null && ct.HasBase) {
                        int j = 0;
                        while (j < c.MemberCount) {
                            Decl mem = this._sc._unwrap(c.Members[j]);
                            if (mem is MethodDecl) {
                                MethodDecl md = mem as MethodDecl;
                                // impl-sealed-semantics-devirt：方法 `sealed`（简写）等价 `sealed override`，
                                // 同样参与 regKey 槽对齐（否则 override 落新槽、虚派发打不到基实现）。
                                if (this._sc._hasWord(md.Mods, "override") || this._sc._hasWord(md.Mods, "sealed")) {
                                    MethodSymbol localSym = ct.Methods.Get(md.RegKey) as MethodSymbol;
                                    if (localSym != null) {
                                        MethodSymbol origin = this._findVirtualOrigin(table, ct,
                                            localSym.Name, localSym.Signature.ParamTypes, localSym.Signature.ParamCount);
                                        if (origin != null && origin.RegKey != md.RegKey) {
                                            localSym.RegKey = origin.RegKey;
                                            md.RegKey = origin.RegKey;
                                            ct.Methods.Put(origin.RegKey, localSym);   // 旧裸键留存亦无害——
                                            // OverloadsOf 按 Name 收集，_collectOverloads 再按 RegKey 去重，
                                            // 两键指向同一（已改写 RegKey 的）对象时天然合并为一个候选。
                                        }
                                    }
                                }
                            }
                            j = j + 1;
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // 沿 base 链逐层上溯，找到（name, paramTypes）对应虚方法**最初**（非 override）声明所在层的
    // MethodSymbol，返回其 RegKey 作为权威键。imported 基类方法无 AST Decl（HasDecl=false）→ 视为终点
    // （其 RegKey 即该 imported 包编译时已定案的键，无需也无法继续上溯）。全链找不到匹配 → 返回 null
    // （不改写，保留 _fillClass 的本地决策——理论上不应发生，`override` 必然对应某个虚方法声明）。
    private MethodSymbol _findVirtualOrigin(SymbolTable table, Z42ClassType ct, string name, Z42Type[] paramTypes, int paramCount) {
        string wantCanon = OverloadResolver.MangleKey(name, paramTypes, paramCount);
        Z42ClassType cur = ct;
        MethodSymbol lastMatch = null;
        bool more = cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName);
        while (more) {
            Z42ClassType baseCt = table.Classes.Get(cur.BaseName) as Z42ClassType;
            if (baseCt == null) {
                more = false;
            } else {
                MethodSymbol matchHere = null;
                string[] keys = baseCt.Methods.Keys();
                int k = 0;
                while (k < keys.Length) {
                    MethodSymbol sym = baseCt.Methods.Get(keys[k]) as MethodSymbol;
                    if (sym != null && sym.Name == name) {
                        string symCanon = OverloadResolver.MangleKey(sym.Name, sym.Signature.ParamTypes, sym.Signature.ParamCount);
                        if (symCanon == wantCanon) { matchHere = sym; }
                    }
                    k = k + 1;
                }
                if (matchHere != null) {
                    lastMatch = matchHere;
                    // impl-sealed-semantics-devirt：中间层 `sealed`（简写）也是 override → 继续上溯找最初声明。
                    bool matchIsOverride = matchHere.HasDecl && matchHere.Decl != null && (this._sc._hasWord(matchHere.Decl.Mods, "override") || this._sc._hasWord(matchHere.Decl.Mods, "sealed"));
                    if (!matchIsOverride) { more = false; }
                    else { cur = baseCt; more = cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName); }
                } else {
                    cur = baseCt; more = cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName);
                }
            }
        }
        return lastMatch;
    }

    // impl-sealed-semantics-devirt：sealed 语义强制。三项检查（本地 + 跨包，跨包 sealed 性由
    // ImportedSymbolLoader 从 CLASS_FLAG_SEALED / METHOD_FLAG_SEALED 还原）：
    //   ① 继承 sealed 类 → E0416
    //   ② 方法级 sealed（含简写）无匹配基类 virtual → E0418（封死一个非 override 方法无意义）
    //   ③ override（含 sealed 简写）一个 sealed 基方法 → E0417
    // 在 _passFixupOverrides 之后运行（regKey/签名已定案），复用 _findVirtualOrigin 的按签名上溯匹配。
    internal void _passSealedEnforce(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct") {
                    string ctKey = c.Name;
                    if (c.TypeParams.Count > 0) { string mk = c.Name + "$" + c.TypeParams.Count.ToString(); if (table.Classes.ContainsKey(mk)) { ctKey = mk; } }
                    Z42ClassType ct = table.Classes.Get(ctKey) as Z42ClassType;
                    if (ct != null) {
                        // ⑤ add-associated-types PR-3：实现了带关联类型的接口，就必须把每个关联类型
                        //    绑上。**放在这个 pass 里**是因为它要求「接口的 `type Item;` 已收集完」——
                        //    `_fillInterface` 与 `_fillClass` 在同一个 `_passMembers` 循环里，声明序 /
                        //    跨 CU 都不保证接口先到，故不能在 `_fillClass` 末尾就地查。本 pass 在成员
                        //    填充全部结束后跑，且三条入口路径（单文件 / 包级 / deps）都调它。
                        this._checkAssocBindingsComplete(table, ct, c);
                        // ⑥ add-interface-satisfaction-check：实现接口就必须**补齐其成员**（名字在 +
                        //    签名匹配）。与 ⑤ 同一时机、同一理由（要求接口成员已收集完）。
                        this._checkIfaceMembersComplete(table, ct, c);
                        // ① 继承 sealed 类
                        if (ct.HasBase && ct.BaseName != "" && table.Classes.ContainsKey(ct.BaseName)) {
                            Z42ClassType baseCt = table.Classes.Get(ct.BaseName) as Z42ClassType;
                            if (baseCt != null && baseCt.IsSealed) {
                                this._sc.Diags.Error(DiagnosticCodes.SealedInheritance,
                                    "cannot inherit from sealed class `" + ct.BaseName + "`", c.Span);
                            }
                        }
                        // ④ static-class 强制（fix-static-class-instance-members）：static 类只容纳静态成员，
                        //   不得声明基类 / 实现接口 / 含实例成员（对标 C# CS0708/0710/0713/0714）。
                        //   `static` 仅对 `class` 有意义（struct 无 static 变体）。
                        bool clsStatic = c.Kind == "class" && this._sc._hasWord(c.Mods, "static");
                        if (clsStatic) {
                            if (ct.HasBase && ct.BaseName != "") {
                                this._sc.Diags.Error(DiagnosticCodes.StaticClassInstanceMember,
                                    "static class `" + c.Name + "` cannot have a base class", c.Span);
                            }
                            if (ct.InterfaceCount > 0) {
                                this._sc.Diags.Error(DiagnosticCodes.StaticClassInstanceMember,
                                    "static class `" + c.Name + "` cannot implement interfaces", c.Span);
                            }
                        }
                        // ②③ 逐方法；④ static 类的实例成员（与上同 change）
                        int j = 0;
                        while (j < c.MemberCount) {
                            Decl mem = this._sc._unwrap(c.Members[j]);
                            if (clsStatic) { this._checkStaticClassMember(c.Name, mem); }
                            if (mem is MethodDecl) {
                                MethodDecl md = mem as MethodDecl;
                                if (!md.IsCtor) {
                                    bool mSealed = this._sc._hasWord(md.Mods, "sealed");
                                    bool mOverride = this._sc._hasWord(md.Mods, "override") || mSealed;
                                    if (mSealed || mOverride) {
                                        MethodSymbol localSym = ct.Methods.Get(md.RegKey) as MethodSymbol;
                                        if (localSym != null) {
                                            MethodSymbol near = this._nearestBaseMethod(table, ct,
                                                localSym.Name, localSym.Signature.ParamTypes, localSym.Signature.ParamCount);
                                            // ② sealed 无基类 virtual
                                            if (mSealed && near == null) {
                                                this._sc.Diags.Error(DiagnosticCodes.SealedMethodNoBase,
                                                    "sealed method `" + localSym.Name + "` must override a base virtual method", md.Span);
                                            }
                                            // ③ override 一个 sealed 基方法（含 sealed 简写覆盖 sealed）
                                            if (near != null && near.IsSealed) {
                                                this._sc.Diags.Error(DiagnosticCodes.SealedOverride,
                                                    "cannot override sealed method `" + localSym.Name + "`", md.Span);
                                            }
                                            // define-null-check-marks D7：`?` 方向一致性（见 _checkNullableDirection）。
                                            if (near != null) {
                                                this._checkNullableDirection("base method", ct.Name(),
                                                    near.Name, near, localSym, md.Span);
                                            }
                                        }
                                    }
                                }
                            }
                            j = j + 1;
                        }
                    }
                }
            }
            i = i + 1;
        }
        // add-iface-return-bridge：⑦ 把「需桥接」标记**沿基链下推**到子类的 override。
        // 必须在上面那个类循环**之后**——标记由 ⑥ 的满足性校验打在「声明接口的那个类」上，
        // 而类的处理顺序不保证基类先到。
        this._propagateBridgeMarks(table);
    }

    // 「需桥接」标记下推：子类 `override` 是**另一个** MethodSymbol、从不经过接口满足性校验，
    // 不下推就会出现「基类改名 + 基类桥接 + 子类覆盖仍占裸名且带 sret」⇒ 对子类实例走接口派发时
    // 同一个崩溃换个入口回来（实测：`Derived.Get … takes 2 physical argument(s), the call passes 1`）。
    //
    // 标记必须落在**符号**上而不是只在发射期上溯：`MethodSymbol.CallKey()`（调用点目标名的唯一
    // 出口）读的就是这个字段 —— 只修发射期会让「`Derived` 类型收者的直接调用」拿到裸名、打在桥接上。
    private void _propagateBridgeMarks(SymbolTable table) {
        string[] keys = table.Classes.Keys();
        int pass = 0;
        bool changed = true;
        // 迭代到不动点：一次遍历的类序不保证自上而下，A→B→C 三层可能要两轮才推到底。
        // 层数有限（`hops<32` 同款上限口径），pass 上限足够。
        while (changed && pass < 32) {
            changed = false;
            int i = 0;
            while (i < keys.Length) {
                Z42ClassType ct = table.Classes.Get(keys[i]) as Z42ClassType;
                if (ct != null && ct.HasBase && ct.BaseName != "" && table.Classes.ContainsKey(ct.BaseName)) {
                    Z42ClassType b = table.Classes.Get(ct.BaseName) as Z42ClassType;
                    if (b != null) {
                        string[] mk = ct.Methods.Keys();
                        int j = 0;
                        while (j < mk.Length) {
                            MethodSymbol dm = ct.Methods.Get(mk[j]) as MethodSymbol;
                            if (dm != null && dm.IfaceBridgeRet == "" && b.Methods.ContainsKey(mk[j])) {
                                MethodSymbol bm = b.Methods.Get(mk[j]) as MethodSymbol;
                                if (bm != null && bm.IfaceBridgeRet != "") {
                                    dm.IfaceBridgeRet = bm.IfaceBridgeRet;
                                    changed = true;
                                }
                            }
                            j = j + 1;
                        }
                    }
                }
                i = i + 1;
            }
            pass = pass + 1;
        }
    }

    // 沿 base 链找 (name, paramTypes) 的**最近**匹配 MethodSymbol（用于 sealed override 强制：最近的被
    // 覆盖方法若 sealed 即非法）。与 _findVirtualOrigin（找**最初**声明）互补：此处首个命中即返回。
    private MethodSymbol _nearestBaseMethod(SymbolTable table, Z42ClassType ct, string name, Z42Type[] paramTypes, int paramCount) {
        string wantCanon = OverloadResolver.MangleKey(name, paramTypes, paramCount);
        Z42ClassType cur = ct;
        bool more = cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName);
        while (more) {
            Z42ClassType baseCt = table.Classes.Get(cur.BaseName) as Z42ClassType;
            if (baseCt == null) { more = false; }
            else {
                string[] keys = baseCt.Methods.Keys();
                int k = 0;
                while (k < keys.Length) {
                    MethodSymbol sym = baseCt.Methods.Get(keys[k]) as MethodSymbol;
                    if (sym != null && sym.Name == name) {
                        string symCanon = OverloadResolver.MangleKey(sym.Name, sym.Signature.ParamTypes, sym.Signature.ParamCount);
                        if (symCanon == wantCanon) { return sym; }   // 最近命中即返回
                    }
                    k = k + 1;
                }
                cur = baseCt; more = cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName);
            }
        }
        return null;
    }

    // fix-static-class-instance-members：static 类的单个成员合法性——实例方法 / 实例字段 /
    // 实例属性 / 实例构造器 / 索引器均非法（static 类只容纳静态成员）。`const` 字段隐含静态（放行）；
    // 嵌套类型（class/struct/enum/interface）不是实例成员（不匹配下列 Decl 分支，天然放行）。
    // add-associated-types PR-3：`class C : IEnum` 且 IEnum 声明了 `type Item;` ⇒ C 必须写
    // `type Item = <某类型>;`。走接口继承闭包（`SymbolTable.Implements` 的同一份 BaseNames 链），
    // 因为父接口的关联类型同样要绑。
    //
    // ⚠️ 这是 z42 **第一条**「实现接口必须补齐某成员」的强制。今天没有接口方法齐备性校验
    // （`InheritanceResolver` 开头自陈「严格校验留待后续」），所以这条**不构成先例扩散**：
    // 它只管关联类型，因为关联类型不绑就根本无法参与约束匹配（不像方法缺失还能靠动态派发兜底）。
    // 零回归风险 —— 全仓今天没有任何 `type X;` 声明。
    private void _checkAssocBindingsComplete(SymbolTable table, Z42ClassType ct, ClassDecl c) {
        int i = 0;
        while (i < ct.InterfaceCount) {
            this._checkOneIfaceAssoc(table, ct, c, ct.InterfaceNames[i]);
            i = i + 1;
        }
    }

    private void _checkOneIfaceAssoc(SymbolTable table, Z42ClassType ct, ClassDecl c, string ifaceName) {
        Z42InterfaceType it = table.GetInterface(ifaceName);
        if (it == null) { return; }
        // assoc-type-crosspkg（zbc 1.42）：接口的 `AssocTypeNames` 现由 TYPE 统一 assoc 块跨包承载、
        // 导入侧 ImportedSymbolLoader.AddAssocType 恢复 ⇒ 删原 `if (it.IsImported) return;` 守卫。跨包实现方
        // 补齐强制现与本包一致：实现导入接口却漏绑其关联类型 → E0453（此前导入侧 AssocTypeCount 恒空空转）。
        int a = 0;
        while (a < it.AssocTypeCount) {
            if (ct.AssocBindingOf(it.AssocTypeNames[a]) == "") {
                this._sc.Diags.Error(DiagnosticCodes.AssocTypeBinding,
                    "`" + c.Name + "` implements `" + ifaceName + "` but does not bind associated type `"
                    + it.AssocTypeNames[a] + "` — add `type " + it.AssocTypeNames[a] + " = <type>;`", c.Span);
            }
            a = a + 1;
        }
        int b = 0;
        while (b < it.BaseCount) {   // 父接口的关联类型同样要绑
            this._checkOneIfaceAssoc(table, ct, c, it.BaseNames[b]);
            b = b + 1;
        }
    }

    // ── add-interface-satisfaction-check ─────────────────────────────────────────────
    // 「声明了接口就必须补齐其成员」。此前 z42 **完全不查**（本文件抬头自陈「严格校验留待后续」）：
    // `class C : I { }` 缺成员不报、签名与 `Self` 不符也不报，两者都静默通过。
    //
    // 走 **AST 的 `c.Bases`** 而不是 `ct.InterfaceNames`：后者在 `StubCollector` 把 `<...>` 剥成裸名
    // 存下，类型实参**丢了** ⇒ `class Foo<U> : IBasicCollection<U>` 无从知道接口的 `T` 绑到了 `U`，
    // 朴素比签名会误报。从 AST 重解析能拿回 `Z42InstantiatedInterfaceType.TypeArgs`。
    private void _checkIfaceMembersComplete(SymbolTable table, Z42ClassType ct, ClassDecl c) {
        int i = 0;
        while (i < c.BaseCount) {
            Z42Type bt = table.ResolveTypeP(c.Bases[i], c.TypeParams.Names, c.TypeParams.Count);
            if (bt is Z42InterfaceType) { this._checkOneIfaceMembers(table, ct, c.Name, c.Span, bt as Z42InterfaceType); }
            i = i + 1;
        }
    }

    // `cName`/`cSpan`（原来是 `ClassDecl c`）：错误定位用的实现方名字与位置。改用 name+span 是为了让
    // **impl 块路径**（`_passImplIfaceComplete`，实现方 decl 可能跨 CU、只有 `ImplDecl`）也能复用本组
    // 校验——声明接口路径照旧传 `c.Name`/`c.Span`，行为逐字不变（fix-iface-self-completeness-gaps A2）。
    private void _checkOneIfaceMembers(SymbolTable table, Z42ClassType ct, string cName, Span cSpan, Z42InterfaceType it) {
        string[] keys = it.Methods.Keys();
        int k = 0;
        while (k < keys.Length) {
            MethodSymbol ims = it.Methods.Get(keys[k]) as MethodSymbol;
            if (ims != null && ims.Signature != null) { this._checkOneIfaceMethod(table, ct, cName, cSpan, it, ims); }
            k = k + 1;
        }
        int b = 0;
        while (b < it.BaseCount) {   // 父接口的成员同样要补齐（与 ⑤ 的闭包同一条链）
            // `BaseAt` 而不是 `GetInterface(裸名)`：后者拿到的是**未实例化**的定义，`interface
            // ILeaf : IMid<int>` 上溯时 `IMid` 的 `T` 就永远换不掉 ⇒ 下方 `_substForIface` 拿 `T`
            // 去跟实现方的 `int` 比，E0412 误报（实现方**怎么写都过不了**）。
            Z42InterfaceType bit = InterfaceClosure.BaseAt(table, it, b);
            if (bit != null) { this._checkOneIfaceMembers(table, ct, cName, cSpan, bit); }
            b = b + 1;
        }
    }

    private void _checkOneIfaceMethod(SymbolTable table, Z42ClassType ct, string cName, Span cSpan, Z42InterfaceType it, MethodSymbol ims) {
        int pc = ims.Signature.ParamCount;
        Z42Type[] want = new Z42Type[pc];
        int p = 0;
        while (p < pc) { want[p] = this._substForIface(ims.Signature.ParamTypes[p], ct, it); p = p + 1; }
        string wantKey = OverloadResolver.MangleKey(ims.Name, want, pc);
        // fix-iface-satisfaction-gaps #1：MangleKey 不含返回类型 → 另算期望返回（Self→实现类，同形参替换）。
        Z42Type wantRet = this._substForIface(ims.Signature.Ret, ct, it);
        // **按名取全部重载**，不能 `Methods.Get(name)`：非-primary 重载登记在 mangled 键上
        // （如 `String` 的 `Equals(object?)` 占裸键、`Equals(string)` 占 `Equals$1$string`），
        // 按名索引会拿到错的那个 → 假阳性。沿 base 链上溯（继承来的实现同样算数）。
        Z42ClassType cur = ct;
        bool nameSeen = false;
        while (cur != null) {
            MethodSymbol[] cands = cur.OverloadsOf(ims.Name);
            int j = 0;
            while (j < cands.Length) {
                nameSeen = true;
                MethodSymbol cm = cands[j];
                if (cm.Signature != null
                    && OverloadResolver.MangleKey(cm.Name, cm.Signature.ParamTypes, cm.Signature.ParamCount) == wantKey) {
                    // fix-iface-satisfaction-gaps #1：MangleKey 命中=「名+形参」对上，但它**不含 static/返回类型**。
                    // 补两项校验，否则 static 接口成员被实现成 instance、或返回类型不符，都静默通过（真洞）。
                    //
                    // fix-imported-iface-static-fidelity（zbc 1.41）：接口方法 static 位现由 wire 承载
                    // （接口方法块 is_static:u8），`TsigReconcile` 用真值构造 ExportedMethodZ、导入侧
                    // `ImportedSymbolLoader` 的 `mz.IsStatic` 已恢复真值 ⇒ 删去原 `if (it.IsImported) return;`
                    // 临时守卫（#636 为绕开导入侧 IsStatic 恒 false 而加）。导入接口自此与本包接口一样接受完整
                    // static/可见性/返回校验：`struct Money : INumber` 的 `public static override`（cm.IsStatic=true）
                    // 与导入 `INumber.op_X`（ims.IsStatic 现=true）匹配放行；把 static 成员实现成 instance 才报。
                    if (cm.IsStatic != ims.IsStatic) {
                        string ik = "an instance method"; if (ims.IsStatic) { ik = "`static`"; }
                        string ck = "an instance method"; if (cm.IsStatic) { ck = "`static`"; }
                        this._sc.Diags.Error(DiagnosticCodes.InterfaceMismatch,
                            "`" + cName + "` implements `" + it.Name() + "` but `" + ims.Name
                            + "` is " + ik + " in the interface and " + ck + " here", cSpan);
                        return;
                    }
                    // fix-iface-satisfaction-gaps A1：接口成员是隐式 public 契约，实现方必须以 `public`
                    // 兑现——非 public 实现无法经接口静态类型调用，等同没实现（C# CS0535/CS0737 同判）。此前
                    // MangleKey 命中即放行、从不比 `Visibility` ⇒ `class C : I { private int M(){…} }` 静默通过
                    // （真洞，与 static/返回同族）。⚠️ 类成员**无修饰默认 private**（`SymbolCollector:385` 的
                    // `containing != ""` → "private"），故 `class C : I { int M(){…} }` 同样被拦——严格口径
                    // （User 裁决 2026-09-14），接口实现必须显式 public。查的是**本地实现方** `cm.Visibility`
                    // （跨包/本包都可靠），故导入接口同样校验（fix-imported-iface-static-fidelity 删守卫后）。
                    if (cm.Visibility != "public") {
                        this._sc.Diags.Error(DiagnosticCodes.InterfaceMismatch,
                            "`" + cName + "` implements `" + it.Name() + "` but `" + ims.Name
                            + "` must be implemented `public` (it is `" + cm.Visibility + "` here)", cSpan);
                        return;
                    }
                    // 返回类型：协变允许（impl.Ret is-a 接口声明的 Ret）。Unknown/Error（含导入未解析返回）
                    // 吸收放行；精确名相等放行；类**子类** / 接口**实现**均算兼容。⚠️ `IsAssignableTo` 不带
                    // 符号表、认不了子类关系，必须用 `table.IsSubclassOf` / `table.Implements`（同 _satisfiesBase）。
                    Z42Type implRet = cm.Signature.Ret;
                    // ① **同类型** = `TypeKey` 归一相等（与 MangleKey 比形参同一口径：`String[]≡string[]`、
                    //    `Int32≡int`、数组叶子 keyword 化）——不能用 `IsAssignableTo`（它会放行数值拓宽
                    //    `int→long` 这类返回类型真不同的情形，且对 `String[]` vs `string[]` 反而认不出）。
                    // ② **协变** = impl 返回是接口声明返回的子类 / 接口实现（用 table，IsAssignableTo 无符号表认不了）。
                    bool retOk = (implRet is Z42UnknownType) || (implRet is Z42ErrorType)
                              || (wantRet is Z42UnknownType) || (wantRet is Z42ErrorType)
                              || OverloadResolver.TypeKey(implRet) == OverloadResolver.TypeKey(wantRet);
                    if (!retOk && ((implRet is Z42ClassType) || (implRet is Z42InstantiatedType))) {
                        string implName = implRet.Name();
                        if (implRet is Z42InstantiatedType) { implName = (implRet as Z42InstantiatedType).Def.Name(); }
                        retOk = table.IsSubclassOf(implName, wantRet.Name()) || table.Implements(implName, wantRet.Name());
                    }
                    // interface-assignability：实现方返回**接口**时的协变。上面那格的守卫只认
                    // class / instantiated ⇒ 接口整个被排除在外：接口声明 `IBase Make()`、实现写
                    // `IDerived Make()`（C# 里成立的返回协变）此前一律 E0412，实现方**怎么写都过不了**。
                    if (!retOk && (implRet is Z42InterfaceType) && (wantRet is Z42InterfaceType)) {
                        retOk = InterfaceClosure.IsInterfaceSubtype(table, implRet as Z42InterfaceType, wantRet as Z42InterfaceType);
                    }
                    if (!retOk) {
                        this._sc.Diags.Error(DiagnosticCodes.InterfaceMismatch,
                            "`" + cName + "` implements `" + it.Name() + "` but `" + ims.Name
                            + "`'s return type `" + cm.Signature.Ret.Name()
                            + "` is not compatible with the interface's `" + wantRet.Name() + "`", cSpan);
                        return;
                    }
                    // add-iface-return-bridge：返回类型**协变通过了，但两侧 ABI 未必一致**——这是
                    // 「MangleKey 命中不代表契约兑现」的又一条，且此前**连诊断都没有**：实现返回值
                    // 类型（struct）、接口声明返回引用型时，blob struct 走 sret（多一个隐藏物理参），
                    // 而接口调用点按引用返回发码、不传该槽 ⇒ 编译期零诊断、运行期
                    // `takes 2 physical argument(s), the call passes 1`。
                    // 这里只**打标记**，真要不要桥接由 IrGen 用 `_isBlobStruct` 再判（标量 repr 的
                    // struct 是自描述 Value，经接口返回今天本来就对，不能动）。
                    // unify-blob-return-abi：**同一个根因的另外两副面孔**。接口声明的返回位是**型参**
                    // （含 `Self`）时，调用点同样把它当引用槽、不传 sret：
                    //   ·`static abstract Self op_Add(Self,Self)`（INumber）在**擦除的泛型体**里
                    //     发接收者驱动 VCall（`this`+1 = 2 物理），而具体实现 2 形参 + sret = 3
                    //     ⇒ `takes 3 physical argument(s), the call passes 2`（坑点 ④a）;
                    //   ·`Self Copy()`（实例）经**接口收者**调用 ⇒ `takes 2 …, passes 1`。
                    // 🔴 判据必须看**未代换**的声明 `ims.Signature.Ret`：`wantRet` 已被 `_substForIface`
                    // 把 `Self` 换成实现类（= 那个 struct），单看它分不出「声明写的是 `Self`」与
                    // 「声明写的就是这个具体 struct」—— 后者调用点**知道**要传 sret，桥接会把它打坏。
                    bool declRetTypeParam = (ims.Signature.Ret is Z42GenericParamType);
                    if (InheritanceResolver._isStructTypeRef(implRet)
                        && (declRetTypeParam || !InheritanceResolver._isStructTypeRef(wantRet))) {
                        // 桥接的声明返回类型：型参位在调用点就是个引用槽 ⇒ `object`（装箱后的形态）。
                        cm.IfaceBridgeRet = declRetTypeParam ? "object" : wantRet.Name();
                    }
                    // define-null-check-marks D7：`?` 方向一致性（见 _checkNullableDirection）。
                    // 与 static / 可见性 / 返回类型同族——都是「MangleKey 命中不代表契约兑现」。
                    this._checkNullableDirection("interface", cName, it.Name(), ims, cm, cSpan);
                    return;
                }
                j = j + 1;
            }
            if (cur.HasBase && cur.BaseName != "" && table.Classes.ContainsKey(cur.BaseName)) {
                cur = table.Classes.Get(cur.BaseName) as Z42ClassType;
            } else { cur = null; }
        }
        if (!nameSeen) {
            this._sc.Diags.Error(DiagnosticCodes.InterfaceMismatch,
                "`" + cName + "` implements `" + it.Name() + "` but does not define member `"
                + ims.Name + "`", cSpan);
            return;
        }
        this._sc.Diags.Error(DiagnosticCodes.InterfaceMismatch,
            "`" + cName + "` implements `" + it.Name() + "` but no overload of `" + ims.Name
            + "` matches the interface signature (want `" + wantKey + "`)", cSpan);
    }

    // 接口成员签名 → 实现方视角的期望签名。两处替换：
    //   ① `Self` → 实现类自己（`interface IEq { bool Same(Self other); }` + `class P : IEq`
    //      ⇒ 期望 `Same(P)`）。基元同样成立：`Self := Int32`，而 `Int32` 与源码写的 `int` 经
    //      `CanonName()` 同为 `i32`，故 `bool Equals(int other)` 匹配得上（已实测 12 个基元全过）。
    //   ② 接口自己的型参 `T` → 该实现子句给的实参（`class Foo<U> : IBasicCollection<U>` ⇒ T := U）。
    //      只有解析出 `Z42InstantiatedInterfaceType` 时才有实参可代；裸写（非泛型接口）无需代。
    private Z42Type _substForIface(Z42Type t, Z42ClassType ct, Z42InterfaceType it) {
        if (t is Z42GenericParamType) {
            if (t.Name() == "Self") { return ct; }
            if (it is Z42InstantiatedInterfaceType) {
                Z42InstantiatedInterfaceType iit = it as Z42InstantiatedInterfaceType;
                int i = 0;
                while (i < iit.TypeParamCount && i < iit.ArgCount) {
                    if (iit.TypeParamNames[i] == t.Name()) { return iit.TypeArgs[i]; }
                    i = i + 1;
                }
            }
            return t;
        }
        if (t is Z42ArrayType) { return new Z42ArrayType(this._substForIface((t as Z42ArrayType).Elem, ct, it)); }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it2 = t as Z42InstantiatedType;
            Z42Type[] na = new Z42Type[it2.ArgCount];
            int i = 0;
            while (i < it2.ArgCount) { na[i] = this._substForIface(it2.TypeArgs[i], ct, it); i = i + 1; }
            return new Z42InstantiatedType(it2.Def, na, it2.ArgCount);
        }
        // 成员类型本身是**泛型接口**（`IEnumerable<T>.GetEnumerator()` 返回 `IEnumerator<T>`）——
        // 不下钻则 want 里的 `T` 原样留着，与实现方的 `IEnumerator<int>` 永不相等 ⇒ E0412 假红。
        // 与下方 `Z42FuncType` 那支同源：每漏一种可承载型参的复合类型，就多一类假红。
        if (t is Z42InstantiatedInterfaceType) {
            Z42InstantiatedInterfaceType it3 = t as Z42InstantiatedInterfaceType;
            Z42Type[] nb = new Z42Type[it3.ArgCount];
            int k = 0;
            while (k < it3.ArgCount) { nb[k] = this._substForIface(it3.TypeArgs[k], ct, it); k = k + 1; }
            return new Z42InstantiatedInterfaceType(it3.Def, nb, it3.ArgCount);
        }
        // fix-iface-self-completeness-gaps A3：下钻 `Func<...>`——接口成员 `void Apply(Func<Self,int> f)` 里
        // 的 Self（及接口型参）藏在函数类型的形参/返回位。不下钻则满足性校验拿到 want 里 Self 未换 →
        // 与实现类 `void Apply(Func<C,int> f)` **假不匹配** → E0412 假红。补齐后期望签名正确、真匹配。
        if (t is Z42FuncType) {
            Z42FuncType ft = t as Z42FuncType;
            Z42Type[] np = new Z42Type[ft.ParamCount];
            int i = 0;
            while (i < ft.ParamCount) { np[i] = this._substForIface(ft.ParamTypes[i], ct, it); i = i + 1; }
            Z42FuncType r = new Z42FuncType(np, ft.ParamCount, this._substForIface(ft.Ret, ct, it));
            r.ParamsFrom = ft.ParamsFrom;
            r.ParamDefaults = ft.ParamDefaults;
            r.ParamCallers = ft.ParamCallers;
            r.ParamNames = ft.ParamNames;
            return r;
        }
        return t;
    }

    private void _checkStaticClassMember(string clsName, Decl mem) {
        if (mem is MethodDecl) {
            MethodDecl md = mem as MethodDecl;
            if (this._sc._hasWord(md.Mods, "static")) { return; }   // 静态方法（含静态构造器）合法
            if (md.IsCtor) {
                this._sc.Diags.Error(DiagnosticCodes.StaticClassInstanceMember,
                    "static class `" + clsName + "` cannot declare an instance constructor", md.Span);
            } else {
                this._sc.Diags.Error(DiagnosticCodes.StaticClassInstanceMember,
                    "static class `" + clsName + "` cannot declare instance method `" + md.Name + "`", md.Span);
            }
        } else if (mem is FieldDecl) {
            FieldDecl fd = mem as FieldDecl;
            if (this._sc._hasWord(fd.Mods, "static") || this._sc._hasWord(fd.Mods, "const")) { return; }
            this._sc.Diags.Error(DiagnosticCodes.StaticClassInstanceMember,
                "static class `" + clsName + "` cannot declare instance field `" + fd.Name + "`", fd.Span);
        } else if (mem is PropertyDecl) {
            PropertyDecl pd = mem as PropertyDecl;
            if (this._sc._hasWord(pd.Mods, "static")) { return; }
            this._sc.Diags.Error(DiagnosticCodes.StaticClassInstanceMember,
                "static class `" + clsName + "` cannot declare instance property `" + pd.Name + "`", pd.Span);
        } else if (mem is IndexerDecl) {
            IndexerDecl ix = mem as IndexerDecl;
            this._sc.Diags.Error(DiagnosticCodes.StaticClassInstanceMember,
                "static class `" + clsName + "` cannot declare an indexer", ix.Span);
        }
    }


    // ── define-null-check-marks D7：override / 接口实现的 `?` 方向一致性 ───────────────
    //
    // `?` 的含义是「**请编译器在这里强制检查**」，义务落在**哪一方**决定了允许的方向：
    //
    // | 位置 | 允许 | 禁止 | 被破坏的是什么 |
    // |---|---|---|---|
    // | 返回类型 | 实现方**去** `?` | 实现方**加** `?` | 基类/接口没标 ⇒ 经它调用的人**没有**检查义务，而实现方却会返回 null |
    // | 形参 | 实现方**加** `?` | 实现方**去** `?` | 基类/接口标了 ⇒ 契约是「任何实现都会检查」，去掉就不检查了 |
    //
    // 两条都是**加严方向可以、放松方向不行**：实现方可以对自己更严（返回更不容易为 null、
    // 对入参检查得更多），但不能比它兑现的契约更松——松的那一侧就是洞。
    //
    // ⚠️ 只在**签名已配对成功**之后调（override 的 `_nearestBaseMethod` 命中 / 接口的 MangleKey 命中），
    // 所以这里不重做匹配，只比标记位。形参逐位比，长度以被实现方为准（已配对 ⇒ 个数相同）。
    //
    // ⚠️ 跨包：方法形参/返回的 `?` 由 TSIG 文本双向携带（`TsigTypeName` / `StubEmitter`），
    // 导入的基类/接口标记可靠。**字段**那半不携带（`SurfaceTypeName` 已擦除 `?`），但字段不参与
    // override/接口实现，与本检查无关。
    //
    private void _checkNullableDirection(string kindWord, string ownerName, string contractName,
                                         MethodSymbol contractSym, MethodSymbol implSym, Span span) {
        if (contractSym == null || implSym == null) { return; }
        if (contractSym.Signature == null || implSym.Signature == null) { return; }
        Z42FuncType cs = contractSym.Signature;
        Z42FuncType ms = implSym.Signature;
        // 返回类型：实现方加 `?` 而契约方没标 → 洞。
        if (ms.RetIsNullable && !cs.RetIsNullable) {
            this._sc.Diags.Error(DiagnosticCodes.NullableOverrideMismatch,
                "`" + ownerName + "." + implSym.Name + "` marks its return type `?` but "
                + kindWord + " `" + contractName + "` does not — callers going through `"
                + contractName + "` have no obligation to check the result, so the mark would be "
                + "silently dropped; either mark the return type `?` on `" + contractName
                + "` too, or drop the `?` here", span);
            return;
        }
        // 形参：契约方标了 `?` 而实现方去掉 → 洞。
        int n = cs.ParamCount;
        if (ms.ParamCount < n) { n = ms.ParamCount; }
        int i = 0;
        while (i < n) {
            if (cs.IsNullableParam(i) && !ms.IsNullableParam(i)) {
                this._sc.Diags.Error(DiagnosticCodes.NullableOverrideMismatch,
                    "`" + ownerName + "." + implSym.Name + "` drops the `?` on parameter #"
                    + (i + 1).ToString() + " that " + kindWord + " `" + contractName + "` marks — "
                    + kindWord + " `" + contractName + "` promises every implementation checks that "
                    + "argument for null, and this one would not; mark it `?` here too", span);
                return;
            }
            i = i + 1;
        }
    }

    // add-iface-return-bridge：这个类型引用是不是**值类型（struct）**。
    //
    // 只看符号层（`IsStruct`）——这一层拿不到 `Gen.Layouts`，也不该拿：blob 与否是**发射期**的
    // 事（`_isBlobStruct` = struct + 展平叶子 ≥2 + 布局非退化），而这里要回答的是更粗的一问
    // 「返回的是值类型还是引用」。粗判在这里是**安全**的：标记只是让 IrGen 去细判，不产生诊断。
    // 实例化类型按**定义**判（`Pair<int>` 是不是 struct 取决于 `Pair`），与 `StructLayout.IsStructType`
    // 的基名口径一致。
    private static bool _isStructTypeRef(Z42Type t) {
        if (t is Z42ClassType) { return (t as Z42ClassType).IsStruct; }
        if (t is Z42InstantiatedType) {
            Z42ClassType d = (t as Z42InstantiatedType).Def;
            if (d == null) { return false; }
            return d.IsStruct;
        }
        return false;   // 接口 / 数组 / 型参 / Unknown 一律当非-struct（保守：不打标记）
    }

}
