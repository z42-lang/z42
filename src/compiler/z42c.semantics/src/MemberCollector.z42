// 符号收集 Pass B（成员填充）：从 SymbolCollector 分出。字段/方法/属性/索引器签名 + regKey mangle
// + const 收集 + 转换运算符声明检测。共享辅助（_unwrap/_vis/_hasWord/_chkTypeRef/_methodSymbol）+ partial
// 状态（_partialDecls/_partialImpls）留 hub SymbolCollector，经 _sc 委回。
namespace Z42.Semantics;
using Z42.IR;
using Z42.Syntax;
using Z42.Core;

public sealed class MemberCollector {
    private SymbolCollector _sc;   // hub 反向引用：共享辅助 + partial 状态 + 编排
    public MemberCollector(SymbolCollector sc) { this._sc = sc; }

    // Pass B：成员 + 顶层 func
    internal void _passMembers(SymbolTable table, CompilationUnit cu) {
        table.CurrentAliases = SymbolTable.BuildAliases(cu);   // add-type-alias：解析成员类型时本 CU 别名生效
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct") { this._fillClass(table, c); }
                else if (c.Kind == "interface") { this._fillInterface(table, c); }
            } else if (d is MethodDecl) {
                MethodDecl m = d as MethodDecl;            // 顶层 func（IsFree）
                table.Functions.Put(m.Name, this._sc._methodSymbol(table, m, "", new string[0], 0));
            }
            i = i + 1;
        }
    }

    // 接口方法签名（体可无；签名同类方法解析）（port-z42c-interface）。
    private void _fillInterface(SymbolTable table, ClassDecl c) {
        Z42InterfaceType it = table.Interfaces.Get(c.Name) as Z42InterfaceType;
        string[] tp = c.TypeParams.Names;    // 接口类型形参（泛型接口 IFoo<T>：T 列入 paramNames 解析签名）
        int tpc = c.TypeParams.Count;
        int j = 0;
        while (j < c.MemberCount) {
            Decl mem = this._sc._unwrap(c.Members[j]);
            if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                it.Methods.Put(md.Name, this._sc._methodSymbol(table, md, c.Name, tp, tpc));
            } else if (mem is PropertyDecl) {
                // 接口属性 getter → get_X 方法符号（镜像 C# IEnumerator<T>.Current → get_Current）。
                PropertyDecl pd = mem as PropertyDecl;
                if (pd.HasGet) {
                    string gkey = "get_" + pd.Name;
                    Z42Type gret = table.ResolveTypeP(pd.Type, tp, tpc);
                    Z42Type[] gps = new Z42Type[0];
                    it.Methods.Put(gkey, new MethodSymbol(gkey, "public", new Z42FuncType(gps, 0, gret), false, c.Name, false, null));
                }
            }
            j = j + 1;
        }
    }

    private void _fillClass(SymbolTable table, ClassDecl c) {
        // Arity-mangle：泛型类若已以 Name$N 键注册，优先取该 CT（镜像 C# TryGetClassFor）。
        string ctKey = c.Name;
        if (c.TypeParams.Count > 0) { string mk = c.Name + "$" + c.TypeParams.Count.ToString(); if (table.Classes.ContainsKey(mk)) { ctKey = mk; } }
        Z42ClassType ct = table.Classes.Get(ctKey) as Z42ClassType;
        string[] tp = c.TypeParams.Names;     // 类型形参（泛型类；非泛型 Count=0）
        int tpc = c.TypeParams.Count;
        // enforce-class-access：基类 / 接口列表类型引用（声明签名位置）。逐 base 解析后校验（含泛型基
        // List<T>→递归实参）；接口若解析为 Z42InterfaceType 则 CheckTypeRef 放行（接口可见性未建模，Deferred）。
        int _bi = 0;
        while (_bi < c.BaseCount) {
            this._sc._chkTypeRef(table.ResolveTypeP(c.Bases[_bi], tp, tpc), c.Name, table, c.Bases[_bi].Span);
            _bi = _bi + 1;
        }
        // stabilize-instance-dispatch-keys：实例/静态虚方法改「primary（声明序首个同名）裸基线键 / 非-primary
        // 全 mangle」，键仅依赖**声明序 + 是否已见过该名**（emit-期 `emittedInst` tracker，见下），不再依赖兄弟集
        // 预扫描（旧的 seenInst/ovldInst/arityDup 三档：unique-bare / arity-`Name$arity` / type-overload 全 mangle
        // 已删——那套让「加一个重载 → 既有方法 rekey」，正是要根治的漂移源）。静态非虚仍恒全 mangle（下方）。
        StrMap classConstEnv = new StrMap();   // add-const-keyword：按声明序累积同类 const（裸名 + `Class.名`），供后续 const 初始化器引用
        // add-user-conversions ②：本类转换运算符 (源→目标) → "implicit"/"explicit"，声明期冲突检测（E0440）。
        // 须在注册时检测——真重复会在 ct.Methods 里静默覆盖，事后扫 ct.Methods 抓不到。
        StrMap convSeen = new StrMap();
        // stabilize-instance-dispatch-keys：primary/非-primary 键决议的 emit-期 tracker。声明序**首次**见到
        // 某实例/静态虚方法名 → primary（基线键=裸名，多态/协议规范槽 + seed 锚点）；后续同名兄弟 → 非-primary
        // （全签名 MangleKey，加/删重载只动自己、不碰 primary → 唯一方法逐字节不变）。协议豁免名恒裸、不入此表。
        StrMap emittedInst = new StrMap();
        int j = 0;
        while (j < c.MemberCount) {
            Decl mem = this._sc._unwrap(c.Members[j]);
            if (mem is FieldDecl) {
                FieldDecl fd = mem as FieldDecl;
                Z42Type ft = table.ResolveTypeP(fd.Type, tp, tpc);
                this._sc._chkTypeRef(ft, c.Name, table, fd.Type.Span);   // enforce-class-access：字段类型引用
                bool fconst = this._sc._hasWord(fd.Mods, "const");   // add-const-keyword：const 隐式 static、无存储
                bool fstatic = this._sc._hasWord(fd.Mods, "static") || fconst;
                // add-partial-types：跨碎片重复字段 → 报错（同碎片内重复是既有语义，不新增判断）。
                if (ct.IsPartial && ct.Fields.ContainsKey(fd.Name)) {
                    this._sc.Diags.Error(DiagnosticCodes.PartialDuplicateMember,
                        "partial type `" + c.Name + "` defines field `" + fd.Name + "` in more than one fragment", fd.Span);
                }
                FieldSymbol fsym = new FieldSymbol(fd.Name, this._sc._vis(fd.Mods, "private"), ft, fstatic, c.Name);
                fsym.IsReadonly = this._sc._hasWord(fd.Mods, "readonly");   // add-readonly-fields-opt：本地字段 readonly → 优化提示
                if (fconst) { this._collectConstField(fd, fsym, c.Name, classConstEnv); }   // add-const-keyword：求值 + 登记 ConstVal + 诊断
                if (HandlerRegistry.HasDeprecated(c.Members[j])) { fsym.IsDeprecated = true; fsym.DeprecationMsg = HandlerRegistry.DeprecatedMsg(c.Members[j]); }   // add-deprecated-directive：本地字段级
                ct.Fields.Put(fd.Name, fsym);
                if (this._sc._hasWord(fd.Mods, "event")) { ct.EventFields.Put(fd.Name, "1"); }   // add-event-keyword-multicast

                // G18：实例字段记有序元数据（声明序 + TSIG 规范拼写）供 TSIG 继承字段展开；static 不入（C# 不继承合并 static）。
                // 用 resolved Z42Type.Name() 镜像 C# TypeToString(sym.Type)：接口→裸名、Predicate<T>→Func<T,bool>、
                // Func/Action 规范化；Unknown/Error → AST fallback（imported 包 interface 未进 ImportedSymbols 时降级）。
                if (!fstatic) { string fsp = (ft is Z42UnknownType || ft is Z42ErrorType) ? TypeNameResolver.TsigTypeName(fd.Type) : TypeNameResolver.SurfaceTypeName(ft); ct.AddOwnField(fd.Name, fsp, this._sc._vis(fd.Mods, "private")); }
            } else if (mem is PropertyDecl) {
                // 属性作为字段处理（type-checking 用；auto-property { get;/set; } 等同只读/读写字段）。
                PropertyDecl pd = mem as PropertyDecl;
                Z42Type pft = table.ResolveTypeP(pd.Type, tp, tpc);
                this._sc._chkTypeRef(pft, c.Name, table, pd.Type.Span);   // enforce-class-access：属性类型引用
                bool pfstatic = this._sc._hasWord(pd.Mods, "static");
                FieldSymbol pfsym = new FieldSymbol(pd.Name, this._sc._vis(pd.Mods, "private"), pft, pfstatic, c.Name);
                ct.Fields.Put(pd.Name, pfsym);
                // 镜像 C# SynthesizeClassAutoProp：后备字段名 __prop_X（非源名 X），供 TSIG 导出匹配。
                // extern/native 属性无后备字段；后备字段 vis 固定 private（C# 合成行为）。
                bool pfExtern = this._sc._hasWord(pd.Mods, "extern");
                // add-property-getter：计算属性（HasGetBody）无后备字段——getter 是真实函数体，不读 __prop_X。
                bool pfHasBacking = !pfstatic && !pfExtern && !pd.HasGetBody;
                if (pfHasBacking) { string pfsp = (pft is Z42UnknownType || pft is Z42ErrorType) ? TypeNameResolver.TsigTypeName(pd.Type) : TypeNameResolver.SurfaceTypeName(pft); ct.AddOwnField("__prop_" + pd.Name, pfsp, "private"); }
                // fix-autoprop-getonly-backing-write：属性打标，让「源名 X ↔ 存储 __prop_X」的落差
                // 对下游可见 —— AssignTyper 据此限制无 setter 的赋值，FunctionEmitter/AccessEmitter 据此
                // 让裸 ident `X` 与 `this.X` 一样走访问器（此前裸 ident 按源名发 field_get/field_set，
                // 打在不存在的字段上：读回 Null、写进虚空）。
                pfsym.IsProp = true;
                if (pfHasBacking) { pfsym.PropBackingName = "__prop_" + pd.Name; }
                if (!pd.HasSet) { pfsym.IsPropNoSetter = true; }
                // get_X / set_X accessor 方法符号（IrGen 发 builtin stub 或编译体；镜像 C# SynthesizeClassAutoProp）。
                string pvis = this._sc._vis(pd.Mods, "private");
                Z42Type[] getPs0 = new Z42Type[0];
                if (pd.HasGet) {
                    ct.Methods.Put("get_" + pd.Name, new MethodSymbol("get_" + pd.Name, pvis,
                        new Z42FuncType(getPs0, 0, pft), pfstatic, c.Name, false, null));
                }
                if (pd.HasSet) {
                    Z42Type[] setPs0 = new Z42Type[1];
                    setPs0[0] = pft;
                    ct.Methods.Put("set_" + pd.Name, new MethodSymbol("set_" + pd.Name, pvis,
                        new Z42FuncType(setPs0, 1, new Z42VoidType()), pfstatic, c.Name, false, null));
                }
            } else if (mem is IndexerDecl) {
                // get_Item / set_Item accessor 方法符号（IndexerDecl lowering；镜像 C# IndexerDecl → get_Item/set_Item）。
                IndexerDecl id = mem as IndexerDecl;
                Z42Type idRet = table.ResolveTypeP(id.RetType, tp, tpc);
                this._sc._chkTypeRef(idRet, c.Name, table, id.RetType.Span);   // enforce-class-access：索引器返回类型引用
                bool idStatic = this._sc._hasWord(id.Mods, "static");
                string idvis = this._sc._vis(id.Mods, "private");
                if (id.HasGet) {
                    Z42Type[] getPs1 = new Z42Type[id.ParamCount];
                    int qi0 = 0;
                    while (qi0 < id.ParamCount) { getPs1[qi0] = table.ResolveTypeP(id.Params[qi0].Type, tp, tpc); qi0 = qi0 + 1; }
                    ct.Methods.Put("get_Item", new MethodSymbol("get_Item", idvis,
                        new Z42FuncType(getPs1, id.ParamCount, idRet), idStatic, c.Name, false, null));
                }
                if (id.HasSet) {
                    Z42Type[] setPs1 = new Z42Type[id.ParamCount + 1];
                    int qi1 = 0;
                    while (qi1 < id.ParamCount) { setPs1[qi1] = table.ResolveTypeP(id.Params[qi1].Type, tp, tpc); qi1 = qi1 + 1; }
                    setPs1[id.ParamCount] = idRet;
                    ct.Methods.Put("set_Item", new MethodSymbol("set_Item", idvis,
                        new Z42FuncType(setPs1, id.ParamCount + 1, new Z42VoidType()), idStatic, c.Name, false, null));
                }
            } else if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                // add-partial-types：partial method 配对追踪（canonical sig key，独立于重载 mangle）。
                if (md.IsPartial) {
                    string psk = this._partialSigKey(c.Name, md);
                    if (md.HasBody) { this._sc._partialImpls.Put(psk, md); } else { this._sc._partialDecls.Put(psk, md); }
                }
                // ctor（G11）也收集为方法（名=类名，ret void）：使 TypeChecker 能绑其体、IrGen 能发 `<Class>.<Class>` 函数。
                // GS3：重载方法注册 Name$arity；unique 方法 bare name（镜像 C# SymbolCollector.Classes.cs regName 逻辑）。
                // add-type-based-overloads：同 (name,arity) ≥2（type-based 重载）→ Name$arity$typesig 消歧。
                bool mst = this._sc._hasWord(md.Mods, "static");
                MethodSymbol msym = this._sc._methodSymbol(table, md, c.Name, tp, tpc);
                if (HandlerRegistry.HasDeprecated(c.Members[j])) { msym.IsDeprecated = true; msym.DeprecationMsg = HandlerRegistry.DeprecatedMsg(c.Members[j]); }   // add-deprecated-directive：本地方法级
                // stabilize-dispatch-keys（方案A，静态-only）：
                // - 常规静态方法：恒全签名 mangle → 键是方法自身签名的纯函数，加/删重载不再 re-mangle 现有静态键
                //   （根治 params-for-Join 的 bootstrap 破坏）。静态无 vtable 派发、编译期决议、emit 用 RegKey → 安全。
                // - 静态【虚】成员（INumber 的 static abstract op_* 接口成员 + 各 primitive 的 static override 实现）：
                //   经 VCall 按运行时类型派发（`x.op_Add(x)` → VCall → Std.Int32.op_Add + arity 重试），base 声明与
                //   派生实现【必须同键】。全 mangle 会因类型参数替换令 base(`op_Add$2$T$T`)≠派生(`op_Add$2$i32$i32`)
                //   → VCall 落空（`expected object, got I64`）。故与实例虚方法同理，走基线键规则（op_* 唯一 → 裸名）。
                // - 实例方法：保持基线键规则（unique bare / arity 重载 Name$arity / type 重载全 mangle；协议豁免名
                //   ToString/Equals/GetHashCode/GetType/get_Item/set_Item 恒裸——被 VM vtable / DepIndex 按裸字面量
                //   硬查，mangle 会断锚点）。实例 / 虚 / 接口 / 泛型 / 委托 / foreach / ctor 派发依赖此基线锚点，不动。
                bool staticVirtual = mst && (this._sc._hasWord(md.Mods, "override") || this._sc._hasWord(md.Mods, "abstract"));
                string regName;
                if (mst && !staticVirtual) {
                    regName = OverloadResolver.MangleKey(md.Name, msym.Signature.ParamTypes, msym.Signature.ParamCount);
                    // add-user-conversions Decision 4（根因）：转换运算符按 (param,return) 唯一——静态 mangle 仅按
                    // 参数类型，`op_Implicit(Foo)->int` 与 `->string` 会撞键 → RegKey 附返回类型消歧。
                    if (SymbolCollector._isConvOp(md.Name)) {
                        regName = regName + "$to$" + msym.Signature.Ret.CanonName();
                    }
                } else {
                    // stabilize-instance-dispatch-keys：primary/非-primary 键。声明序**首个**同名（实例或静态虚）
                    // → 裸基线键（= 唯一方法今天的键：多态/协议规范槽 + seed 锚点，零字节漂移）；后续兄弟 →
                    // 全签名 MangleKey（加/删重载只动自己、不碰 primary）。
                    // 协议豁免名（ToString/Equals/GetHashCode/GetType/get_Item/set_Item）**也走 primary/非-primary**：
                    // 规范签名（声明序首个，惯例=无参 ToString/Equals(object)/等）= primary → 裸（VM vtable/DepIndex
                    // 硬查锚点保住）；其**重载**（如 `ToString(string)`/`Equals(T)`）= 非-primary → 全键（否则全裸 last-wins
                    // 撞车——`guid.ToString("D")` 会派发到无参 ToString 丢 format）。老键正是给协议重载 `Name$arity` 消歧
                    // （ovldInst 分支），本变更改用全键，语义等价、更稳。decl-only partial 被下方擦除、不计入 primary tracker。
                    regName = md.Name;
                    bool tracks = !(md.IsPartial && !md.HasBody);
                    if (tracks) {
                        if (emittedInst.ContainsKey(md.Name)) {
                            regName = OverloadResolver.MangleKey(md.Name, msym.Signature.ParamTypes, msym.Signature.ParamCount);
                        } else {
                            emittedInst.Put(md.Name, "1");
                        }
                    }
                }
                // add-partial-types：decl-only partial method → 擦除（无实现即不存在，不注册桩/体）。
                if (md.IsPartial && !md.HasBody) {
                    // 擦除：跳过注册。若某碎片有实现，其 impl 会在自己的碎片正常注册。
                    // unify-regkey-source-of-truth：虽不注册，仍登记键——消费方（TSIG 导出 /
                    // 暴露检查）要问的是「这个声明该解析到哪个键」，答案正是实现碎片注册的那个。
                    // 两侧键为何一致（`emittedInst` tracker 是 per-碎片的，故要分开看）：
                    //   · 静态：上面 `mst && !staticVirtual` 分支照常算全签名 MangleKey —— 只依赖签名，
                    //     与在哪个碎片、前面有没有同名兄弟都无关 → 必然相同。
                    //   · 实例：`tracks` 为 false → primary 决议整块跳过 → 恒裸 md.Name；实现碎片里该名
                    //     若是首个声明也拿裸键 → 相同。**同名重载分处两碎片时不成立**，但那本就是
                    //     partial v1 的既有限制（重载须同碎片，见 partial-types.md「边界与限制」+
                    //     src/tests/partial-types/partial_protocol_overload.z42），不由本变更引入。
                    // unify-regkey-phase2：读侧回落删除后，**本行是这类方法唯一的键来源**——删了它
                    // MethodKeyOf 会抛。跨-CU 场景由 src/tests/cross-zpkg/partial_crosscu_export 守住。
                    md.RegKey = regName;
                } else {
                    // add-partial-types / fix-partial-protocol-overload-e0433：partial 跨/同碎片重复成员检测。
                    // 只在【完整签名相同】时报 E0433——真重复。协议豁免重载（Equals(object?)/Equals(string) 等
                    // 恒裸键 "Equals"，见 SymbolCollector.IsProtocolExempt）与其它共享 RegKey 的合法重载虽 regName
                    // 相同但签名不同，放行（Put 覆盖，与非-partial 同 last-wins 语义）。此前按 regName 判重会把这类
                    // 合法重载误报重复（如 partial String 的 Equals(object?)+Equals(string) → 误报 E0433）。
                    if (ct.IsPartial && ct.Methods.ContainsKey(regName)
                        && this._sameSignature(ct.Methods.Get(regName) as MethodSymbol, msym)) {
                        this._sc.Diags.Error(DiagnosticCodes.PartialDuplicateMember,
                            "partial type `" + c.Name + "` defines member `" + md.Name + "` in more than one fragment", md.Span);
                    }
                    // unify-regkey-source-of-truth：注册走单一入口——算键与写键绑死，
                    // 结构上不可能「注册了却没填 RegKey」（旧代码里 _passImpls 正是这么漏的）。
                    SymbolCollector.RegisterMethod(ct, md, msym, regName);
                    // add-user-conversions ②：声明期冲突检测（同 (源→目标) 重复 / implicit+explicit 同对 → E0440）。
                    if (SymbolCollector._isConvOp(md.Name) && mst && msym.Signature.ParamCount == 1) {
                        string srcN = msym.Signature.ParamTypes[0].CanonName();
                        string tgtN = msym.Signature.Ret.CanonName();
                        string pairK = srcN + "->" + tgtN;
                        string curKind = "implicit";
                        if (md.Name == "op_Explicit") { curKind = "explicit"; }
                        if (convSeen.ContainsKey(pairK)) {
                            string prevKind = convSeen.Get(pairK) as string;
                            if (prevKind == curKind) {
                                this._sc.Diags.Error(DiagnosticCodes.ConversionOperatorConflict,
                                    "conversion operator '" + srcN + "' -> '" + tgtN + "' is already declared", md.Span);
                            } else {
                                this._sc.Diags.Error(DiagnosticCodes.ConversionOperatorConflict,
                                    "cannot declare both implicit and explicit conversion '" + srcN + "' -> '" + tgtN + "'", md.Span);
                            }
                        } else {
                            convSeen.Put(pairK, curKind);
                        }
                    }
                }
            }
            j = j + 1;
        }
    }

    // partial method 配对用 canonical 签名键（独立于重载 mangle）：Cls#Name(pTypeDump,…)。
    // 声明与实现签名一致 → 键相同 → 配对；不一致 → impl 键在 decls 查不到 → 报 E0434。
    private string _partialSigKey(string cls, MethodDecl md) {
        string s = cls + "#" + md.Name + "(";
        int i = 0;
        while (i < md.ParamCount) {
            if (i > 0) { s = s + ","; }
            s = s + md.Params[i].Type.Dump();
            i = i + 1;
        }
        return s + ")";
    }

    // fix-partial-protocol-overload-e0433：两方法符号的完整参数签名是否逐个相同（partial 重复成员判定用——
    // 区分真重复与共享 RegKey 的合法重载）。参数个数 + 各参数 canonical 类型名逐一比较（用已解析签名，
    // 避免 AST 类型 Dump 与解析类型名不对齐）。
    private bool _sameSignature(MethodSymbol a, MethodSymbol b) {
        if (a == null || b == null) { return false; }
        if (a.Signature.ParamCount != b.Signature.ParamCount) { return false; }
        int i = 0;
        while (i < a.Signature.ParamCount) {
            if (a.Signature.ParamTypes[i].CanonName() != b.Signature.ParamTypes[i].CanonName()) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // add-const-keyword：const 字段求值 + 登记 ConstVal + 诊断。fsym.IsConst 置位；求值成功 →
    // 存 ConstVal 并把值加进 classConstEnv（裸名 + `Class.名`），供后续同类 const 初始化器引用。
    private void _collectConstField(FieldDecl fd, FieldSymbol fsym, string className, StrMap classConstEnv) {
        fsym.IsConst = true;
        if (!fd.HasInit) {
            this._sc.Diags.Error(DiagnosticCodes.ConstNeedsInit,
                "const field `" + fd.Name + "` must have an initializer", fd.Span);
            return;
        }
        ConstValue cv = ConstEval.Eval(fd.Init, classConstEnv);
        if (cv == null) {
            if (this._isPureRef(fd.Init)) {
                this._sc.Diags.Error(DiagnosticCodes.ConstExprBadRef,
                    "const expression can only reference already-defined const values", fd.Span);
            } else {
                this._sc.Diags.Error(DiagnosticCodes.ConstNotConstantInit,
                    "const field `" + fd.Name + "` initializer must be a compile-time constant", fd.Span);
            }
            return;
        }
        fsym.ConstVal = cv;
        classConstEnv.Put(fd.Name, cv);
        classConstEnv.Put(className + "." + fd.Name, cv);
    }

    // add-const-keyword：初始化器顶层是否为「裸标识符 / Class.成员」纯引用（决定 BadRef vs NotConstant 诊断）。
    private bool _isPureRef(Expr e) {
        if (e is IdentExpr) { return true; }
        if (e is MemberExpr) { return (e as MemberExpr).Target is IdentExpr; }
        return false;
    }

}
