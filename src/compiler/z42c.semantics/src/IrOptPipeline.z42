// IrOptPipeline —— 编译期 IR 优化管线（处理流程骨架）。
// 引入 change：optimization-pipeline。挂载点：IrGen.Generate 末尾（emit 后、写 zbc 前）。
//
// 流程（见 docs/book/src/runtime/optimization-pipeline.md，准则 1 interp-first）：
//   Run(module) → 逐函数 _optFunc：
//     pass 1 copy-prop：消 SSA-lite 拷回冗余 Copy（`t = expr; copy local, t` → `local = expr`），
//                       砍 interp 每个赋值的一次 dispatch（interp 热路大头）。
//     pass 2 temp-DCE：删「纯 + Dst 零读」的死指令（含参数寄存器 live-out 保护）。
//   两 pass 间重算读计数（copy-prop 改了 IR）。
//
// 安全：copy-prop 只在**相邻** producer→copy、且 t 单赋值(defs==1)单读(reads==1，含终结子读)、t≠local
//       时 retarget；temp-DCE 只删 IsPure 白名单 + Dst 零读 + 非参数寄存器。保守正确，单趟不级联。
namespace Z42.Semantics;

using Z42.IR;

public sealed class IrOptPipeline {

    // add-compiler-inlining：optSet 决定跑哪些 pass（可独立开关，见 OptSet.z42）。
    // optSet==None（debug 默认）→ 整体跳过（-O0，忠实可调试）。每个 pass 各自从当前 IR
    // 重算 reads/defs → 单独开启也正确（design D2 独立性约束）。
    public static void Run(IrModule m, int optSet) {
        if (optSet == Opt.None) { return; }
        // inline 靠前（模块级，需 callee 跨函数解析）：产出更多下游 const-fold/copy-prop/dce 机会。
        // 单独开 Inline 也正确（只内联、不清理，留下的 copy 由后续 pass 或下一代自愈）——design D2。
        if (Opt.Has(optSet, Opt.Inline)) { IrInline.Run(m); }
        int fi = 0;
        while (fi < m.FuncCount) {
            IrOptPipeline._optFunc(m.Functions[fi], optSet);
            fi = fi + 1;
        }
        // pass: escape-analysis 栈上分配（模块级，最后跑）—— 所有 per-函数变换 + inline 已定型，
        // 分析匹配最终执行的 IR（inline 把 call 展开后可能解锁更多不逃逸对象）。只置 ObjNew/ArrayNew/
        // ArrayNewLit 的 StackAlloc 标志、不改指令流 → 不影响其它 pass，单独开也正确（design D2）。
        if (Opt.Has(optSet, Opt.StackAlloc)) { IrEscapeAnalysis.Run(m); }
    }

    private static void _optFunc(IrFunction f, int optSet) {
        if (f.BlockCount == 0) { return; }   // 抽象/extern 桩：无体
        // pass: const-fold —— 折叠两 int 常量的运算/比较 + 代数恒等式（放最前，产出的 const 供后续传播）
        if (Opt.Has(optSet, Opt.ConstFold)) {
            int[] defs0 = IrOptPipeline._computeDefs(f);
            IrOptPipeline._passConstFold(f, defs0);
        }
        // pass: licm —— 循环不变量外提（放 const-fold 后、cse 前：常量先折，提到 pre-header 后再被下游清理）
        if (Opt.Has(optSet, Opt.Licm)) {
            IrLicm.Run(f);
        }
        // pass: cse —— 块内公共子表达式消除（放 const-fold 后：常量先折、剩下的纯计算去重）
        if (Opt.Has(optSet, Opt.Cse)) {
            IrOptPipeline._passCse(f);
        }
        // pass: copy-prop —— 从当前 IR 重算读/写计数（含终结子读）
        if (Opt.Has(optSet, Opt.CopyProp)) {
            int[] reads = IrOptPipeline._computeReads(f);
            int[] defs = IrOptPipeline._computeDefs(f);
            IrOptPipeline._passCopyProp(f, reads, defs);
            // use-site 级联（improve-copy-prop-cascade）：清相邻 producer→copy retarget 遗留的
            // 链式/非相邻 copy——把单赋值 `dst=copy src`（src 稳定）的所有 dst 使用点改写为 src、删死 copy。
            IrOptPipeline._passCopyPropUse(f);
        }
        // pass: temp-DCE —— 从当前 IR 重算读计数；参数寄存器 live-out
        if (Opt.Has(optSet, Opt.Dce)) {
            int[] reads2 = IrOptPipeline._computeReads(f);
            IrOptPipeline._seedParams(reads2, f.ParamCount);
            IrOptPipeline._passTempDce(f, reads2);
        }
    }

    // ── pass 1: const-fold ─────────────────────────────────────────────────────────
    // 建 int 常量表（单赋值 ConstI64）→ 前向扫，两操作数皆常量的运算/比较就地折成 Const 指令，
    // 并把折出的新 const 登记回表（前向传播链式 const）。单赋值 → temp 位置无关，可全量先播种。
    private static void _passConstFold(IrFunction f, int[] defs) {
        bool[] cint = new bool[f.MaxReg + 2];
        long[] cval = new long[f.MaxReg + 2];
        // 播种：单赋值 ConstI64
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int ii = 0;
            while (ii < blk.InstrCount) {
                IrInstr ins = blk.Instrs[ii];
                if (IrOptInfo.IsConstI64(ins)) {
                    int d = IrOptInfo.DstId(ins);
                    if (d >= 0 && d < cint.Length && defs[d] == 1) { cint[d] = true; cval[d] = IrOptInfo.ConstI64Val(ins); }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        // 前向折叠
        bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int ii = 0;
            while (ii < blk.InstrCount) {
                IrInstr folded = IrOptInfo.TryConstFold(blk.Instrs[ii], cint, cval);
                if (folded != null) {
                    blk.Instrs[ii] = folded;
                    if (IrOptInfo.IsConstI64(folded)) {
                        int d = IrOptInfo.DstId(folded);
                        if (d >= 0 && d < cint.Length) { cint[d] = true; cval[d] = IrOptInfo.ConstI64Val(folded); }
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }

    // ── 计数助手 ──────────────────────────────────────────────────────────────────
    private static int[] _computeReads(IrFunction f) {
        int[] reads = new int[f.MaxReg + 2];
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int ii = 0;
            while (ii < blk.InstrCount) { IrOptInfo.AddReads(reads, blk.Instrs[ii]); ii = ii + 1; }
            if (blk.HasTerm) { IrOptInfo.AddTermReads(reads, blk.Term); }
            bi = bi + 1;
        }
        return reads;
    }
    private static int[] _computeDefs(IrFunction f) {
        int[] defs = new int[f.MaxReg + 2];
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int ii = 0;
            while (ii < blk.InstrCount) { IrOptInfo.AddDef(defs, blk.Instrs[ii]); ii = ii + 1; }
            bi = bi + 1;
        }
        return defs;
    }
    // 参数寄存器 live-out：out/ref 参数最终值由调用方读取（跨函数 escape，函数内看不到）。
    // 上界 [0, ParamCount] 含一格：实例/lambda 精确（reg0=this/env），静态/自由多护一格——安全。
    private static void _seedParams(int[] reads, int paramCount) {
        int pr = 0;
        while (pr <= paramCount && pr < reads.Length) { reads[pr] = reads[pr] + 1; pr = pr + 1; }
    }

    // ── pass 1: copy-prop ────────────────────────────────────────────────────────
    private static void _passCopyProp(IrFunction f, int[] reads, int[] defs) {
        int bi = 0;
        while (bi < f.BlockCount) {
            IrOptPipeline._copyPropBlock(f.Blocks[bi], reads, defs);
            bi = bi + 1;
        }
    }

    private static void _copyPropBlock(IrBlock blk, int[] reads, int[] defs) {
        bool[] removed = new bool[blk.InstrCount];
        int removedCount = 0;
        int i = 0;
        while (i + 1 < blk.InstrCount) {
            IrInstr x = blk.Instrs[i];
            IrInstr c = blk.Instrs[i + 1];
            if (c is CopyInstr) {
                CopyInstr cc = c as CopyInstr;
                int t = cc.Src.Id;
                int local = cc.Dst.Id;
                // 条件：t≠local；t 由 x 写（x.Dst==t）；t 全函数单赋值、单读（那唯一读即本 Copy）
                if (t != local && t >= 0 && t < reads.Length
                    && IrOptInfo.DstId(x) == t && defs[t] == 1 && reads[t] == 1) {
                    if (IrOptInfo.SetDst(x, cc.Dst)) {   // 把 x 的 Dst 换成 local 的 TypedReg（带类型）
                        removed[i + 1] = true;
                        removedCount = removedCount + 1;
                        i = i + 2;   // 跳过已消的 Copy
                        continue;
                    }
                }
            }
            i = i + 1;
        }
        if (removedCount == 0) { return; }
        IrInstr[] nw = new IrInstr[blk.InstrCount - removedCount];
        int j = 0;
        int k = 0;
        while (k < blk.InstrCount) {
            if (!removed[k]) { nw[j] = blk.Instrs[k]; j = j + 1; }
            k = k + 1;
        }
        blk.Instrs = nw;
        blk.InstrCount = blk.InstrCount - removedCount;
    }

    // ── pass 1b: use-site copy 级联传播（improve-copy-prop-cascade）──────────────────
    // 对单赋值 `dst = copy src`（dst 非形参、src 稳定）建 dst→src 映射（链式解析到最终稳定 src），
    // 用 IrOptInfo.ReplaceReads 改写全函数所有 dst 使用点为 src，再删这些已死的 copy。
    // 安全：src 稳定（单赋值 temp / 从不重写的形参）→ 其值在 dst 所有使用点相同（IR 有效 = def 支配 use）。
    private static void _passCopyPropUse(IrFunction f) {
        int[] defs = IrOptPipeline._computeDefs(f);
        int pc = f.ParamCount;
        TypedReg[] map = new TypedReg[f.MaxReg + 2];   // dst id -> src TypedReg（直接映射）
        // 收集合格 copy
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int ii = 0;
            while (ii < blk.InstrCount) {
                if (blk.Instrs[ii] is CopyInstr) {
                    CopyInstr c = blk.Instrs[ii] as CopyInstr;
                    int d = c.Dst.Id;
                    if (d >= pc && d >= 0 && d < map.Length && defs[d] == 1
                        && d != c.Src.Id && IrOptPipeline._stable(c.Src, defs, pc)) {
                        map[d] = c.Src;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        // 链式解析：map[d] 可能又指向被映射的 id → 跟到最终
        TypedReg[] res = new TypedReg[map.Length];
        int r = 0;
        while (r < map.Length) {
            if (map[r] != null) {
                TypedReg cur = map[r];
                int guard = 0;
                while (cur.Id >= 0 && cur.Id < map.Length && map[cur.Id] != null && guard < map.Length) {
                    cur = map[cur.Id]; guard = guard + 1;
                }
                res[r] = cur;
            }
            r = r + 1;
        }
        if (!IrOptPipeline._anyNonNull(res)) { return; }
        // 改写所有读操作数 + 终结子
        bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int ii = 0;
            while (ii < blk.InstrCount) { IrOptInfo.ReplaceReads(blk.Instrs[ii], res); ii = ii + 1; }
            if (blk.HasTerm) { IrOptInfo.ReplaceTermReads(blk.Term, res); }
            bi = bi + 1;
        }
        // 删已死 copy（dst 被映射的那些——使用点已全改写 → dst 零读）
        bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int keep = 0;
            int ii = 0;
            while (ii < blk.InstrCount) {
                if (!IrOptPipeline._isMappedCopy(blk.Instrs[ii], map)) { keep = keep + 1; }
                ii = ii + 1;
            }
            if (keep != blk.InstrCount) {
                IrInstr[] nw = new IrInstr[keep];
                int j = 0;
                ii = 0;
                while (ii < blk.InstrCount) {
                    if (!IrOptPipeline._isMappedCopy(blk.Instrs[ii], map)) { nw[j] = blk.Instrs[ii]; j = j + 1; }
                    ii = ii + 1;
                }
                blk.Instrs = nw;
                blk.InstrCount = keep;
            }
            bi = bi + 1;
        }
    }

    // ── pass: CSE 公共子表达式消除（add-cse-pass）──────────────────────────────────
    // 块内 value-number：`op|操作数ids` 首现记 dst；同 key 复现 → 记 dupDst→firstDst 映射，
    // 之后用 ReplaceReads 全函数把 dupDst 使用点改写为 firstDst、删重复计算指令。
    // 块内检测（同块 firstDst 在前 → 支配 dupDst 及其所有使用点，值恒等）；跨块不做（避支配分析）。
    private static void _passCse(IrFunction f) {
        int[] defs = IrOptPipeline._computeDefs(f);
        int pc = f.ParamCount;
        TypedReg[] remap = new TypedReg[f.MaxReg + 2];   // dupDst id -> firstDst
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            StrMap seen = new StrMap();   // value-number key -> firstDst TypedReg
            int ii = 0;
            while (ii < blk.InstrCount) {
                string key = IrOptInfo.CseKey(blk.Instrs[ii], defs, pc);
                if (key != null) {
                    if (seen.ContainsKey(key)) {
                        TypedReg first = seen.Get(key) as TypedReg;
                        TypedReg dup = IrOptInfo.DstReg(blk.Instrs[ii]);
                        if (dup != null && first != null && dup.Id != first.Id
                            && dup.Id >= 0 && dup.Id < remap.Length) {
                            remap[dup.Id] = first;
                        }
                    } else {
                        seen.Put(key, IrOptInfo.DstReg(blk.Instrs[ii]));
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        if (!IrOptPipeline._anyNonNull(remap)) { return; }
        // 改写所有 dupDst 使用点 → firstDst
        bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int ii = 0;
            while (ii < blk.InstrCount) { IrOptInfo.ReplaceReads(blk.Instrs[ii], remap); ii = ii + 1; }
            if (blk.HasTerm) { IrOptInfo.ReplaceTermReads(blk.Term, remap); }
            bi = bi + 1;
        }
        // 删重复计算指令（dst 在 remap = dup）
        bi = 0;
        while (bi < f.BlockCount) {
            IrBlock blk = f.Blocks[bi];
            int keep = 0;
            int ii = 0;
            while (ii < blk.InstrCount) { if (!IrOptPipeline._isRemappedDst(blk.Instrs[ii], remap)) { keep = keep + 1; } ii = ii + 1; }
            if (keep != blk.InstrCount) {
                IrInstr[] nw = new IrInstr[keep];
                int j = 0;
                ii = 0;
                while (ii < blk.InstrCount) {
                    if (!IrOptPipeline._isRemappedDst(blk.Instrs[ii], remap)) { nw[j] = blk.Instrs[ii]; j = j + 1; }
                    ii = ii + 1;
                }
                blk.Instrs = nw;
                blk.InstrCount = keep;
            }
            bi = bi + 1;
        }
    }

    // 该指令的 dst（仅 CSE-able op 有）是否为被映射的重复计算 → 应删。
    private static bool _isRemappedDst(IrInstr ins, TypedReg[] remap) {
        TypedReg d = IrOptInfo.DstReg(ins);
        if (d == null) { return false; }
        return d.Id >= 0 && d.Id < remap.Length && remap[d.Id] != null;
    }

    // src 稳定：形参须从不被重写（defs==0）；temp/local 须单赋值（defs==1）。
    private static bool _stable(TypedReg r, int[] defs, int paramCount) {
        int id = r.Id;
        if (id < 0 || id >= defs.Length) { return false; }
        if (id < paramCount) { return defs[id] == 0; }
        return defs[id] == 1;
    }

    private static bool _anyNonNull(TypedReg[] a) {
        int i = 0;
        while (i < a.Length) { if (a[i] != null) { return true; } i = i + 1; }
        return false;
    }

    // 是否为「被映射（要删）的 copy」：CopyInstr 且其 Dst 在 map 中。
    private static bool _isMappedCopy(IrInstr ins, TypedReg[] map) {
        if (!(ins is CopyInstr)) { return false; }
        int d = (ins as CopyInstr).Dst.Id;
        return d >= 0 && d < map.Length && map[d] != null;
    }

    // ── pass 2: temp-DCE ─────────────────────────────────────────────────────────
    private static void _passTempDce(IrFunction f, int[] reads) {
        int bi = 0;
        while (bi < f.BlockCount) {
            IrOptPipeline._dceBlock(f.Blocks[bi], reads);
            bi = bi + 1;
        }
    }

    private static void _dceBlock(IrBlock blk, int[] reads) {
        int keep = 0;
        int i = 0;
        while (i < blk.InstrCount) {
            if (!IrOptPipeline._isDead(blk.Instrs[i], reads)) { keep = keep + 1; }
            i = i + 1;
        }
        if (keep == blk.InstrCount) { return; }
        IrInstr[] nw = new IrInstr[keep];
        int j = 0;
        i = 0;
        while (i < blk.InstrCount) {
            if (!IrOptPipeline._isDead(blk.Instrs[i], reads)) { nw[j] = blk.Instrs[i]; j = j + 1; }
            i = i + 1;
        }
        blk.Instrs = nw;
        blk.InstrCount = keep;
    }

    // 死 = 纯（可删白名单）+ 有 Dst + Dst 全函数零读（reads 已含参数 live-out 种子 → 参数不会判死）。
    private static bool _isDead(IrInstr ins, int[] reads) {
        if (!IrOptInfo.IsPure(ins)) { return false; }
        int d = IrOptInfo.DstId(ins);
        if (d < 0 || d >= reads.Length) { return false; }
        return reads[d] == 0;
    }
}
