// attribute-handler-registry PR3a —— 编译期 analyzer 驱动。
//
// 契约在 z42c.syntax（Analysis.z42：Analyzer / DiagSink / DiagRule / SyntaxKind）。本文件是**驱动侧
// 具体实现**（z42c.semantics）：遍历 CompilationUnit 的语法节点，对每个 analyzer 声明观察（ObservedKinds）
// 的节点调用 analyzer.OnSyntaxNode，把回调报告的诊断映射进编译器 DiagnosticBag。
//
// visitor 模型（无 delegate）：z42 自举编译器刻意规避 delegate + 命名 delegate 跨 zpkg 丢 FQ 名（见
// Analysis.z42 头注），故契约与驱动全走**接口派发 + 纯虚调用**——driver 侧零 delegate / 零闭包，
// analyzer 侧也无需 lambda。发现 / 加载外部 analyzer zpkg 见 [analyzers] 段（后续增量）；本增量的驱动
// 机制由单测（tests/analyzer）直接喂 analyzer 实例验证。
//
// 设计 SoT：docs/spec/changes/attribute-handler-registry/design.md §Analyzer 接口 / §Pipeline。
namespace Z42.Semantics;

using Z42.Core;     // Diagnostic / DiagnosticBag / DiagnosticSeverity / Span
using Z42.Syntax;   // Analyzer / DiagSink / DiagRule / SyntaxKind / AST / FixSink / CodeFix / TextEdit
using Std.IO;       // File —— PR7-wire `--fix` 就地重写源（z42.io 已在 semantics 传递闭包：→z42.ir→z42.io）

// DiagSink 具体实现：analyzer 报告 → 编译器 DiagnosticBag。severity 决策经 LintConfig（PR3b）：
// EnabledByDefault + [lints] 覆盖 + 通配 + warnings-as-errors → 最终级别；抑制（规则禁用 / "none"）
// 则整条丢弃、不进 bag。Hidden 暂并入 Info（--fix 消费留后续）。
//
// PR7-wire：同时实现 FixSink——analyzer 命中问题时经 `diags as FixSink` 下转、调 ReportFix 报诊断 +
// 附修复。DiagSinkImpl 既是 DiagSink 又是 FixSink → analyzer 的 `if (diags is FixSink)` 分支恒真、走
// ReportFix；host 无 --fix 能力（Collect=false）时 ReportFix 仍照常报诊断、只是不收编辑（优雅回落）。
public sealed class DiagSinkImpl : DiagSink, FixSink {
    public DiagnosticBag Bag;
    public LintConfig Cfg;
    public SuppressionSet Supp;   // PR3c：局部抑制（`#suppress` 字节区间 + `[Suppress]` 声明活跃栈）
    // PR7-wire：`--fix` 激活时收集编辑（可增长数组，_push idiom 非 List）。Collect=false（非 --fix）→
    // ReportFix 只报诊断、不收编辑。
    public bool Collect;
    public TextEdit[] Fixes;
    public int FixCount;
    public DiagSinkImpl(DiagnosticBag bag, LintConfig cfg, SuppressionSet supp, bool collect) {
        this.Bag = bag; this.Cfg = cfg; this.Supp = supp;
        this.Collect = collect;
        this.Fixes = new TextEdit[0];
        this.FixCount = 0;
    }

    public void Report(DiagRule rule, Span at) {
        this._report(rule, at);
    }

    // FixSink：报诊断（同 Report 的抑制/severity 策略）**并**——仅当诊断真正报出（未抑制/未禁用）且
    // `--fix` 激活（Collect）——收集该修复的编辑。抑制/禁用的诊断不产生修复（不改用户已抑制的代码）。
    public void ReportFix(DiagRule rule, Span at, CodeFix fix) {
        if (this._report(rule, at) && this.Collect) {
            int k = 0;
            while (k < fix.EditCount) { this._pushFix(fix.Edits[k]); k = k + 1; }
        }
    }

    // 报诊断共用体：抑制/禁用 → 返 false（未报）；否则加入 bag 返 true。ReportFix 据此决定收不收编辑。
    private bool _report(DiagRule rule, Span at) {
        // PR3c：局部抑制优先——命中即整条丢弃、不进 bag（早于 severity 决策，省一次 Resolve）。
        if (this.Supp.IsSuppressed(rule.Id, at.Start)) { return false; }
        int eff = this.Cfg.Resolve(rule);
        if (eff < 0) { return false; }   // 抑制（规则禁用 / [lints] "none"）→ 不报
        int sev = AnalyzerDriver._mapSeverity(eff);
        this.Bag.Add(new Diagnostic(sev, rule.Id, rule.MessageFormat, at));
        return true;
    }

    private void _pushFix(TextEdit e) {
        if (this.FixCount >= this.Fixes.Length) {
            int newcap = this.Fixes.Length == 0 ? 4 : this.Fixes.Length * 2;
            TextEdit[] bigger = new TextEdit[newcap];
            int i = 0;
            while (i < this.FixCount) { bigger[i] = this.Fixes[i]; i = i + 1; }
            this.Fixes = bigger;
        }
        this.Fixes[this.FixCount] = e;
        this.FixCount = this.FixCount + 1;
    }
}

public static class AnalyzerDriver {
    // 对一组 analyzer 跑一遍：逐个遍历 CU、对命中 ObservedKinds 的节点调 OnSyntaxNode。诊断汇入同一
    // bag。analyzer 顺序 = 调用方给定（外部加载时按 zpkg 稳定键 sort，common-pitfalls §1）。
    // cfg = [lints] 决策器（severity 覆盖 + EnabledByDefault 门 + WAE）；null → LintConfig.Empty()
    // （无覆盖、无 WAE，仅按规则 EnabledByDefault + DefaultSeverity）。
    // attribute-handler-registry PR7-wire —— `--fix` 接线本体（support 阶段此重载是空转桩，现填入实逻辑）。
    // fix=true（`z42c build --fix`）→ 建 collect 型 sink，走完 CU 后就地重写源文件（_applyFixes）。
    // fix=false → 等价 5-参（不收编辑）。签名与 support 登记的一致（种子已含）→ pipeline 直接调本 6-参
    // **零新跨成员符号**；FixSink/CodeFix/TextEdit 已随 support 的 nightly 进种子 → syntax→semantics 解析安全。
    public static void Run(Analyzer[] analyzers, int analyzerCount, CompilationUnit cu, DiagnosticBag bag, LintConfig cfg, bool fix) {
        if (cfg == null) { cfg = LintConfig.Empty(); }
        // PR3c：建局部抑制集。① `#suppress`/`#restore` 字节区间（parser 收集，挂 cu.SuppressRegions）。
        //       ② `[Suppress]` 声明活跃栈由 walk 期间 push/pop 填充（见 _walkDecl）。
        SuppressionSet supp = new SuppressionSet();
        int r = 0;
        while (r < cu.SuppressRegionCount) {
            SuppressRegion sr = cu.SuppressRegions[r];
            supp.AddRegion(sr.RuleId, sr.Start, sr.End);
            r = r + 1;
        }
        DiagSinkImpl sink = new DiagSinkImpl(bag, cfg, supp, fix);
        int i = 0;
        while (i < analyzerCount) {
            Analyzer a = analyzers[i];
            int[] kinds = a.ObservedKinds();
            AnalyzerDriver._walkCu(cu, a, kinds, sink, supp);   // walk 平衡 push/pop，跨 analyzer 复用同一 supp
            i = i + 1;
        }
        // PR7-wire：`--fix` 激活 → 就地应用收集的编辑（一 CU=一源文件，所有编辑同 At.File）。
        if (fix && sink.FixCount > 0) { AnalyzerDriver._applyFixes(sink.Fixes, sink.FixCount); }
    }

    // 5-参重载（无 --fix）：委托 6-参、fix=false。既有调用方（analyzer_tests 单测）不变。
    public static void Run(Analyzer[] analyzers, int analyzerCount, CompilationUnit cu, DiagnosticBag bag, LintConfig cfg) {
        AnalyzerDriver.Run(analyzers, analyzerCount, cu, bag, cfg, false);
    }

    // PR7-wire：就地应用编辑到源文件。所有编辑同一文件（一 CU=一源，design D4）→ 读一次、降序 splice、
    // 写回。用 String.Substring 而非字节操作：Span.Start/End 源自 Lexer._pos（CharAt 字符索引推进），
    // splice 必须用同一字符串 API 保持偏移一致（Span.z42 注「byte offset」是 C# 镜像语义，z42 侧为字符串索引）。
    private static void _applyFixes(TextEdit[] edits, int count) {
        AnalyzerDriver._sortEditsDesc(edits, count);
        string file = edits[0].At.File;
        string src = File.ReadAllText(file);
        int i = 0;
        while (i < count) {
            TextEdit e = edits[i];
            src = src.Substring(0, e.At.Start) + e.NewText + src.Substring(e.At.End);
            i = i + 1;
        }
        File.WriteAllText(file, src);
    }

    // 按 At.Start 降序插入排序（就地）——降序应用使靠前编辑不移位靠后编辑的偏移。
    private static void _sortEditsDesc(TextEdit[] edits, int count) {
        int i = 1;
        while (i < count) {
            TextEdit key = edits[i];
            int j = i - 1;
            while (j >= 0 && edits[j].At.Start < key.At.Start) {
                edits[j + 1] = edits[j];
                j = j - 1;
            }
            edits[j + 1] = key;
            i = i + 1;
        }
    }

    // ── AST 遍历：抵达已定义 SyntaxKind 的节点即分派（PR3a 只到语句层，不入 Expr）──────────────
    private static void _walkCu(CompilationUnit cu, Analyzer a, int[] kinds, DiagSink sink, SuppressionSet supp) {
        int i = 0;
        while (i < cu.DeclCount) {
            AnalyzerDriver._walkDecl(cu.Decls[i], a, kinds, sink, supp);
            i = i + 1;
        }
    }

    // 进声明前 push 本声明的 `[Suppress]`（若有），walk 内层，退出即 pop——活跃栈精确圈定 [Suppress] 子树
    // （规避 decl.Span 只覆盖首 token 的问题，见 SuppressionSet 头注）。pop 保证与 push 平衡。
    private static void _walkDecl(Decl d, Analyzer a, int[] kinds, DiagSink sink, SuppressionSet supp) {
        int pushed = 0;
        if (d is AttributedDecl) { pushed = AnalyzerDriver._pushSuppress(d as AttributedDecl, supp); }
        AnalyzerDriver._walkDeclInner(AnalyzerDriver._unwrap(d), a, kinds, sink, supp);
        supp.PopActive(pushed);
    }

    private static void _walkDeclInner(Decl inner, Analyzer a, int[] kinds, DiagSink sink, SuppressionSet supp) {
        if (inner is ClassDecl) {
            ClassDecl c = inner as ClassDecl;
            AnalyzerDriver._dispatch(SyntaxKind.ClassDecl, c, a, kinds, sink);
            int i = 0;
            while (i < c.MemberCount) {
                AnalyzerDriver._walkDecl(c.Members[i], a, kinds, sink, supp);   // 嵌套类型 + 方法
                i = i + 1;
            }
            return;
        }
        if (inner is MethodDecl) {
            MethodDecl m = inner as MethodDecl;
            AnalyzerDriver._dispatch(SyntaxKind.MethodDecl, m, a, kinds, sink);
            if (m.HasBody) { AnalyzerDriver._walkStmt(m.Body, a, kinds, sink); }
            return;
        }
    }

    // 剥 AttributedDecl 外壳（`[X]` 应用），拿内层真声明——镜像 SymbolCollector._unwrap。
    private static Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { return (d as AttributedDecl).Inner; }
        return d;
    }

    // 读 AttributedDecl 上的 `[Suppress("Id", ...)]` 并 push 活跃栈；返回 push 条数（供退出时 pop）。
    // `[Suppress]` 是 PR3c directive（纯编译期，不持久化）；这里从 AST 按名读、取首参字符串字面量为 RuleId。
    private static int _pushSuppress(AttributedDecl ad, SuppressionSet supp) {
        int pushed = 0;
        int i = 0;
        while (i < ad.AttrCount) {
            Attr at = ad.Attrs[i];
            if (HandlerRegistry.IsSuppressDirective(at.Name) && at.ArgCount >= 1) {
                if (at.Args[0] is StringLitExpr) {
                    string id = Lexer.DecodeString((at.Args[0] as StringLitExpr).Raw);
                    if (id != "") { supp.PushActive(id); pushed = pushed + 1; }
                }
            }
            i = i + 1;
        }
        return pushed;
    }

    private static void _walkStmt(Stmt s, Analyzer a, int[] kinds, DiagSink sink) {
        if (s == null) { return; }
        if (s is BlockStmt) {
            BlockStmt b = s as BlockStmt;
            int i = 0;
            while (i < b.Count) { AnalyzerDriver._walkStmt(b.Stmts[i], a, kinds, sink); i = i + 1; }
            return;
        }
        if (s is IfStmt) {
            IfStmt f = s as IfStmt;
            AnalyzerDriver._walkStmt(f.Then, a, kinds, sink);
            if (f.HasElse) { AnalyzerDriver._walkStmt(f.Else, a, kinds, sink); }
            return;
        }
        if (s is WhileStmt) {
            WhileStmt w = s as WhileStmt;
            AnalyzerDriver._dispatch(SyntaxKind.WhileStmt, w, a, kinds, sink);
            AnalyzerDriver._walkStmt(w.Body, a, kinds, sink);
            return;
        }
        if (s is ForStmt) {
            ForStmt fo = s as ForStmt;
            AnalyzerDriver._dispatch(SyntaxKind.ForStmt, fo, a, kinds, sink);
            if (fo.HasInit) { AnalyzerDriver._walkStmt(fo.Init, a, kinds, sink); }
            AnalyzerDriver._walkStmt(fo.Body, a, kinds, sink);
            return;
        }
        if (s is ForeachStmt) {
            AnalyzerDriver._walkStmt((s as ForeachStmt).Body, a, kinds, sink);
            return;
        }
        if (s is DoWhileStmt) {
            AnalyzerDriver._walkStmt((s as DoWhileStmt).Body, a, kinds, sink);
            return;
        }
        if (s is SwitchStmt) {
            SwitchStmt sw = s as SwitchStmt;
            int i = 0;
            while (i < sw.CaseCount) {
                SwitchCase cs = sw.Cases[i];
                int j = 0;
                while (j < cs.BodyCount) { AnalyzerDriver._walkStmt(cs.Body[j], a, kinds, sink); j = j + 1; }
                i = i + 1;
            }
            return;
        }
        if (s is TryCatchStmt) {
            TryCatchStmt t = s as TryCatchStmt;
            AnalyzerDriver._dispatch(SyntaxKind.TryCatchStmt, t, a, kinds, sink);
            AnalyzerDriver._walkStmt(t.TryBody, a, kinds, sink);
            int i = 0;
            while (i < t.CatchCount) {
                CatchClause cc = t.Catches[i];
                AnalyzerDriver._dispatch(SyntaxKind.CatchClause, cc, a, kinds, sink);
                AnalyzerDriver._walkStmt(cc.Body, a, kinds, sink);
                i = i + 1;
            }
            if (t.HasFinally) { AnalyzerDriver._walkStmt(t.Finally, a, kinds, sink); }
            return;
        }
        // 其余语句（Expr/Return/VarDecl/Throw/Break/Continue/LocalFunction）无子语句 → PR3a 无需深入。
    }

    // 分派：节点 kind 在 analyzer 的 ObservedKinds 内即调 OnSyntaxNode（纯虚接口调用，无 delegate）。
    private static void _dispatch(int kind, object node, Analyzer a, int[] kinds, DiagSink sink) {
        if (AnalyzerDriver._observes(kinds, kind)) {
            a.OnSyntaxNode(kind, node, sink);
        }
    }

    private static bool _observes(int[] kinds, int kind) {
        int i = 0;
        while (i < kinds.Length) {
            if (kinds[i] == kind) { return true; }
            i = i + 1;
        }
        return false;
    }

    // AnalyzerSeverity（Hidden0/Info1/Warning2/Error3）→ DiagnosticSeverity（Error0/Warning1/Info2）。
    public static int _mapSeverity(int analyzerSev) {
        if (analyzerSev >= AnalyzerSeverity.Error) { return DiagnosticSeverity.Error; }
        if (analyzerSev == AnalyzerSeverity.Warning) { return DiagnosticSeverity.Warning; }
        return DiagnosticSeverity.Info;   // Info + Hidden（PR3a 暂并入）
    }
}
