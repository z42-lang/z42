// add-struct-value-semantics P1 阶段 1：struct 字节精确布局计算。
//
// 为每个 struct 类型计算「字节扁平布局」：每个直接字段的 (byte_offset, size, kind)、类型总 size/align，
// 以及**带种类的引用叶子表**（供 GC 根扫描 + StructCopy/析构按种类分流：Arc 计数 / GcRef 屏障 / 纯基元 memcpy）。
//
// 纯计算模块（不耦合 AST/符号表）：输入是 name→StructFieldsDef（struct 类型的字段名+声明类型名，声明序），
// 由 IrGen 从 ClassDecls 抽取、单测直接构造。ABI 约定见 docs/spec/changes/add-struct-value-semantics/design.md
// 子决策 #2：基元字节精确（char=4B Unicode 标量）、引用叶子=16B 托管句柄（object/array/string/interface/func）。
namespace Z42.Semantics;
using Z42.IR;   // StrMap

// 叶子/字段的存储种类（z42 无 enum → static class + int 常量）。
public static class StructLeafKind {
    public static int Prim      = 0;   // 纯字节基元（可 memcpy，无 clone/drop/屏障）
    public static int ArcString = 1;   // string（Arc<str> 16B）：copy=Arc::clone 计数+1、drop=计数-1
    public static int GcRef     = 2;   // object/array/interface/func（GcRef 16B）：copy=位拷+GC 写屏障
    public static int Struct    = 3;   // 嵌套 struct（递归展平；本身不是叶子，其叶子并入父布局）
}

// 一个 struct 类型的原始字段定义（名 + 声明类型名，声明序）。IrGen 从 ClassDecl 抽取；单测直接构造。
public sealed class StructFieldsDef {
    public string[] FieldNames;
    public string[] FieldTypeNames;
    public int      FieldCount;
    public StructFieldsDef() {
        this.FieldNames = new string[0];
        this.FieldTypeNames = new string[0];
        this.FieldCount = 0;
    }
    public void Add(string name, string typeName) {
        if (this.FieldCount == this.FieldNames.Length) {
            int cap = this.FieldNames.Length * 2;
            if (cap == 0) { cap = 4; }
            string[] nn = new string[cap]; string[] nt = new string[cap];
            int i = 0;
            while (i < this.FieldCount) { nn[i] = this.FieldNames[i]; nt[i] = this.FieldTypeNames[i]; i = i + 1; }
            this.FieldNames = nn; this.FieldTypeNames = nt;
        }
        this.FieldNames[this.FieldCount] = name;
        this.FieldTypeNames[this.FieldCount] = typeName;
        this.FieldCount = this.FieldCount + 1;
    }
}

// 计算好的一个 struct 类型布局。
public sealed class StructLayoutInfo {
    public string TypeName;
    public int    Size;    // 总字节数（对齐后）
    public int    Align;   // = 最大成员对齐
    // 直接字段（codegen 算 lvalue 地址 `obj.f` / 递归 `line.a.x`）：
    public string[] FieldNames; public int[] FieldOffsets; public int[] FieldSizes; public int[] FieldKinds; public string[] FieldTypeNames; public int FieldCount;
    // 扁平引用叶子（GC 位图 + StructCopy/析构分流）：byte offset + 种类（ArcString / GcRef）。
    public int[] RefLeafOffsets; public int[] RefLeafKinds; public int RefLeafCount;
    public StructLayoutInfo(string typeName) {
        this.TypeName = typeName; this.Size = 0; this.Align = 1;
        this.FieldNames = new string[0]; this.FieldOffsets = new int[0]; this.FieldSizes = new int[0];
        this.FieldKinds = new int[0]; this.FieldTypeNames = new string[0]; this.FieldCount = 0;
        this.RefLeafOffsets = new int[0]; this.RefLeafKinds = new int[0]; this.RefLeafCount = 0;
    }
    public void AddField(string name, int off, int size, int kind, string typeName) {
        if (this.FieldCount == this.FieldNames.Length) {
            int cap = this.FieldNames.Length * 2; if (cap == 0) { cap = 4; }
            string[] nn = new string[cap]; int[] no = new int[cap]; int[] ns = new int[cap]; int[] nk = new int[cap]; string[] ntn = new string[cap];
            int i = 0;
            while (i < this.FieldCount) { nn[i] = this.FieldNames[i]; no[i] = this.FieldOffsets[i]; ns[i] = this.FieldSizes[i]; nk[i] = this.FieldKinds[i]; ntn[i] = this.FieldTypeNames[i]; i = i + 1; }
            this.FieldNames = nn; this.FieldOffsets = no; this.FieldSizes = ns; this.FieldKinds = nk; this.FieldTypeNames = ntn;
        }
        this.FieldNames[this.FieldCount] = name; this.FieldOffsets[this.FieldCount] = off; this.FieldSizes[this.FieldCount] = size; this.FieldKinds[this.FieldCount] = kind; this.FieldTypeNames[this.FieldCount] = typeName;
        this.FieldCount = this.FieldCount + 1;
    }
    public void AddRefLeaf(int off, int kind) {
        if (this.RefLeafCount == this.RefLeafOffsets.Length) {
            int cap = this.RefLeafOffsets.Length * 2; if (cap == 0) { cap = 4; }
            int[] no = new int[cap]; int[] nk = new int[cap];
            int i = 0;
            while (i < this.RefLeafCount) { no[i] = this.RefLeafOffsets[i]; nk[i] = this.RefLeafKinds[i]; i = i + 1; }
            this.RefLeafOffsets = no; this.RefLeafKinds = nk;
        }
        this.RefLeafOffsets[this.RefLeafCount] = off; this.RefLeafKinds[this.RefLeafCount] = kind;
        this.RefLeafCount = this.RefLeafCount + 1;
    }
}

// 布局计算器。按需计算 + 缓存；用「在途集」检测递归自含值字段（无限大小 → C# CS0523 同款）。
public sealed class StructLayout {
    private StrMap _defs;         // name → StructFieldsDef（仅 struct/record 类型）
    private StrMap _cache;        // name → StructLayoutInfo
    private StrMap _inProgress;   // name → "1"（环检测在途集）
    // add-struct-heap-inline (P3b)：非-struct class 的字段定义 + 其**合成内联布局**缓存。
    // 内联布局 = class 的 blob-struct 字段内联进堆对象字节区（ScriptObject::struct_bytes）的对象相对布局
    // （每内联字段 byte offset + 合成引用位图）。writer（ClassDescBuilder，本阶段）与 codegen
    // （ExprEmitter，stage 4）**同源**取此布局 → 对象相对 offset 一致。
    private StrMap _classDefs;    // className → StructFieldsDef（非-struct class）
    private StrMap _inlineCache;  // className → StructLayoutInfo（合成内联布局）
    // unify-object-byte-layout PR-1：非-struct 引用类的**对象全字段布局**（8B 引用，休眠元数据）+
    // 内联 struct 字段扁平所需的 8B 引用 struct 展平布局缓存。
    private StrMap _objectCache;       // className → StructLayoutInfo（对象全字段布局，8B 引用）
    private StrMap _objStructCache;    // structName → StructLayoutInfo（8B 引用 struct 展平布局）
    private StrMap _objStructInProgress; // 8B struct 布局环检测在途集
    public string  ErrorType;    // 非 "" → 检测到递归自含（诊断码 E0416 由持 DiagnosticBag 的调用方发）
    public string  ErrorCycle;   // 环路径描述（诊断信息用）

    public StructLayout(StrMap defs) {
        this._defs = defs;
        this._cache = new StrMap();
        this._inProgress = new StrMap();
        this._classDefs = new StrMap();
        this._inlineCache = new StrMap();
        this._objectCache = new StrMap();
        this._objStructCache = new StrMap();
        this._objStructInProgress = new StrMap();
        this.ErrorType = "";
        this.ErrorCycle = "";
    }

    // 从符号表构建：抽取所有 struct（Z42ClassType.IsStruct）的字段定义（OwnFieldNames=名、
    // OwnFieldSpellings=类型名，声明序）→ 预计算全部布局。ErrorType 反映任何递归自含。
    // 尚未被 IrGen 调用（阶段 2 codegen 消费时接线）；诊断（E0416）待值语义生效时再发（避免误杀当前
    // 合法的引用语义自引用 struct）。
    public static StructLayout BuildFromSymbols(SymbolTable table) {
        StrMap defs = new StrMap();
        StrMap classDefs = new StrMap();   // add-struct-heap-inline (P3b)：非-struct class 字段定义
        string[] keys = table.Classes.Keys();
        int i = 0;
        while (i < keys.Length) {
            Z42ClassType ct = table.GetClass(keys[i]);
            if (ct != null) {
                StructFieldsDef def = new StructFieldsDef();
                int j = 0;
                while (j < ct.OwnFieldCount) {
                    def.Add(ct.OwnFieldNames[j], ct.OwnFieldSpellings[j]);
                    j = j + 1;
                }
                // unify-value-types Phase 1：**Scalar 基元 wrapper（Int32/Boolean/Char…）虽 IsStruct=true，
                // 但绝不作为 blob struct 布局类型**——它们是裸 Value 标量（Repr=Scalar，不进字节 arena）。
                // 否则（Canon 收敛后 Int32→"i32"）`int` 字段的 _kindOf 会误判为嵌套 struct（IsStructType("int")
                // ＝ ContainsKey("i32")）→ 布局尺寸/偏移全错。排除后 int 字段走 _isPrim → Prim 叶子（正确）。
                if (ct.IsStruct && !PrimModel.IsScalarValue(keys[i])) { defs.Put(Z42Type.Canon(keys[i]), def); }
                else if (!ct.IsStruct) { classDefs.Put(Z42Type.Canon(keys[i]), def); }
            }
            i = i + 1;
        }
        StructLayout sl = new StructLayout(defs);
        string[] dkeys = defs.Keys();
        int k = 0;
        while (k < dkeys.Length) { sl.LayoutOf(dkeys[k]); k = k + 1; }   // 预计算 struct 布局 + 填缓存
        // add-struct-heap-inline (P3b)：struct 布局就绪后，为每个非-struct class 预计算合成内联布局
        // （内联字段的对象相对 byte offset + 合成引用位图）。无内联字段的 class 得空布局（FieldCount 0）。
        sl._classDefs = classDefs;
        string[] ckeys = classDefs.Keys();
        int m = 0;
        while (m < ckeys.Length) { sl._computeInlineLayout(ckeys[m]); m = m + 1; }
        // unify-object-byte-layout PR-1：为每个非-struct class 预计算**对象全字段布局**（8B 引用）。
        // 休眠元数据（本 PR 只随 zbc 携带、runtime 不消费）；无字段的 class 得空布局（FieldCount 0）。
        int n = 0;
        while (n < ckeys.Length) { sl._computeObjectLayout(ckeys[n]); n = n + 1; }
        return sl;
    }

    // 某类型名是不是 struct（值类型）。
    public bool IsStructType(string typeName) {
        return this._defs.ContainsKey(Z42Type.Canon(typeName));
    }

    // A-use codegen flip 谓词：某类型是否翻转到 **blob 值语义**（emit StructAlloc/Copy/FieldGet/SetPrim）。
    // = IsStruct 且**多叶子复合**（FieldCount>=2）。单标量叶子 struct（GCHandle=1×i64+FFI / 单字段 wrapper）
    // 与 phantom 基元（int/bool/char=Z42PrimType，根本不到这）保持现有模型（标量塌缩=Phase B）。
    // z42c/stdlib 零生产多字段 struct → flip 纯增量。
    public bool IsBlobStruct(string typeName) {
        if (!this.IsStructType(typeName)) { return false; }
        StructLayoutInfo li = this.LayoutOf(typeName);
        if (li.FieldCount < 2) { return false; }
        // add-struct-nested-fields：嵌套 struct 字段（Line{a:P,b:P}）现予接受——布局早已递归展平其叶子
        // （_compute），codegen 沿成员链累积 byte offset 发射 StructFieldGet/SetPrim（整字段走逐叶子复制）。
        // 防护：自引用/环 struct 的布局是空兜底（Size 0，见 LayoutOf 的 _inProgress 环检测 + E0438 诊断）——
        // 不准入，避免 0 字节 blob 的字段访问越界。
        if (li.Size == 0) { return false; }
        return true;
    }

    // unify-value-types Phase 1：值类型表示 Repr。返回 "Scalar" / "Blob" / ""（非值类型）。
    // Scalar = 六个基元 wrapper（PrimModel.IsScalarValue：整数族/f32/f64/bool/char，裸 Value 承载不进 arena）；
    // Blob = 多字段复合值 struct（IsBlobStruct，字节 arena）。用户单字段 struct 与 phantom 零字段 wrapper
    // 之外的退化 struct 暂归 ""（单标量叶子塌缩 = Phase 4）。codegen 据此分派：Scalar 走 PrimTag/裸算术/
    // __box_prim；Blob 走 StructAlloc/StructCopy/__box_struct。
    public string ReprOf(string typeName) {
        if (PrimModel.IsScalarValue(typeName)) { return "Scalar"; }
        if (this.IsBlobStruct(typeName)) { return "Blob"; }
        return "";
    }

    // struct 直接字段的 byte offset（未找到 -1）。供 codegen 烘焙 StructFieldGet/SetPrim 立即数。
    public int FieldByteOffset(string structName, string fieldName) {
        StructLayoutInfo li = this.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) { if (li.FieldNames[i] == fieldName) { return li.FieldOffsets[i]; } i = i + 1; }
        return -1;
    }

    // struct 直接字段的声明类型名（未找到 ""）。供 codegen 算运行期 TypeTag（Tag.FromName）。
    public string FieldTypeName(string structName, string fieldName) {
        StructLayoutInfo li = this.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) { if (li.FieldNames[i] == fieldName) { return li.FieldTypeNames[i]; } i = i + 1; }
        return "";
    }

    // struct 直接字段是否本身也是 blob struct（嵌套值字段：读/写走区间复制而非 prim；A-use 首版暂不支持嵌套，
    // 调用方据此回退/报错，避免误当 prim 读单叶子）。
    public bool FieldIsStruct(string structName, string fieldName) {
        StructLayoutInfo li = this.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) { if (li.FieldNames[i] == fieldName) { return li.FieldKinds[i] == StructLeafKind.Struct; } i = i + 1; }
        return false;
    }

    // struct 总字节大小（供 StructAlloc 立即数）。
    public int StructSize(string structName) {
        return this.LayoutOf(structName).Size;
    }

    // ── add-struct-heap-inline (P3b)：class 合成内联布局 ─────────────────────────────
    //
    // 一个非-struct class 把它的 **blob-struct 字段** 内联进堆对象字节区（`ScriptObject::struct_bytes`）。
    // 合成内联布局 = 逐字段（仅 IsBlobStruct 的）按对齐排布得每内联字段的**对象相对 byte offset** +
    // 把其引用叶子按 `字段 offset + 叶子 offset` 平移进合成引用位图。writer（ClassDescBuilder，写 zbc 1.32
    // 内联块）与 codegen（ExprEmitter stage 4，烘焙 StructFieldGet/SetPrim 立即数）同调此表 → offset 一致。

    // 计算某非-struct class 的合成内联布局并缓存（BuildFromSymbols 预计算调用）。
    private void _computeInlineLayout(string className) {
        object d = this._classDefs.Get(className);
        if (!(d is StructFieldsDef)) { return; }
        StructFieldsDef def = d as StructFieldsDef;
        StructLayoutInfo info = new StructLayoutInfo(className);
        int offset = 0;
        int maxAlign = 1;
        int i = 0;
        while (i < def.FieldCount) {
            string ftype = def.FieldTypeNames[i];
            if (this.IsBlobStruct(ftype)) {
                StructLayoutInfo sub = this.LayoutOf(ftype);
                int align = sub.Align;
                if (align == 0) { align = 1; }   // 空/环兜底
                offset = StructLayout._alignUp(offset, align);
                info.AddField(def.FieldNames[i], offset, sub.Size, StructLeafKind.Struct, ftype);
                int k = 0;
                while (k < sub.RefLeafCount) {
                    info.AddRefLeaf(offset + sub.RefLeafOffsets[k], sub.RefLeafKinds[k]);
                    k = k + 1;
                }
                offset = offset + sub.Size;
                if (align > maxAlign) { maxAlign = align; }
            }
            i = i + 1;
        }
        info.Align = maxAlign;
        info.Size = StructLayout._alignUp(offset, maxAlign);
        this._inlineCache.Put(className, info);
    }

    // 某 class 的合成内联布局（无内联字段 → 空布局 FieldCount 0 / Size 0）。
    public StructLayoutInfo InlineLayoutOf(string className) {
        object c = this._inlineCache.Get(Z42Type.Canon(className));
        if (c is StructLayoutInfo) { return c as StructLayoutInfo; }
        return new StructLayoutInfo(Z42Type.Canon(className));
    }

    // 某 class 是否有内联 struct 字段（→ 设 CLASS_FLAG_HAS_INLINE_STRUCT + emit 内联块）。
    public bool HasInlineFields(string className) {
        return this.InlineLayoutOf(className).FieldCount > 0;
    }

    // 某内联 struct 字段在对象字节区的对象相对 byte offset（**非**内联 struct 字段返 -1）。
    // 供 codegen（stage 4）烘焙，同时作 `_isOwnerInlineField`/`_isInlineStructFieldRoot` 的判据
    // （`>= 0` ⟺「是内联 struct 字段」）。
    //
    // unify-object-byte-layout PR-2：**判据仍走 InlineLayoutOf**（只含 struct 字段，非 struct 字段
    // 不在其中 → 返 -1 → 判据 false → 走普通 FieldGet，绝不能误判基元/引用字段为内联 struct）；但
    // 确认是内联 struct 字段后，返回的 **offset 改用 ObjectLayoutOf**（struct 字段夹在全部直接字段间的
    // composed 对象布局 offset）——runtime 现把所有字段字节内联进 ScriptObject.bytes，struct 字段字节
    // 窗口起点 = 其对象布局 offset。（无 base 类时 = composed offset；含 base 字段的派生类 base-shift
    // 组合见后续。）
    public int InlineFieldByteOffset(string className, string fieldName) {
        // 判据：仅内联 struct 字段（InlineLayoutOf）才有内联 offset。
        StructLayoutInfo inl = this.InlineLayoutOf(className);
        bool found = false;
        int i = 0;
        while (i < inl.FieldCount) { if (inl.FieldNames[i] == fieldName) { found = true; break; } i = i + 1; }
        if (!found) { return -1; }
        // offset：取对象全字段布局中该 struct 字段的 composed offset。
        StructLayoutInfo obj = this.ObjectLayoutOf(className);
        int j = 0;
        while (j < obj.FieldCount) { if (obj.FieldNames[j] == fieldName) { return obj.FieldOffsets[j]; } j = j + 1; }
        return -1;
    }

    // ── unify-object-byte-layout PR-1：对象全字段布局（8B 引用，休眠元数据）───────────
    //
    // 一个非-struct 引用类的**全部直接字段**（基元 + 引用 + 内联 struct）的对象相对字节布局：
    // per-field (offset, size, kind) 供 FieldGet/反射；扁平引用位图（含内联 struct 内部叶子）供 GC。
    // 引用叶子按**8B 裸指针**算（终点 C# 布局；runtime 消费在 PR-2/3，本 PR 仅携带不消费）。
    // offset 从 0 起（本类 OWN 区）；继承 base-shift 由消费方（PR-2）组合（镜像 fields=base++own）。

    // 引用宽度 8B 版 _sizeOf（对象布局终点；基元宽度不变）。
    private int _objSizeOf(string typeName, int kind) {
        if (kind == StructLeafKind.ArcString || kind == StructLeafKind.GcRef) { return 8; }
        return this._sizeOf(typeName, kind);
    }

    // 8B 引用版 struct 展平布局（内联 struct 字段扁平进对象布局时用）。twin of LayoutOf/_compute，
    // 但引用叶子 8B。环检测在途集独立于 16B 版（_objStructInProgress），命中返回空布局打断递归。
    private StructLayoutInfo _objLayoutOfStruct(string structName) {
        string key = Z42Type.Canon(structName);
        object cached = this._objStructCache.Get(key);
        if (cached is StructLayoutInfo) { return cached as StructLayoutInfo; }
        if (this._objStructInProgress.ContainsKey(key)) { return new StructLayoutInfo(key); }
        object d = this._defs.Get(key);
        if (!(d is StructFieldsDef)) { return new StructLayoutInfo(key); }
        StructFieldsDef def = d as StructFieldsDef;
        this._objStructInProgress.Put(key, "1");
        StructLayoutInfo info = this._computeObjFields(key, def);
        this._objStructCache.Put(key, info);
        return info;
    }

    // 布局主算法（8B 引用版）：逐字段按对齐排布，累积 size/align，展平引用叶子（含嵌套/内联 struct）。
    // 与 _compute 同形，差异仅：引用叶子用 _objSizeOf（8B）、嵌套 struct 递归走 _objLayoutOfStruct（8B）。
    private StructLayoutInfo _computeObjFields(string typeName, StructFieldsDef def) {
        StructLayoutInfo info = new StructLayoutInfo(typeName);
        int offset = 0;
        int maxAlign = 1;
        int i = 0;
        while (i < def.FieldCount) {
            string fname = def.FieldNames[i];
            string ftype = def.FieldTypeNames[i];
            int kind = this._kindOf(ftype);
            int size = 0;
            int align = 0;
            if (kind == StructLeafKind.Struct) {
                // unify-object-byte-layout PR-2：内联 struct 字段用**16B 引用版** struct 布局
                // （LayoutOf/_compute），使对象里的 struct 字段字节布局与独立 struct（arena/装箱/
                // struct[]）**逐字节一致**——runtime 反射（compute 16B）读对象内联 struct 字段、装箱成
                // BoxedStruct 直接拷字节即可，无需 8B↔16B 转换；嵌套 struct 的引用叶子 offset 亦一致。
                // （PR-1 曾用 8B 版 _objLayoutOfStruct 作「8B 终点」休眠元数据，但 PR-2 引用仍 16B、
                // struct 各处均 16B，8B 版会与之错位 → 反射 nested ref offset 对不上位图。8B 终点留 PR-3
                // 统一压缩：对象+struct 布局+侧表一起转 8B。）
                StructLayoutInfo nested = this.LayoutOf(ftype);
                size = nested.Size;
                align = nested.Align;
                if (align == 0) { align = 1; }   // 空/环兜底
                offset = StructLayout._alignUp(offset, align);
                info.AddField(fname, offset, size, kind, ftype);
                int k = 0;
                while (k < nested.RefLeafCount) {
                    info.AddRefLeaf(offset + nested.RefLeafOffsets[k], nested.RefLeafKinds[k]);
                    k = k + 1;
                }
            } else {
                size = this._objSizeOf(ftype, kind);
                align = this._alignOf(kind, size);
                offset = StructLayout._alignUp(offset, align);
                info.AddField(fname, offset, size, kind, ftype);
                if (kind == StructLeafKind.ArcString || kind == StructLeafKind.GcRef) {
                    info.AddRefLeaf(offset, kind);   // 引用叶子入位图（8B，带种类）
                }
            }
            offset = offset + size;
            if (align > maxAlign) { maxAlign = align; }
            i = i + 1;
        }
        info.Align = maxAlign;
        info.Size = StructLayout._alignUp(offset, maxAlign);
        return info;
    }

    // 计算并缓存某非-struct class 的对象全字段布局（BuildFromSymbols 预计算调用）。
    private void _computeObjectLayout(string className) {
        object d = this._classDefs.Get(className);
        if (!(d is StructFieldsDef)) { return; }
        StructFieldsDef def = d as StructFieldsDef;
        StructLayoutInfo info = this._computeObjFields(className, def);
        this._objectCache.Put(className, info);
    }

    // 某非-struct class 的对象全字段布局（无缓存 → 空布局 FieldCount 0 / Size 0）。
    public StructLayoutInfo ObjectLayoutOf(string className) {
        object c = this._objectCache.Get(Z42Type.Canon(className));
        if (c is StructLayoutInfo) { return c as StructLayoutInfo; }
        return new StructLayoutInfo(Z42Type.Canon(className));
    }

    // 某 class 是否有对象布局（有直接字段 → 设 CLASS_FLAG_HAS_OBJECT_LAYOUT + emit 对象块）。
    public bool HasObjectLayout(string className) {
        return this.ObjectLayoutOf(className).FieldCount > 0;
    }

    // 计算（或取缓存）某 struct 类型的布局。环检测命中 → 记 ErrorType 并返回空布局（size 0）打断递归。
    public StructLayoutInfo LayoutOf(string typeName) {
        string key = Z42Type.Canon(typeName);
        object cached = this._cache.Get(key);
        if (cached is StructLayoutInfo) { return cached as StructLayoutInfo; }
        if (this._inProgress.ContainsKey(key)) {
            // 递归自含值字段：struct 直接/间接把自身作为**值**字段 → 无限大小。
            if (this.ErrorType == "") { this.ErrorType = key; this.ErrorCycle = key; }
            return new StructLayoutInfo(key);   // 空布局打断递归（不入缓存）
        }
        object d = this._defs.Get(key);
        if (!(d is StructFieldsDef)) {
            // 非 struct 类型不该走这里；返回空布局兜底（调用方应先 IsStructType 判定）。
            return new StructLayoutInfo(key);
        }
        StructFieldsDef def = d as StructFieldsDef;
        // 环检测在途集：标记 key「计算中」。无需在结束时移除——LayoutOf 先查 _cache 再查 _inProgress，
        // 计算完成后 key 已入 cache，后续调用命中 cache 提前返回，永不重入 _inProgress 检查（StrMap 无 Remove）。
        this._inProgress.Put(key, "1");
        StructLayoutInfo info = this._compute(key, def);
        this._cache.Put(key, info);
        return info;
    }

    // 布局主算法：逐字段按对齐排布，累积 size/align，展平引用叶子。
    private StructLayoutInfo _compute(string typeName, StructFieldsDef def) {
        StructLayoutInfo info = new StructLayoutInfo(typeName);
        int offset = 0;
        int maxAlign = 1;
        int i = 0;
        while (i < def.FieldCount) {
            string fname = def.FieldNames[i];
            string ftype = def.FieldTypeNames[i];
            int kind = this._kindOf(ftype);
            int size = 0;
            int align = 0;
            if (kind == StructLeafKind.Struct) {
                StructLayoutInfo nested = this.LayoutOf(ftype);
                size = nested.Size;
                align = nested.Align;
                if (align == 0) { align = 1; }   // 空/环兜底
                offset = StructLayout._alignUp(offset, align);
                info.AddField(fname, offset, size, kind, ftype);
                // 嵌套 struct 的引用叶子并入父布局（偏移平移）。
                int k = 0;
                while (k < nested.RefLeafCount) {
                    info.AddRefLeaf(offset + nested.RefLeafOffsets[k], nested.RefLeafKinds[k]);
                    k = k + 1;
                }
            } else {
                size = this._sizeOf(ftype, kind);
                align = this._alignOf(kind, size);
                offset = StructLayout._alignUp(offset, align);
                info.AddField(fname, offset, size, kind, ftype);
                if (kind == StructLeafKind.ArcString || kind == StructLeafKind.GcRef) {
                    info.AddRefLeaf(offset, kind);   // 引用叶子入位图（带种类）
                }
            }
            offset = offset + size;
            if (align > maxAlign) { maxAlign = align; }
            i = i + 1;
        }
        info.Align = maxAlign;
        info.Size = StructLayout._alignUp(offset, maxAlign);
        return info;
    }

    // 字段类型名 → 存储种类（ABI 子决策 #2）。
    private int _kindOf(string typeName) {
        if (this.IsStructType(typeName)) { return StructLeafKind.Struct; }
        string c = Z42Type.Canon(typeName);
        if (c == "string") { return StructLeafKind.ArcString; }
        if (StructLayout._isPrim(c)) { return StructLeafKind.Prim; }
        // 数组 / 非-struct class / interface / func / unknown → 16B GcRef 托管句柄。
        return StructLeafKind.GcRef;
    }

    // 基元字节大小（char=4B Unicode 标量）。
    private int _sizeOf(string typeName, int kind) {
        if (kind == StructLeafKind.ArcString || kind == StructLeafKind.GcRef) { return 16; }
        string c = Z42Type.Canon(typeName);
        if (c == "i8" || c == "u8" || c == "bool") { return 1; }
        if (c == "i16" || c == "u16") { return 2; }
        if (c == "i32" || c == "u32" || c == "f32" || c == "char") { return 4; }
        if (c == "i64" || c == "u64" || c == "f64") { return 8; }
        return 8;   // 未知基元兜底（不该发生）
    }

    // 对齐：基元=自然对齐(=size)；引用=8。
    private int _alignOf(int kind, int size) {
        if (kind == StructLeafKind.ArcString || kind == StructLeafKind.GcRef) { return 8; }
        return size;
    }

    private static bool _isPrim(string canon) {
        return canon == "i8" || canon == "u8" || canon == "i16" || canon == "u16"
            || canon == "i32" || canon == "u32" || canon == "i64" || canon == "u64"
            || canon == "f32" || canon == "f64" || canon == "bool" || canon == "char";
    }

    // off 向上取整到 align 的倍数（align 为 2 的幂或任意正整数皆可）。
    private static int _alignUp(int off, int align) {
        if (align <= 1) { return off; }
        int rem = off % align;
        if (rem == 0) { return off; }
        return off + (align - rem);
    }
}
