// 转换 / 基元分类纯谓词（compiler-review P1-1 step5：拆 TypeChecker God-Class 的
// 「ConversionChecker」片——无状态叶子助手集中到 static class，供各子绑定器 + Facade 共用。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR.BinaryFormat;

public static class TypeFactsTc {

    public static string _operatorMethodNameTc(string op) {
        if (op == "+") { return "op_Add"; }
        if (op == "-") { return "op_Subtract"; }
        if (op == "*") { return "op_Multiply"; }
        if (op == "/") { return "op_Divide"; }
        if (op == "%") { return "op_Modulo"; }
        // add-comparison-operators：比较/相等/位运算符重载派发名（对齐 C#，与 MemberParser._operatorMethodName
        // 声明侧一致）。无 op_X 方法的类型（裸数值、无重载类）由 _bindBinary 的 _resolveOverload 返回 null
        // 回落 BinaryTypeTable（引用相等 / 原生比较），故非重载类型零行为变化。
        if (op == "==") { return "op_Equality"; }
        if (op == "!=") { return "op_Inequality"; }
        if (op == "<")  { return "op_LessThan"; }
        if (op == ">")  { return "op_GreaterThan"; }
        if (op == "<=") { return "op_LessThanOrEqual"; }
        if (op == ">=") { return "op_GreaterThanOrEqual"; }
        if (op == "&")  { return "op_BitwiseAnd"; }
        if (op == "|")  { return "op_BitwiseOr"; }
        if (op == "^")  { return "op_ExclusiveOr"; }
        if (op == "<<") { return "op_LeftShift"; }
        if (op == ">>") { return "op_RightShift"; }
        return "";
    }

    // 转发到规范实现（IrGenFacts._hasWord）——原本是 `(" "+mods+" ").IndexOf(" "+w+" ")`，
    // 每次调用拼两个新串。对非空 w 语义等价（都要求整词、两侧是空格或串边界）。
    public static bool _hasWordTc(string mods, string w) { return IrGenFacts._hasWord(mods, w); }

    public static Z42Type _floatLitType(string text) {
        int n = text.Length;
        if (n > 0) {
            char last = text.CharAt(n - 1);
            if (last == 'f' || last == 'F') { return Z42ClassType.Builtin("float"); }
        }
        return Z42ClassType.Builtin("double");
    }

    // 可赋性判定：委托给统一转换分类器（add-conversion-classifier PR1）。ImplicitOkPermissive()
    // 的白名单与本函数改动前的分支逐位等价（error/unknown 吸收、泛型擦除、任意→object、结构可赋、
    // 继承/接口上转、数值双向放行含窄化），故此改动 byte-identical。PR2 收紧时改分类器的门，非此处。
    public static bool _isAssignable(Z42Type from, Z42Type to, SymbolTable symbols) {
        return Conversion.Classify(from, to, symbols).ImplicitOk();   // tighten-implicit-conversions T4：收紧门（剔除 ExplicitNumeric）
    }

    public static string _primWrapper(string n) {
        if (n == "int") { return "Int32"; }
        if (n == "long") { return "Int64"; }
        if (n == "short") { return "Int16"; }
        if (n == "sbyte")  { return "SByte"; }
        if (n == "byte")  { return "Byte"; }
        if (n == "ushort") { return "UInt16"; }
        if (n == "uint") { return "UInt32"; }
        if (n == "ulong") { return "UInt64"; }
        if (n == "float") { return "Single"; }
        if (n == "double") { return "Double"; }
        if (n == "bool") { return "Boolean"; }
        if (n == "char") { return "Char"; }
        if (n == "string") { return "String"; }
        return TypeFactsTc._capFirst(n);   // 其它（已是 PascalCase 或未知）→ 首字母大写回退
    }

    public static bool _isPrimKeyword(string n) {
        if (n == "int")  { return true; }
        if (n == "long")  { return true; }
        if (n == "short")  { return true; }
        if (n == "sbyte")   { return true; }
        if (n == "byte")   { return true; }
        if (n == "ushort")  { return true; }
        if (n == "uint")  { return true; }
        if (n == "ulong")  { return true; }
        if (n == "float")  { return true; }
        if (n == "double")  { return true; }
        if (n == "bool"   || n == "char") { return true; }
        if (n == "string") { return true; }
        return false;
    }

    public static bool _isNumericPrim(string n) {
        if (n == "int")  { return true; }
        if (n == "long")  { return true; }
        if (n == "short")  { return true; }
        if (n == "sbyte")   { return true; }
        if (n == "byte")   { return true; }
        if (n == "ushort")  { return true; }
        if (n == "uint")  { return true; }
        if (n == "ulong")  { return true; }
        if (n == "float")  { return true; }
        if (n == "double")  { return true; }
        if (n == "char") { return true; }
        return false;
    }

    public static string _capFirst(string name) {
        if (name.Length == 0) { return name; }
        string head = name.Substring(0, 1).ToUpper();
        return head + name.Substring(1, name.Length - 1);
    }

    public static Z42Type _commonType(Z42Type a, Z42Type b, SymbolTable symbols) {
        if (TypeFactsTc._isAssignable(a, b, symbols)) { return b; }
        if (TypeFactsTc._isAssignable(b, a, symbols)) { return a; }
        return a;
    }

}