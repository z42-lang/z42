// 泛型约束检查器（port-z42c-semantics 2B）。从 TypeChecker 抽出，隔离约束逻辑
// （概念上镜像 C# 的 TypeChecker.Generics.cs partial；z42 无 partial → 独立委托类）。
//
// 两个职责：
//   · Resolve（Pass 0.5，镜像 C# ResolveAllWhereConstraints）：逐泛型类 where 子句 → ConstraintSet
//     登记进符号表；声明期诊断（未知型参 E0401 / class·struct 互斥 E0402）。
//   · Check（call-site，镜像 C# ValidateGenericConstraints）：泛型实例化 new Box<int>() 逐
//     (型参约束 bundle, 实参) 校验；违反报 E0402。
//
// 已校验：base-class / class / struct / 型参引用 where U:T / **interface**（含继承闭包）/
//         **enum** / **new()** —— 与运行期 validate_type_arg_constraint 的七项对齐。
//         **func-type**（validate-func-type-constraint：E0422 签名不符 / E0423 与其它约束并置）——
//         这一项运行期**没有**对应判定，只在编译期、只对本包声明的约束生效，见 _checkFuncConstraint。
//
// **跨包约束（add-associated-types PR-1）**：此前「跨包 100% 不校验」——`ClassConstraints` 的唯一
// 写入点只遍历本包 CU 的 ClassDecl，导入类型全程不碰，`Check` 第一行 `HasConstraints` 即返回。
// 现已接通：zbc TYPE 段的约束 bundle → ZbcReader → TsigReconcile → ExportedClassZ →
// ImportedSymbolLoader._constraintSetOf → SymbolTable.ClassConstraints（键统一走 ConstraintKey）。
// 本包与导入走**同一个** _checkBundle，判定口径完全一致。
//
// 落地强度：complete-where-constraints 那轮定的「先 warning 探针再翻 error」在本项目**收不到数据**——
// z42c.driver Main.z42 的诊断呈现被 `if (art.ErrorCount > 0)` 整体门控，warning 在 CLI 上根本不打印
// （analyzer 警告同病）。故改为直接以 error 落地 + 跑完整 GREEN：全绿即零违反，证据强于看不见的
// warning。驱动隐藏 warning 本身是独立缺陷，已登记 Deferred。
//
// 🔴 DRAFT 风险表那条「基元 wrapper 归一偏差 → `Dictionary<int,int>` 编不过 → 自举链断」正是在
// 这一轮首次被真正触及（上一轮零误报只覆盖同包、不构成跨包证据）。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;

public sealed class ConstraintChecker {
    private DiagnosticBag _diags;
    public ConstraintChecker(DiagnosticBag diags) { this._diags = diags; }

    // ════ Resolve（声明期 Pass 0.5）═══════════════════════════════════════════
    public void Resolve(CompilationUnit cu, SymbolTable symbols) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                // add-associated-types PR-1：条件由 `class || struct` 放宽到**含 interface**。此前
                // 泛型接口声明上的 where（`interface INumber<T> where T : INumber<T>`）根本不进约束
                // 模型 → 既无声明期诊断（型参写错/约束名拼错/class+struct 互斥全静默），也无从持久化
                // （ClassDescBuilder._interfaceDesc 只能建全空 bundle）。接口存独立表，见 SymbolTable。
                if (c.TypeParams.Count > 0 && c.WhereCount > 0) {
                    ConstraintSet cs = this._buildSet(symbols, c);
                    if (cs.AnyNonEmpty()) {
                        if (c.Kind == "interface") {
                            symbols.InterfaceConstraints.Put(c.Name, cs);
                        } else {
                            symbols.ClassConstraints.Put(symbols.ConstraintKey(c.Name, c.TypeParams.Count), cs);
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // 一个泛型类的 where 子句 → ConstraintSet（bundle 与型参声明序对齐）。
    private ConstraintSet _buildSet(SymbolTable symbols, ClassDecl c) {
        string[] pnames = c.TypeParams.Names;
        int pc = c.TypeParams.Count;
        ConstraintBundle[] bundles = new ConstraintBundle[pc];
        int b = 0;
        while (b < pc) { bundles[b] = new ConstraintBundle(); b = b + 1; }
        var cs = new ConstraintSet(pnames, bundles, pc);
        int w = 0;
        while (w < c.WhereCount) {
            WhereClause wc = c.Wheres[w];
            int pi = cs.IndexOf(wc.TypeParam);
            if (pi < 0) {
                this._diags.Error(DiagnosticCodes.UndefinedSymbol,
                    "where clause references unknown type parameter `" + wc.TypeParam + "` on `" + c.Name + "`",
                    wc.Span);
            } else {
                this._fillBundle(symbols, c.Name, bundles[pi], wc, pnames, pc);
            }
            w = w + 1;
        }
        return cs;
    }

    // 把一条 where 子句的各约束项填进 bundle。可行子集外的约束（interface/enum/new()/func/泛型 base）静默延后。
    // 类级与方法级**共用本函数**（此前是逐字重复的两份，改校验必须同时改两处 → 已合并）；
    // 差异只有 owner 名（类名 / 方法名），参数化即可。
    private void _fillBundle(SymbolTable symbols, string ownerName, ConstraintBundle bundle, WhereClause wc,
                             string[] pnames, int pc) {
        int k = 0;
        while (k < wc.Count) {
            WhereConstraint con = wc.Constraints[k];
            if (!con.IsType) {
                if (con.Special == "class")  { bundle.RequiresClass = true; }
                if (con.Special == "struct") { bundle.RequiresStruct = true; }
                if (con.Special == "enum")   { bundle.RequiresEnum = true; }
                if (con.Special == "new()")  { bundle.RequiresCtor = true; }
            } else if (con.Type is NamedType) {
                NamedType nt = con.Type as NamedType;
                if (this._indexOfName(pnames, pc, nt.Name) >= 0) {
                    bundle.HasTypeParamRef = true; bundle.TypeParamRef = nt.Name;
                } else if (symbols.HasInterface(nt.Name)) {
                    // 接口约束。**不加 ArgCount == 0 过滤**——全仓真实接口约束绝大多数是泛型接口
                    // （IEquatable<T> / IComparable<T> / INumber<T>），此前那个过滤在接口判定
                    // 之前就把它们整条丢弃，这才是接口约束全体静默的直接原因。
                    // 按裸名匹配（design D1）：`nt.Name` 已是裸名（泛型实参在 nt.Args）。
                    bundle.AddInterface(nt.Name);
                    // add-associated-types PR-3：接口约束的类型实参位可写 `Item = int` 命名绑定。
                    // 只收 AssocBindingType 那些实参（普通实参仍按 design D1 裸名匹配、被忽略）。
                    int ab = 0;
                    while (ab < nt.ArgCount) {
                        if (nt.Args[ab] is AssocBindingType) {
                            AssocBindingType abt = nt.Args[ab] as AssocBindingType;
                            Z42Type abResolved = symbols.ResolveTypeP(abt.Bound, pnames, pc);
                            bundle.AddAssocBinding(abt.Name, TypeNameResolver.SurfaceTypeName(abResolved));
                            // 绑定的名字必须真是该接口声明过的关联类型，否则是笔误 → 早报，别静默。
                            // 🔴 **跨包接口必须跳过**：导入侧的 `AssocTypeNames` 还没有 wire 来源、恒空
                            // ⇒ 不跳过则「另一个包里 `where T : IEnum<Item = int>`」这种完全合法的写法
                            // 会被判成「IEnum 没有关联类型 Item」——假红。这条守卫是
                            // `src/tests/cross-zpkg/assoc_type_cross_pkg/` 抓出来的（我最初只守了
                            // 使用点 `_checkAssocBinding` 与补齐强制，漏了这个**声明点**）。
                            // Deferred：`assoc-type-crosspkg`（独立 change，含双 bump）。
                            Z42InterfaceType abIface = symbols.GetInterface(nt.Name);
                            if (abIface != null && !abIface.IsImported && !abIface.HasAssocType(abt.Name)) {
                                this._diags.Error("E0453",
                                    "interface `" + nt.Name + "` has no associated type `" + abt.Name + "`",
                                    abt.Span);
                            }
                        }
                        ab = ab + 1;
                    }
                } else if (symbols.HasClass(nt.Name)) {
                    // 泛型 base（`where T : Box<int>`）仍只记裸名——本轮不校验其类型实参
                    // （与接口的裸名匹配同口径，design D1）。
                    bundle.HasBaseClass = true; bundle.BaseClassName = nt.Name;
                } else {
                    Z42Type conT = symbols.ResolveTypeP(con.Type, pnames, pc);
                    if (conT is Z42FuncType) {
                        // fix-func-constraint-reported-unknown：`where T : Action<int>` / `Func<int, R>` /
                        // `Predicate<U>` / 用户 `delegate` —— 这些是**函数类型**，`SymbolTable.ResolveTypeP`
                        // 把它们解析成结构化 `Z42FuncType`，**不进 Classes / Interfaces 表** ⇒ 上面两个分支
                        // 都不命中 ⇒ 掉进下面那条「多半是拼错了」，报 `E0443 unknown constraint type Action`。
                        //
                        // 但它们是**合法且被支持**的约束写法（add-generic-func-constraint，
                        // `src/tests/generics/func_constraint_*.z42` 正在用、运行期也正常）。所以那条 E0443
                        // 是**事实错误**的诊断，不是「该报而暂时不该报」——本分支把它们摘出来。
                        //
                        // ⚠️ 为什么当年的探针没发现：该错误分支落地时以 warning 跑全仓实测「0 条」，
                        // 而这三个受害文件全在 `src/tests/generics/`，走 `z42c --emit-zbc` —— 那条路
                        // 丢弃全部诊断。探针看不见的地方，"0 条" 不构成证据。
                        //
                        // **validate-func-type-constraint：校验已补齐**（E0422/E0423 从留号变成真发出）。
                        // 此前这里只是「摘出来什么也不做」⇒ 约束是**只被相信、从不被检查**的元数据：
                        // binder（`MemberResolver` 的 `Z42GenericParamType` 分支）按这条签名把 `t(args)`
                        // 绑成 CallIndirect 并推断结果类型，而没有任何一处核对实参真是这个签名。
                        // 实测后果：`where T : Action<int>` 传 `Func<string,int>` 编译干净、运行期
                        // `VCall: expected object, got I64(3)`（int 被喂进 string 形参）。
                        // 约束里的型参（`Func<int,R>` 的 R / `Predicate<U>` 的 U）原样存着，
                        // 到调用点再按已解析的类型实参代换，见 `_checkFuncConstraint`。
                        bundle.HasFuncType = true; bundle.FuncType = conT;
                    } else {
                        // 既不是型参、也不是已知接口/类/函数类型 —— 多半是把约束名拼错了（`where T : IFooo`）。
                        // 此前**完全静默**：写错名字等于没写约束，而使用者以为约束生效了。
                        //
                        // 曾担心误报（z42c **不把接口的定义 import 进符号表**——ImportedSymbolLoader，
                        // 会破坏 byte-identical——故 `where T : 某导入接口` 可能 HasInterface/HasClass
                        // 皆假）。以 warning 跑全仓 + 全 stdlib 探针实测 **0 条**，故升 error。
                        this._diags.Error(DiagnosticCodes.UndefinedType,
                            "unknown constraint type `" + nt.Name + "` on `" + ownerName + "`", con.Span);
                    }
                }
            } else {
                // **非 NamedType 的约束类型**——只有字面量函数类型 `(int) -> R` / `() -> void` 走到这里
                // （`FuncTypeExpr`，见 z42c.syntax/TypeExpr.z42）。此前整条 if 链**落空**：既不报
                // E0443，也不存任何东西 ⇒ `where T : (int) -> int` 是一条彻底的空约束。
                Z42Type litT = symbols.ResolveTypeP(con.Type, pnames, pc);
                if (litT is Z42FuncType) { bundle.HasFuncType = true; bundle.FuncType = litT; }
            }
            k = k + 1;
        }
        // v1：函数类型约束与其余七项**互斥**（2026-05-11 add-generic-func-constraint spec）。
        // 并置本身在今天是**静默无害**的（func 半边根本不校验），补上校验后它就成了一条语义未定义的
        // 写法——`where T : Func<int,int> + IDisposable` 要求 T 同时是结构化函数类型与实现某接口的类，
        // z42 的类型模型里没有这种东西。早报好过让它继续看起来合法。
        if (bundle.HasFuncType && !ConstraintChecker._onlyFuncType(bundle)) {
            this._diags.Error(DiagnosticCodes.InvalidFuncConstraint,
                "type parameter `" + wc.TypeParam + "` on `" + ownerName
                + "` cannot combine a function-type constraint with other constraints", wc.Span);
        }
        if (bundle.RequiresClass && bundle.RequiresStruct) {
            this._diags.Error(DiagnosticCodes.TypeMismatch,
                "type parameter `" + wc.TypeParam + "` cannot be both `class` and `struct` on `" + ownerName + "`",
                wc.Span);
        }
    }

    // ════ Check（call-site 校验）═══════════════════════════════════════════════
    // `sp` = 实例化点（`new Box<D>()` 的类型位）。此前全程 `_noSpan()` → 诊断指向 `<sem> 0:0`，
    // 使用者拿到一条不知道该看哪一行的错误（complete-where-constraints PR-4）。
    public void Check(SymbolTable symbols, Z42InstantiatedType inst, Span sp) {
        // 查询键必须经 ConstraintKey（与写入侧同一函数）——裸名查询会让同短名多 arity 的泛型类
        // 互相串味（`Foo<T>` 的实例化被拿去校验 `Foo<T,U>` 的约束）。见 SymbolTable.ConstraintKey。
        // `cname` 仍用**裸名**：它只流进诊断文案，用户不该看到 `Foo$2` 这种内部键。
        string cname = inst.Def.Name();
        string ckey = symbols.ConstraintKey(cname, inst.ArgCount);
        if (!symbols.HasConstraints(ckey)) { return; }
        ConstraintSet cs = symbols.GetConstraints(ckey);
        int n = inst.ArgCount;
        if (n > cs.Count) { n = cs.Count; }
        int i = 0;
        while (i < n) {
            ConstraintBundle b = cs.Bundles[i];
            if (!b.IsEmpty()) {
                this._checkBundle(symbols, cs.ParamNames, cs.Count, inst.TypeArgs, inst.ArgCount,
                                  b, inst.TypeArgs[i], cname, i, sp);
            }
            i = i + 1;
        }
    }

    // 逐 (bundle, 实参) 校验。类级与方法级**共用本函数**（此前是两份，差异仅「型参名/实参从
    // ConstraintSet+Z42InstantiatedType 取 还是 从平行数组取」+ 诊断 Span）——统一改用平行数组
    // + 显式 Span 参数，类级调用方把 cs.ParamNames / inst.TypeArgs 传进来即可，行为逐字等价。
    private void _checkBundle(SymbolTable symbols, string[] pnames, int pc, Z42Type[] args, int argCount,
                              ConstraintBundle b, Z42Type arg, string ownerName, int idx, Span sp) {
        string pn = pnames[idx];
        if (b.HasBaseClass && !this._satisfiesBase(symbols, arg, b.BaseClassName)) {
            this._err(arg, pn, b.BaseClassName, ownerName, sp);
        }
        if (b.RequiresClass && !this._isClassArg(arg)) {
            this._err(arg, pn, "class", ownerName, sp);
        }
        if (b.RequiresStruct && !this._isStructArg(arg)) {
            this._err(arg, pn, "struct", ownerName, sp);
        }
        if (b.HasTypeParamRef) {
            int j = this._indexOfName(pnames, pc, b.TypeParamRef);
            if (j >= 0 && j < argCount && !this._satisfiesParamRef(symbols, arg, args[j])) {
                this._err(arg, pn, b.TypeParamRef, ownerName, sp);
            }
        }
        int ii = 0;
        while (ii < b.InterfaceCount) {
            if (!this._satisfiesInterface(symbols, arg, b.InterfaceNames[ii])) {
                this._err(arg, pn, b.InterfaceNames[ii], ownerName, sp);
            }
            ii = ii + 1;
        }
        if (b.RequiresEnum && !this._isEnumArg(symbols, arg)) {
            this._err(arg, pn, "enum", ownerName, sp);
        }
        if (b.RequiresCtor && !this._hasNoArgCtor(symbols, arg)) {
            this._err(arg, pn, "new()", ownerName, sp);
        }
        // validate-func-type-constraint：函数类型约束。放在最后一组之前，与其余七项并列。
        if (b.HasFuncType) {
            this._checkFuncConstraint(symbols, pnames, pc, args, b.FuncType, arg, pn, ownerName, sp);
        }
        // add-associated-types PR-3：关联类型绑定要求 `where T : IEnum<Item = int>`。
        int ai = 0;
        while (ai < b.AssocBindingCount) {
            this._checkAssocBinding(symbols, arg, pn, b.AssocBindingNames[ai], b.AssocBindingTypeNames[ai], ownerName, sp);
            ai = ai + 1;
        }
    }

    // ════ 函数类型约束（validate-func-type-constraint）════════════════════════
    // `where T : Func<int,R>` / `Action<int>` / `Predicate<U>` / `(int) -> R` / 用户 delegate。
    //
    // 判定分三步：
    //   ① 约束里的型参按**本次调用已解析的类型实参**代换（`Predicate<U>` + U=int → `Predicate<int>`）。
    //      复用 `MethodTypeArgSubst.ByName`（它已有 Z42FuncType 分支）；代换不掉的位（类级型参等）
    //      留作**通配**，见 `_funcPosOk`。
    //   ② 实参必须是函数类型且 arity 相同。
    //   ③ 逐位比：形参位**逆变**（约束形参可传给实参形参 ⇒ 实参形参更宽）、返回位**协变**
    //      （实参返回可当约束返回用）。方向照 2026-05-11 spec 的四条 Scenario。
    //
    // 🔴 与其余七项不同，**运行期没有对应判定**（`generics.rs::validate_type_arg_constraint` 只有七项，
    // zbc 约束 flag 位也没有 func 签名槽）⇒ 本项只在编译期成立，且只对**本包声明**的约束生效：
    // 导入 bundle 恒无 func 约束（`ImportedSymbolLoader._constraintSetOf` 无从取值）⇒ 跨包天然跳过。
    // 这是「漏报」而非「假红」，与关联类型跨包同一取舍。
    private void _checkFuncConstraint(SymbolTable symbols, string[] pnames, int pc, Z42Type[] args,
                                      Z42Type want, Z42Type arg, string pn, string ownerName, Span sp) {
        // 信息不足一律放行（同 _satisfiesInterface / _isEnumArg）。
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return; }
        Z42Type w = MethodTypeArgSubst.ByName(want, pnames, pc, args);
        if (!(w is Z42FuncType)) { return; }        // 代换后不再是函数类型：不该发生，保守放行
        Z42FuncType wf = w as Z42FuncType;
        if (!(arg is Z42FuncType)) {
            this._errFunc(arg, pn, wf, ownerName, sp, "it is not a function type");
            return;
        }
        Z42FuncType af = arg as Z42FuncType;
        if (af.ParamCount != wf.ParamCount) {
            this._errFunc(arg, pn, wf, ownerName, sp,
                "it takes " + af.ParamCount.ToString() + " parameter(s), the constraint requires "
                + wf.ParamCount.ToString());
            return;
        }
        int i = 0;
        while (i < wf.ParamCount) {
            // 逆变：调用方按**约束**的形参类型传值，实参那份必须接得住 ⇒ 约束形参 <: 实参形参。
            if (!ConstraintChecker._funcPosOk(symbols, wf.ParamTypes[i], af.ParamTypes[i])) {
                this._errFunc(arg, pn, wf, ownerName, sp,
                    "parameter " + (i + 1).ToString() + " is `" + af.ParamTypes[i].Name()
                    + "`, the constraint requires it to accept `" + wf.ParamTypes[i].Name() + "`");
                return;
            }
            i = i + 1;
        }
        // 协变：实参返回的东西必须当得了约束声明的返回类型。
        if (!ConstraintChecker._funcPosOk(symbols, af.Ret, wf.Ret)) {
            this._errFunc(arg, pn, wf, ownerName, sp,
                "it returns `" + af.Ret.Name() + "`, the constraint requires `" + wf.Ret.Name() + "`");
        }
    }

    // 「sub 可当 sup 用」——用于函数位的单向判定（形参位传 (约束, 实参)，返回位传 (实参, 约束)）。
    // **信息不足一律放行**：任一侧仍是型参（代换不掉的类级型参 / `Self`）、或 error/unknown。
    // 数值拓宽**刻意不放行**：间接调用按槽位传值，`Func<int,long>` 与 `Func<int,int>` 不是一回事。
    private static bool _funcPosOk(SymbolTable symbols, Z42Type sub, Z42Type sup) {
        if (sub == null || sup == null) { return true; }
        if ((sub is Z42GenericParamType) || (sup is Z42GenericParamType)) { return true; }
        if ((sub is Z42ErrorType) || (sup is Z42ErrorType)) { return true; }
        if ((sub is Z42UnknownType) || (sup is Z42UnknownType)) { return true; }
        if (sub.CanonName() == sup.CanonName()) { return true; }
        string subName = ConstraintChecker._defName(sub);
        if (subName == "") { return false; }        // 数组 / func / void：只认同名
        if (sup is Z42InterfaceType) { return symbols.Implements(subName, sup.Name()); }
        if ((sup is Z42ClassType) || (sup is Z42InstantiatedType)) {
            return symbols.IsSubclassOf(subName, ConstraintChecker._defName(sup));
        }
        return false;
    }

    // 类 / 实例化类型 → 其类定义的裸名；其余（数组 / func / void / 型参）→ ""。
    private static string _defName(Z42Type t) {
        if (t is Z42ClassType) { return t.Name(); }
        if (t is Z42InstantiatedType) { return (t as Z42InstantiatedType).Def.Name(); }
        return "";
    }

    private void _errFunc(Z42Type arg, string pn, Z42FuncType want, string ownerName, Span sp, string why) {
        this._diags.Error(DiagnosticCodes.GenericFuncConstraintViolation,
            "type argument `" + arg.Name() + "` for `" + pn + "` does not satisfy function-type constraint `"
            + want.Name() + "` on `" + ownerName + "` — " + why, sp);
    }

    // bundle 里除 func 约束外一个都没有？（E0423 的判据）
    private static bool _onlyFuncType(ConstraintBundle b) {
        return !b.HasBaseClass && !b.RequiresClass && !b.RequiresStruct && !b.HasTypeParamRef
            && b.InterfaceCount == 0 && !b.RequiresEnum && !b.RequiresCtor && b.AssocBindingCount == 0;
    }

    // `where T : IEnum<Item = int>` —— 实参 T 的类必须给出 `type Item = int;` 且绑定类型一致。
    // 未解析型参 / error / unknown 一律放行（同 _satisfiesInterface：信息不足不误报）。
    private void _checkAssocBinding(SymbolTable symbols, Z42Type arg, string pn,
                                    string bindName, string wantType, string ownerName, Span sp) {
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return; }
        Z42ClassType cls = null;
        if (arg is Z42ClassType) { cls = arg as Z42ClassType; }
        else if (arg is Z42InstantiatedType) { cls = (arg as Z42InstantiatedType).Def; }
        if (cls == null) { return; }                       // 数组 / func / void：无处安放绑定，不误报
        // 🔴 跨包实参一律放行（本轮只落同包，见 tasks「范围裁决」）：类的关联类型绑定还没有 wire
        // 表示（要 zbc bit7 + 双格式 bump），导入类的 `AssocBindingCount` 恒为 0。若在这里照常校验，
        // 合法的跨包代码会被判成「未绑定」——**假红**，比漏报更糟。故按 `IsImported` 跳过，
        // 与 `_satisfiesInterface` 对信息不足者放行的既有口径一致。
        // Deferred：`assoc-type-crosspkg`（独立 change，含双 bump）。
        if (cls.IsImported) { return; }
        string got = cls.AssocBindingOf(bindName);
        if (got == "") {
            this._diags.Error("E0453",
                "type argument `" + arg.Name() + "` for `" + pn + "` on `" + ownerName
                + "` does not bind associated type `" + bindName + "`", sp);
            return;
        }
        if (PrimModel.Canon(got) != PrimModel.Canon(wantType)) {
            this._diags.Error("E0453",
                "type argument `" + arg.Name() + "` for `" + pn + "` on `" + ownerName
                + "` binds `" + bindName + "` to `" + got + "`, but `" + wantType + "` is required", sp);
        }
    }

    // where T : enum —— 运行期判据是 `td.is_enum()`；编译期对应 `symbols.EnumTypes`
    // （本地 + 导入两侧都 seed）。未解析型参 / error / unknown 按满足处理，同 _satisfiesInterface。
    private bool _isEnumArg(SymbolTable symbols, Z42Type arg) {
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return true; }
        return symbols.EnumTypes.ContainsKey(arg.Name());
    }

    // where T : new() —— 照抄运行期 `generics.rs`：
    //   · 基元满足；
    //   · 类实参须 **非 abstract**，且「有可用无参 ctor」——**完全没有显式 ctor 也算满足**
    //     （默认构造），只有「声明了 ctor 但没有一个能零实参调用」才不满足。
    // 「能零实参调用」的判据复用 ConstructTyper 的同款规则（params 变长 / 尾参带默认值都算）。
    // imported / 无 Decl 的 ctor 无法内省 → 不参与判定，避免误报。
    private bool _hasNoArgCtor(SymbolTable symbols, Z42Type arg) {
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return true; }
        Z42ClassType cls = null;
        if (arg is Z42ClassType) { cls = arg as Z42ClassType; }
        else if (arg is Z42InstantiatedType) { cls = (arg as Z42InstantiatedType).Def; }
        if (cls == null) { return false; }              // 数组 / func / void
        if (cls.IsScalarType()) { return true; }   // 基元恒满足（同运行期）
        if (cls.IsAbstract) { return false; }
        MethodSymbol[] ctors = cls.OverloadsOf(cls.Name());
        bool anyDeclared = false;
        int ci = 0;
        while (ci < ctors.Length) {
            MethodSymbol cm = ctors[ci];
            if (cm.HasDecl && cm.Decl != null) {
                anyDeclared = true;
                int pc = cm.Decl.ParamCount;
                bool isParams = pc > 0 && cm.Decl.Params[pc - 1].IsParams;
                if (isParams) {
                    if (pc - 1 <= 0) { return true; }   // `C(params T[] xs)` 可零实参
                } else {
                    bool ok = true;
                    int p = 0;
                    while (p < pc) { if (cm.Decl.Params[p].Default == null) { ok = false; } p = p + 1; }
                    if (ok) { return true; }            // 无参，或全部形参带默认值
                }
            }
            ci = ci + 1;
        }
        return !anyDeclared;   // 一个显式 ctor 都没有 → 默认构造 → 满足
    }

    // arg 满足接口约束（裸名匹配，design D1——不校验接口的类型实参，与运行期
    // `constraint_satisfied_by` 拿到的同样是常量池裸名，两边不产生分歧）。
    private bool _satisfiesInterface(SymbolTable symbols, Z42Type arg, string ifaceName) {
        if (arg is Z42ClassType) { return symbols.Implements(arg.Name(), ifaceName); }
        if (arg is Z42InstantiatedType) { return symbols.Implements((arg as Z42InstantiatedType).Def.Name(), ifaceName); }
        if (arg is Z42InterfaceType) {
            // 接口自身作实参：同名满足；否则沿父接口链判（IDerived 满足 IBase）。
            if (arg.Name() == ifaceName) { return true; }
            return symbols.InterfaceDerivesFrom(arg.Name(), ifaceName);
        }
        // 未解析的型参（`class Outer<T> { Box<T> b; }` 里的 T）：此处无从判定——T 的约束
        // 由 Outer 自己的实例化点校验。**按满足处理**，否则每个泛型类内部转发都会误报。
        if (arg is Z42GenericParamType) { return true; }
        // 数组 / func / void / error / unknown：不实现任何用户接口。error/unknown 已由别处报错，
        // 这里不叠加二次诊断。
        if ((arg is Z42ErrorType) || (arg is Z42UnknownType)) { return true; }
        return false;
    }

    private void _err(Z42Type arg, string param, string constraint, string owner, Span sp) {
        this._diags.Error(DiagnosticCodes.TypeMismatch,
            "type argument `" + arg.Name() + "` for `" + param + "` does not satisfy constraint `" + constraint + "` on `" + owner + "`",
            sp);
    }

    // arg 满足 base-class 约束：arg 是 baseName 或其子类（prim/array 不满足）。
    private bool _satisfiesBase(SymbolTable symbols, Z42Type arg, string baseName) {
        if (arg is Z42ClassType) { return symbols.IsSubclassOf(arg.Name(), baseName); }
        if (arg is Z42InstantiatedType) { return symbols.IsSubclassOf((arg as Z42InstantiatedType).Def.Name(), baseName); }
        return false;
    }

    // where U : T —— U 的实参须可赋给 T 的实参（同名 / 子类 / 数值拓宽）。
    private bool _satisfiesParamRef(SymbolTable symbols, Z42Type arg, Z42Type other) {
        if (arg.Name() == other.Name()) { return true; }
        if (other is Z42ClassType) {
            if (arg is Z42ClassType) { return symbols.IsSubclassOf(arg.Name(), other.Name()); }
            if (arg is Z42InstantiatedType) { return symbols.IsSubclassOf((arg as Z42InstantiatedType).Def.Name(), other.Name()); }
        }
        return arg.IsAssignableTo(other);
    }

    private bool _isClassArg(Z42Type arg) {
        // 阶段 3：翻转后 scalar 基元（int/bool/char…）为 Z42ClassType(Scalar)——**不满足 `where T : class`**
        // （值类型非引用）。故排除 IsScalarValue 的 ClassType；string/object（IsScalarValue=false，引用类型）
        // 与用户 class/instantiated 仍满足。翻转前 scalar 是 Z42PrimType（本就 `is Z42ClassType`=false 不满足），
        // 逐字节同义。
        if ((arg is Z42ClassType) && arg.IsScalarType()) { return false; }
        return (arg is Z42ClassType) || (arg is Z42InstantiatedType);
    }

    private bool _isStructArg(Z42Type arg) {
        // z42c 把基本类型当值类型；class/instantiated 为引用。
        // unify-value-types Phase 1（2.6 双路）：翻转后基元（int→Z42ClassType(Int32,Scalar)）仍算值类型——
        // 追加 Scalar 值类型判定（IsScalarValue 只认六个基元 wrapper，用户 struct 不命中，保持现行为）。
        // 翻转前无 Scalar 名 Z42ClassType 流经此处 → 当前中立。
        return (arg is Z42ClassType) && arg.IsScalarType();
    }

    // ════ 方法级 where 约束（add-generic-methods，call-site）═══════════════════════
    // 泛型方法调用 `Foo<A,B>(...)`：从 md.Wheres 建 bundle（对齐 md.TypeParams 声明序），逐
    // (型参约束, 解析后实参) 校验，违反报 E0402（复用 _satisfiesBase/_isClassArg 等，与类级同规则）。
    // 方法级形参无 ClassConstraints 存储（不预登记）→ 每调用点即席建 bundle（方法约束项少，成本低）。
    public void CheckMethod(SymbolTable symbols, MethodDecl md, Z42Type[] args, int argCount, Span sp) {
        if (md == null || md.WhereCount == 0) { return; }
        string[] pnames = md.TypeParams.Names;
        int pc = md.TypeParams.Count;
        ConstraintBundle[] bundles = new ConstraintBundle[pc];
        int b = 0;
        while (b < pc) { bundles[b] = new ConstraintBundle(); b = b + 1; }
        int w = 0;
        while (w < md.WhereCount) {
            WhereClause wc = md.Wheres[w];
            int pi = this._indexOfName(pnames, pc, wc.TypeParam);
            if (pi >= 0) { this._fillBundle(symbols, md.Name, bundles[pi], wc, pnames, pc); }
            w = w + 1;
        }
        int n = argCount; if (n > pc) { n = pc; }
        int i = 0;
        while (i < n) {
            ConstraintBundle bun = bundles[i];
            if (!bun.IsEmpty()) {
                this._checkBundle(symbols, pnames, pc, args, argCount, bun, args[i], md.Name, i, sp);
            }
            i = i + 1;
        }
    }

    private int _indexOfName(string[] pnames, int pc, string name) {
        int i = 0;
        while (i < pc) { if (pnames[i] == name) { return i; } i = i + 1; }
        return -1;
    }

    private Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { AttributedDecl ad = d as AttributedDecl; return ad.Inner; }
        return d;
    }

}
