// 语句绑定子绑定器（compiler-review P1-1：拆 TypeChecker God-Class step 3）。
// 持 TypeChecker 反向引用 _tc：跨界经 _tc._bindExpr/_tc._bindLambda（ExprTyper）、
// 共享状态 _tc._lambda*/_tc._loopDepth、叶子 _tc._isAssignable/_tc._requireBool/_tc._diags。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;

public sealed class StmtBinder {
    private TypeChecker _tc;
    public StmtBinder(TypeChecker tc) { this._tc = tc; }

    private BoundStmt _bindForeach(ForeachStmt fe, TypeEnv env, Z42Type ret) {
            TypeEnv feScope = env.PushScope();
            BoundExpr feIter = this._tc._expr._bindExpr(fe.Iter, feScope);
            // add-foreach-ienumerable：三-path 决策树的**第三 path（兜底）**——目标既非数组、也无
            // `get_Item`+`Count` 整数索引面，但暴露 `GetEnumerator()` → 走 IEnumerable 协议 path。
            // 实现（User 裁决改 Decision 7）：**binder 脱糖**成既有 AST
            //   { var __e = <Iter>.GetEnumerator();
            //     try { while (__e.MoveNext()) { <T> x = __e.Current; <Body> } }
            //     finally { __e.Dispose(); } }
            // 再走 _bindStmt → 复用 struct 值返回(sret)/try-finally 栈/break-continue/方法派发全部既有
            // lowering，零新 Bound 节点、零新 emitter。数组/索引两 path（下方原逻辑）完全不动 → byte-identical。
            {
                Z42Type ct0 = feIter.Type();
                Z42ClassType cd0 = null;
                if (ct0 is Z42ClassType) { cd0 = ct0 as Z42ClassType; }
                else if (ct0 is Z42InstantiatedType) { cd0 = (ct0 as Z42InstantiatedType).Def; }
                if (!(ct0 is Z42ArrayType) && cd0 != null && cd0.Methods.ContainsKey("GetEnumerator")) {
                    bool idxIter0 = cd0.Methods.ContainsKey("get_Item")
                        && (cd0.Fields.ContainsKey("Count") || cd0.Methods.ContainsKey("Count"));
                    if (!idxIter0) { return this._bindForeachEnumerable(fe, env, ret); }
                }
            }
            Z42Type feElem = new Z42UnknownType();
            bool feIsVar = (fe.Type is NamedType) && ((fe.Type as NamedType).Name == "var");
            if (feIsVar) {
                if (feIter.Type() is Z42ArrayType) { feElem = (feIter.Type() as Z42ArrayType).Elem; }
                else if (feIter.Type() is Z42ClassType) {
                    // class-iter：elem type from get_Item return type（镜像 C# ElemTypeOf）
                    Z42ClassType feCt = feIter.Type() as Z42ClassType;
                    if (feCt.Methods.ContainsKey("get_Item")) {
                        MethodSymbol feMs = feCt.Methods.Get("get_Item") as MethodSymbol;
                        if (feMs != null && feMs.Signature != null) { feElem = feMs.Signature.Ret; }
                    }
                }
            } else { feElem = feScope.ResolveType(fe.Type); }
            TypeEnv elemScope = feScope.PushScope();
            elemScope.Define(fe.Name, feElem);
            this._tc._loopDepth = this._tc._loopDepth + 1;
            BoundStmt febody = this._bindStmt(fe.Body, elemScope, ret);
            this._tc._loopDepth = this._tc._loopDepth - 1;
            // ClassIterTarget：class with get_Item + Count field or method（镜像 C# ClassIterTarget）
            bool feIsClassIter = false; bool feCountIsField = false;
            Z42Type feCollType = feIter.Type();
            Z42ClassType feClassDef = null;
            if (feCollType is Z42ClassType) { feClassDef = feCollType as Z42ClassType; }
            else if (feCollType is Z42InstantiatedType) { feClassDef = (feCollType as Z42InstantiatedType).Def; }
            if (feClassDef != null && feClassDef.Methods.ContainsKey("get_Item")) {
                if (feClassDef.Fields.ContainsKey("Count")) { feIsClassIter = true; feCountIsField = true; }
                else if (feClassDef.Methods.ContainsKey("Count")) { feIsClassIter = true; feCountIsField = false; }
            }
            return new BoundForeach(fe.Name, feElem, feIter, febody, feIsClassIter, feCountIsField, fe.Span);
    }

    // add-foreach-ienumerable：foreach-over-IEnumerable 脱糖（Decision 7 = binder 脱糖，User 裁定）。
    // 合成等价 AST 后交 _bindStmt——__e 是 GetEnumerator() 返回的具体 struct（pattern-based 无装箱，
    // Decision 8），MoveNext/Current/Dispose 直接在其上派发；try/finally 保证所有离开路径调 Dispose
    // （Decision 2）。__e 名以 span.Start 唯一化，避免函数级平表寄存器冲突（嵌套 foreach）。
    private BoundStmt _bindForeachEnumerable(ForeachStmt fe, TypeEnv env, Z42Type ret) {
            Span sp = fe.Span;
            string eName = "__fe_e_" + sp.Start.ToString();
            TypeExpr varTy = new NamedType("var", new TypeExpr[0], 0, sp);
            // var __e = <Iter>.GetEnumerator();
            Expr getEnum = new CallExpr(new MemberExpr(fe.Iter, "GetEnumerator", sp), new Expr[0], 0, sp);
            Stmt declE = new VarDeclStmt(varTy, eName, getEnum, sp);
            // while (__e.MoveNext()) { <fe.Type> <fe.Name> = __e.Current; <fe.Body> }
            Expr moveNext = new CallExpr(new MemberExpr(new IdentExpr(eName, sp), "MoveNext", sp), new Expr[0], 0, sp);
            Expr curGet = new MemberExpr(new IdentExpr(eName, sp), "Current", sp);   // 属性 getter → get_Current 虚调用
            Stmt declX = new VarDeclStmt(fe.Type, fe.Name, curGet, sp);
            Stmt[] whileBodyStmts = new Stmt[2];
            whileBodyStmts[0] = declX;
            whileBodyStmts[1] = fe.Body;
            Stmt whileBody = new BlockStmt(whileBodyStmts, 2, sp);
            Stmt whileStmt = new WhileStmt(moveNext, whileBody, sp);
            // try { <while> } finally { __e.Dispose(); }
            Expr disposeCall = new CallExpr(new MemberExpr(new IdentExpr(eName, sp), "Dispose", sp), new Expr[0], 0, sp);
            Stmt disposeStmt = new ExprStmt(disposeCall, sp);
            Stmt tryStmt = new TryCatchStmt(whileStmt, new CatchClause[0], 0, true, disposeStmt, sp);
            // { var __e = ...; try/finally }
            Stmt[] blockStmts = new Stmt[2];
            blockStmts[0] = declE;
            blockStmts[1] = tryStmt;
            Stmt block = new BlockStmt(blockStmts, 2, sp);
            return this._bindStmt(block, env, ret);
    }

    private BoundStmt _bindFor(ForStmt f, TypeEnv env, Z42Type ret) {
            TypeEnv forScope = env.PushScope();
            BoundStmt finit = null;
            if (f.HasInit) { finit = this._bindStmt(f.Init, forScope, ret); }
            BoundExpr fcond = null;
            if (f.HasCond) {
                fcond = this._tc._expr._bindExpr(f.Cond, forScope);
                this._tc._requireBool(fcond.Type(), "for", f.Cond.Span);
            }
            this._tc._loopDepth = this._tc._loopDepth + 1;
            BoundStmt fbody = this._bindStmt(f.Body, forScope, ret);
            this._tc._loopDepth = this._tc._loopDepth - 1;
            BoundExpr fincr = null;
            if (f.HasIncr) { fincr = this._tc._expr._bindExpr(f.Incr, forScope); }
            return new BoundFor(f.HasInit, finit, f.HasCond, fcond, f.HasIncr, fincr, fbody, f.Span);
    }

    private BoundStmt _bindSwitchStmt(SwitchStmt sw, TypeEnv env, Z42Type ret) {
            BoundExpr subj = this._tc._expr._bindExpr(sw.Subject, env);
            BoundSwitchCase[] cases = new BoundSwitchCase[sw.CaseCount];
            int ci = 0;
            while (ci < sw.CaseCount) {
                SwitchCase sc = sw.Cases[ci];
                TypeEnv caseScope = env.PushScope();
                BoundPattern pat = null;
                BoundExpr guard = null;
                // 模式在 caseScope 绑定：绑定变量注册进本臂作用域（body/guard 可见，不泄漏其它臂）。
                if (sc.HasPattern) { pat = this._tc._pattern.Bind(sc.Pattern, subj.Type(), caseScope); }
                if (sc.Guard != null) {
                    guard = this._tc._expr._bindExpr(sc.Guard, caseScope);
                    this._tc._requireBool(guard.Type(), "switch guard", sc.Guard.Span);
                }
                BoundStmt[] cbody = new BoundStmt[sc.BodyCount];
                int bi = 0;
                while (bi < sc.BodyCount) { cbody[bi] = this._bindStmt(sc.Body[bi], caseScope, ret); bi = bi + 1; }
                cases[ci] = new BoundSwitchCase(sc.HasPattern, pat, guard, cbody, sc.BodyCount, sc.Span);
                ci = ci + 1;
            }
            BoundSwitch bsw = new BoundSwitch(subj, cases, sw.CaseCount, sw.Span);
            this._tc._exhaust.CheckStmt(bsw, env);   // 模式匹配 C：封闭域（bool/enum）穷尽性诊断
            return bsw;
    }

    // 解构声明（模式匹配 B）：`T(x,y) = init;`。绑进**当前 env**（后续语句可见，同 is 语义，非 PushScope）。
    // 复用模式引擎 Bind（record/arity/字段类型校验 + 绑定注册）；再 CheckIrrefutable 静态保证不可失败。
    private BoundStmt _bindDeconstructDecl(DeconstructDeclStmt d, TypeEnv env) {
            BoundExpr init = this._tc._expr._bindExpr(d.Init, env);
            BoundPattern pat = this._tc._pattern.Bind(d.Pat, init.Type(), env);
            this._tc._pattern.CheckIrrefutable(pat, init.Type(), d.Span);
            return new BoundDeconstructDeclStmt(pat, init, d.Span);
    }

    private BoundStmt _bindDoWhile(DoWhileStmt dw, TypeEnv env, Z42Type ret) {
            this._tc._loopDepth = this._tc._loopDepth + 1;
            BoundStmt dwBody = this._bindStmt(dw.Body, env, ret);
            this._tc._loopDepth = this._tc._loopDepth - 1;
            BoundExpr dwCond = this._tc._expr._bindExpr(dw.Cond, env);
            this._tc._requireBool(dwCond.Type(), "do-while", dw.Cond.Span);
            return new BoundDoWhile(dwBody, dwCond, dw.Span);
    }

    private BoundStmt _bindWhile(WhileStmt w, TypeEnv env, Z42Type ret) {
            BoundExpr cond = this._tc._expr._bindExpr(w.Cond, env);
            this._tc._requireBool(cond.Type(), "while", w.Cond.Span);
            this._tc._loopDepth = this._tc._loopDepth + 1;
            BoundStmt body = this._bindStmt(w.Body, env, ret);
            this._tc._loopDepth = this._tc._loopDepth - 1;
            return new BoundWhile(cond, body, w.Span);
    }

    private BoundStmt _bindTryCatch(TryCatchStmt ts, TypeEnv env, Z42Type ret) {
            BoundStmt tryBody = this._bindStmt(ts.TryBody, env, ret);
            BoundCatchClause[] catches = new BoundCatchClause[ts.CatchCount];
            int ci = 0;
            while (ci < ts.CatchCount) {
                CatchClause cc = ts.Catches[ci];
                string exName = "";
                int exArity = 0;
                Z42Type exType = new Z42UnknownType();
                if (cc.HasType) {
                    Z42Type t = env.ResolveType(cc.ExType);
                    this._tc._chkTypeRef(t, env, cc.ExType.Span);   // enforce-class-access：catch 异常类型引用
                    exName = cc.ExType.Dump();           // 解析失败也保留源类型名（imported 异常类经 Unknown 吸收）
                    if (t is Z42ClassType) { exName = t.Name(); exType = t; }
                    // 泛型异常（catch (MulticastException<int>)）：存裸 Def 名 + arity，codegen 限定为
                    // QualifyClass(裸名)+"$"+arity（= Std.MulticastException$1，匹配运行期抛出类型）。
                    // 否则 Dump() 含 <int> → QualifyClass 误前缀当前 ns（Demo.MulticastException<int>）→ 不匹配。
                    else if (t is Z42InstantiatedType) {
                        Z42InstantiatedType it = t as Z42InstantiatedType;
                        exName = it.Def.Name(); exArity = it.ArgCount; exType = t;
                    }
                }
                TypeEnv cenv = env;
                if (cc.HasVar) {
                    cenv = env.PushScope();
                    cenv.Define(cc.VarName, exType);
                    if (this._tc._lambdaActive) { this._tc._lambdaLocals.Put(cc.VarName, exType); }
                }
                BoundStmt body = this._bindStmt(cc.Body, cenv, ret);
                catches[ci] = new BoundCatchClause(cc.HasType, exName, exArity, cc.HasVar, cc.VarName, body, cc.Span);
                ci = ci + 1;
            }
            BoundStmt fin = null;
            if (ts.HasFinally) { fin = this._bindStmt(ts.Finally, env, ret); }
            return new BoundTry(tryBody, catches, ts.CatchCount, ts.HasFinally, fin, ts.Span);
    }

    private BoundStmt _bindIfStmt(IfStmt f, TypeEnv env, Z42Type ret) {
            BoundExpr cond = this._tc._expr._bindExpr(f.Cond, env);
            this._tc._requireBool(cond.Type(), "if", f.Cond.Span);
            BoundStmt then = this._bindStmt(f.Then, env, ret);
            if (f.HasElse) {
                return new BoundIf(cond, then, true, this._bindStmt(f.Else, env, ret), f.Span);
            }
            return new BoundIf(cond, then, false, new BoundBlock(new BoundStmt[0], 0, f.Span), f.Span);
    }

    private BoundStmt _bindReturn(ReturnStmt r, TypeEnv env, Z42Type ret) {
            if (r.HasValue) {
                // add-target-typed-new：`return new()` 以函数返回类型为目标。
                BoundExpr val = this._tc._expr.BindWithTarget(r.Value, ret, env);
                this._tc.CheckImplicitConvert(val, ret, env.Symbols, r.Value.Span, "return");   // tighten-implicit-conversions：窄化→E0439 / 常量在范围内例外
                val = this._tc.BoxIfNeeded(val, ret);   // add-primitive-value-boxing: return 整数→object/接口 装箱
                val = this._tc.ConvertIfNeeded(val, ret, env.Symbols);   // tighten-implicit-conversions: 拓宽表示转换（int→double 等）插 ConvertInstr；add-user-conversions: 用户 implicit
                return new BoundReturn(true, val, r.Span);
            }
            return new BoundReturn(false, new BoundLitNull(new Z42VoidType(), r.Span), r.Span);
    }

    private BoundStmt _bindVarDecl(VarDeclStmt v, TypeEnv env, Z42Type ret) {
            BoundExpr init = null;
            if (v.Init is LambdaExpr) {                              // lambda + 显式 Func 类型 → expected 推导
                Z42Type declared = env.ResolveType(v.Type);          // `var` → Unknown，自然跳过
                if (declared is Z42FuncType) {
                    init = this._bindLambda(v.Init as LambdaExpr, declared as Z42FuncType, env);
                }
            }
            // 集合字面量：把声明侧类型作为目标类型传下（`var` → NamedType("var") 非集合类型，_bindCollLit
            // 走推断路径）。target-typed 让 `List<long> x = {1,2,3}` / 空 `[]`·`{}` 解析出正确元素/容器类型。
            if (init == null && v.Init != null && ExprTyper.IsCollLit(v.Init)) {
                TypeExpr collTarget = null;
                if (!((v.Type is NamedType) && ((v.Type as NamedType).Name == "var"))) { collTarget = v.Type; }
                init = this._tc._expr._bindCollLit(v.Init, collTarget, env);
            }
            // add-target-typed-new：`A a = new()` 以声明类型为目标（`var a = new()` → Unknown → 报 E0437）。
            if (init == null && v.Init != null && ExprTyper.IsTargetTypedNew(v.Init)) {
                init = this._tc._expr.BindWithTarget(v.Init, env.ResolveType(v.Type), env);
            }
            if (init == null && v.Init != null) { init = this._tc._expr._bindExpr(v.Init, env); }   // G8：无 init 则 init 留 null
            Z42Type vt = this._varType(env, v, init);
            env.Define(v.Name, vt);
            if (this._tc._lambdaActive) { this._tc._lambdaLocals.Put(v.Name, vt); }
            init = this._tc.BoxIfNeeded(init, vt);   // add-primitive-value-boxing: 整数→object/接口 装箱
            init = this._tc.ConvertIfNeeded(init, vt, env.Symbols);   // tighten-implicit-conversions: 拓宽表示转换插 ConvertInstr；add-user-conversions: 用户 implicit
            BoundVarDeclStmt bvd = new BoundVarDeclStmt(v.Name, vt, init, v.Span);
            if (v.IsConst) { this._bindLocalConst(v, env, bvd); }   // add-const-keyword：求值 + 登记 + 诊断
            return bvd;
    }

    // add-const-keyword：局部 const —— 求值初始化器，登记进 TypeEnv（供后续 const 引用 + 赋值检查），
    // 结果挂 BoundVarDeclStmt（emit 阶段登记替换表；存储正常发射，全替换后由 DCE 清理）。
    private void _bindLocalConst(VarDeclStmt v, TypeEnv env, BoundVarDeclStmt bvd) {
        bvd.IsConst = true;
        if (v.Init == null) {
            this._tc._diags.Error(DiagnosticCodes.ConstNeedsInit, "const `" + v.Name + "` must have an initializer", v.Span);
            return;
        }
        ConstValue cv = ConstEval.Eval(v.Init, env.CollectConsts());
        if (cv == null) {
            bool pureRef = (v.Init is IdentExpr) || (v.Init is MemberExpr && (v.Init as MemberExpr).Target is IdentExpr);
            if (pureRef) {
                this._tc._diags.Error(DiagnosticCodes.ConstExprBadRef, "const expression can only reference already-defined const values", v.Span);
            } else {
                this._tc._diags.Error(DiagnosticCodes.ConstNotConstantInit, "const `" + v.Name + "` initializer must be a compile-time constant", v.Span);
            }
            return;
        }
        bvd.ConstVal = cv;
        env.DefineConst(v.Name, cv);
    }

    private BoundStmt _bindLocalFunction(LocalFunctionStmt lf, TypeEnv env, Z42Type ret) {
            MethodDecl lmd = lf.Decl;
            TypeEnv lscope = env.PushScope();   // 体内可见同级/外层局部函数（递归/前向引用）+ 外层局部变量（L3 捕获）
            int lpi = 0;
            while (lpi < lmd.ParamCount) { lscope.Define(lmd.Params[lpi].Name, env.ResolveType(lmd.Params[lpi].Type)); lpi = lpi + 1; }
            // 捕获分析（复用 lambda 机制）：体内引用外层非参变量 → BoundCapturedIdent + 记 _lambdaCaps。
            bool savedActive = this._tc._lambdaActive; StrMap savedLocals = this._tc._lambdaLocals;
            BoundCapture[] savedCaps = this._tc._lambdaCaps; int savedCapCount = this._tc._lambdaCapCount;
            this._tc._lambdaActive = true;
            this._tc._lambdaLocals = new StrMap();
            lpi = 0;
            while (lpi < lmd.ParamCount) { this._tc._lambdaLocals.Put(lmd.Params[lpi].Name, lscope.LookupVar(lmd.Params[lpi].Name)); lpi = lpi + 1; }
            this._tc._lambdaCaps = new BoundCapture[2]; this._tc._lambdaCapCount = 0;
            Z42Type lret = env.ResolveType(lmd.RetType);
            BoundStmt lbody = this._bindStmt(lmd.Body, lscope, lret);
            BoundCapture[] lcaps = new BoundCapture[this._tc._lambdaCapCount];
            int lci = 0; while (lci < this._tc._lambdaCapCount) { lcaps[lci] = this._tc._lambdaCaps[lci]; lci = lci + 1; }
            int lcapN = this._tc._lambdaCapCount;
            this._tc._lambdaActive = savedActive; this._tc._lambdaLocals = savedLocals;
            this._tc._lambdaCaps = savedCaps; this._tc._lambdaCapCount = savedCapCount;
            return new BoundLocalFunction(lmd.Name, lmd, lbody, lcaps, lcapN, lf.Span);
    }

    private BoundStmt _bindBlock(BlockStmt b, TypeEnv env, Z42Type ret) {
            TypeEnv scope = env.PushScope();
            // impl-local-fn-l2 pre-pass：先注册块内全部局部函数签名（前向引用 + 递归）。
            int pp = 0;
            while (pp < b.Count) {
                if (b.Stmts[pp] is LocalFunctionStmt) {
                    MethodDecl lmd = (b.Stmts[pp] as LocalFunctionStmt).Decl;
                    Z42Type[] pts = new Z42Type[lmd.ParamCount];
                    int z = 0; while (z < lmd.ParamCount) { pts[z] = scope.ResolveType(lmd.Params[z].Type); z = z + 1; }
                    scope.DefineLocalFn(lmd.Name, new Z42FuncType(pts, lmd.ParamCount, scope.ResolveType(lmd.RetType)));
                }
                pp = pp + 1;
            }
            BoundStmt[] outs = new BoundStmt[b.Count];
            int i = 0;
            while (i < b.Count) { outs[i] = this._bindStmt(b.Stmts[i], scope, ret); i = i + 1; }
            return new BoundBlock(outs, b.Count, b.Span);
    }

    // 集合字面量脱糖（ExprTyper._bindCollLit）绑定合成语句的入口。
    public BoundStmt BindStmt(Stmt s, TypeEnv env, Z42Type ret) { return this._bindStmt(s, env, ret); }

    internal BoundStmt _bindStmt(Stmt s, TypeEnv env, Z42Type ret) {
        if (s is BlockStmt) { return this._bindBlock(s as BlockStmt, env, ret); }
        if (s is LocalFunctionStmt) { return this._bindLocalFunction(s as LocalFunctionStmt, env, ret); }
        if (s is VarDeclStmt) { return this._bindVarDecl(s as VarDeclStmt, env, ret); }
        if (s is DeconstructDeclStmt) { return this._bindDeconstructDecl(s as DeconstructDeclStmt, env); }
        if (s is ReturnStmt) { return this._bindReturn(s as ReturnStmt, env, ret); }
        if (s is ExprStmt) {
            ExprStmt e = s as ExprStmt;
            return new BoundExprStmt(this._tc._expr._bindExpr(e.E, env), e.Span);
        }
        if (s is IfStmt) { return this._bindIfStmt(s as IfStmt, env, ret); }
        if (s is ThrowStmt) {
            ThrowStmt th = s as ThrowStmt;
            return new BoundThrow(this._tc._expr._bindExpr(th.E, env), th.Span);
        }
        if (s is TryCatchStmt) { return this._bindTryCatch(s as TryCatchStmt, env, ret); }
        if (s is WhileStmt) { return this._bindWhile(s as WhileStmt, env, ret); }
        if (s is DoWhileStmt) { return this._bindDoWhile(s as DoWhileStmt, env, ret); }
        if (s is SwitchStmt) { return this._bindSwitchStmt(s as SwitchStmt, env, ret); }
        if (s is BreakStmt) {
            if (this._tc._loopDepth == 0) {
                this._tc._diags.Error(DiagnosticCodes.InvalidBreakContinue, "`break` outside of loop", s.Span);
            }
            return new BoundBreak(s.Span);
        }
        if (s is ContinueStmt) {
            if (this._tc._loopDepth == 0) {
                this._tc._diags.Error(DiagnosticCodes.InvalidBreakContinue, "`continue` outside of loop", s.Span);
            }
            return new BoundContinue(s.Span);
        }
        // for 循环 → BoundFor（独立节点，FunctionEmitter 生成 cond/body/incr/end 四块，
        // continue 跳 incrL 而非 condL，镜像 C# EmitBoundFor，block 结构 byte-identical）。
        if (s is ForStmt) { return this._bindFor(s as ForStmt, env, ret); }
        // GS6: foreach → BoundForeach（镜像 C# TypeChecker：保留语义节点，FunctionEmitter 专用 _emitForeach
        // 产出 ArrayLen+ConstI32 计数器 byte-identical IR；替代旧脱糖到 while+BoundMember.Length 路径）。
        if (s is ForeachStmt) { return this._bindForeach(s as ForeachStmt, env, ret); }
        this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "unsupported statement (1A)", s.Span);
        return new BoundExprStmt(new BoundError("unsupported stmt", new Z42ErrorType(), s.Span), s.Span);
    }

    private Z42Type _varType(TypeEnv env, VarDeclStmt v, BoundExpr init) {
        if (v.Type is NamedType) {
            NamedType nt = v.Type as NamedType;
            if (nt.Name == "var") {
                if (init != null) { return init.Type(); }
                return new Z42UnknownType();              // G8：`var` 无 init 不可推断（实践不出现，防崩）
            }
        }
        Z42Type vt = env.ResolveType(v.Type);
        this._tc._chkTypeRef(vt, env, v.Type.Span);   // enforce-class-access：局部变量声明类型引用
        if (init != null) {   // G8：无 init 跳赋值检查
            this._tc.CheckImplicitConvert(init, vt, env.Symbols, v.Init.Span, "var-decl");   // tighten-implicit-conversions：窄化→E0439 / 常量例外
        }
        return vt;
    }

    public BoundExpr _bindLambda(LambdaExpr lam, Z42FuncType expected, TypeEnv env) {
        if (lam.ParamCount != expected.ParamCount) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch,
                "lambda arity " + lam.ParamCount.ToString() + " != expected " + expected.ParamCount.ToString(), lam.Span);
        }
        string[] pnames = new string[lam.ParamCount];
        Z42Type[] ptypes = new Z42Type[lam.ParamCount];
        TypeEnv lenv = env.PushScope();
        int i = 0;
        while (i < lam.ParamCount) {
            pnames[i] = lam.Params[i].Name;
            Z42Type pt = new Z42UnknownType();
            if (lam.Params[i].HasType) { pt = env.ResolveType(lam.Params[i].Type); }
            else if (i < expected.ParamCount) { pt = expected.ParamTypes[i]; }
            ptypes[i] = pt;
            lenv.Define(pnames[i], pt);
            i = i + 1;
        }
        // 嵌套 lambda：保存外层 frame（绑完恢复），并把内层对「外层非局部变量」的捕获
        // **透传**给外层——外层须把该变量捕获进自己 env，内层经外层 env 间接取
        // （ExprEmitter._captureEnvIdx）。原共享 _lambdaCaps（无 save/restore）意外做了透传，
        // 但丢外层自身在内层前/后的捕获；简单 save/restore 修了后者却丢透传（破 closure_l3_capture
        // case 4：`f=()=>{ g=()=>k2*2; return g() }`，f 不直接用 k2 仅 g 用 → f 必须透传捕获 k2）。
        // 二者兼顾：save/restore + 透传。
        bool savedActive = this._tc._lambdaActive;
        StrMap savedLocals = this._tc._lambdaLocals;
        BoundCapture[] savedCaps = this._tc._lambdaCaps; int savedCapCount = this._tc._lambdaCapCount;
        this._tc._lambdaActive = true;
        this._tc._lambdaLocals = new StrMap();
        i = 0;
        while (i < lam.ParamCount) { this._tc._lambdaLocals.Put(pnames[i], ptypes[i]); i = i + 1; }
        this._tc._lambdaCaps = new BoundCapture[2];
        this._tc._lambdaCapCount = 0;
        BoundExpr exprBody = null;
        BoundStmt blockBody = null;
        if (lam.HasBlock) { blockBody = this._bindStmt(lam.BlockBody, lenv, expected.Ret); }
        else { exprBody = this._tc._expr._bindExpr(lam.ExprBody, lenv); }
        int thisCapCount = this._tc._lambdaCapCount;
        BoundCapture[] caps = new BoundCapture[thisCapCount];
        i = 0;
        while (i < thisCapCount) { caps[i] = this._tc._lambdaCaps[i]; i = i + 1; }
        // 恢复外层 frame
        this._tc._lambdaActive = savedActive;
        this._tc._lambdaLocals = savedLocals;
        this._tc._lambdaCaps = savedCaps; this._tc._lambdaCapCount = savedCapCount;
        // 透传：内层捕获中**不属于外层局部**的变量 → 外层也须捕获（add-if-absent，镜像捕获钩子）。
        if (savedActive) {
            int ti = 0;
            while (ti < thisCapCount) {
                string cn = caps[ti].Name;
                if (!this._tc._lambdaLocals.ContainsKey(cn)) {
                    int hi = 0 - 1; int ci = 0;
                    while (ci < this._tc._lambdaCapCount) { if (this._tc._lambdaCaps[ci].Name == cn) { hi = ci; } ci = ci + 1; }
                    if (hi < 0) {
                        if (this._tc._lambdaCapCount == this._tc._lambdaCaps.Length) {
                            BoundCapture[] gb = new BoundCapture[this._tc._lambdaCaps.Length * 2];
                            int gk = 0; while (gk < this._tc._lambdaCapCount) { gb[gk] = this._tc._lambdaCaps[gk]; gk = gk + 1; }
                            this._tc._lambdaCaps = gb;
                        }
                        this._tc._lambdaCaps[this._tc._lambdaCapCount] = new BoundCapture(cn, caps[ti].CapType);
                        this._tc._lambdaCapCount = this._tc._lambdaCapCount + 1;
                    }
                }
                ti = ti + 1;
            }
        }
        // 返回类型推断（call-arg lambda 无 expected 时 expected.Ret=Unknown，镜像 C#）：
        // 仅 expr-body 从表达式类型推断（void call 得 void）；block-body 保留 Unknown
        // （C# 对无 expected 的 block lambda 不推断，如 `=> { throw }`）。
        Z42FuncType finalSig = expected;
        if ((expected.Ret is Z42UnknownType) && exprBody != null) {
            finalSig = new Z42FuncType(expected.ParamTypes, expected.ParamCount, exprBody.Type());
        }
        return new BoundLambda(pnames, ptypes, lam.ParamCount,
                               lam.HasBlock, exprBody, blockBody,
                               caps, thisCapCount, finalSig, lam.Span);
    }

}