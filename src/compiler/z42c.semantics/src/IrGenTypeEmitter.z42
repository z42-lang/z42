// 类 / struct 声明与 impl 块 → TYPE 条目 + IR 函数（refactor-split-irgen-generate，自 IrGen.Generate 提出；逻辑逐字保留）。
// 每个 ClassDecl：合并 TYPE record（partial 仅主碎片）→ 成员（IrGenMemberEmitter）→ 合成隐式 ctor →
// blob struct Equals → [Record] 值语义合成；ImplDecl：`<qualTarget>.<m>` 函数。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;

public sealed class IrGenTypeEmitter {
    private IrGen _g;
    private SemanticModel _model;
    private IrGenSink _out;
    private IrGenMemberEmitter _members;

    public IrGenTypeEmitter(IrGen g, SemanticModel model, IrGenSink sink) {
        this._g = g; this._model = model; this._out = sink;
        this._members = new IrGenMemberEmitter(g, model, sink);
    }

    // class / struct（rawDecl = cu.Decls[i]，带 attribute 包装；emittedPartial = 本 CU 已发 record 的 partial 名）。
    public void EmitClass(Decl rawDecl, ClassDecl c, StrMap emittedPartial) {
        IrGen g = this._g; SemanticModel model = this._model;
        // Arity-mangle：泛型类以 Name$N 键注册时从 Name$N 取 owner CT。
        string ownerKey = c.Name;
        if (c.TypeParams.Count > 0) { string om = c.Name + "$" + c.TypeParams.Count.ToString(); if (model.Symbols.HasClass(om)) { ownerKey = om; } }
        Z42ClassType owner = model.Symbols.GetClass(ownerKey) as Z42ClassType;
        // generic-struct-erased-slot-value-copy：记下本包**泛型**类型的声明，供实例化特化时重发成员。
        if (c.TypeParams.Count > 0 && !g.GenericDecls.ContainsKey(c.Name)) { g.GenericDecls.Put(c.Name, rawDecl); }
        // add-partial-types：partial 类型仅**主碎片**（min-path）发一条**合并** TYPE record；非主碎片跳过 record（方法体照发）。
        bool ptIsPartial = owner != null && owner.IsPartial;
        bool ptIsMain = !ptIsPartial || owner.PartialMainFile == g.SourceFile;
        if (ptIsPartial && ptIsMain && emittedPartial.ContainsKey(c.Name)) { ptIsMain = false; }   // 同文件多碎片：只发一次
        if (ptIsMain && ptIsPartial) { emittedPartial.Put(c.Name, "1"); }
        if (ptIsMain) {
            ClassDecl descDecl = c;
            if (ptIsPartial && g.PartialMerged != null && g.PartialMerged.ContainsKey(c.Name)) {
                descDecl = g.PartialMerged.Get(c.Name) as ClassDecl;   // 合并碎片：全字段有序 + 基表并集
            }
            IrClassDesc cdesc = g._classDescB._classDesc(descDecl, HandlerRegistry.HasRecord(rawDecl));   // add-record-attribute
            cdesc.Attrs = g._classDescB._attrRefs(rawDecl); cdesc.AttrCount = cdesc.Attrs.Length;   // add-attribute-reflection
            this._out.AddClass(cdesc);
        }
        int j = 0;
        while (j < c.MemberCount) {
            Decl rawMem = c.Members[j];
            Decl mem = IrGenFacts._unwrap(rawMem);
            if (mem is MethodDecl) { this._members.EmitMethod(c, owner, ownerKey, rawMem, mem as MethodDecl); }
            else if (mem is PropertyDecl) { this._members.EmitProperty(c, owner, rawMem, mem as PropertyDecl); }
            else if (mem is IndexerDecl) { this._members.EmitIndexer(c, owner, mem as IndexerDecl); }
            j = j + 1;
        }
        this._emitStructEquals(c, owner);
        this._emitRecordSynth(rawDecl, c, owner);
    }

    // generic-struct-erased-slot-value-copy（B1）：为一个命中闸门的实例化**重发该泛型类型的成员**。
    //
    // 只发成员、**不发类描述符**——描述符已由 IrGen.Generate 尾部按 `InstLayouts` 单独投送（增量 2）。
    // 关键是 `g.SpecInstName`：它同时把 IR 函数名前缀与 `EmitContext.OwnerStructName` 换成实例化名，
    // 于是体内 `this.f` 的字节偏移按**实例化布局**烘焙；调用点用同一规则拼名字，两边对上。
    //
    // 为什么必须重发而不能共用定义那份：定义布局里型参字段一律 8B 句柄，实例化布局里是内联字节
    // ——size 与后续字段偏移都可能不同，共用即错位（实测 `Pair<P2,int>` 读出 0）。
    public void EmitInstantiation(string instName) {
        IrGen g = this._g; SemanticModel model = this._model;
        string baseName = StructLayout.BaseNameOf(instName);
        object rd = g.GenericDecls.Get(baseName);
        if (!(rd is Decl)) { return; }                       // 非本包泛型（闸门已拦，这里兜底）
        Decl rawDecl = rd as Decl;
        Decl dd = IrGenFacts._unwrap(rawDecl);
        if (!(dd is ClassDecl)) { return; }
        ClassDecl c = dd as ClassDecl;
        string ownerKey = c.Name;
        if (c.TypeParams.Count > 0) { string om = c.Name + "$" + c.TypeParams.Count.ToString(); if (model.Symbols.HasClass(om)) { ownerKey = om; } }
        Z42ClassType owner = model.Symbols.GetClass(ownerKey) as Z42ClassType;
        string saved = g.SpecInstName; string savedOwner = g.SpecOwnerName;
        g.SpecInstName = instName; g.SpecOwnerName = owner != null ? owner.Name() : c.Name;
        int j = 0;
        while (j < c.MemberCount) {
            Decl rawMem = c.Members[j];
            Decl mem = IrGenFacts._unwrap(rawMem);
            if (mem is MethodDecl) { this._members.EmitMethod(c, owner, ownerKey, rawMem, mem as MethodDecl); }
            else if (mem is PropertyDecl) { this._members.EmitProperty(c, owner, rawMem, mem as PropertyDecl); }
            else if (mem is IndexerDecl) { this._members.EmitIndexer(c, owner, mem as IndexerDecl); }
            j = j + 1;
        }
        // **合成成员也要特化**：`Equals$1`（blob struct 合成）与 `[Record]` 的 ToString 都按
        // OwnerStructName 的布局烘焙偏移。只发定义那份 ⇒ 实例化 blob 上调它们会按定义偏移读
        // （实测 generic_struct_equals 判红）。它们内部用 `_q(_classIrShortName(c))` 拼名，
        // 特化通道下需换成实例化名——故同样在 SpecInstName 生效期间调用。
        this._emitStructEquals(c, owner);
        this._emitRecordSynth(rawDecl, c, owner);
        g.SpecInstName = saved; g.SpecOwnerName = savedOwner;
    }

    // add-struct-object-methods (PR2b)：blob 值 struct 合成 `Equals(object)`（用户未显式声明才合成）。
    private void _emitStructEquals(ClassDecl c, Z42ClassType owner) {
        IrGen g = this._g;
        if (owner != null && g.Layouts != null && g.Layouts.IsBlobStruct(owner.Name())
            && !owner.Methods.ContainsKey("Equals$1") && !owner.Methods.ContainsKey("Equals")) {
            var eqFe = new FunctionEmitter(this._model.Symbols, g);
            // 特化通道下用实例化名（调用点按同一规则派发）。
            string eqIr = g._q(g.SpecInstName != "" ? g.SpecInstName : g._classIrShortName(c)) + ".Equals$1";
            IrFunction eqF = eqFe.EmitSynthStructEquals(eqIr, owner);
            eqF.MinArg = 1;   // Equals(other) 逻辑参数 1（reconcile：默认=含 this 总数，需覆盖）
            this._out.AddFunc(eqF);
        }
    }

    // add-record-value-semantics：`[Record]` 类型合成值语义（用户未显式声明才合成）。
    //   class（引用）：Equals（裸名，经 vtable 覆盖 Object 槽）/ GetHashCode / ToString；struct（值）：仅 ToString。
    private void _emitRecordSynth(Decl rawDecl, ClassDecl c, Z42ClassType owner) {
        IrGen g = this._g;
        if (owner != null && HandlerRegistry.HasRecord(rawDecl)) {
            var rse = new RecordSynthEmitter(this._model.Symbols, g);
            string rq = g._q(g.SpecInstName != "" ? g.SpecInstName : g._classIrShortName(c));   // 特化通道下用实例化名
            bool hasTs = owner.Methods.ContainsKey("ToString") || owner.Methods.ContainsKey("ToString$0");
            if (owner.IsStruct) {
                if (!hasTs) { this._out.AddFunc(rse.EmitRecordToString(rq + ".ToString", owner, true)); }
            } else {
                if (!owner.Methods.ContainsKey("Equals$1") && !owner.Methods.ContainsKey("Equals")) {
                    this._out.AddFunc(rse.EmitRecordEquals(rq + ".Equals", owner));
                }
                if (!owner.Methods.ContainsKey("GetHashCode") && !owner.Methods.ContainsKey("GetHashCode$0")) {
                    this._out.AddFunc(rse.EmitRecordGetHashCode(rq + ".GetHashCode", owner));
                }
                if (!hasTs) { this._out.AddFunc(rse.EmitRecordToString(rq + ".ToString", owner, false)); }
            }
        }
    }

    // port-z42c-impl-block 2c：发 impl 方法为 `<qualTarget>.<m>` 函数（_qClass：imported target 解析到其声明 ns）。
    public void EmitImpl(ImplDecl im) {
        IrGen g = this._g; SemanticModel model = this._model;
        string itn = "";
        if (im.TargetType is NamedType) { itn = (im.TargetType as NamedType).Name; }
        if (itn != "" && model.Symbols.HasClass(itn)) {
            Z42ClassType iowner = model.Symbols.GetClass(itn) as Z42ClassType;
            int ij = 0;
            while (ij < im.MethodCount) {
                if (im.Methods[ij] is MethodDecl) {
                    MethodDecl imd = im.Methods[ij] as MethodDecl;
                    if (imd.HasBody) {
                        string imk = OverloadResolver.MethodKeyOf(imd);   // unify-regkey-source-of-truth：与 DeclBinder._bindImpl 成对，必须同键
                        string ikey = itn + "." + imk;
                        if (model.HasBody(ikey)) {
                            bool ist = IrGenFacts._hasWord(imd.Mods, "static");
                            var ife = new FunctionEmitter(model.Symbols, g);
                            IrFunction iirf = ife.EmitFunction(g._qClass(itn) + "." + imk, imd,
                                                               model.GetBody(ikey), !ist, ist, iowner, new string[0], 0);
                            iirf.Visibility = IrGenFacts._visCode(imd.Mods, 1);   // add-member-visibility
                            iirf.MethodFlags = iirf.MethodFlags | IrGenFacts._methodFlags(imd.Mods);   // 或：保住 FunctionEmitter 置的 sret 位   // add-method-modifiers
                            IrGenFacts._fillParamMeta(iirf, imd, !ist);   // add-param-metadata
                            this._out.AddFunc(iirf);
                        }
                    }
                }
                ij = ij + 1;
            }
        }
    }
}
