// IrOptInfo —— IR 优化管线的安全基石：单条指令的「写寄存器 / 读寄存器 / 是否可删」查询。
// 引入 change：optimization-pipeline（编译期 IR 优化，interp-first）。
//
// 设计（见 docs/book/src/runtime/optimization-pipeline.md）：
//   - pass 放 compiler 源码（非 stdlib z42.ir），只用 z42.ir 现有 public 字段，type-switch 每 opcode
//     → 零 bootstrap API-face 延迟（Decision 1）。
//   - AddReads 必须**完整**：漏一个读操作数会让 DCE 误删活值 → miscompile。故逐条镜像
//     ZbcWriter._regtInstr 的权威枚举（它访问 Dst + 全部操作数；这里去掉 Dst = 纯读操作数）。
//   - IsPure 用**白名单**：只有明确无副作用（不抛/不调用户码/不写内存/不分配）的 opcode 才可删；
//     未列出的一律当「有副作用、保留」（安全默认）。Div/Rem 会除零陷阱、FieldGet/ArrayGet 会
//     NPE/越界、ToStr 调 ToString → 都不在白名单。
namespace Z42.Semantics;

using Z42.IR;
using Z42.IR.BinaryFormat;   // ZbcInstr._parseIntLit（const-fold 复用编译器权威字面量解析）

public sealed class IrOptInfo {

    // ── const-fold 支持 ─────────────────────────────────────────────────────────────
    // 整数常量值：ConstI64Instr → _parseIntLit(Text)（canonical，与 ZbcWriter 编码同一解析）。
    public static bool IsConstI64(IrInstr ins) { return ins is ConstI64Instr; }
    public static long ConstI64Val(IrInstr ins) { return ZbcInstr._parseIntLit((ins as ConstI64Instr).Text); }

    // 尝试常量折叠：ins 是二元 int 运算/比较、两操作数都是已知 int 常量(cint/cval) → 返回折叠后的
    // Const 指令（保 Dst）；否则 null。整数算术**仅非负结果才折**（负值 _parseIntLit 编码不了，保守跳过）；
    // div/rem 防除零、shift 防越界（镜像 IrGenFacts._foldBinary 的 long 语义）。比较恒安全 → ConstBool。
    public static IrInstr TryConstFold(IrInstr ins, bool[] cint, long[] cval) {
        // 每条：先试双常量折叠（→ Const）；不成再试单操作数代数恒等式（→ Copy 或 Const 0）。
        // 恒等式安全性：→Copy 保留另一操作数的读（不新增死值）；→Const 0 让操作数可能变死，
        // 但 temp-DCE 只删 IsPure 指令，故有副作用的 producer 仍保留。皆 int 语义、无溢出/抛出顾虑。
        if (ins is AddInstr) { AddInstr i = ins as AddInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long r = cval[i.A.Id] + cval[i.B.Id]; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } if (IrOptInfo._cvIs(cint, cval, i.A, 0L)) { return new CopyInstr(i.Dst, i.B); } if (IrOptInfo._cvIs(cint, cval, i.B, 0L)) { return new CopyInstr(i.Dst, i.A); } return null; }
        if (ins is SubInstr) { SubInstr i = ins as SubInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long r = cval[i.A.Id] - cval[i.B.Id]; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } if (IrOptInfo._cvIs(cint, cval, i.B, 0L)) { return new CopyInstr(i.Dst, i.A); } return null; }
        if (ins is MulInstr) { MulInstr i = ins as MulInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long r = cval[i.A.Id] * cval[i.B.Id]; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } if (IrOptInfo._cvIs(cint, cval, i.A, 0L) || IrOptInfo._cvIs(cint, cval, i.B, 0L)) { return new ConstI64Instr(i.Dst, "0"); } if (IrOptInfo._cvIs(cint, cval, i.A, 1L)) { return new CopyInstr(i.Dst, i.B); } if (IrOptInfo._cvIs(cint, cval, i.B, 1L)) { return new CopyInstr(i.Dst, i.A); } return null; }
        if (ins is DivInstr) { DivInstr i = ins as DivInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long c = cval[i.B.Id]; if (c != 0) { long r = cval[i.A.Id] / c; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } } if (IrOptInfo._cvIs(cint, cval, i.B, 1L)) { return new CopyInstr(i.Dst, i.A); } return null; }
        if (ins is RemInstr) { RemInstr i = ins as RemInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long c = cval[i.B.Id]; if (c != 0) { long r = cval[i.A.Id] % c; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } } if (IrOptInfo._cvIs(cint, cval, i.B, 1L)) { return new ConstI64Instr(i.Dst, "0"); } return null; }
        if (ins is BitAndInstr) { BitAndInstr i = ins as BitAndInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long r = cval[i.A.Id] & cval[i.B.Id]; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } if (IrOptInfo._cvIs(cint, cval, i.A, 0L) || IrOptInfo._cvIs(cint, cval, i.B, 0L)) { return new ConstI64Instr(i.Dst, "0"); } return null; }
        if (ins is BitOrInstr)  { BitOrInstr i = ins as BitOrInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long r = cval[i.A.Id] | cval[i.B.Id]; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } if (IrOptInfo._cvIs(cint, cval, i.A, 0L)) { return new CopyInstr(i.Dst, i.B); } if (IrOptInfo._cvIs(cint, cval, i.B, 0L)) { return new CopyInstr(i.Dst, i.A); } return null; }
        if (ins is BitXorInstr) { BitXorInstr i = ins as BitXorInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long r = cval[i.A.Id] ^ cval[i.B.Id]; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } if (IrOptInfo._cvIs(cint, cval, i.A, 0L)) { return new CopyInstr(i.Dst, i.B); } if (IrOptInfo._cvIs(cint, cval, i.B, 0L)) { return new CopyInstr(i.Dst, i.A); } return null; }
        if (ins is ShlInstr) { ShlInstr i = ins as ShlInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long c = cval[i.B.Id]; if (c >= 0 && c <= 63) { long r = cval[i.A.Id] << (int)c; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } } if (IrOptInfo._cvIs(cint, cval, i.B, 0L)) { return new CopyInstr(i.Dst, i.A); } return null; }
        if (ins is ShrInstr) { ShrInstr i = ins as ShrInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { long c = cval[i.B.Id]; if (c >= 0 && c <= 63) { long r = cval[i.A.Id] >> (int)c; if (r >= 0) { return new ConstI64Instr(i.Dst, r.ToString()); } } } if (IrOptInfo._cvIs(cint, cval, i.B, 0L)) { return new CopyInstr(i.Dst, i.A); } return null; }
        if (ins is EqInstr) { EqInstr i = ins as EqInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { return new ConstBoolInstr(i.Dst, cval[i.A.Id] == cval[i.B.Id]); } return null; }
        if (ins is NeInstr) { NeInstr i = ins as NeInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { return new ConstBoolInstr(i.Dst, cval[i.A.Id] != cval[i.B.Id]); } return null; }
        if (ins is LtInstr) { LtInstr i = ins as LtInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { return new ConstBoolInstr(i.Dst, cval[i.A.Id] < cval[i.B.Id]); } return null; }
        if (ins is LeInstr) { LeInstr i = ins as LeInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { return new ConstBoolInstr(i.Dst, cval[i.A.Id] <= cval[i.B.Id]); } return null; }
        if (ins is GtInstr) { GtInstr i = ins as GtInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { return new ConstBoolInstr(i.Dst, cval[i.A.Id] > cval[i.B.Id]); } return null; }
        if (ins is GeInstr) { GeInstr i = ins as GeInstr; if (IrOptInfo._cc(cint, i.A, i.B)) { return new ConstBoolInstr(i.Dst, cval[i.A.Id] >= cval[i.B.Id]); } return null; }
        return null;
    }

    private static bool _cc(bool[] cint, TypedReg a, TypedReg b) {
        return a.Id >= 0 && a.Id < cint.Length && b.Id >= 0 && b.Id < cint.Length && cint[a.Id] && cint[b.Id];
    }

    // 代数恒等式助手：reg 是否为已知 int 常量且值 == v（越界安全）。
    // 用于单操作数恒等折叠（x+0→x、x*1→x、x*0→0 等），操作数皆 int（Add/Mul/… 只对 int 发射）。
    private static bool _cvIs(bool[] cint, long[] cval, TypedReg r, long v) {
        return r.Id >= 0 && r.Id < cint.Length && cint[r.Id] && cval[r.Id] == v;
    }

    // 该指令写入的寄存器 id；无 Dst（FieldSet/StaticSet/ArraySet 及所有终结子）返回 -1。
    public static int DstId(IrInstr ins) {
        if (ins is ConstI32Instr)  { return (ins as ConstI32Instr).Dst.Id; }
        if (ins is ConstI64Instr)  { return (ins as ConstI64Instr).Dst.Id; }
        if (ins is ConstF64Instr)  { return (ins as ConstF64Instr).Dst.Id; }
        if (ins is ConstBoolInstr) { return (ins as ConstBoolInstr).Dst.Id; }
        if (ins is ConstCharInstr) { return (ins as ConstCharInstr).Dst.Id; }
        if (ins is ConstStrInstr)  { return (ins as ConstStrInstr).Dst.Id; }
        if (ins is ConstNullInstr) { return (ins as ConstNullInstr).Dst.Id; }
        if (ins is DefaultOfInstr) { return (ins as DefaultOfInstr).Dst.Id; }
        if (ins is CopyInstr)      { return (ins as CopyInstr).Dst.Id; }
        if (ins is AddInstr)       { return (ins as AddInstr).Dst.Id; }
        if (ins is SubInstr)       { return (ins as SubInstr).Dst.Id; }
        if (ins is MulInstr)       { return (ins as MulInstr).Dst.Id; }
        if (ins is DivInstr)       { return (ins as DivInstr).Dst.Id; }
        if (ins is RemInstr)       { return (ins as RemInstr).Dst.Id; }
        if (ins is NegInstr)       { return (ins as NegInstr).Dst.Id; }
        if (ins is NotInstr)       { return (ins as NotInstr).Dst.Id; }
        if (ins is BitNotInstr)    { return (ins as BitNotInstr).Dst.Id; }
        if (ins is ConvertInstr)   { return (ins as ConvertInstr).Dst.Id; }
        if (ins is ToStrInstr)     { return (ins as ToStrInstr).Dst.Id; }
        if (ins is BitAndInstr)    { return (ins as BitAndInstr).Dst.Id; }
        if (ins is BitOrInstr)     { return (ins as BitOrInstr).Dst.Id; }
        if (ins is BitXorInstr)    { return (ins as BitXorInstr).Dst.Id; }
        if (ins is ShlInstr)       { return (ins as ShlInstr).Dst.Id; }
        if (ins is ShrInstr)       { return (ins as ShrInstr).Dst.Id; }
        if (ins is EqInstr)        { return (ins as EqInstr).Dst.Id; }
        if (ins is NeInstr)        { return (ins as NeInstr).Dst.Id; }
        if (ins is LtInstr)        { return (ins as LtInstr).Dst.Id; }
        if (ins is LeInstr)        { return (ins as LeInstr).Dst.Id; }
        if (ins is GtInstr)        { return (ins as GtInstr).Dst.Id; }
        if (ins is GeInstr)        { return (ins as GeInstr).Dst.Id; }
        if (ins is StrConcatInstr) { return (ins as StrConcatInstr).Dst.Id; }
        if (ins is CallInstr)      { return (ins as CallInstr).Dst.Id; }
        if (ins is BuiltinInstr)   { return (ins as BuiltinInstr).Dst.Id; }
        if (ins is CallNativeInstr){ return (ins as CallNativeInstr).Dst.Id; }
        if (ins is VCallInstr)     { return (ins as VCallInstr).Dst.Id; }
        if (ins is FieldGetInstr)  { return (ins as FieldGetInstr).Dst.Id; }
        if (ins is ObjNewInstr)    { return (ins as ObjNewInstr).Dst.Id; }
        if (ins is IsInstanceInstr){ return (ins as IsInstanceInstr).Dst.Id; }
        if (ins is AsCastInstr)    { return (ins as AsCastInstr).Dst.Id; }
        if (ins is TypeofInstr)    { return (ins as TypeofInstr).Dst.Id; }
        if (ins is ArrayNewInstr)  { return (ins as ArrayNewInstr).Dst.Id; }
        if (ins is ArrayNewLitInstr){ return (ins as ArrayNewLitInstr).Dst.Id; }
        if (ins is StaticGetInstr) { return (ins as StaticGetInstr).Dst.Id; }
        if (ins is ArrayLenInstr)  { return (ins as ArrayLenInstr).Dst.Id; }
        if (ins is LoadFnInstr)    { return (ins as LoadFnInstr).Dst.Id; }
        if (ins is CallIndirectInstr){ return (ins as CallIndirectInstr).Dst.Id; }
        if (ins is MkClosInstr)    { return (ins as MkClosInstr).Dst.Id; }
        if (ins is ArrayGetInstr)  { return (ins as ArrayGetInstr).Dst.Id; }
        if (ins is LoadLocalAddrInstr){ return (ins as LoadLocalAddrInstr).Dst.Id; }
        // 无 Dst：FieldSetInstr / StaticSetInstr / ArraySetInstr
        return -1;
    }

    // 读操作数计数：counts[r.Id] += 1（防越界守卫）。镜像 _regtInstr 但只计**读**（去 Dst）。
    // 完整性是正确性前提 —— 每个 opcode 的每个非 Dst 寄存器操作数都必须计入。
    public static void AddReads(int[] counts, IrInstr ins) {
        if (ins is CopyInstr)      { IrOptInfo._n(counts, (ins as CopyInstr).Src); return; }
        if (ins is AddInstr)       { AddInstr i = ins as AddInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is SubInstr)       { SubInstr i = ins as SubInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is MulInstr)       { MulInstr i = ins as MulInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is DivInstr)       { DivInstr i = ins as DivInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is RemInstr)       { RemInstr i = ins as RemInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is EqInstr)        { EqInstr i = ins as EqInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is NeInstr)        { NeInstr i = ins as NeInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is LtInstr)        { LtInstr i = ins as LtInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is LeInstr)        { LeInstr i = ins as LeInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is GtInstr)        { GtInstr i = ins as GtInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is GeInstr)        { GeInstr i = ins as GeInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is BitAndInstr)    { BitAndInstr i = ins as BitAndInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is BitOrInstr)     { BitOrInstr i = ins as BitOrInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is BitXorInstr)    { BitXorInstr i = ins as BitXorInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is ShlInstr)       { ShlInstr i = ins as ShlInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is ShrInstr)       { ShrInstr i = ins as ShrInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is StrConcatInstr) { StrConcatInstr i = ins as StrConcatInstr; IrOptInfo._n(counts, i.A); IrOptInfo._n(counts, i.B); return; }
        if (ins is NegInstr)       { IrOptInfo._n(counts, (ins as NegInstr).Src); return; }
        if (ins is NotInstr)       { IrOptInfo._n(counts, (ins as NotInstr).Src); return; }
        if (ins is BitNotInstr)    { IrOptInfo._n(counts, (ins as BitNotInstr).Src); return; }
        if (ins is ConvertInstr)   { IrOptInfo._n(counts, (ins as ConvertInstr).Src); return; }
        if (ins is ToStrInstr)     { IrOptInfo._n(counts, (ins as ToStrInstr).Src); return; }
        if (ins is CallInstr)      { CallInstr i = ins as CallInstr; IrOptInfo._args(counts, i.Args, i.ArgCount); return; }
        if (ins is BuiltinInstr)   { BuiltinInstr i = ins as BuiltinInstr; IrOptInfo._args(counts, i.Args, i.ArgCount); return; }
        if (ins is CallNativeInstr){ CallNativeInstr i = ins as CallNativeInstr; IrOptInfo._args(counts, i.Args, i.ArgCount); return; }
        if (ins is VCallInstr)     { VCallInstr i = ins as VCallInstr; IrOptInfo._n(counts, i.Obj); IrOptInfo._args(counts, i.Args, i.ArgCount); return; }
        if (ins is FieldGetInstr)  { IrOptInfo._n(counts, (ins as FieldGetInstr).Obj); return; }
        if (ins is FieldSetInstr)  { FieldSetInstr i = ins as FieldSetInstr; IrOptInfo._n(counts, i.Obj); IrOptInfo._n(counts, i.Val); return; }
        if (ins is ObjNewInstr)    { ObjNewInstr i = ins as ObjNewInstr; IrOptInfo._args(counts, i.Args, i.ArgCount); return; }
        if (ins is IsInstanceInstr){ IrOptInfo._n(counts, (ins as IsInstanceInstr).Obj); return; }
        if (ins is AsCastInstr)    { IrOptInfo._n(counts, (ins as AsCastInstr).Obj); return; }
        if (ins is ArrayNewInstr)  { IrOptInfo._n(counts, (ins as ArrayNewInstr).Size); return; }
        if (ins is ArrayNewLitInstr){ ArrayNewLitInstr i = ins as ArrayNewLitInstr; IrOptInfo._args(counts, i.Elems, i.ElemCount); return; }
        if (ins is StaticSetInstr) { IrOptInfo._n(counts, (ins as StaticSetInstr).Val); return; }
        if (ins is ArrayLenInstr)  { IrOptInfo._n(counts, (ins as ArrayLenInstr).Arr); return; }
        if (ins is CallIndirectInstr){ CallIndirectInstr i = ins as CallIndirectInstr; IrOptInfo._n(counts, i.Callee); IrOptInfo._args(counts, i.Args, i.ArgCount); return; }
        if (ins is MkClosInstr)    { MkClosInstr i = ins as MkClosInstr; IrOptInfo._args(counts, i.Captures, i.CaptureCount); return; }
        if (ins is ArrayGetInstr)  { ArrayGetInstr i = ins as ArrayGetInstr; IrOptInfo._n(counts, i.Arr); IrOptInfo._n(counts, i.Idx); return; }
        if (ins is ArraySetInstr)  { ArraySetInstr i = ins as ArraySetInstr; IrOptInfo._n(counts, i.Arr); IrOptInfo._n(counts, i.Idx); IrOptInfo._n(counts, i.Val); return; }
        if (ins is LoadLocalAddrInstr){ IrOptInfo._n(counts, (ins as LoadLocalAddrInstr).Slot); return; }
        // 无读操作数：Const* / DefaultOf / StaticGet / LoadFn / Typeof
    }

    // 终结子读的寄存器（镜像 _regtTerm）。RetTerm(有值) 读 Reg；BrCond 读 Cond；Throw 读 Reg。
    public static void AddTermReads(int[] counts, IrTerminator t) {
        if (t is RetTerm)     { RetTerm r = t as RetTerm; if (r.HasReg) { IrOptInfo._n(counts, r.Reg); } return; }
        if (t is BrCondTerm)  { IrOptInfo._n(counts, (t as BrCondTerm).Cond); return; }
        if (t is ThrowTerm)   { IrOptInfo._n(counts, (t as ThrowTerm).Reg); return; }
    }

    // ── 读操作数重写（improve-copy-prop-cascade）─────────────────────────────────────
    // 按 remap（TypedReg[] by reg id，null=不改）就地改写一条指令的**读**操作数（不动 Dst）。
    // 完整镜像 AddReads 的读枚举——漏一个操作数 = copy-prop use-site/CSE 改写不全 → miscompile。
    // 供 use-site copy-prop（dst→src 映射改所有 dst 使用点）+ CSE（重复计算的操作数改指首个结果）复用。
    public static void ReplaceReads(IrInstr ins, TypedReg[] remap) {
        if (ins is CopyInstr)      { CopyInstr i = ins as CopyInstr; i.Src = IrOptInfo._sub(i.Src, remap); return; }
        if (ins is AddInstr)       { AddInstr i = ins as AddInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is SubInstr)       { SubInstr i = ins as SubInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is MulInstr)       { MulInstr i = ins as MulInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is DivInstr)       { DivInstr i = ins as DivInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is RemInstr)       { RemInstr i = ins as RemInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is EqInstr)        { EqInstr i = ins as EqInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is NeInstr)        { NeInstr i = ins as NeInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is LtInstr)        { LtInstr i = ins as LtInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is LeInstr)        { LeInstr i = ins as LeInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is GtInstr)        { GtInstr i = ins as GtInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is GeInstr)        { GeInstr i = ins as GeInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is BitAndInstr)    { BitAndInstr i = ins as BitAndInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is BitOrInstr)     { BitOrInstr i = ins as BitOrInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is BitXorInstr)    { BitXorInstr i = ins as BitXorInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is ShlInstr)       { ShlInstr i = ins as ShlInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is ShrInstr)       { ShrInstr i = ins as ShrInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is StrConcatInstr) { StrConcatInstr i = ins as StrConcatInstr; i.A = IrOptInfo._sub(i.A, remap); i.B = IrOptInfo._sub(i.B, remap); return; }
        if (ins is NegInstr)       { NegInstr i = ins as NegInstr; i.Src = IrOptInfo._sub(i.Src, remap); return; }
        if (ins is NotInstr)       { NotInstr i = ins as NotInstr; i.Src = IrOptInfo._sub(i.Src, remap); return; }
        if (ins is BitNotInstr)    { BitNotInstr i = ins as BitNotInstr; i.Src = IrOptInfo._sub(i.Src, remap); return; }
        if (ins is ConvertInstr)   { ConvertInstr i = ins as ConvertInstr; i.Src = IrOptInfo._sub(i.Src, remap); return; }
        if (ins is ToStrInstr)     { ToStrInstr i = ins as ToStrInstr; i.Src = IrOptInfo._sub(i.Src, remap); return; }
        if (ins is CallInstr)      { CallInstr i = ins as CallInstr; IrOptInfo._subArgs(i.Args, i.ArgCount, remap); return; }
        if (ins is BuiltinInstr)   { BuiltinInstr i = ins as BuiltinInstr; IrOptInfo._subArgs(i.Args, i.ArgCount, remap); return; }
        if (ins is CallNativeInstr){ CallNativeInstr i = ins as CallNativeInstr; IrOptInfo._subArgs(i.Args, i.ArgCount, remap); return; }
        if (ins is VCallInstr)     { VCallInstr i = ins as VCallInstr; i.Obj = IrOptInfo._sub(i.Obj, remap); IrOptInfo._subArgs(i.Args, i.ArgCount, remap); return; }
        if (ins is FieldGetInstr)  { FieldGetInstr i = ins as FieldGetInstr; i.Obj = IrOptInfo._sub(i.Obj, remap); return; }
        if (ins is FieldSetInstr)  { FieldSetInstr i = ins as FieldSetInstr; i.Obj = IrOptInfo._sub(i.Obj, remap); i.Val = IrOptInfo._sub(i.Val, remap); return; }
        if (ins is ObjNewInstr)    { ObjNewInstr i = ins as ObjNewInstr; IrOptInfo._subArgs(i.Args, i.ArgCount, remap); return; }
        if (ins is IsInstanceInstr){ IsInstanceInstr i = ins as IsInstanceInstr; i.Obj = IrOptInfo._sub(i.Obj, remap); return; }
        if (ins is AsCastInstr)    { AsCastInstr i = ins as AsCastInstr; i.Obj = IrOptInfo._sub(i.Obj, remap); return; }
        if (ins is ArrayNewInstr)  { ArrayNewInstr i = ins as ArrayNewInstr; i.Size = IrOptInfo._sub(i.Size, remap); return; }
        if (ins is ArrayNewLitInstr){ ArrayNewLitInstr i = ins as ArrayNewLitInstr; IrOptInfo._subArgs(i.Elems, i.ElemCount, remap); return; }
        if (ins is StaticSetInstr) { StaticSetInstr i = ins as StaticSetInstr; i.Val = IrOptInfo._sub(i.Val, remap); return; }
        if (ins is ArrayLenInstr)  { ArrayLenInstr i = ins as ArrayLenInstr; i.Arr = IrOptInfo._sub(i.Arr, remap); return; }
        if (ins is CallIndirectInstr){ CallIndirectInstr i = ins as CallIndirectInstr; i.Callee = IrOptInfo._sub(i.Callee, remap); IrOptInfo._subArgs(i.Args, i.ArgCount, remap); return; }
        if (ins is MkClosInstr)    { MkClosInstr i = ins as MkClosInstr; IrOptInfo._subArgs(i.Captures, i.CaptureCount, remap); return; }
        if (ins is ArrayGetInstr)  { ArrayGetInstr i = ins as ArrayGetInstr; i.Arr = IrOptInfo._sub(i.Arr, remap); i.Idx = IrOptInfo._sub(i.Idx, remap); return; }
        if (ins is ArraySetInstr)  { ArraySetInstr i = ins as ArraySetInstr; i.Arr = IrOptInfo._sub(i.Arr, remap); i.Idx = IrOptInfo._sub(i.Idx, remap); i.Val = IrOptInfo._sub(i.Val, remap); return; }
        if (ins is LoadLocalAddrInstr){ LoadLocalAddrInstr i = ins as LoadLocalAddrInstr; i.Slot = IrOptInfo._sub(i.Slot, remap); return; }
        // 无读操作数：Const* / DefaultOf / StaticGet / LoadFn / Typeof
    }

    // 终结子读重写（镜像 AddTermReads）。
    public static void ReplaceTermReads(IrTerminator t, TypedReg[] remap) {
        if (t is RetTerm)    { RetTerm r = t as RetTerm; if (r.HasReg) { r.Reg = IrOptInfo._sub(r.Reg, remap); } return; }
        if (t is BrCondTerm) { BrCondTerm b = t as BrCondTerm; b.Cond = IrOptInfo._sub(b.Cond, remap); return; }
        if (t is ThrowTerm)  { ThrowTerm th = t as ThrowTerm; th.Reg = IrOptInfo._sub(th.Reg, remap); return; }
    }

    private static TypedReg _sub(TypedReg r, TypedReg[] remap) {
        if (r.Id >= 0 && r.Id < remap.Length && remap[r.Id] != null) { return remap[r.Id]; }
        return r;
    }
    private static void _subArgs(TypedReg[] args, int count, TypedReg[] remap) {
        int i = 0;
        while (i < count) { args[i] = IrOptInfo._sub(args[i], remap); i = i + 1; }
    }

    // ── CSE 值编号（add-cse-pass）────────────────────────────────────────────────────
    // 纯计算 op（arith/cmp/位/一元）的 value-number key：`op|a|b`（正定序，交换律规范化延后）。
    // 仅当 dst 单赋值(defs==1) + 所有操作数**稳定**（单赋值 temp / 从不重写形参 → 值恒定）才给 key，
    // 否则 null（不 CSE）：块内两次同 key ⇒ 同操作数、同值 ⇒ 可复用首个结果。Div/Rem 亦安全——首个
    // 在前，若 trap 则控制流不到第二个；否则同值。含分配/副作用/可空解引用者（StrConcat/FieldGet/Call/…）不入。
    public static string CseKey(IrInstr ins, int[] defs, int paramCount, int optSet) {
        // add-readonly-fields-opt：readonly 字段读消重（ReadonlyLoad 门控，独立于 arith CSE）。
        // 同一稳定接收者上对同一 readonly 字段的重复 field_get ⇒ 同值（构造后不变）⇒ 可复用首个。
        // FieldSet 失效由 _passCse 处理（ctor 内多次写不误合并）。imported 字段 Readonly=false → 不入。
        if (ins is FieldGetInstr) {
            FieldGetInstr fg = ins as FieldGetInstr;
            if (Opt.Has(optSet, Opt.ReadonlyLoad) && fg.Readonly
                && IrOptInfo._dstOk(fg.Dst, defs) && IrOptInfo._stableR(fg.Obj, defs, paramCount)) {
                return "fget|" + fg.Obj.Id.ToString() + "|" + fg.Field;
            }
            return null;
        }
        if (!Opt.Has(optSet, Opt.Cse)) { return null; }   // 以下 arith value-number 仅 Cse 位控
        if (ins is AddInstr)    { AddInstr i = ins as AddInstr; return IrOptInfo._binKey("add", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is SubInstr)    { SubInstr i = ins as SubInstr; return IrOptInfo._binKey("sub", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is MulInstr)    { MulInstr i = ins as MulInstr; return IrOptInfo._binKey("mul", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is DivInstr)    { DivInstr i = ins as DivInstr; return IrOptInfo._binKey("div", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is RemInstr)    { RemInstr i = ins as RemInstr; return IrOptInfo._binKey("rem", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is EqInstr)     { EqInstr i = ins as EqInstr; return IrOptInfo._binKey("eq", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is NeInstr)     { NeInstr i = ins as NeInstr; return IrOptInfo._binKey("ne", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is LtInstr)     { LtInstr i = ins as LtInstr; return IrOptInfo._binKey("lt", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is LeInstr)     { LeInstr i = ins as LeInstr; return IrOptInfo._binKey("le", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is GtInstr)     { GtInstr i = ins as GtInstr; return IrOptInfo._binKey("gt", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is GeInstr)     { GeInstr i = ins as GeInstr; return IrOptInfo._binKey("ge", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is BitAndInstr) { BitAndInstr i = ins as BitAndInstr; return IrOptInfo._binKey("band", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is BitOrInstr)  { BitOrInstr i = ins as BitOrInstr; return IrOptInfo._binKey("bor", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is BitXorInstr) { BitXorInstr i = ins as BitXorInstr; return IrOptInfo._binKey("bxor", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is ShlInstr)    { ShlInstr i = ins as ShlInstr; return IrOptInfo._binKey("shl", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is ShrInstr)    { ShrInstr i = ins as ShrInstr; return IrOptInfo._binKey("shr", i.Dst, i.A, i.B, defs, paramCount); }
        if (ins is NegInstr)    { NegInstr i = ins as NegInstr; return IrOptInfo._unKey("neg", i.Dst, i.Src, defs, paramCount); }
        if (ins is NotInstr)    { NotInstr i = ins as NotInstr; return IrOptInfo._unKey("not", i.Dst, i.Src, defs, paramCount); }
        if (ins is BitNotInstr) { BitNotInstr i = ins as BitNotInstr; return IrOptInfo._unKey("bnot", i.Dst, i.Src, defs, paramCount); }
        if (ins is ConvertInstr){ ConvertInstr i = ins as ConvertInstr; return IrOptInfo._unKeyT("conv", i.Dst, i.Src, defs, paramCount); }
        return null;
    }

    // CSE-able op 的 dst TypedReg（供 value-number 存首个 / 取重复 dst）；非 CSE-able → null。
    public static TypedReg DstReg(IrInstr ins) {
        if (ins is FieldGetInstr) { return (ins as FieldGetInstr).Dst; }   // add-readonly-fields-opt：readonly field_get 消重
        if (ins is AddInstr)    { return (ins as AddInstr).Dst; }
        if (ins is SubInstr)    { return (ins as SubInstr).Dst; }
        if (ins is MulInstr)    { return (ins as MulInstr).Dst; }
        if (ins is DivInstr)    { return (ins as DivInstr).Dst; }
        if (ins is RemInstr)    { return (ins as RemInstr).Dst; }
        if (ins is EqInstr)     { return (ins as EqInstr).Dst; }
        if (ins is NeInstr)     { return (ins as NeInstr).Dst; }
        if (ins is LtInstr)     { return (ins as LtInstr).Dst; }
        if (ins is LeInstr)     { return (ins as LeInstr).Dst; }
        if (ins is GtInstr)     { return (ins as GtInstr).Dst; }
        if (ins is GeInstr)     { return (ins as GeInstr).Dst; }
        if (ins is BitAndInstr) { return (ins as BitAndInstr).Dst; }
        if (ins is BitOrInstr)  { return (ins as BitOrInstr).Dst; }
        if (ins is BitXorInstr) { return (ins as BitXorInstr).Dst; }
        if (ins is ShlInstr)    { return (ins as ShlInstr).Dst; }
        if (ins is ShrInstr)    { return (ins as ShrInstr).Dst; }
        if (ins is NegInstr)    { return (ins as NegInstr).Dst; }
        if (ins is NotInstr)    { return (ins as NotInstr).Dst; }
        if (ins is BitNotInstr) { return (ins as BitNotInstr).Dst; }
        if (ins is ConvertInstr){ return (ins as ConvertInstr).Dst; }
        return null;
    }

    private static string _binKey(string op, TypedReg dst, TypedReg a, TypedReg b, int[] defs, int pc) {
        if (!IrOptInfo._dstOk(dst, defs)) { return null; }
        if (!IrOptInfo._stableR(a, defs, pc) || !IrOptInfo._stableR(b, defs, pc)) { return null; }
        return op + "|" + a.Id.ToString() + "|" + b.Id.ToString();
    }
    private static string _unKey(string op, TypedReg dst, TypedReg s, int[] defs, int pc) {
        if (!IrOptInfo._dstOk(dst, defs)) { return null; }
        if (!IrOptInfo._stableR(s, defs, pc)) { return null; }
        return op + "|" + s.Id.ToString();
    }
    // convert 结果类型随 Dst.Type → key 含目标类型标签（同 src 不同目标类型不可复用）。
    private static string _unKeyT(string op, TypedReg dst, TypedReg s, int[] defs, int pc) {
        if (!IrOptInfo._dstOk(dst, defs)) { return null; }
        if (!IrOptInfo._stableR(s, defs, pc)) { return null; }
        return op + "|" + s.Id.ToString() + "|t" + dst.Type.ToString();
    }
    private static bool _dstOk(TypedReg d, int[] defs) { return d.Id >= 0 && d.Id < defs.Length && defs[d.Id] == 1; }
    private static bool _stableR(TypedReg r, int[] defs, int pc) {
        int id = r.Id;
        if (id < 0 || id >= defs.Length) { return false; }
        if (id < pc) { return defs[id] == 0; }
        return defs[id] == 1;
    }

    // 可删性白名单：仅明确无副作用（不抛/不调用户码/不写内存/不分配）→ true。
    // 排除：Div/Rem（除零陷阱）、ArrayLen/FieldGet/ArrayGet（NPE/越界）、ToStr（调 ToString）、
    //       Call*/VCall/ObjNew/*Set（副作用）、StaticGet（可能触发静态初始化）、ArrayNew*/MkClos/
    //       StrConcat/LoadFn（分配，v1 保守不删）。未列出者默认 false（保留）。
    public static bool IsPure(IrInstr ins) {
        if (ins is ConstI32Instr)  { return true; }
        if (ins is ConstI64Instr)  { return true; }
        if (ins is ConstF64Instr)  { return true; }
        if (ins is ConstBoolInstr) { return true; }
        if (ins is ConstCharInstr) { return true; }
        if (ins is ConstStrInstr)  { return true; }
        if (ins is ConstNullInstr) { return true; }
        if (ins is DefaultOfInstr) { return true; }
        if (ins is CopyInstr)      { return true; }
        if (ins is AddInstr)       { return true; }
        if (ins is SubInstr)       { return true; }
        if (ins is MulInstr)       { return true; }
        if (ins is NegInstr)       { return true; }
        if (ins is NotInstr)       { return true; }
        if (ins is BitNotInstr)    { return true; }
        if (ins is ConvertInstr)   { return true; }
        if (ins is BitAndInstr)    { return true; }
        if (ins is BitOrInstr)     { return true; }
        if (ins is BitXorInstr)    { return true; }
        if (ins is ShlInstr)       { return true; }
        if (ins is ShrInstr)       { return true; }
        if (ins is EqInstr)        { return true; }
        if (ins is NeInstr)        { return true; }
        if (ins is LtInstr)        { return true; }
        if (ins is LeInstr)        { return true; }
        if (ins is GtInstr)        { return true; }
        if (ins is GeInstr)        { return true; }
        if (ins is IsInstanceInstr){ return true; }
        if (ins is AsCastInstr)    { return true; }
        if (ins is TypeofInstr)    { return true; }
        return false;
    }

    // 写计数：counts[DstId] += 1（copy-prop 需 defs[t]==1 判 t 单赋值）。
    public static void AddDef(int[] counts, IrInstr ins) {
        int d = IrOptInfo.DstId(ins);
        if (d >= 0 && d < counts.Length) { counts[d] = counts[d] + 1; }
    }

    // 把指令的 Dst 改写为 nd（copy-prop retarget producer）。成功 true；无 Dst/不支持 false（→ 跳过该优化，安全）。
    // 覆盖全部 Dst-bearing opcode（镜像 DstId 的正例）。
    public static bool SetDst(IrInstr ins, TypedReg nd) {
        if (ins is ConstI32Instr)  { (ins as ConstI32Instr).Dst = nd; return true; }
        if (ins is ConstI64Instr)  { (ins as ConstI64Instr).Dst = nd; return true; }
        if (ins is ConstF64Instr)  { (ins as ConstF64Instr).Dst = nd; return true; }
        if (ins is ConstBoolInstr) { (ins as ConstBoolInstr).Dst = nd; return true; }
        if (ins is ConstCharInstr) { (ins as ConstCharInstr).Dst = nd; return true; }
        if (ins is ConstStrInstr)  { (ins as ConstStrInstr).Dst = nd; return true; }
        if (ins is ConstNullInstr) { (ins as ConstNullInstr).Dst = nd; return true; }
        if (ins is DefaultOfInstr) { (ins as DefaultOfInstr).Dst = nd; return true; }
        if (ins is CopyInstr)      { (ins as CopyInstr).Dst = nd; return true; }
        if (ins is AddInstr)       { (ins as AddInstr).Dst = nd; return true; }
        if (ins is SubInstr)       { (ins as SubInstr).Dst = nd; return true; }
        if (ins is MulInstr)       { (ins as MulInstr).Dst = nd; return true; }
        if (ins is DivInstr)       { (ins as DivInstr).Dst = nd; return true; }
        if (ins is RemInstr)       { (ins as RemInstr).Dst = nd; return true; }
        if (ins is NegInstr)       { (ins as NegInstr).Dst = nd; return true; }
        if (ins is NotInstr)       { (ins as NotInstr).Dst = nd; return true; }
        if (ins is BitNotInstr)    { (ins as BitNotInstr).Dst = nd; return true; }
        if (ins is ConvertInstr)   { (ins as ConvertInstr).Dst = nd; return true; }
        if (ins is ToStrInstr)     { (ins as ToStrInstr).Dst = nd; return true; }
        if (ins is BitAndInstr)    { (ins as BitAndInstr).Dst = nd; return true; }
        if (ins is BitOrInstr)     { (ins as BitOrInstr).Dst = nd; return true; }
        if (ins is BitXorInstr)    { (ins as BitXorInstr).Dst = nd; return true; }
        if (ins is ShlInstr)       { (ins as ShlInstr).Dst = nd; return true; }
        if (ins is ShrInstr)       { (ins as ShrInstr).Dst = nd; return true; }
        if (ins is EqInstr)        { (ins as EqInstr).Dst = nd; return true; }
        if (ins is NeInstr)        { (ins as NeInstr).Dst = nd; return true; }
        if (ins is LtInstr)        { (ins as LtInstr).Dst = nd; return true; }
        if (ins is LeInstr)        { (ins as LeInstr).Dst = nd; return true; }
        if (ins is GtInstr)        { (ins as GtInstr).Dst = nd; return true; }
        if (ins is GeInstr)        { (ins as GeInstr).Dst = nd; return true; }
        if (ins is StrConcatInstr) { (ins as StrConcatInstr).Dst = nd; return true; }
        if (ins is CallInstr)      { (ins as CallInstr).Dst = nd; return true; }
        if (ins is BuiltinInstr)   { (ins as BuiltinInstr).Dst = nd; return true; }
        if (ins is CallNativeInstr){ (ins as CallNativeInstr).Dst = nd; return true; }
        if (ins is VCallInstr)     { (ins as VCallInstr).Dst = nd; return true; }
        if (ins is FieldGetInstr)  { (ins as FieldGetInstr).Dst = nd; return true; }
        if (ins is ObjNewInstr)    { (ins as ObjNewInstr).Dst = nd; return true; }
        if (ins is IsInstanceInstr){ (ins as IsInstanceInstr).Dst = nd; return true; }
        if (ins is AsCastInstr)    { (ins as AsCastInstr).Dst = nd; return true; }
        if (ins is TypeofInstr)    { (ins as TypeofInstr).Dst = nd; return true; }
        if (ins is ArrayNewInstr)  { (ins as ArrayNewInstr).Dst = nd; return true; }
        if (ins is ArrayNewLitInstr){ (ins as ArrayNewLitInstr).Dst = nd; return true; }
        if (ins is StaticGetInstr) { (ins as StaticGetInstr).Dst = nd; return true; }
        if (ins is ArrayLenInstr)  { (ins as ArrayLenInstr).Dst = nd; return true; }
        if (ins is LoadFnInstr)    { (ins as LoadFnInstr).Dst = nd; return true; }
        if (ins is CallIndirectInstr){ (ins as CallIndirectInstr).Dst = nd; return true; }
        if (ins is MkClosInstr)    { (ins as MkClosInstr).Dst = nd; return true; }
        if (ins is ArrayGetInstr)  { (ins as ArrayGetInstr).Dst = nd; return true; }
        if (ins is LoadLocalAddrInstr){ (ins as LoadLocalAddrInstr).Dst = nd; return true; }
        return false;
    }

    // 计一次读（防越界：超出 counts 范围的寄存器不计 → 保守，不会误删）。
    private static void _n(int[] counts, TypedReg r) {
        if (r.Id >= 0 && r.Id < counts.Length) { counts[r.Id] = counts[r.Id] + 1; }
    }
    private static void _args(int[] counts, TypedReg[] args, int argCount) {
        int i = 0;
        while (i < argCount) { IrOptInfo._n(counts, args[i]); i = i + 1; }
    }
}
