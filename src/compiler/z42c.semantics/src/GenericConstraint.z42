// 泛型约束模型（port-z42c-semantics 2B）。镜像 C# `GenericConstraintBundle` 的可行子集。
//
// 判定规则的唯一真相源是**运行期** `src/runtime/src/corelib/reflection/generics.rs::
// validate_type_arg_constraint`（七项俱全）——编译期照抄，不另立规则。当前落地：
//   base-class（where T : C）/ class / struct / 型参引用（where U : T）/ interface（含继承闭包）
//   / enum / new()  + class·struct 互斥。
// 延后：func-type 约束（E0422/E0423 已定义但从未发出；
//   Deferred where-constraint-future-func-constraint——注意 CallEmitter 靠该约束把参数当
//   func 值走 CallIndirect，改动需谨慎）。
//
// > 注：原注释称「z42c 缺 Z42InterfaceType / 缺 ctor 收集」——**均已过时**。
// > `Z42InterfaceType` 是独立类型、`SymbolTable.Implements` 早被 Conversion/DeclBinder 消费；
// > ctor 也早已由 MemberCollector 收集为方法（名=类名）。接口约束因此是**接线**而非造能力。
//
// 受限写法：class + public 字段；约束集用 typed array + int count（类字段不能带泛型）。
namespace Z42.Semantics;

// 单个型参（如 T）的约束集合。
public sealed class ConstraintBundle {
    public bool   HasBaseClass;    // where T : SomeClass
    public string BaseClassName;
    public bool   RequiresClass;   // where T : class
    public bool   RequiresStruct;  // where T : struct
    public bool   HasTypeParamRef; // where U : T
    public string TypeParamRef;    // 引用的型参名（"T"）
    public bool   RequiresEnum;    // where T : enum
    public bool   RequiresCtor;    // where T : new()
    // where T : IFoo —— **裸名**（去 `<...>`，见 design D1）。一个型参可有多条接口约束
    // （`where T : IFoo + IBar`），故用 typed array + count（类字段不能带泛型）。
    public string[] InterfaceNames;
    public int      InterfaceCount;

    public ConstraintBundle() {
        this.HasBaseClass = false; this.BaseClassName = "";
        this.RequiresClass = false; this.RequiresStruct = false;
        this.HasTypeParamRef = false; this.TypeParamRef = "";
        this.InterfaceNames = new string[0]; this.InterfaceCount = 0;
        this.RequiresEnum = false; this.RequiresCtor = false;
    }

    public void AddInterface(string name) {
        if (this.InterfaceCount == this.InterfaceNames.Length) {
            int cap = this.InterfaceNames.Length * 2;
            if (cap < 2) { cap = 2; }
            string[] bigger = new string[cap];
            int i = 0;
            while (i < this.InterfaceCount) { bigger[i] = this.InterfaceNames[i]; i = i + 1; }
            this.InterfaceNames = bigger;
        }
        this.InterfaceNames[this.InterfaceCount] = name;
        this.InterfaceCount = this.InterfaceCount + 1;
    }

    public bool IsEmpty() {
        return !this.HasBaseClass && !this.RequiresClass && !this.RequiresStruct
            && !this.HasTypeParamRef && this.InterfaceCount == 0
            && !this.RequiresEnum && !this.RequiresCtor;
    }
}

// 一个泛型类的约束集：型参名（全部，按声明序）↔ bundle 一一对齐（无约束者为 empty bundle）。
// 与 Z42InstantiatedType.TypeArgs 按索引对齐 → call-site 校验直接 Bundles[i] vs TypeArgs[i]。
public sealed class ConstraintSet {
    public string[]           ParamNames;
    public ConstraintBundle[] Bundles;
    public int                Count;

    public ConstraintSet(string[] paramNames, ConstraintBundle[] bundles, int count) {
        this.ParamNames = paramNames; this.Bundles = bundles; this.Count = count;
    }

    // 型参名 → 索引（未找到 -1）。用于 where U : T 引用解析。
    public int IndexOf(string name) {
        int i = 0;
        while (i < this.Count) {
            if (this.ParamNames[i] == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // 是否至少有一个非空约束（决定是否登记进符号表）。
    public bool AnyNonEmpty() {
        int i = 0;
        while (i < this.Count) {
            if (!this.Bundles[i].IsEmpty()) { return true; }
            i = i + 1;
        }
        return false;
    }
}
