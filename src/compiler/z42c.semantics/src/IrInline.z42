// IrInline —— 编译期函数内联 pass（add-compiler-inlining Phase 2；OptSet.Inline 位驱动）。
//
// 设计全文见 docs/spec/changes/add-compiler-inlining/design.md（D4 资格 / D5 展开 / D7 不动点）+
// docs/book/src/compiler/optimization-pipeline.md。挂载点：IrOptPipeline.Run 里、逐函数清理 pass **之前**
// （内联靠前 → 产出更多下游 const-fold/copy-prop/dce 机会）。
//
// ── v1 curated 集（保守起步）─────────────────────────────────────────────────────────
// z42 IR **无统一「重映射一条指令的寄存器」操作**——每种指令各有自己的 TypedReg 字段。内联要
// 逐指令类型克隆 + 寄存器重命名，故 v1 只支持一组直线（straight-line）curated 指令：
//   const（i32/i64/f64/bool/char/str/null）/ copy / 算术（add/sub/mul/div/rem）/
//   比较（eq/ne/lt/le/gt/ge）/ 位与一元（bit_and/or/xor/shl/shr/not/neg/bit_not/convert）/ field_get。
// callee 体含任何**非** curated 指令（call/vcall/obj_new/array_*/field_set/static_*/str_concat/...）→
// **跳过该 callee**（不内联，保守正确）。curated 集天然排除：嵌套调用（→ 无递归展开风险）、分配、
// 副作用存储、ref/out（无地址/存储指令）。
//
// ── 资格（D4，逐条见 _eligibleCallee）─────────────────────────────────────────────────
//   ① 直接 CallInstr（非 VCall——VCall 不入本 pass）；② callee 同模块可解析（IrModule = 单 CU，
//   函数共享 StringPool → ConstStr idx 内联后仍有效）；③ 非递归（callee.Name ≠ caller.Name；curated 体
//   无嵌套调用 → 不存在间接递归）；④ callee **单块**且终结子 = RetTerm（v1 不做多块重贴标签/续延块）；
//   ⑤ 无异常表 / 无 varargs / 实参数 == 形参数（精确 arity，避开默认值/params 打包）；
//   ⑥ instrCount ≤ INLINE_MAX_SIZE **或** 全模块单调用点（恒内联）。
//
// ── 展开（D5）────────────────────────────────────────────────────────────────────────
//   offset = caller.MaxReg（fresh reg 区，> 所有 caller reg，无碰撞）；callee reg r → caller reg r+offset。
//   ① 形参绑定：形参 reg p（0..ParamCount-1，静态/自由函数无 this）→ `copy (p+offset), arg[p]`（在调用点，
//      与调用语义同：实参在调用点求值）；② body：单块每条指令 curated 克隆 + reg +offset；
//   ③ Ret：有值 → `copy call.Dst, (retReg+offset)`（绑返回值到调用结果），void → 无（丢弃）；
//   ④ CallInstr 被上述序列原地取代；⑤ reg_types 同步扩（callee.RegTypes[r] → caller.RegTypes[r+offset]，
//      否则内联后 typed 指令 / JIT i64 特化失效）；⑥ 稳定序（按 block/instr idx 顺扫）→ 输出确定
//      （自举不动点前提，D7）；⑦ per-caller 预算（INLINE_CALLER_BUDGET）防爆炸；单块 curated →
//      展开深度天然 = 1（body 无嵌套调用可再展开）。
namespace Z42.Semantics;

using Z42.IR;

public sealed class IrInline {

    public static int INLINE_MAX_SIZE      = 24;    // callee 单块指令数上限（超过则仅单调用点才内联）
    public static int INLINE_CALLER_BUDGET = 256;   // 单 caller 累计内联指令预算（防代码爆炸）

    // 模块级入口：逐 caller 展开其内的合格调用点。IrModule = 单 CU，callee 在同模块内解析。
    //
    // 传导内联（emergent）：按 m.Functions **声明序**逐 caller 处理、就地改写 body。故先定义的 callee 若
    // 在其自身处理时把内部调用内联成了 curated 直线体，随后处理的 caller 会看到这份「已内联的」body 并可
    // 再内联它——即沿声明序向后自然传导。结果对声明序确定（同源同序 → 同输出，自举不动点成立，D7）；
    // 每函数只处理一次 + per-caller 预算 → 终止且有界。
    public static void Run(IrModule m) {
        int fi = 0;
        while (fi < m.FuncCount) {
            IrInline._inlineInto(m, m.Functions[fi]);
            fi = fi + 1;
        }
    }

    // 把 caller 内所有合格 CallInstr 就地内联展开。
    private static void _inlineInto(IrModule m, IrFunction caller) {
        if (caller.BlockCount == 0) { return; }   // 抽象/extern 桩：无体
        int runningMax = caller.MaxReg;           // fresh reg 分配游标（单调增）
        int budget = 0;                           // 已内联指令累计（对 INLINE_CALLER_BUDGET）
        bool changed = false;
        // RegTypes 扩展记录：每次内联记 (offset, callee) → 收尾统一重建 caller.RegTypes。
        int[] recOff = new int[4];
        IrFunction[] recFn = new IrFunction[4];
        int recCount = 0;
        int bi = 0;
        while (bi < caller.BlockCount) {
            IrBlock blk = caller.Blocks[bi];
            IrInstr[] outI = new IrInstr[blk.InstrCount + 4];
            int oc = 0;
            bool blkChanged = false;
            int ii = 0;
            while (ii < blk.InstrCount) {
                IrInstr ins = blk.Instrs[ii];
                IrFunction callee = IrInline._eligibleCallee(m, caller, ins, budget);
                if (callee != null) {
                    CallInstr call = ins as CallInstr;
                    IrBlock cb = callee.Blocks[0];
                    int offset = runningMax;
                    // ① 形参绑定：copy (p+offset) = arg[p]
                    int p = 0;
                    while (p < callee.ParamCount) {
                        TypedReg np = new TypedReg(p + offset, IrInline._calleeRegType(callee, p));
                        outI = IrInline._push(outI, oc, new CopyInstr(np, call.Args[p])); oc = oc + 1;
                        p = p + 1;
                    }
                    // ② body：单块每条 curated 指令克隆 + reg +offset
                    int ci = 0;
                    while (ci < cb.InstrCount) {
                        outI = IrInline._push(outI, oc, IrInline._cloneRemap(cb.Instrs[ci], offset)); oc = oc + 1;
                        ci = ci + 1;
                    }
                    // ③ Ret 绑定：有值 → copy call.Dst = retReg+offset
                    RetTerm rt = cb.Term as RetTerm;
                    if (rt.HasReg) {
                        outI = IrInline._push(outI, oc, new CopyInstr(call.Dst, IrInline._rr(rt.Reg, offset))); oc = oc + 1;
                    }
                    // ⑤/⑦ 记录 + 游标 + 预算
                    recOff = IrInline._pushInt(recOff, recCount, offset);
                    recFn = IrInline._pushFn(recFn, recCount, callee);
                    recCount = recCount + 1;
                    runningMax = offset + callee.MaxReg;
                    budget = budget + cb.InstrCount;
                    changed = true;
                    blkChanged = true;
                } else {
                    outI = IrInline._push(outI, oc, ins); oc = oc + 1;
                }
                ii = ii + 1;
            }
            if (blkChanged) {
                blk.Instrs = IrInline._trim(outI, oc);
                blk.InstrCount = oc;
            }
            bi = bi + 1;
        }
        if (!changed) { return; }
        caller.MaxReg = runningMax;
        IrInline._extendRegTypes(caller, runningMax, recOff, recFn, recCount);
    }

    // ── 资格判定（D4）────────────────────────────────────────────────────────────────
    // 返回可内联的 callee IrFunction；任一阻断特征 → null（跳过，保守）。
    private static IrFunction _eligibleCallee(IrModule m, IrFunction caller, IrInstr ins, int budget) {
        if (budget >= IrInline.INLINE_CALLER_BUDGET) { return null; }   // ⑦ 预算耗尽
        if (!(ins is CallInstr)) { return null; }                        // ① 仅直接调用
        CallInstr call = ins as CallInstr;
        IrFunction callee = IrInline._findFunc(m, call.Func);
        if (callee == null) { return null; }                             // ② 同模块可解析
        if (callee.Name == caller.Name) { return null; }                 // ③ 非递归
        if (callee.BlockCount != 1) { return null; }                     // ④ 单块
        IrBlock cb = callee.Blocks[0];
        if (!cb.HasTerm) { return null; }
        if (!(cb.Term is RetTerm)) { return null; }                      // ④ 终结子 = Ret
        if (callee.ExcCount != 0) { return null; }                       // ⑤ 无异常表
        if (callee.ParamsFrom != 255) { return null; }                   // ⑤ 无 varargs
        if (call.ArgCount != callee.ParamCount) { return null; }         // ⑤ 精确 arity
        // curated 体检查：任一非 curated 指令 → 跳过整个 callee
        int ci = 0;
        while (ci < cb.InstrCount) {
            if (!IrInline._isInlinable(cb.Instrs[ci])) { return null; }
            ci = ci + 1;
        }
        // ⑥ 尺寸门：超阈值仅当全模块单调用点才恒内联
        if (cb.InstrCount > IrInline.INLINE_MAX_SIZE) {
            if (IrInline._countCallSites(m, call.Func) != 1) { return null; }
        }
        return callee;
    }

    // 同模块按名解析 callee（线性；首个匹配，稳定序）。
    private static IrFunction _findFunc(IrModule m, string name) {
        int i = 0;
        while (i < m.FuncCount) {
            if (m.Functions[i].Name == name) { return m.Functions[i]; }
            i = i + 1;
        }
        return null;
    }

    // 全模块 CallInstr 中 Func==name 的调用点数（单调用点恒内联判定）。
    private static int _countCallSites(IrModule m, string name) {
        int n = 0;
        int fi = 0;
        while (fi < m.FuncCount) {
            IrFunction f = m.Functions[fi];
            int bi = 0;
            while (bi < f.BlockCount) {
                IrBlock blk = f.Blocks[bi];
                int ii = 0;
                while (ii < blk.InstrCount) {
                    IrInstr ins = blk.Instrs[ii];
                    if (ins is CallInstr) { if ((ins as CallInstr).Func == name) { n = n + 1; } }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
            fi = fi + 1;
        }
        return n;
    }

    // ── curated 白名单（必须与 _cloneRemap 覆盖集完全一致）──────────────────────────────
    private static bool _isInlinable(IrInstr ins) {
        if (ins is ConstI32Instr)  { return true; }
        if (ins is ConstI64Instr)  { return true; }
        if (ins is ConstF64Instr)  { return true; }
        if (ins is ConstBoolInstr) { return true; }
        if (ins is ConstCharInstr) { return true; }
        if (ins is ConstStrInstr)  { return true; }
        if (ins is ConstNullInstr) { return true; }
        if (ins is CopyInstr)      { return true; }
        if (ins is AddInstr)       { return true; }
        if (ins is SubInstr)       { return true; }
        if (ins is MulInstr)       { return true; }
        if (ins is DivInstr)       { return true; }
        if (ins is RemInstr)       { return true; }
        if (ins is NegInstr)       { return true; }
        if (ins is NotInstr)       { return true; }
        if (ins is BitNotInstr)    { return true; }
        if (ins is ConvertInstr)   { return true; }
        if (ins is BitAndInstr)    { return true; }
        if (ins is BitOrInstr)     { return true; }
        if (ins is BitXorInstr)    { return true; }
        if (ins is ShlInstr)       { return true; }
        if (ins is ShrInstr)       { return true; }
        if (ins is EqInstr)        { return true; }
        if (ins is NeInstr)        { return true; }
        if (ins is LtInstr)        { return true; }
        if (ins is LeInstr)        { return true; }
        if (ins is GtInstr)        { return true; }
        if (ins is GeInstr)        { return true; }
        if (ins is FieldGetInstr)  { return true; }
        return false;
    }

    // 逐指令克隆 + 全寄存器 +offset 重命名。仅 curated 集（_isInlinable 已保证）；其余理论不达，
    // 兜底返回原指令的 Copy 会破坏，故此处对未覆盖类型返回一个安全占位（const.null 到 dst 不可能达到）。
    private static IrInstr _cloneRemap(IrInstr ins, int offset) {
        if (ins is ConstI32Instr)  { ConstI32Instr i = ins as ConstI32Instr; return new ConstI32Instr(IrInline._rr(i.Dst, offset), i.Text); }
        if (ins is ConstI64Instr)  { ConstI64Instr i = ins as ConstI64Instr; return new ConstI64Instr(IrInline._rr(i.Dst, offset), i.Text); }
        if (ins is ConstF64Instr)  { ConstF64Instr i = ins as ConstF64Instr; return new ConstF64Instr(IrInline._rr(i.Dst, offset), i.Text); }
        if (ins is ConstBoolInstr) { ConstBoolInstr i = ins as ConstBoolInstr; return new ConstBoolInstr(IrInline._rr(i.Dst, offset), i.Value); }
        if (ins is ConstCharInstr) { ConstCharInstr i = ins as ConstCharInstr; return new ConstCharInstr(IrInline._rr(i.Dst, offset), i.Val); }
        if (ins is ConstStrInstr)  { ConstStrInstr i = ins as ConstStrInstr; return new ConstStrInstr(IrInline._rr(i.Dst, offset), i.Idx); }
        if (ins is ConstNullInstr) { ConstNullInstr i = ins as ConstNullInstr; return new ConstNullInstr(IrInline._rr(i.Dst, offset)); }
        if (ins is CopyInstr)      { CopyInstr i = ins as CopyInstr; return new CopyInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.Src, offset)); }
        if (ins is AddInstr)       { AddInstr i = ins as AddInstr; return new AddInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is SubInstr)       { SubInstr i = ins as SubInstr; return new SubInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is MulInstr)       { MulInstr i = ins as MulInstr; return new MulInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is DivInstr)       { DivInstr i = ins as DivInstr; return new DivInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is RemInstr)       { RemInstr i = ins as RemInstr; return new RemInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is NegInstr)       { NegInstr i = ins as NegInstr; return new NegInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.Src, offset)); }
        if (ins is NotInstr)       { NotInstr i = ins as NotInstr; return new NotInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.Src, offset)); }
        if (ins is BitNotInstr)    { BitNotInstr i = ins as BitNotInstr; return new BitNotInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.Src, offset)); }
        if (ins is ConvertInstr)   { ConvertInstr i = ins as ConvertInstr; return new ConvertInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.Src, offset)); }
        if (ins is BitAndInstr)    { BitAndInstr i = ins as BitAndInstr; return new BitAndInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is BitOrInstr)     { BitOrInstr i = ins as BitOrInstr; return new BitOrInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is BitXorInstr)    { BitXorInstr i = ins as BitXorInstr; return new BitXorInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is ShlInstr)       { ShlInstr i = ins as ShlInstr; return new ShlInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is ShrInstr)       { ShrInstr i = ins as ShrInstr; return new ShrInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is EqInstr)        { EqInstr i = ins as EqInstr; return new EqInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is NeInstr)        { NeInstr i = ins as NeInstr; return new NeInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is LtInstr)        { LtInstr i = ins as LtInstr; return new LtInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is LeInstr)        { LeInstr i = ins as LeInstr; return new LeInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is GtInstr)        { GtInstr i = ins as GtInstr; return new GtInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is GeInstr)        { GeInstr i = ins as GeInstr; return new GeInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.A, offset), IrInline._rr(i.B, offset)); }
        if (ins is FieldGetInstr)  { FieldGetInstr i = ins as FieldGetInstr; return new FieldGetInstr(IrInline._rr(i.Dst, offset), IrInline._rr(i.Obj, offset), i.Field); }
        // 不可达（_isInlinable 已滤）；返回原指令仅为类型完整（不会执行到）。
        return ins;
    }

    // TypedReg 重命名：id +offset，类型标签保留（callee IR 已正确）。
    private static TypedReg _rr(TypedReg r, int offset) {
        return new TypedReg(r.Id + offset, r.Type);
    }

    // callee reg r 的类型标签（越界 → Unknown）。
    private static int _calleeRegType(IrFunction callee, int r) {
        if (r >= 0 && r < callee.RegTypeCount) { return callee.RegTypes[r]; }
        return IrType.Unknown;
    }

    // reg_types 扩展：caller.RegTypes 覆盖到 runningMax，callee.RegTypes[r] → caller[offset+r]。
    private static void _extendRegTypes(IrFunction caller, int runningMax, int[] recOff, IrFunction[] recFn, int recCount) {
        int len = runningMax;
        if (caller.RegTypeCount > len) { len = caller.RegTypeCount; }
        int[] nrt = new int[len];
        int i = 0;
        while (i < caller.RegTypeCount) { nrt[i] = caller.RegTypes[i]; i = i + 1; }
        int r = 0;
        while (r < recCount) {
            int offset = recOff[r];
            IrFunction callee = recFn[r];
            int c = 0;
            while (c < callee.RegTypeCount) {
                int idx = offset + c;
                if (idx >= 0 && idx < len) { nrt[idx] = callee.RegTypes[c]; }
                c = c + 1;
            }
            r = r + 1;
        }
        caller.RegTypes = nrt;
        caller.RegTypeCount = len;
    }

    // ── growable helpers ─────────────────────────────────────────────────────────────
    private static IrInstr[] _push(IrInstr[] arr, int count, IrInstr x) {
        if (count >= arr.Length) {
            IrInstr[] n = new IrInstr[arr.Length * 2 + 8];
            int i = 0;
            while (i < count) { n[i] = arr[i]; i = i + 1; }
            arr = n;
        }
        arr[count] = x;
        return arr;
    }
    private static IrInstr[] _trim(IrInstr[] arr, int count) {
        IrInstr[] n = new IrInstr[count];
        int i = 0;
        while (i < count) { n[i] = arr[i]; i = i + 1; }
        return n;
    }
    private static int[] _pushInt(int[] arr, int count, int v) {
        if (count >= arr.Length) {
            int[] n = new int[arr.Length * 2 + 8];
            int i = 0;
            while (i < count) { n[i] = arr[i]; i = i + 1; }
            arr = n;
        }
        arr[count] = v;
        return arr;
    }
    private static IrFunction[] _pushFn(IrFunction[] arr, int count, IrFunction v) {
        if (count >= arr.Length) {
            IrFunction[] n = new IrFunction[arr.Length * 2 + 8];
            int i = 0;
            while (i < count) { n[i] = arr[i]; i = i + 1; }
            arr = n;
        }
        arr[count] = v;
        return arr;
    }
}
