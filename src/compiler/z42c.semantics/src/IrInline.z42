// IrInline —— 编译期函数内联 pass（add-compiler-inlining Phase 2；OptSet.Inline 位驱动）。
//
// 设计全文见 docs/spec/changes/add-compiler-inlining/design.md（D4 资格 / D5 展开 / D7 不动点）+
// docs/book/src/compiler/optimization-pipeline.md。挂载点：IrOptPipeline.Run 里、逐函数清理 pass **之前**
// （内联靠前 → 产出更多下游 const-fold/copy-prop/dce 机会）。
//
// ── v1 curated 集（保守起步）─────────────────────────────────────────────────────────
// z42 IR **无统一「重映射一条指令的寄存器」操作**——每种指令各有自己的 TypedReg 字段。内联要
// 逐指令类型克隆 + 寄存器重命名，故 v1 只支持一组直线（straight-line）curated 指令：
//   const（i32/i64/f64/bool/char/str/null）/ copy / 算术（add/sub/mul/div/rem）/
//   比较（eq/ne/lt/le/gt/ge）/ 位与一元（bit_and/or/xor/shl/shr/not/neg/bit_not/convert）/ field_get。
// callee 体含任何**非** curated 指令（call/vcall/obj_new/array_*/field_set/static_*/str_concat/...）→
// **跳过该 callee**（不内联，保守正确）。curated 集天然排除：嵌套调用（→ 无递归展开风险）、分配、
// 副作用存储、ref/out（无地址/存储指令）。
//
// ── 资格（D4，逐条见 _eligibleCallee）─────────────────────────────────────────────────
//   ① 直接 CallInstr（非 VCall——VCall 不入本 pass）；② callee 同模块可解析（IrModule = 单 CU，
//   函数共享 StringPool → ConstStr idx 内联后仍有效）；③ 非递归（callee.Name ≠ caller.Name；curated 体
//   无嵌套调用 → 不存在间接递归）；④ **每块**终结子 ∈ {Ret,Br,BrCond}（Throw 不可内联）+ 全 curated 指令
//   （单块 Phase A 就地 splice；多块 Phase B 拆 caller 块 + relabel + Ret→续延块，inline-multiblock）；
//   ⑤ 无异常表 / 无 varargs / 实参数 == 形参数（精确 arity，避开默认值/params 打包）；
//   ⑥ **总** instrCount ≤ INLINE_MAX_SIZE **或** 全模块单调用点（恒内联）。
//
// ── 展开（D5）────────────────────────────────────────────────────────────────────────
//   offset = caller.MaxReg（fresh reg 区，> 所有 caller reg，无碰撞）；callee reg r → caller reg r+offset。
//   ① 形参绑定（clean-inline-copies）：**只读**形参（body 未写）→ body 中直接代入调用方**实参寄存器**、
//      **不 emit copy**（只读形参只作读操作数、从不是 dst → 代入实参安全，等价于调用点求值）；**被写**形参
//      → `copy (p+offset), arg[p]` 材料化到可写 fresh reg（body remap 到 p+offset）；② body：单块每条 curated
//      指令克隆 + 按 ctx 重映射（只读形参→实参 / 其余→+offset）；
//   ③ Ret：有值 → `copy call.Dst, (retReg+offset)`（绑返回值到调用结果），void → 无（丢弃）；
//   ④ 单块：CallInstr 被上述序列原地取代；⑤ reg_types 同步扩（callee.RegTypes[r] → caller.RegTypes[r+offset]，
//      否则内联后 typed 指令 / JIT i64 特化失效）；⑥ 稳定序（Phase B 唯一标签前缀 `__il<ctr>_` 按处理序
//      递增）→ 输出确定（自举不动点前提，D7）；⑦ per-caller 预算（INLINE_CALLER_BUDGET）防爆炸；curated
//      体无嵌套调用 → 内联深度天然 = 1。
//   **多块展开（Phase B，inline-multiblock）**：拆 caller 块为 head（前半 + 被写形参 copy + `br entry`）与
//      cont（后半 + 原终结子）；中间插 callee 各块（relabel `prefix+label`、指令 clone+remap、Br/BrCond 目标
//      relabel、每 Ret → 绑返回值 + `br cont`）。形参 copy 放 head → 只执行一次（loop 安全）。
namespace Z42.Semantics;

using Z42.IR;

// 内联展开的寄存器重映射上下文（clean-inline-copies）：
//   - callee **只读形参**（body 中从不被写）→ 直接代入调用方**实参寄存器**（免 param copy）；
//   - 被写形参 + 所有非形参寄存器 → `id + Offset` 的 fresh caller reg。
// 单遍解析：定义在 IrInline 之前（方法体引用同文件后定义的具体类型会 E0402）。
public sealed class InlineCtx {
    public IrFunction Callee;
    public TypedReg[] Args;
    public int        ArgCount;
    public bool[]     WrittenParam;   // 形参 p 是否在 callee body 中被写（被写 → 不能直代入）
    public int        Offset;
    public InlineCtx(IrFunction callee, TypedReg[] args, int argCount, bool[] writtenParam, int offset) {
        this.Callee = callee; this.Args = args; this.ArgCount = argCount;
        this.WrittenParam = writtenParam; this.Offset = offset;
    }
}

// 单 caller 内联过程的可变状态（Phase A 单块 + Phase B 多块共享）：fresh reg 游标 / 预算 /
// 唯一标签计数（多块 relabel）/ RegTypes 扩展记录 / 是否改动。
public sealed class InlineState {
    public int RunningMax;
    public int Budget;
    public int LabelCtr;
    public int[] RecOff;
    public IrFunction[] RecFn;
    public int RecCount;
    public bool Changed;
    public InlineState(int runningMax) {
        this.RunningMax = runningMax; this.Budget = 0; this.LabelCtr = 0;
        this.RecOff = new int[4]; this.RecFn = new IrFunction[4]; this.RecCount = 0; this.Changed = false;
    }
}

public sealed class IrInline {

    public static int INLINE_MAX_SIZE      = 24;    // callee 总指令数上限（超过则仅单调用点才内联）
    public static int INLINE_CALLER_BUDGET = 256;   // 单 caller 累计内联指令预算（防代码爆炸）

    // 模块级入口：逐 caller 展开其内的合格调用点。IrModule = 单 CU，callee 在同模块内解析。
    //
    // 传导内联（emergent）：按 m.Functions **声明序**逐 caller 处理、就地改写 body。故先定义的 callee 若
    // 在其自身处理时把内部调用内联成了 curated 直线体，随后处理的 caller 会看到这份「已内联的」body 并可
    // 再内联它——即沿声明序向后自然传导。结果对声明序确定（同源同序 → 同输出，自举不动点成立，D7）；
    // 每函数只处理一次 + per-caller 预算 → 终止且有界。
    public static void Run(IrModule m) {
        int fi = 0;
        while (fi < m.FuncCount) {
            IrInline._inlineInto(m, m.Functions[fi]);
            fi = fi + 1;
        }
    }

    // 把 caller 内所有合格调用点内联：Phase A 单块 callee 就地 splice；Phase B 多块 callee split+insert。
    private static void _inlineInto(IrModule m, IrFunction caller) {
        if (caller.BlockCount == 0) { return; }   // 抽象/extern 桩：无体
        InlineState st = new InlineState(caller.MaxReg);
        IrInline._inlineSingleBlock(m, caller, st);   // Phase A
        IrInline._inlineMultiBlock(m, caller, st);    // Phase B
        if (!st.Changed) { return; }
        caller.MaxReg = st.RunningMax;
        IrInline._extendRegTypes(caller, st.RunningMax, st.RecOff, st.RecFn, st.RecCount);
    }

    // Phase A：单块 callee 就地 splice（每块重建指令列表）。多块 callee 留给 Phase B。
    private static void _inlineSingleBlock(IrModule m, IrFunction caller, InlineState st) {
        int bi = 0;
        while (bi < caller.BlockCount) {
            IrBlock blk = caller.Blocks[bi];
            IrInstr[] outI = new IrInstr[blk.InstrCount + 4];
            int oc = 0;
            bool blkChanged = false;
            int ii = 0;
            while (ii < blk.InstrCount) {
                IrInstr ins = blk.Instrs[ii];
                IrFunction callee = IrInline._eligibleCallee(m, caller, ins, st.Budget);
                if (callee != null && callee.BlockCount == 1) {
                    CallInstr call = ins as CallInstr;
                    IrBlock cb = callee.Blocks[0];
                    int offset = st.RunningMax;
                    bool[] written = IrInline._writtenParamsAll(callee);
                    InlineCtx ctx = new InlineCtx(callee, call.Args, call.ArgCount, written, offset);
                    // ① 形参绑定：只对**被写**形参 emit `copy (p+offset)=arg[p]`；只读形参 body 中直接代入实参。
                    int p = 0;
                    while (p < callee.ParamCount) {
                        if (written[p]) {
                            TypedReg np = new TypedReg(p + offset, IrInline._calleeRegType(callee, p));
                            outI = IrInline._push(outI, oc, new CopyInstr(np, call.Args[p])); oc = oc + 1;
                        }
                        p = p + 1;
                    }
                    // ② body：单块每条 curated 指令克隆 + 按 ctx 重映射寄存器
                    int ci = 0;
                    while (ci < cb.InstrCount) {
                        outI = IrInline._push(outI, oc, IrInline._cloneRemap(cb.Instrs[ci], ctx)); oc = oc + 1;
                        ci = ci + 1;
                    }
                    // ③ Ret 绑定：有值 → copy call.Dst = 重映射后 retReg
                    RetTerm rt = cb.Term as RetTerm;
                    if (rt.HasReg) {
                        outI = IrInline._push(outI, oc, new CopyInstr(call.Dst, IrInline._rr(rt.Reg, ctx))); oc = oc + 1;
                    }
                    IrInline._record(st, offset, callee, cb.InstrCount);
                    blkChanged = true;
                } else {
                    outI = IrInline._push(outI, oc, ins); oc = oc + 1;
                }
                ii = ii + 1;
            }
            if (blkChanged) {
                blk.Instrs = IrInline._trim(outI, oc);
                blk.InstrCount = oc;
            }
            bi = bi + 1;
        }
    }

    // Phase B：多块 callee split+insert。迭代找第一个多块合格调用点 → 拆 caller 块并插入 callee 块，
    // 直到没有多块调用点或预算耗尽。callee 体 curated（无 call）→ 插入块不含新调用点 → 终止。
    private static void _inlineMultiBlock(IrModule m, IrFunction caller, InlineState st) {
        bool progress = true;
        while (progress) {
            progress = false;
            int bi = 0;
            while (bi < caller.BlockCount && !progress) {
                IrBlock blk = caller.Blocks[bi];
                int ii = 0;
                while (ii < blk.InstrCount && !progress) {
                    IrFunction callee = IrInline._eligibleCallee(m, caller, blk.Instrs[ii], st.Budget);
                    if (callee != null && callee.BlockCount > 1) {
                        IrInline._spliceMultiBlock(caller, bi, ii, blk.Instrs[ii] as CallInstr, callee, st);
                        progress = true;
                    }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
        }
    }

    // 多块内联展开：把 caller.Blocks[blockIdx] 在 instrIdx（调用点）处拆成 head + continuation，
    // 中间插入 callee 的 relabel+remap 块。head 尾 br 到 callee entry；callee 各 Ret → 绑返回值 + br 到 cont。
    private static void _spliceMultiBlock(IrFunction caller, int blockIdx, int instrIdx, CallInstr call, IrFunction callee, InlineState st) {
        IrBlock orig = caller.Blocks[blockIdx];
        int offset = st.RunningMax;
        bool[] written = IrInline._writtenParamsAll(callee);
        InlineCtx ctx = new InlineCtx(callee, call.Args, call.ArgCount, written, offset);
        int idNum = st.LabelCtr; st.LabelCtr = st.LabelCtr + 1;   // 唯一标签前缀（确定序 → 自举不动点）
        string prefix = "__il" + idNum.ToString() + "_";
        string contLabel = "__ilc" + idNum.ToString();
        string entryLabel = prefix + callee.Blocks[0].Label;

        // head 块：orig 前半 + 被写形参 copy + `br entryLabel`（形参 copy 放 head → 只执行一次，loop 安全）
        IrInstr[] headI = new IrInstr[instrIdx + callee.ParamCount + 2];
        int hc = 0;
        int k = 0;
        while (k < instrIdx) { headI[hc] = orig.Instrs[k]; hc = hc + 1; k = k + 1; }
        int p = 0;
        while (p < callee.ParamCount) {
            if (written[p]) {
                TypedReg np = new TypedReg(p + offset, IrInline._calleeRegType(callee, p));
                headI[hc] = new CopyInstr(np, call.Args[p]); hc = hc + 1;
            }
            p = p + 1;
        }
        IrBlock head = new IrBlock(orig.Label, IrInline._trim(headI, hc), hc, new BrTerm(entryLabel), true);

        // continuation 块：orig 后半（调用点之后）+ orig 原终结子
        int rem = orig.InstrCount - (instrIdx + 1);
        IrInstr[] contI = new IrInstr[rem];
        int cc = 0;
        k = instrIdx + 1;
        while (k < orig.InstrCount) { contI[cc] = orig.Instrs[k]; cc = cc + 1; k = k + 1; }
        IrBlock cont = new IrBlock(contLabel, contI, cc, orig.Term, orig.HasTerm);

        // callee 块（relabel + remap + Ret→br cont / Br·BrCond 目标 relabel）
        IrBlock[] cblocks = new IrBlock[callee.BlockCount];
        int b = 0;
        while (b < callee.BlockCount) {
            cblocks[b] = IrInline._cloneCalleeBlock(callee.Blocks[b], ctx, prefix, contLabel, call.Dst);
            b = b + 1;
        }

        // 新块列表：[..前.., head, <callee blocks>, cont, ..后..]
        int newCount = caller.BlockCount + callee.BlockCount + 1;   // -1 orig +head +callee +cont
        IrBlock[] nb = new IrBlock[newCount];
        int w = 0;
        int bb = 0;
        while (bb < blockIdx) { nb[w] = caller.Blocks[bb]; w = w + 1; bb = bb + 1; }
        nb[w] = head; w = w + 1;
        int cbi = 0;
        while (cbi < callee.BlockCount) { nb[w] = cblocks[cbi]; w = w + 1; cbi = cbi + 1; }
        nb[w] = cont; w = w + 1;
        bb = blockIdx + 1;
        while (bb < caller.BlockCount) { nb[w] = caller.Blocks[bb]; w = w + 1; bb = bb + 1; }
        caller.Blocks = nb;
        caller.BlockCount = newCount;

        IrInline._record(st, offset, callee, IrInline._totalInstrs(callee));
    }

    // 克隆一个 callee 块：新标签 prefix+label；指令 clone+remap；终结子 Ret→(绑返回值)+br cont，
    // Br/BrCond 目标标签 relabel（prefix+）。
    private static IrBlock _cloneCalleeBlock(IrBlock cbk, InlineCtx ctx, string prefix, string contLabel, TypedReg callDst) {
        IrInstr[] ni = new IrInstr[cbk.InstrCount + 1];
        int nc = 0;
        int ci = 0;
        while (ci < cbk.InstrCount) { ni[nc] = IrInline._cloneRemap(cbk.Instrs[ci], ctx); nc = nc + 1; ci = ci + 1; }
        IrTerminator nt = null;
        if (cbk.Term is RetTerm) {
            RetTerm rt = cbk.Term as RetTerm;
            if (rt.HasReg) { ni[nc] = new CopyInstr(callDst, IrInline._rr(rt.Reg, ctx)); nc = nc + 1; }
            nt = new BrTerm(contLabel);
        } else if (cbk.Term is BrTerm) {
            BrTerm bt = cbk.Term as BrTerm;
            nt = new BrTerm(prefix + bt.Label);
        } else {
            BrCondTerm bc = cbk.Term as BrCondTerm;
            nt = new BrCondTerm(IrInline._rr(bc.Cond, ctx), prefix + bc.TrueLabel, prefix + bc.FalseLabel);
        }
        return new IrBlock(prefix + cbk.Label, IrInline._trim(ni, nc), nc, nt, true);
    }

    // 记录一次内联（游标 / 预算 / RegTypes 扩展记录 / changed）。
    private static void _record(InlineState st, int offset, IrFunction callee, int instrCount) {
        st.RecOff = IrInline._pushInt(st.RecOff, st.RecCount, offset);
        st.RecFn = IrInline._pushFn(st.RecFn, st.RecCount, callee);
        st.RecCount = st.RecCount + 1;
        st.RunningMax = offset + callee.MaxReg;
        st.Budget = st.Budget + instrCount;
        st.Changed = true;
    }

    private static int _totalInstrs(IrFunction callee) {
        int n = 0;
        int bi = 0;
        while (bi < callee.BlockCount) { n = n + callee.Blocks[bi].InstrCount; bi = bi + 1; }
        return n;
    }

    // ── 资格判定（D4）────────────────────────────────────────────────────────────────
    // 返回可内联的 callee IrFunction；任一阻断特征 → null（跳过，保守）。
    private static IrFunction _eligibleCallee(IrModule m, IrFunction caller, IrInstr ins, int budget) {
        if (budget >= IrInline.INLINE_CALLER_BUDGET) { return null; }   // ⑦ 预算耗尽
        if (!(ins is CallInstr)) { return null; }                        // ① 仅直接调用
        CallInstr call = ins as CallInstr;
        IrFunction callee = IrInline._findFunc(m, call.Func);
        if (callee == null) { return null; }                             // ② 同模块可解析
        if (callee.Name == caller.Name) { return null; }                 // ③ 非递归（curated 体无嵌套调用 → 无间接递归）
        if (callee.BlockCount < 1) { return null; }
        if (callee.ExcCount != 0) { return null; }                       // ⑤ 无异常表
        if (callee.ParamsFrom != 255) { return null; }                   // ⑤ 无 varargs
        if (call.ArgCount != callee.ParamCount) { return null; }         // ⑤ 精确 arity
        // ④ 每块：终结子 ∈ {Ret,Br,BrCond}（Throw 不可内联）+ 全 curated 指令。多块由 Phase B 拆块内联。
        int total = 0;
        int bi = 0;
        while (bi < callee.BlockCount) {
            IrBlock cbk = callee.Blocks[bi];
            if (!cbk.HasTerm) { return null; }
            if (!IrInline._termInlinable(cbk.Term)) { return null; }
            int ci = 0;
            while (ci < cbk.InstrCount) {
                if (!IrInline._isInlinable(cbk.Instrs[ci])) { return null; }
                ci = ci + 1;
            }
            total = total + cbk.InstrCount;
            bi = bi + 1;
        }
        // ⑥ 尺寸门（总指令数）：超阈值仅当全模块单调用点才恒内联
        if (total > IrInline.INLINE_MAX_SIZE) {
            if (IrInline._countCallSites(m, call.Func) != 1) { return null; }
        }
        return callee;
    }

    // 可内联的终结子：Ret（→绑返回值+br cont）/ Br / BrCond（目标 relabel）。Throw 不可内联。
    private static bool _termInlinable(IrTerminator t) {
        return (t is RetTerm) || (t is BrTerm) || (t is BrCondTerm);
    }

    // 同模块按名解析 callee（线性；首个匹配，稳定序）。
    private static IrFunction _findFunc(IrModule m, string name) {
        int i = 0;
        while (i < m.FuncCount) {
            if (m.Functions[i].Name == name) { return m.Functions[i]; }
            i = i + 1;
        }
        return null;
    }

    // 全模块 CallInstr 中 Func==name 的调用点数（单调用点恒内联判定）。
    private static int _countCallSites(IrModule m, string name) {
        int n = 0;
        int fi = 0;
        while (fi < m.FuncCount) {
            IrFunction f = m.Functions[fi];
            int bi = 0;
            while (bi < f.BlockCount) {
                IrBlock blk = f.Blocks[bi];
                int ii = 0;
                while (ii < blk.InstrCount) {
                    IrInstr ins = blk.Instrs[ii];
                    if (ins is CallInstr) { if ((ins as CallInstr).Func == name) { n = n + 1; } }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
            fi = fi + 1;
        }
        return n;
    }

    // ── curated 白名单（必须与 _cloneRemap 覆盖集完全一致）──────────────────────────────
    private static bool _isInlinable(IrInstr ins) {
        if (ins is ConstI32Instr)  { return true; }
        if (ins is ConstI64Instr)  { return true; }
        if (ins is ConstF64Instr)  { return true; }
        if (ins is ConstBoolInstr) { return true; }
        if (ins is ConstCharInstr) { return true; }
        if (ins is ConstStrInstr)  { return true; }
        if (ins is ConstNullInstr) { return true; }
        if (ins is CopyInstr)      { return true; }
        if (ins is AddInstr)       { return true; }
        if (ins is SubInstr)       { return true; }
        if (ins is MulInstr)       { return true; }
        if (ins is DivInstr)       { return true; }
        if (ins is RemInstr)       { return true; }
        if (ins is NegInstr)       { return true; }
        if (ins is NotInstr)       { return true; }
        if (ins is BitNotInstr)    { return true; }
        if (ins is ConvertInstr)   { return true; }
        if (ins is BitAndInstr)    { return true; }
        if (ins is BitOrInstr)     { return true; }
        if (ins is BitXorInstr)    { return true; }
        if (ins is ShlInstr)       { return true; }
        if (ins is ShrInstr)       { return true; }
        if (ins is EqInstr)        { return true; }
        if (ins is NeInstr)        { return true; }
        if (ins is LtInstr)        { return true; }
        if (ins is LeInstr)        { return true; }
        if (ins is GtInstr)        { return true; }
        if (ins is GeInstr)        { return true; }
        if (ins is FieldGetInstr)  { return true; }
        return false;
    }

    // callee 形参哪些被 body 写（任一块 DstId 命中形参 reg）→ 被写形参不能直代入实参，须材料化。
    private static bool[] _writtenParamsAll(IrFunction callee) {
        bool[] w = new bool[callee.ParamCount];
        int bi = 0;
        while (bi < callee.BlockCount) {
            IrBlock cbk = callee.Blocks[bi];
            int ci = 0;
            while (ci < cbk.InstrCount) {
                int d = IrOptInfo.DstId(cbk.Instrs[ci]);
                if (d >= 0 && d < callee.ParamCount) { w[d] = true; }
                ci = ci + 1;
            }
            bi = bi + 1;
        }
        return w;
    }

    // 逐指令克隆 + 按 ctx 重映射寄存器。仅 curated 集（_isInlinable 已保证）；未覆盖类型不可达，
    // 兜底返回原指令仅为类型完整（不会执行到）。
    private static IrInstr _cloneRemap(IrInstr ins, InlineCtx ctx) {
        if (ins is ConstI32Instr)  { ConstI32Instr i = ins as ConstI32Instr; return new ConstI32Instr(IrInline._rr(i.Dst, ctx), i.Text); }
        if (ins is ConstI64Instr)  { ConstI64Instr i = ins as ConstI64Instr; return new ConstI64Instr(IrInline._rr(i.Dst, ctx), i.Text); }
        if (ins is ConstF64Instr)  { ConstF64Instr i = ins as ConstF64Instr; return new ConstF64Instr(IrInline._rr(i.Dst, ctx), i.Text); }
        if (ins is ConstBoolInstr) { ConstBoolInstr i = ins as ConstBoolInstr; return new ConstBoolInstr(IrInline._rr(i.Dst, ctx), i.Value); }
        if (ins is ConstCharInstr) { ConstCharInstr i = ins as ConstCharInstr; return new ConstCharInstr(IrInline._rr(i.Dst, ctx), i.Val); }
        if (ins is ConstStrInstr)  { ConstStrInstr i = ins as ConstStrInstr; return new ConstStrInstr(IrInline._rr(i.Dst, ctx), i.Idx); }
        if (ins is ConstNullInstr) { ConstNullInstr i = ins as ConstNullInstr; return new ConstNullInstr(IrInline._rr(i.Dst, ctx)); }
        if (ins is CopyInstr)      { CopyInstr i = ins as CopyInstr; return new CopyInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.Src, ctx)); }
        if (ins is AddInstr)       { AddInstr i = ins as AddInstr; return new AddInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is SubInstr)       { SubInstr i = ins as SubInstr; return new SubInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is MulInstr)       { MulInstr i = ins as MulInstr; return new MulInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is DivInstr)       { DivInstr i = ins as DivInstr; return new DivInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is RemInstr)       { RemInstr i = ins as RemInstr; return new RemInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is NegInstr)       { NegInstr i = ins as NegInstr; return new NegInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.Src, ctx)); }
        if (ins is NotInstr)       { NotInstr i = ins as NotInstr; return new NotInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.Src, ctx)); }
        if (ins is BitNotInstr)    { BitNotInstr i = ins as BitNotInstr; return new BitNotInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.Src, ctx)); }
        if (ins is ConvertInstr)   { ConvertInstr i = ins as ConvertInstr; return new ConvertInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.Src, ctx)); }
        if (ins is BitAndInstr)    { BitAndInstr i = ins as BitAndInstr; return new BitAndInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is BitOrInstr)     { BitOrInstr i = ins as BitOrInstr; return new BitOrInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is BitXorInstr)    { BitXorInstr i = ins as BitXorInstr; return new BitXorInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is ShlInstr)       { ShlInstr i = ins as ShlInstr; return new ShlInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is ShrInstr)       { ShrInstr i = ins as ShrInstr; return new ShrInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is EqInstr)        { EqInstr i = ins as EqInstr; return new EqInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is NeInstr)        { NeInstr i = ins as NeInstr; return new NeInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is LtInstr)        { LtInstr i = ins as LtInstr; return new LtInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is LeInstr)        { LeInstr i = ins as LeInstr; return new LeInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is GtInstr)        { GtInstr i = ins as GtInstr; return new GtInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is GeInstr)        { GeInstr i = ins as GeInstr; return new GeInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.A, ctx), IrInline._rr(i.B, ctx)); }
        if (ins is FieldGetInstr)  { FieldGetInstr i = ins as FieldGetInstr; return new FieldGetInstr(IrInline._rr(i.Dst, ctx), IrInline._rr(i.Obj, ctx), i.Field); }
        // 不可达（_isInlinable 已滤）；返回原指令仅为类型完整（不会执行到）。
        return ins;
    }

    // 寄存器重映射（clean-inline-copies）：callee 只读形参 → 直接代入调用方实参寄存器（免 param copy）；
    // 被写形参 + 非形参 → id+Offset 的 fresh caller reg（类型标签保留）。
    private static TypedReg _rr(TypedReg r, InlineCtx ctx) {
        if (r.Id >= 0 && r.Id < ctx.Callee.ParamCount && r.Id < ctx.ArgCount && !ctx.WrittenParam[r.Id]) {
            return ctx.Args[r.Id];   // 只读形参直代入实参寄存器
        }
        return new TypedReg(r.Id + ctx.Offset, r.Type);
    }

    // callee reg r 的类型标签（越界 → Unknown）。
    private static int _calleeRegType(IrFunction callee, int r) {
        if (r >= 0 && r < callee.RegTypeCount) { return callee.RegTypes[r]; }
        return IrType.Unknown;
    }

    // reg_types 扩展：caller.RegTypes 覆盖到 runningMax，callee.RegTypes[r] → caller[offset+r]。
    private static void _extendRegTypes(IrFunction caller, int runningMax, int[] recOff, IrFunction[] recFn, int recCount) {
        int len = runningMax;
        if (caller.RegTypeCount > len) { len = caller.RegTypeCount; }
        int[] nrt = new int[len];
        int i = 0;
        while (i < caller.RegTypeCount) { nrt[i] = caller.RegTypes[i]; i = i + 1; }
        int r = 0;
        while (r < recCount) {
            int offset = recOff[r];
            IrFunction callee = recFn[r];
            int c = 0;
            while (c < callee.RegTypeCount) {
                int idx = offset + c;
                if (idx >= 0 && idx < len) { nrt[idx] = callee.RegTypes[c]; }
                c = c + 1;
            }
            r = r + 1;
        }
        caller.RegTypes = nrt;
        caller.RegTypeCount = len;
    }

    // ── growable helpers ─────────────────────────────────────────────────────────────
    private static IrInstr[] _push(IrInstr[] arr, int count, IrInstr x) {
        if (count >= arr.Length) {
            IrInstr[] n = new IrInstr[arr.Length * 2 + 8];
            int i = 0;
            while (i < count) { n[i] = arr[i]; i = i + 1; }
            arr = n;
        }
        arr[count] = x;
        return arr;
    }
    private static IrInstr[] _trim(IrInstr[] arr, int count) {
        IrInstr[] n = new IrInstr[count];
        int i = 0;
        while (i < count) { n[i] = arr[i]; i = i + 1; }
        return n;
    }
    private static int[] _pushInt(int[] arr, int count, int v) {
        if (count >= arr.Length) {
            int[] n = new int[arr.Length * 2 + 8];
            int i = 0;
            while (i < count) { n[i] = arr[i]; i = i + 1; }
            arr = n;
        }
        arr[count] = v;
        return arr;
    }
    private static IrFunction[] _pushFn(IrFunction[] arr, int count, IrFunction v) {
        if (count >= arr.Length) {
            IrFunction[] n = new IrFunction[arr.Length * 2 + 8];
            int i = 0;
            while (i < count) { n[i] = arr[i]; i = i + 1; }
            arr = n;
        }
        arr[count] = v;
        return arr;
    }
}
