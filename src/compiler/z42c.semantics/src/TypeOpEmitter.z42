// is / typeof / cast / box / convert lowering（CG-1E follow-up：从 ExprEmitter 按职责抽出）。
// 承载 Bound{IsExpr,Typeof,Cast,Box,Convert} → IR 的类型运算发射簇。共享 EmitContext（与
// ExprEmitter 同一 ctx）；递归 .Emit()、typeof 名格式化（_typeofName/_typeofArgName）与
// struct 谓词（_isBlobStruct/_blobStructName）经父反向引用 _ee 委回 ExprEmitter 中心工具。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;
using Z42.IR.BinaryFormat;

public sealed class TypeOpEmitter {
    private EmitContext _ctx;
    private ExprEmitter _ee;   // 反向引用：递归 .Emit() + typeof 名/struct 谓词委回 ExprEmitter

    public TypeOpEmitter(EmitContext ctx, ExprEmitter ee) { this._ctx = ctx; this._ee = ee; }

    // x is T → is_instance（bool）。is-pattern `x is T v`：另发 as-cast 把 (x as T) 存入 v 的
    // 寄存器并登记 Locals（true 分支读 v 命中此寄存器；不匹配时 as 得 null，分支不执行无害）。
    internal TypedReg _emitIs(BoundIsExpr e) {
        TypedReg obj = this._ee.Emit(e.E);
        string qn = this._ctx.QualifyTypeName(e.TypeName);   // 基元别名 → FQ 包装类（fix-boxed-primitive-is-as）
        if (qn == "Array") { qn = "Std.Array"; }       // 内建根类（VM 硬编码 Std.Array/Std.Object）
        else if (qn == "Object") { qn = "Std.Object"; }
        if (e.BindName != "") {
            TypedReg vReg = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new AsCastInstr(vReg, obj, qn));
            this._ctx.Locals.Put(e.BindName, vReg);
        }
        TypedReg dst = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new IsInstanceInstr(dst, obj, qn));
        return dst;
    }

    // x is <structural pattern> → bool（模式匹配核心 A1）：经 PatternEmitter 匹配到 match/fail 块，
    // 收口成布尔结果寄存器。绑定在 match 路径写入（Locals），true 分支支配其使用（无害于不匹配路径）。
    internal TypedReg _emitIsPattern(BoundIsPatternExpr e) {
        TypedReg subj = this._ee.Emit(e.E);
        TypedReg result = this._ctx.Alloc(IrType.Bool);
        string matchL = this._ctx.Fresh("is_match");
        string failL = this._ctx.Fresh("is_fail");
        string endL = this._ctx.Fresh("is_end");
        this._ee._pat.EmitMatch(subj, e.Pat, matchL, failL);
        this._ctx.StartBlock(matchL);
        this._ctx.Emit(new ConstBoolInstr(result, true));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(failL);
        this._ctx.Emit(new ConstBoolInstr(result, false));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(endL);
        return result;
    }

    // typeof(T) → Typeof 指令（reflection Std.Type 句柄）。FQ 名镜像 C# Z42TypeName。
    internal TypedReg _emitTypeof(BoundTypeof e) {
        // add-generic-methods：方法级 typeof(T) → MethodTypeArgInsn 具体化（读 frame.method_type_args）。
        if (e.IsMethodLevel) {
            TypedReg mdst = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new MethodTypeArgInsn(mdst, e.MethodParamIndex));
            return mdst;
        }
        // typeof(delegate)：delegate 名解析成结构化 Z42FuncType（"Action"/"Func<…>"），丢了 FQ
        // delegate 名 → 用 AST 原始名 QualifyClass 回 FQ delegate 名（其 TYPE 条目 under FQ 名，
        // add-delegate-metadata），使 typeof(MyDelegate) 得真句柄（IsDelegate=true），与
        // Type.GetType("<fq>") 一致。非 delegate 走既有 _typeofName（add-reflection-typeof-delegate）。
        string name;
        if (e.Target is Z42FuncType && e.TargetName != "") {
            name = this._ctx.QualifyClass(e.TargetName);
        } else {
            name = this._ee._typeofName(e.Target);
        }
        string[] targs = new string[0];
        int targc = 0;
        if (e.Target is Z42InstantiatedType) {
            Z42InstantiatedType it = e.Target as Z42InstantiatedType;
            targs = new string[it.ArgCount];
            while (targc < it.ArgCount) { targs[targc] = this._ee._typeofArgName(it.TypeArgs[targc]); targc = targc + 1; }
        }
        TypedReg dst = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new TypeofInstr(dst, name, targs, targc));
        return dst;
    }

    // methodof(...) → `__methodof(%qualifiedName)` builtin（add-method-reference）。
    //
    // **不新增 IR 指令、不 bump 格式**：照 `_emitBoxPrim` 的范式复用既有 Builtin opcode
    // （ConstStr 进串池 + BuiltinInstr）。重载决议已在绑定期完成，这里只剩一个池索引 —— 体积
    // 与一次普通 Call 等同，运行期零签名匹配痕迹。
    //
    // 名字 = `<声明类 FQN>.<RegKey>`，与 `EmitContext.ResolveSealedTarget` / IrGen 的
    // `_q(_classIrShortName)+"."+md.RegKey` **逐字节同款** —— methodof 发的就是调用点会发的
    // 那个名字，故「稳定性 = 普通调用的稳定性」。
    //
    // 🔴 用 **DeclOwnerFq（声明该方法的类）** 而非 receiver 类：TSIG 把继承方法展平进每个派生类的
    // `Methods`，拿派生类拼名会指向一个从未发射的函数（`EmitContext._depHasFunction` 就是为这个
    // 存在的）。绑定期已沿基链定位到真正的声明类，这里直接用。
    internal TypedReg _emitMethodOf(BoundMethodOf e) {
        string owner = e.DeclOwnerFq;
        if (owner == "") {
            // 兜底：绑定期没拿到声明类 FQ（理论上不该发生）→ 退回 receiver 类的 Fqn()。
            owner = (e.OwnerCt != null) ? e.OwnerCt.Fqn() : this._ctx.QualifyClass(e.OwnerName);
        }
        string qualified = owner + "." + e.MethodKey;
        int idx = this._ctx.Gen.Intern(qualified);
        TypedReg nameReg = this._ctx.Alloc(IrType.Str);
        this._ctx.Emit(new ConstStrInstr(nameReg, idx));
        TypedReg[] args = new TypedReg[1];
        args[0] = nameReg;
        TypedReg dst = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new BuiltinInstr(dst, "__methodof", args, 1));
        return dst;
    }

    // x as T → as_cast（结果 ref）。目标类型名用 AST 原始名经 QualifyClass 解析（镜像 _emitIs）——
    // 不用 resolved 类型名：imported 接口/内建类 ResolveType 得 Unknown → "<unknown>" 会致目标失配
    // （跨包接口 `as` 恒 null）。含 Array/Object 内建根类归一（同 _emitIs）。
    internal TypedReg _emitCast(BoundCast c) {
        TypedReg obj = this._ee.Emit(c.E);
        TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(c.Type()));
        string qn = this._ctx.QualifyTypeName(c.TypeName);   // 基元别名 → FQ 包装类（fix-boxed-primitive-is-as）
        if (qn == "Array") { qn = "Std.Array"; }
        else if (qn == "Object") { qn = "Std.Object"; }
        this._ctx.Emit(new AsCastInstr(dst, obj, qn));
        return dst;
    }

    // (T)x 数值转换（G3）→ ConvertInstr。镜像 C# VisitCast：identity（fromIr==toIr）no-op；
    // 目标 Unknown/Ref no-op；源 Unknown/Ref 仍发 Convert（VM 按需 coerce）；否则发 Convert。
    // add-primitive-value-boxing: 整数→object/接口 装箱 → `__box_prim(value, primFQ)` builtin。
    // 复用现有 ConstStr + Builtin opcode，无新 IR opcode（不改 zbc 格式）。
    internal TypedReg _emitBox(BoundBox b) {
        // add-struct-object-boxing: blob 值 struct → `__box_struct`（把帧 arena blob 拷到堆，type_name
        // 运行时从 arena slot 取，无需 class 参数）。复用 Builtin opcode，无格式 bump。
        if (this._ee._isBlobStruct(b.E.Type())) {
            TypedReg sval = this._ee.Emit(b.E);
            TypedReg[] sargs = new TypedReg[1];
            sargs[0] = sval;
            TypedReg sdst = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new BuiltinInstr(sdst, "__box_struct", sargs, 1));
            return sdst;
        }
        TypedReg val = this._ee.Emit(b.E);
        // 非基元（如非 blob 单字段 struct 擦除到 object）→ BoundBox 退化为透传，保持现模型。
        // unify-value-types Phase 1：翻转后整数基元为 Z42ClassType(Scalar)——追加 Scalar 值类型判定，
        // 使其仍走下方 __box_prim（否则误透传、丢装箱）。翻转前无 Scalar 名 Z42ClassType → 当前中立。
        Z42Type _bet = b.E.Type();
        bool _boxEnum = (_bet is Z42ClassType) && (_bet as Z42ClassType).IsEnum;
        bool _boxScalar = (_bet is Z42ClassType) && _bet.IsScalarType();
        if (!_boxScalar && !_boxEnum) { return val; }
        // make-enum-distinct-type 1.5：enum 走同一条 `__box_prim`（值仍是裸 i64，只是盒的 type_desc
        // 换成 enum 自身）——runtime `box_prim_to_heap` 对非 wrapper 名按 8 字节 signed 存，正合
        // `Type.z42`「z42 一律以 i64 背书 enum」。类名须 emit 期 `QualifyClass`（语义期存的是短名）。
        if (_boxEnum) { return this._emitBoxPrim(val, this._ctx.QualifyClass(b.PrimFQ)); }
        return this._emitBoxPrim(val, b.PrimFQ);
    }

    // `__box_prim(%value, %classFQ)` 的发射原语——`_emitBox`（擦除点装箱）与 `_emitEnumBox`
    // （字符串化前装箱）共用，保证两条路发的指令序列逐字节同形。
    private TypedReg _emitBoxPrim(TypedReg val, string classFQ) {
        int idx = this._ctx.Gen.Intern(classFQ);
        TypedReg cls = this._ctx.Alloc(IrType.Str);
        this._ctx.Emit(new ConstStrInstr(cls, idx));
        TypedReg[] args = new TypedReg[2];
        args[0] = val; args[1] = cls;
        TypedReg dst = this._ctx.Alloc(IrType.Ref);   // Boxed 落 object 槽（引用）
        this._ctx.Emit(new BuiltinInstr(dst, "__box_prim", args, 2));
        return dst;
    }

    // make-enum-distinct-type 1.5：把一个 **enum 静态类型**的值寄存器装箱成带 enum TypeDesc 的盒。
    // 用在**字符串化**入口（`ToStr` / 字符串 `+` / 插值洞 / `e.ToString()`）：运行期的 i64 不带类型，
    // 不装箱就只能打印数字；装箱后 `value_to_str` / `resolve_vcall` 认出 enum 盒 → 打印成员名
    // （C# `Enum.ToString`）。非 enum 静态类型原样返回（no-op），故调用点可无条件套用。
    internal TypedReg _emitEnumBox(TypedReg val, Z42Type t) {
        if (!((t is Z42ClassType) && (t as Z42ClassType).IsEnum)) { return val; }
        return this._emitBoxPrim(val, this._ctx.QualifyClass(t.Name()));
    }

    // add-symbol-availability-macro：`available!(X)` → `BuiltinInstr("__sym_available", ConstStr(key))`。
    // 复用 Builtin opcode + 常量字符串参数编码语义，零新 IR opcode、零格式 bump（`__box_prim` 同款先例）。
    //
    // ⭐ key 的产出**必须走与真实调用完全相同的那次查找**（design D2.1），不能另拼一份——否则
    // 「探测说有」与「调用能成」会是两套规则、迟早漂移。下面这段是 CallEmitter 静态调用路径的
    // 镜像，包括那条 `ownerIsLocal` local-wins 守卫（本包自有类恒不查 DepIndex，防同短类名串味）。
    //
    // 正常路径这条 Builtin 在**加载期就被 VM 折成 ConstBool 并剪枝**，运行期永不执行。
    internal TypedReg _emitSymAvailable(BoundSymAvailable s) {
        string key = "";
        if (s.Kind == "t") {
            key = "t:" + this._ctx.QualifyClass(s.Owner);
        } else {
            bool ownerIsLocal = this._ctx.LocalClasses != null
                                && this._ctx.LocalClasses.ContainsKey(s.Owner);
            string q = "";
            if (this._ctx.Deps != null && !ownerIsLocal) {
                // s.Member 已是**注册键**（可能含 `$N` mangle），故只查该键，不做 arity→bare 回落。
                DepCallEntry de = this._ctx.Deps.GetStaticScoped(
                    this._ctx.ActiveNs, this._ctx.ActiveNsCount, s.Owner, s.Member);
                if (de == null) { de = this._ctx.Deps.GetStatic(s.Owner, s.Member); }
                if (de != null) { this._ctx.TrackDepNamespace(de.Namespace); q = de.QualifiedName; }
            }
            if (q == "") { q = this._ctx.QualifyClass(s.Owner) + "." + s.Member; }
            key = "m:" + q;
        }
        int idx = this._ctx.Gen.Intern(key);
        TypedReg kreg = this._ctx.Alloc(IrType.Str);
        this._ctx.Emit(new ConstStrInstr(kreg, idx));
        TypedReg[] args = new TypedReg[1];
        args[0] = kreg;
        TypedReg dst = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new BuiltinInstr(dst, "__sym_available", args, 1));
        return dst;
    }

    internal TypedReg _emitConvert(BoundConvert c) {
        TypedReg src = this._ee.Emit(c.E);
        // add-struct-object-boxing (PR2a)：`(P)o`（object/接口 → blob 值 struct 的 C 风格强转）= **拆箱**。
        // 源不是值 struct（是 object/boxed）、目标是 blob 值 struct → 发 AsCast（VM 对 BoxedStruct 精确
        // 匹配 → 拷回当前帧 arena StructRef）。类名用 QualifyClass 与 StructAlloc 的 arena type_name 对齐。
        // （`(P)somePexpr` 源已是值 struct → 不进此支，走下方 Ref==Ref 透传。）
        if (this._ee._isBlobStruct(c.Type()) && !this._ee._isBlobStruct(c.E.Type())) {
            TypedReg ud = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new AsCastInstr(ud, src, this._ctx.QualifyClass(this._ee._blobStructName(c.Type()))));
            return ud;
        }
        int toIr = this._ctx.ToIrType(c.Type());
        int fromIr = this._ctx.ToIrType(c.E.Type());
        if (fromIr == toIr) { return src; }
        if (toIr == IrType.Unknown || toIr == IrType.Ref) { return src; }
        TypedReg dst = this._ctx.Alloc(toIr);
        this._ctx.Emit(new ConvertInstr(dst, src));
        return dst;
    }
}
