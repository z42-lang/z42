// 种子转发层：并行框架已下沉到 z42.package（`Z42.Package.ParallelFor` / `ParallelConfig` / `IParallelBody`），
// 好让 zpkg 写出端也能用。种子 driver 自举时调的是 `Z42.Semantics.ParallelConfig.SetJobs`、实现的是
// `Z42.Semantics.IParallelBody`，运行期加载的却是仓内新建的 z42c.semantics ⇒ 这三个名字留到种子换代。
// STAGE2-DEBT(parallel-for-forwarders): 含 Z42.Package.ParallelFor 的 nightly 发布后删掉本文件。
namespace Z42.Semantics;

using Z42.Package;   // IParallelTask（基表写裸名：上一 nightly 的编译器解析不了基表里的限定名）

public interface IParallelBody {
    void Run(int i);
}

// 种子侧的并行体 → 仓内工作池的并行体（适配而非接口继承：上一 nightly 的编译器解析基表时
// 限定名会被剥成短名；故仓内接口另起唯一的名字 `IParallelTask`）。
sealed class ParallelBodyAdapter : IParallelTask {
    IParallelBody _inner;
    public ParallelBodyAdapter(IParallelBody inner) { this._inner = inner; }
    public void Run(int i) { this._inner.Run(i); }
}

public static class ParallelConfig {
    public static void SetJobs(int j) { Z42.Package.ParallelConfig.SetJobs(j); }
    public static int Jobs(int n) { return Z42.Package.ParallelConfig.Jobs(n); }
}

public static class ParallelFor {
    public static void Run(int n, int jobs, IParallelBody body) {
        Z42.Package.ParallelFor.Run(n, jobs, new ParallelBodyAdapter(body));
    }
}
