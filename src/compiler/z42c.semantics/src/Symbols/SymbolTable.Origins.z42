// SymbolTable 的「名字来源 / 歧义 / 跨包重名」那一簇（split-symbol-origins，从 SymbolTable.z42 拆出）。
//
// 为什么单独成文件：`SymbolTable.z42` 已经顶到 886 行硬限（`xtask check lines` 判红过一次），
// 而这一簇在职责上本来就自成一块 —— 它回答的全是同一个问题族：
//
//   「这个名字是**谁**声明的？有几份？其中哪些在本 CU 可见？该报哪条诊断？」
//
// 三张打包串表（`ClassNsAll` / `ClassPkgAll` / `FuncOriginAll`，值是 `|` 拼接的 `StrBox`）+
// 它们的读写原语 + 五条诊断消息（E0456 裸名歧义 / E0601 跨包同 FQN / E0606 本包遮蔽导入，
// 类与自由函数各一套）全在这里。字段声明留在 `SymbolTable.z42`（ctor 与 `WithAliases` 在那边）。
//
// **用 `partial` 而不是抽成静态辅助类**：后者要么改所有调用点、要么留一层转发壳，而这条仓库
// 实测过「一层纯转发 ≈ 0.5% 全负载」（见 perf-call-frame 系列）。partial 是零调用点改动、
// 零额外帧的拆法，且是本仓既定做法 —— `Std.String` 就拆成 `String.z42` + `String.Edit.z42` +
// `String.Split.z42` 三个 `public sealed partial class String`。
//
// ⚠️ 这次拆分是**纯代码搬运**：方法体逐字未改，只是换了文件。判据、消息措辞、调用关系全不动。
namespace Z42.Semantics;
using Z42.IR;
using Z42.Core;   // ReportTypeOrigin：DiagnosticBag / DiagnosticCodes / Span


public sealed partial class SymbolTable {
    // E0456 的**消息**也只此一份（判据在 IsBareNameAmbiguous）。不歧义返回 ""。
    // 两个消费端：TypeChecker（语句/表达式位）与 SymbolCollector（声明位）——
    // 各写一份消息迟早漂移，这正是本仓库反复吃亏的形状。
    public string AmbiguousBareNameMsg(string name) {
        if (!this.IsBareNameAmbiguous(name)) { return ""; }
        string[] nss = this.ClassNsOf(name);
        string first = "";
        string second = "";
        int i = 0;
        while (i < nss.Length) {
            string ns = nss[i];
            if (ns == "" || this.IsScopeVisibleNs(ns)) {
                if (first == "") { first = ns; }
                else if (second == "") { second = ns; }
            }
            i = i + 1;
        }
        return "`" + name + "` is an ambiguous reference between `" + SymbolTable.QualOf(first, name)
             + "` and `" + SymbolTable.QualOf(second, name) + "`";
    }

    // ── report-crosspkg-duplicate-type：同一个 FQN 被多个包声明 ────────────────────────
    //
    // E0456 管的是「同一个**短名**在多个 ns 里」——限定写法（`A.Foo`）即可消歧。
    // 这里管的是另一回事：**FQN 本身重复**。两个包都声明 `Demo.Ns.Widget` 时，
    // 写全限定名也分不开它们 —— 实测限定与非限定都绑到同一个赢家（字母序靠前的包），
    // 输的那份连同全部成员从未存在过，且**没有任何写法能指到它**（C# 有 extern alias，z42 没有）。
    //
    // ⚠️ 消息与判据都只此一份（同 IsBareNameAmbiguous / AmbiguousBareNameMsg 的纪律）。
    // 两个消费端：TypeChecker._chkTypeRef（表达式位）与 SymbolCollector._chkTypeRefT（声明位）。

    // 两个**依赖包**声明同一 FQN → E0601 消息；否则 ""。
    public string CrossPkgDuplicateMsg(string fqn) {
        // 与 ShadowedImportMsg 在每个类型引用上**成对**被调 ⇒ 单包（绝大多数）到 Count 就结束，不 Split。
        StrBox box = this._pkgBoxOf(fqn);
        if (box == null) { return ""; }
        if (box.Count < 2) { return ""; }
        string[] pkgs = box.Value.Split("|");
        return "`" + fqn + "` is declared in more than one package: `" + pkgs[0] + "` and `" + pkgs[1]
             + "` — their fully-qualified names are identical, so neither can be selected"
             + " (rename one, or move it to a different namespace)";
    }

    // 本包声明的类型遮蔽了某个导入包的同 FQN 类型 → E0606 消息；否则 ""。
    // 判据：该 FQN 上的赢家是**本地**类型（IsImported==false），而 ClassPkgAll 里又记着导入来源。
    //
    // 🔴 **为什么是 error 而不是 warning**（初版照 C# CS0436 做成了 warning，那是错的）：
    // 「本地恒赢」确实是既定规则、不是猜——但**规则明确 ≠ 结果可接受**。被遮蔽的那一份
    // **根本指不了**（两者 FQN 逐字相同，限定名也分不开；C# 有 extern alias，z42 没有），
    // 于是失败形态与 E0601 一模一样：去调依赖包那份才有的成员，得到的是
    // 「no method X on Widget」这种答非所问的诊断。
    //
    // 与 E0601 「未引用则不报」的分工也不同：那条是**两个第三方依赖打架**，下游既没用到
    // 也无权修，不该挡死他；本条冲突的两份里**有一份是本包自己写的**，改名随时可以 ⇒
    // 报 error 是可行动的。代价只有「故意遮蔽以覆盖库类型」这条野路子，而它本就无法控制、
    // 无法回退（指不到被覆盖那份），不值得为它保留一个静默通道。实测全仓 0 处。
    public string ShadowedImportMsg(string fqn) {
        // 只有「**恰好**一个包」才可能出消息 ⇒ box.Value 即 pkgs[0]，全程不 Split。
        StrBox box = this._pkgBoxOf(fqn);
        if (box == null) { return ""; }
        if (box.Count != 1) { return ""; }   // 两个导入包互撞 → 归 E0601，不在这里重复报
        // 类与接口两张 FQN 视图都要查——E0601 那条经 `PkgCheckFqn` 本就覆盖接口，
        // 只查 `ClassesByFqn` 会让「本地接口遮蔽导入接口」这半边单独哑掉（不对称的哑门）。
        bool localWins = false;
        int at = this.ClassesByFqn.Find(fqn);
        if (at >= 0) {
            Z42ClassType win = this.ClassesByFqn.ValAt(at) as Z42ClassType;
            if (win != null && !win.IsImported) { localWins = true; }
        }
        int iat = this.InterfacesByFqn.Find(fqn);
        if (iat >= 0) {
            Z42InterfaceType iwin = this.InterfacesByFqn.ValAt(iat) as Z42InterfaceType;
            if (iwin != null && !iwin.IsImported) { localWins = true; }
        }
        if (!localWins) { return ""; }   // 赢家是导入的（或查不到）→ 没有本地遮蔽
        return "`" + fqn + "` is declared in this package and also in package `" + box.Value
             + "` — their fully-qualified names are identical, so the imported one can never be"
             + " referenced (rename one of them, or move it to a different namespace)";
    }

    // ── report-crosspkg-duplicate-function：自由函数的同名判定 ─────────────────────────
    //
    // 类那边有 `ClassesByFqn` 兜底，自由函数**连 FQN 视图都没有**（键恒为裸名）⇒ 同名者
    // 无论同不同 ns 都撞同一个键、first-wins，且**没有任何写法能指到输的那份**
    // （z42 的自由函数调用只有裸名一种形态，`ns.func()` 只在 ns == 当前 ns 时才是自由调用）。
    // 实测（本 change 的 fixture）：两个包各声明 `Demo.FnNs.helper` → 编译零诊断、字母序靠前的赢；
    // 分居两个 ns 且都 `using` 了也一样静默选一份。
    //
    // 三个判据共用 `FuncOriginAll`，**消息也只此一份**（同 IsBareNameAmbiguous 的纪律）。
    // 消费端：`MemberResolver` 的两处自由调用漏斗。

    // 登记一条来源。pkg 为空串 = 本包声明（由 MemberCollector 在 `_passMembers` 里按 CU 的 ns 记）。
    public void NoteFuncOrigin(string name, string ns, string pkg) {
        SymbolTable.NoteNsInto(this.FuncOriginAll, name, ns + "#" + pkg);
    }

    // name → 全部来源（每条 "ns#pkg"）。无记录返回空数组。
    public string[] FuncOriginsOf(string name) {
        int at = this.FuncOriginAll.Find(name);
        if (at < 0) { return new string[0]; }
        StrBox box = this.FuncOriginAll.ValAt(at) as StrBox;
        return box.Value.Split("|");
    }

    private static string _origNs(string o) { int h = o.IndexOf("#"); return h < 0 ? o : o.Substring(0, h); }

    private static string _origPkg(string o) { int h = o.IndexOf("#"); return h < 0 ? "" : o.Substring(h + 1, o.Length - h - 1); }

    // 该来源的 ns 在本 CU 可见吗（全局 ns 视为可见——与 AmbiguousBareNameMsg 同口径）。
    private bool _origVisible(string o) {
        string ns = SymbolTable._origNs(o);
        return ns == "" || this.IsScopeVisibleNs(ns);
    }

    // ① 同一个 ns 被 **两个依赖包** 各声明了一份同名自由函数 → E0601 消息；否则 ""。
    public string DuplicateFuncPkgMsg(string name) {
        string[] os = this.FuncOriginsOf(name);
        int i = 0;
        while (i < os.Length) {
            if (this._origVisible(os[i]) && SymbolTable._origPkg(os[i]) != "") {
                int j = i + 1;
                while (j < os.Length) {
                    if (this._origVisible(os[j]) && SymbolTable._origPkg(os[j]) != ""
                        && SymbolTable._origNs(os[i]) == SymbolTable._origNs(os[j])
                        && SymbolTable._origPkg(os[i]) != SymbolTable._origPkg(os[j])) {
                        return "`" + SymbolTable.QualOf(SymbolTable._origNs(os[i]), name)
                             + "` is declared in more than one package: `" + SymbolTable._origPkg(os[i])
                             + "` and `" + SymbolTable._origPkg(os[j])
                             + "` — free functions are referenced by bare name only, so neither can be selected"
                             + " (rename one, or move it to a different namespace)";
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return "";
    }

    // ② 本包声明的自由函数与某个导入包**同 ns 同名** → E0606 消息；否则 ""。
    // 与类那边同一条理由：本地恒赢是既定规则，但被遮蔽那份**指不了**（自由函数只有裸名一种写法）。
    public string ShadowedImportFuncMsg(string name) {
        string[] os = this.FuncOriginsOf(name);
        int i = 0;
        while (i < os.Length) {
            if (SymbolTable._origPkg(os[i]) == "") {
                int j = 0;
                while (j < os.Length) {
                    if (SymbolTable._origPkg(os[j]) != "" && this._origVisible(os[j])
                        && SymbolTable._origNs(os[i]) == SymbolTable._origNs(os[j])) {
                        return "`" + SymbolTable.QualOf(SymbolTable._origNs(os[i]), name)
                             + "` is declared in this package and also in package `" + SymbolTable._origPkg(os[j])
                             + "` — free functions are referenced by bare name only, so the imported one"
                             + " can never be referenced (rename one of them)";
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return "";
    }

    // ③ 裸名解析候选不止一个 ns → E0456 消息；否则 ""。
    // 候选集与 `ResolveFuncNs` **同一份**（`_funcCandidates`）：外围 ns 声明了它 → 不算歧义；可见 ns 里 ≥2 份才算。
    // 可见集为空（全部声明都在没 using 的 ns 里）不算歧义 —— 那是 E0436「补 using」的事：依赖包全体都参与名字
    // 查找后，「别的包里恰好也有两个同名函数」极常见，报歧义会把真正该说的「没 using」盖掉。
    public string AmbiguousFuncNameMsg(string name) {
        string[] c = this._funcCandidates(name);
        if (c.Length < 2 || !this._funcNsVisible(c[0])) { return ""; }
        return "`" + name + "` is an ambiguous reference between `" + SymbolTable.QualOf(c[0], name)
             + "` and `" + SymbolTable.QualOf(c[1], name) + "`";
    }

    // deterministic-zpkg-deps：导入类型（类 / 接口 / enum）FQN → 声明它的**那一个**依赖包名。
    // 本包声明、父包（测试目标按同包待遇）、无记录、多包同 FQN（E0601 的地盘）一律返回 ""（= 归属不明）。
    public string ImportedPkgOf(string fqn) {
        StrBox box = this._pkgBoxOf(fqn);
        if (box == null || box.Count != 1) { return ""; }
        string pkg = box.Value;
        if (pkg == this.SelfPkg) { return ""; }
        return pkg;
    }

    // deterministic-zpkg-deps：FQN 指向**本次编译声明**的类型（类或接口，`IsImported == false`）吗。
    // 来源表里查不到归属时用它区分「本包自己的」（不是依赖，跳过）与「真不知道来自哪」（按 ns 保守回落）。
    public bool IsLocalTypeFqn(string fqn) {
        int at = this.ClassesByFqn.Find(fqn);
        if (at >= 0) {
            Z42ClassType ct = this.ClassesByFqn.ValAt(at) as Z42ClassType;
            if (ct != null && !ct.IsImported) { return true; }
        }
        at = this.InterfacesByFqn.Find(fqn);
        if (at >= 0) {
            Z42InterfaceType it = this.InterfacesByFqn.ValAt(at) as Z42InterfaceType;
            if (it != null && !it.IsImported) { return true; }
        }
        return false;
    }

    // deterministic-zpkg-deps：导入自由函数 → 声明它的那一个依赖包名（同 ImportedPkgOf 的口径）。
    // name 可带重载 mangle（`f$2`），按 `$` 前的裸名查 FuncOriginAll。
    public string ImportedFuncPkgOf(string name, string ns) {
        int dollar = name.IndexOf("$");
        string bare = dollar < 0 ? name : name.Substring(0, dollar);
        string[] os = this.FuncOriginsOf(bare);
        string hit = "";
        int i = 0;
        while (i < os.Length) {
            string p = SymbolTable._origPkg(os[i]);
            if (SymbolTable._origNs(os[i]) == ns && p != "" && p != this.SelfPkg) {
                if (hit != "" && hit != p) { return ""; }
                hit = p;
            }
            i = i + 1;
        }
        return hit;
    }

    // FQN → 声明过它的依赖包名列表（无记录返回空数组）。
    // 打包串取 box（perf-packed-count）：热路径只要「有几项」⇒ 读 `StrBox.Count`，不 Split（冷路径出诊断
    // 消息时仍走 ClassPkgsOf / ClassNsOf）。⚠️ 改用 `IndexOf("|")` 判单项没用：它要扫完整串，实测 Split 实测 Split 3.34%→0.07% 时 IndexOf 反升到 5.39%。
    private StrBox _pkgBoxOf(string fqn) {
        int at = this.ClassPkgAll.Find(fqn);
        return (at < 0) ? null : (this.ClassPkgAll.ValAt(at) as StrBox);
    }

    // 一次**类型引用**（FQN）的来源判定 —— 唯一实现，声明位（SymbolCollector）、使用位（TypeChecker 类型引用 /
    // 静态成员）、enum 常量读三处共用：同 FQN 跨包 E0601（报了就停：谁也选不了，再报别的是噪音）→ 本包遮蔽导入
    // E0606 → 用了未声明的第三方包 E0497。fqn 为 "" 时不判。
    public void ReportTypeOrigin(string fqn, DiagnosticBag diags, Span sp) {
        if (fqn == "") { return; }
        string emsg = this.CrossPkgDuplicateMsg(fqn);
        if (emsg != "") { diags.Error(DiagnosticCodes.NamespaceCollision, emsg, sp); return; }
        string wmsg = this.ShadowedImportMsg(fqn);
        if (wmsg != "") { diags.Error(DiagnosticCodes.LocalTypeShadowsImport, wmsg, sp); }
        string umsg = this.UndeclaredDepMsg(fqn);
        if (umsg != "") { diags.Error(DiagnosticCodes.UndeclaredDependency, umsg, sp); }
    }

    // ── fix-crosspkg-ns-reachability：用了未声明的依赖包 → E0497 消息；否则 "" ──────────
    //
    // 🔴 **必须按「符号的归属包」判，不能按 `using` 判。** 实测：按「`using X` ⇒ X 的所有提供包
    // 都要声明」扫全仓得 **299 条命中，其中约 250 条来自 `using Std;`** —— 有 11 个包都声明了
    // `Std` 命名空间，而 `using Std;` 显然不意味着你用了 `z42.yaml`。按 using 判 = 250 个假阳性。
    // 这里查的是 `ClassPkgAll`（FQN → 声明它的包），即**这个类型真正来自哪个包**。
    //
    // 三种不算「跨包依赖」的来源：本包自己（`SelfPkg`）、prelude（`z42.core`，隐式可用）、
    // 已在 `[dependencies]` 里声明的包。
    //
    // ⚠️ `EnforceDeclaredDeps` 为假时恒返回 ""：单文件写不出 `[dependencies]`，而它的契约是
    // 「整个标准库可用」；REPL / 单测 / 裸 emit 同理（它们没有 manifest 可依据）。
    //
    // ⚠️ 多来源（`box.Count >= 2`）由 `CrossPkgDuplicateMsg`（E0601）先报，那是更严重的问题
    // （谁也选不了）⇒ 这里跳过，避免同一处叠两条。
    public string UndeclaredDepMsg(string fqn) {
        if (!this.EnforceDeclaredDeps) { return ""; }
        StrBox box = this._pkgBoxOf(fqn);
        if (box == null) { return ""; }          // 本包类型 / 未登记来源 → 不是跨包引用
        if (box.Count >= 2) { return ""; }       // 同 FQN 多包：E0601 的地盘
        return this.UndeclaredDepPkgMsg(fqn, box.Value);
    }

    // 同上，归属包已知：自由函数没有 FQN 视图，归属包由 `ImportedFuncPkgOf` 给出（多包时给 ""，
    // 那是 E0601 的地盘）。`what` 只进消息。
    public string UndeclaredDepPkgMsg(string what, string pkg) {
        if (!this.EnforceDeclaredDeps) { return ""; }
        if (pkg == "") { return ""; }            // 空 = 本包声明的那份 / 来源不唯一
        if (pkg == this.SelfPkg) { return ""; }
        // 🔴 **标准库（`z42.` 前缀）自动可用，不要求声明** —— 这是已归档的设计裁决
        // `simplify-stdlib-auto-import`（2026-06-06，Rust-std 模型：`[dependencies]` 只写第三方）。
        // ⚠️ 它配套的 WS013 lint（声明 `z42.*` 依赖 → 「冗余」警告）**已随 C# 编译器蠕发**
        // （全仓 `grep WS013 src/` 为空），而 `z42-toml.md` 至今还写着它会警告 ——
        // 同族于 E0407 / `FlowAnalyzer.cs` 那类「文档在、实现没了」。
        // 本码对 stdlib 一律放行，否则就是把那条裁决反过来做。
        if (pkg.StartsWith("z42.")) { return ""; }
        if (this.DeclaredDeps.ContainsKey(pkg)) { return ""; }
        // 每个缺失的包**只报一次**。不去重的话一个 `StringBuilder` 就能刷出八条
        // （声明位 + 使用位 × 每个引用点），而用户要做的动作只有一个：加那一行依赖。
        // ⚠️ 去重键是**包名**而非 FQN：同一个包里用了三个类也只需要加一行。
        if (this._undeclaredSeen.ContainsKey(pkg)) { return ""; }
        this._undeclaredSeen.Put(pkg, "1");
        return "`" + what + "` comes from package `" + pkg
             + "`, which this project does not declare — add it under `[dependencies]` in z42.toml:"
             + "  \"" + pkg + "\" = \"*\"";
    }

    private StrBox _nsBoxOf(string name) {
        int at = this.ClassNsAll.Find(name);
        return (at < 0) ? null : (this.ClassNsAll.ValAt(at) as StrBox);
    }

    public string[] ClassPkgsOf(string fqn) {
        int at = this.ClassPkgAll.Find(fqn);
        if (at < 0) { return new string[0]; }
        StrBox box = this.ClassPkgAll.ValAt(at) as StrBox;
        return box.Value.Split("|");
    }

    // unify-type-identity-fqn：裸名在**本 CU 可见集**内是否歧义。
    //
    // 为什么必须有这个判据：发射端把解析结果写成 FQN 前要先确认那个结果**不是猜的**。
    // 外围 ns 声明了该名 → 按语言规则不算歧义（与 ResolveTypeP 的 ScopeNs 分支同口径）；
    // 否则若 ≥2 个**可见**命名空间都声明了它，解析只能靠 Classes 的 first/last-wins 撞赢家
    // ⇒ 此时发射端必须**退回短名**（诚实降级，与本 change 之前的行为一致），
    // 绝不能写一个「选了赢家」的 FQN —— 那是自信的错答案，比降级更坏。
    //
    // ⚠️ 判据只此一份：`TypeChecker.ChkAmbiguousBareName`（E0456）复用本方法，别再写第二套口径。
    public bool IsBareNameAmbiguous(string name) {
        if (name.IndexOf(".") >= 0) { return false; }   // 限定名 = 已消歧
        StrBox nsBox = this._nsBoxOf(name);
        if (nsBox == null) { return false; }
        if (nsBox.Count < 2) { return false; }
        string[] nss = nsBox.Value.Split("|");
        int visible = 0;
        int i = 0;
        while (i < nss.Length) {
            string ns = nss[i];
            if (NsScope.IsEnclosing(this.ScopeNs, ns)) { return false; }   // using-csharp-rules：外围 ns（任一层）胜出、不算歧义
            if (ns == "" || this.IsScopeVisibleNs(ns)) { visible = visible + 1; }
            i = i + 1;
        }
        return visible >= 2;
    }

    public bool IsScopeVisibleNs(string p) {
        if (p == "") { return false; }
        if (NsScope.IsEnclosing(this.ScopeNs, p)) { return true; }   // using-csharp-rules：外围链隐式可见
        int i = 0;
        while (i < this.ScopeUsingCount) {
            if (this.ScopeUsings[i] == p) { return true; }
            i = i + 1;
        }
        return false;
    }

    // add-bare-name-ambiguity-diagnostic：登记「短名 name 在命名空间 ns 里有一份声明」。
    // 幂等（同 ns 重复登记不累加）；全局 ns 用空串，读回时保留空串语义。
    public void NoteClassNs(string name, string ns) { SymbolTable.NoteNsInto(this.ClassNsAll, name, ns); }

    // enforce-fqn-name-identity 阶段 2：接口版，与 `NoteClassNs` 同一累积逻辑、另一张表。
    // 两个生产点：本地 `StubCollector._passInterfaces`、跨包 `ImportedSymbolLoader` 接口循环
    // （后者**必须在 first-wins 守卫之外**——守卫之内只有赢家能进，那正是「同短名跨 ns」被塌掉
    // 的地方，是 `ClassNsAll` 当初踩过、上面注释里写明的同一个坑）。
    public void NoteIfaceNs(string name, string ns) { SymbolTable.NoteNsInto(this.IfaceNsAll, name, ns); }

    // ── enforce-fqn-name-identity B1：名义身份 intern ──────────────────────────────
    //
    // 一次扫全部四张类型表给 id。**刻意做成"一次扫"而不是"每个登记点各调一次"**：
    // 登记点今天有 5 处（本地 class stub / 本地 interface 两分支 / Object stub / imported 合并），
    // 将来必然还会加 —— 逐点挂钩正是本仓反复失手的形状（[[parallel-pass-sequences-miss-new-hook]]）。
    // 扫在**全部登记之后**跑，新加的登记点自动被覆盖；漏在扫之后登记的由下面那道门抓。
    // 只扫 FQN 视图：短名表 `Classes` / `Interfaces` 的每个值都在 FQN 视图里（`FirstShortOnlyKey` 守着这条），
    // 再扫一遍短名表只是重复。门 `FirstUninternedKey` 仍查四张表 —— 不变量一旦破了就在那里变响。
    public void InternAllTypes() {
        SymbolTable._internAllIn(this.Intern, this.ClassesByFqn);
        SymbolTable._internAllIn(this.Intern, this.InterfacesByFqn);
    }

    // 🔴 **按槽位扫，不是按条目数扫**（2026-09-28 修，B1 的既有缺陷）。
    // `StrMap.ValAt(i)` 取的是**槽位** `i`（哈希布局），而 `Count()` 是**条目数** ——
    // 两者索引空间不同。原先写成 `while (i < tbl.Count())` ⇒ 只扫了前 `_count` 个槽，
    // 条目一旦散布到靠后的槽就**漏 intern**，留下 `TypeId == 0`。
    // ⚠️ 这个缺陷此前抓不到，因为**门 `_firstUninterned` 用了同一个错误模式**、同样漏扫
    // ⇒ 门永远不红。是 B3 的绑定断言把它逼出来的（接口 `IDer` 落在靠后的槽，句柄绑不上）。
    // ⭐ 正确用法见 `StrMap.z42:136` 抬头：`0..Capacity()-1` 扫 `UsedAt(i)`。
    private static void _internAllIn(TypeIntern intern, StrMap tbl) {
        int cap = tbl.Capacity();
        int i = 0;
        while (i < cap) {
            if (tbl.UsedAt(i)) {
                Z42Type t = tbl.ValAt(i) as Z42Type;
                if (t != null) { intern.Of(t); }
            }
            i = i + 1;
        }
    }

    // 门（fqn-tables）：短名表 `Classes` / `Interfaces` 里的每个值都必须也在 FQN 视图里（同一个对象）。
    // 返回第一个违反者的短名键；全部合规返回 ""。全表扫描类的 pass（intern / 句柄绑定）只扫 FQN 视图，
    // 正是靠这条不变量 —— 只活在短名表里的类型会漏 id、漏绑定。
    public string FirstShortOnlyKey() {
        string k = SymbolTable._firstNotInFqn(this.Classes, this.ClassesByFqn);
        if (k != "") { return k; }
        return SymbolTable._firstNotInFqn(this.Interfaces, this.InterfacesByFqn);
    }

    private static string _firstNotInFqn(StrMap shortTbl, StrMap fqnTbl) {
        int cap = shortTbl.Capacity();   // 🔴 按槽位扫，见 `_internAllIn` 抬头
        int i = 0;
        while (i < cap) {
            if (shortTbl.UsedAt(i)) {
                Z42Type t = shortTbl.ValAt(i) as Z42Type;
                string fk = SymbolTable._fqnKeyOf(shortTbl.KeyAt(i), t);
                if (t != null && fqnTbl.Get(fk) != t) { return shortTbl.KeyAt(i); }
            }
            i = i + 1;
        }
        return "";
    }

    // 短名表键 + 值 → 它在 FQN 视图里的键（`<ns>.<短名键>`；全局 ns 即短名键本身）。
    private static string _fqnKeyOf(string shortKey, Z42Type t) {
        string ns = "";
        if (t is Z42ClassType) { ns = (t as Z42ClassType).Namespace; }
        else if (t is Z42InterfaceType) { ns = (t as Z42InterfaceType).Namespace; }
        return ns == "" ? shortKey : ns + "." + shortKey;
    }

    // 门：四张表里是否还有没拿到 id 的类型。返回第一个漏网的键；全部合规返回 ""。
    // 🔴 存在的理由：`InternAllTypes` 是一次性扫，**扫之后**才登记的类型会静默留一个
    // `TypeId == 0`，而 0 在 B3/B4 之后会被当成"未登记"——静默失配。这道门让它变响。
    public string FirstUninternedKey() {
        string k = SymbolTable._firstUninterned(this.Classes);
        if (k != "") { return k; }
        k = SymbolTable._firstUninterned(this.ClassesByFqn);
        if (k != "") { return k; }
        k = SymbolTable._firstUninterned(this.Interfaces);
        if (k != "") { return k; }
        return SymbolTable._firstUninterned(this.InterfacesByFqn);
    }

    // 🔴 同 `_internAllIn`：**按槽位扫**。这道门原先与被守的 pass 犯了同一个错
    // （`Count()` 当上界），于是「漏 intern」与「门看不见漏 intern」互相掩盖 ——
    // 门和被守的东西共用同一个错误假设时，门永远不会红。
    private static string _firstUninterned(StrMap tbl) {
        int cap = tbl.Capacity();
        int i = 0;
        while (i < cap) {
            if (tbl.UsedAt(i)) {
                Z42Type t = tbl.ValAt(i) as Z42Type;
                if (t != null && t.TypeId <= 0) { return tbl.KeyAt(i); }
            }
            i = i + 1;
        }
        return "";
    }

    // ── enforce-fqn-name-identity B3：名字 → 句柄的绑定 pass ──────────────────────
    //
    // 把 `Z42ClassType.InterfaceNames[i]` / `Z42InterfaceType.BaseNames[i]` 解析成
    // `TypeIntern` 的 id，写进平行的 `Interfaces[i]` / `Bases[i]`。
    //
    // 🔴 **相位：必须在 `InternAllTypes()` 之后**（id 那时才存在），且在成员解析之前。
    // 与 `_passQualifyIfaceNames`（名字归一成 FQ）是两件事、两个相位：归一在 intern 之前，
    // 绑定在 intern 之后。别合并 —— 归一要求「全部 stub 进表」，绑定要求「全部 id 已分配」。
    //
    // 🔴 **绑不到就留 0，不报错**。这不是容错兜底，是**语义**：消费方不必看得见它实现的
    // 每个接口（实测 `z42c.driver` 看得见 `Z42cCompiler` 却看不见 `Z42.Build.ICompiler`，
    // 传递依赖未声明 —— 那是合法程序，B2.0 的归因结论就是据此推翻了「无解→报错」）。
    //
    // 🔴 **就地写，不换数组**。与 I3「归一不就地改写」相反，这里**必须**就地：
    // `Z42InstantiatedInterfaceType` 共享 def 的 `Bases` 引用，换数组它就永远停在全 0。
    // 之所以安全：`Interfaces`/`Bases` 是 B3 新加的、**只活在符号表里** —— 不进 wire、
    // 不被 `ClassExtractor` 接管（那条路搬的是 `InterfaceNames`）⇒ 没有第二个所有者。
    // ⚠️ 这个「安全」是有前提的，B5 删字符串字段时要重新审。
    //
    // 🔴 **鲁棒性**：本 pass 跑在 `CollectAll` = 自举必经路径上，它崩就编不出修好它的编译器。
    // 故边界、null、空表全部先判，宁可少绑也不崩（同 [[self-poisoned-bootstrap-via-feature-gate]]）。
    // 只扫 FQN 视图（理由同 `InternAllTypes`）；门 `FirstUnboundIfaceRef` 仍查四张表。
    public void BindTypeRefs() {
        this._bindClassIfaces(this.ClassesByFqn);
        this._bindIfaceBases(this.InterfacesByFqn);
        // B4：类的基类那根轴（`BaseName` → `Base`）。与接口两根同一套约定。
        this._bindClassBase(this.ClassesByFqn);
    }

    // B4：`Z42ClassType.BaseName` → `Base` 句柄。与 `_bindClassIfaces` 对称，差别只在
    // 它是**标量**、且查的是**类**表（`GetClass` 的 FQN 双键）而不是接口表。
    private void _bindClassBase(StrMap tbl) {
        int cap = tbl.Capacity();   // 🔴 按槽位扫，见 `_internAllIn` 抬头
        int i = 0;
        while (i < cap) {
            bool used = tbl.UsedAt(i);
            Z42ClassType ct = used ? tbl.ValAt(i) as Z42ClassType : null;
            i = i + 1;
            if (ct == null) { continue; }
            if (!ct.HasBase) { continue; }
            if (ct.Base != 0) { continue; }            // 幂等：已绑定的不动
            // A5b-2b-3：走到这里的基本只剩**导入类**（本地类已由 `_passBindClassBases` 按 CU 作用域绑过）。
            // 它们没有 CU 可给作用域，但有声明 ns ⇒ 先按「外围 ns 优先」试 `<ns>.<BaseName>`，不中再走名字解析。
            // fix-imported-base-fqn 起导入类的 `BaseName` 已是 FQ ⇒ 前者不中、后者走 FQN 那一步直接命中。
            if (ct.Namespace != "" && ct.BaseName != null && ct.BaseName != "") {
                int own = this.ClassesByFqn.Find(ct.Namespace + "." + ct.BaseName);
                if (own >= 0) { ct.Base = this.Intern.Of(this.ClassesByFqn.ValAt(own) as Z42ClassType); continue; }
            }
            ct.Base = this._refOfClass(ct.BaseName);
        }
    }

    // A5b-2b-3：在**带作用域的 per-CU 视图**上绑一个本地类的基类句柄（`SymbolCollector._passBindClassBases`）。
    // `_refOfClass` → `GetClass` 走的是本视图的 ScopeNs / ScopeUsings ⇒ 外围 ns 胜过裸名表赢家。已绑的不动。
    public void BindBaseInScope(Z42ClassType ct) {
        if (ct == null) { return; }
        if (!ct.HasBase) { return; }
        if (ct.Base != 0) { return; }
        ct.Base = this._refOfClass(ct.BaseName);
    }

    // 名字 → 类句柄。查不到 → 0（合法：跨包基类可能不可见）。
    private int _refOfClass(string name) {
        if (name == null) { return 0; }
        if (name == "") { return 0; }
        Z42ClassType ct = this.GetClass(name);
        if (ct == null) { return 0; }
        return this.Intern.Of(ct);   // 幂等
    }

    private void _bindClassIfaces(StrMap tbl) {
        // 🔴 **按槽位扫**（`0..Capacity()-1` + `UsedAt`），不是 `Count()` —— 见 `_internAllIn` 抬头。
        int cap = tbl.Capacity();
        int i = 0;
        while (i < cap) {
            bool used = tbl.UsedAt(i);
            Z42ClassType ct = used ? tbl.ValAt(i) as Z42ClassType : null;
            i = i + 1;
            if (ct == null) { continue; }
            if (ct.InterfaceNames == null) { continue; }
            // 双重边界：`InterfaceCount` 与数组长度不保证对齐（导入侧接管数组时两值各来各的）
            int m = ct.InterfaceCount;
            if (ct.InterfaceNames.Length < m) { m = ct.InterfaceNames.Length; }
            if (ct.Interfaces == null || ct.Interfaces.Length < m) {
                // 句柄数组短于要绑的条数 ⇒ 补一个足长的（保留已绑定的部分）
                int[] grown = new int[m];
                if (ct.Interfaces != null) {
                    int k = ct.Interfaces.Length; if (k > m) { k = m; }
                    int c = 0;
                    while (c < k) { grown[c] = ct.Interfaces[c]; c = c + 1; }
                }
                ct.Interfaces = grown;
            }
            int j = 0;
            while (j < m) {
                if (ct.Interfaces[j] == 0) { ct.Interfaces[j] = this._refOfIface(ct.InterfaceNames[j]); }
                j = j + 1;
            }
        }
    }

    private void _bindIfaceBases(StrMap tbl) {
        // 🔴 **按槽位扫** —— 这里正是 B1 那个漏扫缺陷被逼出来的现场：
        // `interface IDer : IBase` 的 `IDer` 落在靠后的槽，用 `Count()` 当上界就绑不上。
        int cap = tbl.Capacity();
        int i = 0;
        while (i < cap) {
            bool used = tbl.UsedAt(i);
            Z42InterfaceType it = used ? tbl.ValAt(i) as Z42InterfaceType : null;
            i = i + 1;
            if (it == null) { continue; }
            if (it.BaseNames == null) { continue; }
            int m = it.BaseCount;
            if (it.BaseNames.Length < m) { m = it.BaseNames.Length; }
            if (it.Bases == null || it.Bases.Length < m) {
                int[] grown = new int[m];
                if (it.Bases != null) {
                    int k = it.Bases.Length; if (k > m) { k = m; }
                    int c = 0;
                    while (c < k) { grown[c] = it.Bases[c]; c = c + 1; }
                }
                it.Bases = grown;
            }
            int j = 0;
            while (j < m) {
                if (it.Bases[j] == 0) { it.Bases[j] = this._refOfIface(it.BaseNames[j]); }
                j = j + 1;
            }
        }
    }

    // 名字 → 句柄。走 `GetInterface` 的 FQN 双键（名字此时已由 `_passQualifyIfaceNames` 归一成
    // FQ；归一不了的原样留着，双键的短名回落仍能接住本包声明）。查不到 → 0（合法，见抬头）。
    private int _refOfIface(string name) {
        if (name == null) { return 0; }
        Z42InterfaceType it = this.GetInterface(name);
        if (it == null) { return 0; }
        return this.Intern.Of(it);   // 幂等：已登记的原样返回既有 id
    }

    // 门（B3）：**在表里查得到、却没绑上句柄**的第一处。返回 "类名::接口名"，全绿返回 ""。
    //
    // 🔴 存在的理由：绑定失败本身是**静默**的（留 0，而 0 是合法状态）。于是「`BindTypeRefs`
    // 压根没跑」与「跑了但那几个接口确实不可见」在数据上长得一模一样 —— 正是本仓反复吃亏的
    // 「探测到 0 与探测器没装上不可区分」。本门只挑**矛盾**的那种：名字非空、`GetInterface`
    // 查得到、句柄却仍是 0 ⇒ 只可能是绑定没跑到（漏挂载点 / 相位早于 intern）。
    // ⚠️ 查不到的（合法的"看不见"）**不算**，否则门会对正常工程狂叫。
    public string FirstUnboundIfaceRef() {
        string r = this._firstUnboundIn(this.Classes, true);
        if (r != "") { return r; }
        r = this._firstUnboundIn(this.ClassesByFqn, true);
        if (r != "") { return r; }
        r = this._firstUnboundIn(this.Interfaces, false);
        if (r != "") { return r; }
        r = this._firstUnboundIn(this.InterfacesByFqn, false);
        if (r != "") { return r; }
        // B4：基类那根轴同样要守 —— 漏绑在这里同样是静默的（查不着 = 当作不是子类）。
        r = this._firstUnboundBaseIn(this.Classes);
        if (r != "") { return r; }
        return this._firstUnboundBaseIn(this.ClassesByFqn);
    }

    // B4 的门：`HasBase` 且基类在表里查得到、`Base` 却仍是 0 ⇒ 绑定没跑到。
    private string _firstUnboundBaseIn(StrMap tbl) {
        int cap = tbl.Capacity();
        int i = 0;
        while (i < cap) {
            if (!tbl.UsedAt(i)) { i = i + 1; continue; }
            string key = tbl.KeyAt(i);
            Z42ClassType ct = tbl.ValAt(i) as Z42ClassType;
            i = i + 1;
            if (ct == null) { continue; }
            if (!ct.HasBase) { continue; }
            if (ct.Base != 0) { continue; }
            if (ct.BaseName == null || ct.BaseName == "") { continue; }
            if (this.GetClass(ct.BaseName) != null) { return key + "::base " + ct.BaseName; }
        }
        return "";
    }

    private string _firstUnboundIn(StrMap tbl, bool isClass) {
        // 🔴 **按槽位扫** —— 门若与被守的 pass 用同一个错误上界，就会一起漏、永远不红。
        int cap = tbl.Capacity();
        int i = 0;
        while (i < cap) {
            if (!tbl.UsedAt(i)) { i = i + 1; continue; }
            string key = tbl.KeyAt(i);
            string[] names = null;
            int[] refs = null;
            int m = 0;
            if (isClass) {
                Z42ClassType ct = tbl.ValAt(i) as Z42ClassType;
                if (ct != null) { names = ct.InterfaceNames; refs = ct.Interfaces; m = ct.InterfaceCount; }
            } else {
                Z42InterfaceType it = tbl.ValAt(i) as Z42InterfaceType;
                if (it != null) { names = it.BaseNames; refs = it.Bases; m = it.BaseCount; }
            }
            i = i + 1;
            if (names == null) { continue; }
            if (names.Length < m) { m = names.Length; }
            int j = 0;
            while (j < m) {
                string nm = names[j];
                bool unbound = refs == null || j >= refs.Length || refs[j] == 0;
                if (unbound && nm != null && nm != "") {
                    if (this.GetInterface(nm) != null) { return key + "::" + nm; }
                }
                j = j + 1;
            }
        }
        return "";
    }

    // 接口短名声明过的全部 ns（无记录 → 空数组）。
    public string[] IfaceNsOf(string name) {
        int at = this.IfaceNsAll.Find(name);
        if (at < 0) { return new string[0]; }
        StrBox box = this.IfaceNsAll.ValAt(at) as StrBox;
        if (box == null) { return new string[0]; }
        return box.Value.Split("|");
    }

    // 接口裸名在**本 CU 可见集**内是否歧义。判据与 `IsBareNameAmbiguous` **逐条同构**
    // （限定名已消歧 / 外围 ns 自己声明了则按语言规则不算歧义 / 否则数可见 ns 份数），
    // 只是读另一张表。
    // ⚠️ 阶段 3 两表合一时这两个方法要**一起塌成一个** —— 别让它们各自漂移，
    // 「同一判据两份实现」在本仓已经反复出事（只修一份比都不修更糟）。
    public bool IsBareIfaceNameAmbiguous(string name) {
        if (name.IndexOf(".") >= 0) { return false; }   // 限定名 = 已消歧
        int at = this.IfaceNsAll.Find(name);
        if (at < 0) { return false; }
        StrBox nsBox = this.IfaceNsAll.ValAt(at) as StrBox;
        if (nsBox == null) { return false; }
        if (nsBox.Count < 2) { return false; }
        string[] nss = nsBox.Value.Split("|");
        int visible = 0;
        int i = 0;
        while (i < nss.Length) {
            string ns = nss[i];
            if (NsScope.IsEnclosing(this.ScopeNs, ns)) { return false; }   // using-csharp-rules：外围 ns（任一层）胜出、不算歧义
            if (ns == "" || this.IsScopeVisibleNs(ns)) { visible = visible + 1; }
            i = i + 1;
        }
        return visible >= 2;
    }

    // 同一份累积逻辑给两个生产点共用（本地 StubCollector 走 SymbolTable，跨包 ImportedSymbolLoader
    // 走 ImportedSymbols.ClassNsAll，最后由 SymbolCollector._mergeImports 并进来）——**别写两份**：
    // 两份累积逻辑各自演化正是「同短名信息被塌掉」这一类 bug 的温床。
    public static void NoteNsInto(StrMap m, string name, string ns) {
        int at = m.Find(name);
        if (at < 0) { m.Put(name, new StrBox(ns)); return; }
        StrBox box = m.ValAt(at) as StrBox;
        string cur = box.Value;
        // 逐段比对，避免 `Std` 与 `Std.Test` 互相子串命中。
        string[] parts = cur.Split("|");
        int i = 0;
        while (i < parts.Length) { if (parts[i] == ns) { return; } i = i + 1; }
        box.Value = cur + "|" + ns;
        box.Count = box.Count + 1;   // 唯一的追加点 ⇒ 项数在这里维护（读侧判据见 _pkgBoxOf / _nsBoxOf）
    }

    // 短名 → 声明过它的命名空间列表（无记录返回空数组）。
    public string[] ClassNsOf(string name) {
        int at = this.ClassNsAll.Find(name);
        if (at < 0) { return new string[0]; }
        StrBox box = this.ClassNsAll.ValAt(at) as StrBox;
        return box.Value.Split("|");
    }
}
