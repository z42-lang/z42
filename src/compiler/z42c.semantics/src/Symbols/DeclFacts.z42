// 声明修饰符 / 可见性 / 字面量文本的无状态助手——只看 AST 与字符串，不涉及 IR。
// 语义层（符号收集、类型检查、常量求值、声明期校验）与代码生成共用；放在语义层，代码生成反过来引用它
// （层次：Symbols / Types / Binding 不得引用 Emission 等更上层，见 z42c.semantics README「目录结构」）。
namespace Z42.Semantics;

using Z42.Syntax;

public static class DeclFacts {
    // 可见性 int 编码：0=public / 1=private / 2=protected / 3=internal。dflt = 无修饰符默认，按位置传入
    // （default-member-private：成员 1=private / 顶层自由函数 3=internal，镜像 access-control.md 最小封闭作用域）。
    public static int _visCode(string mods, int dflt) {
        if (DeclFacts._hasWord(mods, "private"))   { return 1; }
        if (DeclFacts._hasWord(mods, "protected")) { return 2; }
        if (DeclFacts._hasWord(mods, "public"))    { return 0; }
        if (DeclFacts._hasWord(mods, "override"))  { return 0; }   // enforce-access-control：override 继承基类(public)可见性
        // z42b-owns-test-targets：**补回漏掉的 internal 分支**。此前显式写 `internal` 的成员会掉到
        // `return dflt`（成员默认 1 = private）→ zbc 字节记成 private。对照同文件的 classVisCode，
        // 那边一直有这条分支。长期没人发现，是因为跨包 internal 成员**本来就一律拒绝** —— 记成
        // private 还是 internal 结果一样；直到测试目标可以合法访问父包 internal 才顶出来。
        if (DeclFacts._hasWord(mods, "internal"))  { return 3; }
        return dflt;
    }

    // enforce-class-access：类声明可见性编码（0=public/1=private/2=protected/3=internal）。位置默认镜像
    // 「最小封闭作用域」：嵌套类（isNested）→ private、顶层类 → internal；显式修饰符优先。SymbolCollector /
    // ClassDescBuilder / ExportedTypeExtractor 三处共用此单一真相，避免默认逻辑漂移。类不参与 override 继承。
    public static int classVisCode(string mods, bool isNested) {
        if (DeclFacts._hasWord(mods, "public"))    { return 0; }
        if (DeclFacts._hasWord(mods, "private"))   { return 1; }
        if (DeclFacts._hasWord(mods, "protected")) { return 2; }
        if (DeclFacts._hasWord(mods, "internal"))  { return 3; }
        if (isNested) { return 1; }   // 嵌套类默认 private
        return 3;                     // 顶层类默认 internal
    }

    // 类可见性 int → string（与 TsigReconcile._visStr 对齐；semantics 侧本地字符串化）。
    public static string classVisStr(int code) {
        if (code == 1) { return "private"; }
        if (code == 2) { return "protected"; }
        if (code == 3) { return "internal"; }
        return "public";
    }

    // 便捷：直接从 Mods + 是否嵌套算可见性字符串（Z42ClassType.Visibility / ExportedClassZ.Visibility 本地面）。
    public static string classVis(string mods, bool isNested) {
        return DeclFacts.classVisStr(DeclFacts.classVisCode(mods, isNested));
    }

    public static string _stripFloatSuffix(string t) {
        int n = t.Length;
        if (n > 0) {
            char last = t.CharAt(n - 1);
            if (last == 'f' || last == 'F' || last == 'd' || last == 'D') { return t.Substring(0, n - 1); }
        }
        return t;
    }

    public static long _parseEnumVal(string s) {
        long r = 0;
        int i = 0;
        bool neg = false;
        if (s.Length > 0 && s.CharAt(0) == '-') { neg = true; i = 1; }
        while (i < s.Length) {
            int d = (int)s.CharAt(i) - 48;
            r = r * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { r = 0 - r; }
        return r;
    }

    public static Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { AttributedDecl ad = d as AttributedDecl; return ad.Inner; }
        return d;
    }

    /// 修饰符串里是否含 `word` 这个**空格分隔的整词**。z42c 里有 75 处调用（全部传
    /// "static"/"abstract"/... 这类字面量），是本项目的规范实现，另外三处（SymbolCollector /
    /// ExportedTypeExtractor / TypeFactsTc）都转发到这里。
    ///
    /// perf：四份旧实现各有各的浪费 —— 两份逐字符 `CharAt`（每字符一次 builtin 分发）再
    /// `Substring` 出 token 比较；一份 `Split(" ")` 分配数组 + 每个 token 一个子串；一份
    /// `(" "+mods+" ").IndexOf(" "+w+" ")` 每次拼两个新串。这里一次 `ToCharArray` 物化，
    /// 之后全是 ArrayGet：不切子串、不建数组。
    ///
    /// 语义：对**非空** word 与四份旧实现逐条一致（整词匹配；空 token 永不匹配非空 word）。
    public static bool _hasWord(string s, string word) {
        int wn = word.Length;
        if (wn == 0) { return false; }
        int n = s.Length;
        if (wn > n) { return false; }
        // 扫描面物化一次（原来两份实现是每字符一次 `CharAt` builtin 分发）；`word` 侧不物化
        // ——只有 token 长度与两侧边界都对上时才逐字符比，实测每次调用至多比一两个 token。
        char[] cs = s.ToCharArray();
        int start = 0;
        int i = 0;
        while (i <= n) {
            if (i == n || cs[i] == ' ') {
                if (i - start == wn) {
                    int j = 0;
                    while (j < wn && cs[start + j] == word.CharAt(j)) { j = j + 1; }
                    if (j == wn) { return true; }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }
}
