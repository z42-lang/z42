// 符号收集 Pass A（骨架 stub）：从 SymbolCollector 分出。接口 / 枚举 / 类 stub / 委托的注册，
// 使成员类型可解析兄弟类。共享辅助（_unwrap）与编排入口留 hub SymbolCollector，经 _sc 委回。
namespace Z42.Semantics;
using Z42.IR;
using Z42.Syntax;
using Z42.Core;

public sealed class StubCollector {
    private SymbolCollector _sc;   // hub 反向引用：共享辅助 + partial 状态 + 编排
    public StubCollector(SymbolCollector sc) { this._sc = sc; }

    // Pass A-1：枚举类型 + 成员常量（先于类 stub——成员类型解析可能用到枚举）。
    // 用户 delegate → Z42FuncType（委托类型即函数类型）。泛型与非泛型都注册，键恒裸名
    // （泛型的型参解析成 Z42GenericParamType；实参在类型位擦除，同运行期）。
    // _passClassStubs 后调用，使签名 prim/类类型可解析。
    internal void _passDelegates(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is DelegateDecl) {
                DelegateDecl dd = d as DelegateDecl;
                // fix-generic-delegate-symbol（欠债表 bug B5）：泛型 delegate 也必须注册。
                // 此前 `TypeParams.Count == 0` 守卫把它整条跳过 ⇒ 类型位写 `Mapper<int,string>`
                // 报 `E0443: undefined type: Mapper`，而 `IrGenAuxEmitter.EmitDelegates` **照发**
                // TYPE 元数据 + `Invoke(...) -> R`（未解析的型参名）——又一处 binder/emitter 不对称。
                // 签名用 `ResolveTypeP` 带上 delegate 自己的型参 ⇒ `T`/`R` 解析成 Z42GenericParamType
                // 而非 Unknown；键仍是**裸名**（z42 泛型类型擦除，`ResolveTypeP` 查 Delegates 也用裸名，
                // 实参在类型位被丢弃 → 与运行期擦除一致）。
                // fix-delegate-param-default：`delegate void Log(string m, int level = 3);`
                // 此前**静默接受**这个默认值再整个丢掉 —— 委托类型的签名只记类型，调用点走
                // CallIndirect（没有「可选参数」这一层），于是 `l("hi")` 报 E1005「too few
                // arguments」，而读者眼里声明处明明写着默认值。默认值不可能生效，就该在
                // **写它的地方**说，而不是在调用点报一个看起来矛盾的错。
                int dp = 0;
                while (dp < dd.ParamCount) {
                    if (dd.Params[dp].Default != null) {
                        this._sc.Diags.Error(DiagnosticCodes.TypeMismatch,
                            "delegate parameter `" + dd.Params[dp].Name + "` cannot have a default value — a delegate type records only parameter types, so the default could never be applied at a call site",
                            dd.Params[dp].Span);
                    }
                    dp = dp + 1;
                }
                string dkey = SymbolTable.DeclKey(cu.HasNamespace ? cu.Namespace : "", dd.Name);   // 表键 = FQN（同名不同 ns 各一份）
                if (!table.Delegates.ContainsKey(dkey)) {
                    // A5b-2d：签名按**本 CU 作用域**解析（此前用根表，经 using 引入的类型全靠短名表回落；回落删掉后
                    // 会静默变成 Unknown）+ 补声明位类型引用检查（E0443 / 引用处 E0436），与字段 / 方法签名同口径。
                    SymbolTable sv = table.WithScopeOf(cu);
                    Z42Type[] ps = new Z42Type[dd.ParamCount];
                    int p = 0;
                    while (p < dd.ParamCount) {
                        ps[p] = sv.ResolveTypeP(dd.Params[p].Type, dd.TypeParams.Names, dd.TypeParams.Count);
                        this._sc._chkTypeRef(ps[p], "", sv, dd.Params[p].Type.Span);
                        p = p + 1;
                    }
                    Z42Type dret = sv.ResolveTypeP(dd.RetType, dd.TypeParams.Names, dd.TypeParams.Count);
                    this._sc._chkTypeRef(dret, "", sv, dd.RetType.Span);
                    table.Delegates.Put(dkey, new Z42FuncType(ps, dd.ParamCount, dret));
                    table.DelegateNs.Put(dkey, new StrBox(cu.HasNamespace ? cu.Namespace : ""));   // using-csharp-rules PR-2
                    table.NoteDelegateKey(dkey);
                }
            }
            i = i + 1;
        }
    }

    internal void _passEnums(SymbolTable table, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is EnumDecl) {
                EnumDecl ed = d as EnumDecl;
                string ekey = SymbolTable.DeclKey(cu.HasNamespace ? cu.Namespace : "", ed.Name);   // 表键 = FQN（同名不同 ns 各一份）
                table.EnumTypes.Put(ekey, "enum");
                table.NoteEnumKey(ekey);
                table.EnumTypeNs.Put(ekey, new StrBox(cu.HasNamespace ? cu.Namespace : ""));   // unify-type-identity-fqn：enum 声明 ns
                long cur = 0;
                int mi = 0;
                while (mi < ed.MemberCount) {
                    EnumMember em = ed.Members[mi];
                    if (em.HasValue) { cur = this._parseEnumVal(em.Value); }
                    table.EnumConsts.Put(ekey + "." + em.Name, new StrBox(cur.ToString()));
                    cur = cur + 1;
                    mi = mi + 1;
                }
            }
            i = i + 1;
        }
    }

    private long _parseEnumVal(string s) {
        long r = 0;
        int i = 0;
        bool neg = false;
        if (s.Length > 0 && s.CharAt(0) == '-') { neg = true; i = 1; }
        while (i < s.Length) {
            int d = (int)s.CharAt(i) - 48;
            r = r * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { r = 0 - r; }
        return r;
    }

    // Pass A0：接口 stub（先于类——基表判别要查 Interfaces）（port-z42c-interface）
    internal void _passInterfaces(SymbolTable table, CompilationUnit cu, string file) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "interface") {
                    // add-partial-types：同名接口碎片合并（方法经 _fillInterface 并入首碎片；主碎片=首=min-path）。
                    // 碰撞只看**本命名空间**的同名接口（FQN 视图）：短名表里别的 ns 的同名接口不是本接口的碎片。
                    string ifq = SymbolTable.QualOf(cu.HasNamespace ? cu.Namespace : "", c.Name);
                    if (table.InterfacesByFqn.ContainsKey(ifq)) {
                        Z42InterfaceType prev = table.InterfacesByFqn.Get(ifq) as Z42InterfaceType;
                        if (c.IsPartial || prev.IsPartial) {
                            if (c.IsPartial && !prev.IsPartial) { prev.IsPartial = true; prev.PartialMainFile = file; }
                            // 保留 prev（首碎片），不覆盖 → _fillInterface 各碎片方法并入同一接口。
                            this._addIfaceBases(prev, c);   // 父接口按碎片累积（与方法同）
                        } else {
                            Z42InterfaceType itw = new Z42InterfaceType(c.Name);   // 均非 partial：维持既有 last-wins
                            itw.Namespace = cu.Namespace;   // unify-type-identity-fqn：声明 ns（供 Fqn()）
                            itw.Visibility = DeclFacts.classVis(c.ModFlags, c.Name.IndexOf('+') >= 0);   // complete-class-access-control ④
                            StubCollector._setIfaceTypeParams(itw, c);   // add-associated-types PR-3
                            this._addIfaceBases(itw, c);
                            table.Interfaces.Put(c.Name, itw);
                            table.InterfacesByFqn.Put(itw.Fqn(), itw);   // unify-type-identity-fqn
                            table.NoteIfaceNs(c.Name, itw.Namespace);    // enforce-fqn-name-identity 阶段 2
                        }
                    } else {
                        Z42InterfaceType it = new Z42InterfaceType(c.Name);
                        it.Namespace = cu.Namespace;   // unify-type-identity-fqn：声明 ns（供 Fqn()）
                        if (c.IsPartial) { it.IsPartial = true; it.PartialMainFile = file; }
                        it.Visibility = DeclFacts.classVis(c.ModFlags, c.Name.IndexOf('+') >= 0);   // complete-class-access-control ④
                        StubCollector._setIfaceTypeParams(it, c);   // add-associated-types PR-3
                        this._addIfaceBases(it, c);
                        table.Interfaces.Put(c.Name, it);
                        table.InterfacesByFqn.Put(it.Fqn(), it);   // unify-type-identity-fqn
                        table.NoteIfaceNs(c.Name, it.Namespace);   // enforce-fqn-name-identity 阶段 2
                    }
                }
            }
            i = i + 1;
        }
    }

    // add-associated-types PR-3：接口自身的型参名进符号表（`interface IBox<T>` → ["T"]）。
    // 此前接口没有型参名槽 —— PR-2 跨包补型参上下文时只能临时从 `ExportedInterfaceZ.TypeParams`
    // 现取，本包侧则压根拿不到。partial 碎片：以首碎片为准（各碎片型参列表须一致，另有 partial 校验管）。
    private static void _setIfaceTypeParams(Z42InterfaceType target, ClassDecl c) {
        if (target.TypeParamCount > 0) { return; }   // 已由首碎片填过
        target.TypeParamNames = c.TypeParams.Names;
        target.TypeParamCount = c.TypeParams.Count;
    }

    // ── interface-names-fqn：把两张接口名字数组从**查找键短名**重写成 FQN ──────────────
    //
    // 目标：`Z42ClassType.InterfaceNames`（类实现的接口）与 `Z42InterfaceType.BaseNames`
    // （接口的父接口）统一成 FQN，让名义关系判定不再依赖「同短名跨 ns 只活一份」这个前提。
    //
    // 🔴 **为什么必须是独立的一趟、不能在 Pass A 就地写**：Pass A 逐 CU 跑，被引用的接口可能
    // 声明在**后面的 CU** 里、此刻还没进表 ⇒ 那时根本算不出 FQN。本 pass 在**全部** stub
    // （本地 + 导入）都进表之后跑一次，把两张数组一起归一。
    //
    // 🔴 **两张必须一起翻**：`SymbolTable.Implements` 的传递闭包 BFS **同时**用
    // `InterfaceNames`（种子）与 `BaseNames`（沿父接口展开）—— 只翻一张，继承来的接口就会在
    // BFS 里 FQN 与短名混比、**静默失配**（class→iface 误报 E0402 **且** 约束满足性漏报）。
    //
    // 幂等：FQN 再查一次（`GetInterface` 双键）仍得同一个 FQN ⇒ 同一个对象被多个键指到、
    // 或本 pass 被重复调用都安全。查不到就原样留着（型参 / 未解析名，交给别处报错）。
    //
    // ⚠️ 走 FQN 视图：`Classes`/`Interfaces` 是短名单赢家，同短名的第二份**只在** FQN 视图里
    //（`ImportedSymbolLoader` 的 first-wins 守卫之外每份都 Put）；短名表的每个值也都在 FQN 视图里
    //（`SymbolTable.FirstShortOnlyKey` 守着），所以只走 FQN 视图就覆盖全部。
    internal void _passQualifyIfaceNames(SymbolTable table) {
        this._qualifyClassIfaces(table, table.ClassesByFqn);
        this._qualifyIfaceBases(table, table.InterfacesByFqn);
    }

    // A5b-2c：**本地**声明先按**声明方 CU 的作用域**归一（三个入口都挂，紧挨根表那一趟之前）。
    // 根表那一趟没有作用域：同包、外围 ns 里的接口（`class CompileCuTask : IParallelBody`，两者都在
    // `Z42.Semantics`）在根表上 FQN 查不中，只能落 `GetInterface` 的裸名回落 —— 探针实测 stdlib + 编译器
    // 全量 31 次，全来自这里与 `ClassExtractor._extractInterface`。根表那一趟保留：导入类（已是 FQ，幂等）
    // 与本 pass 没覆盖到的（查不到的原样留着）走它。
    internal void _passQualifyIfaceNamesInScope(SymbolTable table, CompilationUnit cu) {
        SymbolTable sv = table.WithScopeOf(cu);
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = cu.Decls[i];
            if (d is AttributedDecl) { d = (d as AttributedDecl).Inner; }
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "interface") {
                    Z42InterfaceType it = sv.GetInterface(c.Name);
                    if (it != null && it.BaseNames != null) {
                        int n = it.BaseCount; if (it.BaseNames.Length < n) { n = it.BaseNames.Length; }
                        it.BaseNames = StubCollector._qualifiedCopy(sv, it.BaseNames, n);
                    }
                } else {
                    Z42ClassType ct = sv.LocalClassOf(sv.ScopeNs, c);
                    if (ct != null && ct.InterfaceNames != null) {
                        int n2 = ct.InterfaceCount; if (ct.InterfaceNames.Length < n2) { n2 = ct.InterfaceNames.Length; }
                        ct.InterfaceNames = StubCollector._qualifiedCopy(sv, ct.InterfaceNames, n2);
                    }
                }
            }
            i = i + 1;
        }
    }

    // 产出新数组（**绝不就地改写**，理由见 `_qualifyClassIfaces` 体内注释）：前 n 项经 `IfaceFqnOf` 归一，其余原样。
    private static string[] _qualifiedCopy(SymbolTable view, string[] names, int n) {
        string[] nn = new string[names.Length];
        int c = 0;
        while (c < names.Length) { nn[c] = names[c]; c = c + 1; }
        int i = 0;
        while (i < n) { nn[i] = SymbolTable.IfaceFqnOf(view, nn[i]); i = i + 1; }
        return nn;
    }

    private void _qualifyClassIfaces(SymbolTable table, StrMap tbl) {
        string[] keys = tbl.Keys();
        int k = 0;
        while (k < keys.Length) {
            Z42ClassType ct = tbl.Get(keys[k]) as Z42ClassType;
            if (ct != null) {
                // 🔴 **双重边界**：`InterfaceCount` 与 `InterfaceNames.Length` 不保证对齐 ——
                // 导入侧 `nct.InterfaceNames = cl.Interfaces; nct.InterfaceCount = cl.InterfaceCount`
                // 直接接管数组，两个值各来各的。只按 count 走会**越界读出野引用**，随后
                // `GetHashCode` 段错误（实测 SIGSEGV，栈顶停在 `Std.String.GetHashCode`）。
                int n = ct.InterfaceCount;
                if (ct.InterfaceNames == null) { n = 0; }
                else if (ct.InterfaceNames.Length < n) { n = ct.InterfaceNames.Length; }
                // 🔴 **绝不就地改写**：这个数组不是本表独占的 ——
                //   · `ClassExtractor:375` `ez.Interfaces = ct.InterfaceNames` 是**别名不是拷贝**；
                //   · `ImportedSymbolLoader:254` `nct.InterfaceNames = cl.Interfaces` 又把它接管给导入侧。
                // 就地写会穿透到导出记录与 ImportedSymbols 缓存，且「谁先抓走这个引用」与
                // 「本 pass 何时写」相互竞争 —— 实测下游包里读到的是野引用（探针：3 个条目、
                // 无一是 IEquatable，[0] 的"内容"是约 1.6KB 堆字节）。
                // 改为产出新数组、只换本类型自己的字段引用。长度与 InterfaceCount 都**原样保留**
                // （`InterfaceCount > Length` 那条既有不一致留给单独一刀，这里不夹带）。
                if (ct.InterfaceNames != null) { ct.InterfaceNames = StubCollector._qualifiedCopy(table, ct.InterfaceNames, n); }
            }
            k = k + 1;
        }
    }

    private void _qualifyIfaceBases(SymbolTable table, StrMap tbl) {
        string[] keys = tbl.Keys();
        int k = 0;
        while (k < keys.Length) {
            Z42InterfaceType it = tbl.Get(keys[k]) as Z42InterfaceType;
            if (it != null) {
                int n = it.BaseCount;   // 双重边界，同上
                if (it.BaseNames == null) { n = 0; }
                else if (it.BaseNames.Length < n) { n = it.BaseNames.Length; }
                // 同上，不就地改写（`ExportedInterfaceZ.BaseNames` 同样按引用搬运）。
                // ⚠️ 这里**尤其**不能动长度或 `BaseCount`：`BaseNames` 与 `BaseRefs` 共用同一个
                // `BaseCount`、永远等长扩容（见 `Z42Type.AddBaseRef` 抬头），改一边就错位，
                // 而错位是静默的（型参照旧不代换）。
                if (it.BaseNames != null) { it.BaseNames = StubCollector._qualifiedCopy(table, it.BaseNames, n); }
            }
            k = k + 1;
        }
    }

    // `interface IDerived : IBase` 的父接口裸名 → Z42InterfaceType.BaseNames
    // （complete-where-constraints PR-1：让 `SymbolTable.Implements` 能走接口继承闭包）。
    // 存裸名，与类的 InterfaceNames 一致（`IComparable<char>` → `IComparable`，见本文件 Pass A）。
    // 去重交给 Implements 的 BFS（seen 集），这里只管累积——partial 碎片会重复声明同一父接口。
    private void _addIfaceBases(Z42InterfaceType target, ClassDecl c) {
        int b = 0;
        while (b < c.BaseCount) {
            string bn = c.Bases[b].Dump();
            int ltIdx = bn.IndexOf('<');
            if (ltIdx >= 0) { bn = bn.Substring(0, ltIdx); }
            // 🔴 **必须剥 ns**：`BaseNames` 是 `Interfaces` 表的**查找键**（`BaseAt` / `InterfaceDerivesFrom`
            // 都拿它去查），而那张表的键是**裸短名**。此前这里存的是源码原样串 ⇒ 写
            // `interface IRes : Std.IDisposable` 就永远查不到、父接口链整条断掉。
            // 短名写法下 `_shortOf` 是恒等，故对既有源码逐字等价。
            bn = SymbolTable.ShortNameOf(bn);
            // 裸名作查找键，**AST 原节点**另存一份：裸名把 `IMid<int>` 的 `int` 丢了，而沿继承链
            // 代换型参时正需要它（见 Z42InterfaceType.BaseRefs 抬头）。这里不能就地解析 ——
            // 本 pass 是 Pass A，后声明的父接口此刻可能还没进符号表；解析延到消费端。
            target.AddBaseRef(bn, c.Bases[b]);
            b = b + 1;
        }
    }

    // Pass A：类 stub（基表判别：接口入 InterfaceNames，类→base）
    internal void _passClassStubs(SymbolTable table, CompilationUnit cu, string file) {
        SymbolTable scoped = table.WithScopeOf(cu);   // 基类列表里的名字按本 CU 作用域判接口 / 类
        // arity-mangle 判据（镜像 C# NeedsMangle）：同短名有多个 arity 时，泛型版键带 `$N`。
        //
        // fix-arity-mangle-package-wide：**判据来自包级集合** `table.MultiArityNames`
        // （SymbolCollector 在任何 stub 注册前对全部 CU 喂过 `NoteArities`），不再在这里 per-CU 预扫。
        // 修前是 per-CU 的，而 `table.Classes` 是 per-package ⇒ 「a.z42 的 `class Foo` +
        // b.z42 的 `class Foo<T>`」两边都判「本 CU 只有一个 arity」⇒ 都不 mangle ⇒ 撞同一个裸键
        // ⇒ last-wins。同源对照（同一份程序，只差文件是否拆开）实测：
        //   同一文件：`g.GetType().Name` = `Foo$1`、`g is Foo` = false、`p.N = 7` 正常；
        //   拆两文件：`g.GetType().Name` = `Foo`、`g is Foo` = **true**、`p.N = 7` **运行期崩**
        //             （`VCall: expected object, got Null`）。
        // 即：**同一份源码，拆不拆文件决定它对不对**。
        StrMap multiArityMap = table.MultiArityNames;
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct") {
                    bool hasBase = false;
                    string baseName = "";
                    // fix-inherited-typeparam-field-type：基类的**声明形态**（`GBox<int>`）。
                    // 这里不能就地解析 —— 本 pass 只建 stub，被引用的类型可能还没登记
                    //（同 `_addIfaceBases` 留 AST 节点的理由，见 Z42ClassType.BaseRef 抬头）。
                    TypeExpr baseRef = null;
                    string[] ifaces = new string[c.BaseCount];
                    int ifc = 0;
                    int b = 0;
                    while (b < c.BaseCount) {
                        string bn = c.Bases[b].Dump();
                        // 泛型接口查表用裸名（"IComparable<char>" → "IComparable"），
                        // 存储也用裸名（镜像 C# ExportedTypeExtractor ifaceList.Select(i => i.Name)）。
                        string bnLookup = bn;
                        int ltIdx = bn.IndexOf('<');
                        if (ltIdx >= 0) { bnLookup = bn.Substring(0, ltIdx); }
                        // 🔴 **基表分流必须认限定名**。此前这里直接拿源码原样串查 `Interfaces`
                        // （键是裸短名）⇒ 写 `class A : Std.IDisposable` 查不中，落进下面的
                        // `else` 分支**去占基类槽**。三个症状同一个根，全部实测过：
                        //   ① `IDisposable a = new A();` 报 E0402（接口关系丢了）
                        //   ② `class E : Std.IDisposable, Base` ⇒ 真基类 `Base` 被**静默吞掉**
                        //      （`e.Tag()` 报 E0401，因为接口先占了 `hasBase`）
                        //   ③ `class G : Demo.Base` ⇒ `BaseName` 存成查不到的串，整条基类关系丢失
                        // 同包限定名（`Demo.ILocal`）一样中招 —— 这不是跨包问题，是拼写问题。
                        string ifaceKey = SymbolTable.InterfaceKeyOf(scoped, bnLookup);   // 按本 CU 作用域判（同发射端）
                        if (ifaceKey != "") { ifaces[ifc] = ifaceKey; ifc = ifc + 1; }
                        // fix-generic-base-name（欠债表 bug B 真根因）：**基类**也必须存裸名。
                        // `BaseName` 的每一个消费方都拿它当 `Classes` 的键用（IsSubclassOf /
                        // InheritanceResolver / DeclBinder / EmitContext / AccessChecker /
                        // ClassExtractor），而 `Classes` 的键是裸短名（或 `Name$N`）——存 `"Bag<T>"`
                        // 就永远查不到，整条 base 链在泛型基类处**静默截断**：继承成员找不到、
                        // IsSubclassOf 恒 false（⇒ `Bag<int> b = sub;` 报 E0402）。
                        // 上面接口分支早已算出裸名，这里此前却用了带实参的 `bn`。
                        // 遗留限制：同短名多 arity 的泛型基类（`Classes` 键带 `$N`）仍对不上——
                        // 与接口侧（同样存裸名）一致，不在本次修复范围。
                        else if (!hasBase) { hasBase = true; baseName = SymbolTable.ShortNameOf(bnLookup); baseRef = c.Bases[b]; }
                        b = b + 1;
                    }
                    bool needsMangle = c.TypeParams.Count > 0 && multiArityMap.ContainsKey(c.Name);
                    string key = needsMangle ? c.Name + "$" + c.TypeParams.Count.ToString() : c.Name;
                    // add-partial-types：同名碎片合并。保留首碎片（发现序=Ordinal 序，首=主碎片 min-path），
                    // 并入本碎片的 base/接口；均非 partial 时维持既有 last-wins 覆盖（无回归）。
                    // 碰撞只看**本命名空间**的同名类（FQN 视图）：短名表会把别的 ns（含导入包）里的同名类也算进来，
                    // 任一方是 partial 时就把两个不相干的类并成一个。
                    string declFqn = SymbolTable.QualOf(cu.HasNamespace ? cu.Namespace : "", key);
                    Z42ClassType prevSame = table.ClassesByFqn.Get(declFqn) as Z42ClassType;
                    bool mergePartial = prevSame != null && (c.IsPartial || prevSame.IsPartial);
                    if (mergePartial) {
                        Z42ClassType prev = prevSame;
                        if (hasBase) {
                            if (prev.HasBase && prev.BaseName != baseName) {
                                this._sc.Diags.Error(DiagnosticCodes.PartialBaseConflict,
                                    "partial type `" + c.Name + "` declares a base class in more than one fragment", c.Span);
                            } else if (!prev.HasBase) {
                                prev.HasBase = true; prev.BaseName = baseName; prev.BaseRef = baseRef;
                                // B4：名字换了，句柄必须跟着失效 —— 否则一旦本行跑在
                                // `BindTypeRefs` 之后（今天不会，但相位是会变的），`Base` 会
                                // 指着**旧**基类，而那是静默的。置 0 让绑定 pass 重新解析。
                                prev.Base = 0;
                            }
                        }
                        int ii = 0;
                        while (ii < ifc) { if (!this._ctHasIface(prev, ifaces[ii])) { prev.AddInterfaceName(ifaces[ii]); } ii = ii + 1; }
                        if (c.IsPartial && !prev.IsPartial) { prev.IsPartial = true; prev.PartialMainFile = file; }
                        // 保留 prev（首碎片），不覆盖 → 成员按 Ordinal 序累积进同一 CT（_fillClass 各碎片查同名命中此 CT）。
                    } else {
                        // 新键 OR 碰撞但均非 partial。
                        //
                        // report-duplicate-type-name（E0458）：**同一命名空间里重复声明同一个类型**
                        // 此前是静默 last-wins —— 上面那行注释「维持既有 last-wins 覆盖，无回归」
                        // 说的正是它。实测：同 ns 两个 `class Dup`，单文件与跨 CU 两种形态都
                        // **rc=0 零诊断**，后声明的那个赢，前一个连同它的成员一起消失。
                        // 跨 CU 形态在真实工程里更危险：两个文件各写一个 `class Config`，
                        // 谁也不会注意到其中一个从来没生效过。对齐 C# CS0101。
                        //
                        // 🔴 判据必须是 **(ns, 名字, arity) 三者都相同**，不能只看 `Classes` 的裸名键：
                        //   · 裸名键在**同短名跨 ns**（`A.Foo` / `B.Foo`，同一个包里）也会撞 —— 那是
                        //     **使用点**的歧义（E0456 管），不是重复声明；故按 `ClassesByFqn` 判。
                        //   · arity 也必须比：arity 预扫是 **per-CU** 的（见本方法开头），而符号表是
                        //     per-package —— 于是「a.z42 的 `class Foo` + b.z42 的 `class Foo<T>`」两者
                        //     都拿裸键 `Foo`、撞进同一个 FQN。实测那种写法今天能编过，把它报成
                        //     「重复定义」是**错的诊断**（真问题是 arity 键没跨 CU 生效）。
                        //     登记 Deferred：`arity-mangle-not-package-wide`。
                        string dupNs = cu.HasNamespace ? cu.Namespace : "";
                        string fqnKey = dupNs == "" ? key : dupNs + "." + key;
                        int fqAt = table.ClassesByFqn.Find(fqnKey);
                        if (fqAt >= 0) {
                            Z42ClassType prevFq = table.ClassesByFqn.ValAt(fqAt) as Z42ClassType;
                            if (prevFq != null && prevFq.GenericParamCount == c.TypeParams.Count) {
                                this._sc.Diags.Error(DiagnosticCodes.DuplicateTypeName,
                                    "the " + (dupNs == "" ? "global namespace" : "namespace `" + dupNs + "`")
                                    + " already contains a definition for `" + c.Name + "`"
                                    + " — rename one of them, or mark both `partial` to merge them", c.Span);
                            }
                        }
                        this._putClassStub(table, key, c, hasBase, baseName, baseRef, ifaces, ifc, needsMangle, file,
                                           dupNs);   // fix-type-ref-ns-collision
                    }
                    // add-deprecated-directive：本地类级 `[Deprecated]`（任一碎片带即标记）。stub 已注册 → 回查设位。
                    if (HandlerRegistry.HasDeprecated(cu.Decls[i])) {
                        Z42ClassType ctd = table.ClassesByFqn.Get(declFqn) as Z42ClassType;
                        if (ctd != null) { ctd.IsDeprecated = true; ctd.DeprecationMsg = HandlerRegistry.DeprecatedMsg(cu.Decls[i]); }
                    }
                    // add-record-value-semantics：本地类级 `[Record]`（class/struct）。stub 已注册 → 回查设位，
                    // 供 OperatorEmitter 判定 record-class `==`/`!=` 脱糖成值 Equals。
                    if (HandlerRegistry.HasRecord(cu.Decls[i])) {
                        Z42ClassType ctr = table.ClassesByFqn.Get(declFqn) as Z42ClassType;
                        if (ctr != null) { ctr.IsRecord = true; }
                    }
                }
            }
            i = i + 1;
        }
    }

    // ct 的接口集是否已含 name（碎片接口并集 dedup 用）。
    //
    // 🔴 **B3 刻意不改成句柄比较，这不是漏网**：本函数跑在 **Pass A**（class stub 收集），
    // 那时 `_passQualifyIfaceNames` 还没归一名字、`BindTypeRefs` 更没跑 ⇒
    // `ct.Interfaces[]` **全是 0（未绑定）**，换成句柄这里会恒判「不含」⇒ partial 碎片的
    // 接口并集出现重复条目。**按名字比是这个相位唯一可用的判据。**
    // ⇒ 与之对称：`ImportedSymbolLoader` 的 trait 去重（`_mergeImpl` 早于 `_mergeImports`）同理。
    private bool _ctHasIface(Z42ClassType ct, string name) {
        int i = 0;
        while (i < ct.InterfaceCount) { if (ct.InterfaceNames[i] == name) { return true; } i = i + 1; }
        return false;
    }

    // 建并注册一条类 stub（新键 / 非-partial 碰撞覆盖共用；抽出避免 z42 函数级作用域下 `ct` 重复声明）。
    private void _putClassStub(SymbolTable table, string key, ClassDecl c, bool hasBase, string baseName,
                               TypeExpr baseRef, string[] ifaces, int ifc, bool needsMangle, string file, string ns) {
        Z42ClassType ct = new Z42ClassType(c.Name, hasBase, baseName);
        ct.BaseRef = baseRef;   // fix-inherited-typeparam-field-type：保住 `<...>`，供基类链型参代换
        ct.Namespace = ns;   // fix-type-ref-ns-collision：声明 ns（供 Fqn() + 限定名解析）
        ct.IsStruct = c.Kind == "struct";   // add-struct-value-semantics：值类型标志（`[Record] class` 仍是引用类型，IsStruct=false）
        ct.IsSealed = Mod.Has(c.ModFlags, Mod.Sealed);   // impl-sealed-semantics-devirt：本地 sealed class
        ct.IsAbstract = Mod.Has(c.ModFlags, Mod.Abstract);   // add-internal-hierarchy-exhaustiveness：本地 abstract class（封闭层次穷尽性排除不可实例化类）
        ct.Visibility = DeclFacts.classVis(c.ModFlags, c.Name.IndexOf('+') >= 0);   // enforce-class-access：位置默认（嵌套→private / 顶层→internal，显式优先）
        ct.InterfaceNames = ifaces;
        ct.InterfaceCount = ifc;
        if (c.TypeParams.Count > 0) { ct.GenericParamNames = c.TypeParams.Names; ct.GenericParamCount = c.TypeParams.Count; }
        if (needsMangle) { ct.HasArityMangle = true; ct.ArityMangleCount = c.TypeParams.Count; }
        if (c.IsPartial) { ct.IsPartial = true; ct.PartialMainFile = file; }
        table.Classes.Put(key, ct);
        table.NoteClassNs(key, ns);   // add-bare-name-ambiguity-diagnostic：裸名 → 全部声明 ns（判歧义用）
        // fix-type-ref-ns-collision：同时按 FQN 键登记（`ns.key`；全局 ns 用裸 key）。裸名 Classes 会被同短名
        // 跨 ns 后来者覆盖，此 FQN 视图保留每一份 → `new A.Foo` 的限定名解析命中 ns==A 的那份，不再撞赢家。
        string fqn = ns == "" ? key : ns + "." + key;
        table.ClassesByFqn.Put(fqn, ct);
    }

}
