// SymbolTable 的「名义关系判定」那一簇（A5，从 SymbolTable.z42 拆出）。
//
// 为什么单独成文件：`SymbolTable.z42` 顶到了 886 行硬限（`xtask test lines` 判红），
// 而这一簇在职责上本来就自成一块 —— 它回答的全是同一个问题族：
//
//   「这两个**名义类型**是不是同一个 / 有没有继承关系？」
//
// `_sameRef`（相等判定唯一实现）· `_sameIface`（数组版）· `Implements`（类→接口，含传递闭包）·
// `InterfaceDerivesFrom`（接口→接口）· `_anyInterfaceDerivesFrom`（父链 BFS）·
// `IsSubclassOf`（类→类）· `BaseOf`（取下一层基类的唯一出口）全在这里。
//
// 🔴 这一簇的共同不变量（enforce-fqn-name-identity B3/B4/B5 建立）：
//   **判定只认名义身份句柄**（`TypeIntern` 的 id），不按名字比。0 = 未绑定，永不参与相等判定。
//   名字只在**入口**用一次（调用方给的是名字）与**回落**时用（跨包基类不可见，待 A5 收口）。
//
// ⚠️ 本次拆分是**纯代码搬运**：方法体逐字未改，只是换了文件。判据、消息措辞、调用关系全不动。
// `partial` 而非静态辅助类的理由同 `SymbolTable.Origins.z42` 抬头（零调用点改动、零额外帧）。
namespace Z42.Semantics;
using Z42.IR;


public sealed partial class SymbolTable {
    // ── enforce-fqn-name-identity B3：接口相等判定的**唯一出口** ──────────────────
    //
    // 🔴 **0（未绑定）永不参与相等判定**。否则「目标绑不到」与「实现方那一格绑不到」会
    // `0 == 0` 撞成**假阳性** —— 而「绑不到」是**合法状态**，不是可以忽略的边角：消费方
    // 不必看得见它实现的每个接口（实测 `z42c.driver` 看得见 `Z42cCompiler` 却看不见
    // `Z42.Build.ICompiler`，传递依赖未声明）。这正是 B2.0 归因推翻「无解→报错」的那条。
    //
    // 判定：两边**都**有句柄 ⇒ 比句柄（精确、与拼写无关）；任一为 0 ⇒ 退回名字比较，
    // 逐字保持 B3 之前的行为 ⇒ **字节恒等**。B5 删这条回落时要单独裁「绑不到」的语义。
    //
    // ⚠️ 判定只此一份：`Implements` 的 BFS 种子与 `_anyInterfaceDerivesFrom` 的父链展开
    // 共用它。两处各写一遍正是本仓反复失手的形状（「同一判据两份实现时，只修一份比都不修更糟」）。
    // 标量版：名义身份相等判定的**唯一实现**。B3（接口）与 B4（类基类）共用它 ——
    // 同一判据两份实现正是本仓反复失手的形状（`InterfaceKeyOf` 那次「只修一份反而从误报
    // 升级成运行期崩」）。
    //
    // ── B5：**名字回落已删** ────────────────────────────────────────────────
    //
    // B3/B4 期间这里是「两边都有句柄 ⇒ 比句柄；任一为 0 ⇒ 退回比名字」。回落是过渡设施，
    // 用来保证那两批**行为不变**；它的正当性一直没被测过。B5 先量后删：
    //
    // | 面 | 阳性对照 `refHit` | 回落触发 `fbTotal` |
    // |---|---|---|
    // | stdlib 全量（19 包） | 42~66 | **0** |
    // | 真·跨包编译（导入类 → 本地同短名接口） | 2 | **0** |
    //
    // ⇒ **一次都没触发**，是死代码。机理也说得通：能在源码里写出 `IThing t = ...` 就意味着
    // 该接口解析得到、在表里 ⇒ `targetRef != 0`；而「目标在表里、被查那一格却没绑上」是
    // **矛盾**状态，由 `FirstUnboundIfaceRef()` 那道门专门抓。两种 0 都不该出现在判定里。
    //
    // 🔴 **删掉回落后，0 的语义变成「判不了 ⇒ false」而不是「猜一下」**。这不是收紧：
    // 上面两组数字说明现实中走不到；真走到了，说明绑定漏了 —— 那时给 false 比按名字猜
    // 更好，因为猜出来的 true 是**静默错值**（本程序开篇追的就是这个）。
    // ⚠️ B5 起**不再收名字参数** —— 留着它就是留着「可以按名字比」这条路，而那正是要关掉的。
    private static bool _sameRef(int a, int b) {
        if (a == 0 || b == 0) { return false; }
        return a == b;
    }

    // 数组版：`refs[i]` 对 target 的判定（带双重边界）。转发到 `_sameRef`。
    // B5：名字数组不再参与判定，故不再是参数。
    private static bool _sameIface(int[] refs, int i, int targetRef) {
        if (refs == null || i >= refs.Length) { return false; }
        return SymbolTable._sameRef(refs[i], targetRef);
    }

    public bool Implements(string clsName, string ifaceName) {
        // interface-names-fqn：`InterfaceNames` / `BaseNames` 已是 FQN ⇒ 比较的另一侧也要归一。
        // 🔴 归一放在**这里**而不是让 ~20 个调用方各自传 FQN：判据只有一份，调用方传短名还是
        // FQN 都对。调用方分散改的话，漏一处就是静默失配（误报 + 漏报同时发生）。
        ifaceName = SymbolTable.IfaceFqnOf(this, ifaceName);
        // enforce-fqn-name-identity **B3**：相等判定优先走**名义身份句柄**（见 `_sameIface`）。
        int targetRef = this._refOfIface(ifaceName);
        // 待展开的接口队列（BFS）+ 去重；接口继承一般极浅，初始容量 8 足够。
        // queue 仍装**名字**：下游 `_anyInterfaceDerivesFrom` 要按名字 `GetInterface` 找定义
        // （那一段的句柄化在 A5）。
        string[] queue = new string[8];
        int qt = 0;
        int hops = 0;
        // A4：base 链走查**脱离名字** —— 入口按名字查一次，之后每跳走 `ct.Base` 句柄
        // （数组索引，零哈希）。理由见 `IsSubclassOf` 里的同款注释。
        Z42ClassType ct = this.GetClass(clsName);
        while (ct != null) {
            hops = SymbolTable.NextBaseHop(hops);
            int i = 0;
            while (i < ct.InterfaceCount) {
                if (SymbolTable._sameIface(ct.Interfaces, i, targetRef)) { return true; }
                if (qt == queue.Length) {
                    string[] bigger = new string[queue.Length * 2];
                    int z = 0; while (z < qt) { bigger[z] = queue[z]; z = z + 1; }
                    queue = bigger;
                }
                queue[qt] = ct.InterfaceNames[i]; qt = qt + 1;
                i = i + 1;
            }
            ct = this.BaseOf(ct);   // A5：收敛到唯一出口（句柄优先、未绑定才回落名字）
        }
        return this._anyInterfaceDerivesFrom(queue, qt, ifaceName);
    }

    // 接口 → 接口的继承判定（`IDerived` 是否派生自 `IBase`；不含自身）。
    // 供约束校验里「接口本身作为类型实参」的场景用。
    public bool InterfaceDerivesFrom(string ifaceName, string target) {
        // interface-names-fqn：🔴 **两个参数必须对称归一**。此前只归一 `target`、`ifaceName` 原样
        // 拿去 `this.Interfaces.Find`（**绕过双键 `GetInterface`**）—— 两处不对称各自都能静默给
        // 错答案：喂 FQN 进来时短名表 miss ⇒ 恒 false；`BaseNames` 已是 FQN 而 target 没归一 ⇒
        // 闭包里恒不相等。要么删要么补对称，留着半归一是最坏的一种。
        target = SymbolTable.IfaceFqnOf(this, target);
        Z42InterfaceType it = this.GetInterface(ifaceName);
        if (it == null) { return false; }
        string[] seeds = new string[8];
        int n = 0;
        int b = 0;
        while (b < it.BaseCount) {
            if (n == seeds.Length) {
                string[] bigger = new string[seeds.Length * 2];
                int z = 0; while (z < n) { bigger[z] = seeds[z]; z = z + 1; }
                seeds = bigger;
            }
            seeds[n] = it.BaseNames[b]; n = n + 1;
            b = b + 1;
        }
        return this._anyInterfaceDerivesFrom(seeds, n, target);
    }

    // 从 `seeds`（类的直接接口名，可含重复）出发沿父接口链 BFS，命中 target 返回 true。
    // `queue` 原地扩展兼作 seen 检查的载体——接口数极少（个位数），线性去重比建 StrMap 便宜。
    private bool _anyInterfaceDerivesFrom(string[] queue, int count, string target) {
        // B3：与 `Implements` 共用同一个句柄判定（`_sameIface`）。target 的句柄算一次。
        int targetRef = this._refOfIface(target);
        int qh = 0;
        int qt = count;
        // 无需跳数护栏：按名字去重，每个接口最多展开一次 ⇒ 队列有限（接口环在收集期已报 E0502 并断开）。
        while (qh < qt) {
            string name = queue[qh]; qh = qh + 1;
            // 线性去重：本项此前是否已出现过（含 seeds 里的重复声明）。
            bool dup = false;
            int s = 0;
            while (s < qh - 1) { if (queue[s] == name) { dup = true; break; } s = s + 1; }
            if (dup) { continue; }
            // B3/B5：队列项自身与 target 的比较走**同一个** `_sameRef`（队列装的是名字，
            // 故现查一次句柄）。B5 起不再有名字回落 —— 此前这里手写了一份「0 就比名字」的
            // 逻辑，那是同一判据的第二份实现，正是本仓反复失手的形状；现在收敛掉了。
            if (SymbolTable._sameRef(this._refOfIface(name), targetRef)) { return true; }
            // 🔴 此前是 `this.Interfaces.Find(name)` —— **绕过了 `GetInterface` 访问器**。
            // 访问器已在 fqn-symbol-key 步 1 改成双键（FQN 优先、短名回落），而这条 BFS 直接摸
            // 底层短名表 ⇒ 名字一旦变成 FQN，整条闭包就静默变浅：`Implements` 假否 ⇒
            // class→iface 报 E0402（误报）**且** 约束满足性漏检（漏报）。改走访问器后，
            // 键形态随访问器一起演进，不会再掉队。
            Z42InterfaceType it = this.GetInterface(name); if (it == null) { continue; }
            int b = 0;
            while (b < it.BaseCount) {
                if (qt == queue.Length) {
                    string[] bigger = new string[queue.Length * 2];
                    int z = 0; while (z < qt) { bigger[z] = queue[z]; z = z + 1; }
                    queue = bigger;
                }
                queue[qt] = it.BaseNames[b]; qt = qt + 1;
                b = b + 1;
            }
        }
        return false;
    }
    // ── A5b-2：类名解析的**唯一出口**，按语言的作用域规则来 ─────────────────────
    //
    // 此前 `GetClass` 只有两步：FQN 键 → 裸名表。它**完全不看作用域**，于是
    // `ResolveTypeP` 早就建立的「外围 ns 优先」规则（unify-type-identity-fqn）
    // **没有覆盖这 135 个直接调用点** —— 同短名跨 ns 时它们仍在撞裸名表的 first/last-wins 赢家。
    //
    // 现在按 `ResolveTypeP` 的同一套规则走：
    //
    //   ① 外围 ns 优先     ScopeChain[i] + "." + name —— 语言规则：enclosing ns 胜过 usings（C#：由内到外逐层）
    //   ② 调用方给的就是 FQN                          —— 实测 stdlib 全量构建里 0 次，但测试会走
    //   ③ 逐个 using（含 prelude）                    —— `ScopeUsings` ∪ `PreludeNs.All()`
    //   ④ 裸名表                                      —— ⚠️ 待删的那一支，见下
    //
    // 🔴 **`ScopeUsings` 本身不含 prelude**，而 `CuPreprocess._activeNamespaces` 含
    // （那里的注释用一次真实事故解释了为什么必须含）。两份「活跃 ns 集」此前就不一致，
    // 只是 `GetClass` 不用 `ScopeUsings` 查找所以没暴露。这里用 `PreludeNs.All()` 补齐 ——
    // 漏掉它，`Object`/`String`/`Exception` 这些免 `using` 可见的类型就全落到 ④。
    //
    // ⚠️ **④ 还不能删**：实测（A5b 测绘）①②③ 之后仍有残留。删它不会有任何一处编译报错
    // （135 个调用点全是字符串键）⇒ 只会变成静默错答案。删之前必须先把残留量到 0。
    private Z42ClassType _resolveClass(string name) {
        if (name == null) { return null; }
        int ci = 0;
        while (ci < this.ScopeChain.Length) {   // using-csharp-rules：外围链由内到外，最内层胜出
            int s = this.ClassesByFqn.Find(this.ScopeChain[ci] + "." + name);
            if (s >= 0) { return this.ClassesByFqn.ValAt(s) as Z42ClassType; }
            ci = ci + 1;
        }
        int f = this.ClassesByFqn.Find(name);
        if (f >= 0) { return this.ClassesByFqn.ValAt(f) as Z42ClassType; }
        int ui = 0;
        while (ui < this.ScopeUsingCount) {
            int uf = this.ClassesByFqn.Find(this.ScopeUsings[ui] + "." + name);
            if (uf >= 0) { return this.ClassesByFqn.ValAt(uf) as Z42ClassType; }
            ui = ui + 1;
        }
        string[] pre = PreludeNs.All();
        int pi = 0;
        while (pi < pre.Length) {
            int pf = this.ClassesByFqn.Find(pre[pi] + "." + name);
            if (pf >= 0) { return this.ClassesByFqn.ValAt(pf) as Z42ClassType; }
            pi = pi + 1;
        }
        // ④ 裸名回落 —— **A5b-2c 已删**（阶段-2 欠账 `fqn-symbol-key` 了结）。上面四步都不中 = 本作用域看不见它。
        // 删前用探针（stdlib 19 包 + 编译器 9 包全量，四个访问器各自计数）把调用方清到 **0**，历程：
        //   A5b-2a 实测 2838 次（98.7% 来自没设作用域的根表视图 + 1.3% 父 ns 引用）→ A5b-2b-3 补作用域后 17 次
        //   （导入类跨 ns 基类名）→ fix-imported-base-fqn 0 次；z42.io 另有 3614 次来自按类表逐键回查 +
        //   EmitContext 按名字走基类链 → fix-class-scan-lookup 0 次；接口侧 31 次（根表上归一本地接口名 /
        //   按短名查自己的接口声明）→ 本步改按 CU 作用域 → 0 次。
        // ⚠️ 删了不会有任何编译报错（调用点全是字符串键），漏网的调用方只会拿到 null —— 要靠探针，不能靠「删了看谁红」。
        return null;
    }

    // E0436 的消息正文（唯一一份）：文件级检查（`CuPreprocess._enforceFileScope`）与引用点（`ExprTyper` 未定义标识符 /
    // `AccessChecker` 未定义类型 —— 类型在、只是没 `using`，见下方 `MissingUsingNs`）共用。
    public static string MissingUsingMsg(string ns) {
        return "namespace `" + ns + "` is used but not imported in this file; add `using " + ns + ";`";
    }

    // 名字解析失败时：短名表里有同名类 / 接口（类型确实在、所在包也激活了，只是本文件没 `using` 它的 ns）⇒
    // 返回它的声明 ns，否则 ""。调用点据此报 E0436（与文件级那条同码同文，见上方 `MissingUsingMsg`）。
    // A5b-2c 之前这类引用被裸名回落**静默解析**、事后由文件级检查补报 E0436 @ (1,1)；回落删掉后改在引用点报。
    // 只做诊断、不参与解析（短名表赢家是 first-wins，同短名多份时只点名其中一个，足够指路）。
    public string MissingUsingNs(string name) {
        if (name == null || name == "") { return ""; }
        string n = name;
        int lt = n.IndexOf("<");
        if (lt >= 0) { n = n.Substring(0, lt); }
        if (n.IndexOf(".") >= 0) { return ""; }
        // 本作用域解析得到 ⇒ 不是「缺 using」（调用方在别的原因上失败了，比如把类名当值用）——别指路去 using 本来就可见的 ns。
        if (this.HasClass(n) || this.HasInterface(n)) { return ""; }
        string ns = "";
        Z42ClassType c = this.Classes.Get(n) as Z42ClassType;
        if (c != null) { ns = c.Namespace; }
        else {
            Z42InterfaceType it = this.Interfaces.Get(n) as Z42InterfaceType;
            if (it != null) { ns = it.Namespace; }
        }
        if (ns == null) { return ""; }
        if (ns == "") { ns = SymbolTable._declNsOf(this.EnumTypeNs, n); }
        if (ns == "") { ns = SymbolTable._declNsOf(this.DelegateNs, n); }
        return ns;
    }

    // FQN 键的表（值 = 声明 ns 的 StrBox）里，短名为 n 的那一项的声明 ns；没有则 ""。只供诊断指路。
    // 同短名多份时取字典序最小的 ns（`Keys()` 不保证顺序，诊断文本要确定）。
    private static string _declNsOf(StrMap nsByFqn, string n) {
        string[] ks = nsByFqn.Keys();
        string best = "";
        int i = 0;
        while (i < ks.Length) {
            StrBox b = nsByFqn.Get(ks[i]) as StrBox;
            if (b != null && b.Value != "" && ks[i] == b.Value + "." + n) {
                if (best == "" || b.Value.CompareTo(best) < 0) { best = b.Value; }
            }
            i = i + 1;
        }
        return best;
    }

    // enum / delegate 名 → 表键（FQN），查不到返回 null。与 `_resolveClass` 同一套作用域规则
    // （外围链 → FQN → using → prelude，无裸名回落）。此前这两张表按**短名**做键、按短名直接查 ⇒ 同包两个 ns
    // 各声明一个 `Color`（或 `Op`）时只剩一份：enum 的声明 ns 后写者赢、常量按 `Color.Member` 混在一起，
    // delegate 先写者赢；跨 ns 引用不写 `using` 也解析得到。
    public string EnumKey(string name) { return this._scopedKey(this.EnumTypes, this.EnumShortNames, name); }
    public string DelegateKey(string name) { return this._scopedKey(this.Delegates, this.DelegateShortNames, name); }

    // 登记一个 enum / delegate 表键（FQN）的短名，供上面两个查找快速否决。表本身的 Put 仍由调用方做。
    public void NoteEnumKey(string key) { this.EnumShortNames.Put(SymbolTable._lastSeg(key), "1"); }
    public void NoteDelegateKey(string key) { this.DelegateShortNames.Put(SymbolTable._lastSeg(key), "1"); }

    private static string _lastSeg(string s) {
        int dot = s.LastIndexOf(".");
        return dot < 0 ? s : s.Substring(dot + 1, s.Length - dot - 1);
    }

    private string _scopedKey(StrMap m, StrMap shorts, string name) {
        if (name == null || name == "") { return null; }
        if (!shorts.ContainsKey(SymbolTable._lastSeg(name))) { return null; }   // 没有任何 enum / delegate 叫这个短名
        int ci = 0;
        while (ci < this.ScopeChain.Length) {
            string ck = this.ScopeChain[ci] + "." + name;
            if (m.ContainsKey(ck)) { return ck; }
            ci = ci + 1;
        }
        if (m.ContainsKey(name)) { return name; }
        int ui = 0;
        while (ui < this.ScopeUsingCount) {
            string uk = this.ScopeUsings[ui] + "." + name;
            if (m.ContainsKey(uk)) { return uk; }
            ui = ui + 1;
        }
        string[] pre = PreludeNs.All();
        int pi = 0;
        while (pi < pre.Length) {
            string pk = pre[pi] + "." + name;
            if (m.ContainsKey(pk)) { return pk; }
            pi = pi + 1;
        }
        return null;
    }

    // 接口名 → 接口。与 `_resolveClass` 逐步同构（A5b-2c 之前接口这一侧只有「FQN → 裸名表」两步）。
    private Z42InterfaceType _resolveIface(string name) {
        if (name == null) { return null; }
        int ci = 0;
        while (ci < this.ScopeChain.Length) {
            int s = this.InterfacesByFqn.Find(this.ScopeChain[ci] + "." + name);
            if (s >= 0) { return this.InterfacesByFqn.ValAt(s) as Z42InterfaceType; }
            ci = ci + 1;
        }
        int f = this.InterfacesByFqn.Find(name);
        if (f >= 0) { return this.InterfacesByFqn.ValAt(f) as Z42InterfaceType; }
        int ui = 0;
        while (ui < this.ScopeUsingCount) {
            int uf = this.InterfacesByFqn.Find(this.ScopeUsings[ui] + "." + name);
            if (uf >= 0) { return this.InterfacesByFqn.ValAt(uf) as Z42InterfaceType; }
            ui = ui + 1;
        }
        string[] pre = PreludeNs.All();
        int pi = 0;
        while (pi < pre.Length) {
            int pf = this.InterfacesByFqn.Find(pre[pi] + "." + name);
            if (pf >= 0) { return this.InterfacesByFqn.ValAt(pf) as Z42InterfaceType; }
            pi = pi + 1;
        }
        return null;   // 无裸名回落（同 `_resolveClass` ④）
    }

    // 类名 → 类型。**双键过渡形态**：这笔阶段-2 欠账登记在 `HasClass` 抬头（同一笔，不重复挂标记）。
    // A5b-2 起转发到 `_resolveClass`（作用域感知）—— 实测全量 `build stdlib` 与旧实现**零分歧**。
    public Z42ClassType  GetClass(string name) { return this._resolveClass(name); }
    public bool          HasConstraints(string name) { return this.ClassConstraints.ContainsKey(name); }
    public ConstraintSet GetConstraints(string name) { return this.ClassConstraints.Get(name) as ConstraintSet; }
    public bool          HasIfaceConstraints(string name) { return this.InterfaceConstraints.ContainsKey(name); }
    public ConstraintSet GetIfaceConstraints(string name) { return this.InterfaceConstraints.Get(name) as ConstraintSet; }

    // ClassConstraints 的**唯一**键推导（add-associated-types PR-1）。写入侧（ConstraintChecker.Resolve）、
    // 查询侧（ConstraintChecker.Check）、导入侧（ImportedSymbolLoader seed）三处都必须经过这里。
    //
    // 规则与 `Classes` 完全一致（条件 arity-mangle：同短名多 arity 才带 `$N`）。实现方式是**探测
    // `Classes` 里实际存的是哪一种键**——StubCollector（本地）/ ImportedSymbolLoader（导入）已二选一
    // 地登记过，探测即复现其判定，无需把 multiArityMap 传进来，也就不会与它们漂移。
    //
    // 修前三套规则并存：`Classes` 条件 mangle、`ClassConstraints` 恒裸名、查询侧恒裸名（`inst.Def.Name()`）。
    // 写入与查询恰好都用裸名，故本包能跑；但同短名多 arity 的泛型类（`Foo<T>` / `Foo<T,U>`）其约束在
    // ClassConstraints 里**last-wins 互相覆盖** —— `Foo<Widget>` 可能被拿去校验 `Foo<T,U>` 的约束。
    // 且导入侧一旦接进来，`Name$N` 与裸名直接对不上，跨包约束全部落空。
    public string ConstraintKey(string bareName, int tpCount) {
        if (tpCount > 0) {
            string mangled = bareName + "$" + tpCount.ToString();
            if (this.Classes.ContainsKey(mangled)) { return mangled; }
        }
        return bareName;
    }

    // sub 是否为 baseName 的子类（含自身）。走 base 链（迭代——self-type 字段不可递归调本类方法）。
    // enforce-fqn-name-identity **B4**：沿 base 链的相等判定走**名义身份句柄**（`_sameRef`）。
    //
    // 🔴 0（未绑定）不参与判定 —— 同 B3：目标与某一层基类都绑不到时 `0 == 0` 会撞成假阳性，
    // 而「绑不到」是合法状态（跨包基类可能不可见）。两边都有句柄才比句柄，否则退回名字。
    //
    // 🔴🔴 **本函数的答案会变，那是修复不是回归**（实测；别照抄 B3 那句「行为逐字不变」）：
    // `BaseName` **从不经过归一 pass** —— `_passQualifyIfaceNames` 只归一接口那两根轴 ——
    // 所以它存的是**源码里写的短名**。于是修前拿 FQN 去查会一路比不中：
    //
    //     namespace Demo; class A { } class B : A { }
    //     IsSubclassOf("B", "A")       → true     （短名对短名，碰巧相等）
    //     IsSubclassOf("B", "Demo.A")  → **false**（"A" != "Demo.A"，一直走到链尾）
    //
    // 同一个继承关系，换个拼写就答错 —— 与 B2 那两条「导入边界剥 ns」同族的静默错值。
    // 句柄化后两种拼写解析到同一个 id ⇒ 都答 true。
    // ⇒ **输出会变**（实测 stdlib 有包字节变化）⇒ 按 version-bumping 要累加指纹。
    //
    // ⚠️ **只有比较走句柄，查找仍走名字**（`GetClass(cur)`）：句柄没有「按 id 取下一层」的路径，
    // 那要等 `Base` 成为唯一真相（B5）之后。
    public bool IsSubclassOf(string sub, string baseName) {
        if (sub == baseName) { return true; }
        int targetRef = this._refOfClass(baseName);
        // ── A4：base 链走查**脱离名字** ────────────────────────────────────────
        //
        // 此前每跳一层都 `GetClass(cur)` 一次 —— 那是一次 FNV-1a over UTF-8 的字符串哈希
        // （`__str_hash_code` **O(n)、每次重算、无缓存**，profile 里 `GetHashCode` 自占 1.93%）。
        // 而 `ct.Base` 自 B4 起**已经是句柄** ⇒ 下一层直接 `Intern.At(id)` 拿到，
        // 那是一次数组索引，零哈希。
        //
        // 只有**入口**那一次还要按名字查（调用方给的是名字）；链上每一跳都走句柄。
        // ⚠️ `Base` 为 0（未绑定）时仍需回落到名字 —— 那是合法状态（跨包基类不可见），
        // 且 A 轴尚未收口（`Resolve` 入口还没建），此处保留直到 A5。
        Z42ClassType ct = this.GetClass(sub);
        int hops = 0;
        while (ct != null) {
            hops = SymbolTable.NextBaseHop(hops);
            if (!ct.HasBase) { return false; }
            if (SymbolTable._sameRef(ct.Base, targetRef)) { return true; }
            ct = this.BaseOf(ct);   // A5：收敛到唯一出口
        }
        return false;
    }

    // 对象版：两侧**已经解析成名义类型**时用它（`Conversion` 的 class→class 判定）。
    //
    // 🔴 名字版在这里是错的：调用方手里明明是对象，却传 `to.Name()`（**短名**）回去，`_refOfClass` 再按
    // **调用点作用域**把短名解析一遍 —— 本地有同短名类时就解析成本地那个。实测（enforce-fqn-name-identity，
    // 导入元数据带上 FQ 基类名之后）：本地 `Demo.App.Base` 与导入 `Demo.Lib.Core.Base` 并存时，
    // `Demo.Lib.Core.Base b = new Derived();` 误报 E0402（目标被解析成本地 `Base`）。
    // 修前这条恰好不报，是**两个错抵消**：导入 `Derived` 的基类句柄也被裸名表绑成了本地 `Base`。
    // 同理 `sub == baseName` 的短名捷径会把两个同短名的不同类判成「是自身」。
    public bool IsSubclassOfType(Z42ClassType sub, Z42ClassType target) {
        if (sub == null || target == null) { return false; }
        if (sub == target) { return true; }
        // 只读已有句柄、不 `Intern.Of`：目标没登记过 ⇒ 不可能是谁的已绑基类（`Base` 只指向已登记对象），
        // 而临时造的类型对象（`Z42ClassType.Enum(name)` 每次一份）不该被这里塞进 intern 表。
        int targetRef = target.TypeId;
        Z42ClassType ct = sub;
        int hops = 0;
        while (ct != null) {
            hops = SymbolTable.NextBaseHop(hops);
            if (!ct.HasBase) { return false; }
            if (SymbolTable._sameRef(ct.Base, targetRef)) { return true; }
            ct = this.BaseOf(ct);
            if (ct == target) { return true; }   // `Base` 未绑（0）时 `BaseOf` 按名字回落取到的同一对象
        }
        return false;
    }

    // ── A5：「取下一层基类」的**唯一出口** ──────────────────────────────────────
    //
    // 全仓有 16 处 `GetClass(x.BaseName)` 在做同一件事：沿 base 链往上走一层。每一处都是
    // 一次 FNV-1a over UTF-8 的字符串哈希（`__str_hash_code` **O(n)、每次重算、无缓存**，
    // profile 里 `GetHashCode` 自占 1.93%）—— 而 `ct.Base` 自 B4 起**已经是句柄**，
    // 取下一层只需一次数组索引。
    //
    // 收敛成一个出口而不是在 16 处各改一遍：同一判据多份实现正是本仓反复失手的形状
    // （`InterfaceKeyOf` 那次「只修一份反而从误报升级成运行期崩」）。往后 `Base` 的语义
    // 再演进（A5 收口、B5 删字符串），只动这里。
    //
    // ⚠️ 清扫**必须从全仓 grep 起**，别凭记忆枚举目录：第一刀只迁了 13 处，
    // `ClassExtractor` / `DeclBinder` / `ForeachProtocol` 三处是回头 grep 才抓到的
    // （变量名不叫 `ct`，眼睛扫不出来）。判据 = `grep -E "(GetClass|HasClass)\([^)]*BaseName"`
    // 只应剩两处：`Origins` 里那个**门的判据**（刻意按名字查，用来发现「查得到却没绑」的矛盾）
    // 和本函数自己的回落。
    // ⚠️ A5b-2b-3 又抓到 **15 处**：`table.Classes.Get/ContainsKey(x.BaseName)` 直接读短名表，上面的 grep
    // 不匹配（InheritanceResolver 的虚方法溯源 / override 修正 / sealed 检查 / 桥接标记 + CtorInheritance）。
    // 判据补一条：`grep -E "Classes\.(Get|ContainsKey|Find)\([^)]*BaseName"` 应为 0。
    //
    // 返回 null = 没有基类，或基类不可见（跨包）。
    // ⚠️ `Base == 0` 时回落到名字：那是**合法**状态（跨包基类不可见 / 尚未绑定），
    // 不是错误。这条回落要等 `Resolve` 入口建成后才能收掉。
    public Z42ClassType BaseOf(Z42ClassType ct) {
        if (ct == null) { return null; }
        if (!ct.HasBase) { return null; }
        if (ct.Base != 0) { return this.Intern.At(ct.Base) as Z42ClassType; }   // 零哈希
        if (ct.BaseName == null || ct.BaseName == "") { return null; }
        return this.GetClass(ct.BaseName);
    }

    // 基类链走查的**跳数护栏**（全部沿 base 链走的循环共用）。合法的链没有层数上限：继承环在收集期就报
    // E0502 并断开（`SymbolCollector._passRejectBaseCycles`），之后链必然有限。所以走到这么多跳只可能是
    // 编译器内部错误（某条没断的环 / 名字回落绕回自身）⇒ 抛错。不要换回「到上限就当链到头」——那正是
    // 深于 32 层的类层次静默丢继承成员、误报 E0402 的来源。
    public static int NextBaseHop(int hops) {
        if (hops >= 100000) {
            throw new Exception("z42c internal: base-class chain walk exceeded 100000 hops — an inheritance cycle was not broken");
        }
        return hops + 1;
    }
}
