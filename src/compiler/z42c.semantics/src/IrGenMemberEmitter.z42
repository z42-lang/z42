// 类成员 → IR 函数（refactor-split-irgen-generate，自 IrGen.Generate 提出；逻辑逐字保留）：
// 方法（有体 / extern 桩 / abstract 桩）、属性（计算 getter / extern getter / auto-prop get·set 桩）、索引器（get_Item / set_Item）。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;

public sealed class IrGenMemberEmitter {
    private IrGen _g;
    private SemanticModel _model;
    private IrGenSink _out;

    public IrGenMemberEmitter(IrGen g, SemanticModel model, IrGenSink sink) { this._g = g; this._model = model; this._out = sink; }

    // 方法：GS3 重载键 Name$arity / unique 裸名；HasBody → 编译体；extern → builtin 桩；实例 abstract → signature-only 桩。
    // generic-struct-erased-slot-value-copy：成员 IR 名的 owner 前缀。特化通道下换成**实例化名**
    // （`Demo.GBox<int>.get_Tag`），调用点按同一规则派发。
    //
    // 抽成助手是因为「按 owner 名拼成员名」在本文件里出现 **8 次**（方法 / 属性 getter+setter /
    // native 桩 / 静态 backing / 索引器 get+set）。我先只改了方法那处，属性就漏了 ⇒ 调用点派发到
    // `GBox<int>.get_Tag` 而它根本没发射（`MissingSymbolException`）。同一形状分散在多处时，
    // 逐个改必漏——收敛到一个出口。
    private string _irOwner(ClassDecl c) {
        IrGen g = this._g;
        return g._q(g.SpecInstName != "" ? g.SpecInstName : g._classIrShortName(c));
    }

    public void EmitMethod(ClassDecl c, Z42ClassType owner, string ownerKey, Decl rawMem, MethodDecl md) {
        IrGen g = this._g; SemanticModel model = this._model;
        string methKey = OverloadResolver.MethodKeyOf(md);   // unify-regkey-source-of-truth
        // add-static-constructors：静态 ctor 的**发射名**换独立键——它与**实例** ctor 同名，
        // 不换就会和实例 ctor 争同一个 IR 函数名，`new C()` 会把它当实例构造器再跑一遍
        // （实测 cctor 体打印两次）。见 IrStaticCtor.MethodKey。调用侧选 ctor 时同样要排除它，
        // 见 `Z42ClassType.InstanceCtors`（fix-ctor-init-silent-bugs）。
        //
        // ⚠️ 只改**发射名**，不能改 methKey —— 后者还用作 SemanticModel 的**体查找键**
        // （body 是按 RegKey 存的）。两者一起改会让 model.HasBody 落空 → 函数根本不发射
        // （实测：报 `static ctor C.$cctor not found`）。
        string emitKey = methKey;
        if (md.IsCtor && IrGenFacts._hasWord(md.Mods, "static")) { emitKey = IrStaticCtor.MethodKey; }
        // add-iface-return-bridge：实现了接口成员、但返回 **blob struct** 而接口声明返回引用型 ⇒
        // 两侧 ABI 不一致（sret 多一个隐藏物理参）。让**桥接**占裸名 vtable 槽（接口派发按方法名
        // 索引，见 CallEmitter「VCall 按 vtable slot(方法名)派发」），具体实现挪到 `<m>$struct`。
        // 直接调用点无需改：它们发的就是这个发射名。同 L1 先例——**只改发射名，methKey 不动**。
        string bridgeRet = this._ifaceBridgeRet(owner, methKey, md);
        if (bridgeRet != "") { emitKey = methKey + "$struct"; }
        string irName = this._irOwner(c) + "." + emitKey;   // IR/包内名（FQ，arity-mangle 时 Name$N；特化时为实例化名）
        if (md.HasBody) {              // G11：ctor 也发 `<qualClass>.<Class>` 函数（md.Name=类名，ret void，实例）
            string key = ownerKey + "." + methKey;    // SemanticModel 键（arity-mangle 时 ownerKey=Name$N）
            if (model.HasBody(key)) {
                bool isStaticMethod = IrGenFacts._hasWord(md.Mods, "static");
                bool isInstance = !isStaticMethod;   // 实例方法有 this；静态方法无
                var fe = new FunctionEmitter(model.Symbols, g);
                IrFunction irf = fe.EmitFunction(irName, md, model.GetBody(key), isInstance, isStaticMethod,
                                                 owner, c.TypeParams.Names, c.TypeParams.Count);
                irf.Attrs = g._classDescB._attrRefs(rawMem); irf.AttrCount = irf.Attrs.Length;   // add-attribute-reflection
                irf.ParamAttrs = g._classDescB._paramAttrRefs(md, isInstance); irf.ParamAttrsLen = irf.ParamAttrs.Length;
                irf.Visibility = IrGenFacts._visCode(md.Mods, 1);   // add-member-visibility（成员默认 private）
                irf.MethodFlags = irf.MethodFlags | IrGenFacts._methodFlags(md.Mods);   // 或：保住 FunctionEmitter 置的 sret 位   // add-method-modifiers
                IrGenFacts._fillParamMeta(irf, md, isInstance);       // add-param-metadata
                this._out.AddFunc(irf);
                // add-iface-return-bridge：具体实现已挪到 `<m>$struct`（irName），裸名槽腾出来了 ⇒
                // 合成桥接补上它，否则接口派发找不到该方法（把「arity 失配」换成「方法不存在」，
                // 半个修复比不修更坏）。
                if (bridgeRet != "") {
                    MethodSymbol bms = owner.Methods.Get(methKey) as MethodSymbol;
                    var bsyn = new IfaceBridgeSynth(model.Symbols, g);
                    // 必须先 CanBridge：blob 名由它解出（与 CallEmitter 同源），EmitBridge 直接用。
                    if (bsyn.CanBridge(bms.Signature.Ret)) {
                        IrFunction bridge = bsyn.EmitBridge(this._irOwner(c) + "." + methKey, irName,
                                                            bridgeRet, owner);
                        this._out.AddFunc(bridge);
                    }
                }
            }
        } else if (IrGenFacts._hasWord(md.Mods, "extern")) {
            // legacy [Native("__name")] extern → 发 builtin 桩函数（镜像 C# EmitNativeStub）。
            string nat = g._stubE._nativeIntrinsic(rawMem);
            if (nat != "") {
                bool natStatic = IrGenFacts._hasWord(md.Mods, "static");
                IrFunction stub = g._stubE._emitNativeStub(irName, md, nat, natStatic, rawMem);
                // carry-null-marks-through-native-stubs：extern 桩此前**不写 attr-ref 块** ⇒ 源码里
                // 已经标了的 `?`（`Environment.GetEnvironmentVariable` 等 9 处）过了包边界就静默消失：
                // 跨包调用方拿不到 `$RetNullable` / `$Nullable` 哨兵，标记位落成 false。
                // 两行与 **abstract 桩**那一支逐字同源 —— 这条分支历来是「每来一个特性就补一次」
                // （上一行 visibility 的「此前漏设」就是同一个坑），故这次敲成与它们**对齐**而非只补可空位。
                // 实测：extern 声明里 `ref` 形参 0 处、默认值 0 处 ⇒ 顺带的 `$RefSig`/`$Default`
                // 哨兵均为空转；`[Native(…)]` 无 FactoryFunc，被 `_attrRefsFromList` 滤掉，不进产物。
                stub.Attrs = g._classDescB._attrRefs(rawMem); stub.AttrCount = stub.Attrs.Length;
                stub.ParamAttrs = g._classDescB._paramAttrRefs(md, !natStatic); stub.ParamAttrsLen = stub.ParamAttrs.Length;
                stub.Visibility = IrGenFacts._visCode(md.Mods, 1);      // add-member-visibility：extern 桩此前漏设
                stub.MethodFlags = IrGenFacts._methodFlags(md.Mods); // add-method-modifiers：virtual extern
                IrGenFacts._fillParamMeta(stub, md, !natStatic);   // add-param-metadata
                this._out.AddFunc(stub);
            }
        } else if (IrGenFacts._hasWord(md.Mods, "abstract") && !IrGenFacts._hasWord(md.Mods, "static")) {
            // add-method-modifiers（unify P1-c）：实例 abstract 方法无 body → signature-only 死体桩，进 SIGS/FUNC 使反射可见。
            IrFunction astub = g._stubE._emitAbstractStub(irName, md);
            astub.Attrs = g._classDescB._attrRefs(rawMem); astub.AttrCount = astub.Attrs.Length;
            astub.ParamAttrs = g._classDescB._paramAttrRefs(md, true); astub.ParamAttrsLen = astub.ParamAttrs.Length;
            astub.Visibility = IrGenFacts._visCode(md.Mods, 1);
            astub.MethodFlags = IrGenFacts._methodFlags(md.Mods);
            IrGenFacts._fillParamMeta(astub, md, true);   // add-param-metadata：abstract 恒实例
            this._out.AddFunc(astub);
        }
    }

    // 属性：计算 getter（HasGetBody）→ 真实 get_X；extern getter → builtin 桩；auto-prop → field.get/set @__prop_X 桩。
    public void EmitProperty(ClassDecl c, Z42ClassType owner, Decl rawMem, PropertyDecl pd) {
        IrGen g = this._g; SemanticModel model = this._model;
        bool pdExtern = IrGenFacts._hasWord(pd.Mods, "extern");
        bool pdStatic = IrGenFacts._hasWord(pd.Mods, "static");
        // add-accessor-visibility：访问器可见性进 IR（供反射 + 跨包访问控制）。此前 auto-prop / 计算体
        // accessor 一律不设 .Visibility → 默认 0=public，连属性级 private/protected 都丢、`private set` 更丢。
        // 访问器级修饰符（GetMods/SetMods）覆盖属性级，空则回落属性级（_visCode 对空 mods 回落 dflt）。
        int pdPropVis = IrGenFacts._visCode(pd.Mods, 1);
        int pdGetVis = IrGenFacts._visCode(pd.GetMods, pdPropVis);
        int pdSetVis = IrGenFacts._visCode(pd.SetMods, pdPropVis);
        if (pd.HasGetBody) {
            string pgKey = c.Name + ".get_" + pd.Name;
            string pgIrName = this._irOwner(c) + ".get_" + pd.Name;
            if (model.HasBody(pgKey)) {
                TypeParamList emptyTpPg = new TypeParamList(new string[0], 0, pd.Span);
                MethodDecl synthPg = new MethodDecl("", false, false, pd.Type, "get_" + pd.Name,
                                                     emptyTpPg, new WhereClause[0], 0,
                                                     new Param[0], 0, true, pd.GetBody, new Expr[0], 0, false, pd.Span);
                var fePg = new FunctionEmitter(model.Symbols, g);
                IrFunction pgIrf = fePg.EmitFunction(pgIrName, synthPg, model.GetBody(pgKey),
                                                      !pdStatic, pdStatic, owner, c.TypeParams.Names, c.TypeParams.Count);
                IrGenFacts._fillParamMeta(pgIrf, synthPg, !pdStatic);   // add-param-metadata（reconcile 补齐）
                pgIrf.Visibility = pdGetVis;   // add-accessor-visibility（synthPg.Mods 为空，须显式覆盖）
                this._out.AddFunc(pgIrf);
            }
        } else if (pd.HasGet && pdExtern) {
            string nat2 = g._stubE._nativeIntrinsic(rawMem);
            if (nat2 != "") {
                TypeParamList emptyTpP = new TypeParamList(new string[0], 0, pd.Span);
                MethodDecl synthPd = new MethodDecl("", false, false, pd.Type, "get_" + pd.Name,
                                                     emptyTpP, new WhereClause[0], 0,
                                                     new Param[0], 0, false, null, new Expr[0], 0, false, pd.Span);
                IrFunction pstub = g._stubE._emitNativeStub(this._irOwner(c) + ".get_" + pd.Name,
                                                         synthPd, nat2, pdStatic, rawMem);
                IrGenFacts._fillParamMeta(pstub, synthPd, !pdStatic);   // add-param-metadata（reconcile 补齐）
                pstub.Visibility = pdGetVis;   // add-accessor-visibility
                this._out.AddFunc(pstub);
            }
        } else if (pd.HasGet && !pdExtern) {
            // 非 extern auto-prop：合成 field.get @__prop_Name 桩（镜像 C# SynthesizeClassAutoProp）。
            string backing = "__prop_" + pd.Name;
            // add-static-properties：静态后备是静态字段 → 桩发 static_get/set，须 FQ 名（同 __static_init__ 的 StaticSet）。
            if (pdStatic) { backing = this._irOwner(c) + "." + backing; }
            string getIrNm = this._irOwner(c) + ".get_" + pd.Name;
            string retNm = g._classDescB._typeFieldName(pd.Type);
            int retTag = IrGenFacts._irTypeTag(pd.Type);
            IrFunction ag = g._stubE._emitAutoPropGetter(getIrNm, backing, retNm, retTag, pdStatic, pd.Span.Line);
            ag.MinArg = 0;   // getter 逻辑参数 0（reconcile：ctor 默认=含 this 总数，需覆盖）
            ag.Visibility = pdGetVis;   // add-accessor-visibility
            this._out.AddFunc(ag);
            if (pd.HasSet) {
                string setIrNm = this._irOwner(c) + ".set_" + pd.Name;
                IrFunction sg = g._stubE._emitAutoPropSetter(setIrNm, backing, retNm, retTag, pdStatic, pd.Span.Line);
                sg.MinArg = 1;   // setter 逻辑参数 1
                sg.Visibility = pdSetVis;   // add-accessor-visibility（`private set` 等）
                this._out.AddFunc(sg);
            }
        }
        // add-property-custom-setter：自定义 setter（HasSetBody）→ 真实 set_X（镜像上面计算 getter + 索引器 set_Item）。
        // 独立于 getter 分支：`{ get {} set {} }` 时 HasGetBody 走首分支、auto 链跳过，故 set_X 须在链外单发。
        // 隐式 value 参（属性类型）、void 返回。混合已由 parser E0474 挡下，此处只见「两半都带体」。
        if (pd.HasSetBody) {
            string psKey = c.Name + ".set_" + pd.Name;
            string psIrName = this._irOwner(c) + ".set_" + pd.Name;
            if (model.HasBody(psKey)) {
                TypeParamList emptyTpPs = new TypeParamList(new string[0], 0, pd.Span);
                TypeExpr voidRetP = new NamedType("void", new TypeExpr[0], 0, pd.Span);
                Param[] setPsP = new Param[1];
                setPsP[0] = new Param(pd.Type, "value", pd.Span);
                MethodDecl synthPs = new MethodDecl("", false, false, voidRetP, "set_" + pd.Name,
                                                     emptyTpPs, new WhereClause[0], 0,
                                                     setPsP, 1, true, pd.SetBody, new Expr[0], 0, false, pd.Span);
                var fePs = new FunctionEmitter(model.Symbols, g);
                IrFunction psIrf = fePs.EmitFunction(psIrName, synthPs, model.GetBody(psKey),
                                                      !pdStatic, pdStatic, owner, c.TypeParams.Names, c.TypeParams.Count);
                IrGenFacts._fillParamMeta(psIrf, synthPs, !pdStatic);   // add-param-metadata（reconcile 补齐）
                psIrf.Visibility = pdSetVis;   // add-accessor-visibility（synthPs.Mods 为空，须显式覆盖）
                this._out.AddFunc(psIrf);
            }
        }
    }

    // 索引器 → get_Item / set_Item 编译函数（镜像 C# IndexerDecl lowering）。
    public void EmitIndexer(ClassDecl c, Z42ClassType owner, IndexerDecl idx) {
        IrGen g = this._g; SemanticModel model = this._model;
        TypeParamList emptyTpI = new TypeParamList(new string[0], 0, idx.Span);
        TypeExpr voidRet = new NamedType("void", new TypeExpr[0], 0, idx.Span);
        if (idx.HasGet) {
            string getKey = c.Name + ".get_Item";
            string getIrName = this._irOwner(c) + ".get_Item";
            if (model.HasBody(getKey)) {
                MethodDecl synthGet = new MethodDecl("", false, false, idx.RetType, "get_Item",
                                                      emptyTpI, new WhereClause[0], 0,
                                                      idx.Params, idx.ParamCount, true, idx.GetBody, new Expr[0], 0, false, idx.Span);
                var feGet = new FunctionEmitter(model.Symbols, g);
                IrFunction getIrf = feGet.EmitFunction(getIrName, synthGet, model.GetBody(getKey),
                                                        true, false, owner, c.TypeParams.Names, c.TypeParams.Count);
                IrGenFacts._fillParamMeta(getIrf, synthGet, true);   // add-param-metadata（reconcile 补齐）
                this._out.AddFunc(getIrf);
            }
        }
        if (idx.HasSet) {
            string setKey = c.Name + ".set_Item";
            string setIrName = this._irOwner(c) + ".set_Item";
            if (model.HasBody(setKey)) {
                Param[] setPs = new Param[idx.ParamCount + 1];
                int spi = 0;
                while (spi < idx.ParamCount) { setPs[spi] = idx.Params[spi]; spi = spi + 1; }
                setPs[idx.ParamCount] = new Param(idx.RetType, "value", idx.Span);
                MethodDecl synthSet = new MethodDecl("", false, false, voidRet, "set_Item",
                                                      emptyTpI, new WhereClause[0], 0,
                                                      setPs, idx.ParamCount + 1, true, idx.SetBody, new Expr[0], 0, false, idx.Span);
                var feSet = new FunctionEmitter(model.Symbols, g);
                IrFunction setIrf = feSet.EmitFunction(setIrName, synthSet, model.GetBody(setKey),
                                                        true, false, owner, c.TypeParams.Names, c.TypeParams.Count);
                IrGenFacts._fillParamMeta(setIrf, synthSet, true);   // add-param-metadata（reconcile 补齐）
                this._out.AddFunc(setIrf);
            }
        }
    }

    // add-iface-return-bridge：本方法要不要桥接 ⇒ 返回接口声明的返回类型名；否则 ""。
    //
    // 两道判据缺一不可：
    //   ① **符号层标记**（`InheritanceResolver` 打的 `IfaceBridgeRet`）—— 说明它确实实现了某个
    //      接口成员、且实现返回值类型而接口声明返回引用型；
    //   ② **发射层 blob 判定**（`Layouts.IsBlobStruct`）—— 只有 blob struct 才走 sret、才有 ABI 差。
    //      标量 repr 的 struct（展平叶子 < 2）是自描述 Value，经接口返回今天本来就对
    //      （实测 `V=70 / Tag=One / is IThing=true`），**桥接它反而是回归**。
    // 判据分两层正是因为 ①在继承解析期就知道、而②要等布局算得出来。
    private string _ifaceBridgeRet(Z42ClassType owner, string methKey, MethodDecl md) {
        if (owner == null || md.IsCtor) { return ""; }
        if (!owner.Methods.ContainsKey(methKey)) { return ""; }
        MethodSymbol ms = owner.Methods.Get(methKey) as MethodSymbol;
        if (ms == null) { return ""; }
        // ② 子类 `override` 的标记由 `InheritanceResolver._propagateBridgeMarks` **下推到符号上**，
        // 这里只读符号 —— 不在发射期再上溯一次基链：那会变成同一判据的第二份实现，而且
        // `MethodSymbol.CallKey()`（调用点目标名）读的就是符号字段，两处不一致就会「发射改了名、
        // 调用点没改」。判据只留一份。
        string bridgeRet = ms.IfaceBridgeRet;
        if (bridgeRet == "") { return ""; }
        if (ms.Signature == null || ms.Signature.Ret == null) { return ""; }
        // ③ 布局名算得出来才动手——`CanBridge` 兼了 blob 判定与「能否可靠算出 blob 名/尺寸」。
        // 算不出（泛型实例化返回类型）就**整条不改名不合成**，保持现状而不是发错布局名的桥接。
        var bs = new IfaceBridgeSynth(this._model.Symbols, this._g);
        if (!bs.CanBridge(ms.Signature.Ret)) { return ""; }
        return bridgeRet;
    }

}
