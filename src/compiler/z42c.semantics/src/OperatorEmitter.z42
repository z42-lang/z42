// binary / unary / compare / short-circuit / null-coalesce / conditional / switch-expr lowering
// （CG-1E follow-up：从 ExprEmitter 按职责抽出）。承载 Bound{Binary,Unary,Conditional,SwitchExpr}
// → IR 的运算/控制流表达式发射簇（含短路 &&/||/??、struct == 值相等）。共享 EmitContext
// （与 ExprEmitter 同一 ctx）；递归 .Emit()、struct 谓词与 struct 相等发射经父反向引用 _ee 委回。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;
using Z42.IR.BinaryFormat;

public sealed class OperatorEmitter {
    private EmitContext _ctx;
    private ExprEmitter _ee;   // 反向引用：递归 .Emit() + struct 谓词/相等发射委回 ExprEmitter

    public OperatorEmitter(EmitContext ctx, ExprEmitter ee) { this._ctx = ctx; this._ee = ee; }

    // 二元运算：逻辑短路 &&·‖·?? 先拦截（操作数条件求值，不能预先 Emit 两侧）；
    // 否则算术 + − × ÷ % / 比较 / 位 / 字符串拼接。
    internal TypedReg _emitBinary(BoundBinary b) {
        string sop = b.Op;
        if (sop == "&&") { return this._emitShortCircuit(b, true); }
        if (sop == "||") { return this._emitShortCircuit(b, false); }
        TypedReg a = this._ee.Emit(b.Left);
        TypedReg c = this._ee.Emit(b.Right);
        string op = b.Op;
        if (op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=") {
            // add-struct-value-equality：两操作数均 blob 值 struct 的 ==/!= → 逐叶子值相等（脱糖，非句柄身份）。
            if ((op == "==" || op == "!=") && this._ee._isBlobStruct(b.Left.Type()) && this._ee._isBlobStruct(b.Right.Type())) {
                return this._emitStructEquality(op == "==", a, c, this._ee._blobStructName(b.Left.Type()));
            }
            // add-record-value-semantics：record-class（引用）的 ==/!= → 值 Equals 脱糖（null-safe，非句柄身份）。
            if ((op == "==" || op == "!=") && this._isRecordClass(b.Left.Type())) {
                return this._emitRecordEquality(op == "==", a, c);
            }
            return this._emitCompare(op, a, c);   // → bool
        }
        TypedReg d = this._ctx.Alloc(this._ctx.ToIrType(b.Type()));
        if (op == "-") { this._ctx.Emit(new SubInstr(d, a, c)); }
        else if (op == "*") { this._ctx.Emit(new MulInstr(d, a, c)); }
        else if (op == "/") { this._ctx.Emit(new DivInstr(d, a, c)); }
        else if (op == "%") { this._ctx.Emit(new RemInstr(d, a, c)); }
        else if (op == "&") { this._ctx.Emit(new BitAndInstr(d, a, c)); }
        else if (op == "|") { this._ctx.Emit(new BitOrInstr(d, a, c)); }
        else if (op == "^") { this._ctx.Emit(new BitXorInstr(d, a, c)); }
        else if (op == "<<") { this._ctx.Emit(new ShlInstr(d, a, c)); }
        else if (op == ">>") { this._ctx.Emit(new ShrInstr(d, a, c)); }
        else if (op == "+") {
            // make-enum-distinct-type 1.5：enum 操作数先装箱，让运行期拼出成员名而非裸 i64。
            // **无需判「结果是不是 string」**：enum 的算术 `+`（enum+enum / enum+整数）已被
            // typecheck 的转换格拒掉（E0439），所以能走到这里带 enum 操作数的 `+` 只可能是
            // 字符串拼接——这是类型系统给的不变式，不是此处的假设。
            a = this._ee._boxEnumForStr(a, b.Left.Type());
            c = this._ee._boxEnumForStr(c, b.Right.Type());
            // 值 struct 操作数先转成串（fix-struct-tostr-in-interp）。与上面给 enum 装箱同一位置、
            // 同一动机：VM 的 Add(str) 最终落到 `value_to_str`，那条**没有 ctx** 的路径解不了 arena
            // 里的 struct blob，只吐 `<struct value>` —— struct 自己写的 `ToString` 在 `"" + p` 里
            // 完全不生效。判据同 enum 那两行：带 struct 操作数的 `+` 只可能是字符串拼接
            // （struct 的算术 `+` 要么有 op_Add 重载、早在别处派发，要么被转换格拒掉）。
            if (this._ee._isBlobStruct(b.Left.Type()))  { a = this._ee._emitStructToStr(a, b.Left.Type()); }
            if (this._ee._isBlobStruct(b.Right.Type())) { c = this._ee._emitStructToStr(c, b.Right.Type()); }
            // 字符串拼接也走 Add（tag=str；C# 字节实证 0x10 非 0x85——StrConcatInstr 留作他途）
            this._ctx.Emit(new AddInstr(d, a, c));
        }
        else { this._ctx.Emit(new AddInstr(d, a, c)); }   // && / || → CG-1E-2（占位）
        return d;
    }

    // 比较 → bool（操作数类型透传到指令文本）。
    private TypedReg _emitCompare(string op, TypedReg a, TypedReg c) {
        TypedReg d = this._ctx.Alloc(IrType.Bool);
        if (op == "==") { this._ctx.Emit(new EqInstr(d, a, c)); }
        else if (op == "!=") { this._ctx.Emit(new NeInstr(d, a, c)); }
        else if (op == "<") { this._ctx.Emit(new LtInstr(d, a, c)); }
        else if (op == "<=") { this._ctx.Emit(new LeInstr(d, a, c)); }
        else if (op == ">") { this._ctx.Emit(new GtInstr(d, a, c)); }
        else { this._ctx.Emit(new GeInstr(d, a, c)); }
        return d;
    }

    // 一元：! → not（bool）/ - → neg / ~ → bit_not / + → 透传。++ -- 后续。
    internal TypedReg _emitUnary(BoundUnary u) {
        TypedReg x = this._ee.Emit(u.Operand);
        string op = u.Op;
        if (op == "!") { TypedReg d = this._ctx.Alloc(IrType.Bool); this._ctx.Emit(new NotInstr(d, x)); return d; }
        if (op == "-") { TypedReg d = this._ctx.Alloc(this._ctx.ToIrType(u.Type())); this._ctx.Emit(new NegInstr(d, x)); return d; }
        if (op == "~") { TypedReg d = this._ctx.Alloc(this._ctx.ToIrType(u.Type())); this._ctx.Emit(new BitNotInstr(d, x)); return d; }
        if (op == "+") { return x; }
        // 前置 ++/--（"pre++"/"pre--"）：x = x ± 1，返回**新值**（区别于后置返回旧值）。
        // BoundIdent（`++i`）写回 Locals 活寄存器；非-ident（`++arr[i]`/`++obj.f`）走通用 store。
        if (op == "pre++" || op == "pre--") {
            if (u.Operand is BoundIdent) {
                BoundIdent pbid = u.Operand as BoundIdent;
                TypedReg one = this._ctx.Alloc(IrType.I64);
                TypedReg nv  = this._ctx.Alloc(this._ctx.ToIrType(u.Type()));
                this._ctx.Emit(new ConstI64Instr(one, "1"));
                if (op == "pre++") { this._ctx.Emit(new AddInstr(nv, x, one)); }
                else                { this._ctx.Emit(new SubInstr(nv, x, one)); }
                // 实例字段（裸名）写回 field_set(reg0)；否则 Locals 活寄存器 copy。
                if (this._ctx.Fields.ContainsKey(pbid.Name)) {
                    this._ctx.Emit(new FieldSetInstr(new TypedReg(0, IrType.Ref), pbid.Name, nv));
                    return nv;
                }
                this._ctx.Emit(new CopyInstr(x, nv));
                return x;
            }
            if (u.Operand is BoundStaticGet) {   // ++Class.staticField → static_set 写回
                BoundStaticGet st = u.Operand as BoundStaticGet;
                TypedReg one = this._ctx.Alloc(IrType.I64);
                TypedReg nv  = this._ctx.Alloc(this._ctx.ToIrType(u.Type()));
                this._ctx.Emit(new ConstI64Instr(one, "1"));
                if (op == "pre++") { this._ctx.Emit(new AddInstr(nv, x, one)); } else { this._ctx.Emit(new SubInstr(nv, x, one)); }
                this._ee._emitStaticStore(st, nv);   // add-static-properties：属性走 set_X
                return nv;
            }
            // fix-post-inc-nonident：非-ident 左值（`++arr[i]` / `++obj.field` / `++obj.Prop`）。
            // x 已是读到的旧值（顶部 `_ee.Emit(u.Operand)` 发的 ArrayGet/FieldGet/get_X）；算新值后
            // 经**通用 store**（`_emitStoreTo`）写回，覆盖 ArraySet/FieldSet/属性 set_X/blob 全部情形，
            // 返回新值。索引/接收者随 store 再发一次——与复合赋值 `arr[i] += v` 的求值次数一致。
            if (u.Operand is BoundIndex || u.Operand is BoundMember) {
                TypedReg one = this._ctx.Alloc(IrType.I64);
                TypedReg nv  = this._ctx.Alloc(this._ctx.ToIrType(u.Type()));
                this._ctx.Emit(new ConstI64Instr(one, "1"));
                if (op == "pre++") { this._ctx.Emit(new AddInstr(nv, x, one)); }
                else                { this._ctx.Emit(new SubInstr(nv, x, one)); }
                this._ee._emitStoreTo(u.Operand, nv);
                return nv;
            }
            return x;
        }
        // post-increment / post-decrement（镜像 C# EmitBoundPostfix）：
        // 1. savedOld = copy x（表达式返回旧值）
        // 2. newVal = x ± 1
        // 3. x = copy newVal（写回原寄存器，x 即 Locals 寄存器本身）
        // 注：BoundIdent（`i++`）时 x 是 Locals 活寄存器，写回合法；非-ident（`arr[i]++`/
        //     `obj.f++`）走下方通用 store 分支（fix-post-inc-nonident）。
        TypedReg ph = this._ctx.Alloc(this._ctx.ToIrType(u.Type()));
        this._ctx.Emit(new CopyInstr(ph, x));
        if (u.Operand is BoundIdent) {
            BoundIdent bid = u.Operand as BoundIdent;
            TypedReg one = this._ctx.Alloc(IrType.I64);
            TypedReg nv  = this._ctx.Alloc(this._ctx.ToIrType(u.Type()));
            this._ctx.Emit(new ConstI64Instr(one, "1"));
            if (op == "++") { this._ctx.Emit(new AddInstr(nv, x, one)); }
            else             { this._ctx.Emit(new SubInstr(nv, x, one)); }
            // 实例字段（裸名）写回 field_set(reg0)；否则 Locals 活寄存器 copy（返回旧值 ph）。
            if (this._ctx.Fields.ContainsKey(bid.Name)) {
                this._ctx.Emit(new FieldSetInstr(new TypedReg(0, IrType.Ref), bid.Name, nv));
            } else {
                this._ctx.Emit(new CopyInstr(x, nv));
            }
        } else if (u.Operand is BoundStaticGet) {   // Class.staticField++ → static_set 写回（返回旧值 ph）
            BoundStaticGet st = u.Operand as BoundStaticGet;
            TypedReg one = this._ctx.Alloc(IrType.I64);
            TypedReg nv  = this._ctx.Alloc(this._ctx.ToIrType(u.Type()));
            this._ctx.Emit(new ConstI64Instr(one, "1"));
            if (op == "++") { this._ctx.Emit(new AddInstr(nv, x, one)); } else { this._ctx.Emit(new SubInstr(nv, x, one)); }
            this._ee._emitStaticStore(st, nv);   // add-static-properties：属性走 set_X
        } else if (u.Operand is BoundIndex || u.Operand is BoundMember) {
            // fix-post-inc-nonident：非-ident 左值（`arr[i]++` / `obj.field++` / `obj.Prop++`）。
            // ph 已是旧值（x 的拷贝，x=顶部 `_ee.Emit` 发的 ArrayGet/FieldGet/get_X）；算新值经
            // **通用 store**（`_emitStoreTo`）写回，覆盖 ArraySet/FieldSet/属性 set_X/blob 全部情形，
            // 返回旧值 ph。索引/接收者随 store 再发一次——与复合赋值 `arr[i] += v` 的求值次数一致。
            TypedReg one = this._ctx.Alloc(IrType.I64);
            TypedReg nv  = this._ctx.Alloc(this._ctx.ToIrType(u.Type()));
            this._ctx.Emit(new ConstI64Instr(one, "1"));
            if (op == "++") { this._ctx.Emit(new AddInstr(nv, x, one)); } else { this._ctx.Emit(new SubInstr(nv, x, one)); }
            this._ee._emitStoreTo(u.Operand, nv);
        }
        return ph;
    }

    // ════ 块化表达式（CG-1E-2）：中途分块 + 结果寄存器经 copy/const 汇合 ════════════════
    // 三目 cond ? then : else → 结果寄存器在两分支各赋值（镜像 C# EmitBoundTernary：
    // cond 先求 → 3 标签 tern_then/else/end → result 在标签后 alloc）。
    // switch 表达式 → 等值比较链写结果寄存器（镜像 C# EmitBoundSwitchExpr）。
    internal TypedReg _emitSwitchExpr(BoundSwitchExpr sw) {
        TypedReg subj = this._ee.Emit(sw.Subject);
        TypedReg result = this._ctx.Alloc(this._ctx.ToIrType(sw.Type()));
        string endL = this._ctx.Fresh("swx_end");
        int ai = 0;
        while (ai < sw.ArmCount) {
            BoundSwitchArm arm = sw.Arms[ai];
            if (!arm.HasPattern) {
                TypedReg defR = this._ee.Emit(arm.Body);
                this._ctx.Emit(new CopyInstr(result, defR));
                this._ctx.EndBlock(new BrTerm(endL));
                ai = sw.ArmCount;
            } else {
                string thenL = this._ctx.Fresh("swx_arm");
                string nextL = this._ctx.Fresh("swx_next");
                // 模式匹配（含绑定）→ thenL；失败 → nextL。常量模式 lowering 与旧 Eq 链 byte-identical。
                this._ee._pat.EmitMatch(subj, arm.Pattern, thenL, nextL);
                this._ctx.StartBlock(thenL);
                if (arm.Guard != null) {   // 守卫：匹配后评估，假 → nextL
                    TypedReg g = this._ee.Emit(arm.Guard);
                    string gokL = this._ctx.Fresh("swx_guard");
                    this._ctx.EndBlock(new BrCondTerm(g, gokL, nextL));
                    this._ctx.StartBlock(gokL);
                }
                TypedReg bodyR = this._ee.Emit(arm.Body);
                this._ctx.Emit(new CopyInstr(result, bodyR));
                this._ctx.EndBlock(new BrTerm(endL));
                this._ctx.StartBlock(nextL);
                ai = ai + 1;
            }
        }
        // throw-on-switch-expr-no-match：**落空点**（到这里 = 一个臂都没采纳，且没有兜底臂）。
        // 此前这里是 `Br(endL)` —— 于是 `result` 一次都没被写过就被 return，读到未初始化槽位：
        // `int a = n switch { 1 => 10 }` 在 n=5 时 `a` 打成 `null`、`a + 1` 打出垃圾数
        // （实测 1；换程序形状曾打出 17179869186）。W0700 盖不住它——那条只查封闭域（bool/enum），
        // subject 是 int/string 这类开放域时一条诊断都没有。
        //
        // 改为合成 `new SwitchExpressionException(msg)` + Throw。`Throw` 使块 Ended ⇒
        // **落空路径到不了 endL**，这正是 `result` 不再被未初始化读的机制：endL 的每条入边都写过它。
        //
        // 有兜底臂（default / `_ =>` / 裸绑定）时这里不可达（那一支 `ai = sw.ArmCount` 提前结束、
        // 块已 Ended）⇒ 产物 byte-identical，不多发一条指令。
        //
        // 全用现有指令，**不新增 opcode、不动 wire 格式、VM 一行不改**。位置信息不进消息：
        // `Throw` 运行期已做 resolve_line + populate_stack_trace，抛出点自动在栈回溯里；
        // 而 `Span.File` 是构建机路径，嵌进消息会把它烤进 zbc、破坏字节不动点。
        if (!this._ctx.Ended) {
            TypedReg msg0 = this._ctx.Alloc(IrType.Str);
            this._ctx.Emit(new ConstStrInstr(msg0, this._ctx.Gen.Intern("switch expression did not match any arm; value: ")));
            TypedReg vs  = this._ee._emitToStr(subj, sw.Subject.Type(), false);
            TypedReg msg = this._ctx.Alloc(IrType.Str);
            this._ctx.Emit(new StrConcatInstr(msg, msg0, vs));
            TypedReg exc = this._ctx.Alloc(IrType.Ref);
            TypedReg[] cargs = new TypedReg[1];
            cargs[0] = msg;
            this._ctx.Emit(new ObjNewInstr(exc, OperatorEmitter.SWX_EXC, this._swxCtorFq(), new string[0], 0, cargs, 1));
            this._ctx.EndBlock(new ThrowTerm(exc));
        }
        this._ctx.StartBlock(endL);
        return result;
    }

    // 落空异常的 FQ 类名。emitter 只写**字符串**、不 `using` 这个类 ⇒ 编译期零依赖，
    // 因此不踩 bootstrap-seed 的「新 stdlib API 要晚一个 nightly」纪律（轴 ③ 不触发）。
    private static string SWX_EXC = "Std.SwitchExpressionException";

    // 落空异常的 FQ ctor 名，**从符号表现查、不硬编码**。
    //
    // ctor 键的规则不平凡：primary ctor 注册为**裸类名**、非-primary 才是全签名 mangle
    // （`OverloadBinder._ctorKey`:581-600，stabilize-instance-dispatch-keys）。所以单 ctor 的
    // `SwitchExpressionException` 今天的键就是裸名 —— 写成 `…$1` 会在运行期变
    // `MissingSymbolException`（实测踩过这一脚）。而写死裸名又会在**有人给这个类加第二个
    // ctor 的那天**静默断掉，且只在落空路径才现形。
    //
    // 查得到就用 `RegKey`（权威值，与 `_ctorKey` 的回落循环同一判据）；查不到回落裸名。
    // ⚠️ `GetClass` 走的是**裸名表**（同短名跨 ns 只活一份赢家，`SymbolTable.z42:10,40`）——
    // 所以必须再核一次 `Fqn()`：用户自己定义一个叫 `SwitchExpressionException` 的类时，
    // 裸名会撞到他那个，拿他的 RegKey 去拼 `Std.SwitchExpressionException.…` 就是个断键。
    private string _swxCtorFq() {
        Z42ClassType c = this._ctx.Symbols.GetClass("SwitchExpressionException");
        if (c != null && c.Fqn() == OperatorEmitter.SWX_EXC) {
            MethodSymbol[] cs = c.InstanceCtors();
            int i = 0;
            while (i < cs.Length) {
                // RegKey 可能为空（符号缺失 / decl-only），空则不要拼出 "Std.X." 这种断键 —— 回落裸名。
                if (cs[i].Signature != null && cs[i].Signature.ParamCount == 1 && cs[i].RegKey != "") {
                    return OperatorEmitter.SWX_EXC + "." + cs[i].RegKey;
                }
                i = i + 1;
            }
        }
        return OperatorEmitter.SWX_EXC + ".SwitchExpressionException";
    }

    internal TypedReg _emitConditional(BoundConditional c) {
        TypedReg cond = this._ee.Emit(c.Cond);
        string thenL = this._ctx.Fresh("tern_then");
        string elseL = this._ctx.Fresh("tern_else");
        string endL = this._ctx.Fresh("tern_end");
        TypedReg result = this._ctx.Alloc(this._ctx.ToIrType(c.Type()));
        this._ctx.EndBlock(new BrCondTerm(cond, thenL, elseL));
        this._ctx.StartBlock(thenL);
        TypedReg thenR = this._ee.Emit(c.Then);
        this._ctx.Emit(new CopyInstr(result, thenR));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(elseL);
        TypedReg elseR = this._ee.Emit(c.Else);
        this._ctx.Emit(new CopyInstr(result, elseR));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(endL);
        return result;
    }

    // a && b / a || b → BrCond 块（镜像 C# EmitShortCircuit，统一 and/or 路径）。
    // 标签序 {tag}_rhs/{tag}_short/{tag}_end → result alloc → left 求值 → BrCond。
    // and：真→rhs（求 b）/假→short（const false）；or：真→short（const true）/假→rhs。
    private TypedReg _emitShortCircuit(BoundBinary b, bool isAnd) {
        string tag = "or";
        if (isAnd) { tag = "and"; }
        string rhsL = this._ctx.Fresh(tag + "_rhs");
        string shortL = this._ctx.Fresh(tag + "_short");
        string endL = this._ctx.Fresh(tag + "_end");
        TypedReg result = this._ctx.Alloc(IrType.Bool);
        TypedReg left = this._ee.Emit(b.Left);
        if (isAnd) {
            this._ctx.EndBlock(new BrCondTerm(left, rhsL, shortL));
        } else {
            this._ctx.EndBlock(new BrCondTerm(left, shortL, rhsL));
        }
        this._ctx.StartBlock(rhsL);
        TypedReg rightR = this._ee.Emit(b.Right);
        this._ctx.Emit(new CopyInstr(result, rightR));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(shortL);
        TypedReg constR = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new ConstBoolInstr(constR, !isAnd));
        this._ctx.Emit(new CopyInstr(result, constR));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(endL);
        return result;
    }


    // ── add-struct-value-equality：blob 值 struct 的 == / != → 逐叶子值相等短路合取 ──────────
    // 操作数各求值一次（a/c 为 blob 句柄），递归展平叶子逐个 Eq；首个不等即短路到 fail 块。
    // wantEqual=true → `==`（全叶子相等 → true）；false → `!=`（全等 → false）。结果 result-reg 在
    // 「全等」与「fail」两分支各写 ConstBool，end 块读汇合（镜像 _emitConditional 三目范式）。
    private TypedReg _emitStructEquality(bool wantEqual, TypedReg a, TypedReg c, string structName) {
        TypedReg result = this._ctx.Alloc(IrType.Bool);
        string failL = this._ctx.Fresh("seq_ne");
        string endL = this._ctx.Fresh("seq_end");
        this._emitLeafEqChecks(a, c, 0, structName, failL);
        // 全部叶子相等（fall-through）
        this._ctx.Emit(new ConstBoolInstr(result, wantEqual));
        this._ctx.EndBlock(new BrTerm(endL));
        // 任一叶子不等
        this._ctx.StartBlock(failL);
        this._ctx.Emit(new ConstBoolInstr(result, !wantEqual));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(endL);
        return result;
    }

    // 递归枚举 structName 的展平叶子（镜像 _copyRegion）：嵌套 struct 字段递归累积 offset；基元/引用
    // 叶子读 a/c 两侧值（现有 StructFieldGetPrim）+ 现有 Eq + BrCond 短路到 failL（真→下一叶子块）。
    private void _emitLeafEqChecks(TypedReg a, TypedReg c, int off, string structName, string failL) {
        StructLayoutInfo li = this._ctx.Gen.Layouts.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) {
            int fo = li.FieldOffsets[i];
            if (li.FieldKinds[i] == StructLeafKind.Struct) {
                this._emitLeafEqChecks(a, c, off + fo, li.FieldTypeNames[i], failL);
            } else {
                int tag = Tag.FromName(li.FieldTypeNames[i]);
                int irt = this._ee._tagToIrType(tag);
                TypedReg la = this._ctx.Alloc(irt);
                TypedReg lc = this._ctx.Alloc(irt);
                this._ctx.Emit(new StructFieldGetPrimInstr(la, a, off + fo, tag));
                this._ctx.Emit(new StructFieldGetPrimInstr(lc, c, off + fo, tag));
                TypedReg cmp = this._ctx.Alloc(IrType.Bool);
                this._ctx.Emit(new EqInstr(cmp, la, lc));
                string contL = this._ctx.Fresh("seq_cont");
                this._ctx.EndBlock(new BrCondTerm(cmp, contL, failL));
                this._ctx.StartBlock(contL);
            }
            i = i + 1;
        }
    }

    // ── add-struct-object-methods (PR2b)：合成 Equals(object) body 的结果表达式 ──────────────
    // `(other is P) ? leafEq((P)this, (P)other) : false`。this/other 均为 boxed（vcall 臂传 boxed 值、
    // 或 static Call 传 boxed）→ 内部 AsCast 拆箱到 **callee 帧** arena StructRef（避开 JIT 帧无 frame_id），
    // 再复用 PR1 `_emitStructEquality` 逐叶子比较。result-reg 在两分支汇合（镜像三目）。
    internal TypedReg EmitSynthEqualsResult(string structName, TypedReg thisReg, TypedReg otherReg) {
        string fq = this._ctx.QualifyClass(structName);
        TypedReg result = this._ctx.Alloc(IrType.Bool);
        TypedReg isP = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new IsInstanceInstr(isP, otherReg, fq));
        string doL = this._ctx.Fresh("seq_eq_do");
        string elseL = this._ctx.Fresh("seq_eq_no");
        string endL = this._ctx.Fresh("seq_eq_end");
        this._ctx.EndBlock(new BrCondTerm(isP, doL, elseL));
        this._ctx.StartBlock(doL);
        TypedReg a = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new AsCastInstr(a, thisReg, fq));    // 拆 this → StructRef
        TypedReg b = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new AsCastInstr(b, otherReg, fq));   // 拆 other → StructRef
        TypedReg eq = this._emitStructEquality(true, a, b, structName);
        this._ctx.Emit(new CopyInstr(result, eq));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(elseL);
        this._ctx.Emit(new ConstBoolInstr(result, false));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(endL);
        return result;
    }

    // ── add-record-value-semantics：record-class（引用）`==`/`!=` → 值 Equals（null-safe 脱糖）─────────
    // `==`：(a==null) ? (c==null) : a.Equals(c)；`!=`：取反。避免 `null == r` VCall 空引用崩（对齐 C#
    // record op_Equality 的 null-safe 语义）。Equals 经 vtable 派发到合成的值相等版（RecordSynth）。
    private TypedReg _emitRecordEquality(bool wantEqual, TypedReg a, TypedReg c) {
        TypedReg result = this._ctx.Alloc(IrType.Bool);
        TypedReg nullR = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new ConstNullInstr(nullR));
        TypedReg aNull = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new EqInstr(aNull, a, nullR));
        string aNullL = this._ctx.Fresh("req_op_anull");
        string aNotL = this._ctx.Fresh("req_op_anot");
        string endL = this._ctx.Fresh("req_op_end");
        this._ctx.EndBlock(new BrCondTerm(aNull, aNullL, aNotL));
        this._ctx.StartBlock(aNullL);
        TypedReg cNull = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new EqInstr(cNull, c, nullR));
        this._ctx.Emit(new CopyInstr(result, cNull));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(aNotL);
        TypedReg[] eqArgs = new TypedReg[1]; eqArgs[0] = c;
        TypedReg eqr = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new VCallInstr(eqr, a, "Equals", eqArgs, 1));
        this._ctx.Emit(new CopyInstr(result, eqr));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(endL);
        if (wantEqual) { return result; }
        TypedReg neg = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new NotInstr(neg, result));
        return neg;
    }

    private bool _isRecordClass(Z42Type t) {
        return (t is Z42ClassType) && (t as Z42ClassType).IsRecord && !(t as Z42ClassType).IsStruct;
    }
}
