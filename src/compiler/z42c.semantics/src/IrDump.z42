namespace Z42.Semantics;

using Z42.Syntax;
using Z42.Core;
using Z42.IR;
using Z42.IR.BinaryFormat;

// IR dump/emit + 包编译门面（port-z42c-codegen CG-1A）：源 → typecheck → codegen → .zasm-like IR 文本 / .zbc
// 字节 / CompiledModuleZ 束。供 [Test] 断言 + driver `--dump-ir`/`--emit-zbc` + pipeline 包编译。
// 跨包公开 API 全留本类（自举稳定：pipeline/driver 依赖的接口冻结）；私有 CU 编译内核分出 CuCompile、
// CU 预处理/ns 遮蔽分出 CuPreprocess（irdump-pipeline-split，均同包内消费故 member-compile 内解析）。

// parallelize-package-compile：per-file 编译任务（★② 主并行段）。承载 BuildPackageCus 的 per-file
// 循环体——cached 回填 或 _compileCu（typecheck+codegen）→ file-scope 检查 → 导出抽取，每项写自己
// 的 _r[i]。所有输入字段在并行前冻结、Run 内只读（symbols 数据字段 + deps/imported/各聚合表）；
// 唯 _r[i] 各写各槽 → 确定性、可并行（完成序不影响结果）。诊断已 per-file 隔离进 _r[i]。
sealed class CompileCuTask : IParallelBody {
    CompilationUnit[] _cus; string[] _files; SymbolTable _symbols;
    DependencyIndex _deps; ImportedSymbols _imported;
    StrMap _classNs; StrMap _localClasses; bool _isRelease;
    StrMap _partialMerged; int _optSet; IrModule[] _cached;
    ExportedFuncZ[] _allFuncs; int _afc; StrMap _pkgClassMap;
    StructLayout _layouts;   // perf-layouts-once：包级预计算布局表（并行段只读共享）
    CompiledModuleZ[] _r;
    public CompileCuTask(CompilationUnit[] cus, string[] files, SymbolTable symbols,
                         DependencyIndex deps, ImportedSymbols imported,
                         StrMap classNs, StrMap localClasses, bool isRelease,
                         StrMap partialMerged, int optSet, IrModule[] cached,
                         ExportedFuncZ[] allFuncs, int afc, StrMap pkgClassMap,
                         StructLayout layouts, CompiledModuleZ[] r) {
        this._cus = cus; this._files = files; this._symbols = symbols;
        this._deps = deps; this._imported = imported;
        this._classNs = classNs; this._localClasses = localClasses; this._isRelease = isRelease;
        this._partialMerged = partialMerged; this._optSet = optSet; this._cached = cached;
        this._allFuncs = allFuncs; this._afc = afc; this._pkgClassMap = pkgClassMap;
        this._layouts = layouts;
        this._r = r;
    }
    public void Run(int i) {
        if (this._cached != null && this._cached[i] != null) {
            // cached：typecheck/codegen 跳过；ns/usings 来自当前 AST/源（与 fresh 同源）。
            string nsReal = this._cus[i].HasNamespace ? this._cus[i].Namespace : "";
            string[] us = IrDump.UsingsOf(this._cus[i]);
            this._r[i] = new CompiledModuleZ(this._cached[i], nsReal, us, us.Length, new string[0], 0, 0);
            this._r[i].DiagMsgs = new string[0]; this._r[i].DiagCount = 0;
        } else {
            this._r[i] = CuCompile._compileCu(this._cus[i], this._files[i], this._symbols, this._deps,
                this._imported, this._classNs, this._localClasses, this._isRelease, this._partialMerged,
                this._optSet, this._layouts);
        }
        CuPreprocess._enforceFileScope(this._cus[i], this._files[i], this._r[i]);   // 跨包未-using 报错
        string ns2 = "main";                                 // no-ns build 路径缺省（C# 字节实证）
        if (this._cus[i].HasNamespace) { ns2 = this._cus[i].Namespace; }
        this._r[i].Exported = ExportedTypeExtractor.ExtractP(this._cus[i], this._symbols, ns2,
            this._allFuncs, this._afc, this._pkgClassMap, this._classNs);
    }
}

public static class IrDump {
    // 指定函数（key="Class.Method" / 顶层函数名）的 IR 文本。
    public static string DumpFunc(string src, string funcKey) {
        IrModule m = IrDump._build(src);
        int i = 0;
        while (i < m.FuncCount) {
            if (m.Functions[i].Name == funcKey) { return m.Functions[i].Dump(); }
            i = i + 1;
        }
        return "(no-func " + funcKey + ")";
    }
    // 整模块 IR 文本（所有函数）。
    public static string DumpModule(string src) {
        return IrDump._build(src).Dump();
    }
    // 指定 optSet 的函数 dump（add-compiler-inlining Phase 2：内联/独立性单测用；
    // 传 Opt.All 开内联、Opt.Inline 单独验内联、Opt.None 验 -O0）。
    public static string DumpFuncOpt(string src, string funcKey, int optSet) {
        IrModule m = IrDump._buildFOpt(src, "<input>", optSet);
        int i = 0;
        while (i < m.FuncCount) {
            if (m.Functions[i].Name == funcKey) { return m.Functions[i].Dump(); }
            i = i + 1;
        }
        return "(no-func " + funcKey + ")";
    }
    // 指定 optSet 的整模块 dump。
    public static string DumpModuleOpt(string src, int optSet) {
        return IrDump._buildFOpt(src, "<input>", optSet).Dump();
    }
    // 整模块 → byte-identical .zbc 的小写 hex（golden-hex 断言；port-z42c-zbc-writer）。
    public static string DumpZbcHex(string src) {
        return ZbcWriter.WriteHex(IrDump._build(src));
    }
    // 整模块 → .zbc 字节（driver --emit-zbc 写盘；纯函数，IO 在 driver）。file 进 span→DBUG（basename 化在 TrackLine）。
    public static byte[] ZbcBytes(string src, string file) {
        return ZbcWriter.Write(IrDump._buildF(src, file)).ToBytes();
    }
    // deps-aware 单文件 emit（replace-csharp Phase C：golden regen 脱 dotnet 需跨包 dep 解析，
    // 否则调 stdlib（Assert/Console）的源 emit 出 `<error>` 函数名）。镜像 build 路径用 BuildModuleD。
    public static byte[] ZbcBytesD(string src, string file, DependencyIndex deps, ImportedSymbols imported) {
        CompiledModuleZ cm = IrDump.BuildModuleD(src, file, deps, imported);
        return ZbcWriter.Write(cm.Module).ToBytes();
    }
    // golden-hex 断言用：指定文件名（DBUG file 串须与 C# 同源 capture 一致）。
    public static string DumpZbcHexF(string src, string file) {
        return ZbcWriter.WriteHex(IrDump._buildF(src, file));
    }
    private static IrModule _build(string src) {
        return IrDump._buildF(src, "<input>");
    }
    // 公开：源→IrModule（pipeline/driver build 用）。
    public static IrModule BuildModule(string src, string file) {
        return IrDump._buildF(src, file);
    }
    // 全文件 parse（+ AttributeSynth 合成工厂）。增量路径先 parse 后闭包 → CU 复用进
    // BuildPackageCus，避免二次 parse（add-file-level-incremental D2）。
    public static CompilationUnit[] ParseAll(string[] srcs, string[] files, int count) {
        CompilationUnit[] cus = new CompilationUnit[count];
        int i = 0;
        while (i < count) {
            var pp = new Parser(srcs[i], files[i]);
            cus[i] = HandlerRegistry.RunAst(pp.ParseCompilationUnit());   // attribute-handler-registry：AST-phase 单一入口
            i = i + 1;
        }
        return cus;
    }
    // 包级编译（PS-1）：全文件 parse → 全包合并收集 → 逐文件 typecheck/codegen（per-file IrModule）。
    public static CompiledModuleZ[] BuildPackage(string[] srcs, string[] files, int count,
                                                 DependencyIndex deps, ImportedSymbols imported,
                                                 bool isRelease) {
        return IrDump.BuildPackageCus(srcs, files, count, IrDump.ParseAll(srcs, files, count),
                                      deps, imported, isRelease, null, Opt.ProfileDefault(isRelease));
    }
    // 增量变体（add-file-level-incremental D2）：cachedModules[i] 非 null → 该文件跳过
    // typecheck/codegen，IrModule 用 cache 读回件；符号收集 / allFuncs / classNs / classMap /
    // TSIG（Exported）恒全包重算（每文件 TSIG 全包耦合——自由函数兄弟泄漏 + 全包 AST）。
    // cached 的 UsedDepNs 是 typecheck 产物 → 由调用方从 cache meta 回填。
    public static CompiledModuleZ[] BuildPackageCus(string[] srcs, string[] files, int count,
                                                    CompilationUnit[] cus,
                                                    DependencyIndex deps, ImportedSymbols imported,
                                                    bool isRelease, IrModule[] cachedModules, int optSet) {
        int i = 0;
        CuPreprocess._injectGlobalUsings(cus, count);   // add-global-using：包级 using 注入每个 CU（须在符号收集前）
        SymbolCollector coll = new SymbolCollector();
        SymbolTable symbols = coll.CollectAll(cus, files, count, imported);   // add-partial-types：files 供主碎片跟踪 + 合并校验
        // infer-var-field-types：SymbolCollect 后、TSIG Export 前——从初始化器推断 static var
        // 字段类型、回写 fs.FieldType（消除「var」降级态，使导出 + 跨包消费得真实类型）。
        VarFieldInfer.Run(cus, count, symbols);
        StrMap partialMerged = CuCompile._buildMergedPartial(cus, count, symbols);   // add-partial-types：partial 类型名 → 合并 ClassDecl
        // F4+F12：符号收集后的 4 趟独立全 CU 扫融成一趟——classNs（G17b 跨-ns 类名解析图）/
        // localClasses（G18 本地类集）/ pkgClassMap（跨文件基类 map）/ allFuncs（全包自由函数聚合）
        // 彼此无数据依赖，同序遍历 cus[]，每张 map 的写序不变 → 字节不动。单文件 emit 路径仍用
        // _pkgClassNs / _pkgLocalClasses 辅助（1-CU 场景），故辅助函数保留。
        // classNs 预置跨-zpkg imported（镜像 C# ImportedClassNamespaces）。
        StrMap classNs = new StrMap();
        if (imported != null && imported.ClassNamespaces != null) {
            string[] icks = imported.ClassNamespaces.Keys();
            int ick = 0;
            while (ick < icks.Length) { classNs.Put(icks[ick], imported.ClassNamespaces.Get(icks[ick])); ick = ick + 1; }
        }
        StrMap localClasses = new StrMap();          // G18：反劫持守卫仅认本地类
        StrMap pkgClassMap = new StrMap();            // 跨文件 base 类方法继承（shortName / Name$N → ClassDecl）
        ExportedFuncZ[] allFuncs = new ExportedFuncZ[4];   // 全包自由函数（文件序+声明序，C# sem.Funcs 兄弟泄漏镜像）
        int afc = 0;
        i = 0;
        while (i < count) {
            CompilationUnit fcu = cus[i];
            bool hasNs = fcu.HasNamespace && fcu.Namespace != "";   // classNs 仅收有 ns 的类
            int d = 0;
            while (d < fcu.DeclCount) {
                Decl dd = fcu.Decls[d];
                if (dd is AttributedDecl) { dd = (dd as AttributedDecl).Inner; }
                if (dd is ClassDecl) {
                    ClassDecl cd = dd as ClassDecl;
                    if (hasNs) { classNs.Put(cd.Name, new StrBox(fcu.Namespace)); }   // 含 interface（任意 Kind）
                    if (cd.Kind == "class" || cd.Kind == "struct") {
                        localClasses.Put(cd.Name, new StrBox(cd.Name));
                        if (!pkgClassMap.ContainsKey(cd.Name)) { pkgClassMap.Put(cd.Name, cd); }
                        if (cd.TypeParams.Count > 0) {
                            string pcmk = cd.Name + "$" + cd.TypeParams.Count.ToString();
                            if (!pkgClassMap.ContainsKey(pcmk)) { pkgClassMap.Put(pcmk, cd); }
                        }
                    }
                }
                d = d + 1;
            }
            // F3：仅抽自由函数（此前全量 Extract 只留 Functions，class/interface/enum/delegate/impl 全丢弃）。
            ExportedFuncZ[] ownFuncs = ExportedTypeExtractor.ExtractFuncs(fcu, symbols);
            int f = 0;
            while (f < ownFuncs.Length) {
                if (afc == allFuncs.Length) {
                    ExportedFuncZ[] b = new ExportedFuncZ[allFuncs.Length * 2];
                    int k = 0; while (k < afc) { b[k] = allFuncs[k]; k = k + 1; }
                    allFuncs = b;
                }
                allFuncs[afc] = ownFuncs[f];
                afc = afc + 1;
                f = f + 1;
            }
            i = i + 1;
        }
        // parallelize-package-compile：where 约束解析 hoist 到 per-file 循环前（约束是声明级、包全局：
        // 一个文件可 new 另一个文件声明的泛型类）。一次性把全包约束冻结进共享 symbols.ClassConstraints，
        // 之后 per-file 循环（将并行化）只读 Check、绝不再写——消除并行下对 ClassConstraints 的数据竞争。
        // 诊断入 coll.Diags（包级，与 CollectAll 同路径，line ~176 按 Span.File 分发）。每 CU 用自己的
        // 别名视图（WithAliases）解析约束类型，不覆写共享 CurrentAliases。
        ConstraintChecker _cc = new ConstraintChecker(coll.Diags);
        int cci = 0;
        while (cci < count) {
            _cc.Resolve(cus[cci], symbols.WithAliases(SymbolTable.BuildAliases(cus[cci])));
            cci = cci + 1;
        }
        // parallelize-package-compile ★②：per-file typecheck+codegen 并行（同层前置已冻结共享态：
        // symbols 数据字段只读 + 约束已 hoist + 别名 per-file 视图）。每项写 r[i]，确定性。
        // 并行度 ParallelConfig.Jobs（--jobs / CpuCount）；jobs<=1 串行内联（逃生舱 / 调试）。
        // perf-layouts-once：struct/class 字节布局表只依赖 symbols.Classes/Interfaces（包级、此后只读——
        // AddOwnField 仅在 SymbolCollector/ImportedSymbolLoader 阶段写，Infer/Generate 不写），且 IrGen
        // 拿到的 `model.Symbols` 是 WithAliases 浅拷贝、与此处共享同一 Classes/Interfaces ⇒ 逐 CU 重建
        // 结果恒等。故整包算一次注入（此前 count 个 CU 各重建一遍整包符号表布局）。预计算后全部访问器
        // 只读（LayoutOf 对 _defs 内键必命中缓存，缺失键返回不入缓存的空布局）⇒ 并行段共享安全。
        // 全 cached（增量命中）时无 CU 走 codegen → 不建，保持零开销。
        bool _anyFresh = false;
        int _cf = 0;
        while (_cf < count) { if (cachedModules == null || cachedModules[_cf] == null) { _anyFresh = true; } _cf = _cf + 1; }
        StructLayout layouts = null;
        if (_anyFresh) { layouts = StructLayout.BuildFromSymbols(symbols); }
        CompiledModuleZ[] r = new CompiledModuleZ[count];
        CompileCuTask _task = new CompileCuTask(cus, files, symbols, deps, imported, classNs,
            localClasses, isRelease, partialMerged, optSet, cachedModules, allFuncs, afc, pkgClassMap,
            layouts, r);
        ParallelFor.Run(count, ParallelConfig.Jobs(count), _task);
        // add-partial-types：分发 partial 合并的包级诊断到对应文件的 CompiledModuleZ（按 Span.File 匹配；无匹配落 0 号）。
        // 这些诊断在 CollectAll（包级）产生，不属于任一 _compileCu 的 per-file bag，故此处并入使 PackageCompile 诊断门捕获。
        int pdi = 0;
        while (pdi < coll.Diags.Count()) {
            Diagnostic dg = coll.Diags.Get(pdi);
            int tgt = 0;
            int fj = 0;
            while (fj < count) { if (files[fj] == dg.Span.File) { tgt = fj; } fj = fj + 1; }
            string pmsg = dg.Span.File + "(" + dg.Span.Line.ToString() + "," + dg.Span.Column.ToString() + "): " + dg.Code + ": " + dg.Message;
            int oldn = r[tgt].DiagCount;
            string[] nw = new string[oldn + 1];
            int q = 0; while (q < oldn) { nw[q] = r[tgt].DiagMsgs[q]; q = q + 1; }
            nw[oldn] = pmsg;
            r[tgt].DiagMsgs = nw; r[tgt].DiagCount = oldn + 1;
            r[tgt].ErrorCount = r[tgt].ErrorCount + 1;   // partial 诊断均为 error（this.Diags.Error）
            pdi = pdi + 1;
        }
        return r;
    }
    // 公开：带跨包依赖的编译（CI-4）。imported 合并符号表；deps 驱动静态调用 FQ 命中。
    public static CompiledModuleZ BuildModuleD(string src, string file, DependencyIndex deps, ImportedSymbols imported) {
        var p = new Parser(src, file);
        var cu = HandlerRegistry.RunAst(p.ParseCompilationUnit());   // attribute-handler-registry：AST-phase 单一入口
        // add-partial-types：单文件路径（--emit-zbc / golden）也须走 file-threading 的 CollectAll（非
        // CollectWithImports），否则同文件多 partial 碎片的 PartialMainFile 为 ""、SourceFile 为 null →
        // 主碎片判定失败 → 合并 TYPE record 不发 → new T() 得 <unknown> 类型（无字段/方法）。
        CompilationUnit[] one = new CompilationUnit[1]; one[0] = cu;
        string[] oneFile = new string[1]; oneFile[0] = file;
        var coll = new SymbolCollector();
        var symbols = coll.CollectAll(one, oneFile, 1, imported);
        var diags = new DiagnosticBag();
        cu.MergeParseDiags(diags);   // fix-parse-diags-dropped：parse 错误计入编译错误
        // add-associated-types PR-1：单文件路径也必须跑约束 Resolve。包路径在 BuildPackageCus 里做
        // 这一步（包级 hoist，早于 per-file 并行段），两条单文件路径此前**整个跳过** →
        // ClassConstraints 为空 → Check 第一行即返回 ⇒ **同一份源码 `--emit-zbc` 能过、放进工程就红**。
        // golden 语料（src/tests/**）走的正是这条路径，于是 where 约束在整个 golden 面上形同虚设，
        // 「GREEN 全绿」也就不构成「真实工程无违反」的证据。
        new ConstraintChecker(diags).Resolve(cu, symbols.WithAliases(SymbolTable.BuildAliases(cu)));
        var model = new TypeChecker(diags).Infer(cu, symbols);
        var gen = new IrGen();
        gen.Deps = deps;
        gen.SourceStem = CuPreprocess._stem(cu);
        gen.SourceFile = file;                                        // add-partial-types：主碎片判定
        gen.PartialMerged = CuCompile._buildMergedPartial(one, 1, symbols);   // add-partial-types：合并 ClassDecl
        gen.LocalClasses = CuPreprocess._pkgLocalClasses(one, 1);   // G18：反劫持守卫仅认本地类
        if (imported != null) { gen.ImportedClassNs = CuPreprocess._filterShadowed(imported.ClassNamespaces, cu); }
        if (imported != null) { gen.ImportedFuncNs = CuPreprocess._filterShadowedFuncs(imported.FunctionNamespaces, cu); }   // fix-imported-free-func-namespace
        string[] actNs2 = CuPreprocess._activeNamespaces(cu);   // path C：static call using-scoped 消歧
        gen.ActiveNs = actNs2; gen.ActiveNsCount = actNs2.Length;
        // 单模块 / --dump-ir / codegen 单测 / golden .zbc regen 路径：本地优化但**不内联**
        // （Opt.All - Inline，add-compiler-inlining Phase 2）。codegen/zbc golden 断言的是优化后 IR
        // （test_constfold_* / test_identity_*），但内联是跨函数变换、会折叠含直接调用的 golden 且脆弱；
        // 排除内联 = Phase 2 前 Opt.All 的等价输出，所有既有 golden 逐字节不变。真实 release 包构建
        // （BuildPackageCus 走 ProfileDefault=All 含内联）+ 内联专项单测覆盖内联行为。
        // 同理排除 StackAlloc（add-escape-analysis）：逃逸分析是跨函数（ctor this-摘要）+ 模块级变换，
        // 会给非逃逸分配置标志、改 golden 字节且脆弱 → dump/golden 路径不跑；真实 release 自建 + 专项单测覆盖。
        // 同理排除 LoopAllocReuse（add-loop-alloc-hoist-reuse）：依赖 StackAlloc、模块级改指令流（hoist+ctor-call），
        // 排除即回到既有 golden 输出；真实 release 自建 + 专项单测覆盖。
        IrModule irm = gen.Generate(cu, model, Opt.All - Opt.Inline - Opt.StackAlloc - Opt.LoopAllocReuse - Opt.PureCall - Opt.DeadBranch - Opt.Devirt);
        // usings 抽取（DEPS 用）
        string[] usings = new string[4];
        int uc = 0;
        int i = 0;
        while (i < cu.DeclCount) {
            if (cu.Decls[i] is UsingDecl) {
                if (uc == usings.Length) {
                    string[] b = new string[usings.Length * 2];
                    int k = 0; while (k < uc) { b[k] = usings[k]; k = k + 1; }
                    usings = b;
                }
                usings[uc] = (cu.Decls[i] as UsingDecl).Name;
                uc = uc + 1;
            }
            i = i + 1;
        }
        string ns = "";
        if (cu.HasNamespace) { ns = cu.Namespace; }
        var cm2 = new CompiledModuleZ(irm, ns, usings, uc, gen.UsedDepNs, gen.UsedDepNsCount, diags.ErrorCount());
        string[] dm = new string[diags.Count()];
        int di = 0;
        while (di < diags.Count()) {
            Diagnostic dg = diags.Get(di);
            dm[di] = dg.Span.File + "(" + dg.Span.Line.ToString() + "," + dg.Span.Column.ToString() + "): " + dg.Code + ": " + dg.Message;
            di = di + 1;
        }
        cm2.DiagMsgs = dm; cm2.DiagCount = diags.Count();
        return cm2;
    }
    // 公开：从**已解析** CU 收 using 名，零 reparse（F1）。包编译已有 CompilationUnit 在手时走此入口。
    public static string[] UsingsOf(CompilationUnit cu) {
        string[] usings = new string[8];
        int uc = 0;
        int i = 0;
        while (i < cu.DeclCount) {
            if (cu.Decls[i] is UsingDecl) {
                if (uc == usings.Length) {   // 修存量越界：第 9 个 using 曾直接炸（固定 8 无扩容）
                    string[] b = new string[usings.Length * 2];
                    int k = 0;
                    while (k < uc) { b[k] = usings[k]; k = k + 1; }
                    usings = b;
                }
                usings[uc] = (cu.Decls[i] as UsingDecl).Name;
                uc = uc + 1;
            }
            i = i + 1;
        }
        string[] r = new string[uc];
        i = 0;
        while (i < uc) { r[i] = usings[i]; i = i + 1; }
        return r;
    }
    // 公开：文本入口（仅 --emit-zbc 无-CU 独立路径 Main.z42 用）。有 CU 时改用 UsingsOf 免 reparse（F1）。
    public static string[] ExtractUsings(string src, string file) {
        return UsingsOf(new Parser(src, file).ParseCompilationUnit());
    }
    // 公开：源→导出类型签名（TSIG；port-z42c-tsig）。独立 parse+collect（与 BuildModule 分离，
    // 形态简单；增量编译期再合并为单趟）。
    public static ExportedModuleZ ExtractExports(string src, string file, string ns) {
        var p = new Parser(src, file);
        var cu = p.ParseCompilationUnit();
        var symbols = new SymbolCollector().Collect(cu);
        return ExportedTypeExtractor.Extract(cu, symbols, ns);
    }
    private static IrModule _buildF(string src, string file) {
        // dump / codegen-golden 默认 optSet = Opt.All **减去 Inline**（add-compiler-inlining Phase 2）：
        // 单函数 dump / golden 断言的是「单函数本地优化后」的 IR（const-fold/copy-prop/dce），**不含**
        // 跨函数内联——否则每个含直接调用的 codegen golden 都会被内联折叠、测两件事且脆弱。此值 =
        // Phase 2 前 Opt.All 的等价输出（内联当时是 no-op），故所有既有 golden 逐字节不变。内联单独由
        // 真实 release 自建（D7 不动点 / e2e）+ `DumpFuncOpt(...Opt.All)` 专项单测覆盖。
        // 同理减去 StackAlloc（add-escape-analysis）：跨函数 + 模块级、会改 golden 字节 → 单函数 dump 路径不跑。
        return IrDump._buildFOpt(src, file, Opt.All - Opt.Inline - Opt.StackAlloc - Opt.LoopAllocReuse - Opt.PureCall - Opt.DeadBranch - Opt.Devirt);
    }
    // 带显式 optSet 的 dump 构建（内联 / 独立性单测：传 Opt.All 开内联、传 Opt.Inline 单独验内联）。
    private static IrModule _buildFOpt(string src, string file, int optSet) {
        var p = new Parser(src, file);
        var cu = HandlerRegistry.RunAst(p.ParseCompilationUnit());   // attribute-handler-registry：AST-phase 单一入口
        var symbols = new SymbolCollector().Collect(cu);
        var diags = new DiagnosticBag();
        cu.MergeParseDiags(diags);   // fix-parse-diags-dropped：parse 错误计入编译错误
        // add-associated-types PR-1：单文件路径也必须跑约束 Resolve。包路径在 BuildPackageCus 里做
        // 这一步（包级 hoist，早于 per-file 并行段），两条单文件路径此前**整个跳过** →
        // ClassConstraints 为空 → Check 第一行即返回 ⇒ **同一份源码 `--emit-zbc` 能过、放进工程就红**。
        // golden 语料（src/tests/**）走的正是这条路径，于是 where 约束在整个 golden 面上形同虚设，
        // 「GREEN 全绿」也就不构成「真实工程无违反」的证据。
        new ConstraintChecker(diags).Resolve(cu, symbols.WithAliases(SymbolTable.BuildAliases(cu)));
        var model = new TypeChecker(diags).Infer(cu, symbols);
        var gen = new IrGen();
        gen.SourceStem = CuPreprocess._stem(cu);   // SA-3：__static_init__ 名前缀须用文件 stem（镜像 _compileCu / C# _cuStem），否则回落 "main" → 与 C# `<stem>.__static_init__` 字节不一致
        CompilationUnit[] one = new CompilationUnit[1]; one[0] = cu;
        gen.LocalClasses = CuPreprocess._pkgLocalClasses(one, 1);   // G18：反劫持守卫仅认本地类
        return gen.Generate(cu, model, optSet);
    }
}
