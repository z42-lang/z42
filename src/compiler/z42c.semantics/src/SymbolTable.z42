// 符号表（port-z42c-semantics 1A-3，Pass 0 产物）。类名→Z42ClassType / 顶层函数名→MethodSymbol。
// 含 TypeExpr（语法）→ Z42Type（语义）的桥 ResolveType。1A：NamedType（prim/void/class）；
// Array/Nullable/泛型实参 → Unknown（延后 1D/2A）。
//
// 🔴 **使用契约（enforce-fqn-name-identity B5 起是硬约束）**：往表里登记完类型之后，
// **必须**依次调 `InternAllTypes()` → `BindTypeRefs()`，名义关系判定才成立。
//
//   `IsSubclassOf` / `Implements` 只认**名义身份句柄**（`Z42ClassType.Base` / `.Interfaces`、
//   `Z42InterfaceType.Bases`），B5 已删掉「句柄为 0 就退回比名字」那条回落 —— 因为实测它在
//   stdlib 全量与真·跨包编译两个面上**一次都没触发**，而留着它就等于留着「按名字猜」的路，
//   那正是本程序开篇追的那类静默错值。
//
// ⇒ 漏调这两步的后果是**静默的**：所有名义关系判 false（「谁也不是谁的子类」），不报错。
//   生产路径上 `SymbolCollector` 的三个入口（`Collect` / `CollectAll` / `CollectWithImports`）
//   都紧跟着调；**手搭符号表的测试必须自己补**（`conversion_tests` 曾因此红过一次）。
//   `WithAliases` 产出的 per-file 视图共享同一份 `Intern`，不必重复调。
namespace Z42.Semantics;
using Z42.IR;   // StrMap 统一到 z42c.ir（compiler-review §4.1）

using Z42.Syntax;

public sealed partial class SymbolTable {
    public StrMap Classes;          // name → Z42ClassType（裸名键；同短名跨 ns 碰撞 first/last-wins）
    // fix-type-ref-ns-collision：FQN 键（`ns.Name` / `ns.Name$N`）→ Z42ClassType。裸名 `Classes` 在同短名
    // 跨 ns（`A.Foo`/`B.Foo`）时只能留一份；此 map 保留全部，供 ResolveTypeP 的限定名路径按 FQN 精确解析，
    // 不再靠剥短名撞 first/last-wins 赢家。与 Classes 并存：非限定引用仍走 Classes，限定引用优先走此。
    public StrMap ClassesByFqn;
    public StrMap Interfaces;       // name → Z42InterfaceType（port-z42c-interface）
    // resolve-free-functions-by-namespace：自由函数 **FQN**（`ns.name`；全局 ns 即 `name`）→ MethodSymbol（本包 + 导入）。
    // 解析与登记见 SymbolTable.Functions.z42。此前是裸名键 `Functions`（后写覆盖、不认 ns）。
    public StrMap FunctionsByFqn;
    // free-function-overloads：自由函数重载候选集。键 = **基名 FQN**（`QualOf(ns, 源名)`，不含签名后缀），
    // 值 = MethodSymbolList（该 ns 下同名全部重载，含 primary，登记序）。`FunctionsByFqn` 的键是
    // **RegKey-限定 FQN**（primary=`ns.name`、非-primary=`ns.name$arity$T`）用于发射唯一性与跨包；
    // 这张表按基名分组用于调用点重载决议（GetFuncCandidates）。#414 primary-bare：唯一函数 → primary →
    // 裸键 ⇒ 存量字节零漂移；第二个同名起才带签名后缀，纯增量。
    public StrMap FuncOverloadsByFqn;
    public StrMap FuncNsAll;        // 短名 → 声明过它的全部 ns（StrBox，"|" 连接；与 ClassNsAll 同构）= 裸名解析的候选集
    public StrMap ClassConstraints; // ConstraintKey() → ConstraintSet（2B；仅有 where 子句的泛型类/结构登记）
    // add-associated-types PR-1：泛型**接口**的 where 约束。与 ClassConstraints 分开存，因为类与接口
    // 同名（`Foo` 类 + `Foo` 接口）在各自的 Classes/Interfaces 里合法共存，混进一张表会互相遮蔽——
    // 而 Check 的查询侧只认类（`Z42InstantiatedType.Def` 是 Z42ClassType），被接口条目遮蔽会静默错检。
    // 接口从不 arity-mangle（ImportedSymbolLoader/StubCollector 都按裸名登记），故此表键恒为裸名。
    public StrMap InterfaceConstraints;
    public StrMap EnumTypes;        // name → "enum" 标记（枚举类型名注册）
    // unify-type-identity-fqn：接口的 FQN 视图（对称 ClassesByFqn）+ enum 的声明 ns（name → ns）。
    // 两者此前都不存在 ⇒ 接口/enum 的类型身份只有短名，与类那半边不一致。
    public StrMap InterfacesByFqn;
    public StrMap EnumTypeNs;
    public StrMap EnumConsts;       // "EnumName.MemberName" → 整数值字符串
    public StrMap Delegates;        // name → Z42FuncType（用户 delegate，非泛型；委托类型即函数类型）
    // add-bare-name-ambiguity-diagnostic：**短名 → 声明过它的全部命名空间**（值 StrBox，"|" 连接）。
    // 为什么必须单独存：`Classes` 是裸名单赢家（同短名跨 ns 只活一份）、
    // `ImportedSymbols.ClassNamespaces` 是裸名 → **单个** ns —— 两个生产点都把
    // 「同一短名有几份」这个信息塌掉了。不重建它就无从判歧义（C# CS0104 的判据）。
    // ⚠️ 2026-09-27 更正：这段原本还写着「`ClassesByFqn` 只登记**本地**类（imported 从不进）」——
    // **已经不成立**。`ImportedSymbolLoader` 在 first-wins 守卫**之外** `ClassesByFqn.Put(fqnKey, nct)`
    // （每一份都留），`SymbolCollector._mergeImports` 再并进主表。那句话大概是守卫收窄之前写的，
    // 之后没人回来改 —— 又一条「没有东西盯着的断言迟早变谎言」。
    // 但 `ClassNsAll` 仍**不可删**：它要答的是「同一**短名**有几个 ns」的 O(1) 反查，FQN 键表给不了。
    public StrMap ClassNsAll;
    // enforce-fqn-name-identity 阶段 2：**接口**短名 → 全部声明 ns（对称 `ClassNsAll`）。
    //
    // 🔴 为什么接口需要而此前没有：`ClassNsAll` 的两个生产点都只覆盖类（`StubCollector` 的类分支
    // `NoteClassNs`、`ImportedSymbolLoader` 的**类**循环）⇒ **接口的歧义此前完全判不出来**。
    // 而「短名 → FQN」的归一要把「多解」变成响亮错误，就得先有这份数据，
    // 否则只能靠 `Interfaces` 表的 first/last-wins 撞一个赢家出来。
    //
    // ⚠️ **暂不并进 `ClassNsAll`**（并表才合「判据只此一份」的既定纪律）：并表会让
    // `IsBareNameAmbiguous` 立刻对 11 个 prelude 协议名全仓开火。两表合一是阶段 3 的事；
    // 届时 `IsBareIfaceNameAmbiguous` 与 `IsBareNameAmbiguous` 要**一起塌成一个**，别各自漂移。
    public StrMap IfaceNsAll;
    // enforce-fqn-name-identity B1：名义身份 intern 表（见 TypeIntern.z42 抬头）。
    // ⚠️ **必须是对象、按引用共享** —— 做成 SymbolTable 的 int 计数字段的话，
    // `WithAliases` 的每个 per-file 视图会各拷一份计数、分配出**冲突的 id**。
    public TypeIntern Intern;
    // report-crosspkg-duplicate-type：**FQN → 声明它的全部依赖包名**（值 StrBox，"|" 连接）。
    // 与 ClassNsAll 同构、但另一根轴：那张表答「同一个短名有几个 ns」（E0456），这张答
    // 「同一个 **FQN** 有几个来源包」（E0601）。两者不可合并 —— 同 FQN 跨包时 ns 完全相同，
    // ClassNsAll 只会记下一条，信息在那里就塌掉了。
    // 只登记**导入**的（由 ImportedSymbolLoader 在 first-wins 守卫之外累积，经 _mergeImports 并入）；
    // 本地那份是否存在改由 ClassesByFqn 的 IsImported 位判（见 ShadowedImportMsg）。
    public StrMap ClassPkgAll;
    // report-crosspkg-duplicate-function：**自由函数名 → 声明它的全部来源**，每条形如 `ns#pkg`
    // （值 StrBox，"|" 连接；`pkg` 为空串 = **本包**声明的那份）。
    //
    // 为什么必须单独存、且必须把 ns 和 pkg 一起存：`Functions` 的键是**裸函数名**（`ExportedFuncZ.Name`
    // 就是 `md.Name`，从来没有 ns 前缀）⇒ 它比类那边还糊——类至少有 `ClassesByFqn`，自由函数
    // **连 FQN 视图都没有**，同名者无论在不在同一个 ns 都撞同一个键、first-wins。
    // 于是三种形状都得靠这张表才判得出来：
    //   ① 同 ns、不同 pkg           → E0601（同 FQN 跨包，谁也选不了）
    //   ② 同 ns、其一为本包（pkg=""）→ E0606（本包遮蔽导入，被遮那份指不了）
    //   ③ 不同 ns、都可见            → E0456（裸名歧义，写限定名可消歧）
    public StrMap FuncOriginAll;
    // ── fix-crosspkg-ns-reachability：依赖契约的三件套（E0497 的判据输入）─────────────
    //
    // 此前「工程必须声明它用到的包」只是一句文档（`collections.md:15`），**没有任何执行**：
    // 实测未声明 `z42.text` 照样能用 `Std.Text`，未声明 `z42.collections` 却崩 —— 差别不在
    // 声明与否，而在该包的命名空间有没有被 `z42.core` 抢先占住（nsMap first-wins）。
    // 那是一条实现细节冒充的规则。这三个字段把它换成真规则。
    //
    // `DeclaredDeps`：manifest `[dependencies]` 的包名集（键=包名，值 "1"）。
    public StrMap DeclaredDeps;
    // `SelfPkg`：本包名（自引用不算跨包依赖）。
    public string SelfPkg;
    // `EnforceDeclaredDeps`：⚠️ **单文件必须为 false**。单文件的合成清单写不出 `[dependencies]`，
    // 而它的契约（`z42 run --help`）是「整个标准库可用」⇒ 对它执行声明检查等于把它废掉。
    // 默认 false：没被 pipeline 显式打开的路径（REPL / 单测 / 裸 emit）行为恒等。
    public bool   EnforceDeclaredDeps;
    // E0497 的「每个缺失包只报一次」去重集（包名 → "1"）。
    // ⚠️ 与上三个字段一起走 `WithAliases` 共享，否则每个文件视图各报一遍。
    internal StrMap _undeclaredSeen;
    // fix-arity-mangle-package-wide：**包级**「同短名有多个 arity」集合（name → "1"）。
    // arity-mangle 的判据必须与符号表同尺度：`Classes` 是 per-package 的，而预扫此前在
    // `StubCollector._passClassStubs`（per-CU）与 `ExportedTypeExtractor._extractCore`（per-CU）
    // 各算一份 ⇒ 「a.z42 的 `Foo` + b.z42 的 `Foo<T>`」两边都不 mangle、撞同一个裸键。
    // 由 SymbolCollector 在**任何** stub 注册之前一次算好，两个生产点都读这里。
    public StrMap MultiArityNames;
    private StrMap _firstArity;   // NoteArities 的中间态：短名 → 首次见到的 arity
    public StrMap CurrentAliases;   // add-type-alias：当前 CU 的文件级类型别名 name → TypeExpr（null=无）；per-CU 设置
    public SymbolTable() {
        this.Classes = new StrMap();
        this.ClassesByFqn = new StrMap();   // fix-type-ref-ns-collision
        this.Interfaces = new StrMap();
        this.FunctionsByFqn = new StrMap();
        this.FuncOverloadsByFqn = new StrMap();   // free-function-overloads
        this.FuncNsAll = new StrMap();
        this.ClassConstraints = new StrMap();
        this.InterfaceConstraints = new StrMap();
        this.EnumTypes = new StrMap();
        this.InterfacesByFqn = new StrMap();   // unify-type-identity-fqn
        this.EnumTypeNs = new StrMap();        // unify-type-identity-fqn
        this.EnumConsts = new StrMap();
        this.Delegates = new StrMap();
        this.ClassNsAll = new StrMap();
        this.IfaceNsAll = new StrMap();   // enforce-fqn-name-identity 阶段 2
        this.Intern = new TypeIntern();   // enforce-fqn-name-identity B1
        this.ClassPkgAll = new StrMap();   // report-crosspkg-duplicate-type
        this.FuncOriginAll = new StrMap();   // report-crosspkg-duplicate-function
        this.DeclaredDeps = new StrMap();    // fix-crosspkg-ns-reachability
        this.SelfPkg = "";
        this.EnforceDeclaredDeps = false;    // ⚠️ 默认关：只有 pipeline 的工程路径显式打开
        this._undeclaredSeen = new StrMap();
        this.MultiArityNames = new StrMap();
        this._firstArity = new StrMap();
        this.CurrentAliases = null;
        this.ScopeNs = "";
        this.ScopeUsings = new string[0];
        this.ScopeUsingCount = 0;
        this.ScopeChain = new string[0];
        this.UseRecorder = null;
        this.DelegateNs = new StrMap();
    }

    // unify-type-identity-fqn：**引用方所在的命名空间**（per-CU 视图私有，与 CurrentAliases 同性质）。
    // 供裸名类型引用按「外围 ns 优先」解析——见 ResolveTypeP 里的 ScopeNs 分支。
    // 根表恒为 ""（不参与解析）；由 TypeChecker / ConstraintChecker 建视图时按 cu.Namespace 设。
    public string ScopeNs;
    // 本 CU 的 `using` ns 集（同为 per-CU 视图私有）。供 IsBareNameAmbiguous 算「可见集」。
    public string[] ScopeUsings;
    public int      ScopeUsingCount;
    // using-csharp-rules：`ScopeNs` 的外围链（由内到外，`NsScope.Chain`）。`_setScope` 时算一次、视图链上继承 ——
    // 解析器热路径上每次现算会多出一次分配。根表恒为空数组。
    public string[] ScopeChain;
    // using-csharp-rules PR-2：本文件「用到的命名空间」记录器。只由 `TypeChecker.Infer` 挂在**本文件的视图**上
    // （视图链上继承），`Infer` 结束即停用 —— 遍历类表、按名字查的 pass 与代码生成期的解析都不记。
    public NsUseRecorder UseRecorder;
    // 用户 delegate 名 → 声明 ns（StrBox）。`Delegates` 只存 `Z42FuncType`、没有 ns，记录用法时要它。
    public StrMap DelegateNs;

    // parallelize-package-compile：per-file 别名视图（线程安全根治）。共享其余 7 个数据字段的
    // 引用（并行段内只读），仅换 CurrentAliases。每个文件的 typecheck/codegen 持自己的视图 →
    // 段内零共享可变（旧代码 `symbols.CurrentAliases = ...` 覆写共享表在并行下会数据竞争）。
    public SymbolTable WithAliases(StrMap aliases) {
        SymbolTable t = new SymbolTable();
        t.Classes = this.Classes;
        t.ClassesByFqn = this.ClassesByFqn;   // fix-type-ref-ns-collision：共享 FQN 视图（并行段内只读）
        t.Interfaces = this.Interfaces;
        t.FunctionsByFqn = this.FunctionsByFqn;   // 共享（并行段内只读）
        t.FuncOverloadsByFqn = this.FuncOverloadsByFqn;   // free-function-overloads：共享（并行段内只读）
        t.FuncNsAll = this.FuncNsAll;
        t.ClassConstraints = this.ClassConstraints;
        t.InterfaceConstraints = this.InterfaceConstraints;
        t.EnumTypes = this.EnumTypes;
        t.InterfacesByFqn = this.InterfacesByFqn;   // unify-type-identity-fqn：共享（并行段内只读）
        t.EnumTypeNs = this.EnumTypeNs;             // unify-type-identity-fqn：共享（并行段内只读）
        t.EnumConsts = this.EnumConsts;
        t.Delegates = this.Delegates;
        t.ClassNsAll = this.ClassNsAll;   // add-bare-name-ambiguity-diagnostic：共享（并行段内只读）
        t.IfaceNsAll = this.IfaceNsAll;   // enforce-fqn-name-identity 阶段 2：共享（并行段内只读）
        t.Intern = this.Intern;           // B1：**必须共享同一实例**（各视图各自分配会撞 id）
        t.ClassPkgAll = this.ClassPkgAll;   // report-crosspkg-duplicate-type：共享（并行段内只读）。⚠️ 漏了这行 = 门恒不响
        t.FuncOriginAll = this.FuncOriginAll;   // report-crosspkg-duplicate-function：同上，漏了这行门就恒不响
        t.DeclaredDeps = this.DeclaredDeps;     // fix-crosspkg-ns-reachability：同上三行，漏了 E0497 就恒不响
        t.SelfPkg = this.SelfPkg;
        t.EnforceDeclaredDeps = this.EnforceDeclaredDeps;
        t._undeclaredSeen = this._undeclaredSeen;   // 共享：去重要跨文件视图生效
        t.MultiArityNames = this.MultiArityNames;   // fix-arity-mangle-package-wide：共享（并行段内只读）
        t.CurrentAliases = aliases;
        t.ScopeNs = this.ScopeNs;   // unify-type-identity-fqn：视图链上继承（调用方随后按 cu 覆写）
        t.ScopeUsings = this.ScopeUsings; t.ScopeUsingCount = this.ScopeUsingCount;
        t.ScopeChain = this.ScopeChain;
        t.UseRecorder = this.UseRecorder;
        t.DelegateNs = this.DelegateNs;
        return t;
    }

    // unify-type-identity-fqn：per-CU 视图（别名 + 引用方 ns 一次设齐）。取代散在各处的
    // `WithAliases(BuildAliases(cu))` —— 那种写法只带别名、不带 ns，是裸名解析撞 ns 赢家的入口。
    public SymbolTable WithCu(CompilationUnit cu) {
        SymbolTable t = this.WithAliases(SymbolTable.BuildAliases(cu));
        t._setScope(cu);
        return t;
    }

    // 只设作用域、**不动别名**。collector 阶段用 —— 那里 CurrentAliases 本就是 null，
    // 借 WithCu 会顺带把别名解析引进收集期，改动面超出本 change（别名在 collector 是否生效是另一件事）。
    public SymbolTable WithScopeOf(CompilationUnit cu) {
        SymbolTable t = this.WithAliases(this.CurrentAliases);
        t._setScope(cu);
        return t;
    }

    // A5b-2d：把另一个 CU 的 `using` 并进本视图（去重）。partial 类型的合并 ClassDecl 用：成员来自多个文件，
    // 代码生成期再解析成员类型名时没有「哪个文件」可言 ⇒ 用各碎片 using 的并集（各碎片同 ns）。
    // 成员类型在收集期已按各自碎片的作用域解析过，这里只是 TYPE 段写 FQN 时的再解析。
    public void AddScopeUsingsOf(CompilationUnit cu) {
        int ui = 0;
        while (ui < cu.DeclCount) {
            if (cu.Decls[ui] is UsingDecl) {
                string nm = (cu.Decls[ui] as UsingDecl).Name;
                bool dup = false;
                int k = 0;
                while (k < this.ScopeUsingCount) { if (this.ScopeUsings[k] == nm) { dup = true; } k = k + 1; }
                if (!dup) {
                    if (this.ScopeUsingCount == this.ScopeUsings.Length) {
                        string[] bigger = new string[this.ScopeUsings.Length * 2 + 1];
                        int z = 0; while (z < this.ScopeUsingCount) { bigger[z] = this.ScopeUsings[z]; z = z + 1; }
                        this.ScopeUsings = bigger;
                    }
                    this.ScopeUsings[this.ScopeUsingCount] = nm; this.ScopeUsingCount = this.ScopeUsingCount + 1;
                }
            }
            ui = ui + 1;
        }
    }

    private void _setScope(CompilationUnit cu) {
        this.ScopeNs = cu.HasNamespace ? cu.Namespace : "";
        this.ScopeChain = NsScope.Chain(this.ScopeNs);
        string[] us = new string[8];
        int un = 0;
        int ui = 0;
        while (ui < cu.DeclCount) {
            if (cu.Decls[ui] is UsingDecl) {
                if (un == us.Length) {
                    string[] bigger = new string[us.Length * 2];
                    int z = 0; while (z < un) { bigger[z] = us[z]; z = z + 1; }
                    us = bigger;
                }
                us[un] = (cu.Decls[ui] as UsingDecl).Name; un = un + 1;
            }
            ui = ui + 1;
        }
        this.ScopeUsings = us; this.ScopeUsingCount = un;
    }


    public static string QualOf(string ns, string name) { return ns == "" ? name : ns + "." + name; }










    // harden-crosspkg-gates：enum 短名 → FQN（`EnumTypeNs` 无记录则退回裸名）。
    // enum 常量读（`Color.Green`）绑成 `BoundLitInt`，**不经任何类型引用检查** ——
    // 想判它的来源包冲突，只能在那条分支上按名字自己算 FQN。
    public string EnumFqn(string name) {
        int at = this.EnumTypeNs.Find(name);
        if (at < 0) { return name; }
        string ns = (this.EnumTypeNs.ValAt(at) as StrBox).Value;
        return ns == "" ? name : ns + "." + name;
    }

    // fix-enum-type-identity（A5b-2b-2）：本地造 enum 类型的**唯一出口**——`Z42ClassType.Enum(name)` + 声明 ns。
    // name 是 `EnumTypes` 的键（裸名，或嵌套 enum 的 `Outer+Inner`）。此前只有 `ResolveTypeP` 的裸名分支
    // 查了 `EnumTypeNs`；嵌套 plusKey 分支与 `E.Member` 常量读（MemberResolver）各自 `Enum(name)` 了事 ⇒
    // Namespace 为空、`Fqn()` 退化成裸名。类型相等按 `Name()` 比，所以类型检查照样过——洞是静默的：
    // 按 FQN 的门（E0601 / E0497 / 规则 2 的 `using` 可见性）在这条轴上是瞎的。
    // （导入侧 `ImportedSymbolLoader._resolveTypeName` 读的是 ImportedSymbols 自己的表，另有一份。）
    public Z42ClassType EnumType(string name) {
        Z42ClassType ect = Z42ClassType.Enum(name);   // make-enum-distinct-type：带 IsEnum 标志
        int at = this.EnumTypeNs.Find(name);
        if (at >= 0) { ect.Namespace = (this.EnumTypeNs.ValAt(at) as StrBox).Value; }
        return ect;
    }






    // fix-arity-mangle-package-wide：把 cu 里 class/struct 的 arity 累积进包级 MultiArityNames。
    // 调用方须在**任何** `_passClassStubs` 之前把全部 CU 都喂一遍（多 CU 路径），
    // 否则先注册的那些 CU 仍会按不完整的信息决定 mangle —— 那正是修前的形状。
    public void NoteArities(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = cu.Decls[i];
            if (d is AttributedDecl) { d = (d as AttributedDecl).Inner; }
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct") {
                    string ar = c.TypeParams.Count.ToString();
                    int at = this._firstArity.Find(c.Name);
                    if (at < 0) { this._firstArity.Put(c.Name, new StrBox(ar)); }
                    else if ((this._firstArity.ValAt(at) as StrBox).Value != ar) {
                        this.MultiArityNames.Put(c.Name, "1");
                    }
                }
            }
            i = i + 1;
        }
    }



    // add-type-alias：扫 CU 的 UsingAliasDecl → name → Target TypeExpr（文件级）。无别名返回 null。
    public static StrMap BuildAliases(CompilationUnit cu) {
        StrMap m = null;
        int i = 0;
        while (i < cu.DeclCount) {
            if (cu.Decls[i] is UsingAliasDecl) {
                UsingAliasDecl a = cu.Decls[i] as UsingAliasDecl;
                if (m == null) { m = new StrMap(); }
                m.Put(a.Name, a.Target);
            }
            i = i + 1;
        }
        return m;
    }

    // ── 基表分流的**唯一判定**（qualified-base-name）──────────────────────────────────
    // 「源码里写下的这个基类型名，指的是接口吗？」是则返回 `Interfaces` 表的查找键（裸短名），
    // 不是则返回 ""（调用方按类处理）。
    //
    // 🔴 **必须只有这一份**。此前判据有两处各写一遍 —— `StubCollector._passClassStubs`（符号层）
    // 与 `ClassDescBuilder._classDesc`（发射层）—— 且两处都直接拿**源码原样串**查 `Interfaces`
    // （键是裸短名）⇒ 限定名一律查不中、被当成基类。两份同错时症状还只是「接口关系丢了」；
    // 一旦**只修一份**，就变成「符号层认得、发射层不认」：`class E : Std.IDisposable, Base`
    // 编译通过而运行期 `VCall: Demo.E.Tag not found`（实测踩过）。同一形状仓里记过多次 ——
    // `_constraintDescs` 抬头那条「writer 与 checker 从此共用同一个判定」就是上一次。
    //
    // 三步回落，顺序有意义：
    //   ① **原样**（调用方已剥 `<...>`）—— 短名写法走这步，与改动前逐字等价、零风险。
    //   ② **限定名 → FQN 视图**（`InterfacesByFqn`；本地由 `_passInterfaces` 写、导入由
    //      `_mergeImportedInterfaces` 并入，**两者都在 `_passClassStubs` 之前完成** ⇒ 可靠）。
    //   ③ 退回裸短名 —— FQN 视图里没有的情形（ns 拼写与 `Fqn()` 不一致等）。
    // ⚠️ 第 ③ 步在「跨 ns 同短名」时可能认错 —— 与全仓短名键同病，不更坏；根治见「推进 FQN 键」。
    public static string InterfaceKeyOf(SymbolTable table, string written) {
        if (table.Interfaces.ContainsKey(written)) { return written; }
        string s = SymbolTable.ShortNameOf(written);
        if (s == written) { return ""; }                       // 非限定名且 ① 未命中 ⇒ 不是接口
        if (table.InterfacesByFqn.ContainsKey(written)) { return s; }
        if (table.Interfaces.ContainsKey(s)) { return s; }
        return "";
    }

    // 取最后一段（`Std.IDisposable` → `IDisposable`）。无点则恒等。
    public static string ShortNameOf(string n) {
        int dot = 0 - 1;
        int i = 0;
        while (i < n.Length) { if (n.CharAt(i) == '.') { dot = i; } i = i + 1; }
        if (dot < 0) { return n; }
        return n.Substring(dot + 1, n.Length - dot - 1);
    }

    // ── 类型查找的四个访问器（`GetClass` / `HasClass` / `GetInterface` / `HasInterface`）──────────────
    // fqn-symbol-key 绞杀者三步走完：步 1 双键（FQN 优先、短名回落）→ 步 2 名字数组与声明键翻 FQN →
    // 步 3 探针清掉残留短名调用方、删回落支（A5b-2c）。现在四个都走作用域感知的解析
    // （外围 ns 链 → FQN → using → prelude），**不再查短名表**。`Classes` / `Interfaces` 这两张短名表
    // 仍在（遍历、arity-mangle 探测、诊断里的「同短名几份」等直接读它们的用途），只是不再参与按名解析。
    // 接口名 → 它的 **FQN**（interface-names-fqn 的唯一归一出口）。查不到就原样返回 ——
    // 型参名 / 未解析名 / 还没进表的东西都走这条，交给别处报错，这里不猜。
    // 双键 `GetInterface` 让本函数**幂等**：喂 FQN 进来仍得同一个 FQN。
    public static string IfaceFqnOf(SymbolTable table, string name) {
        // 🔴 **必须容忍 null**：`InterfaceNames` 里实测存在 `i < InterfaceCount` 却为 null 的槽
        // （导入侧 `nct.InterfaceNames = cl.Interfaces` 直接接管数组、长度与 count 不一定对齐）。
        // 而 `GetInterface(null)` 会一路走到 `StrMap.Find` → `null.GetHashCode()` ⇒ **SIGSEGV**
        // （不是可捕获的 NullReferenceException），栈顶停在 `String.GetHashCode`、离真因很远。
        if (name == null) { return name; }
        Z42InterfaceType it = table.GetInterface(name);
        if (it == null) { return name; }
        return it.Fqn();
    }

    // A5b-2c：三个访问器与 `GetClass` 同口径 —— 都走作用域感知的解析（外围链 → FQN → using → prelude）。
    // 此前它们是「FQN 不中就查裸名表」，**没有作用域这一层**，裸名表在替它们兜「外围 ns 的短名」。
    // 改口径前探针实测（stdlib + 编译器全量）：三者在带作用域的视图上与旧答案**零分歧**。
    public bool HasClass(string name) { return this._resolveClass(name) != null; }
    public bool HasInterface(string name) { return this._resolveIface(name) != null; }
    public Z42InterfaceType GetInterface(string name) { return this._resolveIface(name); }

    // class（含 base 链）是否实现接口（可赋性 class→iface）。
    //
    // 两层遍历：① 沿类的 base 链收集各层**直接**接口名；② 对收集到的每个接口再沿其
    // **父接口链**展开（complete-where-constraints PR-1）。此前只有 ①——
    // `interface IDerived : IBase` + `class C : IDerived` 时 `Implements("C","IBase")` 返回
    // **false**，因为传递闭包只在 IR 发射期由 `ClassDescBuilder._expandIfaces` 算、不在符号表里。
    //
    // 注意不对称：**导入类型不受此影响**——生产端写进 zbc 的已是 `_expandIfaces` 后的传递闭包，
    // 导入类的接口名单比本地类还全。缺口只伤本地类，故 ② 是补齐而非改变导入侧语义。

    public Z42Type ResolveType(TypeExpr te) {
        return this.ResolveTypeP(te, new string[0], 0);
    }

    // using-csharp-rules PR-2：记一次「本文件用到了 ns」（视图挂了记录器才记）。
    public void NoteUse(string ns) {
        if (this.UseRecorder != null) { this.UseRecorder.Note(ns); }
    }

    // 带活跃类型形参（泛型类/方法 scope）：名字命中 paramNames → Z42GenericParamType。
    // using-csharp-rules PR-2：外壳 —— 解析交给 `_resolveTypePCore`，再按结果记「用到的 ns」。核心里递归解析
    // 泛型实参 / 数组元素 / 可空内层时走回本外壳，所以嵌套的类型引用也都记到。
    public Z42Type ResolveTypeP(TypeExpr te, string[] paramNames, int paramCount) {
        Z42Type r = this._resolveTypePCore(te, paramNames, paramCount);
        if (this.UseRecorder != null && te is NamedType) { this._noteTypeUse(te as NamedType, r); }
        return r;
    }

    // 只看**用户写的**具名类型：合成的跳过；别名跳过（C#：`using Id = 全限定名;` 的目标不需要另写 using，
    // 解析目标时 `_resolveTypePCore` 已暂停记录）。
    private void _noteTypeUse(NamedType nt, Z42Type r) {
        if (nt.Synthetic) { return; }
        if (this.CurrentAliases != null && nt.ArgCount == 0 && this.CurrentAliases.Find(nt.Name) >= 0) { return; }
        if (r is Z42InstantiatedType) {
            Z42ClassType d = (r as Z42InstantiatedType).Def;
            if (d != null) { this.NoteUse(d.Namespace); }
            return;
        }
        if (r is Z42ClassType) { this.NoteUse((r as Z42ClassType).Namespace); return; }
        if (r is Z42InterfaceType) { this.NoteUse((r as Z42InterfaceType).Namespace); return; }
        if (r is Z42FuncType) {
            string dk = nt.Name;
            if (this.DelegateNs.Find(dk) < 0) { dk = dk.Replace(".", "+"); }   // 嵌套 delegate 的 `+` 键
            int at = this.DelegateNs.Find(dk);
            if (at >= 0) { this.NoteUse((this.DelegateNs.ValAt(at) as StrBox).Value); }
        }
    }

    private Z42Type _resolveTypePCore(TypeExpr te, string[] paramNames, int paramCount) {
        if (te is ResolvedTypeExpr) { return (te as ResolvedTypeExpr).Resolved; }   // add-implicit-base-ctor-call：合成声明已解析的形参类型
        if (te is NamedType) {
            NamedType nt = te as NamedType;
            string n = nt.Name;
            int i = 0;
            while (i < paramCount) {
                if (paramNames[i] == n) { return new Z42GenericParamType(n); }
                i = i + 1;
            }
            // add-type-alias：文件级别名替换（裸名、0 类型实参）。类型形参优先（上），别名次之。
            // 解析目标（可含泛型实参 / 再引别名 → 递归）。
            if (this.CurrentAliases != null && nt.ArgCount == 0) {
                int _as = this.CurrentAliases.Find(n);
                if (_as >= 0) {
                    TypeExpr target = this.CurrentAliases.ValAt(_as) as TypeExpr;
                    if (target != null) {
                        // using-csharp-rules PR-2：别名目标是全限定写法，不计入「用到的 ns」（C# 同款）。
                        if (this.UseRecorder != null) { this.UseRecorder.Suspend = this.UseRecorder.Suspend + 1; }
                        Z42Type ar = this.ResolveTypeP(target, paramNames, paramCount);
                        if (this.UseRecorder != null) { this.UseRecorder.Suspend = this.UseRecorder.Suspend - 1; }
                        return ar;
                    }
                }
            }
            if (n == "void") { return new Z42VoidType(); }
            // `var` 是推断哨兵、非类型名——返回**匿名** Unknown（不携名），使字段级 `var`
            // （`public static var x = ...`，经 SymbolCollector._chkTypeRef）不被误报 E0443。
            // 真实类型由初始化器推断在后续相位填充。局部 `var` 另在 StmtBinder._varType 前置过滤。
            // （fix-undefined-type-diagnostic：局部 var 已过滤，但字段 var 走收集期 choke point 须在此挡。）
            if (n == "var") { return new Z42UnknownType(); }
            if (this._isPrim(n)) { return this.BuiltinType(n); }
            // Func/Action/Predicate → 结构 Z42FuncType（port-z42c-closures D1；C# 经委托注册表但产物同构）
            if (n == "Func" && nt.ArgCount > 0) {
                Z42Type[] fps = new Z42Type[nt.ArgCount - 1];
                int fa = 0;
                while (fa < nt.ArgCount - 1) { fps[fa] = this.ResolveTypeP(nt.Args[fa], paramNames, paramCount); fa = fa + 1; }
                return new Z42FuncType(fps, nt.ArgCount - 1, this.ResolveTypeP(nt.Args[nt.ArgCount - 1], paramNames, paramCount));
            }
            if (n == "Action") {
                Z42Type[] aps = new Z42Type[nt.ArgCount];
                int aa = 0;
                while (aa < nt.ArgCount) { aps[aa] = this.ResolveTypeP(nt.Args[aa], paramNames, paramCount); aa = aa + 1; }
                return new Z42FuncType(aps, nt.ArgCount, new Z42VoidType());
            }
            if (n == "Predicate" && nt.ArgCount == 1) {
                Z42Type[] pps = new Z42Type[1];
                pps[0] = this.ResolveTypeP(nt.Args[0], paramNames, paramCount);
                return new Z42FuncType(pps, 1, Z42ClassType.Builtin("bool"));
            }
            if (this.EnumTypes.ContainsKey(n)) { return this.EnumType(n); }   // unify-type-identity-fqn：enum 也进 FQ 身份体系
            int _sl0 = this.Delegates.Find(n); if (_sl0 >= 0) { return this.Delegates.ValAt(_sl0) as Z42FuncType; }   // 用户 delegate → 函数类型
            // add-associated-types PR-3：泛型接口引用 `IFoo<int>` 解析成**实例化接口类型**，把类型
            // 实参带上。此前这里恒返回裸 `Z42InterfaceType`、`nt.Args` 整条丢弃 —— 那正是「接口约束
            // 只比裸名」（Deferred where-constraint-future-type-arg-matching）在类型模型层面的根。
            // ⚠️ `Z42InstantiatedInterfaceType` 是 `Z42InterfaceType` 的**子类**且 `Name()` 仍返回
            // 裸名 ⇒ 既有全部 `is/as Z42InterfaceType` 路径与元数据拼写**逐字节不变**（见该类注释）。
            // unify-type-identity-fqn：接口同款「外围 ns 优先」（理由见下方 Classes 分支的长注释）。
            int _ich = 0;
            while (_ich < this.ScopeChain.Length) {   // using-csharp-rules：外围链由内到外
                string ifq = this.ScopeChain[_ich] + "." + n;
                if (this.InterfacesByFqn.ContainsKey(ifq)) {
                    Z42InterfaceType sift = this.InterfacesByFqn.Get(ifq) as Z42InterfaceType;
                    if (nt.ArgCount > 0) {
                        Z42Type[] sitargs = new Z42Type[nt.ArgCount];
                        int sia = 0;
                        while (sia < nt.ArgCount) { sitargs[sia] = this.ResolveTypeP(nt.Args[sia], paramNames, paramCount); sia = sia + 1; }
                        return new Z42InstantiatedInterfaceType(sift, sitargs, nt.ArgCount);
                    }
                    return sift;
                }
                _ich = _ich + 1;
            }
            // A5b-2d：再走完整的作用域解析（FQN → using → prelude；与 `GetInterface` 同一出口）。此前这里只有
            // 「外围链 → 短名表」两步 ⇒ 凡经 `using` / prelude 引入的接口名都靠短名表 first-wins 赢家兜着，
            // 同短名跨 ns 时可能答错；限定写法 `D.IF` 也只能剥成短名再撞（下方 G19b）。
            Z42InterfaceType sci = this._resolveIface(n);
            if (sci != null) {
                if (nt.ArgCount > 0) {
                    Z42Type[] scargs = new Z42Type[nt.ArgCount];
                    int sca = 0;
                    while (sca < nt.ArgCount) { scargs[sca] = this.ResolveTypeP(nt.Args[sca], paramNames, paramCount); sca = sca + 1; }
                    return new Z42InstantiatedInterfaceType(sci, scargs, nt.ArgCount);
                }
                return sci;
            }
            // A5b-2d：接口的短名表回落已删 —— 上面的作用域解析不中 = 本作用域看不见它。

            // arity-mangle：泛型实例化 `C<T...>` 对 arity-overloaded 同名类（arity-0 base
            // shadow 着 arity-N 泛型，泛型版注册键 `Name$N`，如 MulticastException$1）须取 `Name$N`，
            // 否则误取 arity-0 base → new/throw 出非泛型 base，catch `C<int>` 失配。镜像
            // TypeChecker arity-mangle 取 CT。非 overloaded 泛型（如 Box<T>，仅注册 bare）未命中
            // `Name$N` → 回退 bare，不受影响。
            // unify-type-identity-fqn：**外围命名空间优先**（C# 作用域规则：enclosing ns 胜过 usings）。
            // 裸名类走下方 `Classes` 是按裸名键、同短名跨 ns **first/last-wins** ⇒ `namespace Alpha`
            // 里写的 `Widget` 可能绑到 `Beta.Widget`。fix-type-ref-ns-collision 当年只根治了**限定**
            // 引用（ClassesByFqn），裸名至今仍撞赢家 —— 以前没人把解析结果持久化，所以只表现为运行期
            // 降级；一旦把它写进元数据就变成「自信的错答案」（实测：HolderA.w 被写成 Beta.Widget）。
            // 只在外围 ns **确实声明了该名字**时改道 —— 那种情形按语言规则本就无歧义，不会误伤。
            int _cch = 0;
            while (_cch < this.ScopeChain.Length) {   // using-csharp-rules：外围链由内到外，最内层胜出
                string _lvl = this.ScopeChain[_cch];
                _cch = _cch + 1;
                if (nt.ArgCount > 0) {
                    string sfqm = _lvl + "." + n + "$" + nt.ArgCount.ToString();
                    string sfqb = _lvl + "." + n;
                    string sfq = this.ClassesByFqn.ContainsKey(sfqm) ? sfqm : sfqb;
                    if (this.ClassesByFqn.ContainsKey(sfq)) {
                        Z42ClassType sdef = this.ClassesByFqn.Get(sfq) as Z42ClassType;
                        Z42Type[] stargs = new Z42Type[nt.ArgCount];
                        int sa = 0;
                        while (sa < nt.ArgCount) { stargs[sa] = this.ResolveTypeP(nt.Args[sa], paramNames, paramCount); sa = sa + 1; }
                        return new Z42InstantiatedType(sdef, stargs, nt.ArgCount);
                    }
                } else {
                    string sfq0 = _lvl + "." + n;
                    if (this.ClassesByFqn.ContainsKey(sfq0)) { return this.ClassesByFqn.Get(sfq0) as Z42ClassType; }
                }
            }
            // A5b-2d：类同款 —— 完整作用域解析（与 `GetClass` 同一出口），短名表退到最后。泛型先试 arity-mangle 键。
            Z42ClassType scc = null;
            if (nt.ArgCount > 0) { scc = this._resolveClass(n + "$" + nt.ArgCount.ToString()); }
            if (scc == null) { scc = this._resolveClass(n); }
            if (scc != null) {
                if (nt.ArgCount > 0) {
                    Z42Type[] sctargs = new Z42Type[nt.ArgCount];
                    int sct = 0;
                    while (sct < nt.ArgCount) { sctargs[sct] = this.ResolveTypeP(nt.Args[sct], paramNames, paramCount); sct = sct + 1; }
                    return new Z42InstantiatedType(scc, sctargs, nt.ArgCount);
                }
                return scc;
            }
            // A5b-2d：类的短名表回落（arity-mangle 键 / 裸名）已删 —— 同上。

            // add-nested-types：嵌套类型 `Outer.Inner`（点串）→ `+` 键（展平已按 `Outer+Inner` 短键注册）。
            // 只命中真注册的嵌套键；namespace-qualified（`Std.Console`→`Std+Console` 未注册）自然跳过、
            // 落到下方限定名回退。任意深度（`A.B.C`→`A+B+C`）。
            if (n.IndexOf(".") >= 0) {
                // fix-type-ref-ns-collision：限定名优先按 FQN 精确解析（`A.Foo` → 声明 ns==A 的那份 Foo），
                // 不再剥短名撞裸名 Classes 的 first/last-wins 赢家（曾致 `new A.Foo` 绑到 B.Foo）。泛型
                // `A.Foo<T>` 用 FQN$N 键。只命中显式注册的 ns 限定顶层类；嵌套类型（`+` 键）自然不匹配、下落。
                if (nt.ArgCount > 0) {
                    string fqMangle = n + "$" + nt.ArgCount.ToString();
                    if (this.ClassesByFqn.ContainsKey(fqMangle)) {
                        Z42ClassType fgdef = this.ClassesByFqn.Get(fqMangle) as Z42ClassType;
                        Z42Type[] fta = new Z42Type[nt.ArgCount];
                        int fa = 0;
                        while (fa < nt.ArgCount) { fta[fa] = this.ResolveTypeP(nt.Args[fa], paramNames, paramCount); fa = fa + 1; }
                        return new Z42InstantiatedType(fgdef, fta, nt.ArgCount);
                    }
                }
                if (this.ClassesByFqn.ContainsKey(n)) {
                    Z42ClassType fdef = this.ClassesByFqn.Get(n) as Z42ClassType;
                    if (nt.ArgCount > 0) {
                        Z42Type[] fta2 = new Z42Type[nt.ArgCount];
                        int fa2 = 0;
                        while (fa2 < nt.ArgCount) { fta2[fa2] = this.ResolveTypeP(nt.Args[fa2], paramNames, paramCount); fa2 = fa2 + 1; }
                        return new Z42InstantiatedType(fdef, fta2, nt.ArgCount);
                    }
                    return fdef;
                }
                string plusKey = n.Replace(".", "+");
                if (this.EnumTypes.ContainsKey(plusKey)) { return this.EnumType(plusKey); }   // make-enum-distinct-type：嵌套 enum 同款
                Z42InterfaceType pift = this._resolveIface(plusKey); if (pift != null) { return pift; }   // A5b-2d：嵌套键也走作用域解析
                // fix-nested-delegate-decl（bug B1）：嵌套 delegate `Outer.Inner` → `Outer+Inner` 键。
                // 与上面嵌套 enum / 接口的 plusKey 兜底同款（NestedFlatten 已按 `+` 名注册）。
                int _sld = this.Delegates.Find(plusKey); if (_sld >= 0) { return this.Delegates.ValAt(_sld) as Z42FuncType; }
                if (nt.ArgCount > 0) {
                    string pm = plusKey + "$" + nt.ArgCount.ToString();
                    Z42ClassType pgdef = this._resolveClass(pm);   // A5b-2d：同上
                    if (pgdef != null) {
                        Z42Type[] pta = new Z42Type[nt.ArgCount];
                        int pa = 0;
                        while (pa < nt.ArgCount) { pta[pa] = this.ResolveTypeP(nt.Args[pa], paramNames, paramCount); pa = pa + 1; }
                        return new Z42InstantiatedType(pgdef, pta, nt.ArgCount);
                    }
                }
                Z42ClassType pdef = this._resolveClass(plusKey);   // A5b-2d：同上
                if (pdef != null) {
                    if (nt.ArgCount > 0) {
                        Z42Type[] pta2 = new Z42Type[nt.ArgCount];
                        int pa2 = 0;
                        while (pa2 < nt.ArgCount) { pta2[pa2] = this.ResolveTypeP(nt.Args[pa2], paramNames, paramCount); pa2 = pa2 + 1; }
                        return new Z42InstantiatedType(pdef, pta2, nt.ArgCount);
                    }
                    return pdef;
                }
            }
            // 限定名回退（G19b：`X.Y` 剥成最后一段 `Y` 再查短名表）—— A5b-2d 已删：限定名由上方 FQN 精确查找承接；
            // 剥短名再撞短名表会把写错前缀的 `Foo.Bar` 绑到任意一个 `Bar`。
            // 具名 NamedType 全解析路径未命中 → 真未定义类型（imported 类已经 SymbolCollector
            // 进 table.Classes 命中上方；泛型形参/别名/void/prim 亦已前置返回）。携名 → E0443。
            Z42UnknownType un = new Z42UnknownType();
            un.UnresolvedName = n;
            return un;
        }
        if (te is ArrayType) {
            ArrayType at = te as ArrayType;
            return new Z42ArrayType(this.ResolveTypeP(at.Elem, paramNames, paramCount));
        }
        if (te is NullableType) {
            NullableType nt = te as NullableType;
            return this.ResolveTypeP(nt.Inner, paramNames, paramCount);   // nullable → inner（Option 延后）
        }
        if (te is FuncTypeExpr) {                                          // `(T,...) -> R` → Z42FuncType
            FuncTypeExpr ft = te as FuncTypeExpr;
            Z42Type[] fps = new Z42Type[ft.ParamCount];
            int fi = 0;
            while (fi < ft.ParamCount) { fps[fi] = this.ResolveTypeP(ft.Params[fi], paramNames, paramCount); fi = fi + 1; }
            return new Z42FuncType(fps, ft.ParamCount, this.ResolveTypeP(ft.Ret, paramNames, paramCount));
        }
        return new Z42UnknownType();
    }

    // unify-value-types Phase 1（D1 翻转）：基元关键字 → 符号表里已存在的 `Std.*` phantom struct
    // 的 Z42ClassType（int→Int32、bool→Boolean、string→String、object→Object…；byte/short/... 经
    // PrimModel.Wrapper 归到对应 wrapper）。使基元与用户 struct 走同一 Z42ClassType 承载（消灭二元）。
    // 名承载 wrapper 短名（"Int32"）；可赋性/拓宽经中心化 PrimModel.Canon(=PrimModel.Canon) 归一，
    // IR 标签经 ToIrType 的 IsBuiltin 分支保留（Scalar→PrimTag、string→Str、object→Ref）。
    // 兜底：phantom 未加载（无 prelude 的独立上下文）→ 退回轻量 Z42PrimType（阶段 3 删类后此兜底移除）。
    public Z42Type BuiltinType(string n) {
        string wrap = PrimModel.Wrapper(n);
        if (this.Classes.ContainsKey(wrap)) {
            object c = this.Classes.Get(wrap);
            if (c is Z42ClassType) { return c as Z42ClassType; }
        }
        return Z42ClassType.Builtin(PrimModel.Canon(n));
    }

    // drop-short-primitive-aliases：`_canonPrim`（byte→u8 等次要名归一）已删 —— canonical 名现在
    // **就是**关键字拼写，归一退化成恒等，直接走 `PrimModel.Canon`（它还顺带剥 `?` / `Std.` 前缀）。

    private bool _isPrim(string n) {
        if (n == "int" || n == "long" || n == "short" || n == "byte" || n == "sbyte") { return true; }
        if (n == "uint" || n == "ulong" || n == "ushort") { return true; }
        if (n == "double" || n == "float" || n == "bool" || n == "char" || n == "string" || n == "object") { return true; }
        return false;
    }
}
