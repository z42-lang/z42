// 语义 dump 工具（port-z42c-semantics 1A-4b）。源 → 类型检查 → bound s-expr / 诊断计数。
// 供 driver `--dump-bound`（后续）+ [Test]。纯函数（内部建临时 DiagnosticBag）。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.Core;
using Z42.IR;

public static class SemanticDump {
    // ── 诊断口径的单一来源（fix-semanticdump-drops-collector-diags）──────────────
    //
    // 🔴 这里此前有个安静的洞：每个入口各自 `new SymbolCollector().Collect(cu)`，随即**丢掉**
    // 那个 collector 的 `Diags`，只把 TypeChecker 的诊断收进新建的 bag。可 `_chkTypeRef` 发出的
    // 未定义类型 E0443 恰恰在 **collector 相位**——方法返回类型 / 形参类型 / 字段类型 / 基类表
    // 这些**声明签名位置**全归它管。结果：签名位置写任何未定义类型，`FirstErrorCode` 都返回 ""。
    //
    // 后果不是「少报一条」，而是**一整类单测静默失效**：凡以「签名位置写坏类型应当报错」为断言的
    // 用例，无论实现对错都恒绿 = 空测试。add-associated-types PR-2 为 `Self` 写的头一批用例
    // 就整批撞上（把支持改动全退回后仍 7/7 全绿），这才把洞挖出来。
    //
    // 修法即本函数：**合并 collector 的 Diags**，并让 6 个入口共用同一条口径，不再各写各的
    // ——原来那 6 份复制粘贴的 preamble 正是「其中一份忘了合并」能长期不被发现的土壤。
    // 合并序 = parse → collector → typecheck（相位序），故 `FirstErrorCode` 取到的仍是**最早**那条。
    private static DiagnosticBag _diags(CompilationUnit cu) {
        var diags = new DiagnosticBag();
        SemanticDump._model(cu, diags);
        return diags;
    }

    // 同上，但把 bound 模型也带出来（DumpBody / DumpAll 用）。诊断合并逻辑只此一处。
    private static SemanticModel _model(CompilationUnit cu, DiagnosticBag diags) {
        var sc = new SymbolCollector();
        var symbols = sc.Collect(cu);
        cu.MergeParseDiags(diags);   // fix-parse-diags-dropped：parse 错误计入编译错误
        diags.MergeFrom(sc.Diags);   // 收集期诊断（签名位置的 E0443 等）——曾整批被丢弃
        return new TypeChecker(diags).Infer(cu, symbols);
    }

    // 导出类型签名（TSIG 形态）确定性 dump：每类 `Name(Base) F:[n:t(s?),...] M:[n(/flags)?,...]`。
    // flags：s=static / v=virtual / a=abstract。验证继承字段展开 + 方法合并序 + override flags（G18 回归守护）。
    public static string DumpExports(string src) {
        ExportedModuleZ em = IrDump.ExtractExports(src, "t.z42", "");
        string s = "";
        int i = 0;
        while (i < em.ClassCount) {
            ExportedClassZ c = em.Classes[i];
            if (i > 0) { s = s + "\n"; }
            s = s + c.Name + "(" + c.BaseName + ") F:[";
            int f = 0;
            while (f < c.FieldCount) {
                if (f > 0) { s = s + ","; }
                ExportedFieldZ fd = c.Fields[f];
                s = s + fd.Name + ":" + fd.TypeName;
                if (fd.IsStatic) { s = s + "(s)"; }
                f = f + 1;
            }
            s = s + "] M:[";
            int m = 0;
            while (m < c.MethodCount) {
                if (m > 0) { s = s + ","; }
                ExportedMethodZ md = c.Methods[m];
                s = s + md.Name;
                string fl = "";
                if (md.IsStatic)   { fl = fl + "s"; }
                if (md.IsVirtual)  { fl = fl + "v"; }
                if (md.IsAbstract) { fl = fl + "a"; }
                if (fl != "") { s = s + "/" + fl; }
                m = m + 1;
            }
            s = s + "]";
            i = i + 1;
        }
        return s;
    }

    // 指定类方法的 TSIG 导出返回类型名（G18d 守护：方法签名类型规范化 byte[]→u8[]）。
    public static string ExportMethodRet(string src, string className, string methodName) {
        ExportedModuleZ em = IrDump.ExtractExports(src, "t.z42", "");
        int i = 0;
        while (i < em.ClassCount) {
            ExportedClassZ c = em.Classes[i];
            if (c.Name == className) {
                int m = 0;
                while (m < c.MethodCount) {
                    if (c.Methods[m].Name == methodName) { return c.Methods[m].ReturnType; }
                    m = m + 1;
                }
            }
            i = i + 1;
        }
        return "?";
    }

    // 指定类字段的 TSIG 导出类型名（字段仍用源拼写 byte[]，区别于方法签名）。
    public static string ExportFieldType(string src, string className, string fieldName) {
        ExportedModuleZ em = IrDump.ExtractExports(src, "t.z42", "");
        int i = 0;
        while (i < em.ClassCount) {
            ExportedClassZ c = em.Classes[i];
            if (c.Name == className) {
                int f = 0;
                while (f < c.FieldCount) {
                    if (c.Fields[f].Name == fieldName) { return c.Fields[f].TypeName; }
                    f = f + 1;
                }
            }
            i = i + 1;
        }
        return "?";
    }

    // 指定类的 TYPE 段（IrClassDesc）字段类型名（G18g 守护：TYPE 字段源拼写 byte[]，非规范 u8[]）。
    public static string TypeFieldName(string src, string className, string fieldName) {
        IrModule irm = IrDump.BuildModule(src, "t.z42");
        int i = 0;
        while (i < irm.ClassCount) {
            IrClassDesc c = irm.Classes[i];
            if (c.Name == className || (className.Length > 0 && c.Name.EndsWith("." + className))) {
                int f = 0;
                while (f < c.FieldCount) {
                    if (c.Fields[f].Name == fieldName) { return c.Fields[f].Type; }
                    f = f + 1;
                }
            }
            i = i + 1;
        }
        return "?";
    }

    // 指定 key（"Class.Method" / 顶层函数名）的方法体 bound s-expr。
    public static string DumpBody(string src, string key) {
        var p = new Parser(src, "<input>");
        var cu = p.ParseCompilationUnit();
        var diags = new DiagnosticBag();
        var model = SemanticDump._model(cu, diags);
        if (model.HasBody(key)) { return model.GetBody(key).Dump(); }
        return "(no-body " + key + ")";
    }

    // 全部方法体 bound s-expr（driver `--dump-bound`）：每行 `key: <bound>`，末附错误数。
    public static string DumpAll(string src) {
        var p = new Parser(src, "<input>");
        var cu = p.ParseCompilationUnit();
        var diags = new DiagnosticBag();
        var model = SemanticDump._model(cu, diags);
        string[] keys = model.Bodies.Keys();
        string s = "";
        int i = 0;
        while (i < keys.Length) {
            if (i > 0) { s = s + "\n"; }
            s = s + keys[i] + ": " + model.GetBody(keys[i]).Dump();
            i = i + 1;
        }
        int ec = diags.ErrorCount();
        if (ec > 0) {
            if (s != "") { s = s + "\n"; }
            s = s + "(" + ec.ToString() + " error(s))";
        }
        return s;
    }

    // 首条诊断的 "line:col"（span 链验证；无诊断 → ""）。
    public static string FirstErrorPos(string src) {
        var p = new Parser(src, "<input>");
        DiagnosticBag diags = SemanticDump._diags(p.ParseCompilationUnit());
        if (diags.Count() == 0) { return ""; }
        Diagnostic d = diags.Get(0);
        return d.Span.Line.ToString() + ":" + d.Span.Column.ToString();
    }

    // 首条诊断的错误码（错误用例精确断言，如 E0426；无诊断 → ""）。
    public static string FirstErrorCode(string src) {
        var p = new Parser(src, "<input>");
        DiagnosticBag diags = SemanticDump._diags(p.ParseCompilationUnit());
        if (diags.Count() == 0) { return ""; }
        return diags.Get(0).Code;
    }

    // 首条诊断的消息文本（错误用例断言消息内容用，如 add-user-conversions ③ 的走中间类型提示）。
    public static string FirstErrorMessage(string src) {
        var p = new Parser(src, "<input>");
        DiagnosticBag diags = SemanticDump._diags(p.ParseCompilationUnit());
        if (diags.Count() == 0) { return ""; }
        return diags.Get(0).Message;
    }

    // 类型检查诊断错误条数（错误用例断言）。
    public static int ErrorCount(string src) {
        var p = new Parser(src, "<input>");
        DiagnosticBag diags = SemanticDump._diags(p.ParseCompilationUnit());
        return diags.ErrorCount();
    }
}
