// 字段/成员/元素 访问 + 赋值 + struct 值语义机制 lowering（CG-1E follow-up：从 ExprEmitter
// 按职责抽出）。承载 Bound{Assign,Member,Index,StaticGet} → IR，以及 blob 值 struct 的字段
// get/set、内联字段链偏移解析、跨帧字节 blob 拷贝（_copyRegion）等值语义机制——它们是 assign/
// member/index 访问的共同底座，聚在一处，内部互调不外泄。共享 EmitContext（与 ExprEmitter 同一
// ctx）；递归 .Emit()、struct 谓词（_isBlobStruct/_blobStructName/_receiverClassType）、cast-Unknown
// 链判定与 tag→IrType 映射（_tagToIrType）经父反向引用 _ee 委回 ExprEmitter 中心工具。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;
using Z42.IR.BinaryFormat;

public sealed class AccessEmitter {
    private EmitContext _ctx;
    private ExprEmitter _ee;   // 反向引用：递归 .Emit() + struct 谓词/cast 链/tag 映射委回 ExprEmitter

    public AccessEmitter(EmitContext ctx, ExprEmitter ee) { this._ctx = ctx; this._ee = ee; }

    // 赋值：local（copy 回写）/ 裸字段（field_set reg0）/ obj.field（field_set obj）/ arr[i]（array_set）。
    internal TypedReg _emitAssign(BoundAssign a) {
        TypedReg val = this._ee.Emit(a.Value);
        // 限定静态字段赋值 `Class.staticField = v`（LHS 绑为 BoundStaticGet）→ static_set。
        // 否则落到末尾 return val 静默丢弃 → 静态字段 mutation 不持久（Log.SetMinLevel 等）。
        // 镜像 static_get 发射（QualifyClass + "." + Field）+ __static_init__ 的 StaticSetInstr。
        if (a.Target is BoundStaticGet) {
            BoundStaticGet st = a.Target as BoundStaticGet;
            TypedReg sv = this._boxIfStaticStruct(val, st.Type());   // add-static-struct-bytecization：struct 字段整写 → 装箱盒
            this._ctx.Emit(new StaticSetInstr(this._ctx.QualifyClass(st.ClassName) + "." + st.FieldName, sv));
            return val;
        }
        if (a.Target is BoundIdent) {
            BoundIdent tid = a.Target as BoundIdent;
            if (this._ctx.Locals.ContainsKey(tid.Name)) {
                TypedReg existing = this._ctx.Locals.Get(tid.Name) as TypedReg;
                if (existing.Id != val.Id) {
                    // A-use：blob 值 struct 局部整体赋值 `b = a` → StructCopy（值语义，b/a 均已是 blob 句柄）。
                    if (this._ee._isBlobStruct(a.Target.Type())) {
                        int scsize = this._ctx.Gen.Layouts.StructSize(this._ee._blobStructName(a.Target.Type()));
                        this._ctx.Emit(new StructCopyInstr(existing, val, scsize));
                    } else {
                        this._ctx.Emit(new CopyInstr(existing, val));
                    }
                }
                return existing;
            }
            if (this._ctx.Fields.ContainsKey(tid.Name)) {
                // A-use：所属类是 blob 值 struct → 裸字段（`this.f`）写翻转为 StructFieldSetPrim(reg0=句柄)。
                if (this._ctx.OwnerStructName != "") {
                    // add-struct-nested-fields：裸 owner struct 字段整写（`a = p;`）→ 逐叶子复制 val 进 this@off。
                    if (this._ctx.Gen.Layouts.FieldIsStruct(this._ctx.OwnerStructName, tid.Name)) {
                        string fs = this._ctx.Gen.Layouts.FieldTypeName(this._ctx.OwnerStructName, tid.Name);
                        int foff = this._ctx.Gen.Layouts.FieldByteOffset(this._ctx.OwnerStructName, tid.Name);
                        this._copyRegion(val, 0, new TypedReg(0, IrType.Ref), foff, fs);
                        return val;
                    }
                    this._emitStructFieldSet(this._ctx.OwnerStructName, tid.Name, new TypedReg(0, IrType.Ref), val);
                    return val;
                }
                // add-struct-heap-inline (P3b)：裸内联 struct 字段整写（`pt = other`，class C 方法内）→ 逐叶子
                // 把 val(blob) 拷进 this 对象 struct_bytes@off（值语义）。裸叶子 `pt.x=v` 由 _emitBlobFieldSet 处理。
                if (this._isOwnerInlineField(tid)) {
                    string fs = this._ee._blobStructName(tid.Type());
                    int foff = this._ctx.Gen.Layouts.InlineFieldByteOffset(this._ctx.OwnerClassName, tid.Name);
                    this._copyRegion(val, 0, new TypedReg(0, IrType.Ref), foff, fs);
                    return val;
                }
                this._ctx.Emit(new FieldSetInstr(new TypedReg(0, IrType.Ref), tid.Name, val));
                return val;
            }
            // local 首次赋值（无 init 声明 `T m;` 后 `m = rhs`）：镜像 C# WriteBackName
            // —— 分配专用寄存器 + copy（而非直接把 local 绑到 rhs 寄存器）。否则 m 复用
            // rhs 寄存器 → 比 C# 少一条 copy + 少一个寄存器（z42c.semantics MODS 实证 −14B）。
            TypedReg varReg = this._ctx.Alloc(val.Type);
            this._ctx.Locals.Put(tid.Name, varReg);
            if (varReg.Id != val.Id) { this._ctx.Emit(new CopyInstr(varReg, val)); }
            return varReg;
        }
        if (a.Target is BoundMember) {
            BoundMember tm = a.Target as BoundMember;
            // add-struct-value-semantics（nested-fields）：blob 值 struct 字段原地写（3a lvalue，含嵌套
            // line.a.x）——先于通用 this._ee.Emit(tm.Target)，理由同 _emitMember。直接字段无 setter。
            if (this._ee._isBlobStruct(tm.Target.Type())) {
                this._emitBlobFieldSet(tm, val);
                return val;
            }
            // add-struct-heap-inline (P3b)：写整个**内联 struct 字段**进堆对象（`c.pt = other`）→ 逐叶子把
            // val(blob) 拷进对象 struct_bytes@off（值语义）。叶子写 `c.pt.x=v` 由上面 blob-target 分支处理。
            if (this._isInlineStructFieldRoot(tm)) {
                string fs = this._ee._blobStructName(tm.Type());
                int foff = this._inlineFieldOffset(tm);
                TypedReg objReg = this._ee.Emit(tm.Target);
                this._copyRegion(val, 0, objReg, foff, fs);
                return val;
            }
            TypedReg obj = this._ee.Emit(tm.Target);
            // 接口接收者：成员写定义上就是属性 setter → 恒 VCall set_X（对称 _emitMember
            // getter；接口无字段，否则落 FieldSet "X" 在实现类找不到同名字段）。
            if (tm.Target.Type() is Z42InterfaceType) {
                TypedReg ifVoid = this._ctx.Alloc(IrType.Void);
                TypedReg[] ifSet = new TypedReg[1];
                ifSet[0] = val;
                this._ctx.Emit(new VCallInstr(ifVoid, obj, "set_" + tm.MemberName, ifSet, 1));
                return val;
            }
            // auto-property setter dispatch（镜像 _emitMember getter dispatch）：
            // class 有 set_MemberName → v_call（镜像 C# SynthesizeClassAutoProp setter 路径）。
            Z42ClassType setCt = this._ee._receiverClassType(tm.Target.Type());
            if (setCt != null && setCt.Methods.ContainsKey("set_" + tm.MemberName)) {
                TypedReg voidDst = this._ctx.Alloc(IrType.Void);
                TypedReg[] setArgs = new TypedReg[1];
                setArgs[0] = val;
                this._ctx.Emit(new VCallInstr(voidDst, obj, "set_" + tm.MemberName, setArgs, 1));
                return val;
            }
            this._ctx.Emit(new FieldSetInstr(obj, tm.MemberName, val));
            return val;
        }
        if (a.Target is BoundIndex) {
            BoundIndex ti = a.Target as BoundIndex;
            // add-struct-array-codegen (P3b follow-up)：`arr[i] = p`（value-struct 数组整元素写）→ 取元素
            // 句柄（StructRefHeap）逐叶子把 p 拷进元素字节区（值语义）。ArraySet 的 set_boxed 收不了 arena
            // StructRef 源。叶子写 `arr[i].x=v` 走上面 BoundMember 分支（_emitBlobFieldSet + 句柄根）。
            if (this._ee._isBlobStruct(ti.Type())) {
                TypedReg h = this._emitArrayElemHandle(ti);
                string fs = this._ee._blobStructName(ti.Type());
                this._copyRegion(val, 0, h, 0, fs);
                return val;
            }
            TypedReg arr = this._ee.Emit(ti.Target);
            TypedReg i = this._ee.Emit(ti.Index);
            this._ctx.Emit(new ArraySetInstr(arr, i, val));
            return val;
        }
        return val;
    }

    // obj.field 读 → field_get。
    internal TypedReg _emitMember(BoundMember m) {
        // arr.Length（PS-2/SA）：C# 字节实证 = FieldGet obj, "Length"（非 ArrayLen 指令；VM 对数组特判）
        if (m.MemberName == "Length" && (m.Target.Type() is Z42ArrayType)) {
            TypedReg arr0 = this._ee.Emit(m.Target);
            TypedReg dst0 = this._ctx.Alloc(this._ctx.ToIrType(m.Type()));
            this._ctx.Emit(new FieldGetInstr(dst0, arr0, "Length"));
            return dst0;
        }
        // add-struct-value-semantics（nested-fields）：blob 值 struct 字段读（含嵌套 line.a.x）——先于
        // 通用 this._ee.Emit(m.Target)，否则嵌套 struct 字段（line.a 的 a）会被误当叶子递归发射
        // StructFieldGetPrim（运行时按 struct tag 解码基元 → 崩）。struct 字段无 auto-property getter。
        if (this._ee._isBlobStruct(m.Target.Type())) {
            // fix-struct-property-getter：blob struct 也可有**属性 getter**（`X { get {...} }` → get_X 方法）。
            // 有 get_X → VCall（**镜像下方 class 路径 :182-188 的同款判据，只查 Methods 不查 Fields**——
            // MemberCollector 把属性名也登记进 Fields 供类型检查，但计算属性无 byte-layout 存储、auto-property
            // 的存储在 `__prop_X` 而非源名）。否则误当叶子发 _emitBlobFieldGet → `FieldByteOffset(X, 源名)`
            // 查不到存储 → 烘焙 `struct_fget_prim @-1` + ref tag → 运行期 `struct ref leaf at byte offset
            // 4294967295`。（原 :148 注释"struct 字段无 auto-property getter"是错的——显式属性 getter 一直漏识别。）
            Z42ClassType sct = this._ee._receiverClassType(m.Target.Type());
            if (sct != null && sct.Methods.ContainsKey("get_" + m.MemberName)) {
                // struct 无虚方法：走**静态 Call 传 handle**（sret-aware），非 VCall（会崩 expected object）。
                TypedReg sobj = this._ee.Emit(m.Target);
                string fqGetter = this._ctx.QualifyClass(sct.Name()) + ".get_" + m.MemberName;
                return this._ee._emitStructPropGet(fqGetter, sobj, m.Type());
            }
            return this._emitBlobFieldGet(m);
        }
        // add-struct-heap-inline (P3b)：读整个**内联 struct 字段**出堆对象（`Point p = c.pt`）→ 拷进新局部
        // blob（值语义副本，非别名/非悬垂）。叶子读 `c.pt.x` 由上面的 blob-target 分支处理（含 inline 根）。
        if (this._isInlineStructFieldRoot(m)) {
            string fs = this._ee._blobStructName(m.Type());
            int foff = this._inlineFieldOffset(m);
            TypedReg objReg = this._ee.Emit(m.Target);
            int sz = this._ctx.Gen.Layouts.StructSize(fs);
            TypedReg cp = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
            this._copyRegion(objReg, foff, cp, 0, fs);
            return cp;
        }
        TypedReg obj = this._ee.Emit(m.Target);
        // G18i/G19a：receiver 是 `as`-cast 到**类**（Z42ClassType/Z42InstantiatedType，跨-ns 与否
        // 均然）时，字段读结果 tag → Unknown（镜像 C#：cast-to-class 不加载目标类字段 → 字段类型
        // codegen 期 Unknown）。param/var/this（非 cast）正常 ToIrType；prim/array/iface cast 不触发。
        // G19a 更正 G18i：原 IsCrossNs 门过窄——同-ns 类 cast（Z42PrimType/Z42InstantiatedType）C#
        // 同样 Unknown（z42c.semantics·ir 实证），真因是 cast receiver 而非跨-ns。
        int ftag = this._ctx.ToIrType(m.Type());
        if (this._ee._castUnknownChain(m.Target)) { ftag = IrType.Unknown; }
        TypedReg dst = this._ctx.Alloc(ftag);
        // 接口接收者：接口无字段，成员访问定义上就是属性 getter → 恒 VCall get_X
        // （fix-crosspkg-virtual-override 同源：接口经 vtable 派发到具体实现的 get_X；
        // 否则落下方 FieldGet "X" 在实现类找不到同名字段 → 返 Null，如 `IPipelineContext
        // ctx; ctx.Dirs` 跨 zpkg 读 PipelineContext auto-property Dirs 时崩 FieldGet null）。
        if (m.Target.Type() is Z42InterfaceType) {
            TypedReg[] ifArgs = new TypedReg[0];
            this._ctx.Emit(new VCallInstr(dst, obj, "get_" + m.MemberName, ifArgs, 0));
            return dst;
        }
        // Issue B：auto-property getter dispatch — class 有 get_MemberName → VCall（镜像 C#）
        Z42ClassType propCt = this._ee._receiverClassType(m.Target.Type());
        if (propCt != null && propCt.Methods.ContainsKey("get_" + m.MemberName)) {
            TypedReg[] noArgs = new TypedReg[0];
            this._ctx.Emit(new VCallInstr(dst, obj, "get_" + m.MemberName, noArgs, 0));
            return dst;
        }
        FieldGetInstr fg = new FieldGetInstr(dst, obj, m.MemberName);
        // add-readonly-fields-opt：readonly 字段 → 打内存标志，供 CSE/LICM。本地字段 FieldSymbol 有 IsReadonly；
        // 导入字段 v1 保守为 false（不跨包）。propCt 为 null（非类接收者）时保持 false。
        if (propCt != null && propCt.Fields.ContainsKey(m.MemberName)) {
            FieldSymbol rfs = propCt.Fields.Get(m.MemberName) as FieldSymbol;
            if (rfs != null) { fg.Readonly = rfs.IsReadonly; }
        }
        this._ctx.Emit(fg);
        return dst;
    }

    // blob 字段 lvalue 直写：base=blob 句柄，off/tag 由 StructLayout 烘焙（tag=运行期 TypeTag，
    // Tag.FromName(字段声明类型名)——ref 类字段(string/object/array)得 Object/Str 标签，运行时按 ref 叶子路由）。
    private void _emitStructFieldSet(string structName, string fieldName, TypedReg base_, TypedReg val) {
        int off = this._ctx.Gen.Layouts.FieldByteOffset(structName, fieldName);
        int tag = Tag.FromName(this._ctx.Gen.Layouts.FieldTypeName(structName, fieldName));
        this._ctx.Emit(new StructFieldSetPrimInstr(base_, off, tag, val));
    }
    // blob 字段读 → 收值寄存器（dstTag=字段结果 IrType 标签）。
    private TypedReg _emitStructFieldGet(string structName, string fieldName, TypedReg base_, int dstTag) {
        int off = this._ctx.Gen.Layouts.FieldByteOffset(structName, fieldName);
        int tag = Tag.FromName(this._ctx.Gen.Layouts.FieldTypeName(structName, fieldName));
        TypedReg dst = this._ctx.Alloc(dstTag);
        this._ctx.Emit(new StructFieldGetPrimInstr(dst, base_, off, tag));
        return dst;
    }

    // ── add-struct-nested-fields：嵌套 struct 字段读写（沿成员链累积 byte offset） ──────────
    // blob 值 struct 字段读（含嵌套 line.a.x）：叶子 → 单条累积-offset StructFieldGetPrim；字段本身是
    // struct（P p = line.a）→ 分配新 blob 逐叶子复制出（值副本，非别名）。
    private TypedReg _emitBlobFieldGet(BoundMember m) {
        string cont = this._ee._blobStructName(m.Target.Type());
        TypedReg base_ = this._structChainRoot(m.Target);
        int off = this._structChainOffset(m.Target) + this._ctx.Gen.Layouts.FieldByteOffset(cont, m.MemberName);
        if (this._ctx.Gen.Layouts.FieldIsStruct(cont, m.MemberName)) {
            string fs = this._ctx.Gen.Layouts.FieldTypeName(cont, m.MemberName);
            int sz = this._ctx.Gen.Layouts.StructSize(fs);
            TypedReg cp = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
            this._copyRegion(base_, off, cp, 0, fs);
            return cp;
        }
        int tag = Tag.FromName(this._ctx.Gen.Layouts.FieldTypeName(cont, m.MemberName));
        TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(m.Type()));
        this._ctx.Emit(new StructFieldGetPrimInstr(dst, base_, off, tag));
        return dst;
    }

    // blob 值 struct 字段原地写（含嵌套 line.a.x=3）：叶子 → 单条累积-offset StructFieldSetPrim；字段本身
    // 是 struct（line.a = p）→ 逐叶子把 val(P blob) 复制进 base_@off。
    private void _emitBlobFieldSet(BoundMember tm, TypedReg val) {
        string cont = this._ee._blobStructName(tm.Target.Type());
        TypedReg base_ = this._structChainRoot(tm.Target);
        int off = this._structChainOffset(tm.Target) + this._ctx.Gen.Layouts.FieldByteOffset(cont, tm.MemberName);
        if (this._ctx.Gen.Layouts.FieldIsStruct(cont, tm.MemberName)) {
            string fs = this._ctx.Gen.Layouts.FieldTypeName(cont, tm.MemberName);
            this._copyRegion(val, 0, base_, off, fs);
            return;
        }
        int tag = Tag.FromName(this._ctx.Gen.Layouts.FieldTypeName(cont, tm.MemberName));
        this._ctx.Emit(new StructFieldSetPrimInstr(base_, off, tag, val));
    }

    // add-static-struct-bytecization (PR-2 S)：发 StaticGet 取**原始存储值**（static struct 字段 = 装箱盒
    // 句柄，不拆箱）。供 Emit 整读（外层再 AsCast 拆箱）与 `_structChainRoot` 叶子根（直接用盒句柄就地读写）复用。
    internal TypedReg _emitStaticGetRaw(BoundStaticGet sg) {
        // StaticGet 结果寄存器 = Unknown（C# REGT 字节实证：静态字段读 IR 层擦除）。
        // G17b：用 QualifyClass（非 Qualify）→ 同包跨-ns 类静态字段限定到声明 ns。
        TypedReg dst = this._ctx.Alloc(IrType.Unknown);
        this._ctx.Emit(new StaticGetInstr(dst, this._ctx.QualifyClass(sg.ClassName) + "." + sg.FieldName));
        return dst;
    }

    // add-static-struct-bytecization (PR-2 S)：整写 static struct 字段前 `__box_struct` 全局化——把帧 arena
    // blob 拷到堆装箱盒（进程存活，无悬垂），存的是盒句柄。非 struct 字段原样返回（int/string/引用照旧）。
    private TypedReg _boxIfStaticStruct(TypedReg val, Z42Type fieldType) {
        if (!this._ee._isBlobStruct(fieldType)) { return val; }
        TypedReg[] bargs = new TypedReg[1]; bargs[0] = val;
        TypedReg bdst = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new BuiltinInstr(bdst, "__box_struct", bargs, 1));
        return bdst;
    }

    // 嵌套字段链的根 blob 句柄：沿链下降到根 lvalue，只 Emit 根一次。根 = 局部 ident / 返回 struct 的调用……
    // 或**拥有者 struct 的裸字段**（`a.x` 即 `this.a.x`，此时根 blob = this 句柄 reg0，偏移见 _structChainOffset）。
    private TypedReg _structChainRoot(BoundExpr e) {
        if (e is BoundMember) {
            BoundMember m = e as BoundMember;
            if (this._ee._isBlobStruct(m.Target.Type())) { return this._structChainRoot(m.Target); }
            // add-struct-heap-inline (P3b)：内联 struct 字段根 = 堆对象句柄（Value::Object）；
            // 后续叶子 offset 由 _structChainOffset 累积（对象相对复合 offset 烘焙进 StructFieldGet/SetPrim）。
            if (this._isInlineStructFieldRoot(e)) { return this._ee.Emit(m.Target); }
        }
        // add-static-struct-bytecization (PR-2 S)：static struct 字段作叶子链根（`Holder.P.X`）→ 根 blob =
        // 装箱盒句柄（BoxedStruct，就地读写，引用身份）。**不拆箱**（拆箱会拷贝出副本 → 叶子写丢失）；
        // 叶子 offset 由 _structChainOffset 从 struct 布局累积（FieldByteOffset，struct 相对）。
        if (e is BoundStaticGet && this._ee._isBlobStruct(e.Type())) { return this._emitStaticGetRaw(e as BoundStaticGet); }
        if (this._isOwnerStructField(e)) { return new TypedReg(0, IrType.Ref); }
        // add-struct-heap-inline (P3b)：裸内联字段 `pt`（class C 方法内）根 = this 对象句柄 reg0。
        if (this._isOwnerInlineField(e)) { return new TypedReg(0, IrType.Ref); }
        // add-struct-array-codegen (P3b follow-up)：`arr[i]`（value-struct 数组元素）链根 = 元素**句柄**
        // （StructRefHeap，ArrayGet 直发不拷贝）——供 `arr[i].x` 原地叶子读写；offset 0（元素起点，_structChainOffset 默认返 0）。
        if (e is BoundIndex && this._ee._isBlobStruct(e.Type())) { return this._emitArrayElemHandle(e as BoundIndex); }
        return this._ee.Emit(e);
    }

    // 表达式在其根 blob 内的累积 byte offset（纯 layout 查表，零 codegen——故与 _structChainRoot 两遍不重复发射）。
    private int _structChainOffset(BoundExpr e) {
        if (e is BoundMember) {
            BoundMember m = e as BoundMember;
            if (this._ee._isBlobStruct(m.Target.Type())) {
                int parent = this._structChainOffset(m.Target);
                return parent + this._ctx.Gen.Layouts.FieldByteOffset(this._ee._blobStructName(m.Target.Type()), m.MemberName);
            }
            // add-struct-heap-inline (P3b)：内联 struct 字段根的对象相对起始 offset（纯查表，不 Emit）。
            if (this._isInlineStructFieldRoot(e)) { return this._inlineFieldOffset(m); }
        }
        if (this._isOwnerStructField(e)) {
            BoundIdent id = e as BoundIdent;
            return this._ctx.Gen.Layouts.FieldByteOffset(this._ctx.OwnerStructName, id.Name);
        }
        // add-struct-heap-inline (P3b)：裸内联字段 `pt` 的对象相对起始 offset。
        if (this._isOwnerInlineField(e)) {
            BoundIdent id = e as BoundIdent;
            return this._ctx.Gen.Layouts.InlineFieldByteOffset(this._ctx.OwnerClassName, id.Name);
        }
        return 0;
    }

    // ── add-struct-heap-inline (P3b)：堆对象的**内联 struct 字段**（`class C{ Point pt; }` 的 `c.pt`）──────
    // e 是否 = 「堆对象/class 的内联 struct 字段访问」——即字段声明类型是 blob struct，但**容器不是** blob
    // struct（是 class/堆对象）。此时该 struct 内联在对象 struct_bytes 里，根 blob = 对象句柄（Value::Object），
    // 对象相对 offset = InlineFieldByteOffset。区别于容器-是-struct 的嵌套链（那走 _isBlobStruct 递归）。
    private bool _isInlineStructFieldRoot(BoundExpr e) {
        if (!(e is BoundMember)) { return false; }
        BoundMember m = e as BoundMember;
        if (!this._ee._isBlobStruct(m.Type())) { return false; }          // 字段类型须是 blob struct
        if (this._ee._isBlobStruct(m.Target.Type())) { return false; }    // 容器是 struct → 归嵌套链，非本例
        Z42ClassType oc = this._ee._receiverClassType(m.Target.Type());
        if (oc == null) { return false; }                            // 容器须是 class（堆对象）
        if (this._ctx.Gen.Layouts == null) { return false; }
        return this._ctx.Gen.Layouts.InlineFieldByteOffset(oc.Name(), m.MemberName) >= 0;
    }

    // 内联 struct 字段的对象相对 byte offset（调用方已确认 _isInlineStructFieldRoot）。
    private int _inlineFieldOffset(BoundMember m) {
        Z42ClassType oc = this._ee._receiverClassType(m.Target.Type());
        return this._ctx.Gen.Layouts.InlineFieldByteOffset(oc.Name(), m.MemberName);
    }

    // e 是否 = 所属**非-struct class** 的裸内联 struct 字段引用（`pt` 即 `this.pt`，class C 的方法内）——
    // 其根 blob = this 对象句柄 reg0，对象相对 offset = InlineFieldByteOffset(OwnerClassName, name)。
    // 未被局部/const 遮蔽且确为字段。struct owner 走 OwnerStructName 路径（其字段无内联，此处 -1 自然排除）。
    private bool _isOwnerInlineField(BoundExpr e) {
        if (!(e is BoundIdent)) { return false; }
        if (this._ctx.OwnerClassName == "") { return false; }
        BoundIdent id = e as BoundIdent;
        if (this._ctx.Locals.ContainsKey(id.Name)) { return false; }
        if (this._ctx.ConstLocals.ContainsKey(id.Name)) { return false; }
        if (!this._ctx.Fields.ContainsKey(id.Name)) { return false; }
        if (this._ctx.Gen.Layouts == null) { return false; }
        return this._ctx.Gen.Layouts.InlineFieldByteOffset(this._ctx.OwnerClassName, id.Name) >= 0;
    }

    // e 是否**拥有者 blob struct 的裸字段引用**（`a` 即 `this.a`，非被局部/const 遮蔽）——其根 blob = this(reg0)。
    private bool _isOwnerStructField(BoundExpr e) {
        if (!(e is BoundIdent)) { return false; }
        if (this._ctx.OwnerStructName == "") { return false; }
        BoundIdent id = e as BoundIdent;
        if (this._ctx.Locals.ContainsKey(id.Name)) { return false; }
        if (this._ctx.ConstLocals.ContainsKey(id.Name)) { return false; }
        return this._ctx.Fields.ContainsKey(id.Name);
    }

    // 从 srcBase@srcOff 处复制出一个 struct 值副本到新分配的 blob，返回其句柄（complete-struct：模式嵌套
    // struct 字段读复用——把子 struct 字段作独立值副本产出供递归子模式解构，非别名）。
    internal TypedReg _copyStructOut(TypedReg srcBase, int srcOff, string structName) {
        int sz = this._ctx.Gen.Layouts.StructSize(structName);
        TypedReg cp = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(structName), sz));
        this._copyRegion(srcBase, srcOff, cp, 0, structName);
        return cp;
    }

    // 整个 struct 区间逐叶子复制（复用现有 Get/SetPrim，无区间指令）：嵌套 struct 子字段递归，基元/引用叶子
    // 一读一写。src/dst 为 blob 句柄，srcOff/dstOff 为其内区间起点。
    internal void _copyRegion(TypedReg srcBase, int srcOff, TypedReg dstBase, int dstOff, string structName) {
        StructLayoutInfo li = this._ctx.Gen.Layouts.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) {
            int fo = li.FieldOffsets[i];
            if (li.FieldKinds[i] == StructLeafKind.Struct) {
                this._copyRegion(srcBase, srcOff + fo, dstBase, dstOff + fo, li.FieldTypeNames[i]);
            } else {
                int tag = Tag.FromName(li.FieldTypeNames[i]);
                TypedReg tmp = this._ctx.Alloc(this._ee._tagToIrType(tag));
                this._ctx.Emit(new StructFieldGetPrimInstr(tmp, srcBase, srcOff + fo, tag));
                this._ctx.Emit(new StructFieldSetPrimInstr(dstBase, dstOff + fo, tag, tmp));
            }
            i = i + 1;
        }
    }

    // arr[i] 读 → array_get（元素类型）。
    internal TypedReg _emitIndex(BoundIndex idx) {
        // add-struct-array-codegen (P3b follow-up): standalone `arr[i]` for a **value-struct
        // array** → ArrayGet yields a `StructRefHeap` element handle; copy it out to a fresh
        // local blob (value semantics: the read is an independent snapshot, not an alias into
        // the array). Leaf access `arr[i].x` instead roots the chain at the handle (see
        // `_structChainRoot`), so it reads/writes in place.
        if (this._ee._isBlobStruct(idx.Type())) {
            TypedReg h = this._emitArrayElemHandle(idx);
            string fs = this._ee._blobStructName(idx.Type());
            int sz = this._ctx.Gen.Layouts.StructSize(fs);
            TypedReg cp = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
            this._copyRegion(h, 0, cp, 0, fs);
            return cp;
        }
        TypedReg arr = this._ee.Emit(idx.Target);
        TypedReg i = this._ee.Emit(idx.Index);
        TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(idx.Type()));
        this._ctx.Emit(new ArrayGetInstr(dst, arr, i));
        return dst;
    }

    // add-struct-array-codegen (P3b follow-up): emit `arr[i]` producing the **element
    // handle** (`StructRefHeap`, via ArrayGet on a value-struct array) with no copy. Used as
    // a struct chain root (`arr[i].x` in-place) + by `_emitIndex`'s copy-out + `arr[i] = p`.
    private TypedReg _emitArrayElemHandle(BoundIndex idx) {
        TypedReg arr = this._ee.Emit(idx.Target);
        TypedReg i = this._ee.Emit(idx.Index);
        TypedReg h = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new ArrayGetInstr(h, arr, i));
        return h;
    }

    internal TypedReg _lookupIdent(BoundIdent id) {
        // add-const-keyword：局部 const 裸引用 → 字面量替换（须先于 Locals：const 也占存储槽，存储由 DCE 清）。
        // perf：同一个键连查三张表（const 局部 / 局部 / 字段）—— `GetHashCode` 是 O(n) FNV-1a
        // 且每次调用都重算，取一次逐表传进去。
        int _h = id.Name.GetHashCode();
        int _sl0 = this._ctx.ConstLocals.FindHashed(id.Name, _h); if (_sl0 >= 0) { return this._ee._emitConstVal(this._ctx.ConstLocals.ValAt(_sl0) as ConstValue, this._ctx.ToIrType(id.Type())); }
        int _sl1 = this._ctx.Locals.FindHashed(id.Name, _h); if (_sl1 >= 0) { return this._ctx.Locals.ValAt(_sl1) as TypedReg; }
        if (this._ctx.Fields.ContainsKeyHashed(id.Name, _h)) {
            // A-use：所属类是 blob 值 struct → 裸字段（`this.f`）读翻转为 StructFieldGetPrim(reg0=句柄)。
            if (this._ctx.OwnerStructName != "") {
                // add-struct-nested-fields：裸 owner 字段本身是 struct（`P p = a;`）→ 值复制出（reg0=this，off=字段 offset）。
                if (this._ctx.Gen.Layouts.FieldIsStruct(this._ctx.OwnerStructName, id.Name)) {
                    string fs = this._ctx.Gen.Layouts.FieldTypeName(this._ctx.OwnerStructName, id.Name);
                    int foff = this._ctx.Gen.Layouts.FieldByteOffset(this._ctx.OwnerStructName, id.Name);
                    int sz = this._ctx.Gen.Layouts.StructSize(fs);
                    TypedReg cp = this._ctx.Alloc(IrType.Ref);
                    this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
                    this._copyRegion(new TypedReg(0, IrType.Ref), foff, cp, 0, fs);
                    return cp;
                }
                return this._emitStructFieldGet(this._ctx.OwnerStructName, id.Name, new TypedReg(0, IrType.Ref), this._ctx.ToIrType(id.Type()));
            }
            // add-struct-heap-inline (P3b)：裸内联 struct 字段整读（`Point p = pt`，class C 方法内）→ 拷出新局部
            // blob（值语义）。裸叶子 `pt.x` 由 _emitBlobFieldGet 经 _isOwnerInlineField 根处理。
            if (this._isOwnerInlineField(id)) {
                string fs = this._ee._blobStructName(id.Type());
                int foff = this._ctx.Gen.Layouts.InlineFieldByteOffset(this._ctx.OwnerClassName, id.Name);
                int sz = this._ctx.Gen.Layouts.StructSize(fs);
                TypedReg cp = this._ctx.Alloc(IrType.Ref);
                this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
                this._copyRegion(new TypedReg(0, IrType.Ref), foff, cp, 0, fs);
                return cp;
            }
            TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(id.Type()));
            FieldGetInstr bfg = new FieldGetInstr(dst, new TypedReg(0, IrType.Ref), id.Name);
            if (this._ctx.ReadonlyFields.ContainsKey(id.Name)) { bfg.Readonly = true; }   // add-readonly-fields-opt
            this._ctx.Emit(bfg);
            return dst;
        }
        TypedReg ph = this._ctx.Alloc(this._ctx.ToIrType(id.Type()));
        this._ctx.Emit(new ConstNullInstr(ph));
        return ph;
    }
}
