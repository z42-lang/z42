// Definite assignment —— 局部变量未赋值就读 → E0407。
//
// ## 为什么这个文件是新建的
//
// 老的 C# 宿主编译器有 `z42.Semantics/TypeCheck/FlowAnalyzer.cs`（528 行，可达性分析 +
// definite assignment）。`f8ff73d59`「delete src/compiler」把它连同整个 C# 编译器删掉，
// **z42c 这边从来没补**——于是 `DiagnosticCodes.UninitializedVariable = "E0407"` 这个常量
// 一直摆着、文档也记着它，却**零发射点**。本文件把它补回来，join 规则逐条移植自老实现
// （`git show f8ff73d59^:src/compiler/z42.Semantics/TypeCheck/FlowAnalyzer.cs`）。
//
// ## 两条设计铁律
//
// **① 误报零容忍。** DA 的全部价值前提是「用了没赋值的变量」是**确定性事实**、不是概率判断。
// 任何误报都说明下面的 join 规则漏了一种控制流结构，**不是「规则太严」**。
//
// **② 漏报可以接受，误报不可以。** 没覆盖到的节点一律保守当成「已赋值」——漏报只是少抓一个
// bug，误报会拦住合法代码。故 `_stmt` / `_reads` 的兜底分支什么都不做，而不是报错。
//
// ## 不做 `out` 那半
//
// 老实现近一半是 `out` 形参的 callee 端 DA。`simplify-ref-parameters`（#728）砍了 `out`，
// 且被 `ref` 取址的无 init 局部会在**声明处**回填 `default(T)` ⇒ 形参与被取址的局部恒为已赋值。
namespace Z42.Semantics;

using Z42.Core;
using Z42.Syntax;
using Z42.IR;     // StrMap

public sealed class FlowAnalyzer {

    private DiagnosticBag _diags;
    private StrMap _uninit;     // 声明时无初始化器的局部名 → "1"
    private StrMap _assigned;   // 到当前程序点为止**必定已赋值**的名字 → "1"

    // define-null-check-marks：到当前程序点为止**可能为 null**的名字 → "1"。
    //
    // 两处事实来源：**标了 `?` 的形参**，以及**标了 `?` 的返回值**（`BoundCall.RetIsNullable`）。
    // `?` 的语义是「编译器请在这里强制检查」，缺席 = **不强制**（不是「保证非空」）
    // ⇒ 未标的名字不进本表、天然不受检，零迁移成本。
    private StrMap _maybeNull;

    // 本方法自己的返回类型标没标 `?`。未标 ⇒ 调用方**没有**检查义务 ⇒ 不许把可空值
    // 从这里漏出去（design D9 的 `PossibleNullReturn`），否则标记体系就被洗穿了。
    private bool _retIsNullable;

    // ── 字段那半（define-null-check-marks 阶段 3.5）────────────────────────
    //
    // 字段与局部的**关键差别**：字段不是一个「值」，是一个**每次读都重新求值的位置**。
    // 于是 `if (this.F != null) { this.F.M(); }` 里的两个 `this.F` 是两次独立的读，
    // 中间别的线程能写、若 `F` 是属性还会是两次真调用（返回值可以不同）。
    // design §D4 由此选了 (a)「强制快照」：字段**永不窄化**，要用就先存进局部
    // ⇒ 字段不入 `_maybeNull`（没有状态可记）。
    //
    // ⭐ **这条是实测定的，不是照抄文档**（tasks 阶段 4 的 Q1 A/B）：另一档 (b)「调用即失效」
    // 两条都实现过、各跑一遍全仓。(a) 命中 51 处、形态单一；(b) 命中 7 处，但那 7 处全是
    // **「检查完插了一次无关调用」**——
    //   · `LinkedList` 里 `node.SetNext(this.head);` 的下一行 `this.head.SetPrevious(node)` 才报（相邻两行，同一个表达式，一行报一行不报）；
    //   · `HttpClient` 里查完 `_cookieJar` 取了个时间戳，再用就要重查；
    //   · `Decl.MergeParseDiags` 里 `while (i < this.ParseDiags.Count())` 的条件合法、体内 `this.ParseDiags.Get(i)` 报——**同一条 while 语句内**。
    // 少报的 44 处买回来的是这种「我明明检查过了，为什么这里报那里不报」。⇒ 维持 (a)。

    // 报过的字段路径 —— 同一个字段在一个方法里每处再报一遍只是噪声（同 E0407 的处置）。
    private StrMap _fieldReported;

    private FlowAnalyzer(DiagnosticBag diags) {
        this._diags = diags;
        this._uninit = new StrMap();
        this._assigned = new StrMap();
        this._maybeNull = new StrMap();
        this._fieldReported = new StrMap();
    }

    // 入口：方法体绑定完之后调。形参一律预置为已赋值（调用方提供了值；`ref` 亦然——
    // 取址点要求槽位已初始化，见 simplify-ref-parameters）。
    public static void Check(BoundStmt body, MethodDecl md, DiagnosticBag diags) {
        if (body == null || diags == null) { return; }
        FlowAnalyzer fa = new FlowAnalyzer(diags);
        FlowAnalyzer._seed(fa, md);
        fa._stmt(body);
    }

    private static void _seed(FlowAnalyzer fa, MethodDecl md) {
        if (md == null) { return; }
        fa._retIsNullable = (md.RetType is NullableType);
        int i = 0;
        while (i < md.ParamCount) {
            fa._assigned.Put(md.Params[i].Name, "1");
            // 标了 `?` 的形参进入体内时是「可能为 null」——被调方必须先检查再解引用。
            if (md.Params[i].Type is NullableType) { fa._maybeNull.Put(md.Params[i].Name, "1"); }
            i = i + 1;
        }
    }

    // ── 正常结束分析 ────────────────────────────────────────────────────────
    //
    // 「这条语句的所有路径都以 return / throw 离开吗」。if/else 的 join 要用它：
    // 一支必定退出时，只有另一支的赋值能落到后面。
    //
    // 保守方向：拿不准就返 false（= 会正常结束）。返 false 只会让 join 更严（少传播赋值），
    // 那是漏报方向；返 true 则可能让未赋值的路径被误判成已赋值 —— 那是**误报+漏报**兼有，更坏。
    public static bool AlwaysReturns(BoundStmt s) {
        if (s == null) { return false; }
        if (s is BoundReturn) { return true; }
        if (s is BoundThrow)  { return true; }
        if (s is BoundBlock) {
            BoundBlock b = s as BoundBlock;
            int i = 0;
            while (i < b.Count) {
                if (FlowAnalyzer.AlwaysReturns(b.Stmts[i])) { return true; }
                i = i + 1;
            }
            return false;
        }
        if (s is BoundIf) {
            BoundIf f = s as BoundIf;
            if (!f.HasElse) { return false; }   // 条件假时会落下来
            return FlowAnalyzer.AlwaysReturns(f.Then) && FlowAnalyzer.AlwaysReturns(f.Else);
        }
        if (s is BoundTry) {
            // try 与**每个** catch 都必定退出才算；finally 不影响（它总会执行但不决定去向）。
            BoundTry t = s as BoundTry;
            if (!FlowAnalyzer.AlwaysReturns(t.TryBody)) { return false; }
            int i = 0;
            while (i < t.CatchCount) {
                if (!FlowAnalyzer.AlwaysReturns(t.Catches[i].Body)) { return false; }
                i = i + 1;
            }
            return true;
        }
        // while / for / foreach / switch / break / continue / 其余：保守返 false。
        // （`while (true)` 无 break 也算必定不落下来，但判它需要常量求值 + break 分析，
        //  收益小于风险，留白。）
        return false;
    }

    // ── 语句遍 ──────────────────────────────────────────────────────────────

    private void _stmt(BoundStmt s) {
        if (s == null) { return; }

        if (s is BoundBlock) {
            BoundBlock b = s as BoundBlock;
            int i = 0;
            while (i < b.Count) { this._stmt(b.Stmts[i]); i = i + 1; }
            return;
        }

        if (s is BoundVarDeclStmt) {
            BoundVarDeclStmt v = s as BoundVarDeclStmt;
            if (v.Init != null) {
                this._reads(v.Init);
                // 「存进局部再检查」正是返回值标记的逃生口（调用结果没有名字可窄化），
                // 所以这条传播是必须的，不是可选的优化。
                this._propagate(v.Name, v.Init);
            }
            else { this._uninit.Put(v.Name, "1"); }
            return;
        }

        if (s is BoundExprStmt) {
            BoundExprStmt e = s as BoundExprStmt;
            this._reads(e.E);
            this._collectAssign(e.E);
            return;
        }

        if (s is BoundReturn) {
            BoundReturn r = s as BoundReturn;
            if (r.HasValue) {
                this._reads(r.Value);
                this._checkReturn(r.Value);
            }
            return;
        }

        if (s is BoundThrow) {
            BoundThrow th = s as BoundThrow;
            this._checkDeref(th.E); this._reads(th.E); return;
        }

        if (s is BoundIf) { this._if(s as BoundIf); return; }

        if (s is BoundWhile) {
            // 循环体可能**零次执行** ⇒ 体内赋值不传出。
            BoundWhile w = s as BoundWhile;
            this._reads(w.Cond);
            this._inScratch(w.Body);
            return;
        }

        if (s is BoundDoWhile) {
            // 体**必执行一次** ⇒ 赋值传出（与 while 相反，这条容易写反）。
            BoundDoWhile d = s as BoundDoWhile;
            this._stmt(d.Body);
            this._reads(d.Cond);
            return;
        }

        if (s is BoundFor) {
            BoundFor f = s as BoundFor;
            if (f.HasInit) { this._stmt(f.Init); }       // init 必执行 ⇒ 赋值传出
            if (f.HasCond) { this._reads(f.Cond); }
            this._inScratch(f.Body);                      // 体与 incr 可能零次执行
            if (f.HasIncr) { this._readsScratch(f.Incr); }
            return;
        }

        if (s is BoundForeach) {
            BoundForeach fe = s as BoundForeach;
            this._checkDeref(fe.Collection);
            this._reads(fe.Collection);
            this._assigned.Put(fe.VarName, "1");          // 迭代变量由 foreach 赋值
            this._inScratch(fe.Body);                     // 集合可能为空 ⇒ 体内赋值不传出
            return;
        }

        if (s is BoundSwitch) { this._switch(s as BoundSwitch); return; }
        if (s is BoundTry)    { this._try(s as BoundTry);       return; }

        if (s is BoundDeconstructDeclStmt) {
            // 解构声明：初始化器必被读；绑出的名字视为已赋值（名字在 Pattern 里，
            // 这里不拆——未登记进 uninit 的名字本就不会被判红，保守且正确）。
            this._reads((s as BoundDeconstructDeclStmt).Init);
            return;
        }

        if (s is BoundLocalFunction) {
            // 局部函数体单独成域：只查它内部的读，不与外层共享赋值状态
            // （它的调用时机不确定，把外层赋值算进去会漏报、把它的赋值传出会误报）。
            BoundLocalFunction lf = s as BoundLocalFunction;
            FlowAnalyzer inner = new FlowAnalyzer(this._diags);
            if (lf.Decl != null) {
                int i = 0;
                while (i < lf.Decl.ParamCount) { inner._assigned.Put(lf.Decl.Params[i].Name, "1"); i = i + 1; }
            }
            inner._stmt(lf.Body);
            return;
        }

        // break / continue / 其余：无赋值语义，且 D4 的保守兜底。
    }

    // if / else 的合并（老实现 VisitIf 的逐条移植）。
    private void _if(BoundIf f) {
        this._reads(f.Cond);
        StrMap prev = this._assigned;

        StrMap prevNull = this._maybeNull;

        StrMap thenA = FlowAnalyzer._copy(prev);
        this._assigned = thenA;
        this._maybeNull = FlowAnalyzer._copyNull(prevNull);
        this._narrowNotNull(f.Cond, true);
        this._stmt(f.Then);
        StrMap thenN = this._maybeNull;

        // else 路径。**没有 else 时它依然存在** —— 就是「条件为假直接落下来」那条路，
        // 早返回守卫 `if (s == null) { return; }` 全靠它。
        StrMap elseA = FlowAnalyzer._copy(prev);
        this._maybeNull = FlowAnalyzer._copyNull(prevNull);
        this._narrowNotNull(f.Cond, false);
        if (f.HasElse) { this._assigned = elseA; this._stmt(f.Else); }
        StrMap elseN = this._maybeNull;

        bool thenOut = FlowAnalyzer.AlwaysReturns(f.Then);
        bool elseOut = f.HasElse && FlowAnalyzer.AlwaysReturns(f.Else);

        // 只收还活着的那些支。这一步不做的话，`if (s != null) { return 1; } return s.Length;`
        // ——一个**必定** NRE 的写法——会因为 then 支的窄化漏出来而被完全放过。
        if (thenOut && elseOut)  { this._maybeNull = prevNull; }   // 落不下来
        else if (thenOut)        { this._maybeNull = elseN; }
        else if (elseOut)        { this._maybeNull = thenN; }
        else                     { this._maybeNull = FlowAnalyzer._joinNull(thenN, elseN); }

        if (!f.HasElse) {
            // 无 else：条件假时会落下来 ⇒ then 里的赋值**不算**。
            this._assigned = prev;
            return;
        }
        this._assigned = prev;
        if (thenOut && !elseOut)       { FlowAnalyzer._union(this._assigned, elseA); }
        else if (!thenOut && elseOut)  { FlowAnalyzer._union(this._assigned, thenA); }
        else if (!thenOut && !elseOut) { FlowAnalyzer._unionCommon(this._assigned, thenA, elseA); }
        // 两支都退出 → 控制流落不下来，prev 不动。
    }

    // switch：各 case 的**交集**；必定退出的 case 跳过（同 if/else 的道理）。
    private void _switch(BoundSwitch sw) {
        this._reads(sw.Subject);
        StrMap prev = this._assigned;
        StrMap common = null;
        bool sawFallthrough = false;
        int i = 0;
        while (i < sw.CaseCount) {
            BoundSwitchCase c = sw.Cases[i];
            StrMap caseA = FlowAnalyzer._copy(prev);
            this._assigned = caseA;
            if (c.Guard != null) { this._reads(c.Guard); }
            int j = 0;
            bool outs = false;
            while (j < c.BodyCount) {
                this._stmt(c.Body[j]);
                if (FlowAnalyzer.AlwaysReturns(c.Body[j])) { outs = true; }
                j = j + 1;
            }
            if (!outs) {
                sawFallthrough = true;
                if (common == null) { common = caseA; }
                else { common = FlowAnalyzer._common(common, caseA); }
            }
            i = i + 1;
        }
        this._assigned = prev;
        // 只有**每个**正常结束的 case 都赋了才传出；且必须有 default（否则可能一个 case 都不进）。
        if (sawFallthrough && common != null && FlowAnalyzer._hasDefault(sw)) {
            FlowAnalyzer._union(this._assigned, common);
        }
    }

    private static bool _hasDefault(BoundSwitch sw) {
        int i = 0;
        while (i < sw.CaseCount) {
            if (!sw.Cases[i].HasPattern) { return true; }
            i = i + 1;
        }
        return false;
    }

    // try / catch / finally。
    //
    // ## 这条规则是三方权衡的结果，改它之前先看完
    //
    // **老实现（C# 编译器）**：try 体直接在当前状态上走（赋值保留）、**catch 也拿到 try 的赋值**、
    // 事后状态 = try 的赋值。零误报，但漏掉「catch 里读 try 赋的值」这种真 bug。
    //
    // **我最初写的严格版**：事后状态 = try 与各 catch 的交集。它在 z42.net 的
    // `HttpServer.ServeThreaded` 上**误报**了：
    //
    // ```z42
    // TcpClient peer;
    // try { peer = accept(); }
    // catch (SocketClosedException e) { return; }        // 必定退出，跳过 ✓
    // catch (Exception e) { log(...); continue; }        // ← `continue` 不算「必定退出」⇒ 被纳入交集 ⇒ peer 被判未赋值
    // peer.Dispose();
    // ```
    //
    // 把 `break`/`continue` 也算进「必定退出」能修这一例，但会**打坏 switch**——
    // `case 1: x = 1; break;` 的 break 是 case 的正常收尾，算成「退出」后各 case 都不进交集、
    // `switch` 整个不传播赋值 ⇒ 换来一批新的误报。控制流转移在「块内顺序」与「switch case 收尾」
    // 两种语境下含义相反，一个谓词表达不了。
    //
    // **选定（严格优于老实现，又无误报）**：
    // - try 体在当前状态上走 ⇒ 赋值**保留**（避开上面那个误报；代价是漏掉「异常在赋值前抛出」）
    // - 每个 catch 从 **try 之前**的状态副本开始 ⇒ 「catch 里读 try 赋的值」**照样报**（老实现漏的那条）
    // - 事后状态 = try 体之后（catch 不参与收紧）
    // - finally 必执行 ⇒ 在事后状态上走，赋值传出
    //
    // 净效果：比老实现多抓一类真 bug，且零误报。剩下的漏报（异常在赋值前抛出）是 D4 认可的方向。
    private void _try(BoundTry t) {
        StrMap preTry = FlowAnalyzer._copy(this._assigned);

        this._stmt(t.TryBody);                     // 就地走：try 的赋值保留
        StrMap postTry = this._assigned;

        int i = 0;
        while (i < t.CatchCount) {
            BoundCatchClause c = t.Catches[i];
            StrMap catchA = FlowAnalyzer._copy(preTry);   // ← preTry，不是 postTry
            if (c.HasVar) { catchA.Put(c.VarName, "1"); }
            this._assigned = catchA;
            this._stmt(c.Body);
            i = i + 1;
        }

        this._assigned = postTry;
        if (t.HasFinally) { this._stmt(t.Finally); }
    }

    // 在一份**快照**上走（体内赋值不传出）。while / for 体 / foreach 体用。
    private void _inScratch(BoundStmt body) {
        StrMap prev = this._assigned;
        StrMap prevNull = this._maybeNull;
        this._assigned = FlowAnalyzer._copy(prev);
        this._maybeNull = FlowAnalyzer._copyNull(prevNull);
        this._stmt(body);
        this._assigned = prev;
        this._maybeNull = prevNull;   // 循环体内的窄化不外泄（体可能一次都不执行）
    }

    private void _readsScratch(BoundExpr e) {
        StrMap prev = this._assigned;
        StrMap prevNull = this._maybeNull;
        this._assigned = FlowAnalyzer._copy(prev);
        this._maybeNull = FlowAnalyzer._copyNull(prevNull);
        this._reads(e);
        this._collectAssign(e);
        this._assigned = prev;
        this._maybeNull = prevNull;
    }

    // ── 赋值收集 ────────────────────────────────────────────────────────────

    private void _collectAssign(BoundExpr e) {
        if (e == null) { return; }
        if (e is BoundAssign) {
            BoundAssign a = e as BoundAssign;
            this._collectAssign(a.Value);                 // 嵌套赋值 `a = b = 1`
            if (a.Target is BoundIdent) {
                this._assigned.Put((a.Target as BoundIdent).Name, "1");
            }
            return;
        }
        if (e is BoundSeqExpr) { this._collectAssign((e as BoundSeqExpr).Value); return; }
        // 其余形态不产生对局部名的确定性赋值（D4 的保守兜底）。
    }

    // ── 表达式 reads 遍 ─────────────────────────────────────────────────────
    //
    // 只有「登记在 uninit 且尚未 assigned」的名字才报。其余（形参 / 带初始化器的局部 /
    // 字段 / 静态）一律不进 uninit，故天然不会被判红。

    private void _reads(BoundExpr e) {
        if (e == null) { return; }

        if (e is BoundIdent) {
            BoundIdent id = e as BoundIdent;
            if (this._uninit.ContainsKey(id.Name) && !this._assigned.ContainsKey(id.Name)) {
                this._diags.Error(DiagnosticCodes.UninitializedVariable,
                    "use of unassigned local variable `" + id.Name + "`", e.Span);
                // 报一次就当它已赋值 —— 同一个变量在后面每处再报一遍只是噪声。
                this._assigned.Put(id.Name, "1");
            }
            return;
        }

        if (e is BoundAssign) {
            // 赋值：只读 RHS。**不读 Target** —— 给未赋值的变量赋值正是让它变成已赋值。
            BoundAssign a = e as BoundAssign;
            this._reads(a.Value);
            if (!(a.Target is BoundIdent)) { this._reads(a.Target); }   // `arr[i] = v` 的 arr/i 要读
            else {
                // 重新赋值会**改写**空值事实（两个方向都要）：赋一个可空调用的结果 ⇒ 重新受检；
                // 赋一个已知非空的值 ⇒ 义务解除。只往一个方向走都会错。
                this._propagate((a.Target as BoundIdent).Name, a.Value);
            }
            return;
        }

        if (e is BoundBinary) {
            BoundBinary b = e as BoundBinary;
            this._reads(b.Left);
            // 短路求值自带窄化：`s == null || s.Length == 0`（String.IsNullOrEmpty 的原型）里
            // 右操作数只在左边为**假**时求值 ⇒ 那时 s 必非 null。`&&` 对称。
            // 不做这一步就会在这个最常见的写法上误报（D3：误报 = 漏了一种结构）。
            if (b.Op == "&&") { this._narrowNotNull(b.Left, true); }
            if (b.Op == "||") { this._narrowNotNull(b.Left, false); }
            this._reads(b.Right); return;
        }
        if (e is BoundUnary)   { this._reads((e as BoundUnary).Operand); return; }
        if (e is BoundMember) {
            BoundMember m = e as BoundMember;
            this._checkDeref(m.Target); this._reads(m.Target); return;
        }
        if (e is BoundIndex) {
            BoundIndex ix = e as BoundIndex;
            this._checkDeref(ix.Target);
            this._reads(ix.Target); this._reads(ix.Index); return;
        }
        if (e is BoundConditional) {
            BoundConditional c = e as BoundConditional;
            this._reads(c.Cond);
            this._narrowNotNull(c.Cond, true);    // `s != null ? s.Length : 0`
            this._reads(c.Then);
            this._narrowNotNull(c.Cond, false);   // `s == null ? 0 : s.Length`
            this._reads(c.Else); return;
        }
        if (e is BoundCall) {
            BoundCall c = e as BoundCall;
            if (c.Receiver != null) { this._checkDeref(c.Receiver); this._reads(c.Receiver); }
            int i = 0; while (i < c.ArgCount) { this._reads(c.Args[i]); i = i + 1; }
            return;
        }
        if (e is BoundIndirectCall) {
            BoundIndirectCall c = e as BoundIndirectCall;
            this._reads(c.Callee);
            int i = 0; while (i < c.ArgCount) { this._reads(c.Args[i]); i = i + 1; }
            return;
        }
        if (e is BoundNew) {
            BoundNew n = e as BoundNew;
            int i = 0; while (i < n.ArgCount) { this._reads(n.Args[i]); i = i + 1; }
            return;
        }
        if (e is BoundArrayLit) {
            BoundArrayLit a = e as BoundArrayLit;
            int i = 0; while (i < a.ElemCount) { this._reads(a.Elems[i]); i = i + 1; }
            return;
        }
        if (e is BoundArrayNew) { this._reads((e as BoundArrayNew).Size); return; }
        if (e is BoundCast)     { this._reads((e as BoundCast).E);       return; }
        if (e is BoundConvert)  { this._reads((e as BoundConvert).E);    return; }
        if (e is BoundBox)      { this._reads((e as BoundBox).E);        return; }
        if (e is BoundIsExpr)   { this._reads((e as BoundIsExpr).E);     return; }
        if (e is BoundIsPatternExpr) { this._reads((e as BoundIsPatternExpr).E); return; }
        if (e is BoundRefArg) {
            // `ref x`：取址即视为赋值（被取址的无 init 局部在声明处已回填 default(T)，
            // 见 simplify-ref-parameters）——不读、且标为已赋值。
            BoundRefArg r = e as BoundRefArg;
            if (r.Inner is BoundIdent) { this._assigned.Put((r.Inner as BoundIdent).Name, "1"); }
            else { this._reads(r.Inner); }
            return;
        }
        if (e is BoundInterpolatedStr) {
            BoundInterpolatedStr s = e as BoundInterpolatedStr;
            int i = 0;
            while (i < s.PartCount) {
                if (s.Parts[i] is BoundInterpHole) { this._reads((s.Parts[i] as BoundInterpHole).Inner); }
                i = i + 1;
            }
            return;
        }
        if (e is BoundSeqExpr) {
            BoundSeqExpr q = e as BoundSeqExpr;
            int i = 0; while (i < q.PreludeCount) { this._stmt(q.Prelude[i]); i = i + 1; }
            this._reads(q.Value);
            return;
        }
        if (e is BoundSwitchExpr) {
            BoundSwitchExpr sx = e as BoundSwitchExpr;
            this._reads(sx.Subject);
            int i = 0;
            while (i < sx.ArmCount) {
                if (sx.Arms[i].Guard != null) { this._reads(sx.Arms[i].Guard); }
                this._reads(sx.Arms[i].Body);
                i = i + 1;
            }
            return;
        }
        // BoundLambda：体内的读用外层快照查，但不回传赋值（捕获时机不确定）。
        if (e is BoundLambda) {
            BoundLambda lm = e as BoundLambda;
            if (lm.ExprBody != null) {
                StrMap prev = this._assigned;
                this._assigned = FlowAnalyzer._copy(prev);
                this._reads(lm.ExprBody);
                this._assigned = prev;
            }
            return;
        }
        // 字面量 / typeof / methodof / 静态读 / 方法组 / 捕获标识符 等：无局部读。
    }

    // ── 空值义务点（define-null-check-marks）────────────────────────────────

    // 解引用一个「可能为 null」的名字 → E0478。
    //
    // 报一次就清掉事实 —— 同一个变量在后面每处再报一遍只是噪声（同 E0407 的处置）。
    private void _checkDeref(BoundExpr e) {
        if (e == null) { return; }
        // 三类义务来源：调用结果（返回值标记）/ 裸名（形参标记）/ 字段与属性（字段标记）。
        if (e is BoundCall) {
            BoundCall c = e as BoundCall;
            if (!c.RetIsNullable) { return; }
            this._diags.Error(DiagnosticCodes.DereferenceOfNullMarked,
                "`" + c.MethodName + "` returns a `?`-marked type and may be null here — "
                + "assign it to a local and check that (e.g. `var v = …; if (v != null) { … }`)", e.Span);
            return;
        }
        if (e is BoundMember) { this._checkFieldDeref(e as BoundMember); return; }
        if (!(e is BoundIdent)) { return; }
        BoundIdent id = e as BoundIdent;
        if (!this._isMaybeNull(id.Name)) { return; }
        this._diags.Error(DiagnosticCodes.DereferenceOfNullMarked,
            "`" + id.Name + "` is marked `?` and may be null here — check it before dereferencing "
            + "(e.g. `if (" + id.Name + " != null) { … }`)", e.Span);
        this._maybeNull.Put(id.Name, "0");
    }

    // 把右侧表达式的空值性传给名字 `name`。
    //
    // ⭐ **义务集只能由 `?` 标记产生，赋值只能更新、不能新增。**
    // 起初我让「赋 null 字面量」也建立事实，结果在 `z42.net/HttpClient` 上误报：
    // `TcpClient client = null;` —— 一个**没标 `?`** 的普通局部，随后在循环里被赋上真值。
    // 那等于偷偷开了**悲观档**（所有引用类型都受检），而那正是设计里明确不做、
    // User 也否掉过的一档。`null` 字面量本身不是标记。
    private void _propagate(string name, BoundExpr v) {
        if (FlowAnalyzer._isNullableCall(v)) { this._maybeNull.Put(name, "1"); return; }
        // 快照：`var v = this.F;` —— 义务从字段转移到这个局部。这条是字段那半的**逃生口本身**，
        // 不是可选优化：没有它，标了 `?` 的字段就只剩「无处可用」。
        if (FlowAnalyzer._isMarkedFieldExpr(this, v)) { this._maybeNull.Put(name, "1"); return; }
        // 只更新**已在义务集内**的名字：赋 null ⇒ 重新受检；赋别的 ⇒ 义务解除。
        if (!this._maybeNull.ContainsKey(name)) { return; }
        if (v is BoundLitNull) { this._maybeNull.Put(name, "1"); }
        else { this._maybeNull.Put(name, "0"); }
    }

    private static bool _isNullableCall(BoundExpr e) {
        if (e == null) { return false; }
        if (!(e is BoundCall)) { return false; }
        return (e as BoundCall).RetIsNullable;
    }

    // ── 字段：义务点（永不窄化，见类首注释）───────────────────────────────

    // 这个成员访问是不是「标了 `?` 的字段/属性」。
    //
    // 标记从**接收者的类型**上查，而不是从「当前类」查 —— 这样 `this.F` 与 `other.F`
    // 走同一条路，不用把 enclosing 类当参数串下来。查不到（接收者不是类类型 /
    // 成员不是字段）一律返 false：**漏报方向**，符合 D4。
    private bool _isMarkedField(BoundMember m) {
        if (m == null) { return false; }
        if (m.Target == null) { return false; }
        Z42Type t = m.Target.Type();
        if (!(t is Z42ClassType)) { return false; }
        FieldSymbol f = (t as Z42ClassType).Fields.Get(m.MemberName) as FieldSymbol;
        if (f == null) { return false; }
        return f.IsNullable;
    }

    private static bool _isMarkedFieldExpr(FlowAnalyzer fa, BoundExpr e) {
        if (!(e is BoundMember)) { return false; }
        return fa._isMarkedField(e as BoundMember);
    }

    // 字段路径键，只用于「同一路径在本方法里只报一次」的去重。
    // 只认**接收者是裸名**的一层（`this.F` / `x.F`）；更深的链（`a.b.F`）返 ""，不去重也不漏报。
    private static string _fieldKey(BoundMember m) {
        if (m.Target is BoundIdent) { return (m.Target as BoundIdent).Name + "." + m.MemberName; }
        return "";
    }

    // 解引用一个标了 `?` 的字段 → E0484。
    //
    // 规则 (a)（design §D4）：**永不窄化**。`if (this.F != null) { this.F.M(); }` 照样报，
    // 因为那是**两次独立的读**：别的线程能在中间写；`F` 若是属性还是两次真调用，返回值可以不同。
    // 修法是快照到局部再检查那个局部 —— 局部是个值，检查一次就永远成立。
    private void _checkFieldDeref(BoundMember m) {
        if (!this._isMarkedField(m)) { return; }
        // 同一个字段路径在一个方法里只报一次 —— 一次快照就把这个方法里的全部站点一并修掉，
        // 每处再报一遍只是噪声（同 E0407 / E0478 的处置）。
        string key = FlowAnalyzer._fieldKey(m);
        if (key != "" && this._fieldReported.ContainsKey(key)) { return; }
        if (key != "") { this._fieldReported.Put(key, "1"); }
        string recv = "";
        if (m.Target is BoundIdent) { recv = (m.Target as BoundIdent).Name + "."; }
        string msg = "`" + m.MemberName + "` is marked `?` and may be null here — a field is re-read "
            + "on every access (and a property is re-invoked), so checking it in place does not make "
            + "the next read non-null; snapshot it into a local and check that "
            + "(e.g. `var v = " + recv + m.MemberName + "; if (v != null) { … }`)";
        this._diags.Error(DiagnosticCodes.NullableFieldNotSnapshotted, msg, m.Span);
    }

    // 把可空值 `return` 给**未标 `?`** 的返回类型 → E0479。
    // 未标的返回类型意味着「调用方不必检查」，所以这里放行就等于凭空造了一个洞。
    // 修法有两条，诊断里都给出来：给返回类型加 `?`（把义务传给调用方），或在这里先检查。
    //
    // ⚠️ 只认**确定性**来源（标 `?` 的名字 / 标 `?` 的调用结果）。
    // `return null;` 字面量本身**不报** —— 那是 design D8 的反向推导，是「建议加 `?`」
    // 而非「这里有错」，留给后续 PR，免得和本码混成一团。
    private void _checkReturn(BoundExpr v) {
        if (this._retIsNullable) { return; }
        bool bad = false;
        if (v is BoundIdent) { bad = this._isMaybeNull((v as BoundIdent).Name); }
        else if (FlowAnalyzer._isNullableCall(v)) { bad = true; }
        else if (FlowAnalyzer._isMarkedFieldExpr(this, v)) { bad = true; }
        if (!bad) { return; }
        this._diags.Error(DiagnosticCodes.PossibleNullReturn,
            "returning a value that may be null from a return type not marked `?` — "
            + "callers of this method have no obligation to check it; "
            + "either mark the return type `?` or check before returning", v.Span);
    }

    private bool _isMaybeNull(string name) {
        if (!this._maybeNull.ContainsKey(name)) { return false; }
        object v = this._maybeNull.Get(name);
        return (v as string) == "1";
    }

    // `cond` 里能确定「x 非 null」的名字 → 置为已检查。
    //
    // 只认最直接的形态（`x != null` / `null != x`，加 `&&` / `||` / `!` 的组合）。
    // **认不出的形态不做窄化 ⇒ 多报**，所以这里宁可多认；而分支间的隔离与合并交给
    // `_if`（见那里的 join），窄化不会越过它该管的范围。
    //
    // ⚠️ 已知的漏报：`&&` / `||` / 三元里的窄化在**同一条语句内**不回滚，
    // 例如 `bool b = s == null || s.Length == 0; return s.Length;` 的第二处不会报。
    // 按 D4（漏报可接受、误报不可以）留着——把表达式级也做成 join 要另起一套状态机。
    // 字段/属性走另一条路（E0484 强制快照，**不在这里窄化**）。
    private void _narrowNotNull(BoundExpr cond, bool whenTrue) {
        if (cond == null) { return; }
        if (cond is BoundBinary) {
            BoundBinary b = cond as BoundBinary;
            if (b.Op == "&&" && whenTrue) { this._narrowNotNull(b.Left, true); this._narrowNotNull(b.Right, true); return; }
            if (b.Op == "||" && !whenTrue) { this._narrowNotNull(b.Left, false); this._narrowNotNull(b.Right, false); return; }
            bool ne = (b.Op == "!=");
            bool eq = (b.Op == "==");
            if (!ne && !eq) { return; }
            // 想要的是「这一支里 x 非 null」：`x != null` 的 true 支，或 `x == null` 的 false 支。
            if (ne != whenTrue) { return; }
            string n = FlowAnalyzer._nullCompareName(b);
            if (n != "") { this._maybeNull.Put(n, "0"); }
            // ⚠️ 字段**故意不在这里窄化**（`this.F != null` 不产生任何事实）——那正是
            // 「强制快照」的全部内容，Q1 实测定的（见类首注释）。
            return;
        }
        if (cond is BoundUnary) {
            BoundUnary u = cond as BoundUnary;
            if (u.Op == "!") { this._narrowNotNull(u.Operand, !whenTrue); }
            return;
        }
    }

    // `x != null` / `null != x` → "x"；否则 ""。
    private static string _nullCompareName(BoundBinary b) {
        if ((b.Right is BoundLitNull) && (b.Left is BoundIdent))  { return (b.Left  as BoundIdent).Name; }
        if ((b.Left  is BoundLitNull) && (b.Right is BoundIdent)) { return (b.Right as BoundIdent).Name; }
        return "";
    }

    // ── 集合助手 ────────────────────────────────────────────────────────────

    private static StrMap _copy(StrMap m) {
        StrMap r = new StrMap();
        int i = 0;
        while (i < m.Capacity()) {
            if (m.UsedAt(i)) { r.Put(m.KeyAt(i), "1"); }
            i = i + 1;
        }
        return r;
    }

    // `_copy` 把所有键一律写 "1"（它服务的是 `_assigned` 那个纯集合）。
    // `_maybeNull` 的值有意义（"1" 可能为 null / "0" 已窄化），必须原样搬。
    private static StrMap _copyNull(StrMap m) {
        StrMap r = new StrMap();
        int i = 0;
        while (i < m.Capacity()) {
            if (m.UsedAt(i)) { r.Put(m.KeyAt(i), (m.Get(m.KeyAt(i)) as string)); }
            i = i + 1;
        }
        return r;
    }

    // 「可能为 null」是 **may** 集合（与 `_assigned` 的 must 集合方向相反）：
    // 只要某条可达支上它仍可能为 null，合并之后就仍然可能。
    private static StrMap _joinNull(StrMap a, StrMap b) {
        StrMap r = FlowAnalyzer._copyNull(a);
        int i = 0;
        while (i < b.Capacity()) {
            if (b.UsedAt(i)) {
                string k = b.KeyAt(i);
                if ((b.Get(k) as string) == "1") { r.Put(k, "1"); }
            }
            i = i + 1;
        }
        return r;
    }

    private static void _union(StrMap dst, StrMap src) {
        int i = 0;
        while (i < src.Capacity()) {
            if (src.UsedAt(i)) { dst.Put(src.KeyAt(i), "1"); }
            i = i + 1;
        }
    }

    // a 与 b 的交集（新表）。
    private static StrMap _common(StrMap a, StrMap b) {
        StrMap r = new StrMap();
        int i = 0;
        while (i < a.Capacity()) {
            if (a.UsedAt(i) && b.ContainsKey(a.KeyAt(i))) { r.Put(a.KeyAt(i), "1"); }
            i = i + 1;
        }
        return r;
    }

    private static void _unionCommon(StrMap dst, StrMap a, StrMap b) {
        FlowAnalyzer._union(dst, FlowAnalyzer._common(a, b));
    }
}
