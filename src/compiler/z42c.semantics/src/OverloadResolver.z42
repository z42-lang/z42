// 方法重载决议 + 签名键派生（add-type-based-overloads）。
//
// z42c 方法身份 = 精确函数签名（name + 形参类型序列）。签名键统一派生、可序列化、跨包可复算：
//   key = Name$arity[$T1$T2...]，Ti = PrimModel.Canon(paramType.Name())（剥空白）。
//   用 Canon 归一基本类型别名 + 剥 nullable → imported（keyword 拼写）与本地（canonical）两侧一致。
//
// 决议：候选集（同名所有重载，沿 base 链聚合）→ 适用性（arity + 每位 IsAssignableTo）→
//   最具体（better-conversion 偏序：精确匹配优于加宽/装箱）→ 唯一极小 = 选中 / 空 = no-match /
//   多个不可比 = 歧义。v1 不做 int→long→double 隐式数值排序（并列即歧义，让用户显式 cast）。
namespace Z42.Semantics;

using Z42.Syntax;   // MethodKeyOf 收 MethodDecl（阶段 1 的 `using Z42.IR` 是 DRAFT 版签名
                    // 收 StrMap 时加的，实现改收类型后就没用了 —— 顺手订正）

// 决议结果（z42 无元组 → holder）。Kind：0=Resolved，1=NoMatch，2=Ambiguous。
public sealed class OverloadResult {
    public int          Kind;
    public MethodSymbol Method;   // Kind==0 时有效
    public string       Key;      // 选中重载的签名键（Kind==0）
    public OverloadResult(int kind, MethodSymbol method, string key) {
        this.Kind = kind; this.Method = method; this.Key = key;
    }
    public bool IsResolved()  { return this.Kind == 0; }
    public bool IsNoMatch()   { return this.Kind == 1; }
    public bool IsAmbiguous() { return this.Kind == 2; }
}

// 实参形态（fix-overload-defaults-named-args）：位置实参类型（null = 无类型的延迟实参，按通配处理）+ 命名实参名与类型。
public sealed class ArgShape {
    public int       PosCount;
    public Z42Type[] PosTypes;
    public string[]  Names;
    public Z42Type[] NamedTypes;
    public int       NamedCount;
    public ArgShape(int posCount, int namedCount) {
        this.PosCount = posCount; this.PosTypes = new Z42Type[posCount];
        this.NamedCount = namedCount; this.Names = new string[namedCount]; this.NamedTypes = new Z42Type[namedCount];
    }
}

// 单个候选的映射结果：是否适用、是否需要默认值、是否 params 展开形态，以及每个实参映射到的形参类型。
public sealed class MapResult {
    public bool      Ok;
    public bool      NeedsDefaults;
    public bool      Expanded;
    public Z42Type[] PosParam;
    public Z42Type[] NamedParam;
    public MapResult(int posCount, int namedCount) {
        this.Ok = false; this.NeedsDefaults = false; this.Expanded = false;
        this.PosParam = new Z42Type[posCount]; this.NamedParam = new Z42Type[namedCount];
    }
}

public sealed class OverloadResolver {

    // ── 注册键解析（唯一 owner）────────────────────────────────────────────
    // unify-regkey-source-of-truth：**「这个声明应解析到哪个注册键」的唯一实现。**
    //
    // 注意它回答的不是「这个声明注册在哪个键下」——两者对**被擦除的 decl-only partial
    // method** 不同：那种方法自己不注册（`MemberCollector` 的擦除分支），但它的实现在
    // 另一个碎片里注册着，消费方要的正是后者的键。
    //
    // 此前这段逻辑被**手抄了 7 份**（ClassExtractor ×2 / DeclBinder ×3 /
    // IrGenTypeEmitter / IrGenMemberEmitter）。stabilize-instance-dispatch-keys（#414）
    // 改键规则时漏同步其中一份（ClassExtractor 的祖先方法导出），拿错 symbol 后
    // `sig.ParamTypes[1]` 在 len-1 上越界，gen2 z42c 建 z42.core 直接崩 —— 那次返工的
    // 直接成因就是这份复制。收敛到此处后，改键规则只需动这一个地方。
    //
    // **阶段 2（本变更）：回落已删。** 写侧收敛后，进到这 6 个消费点的 MethodDecl 全部
    // 经 `MemberCollector._fillClass`（含擦除分支顺手写键）或 `InheritanceResolver._passImpls`
    // 填过 RegKey —— 回落分支在全仓库 + 自举 + 全套测试下**一次都不触发**（用「命中即抛」
    // 的探针实测过）。故不再按名字猜键，改为**守住不变量**：
    //
    //   RegKey 为空 = 有新的注册路径漏走 `SymbolCollector.RegisterMethod`（唯一注册入口）。
    //
    // 这里**必须抛而不是回落**：派发相关缺陷的失败模式是「静默派发到错误目标」——
    // 猜出来的裸名可能恰好命中**另一个同名重载**（#414 后 primary 才是裸键），
    // 编译照样成功、跑起来才错。宁可在编译期炸出调用栈。
    // 不接收 owner（不再查表）：调用点少一个「拿 owner」的负担，也杜绝「传错 owner
    // 导致解析到别的类型」这类新错法。
    public static string MethodKeyOf(MethodDecl md) {
        if (md.RegKey == "") {
            throw new Exception("MethodKeyOf: method `" + md.Name + "` has no RegKey — "
                + "注册路径漏走 SymbolCollector.RegisterMethod（unify-regkey 不变量）");
        }
        return md.RegKey;
    }

    // ── 签名键派生 ──────────────────────────────────────────────────────────
    // 统一签名键：每个方法（含唯一方法）一律编码完整签名。定义点与跨包 import 两侧用本函数 +
    // 解析后类型 .Name() → round-trip 一致。
    public static string MangleKey(string name, Z42Type[] paramTypes, int paramCount) {
        string s = name + "$" + paramCount.ToString();
        int i = 0;
        while (i < paramCount) {
            s = s + "$" + OverloadResolver.TypeKey(paramTypes[i]);
            i = i + 1;
        }
        return s;
    }

    // 单个形参类型 → 键片段：Canon 归一（基本别名 + 剥 nullable）后剥空白（泛型名含 ", "）。
    // unify-value-types Phase 1：**复合类型（array / instantiated / func）里的内建叶子必须用
    // keyword 拼写**（PrimModel.Canon：Char→"char"、Int32→"int"、Byte→"byte"），复刻翻转前
    // Z42PrimType 承载的名——否则 `char[]` 变 `Char[]`，与 TSIG 源拼写导出键失配 → 跨包
    // `undefined function`。裸内建仍走 Canon（int→"int"）。二者的非对称正是逐字节
    // 复刻旧 `Canon(Name())`：旧 Canon 只归一裸名、不进 "[]"/"<>" 内部，故内部叶子保留 keyword 拼写。
    public static string TypeKey(Z42Type t) {
        if (t == null) { return "unknown"; }
        if ((t is Z42ArrayType) || (t is Z42InstantiatedType) || (t is Z42FuncType)) {
            return OverloadResolver._stripSpaces(OverloadResolver._compositeKeyName(t));
        }
        return OverloadResolver._stripSpaces(t.CanonName());
    }

    // 复合类型名重建（镜像各 Z42Type.Name() 的字符串格式），但内建叶子映射回 keyword 拼写。
    private static string _compositeKeyName(Z42Type t) {
        if (t is Z42ArrayType) { return OverloadResolver._compositeKeyName((t as Z42ArrayType).Elem) + "[]"; }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it = t as Z42InstantiatedType;
            string s = it.Def.Name() + "<";
            int i = 0;
            while (i < it.ArgCount) { if (i > 0) { s = s + ", "; } s = s + OverloadResolver._compositeKeyName(it.TypeArgs[i]); i = i + 1; }
            return s + ">";
        }
        if (t is Z42FuncType) {
            Z42FuncType ft = t as Z42FuncType;
            bool isVoid = ft.Ret is Z42VoidType;
            string s = "Func<";
            if (isVoid) { if (ft.ParamCount == 0) { return "Action"; } s = "Action<"; }
            int i = 0;
            while (i < ft.ParamCount) { if (i > 0) { s = s + ", "; } s = s + OverloadResolver._compositeKeyName(ft.ParamTypes[i]); i = i + 1; }
            if (!isVoid) { if (ft.ParamCount > 0) { s = s + ", "; } s = s + OverloadResolver._compositeKeyName(ft.Ret); }
            return s + ">";
        }
        // 叶子：内建 → keyword 拼写（复刻翻转前 Z42PrimType 名）；其余 → 原名。
        if (t is Z42ClassType) { int _c = t.PrimCode(); if (_c >= 0) { return PrimModel.KeywordOfCode(_c); } }
        return t.Name();
    }

    // perf-compiler-lookup-tables：单趟 char[] 过滤（原 Substring(i,1) + 串拼接为 O(n²) 且每字符两次分配）。
    private static string _stripSpaces(string s) {
        char[] cs = s.ToCharArray();
        int keep = 0;
        int i = 0;
        while (i < cs.Length) { if (cs[i] != ' ') { keep = keep + 1; } i = i + 1; }
        if (keep == cs.Length) { return s; }
        char[] outc = new char[keep];
        int k = 0;
        i = 0;
        while (i < cs.Length) { if (cs[i] != ' ') { outc[k] = cs[i]; k = k + 1; } i = i + 1; }
        return String.FromChars(outc);
    }

    // ── 决议 ────────────────────────────────────────────────────────────────
    // candidates = 同名所有重载（调用方枚举）；argTypes = 实参解析类型。
    public static OverloadResult Resolve(MethodSymbol[] candidates, int candCount,
                                         Z42Type[] argTypes, int argCount, SymbolTable symbols) {
        // 1. 适用集
        MethodSymbol[] applic = new MethodSymbol[candCount];
        int ac = 0;
        int i = 0;
        while (i < candCount) {
            if (OverloadResolver._applicable(candidates[i], argTypes, argCount, symbols)) {
                applic[ac] = candidates[i]; ac = ac + 1;
            }
            i = i + 1;
        }
        if (ac == 0) { return new OverloadResult(1, null, ""); }
        if (ac == 1) {
            return new OverloadResult(0, applic[0], applic[0].RegKey);
        }
        // 2. 最具体：找一个 betterThan 所有其它的候选
        int bestIdx = 0 - 1;
        int j = 0;
        while (j < ac) {
            bool dominatesAll = true;
            int k = 0;
            while (k < ac) {
                if (k != j) {
                    if (!OverloadResolver._betterThan(applic[j], applic[k], argTypes, argCount, symbols)) {
                        dominatesAll = false;
                    }
                }
                k = k + 1;
            }
            if (dominatesAll) {
                if (bestIdx >= 0) {
                    // 两个都"支配所有" → 不可能除非相等签名；保守判歧义
                    return new OverloadResult(2, null, "");
                }
                bestIdx = j;
            }
            j = j + 1;
        }
        if (bestIdx < 0) { return new OverloadResult(2, null, ""); }   // 无唯一极小 → 歧义
        return new OverloadResult(0, applic[bestIdx], applic[bestIdx].RegKey);
    }

    // 候选适用 ⟺ arity 匹配 ∧ 每个实参可赋值到对应形参（含子类→基类 / prim→object 装箱 / 接口实现）。
    private static bool _applicable(MethodSymbol ms, Z42Type[] argTypes, int argCount, SymbolTable symbols) {
        Z42FuncType sig = ms.Signature;
        if (sig.ParamCount != argCount) { return false; }
        int i = 0;
        while (i < argCount) {
            if (!OverloadResolver._assignable(argTypes[i], sig.ParamTypes[i], symbols)) { return false; }
            i = i + 1;
        }
        return true;
    }

    // X 比 Y 更优 ⟺ 每个位置 X 不差于 Y（X 的形参更精确或同等）且至少一处严格更优。
    private static bool _betterThan(MethodSymbol x, MethodSymbol y, Z42Type[] argTypes, int argCount, SymbolTable symbols) {
        Z42FuncType sx = x.Signature;
        Z42FuncType sy = y.Signature;
        bool someStrict = false;
        int i = 0;
        while (i < argCount) {
            int c = OverloadResolver._betterAtPos(sx.ParamTypes[i], sy.ParamTypes[i], argTypes[i], symbols);
            if (c < 0) { return false; }       // 某位 X 更差 → 非更优
            if (c > 0) { someStrict = true; }
            i = i + 1;
        }
        return someStrict;
    }

    // 位置比较：+1 = px 比 py 更适合 argType，-1 = 更差，0 = 同等。
    internal static int _betterAtPos(Z42Type px, Z42Type py, Z42Type arg, SymbolTable symbols) {
        bool exX = OverloadResolver._sameType(arg, px);
        bool exY = OverloadResolver._sameType(arg, py);
        if (exX && !exY) { return 1; }
        if (exY && !exX) { return 0 - 1; }
        if (exX && exY)  { return 0; }
        // 都非精确：更"具体"的形参类型胜（px 可赋值到 py 而非反向 → px 更派生/更具体）。
        bool xToY = OverloadResolver._assignable2(px, py, symbols);
        bool yToX = OverloadResolver._assignable2(py, px, symbols);
        if (xToY && !yToX) { return 1; }
        if (yToX && !xToY) { return 0 - 1; }
        return 0;
    }

    // ── 实参映射决议（fix-overload-defaults-named-args）────────────────────────
    // 上面的 `Resolve` 只认「形参个数 == 实参个数」。带默认值的重载在少给实参时、命名实参在多个重载时，
    // 都进不了它的候选集 ⇒ 要么「找不到方法」，要么落到别的兜底上**静默选错**。本段按 C# 的规则把
    // 实参映射到形参再判适用：
    //   · 位置实参依次占前面的形参；命名实参按名占位（名字不存在 / 重复 / 与位置实参撞位 ⇒ 不适用）
    //   · 被占的形参：实参类型可赋值（无类型的延迟实参——target-typed `new()`、lambda——视为通配）
    //   · 未被占的形参：必须有默认值（本地 Default / 跨包 `$Default` / caller 宏）或是 params 尾参
    //   · params：正常形态（实参本身是数组）/ 展开形态（多余位置实参逐个可赋值到元素类型）
    // 择优：逐实参比较所映射形参的具体程度（同 `_betterAtPos`）；仍平手时，不需要默认值的胜，非展开形态胜。
    // 只在既有路径失败或会选错的地方调用（见 OverloadBinder / ConstructTyper 的调用点），今天能解析的调用不经过这里。
    public static MapResult Map(MethodSymbol m, ArgShape a, SymbolTable symbols) {
        MapResult r = new MapResult(a.PosCount, a.NamedCount);
        Z42FuncType sig = m.Signature;
        if (sig == null) { return r; }
        int pc = sig.ParamCount;
        int pf = sig.ParamsFrom;
        bool[] filled = new bool[pc];
        int fixedCount = pf >= 0 ? pf : pc;
        int i = 0;
        while (i < a.PosCount) {
            Z42Type at = a.PosTypes[i];
            if (i < fixedCount) {
                Z42Type pt = sig.ParamTypes[i];
                if (at != null && !OverloadResolver._assignable(at, pt, symbols)) { return r; }
                r.PosParam[i] = pt; filled[i] = true;
            } else if (pf >= 0) {
                Z42ArrayType arr = sig.ParamTypes[pf] as Z42ArrayType;
                if (arr == null) { return r; }
                bool normal = a.PosCount == pc && i == pf && (at == null || OverloadResolver._assignable(at, arr, symbols));
                if (normal) {
                    r.PosParam[i] = arr;
                } else {
                    if (at != null && !OverloadResolver._assignable(at, arr.Elem, symbols)) { return r; }
                    r.PosParam[i] = arr.Elem; r.Expanded = true;
                }
                filled[pf] = true;
            } else {
                return r;   // 位置实参多于形参
            }
            i = i + 1;
        }
        int j = 0;
        while (j < a.NamedCount) {
            if (!CallParams.CanName(m)) { return r; }   // 无形参名（导入符号未带名）→ 命名实参不可映射
            int idx = CallParams.IndexOf(m, a.Names[j]);
            if (idx < 0 || idx >= pc || filled[idx]) { return r; }
            Z42Type npt = sig.ParamTypes[idx];
            Z42Type nat = a.NamedTypes[j];
            if (nat != null && !OverloadResolver._assignable(nat, npt, symbols)) { return r; }
            r.NamedParam[j] = npt; filled[idx] = true;
            j = j + 1;
        }
        int q = 0;
        while (q < pc) {
            if (!filled[q]) {
                if (q == pf) { r.Expanded = true; }
                else if (OverloadResolver._hasDefault(m, q)) { r.NeedsDefaults = true; }
                else { return r; }
            }
            q = q + 1;
        }
        r.Ok = true;
        return r;
    }

    private static bool _hasDefault(MethodSymbol m, int i) {
        if (m.HasDecl && m.Decl != null && i < m.Decl.ParamCount) { return m.Decl.Params[i].Default != null; }
        Z42FuncType sig = m.Signature;
        if (sig.ParamDefaults != null && i < sig.ParamDefaults.Length && sig.ParamDefaults[i] != null && sig.ParamDefaults[i] != "") { return true; }
        if (sig.ParamCallers != null && i < sig.ParamCallers.Length && sig.ParamCallers[i] != null && sig.ParamCallers[i] != "") { return true; }
        return false;
    }

    public static OverloadResult ResolveMapped(MethodSymbol[] cands, int n, ArgShape a, SymbolTable symbols) {
        MethodSymbol[] app = new MethodSymbol[n];
        MapResult[] maps = new MapResult[n];
        int ac = 0;
        int i = 0;
        while (i < n) {
            MapResult mr = OverloadResolver.Map(cands[i], a, symbols);
            if (mr.Ok) { app[ac] = cands[i]; maps[ac] = mr; ac = ac + 1; }
            i = i + 1;
        }
        if (ac == 0) { return new OverloadResult(1, null, ""); }
        if (ac == 1) { return new OverloadResult(0, app[0], app[0].RegKey); }
        int best = 0 - 1;
        int x = 0;
        while (x < ac) {
            bool dominates = true;
            int y = 0;
            while (y < ac) {
                if (y != x && !OverloadResolver._mappedBetter(maps[x], maps[y], a, symbols)) { dominates = false; }
                y = y + 1;
            }
            if (dominates) {
                if (best >= 0) { return new OverloadResult(2, null, ""); }
                best = x;
            }
            x = x + 1;
        }
        if (best < 0) { return new OverloadResult(2, null, ""); }
        return new OverloadResult(0, app[best], app[best].RegKey);
    }

    // X 严格优于 Y：逐实参不差且至少一处更好；逐实参全平手时，看「不需要默认值」再看「非展开形态」。
    private static bool _mappedBetter(MapResult x, MapResult y, ArgShape a, SymbolTable symbols) {
        bool strict = false;
        int i = 0;
        while (i < a.PosCount) {
            int c = OverloadResolver._betterAtPos(x.PosParam[i], y.PosParam[i], a.PosTypes[i], symbols);
            if (c < 0) { return false; }
            if (c > 0) { strict = true; }
            i = i + 1;
        }
        int j = 0;
        while (j < a.NamedCount) {
            int c = OverloadResolver._betterAtPos(x.NamedParam[j], y.NamedParam[j], a.NamedTypes[j], symbols);
            if (c < 0) { return false; }
            if (c > 0) { strict = true; }
            j = j + 1;
        }
        if (strict) { return true; }
        if (!x.NeedsDefaults && y.NeedsDefaults) { return true; }
        if (x.NeedsDefaults == y.NeedsDefaults && !x.Expanded && y.Expanded) { return true; }
        return false;
    }

    // 类型相等（规范名比较，归一别名）。
    private static bool _sameType(Z42Type a, Z42Type b) {
        if (a == null || b == null) { return false; }
        return a.CanonName() == b.CanonName();
    }

    // 实参类型可赋值到形参类型（复用 Z42Type.IsAssignableTo + 精确名等价兜底 + 类表引用上转）。
    //
    // fix-overload-ref-conversion：`Z42Type.IsAssignableTo` **不带符号表**，而
    // `Z42ClassType.IsAssignableTo` 自己的注释就写着「1A-1 不查继承链；subclass→base 需类表走 base 链」。
    // 于是被漏掉的恰好是**需要类表**的三条：派生→基、类→接口、实例化泛型→基/接口；
    // 而数值加宽（PrimModel.CanWiden）与 object（下面第二行短路）不需类表，所以它们一直过得去
    // —— 这就是「数值和 object 行、用户类层次不行」这个反直觉现象的全部原因。
    //
    // 窄口用 `ConvKind.ImplicitRef` 而不是 `TypeFactsTc._isAssignable`（= `Classify(...).ImplicitOk()`）：
    // 后者白名单还含 ImplicitNumeric / Boxing / UserImplicit，换过去会把数值门从 CanWiden 换成更严的
    // _widensLossless（诊断质量倒退），并把用户 op_Implicit 拉进重载适用性（语义扩张，属另一件事）。
    // 窄口 = 只补需要类表的那几条，数值 / object / 装箱 / 泛型擦除的行为逐位不变。
    //
    // symbols 可为 null（判据层单测传 null）→ 退化为改动前行为。
    internal static bool _assignable(Z42Type arg, Z42Type param, SymbolTable symbols) {
        if (OverloadResolver._sameType(arg, param)) { return true; }
        // 任意 → object 装箱/上转。阶段 3：object 形参现恒 Z42ClassType(Object)（Name()="Object"），
        // 须按 PrimModel.Canon 归一（与 _assignable2 同款），否则 raw "object" 失配 → object 形参
        // 重载（如 StrMap.Put(string,object)）对任意实参判不适用。
        if (param != null && param.CanonName() == "object") { return true; }
        if (arg == null) { return false; }
        if (arg.IsAssignableTo(param)) { return true; }
        return OverloadResolver._refUpcast(arg, param, symbols);
    }

    // 🔴 _assignable2（择优用）必须与 _assignable **同一批**认类层次。
    // C# 的「更派生的形参更优」在这套实现里是自动推出来的（_betterAtPos：px 可赋到 py 而非反向
    // ⇒ px 更具体），前提是这里也认。只改 _assignable 不改这里，`F(A)`+`F(M)` 传 `D:M:A` 会从
    // 「找不到」变成「歧义 E0425」—— 用户体验没变好，还多一种错法。
    private static bool _assignable2(Z42Type a, Z42Type b, SymbolTable symbols) {
        if (OverloadResolver._sameType(a, b)) { return true; }
        // unify-value-types Phase 1：任意 → object（翻转后 object→Z42ClassType(Object)，Canon 归一）。
        if (b != null && b.CanonName() == "object") { return true; }
        if (a == null) { return false; }
        if (a.IsAssignableTo(b)) { return true; }
        return OverloadResolver._refUpcast(a, b, symbols);
    }

    // 引用上转（派生→基 / 类→接口 / inst→基·接口 / 数组→Array）——Conversion 里这条路本来就是齐的
    // 且都带符号表（分支 E/F/G/H/H2 走 symbols.IsSubclassOf / symbols.Implements）。
    private static bool _refUpcast(Z42Type from, Z42Type to, SymbolTable symbols) {
        if (symbols == null || to == null) { return false; }
        return Conversion.Classify(from, to, symbols).Kind == ConvKind.ImplicitRef;
    }
}
