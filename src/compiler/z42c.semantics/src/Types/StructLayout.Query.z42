// StructLayout 的**读端查询面**（StructLayout 的 partial 分片；拆分只为守 code-organization 的 886 行硬限，
// 主文件此前 883 行贴着上限）：「这个名字是不是 struct / 实例化布局是否异于定义 / 名字拆基名与实参 /
// 字段的下标·偏移·类型名·是否 struct / 总大小」。不碰计算与缓存流程（那些留在主文件：BuildFromSymbols /
// _compute* / ForkView）；与主文件同一个类、共享其 private 面。
namespace Z42.Semantics;

using Z42.IR;   // StrMap

public sealed partial class StructLayout {
    // 某类型名是不是 struct（值类型）。
    public bool IsStructType(string typeName) {
        // generic-struct-erased-slot-value-copy：实例化名（`Pair<P2,int>`）按**基名**判定是不是 struct
        // ——`_defs` 只存定义。基名是 struct ⇒ 其任何实例化也是 struct。
        return this._defs.ContainsKey(LayoutKey.Norm(StructLayout.BaseNameOf(typeName)));
    }

    // 某实例化的布局是否**真的不同于定义布局**——这是「要不要特化」的唯一判据。
    //
    // 为什么不是「有没有 blob struct 实参」（我最初的判据，实测错）：定义把**所有**型参字段当
    // 8B `GcRef` 引用叶子，而实例化按实参真实种类排布。于是 `Pair<int,long>` 虽无 struct 实参，
    // 布局也不同（定义有两个引用叶子 @0/@8；实例化零引用叶子、int@0 + long@8）。漏掉它 ⇒ 它作为
    // 内层被内联进外层后，`pp.First.Second` 会按定义布局把 `B` 当 Object 引用写 ⇒ 运行期
    // `struct ref leaf at byte offset 8 not in type layout`。
    //
    // 这个判据同时自带闸门性质：布局**相同**则特化是 no-op，跳过即产出逐字节不变。
    public bool InstDiffersFromDef(string instName) {
        string baseName = StructLayout.BaseNameOf(instName);
        if (baseName == instName) { return false; }          // 非实例化名
        if (!this.IsStructType(instName)) {
            // 泛型 **class**（形态 ②）：比**内联布局**。定义下型参字段不是 blob struct ⇒ 无内联字段；
            // 代换后若有内联字段，则布局不同 ⇒ 需特化（否则 ctor 体仍发 field_set 引用槽写，
            // 存进去的是栈帧作用域的 arena 句柄 ⇒ 帧一弹即悬垂）。
            StructLayoutInfo ai = this.InlineLayoutOf(instName);
            StructLayoutInfo bi = this.InlineLayoutOf(baseName);
            if (ai.FieldCount != bi.FieldCount) { return true; }
            if (ai.Size != bi.Size) { return true; }
            int q = 0;
            while (q < ai.FieldCount) {
                if (ai.FieldOffsets[q] != bi.FieldOffsets[q]) { return true; }
                q = q + 1;
            }
            return false;
        }
        StructLayoutInfo a = this.LayoutOf(instName);
        StructLayoutInfo b = this.LayoutOf(baseName);
        if (a.Size != b.Size) { return true; }
        if (a.RefLeafCount != b.RefLeafCount) { return true; }
        int i = 0;
        while (i < a.RefLeafCount) {
            if (a.RefLeafOffsets[i] != b.RefLeafOffsets[i]) { return true; }
            if (a.RefLeafKinds[i] != b.RefLeafKinds[i]) { return true; }   // ArcString vs GcRef：Arc 计数语义不同
            i = i + 1;
        }
        // 字段偏移/种类也要比：size 与引用位图相同、但字段切分不同时（如 int+int vs 一个 8B 引用）
        // 链式访问仍会按错的种类发指令。
        if (a.FieldCount != b.FieldCount) { return true; }
        int j = 0;
        while (j < a.FieldCount) {
            if (a.FieldOffsets[j] != b.FieldOffsets[j]) { return true; }
            if (a.FieldKinds[j] != b.FieldKinds[j]) { return true; }
            j = j + 1;
        }
        return false;
    }

    // 实例化名 → 基名（`Pair<P2,int>` → `Pair`）；无 `<` 原样返回。
    public static string BaseNameOf(string typeName) {
        int lt = typeName.IndexOf('<');   // char 重载：needle 不必物化（热路径，布局 / 实例化名判定）
        if (lt < 0) { return typeName; }
        return typeName.Substring(0, lt);
    }

    // 实例化规范名：基名 + `<` + 实参逗号连接 + `>`。**编译器 / wire / 运行期三方必须用这一份拼法**
    // （与数组元素类型名同源：`ExprEmitter._qualifyElemName` 也是「在 `<` 处切开、只限定基名」）。
    // argCount==0 → 返回基名（非泛型不该进来，兜底）。
    public static string InstName(string baseName, string[] args, int argCount) {
        if (argCount <= 0) { return baseName; }
        string s = baseName + "<";
        int i = 0;
        while (i < argCount) {
            if (i > 0) { s = s + ","; }
            s = s + args[i];
            i = i + 1;
        }
        return s + ">";
    }

    // 实例化名 → 实参名数组（`Pair<P2,int>` → ["P2","int"]）。顶层逗号切分，**跟踪嵌套深度**
    // 以正确处理 `Pair<Pair<P2,int>,int>`（内层逗号不是分隔符）。无 `<` → 空数组。
    public static string[] InstArgsOf(string typeName) {
        int lt = typeName.IndexOf('<');
        if (lt < 0) { return new string[0]; }
        // 去掉外层 `<` 与末尾 `>`
        int inner = typeName.Length - lt - 2;
        if (inner <= 0) { return new string[0]; }
        string body = typeName.Substring(lt + 1, inner);
        string[] outp = new string[8]; int n = 0;
        int depth = 0; int start = 0; int i = 0;
        while (i < body.Length) {
            string c = body.Substring(i, 1);
            if (c == "<") { depth = depth + 1; }
            else if (c == ">") { depth = depth - 1; }
            else if (c == "," && depth == 0) {
                if (n == outp.Length) { string[] b = new string[outp.Length * 2]; int k = 0; while (k < n) { b[k] = outp[k]; k = k + 1; } outp = b; }
                outp[n] = body.Substring(start, i - start); n = n + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        if (n == outp.Length) { string[] b = new string[outp.Length * 2]; int k = 0; while (k < n) { b[k] = outp[k]; k = k + 1; } outp = b; }
        outp[n] = body.Substring(start, body.Length - start); n = n + 1;
        string[] res = new string[n]; int j = 0; while (j < n) { res[j] = outp[j]; j = j + 1; }
        return res;
    }

    // A-use codegen flip 谓词：某类型是否翻转到 **blob 值语义**（emit StructAlloc/Copy/FieldGet/SetPrim）。
    // = IsStruct 且**多叶子复合**（FieldCount>=2）。单标量叶子 struct（GCHandle=1×i64+FFI / 单字段 wrapper）
    // 与 phantom 基元（int/bool/char=Z42PrimType，根本不到这）保持现有模型（标量塌缩=Phase B）。
    // z42c/stdlib 零生产多字段 struct → flip 纯增量。
    public bool IsBlobStruct(string typeName) {
        if (!this.IsStructType(typeName)) { return false; }
        StructLayoutInfo li = this.LayoutOf(typeName);
        if (li.FieldCount < 1) { return false; }
        // add-struct-nested-fields：嵌套 struct 字段（Line{a:P,b:P}）现予接受——布局早已递归展平其叶子
        // （_compute），codegen 沿成员链累积 byte offset 发射 StructFieldGet/SetPrim（整字段走逐叶子复制）。
        // 防护：自引用/环 struct 的布局是空兜底（Size 0，见 LayoutOf 的 _inProgress 环检测 + E0438 诊断）——
        // 不准入，避免 0 字节 blob 的字段访问越界。
        if (li.Size == 0) { return false; }
        return true;
    }

    // unify-value-types Phase 1：值类型表示 Repr。返回 "Scalar" / "Blob" / ""（非值类型）。
    // Scalar = 六个基元 wrapper（PrimModel.IsScalarValue：整数族/f32/f64/bool/char，裸 Value 承载不进 arena）；
    // Blob = 多字段复合值 struct（IsBlobStruct，字节 arena）。用户单字段 struct 与 phantom 零字段 wrapper
    // 之外的退化 struct 暂归 ""（单标量叶子塌缩 = Phase 4）。codegen 据此分派：Scalar 走 PrimTag/裸算术/
    // __box_prim；Blob 走 StructAlloc/StructCopy/__box_struct。
    public string ReprOf(string typeName) {
        if (PrimModel.IsScalarValue(typeName)) { return "Scalar"; }
        if (this.IsBlobStruct(typeName)) { return "Blob"; }
        return "";
    }

    // ── symbolic-struct-field-access P2：序号访问器 ────────────────────────────
    //
    // P2 之后 codegen 烘焙的是**字段序号**而不是字节偏移。序号必须索引到**运行期会索引的同一张表**：
    //   · struct 根 ⇒ `LayoutOf(structName)` ——它就是写进 zbc `struct_field_table` 的那个数组
    //     （`ClassDescBuilder` 直接 `cd2.StructFieldOffsets = li.FieldOffsets`）；
    //   · class 根 ⇒ `ObjectLayoutOf(className)` ——写进 zbc 对象全字段布局块的那个数组，
    //     运行期是 `composed_object_layout().field_offsets`。
    // 两侧同源 ⇒ 序号按构造一致。
    //
    // ⚠️ 返回 -1 = 查不到。与 `FieldByteOffset` 不同的是：**序号不参与求和**，所以 -1
    // 不会被加成一个看起来合法的正数（那正是烘焙偏移年代的隐患）。调用方直接判。
    public int FieldIndexOf(string structName, string fieldName) {
        StructLayoutInfo li = this.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) { if (li.FieldNames[i] == fieldName) { return i; } i = i + 1; }
        return -1;
    }

    // 内联 struct 字段在**对象全字段布局**里的序号（class 根路径的第一级）。
    // 判据与 `InlineFieldByteOffset` 一致：先确认它确实是内联 struct 字段，再取对象布局里的序号。
    public int ObjectFieldIndexOf(string className, string fieldName) {
        StructLayoutInfo inl = this.InlineLayoutOf(className);
        bool found = false;
        int i = 0;
        while (i < inl.FieldCount) { if (inl.FieldNames[i] == fieldName) { found = true; break; } i = i + 1; }
        if (!found) { return -1; }
        StructLayoutInfo obj = this.ObjectLayoutOf(className);
        int j = 0;
        while (j < obj.FieldCount) { if (obj.FieldNames[j] == fieldName) { return j; } j = j + 1; }
        return -1;
    }

    // struct 直接字段的 byte offset（未找到 -1）。供 codegen 烘焙 StructFieldGet/SetPrim 立即数。
    public int FieldByteOffset(string structName, string fieldName) {
        StructLayoutInfo li = this.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) { if (li.FieldNames[i] == fieldName) { return li.FieldOffsets[i]; } i = i + 1; }
        return -1;
    }

    // struct 直接字段的声明类型名（未找到 ""）。供 codegen 算运行期 TypeTag（Tag.FromName）。
    public string FieldTypeName(string structName, string fieldName) {
        StructLayoutInfo li = this.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) { if (li.FieldNames[i] == fieldName) { return li.FieldTypeNames[i]; } i = i + 1; }
        return "";
    }

    // struct 直接字段是否本身也是 blob struct（嵌套值字段：读/写走区间复制而非 prim；A-use 首版暂不支持嵌套，
    // 调用方据此回退/报错，避免误当 prim 读单叶子）。
    public bool FieldIsStruct(string structName, string fieldName) {
        StructLayoutInfo li = this.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) { if (li.FieldNames[i] == fieldName) { return li.FieldKinds[i] == StructLeafKind.Struct; } i = i + 1; }
        return false;
    }

    // struct 总字节大小（供 StructAlloc 立即数）。
    public int StructSize(string structName) {
        return this.LayoutOf(structName).Size;
    }
}
