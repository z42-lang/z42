// add-generic-type-arg-inference 阶段 D：方法体是否**运行期消费**方法级型参。
//
// 为什么需要它：阶段 C 的推断**不回灌** `BoundCall.MethodTypeArgs`（design D4——回灌会把
// opcode 从 Op.Call 换成 Op.CallGeneric、重排 zbc 串池、并关掉 native 快路径门，而全仓 112 处
// 隐式泛型调用全是不消费型参的 `Array.Copy<T>`）。不回灌的代价是：**若 callee 体内真的消费型参**，
// 省略尖括号的调用会让运行期读到空的 `frame.method_type_args` ⇒ 静默错值（同
// generic-new-array-value-type-null-tail 那条坑的形状）。本判定把静默错值换成编译错误 E0455。
//
// 运行期真正读 `frame.method_type_args` 的四种形态（`exec_address.rs:91-106` / `exec_array.rs:80-90`）：
//   typeof(T) / new T() / default(T) / new T[n]
// 外加**第五种、最容易漏的**：`Foo<T>() { Bar<T>(); }` —— 把自己的型参转发给嵌套泛型调用，
// emit 期发 `$mta:<idx>` 标记，运行期按调用方 frame 解析 ⇒ **也是消费**。
//
// 🔴 完备性是本文件的全部价值：**漏一种形态 = 漏一个静默洞**。故：
//   ① 表达式 / 语句 / 模式 / 类型 四个层面**逐节点类**覆盖，不留 fallthrough 猜测；
//   ② 判定方向刻意**过近似**（宁可多判「消费」）——多判只会要求用户显式写 `<T>`（响亮、可改），
//      漏判会产生静默错值（安静、难查）。同 #530「守禁令的一侧必须比替换的一侧更宽」。
//   ③ 完备性由**编译器**保证：`V` 实现语法树全部四个 visitor 接口（`z42c.syntax` 的
//      `IExprVisitor` / `IStmtVisitor` / `IPatternVisitor` / `ITypeExprVisitor`，节点经
//      `Accept<R, D>` 双分派）——给任一族加新节点子类，接口加 Visit 方法、这里编不过直到处理它。
//      （2026-09-09 起此处曾由 `xtask check walkers` 文本对账兜底；visitor 化后该登记已删。）
//
// 覆盖基线：Ast.z42 36 个 Expr / Stmt.z42 17 个 Stmt / Pattern.z42 10 个 Pattern /
// TypeExpr.z42 5 个 TypeExpr 子类——接口即清单。
namespace Z42.Semantics;

using Z42.Syntax;

public static class MethodTypeParamUse {
    // md 的方法体是否消费其**方法级**型参。无型参 / 无方法体（abstract、extern、[Native]）→ false。
    public static bool Consumes(MethodDecl md) {
        if (md == null || md.TypeParams == null || md.TypeParams.Count == 0) { return false; }
        if (!md.HasBody || md.Body == null) { return false; }
        MethodTypeParamUse.V v = new MethodTypeParamUse.V(md.TypeParams.Names, md.TypeParams.Count);
        return v._s(md.Body);
    }

    // ── visitor 本体：型参名单作实例字段，D 用不上（Unit）──────────────────────
    private sealed class V : IExprVisitor<bool, Unit>, IStmtVisitor<bool, Unit>,
                              IPatternVisitor<bool, Unit>, ITypeExprVisitor<bool, Unit> {
        private string[] _ns;
        private int      _nc;
        public V(string[] ns, int nc) { this._ns = ns; this._nc = nc; }

        // 薄递归入口：null 孩子（Init 可空、`return;` 无值、数组超额尾部）统一在入口拦成 false。
        internal bool _e(Expr x)   { return x == null ? false : x.Accept<bool, Unit>(this, Unit.Value); }
        internal bool _s(Stmt x)   { return x == null ? false : x.Accept<bool, Unit>(this, Unit.Value); }
        internal bool _p(Pattern x){ return x == null ? false : x.Accept<bool, Unit>(this, Unit.Value); }
        internal bool _t(TypeExpr x){ return x == null ? false : x.Accept<bool, Unit>(this, Unit.Value); }
        private bool _es(Expr[] xs, int n) {
            if (xs == null) { return false; }
            int i = 0;
            while (i < n) { if (this._e(xs[i])) { return true; } i = i + 1; }
            return false;
        }
        // ⚠️ 按显式 Count 迭代，**不用 `.Length`** —— 这些数组按增长策略超额分配，尾部是 null。
        private bool _ps(Pattern[] ps, int n) {
            if (ps == null) { return false; }
            int i = 0;
            while (i < n) { if (this._p(ps[i])) { return true; } i = i + 1; }
            return false;
        }
        private bool _isName(string n) {
            int i = 0;
            while (i < this._nc) { if (this._ns[i] == n) { return true; } i = i + 1; }
            return false;
        }

        // ── 类型层（TypeExpr.z42 5 子类）：`typeof(List<T>)` 同样要 T ⇒ 递归下钻 ──
        public bool VisitNamedType(NamedType n, Unit d) {
            if (n.ArgCount == 0 && this._isName(n.Name)) { return true; }
            int i = 0;
            while (i < n.ArgCount) { if (this._t(n.Args[i])) { return true; } i = i + 1; }
            return false;
        }
        public bool VisitArrayType(ArrayType n, Unit d)    { return this._t(n.Elem); }
        public bool VisitNullableType(NullableType n, Unit d) { return this._t(n.Inner); }
        public bool VisitAssocBindingType(AssocBindingType n, Unit d) { return this._t(n.Bound); }
        public bool VisitFuncTypeExpr(FuncTypeExpr n, Unit d) {
            int i = 0;
            while (i < n.ParamCount) { if (this._t(n.Params[i])) { return true; } i = i + 1; }
            return this._t(n.Ret);
        }

        // ── 语句层（Stmt.z42 17 子类）──────────────────────────────────────────
        public bool VisitBlockStmt(BlockStmt n, Unit d) {
            int i = 0;
            while (i < n.Count) { if (this._s(n.Stmts[i])) { return true; } i = i + 1; }
            return false;
        }
        public bool VisitExprStmt(ExprStmt n, Unit d)    { return this._e(n.E); }
        public bool VisitThrowStmt(ThrowStmt n, Unit d)  { return this._e(n.E); }
        public bool VisitReturnStmt(ReturnStmt n, Unit d) {
            if (!n.HasValue) { return false; }
            return this._e(n.Value);
        }
        public bool VisitVarDeclStmt(VarDeclStmt n, Unit d) {
            // 注解位的 `T x;` **不算消费**（只是静态类型，不读 frame）；但 init 里可能有 new T() 等。
            return this._e(n.Init);
        }
        public bool VisitDeconstructDeclStmt(DeconstructDeclStmt n, Unit d) {
            if (this._p(n.Pat)) { return true; }
            return this._e(n.Init);
        }
        public bool VisitIfStmt(IfStmt n, Unit d) {
            if (this._e(n.Cond)) { return true; }
            if (this._s(n.Then)) { return true; }
            if (n.HasElse) { return this._s(n.Else); }
            return false;
        }
        public bool VisitWhileStmt(WhileStmt n, Unit d) {
            if (this._e(n.Cond)) { return true; }
            return this._s(n.Body);
        }
        public bool VisitDoWhileStmt(DoWhileStmt n, Unit d) {
            if (this._s(n.Body)) { return true; }
            return this._e(n.Cond);
        }
        public bool VisitForStmt(ForStmt n, Unit d) {
            if (n.HasInit && this._s(n.Init)) { return true; }
            if (n.HasCond && this._e(n.Cond)) { return true; }
            if (n.HasIncr && this._e(n.Incr)) { return true; }
            return this._s(n.Body);
        }
        public bool VisitForeachStmt(ForeachStmt n, Unit d) {
            if (this._e(n.Iter)) { return true; }
            return this._s(n.Body);
        }
        // `using`（add-using-statement 批 3）：资源表达式 + 声明类型 + 块体都可能提到型参。
        // 简化形态（`using var v = e;`）没有自己的块 ⇒ `Body` 是空块占位，走同一条也无害。
        public bool VisitUsingStmt(UsingStmt n, Unit d) {
            if (this._e(n.Init)) { return true; }
            if (n.HasDecl && this._t(n.Type)) { return true; }
            return this._s(n.Body);
        }
        public bool VisitSwitchStmt(SwitchStmt n, Unit d) {
            if (this._e(n.Subject)) { return true; }
            int i = 0;
            while (i < n.CaseCount) {
                SwitchCase c = n.Cases[i];
                if (c.HasPattern && this._p(c.Pattern)) { return true; }
                if (this._e(c.Guard)) { return true; }
                int j = 0;
                while (j < c.BodyCount) { if (this._s(c.Body[j])) { return true; } j = j + 1; }
                i = i + 1;
            }
            return false;
        }
        public bool VisitTryCatchStmt(TryCatchStmt n, Unit d) {
            if (this._s(n.TryBody)) { return true; }
            int i = 0;
            while (i < n.CatchCount) {
                if (this._s(n.Catches[i].Body)) { return true; }
                i = i + 1;
            }
            if (n.HasFinally) { return this._s(n.Finally); }
            return false;
        }
        public bool VisitLocalFunctionStmt(LocalFunctionStmt n, Unit d) {
            // 局部函数体引用外层型参 → 过近似判「消费」（见抬头 ②：宁可多判）。
            if (n.Decl != null && n.Decl.HasBody) { return this._s(n.Decl.Body); }
            return false;
        }
        public bool VisitBreakStmt(BreakStmt n, Unit d)    { return false; }
        public bool VisitContinueStmt(ContinueStmt n, Unit d) { return false; }

        // ── 表达式层（Ast.z42 36 子类）────────────────────────────────────────
        // ★ 五种**消费点**（其余节点只是递归容器）：
        public bool VisitTypeofExpr(TypeofExpr n, Unit d)  { return this._t(n.Type); }
        // methodof(X.M(T))：参数类型列表里可以出现方法级型参（add-method-reference）。
        // owner 名是限定名字符串、不是 TypeExpr，故只走参数列表。
        public bool VisitMethodOfExpr(MethodOfExpr n, Unit d) {
            int mi = 0;
            while (mi < n.ParamCount) {
                if (this._t(n.ParamTypes[mi])) { return true; }
                mi = mi + 1;
            }
            return false;
        }
        public bool VisitDefaultExpr(DefaultExpr n, Unit d) { return this._t(n.Target); }
        public bool VisitArrayNewExpr(ArrayNewExpr n, Unit d) {
            if (this._t(n.Elem)) { return true; }
            return this._e(n.Size);
        }
        public bool VisitArrayInitExpr(ArrayInitExpr n, Unit d) {
            if (this._t(n.Elem)) { return true; }
            return this._es(n.Elems, n.ElemCount);
        }
        public bool VisitObjNewExpr(ObjNewExpr n, Unit d) {
            if (this._t(n.Type)) { return true; }   // Type 可为 null（target-typed new）
            return this._es(n.Args, n.ArgCount);
        }
        public bool VisitObjInitExpr(ObjInitExpr n, Unit d) {
            if (this._t(n.Type)) { return true; }
            if (this._es(n.Args, n.ArgCount)) { return true; }
            return this._es(n.FieldValues, n.FieldCount);
        }
        // ★ 第五种消费：把自身型参**转发**给嵌套泛型调用（emit 期发 `$mta:<idx>`）。
        public bool VisitCallExpr(CallExpr n, Unit d) {
            int t = 0;
            while (t < n.TypeArgCount) { if (this._t(n.TypeArgs[t])) { return true; } t = t + 1; }
            if (this._e(n.Callee)) { return true; }
            return this._es(n.Args, n.ArgCount);
        }
        // ── 以下纯递归容器 ────────────────────────────────────────────────────
        public bool VisitUnaryExpr(UnaryExpr n, Unit d)  { return this._e(n.Operand); }
        public bool VisitRefArgExpr(RefArgExpr n, Unit d){ return this._e(n.Inner); }
        public bool VisitBinaryExpr(BinaryExpr n, Unit d) {
            if (this._e(n.Left)) { return true; }
            return this._e(n.Right);
        }
        public bool VisitAssignExpr(AssignExpr n, Unit d) {
            if (this._e(n.Target)) { return true; }
            return this._e(n.Value);
        }
        public bool VisitMemberExpr(MemberExpr n, Unit d) { return this._e(n.Target); }
        public bool VisitIndexExpr(IndexExpr n, Unit d) {
            if (this._e(n.Target)) { return true; }
            return this._es(n.Indices, n.IndexCount);
        }
        public bool VisitTernaryExpr(TernaryExpr n, Unit d) {
            if (this._e(n.Cond)) { return true; }
            if (this._e(n.Then)) { return true; }
            return this._e(n.Else);
        }
        // `x is T` 的类型位是**静态**判定（is-check 走 type_registry），不读 frame ⇒ 不算消费；
        // 但过近似方向下仍判进来（宁可多判，见抬头 ②）。
        public bool VisitIsExpr(IsExpr n, Unit d) {
            if (this._t(n.Type)) { return true; }
            return this._e(n.E);
        }
        public bool VisitAsExpr(AsExpr n, Unit d) {
            if (this._t(n.Type)) { return true; }
            return this._e(n.E);
        }
        public bool VisitCastExpr(CastExpr n, Unit d) {
            if (this._t(n.Type)) { return true; }
            return this._e(n.E);
        }
        public bool VisitIsPatternExpr(IsPatternExpr n, Unit d) {
            if (this._p(n.Pat)) { return true; }
            return this._e(n.E);
        }
        public bool VisitSwitchExpr(SwitchExpr n, Unit d) {
            if (this._e(n.Subject)) { return true; }
            int i = 0;
            while (i < n.ArmCount) {
                SwitchArm a = n.Arms[i];
                if (a.HasPattern && this._p(a.Pattern)) { return true; }
                if (this._e(a.Guard)) { return true; }
                if (this._e(a.Body)) { return true; }
                i = i + 1;
            }
            return false;
        }
        public bool VisitWithExpr(WithExpr n, Unit d) {
            if (this._e(n.Target)) { return true; }
            return this._es(n.FieldValues, n.FieldCount);
        }
        public bool VisitLambdaExpr(LambdaExpr n, Unit d) {
            int i = 0;
            while (i < n.ParamCount) {
                if (n.Params[i].HasType && this._t(n.Params[i].Type)) { return true; }
                i = i + 1;
            }
            if (n.HasBlock) { return this._s(n.BlockBody); }
            return this._e(n.ExprBody);
        }
        public bool VisitArrayLitExpr(ArrayLitExpr n, Unit d)    { return this._es(n.Elems, n.ElemCount); }
        public bool VisitListLitExpr(ListLitExpr n, Unit d)      { return this._es(n.Elems, n.ElemCount); }
        public bool VisitTupleExpr(TupleExpr n, Unit d)          { return this._es(n.Elems, n.Count); }
        public bool VisitArrayRepeatExpr(ArrayRepeatExpr n, Unit d) {
            if (this._e(n.Value)) { return true; }
            return this._e(n.Count);
        }
        public bool VisitDictLitExpr(DictLitExpr n, Unit d) {
            if (this._es(n.Keys, n.Count)) { return true; }
            return this._es(n.Values, n.Count);
        }
        public bool VisitInterpolatedStringExpr(InterpolatedStringExpr n, Unit d) {
            int i = 0;
            while (i < n.PartCount) {
                if (n.Parts[i] is InterpHole) {
                    if (this._e((n.Parts[i] as InterpHole).Inner)) { return true; }
                }
                i = i + 1;
            }
            return false;
        }
        // 叶子（无子节点、无类型位）：IntLit / FloatLit / StringLit / CharLit / BoolLit / NullLit /
        // Ident / EmptyBraceLit——显式列全（接口完备性；新叶子节点会迫使这里显式表态）。
        public bool VisitIntLitExpr(IntLitExpr n, Unit d)    { return false; }
        public bool VisitFloatLitExpr(FloatLitExpr n, Unit d){ return false; }
        public bool VisitStringLitExpr(StringLitExpr n, Unit d) { return false; }
        public bool VisitCharLitExpr(CharLitExpr n, Unit d)  { return false; }
        public bool VisitBoolLitExpr(BoolLitExpr n, Unit d)  { return false; }
        public bool VisitNullLitExpr(NullLitExpr n, Unit d)  { return false; }
        public bool VisitIdentExpr(IdentExpr n, Unit d)      { return false; }
        public bool VisitEmptyBraceLitExpr(EmptyBraceLitExpr n, Unit d) { return false; }

        // ── 模式层（Pattern.z42 10 子类）──────────────────────────────────────
        public bool VisitConstantPattern(ConstantPattern n, Unit d) { return this._e(n.Value); }
        public bool VisitNamePattern(NamePattern n, Unit d)     { return this._t(n.Type); }
        public bool VisitPositionalPattern(PositionalPattern n, Unit d) {
            if (this._t(n.Type)) { return true; }
            return this._ps(n.Elems, n.ElemCount);
        }
        public bool VisitPropertyPattern(PropertyPattern n, Unit d) {
            if (n.HasType && this._t(n.Type)) { return true; }
            return this._ps(n.FieldPats, n.FieldCount);
        }
        public bool VisitTuplePattern(TuplePattern n, Unit d) { return this._ps(n.Elems, n.Count); }
        public bool VisitOrPattern(OrPattern n, Unit d)       { return this._ps(n.Alts, n.Count); }
        public bool VisitAtPattern(AtPattern n, Unit d)       { return this._p(n.Sub); }
        public bool VisitRangePattern(RangePattern n, Unit d) {
            if (this._e(n.Lo)) { return true; }
            return this._e(n.Hi);
        }
        public bool VisitRelationalPattern(RelationalPattern n, Unit d) { return this._e(n.Value); }
        public bool VisitWildcardPattern(WildcardPattern n, Unit d)     { return false; }
    }
}
