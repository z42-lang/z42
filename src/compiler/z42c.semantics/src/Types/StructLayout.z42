// add-struct-value-semantics P1 阶段 1：struct 字节精确布局计算。
//
// 为每个 struct 类型计算「字节扁平布局」：每个直接字段的 (byte_offset, size, kind)、类型总 size/align，
// 以及**带种类的引用叶子表**（供 GC 根扫描 + StructCopy/析构按种类分流：Arc 计数 / GcRef 屏障 / 纯基元 memcpy）。
//
// 纯计算模块（不耦合 AST/符号表）：输入是 name→StructFieldsDef（struct 类型的字段名+声明类型名，声明序），
// 由 IrGen 从 ClassDecls 抽取、单测直接构造。ABI 约定见 变更 add-struct-value-semantics/design.md
// 子决策 #2：基元字节精确（char=4B Unicode 标量）、引用叶子=16B 托管句柄（object/array/string/interface/func）。
namespace Z42.Semantics;
using Z42.IR;   // StrMap

// 叶子/字段的存储种类（z42 无 enum → static class + int 常量）。
public static class StructLeafKind {
    public static int Prim      = 0;   // 纯字节基元（可 memcpy，无 clone/drop/屏障）
    public static int ArcString = 1;   // string（Arc<str> 16B）：copy=Arc::clone 计数+1、drop=计数-1
    public static int GcRef     = 2;   // class/interface object（Value::Object，8B GcRef）：可内联进 bytes
    public static int Struct    = 3;   // 嵌套 struct（递归展平；本身不是叶子，其叶子并入父布局）
    // unify-object-byte-layout PR-3 chunk 2a：把粗粒度 GcRef（原含 object/array/interface/func）细分，
    // 供 runtime 安全内联（不同 Value 变体重建不同 / 部分根本不是 GcRef）。见 design D17。
    // **判据保守**：只把「确定 object/array」标出来内联；delegate/func/unknown 一律 GcRefClosure（侧表安全默认）。
    public static int GcRefArray   = 4;   // 数组 T[]（Value::Array，8B GcRef<ArrayObj>）：可内联，重建为 Array
    public static int GcRefClosure = 5;   // delegate/func/未解析（Value::Closure/FuncRef，**非 8B GcRef**）：留侧表，永不内联
    // 是否引用叶子（占 8B 引用槽、参与 GC 位图）——布局尺寸/对齐用（四类引用等宽同对齐）。
    public static bool IsRef(int kind) {
        return kind == StructLeafKind.ArcString || kind == StructLeafKind.GcRef
            || kind == StructLeafKind.GcRefArray || kind == StructLeafKind.GcRefClosure;
    }
}

// 一个 struct 类型的原始字段定义（名 + 声明类型名，声明序）。IrGen 从 ClassDecl 抽取；单测直接构造。
public sealed class StructFieldsDef {
    public string[] FieldNames;
    public string[] FieldTypeNames;
    public int      FieldCount;
    // generic-struct-erased-slot-value-copy：**定义**的型参名（`Pair<A,B>` → ["A","B"]）。
    // 算**实例化**布局（`Pair<P2,int>`）时按位与实参配对成代换表，`_kindOf` 据此把字段声明
    // 类型名 `A` 换成 `P2` 再判种类 —— 这是「擦除槽变真内联字段」的全部机关。
    // 非泛型 struct 恒空 ⇒ 代换表恒空 ⇒ 行为逐字不变。
    public string[] TypeParamNames;
    public int      TpCount;
    public StructFieldsDef() {
        this.FieldNames = new string[0];
        this.FieldTypeNames = new string[0];
        this.FieldCount = 0;
        this.TypeParamNames = new string[0];
        this.TpCount = 0;
    }
    public void Add(string name, string typeName) {
        if (this.FieldCount == this.FieldNames.Length) {
            int cap = this.FieldNames.Length * 2;
            if (cap == 0) { cap = 4; }
            string[] nn = new string[cap]; string[] nt = new string[cap];
            int i = 0;
            while (i < this.FieldCount) { nn[i] = this.FieldNames[i]; nt[i] = this.FieldTypeNames[i]; i = i + 1; }
            this.FieldNames = nn; this.FieldTypeNames = nt;
        }
        this.FieldNames[this.FieldCount] = name;
        this.FieldTypeNames[this.FieldCount] = typeName;
        this.FieldCount = this.FieldCount + 1;
    }
}

// 计算好的一个 struct 类型布局。
public sealed class StructLayoutInfo {
    public string TypeName;
    public int    Size;    // 总字节数（对齐后）
    public int    Align;   // = 最大成员对齐
    // 直接字段（codegen 算 lvalue 地址 `obj.f` / 递归 `line.a.x`）：
    public string[] FieldNames; public int[] FieldOffsets; public int[] FieldSizes; public int[] FieldKinds; public string[] FieldTypeNames; public int FieldCount;
    // 扁平引用叶子（GC 位图 + StructCopy/析构分流）：byte offset + 种类（ArcString / GcRef）。
    public int[] RefLeafOffsets; public int[] RefLeafKinds; public int RefLeafCount;
    public StructLayoutInfo(string typeName) {
        this.TypeName = typeName; this.Size = 0; this.Align = 1;
        this.FieldNames = new string[0]; this.FieldOffsets = new int[0]; this.FieldSizes = new int[0];
        this.FieldKinds = new int[0]; this.FieldTypeNames = new string[0]; this.FieldCount = 0;
        this.RefLeafOffsets = new int[0]; this.RefLeafKinds = new int[0]; this.RefLeafCount = 0;
    }
    public void AddField(string name, int off, int size, int kind, string typeName) {
        if (this.FieldCount == this.FieldNames.Length) {
            int cap = this.FieldNames.Length * 2; if (cap == 0) { cap = 4; }
            string[] nn = new string[cap]; int[] no = new int[cap]; int[] ns = new int[cap]; int[] nk = new int[cap]; string[] ntn = new string[cap];
            int i = 0;
            while (i < this.FieldCount) { nn[i] = this.FieldNames[i]; no[i] = this.FieldOffsets[i]; ns[i] = this.FieldSizes[i]; nk[i] = this.FieldKinds[i]; ntn[i] = this.FieldTypeNames[i]; i = i + 1; }
            this.FieldNames = nn; this.FieldOffsets = no; this.FieldSizes = ns; this.FieldKinds = nk; this.FieldTypeNames = ntn;
        }
        this.FieldNames[this.FieldCount] = name; this.FieldOffsets[this.FieldCount] = off; this.FieldSizes[this.FieldCount] = size; this.FieldKinds[this.FieldCount] = kind; this.FieldTypeNames[this.FieldCount] = typeName;
        this.FieldCount = this.FieldCount + 1;
    }
    public void AddRefLeaf(int off, int kind) {
        if (this.RefLeafCount == this.RefLeafOffsets.Length) {
            int cap = this.RefLeafOffsets.Length * 2; if (cap == 0) { cap = 4; }
            int[] no = new int[cap]; int[] nk = new int[cap];
            int i = 0;
            while (i < this.RefLeafCount) { no[i] = this.RefLeafOffsets[i]; nk[i] = this.RefLeafKinds[i]; i = i + 1; }
            this.RefLeafOffsets = no; this.RefLeafKinds = nk;
        }
        this.RefLeafOffsets[this.RefLeafCount] = off; this.RefLeafKinds[this.RefLeafCount] = kind;
        this.RefLeafCount = this.RefLeafCount + 1;
    }
}

// 布局计算器。按需计算 + 缓存；用「在途集」检测递归自含值字段（无限大小 → C# CS0523 同款）。
//
// 并发：包编译里一份 `BuildFromSymbols` 预计算的**基表**被所有并行 CU 共享，而实例化名
// （`Pair$1<P>`）的布局只能在代码生成时按需算——那一步会写缓存与在途集。直接共享基表时，两个
// worker 同算一个实例化，后到者会在 `_inProgress` 里看见先到者的键、误判为递归自含而拿到空布局
// （`FieldIndexOf` = -1 ⇒ `struct field path: layout lookup failed`），且 `StrMap` 并发读写本身不安全。
// 故每个 CU 经 `ForkView()` 拿一个**视图**：定义表与基表的预计算缓存只读共享，按需算出的布局只进视图
// 自己的缓存。基表预计算完成后不再被写。
public sealed partial class StructLayout {
    // 视图的只读基表（null = 自己就是基表）。缓存未命中时回落到它预计算好的那份。
    private StructLayout _base;
    private StrMap _defs;         // name → StructFieldsDef（仅 struct/record 类型）
    private StrMap _cache;        // name → StructLayoutInfo
    private StrMap _inProgress;   // name → "1"（环检测在途集）
    // add-struct-heap-inline (P3b)：非-struct class 的字段定义 + 其**合成内联布局**缓存。
    // 内联布局 = class 的 blob-struct 字段内联进堆对象字节区（ScriptObject::struct_bytes）的对象相对布局
    // （每内联字段 byte offset + 合成引用位图）。writer（ClassDescBuilder，本阶段）与 codegen
    // （ExprEmitter，stage 4）**同源**取此布局 → 对象相对 offset 一致。
    private StrMap _classDefs;    // className → StructFieldsDef（非-struct class）
    // unify-object-byte-layout PR-3 chunk 2b：多态**擦除目标**类型名集（interface + object）。这些字段
    // 可持装箱值（BoxedStruct/Array/Str/Closure），8B 内联丢变体判别 → 必须留侧表（GcRefClosure），
    // 仅**具体类**（恒 Value::Object）可安全内联。见 `_refineDirectRefKind`（键 = 接口全名）。
    private StrMap _erasureNames;
    private StrMap _inlineCache;  // className → StructLayoutInfo（合成内联布局）
    // unify-object-byte-layout PR-1：非-struct 引用类的**对象全字段布局**（8B 引用，休眠元数据）+
    // 内联 struct 字段扁平所需的 8B 引用 struct 展平布局缓存。
    private StrMap _objectCache;       // className → StructLayoutInfo（对象全字段布局，8B 引用）
    private StrMap _objStructCache;    // structName → StructLayoutInfo（8B 引用 struct 展平布局）
    private StrMap _objStructInProgress; // 8B struct 布局环检测在途集
    // 布局键（`LayoutKey`）→ 算出这份布局的那个类（`OwnerOf`）。手搭的布局（测试）为 null。
    private StrMap _owners;
    public string  ErrorType;    // 非 "" → 检测到递归自含（诊断码 E0416 由持 DiagnosticBag 的调用方发）
    public string  ErrorCycle;   // 环路径描述（诊断信息用）

    public StructLayout(StrMap defs) {
        this._defs = defs;
        this._cache = new StrMap();
        this._inProgress = new StrMap();
        this._classDefs = new StrMap();
        this._erasureNames = new StrMap();
        this._inlineCache = new StrMap();
        this._objectCache = new StrMap();
        this._objStructCache = new StrMap();
        this._objStructInProgress = new StrMap();
        this.ErrorType = "";
        this.ErrorCycle = "";
        this._owners = null;
        this._base = null;
    }

    // 并行 CU 用的视图：共享定义表与本表的预计算缓存（只读），按需算出的布局只进视图自己的缓存。
    public StructLayout ForkView() {
        StructLayout v = new StructLayout(this._defs);
        v._classDefs = this._classDefs;
        v._erasureNames = this._erasureNames;
        v._owners = this._owners;
        v._base = this;
        return v;
    }

    // 布局名（`LayoutKey`：全名 / 实例化名 `Demo.Pair<Demo.P2,int>`）→ 算出该布局的类；不认识返回 null。
    public Z42ClassType OwnerOf(string layoutName) {
        if (this._owners == null || layoutName == null) { return null; }
        return this._owners.Get(LayoutKey.Norm(StructLayout.BaseNameOf(layoutName))) as Z42ClassType;
    }

    // 从符号表构建：抽取所有 struct（Z42ClassType.IsStruct）与 class 的字段定义 → 预计算全部布局。
    // 键 = `LayoutKey.OfClass`（全名），字段类型 = 字段符号的已解析类型（`LayoutKey.Of`）——同包跨 ns 的同短名
    // struct 各有各的布局。ErrorType 反映任何递归自含。
    public static StructLayout BuildFromSymbols(SymbolTable table) {
        StrMap defs = new StrMap();
        StrMap classDefs = new StrMap();   // add-struct-heap-inline (P3b)：非-struct class 字段定义
        // 同一全名本地胜导入（本包重编一个依赖里也有的类时，以源码为准）；其余按 FQN 序。
        Z42ClassType[] all = table.SortedClasses();
        StrMap owner = new StrMap();   // 布局键 → Z42ClassType
        StrMap shortIdx = new StrMap();   // 短名键 → 布局键（唯一时）/ "" （歧义）：字段类型解析不到时按源拼写兜底
        int oi = 0;
        while (oi < all.Length) {
            Z42ClassType oc = all[oi];
            if (oc != null) {
                string ok = LayoutKey.OfClass(oc);
                Z42ClassType prev = owner.Get(ok) as Z42ClassType;
                if (prev == null || (prev.IsImported && !oc.IsImported)) { owner.Put(ok, oc); }
                string sk = SymbolTable.ClassKeyOf(oc);
                object had = shortIdx.Get(sk);
                if (had == null) { shortIdx.Put(sk, new StrBox(ok)); }
                else if ((had as StrBox).Value != ok) { shortIdx.Put(sk, new StrBox("")); }
            }
            oi = oi + 1;
        }
        string[] keys = owner.Keys();
        int i = 0;
        while (i < keys.Length) {
            Z42ClassType ct = owner.Get(keys[i]) as Z42ClassType;
            if (ct != null) {
                StructFieldsDef def = new StructFieldsDef();
                int j = 0;
                while (j < ct.OwnFieldCount) {
                    def.Add(ct.OwnFieldNames[j], StructLayout._ownFieldType(ct, j, shortIdx));
                    j = j + 1;
                }
                // generic-struct-erased-slot-value-copy：记下定义的型参名，供实例化布局的代换表。
                def.TypeParamNames = ct.GenericParamNames; def.TpCount = ct.GenericParamCount;
                // unify-value-types Phase 1：**Scalar 基元 wrapper（Int32/Boolean/Char…）虽 IsStruct=true，
                // 但绝不作为 blob struct 布局类型**——它们是裸 Value 标量（Repr=Scalar，不进字节 arena）。
                // 否则（键为关键字 `int`）`int` 字段的 _kindOf 会误判为嵌套 struct ⇒ 布局尺寸/偏移全错。
                if (ct.IsStruct && !PrimModel.IsScalarValue(keys[i])) { defs.Put(keys[i], def); }
                else if (!ct.IsStruct) { classDefs.Put(keys[i], def); }
            }
            i = i + 1;
        }
        StructLayout sl = new StructLayout(defs);
        sl._owners = owner;
        // unify-object-byte-layout PR-3 chunk 2a：先设 _classDefs（object 类型集），供 `_kindOf` 在
        // **struct 布局** LayoutOf 期就能把 object 字段判成 GcRef（否则 _classDefs 尚 null → 落 GcRefClosure）。
        sl._classDefs = classDefs;
        // unify-object-byte-layout PR-3 chunk 2b：擦除目标名集 = 所有 interface（+ object，由
        // `_isObjectSpelling` 直接识别）。`_computeObjectLayout`(下) 的 `_refineDirectRefKind` 据此把
        // object/interface 字段归 GcRefClosure（侧表），只让具体类字段内联。
        StrMap erasure = new StrMap();
        string[] ikeys = table.InterfacesByFqn.Keys();
        int ii = 0;
        while (ii < ikeys.Length) {
            Z42InterfaceType it = table.InterfacesByFqn.Get(ikeys[ii]) as Z42InterfaceType;
            if (it != null) { erasure.Put(it.Fqn(), "1"); }
            ii = ii + 1;
        }
        sl._erasureNames = erasure;
        string[] dkeys = defs.Keys();
        int k = 0;
        while (k < dkeys.Length) { sl.LayoutOf(dkeys[k]); k = k + 1; }   // 预计算 struct 布局 + 填缓存
        // add-struct-heap-inline (P3b)：struct 布局就绪后，为每个非-struct class 预计算合成内联布局
        // （内联字段的对象相对 byte offset + 合成引用位图）。无内联字段的 class 得空布局（FieldCount 0）。
        string[] ckeys = classDefs.Keys();
        int m = 0;
        while (m < ckeys.Length) { sl._computeInlineLayout(ckeys[m]); m = m + 1; }
        // unify-object-byte-layout PR-1：为每个非-struct class 预计算**对象全字段布局**（8B 引用）。
        // 休眠元数据（本 PR 只随 zbc 携带、runtime 不消费）；无字段的 class 得空布局（FieldCount 0）。
        int n = 0;
        while (n < ckeys.Length) { sl._computeObjectLayout(ckeys[n]); n = n + 1; }
        return sl;
    }

    // 第 j 个自有字段的布局类型名：取字段符号的已解析类型（auto-property 的后备字段 `__prop_X` 登记在 `X` 下）。
    // 解析不到（未知 / 错误类型）→ 退回源拼写，短名唯一时换成它的布局键。
    private static string _ownFieldType(Z42ClassType ct, int j, StrMap shortIdx) {
        string fname = ct.OwnFieldNames[j];
        FieldSymbol fs = ct.Fields.Get(fname) as FieldSymbol;
        if (fs == null && fname.StartsWith("__prop_")) { fs = ct.Fields.Get(fname.Substring(7)) as FieldSymbol; }
        if (fs != null) {
            string tn = LayoutKey.Of(fs.FieldType);
            if (tn != "") { return tn; }
        }
        string sp = ct.OwnFieldSpellings[j];
        object hit = shortIdx.Get(StructLayout.BaseNameOf(sp));
        if (hit != null && sp.IndexOf('<') < 0 && (hit as StrBox).Value != "") { return (hit as StrBox).Value; }
        return sp;
    }

    // ── add-struct-heap-inline (P3b)：class 合成内联布局 ─────────────────────────────
    //
    // 一个非-struct class 把它的 **blob-struct 字段** 内联进堆对象字节区（`ScriptObject::struct_bytes`）。
    // 合成内联布局 = 逐字段（仅 IsBlobStruct 的）按对齐排布得每内联字段的**对象相对 byte offset** +
    // 把其引用叶子按 `字段 offset + 叶子 offset` 平移进合成引用位图。writer（ClassDescBuilder，写 zbc 1.32
    // 内联块）与 codegen（ExprEmitter stage 4，烘焙 StructFieldGet/SetPrim 立即数）同调此表 → offset 一致。

    // 计算某非-struct class 的合成内联布局并缓存（BuildFromSymbols 预计算调用）。
    private void _computeInlineLayout(string className) { this._computeInlineLayoutS(className, className); }

    // generic-struct-erased-slot-value-copy：`key` = 缓存键（可为实例化名），`defName` = 取定义用的基名。
    private void _computeInlineLayoutS(string key, string defName) {
        object d = this._classDefs.Get(LayoutKey.Norm(StructLayout.BaseNameOf(defName)));
        if (!(d is StructFieldsDef)) { return; }
        StructFieldsDef def = d as StructFieldsDef;
        StrMap subst = StructLayout._substOf(def, key);
        string className = key;
        StructLayoutInfo info = new StructLayoutInfo(className);
        int offset = 0;
        int maxAlign = 1;
        int i = 0;
        while (i < def.FieldCount) {
            string ftype = def.FieldTypeNames[i];
            if (subst.ContainsKey(ftype)) { ftype = (subst.Get(ftype) as StrBox).Value; }
            if (this.IsBlobStruct(ftype)) {
                StructLayoutInfo sub = this.LayoutOf(ftype);
                int align = sub.Align;
                if (align == 0) { align = 1; }   // 空/环兜底
                offset = StructLayout._alignUp(offset, align);
                info.AddField(def.FieldNames[i], offset, sub.Size, StructLeafKind.Struct, ftype);
                int k = 0;
                while (k < sub.RefLeafCount) {
                    info.AddRefLeaf(offset + sub.RefLeafOffsets[k], sub.RefLeafKinds[k]);
                    k = k + 1;
                }
                offset = offset + sub.Size;
                if (align > maxAlign) { maxAlign = align; }
            }
            i = i + 1;
        }
        info.Align = maxAlign;
        info.Size = StructLayout._alignUp(offset, maxAlign);
        this._inlineCache.Put(className, info);
    }

    // 某 class 的合成内联布局（无内联字段 → 空布局 FieldCount 0 / Size 0）。
    public StructLayoutInfo InlineLayoutOf(string className) {
        string k = LayoutKey.Norm(className);
        object c = this._inlineCache.Get(k);
        if (c == null && this._base != null) { c = this._base._inlineCache.Get(k); }
        if (c is StructLayoutInfo) { return c as StructLayoutInfo; }
        // generic-struct-erased-slot-value-copy：实例化名按需算（定义那份在 BuildFromSymbols 预计算）。
        // 泛型 class 的 `T` 字段在**定义**下 `IsBlobStruct("T")` 为假 ⇒ 无内联字段；带代换 `T→P2` 才内联。
        if (StructLayout.BaseNameOf(k) != k) {
            this._computeInlineLayoutS(k, k);
            object c2 = this._inlineCache.Get(k);
            if (c2 is StructLayoutInfo) { return c2 as StructLayoutInfo; }
        }
        return new StructLayoutInfo(k);
    }

    // 某 class 是否有内联 struct 字段（→ 设 CLASS_FLAG_HAS_INLINE_STRUCT + emit 内联块）。
    public bool HasInlineFields(string className) {
        return this.InlineLayoutOf(className).FieldCount > 0;
    }

    // 某内联 struct 字段在对象字节区的对象相对 byte offset（**非**内联 struct 字段返 -1）。
    // 供 codegen（stage 4）烘焙，同时作 `_isOwnerInlineField`/`_isInlineStructFieldRoot` 的判据
    // （`>= 0` ⟺「是内联 struct 字段」）。
    //
    // unify-object-byte-layout PR-2：**判据仍走 InlineLayoutOf**（只含 struct 字段，非 struct 字段
    // 不在其中 → 返 -1 → 判据 false → 走普通 FieldGet，绝不能误判基元/引用字段为内联 struct）；但
    // 确认是内联 struct 字段后，返回的 **offset 改用 ObjectLayoutOf**（struct 字段夹在全部直接字段间的
    // composed 对象布局 offset）——runtime 现把所有字段字节内联进 ScriptObject.bytes，struct 字段字节
    // 窗口起点 = 其对象布局 offset。（无 base 类时 = composed offset；含 base 字段的派生类 base-shift
    // 组合见后续。）
    // generic-struct-erased-slot-value-copy（形态 ②）：内联字段的**struct 类型名**，取自内联布局。
    // 泛型 class 的 `T` 字段静态类型是型参 `A`，从静态类型取不出 struct 名（`_blobStructName` 会
    // 对它 `.Name()` 直接崩）。内联布局已按实例化算过，知道那是 `P2` —— 它才是权威来源。
    public string InlineFieldTypeName(string className, string fieldName) {
        StructLayoutInfo inl = this.InlineLayoutOf(className);
        int i = 0;
        while (i < inl.FieldCount) { if (inl.FieldNames[i] == fieldName) { return inl.FieldTypeNames[i]; } i = i + 1; }
        return "";
    }

    public int InlineFieldByteOffset(string className, string fieldName) {
        // 判据：仅内联 struct 字段（InlineLayoutOf）才有内联 offset。
        StructLayoutInfo inl = this.InlineLayoutOf(className);
        bool found = false;
        int i = 0;
        while (i < inl.FieldCount) { if (inl.FieldNames[i] == fieldName) { found = true; break; } i = i + 1; }
        if (!found) { return -1; }
        // offset：取对象全字段布局中该 struct 字段的 composed offset。
        StructLayoutInfo obj = this.ObjectLayoutOf(className);
        int j = 0;
        while (j < obj.FieldCount) { if (obj.FieldNames[j] == fieldName) { return obj.FieldOffsets[j]; } j = j + 1; }
        return -1;
    }

    // ── unify-object-byte-layout PR-1：对象全字段布局（8B 引用，休眠元数据）───────────
    //
    // 一个非-struct 引用类的**全部直接字段**（基元 + 引用 + 内联 struct）的对象相对字节布局：
    // per-field (offset, size, kind) 供 FieldGet/反射；扁平引用位图（含内联 struct 内部叶子）供 GC。
    // 引用叶子按**8B 裸指针**算（终点 C# 布局；runtime 消费在 PR-2/3，本 PR 仅携带不消费）。
    // offset 从 0 起（本类 OWN 区）；继承 base-shift 由消费方（PR-2）组合（镜像 fields=base++own）。

    // 引用宽度 8B 版 _sizeOf（对象布局终点；基元宽度不变）。
    private int _objSizeOf(string typeName, int kind) {
        if (StructLeafKind.IsRef(kind)) { return 8; }
        return this._sizeOf(typeName, kind);
    }

    // 8B 引用版 struct 展平布局（内联 struct 字段扁平进对象布局时用）。twin of LayoutOf/_compute，
    // 但引用叶子 8B。环检测在途集独立于 16B 版（_objStructInProgress），命中返回空布局打断递归。
    private StructLayoutInfo _objLayoutOfStruct(string structName) {
        string key = LayoutKey.Norm(structName);
        object cached = this._objStructCache.Get(key);
        if (cached == null && this._base != null) { cached = this._base._objStructCache.Get(key); }
        if (cached is StructLayoutInfo) { return cached as StructLayoutInfo; }
        if (this._objStructInProgress.ContainsKey(key)) { return new StructLayoutInfo(key); }
        object d = this._defs.Get(key);
        if (!(d is StructFieldsDef)) { return new StructLayoutInfo(key); }
        StructFieldsDef def = d as StructFieldsDef;
        this._objStructInProgress.Put(key, "1");
        StructLayoutInfo info = this._computeObjFields(key, def, new StrMap());
        this._objStructCache.Put(key, info);
        return info;
    }

    // 布局主算法（8B 引用版）：逐字段按对齐排布，累积 size/align，展平引用叶子（含嵌套/内联 struct）。
    // 与 _compute 同形，差异仅：引用叶子用 _objSizeOf（8B）、嵌套 struct 递归走 _objLayoutOfStruct（8B）。
    private StructLayoutInfo _computeObjFields(string typeName, StructFieldsDef def, StrMap subst) {
        StructLayoutInfo info = new StructLayoutInfo(typeName);
        int offset = 0;
        int maxAlign = 1;
        int i = 0;
        while (i < def.FieldCount) {
            string fname = def.FieldNames[i];
            string ftype = def.FieldTypeNames[i];
            // generic-struct-erased-slot-value-copy：字段声明类型先过代换表（`T` → `P2`），同 _compute。
            // fix-nested-generic-field-layout：同样递归进实例化实参（两处必须同口径，否则
            // 类里的内联 struct 字段与裸 struct 的同名布局会分叉）。
            ftype = StructLayout._substFieldTypeName(ftype, subst);
            int kind = this._kindOf(ftype);
            int size = 0;
            int align = 0;
            if (kind == StructLeafKind.Struct) {
                // 内联 struct 字段用 struct 布局（LayoutOf/_compute），使对象里的 struct 字段字节布局与
                // 独立 struct（arena/装箱/struct[]）**逐字节一致**——runtime 反射读对象内联 struct 字段、
                // 装箱成 BoxedStruct 直接拷字节即可，无需转换；嵌套 struct 的引用叶子 offset 亦一致。
                // unify-object-byte-layout PR-3 chunk 2c：LayoutOf/_compute 的引用叶子现已 8B（_sizeOf 塌缩），
                // 故对象内联 struct 与独立 struct 同为 8B——D13 的 8B(对象)/16B(struct) 分裂消除，仍 byte-identical。
                StructLayoutInfo nested = this.LayoutOf(ftype);
                size = nested.Size;
                align = nested.Align;
                if (align == 0) { align = 1; }   // 空/环兜底
                offset = StructLayout._alignUp(offset, align);
                info.AddField(fname, offset, size, kind, ftype);
                int k = 0;
                while (k < nested.RefLeafCount) {
                    info.AddRefLeaf(offset + nested.RefLeafOffsets[k], nested.RefLeafKinds[k]);
                    k = k + 1;
                }
            } else {
                size = this._objSizeOf(ftype, kind);
                align = this._alignOf(kind, size);
                offset = StructLayout._alignUp(offset, align);
                // chunk 2a：对象块直接字段的 FieldKinds 细化（GcRef→object/array/closure），供 2b 安全内联。
                // 仅 FieldKinds 细化；size/align + 引用位图仍用粗粒度 kind（8B，byte-identical）→ 格式变更仅限
                // array/delegate 直接字段的 field_kinds 字节，offset/位图/struct 块全不动。
                int fieldKind = kind;
                if (kind == StructLeafKind.GcRef) { fieldKind = this._refineDirectRefKind(ftype); }
                info.AddField(fname, offset, size, fieldKind, ftype);
                if (StructLeafKind.IsRef(kind)) {
                    info.AddRefLeaf(offset, kind);   // 引用叶子入位图（8B，粗粒度 kind，与 struct 块一致）
                }
            }
            offset = offset + size;
            if (align > maxAlign) { maxAlign = align; }
            i = i + 1;
        }
        info.Align = maxAlign;
        info.Size = StructLayout._alignUp(offset, maxAlign);
        return info;
    }

    // 计算并缓存某非-struct class 的对象全字段布局（BuildFromSymbols 预计算调用）。
    private void _computeObjectLayout(string className) {
        object d = this._classDefs.Get(className);
        if (!(d is StructFieldsDef)) { return; }
        StructFieldsDef def = d as StructFieldsDef;
        StructLayoutInfo info = this._computeObjFields(className, def, new StrMap());
        this._objectCache.Put(className, info);
    }

    // 某非-struct class 的对象全字段布局（无缓存 → 空布局 FieldCount 0 / Size 0）。
    public StructLayoutInfo ObjectLayoutOf(string className) {
        string k = LayoutKey.Norm(className);
        object c = this._objectCache.Get(k);
        if (c == null && this._base != null) { c = this._base._objectCache.Get(k); }
        if (c is StructLayoutInfo) { return c as StructLayoutInfo; }
        // 同 InlineLayoutOf：实例化名按需算（`InlineFieldByteOffset` 要用它取 composed offset）。
        if (StructLayout.BaseNameOf(k) != k) {
            object d = this._classDefs.Get(LayoutKey.Norm(StructLayout.BaseNameOf(k)));
            if (d is StructFieldsDef) {
                StructFieldsDef def = d as StructFieldsDef;
                StructLayoutInfo info = this._computeObjFields(k, def, StructLayout._substOf(def, k));
                this._objectCache.Put(k, info);
                return info;
            }
        }
        return new StructLayoutInfo(k);
    }

    // 某 class 是否有对象布局（有直接字段 → 设 CLASS_FLAG_HAS_OBJECT_LAYOUT + emit 对象块）。
    public bool HasObjectLayout(string className) {
        return this.ObjectLayoutOf(className).FieldCount > 0;
    }

    // 计算（或取缓存）某 struct 类型的布局。环检测命中 → 记 ErrorType 并返回空布局（size 0）打断递归。
    public StructLayoutInfo LayoutOf(string typeName) {
        string key = LayoutKey.Norm(typeName);
        object cached = this._cache.Get(key);
        if (cached == null && this._base != null) { cached = this._base._cache.Get(key); }
        if (cached is StructLayoutInfo) { return cached as StructLayoutInfo; }
        if (this._inProgress.ContainsKey(key)) {
            // 递归自含值字段：struct 直接/间接把自身作为**值**字段 → 无限大小。
            if (this.ErrorType == "") { this.ErrorType = key; this.ErrorCycle = key; }
            return new StructLayoutInfo(key);   // 空布局打断递归（不入缓存）
        }
        // generic-struct-erased-slot-value-copy：实例化名按**基名**取定义，并用「定义型参名 ↔ 实参名」
        // 按位配对出代换表。缓存 key 仍是完整实例化名 ⇒ `Pair<P2,int>` 与 `Pair<string,int>` 各有一份布局。
        object d = this._defs.Get(LayoutKey.Norm(StructLayout.BaseNameOf(key)));
        if (!(d is StructFieldsDef)) {
            // 非 struct 类型不该走这里；返回空布局兜底（调用方应先 IsStructType 判定）。
            return new StructLayoutInfo(key);
        }
        StructFieldsDef def = d as StructFieldsDef;
        StrMap subst = StructLayout._substOf(def, key);
        // 环检测在途集：标记 key「计算中」。无需在结束时移除——LayoutOf 先查 _cache 再查 _inProgress，
        // 计算完成后 key 已入 cache，后续调用命中 cache 提前返回，永不重入 _inProgress 检查（StrMap 无 Remove）。
        this._inProgress.Put(key, "1");
        StructLayoutInfo info = this._compute(key, def, subst);
        this._cache.Put(key, info);
        return info;
    }

    // 「定义型参名 → 实参名」代换表。非实例化名 / 非泛型 / 元数对不上 → 空表（行为逐字不变）。
    // 元数对不上不报错、直接放弃代换：那属于上游类型检查的职责，布局层保守退回今天的句柄表示。
    private static StrMap _substOf(StructFieldsDef def, string instName) {
        StrMap m = new StrMap();
        if (def.TpCount <= 0) { return m; }
        string[] args = StructLayout.InstArgsOf(instName);
        if (args.Length != def.TpCount) { return m; }
        int i = 0;
        // 值包 StrBox：StrMap 存 object，prim string 不能 `as string` 下行（同 ImportedSymbolLoader 的口径）。
        while (i < def.TpCount) { m.Put(def.TypeParamNames[i], new StrBox(args[i])); i = i + 1; }
        return m;
    }

    // 字段声明类型名过代换表。**整名匹配 + 递归进实例化实参**（fix-nested-generic-field-layout）。
    //
    // 🔴 此前只做整名匹配，于是「字段类型本身是个实例化」这一格**代换不到**：
    // `struct Wrap<T> { Loc<T,long> inner; }` + `Wrap<P2>` 时 `subst = {T→P2}`，而字段类型串是
    // `"Loc<T,long>"` —— 整名不在表里 ⇒ 不代换 ⇒ 这里按**擦除**的 `Loc`（A 当 8B 句柄）算，
    // 得 16B；而访问侧的类型是语义层结构递归出来的 `Loc<P2,long>`（a 内联 16B + b 8B = 24B）。
    // 两侧对同一批字节的理解不一致 ⇒ 实测崩在
    // `struct field write out of blob bounds (off=16, w=8, len=16)`：
    // 分配端给 16 字节，访问端按 off=16 写 —— 越界。
    //
    // ⚠️ 重组必须用 `InstName`（那是「编译器 / wire / 运行期三方必须用的同一份拼法」）。
    // 自己拼一份会让描述符名对不上，而运行期 `resolve_layout` 查不到是**静默落兜底布局**
    // ——零引用叶子的实例化恰好照常工作、有引用叶子的才崩，规律不自解释。
    //
    // 递归而非一层：`Wrap<Loc<T,long>>` / `Loc<Wrap<T>,long>` 都要代换到底。
    // 不在表里且无 `<` ⇒ 原样返回（非型参的具体类型名，本就不该动）。
    private static string _substFieldTypeName(string ftype, StrMap subst) {
        if (subst.ContainsKey(ftype)) { return (subst.Get(ftype) as StrBox).Value; }
        if (ftype.IndexOf('<') < 0) { return ftype; }
        string[] args = StructLayout.InstArgsOf(ftype);
        if (args.Length == 0) { return ftype; }
        bool changed = false;
        int i = 0;
        while (i < args.Length) {
            string na = StructLayout._substFieldTypeName(args[i], subst);
            if (na != args[i]) { args[i] = na; changed = true; }
            i = i + 1;
        }
        if (!changed) { return ftype; }
        return StructLayout.InstName(StructLayout.BaseNameOf(ftype), args, args.Length);
    }

    // 布局主算法：逐字段按对齐排布，累积 size/align，展平引用叶子。
    private StructLayoutInfo _compute(string typeName, StructFieldsDef def, StrMap subst) {
        StructLayoutInfo info = new StructLayoutInfo(typeName);
        int offset = 0;
        int maxAlign = 1;
        int i = 0;
        while (i < def.FieldCount) {
            string fname = def.FieldNames[i];
            string ftype = def.FieldTypeNames[i];
            // generic-struct-erased-slot-value-copy：字段声明类型名先过代换表（`A` → `P2`）。
            // 代换之后一切照旧——下游拿到的已是具体名（可能本身又是实例化名，递归 LayoutOf 会再代换一层）。
            // fix-nested-generic-field-layout：代换**递归进实例化实参**（`Loc<T,long>` → `Loc<P2,long>`），
            // 不再只认整名 —— 见 `_substFieldTypeName` 头注（只认整名时分配端与访问端布局会分裂）。
            ftype = StructLayout._substFieldTypeName(ftype, subst);
            int kind = this._kindOf(ftype);
            int size = 0;
            int align = 0;
            if (kind == StructLeafKind.Struct) {
                StructLayoutInfo nested = this.LayoutOf(ftype);
                size = nested.Size;
                align = nested.Align;
                if (align == 0) { align = 1; }   // 空/环兜底
                offset = StructLayout._alignUp(offset, align);
                info.AddField(fname, offset, size, kind, ftype);
                // 嵌套 struct 的引用叶子并入父布局（偏移平移）。
                int k = 0;
                while (k < nested.RefLeafCount) {
                    info.AddRefLeaf(offset + nested.RefLeafOffsets[k], nested.RefLeafKinds[k]);
                    k = k + 1;
                }
            } else {
                size = this._sizeOf(ftype, kind);
                align = this._alignOf(kind, size);
                offset = StructLayout._alignUp(offset, align);
                info.AddField(fname, offset, size, kind, ftype);
                if (StructLeafKind.IsRef(kind)) {
                    info.AddRefLeaf(offset, kind);   // 引用叶子入位图（带种类）
                }
            }
            offset = offset + size;
            if (align > maxAlign) { maxAlign = align; }
            i = i + 1;
        }
        info.Align = maxAlign;
        info.Size = StructLayout._alignUp(offset, maxAlign);
        return info;
    }

    // 字段类型名 → 存储种类（ABI 子决策 #2）。**粗粒度**（Prim/ArcString/GcRef/Struct）——保持不变，
    // 使 struct 布局 / ref 位图 / 尺寸对齐全不受 chunk 2a 影响（GcRef 的细分只作用于对象块直接字段的
    // FieldKinds，见 `_refineDirectRefKind` + `_computeObjFields`）。
    private int _kindOf(string typeName) {
        if (this.IsStructType(typeName)) { return StructLeafKind.Struct; }
        string c = PrimModel.Canon(typeName);
        if (c == "string") { return StructLeafKind.ArcString; }
        if (StructLayout._isPrim(c)) { return StructLeafKind.Prim; }
        // 数组 / 非-struct class / interface / func / unknown → 8B GcRef 托管句柄（粗粒度）。
        return StructLeafKind.GcRef;
    }

    // unify-object-byte-layout PR-3 chunk 2a：把对象**直接字段**的粗粒度 GcRef 细分成
    // GcRef(object)/GcRefArray/GcRefClosure，供 runtime 安全内联（design D17）。**判据保守**——只把
    // 「确定 object/array」标为可内联；其余（delegate/func/未解析泛型/unknown）一律 GcRefClosure（侧表安全
    // 默认），因为它们运行时可能是 Closure/FuncRef（非 GcRef），误内联 = UB。false-negative（object 落
    // closure）只是次优（留侧表），绝不 UB。只对 coarse==GcRef 的字段调用。
    private int _refineDirectRefKind(string ftype) {
        // 数组 T[]：运行时 Value::Array（8B GcRef<ArrayObj>）→ 可内联，重建为 Array。
        if (StructLayout._isArraySpelling(ftype)) { return StructLeafKind.GcRefArray; }
        string bn = StructLayout._baseName(LayoutKey.Norm(ftype));
        // **object / interface 字段是多态擦除目标**（TypeChecker 装箱边界 = is Interface || _isObjectName）：
        // 可持装箱值（BoxedStruct/Array/Str/Closure）——运行时 Value 变体不定。8B 裸指针**丢变体判别**，
        // 读回只能重建 Value::Object（≠ BoxedStruct，unbox 失败）→ **不可安全内联，留侧表(GcRefClosure)**。
        if (StructLayout._isObjectSpelling(bn)) { return StructLeafKind.GcRefClosure; }
        if (this._erasureNames != null && this._erasureNames.ContainsKey(bn)) { return StructLeafKind.GcRefClosure; }
        // 确定的**具体类**（本地/导入的非-struct class，在 _classDefs 里，非 object/interface）：字段恒
        // Value::Object（只能持该类或子类，绝不持 boxed struct/array）→ 可内联，重建为 Object。
        // delegate 不在 _classDefs（它在 SymbolTable.Delegates，是 Z42FuncType）→ 自然落 GcRefClosure。
        if (this._classDefs != null && this._classDefs.ContainsKey(bn)) { return StructLeafKind.GcRef; }
        // 其余（delegate/func/未解析泛型 base 名不匹配/unknown）：可能是 Closure/FuncRef（非 GcRef）→ 侧表安全默认。
        return StructLeafKind.GcRefClosure;
    }

    // object 根类型的各拼写（镜像 TypeChecker._isObjectName）。object 字段多态 → 不可内联。
    private static bool _isObjectSpelling(string n) {
        return n == "object" || n == "Object" || n == "Std.Object";
    }

    // 是否数组拼写（`T[]`）。剥可空 `?` 后判后缀。
    private static bool _isArraySpelling(string typeName) {
        string s = typeName;
        if (s.EndsWith("?")) { s = s.Substring(0, s.Length - 1); }
        return s.EndsWith("[]");
    }

    // 泛型类型的 base 名（`Demo.List<int>` → `Demo.List`）。用于查 _classDefs / _erasureNames（键为布局键）。
    private static string _baseName(string normName) {
        int lt = normName.IndexOf('<');
        if (lt >= 0) { return LayoutKey.Norm(normName.Substring(0, lt)); }
        return normName;
    }

    // 基元字节大小（char=4B Unicode 标量）。
    private int _sizeOf(string typeName, int kind) {
        // unify-object-byte-layout PR-3 chunk 2c：引用叶子 16→8B。GcRef 已 8B（chunk 1）、对象直接
        // 引用已内联 8B（chunk 2b），此处把 struct 字节布局的引用宽度也塌到 8B → 全局 8B 引用一致
        // （消除 D13 的 struct=16B / 对象=8B 分裂）。runtime 反射镜像 `struct_reflect.rs::_sizeOf` 同步。
        if (StructLeafKind.IsRef(kind)) { return 8; }
        string c = PrimModel.Canon(typeName);
        if (c == "sbyte" || c == "byte" || c == "bool") { return 1; }
        if (c == "short" || c == "ushort") { return 2; }
        if (c == "int" || c == "uint" || c == "float" || c == "char") { return 4; }
        if (c == "long" || c == "ulong" || c == "double") { return 8; }
        return 8;   // 未知基元兜底（不该发生）
    }

    // 对齐：基元=自然对齐(=size)；引用=8。
    private int _alignOf(int kind, int size) {
        if (StructLeafKind.IsRef(kind)) { return 8; }
        return size;
    }

    private static bool _isPrim(string canon) {
        return canon == "sbyte" || canon == "byte" || canon == "short" || canon == "ushort"
            || canon == "int" || canon == "uint" || canon == "long" || canon == "ulong"
            || canon == "float" || canon == "double" || canon == "bool" || canon == "char";
    }

    // off 向上取整到 align 的倍数（align 为 2 的幂或任意正整数皆可）。
    private static int _alignUp(int off, int align) {
        if (align <= 1) { return off; }
        int rem = off % align;
        if (rem == 0) { return off; }
        return off + (align - rem);
    }
}
