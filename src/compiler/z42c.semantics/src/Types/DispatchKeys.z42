// 派发键派生（统一签名键 / 参数类型键片段）——semantics-split 准备：从 `Binding/OverloadResolver.z42`
// 逐字搬来的**纯命名工具**（只依赖 Z42Type 家族 + PrimModel，零符号表、零 AST），供 Symbols/Types
// 层（MemberCollector / SymbolCollector / InheritanceResolver / CtorInheritance / ConstraintChecker）
// 与 Binding 层（OverloadResolver 薄转发）共用。定义点与跨包 import 两侧共用同一份 ⇒ round-trip 一致。
namespace Z42.Semantics;

public static class DispatchKeys {
    // 统一签名键：每个方法（含唯一方法）一律编码完整签名 `名$参数数$类型键…`。
    public static string MangleKey(string name, Z42Type[] paramTypes, int paramCount) {
        string s = name + "$" + paramCount.ToString();
        int i = 0;
        while (i < paramCount) {
            s = s + "$" + DispatchKeys.TypeKey(paramTypes[i]);
            i = i + 1;
        }
        return s;
    }

    // 单个形参类型 → 键片段：Canon 归一（基本别名 + 剥 nullable）后剥空白（泛型名含 ", "）。
    // unify-value-types Phase 1：**复合类型（array / instantiated / func）里的内建叶子必须用
    // keyword 拼写**（PrimModel.Canon：Char→"char"、Int32→"int"、Byte→"byte"），复刻翻转前
    // Z42PrimType 承载的名——否则 `char[]` 变 `Char[]`，与 TSIG 源拼写导出键失配 → 跨包
    // `undefined function`。裸内建仍走 Canon（int→"int"）。二者的非对称正是逐字节
    // 复刻旧 `Canon(Name())`：旧 Canon 只归一裸名、不进 "[]"/"<>" 内部，故内部叶子保留 keyword 拼写。
    public static string TypeKey(Z42Type t) {
        if (t == null) { return "unknown"; }
        if ((t is Z42ArrayType) || (t is Z42InstantiatedType) || (t is Z42FuncType)) {
            return DispatchKeys._stripSpaces(DispatchKeys._compositeKeyName(t));
        }
        return DispatchKeys._stripSpaces(t.CanonName());
    }

    // 复合类型名重建（镜像各 Z42Type.Name() 的字符串格式），但内建叶子映射回 keyword 拼写。
    private static string _compositeKeyName(Z42Type t) {
        if (t is Z42ArrayType) { return DispatchKeys._compositeKeyName((t as Z42ArrayType).Elem) + "[]"; }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it = t as Z42InstantiatedType;
            string s = it.Def.Name() + "<";
            int i = 0;
            while (i < it.ArgCount) { if (i > 0) { s = s + ", "; } s = s + DispatchKeys._compositeKeyName(it.TypeArgs[i]); i = i + 1; }
            return s + ">";
        }
        if (t is Z42FuncType) {
            Z42FuncType ft = t as Z42FuncType;
            bool isVoid = ft.Ret is Z42VoidType;
            string s = "Func<";
            if (isVoid) { if (ft.ParamCount == 0) { return "Action"; } s = "Action<"; }
            int i = 0;
            while (i < ft.ParamCount) { if (i > 0) { s = s + ", "; } s = s + DispatchKeys._compositeKeyName(ft.ParamTypes[i]); i = i + 1; }
            if (!isVoid) { if (ft.ParamCount > 0) { s = s + ", "; } s = s + DispatchKeys._compositeKeyName(ft.Ret); }
            return s + ">";
        }
        // 叶子：内建 → keyword 拼写（复刻翻转前 Z42PrimType 名）；其余 → 原名。
        if (t is Z42ClassType) { int _c = t.PrimCode(); if (_c >= 0) { return PrimModel.KeywordOfCode(_c); } }
        return t.Name();
    }

    // perf-compiler-lookup-tables：单趟 char[] 过滤（原 Substring(i,1) + 串拼接为 O(n²) 且每字符两次分配）。
    private static string _stripSpaces(string s) {
        char[] cs = s.ToCharArray();
        int keep = 0;
        int i = 0;
        while (i < cs.Length) { if (cs[i] != ' ') { keep = keep + 1; } i = i + 1; }
        if (keep == cs.Length) { return s; }
        char[] outc = new char[keep];
        int k = 0;
        i = 0;
        while (i < cs.Length) { if (cs[i] != ' ') { outc[k] = cs[i]; k = k + 1; } i = i + 1; }
        return String.FromChars(outc);
    }
}
