// enforce-access-control：成员访问可见性校验（private / protected / internal）。
// 持 TypeChecker 反向引用取 _diags（与 MemberResolver 同款 mediator）。违规 emit E0404，不阻断绑定。
//
// 语义（镜像 C#）：
//   public    — 不校验。
//   private   — 仅声明类文本内可访问（CurrentClass()==declClass；含同类其它实例；派生类不可访问基类 private）。
//   protected — 声明类 + 派生类可访问（沿 CurrentClass 基链上溯能到 declClass；跨包派生天然支持）。
//   internal  — 同包可访问；跨包不可（声明类 IsImported==true → deny）。默认无修饰符成员即 internal。
//
// 名字形式：CurrentClass() 与 FieldSymbol/MethodSymbol.ContainingTypeName 均为**短名**，直接可比。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;

public sealed class AccessChecker {
    private TypeChecker _tc;
    public AccessChecker(TypeChecker tc) { this._tc = tc; }

    // 校验从 env 当前上下文访问「declClass 的 vis 成员」是否允许；违规 emit E0404。
    // vis: 成员 Visibility；declClass: 声明该成员的类短名；kind: "field"/"method"/"property"（消息用）。
    public void CheckAccess(string vis, string declClass, TypeEnv env, SymbolTable symbols,
                            string kind, string name, Span sp) {
        if (vis == "public") { return; }
        if (declClass == "") { return; }   // 声明类未知（prim/接口/泛型形参松绑路径不入此函数，兜底放行不误报）
        if (vis == "private") {
            if (env.CurrentClass() == declClass) { return; }
            this._deny("private", kind, name, declClass, false, sp);
            return;
        }
        if (vis == "protected") {
            if (this._currentDerivesFrom(declClass, env, symbols)) { return; }
            this._deny("protected", kind, name, declClass, false, sp);
            return;
        }
        // internal（含无修饰符默认）：声明类本包 → OK；imported（跨包）→ deny。
        Z42ClassType dc = symbols.GetClass(declClass);
        if (dc == null) { return; }          // 未知声明类 → 保守当本地，放行（绝不误报）
        if (!dc.IsImported) { return; }      // 本包声明 → 同包可访问
        this._deny("internal", kind, name, declClass, true, sp);
    }

    // CurrentClass()==declClass，或沿 CurrentClass 基链上溯能到 declClass（含隐式 Object，镜像 _findField）。
    private bool _currentDerivesFrom(string declClass, TypeEnv env, SymbolTable symbols) {
        string cur = env.CurrentClass();
        if (cur == "") { return false; }     // 自由函数上下文：无「派生」身份
        bool more = true;
        while (more) {
            if (cur == declClass) { return true; }
            Z42ClassType ct = symbols.GetClass(cur);
            if (ct == null) { more = false; }
            else if (ct.HasBase) { cur = ct.BaseName; }
            else if (cur != "Object" && symbols.HasClass("Object")) { cur = "Object"; }   // 隐式继承 Object
            else { more = false; }
        }
        return false;
    }

    private void _deny(string vis, string kind, string name, string declClass, bool crossPkg, Span sp) {
        string msg = "cannot access " + vis + " " + kind + " `" + name + "` of `" + declClass + "`";
        if (crossPkg) { msg = msg + " from another package"; }
        this._tc._diags.Error(DiagnosticCodes.AccessViolation, msg, sp);
    }

    // ── add-deprecated-directive（PR5）：use-site 弃用检测 ────────────────────────────────────
    // 解析到某符号后调；若其带 `[Deprecated]`，记一条 hit 到当前 CU（相位错配：检测在 typecheck、治理
    // 在 PackageCompile._runDeprecation，届时按 [lints]/WAE/#suppress 决定最终 severity/抑制）。不直接进 bag。
    public void CheckDeprecatedM(MethodSymbol m, string name, Span sp) {
        if (m != null && m.IsDeprecated) { this._recordDep(name, m.DeprecationMsg, sp); }
    }
    public void CheckDeprecatedF(FieldSymbol f, string name, Span sp) {
        if (f != null && f.IsDeprecated) { this._recordDep(name, f.DeprecationMsg, sp); }
    }
    public void CheckDeprecatedT(Z42ClassType t, Span sp) {
        if (t != null && t.IsDeprecated) { this._recordDep(t.Name(), t.DeprecationMsg, sp); }
    }
    // 直接发 use-site 弃用告警到 _diags（code "deprecated"，Warning 级，不阻断编译）。#suppress 局部抑制
    // 用 TypeChecker 每-CU 建的 _curSuppress（源自 cu.SuppressRegions，PR3c 既有；语义内、F2 安全——不改
    // z42c.syntax 跨成员面）。**[lints]/warnings-as-errors 治理留 Deferred**：接 LintConfig 到 typecheck 相位
    // 需 pipeline→semantics 新跨成员符号（撞 F2 冷启动 stale-cache），待 F2 修复/staged 后补。见 design.md。
    private void _recordDep(string name, string msg, Span sp) {
        if (this._tc._curSuppress != null && this._tc._curSuppress.IsSuppressed("deprecated", sp.Start)) { return; }
        string m = "`" + name + "` 已弃用（deprecated）";
        if (msg != "") { m = m + "：" + msg; }
        this._tc._diags.Warning("deprecated", m, sp);
    }

    // ── enforce-class-access：类级访问强制（引用点） ──────────────────────────────────────────
    // 从 currentClass 上下文**引用** resolved 类型是否允许；违规 emit E0404 到 diags（不阻断）。
    // 静态 + 显式 diag bag：绑定期（binder → _tc._diags）与收集期（SymbolCollector → 其 Diags）共用同一逻辑。
    // 语义镜像成员级：public 放行；private 嵌套类仅外层类文本内；protected 外层类+派生；internal 同包，跨包 deny。
    // 泛型实例化递归校验（定义类 + 每个类型实参）。非类类型（prim/接口/泛型形参/未知/func）一律放行，绝不误报。
    public static void CheckTypeRef(Z42Type resolved, string currentClass, SymbolTable symbols,
                                    DiagnosticBag diags, Span sp) {
        if (resolved is Z42InstantiatedType) {
            Z42InstantiatedType it = resolved as Z42InstantiatedType;
            AccessChecker.CheckTypeRef(it.Def, currentClass, symbols, diags, sp);
            int i = 0;
            while (i < it.ArgCount) { AccessChecker.CheckTypeRef(it.TypeArgs[i], currentClass, symbols, diags, sp); i = i + 1; }
            return;
        }
        if (resolved is Z42ClassType) {
            Z42ClassType ct = resolved as Z42ClassType;
            // unify（删 Z42PrimType）后基元 `int`≡`Std.Int32` 是 phantom Z42ClassType——永远可访问
            // （镜像旧模型：旧 Z42PrimType 本就被 `!(is Z42ClassType)` 跳过），否则会误拒所有 `int` 引用。
            if (PrimModel.IsBuiltin(ct.Name())) { return; }
            AccessChecker._checkVisRef(ct.Visibility, ct.Name(), ct.IsImported, "class", currentClass, symbols, diags, sp);
            return;
        }
        // complete-class-access-control ④：接口与类对称强制（internal 接口跨包引用 deny）。
        if (resolved is Z42InterfaceType) {
            Z42InterfaceType ift = resolved as Z42InterfaceType;
            AccessChecker._checkVisRef(ift.Visibility, ift.Name(), ift.IsImported, "interface", currentClass, symbols, diags, sp);
            return;
        }
        // fix-undefined-type-diagnostic D5：数组元素递归（覆盖 `C[]` 元素未定义）。
        if (resolved is Z42ArrayType) {
            Z42ArrayType at = resolved as Z42ArrayType;
            AccessChecker.CheckTypeRef(at.Elem, currentClass, symbols, diags, sp);
            return;
        }
        // fix-undefined-type-diagnostic：具名 Unknown（SymbolTable.ResolveTypeP 未解析 fallthrough
        // 携原名）= 真未定义类型 → E0443。匿名 Unknown（var 无 init / 错误恢复，UnresolvedName=="")
        // 是级联抑制哨兵，放行不误报。
        if (resolved is Z42UnknownType) {
            Z42UnknownType u = resolved as Z42UnknownType;
            if (u.UnresolvedName != "") {
                diags.Error(DiagnosticCodes.UndefinedType, "undefined type: " + u.UnresolvedName, sp);
            }
            return;
        }
        // 其余（prim/泛型形参/func）一律放行，绝不误报。
    }

    // 类/接口共用的可见性引用校验（private 嵌套文本域 / protected 外层家族 / internal 跨包 deny）。
    // kind："class"/"interface"（仅诊断措辞）。isImported=声明自依赖 zpkg（跨包）。
    private static void _checkVisRef(string vis, string declName, bool isImported, string kind,
                                     string currentClass, SymbolTable symbols, DiagnosticBag diags, Span sp) {
        if (vis == "public") { return; }
        string outer = AccessChecker._nestedOuter(declName);
        if (vis == "private") {
            // 嵌套 private：外层类文本内（含更深嵌套）。顶层 private（outer==""）：仅类自身文本（真实代码无此）。
            if (outer == "") { if (currentClass == declName) { return; } }
            else if (currentClass == outer || currentClass.StartsWith(outer + "+")) { return; }
            AccessChecker._denyType("private", declName, kind, false, diags, sp);
            return;
        }
        if (vis == "protected") {
            // 嵌套 protected：外层类家族（外层类 + 派生）。顶层 protected（unreal）：本类家族。
            string tgt = (outer == "") ? declName : outer;
            if (AccessChecker._derivesFromOrEq(tgt, currentClass, symbols)) { return; }
            AccessChecker._denyType("protected", declName, kind, false, diags, sp);
            return;
        }
        // internal（含无修饰符顶层默认）：本包声明放行；imported（跨包）deny。
        if (!isImported) { return; }
        AccessChecker._denyType("internal", declName, kind, true, diags, sp);
    }

    // 嵌套类外层名（剥 '+' 末段）；顶层类（无 '+'）返回 ""。
    private static string _nestedOuter(string name) {
        int lp = -1;
        int i = 0;
        while (i < name.Length) { if (name.CharAt(i) == '+') { lp = i; } i = i + 1; }
        if (lp < 0) { return ""; }
        return name.Substring(0, lp);
    }

    // cur == target，或沿 cur 基链上溯能到 target（含隐式 Object）。target=="" / cur=="" → false（无家族）。
    private static bool _derivesFromOrEq(string target, string cur, SymbolTable symbols) {
        if (target == "" || cur == "") { return false; }
        bool more = true;
        while (more) {
            if (cur == target) { return true; }
            Z42ClassType ct = symbols.GetClass(cur);
            if (ct == null) { more = false; }
            else if (ct.HasBase) { cur = ct.BaseName; }
            else if (cur != "Object" && symbols.HasClass("Object")) { cur = "Object"; }
            else { more = false; }
        }
        return false;
    }

    private static void _denyType(string vis, string declName, string kind, bool crossPkg, DiagnosticBag diags, Span sp) {
        string disp = declName.Replace("+", ".");   // 用户面用点号（Outer.Inner），内部键为 Outer+Inner
        string msg = "cannot access " + vis + " " + kind + " `" + disp + "`";
        if (crossPkg) { msg = msg + " from another package"; }
        diags.Error(DiagnosticCodes.AccessViolation, msg, sp);
    }

    // ── complete-class-access-control ②：不一致可访问性（C# CS0050 族） ──────────────────────────
    // declVis 的声明（成员/类型）在其签名/基类列表里**暴露**了 exposed 类型；若 exposed 比 declVis
    // 更低可见性 → E0441。可见性线性 rank：public 3 > internal 2 > protected 1 > private 0（design D2，
    // 完整 accessibility-domain 偏序 Deferred）。递归穿透泛型实例化（Def+每个实参）与数组元素；非
    // 类/接口类型（prim/泛型形参/func/void/未知）rank 视 public → 不触发（绝不误报）。
    public static void CheckExposure(string declVis, Z42Type exposed, SymbolTable symbols,
                                     DiagnosticBag diags, Span sp) {
        if (exposed is Z42InstantiatedType) {
            Z42InstantiatedType it = exposed as Z42InstantiatedType;
            AccessChecker.CheckExposure(declVis, it.Def, symbols, diags, sp);
            int i = 0;
            while (i < it.ArgCount) { AccessChecker.CheckExposure(declVis, it.TypeArgs[i], symbols, diags, sp); i = i + 1; }
            return;
        }
        if (exposed is Z42ArrayType) {
            AccessChecker.CheckExposure(declVis, (exposed as Z42ArrayType).Elem, symbols, diags, sp);
            return;
        }
        string exVis = "public";
        string exName = "";
        string exKind = "type";
        if (exposed is Z42ClassType) {
            Z42ClassType ct = exposed as Z42ClassType;
            if (PrimModel.IsBuiltin(ct.Name())) { return; }   // unify：基元 phantom class 恒 public，不算暴露
            exVis = ct.Visibility; exName = ct.Name(); exKind = "class";
        }
        else if (exposed is Z42InterfaceType) { Z42InterfaceType ift = exposed as Z42InterfaceType; exVis = ift.Visibility; exName = ift.Name(); exKind = "interface"; }
        else { return; }
        if (AccessChecker._visRank(exVis) >= AccessChecker._visRank(declVis)) { return; }
        string disp = exName.Replace("+", ".");
        string msg = "inconsistent accessibility: " + exKind + " `" + disp + "` (" + exVis
                   + ") is less accessible than the exposing declaration (" + declVis + ")";
        diags.Error(DiagnosticCodes.InconsistentAccessibility, msg, sp);
    }

    // 可见性线性 rank（public 最高）；null / 未知安全默认 public（最高，绝不误报）。
    private static int _visRank(string vis) {
        if (vis == "private")   { return 0; }
        if (vis == "protected") { return 1; }
        if (vis == "internal")  { return 2; }
        return 3;
    }

    // 两者中更低可见性的那个（有效可访问性 = min(成员声明, 外层类)——镜像 C# effective accessibility；
    // `internal class` 内的 `public` 成员实际只 internal 可见，故暴露 internal 类型不算泄漏，绝不误报）。
    public static string MinVisibility(string a, string b) {
        return (AccessChecker._visRank(a) <= AccessChecker._visRank(b)) ? a : b;
    }
}
