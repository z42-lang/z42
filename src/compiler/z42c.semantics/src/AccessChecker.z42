// enforce-access-control：成员访问可见性校验（private / protected / internal）。
// 持 TypeChecker 反向引用取 _diags（与 MemberResolver 同款 mediator）。违规 emit E0404，不阻断绑定。
//
// 语义（镜像 C#）：
//   public    — 不校验。
//   private   — 仅声明类文本内可访问（CurrentClass()==declClass；含同类其它实例；派生类不可访问基类 private）。
//   protected — 声明类 + 派生类可访问（沿 CurrentClass 基链上溯能到 declClass；跨包派生天然支持）。
//   internal  — 同包可访问；跨包不可（声明类 IsImported==true → deny）。默认无修饰符成员即 internal。
//
// 名字形式：CurrentClass() 与 FieldSymbol/MethodSymbol.ContainingTypeName 均为**短名**，直接可比。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;

public sealed class AccessChecker {
    private TypeChecker _tc;
    public AccessChecker(TypeChecker tc) { this._tc = tc; }

    // 校验从 env 当前上下文访问「declClass 的 vis 成员」是否允许；违规 emit E0404。
    // vis: 成员 Visibility；declClass: 声明该成员的类短名；kind: "field"/"method"/"property"（消息用）。
    public void CheckAccess(string vis, string declClass, TypeEnv env, SymbolTable symbols,
                            string kind, string name, Span sp) {
        if (vis == "public") { return; }
        if (declClass == "") { return; }   // 声明类未知（prim/接口/泛型形参松绑路径不入此函数，兜底放行不误报）
        if (vis == "private") {
            if (env.CurrentClass() == declClass) { return; }
            this._deny("private", kind, name, declClass, false, sp);
            return;
        }
        if (vis == "protected") {
            if (this._currentDerivesFrom(declClass, env, symbols)) { return; }
            this._deny("protected", kind, name, declClass, false, sp);
            return;
        }
        // internal（含无修饰符默认）：声明类本包 → OK；imported（跨包）→ deny。
        Z42ClassType dc = symbols.GetClass(declClass);
        if (dc == null) { return; }          // 未知声明类 → 保守当本地，放行（绝不误报）
        if (!dc.IsImported) { return; }      // 本包声明 → 同包可访问
        this._deny("internal", kind, name, declClass, true, sp);
    }

    // CurrentClass()==declClass，或沿 CurrentClass 基链上溯能到 declClass（含隐式 Object，镜像 _findField）。
    private bool _currentDerivesFrom(string declClass, TypeEnv env, SymbolTable symbols) {
        string cur = env.CurrentClass();
        if (cur == "") { return false; }     // 自由函数上下文：无「派生」身份
        bool more = true;
        while (more) {
            if (cur == declClass) { return true; }
            Z42ClassType ct = symbols.GetClass(cur);
            if (ct == null) { more = false; }
            else if (ct.HasBase) { cur = ct.BaseName; }
            else if (cur != "Object" && symbols.HasClass("Object")) { cur = "Object"; }   // 隐式继承 Object
            else { more = false; }
        }
        return false;
    }

    private void _deny(string vis, string kind, string name, string declClass, bool crossPkg, Span sp) {
        string msg = "cannot access " + vis + " " + kind + " `" + name + "` of `" + declClass + "`";
        if (crossPkg) { msg = msg + " from another package"; }
        this._tc._diags.Error(DiagnosticCodes.AccessViolation, msg, sp);
    }

    // ── enforce-class-access：类级访问强制（引用点） ──────────────────────────────────────────
    // 从 currentClass 上下文**引用** resolved 类型是否允许；违规 emit E0404 到 diags（不阻断）。
    // 静态 + 显式 diag bag：绑定期（binder → _tc._diags）与收集期（SymbolCollector → 其 Diags）共用同一逻辑。
    // 语义镜像成员级：public 放行；private 嵌套类仅外层类文本内；protected 外层类+派生；internal 同包，跨包 deny。
    // 泛型实例化递归校验（定义类 + 每个类型实参）。非类类型（prim/接口/泛型形参/未知/func）一律放行，绝不误报。
    public static void CheckTypeRef(Z42Type resolved, string currentClass, SymbolTable symbols,
                                    DiagnosticBag diags, Span sp) {
        if (resolved is Z42InstantiatedType) {
            Z42InstantiatedType it = resolved as Z42InstantiatedType;
            AccessChecker.CheckTypeRef(it.Def, currentClass, symbols, diags, sp);
            int i = 0;
            while (i < it.ArgCount) { AccessChecker.CheckTypeRef(it.TypeArgs[i], currentClass, symbols, diags, sp); i = i + 1; }
            return;
        }
        if (!(resolved is Z42ClassType)) { return; }
        Z42ClassType ct = resolved as Z42ClassType;
        string vis = ct.Visibility;
        if (vis == "public") { return; }
        string declName = ct.Name();
        string outer = AccessChecker._nestedOuter(declName);
        if (vis == "private") {
            // 嵌套 private：外层类文本内（含更深嵌套）。顶层 private（outer==""）：仅类自身文本（真实代码无此）。
            if (outer == "") { if (currentClass == declName) { return; } }
            else if (currentClass == outer || currentClass.StartsWith(outer + "+")) { return; }
            AccessChecker._denyType("private", declName, false, diags, sp);
            return;
        }
        if (vis == "protected") {
            // 嵌套 protected：外层类家族（外层类 + 派生）。顶层 protected（unreal）：本类家族。
            string tgt = (outer == "") ? declName : outer;
            if (AccessChecker._derivesFromOrEq(tgt, currentClass, symbols)) { return; }
            AccessChecker._denyType("protected", declName, false, diags, sp);
            return;
        }
        // internal（含无修饰符顶层默认）：本包声明放行；imported（跨包）deny。
        if (!ct.IsImported) { return; }
        AccessChecker._denyType("internal", declName, true, diags, sp);
    }

    // 嵌套类外层名（剥 '+' 末段）；顶层类（无 '+'）返回 ""。
    private static string _nestedOuter(string name) {
        int lp = -1;
        int i = 0;
        while (i < name.Length) { if (name.CharAt(i) == '+') { lp = i; } i = i + 1; }
        if (lp < 0) { return ""; }
        return name.Substring(0, lp);
    }

    // cur == target，或沿 cur 基链上溯能到 target（含隐式 Object）。target=="" / cur=="" → false（无家族）。
    private static bool _derivesFromOrEq(string target, string cur, SymbolTable symbols) {
        if (target == "" || cur == "") { return false; }
        bool more = true;
        while (more) {
            if (cur == target) { return true; }
            Z42ClassType ct = symbols.GetClass(cur);
            if (ct == null) { more = false; }
            else if (ct.HasBase) { cur = ct.BaseName; }
            else if (cur != "Object" && symbols.HasClass("Object")) { cur = "Object"; }
            else { more = false; }
        }
        return false;
    }

    private static void _denyType(string vis, string declName, bool crossPkg, DiagnosticBag diags, Span sp) {
        string disp = declName.Replace("+", ".");   // 用户面用点号（Outer.Inner），内部键为 Outer+Inner
        string msg = "cannot access " + vis + " class `" + disp + "`";
        if (crossPkg) { msg = msg + " from another package"; }
        diags.Error(DiagnosticCodes.AccessViolation, msg, sp);
    }
}
