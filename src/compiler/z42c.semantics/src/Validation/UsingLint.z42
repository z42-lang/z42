// using-csharp-rules PR-3：多余的 `using` 报 warning（User 2026-10-01 裁定，三种都报）。
//
//   W0607 不必要（C# CS8019 / IDE0005）：
//     · 指向 prelude（`Std` / `Std.Runtime`）或本文件 ns 及其外围 —— 本来就可见；
//     · 本文件没有任何地方用到它（判据与 E0436 同一份集合：`UsedNs` ∪ `UsedDepNs`）。
//   W0608 重复（C# CS0105）：同一文件写了两次；或包里已有同名 `global using`（注入时打的 `CoveredByGlobal`）。
//
// 不判：编译器注入的 global using 副本（`Injected`）；`global using` 声明本身「全包都没用到」—— 那要全包每个文件的
// 用法集合，而 cached 文件跳过类型检查拿不到（见 tasks）；别名 `using Id = T;`（另一个类）。
// 本文件已有编译错误时整个跳过：解析不全，用法集合不可信，会把用得着的 using 报成多余。
// 发射点用字面量（bootstrap-seed：新常量与引用它的发射点不能同 PR，见 diag-literal-emitters.txt）。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.Core;

public static class UsingLint {

    public static void Check(CompilationUnit cu, string[] used, string[] dep, int depCount, DiagnosticBag diags) {
        if (diags.ErrorCount() > 0) { return; }
        string fileNs = cu.HasNamespace ? cu.Namespace : "";
        string[] seen = new string[cu.DeclCount];
        int sn = 0;
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = cu.Decls[i];
            i = i + 1;
            if (!(d is UsingDecl)) { continue; }
            UsingDecl u = d as UsingDecl;
            if (u.Injected) { continue; }
            if (UsingLint._has(seen, sn, u.Name)) {
                diags.Warning(DiagnosticCodes.DuplicateUsing, "duplicate `using " + u.Name + ";` — it is already imported above in this file", u.Span);
                continue;
            }
            seen[sn] = u.Name; sn = sn + 1;
            if (u.CoveredByGlobal) {
                diags.Warning(DiagnosticCodes.DuplicateUsing, "`using " + u.Name + ";` is redundant — `global using " + u.Name
                    + ";` already imports it into every file of the package", u.Span);
            } else if (PreludeNs.Contains(u.Name)) {
                diags.Warning(DiagnosticCodes.UnnecessaryUsing, "unnecessary `using " + u.Name + ";` — `" + u.Name
                    + "` is part of the prelude and always visible", u.Span);
            } else if (!u.IsGlobal && NsScope.IsEnclosing(fileNs, u.Name)) {
                // ↑ `global using` 不适用：它对**声明它的文件**本来就可见没关系，它是给全包别的文件用的
                //   （`namespace A;` 的文件里写 `global using A;` 是常见写法）。全包没人用到另由 CheckGlobalUsings 判。
                diags.Warning(DiagnosticCodes.UnnecessaryUsing, "unnecessary `using " + u.Name + ";` — `" + u.Name
                    + "` is this file's namespace or encloses it, so it is visible without `using`", u.Span);
            } else if (!u.IsGlobal && !UsingLint._has(used, used.Length, u.Name) && !UsingLint._hasDep(dep, depCount, u.Name)) {
                diags.Warning(DiagnosticCodes.UnnecessaryUsing, "unnecessary `using " + u.Name + ";` — nothing in this file uses it", u.Span);
            }
        }
    }

    // using-csharp-rules 3.6：`global using X;` **全包**没有任何文件用到 X ⇒ W0607（报在声明它的那一行）。
    // 判据：每个文件的 `UsedNs` ∪ `UsedDepNs`（与 E0436 同一份集合）。cached 文件的这两项由 meta 回填（2.9）——
    // 少了 `UsedNs` 就会把只被 cached 文件用到的 global using 误报成没用。
    // 不判：包里有错误（同 `Check`：用法集合不可信）；编译器注入的副本（`Injected`）；prelude（`Check` 已在声明处报过）。
    public static void CheckGlobalUsings(CompilationUnit[] cus, CompiledModuleZ[] cms, int n) {
        int e = 0;
        while (e < n) { if (cms[e] != null && cms[e].ErrorCount > 0) { return; } e = e + 1; }
        int i = 0;
        while (i < n) {
            if (cus[i] != null && cms[i] != null) {
                int di = 0;
                while (di < cus[i].DeclCount) {
                    Decl d = cus[i].Decls[di];
                    di = di + 1;
                    if (!(d is UsingDecl)) { continue; }
                    UsingDecl u = d as UsingDecl;
                    if (!u.IsGlobal || u.Injected || PreludeNs.Contains(u.Name)) { continue; }
                    if (UsingLint._usedAnywhere(cms, n, u.Name)) { continue; }
                    string file = u.Span != null && u.Span.File != "" ? u.Span.File : (cus[i].Span != null ? cus[i].Span.File : "");
                    string msg = file + "(" + u.Span.Line.ToString() + "," + u.Span.Column.ToString() + "): " + DiagnosticCodes.UnnecessaryUsing
                        + ": unnecessary `global using " + u.Name + ";` — no file in the package uses it";
                    int oldn = cms[i].DiagCount;
                    string[] nw = new string[oldn + 1];
                    int q = 0; while (q < oldn) { nw[q] = cms[i].DiagMsgs[q]; q = q + 1; }
                    nw[oldn] = msg;
                    cms[i].DiagMsgs = nw; cms[i].DiagCount = oldn + 1;
                }
            }
            i = i + 1;
        }
    }

    private static bool _usedAnywhere(CompiledModuleZ[] cms, int n, string ns) {
        int i = 0;
        while (i < n) {
            if (cms[i] != null) {
                if (cms[i].UsedNs != null && UsingLint._has(cms[i].UsedNs, cms[i].UsedNs.Length, ns)) { return true; }
                if (cms[i].UsedDepNs != null && UsingLint._hasDep(cms[i].UsedDepNs, cms[i].UsedDepNsCount, ns)) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    // `UsedDepNs` 的条目可能带归属包（`ns#pkg`，deterministic-zpkg-deps / DepRef）—— 只比 ns 部分。
    private static bool _hasDep(string[] a, int n, string s) {
        int i = 0;
        while (i < n) { if (DepRef.NsOf(a[i]) == s) { return true; } i = i + 1; }
        return false;
    }

    private static bool _has(string[] a, int n, string s) {
        int i = 0;
        while (i < n) { if (a[i] == s) { return true; } i = i + 1; }
        return false;
    }
}
