// add-record-attribute (2026-08-26) — AST-phase desugar for positional parameters on
// class / struct, replacing the deleted `record` keyword. Runs at the same seam as
// AttributeSynth / BenchmarkDesugar (HandlerRegistry.RunAst), before TypeCheck.
//
//   [Record] class Point(int X, int Y) { ... }     →  public  fields X, Y + primary ctor,
//                                                       ClassDecl.IsRecord = true  (zbc bit3)
//   class Point(int X, int Y) { ... }               →  private fields X, Y + primary ctor
//                                                       (C# 12 primary constructor; no bit3)
//
// The parser (_parseTypeDecl) only stores the positional params on ClassDecl.PrimaryParams
// (it cannot see its own [Record] attribute — attrs are wrapped one level out in
// AttributedDecl). This pass, which does see the AttributedDecl, expands them: identical
// desugar to the old _parseRecord (public fields + `this.X = X` ctor) for [Record], and the
// same shape with *private* fields for the bare primary-constructor case.
//
// Bare references to the fields inside method bodies resolve for free: DeclBinder seeds all
// fields into the method-body TypeEnv and AccessEmitter emits a bare BoundIdent hitting a
// field name as `this.X` (FieldGetInstr). So no name-resolution / binder change is needed.
//
// Mutates ClassDecl in place (Members + IsRecord) and recurses into nested type members;
// returns `cu` unchanged (no top-level decl-list rebuild).
namespace Z42.Semantics;

using Z42.Syntax;

public static class RecordExpand {
    public static CompilationUnit Run(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            RecordExpand._expandDecl(cu.Decls[i]);
            i = i + 1;
        }
        return cu;
    }

    // Dispatch a decl that may be an AttributedDecl(ClassDecl) (has attrs — check [Record]),
    // a bare ClassDecl (no attrs — primary ctor if it has positional params), or anything else.
    static void _expandDecl(Decl d) {
        if (d is AttributedDecl) {
            AttributedDecl ad = d as AttributedDecl;
            if (ad.Inner is ClassDecl) {
                RecordExpand._expandClass(ad.Inner as ClassDecl, HandlerRegistry.HasRecord(ad));
            }
        } else if (d is ClassDecl) {
            RecordExpand._expandClass(d as ClassDecl, false);
        }
    }

    // Expand a class/struct's positional params (if any) and recurse into its members.
    static void _expandClass(ClassDecl c, bool hasRecord) {
        if (hasRecord) { c.IsRecord = true; }
        if (c.PrimaryParamCount > 0) {
            RecordExpand._synthPrimaryMembers(c, hasRecord);
            c.PrimaryParams = new Param[0]; c.PrimaryParamCount = 0;   // consumed — avoid re-expansion
        }
        // Nested type members (nested `[Record] class` / `class(params)`) — expand recursively.
        int m = 0;
        while (m < c.MemberCount) {
            RecordExpand._expandDecl(c.Members[m]);
            m = m + 1;
        }
    }

    // Positional params → fields (public for [Record], private otherwise) + primary ctor
    // (`this.X = X` assignments). Mirrors DeclParser._parseRecord:283-307. Prepended before
    // existing block members, so field/ctor ordering matches the old record desugar.
    static void _synthPrimaryMembers(ClassDecl c, bool hasRecord) {
        int pc = c.PrimaryParamCount;
        Param[] pos = c.PrimaryParams;
        string vis = "private";
        if (hasRecord) { vis = "public"; }

        Decl[] nm = new Decl[pc + 1 + c.MemberCount];
        int n = 0;

        // fields
        int pi = 0;
        while (pi < pc) {
            nm[n] = new FieldDecl(vis, pos[pi].Type, pos[pi].Name, false, null, pos[pi].Span);
            n = n + 1;
            pi = pi + 1;
        }

        // primary ctor: Foo(params) { this.p = p; ... }
        Stmt[] cstmts = new Stmt[pc];
        int ci = 0;
        while (ci < pc) {
            Expr tgt = new MemberExpr(new IdentExpr("this", pos[ci].Span), pos[ci].Name, pos[ci].Span);
            Expr val = new IdentExpr(pos[ci].Name, pos[ci].Span);
            cstmts[ci] = new ExprStmt(new AssignExpr("=", tgt, val, pos[ci].Span), pos[ci].Span);
            ci = ci + 1;
        }
        BlockStmt cbody = new BlockStmt(cstmts, pc, c.Span);
        nm[n] = new MethodDecl("", false, true, RecordExpand._emptyType(c.Span), c.Name,
                               RecordExpand._emptyTypeParams(c.Span), new WhereClause[0], 0,
                               pos, pc, true, cbody, new Expr[0], 0, false, c.Span);
        n = n + 1;

        // existing block members
        int em = 0;
        while (em < c.MemberCount) {
            nm[n] = c.Members[em]; n = n + 1;
            em = em + 1;
        }

        c.Members = nm; c.MemberCount = n;
    }

    static TypeExpr _emptyType(Span sp) { return new NamedType("", new TypeExpr[0], 0, sp); }
    static TypeParamList _emptyTypeParams(Span sp) { return new TypeParamList(new string[0], 0, sp); }
}
