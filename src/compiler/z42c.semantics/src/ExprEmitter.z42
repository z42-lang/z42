// 表达式 Bound → IR lowering（port-z42c-codegen，CG-1A–1D；CG-1E refactor 抽出）。
// 集中 if-is 调度（D1）；无表达式临时栈——每子表达式 Alloc 寄存器 + 内联 Emit，返回该寄存器。
// 共享状态经 EmitContext（FunctionEmitter 与本类共用同一 ctx）。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;
using Z42.IR.BinaryFormat;

public sealed class ExprEmitter {
    private EmitContext _ctx;
    private FunctionEmitter _fn;   // 反向引用：BoundSeqExpr 的 prelude 语句委托 _fn._emitStmt（含循环/控制流）
    private CallEmitter _call;     // call/new/method-group 发射簇（CG-1E follow-up 按职责抽出）
    private TypeOpEmitter _top;    // is/typeof/cast/box/convert 发射簇（CG-1E follow-up 按职责抽出）
    private OperatorEmitter _op;   // binary/unary/conditional/switch-expr 发射簇（CG-1E follow-up 按职责抽出）
    public ExprEmitter(EmitContext ctx, FunctionEmitter fn) { this._ctx = ctx; this._fn = fn; this._call = new CallEmitter(ctx, this); this._top = new TypeOpEmitter(ctx, this); this._op = new OperatorEmitter(ctx, this); }

    public TypedReg Emit(BoundExpr e) {
        // 每表达式入口记源码行（镜像 C# EmitExpr 入口 TrackLine；同行去重在 ctx）。
        // 配合 _emitStmt 的语句级 TrackLine，覆盖跨多行的表达式（如多行 return 拼接）。
        // 合成 __static_init__ 走 EmitStaticInit 丢弃行表，不受此影响（镜像 C#）。
        this._ctx.TrackLine(e.Span);
        if (e is BoundLitInt) {
            BoundLitInt li = e as BoundLitInt;
            int tag = this._ctx.ToIrType(li.Type());
            TypedReg r = this._ctx.Alloc(tag);
            // 恒 ConstI64（镜像 C# FunctionEmitterExprs：int 字面量一律 ConstI64Instr，dst 仍按类型 tag；
            // ConstI32 仅闭包 capture index 用——byte-identical 关键）。
            this._ctx.Emit(new ConstI64Instr(r, li.Text));
            return r;
        }
        if (e is BoundLitFloat) {
            BoundLitFloat lf = e as BoundLitFloat;
            TypedReg r = this._ctx.Alloc(this._ctx.ToIrType(lf.Type()));
            this._ctx.Emit(new ConstF64Instr(r, lf.Text));
            return r;
        }
        if (e is BoundLitChar) {
            BoundLitChar lc = e as BoundLitChar;
            TypedReg r = this._ctx.Alloc(IrType.Char);
            this._ctx.Emit(new ConstCharInstr(r, lc.Value));
            return r;
        }
        if (e is BoundLitBool) {
            BoundLitBool lb = e as BoundLitBool;
            TypedReg r = this._ctx.Alloc(IrType.Bool);
            this._ctx.Emit(new ConstBoolInstr(r, lb.Value));
            return r;
        }
        if (e is BoundLitStr) {
            BoundLitStr ls = e as BoundLitStr;
            // 入池须是解码值（剥引号+转义还原），非 raw lexeme——否则引号泄进 STRS：
            // 同池字面量比较碰巧相等，但 concat/输出全错（zbc e2e 抓出，2026-06-10）。
            int idx = this._ctx.Gen.Intern(Lexer.DecodeString(ls.Raw));
            TypedReg r = this._ctx.Alloc(IrType.Str);
            this._ctx.Emit(new ConstStrInstr(r, idx));
            return r;
        }
        if (e is BoundLitNull) {
            TypedReg r = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new ConstNullInstr(r));
            return r;
        }
        if (e is BoundIdent) { return this._lookupIdent(e as BoundIdent); }
        if (e is BoundCapturedIdent) {
            // lift env 版体内：array_get env(reg0)[captureIdx]（镜像 C#——idx 用 ConstI32，唯一 ConstI32 场景）
            BoundCapturedIdent ci = e as BoundCapturedIdent;
            TypedReg idxReg = this._ctx.Alloc(IrType.I32);
            this._ctx.Emit(new ConstI32Instr(idxReg, ci.CaptureIdx.ToString()));
            TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(ci.Type()));
            this._ctx.Emit(new ArrayGetInstr(dst, new TypedReg(0, IrType.Ref), idxReg));
            return dst;
        }
        if (e is BoundArrayNew) {
            BoundArrayNew an = e as BoundArrayNew;
            TypedReg size = this.Emit(an.Size);
            TypedReg dst = this._ctx.Alloc(IrType.Ref);
            // 元素类型名须与 C# Z42TypeName 一致：prim / 泛型形参保留短名；类·实例化用 FQ
            // （镜像 add-reflection-array-element-type：数组运行期非擦除，elem 名须可解析）。
            string elemName = an.ElemName;
            Z42ArrayType at = an.Type() as Z42ArrayType;
            if (at != null && !this._isBuiltinValueElem(at.Elem) && !(at.Elem is Z42GenericParamType)) {
                elemName = this._ctx.QualifyClass(an.ElemName);
            }
            // ElemTag：直接用实际元素 Z42Type 走 ToIrType（泛型形参→Unknown 0x00，非 Ref）。
            // 修 PrimTag 对泛型形参名回落 Ref 的 bug：通过 Z42PrimType 包装会调 PrimTag("T")→Ref。
            int elemTag = at != null ? this._ctx.ToIrType(at.Elem) : IrType.Ref;
            this._ctx.Emit(new ArrayNewInstr(dst, size, elemTag, elemName));
            return dst;
        }
        if (e is BoundRefArg) {
            BoundRefArg ra = e as BoundRefArg;
            TypedReg slotReg;
            // `out var n` 内联声明：先为 n 分配槽寄存器 + 登记 Locals（调用后读 n 命中），
            // 镜像 C#（%1=n; load_local_addr %1）。否则 Emit inner 取其活寄存器。
            if (ra.IsVarDecl && !this._ctx.Locals.ContainsKey(ra.VarName)) {
                slotReg = this._ctx.Alloc(IrType.Unknown);
                this._ctx.Locals.Put(ra.VarName, slotReg);
            } else {
                slotReg = this.Emit(ra.Inner);
            }
            TypedReg dst = this._ctx.Alloc(IrType.Unknown);
            this._ctx.Emit(new LoadLocalAddrInstr(dst, slotReg));
            return dst;
        }
        if (e is BoundArrayLit) {
            BoundArrayLit al = e as BoundArrayLit;
            TypedReg[] elemRegs = new TypedReg[al.ElemCount];
            int ei = 0;
            while (ei < al.ElemCount) { elemRegs[ei] = this.Emit(al.Elems[ei]); ei = ei + 1; }
            TypedReg dst = this._ctx.Alloc(IrType.Ref);
            string elemName = al.ElemName;
            Z42ArrayType at = al.Type() as Z42ArrayType;
            if (at != null && !this._isBuiltinValueElem(at.Elem) && !(at.Elem is Z42GenericParamType)) {
                elemName = this._ctx.QualifyClass(al.ElemName);
            }
            this._ctx.Emit(new ArrayNewLitInstr(dst, elemRegs, al.ElemCount, elemName));
            return dst;
        }
        if (e is BoundSeqExpr) {
            // 序列表达式：依次发射 prelude 语句（委托 FunctionEmitter，支持 var-decl/循环/控制流），
            // 再发射 value 返回其寄存器。集合字面量脱糖用（new + Add/Set + 填充循环 + 收尾读 tmp）。
            BoundSeqExpr sq = e as BoundSeqExpr;
            int si = 0;
            while (si < sq.PreludeCount) { this._fn.EmitStmt(sq.Prelude[si]); si = si + 1; }
            return this.Emit(sq.Value);
        }
        if (e is BoundStaticGet) {
            BoundStaticGet sg = e as BoundStaticGet;
            // add-const-keyword：const 字段 → 字面量替换（无静态存储；喂 ConstFold）。
            ConstValue cfv = this._constFieldVal(sg.ClassName, sg.FieldName);
            if (cfv != null) { return this._emitConstVal(cfv, this._ctx.ToIrType(sg.Type())); }
            TypedReg dst = this._emitStaticGetRaw(sg);
            // add-static-struct-bytecization (PR-2 S)：static struct 字段存的是**装箱盒**
            // （StaticSet 时 __box_struct 全局化，进程存活 + 引用身份）。**整读**（`var q = Holder.P`）
            // 发 AsCast 拆回当前帧 arena StructRef（值语义拷贝）。**叶子访问**（`Holder.P.X`）不走这里——
            // `_structChainRoot` 直接取盒句柄（见下），叶子 StructFieldGet/SetPrim 就地读写盒。
            if (this._isBlobStruct(sg.Type())) {
                TypedReg ud = this._ctx.Alloc(IrType.Ref);
                this._ctx.Emit(new AsCastInstr(ud, dst, this._ctx.QualifyClass(this._blobStructName(sg.Type()))));
                return ud;
            }
            return dst;
        }
        if (e is BoundLambda) { return this._emitLambda(e as BoundLambda); }
        if (e is BoundIndirectCall) {
            BoundIndirectCall ic = e as BoundIndirectCall;
            TypedReg[] args = new TypedReg[ic.ArgCount];
            int ai = 0;
            while (ai < ic.ArgCount) { args[ai] = this.Emit(ic.Args[ai]); ai = ai + 1; }
            TypedReg callee = this.Emit(ic.Callee);
            TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(ic.Type()));
            this._ctx.Emit(new CallIndirectInstr(dst, callee, args, ic.ArgCount));
            return dst;
        }
        if (e is BoundBinary) { return this._op._emitBinary(e as BoundBinary); }
        if (e is BoundUnary) { return this._op._emitUnary(e as BoundUnary); }
        if (e is BoundAssign) { return this._emitAssign(e as BoundAssign); }
        if (e is BoundMember) { return this._emitMember(e as BoundMember); }
        if (e is BoundCall) { return this._call._emitCall(e as BoundCall); }
        if (e is BoundNew) { return this._call._emitNew(e as BoundNew); }
        if (e is BoundIndex) { return this._emitIndex(e as BoundIndex); }
        if (e is BoundIsExpr) { return this._top._emitIs(e as BoundIsExpr); }
        if (e is BoundTypeof) { return this._top._emitTypeof(e as BoundTypeof); }
        if (e is BoundCast) { return this._top._emitCast(e as BoundCast); }
        if (e is BoundBox) { return this._top._emitBox(e as BoundBox); }
        if (e is BoundConvert) { return this._top._emitConvert(e as BoundConvert); }
        if (e is BoundConditional) { return this._op._emitConditional(e as BoundConditional); }
        if (e is BoundSwitchExpr) { return this._op._emitSwitchExpr(e as BoundSwitchExpr); }
        if (e is BoundFuncRef) {   // 方法组：LoadFn @<qualified 自由函数名>（与 free-call 同名限定）
            BoundFuncRef fr = e as BoundFuncRef;
            TypedReg frdst = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new LoadFnInstr(frdst, this._ctx.Qualify(fr.FuncName)));
            return frdst;
        }
        if (e is BoundMethodGroup) { return this._call._emitMethodGroup(e as BoundMethodGroup); }
        if (e is BoundInterpolatedStr) { return this._emitInterpolation(e as BoundInterpolatedStr); }
        if (e is BoundDefault) {
            BoundDefault def = e as BoundDefault;
            // add-generic-methods：方法级 default(T) → MethodDefaultInsn（读 frame.method_type_args）。
            if (def.IsMethodLevel) {
                TypedReg mdr = this._ctx.Alloc(IrType.Ref);
                this._ctx.Emit(new MethodDefaultInsn(mdr, def.ParamIndex));
                return mdr;
            }
            if (def.ParamIndex >= 0) {
                TypedReg dr = this._ctx.Alloc(IrType.Ref);
                this._ctx.Emit(new DefaultOfInstr(dr, def.ParamIndex));
                return dr;
            }
            int dtag = this._ctx.ToIrType(def.Type());
            if (dtag == IrType.Bool) {
                TypedReg drb = this._ctx.Alloc(IrType.Bool);
                this._ctx.Emit(new ConstBoolInstr(drb, false));
                return drb;
            }
            if (dtag == IrType.I32 || dtag == IrType.I8 || dtag == IrType.I16 || dtag == IrType.U8 || dtag == IrType.U16 || dtag == IrType.U32) {
                TypedReg dri = this._ctx.Alloc(IrType.I32);
                this._ctx.Emit(new ConstI32Instr(dri, "0"));
                return dri;
            }
            if (dtag == IrType.I64 || dtag == IrType.U64) {
                TypedReg drl = this._ctx.Alloc(IrType.I64);
                this._ctx.Emit(new ConstI64Instr(drl, "0"));
                return drl;
            }
            if (dtag == IrType.F32 || dtag == IrType.F64) {
                TypedReg drf = this._ctx.Alloc(IrType.F64);
                this._ctx.Emit(new ConstF64Instr(drf, "0.0"));
                return drf;
            }
            if (dtag == IrType.Char) {
                TypedReg drc = this._ctx.Alloc(IrType.Char);
                this._ctx.Emit(new ConstCharInstr(drc, '\0'));   // default(char) = '\0'
                return drc;
            }
            TypedReg drn = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new ConstNullInstr(drn));
            return drn;
        }
        // BoundError（类型检查失败的错误恢复哨兵）：优雅降级为 const.null（保 dump 良构）。
        // 仅错误路径可达——成功编译在 emit 前已因类型错误中止，不会走到这里。
        if (e is BoundError) {
            TypedReg ph = this._ctx.Alloc(this._ctx.ToIrType(e.Type()));
            this._ctx.Emit(new ConstNullInstr(ph));
            return ph;
        }
        // 其余任何未处理节点 = 编译器 bug（新增了 BoundExpr 种类却漏接 emit dispatch）。
        // 响亮报错，杜绝此前「静默 emit const.null 占位 → 错误 codegen」的隐蔽陷阱
        // （dispatch 穷尽性：新增节点漏接立即崩、带节点 Dump，而非产出错误字节）。
        throw new Exception("ExprEmitter.Emit: unhandled BoundExpr kind: " + e.Dump());
    }

    // GS4：插值串发射。镜像 C# EmitInterpolation：
    // 1. 所有 part 左→右依次发射，收集寄存器列表；
    // 2. EmitConcat 左折叠 StrConcatInstr。
    // 文本段 → ConstStrInstr；洞 → emit inner + ToStrInstr（内层非 BoundLitStr/BoundInterpolatedStr 时）。
    private TypedReg _emitInterpolation(BoundInterpolatedStr interp) {
        if (interp.PartCount == 0) {
            TypedReg empty = this._ctx.Alloc(IrType.Str);
            int emptyIdx = this._ctx.Gen.Intern("");
            this._ctx.Emit(new ConstStrInstr(empty, emptyIdx));
            return empty;
        }
        TypedReg[] regs = new TypedReg[interp.PartCount];
        int i = 0;
        while (i < interp.PartCount) {
            BoundInterpPart p = interp.Parts[i];
            if (p is BoundInterpText) {
                BoundInterpText tp = p as BoundInterpText;
                TypedReg dst = this._ctx.Alloc(IrType.Str);
                int idx = this._ctx.Gen.Intern(tp.Text);
                this._ctx.Emit(new ConstStrInstr(dst, idx));
                regs[i] = dst;
            } else {
                BoundInterpHole hp = p as BoundInterpHole;
                TypedReg innerReg = this.Emit(hp.Inner);
                bool isStrLit = (hp.Inner is BoundLitStr) || (hp.Inner is BoundInterpolatedStr);
                if (!isStrLit) {
                    TypedReg strReg = this._ctx.Alloc(IrType.Str);
                    this._ctx.Emit(new ToStrInstr(strReg, innerReg));
                    innerReg = strReg;
                }
                regs[i] = innerReg;
            }
            i = i + 1;
        }
        // left-fold: result = regs[0]; for each regs[j] j>0: result = StrConcat(result, regs[j])
        TypedReg result = regs[0];
        int j = 1;
        while (j < interp.PartCount) {
            TypedReg dst = this._ctx.Alloc(IrType.Str);
            this._ctx.Emit(new StrConcatInstr(dst, result, regs[j]));
            result = dst;
            j = j + 1;
        }
        return result;
    }

    // lambda 发射（port-z42c-closures）：lift 子发射器 + LoadFn（无捕获）/ MkClos（捕获，恒堆）。
    private TypedReg _emitLambda(BoundLambda lam) {
        string liftName = this._ctx.CurFnName + "__lambda_" + this._ctx.LambdaIdx.ToString();
        this._ctx.LambdaIdx = this._ctx.LambdaIdx + 1;
        var fe = new FunctionEmitter(this._ctx.Symbols, this._ctx.Gen);
        IrFunction lifted = fe.EmitLambdaLifted(liftName, lam);
        this._ctx.Gen.AddLifted(lifted);
        TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(lam.Type()));
        if (lam.CaptureCount == 0) {
            this._ctx.Emit(new LoadFnInstr(dst, liftName));
            return dst;
        }
        TypedReg[] caps = new TypedReg[lam.CaptureCount];
        int i = 0;
        while (i < lam.CaptureCount) {
            string cname = lam.Captures[i].Name;
            if (this._ctx.Locals.ContainsKey(cname)) {
                caps[i] = this._ctx.Locals.Get(cname) as TypedReg;
            } else {
                // 嵌套捕获：cname 是**外层 lambda 的捕获**（不在 Locals，经 env 访问）。
                // 物化 array_get env(reg0)[envIdx] 成寄存器，作内层 lambda 的捕获实参。
                // 修：原 Locals.Get → null → MkClos null 捕获 → ZbcWriter._args 崩溃。
                int envIdx = this._captureEnvIdx(cname);
                if (envIdx >= 0) {
                    TypedReg idxReg = this._ctx.Alloc(IrType.I32);
                    this._ctx.Emit(new ConstI32Instr(idxReg, envIdx.ToString()));
                    TypedReg mat = this._ctx.Alloc(this._ctx.ToIrType(lam.Captures[i].CapType));
                    this._ctx.Emit(new ArrayGetInstr(mat, new TypedReg(0, IrType.Ref), idxReg));
                    caps[i] = mat;
                } else {
                    TypedReg ph = this._ctx.Alloc(IrType.Ref);
                    this._ctx.Emit(new ConstNullInstr(ph));
                    caps[i] = ph;
                }
            }
            i = i + 1;
        }
        this._ctx.Emit(new MkClosInstr(dst, liftName, caps, lam.CaptureCount, false));
        return dst;
    }

    // 当前 lifted lambda 的捕获名 → env 槽位（嵌套 lambda 解析外层捕获）；非捕获返回 -1。
    private int _captureEnvIdx(string name) {
        int i = 0;
        while (i < this._ctx.CaptureNameCount) {
            if (this._ctx.CaptureNames[i] == name) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    // ident：local/param → 寄存器；裸自身字段 → field_get(reg0=this)；静态字段/未解析 → 占位。
    // add-const-keyword：class.field 是 const 字段 → 返回其 ConstValue（供字面量替换）；否则 null。
    private ConstValue _constFieldVal(string className, string fieldName) {
        if (!this._ctx.Symbols.HasClass(className)) { return null; }
        Z42ClassType ct = this._ctx.Symbols.GetClass(className);
        if (ct == null || ct.Fields == null) { return null; }
        FieldSymbol fs = ct.Fields.Get(fieldName) as FieldSymbol;
        if (fs != null && fs.IsConst) { return fs.ConstVal; }
        return null;
    }

    // add-const-keyword：把 ConstValue 发射为对应字面量指令，返回其寄存器（喂 ConstFold）。
    // intTag = 引用点类型的 IR 标签（镜像字面量路径 `Alloc(ToIrType(lit.Type()))`——int 字面量恒 ConstI64
    // 但 dst 按声明类型 i8/i16/i32/i64 tag，保 REGT 与 JIT 特化一致）。
    // 负整数：ConstI64 不编码负值 → magnitude + neg（镜像源码 `-N` = Neg(ConstI64 N)）。
    // 浮点：ConstF64Instr 存文本，用 bits→double→ToString（Rust 最短往返表示，Convert.ToDouble 精确还原）。
    private TypedReg _emitConstVal(ConstValue cv, int intTag) {
        if (cv == null) { TypedReg r0 = this._ctx.Alloc(IrType.Ref); this._ctx.Emit(new ConstNullInstr(r0)); return r0; }
        if (cv.Kind == ConstValue.KInt) {
            if (cv.IntVal >= 0) {
                TypedReg r = this._ctx.Alloc(intTag);
                this._ctx.Emit(new ConstI64Instr(r, cv.IntVal.ToString()));
                return r;
            }
            long mag = 0 - cv.IntVal;
            TypedReg m = this._ctx.Alloc(intTag);
            this._ctx.Emit(new ConstI64Instr(m, mag.ToString()));
            TypedReg rn = this._ctx.Alloc(intTag);
            this._ctx.Emit(new NegInstr(rn, m));
            return rn;
        }
        if (cv.Kind == ConstValue.KBool) {
            TypedReg r = this._ctx.Alloc(IrType.Bool);
            this._ctx.Emit(new ConstBoolInstr(r, cv.IntVal != 0));
            return r;
        }
        if (cv.Kind == ConstValue.KChar) {
            TypedReg r = this._ctx.Alloc(IrType.Char);
            this._ctx.Emit(new ConstCharInstr(r, (char)(int)cv.IntVal));
            return r;
        }
        if (cv.Kind == ConstValue.KFloat) {
            TypedReg r = this._ctx.Alloc(IrType.F64);
            this._ctx.Emit(new ConstF64Instr(r, ZbcReaderInstr.BitsToDouble(cv.IntVal).ToString()));
            return r;
        }
        if (cv.Kind == ConstValue.KStr) {
            int idx = this._ctx.Gen.Intern(cv.StrVal);
            TypedReg r = this._ctx.Alloc(IrType.Str);
            this._ctx.Emit(new ConstStrInstr(r, idx));
            return r;
        }
        TypedReg rr = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new ConstNullInstr(rr));
        return rr;
    }

    private TypedReg _lookupIdent(BoundIdent id) {
        // add-const-keyword：局部 const 裸引用 → 字面量替换（须先于 Locals：const 也占存储槽，存储由 DCE 清）。
        if (this._ctx.ConstLocals.ContainsKey(id.Name)) { return this._emitConstVal(this._ctx.ConstLocals.Get(id.Name) as ConstValue, this._ctx.ToIrType(id.Type())); }
        if (this._ctx.Locals.ContainsKey(id.Name)) { return this._ctx.Locals.Get(id.Name) as TypedReg; }
        if (this._ctx.Fields.ContainsKey(id.Name)) {
            // A-use：所属类是 blob 值 struct → 裸字段（`this.f`）读翻转为 StructFieldGetPrim(reg0=句柄)。
            if (this._ctx.OwnerStructName != "") {
                // add-struct-nested-fields：裸 owner 字段本身是 struct（`P p = a;`）→ 值复制出（reg0=this，off=字段 offset）。
                if (this._ctx.Gen.Layouts.FieldIsStruct(this._ctx.OwnerStructName, id.Name)) {
                    string fs = this._ctx.Gen.Layouts.FieldTypeName(this._ctx.OwnerStructName, id.Name);
                    int foff = this._ctx.Gen.Layouts.FieldByteOffset(this._ctx.OwnerStructName, id.Name);
                    int sz = this._ctx.Gen.Layouts.StructSize(fs);
                    TypedReg cp = this._ctx.Alloc(IrType.Ref);
                    this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
                    this._copyRegion(new TypedReg(0, IrType.Ref), foff, cp, 0, fs);
                    return cp;
                }
                return this._emitStructFieldGet(this._ctx.OwnerStructName, id.Name, new TypedReg(0, IrType.Ref), this._ctx.ToIrType(id.Type()));
            }
            // add-struct-heap-inline (P3b)：裸内联 struct 字段整读（`Point p = pt`，class C 方法内）→ 拷出新局部
            // blob（值语义）。裸叶子 `pt.x` 由 _emitBlobFieldGet 经 _isOwnerInlineField 根处理。
            if (this._isOwnerInlineField(id)) {
                string fs = this._blobStructName(id.Type());
                int foff = this._ctx.Gen.Layouts.InlineFieldByteOffset(this._ctx.OwnerClassName, id.Name);
                int sz = this._ctx.Gen.Layouts.StructSize(fs);
                TypedReg cp = this._ctx.Alloc(IrType.Ref);
                this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
                this._copyRegion(new TypedReg(0, IrType.Ref), foff, cp, 0, fs);
                return cp;
            }
            TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(id.Type()));
            FieldGetInstr bfg = new FieldGetInstr(dst, new TypedReg(0, IrType.Ref), id.Name);
            if (this._ctx.ReadonlyFields.ContainsKey(id.Name)) { bfg.Readonly = true; }   // add-readonly-fields-opt
            this._ctx.Emit(bfg);
            return dst;
        }
        TypedReg ph = this._ctx.Alloc(this._ctx.ToIrType(id.Type()));
        this._ctx.Emit(new ConstNullInstr(ph));
        return ph;
    }


    // 赋值：local（copy 回写）/ 裸字段（field_set reg0）/ obj.field（field_set obj）/ arr[i]（array_set）。
    private TypedReg _emitAssign(BoundAssign a) {
        TypedReg val = this.Emit(a.Value);
        // 限定静态字段赋值 `Class.staticField = v`（LHS 绑为 BoundStaticGet）→ static_set。
        // 否则落到末尾 return val 静默丢弃 → 静态字段 mutation 不持久（Log.SetMinLevel 等）。
        // 镜像 static_get 发射（QualifyClass + "." + Field）+ __static_init__ 的 StaticSetInstr。
        if (a.Target is BoundStaticGet) {
            BoundStaticGet st = a.Target as BoundStaticGet;
            TypedReg sv = this._boxIfStaticStruct(val, st.Type());   // add-static-struct-bytecization：struct 字段整写 → 装箱盒
            this._ctx.Emit(new StaticSetInstr(this._ctx.QualifyClass(st.ClassName) + "." + st.FieldName, sv));
            return val;
        }
        if (a.Target is BoundIdent) {
            BoundIdent tid = a.Target as BoundIdent;
            if (this._ctx.Locals.ContainsKey(tid.Name)) {
                TypedReg existing = this._ctx.Locals.Get(tid.Name) as TypedReg;
                if (existing.Id != val.Id) {
                    // A-use：blob 值 struct 局部整体赋值 `b = a` → StructCopy（值语义，b/a 均已是 blob 句柄）。
                    if (this._isBlobStruct(a.Target.Type())) {
                        int scsize = this._ctx.Gen.Layouts.StructSize(this._blobStructName(a.Target.Type()));
                        this._ctx.Emit(new StructCopyInstr(existing, val, scsize));
                    } else {
                        this._ctx.Emit(new CopyInstr(existing, val));
                    }
                }
                return existing;
            }
            if (this._ctx.Fields.ContainsKey(tid.Name)) {
                // A-use：所属类是 blob 值 struct → 裸字段（`this.f`）写翻转为 StructFieldSetPrim(reg0=句柄)。
                if (this._ctx.OwnerStructName != "") {
                    // add-struct-nested-fields：裸 owner struct 字段整写（`a = p;`）→ 逐叶子复制 val 进 this@off。
                    if (this._ctx.Gen.Layouts.FieldIsStruct(this._ctx.OwnerStructName, tid.Name)) {
                        string fs = this._ctx.Gen.Layouts.FieldTypeName(this._ctx.OwnerStructName, tid.Name);
                        int foff = this._ctx.Gen.Layouts.FieldByteOffset(this._ctx.OwnerStructName, tid.Name);
                        this._copyRegion(val, 0, new TypedReg(0, IrType.Ref), foff, fs);
                        return val;
                    }
                    this._emitStructFieldSet(this._ctx.OwnerStructName, tid.Name, new TypedReg(0, IrType.Ref), val);
                    return val;
                }
                // add-struct-heap-inline (P3b)：裸内联 struct 字段整写（`pt = other`，class C 方法内）→ 逐叶子
                // 把 val(blob) 拷进 this 对象 struct_bytes@off（值语义）。裸叶子 `pt.x=v` 由 _emitBlobFieldSet 处理。
                if (this._isOwnerInlineField(tid)) {
                    string fs = this._blobStructName(tid.Type());
                    int foff = this._ctx.Gen.Layouts.InlineFieldByteOffset(this._ctx.OwnerClassName, tid.Name);
                    this._copyRegion(val, 0, new TypedReg(0, IrType.Ref), foff, fs);
                    return val;
                }
                this._ctx.Emit(new FieldSetInstr(new TypedReg(0, IrType.Ref), tid.Name, val));
                return val;
            }
            // local 首次赋值（无 init 声明 `T m;` 后 `m = rhs`）：镜像 C# WriteBackName
            // —— 分配专用寄存器 + copy（而非直接把 local 绑到 rhs 寄存器）。否则 m 复用
            // rhs 寄存器 → 比 C# 少一条 copy + 少一个寄存器（z42c.semantics MODS 实证 −14B）。
            TypedReg varReg = this._ctx.Alloc(val.Type);
            this._ctx.Locals.Put(tid.Name, varReg);
            if (varReg.Id != val.Id) { this._ctx.Emit(new CopyInstr(varReg, val)); }
            return varReg;
        }
        if (a.Target is BoundMember) {
            BoundMember tm = a.Target as BoundMember;
            // add-struct-value-semantics（nested-fields）：blob 值 struct 字段原地写（3a lvalue，含嵌套
            // line.a.x）——先于通用 this.Emit(tm.Target)，理由同 _emitMember。直接字段无 setter。
            if (this._isBlobStruct(tm.Target.Type())) {
                this._emitBlobFieldSet(tm, val);
                return val;
            }
            // add-struct-heap-inline (P3b)：写整个**内联 struct 字段**进堆对象（`c.pt = other`）→ 逐叶子把
            // val(blob) 拷进对象 struct_bytes@off（值语义）。叶子写 `c.pt.x=v` 由上面 blob-target 分支处理。
            if (this._isInlineStructFieldRoot(tm)) {
                string fs = this._blobStructName(tm.Type());
                int foff = this._inlineFieldOffset(tm);
                TypedReg objReg = this.Emit(tm.Target);
                this._copyRegion(val, 0, objReg, foff, fs);
                return val;
            }
            TypedReg obj = this.Emit(tm.Target);
            // 接口接收者：成员写定义上就是属性 setter → 恒 VCall set_X（对称 _emitMember
            // getter；接口无字段，否则落 FieldSet "X" 在实现类找不到同名字段）。
            if (tm.Target.Type() is Z42InterfaceType) {
                TypedReg ifVoid = this._ctx.Alloc(IrType.Void);
                TypedReg[] ifSet = new TypedReg[1];
                ifSet[0] = val;
                this._ctx.Emit(new VCallInstr(ifVoid, obj, "set_" + tm.MemberName, ifSet, 1));
                return val;
            }
            // auto-property setter dispatch（镜像 _emitMember getter dispatch）：
            // class 有 set_MemberName → v_call（镜像 C# SynthesizeClassAutoProp setter 路径）。
            Z42ClassType setCt = this._receiverClassType(tm.Target.Type());
            if (setCt != null && setCt.Methods.ContainsKey("set_" + tm.MemberName)) {
                TypedReg voidDst = this._ctx.Alloc(IrType.Void);
                TypedReg[] setArgs = new TypedReg[1];
                setArgs[0] = val;
                this._ctx.Emit(new VCallInstr(voidDst, obj, "set_" + tm.MemberName, setArgs, 1));
                return val;
            }
            this._ctx.Emit(new FieldSetInstr(obj, tm.MemberName, val));
            return val;
        }
        if (a.Target is BoundIndex) {
            BoundIndex ti = a.Target as BoundIndex;
            // add-struct-array-codegen (P3b follow-up)：`arr[i] = p`（value-struct 数组整元素写）→ 取元素
            // 句柄（StructRefHeap）逐叶子把 p 拷进元素字节区（值语义）。ArraySet 的 set_boxed 收不了 arena
            // StructRef 源。叶子写 `arr[i].x=v` 走上面 BoundMember 分支（_emitBlobFieldSet + 句柄根）。
            if (this._isBlobStruct(ti.Type())) {
                TypedReg h = this._emitArrayElemHandle(ti);
                string fs = this._blobStructName(ti.Type());
                this._copyRegion(val, 0, h, 0, fs);
                return val;
            }
            TypedReg arr = this.Emit(ti.Target);
            TypedReg i = this.Emit(ti.Index);
            this._ctx.Emit(new ArraySetInstr(arr, i, val));
            return val;
        }
        return val;
    }

    // obj.field 读 → field_get。
    private TypedReg _emitMember(BoundMember m) {
        // arr.Length（PS-2/SA）：C# 字节实证 = FieldGet obj, "Length"（非 ArrayLen 指令；VM 对数组特判）
        if (m.MemberName == "Length" && (m.Target.Type() is Z42ArrayType)) {
            TypedReg arr0 = this.Emit(m.Target);
            TypedReg dst0 = this._ctx.Alloc(this._ctx.ToIrType(m.Type()));
            this._ctx.Emit(new FieldGetInstr(dst0, arr0, "Length"));
            return dst0;
        }
        // add-struct-value-semantics（nested-fields）：blob 值 struct 字段读（含嵌套 line.a.x）——先于
        // 通用 this.Emit(m.Target)，否则嵌套 struct 字段（line.a 的 a）会被误当叶子递归发射
        // StructFieldGetPrim（运行时按 struct tag 解码基元 → 崩）。struct 字段无 auto-property getter。
        if (this._isBlobStruct(m.Target.Type())) {
            return this._emitBlobFieldGet(m);
        }
        // add-struct-heap-inline (P3b)：读整个**内联 struct 字段**出堆对象（`Point p = c.pt`）→ 拷进新局部
        // blob（值语义副本，非别名/非悬垂）。叶子读 `c.pt.x` 由上面的 blob-target 分支处理（含 inline 根）。
        if (this._isInlineStructFieldRoot(m)) {
            string fs = this._blobStructName(m.Type());
            int foff = this._inlineFieldOffset(m);
            TypedReg objReg = this.Emit(m.Target);
            int sz = this._ctx.Gen.Layouts.StructSize(fs);
            TypedReg cp = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
            this._copyRegion(objReg, foff, cp, 0, fs);
            return cp;
        }
        TypedReg obj = this.Emit(m.Target);
        // G18i/G19a：receiver 是 `as`-cast 到**类**（Z42ClassType/Z42InstantiatedType，跨-ns 与否
        // 均然）时，字段读结果 tag → Unknown（镜像 C#：cast-to-class 不加载目标类字段 → 字段类型
        // codegen 期 Unknown）。param/var/this（非 cast）正常 ToIrType；prim/array/iface cast 不触发。
        // G19a 更正 G18i：原 IsCrossNs 门过窄——同-ns 类 cast（Z42PrimType/Z42InstantiatedType）C#
        // 同样 Unknown（z42c.semantics·ir 实证），真因是 cast receiver 而非跨-ns。
        int ftag = this._ctx.ToIrType(m.Type());
        if (this._castUnknownChain(m.Target)) { ftag = IrType.Unknown; }
        TypedReg dst = this._ctx.Alloc(ftag);
        // 接口接收者：接口无字段，成员访问定义上就是属性 getter → 恒 VCall get_X
        // （fix-crosspkg-virtual-override 同源：接口经 vtable 派发到具体实现的 get_X；
        // 否则落下方 FieldGet "X" 在实现类找不到同名字段 → 返 Null，如 `IPipelineContext
        // ctx; ctx.Dirs` 跨 zpkg 读 PipelineContext auto-property Dirs 时崩 FieldGet null）。
        if (m.Target.Type() is Z42InterfaceType) {
            TypedReg[] ifArgs = new TypedReg[0];
            this._ctx.Emit(new VCallInstr(dst, obj, "get_" + m.MemberName, ifArgs, 0));
            return dst;
        }
        // Issue B：auto-property getter dispatch — class 有 get_MemberName → VCall（镜像 C#）
        Z42ClassType propCt = this._receiverClassType(m.Target.Type());
        if (propCt != null && propCt.Methods.ContainsKey("get_" + m.MemberName)) {
            TypedReg[] noArgs = new TypedReg[0];
            this._ctx.Emit(new VCallInstr(dst, obj, "get_" + m.MemberName, noArgs, 0));
            return dst;
        }
        FieldGetInstr fg = new FieldGetInstr(dst, obj, m.MemberName);
        // add-readonly-fields-opt：readonly 字段 → 打内存标志，供 CSE/LICM。本地字段 FieldSymbol 有 IsReadonly；
        // 导入字段 v1 保守为 false（不跨包）。propCt 为 null（非类接收者）时保持 false。
        if (propCt != null && propCt.Fields.ContainsKey(m.MemberName)) {
            FieldSymbol rfs = propCt.Fields.Get(m.MemberName) as FieldSymbol;
            if (rfs != null) { fg.Readonly = rfs.IsReadonly; }
        }
        this._ctx.Emit(fg);
        return dst;
    }

    // receiver 若为 class 类型返回其 Z42ClassType，用于属性 getter 分派判断。
    internal Z42ClassType _receiverClassType(Z42Type t) {
        if (t is Z42ClassType) { return t as Z42ClassType; }
        if (t is Z42InstantiatedType) { return (t as Z42InstantiatedType).Def; }
        return null;
    }

    // ── add-struct-value-semantics A-use：blob 值 struct 字段 access 翻转助手 ────────────
    // 某静态类型是否 blob 值 struct（多叶子复合，翻转到字节 blob 值语义）。
    internal bool _isBlobStruct(Z42Type t) {
        Z42ClassType ct = this._receiverClassType(t);
        if (ct == null) { return false; }
        return this._ctx.Gen.Layouts != null && this._ctx.Gen.Layouts.IsBlobStruct(ct.Name());
    }
    // blob struct 短名（调用方已确认 _isBlobStruct）。
    internal string _blobStructName(Z42Type t) { return this._receiverClassType(t).Name(); }
    // blob 字段 lvalue 直写：base=blob 句柄，off/tag 由 StructLayout 烘焙（tag=运行期 TypeTag，
    // Tag.FromName(字段声明类型名)——ref 类字段(string/object/array)得 Object/Str 标签，运行时按 ref 叶子路由）。
    private void _emitStructFieldSet(string structName, string fieldName, TypedReg base_, TypedReg val) {
        int off = this._ctx.Gen.Layouts.FieldByteOffset(structName, fieldName);
        int tag = Tag.FromName(this._ctx.Gen.Layouts.FieldTypeName(structName, fieldName));
        this._ctx.Emit(new StructFieldSetPrimInstr(base_, off, tag, val));
    }
    // blob 字段读 → 收值寄存器（dstTag=字段结果 IrType 标签）。
    private TypedReg _emitStructFieldGet(string structName, string fieldName, TypedReg base_, int dstTag) {
        int off = this._ctx.Gen.Layouts.FieldByteOffset(structName, fieldName);
        int tag = Tag.FromName(this._ctx.Gen.Layouts.FieldTypeName(structName, fieldName));
        TypedReg dst = this._ctx.Alloc(dstTag);
        this._ctx.Emit(new StructFieldGetPrimInstr(dst, base_, off, tag));
        return dst;
    }

    // ── add-struct-nested-fields：嵌套 struct 字段读写（沿成员链累积 byte offset） ──────────
    // blob 值 struct 字段读（含嵌套 line.a.x）：叶子 → 单条累积-offset StructFieldGetPrim；字段本身是
    // struct（P p = line.a）→ 分配新 blob 逐叶子复制出（值副本，非别名）。
    private TypedReg _emitBlobFieldGet(BoundMember m) {
        string cont = this._blobStructName(m.Target.Type());
        TypedReg base_ = this._structChainRoot(m.Target);
        int off = this._structChainOffset(m.Target) + this._ctx.Gen.Layouts.FieldByteOffset(cont, m.MemberName);
        if (this._ctx.Gen.Layouts.FieldIsStruct(cont, m.MemberName)) {
            string fs = this._ctx.Gen.Layouts.FieldTypeName(cont, m.MemberName);
            int sz = this._ctx.Gen.Layouts.StructSize(fs);
            TypedReg cp = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
            this._copyRegion(base_, off, cp, 0, fs);
            return cp;
        }
        int tag = Tag.FromName(this._ctx.Gen.Layouts.FieldTypeName(cont, m.MemberName));
        TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(m.Type()));
        this._ctx.Emit(new StructFieldGetPrimInstr(dst, base_, off, tag));
        return dst;
    }

    // blob 值 struct 字段原地写（含嵌套 line.a.x=3）：叶子 → 单条累积-offset StructFieldSetPrim；字段本身
    // 是 struct（line.a = p）→ 逐叶子把 val(P blob) 复制进 base_@off。
    private void _emitBlobFieldSet(BoundMember tm, TypedReg val) {
        string cont = this._blobStructName(tm.Target.Type());
        TypedReg base_ = this._structChainRoot(tm.Target);
        int off = this._structChainOffset(tm.Target) + this._ctx.Gen.Layouts.FieldByteOffset(cont, tm.MemberName);
        if (this._ctx.Gen.Layouts.FieldIsStruct(cont, tm.MemberName)) {
            string fs = this._ctx.Gen.Layouts.FieldTypeName(cont, tm.MemberName);
            this._copyRegion(val, 0, base_, off, fs);
            return;
        }
        int tag = Tag.FromName(this._ctx.Gen.Layouts.FieldTypeName(cont, tm.MemberName));
        this._ctx.Emit(new StructFieldSetPrimInstr(base_, off, tag, val));
    }

    // add-static-struct-bytecization (PR-2 S)：发 StaticGet 取**原始存储值**（static struct 字段 = 装箱盒
    // 句柄，不拆箱）。供 Emit 整读（外层再 AsCast 拆箱）与 `_structChainRoot` 叶子根（直接用盒句柄就地读写）复用。
    private TypedReg _emitStaticGetRaw(BoundStaticGet sg) {
        // StaticGet 结果寄存器 = Unknown（C# REGT 字节实证：静态字段读 IR 层擦除）。
        // G17b：用 QualifyClass（非 Qualify）→ 同包跨-ns 类静态字段限定到声明 ns。
        TypedReg dst = this._ctx.Alloc(IrType.Unknown);
        this._ctx.Emit(new StaticGetInstr(dst, this._ctx.QualifyClass(sg.ClassName) + "." + sg.FieldName));
        return dst;
    }

    // add-static-struct-bytecization (PR-2 S)：整写 static struct 字段前 `__box_struct` 全局化——把帧 arena
    // blob 拷到堆装箱盒（进程存活，无悬垂），存的是盒句柄。非 struct 字段原样返回（int/string/引用照旧）。
    private TypedReg _boxIfStaticStruct(TypedReg val, Z42Type fieldType) {
        if (!this._isBlobStruct(fieldType)) { return val; }
        TypedReg[] bargs = new TypedReg[1]; bargs[0] = val;
        TypedReg bdst = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new BuiltinInstr(bdst, "__box_struct", bargs, 1));
        return bdst;
    }

    // 嵌套字段链的根 blob 句柄：沿链下降到根 lvalue，只 Emit 根一次。根 = 局部 ident / 返回 struct 的调用……
    // 或**拥有者 struct 的裸字段**（`a.x` 即 `this.a.x`，此时根 blob = this 句柄 reg0，偏移见 _structChainOffset）。
    private TypedReg _structChainRoot(BoundExpr e) {
        if (e is BoundMember) {
            BoundMember m = e as BoundMember;
            if (this._isBlobStruct(m.Target.Type())) { return this._structChainRoot(m.Target); }
            // add-struct-heap-inline (P3b)：内联 struct 字段根 = 堆对象句柄（Value::Object）；
            // 后续叶子 offset 由 _structChainOffset 累积（对象相对复合 offset 烘焙进 StructFieldGet/SetPrim）。
            if (this._isInlineStructFieldRoot(e)) { return this.Emit(m.Target); }
        }
        // add-static-struct-bytecization (PR-2 S)：static struct 字段作叶子链根（`Holder.P.X`）→ 根 blob =
        // 装箱盒句柄（BoxedStruct，就地读写，引用身份）。**不拆箱**（拆箱会拷贝出副本 → 叶子写丢失）；
        // 叶子 offset 由 _structChainOffset 从 struct 布局累积（FieldByteOffset，struct 相对）。
        if (e is BoundStaticGet && this._isBlobStruct(e.Type())) { return this._emitStaticGetRaw(e as BoundStaticGet); }
        if (this._isOwnerStructField(e)) { return new TypedReg(0, IrType.Ref); }
        // add-struct-heap-inline (P3b)：裸内联字段 `pt`（class C 方法内）根 = this 对象句柄 reg0。
        if (this._isOwnerInlineField(e)) { return new TypedReg(0, IrType.Ref); }
        // add-struct-array-codegen (P3b follow-up)：`arr[i]`（value-struct 数组元素）链根 = 元素**句柄**
        // （StructRefHeap，ArrayGet 直发不拷贝）——供 `arr[i].x` 原地叶子读写；offset 0（元素起点，_structChainOffset 默认返 0）。
        if (e is BoundIndex && this._isBlobStruct(e.Type())) { return this._emitArrayElemHandle(e as BoundIndex); }
        return this.Emit(e);
    }

    // 表达式在其根 blob 内的累积 byte offset（纯 layout 查表，零 codegen——故与 _structChainRoot 两遍不重复发射）。
    private int _structChainOffset(BoundExpr e) {
        if (e is BoundMember) {
            BoundMember m = e as BoundMember;
            if (this._isBlobStruct(m.Target.Type())) {
                int parent = this._structChainOffset(m.Target);
                return parent + this._ctx.Gen.Layouts.FieldByteOffset(this._blobStructName(m.Target.Type()), m.MemberName);
            }
            // add-struct-heap-inline (P3b)：内联 struct 字段根的对象相对起始 offset（纯查表，不 Emit）。
            if (this._isInlineStructFieldRoot(e)) { return this._inlineFieldOffset(m); }
        }
        if (this._isOwnerStructField(e)) {
            BoundIdent id = e as BoundIdent;
            return this._ctx.Gen.Layouts.FieldByteOffset(this._ctx.OwnerStructName, id.Name);
        }
        // add-struct-heap-inline (P3b)：裸内联字段 `pt` 的对象相对起始 offset。
        if (this._isOwnerInlineField(e)) {
            BoundIdent id = e as BoundIdent;
            return this._ctx.Gen.Layouts.InlineFieldByteOffset(this._ctx.OwnerClassName, id.Name);
        }
        return 0;
    }

    // ── add-struct-heap-inline (P3b)：堆对象的**内联 struct 字段**（`class C{ Point pt; }` 的 `c.pt`）──────
    // e 是否 = 「堆对象/class 的内联 struct 字段访问」——即字段声明类型是 blob struct，但**容器不是** blob
    // struct（是 class/堆对象）。此时该 struct 内联在对象 struct_bytes 里，根 blob = 对象句柄（Value::Object），
    // 对象相对 offset = InlineFieldByteOffset。区别于容器-是-struct 的嵌套链（那走 _isBlobStruct 递归）。
    private bool _isInlineStructFieldRoot(BoundExpr e) {
        if (!(e is BoundMember)) { return false; }
        BoundMember m = e as BoundMember;
        if (!this._isBlobStruct(m.Type())) { return false; }          // 字段类型须是 blob struct
        if (this._isBlobStruct(m.Target.Type())) { return false; }    // 容器是 struct → 归嵌套链，非本例
        Z42ClassType oc = this._receiverClassType(m.Target.Type());
        if (oc == null) { return false; }                            // 容器须是 class（堆对象）
        if (this._ctx.Gen.Layouts == null) { return false; }
        return this._ctx.Gen.Layouts.InlineFieldByteOffset(oc.Name(), m.MemberName) >= 0;
    }

    // 内联 struct 字段的对象相对 byte offset（调用方已确认 _isInlineStructFieldRoot）。
    private int _inlineFieldOffset(BoundMember m) {
        Z42ClassType oc = this._receiverClassType(m.Target.Type());
        return this._ctx.Gen.Layouts.InlineFieldByteOffset(oc.Name(), m.MemberName);
    }

    // e 是否 = 所属**非-struct class** 的裸内联 struct 字段引用（`pt` 即 `this.pt`，class C 的方法内）——
    // 其根 blob = this 对象句柄 reg0，对象相对 offset = InlineFieldByteOffset(OwnerClassName, name)。
    // 未被局部/const 遮蔽且确为字段。struct owner 走 OwnerStructName 路径（其字段无内联，此处 -1 自然排除）。
    private bool _isOwnerInlineField(BoundExpr e) {
        if (!(e is BoundIdent)) { return false; }
        if (this._ctx.OwnerClassName == "") { return false; }
        BoundIdent id = e as BoundIdent;
        if (this._ctx.Locals.ContainsKey(id.Name)) { return false; }
        if (this._ctx.ConstLocals.ContainsKey(id.Name)) { return false; }
        if (!this._ctx.Fields.ContainsKey(id.Name)) { return false; }
        if (this._ctx.Gen.Layouts == null) { return false; }
        return this._ctx.Gen.Layouts.InlineFieldByteOffset(this._ctx.OwnerClassName, id.Name) >= 0;
    }

    // e 是否**拥有者 blob struct 的裸字段引用**（`a` 即 `this.a`，非被局部/const 遮蔽）——其根 blob = this(reg0)。
    private bool _isOwnerStructField(BoundExpr e) {
        if (!(e is BoundIdent)) { return false; }
        if (this._ctx.OwnerStructName == "") { return false; }
        BoundIdent id = e as BoundIdent;
        if (this._ctx.Locals.ContainsKey(id.Name)) { return false; }
        if (this._ctx.ConstLocals.ContainsKey(id.Name)) { return false; }
        return this._ctx.Fields.ContainsKey(id.Name);
    }

    // 整个 struct 区间逐叶子复制（复用现有 Get/SetPrim，无区间指令）：嵌套 struct 子字段递归，基元/引用叶子
    // 一读一写。src/dst 为 blob 句柄，srcOff/dstOff 为其内区间起点。
    private void _copyRegion(TypedReg srcBase, int srcOff, TypedReg dstBase, int dstOff, string structName) {
        StructLayoutInfo li = this._ctx.Gen.Layouts.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) {
            int fo = li.FieldOffsets[i];
            if (li.FieldKinds[i] == StructLeafKind.Struct) {
                this._copyRegion(srcBase, srcOff + fo, dstBase, dstOff + fo, li.FieldTypeNames[i]);
            } else {
                int tag = Tag.FromName(li.FieldTypeNames[i]);
                TypedReg tmp = this._ctx.Alloc(this._tagToIrType(tag));
                this._ctx.Emit(new StructFieldGetPrimInstr(tmp, srcBase, srcOff + fo, tag));
                this._ctx.Emit(new StructFieldSetPrimInstr(dstBase, dstOff + fo, tag, tmp));
            }
            i = i + 1;
        }
    }

    // zbc tag → IrType（供 _copyRegion 临时寄存器类型；ref 类 Str/Object/Array → Ref）。
    private int _tagToIrType(int tag) {
        if (tag == Tag.Bool) { return IrType.Bool; }
        if (tag == Tag.I8)  { return IrType.I8; }
        if (tag == Tag.I16) { return IrType.I16; }
        if (tag == Tag.I32) { return IrType.I32; }
        if (tag == Tag.I64) { return IrType.I64; }
        if (tag == Tag.U8)  { return IrType.U8; }
        if (tag == Tag.U16) { return IrType.U16; }
        if (tag == Tag.U32) { return IrType.U32; }
        if (tag == Tag.U64) { return IrType.U64; }
        if (tag == Tag.F32) { return IrType.F32; }
        if (tag == Tag.F64) { return IrType.F64; }
        if (tag == Tag.Char) { return IrType.Char; }
        if (tag == Tag.Str) { return IrType.Str; }
        return IrType.Ref;
    }

    // ── add-struct-value-equality：blob 值 struct 的 == / != → 逐叶子值相等短路合取 ──────────
    // 操作数各求值一次（a/c 为 blob 句柄），递归展平叶子逐个 Eq；首个不等即短路到 fail 块。
    // wantEqual=true → `==`（全叶子相等 → true）；false → `!=`（全等 → false）。结果 result-reg 在
    // 「全等」与「fail」两分支各写 ConstBool，end 块读汇合（镜像 _emitConditional 三目范式）。
    internal TypedReg _emitStructEquality(bool wantEqual, TypedReg a, TypedReg c, string structName) {
        TypedReg result = this._ctx.Alloc(IrType.Bool);
        string failL = this._ctx.Fresh("seq_ne");
        string endL = this._ctx.Fresh("seq_end");
        this._emitLeafEqChecks(a, c, 0, structName, failL);
        // 全部叶子相等（fall-through）
        this._ctx.Emit(new ConstBoolInstr(result, wantEqual));
        this._ctx.EndBlock(new BrTerm(endL));
        // 任一叶子不等
        this._ctx.StartBlock(failL);
        this._ctx.Emit(new ConstBoolInstr(result, !wantEqual));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(endL);
        return result;
    }

    // 递归枚举 structName 的展平叶子（镜像 _copyRegion）：嵌套 struct 字段递归累积 offset；基元/引用
    // 叶子读 a/c 两侧值（现有 StructFieldGetPrim）+ 现有 Eq + BrCond 短路到 failL（真→下一叶子块）。
    private void _emitLeafEqChecks(TypedReg a, TypedReg c, int off, string structName, string failL) {
        StructLayoutInfo li = this._ctx.Gen.Layouts.LayoutOf(structName);
        int i = 0;
        while (i < li.FieldCount) {
            int fo = li.FieldOffsets[i];
            if (li.FieldKinds[i] == StructLeafKind.Struct) {
                this._emitLeafEqChecks(a, c, off + fo, li.FieldTypeNames[i], failL);
            } else {
                int tag = Tag.FromName(li.FieldTypeNames[i]);
                int irt = this._tagToIrType(tag);
                TypedReg la = this._ctx.Alloc(irt);
                TypedReg lc = this._ctx.Alloc(irt);
                this._ctx.Emit(new StructFieldGetPrimInstr(la, a, off + fo, tag));
                this._ctx.Emit(new StructFieldGetPrimInstr(lc, c, off + fo, tag));
                TypedReg cmp = this._ctx.Alloc(IrType.Bool);
                this._ctx.Emit(new EqInstr(cmp, la, lc));
                string contL = this._ctx.Fresh("seq_cont");
                this._ctx.EndBlock(new BrCondTerm(cmp, contL, failL));
                this._ctx.StartBlock(contL);
            }
            i = i + 1;
        }
    }

    // ── add-struct-object-methods (PR2b)：合成 Equals(object) body 的结果表达式 ──────────────
    // `(other is P) ? leafEq((P)this, (P)other) : false`。this/other 均为 boxed（vcall 臂传 boxed 值、
    // 或 static Call 传 boxed）→ 内部 AsCast 拆箱到 **callee 帧** arena StructRef（避开 JIT 帧无 frame_id），
    // 再复用 PR1 `_emitStructEquality` 逐叶子比较。result-reg 在两分支汇合（镜像三目）。
    public TypedReg EmitSynthEqualsResult(string structName, TypedReg thisReg, TypedReg otherReg) {
        string fq = this._ctx.QualifyClass(structName);
        TypedReg result = this._ctx.Alloc(IrType.Bool);
        TypedReg isP = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new IsInstanceInstr(isP, otherReg, fq));
        string doL = this._ctx.Fresh("seq_eq_do");
        string elseL = this._ctx.Fresh("seq_eq_no");
        string endL = this._ctx.Fresh("seq_eq_end");
        this._ctx.EndBlock(new BrCondTerm(isP, doL, elseL));
        this._ctx.StartBlock(doL);
        TypedReg a = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new AsCastInstr(a, thisReg, fq));    // 拆 this → StructRef
        TypedReg b = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new AsCastInstr(b, otherReg, fq));   // 拆 other → StructRef
        TypedReg eq = this._emitStructEquality(true, a, b, structName);
        this._ctx.Emit(new CopyInstr(result, eq));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(elseL);
        this._ctx.Emit(new ConstBoolInstr(result, false));
        this._ctx.EndBlock(new BrTerm(endL));
        this._ctx.StartBlock(endL);
        return result;
    }

    // arr[i] 读 → array_get（元素类型）。
    private TypedReg _emitIndex(BoundIndex idx) {
        // add-struct-array-codegen (P3b follow-up): standalone `arr[i]` for a **value-struct
        // array** → ArrayGet yields a `StructRefHeap` element handle; copy it out to a fresh
        // local blob (value semantics: the read is an independent snapshot, not an alias into
        // the array). Leaf access `arr[i].x` instead roots the chain at the handle (see
        // `_structChainRoot`), so it reads/writes in place.
        if (this._isBlobStruct(idx.Type())) {
            TypedReg h = this._emitArrayElemHandle(idx);
            string fs = this._blobStructName(idx.Type());
            int sz = this._ctx.Gen.Layouts.StructSize(fs);
            TypedReg cp = this._ctx.Alloc(IrType.Ref);
            this._ctx.Emit(new StructAllocInstr(cp, this._ctx.QualifyClass(fs), sz));
            this._copyRegion(h, 0, cp, 0, fs);
            return cp;
        }
        TypedReg arr = this.Emit(idx.Target);
        TypedReg i = this.Emit(idx.Index);
        TypedReg dst = this._ctx.Alloc(this._ctx.ToIrType(idx.Type()));
        this._ctx.Emit(new ArrayGetInstr(dst, arr, i));
        return dst;
    }

    // add-struct-array-codegen (P3b follow-up): emit `arr[i]` producing the **element
    // handle** (`StructRefHeap`, via ArrayGet on a value-struct array) with no copy. Used as
    // a struct chain root (`arr[i].x` in-place) + by `_emitIndex`'s copy-out + `arr[i] = p`.
    private TypedReg _emitArrayElemHandle(BoundIndex idx) {
        TypedReg arr = this.Emit(idx.Target);
        TypedReg i = this.Emit(idx.Index);
        TypedReg h = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new ArrayGetInstr(h, arr, i));
        return h;
    }


    // FQ 运行期类型名：prim→裸名 / array→elem[] / class·iface→QualifyClass /
    // instantiated→QualifyClass(def)（args 另发）/ generic-param→裸名（镜像 C# Z42TypeName）。
    // unify-value-types Phase 1：翻转后数组元素若为内建 Z42ClassType（int[]→elem Z42ClassType(Int32)），
    // 元素名不走 QualifyClass（否则 "int"→"Std.Int32" 破 byte-identical）——与历史 Z42PrimType 元素同款
    // 保留源短名（an.ElemName）。翻转前无内建名 Z42ClassType 元素 → 当前中立。
    private bool _isBuiltinValueElem(Z42Type elem) {
        return (elem is Z42ClassType) && PrimModel.IsBuiltin(elem.Name());
    }

    internal string _typeofName(Z42Type t) {
        if (t is Z42ArrayType) { return this._typeofName((t as Z42ArrayType).Elem) + "[]"; }
        // unify-value-types Phase 1：翻转后内建（int→Z42ClassType(Int32)）的 typeof 名须回到历史
        // Z42PrimType 拼写（PrimModel.Keyword: Int32→"int"），而非 QualifyClass 的 FQ "Std.Int32"。
        if ((t is Z42ClassType) && PrimModel.IsBuiltin(t.Name())) { return PrimModel.Keyword(t.Name()); }
        if (t is Z42ClassType) { return this._ctx.QualifyClass(t.Name()); }
        if (t is Z42InterfaceType) { return this._ctx.QualifyClass(t.Name()); }
        if (t is Z42InstantiatedType) { return this._ctx.QualifyClass((t as Z42InstantiatedType).Def.Name()); }
        return t.Name();
    }

    // typeof 实参侧 FQ 名（add-reflection-nested-generic-args）：构造泛型实参递归产**带尖括号**
    // 的完整名 `Box<Pair<int,string>>`，让 runtime `make_type_from_name` 解析尖括号 → 嵌套构造
    // Type（其 GetGenericArguments 再递归）。此前 instantiated 实参被 `_typeofName` 压成裸定义名
    // `"Pair"`、内层 args 丢失。顶层与嵌套实参同款递归；非泛型实参复用 `_typeofName` 叶子名。
    // 无 zbc/zpkg 格式改动（TypeofInstr 仍携 string[]，仅实参串内容带括号）。
    internal string _typeofArgName(Z42Type t) {
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it = t as Z42InstantiatedType;
            string s = this._ctx.QualifyClass(it.Def.Name()) + "<";
            int k = 0;
            while (k < it.ArgCount) { if (k > 0) { s = s + ","; } s = s + this._typeofArgName(it.TypeArgs[k]); k = k + 1; }
            return s + ">";
        }
        return this._typeofName(t);
    }


    // cast 目标是否为类（Z42ClassType / Z42InstantiatedType）——field.get / instance-call 在
    // cast-to-class receiver 上结果 tag → Unknown 的门（G19a；prim/array/iface cast 不触发）。
    private static bool _isClassCast(Z42Type t) {
        return (t is Z42ClassType) || (t is Z42InstantiatedType);
    }

    // receiver 表达式是否处于 cast-to-class 的「Unknown 链」上（镜像 C#：cast-to-class 的
    // field/method 结果语义类型 Unknown，链式 `(x as T).f.Name()` 整条 Unknown）。结构化沿
    // member.Target / call.Receiver 递归——只穿 cast→field→call 链，不误判同 REGT-Unknown 的
    // 无关寄存器（REGT-tag 传播曾过度匹配 522 处）。BoundIdent/param/this 等非链节点 → false。
    internal bool _castUnknownChain(BoundExpr e) {
        if ((e is BoundCast) && ExprEmitter._isClassCast(e.Type())) { return true; }
        if (e is BoundMember) { return this._castUnknownChain((e as BoundMember).Target); }
        if (e is BoundCall) {
            BoundCall bc = e as BoundCall;
            if (bc.Receiver != null) { return this._castUnknownChain(bc.Receiver); }
        }
        return false;
    }
}
