// OptSet —— 可独立开关的具名编译期优化集（add-compiler-inlining）。
// 受限写法：static class + int 常量（同 TokenKind / DiagnosticCodes 模式，无 enum/const）。
//
// 用户自助勾选任意优化子集（不是"高档含低档"的单调档位）。每个优化 pass 必须**自洽、
// 不依赖其它 pass 才正确**（design D2）——OptSet 只决定"开哪些"，IrOptPipeline 按固定
// 稳妥顺序跑被勾选的那些。
//
// 注：代数恒等式（x+0→copy 等）在 IrOptInfo.TryConstFold 内，与常量折叠同属 ConstFold
// 一个开关；如需更细粒度，未来拆 TryConstFold 再加一位。
namespace Z42.Semantics;

public static class Opt {
    public static int None      = 0;
    public static int ConstFold = 1;    // bit0：常量折叠 + 代数恒等式
    public static int CopyProp  = 2;    // bit1：拷回冗余消除 + use-site 级联
    public static int Dce       = 4;    // bit2：纯指令死代码删除
    public static int Inline    = 8;    // bit3：函数内联
    public static int Cse       = 16;   // bit4：公共子表达式消除
    public static int Licm      = 32;   // bit5：循环不变量外提（defInLoop 用 header 支配域 → 含异常/多出口退出块，
                                        //        修复复杂 CFG miscompile 后入 All，见 add-licm-pass）
    public static int StackAlloc = 64;  // bit6：逃逸分析栈上分配（不逃逸 ObjNew/ArrayNew/ArrayNewLit → 帧 arena，
                                        //        interp 消费、绕过 GC；add-escape-analysis-stack-alloc）
    public static int LoopAllocReuse = 128; // bit7：循环内分配 hoist + 对象复用（迭代内可复用 ObjNew/ArrayNew →
                                        //        pre-header 只分配一次 + 循环体重初始化；add-loop-alloc-hoist-reuse）
    public static int ReadonlyLoad = 256; // bit8：readonly 字段读优化（同接收者 readonly FieldGet 块内 CSE 消重 +
                                        //        接收者=this 的读 LICM 外提循环；add-readonly-fields-opt）
    public static int PureCall  = 512;  // bit9：纯函数调用优化（自动推断纯度：同 callee+参数纯调用 CSE 消重 +
                                        //        循环不变纯调用 LICM 外提；add-pure-call-opt）
    public static int DeadBranch = 1024; // bit10：常量条件死分支消除（br.cond(常量 bool)→br 折叠 + ExcCount==0 时
                                        //        可达性移除死块；喂料来自 const 替换 / const-fold；add-const-keyword）
    public static int Devirt    = 2048; // bit11：基于 sealed 的去虚化（receiver 静态类型是本地非泛型 sealed 类 →
                                        //        VCall 降级为直接 Call，解锁 IrInline 内联；emit 时就地，add-sealed-devirt）
    public static int All       = 4095; // ...|DeadBranch|Devirt

    // (set & opt) != 0 —— 某优化是否启用。
    public static bool Has(int set, int opt) {
        return (set & opt) != 0;
    }

    // 优化名 → 位；未知名返回 -1（调用方据此报错，不静默忽略）。
    public static int ByName(string name) {
        if (name == "const-fold") { return Opt.ConstFold; }
        if (name == "copy-prop")  { return Opt.CopyProp; }
        if (name == "dce")        { return Opt.Dce; }
        if (name == "inline")     { return Opt.Inline; }
        if (name == "cse")        { return Opt.Cse; }
        if (name == "licm")       { return Opt.Licm; }
        if (name == "stack-alloc"){ return Opt.StackAlloc; }
        if (name == "loop-alloc-reuse") { return Opt.LoopAllocReuse; }
        if (name == "readonly-load") { return Opt.ReadonlyLoad; }
        if (name == "pure-call")  { return Opt.PureCall; }
        if (name == "dead-branch"){ return Opt.DeadBranch; }
        if (name == "devirt")     { return Opt.Devirt; }
        if (name == "all")        { return Opt.All; }
        if (name == "none")       { return Opt.None; }
        return -1;
    }

    // profile 默认：release = 全开，debug = 全关（-O0，忠实可调试；User 裁决 B）。
    public static int ProfileDefault(bool isRelease) {
        if (isRelease) { return Opt.All; }
        return Opt.None;
    }

    // 解析：以 profile 默认为基，先按 toml 覆盖，再按 CLI 加/减（CLI > toml > profile）。
    // tomlBits/tomlMask：toml [optimize] 逐项——mask 标记"该项在 toml 里显式写了"，
    //   bits 是其值；未写的项保持 profile 默认。cliAdd/cliRemove：CLI --opt/--no-opt 累积位。
    public static int Resolve(bool isRelease, int tomlBits, int tomlMask, int cliAdd, int cliRemove) {
        int set = Opt.ProfileDefault(isRelease);
        // toml：仅覆盖显式写了的位
        set = (set & (Opt.All - tomlMask)) | (tomlBits & tomlMask);
        // CLI：先加后减
        set = set | cliAdd;
        set = set & (Opt.All - cliRemove);
        return set;
    }

    // wire-optimize-manifest：把 manifest `[optimize]` 的**中性 name/value 对**折成
    // `Resolve` 要的 (bits, mask) —— 解释权在消费方（`z42.project` 只搬运，不认识 Opt 位）。
    //
    // ⚠️ 这个函数此前**不存在**，于是 `Resolve` 的 `tomlBits`/`tomlMask` 两个形参从来没人填：
    // `BuildCommand` 调的是 `Opt.Resolve(isRelease, 0, 0, cliAdd, cliRemove)`。结果是
    // **`z42.toml` 的 `[optimize]` 段被静默忽略** —— 写 `inline = false` 照样内联，零诊断。
    // 实测（字节对账 + 阳性对照）：`inline=true` 与 `inline=false` 编出的 zpkg **逐字节相同**，
    // 而同一份源用 CLI `--no-opt inline` 字节不同 ⇒ 对账有判别力、toml 那条是死的。
    // `ProjectManifest.z42` 的注释当时却写着「消费方按名映射到 Opt 位…交 Opt.Resolve」。
    //
    // 未知名**不静默忽略**（`ByName` 的注释就是这么要求的）：记进 `Unknown`，由调用方报错。
    // 与 CLI 侧 `--opt 乱写` 报错（`BuildCommand._unknownOpt`）同一口径 —— 同一个名字表，
    // 两条入口不该一个报错一个装没看见。
    public static OptTomlResult FromToml(string[] names, bool[] values, int count) {
        var r = new OptTomlResult();
        if (names == null || values == null || count <= 0) { return r; }
        string[] unk = new string[count];
        int un = 0;
        int i = 0;
        while (i < count) {
            int b = Opt.ByName(names[i]);
            if (b < 0) { unk[un] = names[i]; un = un + 1; }
            else {
                r.Mask = r.Mask | b;                      // 「该项在 toml 里显式写了」
                if (values[i]) { r.Bits = r.Bits | b; }   // 值为 true 才置位
            }
            i = i + 1;
        }
        r.Unknown = unk; r.UnknownCount = un;
        return r;
    }
}

// `Opt.FromToml` 的产物。独立类而非 out 形参：z42 的 `ref`/`out` 当前是**静默失败特性**
// （见 add-ref-borrow-system），不能用在新代码里。
public sealed class OptTomlResult {
    public int      Bits;            // 显式写了且值为 true 的位
    public int      Mask;            // 显式写了的位（无论真假）——未写的位保持 profile 默认
    public string[] Unknown;         // `[optimize]` 里不认识的名字（调用方报错用）
    public int      UnknownCount;
    public OptTomlResult() { this.Bits = 0; this.Mask = 0; this.Unknown = new string[0]; this.UnknownCount = 0; }
}
