// 模式绑定器（Rust 风格模式匹配核心 A1）。把 syntax Pattern 绑定成 BoundPattern：
// 类型解析、裸名歧义消解（类型 vs 常量 vs 绑定，见 design Decision 2）、record 位置解构校验
// （IsRecord + arity）、字段类型递归、绑定变量注册进 TypeEnv。三位点（switch/is）共用。
// 持 TypeChecker 反向引用 _tc：_tc._expr._bindExpr（常量子表达式）、_tc._chkTypeRef（类型引用检查）、_tc._diags。
namespace Z42.Semantics;

using Z42.IR;
using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;

public sealed class PatternBinder {
    private TypeChecker _tc;
    public PatternBinder(TypeChecker tc) { this._tc = tc; }

    // 绑定一个模式：subjType=被匹配值的静态类型（用于裸绑定变量类型 / 子模式字段类型来源）。
    internal BoundPattern Bind(Pattern pat, Z42Type subjType, TypeEnv env) {
        if (pat is WildcardPattern) { return new BoundWildcardPattern(pat.Span); }
        if (pat is ConstantPattern) {
            ConstantPattern cp = pat as ConstantPattern;
            BoundExpr v = this._tc._expr._bindExpr(cp.Value, env);
            return new BoundConstantPattern(v, pat.Span);
        }
        if (pat is NamePattern)       { return this._bindName(pat as NamePattern, subjType, env); }
        if (pat is PositionalPattern) { return this._bindPositional(pat as PositionalPattern, subjType, env); }
        if (pat is PropertyPattern)   { return this._bindProperty(pat as PropertyPattern, subjType, env); }
        if (pat is OrPattern)         { return this._bindOr(pat as OrPattern, subjType, env); }
        if (pat is AtPattern)         { return this._bindAt(pat as AtPattern, subjType, env); }
        if (pat is RangePattern)      { return this._bindRange(pat as RangePattern, subjType, env); }
        if (pat is RelationalPattern) { return this._bindRelational(pat as RelationalPattern, subjType, env); }
        this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "unsupported pattern", pat.Span);
        return new BoundWildcardPattern(pat.Span);
    }

    // 解构声明（模式匹配 B）不可失败校验：结构仅允许 通配 / 裸绑定 / 嵌套位置模式；且每个位置模式的期望类型
    // （顶层=init 静态类型，嵌套=父 record 字段类型）须与模式类型**精确一致**（IsInstance 恒真）→ 无失败分支。
    // 含常量 / or / 范围 / 关系 / 类型测试子模式，或类型不匹配 → 报错（该声明本可运行时失败）。
    internal void CheckIrrefutable(BoundPattern bp, Z42Type expected, Span sp) {
        if (bp is BoundWildcardPattern) { return; }
        if (bp is BoundBindingPattern) { return; }
        if (bp is BoundPositionalPattern) {
            BoundPositionalPattern pp = bp as BoundPositionalPattern;
            if (expected.Name() != pp.Type.Name()) {
                this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "destructuring declaration requires the value's static type to match the pattern exactly: " + expected.Name() + " vs " + pp.TypeName, sp);
            }
            int i = 0;
            while (i < pp.ElemCount) { this.CheckIrrefutable(pp.Elems[i], pp.FieldTypes[i], sp); i = i + 1; }
            return;
        }
        if (bp is BoundPropertyPattern) {
            BoundPropertyPattern qp = bp as BoundPropertyPattern;
            // 带类型时须与 subject 静态类型精确一致（IsInstance 恒真，无失败分支）；省类型时 type=subject 恒真。
            if (qp.HasType && expected.Name() != qp.Type.Name()) {
                this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "destructuring declaration requires the value's static type to match the pattern exactly: " + expected.Name() + " vs " + qp.TypeName, sp);
            }
            // 属性形态天然允许部分字段（未列字段不解构、不失败）；逐列字段子模式须仍不可失败。
            int j = 0;
            while (j < qp.FieldCount) { this.CheckIrrefutable(qp.Pats[j], qp.FieldTypes[j], sp); j = j + 1; }
            return;
        }
        this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "destructuring declaration pattern must be irrefutable: only wildcards, bindings, and nested record patterns are allowed (no constants, ranges, relational, type tests, or or-patterns)", sp);
    }

    // or-模式（A2 起；A3 补带绑定）：逐 alt 绑定（同一 subjType）。每个 alt 绑进独立子作用域，收集其
    // 绑定集（名字 → 类型），校验各 alt 绑定集**完全一致**（同名同类型，User 裁决 A3）；不一致 → 报错。
    // 统一后的绑定集一次性注册进真实 env（供守卫 / arm body 类型检查），并存入 BoundOrPattern 供 emit 合流。
    private BoundPattern _bindOr(OrPattern op, Z42Type subjType, TypeEnv env) {
        BoundPattern[] alts = new BoundPattern[op.Count];
        string[]  refNames = new string[0];
        Z42Type[] refTypes = new Z42Type[0];
        int       refCount = 0;
        int i = 0;
        while (i < op.Count) {
            TypeEnv child = env.PushScope();          // alt 绑定落 child.Vars，不污染 env / 兄弟 alt
            alts[i] = this.Bind(op.Alts[i], subjType, child);
            string[] names = child.Vars.Keys();
            if (i == 0) {
                refCount = names.Length;
                refNames = names;
                refTypes = new Z42Type[refCount];
                int k = 0;
                while (k < refCount) { refTypes[k] = child.Vars.Get(refNames[k]) as Z42Type; k = k + 1; }
            } else {
                this._checkOrBindConsistency(refNames, refTypes, refCount, names, child, op.Alts[i].Span);
            }
            i = i + 1;
        }
        // 统一绑定集注册进真实 env（类型来自首个 alt）
        int j = 0;
        while (j < refCount) { env.Define(refNames[j], refTypes[j]); j = j + 1; }
        return new BoundOrPattern(alts, op.Count, refNames, refTypes, refCount, op.Span);
    }

    // 校验一个 alt 的绑定集（altNames + child.Vars 类型）与参考集（refNames/refTypes）完全一致。
    private void _checkOrBindConsistency(string[] refNames, Z42Type[] refTypes, int refCount, string[] altNames, TypeEnv child, Span sp) {
        if (altNames.Length != refCount) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "or-pattern alternatives must bind the same set of variables", sp);
            return;
        }
        int i = 0;
        while (i < altNames.Length) {
            string nm = altNames[i];
            int idx = PatternBinder._indexOf(refNames, refCount, nm);
            if (idx < 0) {
                this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "or-pattern binding '" + nm + "' is not bound by every alternative", sp);
            } else {
                Z42Type t = child.Vars.Get(nm) as Z42Type;
                if (t.Name() != refTypes[idx].Name()) {
                    this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "or-pattern binding '" + nm + "' has inconsistent type across alternatives: " + refTypes[idx].Name() + " vs " + t.Name(), sp);
                }
            }
            i = i + 1;
        }
    }

    private static int _indexOf(string[] arr, int count, string s) {
        int i = 0;
        while (i < count) { if (arr[i] == s) { return i; } i = i + 1; }
        return -1;
    }

    // @ 绑定（A2）：绑 Name 到整个 subject（subjType），再匹配子模式（子模式绑定照常，@ 不涉合流）。
    private BoundPattern _bindAt(AtPattern ap, Z42Type subjType, TypeEnv env) {
        env.Define(ap.Name, subjType);
        BoundPattern sub = this.Bind(ap.Sub, subjType, env);
        return new BoundAtPattern(ap.Name, subjType, sub, ap.Span);
    }

    // 闭区间范围（A2）：Lo/Hi 常量；subject 须可全序（numeric | char）。
    private BoundPattern _bindRange(RangePattern rp, Z42Type subjType, TypeEnv env) {
        BoundExpr lo = this._tc._expr._bindExpr(rp.Lo, env);
        BoundExpr hi = this._tc._expr._bindExpr(rp.Hi, env);
        if (!TypeFacts.IsOrderable(subjType)) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "range pattern requires an orderable (numeric or char) subject, got " + subjType.Name(), rp.Span);
        }
        return new BoundRangePattern(lo, hi, rp.Span);
    }

    // 关系模式（A2）：Value 常量；subject 须可全序（numeric | char）。
    private BoundPattern _bindRelational(RelationalPattern rp, Z42Type subjType, TypeEnv env) {
        BoundExpr v = this._tc._expr._bindExpr(rp.Value, env);
        if (!TypeFacts.IsOrderable(subjType)) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "relational pattern requires an orderable (numeric or char) subject, got " + subjType.Name(), rp.Span);
        }
        return new BoundRelationalPattern(rp.Op, v, rp.Span);
    }

    // 名字/类型模式：`T x`（恒类型+绑定）/ `T`（类型）/ 点分名（常量）/ 单裸名（绑定）。
    private BoundPattern _bindName(NamePattern np, Z42Type subjType, TypeEnv env) {
        Z42Type resolved = env.ResolveType(np.Type);
        string tn = PatternBinder._rawTypeName(np.Type, resolved);
        // 显式 `T x` → 恒类型模式 + 绑定
        if (np.Bind != "") {
            this._tc._chkTypeRef(resolved, env, np.Span);
            env.Define(np.Bind, resolved);
            return new BoundTypePattern(tn, np.Bind, resolved, np.Span);
        }
        // 无绑定：命中类型名 → 类型模式（不绑定）
        if (!(resolved is Z42UnknownType)) {
            this._tc._chkTypeRef(resolved, env, np.Span);
            return new BoundTypePattern(tn, "", resolved, np.Span);
        }
        // 非类型：点分名 → 常量（枚举/限定常量）；单裸名 → 新绑定
        if (tn.IndexOf(".") >= 0) {
            Expr ce = PatternBinder._dottedToExpr(tn, np.Span);
            BoundExpr bv = this._tc._expr._bindExpr(ce, env);
            return new BoundConstantPattern(bv, np.Span);
        }
        env.Define(tn, subjType);
        return new BoundBindingPattern(tn, subjType, np.Span);
    }

    // 位置模式（record 解构）：T 必须 record class 或 struct record；子模式数 == 声明序字段数；逐字段递归绑定。
    private BoundPattern _bindPositional(PositionalPattern pp, Z42Type subjType, TypeEnv env) {
        Z42Type resolved = env.ResolveType(pp.Type);
        string tn = PatternBinder._rawTypeName(pp.Type, resolved);
        this._tc._chkTypeRef(resolved, env, pp.Span);
        if (!(resolved is Z42ClassType)) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "positional pattern requires a record type: " + tn, pp.Span);
            return new BoundWildcardPattern(pp.Span);
        }
        Z42ClassType ct = resolved as Z42ClassType;
        if (!ct.IsRecord) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "positional (deconstruction) pattern is only allowed on record types: " + tn, pp.Span);
            return new BoundWildcardPattern(pp.Span);
        }
        // complete-pattern-engine 特性 3：放开 struct record 位置解构（emit 侧按 blob 偏移读字段，见 _emitPatFieldRead）。
        // struct 无多态 → 要求 subject 静态即该 struct（blob 在寄存器）；boxed struct（object 持 struct）需拆箱，
        // defer（emit 按 pattern 类型 blob 分派，故 subject 非 struct 时会误读 → 此处拦下）。嵌套 struct 字段亦 defer（下循环守卫）。
        this._guardStructSubject(ct, subjType, tn, pp.Span);
        if (pp.ElemCount != ct.OwnFieldCount) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "positional pattern arity mismatch: " + tn + " has " + ct.OwnFieldCount.ToString() + " fields", pp.Span);
            return new BoundWildcardPattern(pp.Span);
        }
        string[]       fieldNames = new string[pp.ElemCount];
        Z42Type[]      fieldTypes = new Z42Type[pp.ElemCount];
        BoundPattern[] elems      = new BoundPattern[pp.ElemCount];
        int i = 0;
        while (i < pp.ElemCount) {
            string fname = ct.OwnFieldNames[i];
            fieldNames[i] = fname;
            Z42Type fty = PatternBinder._fieldType(ct, fname);
            fieldTypes[i] = fty;
            this._guardNestedStructField(ct, fty, env, pp.Span);   // 特性 3：struct record 内嵌 struct 字段 defer
            elems[i] = this.Bind(pp.Elems[i], fty, env);
            i = i + 1;
        }
        return new BoundPositionalPattern(tn, resolved, fieldNames, fieldTypes, elems, pp.ElemCount, pp.Span);
    }

    // 特性 3：struct record 模式要求 subject 静态即该 struct（blob 在寄存器，emit 直发 StructFieldGetPrim）。
    // boxed struct（subject 为 object/接口/非-struct，struct 装箱进 ref）需拆箱后再读 → defer（初版）。
    private void _guardStructSubject(Z42ClassType ct, Z42Type subjType, string tn, Span sp) {
        if (!ct.IsStruct) { return; }
        // struct 无多态：合法 subject 静态类型名须恰等于 struct 名（`Point p; ... p ...`）。不等 → subject 是
        // object/接口/别的类型（boxed struct）→ 需拆箱，defer。用 Name() 比对（跨 binder/dump 路径稳定，
        // 不依赖可能未填充的 IsStruct 位）。
        if (subjType.Name() != ct.Name()) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "matching a struct record pattern requires a struct-typed subject (boxed struct not yet supported): " + tn, sp);
        }
    }

    // 特性 3：struct record（blob 容器）的内嵌 struct-record 字段模式解构 defer（6.5 决策 3）——嵌套 struct
    // 字段读需 blob copyRegion 值副本，初版限基元 + 引用字段。容器是 struct 且字段本身是 struct record → 报错。
    // ⚠️ 字段类型（FieldSymbol.FieldType）是薄类型、IsStruct 未必填充 → 经 env.Symbols.GetClass 取规范类型判；
    // 且须 IsStruct **且** IsRecord（排除基元标量 int/float——它们 IsStruct=true 但按 prim 读 struct_fget_prim 正确）。
    private void _guardNestedStructField(Z42ClassType ct, Z42Type fty, TypeEnv env, Span sp) {
        if (!ct.IsStruct) { return; }
        Z42ClassType fclass = env.Symbols.GetClass(fty.Name());
        if (fclass != null && fclass.IsStruct && fclass.IsRecord) {
            this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "destructuring a nested struct-record field of a struct record is not yet supported: " + fty.Name(), sp);
        }
    }

    // 属性模式：T{F:p}（HasType 测类型）/ {F:p}（省类型，仅按字段名）。逐字段递归绑定。
    private BoundPattern _bindProperty(PropertyPattern pp, Z42Type subjType, TypeEnv env) {
        Z42Type resolved = new Z42UnknownType();
        string tn = "";
        if (pp.HasType) {
            resolved = env.ResolveType(pp.Type);
            tn = PatternBinder._rawTypeName(pp.Type, resolved);
            this._tc._chkTypeRef(resolved, env, pp.Span);
        } else {
            resolved = subjType;   // 省类型 `{F:p}` → 用 subject 静态类型解析字段（解构声明 / switch / is 通用）
            tn = subjType.Name();
        }
        if (resolved is Z42ClassType) { this._guardStructSubject(resolved as Z42ClassType, subjType, tn, pp.Span); }   // 特性 3：boxed struct defer
        string[]       names      = new string[pp.FieldCount];
        Z42Type[]      fieldTypes = new Z42Type[pp.FieldCount];
        BoundPattern[] pats       = new BoundPattern[pp.FieldCount];
        int i = 0;
        while (i < pp.FieldCount) {
            string fname = pp.FieldNames[i];
            names[i] = fname;
            Z42Type fty = new Z42UnknownType();
            if (resolved is Z42ClassType) {
                Z42ClassType ct = resolved as Z42ClassType;
                if (ct.Fields.ContainsKey(fname)) { fty = PatternBinder._fieldType(ct, fname); this._guardNestedStructField(ct, fty, env, pp.Span); }
                else { this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol, "no field '" + fname + "' on " + tn, pp.Span); }
            }
            fieldTypes[i] = fty;
            pats[i] = this.Bind(pp.FieldPats[i], fty, env);
            i = i + 1;
        }
        return new BoundPropertyPattern(pp.HasType, tn, resolved, names, fieldTypes, pats, pp.FieldCount, pp.Span);
    }

    // AST 原始类型名（镜像 BoundIsExpr：NamedType 优先取原始点串名，否则 resolved.Name()）。
    private static string _rawTypeName(TypeExpr te, Z42Type resolved) {
        if (te is NamedType) { return (te as NamedType).Name; }
        return resolved.Name();
    }

    private static Z42Type _fieldType(Z42ClassType ct, string fname) {
        if (ct.Fields.ContainsKey(fname)) {
            FieldSymbol fs = ct.Fields.Get(fname) as FieldSymbol;
            if (fs != null) { return fs.FieldType; }
        }
        return new Z42UnknownType();
    }

    // 点分名 "A.B.C" → MemberExpr(MemberExpr(IdentExpr("A"),"B"),"C")（供枚举/限定常量绑定，与 _parseExpr 等价）。
    private static Expr _dottedToExpr(string name, Span sp) {
        Expr e = null;
        int start = 0;
        int i = 0;
        while (i <= name.Length) {
            bool atEnd = (i == name.Length);
            if (atEnd || name.CharAt(i) == '.') {
                string seg = name.Substring(start, i - start);
                if (e == null) { e = new IdentExpr(seg, sp); }
                else { e = new MemberExpr(e, seg, sp); }
                start = i + 1;
            }
            i = i + 1;
        }
        return e;
    }
}
