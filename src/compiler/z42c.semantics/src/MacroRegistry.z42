// 编译期宏注册表（零格式-bump）。原名 CallerMacro（attribute-handler-registry PR6b，只有 caller
// info 一族）；add-symbol-availability-macro 起承载多族宏，改名以副实。
//
// parser 把宏译成既有 `IdentExpr("$macro:"+name)` 哨兵（见 ExprParser）——不新增任何 syntax AST
// 节点，故 z42c.semantics 只靠既有 IdentExpr.Name 识别，**无新 syntax→semantics 跨包符号** →
// 避开 F2 冷启动 stale-cache（[[two-gen-bootstrap-regressed-blocks-format-bumps]] 邻近 PR4d/4e 教训）。
// 两种表面形态：
//   - 无参 `name!()`   → 裸 IdentExpr(哨兵)                       ← caller 族
//   - 带参 `name!(x)`  → CallExpr(IdentExpr(哨兵), args)（postfix 循环自然产出） ← available
//
// 本 helper 全在 z42c.semantics **包内**（被 ClassDescBuilder/DeclBinder/OverloadBinder/ExprTyper
// 引用）→ 包内符号解析，F2-安全。宏白名单也在此（design「语义层按宏名白名单认」）。
//
// 两族宏的**合法位置不同**，由 PositionOf 表达、调用方按它分流（此前 ExprTyper 一刀切 E0450）：
//   caller 族  → "param-default"：只合法于参数默认值位；运行期零参与（编译期注入字面量）
//   available → "expr"          ：只合法于普通表达式位；发 BuiltinInstr，加载期被 VM 折成常量
//
// 持久化：caller 宏 → param attr-ref `$Caller:<kind>` 哨兵（FactoryFunc 空；PR6 infra 的
// IrParamDefault.Caller() 读回、ImportedSymbolLoader 填 Z42FuncType.ParamCallers）。
// 注入：调用点省略实参 → OverloadBinder._callerLiteral 注入 enclosing member/line/file/namespace 字面量。
// available 不走哨兵——它在 codegen 就变成一条 Builtin 指令，见 design D1/D2。
namespace Z42.Semantics;

using Z42.Syntax;

public static class MacroRegistry {
    // parser 产出的宏哨兵名前缀（IdentExpr.Name = "$macro:" + 宏名）。
    public static string Prefix = "$macro:";

    // Expr 是否为编译期宏哨兵。
    public static bool IsMacro(Expr e) {
        if (!(e is IdentExpr)) { return false; }
        return (e as IdentExpr).Name.StartsWith(MacroRegistry.Prefix);
    }

    // 宏名（去掉 "$macro:" 前缀），如 "caller_member"。调用方须先 IsMacro 为真。
    public static string NameOf(Expr e) {
        string n = (e as IdentExpr).Name;
        return n.Substring(MacroRegistry.Prefix.Length, n.Length - MacroRegistry.Prefix.Length);
    }

    // `available` 的宏名（避免各处硬编码字面量）。
    public static string AvailableName = "available";

    // 带参形态：Expr 是否为 `name!(args)` —— 即 CallExpr 且 Callee 是宏哨兵。
    // 无参形态请用 IsMacro（裸 IdentExpr）。
    public static bool IsMacroCall(Expr e) {
        if (!(e is CallExpr)) { return false; }
        return MacroRegistry.IsMacro((e as CallExpr).Callee);
    }

    // 宏名 → 合法位置："param-default"（caller 族）/ "expr"（available）/ ""（未知宏 → E0450）。
    // **这是宏白名单的单一真相**：KindOf 只回答 caller 族内部的 kind，不承担「是不是已知宏」。
    public static string PositionOf(string macroName) {
        if (MacroRegistry.KindOf(macroName) != "") { return "param-default"; }
        if (macroName == MacroRegistry.AvailableName) { return "expr"; }
        return "";
    }

    // caller 宏名 → caller kind（"member"/"line"/"file"/"module"）；非 caller 族 → ""。
    // ⚠️ 返回 "" **不再等价于「未知宏」**（available 也返回 ""）——判未知请用 PositionOf。
    public static string KindOf(string macroName) {
        if (macroName == "caller_member") { return "member"; }
        if (macroName == "caller_line")   { return "line"; }
        if (macroName == "caller_file")   { return "file"; }
        if (macroName == "module_path")   { return "module"; }
        return "";
    }

    // 该 kind 要求的参数类型（"line" → int；其余 → string）。定义侧类型校验用。
    public static bool ParamTypeOk(string kind, string typeName) {
        if (kind == "line") { return typeName == "int"; }
        return typeName == "string";
    }
}
