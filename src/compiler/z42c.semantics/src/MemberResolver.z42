// 成员解析 + 调用子绑定器（compiler-review P1-1：拆 TypeChecker God-Class step 2）。
// 持 TypeChecker 反向引用 _tc：跨界经 _tc._bindExpr（ExprTyper）/_tc._overload（重载决议）/
// _tc._diags / _tc._currentNs；prim 谓词走 TypeChecker 静态。同组方法互调仍 this._X。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;

public sealed class MemberResolver {
    private TypeChecker _tc;
    public MemberResolver(TypeChecker tc) { this._tc = tc; }

    internal BoundExpr _bindMember(MemberExpr m, TypeEnv env) {
        // 裸类名静态字段读（SA-2）：Sev.Error——target 是类名（非变量）→ StaticGet
        if (m.Target is IdentExpr) {
            IdentExpr tid = m.Target as IdentExpr;
            // Static field read on a bare type name (SA-2). Scalar primitive
            // keyword aliases (`int`, `double`, …) are keyed in the symbol table
            // under their wrapper name (`Int32`, `Double`); map through so that
            // `int.MaxValue` binds to the same static field as `Int32.MaxValue`.
            string clsName = tid.Name;
            if (!env.Symbols.HasClass(clsName) && PrimModel.IsBuiltin(clsName)) {
                clsName = PrimModel.Wrapper(clsName);
            }
            if (env.LookupVar(tid.Name) == null && env.Symbols.HasClass(clsName)) {
                Z42ClassType sct = env.Symbols.GetClass(clsName);
                FieldSymbol sfs = sct.Fields.Get(m.Name) as FieldSymbol;
                if (sfs != null && sfs.IsStatic) {
                    this._tc._access.CheckAccess(sfs.Visibility, sfs.ContainingTypeName, env, env.Symbols, "field", m.Name, m.Span);   // enforce-access-control
                    this._tc._access.CheckDeprecatedF(sfs, m.Name, m.Span);   // add-deprecated-directive
                    return new BoundStaticGet(clsName, m.Name, sfs.FieldType, m.Span);
                }
            }
            // 枚举常量访问 `EnumType.Member` → BoundLitInt（long）。保 z42 enum-as-int 模型（member
            // 值即底层 i64，可自由当 int 用）；EnumTypeName 标记来源 enum，供 `E.Red.GetType()` 折叠回
            // typeof(E)（fix-value-type-object-methods）——静态类型仍 long，不改任何 int-context 语义。
            if (env.LookupVar(tid.Name) == null && env.Symbols.EnumTypes.ContainsKey(tid.Name)) {
                string ekey = tid.Name + "." + m.Name;
                if (env.Symbols.EnumConsts.ContainsKey(ekey)) {
                    StrBox evalBox = env.Symbols.EnumConsts.Get(ekey) as StrBox;
                    BoundLitInt eb = new BoundLitInt(evalBox.Value, Z42ClassType.Builtin("long"), m.Span);
                    eb.EnumTypeName = tid.Name;
                    return eb;
                }
            }
        }
        BoundExpr target = this._tc._expr._bindExpr(m.Target, env);
        Z42Type tt = target.Type();
        return this._bindInstanceMember(m, target, tt, env);
    }

    // `call` 仅用于把**已解析出的 MethodSymbol** 接进 `_applyMethodTypeArgs`
    // （complete-where-constraints PR-1）。此前实例路径的类型实参是由 `_bindCall` 的兜底以
    // `ms = null` 附加的 —— 那让 `_applyMethodTypeArgs` 里 `ms != null && ms.HasDecl` 恒不成立，
    // **arity 校验 E0445 与方法级 where 约束在 `this.m<T>()` 上双双静默**（实测：连 `this.g<K,K>()`
    // 的 arity 都不报）。兜底注释「无本地 Decl」只对 imported / prim 成立；同类实例方法这里明明
    // 已经解析出 ms，只是没往外透。
    //
    // **刻意不改重载决议**：下方 `_resolveOverload` 的 typeArgCount 仍传 0。把它改成
    // `call.TypeArgCount` 会改变重载选择 → 撼动 codegen 与自举字节不动点，属另一件事。
    private BoundExpr _bindInstanceMemberCall(MemberExpr mem, BoundExpr recv, Z42Type rt, BoundExpr[] args, int argCount, Expr[] rawArgs, TypeEnv env, Span sp, CallExpr call) {
        // unify-value-types Phase 1：翻转后基元/string/object 为 Z42ClassType——**排除内建**，让其
        // 继续走下方 prim-wrapper 派发路径（declClass 用 keyword 名、键用 _overloadKey），与翻转前
        // Z42PrimType 收者逐字节同义。用户 class/struct（非内建）仍走此类分支。
        if ((rt is Z42ClassType) && !rt.IsBuiltinType()) {
            Z42ClassType ct = rt as Z42ClassType;
            // 阶段 3：受者可能是**空方法 stub**——`ImportedSymbolLoader._resolve` 对未在 per-import
            // `r.Classes` 加载的类名（如无 `using Z42.IR` 时经字段类型间接可知的 StrMap）落兜底产
            // `Z42ClassType.Builtin(name)`（无成员）。翻转前该兜底是 Z42PrimType，MemberResolver 走 prim
            // 路径按名重解析/loose 绑定；翻转成 ClassType 后须复刻同款以维 byte-identical：
            //   ① ct 无方法而主符号表有同名真类 → 重解析成真类（prim 路径 HasClass 分支）；
            //   ② ct 无方法且主符号表无（懒加载未载真类）→ 下方 ms==null 时 **loose 绑定 Unknown**，
            //      不报 "no method"（prim 路径 fallthrough，运行期经 DepIndex 解析）。
            bool _stub = ct.Methods.Count() == 0;
            if (_stub && env.Symbols.HasClass(ct.Name())) { ct = env.Symbols.GetClass(ct.Name()); _stub = false; }
            MethodSymbol ms = this._tc._overload._resolveOverload(env.Symbols, ct, mem.Name, args, argCount, 0, sp);   // 实例成员调用无 CallExpr → typeArgCount=0
            if (ms != null) {
                this._tc._access.CheckAccess(ms.Visibility, ms.ContainingTypeName, env, env.Symbols, "method", mem.Name, sp);   // enforce-access-control
                this._tc._access.CheckDeprecatedM(ms, mem.Name, sp);   // add-deprecated-directive
                BoundExpr[] fa = this._tc._overload._withDefaults(ms, args, rawArgs, argCount, env, sp);
                BoundCall ibc = new BoundCall("instance", true, recv, ct.Name(), ms.RegKey, fa, fa.Length, ms.Signature.Ret, sp);
                this._applyMethodTypeArgs(ibc, call, ms, env);   // 带真 ms → arity + where 约束真校验
                return ibc;
            }
            if (_stub) {   // 懒加载 stub 受者、主符号表无真类 → loose 绑定（镜像翻转前 prim 路径 fallthrough，无 "no method"）
                args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
                return new BoundCall("instance", true, recv, ct.Name(), mem.Name, args, argCount, new Z42UnknownType(), sp);
            }
            this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                "no method `" + mem.Name + "` on `" + ct.Name() + "`", sp);
            args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);   // add-target-typed-new：错误路径清 null 占位
            return new BoundCall("instance", true, recv, ct.Name(), mem.Name, args, argCount, new Z42ErrorType(), sp);
        }
        if (rt is Z42InterfaceType) {                                // 接口收者（port-z42c-interface）
            Z42InterfaceType it = rt as Z42InterfaceType;
            MethodSymbol ims = it.Methods.Get(mem.Name) as MethodSymbol;
            if (ims != null) {
                // bind-self-param-and-constraint-members Part B：**形参位**的 `Self` 经接口静态类型
                // 调用一律禁止（对标 Rust object-safety）。返回位（#527）能取接口作**上界**是因为它
                // 协变——任何实现方都实现了该接口；形参位是**逆变**，接口只保证实参「也实现了该接口」，
                // 而实现方的签名要的是「它自己」⇒ 放行即运行期类型混淆。
                //
                // 实测（本 change 阶段 0）：`IEq a = new P(1); IEq b = new Q("hello"); a.Same(b)`
                // 编译期零诊断，运行期派发到 `P.Same(P)`、`other.V` 从 Q 上读出 **null**，静默返回 false。
                // ⚠️ 上界替换（把 `Self` 换成 `IEq`）**拦不住它**——P 和 Q 都是 IEq。故只能禁止。
                //
                // 替代写法就在隔壁：`bool f<T>(T a, T b) where T : IEq` 走型参收者那条，`Self ≡ T`
                // 精确、且实参经 Part A 真校验。诊断消息直接把这条路给出来。
                if (MemberResolver._sigHasSelfParam(ims.Signature)) {
                    this._tc._diags.Error("E0454",
                        "cannot call `" + mem.Name + "` through interface type `" + it.Name()
                        + "`: a `Self` parameter has no safe bound here — use a type parameter instead, e.g. `where T : "
                        + it.Name() + "`", sp);
                }
                args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, ims.Signature, env);   // add-target-typed-new：接口方法按形参类型回填
                // self-return-type-substitution：返回类型里的 `Self` 换成接收者的静态接口类型，
                // 否则型参 `Self` 会裸奔到调用方（`var x = c.Copy()` 得到 `:Self`，不可用）。
                return new BoundCall("instance", true, recv, it.Name(), mem.Name, args, argCount,
                                     MemberResolver._substSelf(ims.Signature.Ret, it), sp);
            }
            this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                "no method `" + mem.Name + "` on interface `" + it.Name() + "`", sp);
            args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
            return new BoundCall("instance", true, recv, it.Name(), mem.Name, args, argCount, new Z42ErrorType(), sp);
        }
        if ((rt is Z42ErrorType) || (rt is Z42UnknownType)) {
            args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
            return new BoundCall("instance", true, recv, "<?>", mem.Name, args, argCount, new Z42ErrorType(), sp);
        }
        // GS6: 泛型实例化类型（List<string>.ToArray() / LinkedList<T>.Next() 等）→ 查 Def 类方法，
        // 返回类型里的**类泛型形参**按 receiver 的 TypeArgs 替换（T→string；T[]→string[]；嵌套递归）。
        // 形参名不在 Def.GenericParamNames 中（方法级泛型形参）→ 松绑 Unknown（沿用旧行为）。
        if (rt is Z42InstantiatedType) {
            Z42InstantiatedType instRecv = rt as Z42InstantiatedType;
            Z42ClassType itDef2 = instRecv.Def;
            MethodSymbol itms = this._tc._overload._resolveOverload(env.Symbols, itDef2, mem.Name, args, argCount, 0, sp);
            if (itms != null) {
                Z42Type itRet = MemberResolver._substGeneric(itms.Signature.Ret, instRecv);
                BoundExpr[] fa = this._tc._overload._withDefaults(itms, args, rawArgs, argCount, env, sp);
                // add-generic-type-arg-inference 阶段 A：形参位也按 receiver 的 TypeArgs 代换，再查一遍实参。
                //
                // 为什么必须**另起一次检查**而不是把代换后的签名喂给上面的 `_withDefaults`（不变式 I1）：
                // `_withDefaults` 里有四条对形参类型敏感、且会改发射的通道 —— params 的 normal/expanded
                // 翻转（`OverloadBinder:178` 的 `IsAssignableTo(T[])` 今天恒 false ⇒ 恒走 expanded 合成
                // BoundArrayLit）、值 struct 装箱（`TypeChecker:136` 的 `target is Z42GenericParamType`
                // 今天恒装箱）、ConvertInstr / op_Implicit 的插入、以及 lambda 按 expected 重绑。
                // 代换一旦回灌，这四条**每一条都是确定性的自举字节漂移**，前两条在 stdlib 容器里遍地触发。
                // 故代换结果只作为诊断入参存在：`_withDefaults` 拿到的仍是原始 itms.Signature。
                //
                // ⚠️ 走 `CheckSubstitutedArgs` 而非 `CheckArgTypes`：**只补查原签名含型参的那些位**。
                // 形参是具体类型的位（`void PutAt(T v, int i)` 的 `int`）在 `_withDefaults` 内部那次
                // 已经查过并报过，整条签名重查会同 span 同消息报两条 —— 实测过（本阶段初版就是这样）。
                //
                // **方法级**型参（`U` 这种不在 Def.GenericParamNames 里的）在 `_substGeneric` 下退化成
                // Z42UnknownType（见其 :365）⇒ 落 Conversion 分支 A 的 Absorb ⇒ 放行。所以「类级 + 方法级
                // 混合泛型」在本阶段不产生假红，要等阶段 C 求出方法级绑定后才真检查。
                this._tc._overload.CheckSubstitutedArgs(fa, rawArgs, argCount, itms.Signature,
                    MemberResolver._substGenericSig(itms.Signature, instRecv), env);
                // add-struct-generic-boxing (P3a)：方法返回 type-param 且 subst 为 blob 值 struct（如
                // `List<P>.First()`）→ 返回装箱值 → 包 BoundConvert 拆箱回值 struct（内层 call 类型 Unknown
                // 触发 _emitConvert AsCast 拆箱臂）。
                Z42Type ubR = this._tc.StructUnboxTarget(itms.Signature.Ret, instRecv);
                if (ubR != null) {
                    BoundCall rawM = new BoundCall("instance", true, recv, itDef2.Name(), itms.RegKey, fa, fa.Length, new Z42UnknownType(), sp);
                    this._applyMethodTypeArgs(rawM, call, itms, env);
                    return new BoundConvert(rawM, ubR, sp);
                }
                BoundCall gbc = new BoundCall("instance", true, recv, itDef2.Name(), itms.RegKey, fa, fa.Length, itRet, sp);
                this._applyMethodTypeArgs(gbc, call, itms, env);   // 泛型受者上的实例泛型方法同款
                return gbc;
            }
            args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
            return new BoundCall("instance", true, recv, itDef2.Name(), mem.Name, args, argCount, new Z42UnknownType(), sp);
        }
        // Z42GenericParamType：T.GetHashCode() 等继承自 Object 的方法 → 查 Object 类取真实返回类型。
        if (rt is Z42GenericParamType) {
            if (env.Symbols.HasClass("Object")) {
                Z42ClassType objCt = env.Symbols.GetClass("Object");
                string gpMkey = this._tc._overload._overloadKey(env.Symbols, objCt, mem.Name, argCount);
                MethodSymbol gpMs = this._tc._overload._findMethod(env.Symbols, objCt, gpMkey);
                if (gpMs != null) {
                    args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, gpMs.Signature, env);
                    return new BoundCall("instance", true, recv, rt.Name(), gpMkey, args, argCount, gpMs.Signature.Ret, sp);
                }
            }
            // bind-self-param-and-constraint-members Part A：Object 查不到 → 按该型参的 **where 约束
            // 接口**（含父接口闭包、方法级 + 类级两个来源）找同名方法，拿真签名。
            //
            // 为什么必须补这一步：不补就落到下方 `sig = null` 的松绑，而 `OverloadBinder.CheckArgTypes`
            // 第一行就是 `if (sig == null) { return; }` ⇒ **泛型代码里对约束接口方法的调用，实参一律
            // 不检查**。实测 `bool badGen<T>(T a) where T : IEq { return a.Same("nope"); }` 编译期零
            // 诊断、运行期才炸 `string has no field 'V'`。这不限于 `Self`——`where T : IComparable` 的
            // `CompareTo`、`INumber` 的 `op_Add` 全都如此，而 PriorityQueue / SortedSet 正走这条路。
            //
            // **Object 优先于约束接口**（顺序不能反）：`where T : IEquatable` 的 `a.Equals(b)` 今天派发
            // 到 `Object.Equals` 的 `gpMkey`，反过来会改派发键 → 撼动自举字节。
            //
            // 签名里的 `Self` 在这条路上**精确替换为该型参本身**（不是上界）：约束 `T : IEq` 就是
            // 「运行期 T 即那个实现类型」的断言 ⇒ `Self ≡ T`。与接口静态类型收者那条（只能取接口作
            // 上界，见 _substSelf 抬头）本质不同。
            MethodSymbol cms = this._tc._expr._constraintIfaceMethod(env, rt.Name(), mem.Name);
            if (cms != null && cms.Signature != null) {
                Z42FuncType csig = MemberResolver._substSelfSig(cms.Signature, rt);
                args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, csig, env);
                return new BoundCall("instance", true, recv, rt.Name(), mem.Name, args, argCount, csig.Ret, sp);
            }
            args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
            return new BoundCall("instance", true, recv, rt.Name(), mem.Name, args, argCount, new Z42UnknownType(), sp);
        }
        // fix-value-type-object-methods ④：数组收者的 Object 继承方法（GetType/ToString/Equals/
        // GetHashCode）——查 Object 取**真实返回类型**（否则下方 fallthrough 松绑 Unknown → 链式
        // `xs.GetType().FullName` 退化成 FieldGet "FullName" → null）。镜像上方 Z42GenericParamType 分支。
        // 运行期 VCall 在数组值上仍走 builtin_obj_get_type（数组特化），OwnerClass 与 fallthrough 同名不改派发。
        if (rt is Z42ArrayType) {
            if (env.Symbols.HasClass("Object")) {
                Z42ClassType objCt = env.Symbols.GetClass("Object");
                string aMkey = this._tc._overload._overloadKey(env.Symbols, objCt, mem.Name, argCount);
                MethodSymbol aMs = this._tc._overload._findMethod(env.Symbols, objCt, aMkey);
                if (aMs != null) {
                    args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, aMs.Signature, env);
                    return new BoundCall("instance", true, recv, PrimModel.Keyword(rt.Name()), aMkey, args, argCount, aMs.Signature.Ret, sp);
                }
            }
        }
        // prim receiver（IC-3，镜像 C#）：prim 名首字母大写 → stdlib 包装类（"string"→"String"，
        // imported 自 z42.core TSIG）→ 取方法 ret 真类型（dst tag 字节实证 Str 非 Unknown）；
        // 查无则松绑定 Unknown（codegen 经 DepIndex 真实解析）。
        string wrapper = TypeFactsTc._primWrapper(rt.Name());
        if (env.Symbols.HasClass(wrapper)) {
            Z42ClassType wct = env.Symbols.GetClass(wrapper);
            // stabilize-instance-dispatch-keys：prim 收者实例方法**恒走完整 `_resolveOverload`**（镜像上方
            // class 收者路径 :69 → ms.RegKey）。旧的 `_sameArity<2` 快路径（`_overloadKey`/`_findMethod` 取
            // bare / `Name$arity`）在新键方案下**失效并致命**：arity 重载（如 `Substring(int)`/`Substring(int,int)`）
            // 的非-primary 现注册为全签名键 `Substring$2$i32$i32`（非 `Substring$2`），`_overloadKey` 找不到
            // `Substring$2` → 回落裸 `Substring` → `_findMethod` 命中 **primary（arity-1）** → emit 裸名 + argCount=2
            // → 运行期按裸名派发到 arity-1 方法却传 2 实参 → **错-arity 调用 → 段错误**。`_resolveOverload` 按
            // arity 过滤 + 返回正确 `rms.RegKey`（primary 裸 / 非-primary 全键），根治。唯一方法字节中性（RegKey=裸）。
            MethodSymbol rms = this._tc._overload._resolveOverload(env.Symbols, wct, mem.Name, args, argCount, 0, sp);
            if (rms != null) {
                this._tc._access.CheckAccess(rms.Visibility, rms.ContainingTypeName, env, env.Symbols, "method", mem.Name, sp);
                this._tc._access.CheckDeprecatedM(rms, mem.Name, sp);
                BoundExpr[] fa = this._tc._overload._withDefaults(rms, args, rawArgs, argCount, env, sp);
                return new BoundCall("instance", true, recv, PrimModel.Keyword(rt.Name()), rms.RegKey, fa, fa.Length, rms.Signature.Ret, sp);
            }
        }
        args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
        return new BoundCall("instance", true, recv, PrimModel.Keyword(rt.Name()), mem.Name, args, argCount, new Z42UnknownType(), sp);
    }

    private BoundExpr _bindInstanceMember(MemberExpr m, BoundExpr target, Z42Type tt, TypeEnv env) {
        // unify-value-types Phase 1：排除内建 Z42ClassType，让 string.Length（下方特例）+ 其余基元成员
        // 走 prim-wrapper 路径，与翻转前 Z42PrimType 收者同款。用户 class/struct 仍走类成员访问。
        if ((tt is Z42ClassType) && !tt.IsBuiltinType()) { return this._bindClassMemberAccess(m, target, tt as Z42ClassType, env); }
        // 接口收者属性访问：get_<Name>() 虚调用（接口 getter 已注册为 get_X 方法符号）。
        if (tt is Z42InterfaceType) {
            Z42InterfaceType it = tt as Z42InterfaceType;
            MethodSymbol ig = it.Methods.Get("get_" + m.Name) as MethodSymbol;
            if (ig != null && ig.Signature != null) {
                // self-return-type-substitution：属性 getter 同款（`interface IBox { Self Inner { get; } }`）
                return new BoundCall("instance", true, target, it.Name(), "get_" + m.Name, new BoundExpr[0], 0,
                                     MemberResolver._substSelf(ig.Signature.Ret, it), m.Span);
            }
            return new BoundMember(target, m.Name, new Z42ErrorType(), m.Span);
        }
        // Length on array OR string → int；Count → int（镜像 C# TypeChecker.Exprs.Members 行 161-164：
        // `m.Member is "Length" && (target.Type is Z42ArrayType || target.Type == Z42Type.String)`）。
        // unify-value-types Phase 1：翻转后 string→Z42ClassType(String)——追加 Canon=="string" 判定
        // （翻转前无该拼写 Z42ClassType 流经 → 中立）。
        if (m.Name == "Length" && ((tt is Z42ArrayType) || ((tt is Z42ClassType) && tt.CanonName() == "string"))) {
            return new BoundMember(target, m.Name, Z42ClassType.Builtin("int"), m.Span);
        }
        if (m.Name == "Count") {
            return new BoundMember(target, m.Name, Z42ClassType.Builtin("int"), m.Span);
        }
        if ((tt is Z42ErrorType) || (tt is Z42UnknownType)) {
            return new BoundMember(target, m.Name, new Z42ErrorType(), m.Span);
        }
        // GS5：泛型类型形参（TKey/TValue 等）上的成员访问松绑到 Unknown（调用方再按 DepIndex 真实解析）。
        if (tt is Z42GenericParamType) {
            return new BoundMember(target, m.Name, new Z42UnknownType(), m.Span);
        }
        // GS6: 泛型实例化类型（LinkedListNode<T> 等）成员访问 → 查 Def 类字段，字段类型里的类形参
        // 按 receiver TypeArgs 替换（与方法返回同一 _substGeneric）；形参名不在 Def 形参表 → Unknown。
        if (tt is Z42InstantiatedType) {
            Z42InstantiatedType instT = tt as Z42InstantiatedType;
            Z42ClassType itDef = instT.Def;
            FieldSymbol itFs = this._findField(env.Symbols, itDef, m.Name);
            if (itFs != null) {
                Z42Type fType = MemberResolver._substGeneric(itFs.FieldType, instT);
                return new BoundMember(target, m.Name, fType, m.Span);
            }
            // fix-generic-struct-property-getter：泛型实例化收者的**属性 getter**（无字段但有 get_Name）→
            // BoundCall(get_Name)，返回类型经 _substGeneric 按 receiver 实参替换（镜像 :218-222 class 路径 +
            // :97 方法路径的替换）。缺此则 imported 泛型 struct 的计算属性（如 `DictionaryEnumerator<K,V>.
            // Current` → `KeyValuePair<K,V>`）——imported 元数据里计算属性**无字段** → _findField 落空 → 松绑
            // Unknown → 下游 retType=Unknown → `_isBlobStruct` false → sret 失配 → 运行期 `StructCopy got Null`。
            // （in-app 恰好因属性名被本地登记为字段而走上面 field 分支蒙对；跨包无该字段登记才暴露。）
            MethodSymbol itGetter = this._tc._overload._findMethod(env.Symbols, itDef, "get_" + m.Name);
            if (itGetter != null && itGetter.Signature != null) {
                this._tc._access.CheckAccess(itGetter.Visibility, itGetter.ContainingTypeName, env, env.Symbols, "property", m.Name, m.Span);
                this._tc._access.CheckDeprecatedM(itGetter, m.Name, m.Span);
                Z42Type gret = MemberResolver._substGeneric(itGetter.Signature.Ret, instT);
                return new BoundCall("instance", true, target, itDef.Name(), "get_" + m.Name, new BoundExpr[0], 0, gret, m.Span);
            }
            return new BoundMember(target, m.Name, new Z42UnknownType(), m.Span);
        }
        // prim receiver 属性访问（镜像 _bindMemberCall 的 prim 处理）：prim 名首字母大写 →
        // stdlib 包装类（"string"→"String"，imported 自 z42.core TSIG）→ 取字段/属性真类型；
        // 查无则松绑 Unknown（codegen 经 DepIndex/VM builtin 真实解析，如 string.Length）。
        string wrapper = TypeFactsTc._primWrapper(tt.Name());
        if (env.Symbols.HasClass(wrapper)) {
            Z42ClassType wct = env.Symbols.GetClass(wrapper);
            FieldSymbol wfs = this._findField(env.Symbols, wct, m.Name);
            if (wfs != null) { return new BoundMember(target, m.Name, wfs.FieldType, m.Span); }
            // 属性 getter 派发（镜像上面 Z42ClassType 分支）：wrapper 类的 extern 属性
            // （如 String.ByteLength）注册为 get_<Name> 方法而非字段，须同样查 getter
            // 才能拿到真实返回类型；否则误判 "member access on non-class" 或松绑 Unknown。
            MethodSymbol wgetter = this._tc._overload._findMethod(env.Symbols, wct, "get_" + m.Name);
            if (wgetter != null && wgetter.Signature != null) {
                return new BoundCall("instance", true, target, PrimModel.Keyword(tt.Name()), "get_" + m.Name, new BoundExpr[0], 0, wgetter.Signature.Ret, m.Span);
            }
            return new BoundMember(target, m.Name, new Z42UnknownType(), m.Span);
        }
        this._tc._diags.Error(DiagnosticCodes.TypeMismatch,
            "member access on non-class `" + tt.Name() + "`", m.Span);
        return new BoundMember(target, m.Name, new Z42ErrorType(), m.Span);
    }

    private BoundExpr _bindClassMemberAccess(MemberExpr m, BoundExpr target, Z42ClassType ct, TypeEnv env) {
            FieldSymbol fs = this._findField(env.Symbols, ct, m.Name);
            if (fs != null) {
                this._tc._access.CheckAccess(fs.Visibility, fs.ContainingTypeName, env, env.Symbols, "field", m.Name, m.Span);   // enforce-access-control
                this._tc._access.CheckDeprecatedF(fs, m.Name, m.Span);   // add-deprecated-directive
                return new BoundMember(target, m.Name, fs.FieldType, m.Span);
            }
            // 属性 getter 派发：无字段但有 get_<Name>(0 参) → 虚调用 getter（镜像 C#）。
            MethodSymbol getter = this._tc._overload._findMethod(env.Symbols, ct, "get_" + m.Name);
            if (getter != null && getter.Signature != null) {
                this._tc._access.CheckAccess(getter.Visibility, getter.ContainingTypeName, env, env.Symbols, "property", m.Name, m.Span);   // enforce-access-control
                this._tc._access.CheckDeprecatedM(getter, m.Name, m.Span);   // add-deprecated-directive
                return new BoundCall("instance", true, target, ct.Name(), "get_" + m.Name, new BoundExpr[0], 0, getter.Signature.Ret, m.Span);
            }
            // 实例方法组（D-1b）：`obj.Method` 作值（非调用）→ BoundMethodGroup（emit 合成 thunk+MkClos）。
            // stabilize-dispatch-keys（方案A，静态-only）：实例方法保持基线键 → 沿用 _findMethod 按源名查（unique
            // bare / arity 重载 Name$arity）。静态-only 不 mangle 实例方法，此路径不变。
            MethodSymbol mg = this._tc._overload._findMethod(env.Symbols, ct, m.Name);
            if (mg != null && mg.Signature != null) {
                this._tc._access.CheckAccess(mg.Visibility, mg.ContainingTypeName, env, env.Symbols, "method", m.Name, m.Span);   // enforce-access-control
                this._tc._access.CheckDeprecatedM(mg, m.Name, m.Span);   // add-deprecated-directive
                return new BoundMethodGroup(target, ct.Name(), m.Name, mg.Signature, m.Span);
            }
            this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                "no field `" + m.Name + "` on `" + ct.Name() + "`", m.Span);
            return new BoundMember(target, m.Name, new Z42ErrorType(), m.Span);
    }

    private FieldSymbol _findField(SymbolTable symbols, Z42ClassType ct, string name) {
        Z42ClassType cur = ct;
        bool more = true;
        while (more) {
            int _sl0 = cur.Fields.Find(name); if (_sl0 >= 0) { return cur.Fields.ValAt(_sl0) as FieldSymbol; }
            if (!cur.HasBase) {
                // 无显式 base 的 class 隐式继承 Object（struct 不继承，但字段不含在 Object）。
                if (cur.Name() != "Object" && symbols.HasClass("Object")) { cur = symbols.GetClass("Object"); }
                else { more = false; }
            } else {
                Z42ClassType b = symbols.GetClass(cur.BaseName);
                if (b == null) { more = false; } else { cur = b; }
            }
        }
        return null;
    }

    // 把类型 t 里出现的**类泛型形参**（按 inst.Def.GenericParamNames 匹配名）替换为 inst 对应的 TypeArgs。
    // 递归：裸 T→arg；T[]→subst(T)[]；嵌套 List<T>→List<subst(T)>。形参名不在 Def 形参表中
    //（如方法级泛型形参 U）→ 松绑 Unknown（沿用旧 GS6 行为，避免误绑）。inst 无形参信息（种子旧 TSIG
    // 未带 GenericParamNames / 非泛型）→ 保守返回 t 原样（不劣化既有解析）。
    public static Z42Type _substGeneric(Z42Type t, Z42InstantiatedType inst) {   // P3a：ExprTyper 检索拆箱亦需
        if (t is Z42GenericParamType) {
            int idx = MemberResolver._paramIndex(inst.Def, t.Name());
            if (idx >= 0 && idx < inst.ArgCount) { return inst.TypeArgs[idx]; }
            return new Z42UnknownType();
        }
        if (t is Z42ArrayType) {
            return new Z42ArrayType(MemberResolver._substGeneric((t as Z42ArrayType).Elem, inst));
        }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it2 = t as Z42InstantiatedType;
            Z42Type[] na = new Z42Type[it2.ArgCount];
            int i = 0;
            while (i < it2.ArgCount) { na[i] = MemberResolver._substGeneric(it2.TypeArgs[i], inst); i = i + 1; }
            return new Z42InstantiatedType(it2.Def, na, it2.ArgCount);
        }
        return t;
    }

    // add-generic-type-arg-inference 阶段 A：整条签名（形参位 + 返回位）按 receiver 的 TypeArgs
    // 做**类泛型形参**代换。与 `_substSelfSig` 同构，只是逐类型的代换函数换成 `_substGeneric`。
    //
    // ⚠️ 产物是**诊断专用**签名：只喂 `CheckArgTypes`，绝不回灌 `_withDefaults` / `BoxArgs` /
    // `ConvertIfNeeded` / `_withParamsExpansion` / 重载决议（不变式 I1，理由见调用点注释）。
    //
    // `ParamsFrom` / `ParamDefaults` / `ParamCallers` 必须**原样搬运**：ctor 只设 ParamsFrom = -1，
    // 漏搬会让 params 变长形参在这条路上退化成定长（CheckArgTypes 的 params 尾位分支读的就是它）。
    // 这条是照抄 `_substSelfSig` 的教训，别重踩。
    private static Z42FuncType _substGenericSig(Z42FuncType sig, Z42InstantiatedType recv) {
        Z42Type[] np = new Z42Type[sig.ParamCount];
        int i = 0;
        while (i < sig.ParamCount) { np[i] = MemberResolver._substGeneric(sig.ParamTypes[i], recv); i = i + 1; }
        Z42FuncType r = new Z42FuncType(np, sig.ParamCount, MemberResolver._substGeneric(sig.Ret, recv));
        r.ParamsFrom = sig.ParamsFrom;
        r.ParamDefaults = sig.ParamDefaults;
        r.ParamCallers = sig.ParamCallers;
        return r;
    }

    // self-return-type-substitution：把签名里的隐式型参 `Self` 换成 `selfT`。
    //
    // `Self` 由 MemberCollector._withSelf 作为**接口的隐式类型参数**并进 paramNames，所以它在签名里
    // 就是一个名叫 "Self" 的 Z42GenericParamType、与真型参 `T` 无差别 —— 但 `T` 有
    // Z42InstantiatedType.TypeArgs 可按下标查（_substGeneric 走的就是那条），`Self` 没有：它绑的是**接收者**。
    //
    // 经**接口静态类型**调用时 selfT = 该接口本身：`IClone c; c.Copy()` → `IClone`，而非型参 `Self` 裸奔。
    // 这是可靠的上界——任何实现方都实现了该接口，故把结果当接口用一定成立。要拿到具体类型就在**具体类**
    // 上调用，那条路走实现方签名、本函数不参与（`Point p; p.Copy()` → `Point`，改动前后都对）。
    // 结构与 _substGeneric 一致（数组 / 泛型实参递归），只是判据从「Def 形参表命中」换成「名叫 Self」。
    public static Z42Type _substSelf(Z42Type t, Z42Type selfT) {
        if (t is Z42GenericParamType) {
            if (t.Name() == "Self") { return selfT; }
            return t;
        }
        if (t is Z42ArrayType) {
            return new Z42ArrayType(MemberResolver._substSelf((t as Z42ArrayType).Elem, selfT));
        }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it2 = t as Z42InstantiatedType;
            Z42Type[] na = new Z42Type[it2.ArgCount];
            int i = 0;
            while (i < it2.ArgCount) { na[i] = MemberResolver._substSelf(it2.TypeArgs[i], selfT); i = i + 1; }
            return new Z42InstantiatedType(it2.Def, na, it2.ArgCount);
        }
        return t;
    }

    // bind-self-param-and-constraint-members Part B：签名的**形参位**是否出现 `Self`（含数组元素 /
    // 泛型实参嵌套）。返回位不算——那条由 `_substSelf` 上界替换处理（#527）。
    private static bool _sigHasSelfParam(Z42FuncType sig) {
        int i = 0;
        while (i < sig.ParamCount) {
            if (MemberResolver._containsSelf(sig.ParamTypes[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    // 结构与 `_substSelf` 同构（数组 / 泛型实参递归），只是「换」改成「找」——**但多下钻一层
    // `Z42FuncType`**（`void Apply(Func<Self,int> f)`）。两者刻意不对称：本函数守的是一条**禁令**，
    // 漏一种形态就是漏一个洞；`_substSelf` 少覆盖一种形态只是少换一次、不产生错误结论。
    // 「禁止侧比替换侧更宽」是安全方向。（镜像 `Conversion._hasGenericParam` 的递归面。）
    private static bool _containsSelf(Z42Type t) {
        if (t == null) { return false; }
        if (t is Z42GenericParamType) { return t.Name() == "Self"; }
        if (t is Z42ArrayType) { return MemberResolver._containsSelf((t as Z42ArrayType).Elem); }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it = t as Z42InstantiatedType;
            int i = 0;
            while (i < it.ArgCount) { if (MemberResolver._containsSelf(it.TypeArgs[i])) { return true; } i = i + 1; }
            return false;
        }
        if (t is Z42FuncType) {
            Z42FuncType ft = t as Z42FuncType;
            int i = 0;
            while (i < ft.ParamCount) { if (MemberResolver._containsSelf(ft.ParamTypes[i])) { return true; } i = i + 1; }
            return MemberResolver._containsSelf(ft.Ret);
        }
        return false;
    }

    // bind-self-param-and-constraint-members Part A：整条签名（形参位 + 返回位）做 `Self` 替换。
    // `_substSelf` 只处理单个类型；约束接口方法要连**形参**一起换，否则 `BindArgsToSignature` 拿到的
    // 形参类型仍是裸型参 `Self` ⇒ `Conversion` 分支 B「恰一侧含型参 → GenericErase」照旧放行，
    // 等于白接。
    //
    // ParamsFrom / ParamDefaults / ParamCallers 必须**原样搬运**：ctor 只设 ParamsFrom = -1，
    // 漏搬会让 params 变长形参在这条路上退化成定长（CheckArgTypes 的 params 尾位分支读的就是它）。
    private static Z42FuncType _substSelfSig(Z42FuncType sig, Z42Type selfT) {
        Z42Type[] np = new Z42Type[sig.ParamCount];
        int i = 0;
        while (i < sig.ParamCount) { np[i] = MemberResolver._substSelf(sig.ParamTypes[i], selfT); i = i + 1; }
        Z42FuncType r = new Z42FuncType(np, sig.ParamCount, MemberResolver._substSelf(sig.Ret, selfT));
        r.ParamsFrom = sig.ParamsFrom;
        r.ParamDefaults = sig.ParamDefaults;
        r.ParamCallers = sig.ParamCallers;
        return r;
    }

    // Def 的有序泛型形参名里查 name 的下标（与 Z42InstantiatedType.TypeArgs 按索引对齐）；无则 -1。
    private static int _paramIndex(Z42ClassType def, string name) {
        int i = 0;
        while (i < def.GenericParamCount) {
            if (def.GenericParamNames[i] == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // add-generic-methods：解析泛型方法调用 `Foo<A,B>(...)` 的类型实参，写入 BoundCall.MethodTypeArgs
    // （解析后的具体 Z42Type[]，ExprEmitter 转 FQ 名编进 IR Call）。ms 有本地 Decl 时校验 arity（E0445）
    // 与 where 约束（复用 ConstraintChecker.CheckMethod）；ms=null / 无 Decl（导入 / 间接）→ 仅解析、跳过校验。
    // 幂等：已附加（MethodTypeArgCount>0）或非泛型调用（TypeArgCount==0）即返回。
    private void _applyMethodTypeArgs(BoundCall bc, CallExpr call, MethodSymbol ms, TypeEnv env) {
        if (call.TypeArgCount == 0 || bc.MethodTypeArgCount > 0) { return; }
        Z42Type[] targs = new Z42Type[call.TypeArgCount];
        int[] fwd = new int[call.TypeArgCount];
        int i = 0;
        while (i < call.TypeArgCount) {
            targs[i] = env.ResolveType(call.TypeArgs[i]);
            this._tc._chkTypeRef(targs[i], env, call.TypeArgs[i].Span);   // 类型实参引用的可访问性/存在性
            // add-generic-activator：类型实参是外层方法的方法级泛型形参（Foo<T>() 里的 T）→ 记其
            // 方法级下标，emit 期发 `$mta:<idx>` 转发标记而非字面 "T"（运行期按调用方 frame 解析）。
            fwd[i] = 0 - 1;
            if (targs[i] is Z42GenericParamType) {
                int mIdx = env.MethodParamIndexOf(targs[i].Name());
                if (mIdx >= 0) { fwd[i] = mIdx; }
            }
            i = i + 1;
        }
        bc.MethodTypeArgs = targs;
        bc.MethodTypeArgFwd = fwd;
        bc.MethodTypeArgCount = call.TypeArgCount;
        if (ms != null && ms.HasDecl && ms.Decl != null) {
            int declTp = ms.Decl.TypeParams.Count;
            if (declTp != call.TypeArgCount) {
                this._tc._diags.Error(DiagnosticCodes.GenericMethodArity,
                    "generic method `" + ms.Name + "` expects " + declTp.ToString()
                    + " type argument(s) but got " + call.TypeArgCount.ToString(), call.Span);
            } else {
                this._tc._constraints.CheckMethod(env.GetSymbols(), ms.Decl, targs, call.TypeArgCount, call.Span);
                // add-generic-type-arg-inference 阶段 B：**形参位**也按已解析的类型实参代换，再补查实参。
                // 此前 targs 只用来写 bc.MethodTypeArgs + 校 arity/where，从不代回签名 ⇒ 形参仍是裸型参
                // ⇒ Conversion 分支 B 擦除放行 ⇒ `IdOf<string>(7)` 编译期零诊断（#531 正面留下的口子）。
                //
                // **刻意不调整执行顺序**：本方法在 `_withDefaults` 之后跑，所以代换结果天然只能影响
                // 诊断、进不了 target-typed new / lambda 绑定 / 装箱决策（不变式 I1）。把它提到
                // `_withDefaults` 之前会立刻打开那四条字节漂移通道。
                //
                // 只对**方法级**型参代换（按 Decl.TypeParams.Names 匹配）；类级型参原样留着，
                // 由阶段 A 那条路负责。导入方法（无 Decl）拿不到有序型参名 ⇒ 本分支进不来，
                // 与既有的 arity/where 校验同一道门，不新增跨包能力。
                MemberResolver._checkSubstMethodArgs(this._tc, bc, ms.Signature, ms.Decl.TypeParams.Names,
                                                    declTp, targs, env);
            }
        }
    }

    // add-generic-type-arg-inference 阶段 B：按方法级型参名做代换后补查实参。
    private static void _checkSubstMethodArgs(TypeChecker tc, BoundCall bc, Z42FuncType sig,
                                              string[] names, int nameCount, Z42Type[] targs, TypeEnv env) {
        if (sig == null) { return; }
        Z42Type[] np = new Z42Type[sig.ParamCount];
        int i = 0;
        while (i < sig.ParamCount) {
            np[i] = MemberResolver._substByName(sig.ParamTypes[i], names, nameCount, targs);
            i = i + 1;
        }
        Z42FuncType subst = new Z42FuncType(np, sig.ParamCount,
            MemberResolver._substByName(sig.Ret, names, nameCount, targs));
        subst.ParamsFrom = sig.ParamsFrom;
        subst.ParamDefaults = sig.ParamDefaults;
        subst.ParamCallers = sig.ParamCallers;
        // rawArgs 传 null：本方法在 BoundCall 构造之后，原始实参表达式已不可得；
        // `_checkOneArg` 的 span 会回落到 args[i].Span（仍指向实参本身，够用）。
        tc._overload.CheckSubstitutedArgs(bc.Args, null, bc.ArgCount, sig, subst, env);
    }

    // 按**名字**把型参替换成对应类型实参（方法级型参用；类级型参走 `_substGeneric` 按下标那条）。
    // 名字不在表里 → **原样返回**（不是 Unknown）：那多半是类级型参，留着让分支 B 继续擦除放行，
    // 由阶段 A 负责。递归面与 `_substGeneric` 一致（数组元素 / 实例化类型实参）。
    private static Z42Type _substByName(Z42Type t, string[] names, int nameCount, Z42Type[] targs) {
        if (t == null) { return t; }
        if (t is Z42GenericParamType) {
            int i = 0;
            while (i < nameCount) {
                if (names[i] == t.Name() && i < targs.Length) { return targs[i]; }
                i = i + 1;
            }
            return t;
        }
        if (t is Z42ArrayType) {
            return new Z42ArrayType(MemberResolver._substByName((t as Z42ArrayType).Elem, names, nameCount, targs));
        }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it = t as Z42InstantiatedType;
            Z42Type[] na = new Z42Type[it.ArgCount];
            int i = 0;
            while (i < it.ArgCount) { na[i] = MemberResolver._substByName(it.TypeArgs[i], names, nameCount, targs); i = i + 1; }
            return new Z42InstantiatedType(it.Def, na, it.ArgCount);
        }
        return t;
    }

    internal BoundExpr _bindCall(CallExpr call, TypeEnv env) {
        BoundExpr[] args = new BoundExpr[call.ArgCount];
        int i = 0;
        // add-target-typed-new：target-typed new 实参延迟绑定（留 null）——形参类型要等重载选定后才知道。
        // 重载决议容忍 null 位（OverloadBinder._resolveOverload），选定后各形态按形参类型回填。
        while (i < call.ArgCount) {
            // R5：lambda 实参与 target-typed new 同款延迟——形参类型要等重载选定后才知道。
            if (ExprTyper.IsTargetTypedNew(call.Args[i]) || ExprTyper.IsLambdaArg(call.Args[i])) { args[i] = null; }
            else { args[i] = this._tc._expr._bindExpr(call.Args[i], env); }
            i = i + 1;
        }
        // 顶层自由函数：f(args)
        if (call.Callee is IdentExpr) {
            IdentExpr id = call.Callee as IdentExpr;
            Z42Type vfn = env.LookupVar(id.Name);
            if (vfn != null && (vfn is Z42FuncType)) {              // Func 值间接调用（port-z42c-closures）
                BoundExpr callee = this._tc._expr._bindExpr(call.Callee, env);
                args = this._tc._overload.BindArgsToSignature(args, call.Args, call.ArgCount, vfn as Z42FuncType, env);
                return new BoundIndirectCall(callee, args, call.ArgCount, (vfn as Z42FuncType).Ret, call.Span);
            }
            // fix-generic-func-param-indirect-call：**型参**局部/形参被当函数调用（`T f` 且
            // `where T : Func<int,int>`）→ 同样是间接调用。镜像下方 :456 已有的 Z42GenericParamType
            // 分支（那条服务 `arr[i](x)` / `m()(x)` 这类**非** IdentExpr callee——不对称就只在这一支）。
            //
            // 此前落到下面的自由函数查找 → E0401「undefined function: f」，而 `CallEmitter` 靠
            // `Locals.ContainsKey("f")` 侥幸救回、发 CallIndirect，于是直接调用能跑、诊断没人看。
            // 但**一旦 f 被 lambda 捕获就真炸**：binder 绑成 BoundCall "free" → 捕获分析压根没看见
            // f 是被捕获变量 → 不发 mk_clos，lambda 体里发 `call @f` 调一个不存在的自由函数，
            // 运行期 `undefined function`。返回类型取 Unknown（与 :456 同口径；func-type 约束本身
            // 仍是 Deferred，拿不到 R）。
            if (vfn != null && (vfn is Z42GenericParamType)) {
                BoundExpr gcallee = this._tc._expr._bindExpr(call.Callee, env);
                args = this._tc._overload.BindArgsToSignature(args, call.Args, call.ArgCount, null, env);
                return new BoundIndirectCall(gcallee, args, call.ArgCount, new Z42UnknownType(), call.Span);
            }
            // impl-local-fn-l2：局部函数调用 → BoundCall "free"（local 名；emit 期改写为 lifted 名）。
            Z42FuncType lfsig = env.LookupLocalFn(id.Name);
            if (lfsig != null) {
                args = this._tc._overload.BindArgsToSignature(args, call.Args, call.ArgCount, lfsig, env);
                return new BoundCall("free", false, null, "", id.Name, args, call.ArgCount, lfsig.Ret, call.Span);
            }
            if (env.Symbols.HasFunc(id.Name)) {
                MethodSymbol ms = env.Symbols.GetFunc(id.Name);
                BoundExpr[] fa = this._tc._overload._withDefaults(ms, args, call.Args, call.ArgCount, env, call.Span);
                BoundCall bc = new BoundCall("free", false, null, "", id.Name, fa, fa.Length, ms.Signature.Ret, call.Span);
                this._applyMethodTypeArgs(bc, call, ms, env);
                return bc;
            }
            // 同类无限定静态调用（unqualified static call within class body：OSKindValue() inside Platform）。
            if (env.HasClass()) {
                string cls = env.CurrentClass();
                if (env.Symbols.HasClass(cls)) {
                    Z42ClassType sct = env.Symbols.GetClass(cls);
                    MethodSymbol sms = this._tc._overload._resolveOverload(env.Symbols, sct, id.Name, args, call.ArgCount, call.TypeArgCount, call.Span);
                    if (sms != null && sms.IsStatic) {
                        // add-params-varargs：本路径（同类无限定静态调用）不经 _withDefaults，
                        // 但仍须为选中的 params 重载打包 trailing 实参，否则 codegen 收到未打包实参形状。
                        args = this._tc._overload.BindArgsToSignature(args, call.Args, call.ArgCount, sms.Signature, env);
                        BoundExpr[] fa = args;
                        if (sms.Signature.ParamsFrom >= 0) { fa = this._tc._overload._withParamsExpansion(sms, args, call.ArgCount, call.Span, env.Symbols); }
                        BoundCall bc = new BoundCall("static", false, null, cls, sms.RegKey, fa, fa.Length, sms.Signature.Ret, call.Span);
                        this._applyMethodTypeArgs(bc, call, sms, env);
                        return bc;
                    }
                }
            }
            this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol, "undefined function: " + id.Name, call.Span);
            args = this._tc._overload.BindArgsToSignature(args, call.Args, call.ArgCount, null, env);   // add-target-typed-new：错误路径清 null 占位
            return new BoundCall("free", false, null, "", id.Name, args, call.ArgCount, new Z42ErrorType(), call.Span);
        }
        // 成员调用：obj.m(args) / Class.m(args)
        if (call.Callee is MemberExpr) {
            BoundExpr mr = this._bindMemberCall(call.Callee as MemberExpr, args, call.ArgCount, call.Args, env, call.Span, call);
            // add-generic-methods：兜底——静态 Class.m 与（complete-where-constraints 起）有本地 Decl 的
            // instance 路径都已在 _bindMemberCall / _bindInstanceMemberCall 内**带真 ms** 校验过，
            // 此处对它们因 `MethodTypeArgCount > 0` 幂等早退。剩下真正无本地 Decl 的路径
            // （imported / prim / loose 绑定）在此仅解析类型实参、不校验，保证运行期拿到 type_args。
            if (mr is BoundCall) { this._applyMethodTypeArgs(mr as BoundCall, call, null, env); }
            return mr;
        }
        // 通用间接调用：array[i](args) / method()(args) 等 callee 是任意表达式且类型为 Z42FuncType。
        // Z42GenericParamType：泛型接口方法返回类型参数（如 ISubscription<TD>.Get()→TD）；type-erased，运行期解析。
        {
            BoundExpr callee = this._tc._expr._bindExpr(call.Callee, env);
            Z42Type ct = callee.Type();
            if (ct is Z42FuncType) {
                args = this._tc._overload.BindArgsToSignature(args, call.Args, call.ArgCount, ct as Z42FuncType, env);
                return new BoundIndirectCall(callee, args, call.ArgCount, (ct as Z42FuncType).Ret, call.Span);
            }
            if (ct is Z42GenericParamType) {
                args = this._tc._overload.BindArgsToSignature(args, call.Args, call.ArgCount, null, env);   // 类型未知 → target-typed 实参报 E0437
                return new BoundIndirectCall(callee, args, call.ArgCount, new Z42UnknownType(), call.Span);
            }
        }
        this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "unsupported call form", call.Span);
        return new BoundError("unsupported call", new Z42ErrorType(), call.Span);
    }

    private BoundExpr _bindMemberCall(MemberExpr mem, BoundExpr[] args, int argCount, Expr[] rawArgs, TypeEnv env, Span sp, CallExpr call) {
        // fix-namespace-qualified-free-call：`ns.func()` 当 ns=当前命名空间且 func 是自由函数
        // → 自由调用（否则被误当类 ns 的静态调用 → 双限定 ns.ns.func → 运行期 undefined）。
        if (mem.Target is IdentExpr) {
            IdentExpr nsId = mem.Target as IdentExpr;
            if (this._tc._currentNs != "" && nsId.Name == this._tc._currentNs
                && env.LookupVar(nsId.Name) == null && env.Symbols.HasFunc(mem.Name)) {
                MethodSymbol nfs = env.Symbols.GetFunc(mem.Name);
                args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, nfs.Signature, env);
                return new BoundCall("free", false, null, "", mem.Name, args, argCount, nfs.Signature.Ret, sp);
            }
        }
        // 静态：target 是裸类名（非局部变量）→ Class.m(args)
        if (mem.Target is IdentExpr) {
            IdentExpr tid = mem.Target as IdentExpr;
            if (env.LookupVar(tid.Name) == null && env.Symbols.HasClass(tid.Name)) {
                Z42ClassType ct = env.Symbols.GetClass(tid.Name);
                MethodSymbol ms = this._tc._overload._resolveOverload(env.Symbols, ct, mem.Name, args, argCount, call.TypeArgCount, sp);   // 限定名静态调用（Array.Sort<int>）→ 传显式类型实参个数启用 arity 过滤
                if (ms != null) {
                    this._tc._access.CheckAccess(ms.Visibility, ms.ContainingTypeName, env, env.Symbols, "method", mem.Name, sp);   // enforce-access-control
                    this._tc._access.CheckDeprecatedM(ms, mem.Name, sp);   // add-deprecated-directive
                    BoundExpr[] fa = this._tc._overload._withDefaults(ms, args, rawArgs, argCount, env, sp);
                    BoundCall bc = new BoundCall("static", false, null, ct.Name(), ms.RegKey, fa, fa.Length, ms.Signature.Ret, sp);
                    this._applyMethodTypeArgs(bc, call, ms, env);   // add-generic-methods：静态泛型方法（serde 招牌路径）
                    return bc;
                }
                this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                    "no static method `" + mem.Name + "` on `" + ct.Name() + "`", sp);
                args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
                return new BoundCall("static", false, null, tid.Name, mem.Name, args, argCount, new Z42ErrorType(), sp);
            }
        }
        // GS6: prim 关键字静态调用（int.Parse / string.FromChars 等）→ wrapper class 静态方法
        if (mem.Target is IdentExpr) {
            IdentExpr tid2 = mem.Target as IdentExpr;
            if (env.LookupVar(tid2.Name) == null && TypeFactsTc._isPrimKeyword(tid2.Name)) {
                string pwrap2 = TypeFactsTc._primWrapper(tid2.Name);
                if (env.Symbols.HasClass(pwrap2)) {
                    Z42ClassType wct2 = env.Symbols.GetClass(pwrap2);
                    // stabilize-dispatch-keys（方案A，静态-only）：prim 关键字静态调用（int.Parse / string.FromChars）
                    // 是【静态】方法 → 静态-only 下恒全签名 mangle。旧 _overloadKey/_findMethod（裸名/Name$arity）
                    // 查不到已 mangle 的静态方法 → 必须走 _resolveOverload 拿 RegKey。（prim 实例方法不 mangle，走上方裸键路径。）
                    MethodSymbol wms2 = this._tc._overload._resolveOverload(env.Symbols, wct2, mem.Name, args, argCount, call.TypeArgCount, sp);
                    if (wms2 != null) {
                        // params 打包 / 默认参数填充（与上方类限定静态调用一致）：keyword 静态调用此前不经
                        // _withDefaults，靠精确 arity 重载兜底；params-for-Join 移除了 `Join(string,string,string,string)`
                        // 精确重载后，`string.Join("-","x","y","z")` 的 expanded form 需在此打包成 string[]，
                        // 否则以 4 裸实参调 `Join$2$string$string[]`（2 形参）→ arity 不符。
                        BoundExpr[] fa2 = this._tc._overload._withDefaults(wms2, args, rawArgs, argCount, env, sp);
                        return new BoundCall("static", false, null, pwrap2, wms2.RegKey, fa2, fa2.Length, wms2.Signature.Ret, sp);
                    }
                    this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                        "no static method `" + mem.Name + "` on `" + pwrap2 + "`", sp);
                    args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
                    return new BoundCall("static", false, null, pwrap2, mem.Name, args, argCount, new Z42ErrorType(), sp);
                }
            }
        }
        // fix-ns-qualified-static-call（欠债表 bug B7）：**ns 限定**静态调用 `Std.IO.Console.WriteLine(…)`。
        // 上面三条静态分支都要求 `mem.Target is IdentExpr`，而限定形式的 target 是嵌套 MemberExpr
        // （`Std.IO.Console`）⇒ 全部落空 → 直冲下方实例路径 → 递归到最里层把 `Std` 当变量查
        // → `E0401: undefined: Std`（裸名 `Console.WriteLine` 一直正常，故全仓无人这么写、长期没暴露）。
        //
        // 判别：点串拍平成 `<prefix>.<Short>`，prefix 须是本 CU 可见的 ns（using 集 ∪ 本 ns），
        // 且根标识符不能是局部变量（否则 `a.b.M()` 这类真实例链会被劫持）。命中就按短名走
        // 与裸名**完全同一条**静态决议路径 —— 即不改变歧义语义（同短名跨 ns 仍 first-wins，
        // 消歧要等 imported 类补上 Namespace，见 tasks.md「后续」）。
        string qpath = MemberResolver._dottedPath(mem.Target);
        if (qpath != "") {
            int lastDot = qpath.LastIndexOf(".");
            if (lastDot > 0) {
                string qns = qpath.Substring(0, lastDot);
                string qcls = qpath.Substring(lastDot + 1);
                if (this._tc._isVisibleNs(qns) && env.Symbols.HasClass(qcls)
                    && env.LookupVar(MemberResolver._rootIdent(mem.Target)) == null) {
                    Z42ClassType qct = env.Symbols.GetClass(qcls);
                    MethodSymbol qms = this._tc._overload._resolveOverload(env.Symbols, qct, mem.Name, args, argCount, call.TypeArgCount, sp);
                    if (qms != null) {
                        this._tc._access.CheckAccess(qms.Visibility, qms.ContainingTypeName, env, env.Symbols, "method", mem.Name, sp);
                        this._tc._access.CheckDeprecatedM(qms, mem.Name, sp);
                        BoundExpr[] qfa = this._tc._overload._withDefaults(qms, args, rawArgs, argCount, env, sp);
                        BoundCall qbc = new BoundCall("static", false, null, qct.Name(), qms.RegKey, qfa, qfa.Length, qms.Signature.Ret, sp);
                        this._applyMethodTypeArgs(qbc, call, qms, env);
                        return qbc;
                    }
                    this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                        "no static method `" + mem.Name + "` on `" + qct.Name() + "`", sp);
                    args = this._tc._overload.BindArgsToSignature(args, rawArgs, argCount, null, env);
                    return new BoundCall("static", false, null, qcls, mem.Name, args, argCount, new Z42ErrorType(), sp);
                }
            }
        }
        // 实例：bind target 为值
        BoundExpr recv = this._tc._expr._bindExpr(mem.Target, env);
        Z42Type rt = recv.Type();
        return this._bindInstanceMemberCall(mem, recv, rt, args, argCount, rawArgs, env, sp, call);
    }

    // 纯 Ident/Member 链 → 点串（`Std.IO.Console`）。链上出现任何别的表达式（调用 / 下标 / this…）
    // 返回 ""——只有纯名字链才可能是 ns 限定。
    private static string _dottedPath(Expr e) {
        if (e is IdentExpr) { return (e as IdentExpr).Name; }
        if (e is MemberExpr) {
            MemberExpr m = e as MemberExpr;
            string head = MemberResolver._dottedPath(m.Target);
            if (head == "") { return ""; }
            return head + "." + m.Name;
        }
        return "";
    }

    // 点串链最里层的标识符名（`Std.IO.Console` → `Std`）；非名字链返回 ""。
    private static string _rootIdent(Expr e) {
        if (e is IdentExpr) { return (e as IdentExpr).Name; }
        if (e is MemberExpr) { return MemberResolver._rootIdent((e as MemberExpr).Target); }
        return "";
    }

}