// 成员解析 + 调用子绑定器（compiler-review P1-1：拆 TypeChecker God-Class step 2）。
// 持 TypeChecker 反向引用 _tc：跨界经 _tc._bindExpr（ExprTyper）/_tc._overload（重载决议）/
// _tc._diags / _tc._currentNs；prim 谓词走 TypeChecker 静态。同组方法互调仍 this._X。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;

public sealed class MemberResolver {
    private TypeChecker _tc;
    public MemberResolver(TypeChecker tc) { this._tc = tc; }

    internal BoundExpr _bindMember(MemberExpr m, TypeEnv env) {
        // 裸类名静态字段读（SA-2）：Sev.Error——target 是类名（非变量）→ StaticGet
        if (m.Target is IdentExpr) {
            IdentExpr tid = m.Target as IdentExpr;
            if (env.LookupVar(tid.Name) == null && env.Symbols.HasClass(tid.Name)) {
                Z42ClassType sct = env.Symbols.GetClass(tid.Name);
                FieldSymbol sfs = sct.Fields.Get(m.Name) as FieldSymbol;
                if (sfs != null && sfs.IsStatic) {
                    this._tc._access.CheckAccess(sfs.Visibility, sfs.ContainingTypeName, env, env.Symbols, "field", m.Name, m.Span);   // enforce-access-control
                    return new BoundStaticGet(tid.Name, m.Name, sfs.FieldType, m.Span);
                }
            }
            // 枚举常量访问 `EnumType.Member` → BoundLitInt（long）。
            if (env.LookupVar(tid.Name) == null && env.Symbols.EnumTypes.ContainsKey(tid.Name)) {
                string ekey = tid.Name + "." + m.Name;
                if (env.Symbols.EnumConsts.ContainsKey(ekey)) {
                    StrBox evalBox = env.Symbols.EnumConsts.Get(ekey) as StrBox;
                    return new BoundLitInt(evalBox.Value, Z42ClassType.Builtin("long"), m.Span);
                }
            }
        }
        BoundExpr target = this._tc._expr._bindExpr(m.Target, env);
        Z42Type tt = target.Type();
        return this._bindInstanceMember(m, target, tt, env);
    }

    private BoundExpr _bindInstanceMemberCall(MemberExpr mem, BoundExpr recv, Z42Type rt, BoundExpr[] args, int argCount, Expr[] rawArgs, TypeEnv env, Span sp) {
        // unify-value-types Phase 1：翻转后基元/string/object 为 Z42ClassType——**排除内建**，让其
        // 继续走下方 prim-wrapper 派发路径（declClass 用 keyword 名、键用 _overloadKey），与翻转前
        // Z42PrimType 收者逐字节同义。用户 class/struct（非内建）仍走此类分支。
        if ((rt is Z42ClassType) && !PrimModel.IsBuiltin(rt.Name())) {
            Z42ClassType ct = rt as Z42ClassType;
            // 阶段 3：受者可能是**空方法 stub**——`ImportedSymbolLoader._resolve` 对未在 per-import
            // `r.Classes` 加载的类名（如无 `using Z42.IR` 时经字段类型间接可知的 StrMap）落兜底产
            // `Z42ClassType.Builtin(name)`（无成员）。翻转前该兜底是 Z42PrimType，MemberResolver 走 prim
            // 路径按名重解析/loose 绑定；翻转成 ClassType 后须复刻同款以维 byte-identical：
            //   ① ct 无方法而主符号表有同名真类 → 重解析成真类（prim 路径 HasClass 分支）；
            //   ② ct 无方法且主符号表无（懒加载未载真类）→ 下方 ms==null 时 **loose 绑定 Unknown**，
            //      不报 "no method"（prim 路径 fallthrough，运行期经 DepIndex 解析）。
            bool _stub = ct.Methods.Keys().Length == 0;
            if (_stub && env.Symbols.HasClass(ct.Name())) { ct = env.Symbols.GetClass(ct.Name()); _stub = false; }
            MethodSymbol ms = this._tc._overload._resolveOverload(env.Symbols, ct, mem.Name, args, argCount, sp);
            if (ms != null) {
                this._tc._access.CheckAccess(ms.Visibility, ms.ContainingTypeName, env, env.Symbols, "method", mem.Name, sp);   // enforce-access-control
                BoundExpr[] fa = this._tc._overload._withDefaults(ms, args, rawArgs, argCount, env, sp);
                return new BoundCall("instance", true, recv, ct.Name(), ms.RegKey, fa, fa.Length, ms.Signature.Ret, sp);
            }
            if (_stub) {   // 懒加载 stub 受者、主符号表无真类 → loose 绑定（镜像翻转前 prim 路径 fallthrough，无 "no method"）
                args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);
                return new BoundCall("instance", true, recv, ct.Name(), mem.Name, args, argCount, new Z42UnknownType(), sp);
            }
            this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                "no method `" + mem.Name + "` on `" + ct.Name() + "`", sp);
            args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);   // add-target-typed-new：错误路径清 null 占位
            return new BoundCall("instance", true, recv, ct.Name(), mem.Name, args, argCount, new Z42ErrorType(), sp);
        }
        if (rt is Z42InterfaceType) {                                // 接口收者（port-z42c-interface）
            Z42InterfaceType it = rt as Z42InterfaceType;
            MethodSymbol ims = it.Methods.Get(mem.Name) as MethodSymbol;
            if (ims != null) {
                args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, ims.Signature, env);   // add-target-typed-new：接口方法按形参类型回填
                return new BoundCall("instance", true, recv, it.Name(), mem.Name, args, argCount, ims.Signature.Ret, sp);
            }
            this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                "no method `" + mem.Name + "` on interface `" + it.Name() + "`", sp);
            args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);
            return new BoundCall("instance", true, recv, it.Name(), mem.Name, args, argCount, new Z42ErrorType(), sp);
        }
        if ((rt is Z42ErrorType) || (rt is Z42UnknownType)) {
            args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);
            return new BoundCall("instance", true, recv, "<?>", mem.Name, args, argCount, new Z42ErrorType(), sp);
        }
        // GS6: 泛型实例化类型（List<string>.ToArray() / LinkedList<T>.Next() 等）→ 查 Def 类方法，
        // 返回类型里的**类泛型形参**按 receiver 的 TypeArgs 替换（T→string；T[]→string[]；嵌套递归）。
        // 形参名不在 Def.GenericParamNames 中（方法级泛型形参）→ 松绑 Unknown（沿用旧行为）。
        if (rt is Z42InstantiatedType) {
            Z42InstantiatedType instRecv = rt as Z42InstantiatedType;
            Z42ClassType itDef2 = instRecv.Def;
            MethodSymbol itms = this._tc._overload._resolveOverload(env.Symbols, itDef2, mem.Name, args, argCount, sp);
            if (itms != null) {
                Z42Type itRet = MemberResolver._substGeneric(itms.Signature.Ret, instRecv);
                BoundExpr[] fa = this._tc._overload._withDefaults(itms, args, rawArgs, argCount, env, sp);
                // add-struct-generic-boxing (P3a)：方法返回 type-param 且 subst 为 blob 值 struct（如
                // `List<P>.First()`）→ 返回装箱值 → 包 BoundConvert 拆箱回值 struct（内层 call 类型 Unknown
                // 触发 _emitConvert AsCast 拆箱臂）。
                Z42Type ubR = this._tc.StructUnboxTarget(itms.Signature.Ret, instRecv);
                if (ubR != null) {
                    BoundExpr rawM = new BoundCall("instance", true, recv, itDef2.Name(), itms.RegKey, fa, fa.Length, new Z42UnknownType(), sp);
                    return new BoundConvert(rawM, ubR, sp);
                }
                return new BoundCall("instance", true, recv, itDef2.Name(), itms.RegKey, fa, fa.Length, itRet, sp);
            }
            args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);
            return new BoundCall("instance", true, recv, itDef2.Name(), mem.Name, args, argCount, new Z42UnknownType(), sp);
        }
        // Z42GenericParamType：T.GetHashCode() 等继承自 Object 的方法 → 查 Object 类取真实返回类型。
        if (rt is Z42GenericParamType) {
            if (env.Symbols.HasClass("Object")) {
                Z42ClassType objCt = env.Symbols.GetClass("Object");
                string gpMkey = this._tc._overload._overloadKey(env.Symbols, objCt, mem.Name, argCount);
                MethodSymbol gpMs = this._tc._overload._findMethod(env.Symbols, objCt, gpMkey);
                if (gpMs != null) {
                    args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, gpMs.Signature, env);
                    return new BoundCall("instance", true, recv, rt.Name(), gpMkey, args, argCount, gpMs.Signature.Ret, sp);
                }
            }
            args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);
            return new BoundCall("instance", true, recv, rt.Name(), mem.Name, args, argCount, new Z42UnknownType(), sp);
        }
        // prim receiver（IC-3，镜像 C#）：prim 名首字母大写 → stdlib 包装类（"string"→"String"，
        // imported 自 z42.core TSIG）→ 取方法 ret 真类型（dst tag 字节实证 Str 非 Unknown）；
        // 查无则松绑定 Unknown（codegen 经 DepIndex 真实解析）。
        string wrapper = TypeFactsTc._primWrapper(rt.Name());
        if (env.Symbols.HasClass(wrapper)) {
            Z42ClassType wct = env.Symbols.GetClass(wrapper);
            // stabilize-dispatch-keys（方案A，静态-only）：prim 收者的实例方法（string.StartsWith 等）保持
            // 基线键规则（bare / Name$arity），故沿用 _overloadKey/_findMethod。静态-only 不 mangle 实例方法，
            // 无需改此路径。（prim 静态 int.Parse/string.FromChars 走下方独立路径，那里才用 RegKey。）
            string mkey = this._tc._overload._overloadKey(env.Symbols, wct, mem.Name, argCount);
            MethodSymbol wms = this._tc._overload._findMethod(env.Symbols, wct, mkey);
            if (wms != null) {
                args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, wms.Signature, env);
                return new BoundCall("instance", true, recv, PrimModel.Keyword(rt.Name()), mkey, args, argCount, wms.Signature.Ret, sp);
            }
        }
        args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);
        return new BoundCall("instance", true, recv, PrimModel.Keyword(rt.Name()), mem.Name, args, argCount, new Z42UnknownType(), sp);
    }

    private BoundExpr _bindInstanceMember(MemberExpr m, BoundExpr target, Z42Type tt, TypeEnv env) {
        // unify-value-types Phase 1：排除内建 Z42ClassType，让 string.Length（下方特例）+ 其余基元成员
        // 走 prim-wrapper 路径，与翻转前 Z42PrimType 收者同款。用户 class/struct 仍走类成员访问。
        if ((tt is Z42ClassType) && !PrimModel.IsBuiltin(tt.Name())) { return this._bindClassMemberAccess(m, target, tt as Z42ClassType, env); }
        // 接口收者属性访问：get_<Name>() 虚调用（接口 getter 已注册为 get_X 方法符号）。
        if (tt is Z42InterfaceType) {
            Z42InterfaceType it = tt as Z42InterfaceType;
            MethodSymbol ig = it.Methods.Get("get_" + m.Name) as MethodSymbol;
            if (ig != null && ig.Signature != null) {
                return new BoundCall("instance", true, target, it.Name(), "get_" + m.Name, new BoundExpr[0], 0, ig.Signature.Ret, m.Span);
            }
            return new BoundMember(target, m.Name, new Z42ErrorType(), m.Span);
        }
        // Length on array OR string → int；Count → int（镜像 C# TypeChecker.Exprs.Members 行 161-164：
        // `m.Member is "Length" && (target.Type is Z42ArrayType || target.Type == Z42Type.String)`）。
        // unify-value-types Phase 1：翻转后 string→Z42ClassType(String)——追加 Canon=="string" 判定
        // （翻转前无该拼写 Z42ClassType 流经 → 中立）。
        if (m.Name == "Length" && ((tt is Z42ArrayType) || ((tt is Z42ClassType) && PrimModel.Canon(tt.Name()) == "string"))) {
            return new BoundMember(target, m.Name, Z42ClassType.Builtin("int"), m.Span);
        }
        if (m.Name == "Count") {
            return new BoundMember(target, m.Name, Z42ClassType.Builtin("int"), m.Span);
        }
        if ((tt is Z42ErrorType) || (tt is Z42UnknownType)) {
            return new BoundMember(target, m.Name, new Z42ErrorType(), m.Span);
        }
        // GS5：泛型类型形参（TKey/TValue 等）上的成员访问松绑到 Unknown（调用方再按 DepIndex 真实解析）。
        if (tt is Z42GenericParamType) {
            return new BoundMember(target, m.Name, new Z42UnknownType(), m.Span);
        }
        // GS6: 泛型实例化类型（LinkedListNode<T> 等）成员访问 → 查 Def 类字段，字段类型里的类形参
        // 按 receiver TypeArgs 替换（与方法返回同一 _substGeneric）；形参名不在 Def 形参表 → Unknown。
        if (tt is Z42InstantiatedType) {
            Z42InstantiatedType instT = tt as Z42InstantiatedType;
            Z42ClassType itDef = instT.Def;
            FieldSymbol itFs = this._findField(env.Symbols, itDef, m.Name);
            if (itFs != null) {
                Z42Type fType = MemberResolver._substGeneric(itFs.FieldType, instT);
                return new BoundMember(target, m.Name, fType, m.Span);
            }
            return new BoundMember(target, m.Name, new Z42UnknownType(), m.Span);
        }
        // prim receiver 属性访问（镜像 _bindMemberCall 的 prim 处理）：prim 名首字母大写 →
        // stdlib 包装类（"string"→"String"，imported 自 z42.core TSIG）→ 取字段/属性真类型；
        // 查无则松绑 Unknown（codegen 经 DepIndex/VM builtin 真实解析，如 string.Length）。
        string wrapper = TypeFactsTc._primWrapper(tt.Name());
        if (env.Symbols.HasClass(wrapper)) {
            Z42ClassType wct = env.Symbols.GetClass(wrapper);
            FieldSymbol wfs = this._findField(env.Symbols, wct, m.Name);
            if (wfs != null) { return new BoundMember(target, m.Name, wfs.FieldType, m.Span); }
            // 属性 getter 派发（镜像上面 Z42ClassType 分支）：wrapper 类的 extern 属性
            // （如 String.ByteLength）注册为 get_<Name> 方法而非字段，须同样查 getter
            // 才能拿到真实返回类型；否则误判 "member access on non-class" 或松绑 Unknown。
            MethodSymbol wgetter = this._tc._overload._findMethod(env.Symbols, wct, "get_" + m.Name);
            if (wgetter != null && wgetter.Signature != null) {
                return new BoundCall("instance", true, target, PrimModel.Keyword(tt.Name()), "get_" + m.Name, new BoundExpr[0], 0, wgetter.Signature.Ret, m.Span);
            }
            return new BoundMember(target, m.Name, new Z42UnknownType(), m.Span);
        }
        this._tc._diags.Error(DiagnosticCodes.TypeMismatch,
            "member access on non-class `" + tt.Name() + "`", m.Span);
        return new BoundMember(target, m.Name, new Z42ErrorType(), m.Span);
    }

    private BoundExpr _bindClassMemberAccess(MemberExpr m, BoundExpr target, Z42ClassType ct, TypeEnv env) {
            FieldSymbol fs = this._findField(env.Symbols, ct, m.Name);
            if (fs != null) {
                this._tc._access.CheckAccess(fs.Visibility, fs.ContainingTypeName, env, env.Symbols, "field", m.Name, m.Span);   // enforce-access-control
                return new BoundMember(target, m.Name, fs.FieldType, m.Span);
            }
            // 属性 getter 派发：无字段但有 get_<Name>(0 参) → 虚调用 getter（镜像 C#）。
            MethodSymbol getter = this._tc._overload._findMethod(env.Symbols, ct, "get_" + m.Name);
            if (getter != null && getter.Signature != null) {
                this._tc._access.CheckAccess(getter.Visibility, getter.ContainingTypeName, env, env.Symbols, "property", m.Name, m.Span);   // enforce-access-control
                return new BoundCall("instance", true, target, ct.Name(), "get_" + m.Name, new BoundExpr[0], 0, getter.Signature.Ret, m.Span);
            }
            // 实例方法组（D-1b）：`obj.Method` 作值（非调用）→ BoundMethodGroup（emit 合成 thunk+MkClos）。
            // stabilize-dispatch-keys（方案A，静态-only）：实例方法保持基线键 → 沿用 _findMethod 按源名查（unique
            // bare / arity 重载 Name$arity）。静态-only 不 mangle 实例方法，此路径不变。
            MethodSymbol mg = this._tc._overload._findMethod(env.Symbols, ct, m.Name);
            if (mg != null && mg.Signature != null) {
                this._tc._access.CheckAccess(mg.Visibility, mg.ContainingTypeName, env, env.Symbols, "method", m.Name, m.Span);   // enforce-access-control
                return new BoundMethodGroup(target, ct.Name(), m.Name, mg.Signature, m.Span);
            }
            this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                "no field `" + m.Name + "` on `" + ct.Name() + "`", m.Span);
            return new BoundMember(target, m.Name, new Z42ErrorType(), m.Span);
    }

    private FieldSymbol _findField(SymbolTable symbols, Z42ClassType ct, string name) {
        Z42ClassType cur = ct;
        bool more = true;
        while (more) {
            if (cur.Fields.ContainsKey(name)) { return cur.Fields.Get(name) as FieldSymbol; }
            if (!cur.HasBase) {
                // 无显式 base 的 class 隐式继承 Object（struct 不继承，但字段不含在 Object）。
                if (cur.Name() != "Object" && symbols.HasClass("Object")) { cur = symbols.GetClass("Object"); }
                else { more = false; }
            } else {
                Z42ClassType b = symbols.GetClass(cur.BaseName);
                if (b == null) { more = false; } else { cur = b; }
            }
        }
        return null;
    }

    // 把类型 t 里出现的**类泛型形参**（按 inst.Def.GenericParamNames 匹配名）替换为 inst 对应的 TypeArgs。
    // 递归：裸 T→arg；T[]→subst(T)[]；嵌套 List<T>→List<subst(T)>。形参名不在 Def 形参表中
    //（如方法级泛型形参 U）→ 松绑 Unknown（沿用旧 GS6 行为，避免误绑）。inst 无形参信息（种子旧 TSIG
    // 未带 GenericParamNames / 非泛型）→ 保守返回 t 原样（不劣化既有解析）。
    public static Z42Type _substGeneric(Z42Type t, Z42InstantiatedType inst) {   // P3a：ExprTyper 检索拆箱亦需
        if (t is Z42GenericParamType) {
            int idx = MemberResolver._paramIndex(inst.Def, t.Name());
            if (idx >= 0 && idx < inst.ArgCount) { return inst.TypeArgs[idx]; }
            return new Z42UnknownType();
        }
        if (t is Z42ArrayType) {
            return new Z42ArrayType(MemberResolver._substGeneric((t as Z42ArrayType).Elem, inst));
        }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it2 = t as Z42InstantiatedType;
            Z42Type[] na = new Z42Type[it2.ArgCount];
            int i = 0;
            while (i < it2.ArgCount) { na[i] = MemberResolver._substGeneric(it2.TypeArgs[i], inst); i = i + 1; }
            return new Z42InstantiatedType(it2.Def, na, it2.ArgCount);
        }
        return t;
    }

    // Def 的有序泛型形参名里查 name 的下标（与 Z42InstantiatedType.TypeArgs 按索引对齐）；无则 -1。
    private static int _paramIndex(Z42ClassType def, string name) {
        int i = 0;
        while (i < def.GenericParamCount) {
            if (def.GenericParamNames[i] == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    internal BoundExpr _bindCall(CallExpr call, TypeEnv env) {
        BoundExpr[] args = new BoundExpr[call.ArgCount];
        int i = 0;
        // add-target-typed-new：target-typed new 实参延迟绑定（留 null）——形参类型要等重载选定后才知道。
        // 重载决议容忍 null 位（OverloadBinder._resolveOverload），选定后各形态按形参类型回填。
        while (i < call.ArgCount) {
            if (ExprTyper.IsTargetTypedNew(call.Args[i])) { args[i] = null; }
            else { args[i] = this._tc._expr._bindExpr(call.Args[i], env); }
            i = i + 1;
        }
        // 顶层自由函数：f(args)
        if (call.Callee is IdentExpr) {
            IdentExpr id = call.Callee as IdentExpr;
            Z42Type vfn = env.LookupVar(id.Name);
            if (vfn != null && (vfn is Z42FuncType)) {              // Func 值间接调用（port-z42c-closures）
                BoundExpr callee = this._tc._expr._bindExpr(call.Callee, env);
                args = this._tc._overload.FillDeferredArgs(args, call.Args, call.ArgCount, vfn as Z42FuncType, env);
                return new BoundIndirectCall(callee, args, call.ArgCount, (vfn as Z42FuncType).Ret, call.Span);
            }
            // impl-local-fn-l2：局部函数调用 → BoundCall "free"（local 名；emit 期改写为 lifted 名）。
            Z42FuncType lfsig = env.LookupLocalFn(id.Name);
            if (lfsig != null) {
                args = this._tc._overload.FillDeferredArgs(args, call.Args, call.ArgCount, lfsig, env);
                return new BoundCall("free", false, null, "", id.Name, args, call.ArgCount, lfsig.Ret, call.Span);
            }
            if (env.Symbols.HasFunc(id.Name)) {
                MethodSymbol ms = env.Symbols.GetFunc(id.Name);
                BoundExpr[] fa = this._tc._overload._withDefaults(ms, args, call.Args, call.ArgCount, env, call.Span);
                return new BoundCall("free", false, null, "", id.Name, fa, fa.Length, ms.Signature.Ret, call.Span);
            }
            // 同类无限定静态调用（unqualified static call within class body：OSKindValue() inside Platform）。
            if (env.HasClass()) {
                string cls = env.CurrentClass();
                if (env.Symbols.HasClass(cls)) {
                    Z42ClassType sct = env.Symbols.GetClass(cls);
                    MethodSymbol sms = this._tc._overload._resolveOverload(env.Symbols, sct, id.Name, args, call.ArgCount, call.Span);
                    if (sms != null && sms.IsStatic) {
                        // add-params-varargs：本路径（同类无限定静态调用）不经 _withDefaults，
                        // 但仍须为选中的 params 重载打包 trailing 实参，否则 codegen 收到未打包实参形状。
                        args = this._tc._overload.FillDeferredArgs(args, call.Args, call.ArgCount, sms.Signature, env);
                        BoundExpr[] fa = args;
                        if (sms.Signature.ParamsFrom >= 0) { fa = this._tc._overload._withParamsExpansion(sms, args, call.ArgCount, call.Span, env.Symbols); }
                        return new BoundCall("static", false, null, cls, sms.RegKey, fa, fa.Length, sms.Signature.Ret, call.Span);
                    }
                }
            }
            this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol, "undefined function: " + id.Name, call.Span);
            args = this._tc._overload.FillDeferredArgs(args, call.Args, call.ArgCount, null, env);   // add-target-typed-new：错误路径清 null 占位
            return new BoundCall("free", false, null, "", id.Name, args, call.ArgCount, new Z42ErrorType(), call.Span);
        }
        // 成员调用：obj.m(args) / Class.m(args)
        if (call.Callee is MemberExpr) {
            return this._bindMemberCall(call.Callee as MemberExpr, args, call.ArgCount, call.Args, env, call.Span);
        }
        // 通用间接调用：array[i](args) / method()(args) 等 callee 是任意表达式且类型为 Z42FuncType。
        // Z42GenericParamType：泛型接口方法返回类型参数（如 ISubscription<TD>.Get()→TD）；type-erased，运行期解析。
        {
            BoundExpr callee = this._tc._expr._bindExpr(call.Callee, env);
            Z42Type ct = callee.Type();
            if (ct is Z42FuncType) {
                args = this._tc._overload.FillDeferredArgs(args, call.Args, call.ArgCount, ct as Z42FuncType, env);
                return new BoundIndirectCall(callee, args, call.ArgCount, (ct as Z42FuncType).Ret, call.Span);
            }
            if (ct is Z42GenericParamType) {
                args = this._tc._overload.FillDeferredArgs(args, call.Args, call.ArgCount, null, env);   // 类型未知 → target-typed 实参报 E0437
                return new BoundIndirectCall(callee, args, call.ArgCount, new Z42UnknownType(), call.Span);
            }
        }
        this._tc._diags.Error(DiagnosticCodes.TypeMismatch, "unsupported call form", call.Span);
        return new BoundError("unsupported call", new Z42ErrorType(), call.Span);
    }

    private BoundExpr _bindMemberCall(MemberExpr mem, BoundExpr[] args, int argCount, Expr[] rawArgs, TypeEnv env, Span sp) {
        // fix-namespace-qualified-free-call：`ns.func()` 当 ns=当前命名空间且 func 是自由函数
        // → 自由调用（否则被误当类 ns 的静态调用 → 双限定 ns.ns.func → 运行期 undefined）。
        if (mem.Target is IdentExpr) {
            IdentExpr nsId = mem.Target as IdentExpr;
            if (this._tc._currentNs != "" && nsId.Name == this._tc._currentNs
                && env.LookupVar(nsId.Name) == null && env.Symbols.HasFunc(mem.Name)) {
                MethodSymbol nfs = env.Symbols.GetFunc(mem.Name);
                args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, nfs.Signature, env);
                return new BoundCall("free", false, null, "", mem.Name, args, argCount, nfs.Signature.Ret, sp);
            }
        }
        // 静态：target 是裸类名（非局部变量）→ Class.m(args)
        if (mem.Target is IdentExpr) {
            IdentExpr tid = mem.Target as IdentExpr;
            if (env.LookupVar(tid.Name) == null && env.Symbols.HasClass(tid.Name)) {
                Z42ClassType ct = env.Symbols.GetClass(tid.Name);
                MethodSymbol ms = this._tc._overload._resolveOverload(env.Symbols, ct, mem.Name, args, argCount, sp);
                if (ms != null) {
                    this._tc._access.CheckAccess(ms.Visibility, ms.ContainingTypeName, env, env.Symbols, "method", mem.Name, sp);   // enforce-access-control
                    BoundExpr[] fa = this._tc._overload._withDefaults(ms, args, rawArgs, argCount, env, sp);
                    return new BoundCall("static", false, null, ct.Name(), ms.RegKey, fa, fa.Length, ms.Signature.Ret, sp);
                }
                this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                    "no static method `" + mem.Name + "` on `" + ct.Name() + "`", sp);
                args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);
                return new BoundCall("static", false, null, tid.Name, mem.Name, args, argCount, new Z42ErrorType(), sp);
            }
        }
        // GS6: prim 关键字静态调用（int.Parse / string.FromChars 等）→ wrapper class 静态方法
        if (mem.Target is IdentExpr) {
            IdentExpr tid2 = mem.Target as IdentExpr;
            if (env.LookupVar(tid2.Name) == null && TypeFactsTc._isPrimKeyword(tid2.Name)) {
                string pwrap2 = TypeFactsTc._primWrapper(tid2.Name);
                if (env.Symbols.HasClass(pwrap2)) {
                    Z42ClassType wct2 = env.Symbols.GetClass(pwrap2);
                    // stabilize-dispatch-keys（方案A，静态-only）：prim 关键字静态调用（int.Parse / string.FromChars）
                    // 是【静态】方法 → 静态-only 下恒全签名 mangle。旧 _overloadKey/_findMethod（裸名/Name$arity）
                    // 查不到已 mangle 的静态方法 → 必须走 _resolveOverload 拿 RegKey。（prim 实例方法不 mangle，走上方裸键路径。）
                    MethodSymbol wms2 = this._tc._overload._resolveOverload(env.Symbols, wct2, mem.Name, args, argCount, sp);
                    if (wms2 != null) {
                        // params 打包 / 默认参数填充（与上方类限定静态调用一致）：keyword 静态调用此前不经
                        // _withDefaults，靠精确 arity 重载兜底；params-for-Join 移除了 `Join(string,string,string,string)`
                        // 精确重载后，`string.Join("-","x","y","z")` 的 expanded form 需在此打包成 string[]，
                        // 否则以 4 裸实参调 `Join$2$string$string[]`（2 形参）→ arity 不符。
                        BoundExpr[] fa2 = this._tc._overload._withDefaults(wms2, args, rawArgs, argCount, env, sp);
                        return new BoundCall("static", false, null, pwrap2, wms2.RegKey, fa2, fa2.Length, wms2.Signature.Ret, sp);
                    }
                    this._tc._diags.Error(DiagnosticCodes.UndefinedSymbol,
                        "no static method `" + mem.Name + "` on `" + pwrap2 + "`", sp);
                    args = this._tc._overload.FillDeferredArgs(args, rawArgs, argCount, null, env);
                    return new BoundCall("static", false, null, pwrap2, mem.Name, args, argCount, new Z42ErrorType(), sp);
                }
            }
        }
        // 实例：bind target 为值
        BoundExpr recv = this._tc._expr._bindExpr(mem.Target, env);
        Z42Type rt = recv.Type();
        return this._bindInstanceMemberCall(mem, recv, rt, args, argCount, rawArgs, env, sp);
    }

}