// 声明良构约束簇：从 SymbolCollector 分出。D8 类名后缀强制（attribute/analyzer/generator，E0444/5/7）
// + partial 类型/方法校验。纯语法/AST 级检查。共享辅助 + partial 状态留 hub SymbolCollector，经 _sc 委回。
namespace Z42.Semantics;
using Z42.IR;
using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;   // ZbcInstr._parseIntLit（[Timeout] 的整数字面量）

public sealed class DeclEnforcer {
    private SymbolCollector _sc;   // hub 反向引用：共享辅助 + partial 状态 + 编排
    public DeclEnforcer(SymbolCollector sc) { this._sc = sc; }

    // attribute-handler-registry PR2（D8 后缀约定）：任何直接以 `Attribute` 基类派生的用户类，其类名
    // **必须**以 `Attribute` 结尾——用名 `[X]` 剥后缀 ↔ 定义名 `XAttribute` 带后缀，AttributeSynth 按此
    // 展开合成工厂 `new XAttribute()`。违规 → E0444（把 C# 的软警告 CA1710 提成硬编译错，design D8 注）。
    // 纯语法检查（NestedFlatten 后遍历 ClassDecl，看直接基类名）；directive（`[Native]`）/ test 家族
    // 不派生 `Attribute` → 天然豁免；基类 `Attribute` 自身无 `: Attribute` 基 → 不触发。
    // （Generator/Analyzer 的后缀强制留 PR3/PR4——彼时那两 kind 才成为可加载的真类型。）
    internal void _passAttributeSuffixEnforce(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (this._baseIsAttribute(c) && !c.Name.EndsWith("Attribute")) {
                    this._sc.Diags.Error(DiagnosticCodes.AttributeSuffixRequired,
                        "attribute class `" + c.Name + "` must end with `Attribute` suffix (rename to `" + c.Name + "Attribute`; apply it as `[" + c.Name + "]`)", c.Span);
                }
            }
            i = i + 1;
        }
    }

    // 直接基类里是否有 `Attribute`（或限定 `*.Attribute`）。attribute 基类现实中一律不限定（限定
    // `Std.Attribute` 触 typechecker FQN-upcast gap，见 reflection.md Deferred），限定分支仅稳妥兜底。
    private bool _baseIsAttribute(ClassDecl c) {
        return this._baseHasSimpleName(c, "Attribute");
    }

    // attribute-handler-registry PR3a（D8 后缀约定，analyzer 侧）：任何直接实现 `Analyzer` 接口的用户类，
    // 其类名**必须**以 `Analyzer` 结尾（`NoGotoAnalyzer` 等）——handler 靠接口发现、无用名 `[X]`，后缀是
    // kind 信号（design D8：Generator/Analyzer 后缀 C# 无先例、z42 自创）。违规 → E0445。与 E0444 同为纯
    // 语法检查（看直接基/接口名，不依赖可解析）；同 3 挂载点。Generator 后缀强制留 PR4（彼时 Generator 成
    // 可加载真类型）。
    internal void _passAnalyzerSuffixEnforce(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (this._baseHasSimpleName(c, "Analyzer") && !c.Name.EndsWith("Analyzer")) {
                    this._sc.Diags.Error(DiagnosticCodes.AnalyzerSuffixRequired,
                        "analyzer class `" + c.Name + "` must end with `Analyzer` suffix (rename to `" + c.Name + "Analyzer`)", c.Span);
                }
            }
            i = i + 1;
        }
    }

    // attribute-handler-registry PR4a（D8 后缀约定，generator 侧）：任何直接实现 `Generator`（applied，PR4a）
    // 或 `ModuleGenerator`（module，PR4c）接口的用户类，其类名**必须**以 `Generator` 结尾（`DeriveGenerator` /
    // `RouteTableGenerator` 等）——applied generator 靠接口发现、类名剥后缀即触发注解名（`[Derive]`），module
    // generator 无触发名但共用同一 kind 信号后缀（design D8）。违规 → E0447。与 E0444/E0445 同为纯语法检查
    // （看直接基/接口名，不依赖可解析）；同 3 挂载点。
    internal void _passGeneratorSuffixEnforce(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                bool isGen = this._baseHasSimpleName(c, "Generator") || this._baseHasSimpleName(c, "ModuleGenerator");
                if (isGen && !c.Name.EndsWith("Generator")) {
                    this._sc.Diags.Error(DiagnosticCodes.GeneratorSuffixRequired,
                        "generator class `" + c.Name + "` must end with `Generator` suffix (rename to `" + c.Name + "Generator`)", c.Span);
                }
            }
            i = i + 1;
        }
    }

    // 直接基/接口列表里是否有简单名 `name`（或限定 `*.name`）。纯语法（不依赖 base 可解析）——E0444/E0445/
    // E0447 后缀强制共用；attribute 基类/analyzer·generator 接口现实中都不限定，限定分支仅稳妥兜底。
    private bool _baseHasSimpleName(ClassDecl c, string name) {
        int j = 0;
        while (j < c.BaseCount) {
            if (c.Bases[j] is NamedType) {
                string bn = (c.Bases[j] as NamedType).Name;
                if (bn == name || bn.EndsWith("." + name)) { return true; }
            }
            j = j + 1;
        }
        return false;
    }

    // partial 类型校验（AST 级，跨全部 CU 按名分组）：① 全部标 partial ② Kind 一致 ③ 嵌套 partial 报错。
    // （base 冲突在 _passClassStubs——需接口表分辨 base vs iface；成员重复在 _fillClass。）
    internal void _passValidatePartial(CompilationUnit[] cus, string[] files, int count) {
        ClassDecl[] frags = new ClassDecl[16];
        int nf = 0;
        int c = 0;
        while (c < count) {
            int i = 0;
            while (i < cus[c].DeclCount) {
                Decl d = this._sc._unwrap(cus[c].Decls[i]);
                if (d is ClassDecl) {
                    ClassDecl cd = d as ClassDecl;
                    if (nf == frags.Length) {
                        ClassDecl[] bb = new ClassDecl[frags.Length * 2];
                        int k = 0; while (k < nf) { bb[k] = frags[k]; k = k + 1; }
                        frags = bb;
                    }
                    frags[nf] = cd; nf = nf + 1;
                    this._checkNestedPartial(cd);
                }
                i = i + 1;
            }
            c = c + 1;
        }
        StrMap seen = new StrMap();
        int a = 0;
        while (a < nf) {
            string nm = frags[a].Name;
            if (!seen.ContainsKey(nm)) {
                seen.Put(nm, "1");
                int total = 0; int partialN = 0; string firstKind = "";
                bool kindErr = false; ClassDecl kindReport = frags[a];
                int b = 0;
                while (b < nf) {
                    if (frags[b].Name == nm) {
                        total = total + 1;
                        if (frags[b].IsPartial) { partialN = partialN + 1; }
                        if (firstKind == "") { firstKind = frags[b].Kind; }
                        else if (frags[b].Kind != firstKind) { kindErr = true; kindReport = frags[b]; }
                    }
                    b = b + 1;
                }
                if (partialN > 0) {
                    if (partialN != total) {
                        this._sc.Diags.Error(DiagnosticCodes.PartialModifierMissing,
                            "type `" + nm + "` has both partial and non-partial declarations; all must be `partial`", frags[a].Span);
                    }
                    if (kindErr) {
                        this._sc.Diags.Error(DiagnosticCodes.PartialKindMismatch,
                            "partial type `" + nm + "` declared with mismatched kinds (class/struct/interface must agree)", kindReport.Span);
                    }
                }
            }
            a = a + 1;
        }
    }

    // 嵌套类型自身 partial（v1 不支持，design D9）：外层 partial 含嵌套允许；嵌套类**自身**标 partial → 报错。
    private void _checkNestedPartial(ClassDecl outer) {
        int i = 0;
        while (i < outer.MemberCount) {
            Decl m = this._sc._unwrap(outer.Members[i]);
            if (m is ClassDecl) {
                ClassDecl inner = m as ClassDecl;
                if (inner.IsPartial) {
                    this._sc.Diags.Error(DiagnosticCodes.PartialNestedUnsupported,
                        "nested type `" + inner.Name + "` cannot be `partial` (v1 supports partial only on top-level types)", inner.Span);
                }
            }
            i = i + 1;
        }
    }

    // ── [Test] 家族的位置 + 签名强制（fix-test-attr-placement）──────────────────────────────
    // 补回自举迁移中丢失的 TestAttributeValidator（E0911/E0912/E0915）：那套校验随 C# 编译器退休
    // 一起被删、从未移植到 z42c，而 docs/design/compiler/error-codes.md 至今写着「已启用」。
    // 后果实测：`[Test]` 贴实例方法编译期全绿 → TestIndexBuilder 照写 TIDX entry → 运行期
    // `__invoke_static` 撞 `expects 1 argument(s) (incl. receiver), got 0`（runner 按 FQN 无参调用，
    // 见 z42.test/src/Runner.z42 头注的不变量）。同一失败模式在 BenchmarkDesugar 上已发生过一次。
    //
    // 五条规则（全纯语法，不查符号表 → 与 E0444/E0445/E0447 同级、first-pass 可用）：
    //   R1 零接收者：顶层自由函数 或 static 方法      R4 非泛型
    //   R2 返回 void                                   R5 有方法体
    //   R3 无参数
    //
    // ⚠️⚠️ 相位：本 pass **必须**在 HandlerRegistry.RunAst 之后跑（三个挂载点在 SymbolCollector，
    //    天然满足）。RunAst 里的 BenchmarkDesugar 会把**合法**的 form-2 `[Benchmark] void f(Bencher b)`
    //    改写成 `f$impl(Bencher b)` + 零参 wrapper `[Benchmark] void f()`；在它之前查 R3 会让全仓
    //    66 处 benchmark 全红。移动本 pass 位置前先读
    //    docs/spec/changes/add-attribute-usage/design.md §3.2。
    internal void _passTestAttrEnforce(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            this._teWalk(cu.Decls[i], "");
            i = i + 1;
        }
    }

    // 递归下降：顶层 → 类成员（含嵌套类型）→ impl 块方法。
    // owner = 外层类型名（"" = 顶层），只用于诊断消息里的限定名。
    private void _teWalk(Decl raw, string owner) {
        // ① 本节点若是「带 attribute 的方法」，先查它。
        if (raw is AttributedDecl) {
            AttributedDecl ad = raw as AttributedDecl;
            if (ad.Inner is MethodDecl) { this._teCheck(ad, ad.Inner as MethodDecl, owner); }
            this._teOrphanCheck(ad);   // 修饰类 attr 无 kind attr 相伴（E0914），不限于方法
        }
        // ② 再下沉到容器（AttributedDecl 也可能包着 ClassDecl，故先 _unwrap）。
        Decl d = this._sc._unwrap(raw);
        if (d is ClassDecl) {
            ClassDecl c = d as ClassDecl;
            int j = 0;
            while (j < c.MemberCount) {
                // ⚠️ 跳过嵌套类型成员：NestedFlatten（本 pass 之前跑）已把它们**提升为顶层**
                // （改名 `Outer+Inner`）**但仍留在 outer.Members**——不跳会把同一个声明访问两次、
                // 报重复诊断。与其它成员 pass 的既有约定一致（「成员处理阶段忽略 ClassDecl/EnumDecl
                // 成员」，见 NestedFlatten 头注）；嵌套类型的成员由那份顶层副本覆盖。
                Decl mem = this._sc._unwrap(c.Members[j]);
                if (!(mem is ClassDecl) && !(mem is EnumDecl)) { this._teWalk(c.Members[j], c.Name); }
                j = j + 1;
            }
        } else if (d is ImplDecl) {
            ImplDecl im = d as ImplDecl;
            string tn = "";
            if (im.TargetType is NamedType) { tn = (im.TargetType as NamedType).Name; }
            int j = 0;
            while (j < im.MethodCount) { this._teWalk(im.Methods[j], tn); j = j + 1; }
        }
    }

    // 诊断锚在 **attribute 的 span**（指着 `[Test]`），不是方法 span——本 parser 的 decl span 只覆盖
    // 起始 token，且一个方法可能贴多个 attribute。
    private void _teCheck(AttributedDecl ad, MethodDecl md, string owner) {
        Attr kind = this._teKindAttr(ad);
        if (kind == null) { return; }
        string code = this._teCode(kind.Name);
        string use = "`[" + kind.Name + "]`";

        // R1 —— 位置错了就**只报这一条并返回**：贴错地方时再说「还得返回 void」只会刷屏。
        if (!md.IsFree && !this._sc._hasWord(md.Mods, "static")) {
            this._sc.Diags.Error(code,
                use + " must be applied to a free function or a `static` method (got: "
                    + this._teShape(md, owner) + "); add `static`, or move it to a top-level function",
                kind.Span);
            return;
        }
        // R2..R5 各报一次 —— 一个方法可能同时「有返回值」且「有参数」，都说出来比只说第一条有用。
        if (!(md.RetType is NamedType) || (md.RetType as NamedType).Name != "void") {
            this._sc.Diags.Error(code,
                use + " must return `void` (got: `" + md.RetType.Dump() + "`)", kind.Span);
        }
        if (md.ParamCount != 0) {
            this._sc.Diags.Error(code,
                use + " must take no parameters (got: " + md.ParamCount.ToString() + ")", kind.Span);
        }
        if (md.TypeParams.Count != 0) {
            this._sc.Diags.Error(code, use + " cannot be applied to a generic method", kind.Span);
        }
        if (!md.HasBody) {
            this._sc.Diags.Error(code, use + " must have a method body", kind.Span);
        }
        // 实参语义（complete-test-attr-arg-checks）：位置违规已在 R1 处 return，故这里天然不叠加。
        this._teArgChecks(ad);
    }

    // ── 实参语义：E0914（[Skip] reason / [Skip]·[Ignore] 孤儿）+ E0917（[Timeout] 值域）──────
    // 纯语法：只看同一声明上的 attr 实参，不查符号表。三码常量早已存在于 z42c.core（零引用），
    // 直接引用。修的都是**静默降级**：今天 TestIndexBuilder 读不到就 `if (x > 0)` 跳过 ——
    // skip 没理由、超时静默失效，全推到运行期且症状指不回病灶。
    private void _teArgChecks(AttributedDecl ad) {
        int a = 0;
        while (a < ad.AttrCount) {
            Attr at = ad.Attrs[a];
            if (at.Name == "Skip") {
                if (this._teNamedStr(at, "reason") == "") {
                    this._sc.Diags.Error(DiagnosticCodes.SkipReasonMissing,
                        "`[Skip]` requires a non-empty `reason` (e.g. `[Skip(reason: \"flaky on CI\")]`)",
                        at.Span);
                }
            } else if (at.Name == "Timeout") {
                // 非字面量视为「未给出」—— 与 TestIndexBuilder._namedIntArg 的既有读法一致
                // （它也只认字面量）。要支持命名常量须连同那边一起改，属另案（design §4）。
                if (!this._teHasNamedInt(at, "milliseconds")) {
                    this._sc.Diags.Error(DiagnosticCodes.TimeoutValueInvalid,
                        "`[Timeout]` requires a `milliseconds` argument (e.g. `[Timeout(milliseconds: 5000)]`)",
                        at.Span);
                } else {
                    long ms = this._teNamedInt(at, "milliseconds");
                    if (ms <= 0) {
                        this._sc.Diags.Error(DiagnosticCodes.TimeoutValueInvalid,
                            "`[Timeout]` requires a positive `milliseconds` (got: " + ms.ToString() + ")",
                            at.Span);
                    }
                }
            }
            a = a + 1;
        }
    }

    // 修饰类 attr 必须与 kind attr 同贴：孤儿 `[Skip]` 今天会让 TIDX 凭空多一条 Kind=Test 的
    // skipped entry —— 测试报告里出现一个没人写过的「测试」。独立于 _teCheck（后者要求命中
    // kind attr 才进），故由 _teWalk 单独调。
    private void _teOrphanCheck(AttributedDecl ad) {
        if (this._teKindAttr(ad) != null) { return; }
        int a = 0;
        while (a < ad.AttrCount) {
            string n = ad.Attrs[a].Name;
            if (n == "Skip" || n == "Ignore") {
                this._sc.Diags.Error(DiagnosticCodes.SkipReasonMissing,
                    "`[" + n + "]` requires `[Test]` or `[Benchmark]` on the same declaration",
                    ad.Attrs[a].Span);
            }
            a = a + 1;
        }
    }

    // 命名实参的字符串值（无 / 非字符串字面量 → ""）。形态见 DeclParser：`name: value` 译成
    // AssignExpr("=", IdentExpr(name), value)。
    private string _teNamedStr(Attr at, string key) {
        int i = 0;
        while (i < at.ArgCount) {
            if (at.Args[i] is AssignExpr) {
                AssignExpr ae = at.Args[i] as AssignExpr;
                if (ae.Target is IdentExpr && (ae.Target as IdentExpr).Name == key
                    && ae.Value is StringLitExpr) {
                    return Lexer.DecodeString((ae.Value as StringLitExpr).Raw);
                }
            }
            i = i + 1;
        }
        return "";
    }

    private bool _teHasNamedInt(Attr at, string key) {
        int i = 0;
        while (i < at.ArgCount) {
            if (at.Args[i] is AssignExpr) {
                AssignExpr ae = at.Args[i] as AssignExpr;
                if (ae.Target is IdentExpr && (ae.Target as IdentExpr).Name == key
                    && ae.Value is IntLitExpr) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    private long _teNamedInt(Attr at, string key) {
        int i = 0;
        while (i < at.ArgCount) {
            if (at.Args[i] is AssignExpr) {
                AssignExpr ae = at.Args[i] as AssignExpr;
                if (ae.Target is IdentExpr && (ae.Target as IdentExpr).Name == key
                    && ae.Value is IntLitExpr) {
                    return ZbcInstr._parseIntLit((ae.Value as IntLitExpr).Value);
                }
            }
            i = i + 1;
        }
        return 0;
    }

    // 首个命中的 kind attr（它决定诊断码）；无 → null。修饰类 attr（Skip/Ignore/ShouldThrow/Timeout）
    // 不单独触发：它们骑在同一声明上，由 kind attr 的检查覆盖。
    private Attr _teKindAttr(AttributedDecl ad) {
        int a = 0;
        while (a < ad.AttrCount) {
            if (HandlerRegistry.IsTestKindAttr(ad.Attrs[a].Name)) { return ad.Attrs[a]; }
            a = a + 1;
        }
        return null;
    }

    // 码映射：三个常量早已存在于 z42c.core（非本次新增）→ 可直接引用，无 F2 冷启动顾虑。
    private string _teCode(string name) {
        if (name == "Benchmark") { return DiagnosticCodes.BenchmarkSignatureInvalid; }
        if (name == "Setup" || name == "Teardown") { return DiagnosticCodes.SetupTeardownSignatureInvalid; }
        return DiagnosticCodes.TestSignatureInvalid;
    }

    // 诊断里的「你贴到了什么」：instance method `MathTests.test_add` / constructor `Foo`
    private string _teShape(MethodDecl md, string owner) {
        string q = md.Name;
        // 嵌套类型经 NestedFlatten 后名为 `Outer+Inner`（元数据拼法）；诊断面向源码作者，
        // 还原成源码里写的 `Outer.Inner`。
        if (owner != "") { q = owner.Replace("+", ".") + "." + md.Name; }
        if (md.IsCtor) { return "constructor `" + q + "`"; }
        return "instance method `" + q + "`";
    }

    // ── 语义相：E0913（`[ShouldThrow<E>]` 的 E 必须派生 Exception）────────────────────────
    // 与 _passTestAttrEnforce 分开是刻意的：那条要保住「纯语法 / 零依赖 / first-pass 可用」——
    // 位置与签名是最该尽早报的一批。本 pass 需要符号表走基类链，故单列（design §1）。
    //
    // ⚠️ **刻意保守**：TypeArg 在符号表里**解析不到就不报**。符号表在若干场景下不完整
    //    （Collect(cu) 单 CU 无 imports、跨包类型取决于依赖是否已建），报「类型不存在」会误伤
    //    真实代码。宁可漏报也不误报 —— 已登记为已知缺口（design §2）。
    internal void _passTestAttrSemantic(SymbolTable t, CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            this._tsWalk(t, cu.Decls[i]);
            i = i + 1;
        }
    }

    // 遍历面与 _teWalk 一致（顶层 / 类成员含嵌套跳过 / impl 块），只是检查内容不同。
    private void _tsWalk(SymbolTable t, Decl raw) {
        if (raw is AttributedDecl) {
            AttributedDecl ad = raw as AttributedDecl;
            if (ad.Inner is MethodDecl) { this._tsCheck(t, ad); }
        }
        Decl d = this._sc._unwrap(raw);
        if (d is ClassDecl) {
            ClassDecl c = d as ClassDecl;
            int j = 0;
            while (j < c.MemberCount) {
                Decl mem = this._sc._unwrap(c.Members[j]);
                if (!(mem is ClassDecl) && !(mem is EnumDecl)) { this._tsWalk(t, c.Members[j]); }
                j = j + 1;
            }
        } else if (d is ImplDecl) {
            ImplDecl im = d as ImplDecl;
            int j = 0;
            while (j < im.MethodCount) { this._tsWalk(t, im.Methods[j]); j = j + 1; }
        }
    }

    private void _tsCheck(SymbolTable t, AttributedDecl ad) {
        int a = 0;
        while (a < ad.AttrCount) {
            Attr at = ad.Attrs[a];
            if (at.Name == "ShouldThrow") {
                if (at.TypeArg == "") {
                    this._sc.Diags.Error(DiagnosticCodes.ShouldThrowTypeInvalid,
                        "`[ShouldThrow]` requires a type argument (e.g. `[ShouldThrow<TestFailure>]`)",
                        at.Span);
                } else if (t != null && t.Classes.ContainsKey(at.TypeArg)
                           && !this._tsDerivesFromException(t, at.TypeArg)) {
                    this._sc.Diags.Error(DiagnosticCodes.ShouldThrowTypeInvalid,
                        "`[ShouldThrow<" + at.TypeArg + ">]` requires a type deriving from `Exception` (got: `"
                            + at.TypeArg + "`)", at.Span);
                }
            }
            a = a + 1;
        }
    }

    // 基类链是否（传递地）到达 `Exception`；类型自身就是 Exception 也算。32 跳上限防成环。
    // 按**短名**比较 —— 表里存的 BaseName 可能带命名空间（同 TestIndexBuilder._isDescendantOf；
    // 那份是 private + 绑 IrGen 反向引用，无法复用，属刻意重复，见 design §6）。
    private bool _tsDerivesFromException(SymbolTable t, string clsName) {
        if (clsName == "Exception") { return true; }
        string cur = clsName;
        int hops = 0;
        while (hops < 32) {
            if (!t.Classes.ContainsKey(cur)) { return false; }
            Z42ClassType ct = t.Classes.Get(cur) as Z42ClassType;
            if (!ct.HasBase || ct.BaseName == "") { return false; }
            string baseShort = this._tsShortName(ct.BaseName);
            if (baseShort == "Exception") { return true; }
            cur = baseShort;
            hops = hops + 1;
        }
        return false;
    }

    private string _tsShortName(string fq) {
        int lastDot = 0 - 1;
        int di = 0;
        while (di < fq.Length) { if (fq.CharAt(di) == '.') { lastDot = di; } di = di + 1; }
        if (lastDot >= 0) { return fq.Substring(lastDot + 1); }
        return fq;
    }

    // partial method 配对校验：每个实现必须有匹配声明（同 canonical 签名）；否则=实现无声明/签名不一致。
    // decl-only（有声明无实现）→ 已在 _fillClass 擦除，此处不报错（合法擦除）。
    internal void _passResolvePartialMethods() {
        string[] implKeys = this._sc._partialImpls.Keys();
        int i = 0;
        while (i < implKeys.Length) {
            if (!this._sc._partialDecls.ContainsKey(implKeys[i])) {
                MethodDecl implMd = this._sc._partialImpls.Get(implKeys[i]) as MethodDecl;
                this._sc.Diags.Error(DiagnosticCodes.PartialMethodSigMismatch,
                    "partial method `" + implMd.Name + "` implementation has no matching declaration (declaration and implementation signatures must match exactly)", implMd.Span);
            }
            i = i + 1;
        }
    }

}
