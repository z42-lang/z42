// 符号模型（port-z42c-semantics 1A-2b）。受限写法：独立 sealed class（暂无共享 ISymbol 基类——
// 1A 字段/方法分属各自 StrMap，无混合集合需求；需要混合查找时再引入 ISymbol 基 + Kind tag）。
// 存入 StrMap（object 值），调用方 `as` 下行到 MethodSymbol / FieldSymbol。
namespace Z42.Semantics;
using Z42.IR;   // StrMap 统一到 z42c.ir（compiler-review §4.1）

using Z42.Syntax;

public sealed class MethodSymbol {
    public string      Name;
    public string      Visibility;
    public Z42FuncType Signature;
    public bool        IsStatic;
    public string      ContainingTypeName;   // 两阶段：收集时填类名（fixup 简化为名字回指）
    public bool        HasDecl;
    public MethodDecl  Decl;                  // syntax AST（绑定体时用；imported 时 null）
    public string      RegKey;                // add-type-based-overloads：注册键（= Methods 映射键 = IR 名 =
                                              // BoundCall 目标名）。bare Name / Name$arity / Name$arity$typesig。
                                              // 默认 = Name；注册方按冲突上下文覆写。
    public bool        IsSealed;              // impl-sealed-semantics-devirt：方法级 sealed（sealed override 或
                                              // 简写 sealed）。默认 false；本地由 SymbolCollector 从 Mods 设置，
                                              // 导入由 ImportedSymbolLoader 从 METHOD_FLAG_SEALED 还原。
    public bool        IsDeprecated;          // add-deprecated-directive：`[Deprecated]` 方法。use-site 告警用。
    public string      DeprecationMsg;        // 本地由 SymbolCollector 从 attr 设置，导入由 ImportedSymbolLoader 还原。
    public int         TypeParamCount;        // add-array-paired-sort：方法级泛型形参个数（`Sort<T>`=1 / `Sort<TKey,TValue>`=2）。
                                              // 本地由 SymbolCollector 从 Decl.TypeParams.Count 设；导入由 ImportedSymbolLoader
                                              // 从 ExportedMethodZ.TypeParamCount 还原。供泛型 arity 重载过滤（默认 0）。
    public string[]    TypeParamNames;        // fix-explicit-type-arg-not-substituted：方法级泛型形参**名**（声明序）。
                                              // 与 TypeParamCount 同源同步设置（本地 Decl.TypeParams.Names；导入
                                              // ExportedMethodZ.TypeParams）。`TypeParamCount` 只够做 arity 过滤，
                                              // 而**按名代换**签名（`Sort<int>` 的 `Comparison<T>` → `Comparison<int>`）
                                              // 必须有名字——导入侧此前把这些名字读出来只当解析上下文用，没留在符号上。
    public MethodSymbol(string name, string visibility, Z42FuncType sig, bool isStatic,
                        string containingTypeName, bool hasDecl, MethodDecl decl) {
        this.Name = name; this.Visibility = visibility; this.Signature = sig; this.IsStatic = isStatic;
        this.ContainingTypeName = containingTypeName; this.HasDecl = hasDecl; this.Decl = decl;
        this.RegKey = name;
        this.IsSealed = false;
        this.IsDeprecated = false; this.DeprecationMsg = "";
        this.TypeParamCount = 0;
        this.TypeParamNames = new string[0];
    }
    // fix-explicit-type-arg-not-substituted：同一符号、换一条签名的浅拷贝。
    //
    // 🔴 **加字段就要在这里补一行**——本方法必须与上面的字段清单逐字段对应。之所以放在
    // MethodSymbol 自己身上（而不是让调用方就地 `new`），正是为了让「字段清单」与「拷贝清单」
    // 贴在一起、漏拷时一眼可见：调用方就地拷会让新字段在某条调用路径上静默丢失
    // （最典型的是 `RegKey` —— 丢了就发错函数名，而且只在重载 mangle 过的方法上才炸）。
    public MethodSymbol WithSignature(Z42FuncType sig) {
        var c = new MethodSymbol(this.Name, this.Visibility, sig, this.IsStatic,
                                 this.ContainingTypeName, this.HasDecl, this.Decl);
        c.RegKey = this.RegKey;
        c.IsSealed = this.IsSealed;
        c.IsDeprecated = this.IsDeprecated; c.DeprecationMsg = this.DeprecationMsg;
        c.TypeParamCount = this.TypeParamCount; c.TypeParamNames = this.TypeParamNames;
        return c;
    }
    public string Dump() { return "(method " + this.Name + " " + this.Signature.Dump() + ")"; }
}

public sealed class FieldSymbol {
    public string  Name;
    public string  Visibility;
    public Z42Type FieldType;
    public bool    IsStatic;
    public string  ContainingTypeName;
    public bool    IsReadonly;   // add-readonly-fields-opt：readonly 字段（构造后不变）。默认 false；
                                 // 本地字段由 SymbolCollector 从 Mods 设置；导入字段 v1 保守留 false（不跨包）。
    public bool       IsConst;   // add-const-keyword：const 编译期常量字段（隐式 static、无存储）。默认 false。
    public ConstValue ConstVal;  // add-const-keyword：IsConst 时的求值结果（引用替换用）；否则 null。
    public bool       IsDeprecated;   // add-deprecated-directive：`[Deprecated]` 字段。use-site 告警用。
    public string     DeprecationMsg; // 本地由 SymbolCollector 从 attr 设置，导入由 ImportedSymbolLoader 还原。
    // fix-autoprop-getonly-backing-write：属性也以 FieldSymbol 形式登记（键=源名 X），但**没有 setter**
    // 时赋值此前落到「按源名 X 发 field_set」——而存储在 __prop_X，于是写进一个不存在的字段、静默丢失。
    // 两个标志把「这是个没有 setter 的属性」带给 AssignTyper（限制赋值）与 AccessEmitter（改写后备名）：
    //   IsProp           — 这个 FieldSymbol 其实是个属性（裸 ident 访问须走访问器，不能当字段读写）。
    //   IsPropNoSetter   — `X { get; }` / `X { get {..} }`，赋值须受限（不是普通字段）。
    //   PropBackingName  — auto-property 的后备字段名 `__prop_X`；计算属性（有 get 体）无存储 → ""。
    public bool       IsProp;
    public bool       IsPropNoSetter;
    public string     PropBackingName;
    public FieldSymbol(string name, string visibility, Z42Type fieldType, bool isStatic, string containingTypeName) {
        this.Name = name; this.Visibility = visibility; this.FieldType = fieldType;
        this.IsStatic = isStatic; this.ContainingTypeName = containingTypeName;
        this.IsReadonly = false;
        this.IsConst = false; this.ConstVal = null;
        this.IsDeprecated = false; this.DeprecationMsg = "";
        this.IsProp = false; this.IsPropNoSetter = false; this.PropBackingName = "";
    }
    public string Dump() { return "(field " + this.Name + " " + this.FieldType.Dump() + ")"; }
}
