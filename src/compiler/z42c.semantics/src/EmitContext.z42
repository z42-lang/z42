// 共享 codegen 状态 + 低层助手（port-z42c-codegen，CG-1E 前 refactor）。
// z42 无 partial class（C# 把 FunctionEmitter 拆 17 文件不可移植）→ 抽公共状态到 EmitContext：
// FunctionEmitter（函数入口/语句/控制流）与 ExprEmitter（表达式）共用同一个 ctx，
// 各自文件控制在行数限内。受限写法：public 字段 + 集合 typed array+count。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.Core;
using Z42.IR;
using Z42.IR.BinaryFormat;

public sealed class EmitContext {
    public SymbolTable Symbols;
    public IrGen       Gen;          // 字符串 intern
    public StrMap      Locals;       // name → TypedReg（object 下行）
    public StrMap      Fields;       // 实例方法自身字段名集合（裸 ident → field_get reg0）
    public StrMap      ReadonlyFields; // add-readonly-fields-opt：其中声明为 readonly 的字段名子集（裸 ident field_get 打 Readonly 标志）
    public StrMap      ConstLocals;    // add-const-keyword：局部 const 名 → ConstValue（裸 ident 引用替换为字面量；存储正常发射，全替换后 DCE 清理）
    public IrBlock[]   Blocks;   public int BlockCount;
    public IrInstr[]   Cur;      public int CurCount;     // 当前块指令累积
    public string      CurLabel; public bool Ended;       // 当前块已终结
    public int         NextReg;  public int MaxReg;  public int LabelSeq;
    public string[]    ContLabels; public string[] BreakLabels; public int LoopDepth;  // 循环标签栈
    // fix-finally-nonlocal-exit：每层「循环/switch」入栈时的 finally 栈深，break/continue 各一个——
    // break 目标 = 本层结束（floor=本层入栈深）；continue 目标对 switch 是**外层循环**（floor 继承外层），
    // 故二者可不同。退出该层时只跑 floor..当前深 之间的 finally（跨越本层边界的那些）。
    public int[]       BreakFinFloor; public int[] ContFinFloor;
    public int[]       RegTags;   public int RegTagCount;   // reg id → IrType 标签（REGT，byte-identical）
    public IrLineEntry[] Lines;  public int LineCount;  public int LastLine;   // DBUG 行表（同行去重，镜像 C# TrackLine）
    public string Ns;   // 根命名空间（""=无；名字限定 BP-0，镜像 C# QualifyName）
    public DependencyIndex Deps;       // 跨包调用索引（CI-4；null=无依赖）
    public StrMap ImportedClassNs;     // imported 短类名 → ns（StrBox；IC-1：VCall 依赖追踪 + ObjNew FQ；**含本包跨-ns 自有类**，G17b）
    public StrMap ImportedFuncNs;      // imported 自由函数名 → 源 ns（StrBox；fix-imported-free-func-namespace：跨包裸调按源 ns 限定，与 ImportedClassNs 对称）
    public string[] ActiveNs; public int ActiveNsCount;  // path C：本 CU 活跃命名空间集（usings + 本 ns，prelude-first）→ 静态调用 using-scoped 消歧
    public StrMap LocalClasses;        // 本包**自有声明**类名集（G18 修正：ChainHasMethod 反劫持守卫须仅认本地类，镜像 C# ClassRegistry）
    public string[] UsedDepNs; public int UsedDepNsCount;   // codegen 期实际命中的依赖 ns（DEPS 用，首现序）
    public IrExcEntry[] ExcTable; public int ExcCount;       // 异常表（port-z42c-try）
    public string CurFnName;                                  // lift 命名用（port-z42c-closures）
    public int LambdaIdx;                                     // 本函数 lambda 计数（镜像 NextLambdaIndex）
    public bool InLambdaEnv;                                  // lift env 版：BoundCapturedIdent → array_get env(reg0)
    public string[] CaptureNames; public int CaptureNameCount;  // 当前 lifted lambda 的捕获名（env 布局序）→ 嵌套 lambda 解析外层捕获
    public StrMap LocalFnNames;     // impl-local-fn-l2：局部函数 local 名 → lifted 名（free call emit 改写）

    public EmitContext(SymbolTable symbols, IrGen gen) {
        this.Symbols = symbols; this.Gen = gen;
        this.Locals = new StrMap(); this.Fields = new StrMap(); this.ReadonlyFields = new StrMap();
        this.ConstLocals = new StrMap();
        this.Blocks = new IrBlock[4]; this.BlockCount = 0;
        this.NextReg = 0; this.MaxReg = 0; this.LabelSeq = 0;
        this.ContLabels = new string[4]; this.BreakLabels = new string[4];
        this.BreakFinFloor = new int[4]; this.ContFinFloor = new int[4]; this.LoopDepth = 0;
        this.RegTags = new int[8]; this.RegTagCount = 0;
        this.Lines = new IrLineEntry[8]; this.LineCount = 0; this.LastLine = 0;
        this.Ns = "";
        this.Deps = null;
        this.ImportedClassNs = null;
        this.ImportedFuncNs = null;
        this.ActiveNs = null; this.ActiveNsCount = 0;
        this.UsedDepNs = new string[4]; this.UsedDepNsCount = 0;
        this.ExcTable = new IrExcEntry[2]; this.ExcCount = 0;
        this.CurFnName = ""; this.LambdaIdx = 0; this.InLambdaEnv = false;
        this.CaptureNames = new string[0]; this.CaptureNameCount = 0;
        this.LocalFnNames = new StrMap();
    }

    public void AddExc(IrExcEntry e) {
        if (this.ExcCount == this.ExcTable.Length) {
            IrExcEntry[] b = new IrExcEntry[this.ExcTable.Length * 2];
            int k = 0; while (k < this.ExcCount) { b[k] = this.ExcTable[k]; k = k + 1; }
            this.ExcTable = b;
        }
        this.ExcTable[this.ExcCount] = e;
        this.ExcCount = this.ExcCount + 1;
    }

    // 记录命中的依赖 ns（首现序去重；镜像 C# TrackDepNamespace）。
    public void TrackDepNamespace(string ns) {
        int i = 0;
        while (i < this.UsedDepNsCount) {
            if (this.UsedDepNs[i] == ns) { return; }
            i = i + 1;
        }
        if (this.UsedDepNsCount == this.UsedDepNs.Length) {
            string[] b = new string[this.UsedDepNs.Length * 2];
            int k = 0; while (k < this.UsedDepNsCount) { b[k] = this.UsedDepNs[k]; k = k + 1; }
            this.UsedDepNs = b;
        }
        this.UsedDepNs[this.UsedDepNsCount] = ns;
        this.UsedDepNsCount = this.UsedDepNsCount + 1;
    }

    // 类名限定（镜像 C# QualifyClassName）：imported 类 → 其原 ns 前缀；否则按模块 ns 限定。
    public string QualifyClass(string name) {
        if (this.ImportedClassNs != null && this.ImportedClassNs.ContainsKey(name)) {
            StrBox b = this.ImportedClassNs.Get(name) as StrBox;
            if (b != null) { return b.Value + "." + name; }
        }
        return this.Qualify(name);
    }

    // 自由函数名限定（fix-imported-free-func-namespace，镜像 QualifyClass）：跨包 imported 自由函数
    // → 其源 ns 前缀（并追踪依赖 ns，使 DEPS 收录、加载器能解析）；否则回落 Qualify（当前 ns）。
    // ImportedFuncNs 已由 _filterShadowedFuncs 剔除本地遮蔽名（local-wins：本地同名函数不误绑到导入份）。
    public string QualifyFreeFunc(string name) {
        if (this.ImportedFuncNs != null && this.ImportedFuncNs.ContainsKey(name)) {
            StrBox b = this.ImportedFuncNs.Get(name) as StrBox;
            if (b != null) { this.TrackDepNamespace(b.Value); return b.Value + "." + name; }
        }
        return this.Qualify(name);
    }

    // is / as / cast 的目标类型名限定（fix-boxed-primitive-is-as）：基元别名（string/int/…）→
    // FQ 包装类（Std.String / Std.Int32 …），否则 QualifyClass。基元关键字不该被当前 ns 限定
    // ——`QualifyClass("string")` 曾无 imported 命中 → 误加当前 ns 前缀（"I.string"），致
    // `is/as <prim>` 运行时永不匹配。
    public string QualifyTypeName(string name) {
        if (name == "object") { return "Std.Object"; }   // 万物基类别名（不走 ns 限定）
        string w = EmitContext._primWrapper(name);
        if (w != name) { return "Std." + w; }   // 是基元别名 → FQ 包装类
        return this.QualifyClass(name);
    }

    // receiver 类链是否自有该方法（IC-1 反劫持守卫）。**仅本地声明类**——镜像 C#
    // ReceiverChainHasMethod 走 codegen `ClassRegistry`（只含本包声明/编译的类，不含 imported）。
    // 非本地类（imported / 外部，不在 LocalClasses）→ 停止返回 false，交由 DepIndex instance 捷径
    // 走 FQ Call（`Ns.Class.Method`）：①imported receiver（z42c.syntax `_diags.Error` → `Z42.Core.
    // DiagnosticBag.Error`）。本地类（含本包跨-ns 自有类如 z42c.ir BinaryFormat 段）→ 认 vtable-owned
    // → VCall，不误劫持到同名外部方法（G18 修正：原误用含自有跨-ns 类的 ImportedClassNs → ByteWriter.
    // ToHex 被劫持到 Std.Numerics.BigInt.ToHex 等虚假 DEPS）。
    public bool ChainHasMethod(string clsName, string method) {
        string cur = clsName;
        int hops = 0;
        while (hops < 32) {
            // 泛型实例化名（List<string>）→ 裸名（List）查 LocalClasses/SymbolTable。
            string bare = cur;
            int bi = 0;
            bool foundAngle = false;
            while (bi < bare.Length && !foundAngle) {
                if (bare.CharAt(bi) == '<') { bare = bare.Substring(0, bi); foundAngle = true; }
                bi = bi + 1;
            }
            // IC-3 prim→wrapper：prim 别名（"string"）→ 包装类名（"String"）再查 LocalClasses
            // 镜像 C# ReceiverChainHasMethod 经 QualifyClassName 把 prim 映射到 "Std.String" 等
            // FQ 类名在 ClassRegistry 查找；z42c 用短名 LocalClasses，故只需 bare→wrapper 映射。
            string lookup = EmitContext._primWrapper(bare);
            if (this.LocalClasses == null || !this.LocalClasses.ContainsKey(lookup)) { return false; }   // 非本地声明类 → 不算 vtable-owned
            if (!this.Symbols.HasClass(lookup)) { return false; }
            Z42ClassType ct = this.Symbols.GetClass(lookup);
            if (ct.Methods.ContainsKey(method)) { return true; }
            if (!ct.HasBase || ct.BaseName == "") { return false; }
            cur = ct.BaseName;
            hops = hops + 1;
        }
        return false;
    }

    // receiver 静态类型的该方法是否**虚**（virtual / abstract / 经 override 参与 vtable）。
    // 跨 zpkg 具体基类 override 的根因修复：imported 类走 ChainHasMethod 恒 false → 落 DepIndex
    // instance 直呼捷径（FQ Call `Ns.Base.M`），把基类实现**编译期钉死** → 子类 override 永不
    // 生效（`BuildHooks h = new ProjectHooks(); h.BeforeAssets()` 只跑基类 no-op）。虚方法必须
    // VCall 交由运行时按接收者实际 type_desc.vtable 派发。此处独立于 ChainHasMethod（后者刻意
    // 只认本地类做反劫持），专判「imported 虚方法」这一必须 VCall 的子集。
    //
    // imported 类的 OwnMethod*（TSIG 已展开继承方法到每个类）直接携带 virtual/abstract flag，
    // 故查接收者自身 Z42ClassType 即可命中「接收者静态类型 = 基类本身」的主场景；再沿 BaseName
    // 走一次链（经 Symbols）兜住「静态类型是某中间类、方法虚自更上层」。prim 接收者（string/int，
    // Type() 非 Z42ClassType）→ false → 仍走既有 prim 派发，不受影响。
    public bool ReceiverMethodIsVirtual(Z42Type recvType, string method) {
        Z42ClassType ct = recvType as Z42ClassType;
        int hops = 0;
        while (ct != null && hops < 32) {
            int i = 0;
            while (i < ct.OwnMethodCount) {
                string nm = ct.OwnMethodNames[i];
                // OwnMethodNames 可能是 arity 后缀键（"M$1"）；bare 前缀匹配。
                bool hit = nm == method;
                if (!hit && nm.Length > method.Length && nm.StartsWith(method)
                    && nm.CharAt(method.Length) == '$') { hit = true; }
                if (hit && (ct.OwnMethodIsVirtual[i] || ct.OwnMethodIsAbstract[i])) { return true; }
                i = i + 1;
            }
            if (!ct.HasBase || ct.BaseName == "") { return false; }
            string bare = ct.BaseName;
            int bi = 0;
            while (bi < bare.Length) { if (bare.CharAt(bi) == '<') { bare = bare.Substring(0, bi); bi = bare.Length; } else { bi = bi + 1; } }
            if (this.Symbols == null || !this.Symbols.HasClass(bare)) { return false; }
            ct = this.Symbols.GetClass(bare);
            hops = hops + 1;
        }
        return false;
    }

    // prim 别名 → 包装类名（镜像 TypeChecker._primWrapper；ChainHasMethod IC-3 映射用）。
    private static string _primWrapper(string n) {
        if (n == "string")              { return "String"; }
        if (n == "int"    || n == "i32") { return "Int32"; }
        if (n == "long"   || n == "i64") { return "Int64"; }
        if (n == "short"  || n == "i16") { return "Int16"; }
        if (n == "sbyte"  || n == "i8")  { return "SByte"; }
        if (n == "byte"   || n == "u8")  { return "Byte"; }
        if (n == "ushort" || n == "u16") { return "UInt16"; }
        if (n == "uint"   || n == "u32") { return "UInt32"; }
        if (n == "ulong"  || n == "u64") { return "UInt64"; }
        if (n == "float"  || n == "f32") { return "Single"; }
        if (n == "double" || n == "f64") { return "Double"; }
        if (n == "bool")                { return "Boolean"; }
        if (n == "char")                { return "Char"; }
        return n;   // 已是类名（"String"/"List" 等）→ 原样
    }

    // 类的声明 ns 是否异于当前模块 ns（跨-ns，含 imported）。G18i：`as`-cast 到跨-ns 类后字段读
    // 结果 tag → Unknown（镜像 C#：cast-to-cross-ns-class 不加载目标类字段；param/var 已声明类型则加载）。
    public bool IsCrossNs(string clsName) {
        if (this.ImportedClassNs == null || !this.ImportedClassNs.ContainsKey(clsName)) { return false; }
        StrBox b = this.ImportedClassNs.Get(clsName) as StrBox;
        if (b == null) { return false; }
        return b.Value != this.Ns;
    }

    // imported receiver 的依赖 ns 追踪（IC-1 镜像 C# VCall fallback 行 198-200）。
    public void TrackImportedClass(string clsName) {
        if (this.ImportedClassNs != null && this.ImportedClassNs.ContainsKey(clsName)) {
            StrBox b = this.ImportedClassNs.Get(clsName) as StrBox;
            if (b != null) { this.TrackDepNamespace(b.Value); }
        }
    }

    // 名字限定（镜像 C# QualifyName）：已含 '.' 视为已限定；ns 空则原样。
    public string Qualify(string name) {
        if (this.Ns == "") { return name; }
        int i = 0;
        while (i < name.Length) {
            if (name.CharAt(i) == '.') { return name; }
            i = i + 1;
        }
        return this.Ns + "." + name;
    }

    // 每语句记源码行（镜像 C# FunctionEmitter.TrackLine）：行号≤0 或与上条同行 → 跳过；
    // blockIdx = 当前块（= 已封块数），instrIdx = 当前块内指令数；file 取 basename（跨机器可复现）。
    public void TrackLine(Span sp) {
        if (sp.Line <= 0 || sp.Line == this.LastLine) { return; }
        this.LastLine = sp.Line;
        string file = EmitContext.BaseName(sp.File);
        bool hasFile = file != "";
        if (this.LineCount == this.Lines.Length) {
            IrLineEntry[] bigger = new IrLineEntry[this.Lines.Length * 2];
            int i = 0; while (i < this.LineCount) { bigger[i] = this.Lines[i]; i = i + 1; }
            this.Lines = bigger;
        }
        this.Lines[this.LineCount] = new IrLineEntry(this.BlockCount, this.CurCount, sp.Line, hasFile, file, sp.Column);
        this.LineCount = this.LineCount + 1;
    }

    // 末路径段（同切 `/` 与 `\`，镜像 C# BaseName——结果与产出路径的 OS 无关）。空 → ""。
    public static string BaseName(string path) {
        if (path == "") { return ""; }
        int cut = 0 - 1;
        int i = path.Length - 1;
        bool more = i >= 0;
        while (more) {
            char c = path.CharAt(i);
            if (c == '/' || c == '\\') { cut = i; more = false; }
            else { i = i - 1; more = i >= 0; }
        }
        if (cut < 0) { return path; }
        return path.Substring(cut + 1, path.Length - cut - 1);
    }

    // 局部变量表快照（镜像 C# SnapshotLocalVarTable：全部 locals 按 RegId 升序——hash 序经排序后确定）。
    public IrLocalVarEntry[] SnapshotLocals() {
        string[] names = this.Locals.Keys();
        int n = names.Length;
        IrLocalVarEntry[] r = new IrLocalVarEntry[n];
        int i = 0;
        while (i < n) {
            TypedReg tr = this.Locals.Get(names[i]) as TypedReg;
            r[i] = new IrLocalVarEntry(names[i], tr.Id);
            i = i + 1;
        }
        // 插入排序 by RegId
        i = 1;
        while (i < n) {
            IrLocalVarEntry key = r[i];
            int j = i - 1;
            bool m2 = j >= 0;
            while (m2) {
                if (r[j].RegId > key.RegId) { r[j + 1] = r[j]; j = j - 1; m2 = j >= 0; }
                else { m2 = false; }
            }
            r[j + 1] = key;
            i = i + 1;
        }
        return r;
    }

    // 线性寄存器分配（不复用）。记 reg→tag（REGT）。
    public TypedReg Alloc(int tag) {
        TypedReg r = new TypedReg(this.NextReg, tag);
        this.RecordReg(this.NextReg, tag);
        this.NextReg = this.NextReg + 1;
        if (this.NextReg > this.MaxReg) { this.MaxReg = this.NextReg; }
        return r;
    }

    // 记 reg id 的类型标签（params/this 直接构造 TypedReg 时也须记，使 RegTags 全覆盖 0..MaxReg）。
    public void RecordReg(int id, int tag) {
        while (id >= this.RegTags.Length) {
            int[] bigger = new int[this.RegTags.Length * 2];
            int i = 0; while (i < this.RegTagCount) { bigger[i] = this.RegTags[i]; i = i + 1; }
            this.RegTags = bigger;
        }
        this.RegTags[id] = tag;
        if (id + 1 > this.RegTagCount) { this.RegTagCount = id + 1; }
    }

    public void Emit(IrInstr ins) {
        if (this.CurCount == this.Cur.Length) {
            IrInstr[] bigger = new IrInstr[this.Cur.Length * 2];
            int i = 0; while (i < this.CurCount) { bigger[i] = this.Cur[i]; i = i + 1; }
            this.Cur = bigger;
        }
        this.Cur[this.CurCount] = ins;
        this.CurCount = this.CurCount + 1;
    }

    public void StartBlock(string label) {
        this.CurLabel = label; this.Cur = new IrInstr[8]; this.CurCount = 0; this.Ended = false;
    }

    public void EndBlock(IrTerminator term) {
        if (this.Ended) { return; }
        if (this.BlockCount == this.Blocks.Length) {
            IrBlock[] bigger = new IrBlock[this.Blocks.Length * 2];
            int i = 0; while (i < this.BlockCount) { bigger[i] = this.Blocks[i]; i = i + 1; }
            this.Blocks = bigger;
        }
        this.Blocks[this.BlockCount] = new IrBlock(this.CurLabel, this.Cur, this.CurCount, term, true);
        this.BlockCount = this.BlockCount + 1;
        this.Ended = true;
    }

    public string Fresh(string hint) {
        string r = hint + "_" + this.LabelSeq.ToString();
        this.LabelSeq = this.LabelSeq + 1;
        return r;
    }

    // breakFloor/contFloor = 分别在 break/continue 退出本层时应跑到的 finally 底深（FunctionEmitter
    // 传入）。真循环两者相等（=入栈时 finally 深）；switch 的 continue 转发外层循环，contFloor 继承外层。
    public void PushLoop(string contL, string breakL, int breakFloor, int contFloor) {
        if (this.LoopDepth == this.ContLabels.Length) {
            string[] bc = new string[this.ContLabels.Length * 2];
            string[] bb = new string[this.BreakLabels.Length * 2];
            int[]    kf = new int[this.BreakFinFloor.Length * 2];
            int[]    cf = new int[this.ContFinFloor.Length * 2];
            int i = 0;
            while (i < this.LoopDepth) {
                bc[i] = this.ContLabels[i]; bb[i] = this.BreakLabels[i];
                kf[i] = this.BreakFinFloor[i]; cf[i] = this.ContFinFloor[i]; i = i + 1;
            }
            this.ContLabels = bc; this.BreakLabels = bb; this.BreakFinFloor = kf; this.ContFinFloor = cf;
        }
        this.ContLabels[this.LoopDepth] = contL;
        this.BreakLabels[this.LoopDepth] = breakL;
        this.BreakFinFloor[this.LoopDepth] = breakFloor;
        this.ContFinFloor[this.LoopDepth] = contFloor;
        this.LoopDepth = this.LoopDepth + 1;
    }
    public void   PopLoop()     { this.LoopDepth = this.LoopDepth - 1; }
    public bool   InLoop()      { return this.LoopDepth > 0; }
    public string CurBreak()    { return this.BreakLabels[this.LoopDepth - 1]; }
    public string CurContinue() { return this.ContLabels[this.LoopDepth - 1]; }
    public int    CurBreakFinFloor() { return this.BreakFinFloor[this.LoopDepth - 1]; }
    public int    CurContFinFloor()  { return this.ContFinFloor[this.LoopDepth - 1]; }

    // Z42Type → IrType 标签（z42c.ir 是无依赖叶子不能引用 Z42Type，故映射在 semantics 侧）。
    public int ToIrType(Z42Type t) {
        if (t is Z42VoidType) { return IrType.Void; }
        if (t is Z42PrimType) { return this.PrimTag(t.Name()); }
        if (t is Z42ClassType) { return IrType.Ref; }
        if (t is Z42ArrayType) { return IrType.Ref; }
        // Interface / InstantiatedType / GenericParam / Error / func → Unknown(0x00)
        // 镜像 C# ToIrType: only PrimType/ClassType/ArrayType/OptionType/NullType→Ref；
        // 其余（含接口、泛型实例化、泛型形参）→ Unknown。
        return IrType.Unknown;
    }

    // prim 名（含别名，ResolveType 不规范化）→ IrType 标签。镜像 C# TypeRegistry（int→i32, long→i64）。
    public int PrimTag(string n) {
        if (n == "int" || n == "i32" || n == "Int32") { return IrType.I32; }
        if (n == "long" || n == "i64" || n == "Int64") { return IrType.I64; }
        if (n == "i8" || n == "sbyte" || n == "SByte") { return IrType.I8; }
        if (n == "i16" || n == "short" || n == "Int16") { return IrType.I16; }
        if (n == "u8" || n == "byte" || n == "Byte") { return IrType.U8; }
        if (n == "u16" || n == "ushort" || n == "UInt16") { return IrType.U16; }
        if (n == "u32" || n == "uint" || n == "UInt32") { return IrType.U32; }
        if (n == "u64" || n == "ulong" || n == "UInt64") { return IrType.U64; }
        if (n == "float" || n == "f32" || n == "Single") { return IrType.F32; }
        if (n == "double" || n == "f64" || n == "Double") { return IrType.F64; }
        if (n == "bool" || n == "Boolean") { return IrType.Bool; }
        if (n == "char" || n == "Char") { return IrType.Char; }
        if (n == "string" || n == "String") { return IrType.Str; }
        return IrType.Ref;   // object / 未知 → ref
    }
}
