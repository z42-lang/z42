// 声明绑定编排子绑定器（compiler-review P1-1 step5：拆 TypeChecker God-Class 收官）。
// 顶层声明的类型检查驱动（类/自由函数/impl/合成 ctor/字段 init/方法体/重复检测）。
// TypeChecker 降为协调器：Infer 分派 → _decl.*；持 _tc 反向引用触达 _expr/_stmt/_overload/_diags/_unwrap。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;

public sealed class DeclBinder {
    private TypeChecker _tc;
    public DeclBinder(TypeChecker tc) { this._tc = tc; }

    // add-static-properties：实例 auto 属性初始化器 `T P { get; set; } = e;` → `this.__prop_P = e`。
    // **直写后备、不经 setter**（对标 C#：初始化器是字段初始化，派生类 override 的 setter 不参与；get-only
    // 没有 setter 也能初始化）。`__prop_P` 不在 Fields 表里 ⇒ AccessEmitter 按原名发 field_set，恰好落到后备。
    // 无初始化器 / 静态 / 无存储（计算属性，E0452 由 _bindClass 每声明报一次）→ null。
    private BoundStmt _propInstanceInit(PropertyDecl pd, Z42ClassType ct, TypeEnv env) {
        if (!pd.HasInit || ct == null) { return null; }
        FieldSymbol ps = ct.Fields.Get(pd.Name) as FieldSymbol;
        if (ps == null || ps.IsStatic || ps.PropBackingName == "") { return null; }
        BoundExpr pv = this._tc._expr.BindInitValue(pd.Init, ps.FieldType, env);
        BoundExpr pt = new BoundMember(new BoundIdent("this", ct, pd.Span), ps.PropBackingName, ps.FieldType, pd.Span);
        return new BoundExprStmt(new BoundAssign(pt, pv, ps.FieldType, pd.Span), pd.Span);
    }

    // 体绑定环境里的**实例**字段（含 _passInheritFields 并入的继承字段）作变量，供裸名访问。
    // add-static-properties：static / const 不进——此前一并定义，实例体里的裸名静态成员于是被当实例字段、
    // 发 `field_get reg0.x` 静默读回 Null；现在它们在 LookupVar 落空后由 BindBareStatic 解析成 `C.x`。
    internal static void _defineInstanceFields(TypeEnv env, Z42ClassType ct) {
        string[] fnames = ct.Fields.Keys();
        int k = 0;
        while (k < fnames.Length) {
            FieldSymbol fs = ct.Fields.Get(fnames[k]) as FieldSymbol;
            if (!fs.IsStatic) { env.Define(fnames[k], fs.FieldType); }
            k = k + 1;
        }
    }

    // stabilize-instance-dispatch-keys：判重键从 `md.RegKey` 改为**全签名 MangleKey**。
    // 老键下碰撞的重载（`G(string)`/`G(string?)`、`F(int)`/`F(Int32)`——Canon 归一 nullable/包装名后同签名）
    // 共享同一 RegKey，靠「RegKey 重复」即可判重；新键下 primary=裸、非-primary=全键，二者 RegKey
    // **不再相同** → 漏判。故这里按符号的语义签名重算全键（Canon 归一，同 MemberCollector 的键规则），
    // 与兄弟集无关、只看方法自身签名 → 判重恢复且不随 primary 选取漂移。
    // decl-only 的 partial 方法：**判重要当它不存在**（fix-partial-method-overloads）。
    //
    // 它确实不存在 —— `MemberCollector`（:262「无实现即不存在，不注册桩/体」）把它整个擦除，
    // `ct.Methods` 里没有它。让它参与判重会双重出错：
    //   ① 它的「重复」对象其实是**它自己的实现**（两者签名按定义必须一致，E0434 就是这么要求的）
    //      ⇒ 每个 partial 方法都会被报成重复；
    //   ② 擦除路径给实例方法的键**恒为裸 `md.Name`**（同处注释：`tracks` 为 false → primary 决议
    //      整块跳过）⇒ 同名的两个 decl-only 重载共用一个键，`_dupSigKey` 顺着这个键查到**同一个**
    //      符号、算出同一个签名键 ⇒ 报「参数类型相同」。
    //      实测：`partial string Log(string m);` + `partial string Log(int n);` 直接 E0408，
    //      而 string 与 int 显然不同 —— 诊断文案说的「aliases 归一后相同」纯属误报。
    //
    // 排除它们之后，判重看到的恰好是**最终真会存在的那组方法**（即各实现），语义对齐。
    // 真正的重复（两个实现同签名）照报不误。
    private static bool _isErasedPartialDecl(MethodDecl md) {
        return md.IsPartial && !md.HasBody;
    }

    private string _dupSigKey(Z42ClassType ct, MethodDecl md) {
        if (ct != null && md.RegKey != "") {
            MethodSymbol dms = ct.Methods.Get(md.RegKey) as MethodSymbol;
            if (dms != null && dms.Signature != null) {
                return OverloadResolver.MangleKey(md.Name, dms.Signature.ParamTypes, dms.Signature.ParamCount);
            }
        }
        return md.RegKey;   // 符号缺失（decl-only partial 等）→ 回落老行为
    }

    private void _checkDuplicateStaticOverloads(ClassDecl c, Z42ClassType ct) {
        StrMap seenArity = new StrMap();   // (static|inst)$name$arity → 首次见
        StrMap dupArity  = new StrMap();   // 同键 → 该 arity ≥2 个方法
        int i = 0;
        while (i < c.MemberCount) {
            Decl mem = this._tc._unwrap(c.Members[i]);
            if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                if (!SymbolCollector.IsProtocolExempt(md.Name) && !DeclBinder._isErasedPartialDecl(md)) {
                    string ak = this._dupCheckKey(md);
                    if (seenArity.ContainsKey(ak)) { dupArity.Put(ak, "1"); }
                    else { seenArity.Put(ak, "1"); }
                }
            }
            i = i + 1;
        }
        StrMap seenKey = new StrMap();
        i = 0;
        while (i < c.MemberCount) {
            Decl mem = this._tc._unwrap(c.Members[i]);
            if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                if (!SymbolCollector.IsProtocolExempt(md.Name) && !DeclBinder._isErasedPartialDecl(md)) {
                    string ak = this._dupCheckKey(md);
                    if (dupArity.ContainsKey(ak)) {
                        string sk = this._dupSigKey(ct, md);
                        if (seenKey.ContainsKey(sk)) {
                            this._tc._diags.Error(DiagnosticCodes.DuplicateDeclaration,
                                "duplicate overload `" + md.Name + "` — parameter types are identical once " +
                                "aliases (e.g. int/Int32) and nullability are normalized", md.Span);
                        } else {
                            seenKey.Put(sk, "1");
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    private string _dupCheckKey(MethodDecl md) {
        string bucket = TypeFactsTc._hasWordTc(md.Mods, "static") ? "s$" : "i$";
        return bucket + md.Name + "$" + md.ParamCount.ToString();
    }

    internal void _bindImpl(SemanticModel model, SymbolTable symbols, ImplDecl im) {
        string targetName = "";
        if (im.TargetType is NamedType) { targetName = (im.TargetType as NamedType).Name; }
        if (targetName == "" || !symbols.HasClass(targetName)) { return; }
        Z42ClassType ct = symbols.GetClass(targetName);
        int j = 0;
        while (j < im.MethodCount) {
            if (im.Methods[j] is MethodDecl) {
                MethodDecl md = im.Methods[j] as MethodDecl;
                if (md.HasBody) {
                    string mkey = OverloadResolver.MethodKeyOf(md);
                    MethodSymbol ms = ct.Methods.Get(mkey) as MethodSymbol;
                    int mtpc = md.TypeParams.Count;
                    string[] allParams = this._mergeParams(new string[0], 0, md.TypeParams.Names, mtpc);
                    // add-generic-methods：impl 方法无类形参 → classParamCount=0，全部为方法级。
                    var env = TypeEnv.Root(symbols).WithClassGenericMethod(ct.Name(), allParams, mtpc, 0, false);
                    if (ms != null && !ms.IsStatic) {
                        env.Define("this", ct);
                        DeclBinder._defineInstanceFields(env, ct);
                    }
                    BoundStmt body = this._bindMethodBody(symbols, env, md);
                    model.AddBody(targetName + "." + mkey, body);
                }
            }
            j = j + 1;
        }
    }

    internal void _bindClass(SemanticModel model, SymbolTable symbols, ClassDecl c) {
        // Arity-mangle：泛型类若以 Name$N 键注册，优先取该 CT。
        string ctKey = c.Name;
        if (c.TypeParams.Count > 0) { string mk = c.Name + "$" + c.TypeParams.Count.ToString(); if (symbols.HasClass(mk)) { ctKey = mk; } }
        Z42ClassType ct = symbols.GetClass(ctKey);
        this._checkDuplicateStaticOverloads(c, ct);
        this._checkExposure(symbols, c, ct);   // complete-class-access-control ②：不一致可访问性（E0441）
        int j = 0;
        while (j < c.MemberCount) {
            Decl mem = this._tc._unwrap(c.Members[j]);
            if (mem is FieldDecl) {                                  // 静态字段 init（SA-3）
                FieldDecl fd = mem as FieldDecl;
                FieldSymbol fsym = ct.Fields.Get(fd.Name) as FieldSymbol;
                // add-static-constructors：**有静态构造器的类**，其静态字段初始化器不进
                // per-CU `__static_init__`，改为注入到该类的静态 ctor 体首（见
                // _injectStaticFieldInits）——这样「字段初始化器在前、cctor 体在后」的 C# 顺序
                // 才成立。此前两者分处两个函数，cctor 被触发时 __static_init__ 可能还没跑完，
                // 会出现「cctor 写了 42、随后 __static_init__ 又覆写回 1」的错值。
                //
                // 没有静态 ctor 的类保持原样（继续走 per-CU 急切初始化）——这**本来就合规**：
                // C# 里只有显式静态 ctor 才失去 beforefieldinit、才要求精确的「首次使用前」。
                if (fd.HasInit && fsym != null && fsym.IsStatic && !fsym.IsConst
                    && !DeclBinder._hasStaticCtor(this._tc, c)) {   // add-const-keyword：const 无静态存储/初始化（引用替换为字面量）
                    var fenv = TypeEnv.Root(symbols);
                    // add-target-typed-new：`static A f = new()` 以字段类型为目标。
                    model.AddStaticInit(c.Name, fd.Name, this._tc._expr.BindWithTarget(fd.Init, fenv.ResolveType(fd.Type), fenv));
                }
            } else if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                if (md.HasBody) {                       // G11：ctor（IsCtor）也绑体——ms 已收集（名=类名，ret void），this+字段入 scope
                    string mkey = OverloadResolver.MethodKeyOf(md);
                    MethodSymbol ms = ct.Methods.Get(mkey) as MethodSymbol;
                    // 活跃类型形参 = 类的 + 方法自身的（2A-2）。
                    int mtpc = md.TypeParams.Count;
                    string[] allParams = this._mergeParams(c.TypeParams.Names, c.TypeParams.Count, md.TypeParams.Names, mtpc);
                    // add-readonly-fields-opt：实例 ctor 体（含注入的字段初始化器）用 InCtorThis scope → readonly 可赋值。
                    bool inCtor = md.IsCtor && !ms.IsStatic;
                    // add-generic-methods：allParams = 类形参(前 c.TypeParams.Count 个) + 方法形参(后 mtpc 个)。
                    var env = TypeEnv.Root(symbols).WithClassGenericMethod(
                        ct.Name(), allParams, c.TypeParams.Count + mtpc, c.TypeParams.Count, inCtor);
                    // add-static-constructors：静态 ctor 体 → 放行本类 static readonly 赋值（C# 语义）。
                    // 这是 fix-static-readonly-not-enforced（#544）在 AssignTyper 里显式标注的耦合点。
                    if (md.IsCtor && ms.IsStatic) { env.InStaticCtor = true; }
                    if (!ms.IsStatic) {
                        env.Define("this", ct);
                        DeclBinder._defineInstanceFields(env, ct);
                    }
                    BoundStmt body = this._bindMethodBody(symbols, env, md);
                    // 实例 ctor：注入实例字段初始化器（`int x=1`）到体首（base 调用后、用户体前）。
                    // 此前完全未注入 → 字段停留类型默认值（got 0/null）。仅 ctor-exists 路径；
                    // ctor-less 类的合成 ctor 待 follow-up。
                    if (md.IsCtor && !ms.IsStatic && !md.IsThisInit) { body = this._injectFieldInits(c, ct, env, body); }
                    // add-static-constructors：静态 ctor = 该类型的**类型初始化器**——
                    // 字段初始化器在前、用户体在后（C# 顺序）。与上面的 per-CU 跳过成对。
                    if (md.IsCtor && ms.IsStatic) { body = this._injectStaticFieldInits(c, ct, env, body); }
                    model.AddBody(ctKey + "." + mkey, body);   // GS3：body 键用 mkey（重载时=Name$arity）；arity-mangle 时用 ctKey（Name$N）
                }
            } else if (mem is PropertyDecl) {
                // add-property-getter：计算属性 getter body 绑定 → get_<Name>（镜像 IndexerDecl get，无索引参数）。
                PropertyDecl pd = mem as PropertyDecl;
                // add-static-properties：初始化器只能落在有存储的属性上（auto）；每个声明报一次（注入点可能有多个 ctor）。
                FieldSymbol pinitSym = ct.Fields.Get(pd.Name) as FieldSymbol;
                if (pd.HasInit && pinitSym != null && pinitSym.PropBackingName == "") {
                    this._tc._diags.Error(DiagnosticCodes.PropertyNoSetter,
                        "cannot initialize property `" + pd.Name + "`: it has no backing storage (only auto-properties can have an initializer)", pd.Span);
                }
                // 静态 auto 属性初始化器：同静态字段——无静态 ctor 进 per-CU `__static_init__`，有则注入其体首。
                if (pd.HasInit && pinitSym != null && pinitSym.IsStatic && pinitSym.PropBackingName != ""
                    && !DeclBinder._hasStaticCtor(this._tc, c)) {
                    var penv = TypeEnv.Root(symbols);
                    model.AddStaticInit(c.Name, pinitSym.PropBackingName, this._tc._expr.BindInitValue(pd.Init, pinitSym.FieldType, penv));
                }
                if (pd.HasGetBody) {
                    var pgEnv = TypeEnv.Root(symbols).WithClassGeneric(ct.Name(), c.TypeParams.Names, c.TypeParams.Count);
                    // add-static-properties：静态计算 getter 是静态上下文——此前无条件定义 this 与字段。
                    if (!TypeFactsTc._hasWordTc(pd.Mods, "static")) {
                        pgEnv.Define("this", ct);
                        DeclBinder._defineInstanceFields(pgEnv, ct);
                    }
                    Z42Type pgret = pgEnv.ResolveType(pd.Type);
                    model.AddBody(ctKey + ".get_" + pd.Name, this._tc._stmt._bindStmt(pd.GetBody, pgEnv, pgret));
                }
                if (pd.HasSetBody) {
                    // add-property-custom-setter：自定义 setter body 绑定 → set_<Name>（镜像索引器 set_Item，无索引参数，
                    // 隐式 value 参 = 属性类型、void 返回）。静态属性走静态上下文（同计算 getter）。
                    var psEnv = TypeEnv.Root(symbols).WithClassGeneric(ct.Name(), c.TypeParams.Names, c.TypeParams.Count);
                    if (!TypeFactsTc._hasWordTc(pd.Mods, "static")) {
                        psEnv.Define("this", ct);
                        DeclBinder._defineInstanceFields(psEnv, ct);
                    }
                    psEnv.Define("value", psEnv.ResolveType(pd.Type));
                    model.AddBody(ctKey + ".set_" + pd.Name, this._tc._stmt._bindStmt(pd.SetBody, psEnv, new Z42VoidType()));
                }
            } else if (mem is IndexerDecl) {
                // get_Item / set_Item 体绑定（IndexerDecl lowering；镜像 C# IndexerDecl 处理）。
                IndexerDecl id = mem as IndexerDecl;
                if (id.HasGet) {
                    var getEnv = TypeEnv.Root(symbols).WithClassGeneric(ct.Name(), c.TypeParams.Names, c.TypeParams.Count);
                    getEnv.Define("this", ct);
                    DeclBinder._defineInstanceFields(getEnv, ct);
                    int gp = 0;
                    while (gp < id.ParamCount) { getEnv.Define(id.Params[gp].Name, getEnv.ResolveType(id.Params[gp].Type)); gp = gp + 1; }
                    Z42Type gret = getEnv.ResolveType(id.RetType);
                    model.AddBody(ctKey + ".get_Item", this._tc._stmt._bindStmt(id.GetBody, getEnv, gret));
                }
                if (id.HasSet) {
                    var setEnv = TypeEnv.Root(symbols).WithClassGeneric(ct.Name(), c.TypeParams.Names, c.TypeParams.Count);
                    setEnv.Define("this", ct);
                    DeclBinder._defineInstanceFields(setEnv, ct);
                    int sp = 0;
                    while (sp < id.ParamCount) { setEnv.Define(id.Params[sp].Name, setEnv.ResolveType(id.Params[sp].Type)); sp = sp + 1; }
                    setEnv.Define("value", setEnv.ResolveType(id.RetType));
                    model.AddBody(ctKey + ".set_Item", this._tc._stmt._bindStmt(id.SetBody, setEnv, new Z42VoidType()));
                }
            }
            j = j + 1;
        }
    }

    // complete-class-access-control ②：类的基类/接口/字段/方法签名不得暴露比声明本身更低可见性的类型
    // （C# CS0050 族 → E0441）。走 TypeChecker._diags（SemanticDump 计数）。
    private void _checkExposure(SymbolTable symbols, ClassDecl c, Z42ClassType ct) {
        if (ct == null) { return; }
        // 基类 + 接口 vs 类可见性
        if (ct.HasBase) {
            Z42ClassType bt = symbols.GetClass(ct.BaseName);
            if (bt != null) { AccessChecker.CheckExposure(ct.Visibility, bt, symbols, this._tc._diags, c.Span); }
        }
        int ii = 0;
        while (ii < ct.InterfaceCount) {
            Z42InterfaceType it = symbols.GetInterface(ct.InterfaceNames[ii]);
            if (it != null) { AccessChecker.CheckExposure(ct.Visibility, it, symbols, this._tc._diags, c.Span); }
            ii = ii + 1;
        }
        // 成员：字段类型 + 方法（含 ctor）返回/参数类型 vs 成员可见性
        int j = 0;
        while (j < c.MemberCount) {
            Decl mem = this._tc._unwrap(c.Members[j]);
            if (mem is FieldDecl) {
                FieldDecl fd = mem as FieldDecl;
                FieldSymbol fs = ct.Fields.Get(fd.Name) as FieldSymbol;
                if (fs != null) {
                    string fvis = AccessChecker.MinVisibility(fs.Visibility, ct.Visibility);   // 有效可访问性封顶
                    AccessChecker.CheckExposure(fvis, fs.FieldType, symbols, this._tc._diags, fd.Span);
                }
            } else if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                string mkey = OverloadResolver.MethodKeyOf(md);
                MethodSymbol ms = ct.Methods.Get(mkey) as MethodSymbol;
                if (ms != null) {
                    string mvis = AccessChecker.MinVisibility(ms.Visibility, ct.Visibility);   // 有效可访问性封顶
                    AccessChecker.CheckExposure(mvis, ms.Signature.Ret, symbols, this._tc._diags, md.Span);
                    int p = 0;
                    while (p < ms.Signature.ParamCount) {
                        AccessChecker.CheckExposure(mvis, ms.Signature.ParamTypes[p], symbols, this._tc._diags, md.Span);
                        p = p + 1;
                    }
                }
            }
            j = j + 1;
        }
    }

    internal void _bindFreeFunc(SemanticModel model, SymbolTable symbols, MethodDecl md) {
        if (md.HasBody) {
            // 顶层泛型函数携自身型参（classFlag=false）。
            var env = new TypeEnv(symbols, false, null, false, "", md.TypeParams.Names, md.TypeParams.Count, false);
            // add-generic-methods：自由函数无类形参 → 全部型参为**方法级**（ClassTypeParamCount=0），
            // 使 typeof(T)/new T()/default(T) 走 frame.method_type_args 通道（否则默认全类级 → 占位名）。
            env.ClassTypeParamCount = 0;
            BoundStmt body = this._bindMethodBody(symbols, env, md);
            // free-function-overloads：体按 RegKey 存（primary=裸名→与旧键相同；重载各份键唯一，避免同名撞体）。
            model.AddBody(md.RegKey, body);
        }
    }

    private string[] _mergeParams(string[] a, int ac, string[] b, int bc) {
        string[] r = new string[ac + bc];
        int i = 0;
        while (i < ac) { r[i] = a[i]; i = i + 1; }
        int j = 0;
        while (j < bc) { r[ac + j] = b[j]; j = j + 1; }
        return r;
    }

    // add-static-constructors：该类是否声明了静态构造器。
    // 判据与发射端（ClassDescBuilder._cctorFuncName）必须一致：IsCtor + static + 有体。
    internal static bool _hasStaticCtor(TypeChecker tc, ClassDecl c) {
        int j = 0;
        while (j < c.MemberCount) {
            Decl m = tc._unwrap(c.Members[j]);
            if (m is MethodDecl) {
                MethodDecl md = m as MethodDecl;
                if (md.IsCtor && TypeFactsTc._hasWordTc(md.Mods, "static") && md.HasBody) { return true; }
            }
            j = j + 1;
        }
        return false;
    }

    // add-static-constructors：把本类的**静态**字段初始化器注入静态 ctor 体首。
    // 镜像 _injectFieldInits（实例版），差别只有目标形态：`C.Field = init`（静态）
    // 而非 `this.Field = init`（实例）。
    //
    // 注意 env 此时 InStaticCtor=true，故 `static readonly` 字段的初始化器也能通过
    // AssignTyper 的只读检查（C# 同样允许静态 ctor 给 static readonly 赋值）。
    private BoundStmt _injectStaticFieldInits(ClassDecl c, Z42ClassType ct, TypeEnv env, BoundStmt body) {
        BoundStmt[] inits = new BoundStmt[c.MemberCount];
        int ic = 0;
        int j = 0;
        while (j < c.MemberCount) {
            Decl mem = this._tc._unwrap(c.Members[j]);
            if (mem is FieldDecl) {
                FieldDecl fd = mem as FieldDecl;
                FieldSymbol fsym = ct.Fields.Get(fd.Name) as FieldSymbol;
                if (fd.HasInit && fsym != null && fsym.IsStatic && !fsym.IsConst) {
                    Expr tgt = new MemberExpr(new IdentExpr(c.Name, fd.Span), fd.Name, fd.Span);
                    Expr asn = new AssignExpr("=", tgt, fd.Init, fd.Span);
                    inits[ic] = new BoundExprStmt(this._tc._expr._bindExpr(asn, env), fd.Span);
                    ic = ic + 1;
                }
            } else if (mem is PropertyDecl) {
                // add-static-properties：静态 auto 属性初始化器 → 直写静态后备 `C.__prop_X`（非属性型 BoundStaticGet
                // ⇒ 发 static_set 后备名），与字段按声明序交错。
                PropertyDecl spd = mem as PropertyDecl;
                FieldSymbol psym = ct.Fields.Get(spd.Name) as FieldSymbol;
                if (spd.HasInit && psym != null && psym.IsStatic && psym.PropBackingName != "") {
                    BoundExpr pv = this._tc._expr.BindInitValue(spd.Init, psym.FieldType, env);
                    BoundExpr pt = new BoundStaticGet(c.Name, psym.PropBackingName, psym.FieldType, spd.Span);
                    inits[ic] = new BoundExprStmt(new BoundAssign(pt, pv, psym.FieldType, spd.Span), spd.Span);
                    ic = ic + 1;
                }
            }
            j = j + 1;
        }
        if (ic == 0) { return body; }
        BoundStmt[] orig = new BoundStmt[1]; orig[0] = body; int origN = 1;
        if (body is BoundBlock) { BoundBlock bb = body as BoundBlock; orig = bb.Stmts; origN = bb.Count; }
        BoundStmt[] merged = new BoundStmt[ic + origN];
        int m = 0;
        while (m < ic) { merged[m] = inits[m]; m = m + 1; }
        int k = 0;
        while (k < origN) { merged[ic + k] = orig[k]; k = k + 1; }
        return new BoundBlock(merged, ic + origN, body.Span);
    }

    private BoundStmt _injectFieldInits(ClassDecl c, Z42ClassType ct, TypeEnv env, BoundStmt body) {
        BoundStmt[] inits = new BoundStmt[c.MemberCount];
        int ic = 0;
        int j = 0;
        while (j < c.MemberCount) {
            Decl mem = this._tc._unwrap(c.Members[j]);
            if (mem is FieldDecl) {
                FieldDecl fd = mem as FieldDecl;
                FieldSymbol fsym = ct.Fields.Get(fd.Name) as FieldSymbol;
                if (fd.HasInit && fsym != null && !fsym.IsStatic) {
                    Expr tgt = new MemberExpr(new IdentExpr("this", fd.Span), fd.Name, fd.Span);
                    Expr asn = new AssignExpr("=", tgt, fd.Init, fd.Span);
                    inits[ic] = new BoundExprStmt(this._tc._expr._bindExpr(asn, env), fd.Span);
                    ic = ic + 1;
                }
            } else if (mem is PropertyDecl) {
                BoundStmt pinit = this._propInstanceInit(mem as PropertyDecl, ct, env);
                if (pinit != null) { inits[ic] = pinit; ic = ic + 1; }
            }
            j = j + 1;
        }
        if (ic == 0) { return body; }
        BoundStmt[] orig = new BoundStmt[1]; orig[0] = body; int origN = 1;
        if (body is BoundBlock) { BoundBlock bb = body as BoundBlock; orig = bb.Stmts; origN = bb.Count; }
        BoundStmt[] merged = new BoundStmt[ic + origN];
        int m = 0;
        while (m < ic) { merged[m] = inits[m]; m = m + 1; }
        int k = 0;
        while (k < origN) { merged[ic + k] = orig[k]; k = k + 1; }
        return new BoundBlock(merged, ic + origN, body.Span);
    }

    // add-implicit-base-ctor-call：候选里是否有能以零个实参调用的实例 ctor（无参 / 形参全带默认值 / 只有 params 尾参）。
    // 本地 ctor 看声明；导入 ctor 没有声明，看签名携带的默认值 / caller 宏 / ParamsFrom。
    internal static bool _anyAcceptsZeroArgs(MethodSymbol[] ctors) {
        int i = 0;
        while (i < ctors.Length) {
            MethodSymbol m = ctors[i];
            if (m.HasDecl && m.Decl != null) {
                int pc = m.Decl.ParamCount;
                bool ok = true;
                int p = 0;
                while (p < pc) {
                    Param pr = m.Decl.Params[p];
                    if (pr.Default == null && !(pr.IsParams && p == pc - 1)) { ok = false; }
                    p = p + 1;
                }
                if (ok) { return true; }
            } else if (m.Signature != null) {
                Z42FuncType sig = m.Signature;
                bool ok2 = true;
                int q = 0;
                while (q < sig.ParamCount) {
                    bool isParams = sig.ParamsFrom >= 0 && q == sig.ParamsFrom;
                    bool hasDefault = sig.ParamDefaults != null && q < sig.ParamDefaults.Length
                                      && sig.ParamDefaults[q] != null && sig.ParamDefaults[q] != "";
                    bool hasCaller = sig.ParamCallers != null && q < sig.ParamCallers.Length
                                     && sig.ParamCallers[q] != null && sig.ParamCallers[q] != "";
                    if (!isParams && !hasDefault && !hasCaller) { ok2 = false; }
                    q = q + 1;
                }
                if (ok2) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    // add-definite-assignment：方法体绑定完统一过一遍 DA（局部未赋值就读 → E0407）。
    // 包成一层是因为 `_bindMethodBodyCore` 有两个返回点（普通体 / ctor 注入 base 调用后的体），
    // 挂在这里保证**只有一处**调用、且查的是最终交给发射层的那棵树。
    private BoundStmt _bindMethodBody(SymbolTable symbols, TypeEnv env, MethodDecl md) {
        BoundStmt body = this._bindMethodBodyCore(symbols, env, md);
        FlowAnalyzer.Check(body, md, this._tc._diags);
        return body;
    }

    private BoundStmt _bindMethodBodyCore(SymbolTable symbols, TypeEnv env, MethodDecl md) {
        int p = 0;
        while (p < md.ParamCount) {
            env.Define(md.Params[p].Name, env.ResolveType(md.Params[p].Type));
            p = p + 1;
        }
        // PR6b：记录当前 enclosing 成员名，供 caller_member!() 在本体内的调用点注入（三挂载点
        // 均经此：类方法 / impl / free func；lambda 走 _bindStmt 不重置 → 继承外层成员名，同 C#）。
        this._tc._curMemberName = md.Name;
        this._tc._curMethodDecl = md;   // fix-generic-operator-constraint-dispatch：体内 `a+b` 查方法级 where
        this._tc._noInitLocals = new StrMap();   // simplify-ref-parameters：每方法一张「无 init 局部」表
        // PR6b：定义侧校验 caller 宏参数默认值——名字白名单 + 参数类型（member/file/module→string，
        // line→int）。未知宏名 / 类型不符 → E0450。
        this._validateCallerMacroDefaults(env, md);
        Z42Type ret = env.ResolveType(md.RetType);
        BoundStmt body = this._tc._stmt._bindStmt(md.Body, env, ret);
        // ctor 初始化调用 → 在体首插入 call @TargetCls.CtorKey %0, ...args（镜像 C# FunctionEmitter
        // BoundThisCtorArgs / BoundBaseCtorArgs 两分支）：
        //   · `: this(args)` → 委托同类 ctor；`: base(args)` → 基类 ctor；
        //   · add-implicit-base-ctor-call：**没写子句**的实例 ctor ⇒ 隐式 `: base()`（对齐 C#）。基类没有任何
        //     实例 ctor ⇒ 无可调、不发调用；有 ctor 但无一可零实参调用 ⇒ E0469（须显式 `: base(...)`）。
        // 目标 ctor 的选择与实参适配（按类型的重载决议 / 命名实参 / 默认值 / params）与 `new` 共用
        // `BindCtorArgs`——此前这里只按实参个数取键，是另一套口径。
        // fix-ctor-init-silent-bugs：「有没有子句」看 HasCtorInit，不看实参个数（零实参子句曾被整条丢弃）。
        if (md.IsCtor && !TypeFactsTc._hasWordTc(md.Mods, "static")) {
            Z42Type thisType = env.LookupVar("this");
            if (thisType is Z42ClassType) {
                Z42ClassType curCls = thisType as Z42ClassType;
                Z42ClassType targetCls = null;
                string targetName = "";
                if (md.HasCtorInit && md.IsThisInit) {
                    targetCls = curCls;
                    targetName = curCls.Name();
                } else if (curCls.HasBase && curCls.BaseName != "" && curCls.BaseName != "Object") {
                    targetCls = symbols.GetClass(curCls.BaseName);
                    targetName = curCls.BaseName;
                }
                int argc = md.HasCtorInit ? md.BaseArgCount : 0;
                if (targetCls != null && argc == 0 && !(md.HasCtorInit && md.IsThisInit)) {
                    MethodSymbol[] tctors = targetCls.InstanceCtors();
                    if (tctors.Length == 0) {
                        targetCls = null;   // 基类没有构造器：没有可调用的目标
                    } else if (!md.HasCtorInit && !DeclBinder._anyAcceptsZeroArgs(tctors)) {
                        // 合成的默认构造器（派生类没写构造器、基类构造器又全是 private 继承不到）用户看不见，换一句能照做的提示。
                        string e0469 = md.IsSynthesized
                            ? "`" + curCls.Name() + "` has no constructor and cannot inherit one from `" + targetName
                              + "` (its constructors are not accessible or all take arguments); declare a constructor that calls `: base(...)`"
                            : "constructor of `" + curCls.Name() + "` must call a base constructor: `" + targetName
                              + "` has no constructor accepting 0 arguments (add `: base(...)`)";
                        this._tc._diags.Error(DiagnosticCodes.BaseCtorRequired, e0469, md.Span);
                        targetCls = null;
                    }
                }
                if (targetCls != null) {
                    Expr[] rawArgs = md.HasCtorInit ? md.BaseArgs : new Expr[0];
                    BoundCtorArgs ca = this._tc._expr.BindCtorArgs(targetCls, rawArgs, argc, env, md.Span);
                    BoundExpr[] callArgs = new BoundExpr[ca.Args.Length + 1];
                    callArgs[0] = new BoundIdent("this", thisType, md.Span);
                    int ba = 0;
                    while (ba < ca.Args.Length) { callArgs[ba + 1] = ca.Args[ba]; ba = ba + 1; }
                    BoundCall baseCall = new BoundCall("base_ctor", false, null, targetName, ca.Key,
                                                        callArgs, ca.Args.Length + 1, new Z42VoidType(), md.Span);
                    BoundExprStmt baseStmt = new BoundExprStmt(baseCall, md.Span);
                    BoundStmt[] stmts = null;
                    int sc = 0;
                    if (body is BoundBlock) {
                        BoundBlock bb = body as BoundBlock;
                        stmts = new BoundStmt[bb.Count + 1];
                        stmts[0] = baseStmt;
                        int si = 0;
                        while (si < bb.Count) { stmts[si + 1] = bb.Stmts[si]; si = si + 1; }
                        sc = bb.Count + 1;
                    } else {
                        stmts = new BoundStmt[2];
                        stmts[0] = baseStmt; stmts[1] = body; sc = 2;
                    }
                    return new BoundBlock(stmts, sc, md.Span);
                }
            }
        }
        return body;
    }

    // PR6b：定义侧校验 caller 宏参数默认值。宏经 parser 译成 IdentExpr("$macro:<name>") 哨兵
    // （见 MacroRegistry）。未知宏名 或 参数类型不符（member/file/module 须 string、line 须 int）→ E0450。
    // 合法 caller 宏在此不产码——持久化由 ClassDescBuilder、注入由 OverloadBinder。
    private void _validateCallerMacroDefaults(TypeEnv env, MethodDecl md) {
        int i = 0;
        while (i < md.ParamCount) {
            Expr dv = md.Params[i].Default;
            // add-symbol-availability-macro：**两种表面形态都要认**。
            // 无参 `name!()` → 裸 IdentExpr(哨兵)；带参 `name!(x)` → CallExpr(哨兵, args)。
            // 此前只认前者，于是 `available!(X)` 出现在参数默认值位会**静默放行**——而参数默认值
            // 必须是编译期常量（走 ConstBlob），available! 的值到加载期才定，绝不能进那条通道。
            if (dv != null && MacroRegistry.IsMacroCall(dv)) {
                string cmn = MacroRegistry.NameOf((dv as CallExpr).Callee);
                string cpos = MacroRegistry.PositionOf(cmn);
                if (cpos == "") {
                    this._tc._diags.Error(DiagnosticCodes.CallerMacroInvalid, "unknown compile-time macro '" + cmn + "!()'", dv.Span);
                } else {
                    // 已知的带参宏一律不是参数默认值位宏（caller 族全是无参形态）。
                    this._tc._diags.Error(DiagnosticCodes.CallerMacroInvalid, "'" + cmn + "!()' is not valid as a parameter default value", dv.Span);
                }
            } else if (dv != null && MacroRegistry.IsMacro(dv)) {
                string mn = MacroRegistry.NameOf(dv);
                // add-symbol-availability-macro：判「未知宏」改用 PositionOf——KindOf 返回 "" 不再
                // 等价于未知（available 也返回 ""）。表达式位宏落到参数默认值位 → 精确报「位置不对」。
                string pos = MacroRegistry.PositionOf(mn);
                if (pos == "") {
                    this._tc._diags.Error(DiagnosticCodes.CallerMacroInvalid, "unknown compile-time macro '" + mn + "!()'", dv.Span);
                } else if (pos != "param-default") {
                    this._tc._diags.Error(DiagnosticCodes.CallerMacroInvalid, "'" + mn + "!()' is not valid as a parameter default value", dv.Span);
                } else {
                    string kind = MacroRegistry.KindOf(mn);
                    Z42Type pt = env.ResolveType(md.Params[i].Type);
                    // 归一到表面 keyword（Int32/Std.String… → int/string）再比对。
                    if (!MacroRegistry.ParamTypeOk(kind, PrimModel.SurfaceName(pt.Name()))) {
                        string need = (kind == "line") ? "int" : "string";
                        this._tc._diags.Error(DiagnosticCodes.CallerMacroInvalid, "'" + mn + "!()' requires a " + need + " parameter", dv.Span);
                    }
                }
            }
            i = i + 1;
        }
    }

}