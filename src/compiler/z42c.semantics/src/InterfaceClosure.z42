// 接口成员的**父接口闭包**查找。
//
// 为什么需要：本地接口的 `Methods` 表**只装本接口自己声明的成员**——`InheritanceResolver`
// 有 `_passInheritFields`（类的字段继承）却没有对应的「父接口方法合进子接口」那一 pass。
// 于是 `interface IDerived : IBase` 上调 `IBase` 的方法，裸查 `it.Methods` 查不到 ⇒ E0401。
//
// 本包与跨包走同一份闭包：跨包侧的 `BaseNames` / `BaseRefs` 由 TSIG 承载
// （`ExportedInterfaceZ.BaseNames`，`ImportedSymbolLoader` 恢复）。`IEnumerator<T> : IDisposable`
// 正撞这条——foreach 脱糖出的 `__e.Dispose()` 走的就是继承来的成员。
//
// 查找语义与 `ExprTyper._ifaceMethodClosure`（运算符重载那条路径的同款遍历）统一：
// 深度优先、先本接口后父接口、**要求签名非 null 才算命中**（无签名的占位符号继续往上找）。
//
// ⚠️ 命中结果连**归属接口**一起给（`IfaceMethodHit.Owner`，已按继承链逐层代换过实参）：
// 调用方拿它做型参代换。只给 MethodSymbol 的话，父接口成员上的 `T` 换不掉 —— 返回位误报、
// 形参位漏报，与 `_substIfaceArgs` 抬头记的那对症状同源，只是发生在继承链上。
namespace Z42.Semantics;
using Z42.IR;   // StrMap
using Z42.Syntax;   // NamedType（父接口声明形态的实参判别）

// 一次命中：方法符号 + 它**归属的接口**（沿继承链逐层代换实参后的形态）。
public sealed class IfaceMethodHit {
    public MethodSymbol      Sym;
    public Z42InterfaceType  Owner;
    public IfaceMethodHit(MethodSymbol sym, Z42InterfaceType owner) { this.Sym = sym; this.Owner = owner; }
}

public sealed class InterfaceClosure {

    // 接口（含父接口闭包）里找方法。接口方法按**裸名**登记（MemberCollector）。
    // 只要符号、不关心归属时用这个；要做型参代换的调用方用 `Find`。
    public static MethodSymbol FindMethod(SymbolTable symbols, Z42InterfaceType it, string method) {
        IfaceMethodHit hit = InterfaceClosure.Find(symbols, it, method);
        if (hit == null) { return null; }
        return hit.Sym;
    }

    // 同上，但连归属接口一起给（`Owner` 已按 `it` 的实参逐层代换）。
    public static IfaceMethodHit Find(SymbolTable symbols, Z42InterfaceType it, string method) {
        if (it == null) { return null; }
        MethodSymbol own = it.Methods.Get(method) as MethodSymbol;
        if (own != null && own.Signature != null) { return new IfaceMethodHit(own, it); }
        if (symbols == null) { return null; }
        return InterfaceClosure._walkBases(symbols, it, method, 0);
    }

    // 按接口**名**找（调用方只有名字时用，例如泛型约束里的 `where T : IFoo`）。
    public static MethodSymbol FindMethodByName(SymbolTable symbols, string ifaceName, string method) {
        if (symbols == null || !symbols.HasInterface(ifaceName)) { return null; }
        return InterfaceClosure.FindMethod(symbols, symbols.GetInterface(ifaceName), method);
    }

    // 第 `i` 个父接口在**当前视角**下的形态：解析声明形态（`IMid<int>` 带实参）后，把子接口自己的
    // 型参按 `it` 的实参换掉 —— 于是 `class C : ILeaf<int>` 看 `ILeaf<U> : IMid<U>` 的父接口时
    // 拿到的是 `IMid<int>`，逐层传递。没有声明形态（跨包未解析）或父接口非泛型时退回裸名定义。
    public static Z42InterfaceType BaseAt(SymbolTable symbols, Z42InterfaceType it, int i) {
        if (symbols == null || it == null || i >= it.BaseCount) { return null; }
        // 快路径：声明处没写实参（`: IBase`）⇒ 无实参可代，直接用裸名定义。
        // 判别用 AST 的 ArgCount，不用 `def.TypeParamCount` —— 后者混着隐式 `Self`
        //（`_substIfaceArgs` 抬头记着这条），拿它当「是不是泛型」会误判。
        TypeExpr bref = null;
        if (it.BaseRefs != null && i < it.BaseRefs.Length) { bref = it.BaseRefs[i]; }
        bool hasArgs = false;
        if (bref != null) {
            if (bref is NamedType) { hasArgs = (bref as NamedType).ArgCount > 0; }
            else { hasArgs = true; }   // ResolvedTypeExpr（跨包）等：交给下面解析判断
        }
        if (hasArgs) {
            Z42Type bt = symbols.ResolveTypeP(bref, it.TypeParamNames, it.TypeParamCount);
            if (bt is Z42InstantiatedInterfaceType) {
                if (it is Z42InstantiatedInterfaceType) {
                    bt = MemberResolver._substIfaceArgs(bt, it as Z42InstantiatedInterfaceType);
                }
                return bt as Z42InterfaceType;
            }
            if (bt is Z42InterfaceType) { return bt as Z42InterfaceType; }
        }
        if (!symbols.HasInterface(it.BaseNames[i])) { return null; }
        return symbols.GetInterface(it.BaseNames[i]);
    }

    // 沿父接口链递归。`depth` 是**成环护栏**——接口继承成环本不该发生，但查找不该因此挂死；
    // 接口继承链在实际代码里是个位数深度，32 层足够宽松。
    private static IfaceMethodHit _walkBases(SymbolTable symbols, Z42InterfaceType it, string method, int depth) {
        if (depth > 32) { return null; }
        int i = 0;
        while (i < it.BaseCount) {
            Z42InterfaceType bit = InterfaceClosure.BaseAt(symbols, it, i);
            if (bit != null) {
                MethodSymbol own = bit.Methods.Get(method) as MethodSymbol;
                if (own != null && own.Signature != null) { return new IfaceMethodHit(own, bit); }
                IfaceMethodHit up = InterfaceClosure._walkBases(symbols, bit, method, depth + 1);
                if (up != null) { return up; }
            }
            i = i + 1;
        }
        return null;
    }

    // ── 接口 → 祖先接口的名义可赋性（interface-assignability）──────────────────────────
    // 「`from` 这个接口当得了 `to` 用吗」——**这条边此前全仓没有**。`Conversion.Classify` 备齐了
    // class→iface（分支 F）、inst→iface（G）、class→class（E）…… 独缺 iface→iface ⇒
    // `IBase b = derivedIface` 报 E0402。实测七个位置全中：var-decl / 实参 / 返回 / 隔一层 /
    // 跨包 / 泛型接口 / 接口实现的返回协变。
    //
    // 🔴 **为什么走 `BaseAt` 而不是 `SymbolTable.InterfaceDerivesFrom`** —— 后者比的是
    // `BaseNames` 里的**字符串**，于是两件事都做不对：
    //   · 拼写：源码写 `: Std.IDisposable` 与写 `: IDisposable` 存下来是两个串，只认一种 ⇒ 跨包误判。
    //   · 型参：裸名把 `IStrLeaf : IBase<string>` 的 `string` 丢了，上溯只剩未实例化的 `IBase`。
    // `BaseAt` 这两件事**已经做对了**（它解析声明形态、逐层代换实参，返回「当前视角下」的父接口），
    // 所以本条边是搭在既有机制上的，没有第二套遍历。
    //
    // 消费端一律走这里（`Conversion` / `ConstraintChecker` ×2 / `InheritanceResolver` /
    // `StmtBinder`）：判定散成多份的代价这个子系统已经付过——那正是「接口那半其实早就有实现、
    // 只是没人用」的由来。
    public static bool IsInterfaceSubtype(SymbolTable symbols, Z42InterfaceType from, Z42InterfaceType to) {
        if (from == null || to == null) { return false; }
        if (Z42InterfaceType.SameInterface(from, to)) { return true; }
        if (symbols == null) { return false; }
        return InterfaceClosure._anyBaseIs(symbols, from, to, 0);
    }

    // 只有接口**名**时用（`where T : IFoo` 这类）。名字解析不到就判否——解析不到意味着这个约束
    // 本来就已经在别处报过错，这里不叠第二条诊断。
    public static bool IsInterfaceSubtypeByName(SymbolTable symbols, Z42InterfaceType from, string toName) {
        if (symbols == null || from == null) { return false; }
        if (from.Name() == toName || from.Fqn() == toName) { return true; }
        if (!symbols.HasInterface(toName)) { return false; }
        return InterfaceClosure.IsInterfaceSubtype(symbols, from, symbols.GetInterface(toName));
    }

    // 沿父接口链递归找 `to`。`depth` 是成环护栏，口径同 `_walkBases`（接口继承实际是个位数深度）。
    private static bool _anyBaseIs(SymbolTable symbols, Z42InterfaceType it, Z42InterfaceType to, int depth) {
        if (depth > 32) { return false; }
        int i = 0;
        while (i < it.BaseCount) {
            Z42InterfaceType bit = InterfaceClosure.BaseAt(symbols, it, i);
            if (bit != null) {
                if (Z42InterfaceType.SameInterface(bit, to)) { return true; }
                if (InterfaceClosure._anyBaseIs(symbols, bit, to, depth + 1)) { return true; }
            }
            i = i + 1;
        }
        return false;
    }
}
