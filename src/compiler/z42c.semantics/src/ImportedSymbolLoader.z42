// 跨包符号加载（port-z42c-import CI-3）。镜像 C# ImportedSymbolLoader 的 Phase1/2 子集：
// TSIG ExportedModuleZ → 短名 Z42ClassType 骨架（Phase1）→ 成员填充（Phase2：实例+静态方法、
// 字段、自由函数）。激活过滤 = prelude 包 ∪ {提供 cu.Usings 中 ns 的包}（strict-using-resolution）。
// 延后：Phase3 impl 合并 / 接口·委托·枚举 / 泛型实例化串解析 / E0601 冲突诊断。
namespace Z42.Semantics;

using Z42.IR;
using Z42.Core;   // Span（导入接口的父接口形态包成 ResolvedTypeExpr 时要）

// string 值盒（StrMap 存 object，prim 不能 `as string` 下行 → 包一层）。
public sealed class StrBox {
    public string Value;
    // 打包串（`a|b|c`）里的项数（perf-next-cluster）。只有经 `SymbolTable.NoteNsInto` 累积的那几张表
    // （ClassNsAll / ClassPkgAll / FuncOriginAll）会 >1；其余单值 box 恒为 1，读它无害。
    // 存在的理由：热路径（每个类型引用的 E0601/E0606 判据）只要「是不是只有一项」——
    // 从串上现算要么 Split（分配数组 + N 个子串）、要么 IndexOf（单项时必须扫完整串才能确定没有分隔符），
    // 实测两种都是 profile 前几名。写时记一次、读时读字段，才是 O(1)。
    public int Count;
    public StrBox(string value) { this.Value = value; this.Count = 1; }
}

// 加载产物（镜像 C# ImportedSymbols 子集）。
public sealed class ImportedSymbols {
    public StrMap Classes;          // 短名 → Z42ClassType（成员已填）
    public StrMap FunctionsByFqn;   // `ns.name` → MethodSymbol（自由函数；resolve-free-functions-by-namespace：此前按裸名、同名跨 ns 塌成一份）
    public StrMap ClassNamespaces;  // 短名 → 原 ns（QualifyClassName / 诊断用；值存 StrBox）
    // add-bare-name-ambiguity-diagnostic：短名 → **全部**声明 ns（"|" 连接）。`ClassNamespaces` 是
    // 单值、且被 first-wins 守卫盖住，判不了歧义；本表在守卫**之外**累积，每个 active 模块都记一笔。
    public StrMap ClassNsAll;
    public StrMap Interfaces;       // 短名 → Z42InterfaceType（接口骨架；供 _passClassStubs 基表判别）
    // unify-type-identity-fqn：**FQN 视图**（对称 SymbolTable.ClassesByFqn）。`Classes` / `Interfaces`
    // 按短名键，同短名跨 ns 只活一份（first-wins）⇒ 无法承载 FQ 名的精确解析。发射端已改发 FQN，
    // 消费端必须有对应的 FQ 查找，否则 `Std.Type` 在短名表里恒 miss、落到末尾 Builtin 兜底成
    // 「名叫 Std.Type 的垃圾类」。键 = `<ns>.<clKey>`（clKey 已含条件 arity-mangle）。
    public StrMap ClassesByFqn;
    // report-crosspkg-duplicate-type：**FQN → 声明它的全部包名**（值 StrBox，"|" 连接）。
    // 与 ClassNsAll 同一手法——在 first-wins 守卫**之外**累积，因为守卫之内只有赢家能进，
    // 而「有几个包声明了这个 FQN」恰恰是守卫塌掉的那个信息。类/接口/enum 共用一张表
    // （三者的 FQN 本就在同一个命名空间里，不会互相误命中）。
    public StrMap ClassPkgAll;
    // report-crosspkg-duplicate-function：自由函数名 → 全部来源（"ns#pkg"，"|" 连接）。
    // 与 ClassPkgAll 同一手法——在 first-wins 守卫**之外**累积。自由函数比类更糊：`Functions`
    // 的键是**裸名**（`ExportedFuncZ.Name` 就是 `md.Name`，没有 ns），连 FQN 视图都没有。
    public StrMap FuncOriginAll;
    public StrMap InterfacesByFqn;
    public StrMap EnumTypeNamesByFqn;   // FQN → "enum"
    public StrMap EnumTypeNames;    // 枚举类型短名 → "enum"（镜像 SymbolTable.EnumTypes；imported 枚举常量解析用）
    public StrMap EnumConsts;       // "EnumType.Member" → StrBox(long 值)（镜像 SymbolTable.EnumConsts）
    // add-associated-types PR-1：导入类的 where 约束（键与 Classes 同一 clKey，即条件 arity-mangle，
    // 与 SymbolTable.ConstraintKey 口径一致）→ ConstraintSet。修前此表不存在，跨包约束全程无载体。
    public StrMap Constraints;
    // fix-crosspkg-ns-reachability：依赖契约三件套的**搬运载体**。放在这里而不是给
    // `BuildPackageCus` 加参：本类已经是「跨包信息进符号表」的唯一通道（ClassPkgAll 就走这条），
    // 而改签名要动十几个调用点。由 `SymbolCollector._mergeImports` 并进 SymbolTable。
    public StrMap DeclaredDeps;
    public string SelfPkg;
    public bool   EnforceDeclaredDeps;
    public ImportedSymbols() {
        this.Classes = new StrMap();
        this.Constraints = new StrMap();
        this.FunctionsByFqn = new StrMap();
        this.ClassNamespaces = new StrMap();
        this.ClassNsAll = new StrMap();
        this.Interfaces = new StrMap();
        this.ClassesByFqn = new StrMap();          // unify-type-identity-fqn
        this.ClassPkgAll = new StrMap();           // report-crosspkg-duplicate-type
        this.DeclaredDeps = new StrMap();          // fix-crosspkg-ns-reachability
        this.SelfPkg = "";
        this.EnforceDeclaredDeps = false;
        this.FuncOriginAll = new StrMap();         // report-crosspkg-duplicate-function
        this.InterfacesByFqn = new StrMap();       // unify-type-identity-fqn
        this.EnumTypeNamesByFqn = new StrMap();    // unify-type-identity-fqn
        this.EnumTypeNames = new StrMap();
        this.EnumConsts = new StrMap();
    }
}

public static partial class ImportedSymbolLoader {

    // add-associated-types PR-1：导入类的 IrConstraintDesc[]（IR 侧，与 zbc flag 位对应）
    // → ConstraintSet（语义侧，ConstraintChecker.Check 直接消费的形态）。无约束返回 null。
    //
    // 这是「跨包约束校验」链路的最后一段。上游：ZbcWriter 置全 bit → ZbcReader 读回
    // IrConstraintDesc → TsigReconcile 搬进 ExportedClassZ → 此处 → SymbolTable.ClassConstraints。
    // bundle 里的接口名/基类名是**裸名**，与本包路径（ConstraintChecker._fillBundle 存 nt.Name）
    // 同一口径，故 _satisfiesInterface / _satisfiesBase 对本包与导入类型的判定完全一致。
    private static ConstraintSet _constraintSetOf(ExportedClassZ cl) {
        if (cl.TpConstraintCount <= 0 || cl.TypeParamConstraints == null) { return null; }
        int pc = cl.TpCount;
        if (pc <= 0) { return null; }
        ConstraintBundle[] bundles = new ConstraintBundle[pc];
        int i = 0;
        while (i < pc) { bundles[i] = new ConstraintBundle(); i = i + 1; }
        int n = pc;
        if (cl.TpConstraintCount < n) { n = cl.TpConstraintCount; }
        bool any = false;
        int k = 0;
        while (k < n) {
            IrConstraintDesc d = cl.TypeParamConstraints[k];
            if (d != null) {
                ConstraintBundle b = bundles[k];
                b.RequiresClass  = d.RequiresClass;
                b.RequiresStruct = d.RequiresStruct;
                if (d.BaseClass != "") { b.HasBaseClass = true; b.BaseClassName = d.BaseClass; }
                if (d.TypeParamConstraint != "") { b.HasTypeParamRef = true; b.TypeParamRef = d.TypeParamConstraint; }
                b.RequiresCtor = d.RequiresCtor;
                b.RequiresEnum = d.RequiresEnum;
                int j = 0;
                while (j < d.InterfaceCount) { b.AddInterface(d.Interfaces[j]); j = j + 1; }
                // 关联类型绑定（zbc 1.42，assoc-type-crosspkg）：`where T:IEnum<Item=int>` 经 bit7 恢复
                // → ConstraintBundle.AssocBinding*，供 ConstraintChecker 使用点跨包匹配（删 IsImported 守卫）。
                int ab = 0;
                while (ab < d.AssocBindingCount) { b.AddAssocBinding(d.AssocBindingNames[ab], d.AssocBindingTypeNames[ab]); ab = ab + 1; }
                if (!b.IsEmpty()) { any = true; }
            }
            k = k + 1;
        }
        if (!any) { return null; }
        string[] pnames = cl.TypeParams;
        if (pnames == null) { pnames = new string[0]; }
        return new ConstraintSet(pnames, bundles, pc);
    }

    // exported/pkgNames 平行（DepScan 产物）；usings = cu 的 using ns 列表。
    // parentPkg（z42b-owns-test-targets）：本次编译若是 <parentPkg> 的测试/bench 目标，加载该包时
    // 按**同包**待遇 —— 不设 IsImported ⇒ 其 internal 成员可见。其余依赖照旧跨包。`""` = 现状。
    // 为什么这样就够：导出端不按可见性过滤、导入端也不过滤 ⇒ internal 成员**本来就完整在 zpkg 里**，
    // 跨包拦截只靠 IsImported 这一个布尔（AccessChecker:40）。故零格式改动、AccessChecker 一行不改。
    public static ImportedSymbols Load(ExportedModuleZ[] exported, string[] pkgNames, int exportedCount,
                                       string[] usings, int usingCount) {
        return ImportedSymbolLoader.Load(exported, pkgNames, exportedCount, usings, usingCount, "");
    }

    public static ImportedSymbols Load(ExportedModuleZ[] exported, string[] pkgNames, int exportedCount,
                                       string[] usings, int usingCount, string parentPkg) {
        var r = new ImportedSymbols();
        // ── 激活集：prelude 包恒激活；非 prelude 须有 using 命中其某模块 ns ──
        bool[] active = new bool[exportedCount];
        int i = 0;
        while (i < exportedCount) {
            if (ImportedSymbolLoader._isPrelude(pkgNames[i])) { active[i] = true; }
            else { active[i] = ImportedSymbolLoader._pkgProvidesUsing(exported, pkgNames, exportedCount, pkgNames[i], usings, usingCount); }
            i = i + 1;
        }
        // ── Pre-scan：检测 imported 同名不同 arity 的类，泛型版需 arity-mangle（镜像 local
        // SymbolCollector pre-scan + C# NeedsMangle）。否则 arity-0 base 与 arity-N 泛型
        // （如 MulticastException / MulticastException<TResult>）撞键 → first-wins 丢泛型 →
        // new/throw/catch `C<int>` 误取 base → 运行期类型失配。
        StrMap impFirstArity = new StrMap();
        StrMap impMultiArity = new StrMap();
        i = 0;
        while (i < exportedCount) {
            if (active[i]) {
                ExportedModuleZ pem = exported[i];
                int pc = 0;
                while (pc < pem.ClassCount) {
                    ExportedClassZ pcl = pem.Classes[pc];
                    string arStr = pcl.TpCount.ToString();
                    if (impFirstArity.ContainsKey(pcl.Name)) {
                        StrBox fa = impFirstArity.Get(pcl.Name) as StrBox;
                        if (fa.Value != arStr) { impMultiArity.Put(pcl.Name, "1"); }
                    } else { impFirstArity.Put(pcl.Name, new StrBox(arStr)); }
                    pc = pc + 1;
                }
            }
            i = i + 1;
        }
        // ── Phase1：骨架（短名 → 空成员 Z42ClassType + 接口名表）──
        i = 0;
        while (i < exportedCount) {
            if (active[i]) {
                ExportedModuleZ em = exported[i];
                int c = 0;
                while (c < em.ClassCount) {
                    ExportedClassZ cl = em.Classes[c];
                    bool needsMangle = cl.TpCount > 0 && impMultiArity.ContainsKey(cl.Name);
                    string clKey = needsMangle ? (cl.Name + "$" + cl.TpCount.ToString()) : cl.Name;
                    // add-bare-name-ambiguity-diagnostic：**在 first-wins 守卫之外**累积声明 ns ——
                    // 守卫之内只有赢家能进，那正是「同短名跨 ns 被塌掉」的地方。`active[i]` 已把模块
                    // 限制在本 CU 可见的那些，所以这里记下的 ns 天然是可见集的子集。
                    SymbolTable.NoteNsInto(r.ClassNsAll, clKey, em.Namespace);
                    // unify-type-identity-fqn：**first-wins 只能管裸名表**。此前整个建型都被这道守卫罩着 ⇒
                    // 同短名的第二份（`Demo.FqnBeta.Widget`）压根不建型，FQN 视图自然也拿不到它 ⇒
                    // 限定引用只能退回剥短名撞赢家（实测 `Both.fromBeta` 绑成了 `Demo.FqnAlpha.Widget`）。
                    // 现在把守卫收窄到只裹 `r.Classes.Put`，其余每份都建、按 FQN 各存一份。
                    string fqnKey = em.Namespace == "" ? clKey : em.Namespace + "." + clKey;
                    // report-crosspkg-duplicate-type：记「这个 FQN 由哪个包声明」——同样在 first-wins
                    // 守卫之外。`pkgNames` 与 `exported` 平行，来源包名一直就在手边，只是从没被记过。
                    // 同一个包的多个模块贡献同一个包名 → NoteNsInto 幂等，不会自己撞自己。
                    // 🔴 父包不算「另一个包」（fix-e0606-parent-pkg-false-positive）：本次编译是
                    // <parentPkg> 的测试/bench 目标时，父包按**同包**待遇加载（其类型 IsImported=false，
                    // 这正是测试能看见 internal 的机制）。若还把它记进「FQN → 来源包」表，同一个类型
                    // 就会既算「本包声明」又算「导入包声明」⇒ E0606（本地遮蔽导入）对**每一处**父包
                    // 类型引用误报，而那正是测试该做的事。E0601（两包同 FQN）同理。
                    // 一句话：这张表记的是「有几个**别的**包声明了它」，父包不在此列。
                    if (!(parentPkg != "" && pkgNames[i] == parentPkg)) {
                        SymbolTable.NoteNsInto(r.ClassPkgAll, fqnKey, pkgNames[i]);
                    }
                    bool bareFree = !r.Classes.ContainsKey(clKey);   // first-wins（输入已 prelude-first 排序）
                    if (bareFree || !r.ClassesByFqn.ContainsKey(fqnKey)) {
                        string baseName = "";
                        bool hasBase = cl.HasBase && cl.BaseName != "Object";
                        if (hasBase) { baseName = cl.BaseName; }
                        Z42ClassType nct = new Z42ClassType(cl.Name, hasBase, baseName);
                        // enforce-access-control：来自依赖 zpkg（跨包）→ internal 成员不可访问。
                        // z42b-owns-test-targets：**例外** —— 本次编译是 <parentPkg> 的测试/bench 目标时，
                        // 加载父包按同包待遇（internal 可见）。其余依赖照旧。parentPkg=="" → 恒 true（现状）。
                        nct.IsImported = !(parentPkg != "" && pkgNames[i] == parentPkg);
                        nct.IsSealed = cl.IsSealed;   // impl-sealed-semantics-devirt：跨包 sealed 类（继承强制 + 去虚化）
                        nct.IsDeprecated = cl.IsDeprecated; nct.DeprecationMsg = cl.DeprecationMsg;   // add-deprecated-directive：跨包类级弃用（use-site 告警）
                        nct.Visibility = cl.Visibility;   // enforce-class-access：跨包类声明可见性（internal 类跨包引用 deny）
                        // add-crosspkg-struct-value-semantics (P4a) 根因修复：跨包 struct 值类型分类。生产方
                        // ExportedTypeExtractor 把 struct-ness 编码进 ExportedClassZ.HasBase（`hasBase = !isStruct`——
                        // 非-struct class 恒 HasBase=true，struct 恒 HasBase=false），故 `!cl.HasBase` 精确等价
                        // isStruct。修前 imported struct 当引用类型（消费方不发 StructAlloc/FieldGetPrim）→ 与生产方
                        // struct 构造函数（发 StructFieldSetPrim off=0）不一致 → 运行期 blob-bounds 崩。分类正确后
                        // StructLayout.BuildFromSymbols 从字段名/类型重算布局（与生产方持久化逐字节一致）。
                        //
                        // ⚠️ 此处原有一条「不新增 ExportedClassZ 字段 ← bootstrap 越界」的论证，已于
                        // add-associated-types (2026-09-06) 删除：它写下时（ea3f0c73, 08-12）就已失效 13 天——
                        // _ensureBootstrapSelfDepLibs 的破环预建自 07596b57 (07-30) 起**总是**用当前 driver 把
                        // 当前源 z42.ir 建进 build-libs（不 warm-skip），z42c 源用当前源 z42.ir 新 API 已是常态
                        // （先例：IsSealed / Visibility / IsDeprecated / ExportedMethodZ.TypeParamCount / StrMap.Find）。
                        // 唯一仍有效的约束是**种子 ABI**：新字段不得进 ctor 签名，须 ctor 内给默认值 + 构造后赋值。
                        // 机制见 docs/internals/src/compiler/self-hosting.md 轴④ 与 docs/agent/rules/bootstrap-seed.md。
                        // （struct-ness 继续复用 HasBase 编码属独立技术债，登记 Deferred，不在本 change 内改。）
                        nct.IsStruct = !cl.HasBase;
                        // 类侧关联类型绑定（zbc 1.42，assoc-type-crosspkg）：`class IntBag:IEnum{type Item=int;}` 的
                        // `Item=int` 经 TYPE assoc 块恢复 → Z42ClassType.AssocBinding*，供 ConstraintChecker 使用点
                        // 跨包匹配（`AssocBindingOf` 不再恒空，删 IsImported 守卫后跨包错绑定/缺绑定才报得出）。
                        int cab = 0;
                        while (cab < cl.AssocBindingCount) { nct.AddAssocBinding(cl.AssocBindingNames[cab], cl.AssocBindingTypeNames[cab]); cab = cab + 1; }
                        // unify-type-identity-fqn：**导入类的声明 ns**。此前从未设置 —— 全编译器给
                        // `Z42ClassType.Namespace` 赋值的点只有 `StubCollector._putClassStub`（本地类），
                        // 于是 imported 类的 `Fqn()` 恒退化成短名。`Z42Type.z42` 里那句「导入由
                        // ImportedSymbolLoader 从 em.Namespace 设置」是**过期的假断言**（见 §6 防腐门）。
                        // 数据本就在手：下方 `r.ClassNamespaces.Put` 用的就是同一个 `em.Namespace`。
                        // 种子 ABI 安全：Namespace 不进 ctor 签名、ctor 内默认 ""，此处构造后赋值。
                        nct.Namespace = em.Namespace;
                        if (cl.TpCount > 0) { nct.GenericParamNames = cl.TypeParams; nct.GenericParamCount = cl.TpCount; }
                        if (needsMangle) { nct.HasArityMangle = true; nct.ArityMangleCount = cl.TpCount; }
                        // fix-crosspkg-interface-impl：imported 类带上实现接口表（bare 名，TSIG 恢复）——
                        // SymbolTable.Implements 据此判 class→iface 可赋性（`ICompiler c = new NoCompiler()`）。
                        if (cl.InterfaceCount > 0) {
                            nct.InterfaceNames = cl.Interfaces;
                            nct.InterfaceCount = cl.InterfaceCount;
                        }
                        // 短名表保留 first-wins（型参 / 无 ns 的东西仍走它）；FQN 视图每一份都留。
                        if (bareFree) {
                            r.Classes.Put(clKey, nct);
                            r.ClassNamespaces.Put(clKey, new StrBox(em.Namespace));
                        }
                        r.ClassesByFqn.Put(fqnKey, nct);
                        // add-associated-types PR-1：跨包 where 约束。键与 Classes 同为 clKey，
                        // 与 SymbolTable.ConstraintKey 的条件 arity-mangle 口径一致。
                        // 键是 clKey（裸名）⇒ 与 r.Classes 同受 first-wins 约束，否则同短名的第二份
                        // 会把赢家的约束覆盖掉（守卫收窄后这里必须显式跟上）。
                        if (bareFree) {
                            ConstraintSet ics = ImportedSymbolLoader._constraintSetOf(cl);
                            if (ics != null) { r.Constraints.Put(clKey, ics); }
                        }
                    }
                    c = c + 1;
                }
                // 接口骨架（供下游 _passClassStubs 基表判别：imported 接口名必须在 table.Interfaces 中）
                int ic = 0;
                while (ic < em.InterfaceCount) {
                    ExportedInterfaceZ iz = em.Interfaces[ic];
                    // report-crosspkg-duplicate-type：接口同款（守卫之外累积）。接口不 arity-mangle，
                    // FQN 直接 ns + 裸名，与 Z42InterfaceType.Fqn() 同口径。
                    if (!(parentPkg != "" && pkgNames[i] == parentPkg)) {   // 父包不算「另一个包」，见上
                        SymbolTable.NoteNsInto(r.ClassPkgAll,
                            em.Namespace == "" ? iz.Name : em.Namespace + "." + iz.Name, pkgNames[i]);
                    }
                    if (!r.Interfaces.ContainsKey(iz.Name)) {
                        Z42InterfaceType nift = new Z42InterfaceType(iz.Name);
                        nift.Namespace = em.Namespace;   // unify-type-identity-fqn：导入接口的声明 ns（与 nct.Namespace 对称）
                        // complete-class-access-control ④：跨包 → internal 接口不可引用。
                        // 同上例外：父包的 internal 接口对其测试目标可见。
                        nift.IsImported = !(parentPkg != "" && pkgNames[i] == parentPkg);
                        nift.Visibility = iz.Visibility;        // complete-class-access-control ④：跨包接口声明可见性
                        // add-associated-types PR-3：导入接口的型参名进符号表（与本包 StubCollector 对称）。
                        nift.TypeParamNames = iz.TypeParams; nift.TypeParamCount = iz.TpCount;
                        // 关联类型名单（zbc 1.42，assoc-type-crosspkg）：接口声明的 `type Item;` 经 TYPE assoc 块恢复
                        // → Z42InterfaceType.AssocTypeNames，供 ConstraintChecker 声明点 + InheritanceResolver 补齐强制
                        //（删 IsImported 守卫后跨包生效）。
                        int iat = 0;
                        while (iat < iz.AssocTypeCount) { nift.AddAssocType(iz.AssocTypeNames[iat]); iat = iat + 1; }
                        // 父接口链（fix-crosspkg-iface-basenames）：TSIG 的 BaseNames（TYPE Interfaces 块搬运，
                        // 已是传递闭包）→ Z42InterfaceType.BaseNames，与本包 StubCollector 的 AddBase 对称。
                        // 缺了这一步，跨包接口上调**继承来的**成员一律 E0401 —— 直接后果是实现
                        // `Std.IEnumerable<T>` 的类型不能 foreach（脱糖出的 `__e.Dispose()` 走的正是
                        // `IEnumerator<T> : IDisposable` 继承来的成员）。
                        // ⚠️ TSIG 存 **FQ + 带泛型实参**的名（`Std.IDisposable`、`Std.IBox<T>`），而
                        // `SymbolTable.Interfaces` / `InterfaceClosure` 的查找键是**裸短名**
                        // ⇒ 此处必须先截 `<`（否则 `Std.IComparable<Std.String>` 的「最后一个点」
                        // 落在实参里，剥出来是 `String>`）再剥短名。
                        int ibn = 0;
                        while (ibn < iz.BaseCount) {
                            nift.AddBase(ImportedSymbolLoader._bareShortName(iz.BaseNames[ibn]));
                            ibn = ibn + 1;
                        }
                        r.Interfaces.Put(iz.Name, nift);
                        r.InterfacesByFqn.Put(nift.Fqn(), nift);   // unify-type-identity-fqn
                        // fix-crosspkg-interface-impl：记 imported 接口声明 ns，使 QualifyClass 把
                        // `: IFace` / `as IFace` 正确 FQ 化为「声明包.IFace」（否则退化当前包 ns →
                        // 实现类与 cast 目标名各自错限定、跨包 is/as/接口派发失配）。
                        r.ClassNamespaces.Put(iz.Name, new StrBox(em.Namespace));
                    }
                    ic = ic + 1;
                }
                // 枚举常量（imported `EnumType.Member` → BoundLitInt；镜像 _passEnums 填 EnumTypes/EnumConsts）。
                int ec = 0;
                while (ec < em.EnumCount) {
                    ExportedEnumZ ez = em.Enums[ec];
                    // report-crosspkg-duplicate-type：enum 同款（守卫之外累积）。
                    if (!(parentPkg != "" && pkgNames[i] == parentPkg)) {   // 父包不算「另一个包」，见上
                        SymbolTable.NoteNsInto(r.ClassPkgAll,
                            em.Namespace == "" ? ez.Name : em.Namespace + "." + ez.Name, pkgNames[i]);
                    }
                    if (!r.EnumTypeNames.ContainsKey(ez.Name)) {
                        r.EnumTypeNames.Put(ez.Name, "enum");
                        r.EnumTypeNamesByFqn.Put(em.Namespace == "" ? ez.Name : em.Namespace + "." + ez.Name, "enum");   // unify-type-identity-fqn
                        // make-enum-distinct-type 1.5：imported enum 也要记源 ns。此前只填
                        // EnumTypeNames/EnumConsts（够把 `Color.Green` 折成常量），但**类名限定**
                        // 查的是 ClassNamespaces —— 缺了它，消费方的 `QualifyClass("Color")` 落回
                        // **当前** ns，发出 `Demo.EnumApp.Color` 这种根本不存在的 FQ 名。
                        // 以前不炸，只因没人拿这个名字去运行期查类型（imported enum 的 typeof /
                        // GetType 拿到的是个查不到的合成 Type，静默错）；装箱会真去 try_lookup_type
                        // ⇒ 立刻 `__box_prim: unknown prim wrapper type`。又一处「装箱把静默的错
                        // 变成响的错」。同短名的真类优先（与本 loader 通篇 first-wins 一致，不覆盖）。
                        if (!r.ClassNamespaces.ContainsKey(ez.Name)) {
                            r.ClassNamespaces.Put(ez.Name, new StrBox(em.Namespace));
                        }
                        int emi = 0;
                        while (emi < ez.MemberCount) {
                            ExportedEnumMemberZ emem = ez.Members[emi];
                            r.EnumConsts.Put(ez.Name + "." + emem.Name, new StrBox(emem.Value.ToString()));
                            emi = emi + 1;
                        }
                    }
                    ec = ec + 1;
                }
            }
            i = i + 1;
        }
        // ── Phase2：成员填充（骨架齐备后解析类型可互指）──
        i = 0;
        while (i < exportedCount) {
            if (active[i]) {
                ExportedModuleZ em = exported[i];
                int c = 0;
                while (c < em.ClassCount) {
                    ExportedClassZ cl = em.Classes[c];
                    bool needsMangle = cl.TpCount > 0 && impMultiArity.ContainsKey(cl.Name);
                    string clKey = needsMangle ? (cl.Name + "$" + cl.TpCount.ToString()) : cl.Name;
                    Z42ClassType ct = r.Classes.Get(clKey) as Z42ClassType;
                    StrBox owner = r.ClassNamespaces.Get(clKey) as StrBox;
                    if (ct != null && owner != null && owner.Value == em.Namespace) {
                        ImportedSymbolLoader._fillClass(r, ct, cl);
                    }
                    c = c + 1;
                }
                // 自由函数
                int f = 0;
                while (f < em.FunctionCount) {
                    ExportedFuncZ fz = em.Functions[f];
                    // free-function-overloads：TSIG 里 fz.Name = **RegKey**（primary=裸名 / 非-primary=`name$arity$T`）。
                    // 基名（源名）= 剥首个 `$`（标识符不含 `$`）。FuncOriginAll / 裸名歧义按**基名**记；
                    // FunctionsByFqn 键与符号 RegKey 用完整 RegKey。Phase 1 无重载 ⇒ fz.Name 无 `$` ⇒ 基名==全名，字节稳定。
                    int fzDollar = fz.Name.IndexOf("$");
                    string fzBase = fzDollar < 0 ? fz.Name : fz.Name.Substring(0, fzDollar);
                    // report-crosspkg-duplicate-function：**守卫之外**记来源（ns + 包名）。
                    // 守卫之内只有赢家能进，而「这个名字有几个来源」正是守卫塌掉的那个信息。
                    // 父包不算「另一个包」——与上面类/接口/enum 三处同一判据（#586）。
                    if (!(parentPkg != "" && pkgNames[i] == parentPkg)) {
                        SymbolTable.NoteNsInto(r.FuncOriginAll, fzBase, em.Namespace + "#" + pkgNames[i]);
                    }
                    string fzFqn = SymbolTable.QualOf(em.Namespace, fz.Name);
                    if (!r.FunctionsByFqn.ContainsKey(fzFqn)) {
                        // imported-generic-func-type-param-fidelity：自由函数的**函数级**型参
                        // （`T IdOf<T>(T a)`）。这是 R1 当初列出却漏修的第四处（见 _tpsWith 注释）：
                        // 不喂型参表 → `T` 落 `_resolve` 末尾的 Builtin 兜底成普通类 ⇒ 调用点 E0402。
                        // 自由函数无外层类 ⇒ outer 为空，与 trait-impl 方法那支同形。
                        string[] ftps = ImportedSymbolLoader._tpsWith(new string[0], 0, fz.TypeParams);
                        int ftpc = ftps.Length;
                        Z42Type[] ps = new Z42Type[fz.ParamCount];
                        int j = 0;
                        while (j < fz.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, fz.Params[j].TypeName, ftps, ftpc); j = j + 1; }
                        var sig = new Z42FuncType(ps, fz.ParamCount, ImportedSymbolLoader._resolve(r, fz.ReturnType, ftps, ftpc));
                        sig.ParamsFrom = fz.ParamsFrom;
                        ImportedSymbolLoader._fillParamMeta(sig, fz.Params, fz.ParamCount, fz.RefInfoKnown, fz.RetIsNullable);   // PR6：跨包默认值/ caller
                        // free-function-overloads：Name=基名（源名，诊断/候选分组用），RegKey=完整 RegKey（发射键）。
                        var fsym = new MethodSymbol(fzBase, "public", sig, false, "", false, null);
                        fsym.RegKey = fz.Name;
                        fsym.IsDeprecated = fz.IsDeprecated; fsym.DeprecationMsg = fz.DeprecationMsg;   // fix-free-function-attrs：跨包自由函数弃用
                        fsym.TypeParamCount = fz.TypeParamCount;   // 供泛型 arity 重载过滤（镜像方法侧）
                        fsym.TypeParamNames = ImportedSymbolLoader._tpNames(fz.TypeParams);   // fix-explicit-type-arg-not-substituted
                        r.FunctionsByFqn.Put(fzFqn, fsym);   // 源 ns + RegKey 在键里；调用点解析出 ns 后随 BoundCall 带到发射端
                    }
                    f = f + 1;
                }
                // imported 接口方法填充（fix-crosspkg-interface-impl）：跨包 `c.Compile(req)` /
                // `f.Val()` 的接口派发查 Z42InterfaceType.Methods——从 TSIG 重建的
                // ExportedInterfaceZ 方法灌入（镜像 local _passMembers 的接口方法收集）。
                int ifi2 = 0;
                while (ifi2 < em.InterfaceCount) {
                    ExportedInterfaceZ iz2 = em.Interfaces[ifi2];
                    Z42InterfaceType it2 = r.Interfaces.Get(iz2.Name) as Z42InterfaceType;
                    if (it2 != null) {
                        // add-associated-types PR-2：接口方法签名的型参上下文 = 接口 TypeParams ∪ {"Self"}。
                        // **顺带修既有缺口**：此前这里走 `_resolve(r, name)` 单参版（无型参上下文）⇒ 跨包
                        // 泛型接口方法里的 `T` 落到 `Z42ClassType.Builtin("T")` 兜底垃圾类型，而非
                        // Z42GenericParamType。`Self` 会踩同一个坑，故一并接上（design D5）。
                        string[] itp2 = MemberCollector._withSelf(iz2.TypeParams, iz2.TpCount);
                        int itpc2 = iz2.TpCount + 1;
                        // 父接口的**带实参**形态（与本包 `StubCollector._addIfaceBases` 存 AST 节点同形）。
                        // 骨架那一步（Phase1）只能恢复裸短名 —— 它是查找键，实参被剥掉了；沿继承链代换
                        // 型参却正需要实参（`interface ILeaf : IMid<int>`）。放在 Phase2 是因为解析父接口
                        // 要求**所有**骨架已建（Phase1 内父接口可能还没轮到），而 `_resolve` 认 FQ 名 +
                        // 泛型实例化串，正好吃 TSIG 存的那个形态。
                        int ibr = 0;
                        while (ibr < it2.BaseCount && ibr < iz2.BaseCount) {
                            if (it2.BaseRefs[ibr] == null) {
                                Z42Type bt2 = ImportedSymbolLoader._resolve(r, iz2.BaseNames[ibr], itp2, itpc2);
                                if (bt2 is Z42InterfaceType) {
                                    it2.BaseRefs[ibr] = new ResolvedTypeExpr(bt2, new Span(0, 0, 0, 0, ""));
                                }
                            }
                            ibr = ibr + 1;
                        }
                        int im2 = 0;
                        while (im2 < iz2.MethodCount) {
                            ExportedMethodZ mz = iz2.Methods[im2];
                            if (!it2.Methods.ContainsKey(mz.Name)) {
                                // R1：接口级型参（**含 `Self`**，add-self-type 的 `itp2`）∪ **方法级**型参。
                                // 此前方法级一个都没喂 → `IBasicCollection<T>.AddOne(T)` 的 `T` 降级成
                                // 名为 "T" 的普通类 ⇒ `AddOne(1)` 报 `int → T`。
                                string[] itps = ImportedSymbolLoader._tpsWith(itp2, itpc2, mz.TypeParams);
                                int itpc = itps.Length;
                                Z42Type[] mps = new Z42Type[mz.ParamCount];
                                int mj2 = 0;
                                while (mj2 < mz.ParamCount) { mps[mj2] = ImportedSymbolLoader._resolve(r, mz.Params[mj2].TypeName, itps, itpc); mj2 = mj2 + 1; }
                                var msig = new Z42FuncType(mps, mz.ParamCount, ImportedSymbolLoader._resolve(r, mz.ReturnType, itps, itpc));
                                ImportedSymbolLoader._fillParamMeta(msig, mz.Params, mz.ParamCount, mz.RefInfoKnown, mz.RetIsNullable);   // PR6
                                // add-interface-satisfaction-check：`isStatic` 此前硬编码 `false`，
                                // 而 `mz.IsStatic` 明明就在手上 ⇒ 跨包看 `INumber.op_Add` 这类
                                // **static abstract** 接口成员会被当成实例方法。与 #523 修的四条
                                // 「imported 类型保真度」同族：元数据带着信息，导入侧把它抹平了。
                                // （`IsAbstract` 没有对应槽——`MethodSymbol` 无该字段，抽象性一律靠
                                //  `Decl.Mods` 嗅探，而导入符号 `HasDecl=false`；故只还原 IsStatic。）
                                it2.Methods.Put(mz.Name, new MethodSymbol(mz.Name, "public", msig, mz.IsStatic, iz2.Name, false, null));
                            }
                            im2 = im2 + 1;
                        }
                    }
                    ifi2 = ifi2 + 1;
                }
            }
            i = i + 1;
        }
        // ── Phase3：impl 合并（L3-Impl2；镜像 C# MergeImpls）——方法并入 imported target，trait 入其接口集 ──
        i = 0;
        while (i < exportedCount) {
            if (active[i]) {
                ExportedModuleZ em = exported[i];
                int c = 0;
                while (c < em.ImplCount) {
                    ImportedSymbolLoader._mergeImpl(r, em.Impls[c]);
                    c = c + 1;
                }
            }
            i = i + 1;
        }
        return r;
    }

    // 单条 impl 合并到 imported target class（镜像 C# MergeImpls 内层）。
    private static void _mergeImpl(ImportedSymbols r, ExportedImplZ im) {
        string targetShort = ImportedSymbolLoader._shortName(im.TargetFq);
        if (targetShort == "") { return; }
        if (!r.Classes.ContainsKey(targetShort)) { return; }      // target 不在 import 集 → 跳过
        Z42ClassType ct = r.Classes.Get(targetShort) as Z42ClassType;
        string traitShort = ImportedSymbolLoader._shortName(im.TraitFq);
        if (traitShort == "") { return; }
        // 注：不校验 r.Interfaces.ContainsKey(traitShort)——z42c 不 import 接口进表（会破坏
        // stdlib byte-identical），且 impl 块由生产端（greeter 编译期）已校验 trait 合法性。
        // 方法并入 target.Methods（first-wins）+ 实例方法入 OwnMethod 有序元数据
        int m = 0;
        while (m < im.MethodCount) {
            ExportedMethodZ me = im.Methods[m];
            if (!ct.Methods.ContainsKey(me.Name)) {
                // R1：trait-impl 方法的方法级型参（此前不喂 → 同款降级）。
                string[] etps = ImportedSymbolLoader._tpsWith(new string[0], 0, me.TypeParams);
                int etpc = etps.Length;
                Z42Type[] ps = new Z42Type[me.ParamCount];
                int j = 0;
                while (j < me.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, me.Params[j].TypeName, etps, etpc); j = j + 1; }
                var sig = new Z42FuncType(ps, me.ParamCount, ImportedSymbolLoader._resolve(r, me.ReturnType, etps, etpc));
                sig.ParamsFrom = me.ParamsFrom;
                ImportedSymbolLoader._fillParamMeta(sig, me.Params, me.ParamCount, me.RefInfoKnown, me.RetIsNullable);   // PR6：跨包默认值/ caller
                var sym = new MethodSymbol(me.Name, me.Visibility, sig, me.IsStatic, ct.Name(), false, null);
                sym.IsSealed = me.IsSealed;   // impl-sealed-semantics-devirt：跨包方法级 sealed（override 强制）
                sym.IsDeprecated = me.IsDeprecated; sym.DeprecationMsg = me.DeprecationMsg;   // add-deprecated-directive：跨包方法级弃用
                sym.TypeParamCount = me.TypeParamCount;   // add-array-paired-sort：跨包方法级泛型形参个数，供 arity 重载过滤
                sym.TypeParamNames = ImportedSymbolLoader._tpNames(me.TypeParams);   // fix-explicit-type-arg-not-substituted
                ct.Methods.Put(me.Name, sym);
                if (!me.IsStatic) { ct.AddOwnMethod(me.Name, me.IsVirtual, me.IsAbstract); }
            }
            m = m + 1;
        }
        // trait 并入 target 接口集（去重：AddInterfaceName 不查重 → 此处先查）
        bool seen = false;
        int ix = 0;
        while (ix < ct.InterfaceCount) { if (ct.InterfaceNames[ix] == traitShort) { seen = true; } ix = ix + 1; }
        if (!seen) { ct.AddInterfaceName(traitShort); }
    }

    // FQ "Demo.Target.Robot" → 短名 "Robot"（无点 → 原串）。镜像 C# SplitFqName 取 ShortName。
    private static string _shortName(string fq) {
        if (fq == "") { return ""; }
        int dot = 0 - 1;
        int i = 0;
        while (i < fq.Length) { if (fq.CharAt(i) == '.') { dot = i; } i = i + 1; }
        if (dot < 0) { return fq; }
        return fq.Substring(dot + 1, fq.Length - dot - 1);
    }

    // fix-crosspkg-iface-basenames：`Std.IComparable<Std.String>` → `IComparable`。
    // 先截泛型实参再剥短名 —— 顺序不能反：反了的话「最后一个点」会落进实参里（→ `String>`）。
    // 与本包侧 `StubCollector._addIfaceBases` 的裸名约定对齐（BaseNames 存裸短名）。
    //
    // ⚠️ 截 `<` 这一支**当前不可达**，且没有用例覆盖：父接口带实参（`interface ILeaf : IMid<int>`）
    // 在本包满足性校验就撞 E0412（沿继承链上溯时不代换型参），所以这样的类型今天写不出来、
    // 也就进不了 TSIG。留着是因为它便宜且与本包侧同构 —— 那一洞修好后它立刻转为在用。
    private static string _bareShortName(string fq) {
        string bare = fq;
        int lt = fq.IndexOf("<");
        if (lt >= 0) { bare = fq.Substring(0, lt); }
        return ImportedSymbolLoader._shortName(bare);
    }

    // add-argument-type-check R1：类/接口级型参 ∪ **方法级**型参 → `_resolve` 的型参表。
    // 此前只喂类级（`_fillClass` 的 tps）或压根不喂（接口方法 / trait-impl 方法 / 自由函数），
    // 于是 `Array.Copy<T>(T[],T[],int)`、`IBasicCollection<T>.AddOne(T)` 这类签名里的 `T` 落到
    // `_resolve` 末尾的 `Z42ClassType.Builtin(name)` 兜底 → **型参身份丢失**（成了名为 "T" 的普通类）
    // ⇒ `Conversion._classifyBuiltin` 分支 B「恰一侧泛型形参 → 擦除放行」永不触发。
    // 合并而非替换：类级与方法级可同时在场（`class C<T> { void M<U>(T t, U u) }`）。
    // fix-explicit-type-arg-not-substituted：方法级型参名的**非空**视图。
    // `_tpsWith` 合并的是「类级 ∪ 方法级」（解析签名时的可见型参上下文），而按显式类型实参
    // 代换签名时**只能**按方法级的那几个名字代——把类级也代进去会把 `Box<T>.Put(T)` 的 T
    // 当成方法级型参换掉。故这里单独取 `me.TypeParams`，不复用 `_tpsWith` 的结果。
    private static string[] _tpNames(string[] tps) {
        if (tps == null) { return new string[0]; }
        return tps;
    }

    private static string[] _tpsWith(string[] outer, int outerCount, string[] methodTps) {
        int mc = 0;
        if (methodTps != null) { mc = methodTps.Length; }
        if (mc == 0) { return outer == null ? new string[0] : outer; }
        int oc = outerCount;
        if (outer == null) { oc = 0; }
        string[] merged = new string[oc + mc];
        int i = 0;
        while (i < oc) { merged[i] = outer[i]; i = i + 1; }
        int k = 0;
        while (k < mc) { merged[oc + k] = methodTps[k]; k = k + 1; }
        return merged;
    }

    private static void _fillClass(ImportedSymbols r, Z42ClassType ct, ExportedClassZ cl) {
        string[] tps = cl.TypeParams;
        int tpc = cl.TpCount;
        int i = 0;
        while (i < cl.FieldCount) {
            ExportedFieldZ fd = cl.Fields[i];
            if (!ct.Fields.ContainsKey(fd.Name)) {
                FieldSymbol fsym = new FieldSymbol(fd.Name, fd.Visibility,
                    ImportedSymbolLoader._resolve(r, fd.TypeName, tps, tpc), fd.IsStatic, ct.Name());
                fsym.IsDeprecated = fd.IsDeprecated; fsym.DeprecationMsg = fd.DeprecationMsg;   // add-deprecated-directive：跨包字段级弃用
                ct.Fields.Put(fd.Name, fsym);
                // G18-import：实例字段入 OwnField* 有序元数据（TSIG 继承字段展开；static 不入，同本地 _fillClass）。
                // fix-generic-struct-chain-access：拼写须与本地 `MemberCollector` **同一口径**（`SurfaceTypeName`
                // 已解析类型 = 短名形式，解析失败才回落原串）。导出元数据里的 `fd.TypeName` 是 FQ
                // （`Demo.StructTarget.Point`），而 `StructLayout` 按符号表裸名键判「字段是不是 struct」⇒ 照搬 FQ
                // 会把导入 struct 里的嵌套 struct 字段当成 8B 引用叶子：布局与生产方错位、读写静默错值
                // （只有嵌套 struct 恰好 8B 时偏移碰巧重合——`struct_cross_pkg` 的 `Point{int,int}` 正是如此）。
                if (!fd.IsStatic) {
                    string fsp = (fsym.FieldType is Z42UnknownType || fsym.FieldType is Z42ErrorType)
                        ? fd.TypeName : TypeNameResolver.SurfaceTypeName(fsym.FieldType);
                    ct.AddOwnField(fd.Name, fsp, fd.Visibility);
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < cl.MethodCount) {
            ExportedMethodZ m = cl.Methods[i];
            if (!ct.Methods.ContainsKey(m.Name)) {              // bare+arity 键并存，bare first-wins
                // R1：类级 tps ∪ 方法级 m.TypeParams（`Array.Copy<T>` 是「类无型参 + 方法级型参」）。
                string[] mtps = ImportedSymbolLoader._tpsWith(tps, tpc, m.TypeParams);
                int mtpc = mtps.Length;
                Z42Type[] ps = new Z42Type[m.ParamCount];
                int j = 0;
                while (j < m.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, m.Params[j].TypeName, mtps, mtpc); j = j + 1; }
                var sig = new Z42FuncType(ps, m.ParamCount, ImportedSymbolLoader._resolve(r, m.ReturnType, mtps, mtpc));
                sig.ParamsFrom = m.ParamsFrom;
                ImportedSymbolLoader._fillParamMeta(sig, m.Params, m.ParamCount, m.RefInfoKnown, m.RetIsNullable);   // PR6：跨包默认值/ caller（静态+实例主路径）
                // z42c 既有约定：静态/实例同进 Methods（IsStatic 标真值）——D3
                // add-type-based-overloads：symbol.Name = 源名（首个 $ 前），RegKey = 完整注册键
                //   → OverloadsOf(源名) 跨包候选枚举一致（同本地）；调用方决议返回 RegKey 派发。
                // 同一个 m.Name 原来在本次迭代里被 _dollarAt 算了两遍（这里与下面注册 bare 键处）。
                int srcDol = ImportedSymbolLoader._dollarAt(m.Name);
                string srcName = (srcDol >= 0) ? m.Name.Substring(0, srcDol) : m.Name;
                var sym = new MethodSymbol(srcName, m.Visibility, sig, m.IsStatic, ct.Name(), false, null);
                sym.RegKey = m.Name;
                sym.IsSealed = m.IsSealed;   // impl-sealed-semantics-devirt：跨包方法级 sealed（override 强制）
                sym.IsDeprecated = m.IsDeprecated; sym.DeprecationMsg = m.DeprecationMsg;   // add-deprecated-directive：跨包方法级弃用
                sym.TypeParamCount = m.TypeParamCount;   // add-array-paired-sort：跨包方法级泛型形参个数，供 arity 重载过滤
                sym.TypeParamNames = ImportedSymbolLoader._tpNames(m.TypeParams);   // fix-explicit-type-arg-not-substituted
                ct.Methods.Put(m.Name, sym);
                // G18-import：实例方法入 OwnMethod* 有序元数据（TSIG 方法继承展开；static 不入）。
                if (!m.IsStatic) { ct.AddOwnMethod(m.Name, m.IsVirtual, m.IsAbstract); }
                // 重载 arity 后缀（"Substring$2"）→ 同时注册 bare 键 first-wins（镜像 C# Phase2）
                if (srcDol >= 0) {
                    string bare = srcName;
                    if (!ct.Methods.ContainsKey(bare)) { ct.Methods.Put(bare, sym); }
                }
            }
            i = i + 1;
        }
    }

    // `String.IndexOf(char)` 已是 bulk char[] 版（ToCharArray 一次 + ArrayGet 扫）；原来这里
    // 手写的循环每字符要 `s.Length` + `s.CharAt(i)` 两次 builtin 分发。
    private static int _dollarAt(string s) { return s.IndexOf('$'); }

    // PR6：把 ExportedParamZ 的 DefaultBlob / CallerKind 填进 Z42FuncType（跨包默认值/ caller 宏传播）。
    // fix-crosspkg-named-args：同批填形参**源名**（命名实参跨包归位用；来源是 SIGS 的 name_str_idx）。
    // pz 已是逻辑参数序（TsigReconcile._params 跳 this 槽）→ 与 sig.ParamTypes 对齐。
    // record-ref-in-signature：`known` = 该方法的 ref 信息是否写全了（`$RefSig` 完备性标记）。
    // **旧包传 false** ⇒ `HasRefInfo()` 为假 ⇒ 对称性检查整条跳过。不能省略这个参数按
    // 「ParamIsRef 全 false」推断——那会把旧包判成「已知全非 ref」，让引用未重编旧包、
    // 且写了 `F(ref v)` 的调用点被成批误报 E0473。见 record-ref-in-signature 的 design §D2。
    private static void _fillParamMeta(Z42FuncType sig, ExportedParamZ[] pz, int count, bool known, bool retMarked) {
        string[] defs = new string[count];
        string[] cls = new string[count];
        string[] names = new string[count];
        bool[] refs = new bool[count];
        // define-null-check-marks 3.3：跨包 `?` 标记。发射端早就把它写进 TSIG 了
        // （`TypeNameResolver._hybridTypeName` 对 `NullableType` 追加 `?`），只是加载侧
        // `_resolve` 把后缀当垃圾剥掉、标记位一位不还原 ⇒ **跨过包边界义务就没了**。
        // stdlib 对用户代码就是跨包，不补这一截，「标注 stdlib 的『可能没有』API」等于白标。
        bool[] nulls = new bool[count];
        int i = 0;
        while (i < count) {
            defs[i] = pz[i].DefaultBlob; cls[i] = pz[i].CallerKind; names[i] = pz[i].Name; refs[i] = pz[i].IsRef;
            nulls[i] = ImportedSymbolLoader._nullableMark(pz[i].IsNullable, sig.ParamTypes[i]);
            i = i + 1;
        }
        sig.ParamDefaults = defs; sig.ParamCallers = cls; sig.ParamNames = names;
        sig.ParamIsRef = refs; sig.RefInfoKnown = known;
        sig.ParamIsNullable = nulls;
        sig.RetIsNullable = ImportedSymbolLoader._nullableMark(retMarked, sig.Ret);
    }

    // 跨包 `?` 标记位。**唯一来源是哨兵**（`$Nullable` 逐形参 / `$RetNullable` 方法级），
    // 走 param/method attr-ref 旁路通道。
    //
    // 🔴 **绝不能改看类型拼写**（我栽过一次，8 处误报）：`"?"` 在这套代码里是**「类型未知」
    // 占位串**——`this` 槽（`FunctionEmitter:62/391`）、lift 形参（`:398`）、SIGS 缺名回落
    // （`TsigReconcile._params:630`）都写它。拿 `EndsWith("?")` 当判据，这些占位全被认成
    // 「标了 `?`」，`string.Substring` / `Path.Normalize` 这类根本没标的成员一律变可空
    // ⇒ 自举当场崩。**同一个字符在两套语境里含义相反**，这是 D3 零容忍的那类误报。
    //
    // 另一面：SIGS 的类型拼写里本来也**没有**真标记可读 —— `FunctionEmitter._sigTypeName`
    // 历来剥 `?`，因为那串同时是**派发键**，塞 `?` 会改键。所以旁路是唯一的路。
    //
    // **不需要 `ref` 那样的「已知」位**：`?` 的语义是「请编译器在这里强制检查」，
    // **缺席 = 不强制**（不是「保证非空」），所以旧包读不出哨兵时落成 false 恰好正确。
    //
    // ⚠️ 值类型不置位，且**复用 `TypeChecker._isNonNullableValueType`、不另写一份判据**
    // （「编译期与运行期各判各的」正是 `where T : struct` 那个 bug 的形状）。
    private static bool _nullableMark(bool marked, Z42Type resolved) {
        if (!marked) { return false; }
        if (TypeChecker._isNonNullableValueType(resolved)) { return false; }
        return true;
    }

    private static bool _isPrelude(string pkg) { return pkg == "z42.core"; }

    // 包是否提供 usings 中任一 ns（按该包全部 TSIG 模块的 ns 判断）。
    private static bool _pkgProvidesUsing(ExportedModuleZ[] exported, string[] pkgNames, int count,
                                          string pkg, string[] usings, int usingCount) {
        int i = 0;
        while (i < count) {
            if (pkgNames[i] == pkg) {
                int u = 0;
                while (u < usingCount) {
                    if (exported[i].Namespace == usings[u]) { return true; }
                    u = u + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }
}
