// 跨包符号加载（port-z42c-import CI-3）。镜像 C# ImportedSymbolLoader 的 Phase1/2 子集：
// TSIG ExportedModuleZ → 短名 Z42ClassType 骨架（Phase1）→ 成员填充（Phase2：实例+静态方法、
// 字段、自由函数）。激活过滤 = prelude 包 ∪ {提供 cu.Usings 中 ns 的包}（strict-using-resolution）。
// 延后：Phase3 impl 合并 / 接口·委托·枚举 / 泛型实例化串解析 / E0601 冲突诊断。
namespace Z42.Semantics;

using Z42.IR;

// string 值盒（StrMap 存 object，prim 不能 `as string` 下行 → 包一层）。
public sealed class StrBox {
    public string Value;
    public StrBox(string value) { this.Value = value; }
}

// 加载产物（镜像 C# ImportedSymbols 子集）。
public sealed class ImportedSymbols {
    public StrMap Classes;          // 短名 → Z42ClassType（成员已填）
    public StrMap Functions;        // 名 → MethodSymbol（自由函数）
    public StrMap ClassNamespaces;  // 短名 → 原 ns（QualifyClassName / 诊断用；值存 StrBox）
    public StrMap FunctionNamespaces; // 自由函数名 → 原 ns（QualifyFreeFunc：跨包裸调按源 ns 限定；值存 StrBox）
    public StrMap Interfaces;       // 短名 → Z42InterfaceType（接口骨架；供 _passClassStubs 基表判别）
    public StrMap EnumTypeNames;    // 枚举类型短名 → "enum"（镜像 SymbolTable.EnumTypes；imported 枚举常量解析用）
    public StrMap EnumConsts;       // "EnumType.Member" → StrBox(long 值)（镜像 SymbolTable.EnumConsts）
    // add-associated-types PR-1：导入类的 where 约束（键与 Classes 同一 clKey，即条件 arity-mangle，
    // 与 SymbolTable.ConstraintKey 口径一致）→ ConstraintSet。修前此表不存在，跨包约束全程无载体。
    public StrMap Constraints;
    public ImportedSymbols() {
        this.Classes = new StrMap();
        this.Constraints = new StrMap();
        this.Functions = new StrMap();
        this.ClassNamespaces = new StrMap();
        this.FunctionNamespaces = new StrMap();
        this.Interfaces = new StrMap();
        this.EnumTypeNames = new StrMap();
        this.EnumConsts = new StrMap();
    }
}

public static class ImportedSymbolLoader {

    // add-associated-types PR-1：导入类的 IrConstraintDesc[]（IR 侧，与 zbc flag 位对应）
    // → ConstraintSet（语义侧，ConstraintChecker.Check 直接消费的形态）。无约束返回 null。
    //
    // 这是「跨包约束校验」链路的最后一段。上游：ZbcWriter 置全 bit → ZbcReader 读回
    // IrConstraintDesc → TsigReconcile 搬进 ExportedClassZ → 此处 → SymbolTable.ClassConstraints。
    // bundle 里的接口名/基类名是**裸名**，与本包路径（ConstraintChecker._fillBundle 存 nt.Name）
    // 同一口径，故 _satisfiesInterface / _satisfiesBase 对本包与导入类型的判定完全一致。
    private static ConstraintSet _constraintSetOf(ExportedClassZ cl) {
        if (cl.TpConstraintCount <= 0 || cl.TypeParamConstraints == null) { return null; }
        int pc = cl.TpCount;
        if (pc <= 0) { return null; }
        ConstraintBundle[] bundles = new ConstraintBundle[pc];
        int i = 0;
        while (i < pc) { bundles[i] = new ConstraintBundle(); i = i + 1; }
        int n = pc;
        if (cl.TpConstraintCount < n) { n = cl.TpConstraintCount; }
        bool any = false;
        int k = 0;
        while (k < n) {
            IrConstraintDesc d = cl.TypeParamConstraints[k];
            if (d != null) {
                ConstraintBundle b = bundles[k];
                b.RequiresClass  = d.RequiresClass;
                b.RequiresStruct = d.RequiresStruct;
                if (d.BaseClass != "") { b.HasBaseClass = true; b.BaseClassName = d.BaseClass; }
                if (d.TypeParamConstraint != "") { b.HasTypeParamRef = true; b.TypeParamRef = d.TypeParamConstraint; }
                b.RequiresCtor = d.RequiresCtor;
                b.RequiresEnum = d.RequiresEnum;
                int j = 0;
                while (j < d.InterfaceCount) { b.AddInterface(d.Interfaces[j]); j = j + 1; }
                if (!b.IsEmpty()) { any = true; }
            }
            k = k + 1;
        }
        if (!any) { return null; }
        string[] pnames = cl.TypeParams;
        if (pnames == null) { pnames = new string[0]; }
        return new ConstraintSet(pnames, bundles, pc);
    }

    // exported/pkgNames 平行（DepScan 产物）；usings = cu 的 using ns 列表。
    public static ImportedSymbols Load(ExportedModuleZ[] exported, string[] pkgNames, int exportedCount,
                                       string[] usings, int usingCount) {
        var r = new ImportedSymbols();
        // ── 激活集：prelude 包恒激活；非 prelude 须有 using 命中其某模块 ns ──
        bool[] active = new bool[exportedCount];
        int i = 0;
        while (i < exportedCount) {
            if (ImportedSymbolLoader._isPrelude(pkgNames[i])) { active[i] = true; }
            else { active[i] = ImportedSymbolLoader._pkgProvidesUsing(exported, pkgNames, exportedCount, pkgNames[i], usings, usingCount); }
            i = i + 1;
        }
        // ── Pre-scan：检测 imported 同名不同 arity 的类，泛型版需 arity-mangle（镜像 local
        // SymbolCollector pre-scan + C# NeedsMangle）。否则 arity-0 base 与 arity-N 泛型
        // （如 MulticastException / MulticastException<TResult>）撞键 → first-wins 丢泛型 →
        // new/throw/catch `C<int>` 误取 base → 运行期类型失配。
        StrMap impFirstArity = new StrMap();
        StrMap impMultiArity = new StrMap();
        i = 0;
        while (i < exportedCount) {
            if (active[i]) {
                ExportedModuleZ pem = exported[i];
                int pc = 0;
                while (pc < pem.ClassCount) {
                    ExportedClassZ pcl = pem.Classes[pc];
                    string arStr = pcl.TpCount.ToString();
                    if (impFirstArity.ContainsKey(pcl.Name)) {
                        StrBox fa = impFirstArity.Get(pcl.Name) as StrBox;
                        if (fa.Value != arStr) { impMultiArity.Put(pcl.Name, "1"); }
                    } else { impFirstArity.Put(pcl.Name, new StrBox(arStr)); }
                    pc = pc + 1;
                }
            }
            i = i + 1;
        }
        // ── Phase1：骨架（短名 → 空成员 Z42ClassType + 接口名表）──
        i = 0;
        while (i < exportedCount) {
            if (active[i]) {
                ExportedModuleZ em = exported[i];
                int c = 0;
                while (c < em.ClassCount) {
                    ExportedClassZ cl = em.Classes[c];
                    bool needsMangle = cl.TpCount > 0 && impMultiArity.ContainsKey(cl.Name);
                    string clKey = needsMangle ? (cl.Name + "$" + cl.TpCount.ToString()) : cl.Name;
                    if (!r.Classes.ContainsKey(clKey)) {        // first-wins（输入已 prelude-first 排序）
                        string baseName = "";
                        bool hasBase = cl.HasBase && cl.BaseName != "Object";
                        if (hasBase) { baseName = cl.BaseName; }
                        Z42ClassType nct = new Z42ClassType(cl.Name, hasBase, baseName);
                        nct.IsImported = true;        // enforce-access-control：来自依赖 zpkg（跨包）→ internal 成员不可访问
                        nct.IsSealed = cl.IsSealed;   // impl-sealed-semantics-devirt：跨包 sealed 类（继承强制 + 去虚化）
                        nct.IsDeprecated = cl.IsDeprecated; nct.DeprecationMsg = cl.DeprecationMsg;   // add-deprecated-directive：跨包类级弃用（use-site 告警）
                        nct.Visibility = cl.Visibility;   // enforce-class-access：跨包类声明可见性（internal 类跨包引用 deny）
                        // add-crosspkg-struct-value-semantics (P4a) 根因修复：跨包 struct 值类型分类。生产方
                        // ExportedTypeExtractor 把 struct-ness 编码进 ExportedClassZ.HasBase（`hasBase = !isStruct`——
                        // 非-struct class 恒 HasBase=true，struct 恒 HasBase=false），故 `!cl.HasBase` 精确等价
                        // isStruct。修前 imported struct 当引用类型（消费方不发 StructAlloc/FieldGetPrim）→ 与生产方
                        // struct 构造函数（发 StructFieldSetPrim off=0）不一致 → 运行期 blob-bounds 崩。分类正确后
                        // StructLayout.BuildFromSymbols 从字段名/类型重算布局（与生产方持久化逐字节一致）。
                        //
                        // ⚠️ 此处原有一条「不新增 ExportedClassZ 字段 ← bootstrap 越界」的论证，已于
                        // add-associated-types (2026-09-06) 删除：它写下时（ea3f0c73, 08-12）就已失效 13 天——
                        // _ensureBootstrapSelfDepLibs 的破环预建自 07596b57 (07-30) 起**总是**用当前 driver 把
                        // 当前源 z42.ir 建进 build-libs（不 warm-skip），z42c 源用当前源 z42.ir 新 API 已是常态
                        // （先例：IsSealed / Visibility / IsDeprecated / ExportedMethodZ.TypeParamCount / StrMap.Find）。
                        // 唯一仍有效的约束是**种子 ABI**：新字段不得进 ctor 签名，须 ctor 内给默认值 + 构造后赋值。
                        // 机制见 docs/design/compiler/self-hosting.md 轴④ 与 .claude/rules/bootstrap-seed.md。
                        // （struct-ness 继续复用 HasBase 编码属独立技术债，登记 Deferred，不在本 change 内改。）
                        nct.IsStruct = !cl.HasBase;
                        if (cl.TpCount > 0) { nct.GenericParamNames = cl.TypeParams; nct.GenericParamCount = cl.TpCount; }
                        if (needsMangle) { nct.HasArityMangle = true; nct.ArityMangleCount = cl.TpCount; }
                        // fix-crosspkg-interface-impl：imported 类带上实现接口表（bare 名，TSIG 恢复）——
                        // SymbolTable.Implements 据此判 class→iface 可赋性（`ICompiler c = new NoCompiler()`）。
                        if (cl.InterfaceCount > 0) {
                            nct.InterfaceNames = cl.Interfaces;
                            nct.InterfaceCount = cl.InterfaceCount;
                        }
                        r.Classes.Put(clKey, nct);
                        r.ClassNamespaces.Put(clKey, new StrBox(em.Namespace));
                        // add-associated-types PR-1：跨包 where 约束。键与 Classes 同为 clKey，
                        // 与 SymbolTable.ConstraintKey 的条件 arity-mangle 口径一致。
                        ConstraintSet ics = ImportedSymbolLoader._constraintSetOf(cl);
                        if (ics != null) { r.Constraints.Put(clKey, ics); }
                    }
                    c = c + 1;
                }
                // 接口骨架（供下游 _passClassStubs 基表判别：imported 接口名必须在 table.Interfaces 中）
                int ic = 0;
                while (ic < em.InterfaceCount) {
                    ExportedInterfaceZ iz = em.Interfaces[ic];
                    if (!r.Interfaces.ContainsKey(iz.Name)) {
                        Z42InterfaceType nift = new Z42InterfaceType(iz.Name);
                        nift.IsImported = true;                 // complete-class-access-control ④：来自依赖 zpkg（跨包）→ internal 接口不可引用
                        nift.Visibility = iz.Visibility;        // complete-class-access-control ④：跨包接口声明可见性
                        // add-associated-types PR-3：导入接口的型参名进符号表（与本包 StubCollector 对称）。
                        nift.TypeParamNames = iz.TypeParams; nift.TypeParamCount = iz.TpCount;
                        r.Interfaces.Put(iz.Name, nift);
                        // fix-crosspkg-interface-impl：记 imported 接口声明 ns，使 QualifyClass 把
                        // `: IFace` / `as IFace` 正确 FQ 化为「声明包.IFace」（否则退化当前包 ns →
                        // 实现类与 cast 目标名各自错限定、跨包 is/as/接口派发失配）。
                        r.ClassNamespaces.Put(iz.Name, new StrBox(em.Namespace));
                    }
                    ic = ic + 1;
                }
                // 枚举常量（imported `EnumType.Member` → BoundLitInt；镜像 _passEnums 填 EnumTypes/EnumConsts）。
                int ec = 0;
                while (ec < em.EnumCount) {
                    ExportedEnumZ ez = em.Enums[ec];
                    if (!r.EnumTypeNames.ContainsKey(ez.Name)) {
                        r.EnumTypeNames.Put(ez.Name, "enum");
                        int emi = 0;
                        while (emi < ez.MemberCount) {
                            ExportedEnumMemberZ emem = ez.Members[emi];
                            r.EnumConsts.Put(ez.Name + "." + emem.Name, new StrBox(emem.Value.ToString()));
                            emi = emi + 1;
                        }
                    }
                    ec = ec + 1;
                }
            }
            i = i + 1;
        }
        // ── Phase2：成员填充（骨架齐备后解析类型可互指）──
        i = 0;
        while (i < exportedCount) {
            if (active[i]) {
                ExportedModuleZ em = exported[i];
                int c = 0;
                while (c < em.ClassCount) {
                    ExportedClassZ cl = em.Classes[c];
                    bool needsMangle = cl.TpCount > 0 && impMultiArity.ContainsKey(cl.Name);
                    string clKey = needsMangle ? (cl.Name + "$" + cl.TpCount.ToString()) : cl.Name;
                    Z42ClassType ct = r.Classes.Get(clKey) as Z42ClassType;
                    StrBox owner = r.ClassNamespaces.Get(clKey) as StrBox;
                    if (ct != null && owner != null && owner.Value == em.Namespace) {
                        ImportedSymbolLoader._fillClass(r, ct, cl);
                    }
                    c = c + 1;
                }
                // 自由函数
                int f = 0;
                while (f < em.FunctionCount) {
                    ExportedFuncZ fz = em.Functions[f];
                    if (!r.Functions.ContainsKey(fz.Name)) {
                        Z42Type[] ps = new Z42Type[fz.ParamCount];
                        int j = 0;
                        while (j < fz.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, fz.Params[j].TypeName); j = j + 1; }
                        var sig = new Z42FuncType(ps, fz.ParamCount, ImportedSymbolLoader._resolve(r, fz.ReturnType));
                        sig.ParamsFrom = fz.ParamsFrom;
                        ImportedSymbolLoader._fillParamDefaults(sig, fz.Params, fz.ParamCount);   // PR6：跨包默认值/ caller
                        r.Functions.Put(fz.Name, new MethodSymbol(fz.Name, "public", sig, false, "", false, null));
                        // 记源 ns（与 ClassNamespaces 对称）→ 发射期 QualifyFreeFunc 跨包裸调按源 ns 限定。
                        r.FunctionNamespaces.Put(fz.Name, new StrBox(em.Namespace));
                    }
                    f = f + 1;
                }
                // imported 接口方法填充（fix-crosspkg-interface-impl）：跨包 `c.Compile(req)` /
                // `f.Val()` 的接口派发查 Z42InterfaceType.Methods——从 TSIG 重建的
                // ExportedInterfaceZ 方法灌入（镜像 local _passMembers 的接口方法收集）。
                int ifi2 = 0;
                while (ifi2 < em.InterfaceCount) {
                    ExportedInterfaceZ iz2 = em.Interfaces[ifi2];
                    Z42InterfaceType it2 = r.Interfaces.Get(iz2.Name) as Z42InterfaceType;
                    if (it2 != null) {
                        // add-associated-types PR-2：接口方法签名的型参上下文 = 接口 TypeParams ∪ {"Self"}。
                        // **顺带修既有缺口**：此前这里走 `_resolve(r, name)` 单参版（无型参上下文）⇒ 跨包
                        // 泛型接口方法里的 `T` 落到 `Z42ClassType.Builtin("T")` 兜底垃圾类型，而非
                        // Z42GenericParamType。`Self` 会踩同一个坑，故一并接上（design D5）。
                        string[] itp2 = MemberCollector._withSelf(iz2.TypeParams, iz2.TpCount);
                        int itpc2 = iz2.TpCount + 1;
                        int im2 = 0;
                        while (im2 < iz2.MethodCount) {
                            ExportedMethodZ mz = iz2.Methods[im2];
                            if (!it2.Methods.ContainsKey(mz.Name)) {
                                // R1：接口级型参（**含 `Self`**，add-self-type 的 `itp2`）∪ **方法级**型参。
                                // 此前方法级一个都没喂 → `IBasicCollection<T>.AddOne(T)` 的 `T` 降级成
                                // 名为 "T" 的普通类 ⇒ `AddOne(1)` 报 `int → T`。
                                string[] itps = ImportedSymbolLoader._tpsWith(itp2, itpc2, mz.TypeParams);
                                int itpc = itps.Length;
                                Z42Type[] mps = new Z42Type[mz.ParamCount];
                                int mj2 = 0;
                                while (mj2 < mz.ParamCount) { mps[mj2] = ImportedSymbolLoader._resolve(r, mz.Params[mj2].TypeName, itps, itpc); mj2 = mj2 + 1; }
                                var msig = new Z42FuncType(mps, mz.ParamCount, ImportedSymbolLoader._resolve(r, mz.ReturnType, itps, itpc));
                                ImportedSymbolLoader._fillParamDefaults(msig, mz.Params, mz.ParamCount);   // PR6
                                it2.Methods.Put(mz.Name, new MethodSymbol(mz.Name, "public", msig, false, iz2.Name, false, null));
                            }
                            im2 = im2 + 1;
                        }
                    }
                    ifi2 = ifi2 + 1;
                }
            }
            i = i + 1;
        }
        // ── Phase3：impl 合并（L3-Impl2；镜像 C# MergeImpls）——方法并入 imported target，trait 入其接口集 ──
        i = 0;
        while (i < exportedCount) {
            if (active[i]) {
                ExportedModuleZ em = exported[i];
                int c = 0;
                while (c < em.ImplCount) {
                    ImportedSymbolLoader._mergeImpl(r, em.Impls[c]);
                    c = c + 1;
                }
            }
            i = i + 1;
        }
        return r;
    }

    // 单条 impl 合并到 imported target class（镜像 C# MergeImpls 内层）。
    private static void _mergeImpl(ImportedSymbols r, ExportedImplZ im) {
        string targetShort = ImportedSymbolLoader._shortName(im.TargetFq);
        if (targetShort == "") { return; }
        if (!r.Classes.ContainsKey(targetShort)) { return; }      // target 不在 import 集 → 跳过
        Z42ClassType ct = r.Classes.Get(targetShort) as Z42ClassType;
        string traitShort = ImportedSymbolLoader._shortName(im.TraitFq);
        if (traitShort == "") { return; }
        // 注：不校验 r.Interfaces.ContainsKey(traitShort)——z42c 不 import 接口进表（会破坏
        // stdlib byte-identical），且 impl 块由生产端（greeter 编译期）已校验 trait 合法性。
        // 方法并入 target.Methods（first-wins）+ 实例方法入 OwnMethod 有序元数据
        int m = 0;
        while (m < im.MethodCount) {
            ExportedMethodZ me = im.Methods[m];
            if (!ct.Methods.ContainsKey(me.Name)) {
                // R1：trait-impl 方法的方法级型参（此前不喂 → 同款降级）。
                string[] etps = ImportedSymbolLoader._tpsWith(new string[0], 0, me.TypeParams);
                int etpc = etps.Length;
                Z42Type[] ps = new Z42Type[me.ParamCount];
                int j = 0;
                while (j < me.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, me.Params[j].TypeName, etps, etpc); j = j + 1; }
                var sig = new Z42FuncType(ps, me.ParamCount, ImportedSymbolLoader._resolve(r, me.ReturnType, etps, etpc));
                sig.ParamsFrom = me.ParamsFrom;
                ImportedSymbolLoader._fillParamDefaults(sig, me.Params, me.ParamCount);   // PR6：跨包默认值/ caller
                var sym = new MethodSymbol(me.Name, me.Visibility, sig, me.IsStatic, ct.Name(), false, null);
                sym.IsSealed = me.IsSealed;   // impl-sealed-semantics-devirt：跨包方法级 sealed（override 强制）
                sym.IsDeprecated = me.IsDeprecated; sym.DeprecationMsg = me.DeprecationMsg;   // add-deprecated-directive：跨包方法级弃用
                sym.TypeParamCount = me.TypeParamCount;   // add-array-paired-sort：跨包方法级泛型形参个数，供 arity 重载过滤
                ct.Methods.Put(me.Name, sym);
                if (!me.IsStatic) { ct.AddOwnMethod(me.Name, me.IsVirtual, me.IsAbstract); }
            }
            m = m + 1;
        }
        // trait 并入 target 接口集（去重：AddInterfaceName 不查重 → 此处先查）
        bool seen = false;
        int ix = 0;
        while (ix < ct.InterfaceCount) { if (ct.InterfaceNames[ix] == traitShort) { seen = true; } ix = ix + 1; }
        if (!seen) { ct.AddInterfaceName(traitShort); }
    }

    // FQ "Demo.Target.Robot" → 短名 "Robot"（无点 → 原串）。镜像 C# SplitFqName 取 ShortName。
    private static string _shortName(string fq) {
        if (fq == "") { return ""; }
        int dot = 0 - 1;
        int i = 0;
        while (i < fq.Length) { if (fq.CharAt(i) == '.') { dot = i; } i = i + 1; }
        if (dot < 0) { return fq; }
        return fq.Substring(dot + 1, fq.Length - dot - 1);
    }

    // add-argument-type-check R1：类/接口级型参 ∪ **方法级**型参 → `_resolve` 的型参表。
    // 此前只喂类级（`_fillClass` 的 tps）或压根不喂（接口方法 / trait-impl 方法 / 自由函数），
    // 于是 `Array.Copy<T>(T[],T[],int)`、`IBasicCollection<T>.AddOne(T)` 这类签名里的 `T` 落到
    // `_resolve` 末尾的 `Z42ClassType.Builtin(name)` 兜底 → **型参身份丢失**（成了名为 "T" 的普通类）
    // ⇒ `Conversion._classifyBuiltin` 分支 B「恰一侧泛型形参 → 擦除放行」永不触发。
    // 合并而非替换：类级与方法级可同时在场（`class C<T> { void M<U>(T t, U u) }`）。
    private static string[] _tpsWith(string[] outer, int outerCount, string[] methodTps) {
        int mc = 0;
        if (methodTps != null) { mc = methodTps.Length; }
        if (mc == 0) { return outer == null ? new string[0] : outer; }
        int oc = outerCount;
        if (outer == null) { oc = 0; }
        string[] merged = new string[oc + mc];
        int i = 0;
        while (i < oc) { merged[i] = outer[i]; i = i + 1; }
        int k = 0;
        while (k < mc) { merged[oc + k] = methodTps[k]; k = k + 1; }
        return merged;
    }

    private static void _fillClass(ImportedSymbols r, Z42ClassType ct, ExportedClassZ cl) {
        string[] tps = cl.TypeParams;
        int tpc = cl.TpCount;
        int i = 0;
        while (i < cl.FieldCount) {
            ExportedFieldZ fd = cl.Fields[i];
            if (!ct.Fields.ContainsKey(fd.Name)) {
                FieldSymbol fsym = new FieldSymbol(fd.Name, fd.Visibility,
                    ImportedSymbolLoader._resolve(r, fd.TypeName, tps, tpc), fd.IsStatic, ct.Name());
                fsym.IsDeprecated = fd.IsDeprecated; fsym.DeprecationMsg = fd.DeprecationMsg;   // add-deprecated-directive：跨包字段级弃用
                ct.Fields.Put(fd.Name, fsym);
                // G18-import：实例字段入 OwnField* 有序元数据（TSIG 继承字段展开；static 不入，同本地 _fillClass）。
                if (!fd.IsStatic) { ct.AddOwnField(fd.Name, fd.TypeName, fd.Visibility); }
            }
            i = i + 1;
        }
        i = 0;
        while (i < cl.MethodCount) {
            ExportedMethodZ m = cl.Methods[i];
            if (!ct.Methods.ContainsKey(m.Name)) {              // bare+arity 键并存，bare first-wins
                // R1：类级 tps ∪ 方法级 m.TypeParams（`Array.Copy<T>` 是「类无型参 + 方法级型参」）。
                string[] mtps = ImportedSymbolLoader._tpsWith(tps, tpc, m.TypeParams);
                int mtpc = mtps.Length;
                Z42Type[] ps = new Z42Type[m.ParamCount];
                int j = 0;
                while (j < m.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, m.Params[j].TypeName, mtps, mtpc); j = j + 1; }
                var sig = new Z42FuncType(ps, m.ParamCount, ImportedSymbolLoader._resolve(r, m.ReturnType, mtps, mtpc));
                sig.ParamsFrom = m.ParamsFrom;
                ImportedSymbolLoader._fillParamDefaults(sig, m.Params, m.ParamCount);   // PR6：跨包默认值/ caller（静态+实例主路径）
                // z42c 既有约定：静态/实例同进 Methods（IsStatic 标真值）——D3
                // add-type-based-overloads：symbol.Name = 源名（首个 $ 前），RegKey = 完整注册键
                //   → OverloadsOf(源名) 跨包候选枚举一致（同本地）；调用方决议返回 RegKey 派发。
                // 同一个 m.Name 原来在本次迭代里被 _dollarAt 算了两遍（这里与下面注册 bare 键处）。
                int srcDol = ImportedSymbolLoader._dollarAt(m.Name);
                string srcName = (srcDol >= 0) ? m.Name.Substring(0, srcDol) : m.Name;
                var sym = new MethodSymbol(srcName, m.Visibility, sig, m.IsStatic, ct.Name(), false, null);
                sym.RegKey = m.Name;
                sym.IsSealed = m.IsSealed;   // impl-sealed-semantics-devirt：跨包方法级 sealed（override 强制）
                sym.IsDeprecated = m.IsDeprecated; sym.DeprecationMsg = m.DeprecationMsg;   // add-deprecated-directive：跨包方法级弃用
                sym.TypeParamCount = m.TypeParamCount;   // add-array-paired-sort：跨包方法级泛型形参个数，供 arity 重载过滤
                ct.Methods.Put(m.Name, sym);
                // G18-import：实例方法入 OwnMethod* 有序元数据（TSIG 方法继承展开；static 不入）。
                if (!m.IsStatic) { ct.AddOwnMethod(m.Name, m.IsVirtual, m.IsAbstract); }
                // 重载 arity 后缀（"Substring$2"）→ 同时注册 bare 键 first-wins（镜像 C# Phase2）
                if (srcDol >= 0) {
                    string bare = srcName;
                    if (!ct.Methods.ContainsKey(bare)) { ct.Methods.Put(bare, sym); }
                }
            }
            i = i + 1;
        }
    }

    // `String.IndexOf(char)` 已是 bulk char[] 版（ToCharArray 一次 + ArrayGet 扫）；原来这里
    // 手写的循环每字符要 `s.Length` + `s.CharAt(i)` 两次 builtin 分发。
    private static int _dollarAt(string s) { return s.IndexOf('$'); }

    // add-argument-type-check R5/R7：委托类型名 → Z42FuncType；非委托名返回 null（调用方继续原流程）。
    // 名字形态与 `Z42FuncType.Name()` 的产物**互逆**（Action / Action<A,…> / Func<A,…,Ret> / Predicate<A>），
    // 故 TSIG 里的委托类型串能无损还原。语义逐条对齐 `SymbolTable.ResolveTypeP:238-254`。
    private static Z42Type _resolveDelegate(ImportedSymbols r, string name, string[] typeParams, int tpCount) {
        if (name == "Action") { return new Z42FuncType(new Z42Type[0], 0, new Z42VoidType()); }
        int lt = name.IndexOf("<");
        if (lt <= 0 || !name.EndsWith(">")) { return null; }
        string b = name.Substring(0, lt);
        if (b != "Action" && b != "Func" && b != "Predicate") { return null; }
        string[] argStrs = ImportedSymbolLoader._splitTypeArgs(name.Substring(lt + 1, name.Length - lt - 2));
        int n = argStrs.Length;
        if (b == "Action") {
            Z42Type[] ps = new Z42Type[n];
            int i = 0;
            while (i < n) { ps[i] = ImportedSymbolLoader._resolve(r, argStrs[i], typeParams, tpCount); i = i + 1; }
            return new Z42FuncType(ps, n, new Z42VoidType());
        }
        if (b == "Predicate") {
            if (n != 1) { return null; }
            Z42Type[] ps = new Z42Type[1];
            ps[0] = ImportedSymbolLoader._resolve(r, argStrs[0], typeParams, tpCount);
            return new Z42FuncType(ps, 1, Z42ClassType.Builtin("bool"));
        }
        if (n < 1) { return null; }                     // Func 至少要有返回类型
        Z42Type[] ps = new Z42Type[n - 1];
        int i = 0;
        while (i < n - 1) { ps[i] = ImportedSymbolLoader._resolve(r, argStrs[i], typeParams, tpCount); i = i + 1; }
        return new Z42FuncType(ps, n - 1, ImportedSymbolLoader._resolve(r, argStrs[n - 1], typeParams, tpCount));
    }

    // TypeResolver 子集（镜像 C# 优先级）：数组后缀 → prim/void → imported class → 泛型型参 → fallback prim(name)。
    // typeParams/tpCount：当前类的类型形参列表（如 ["T"] for Channel<T>）；无则传空数组 + 0。
    private static Z42Type _resolve(ImportedSymbols r, string name, string[] typeParams, int tpCount) {
        if (name.EndsWith("[]")) {
            return new Z42ArrayType(ImportedSymbolLoader._resolve(r, name.Substring(0, name.Length - 2), typeParams, tpCount));
        }
        if (name == "void") { return new Z42VoidType(); }
        // add-argument-type-check R3（欠债表 bug B3 的**消费端**半边）：`"unknown"` 是**哨兵**，不是类名。
        // 发射端 `FunctionEmitter._sigTypeName` 对含点的限定名（`Std.Type`）刻意写字面量 "unknown"，
        // 此处却读成 `Z42ClassType.Builtin("unknown")`——一个「名叫 unknown 的类」⇒ `Conversion` 分支 A
        // 的 error/unknown **Absorb 守卫失效** ⇒ `f.GetAttribute(typeof(X))` 被判 `Type → unknown` 不可转。
        // 还原成 Z42UnknownType 后 Absorb 生效、级联抑制恢复正常。
        // 🕳 **产出端半边仍是欠债**（让 SIGS 写出真实限定名）：那会改 SIGS 字节、波及 golden 与自举
        // 不动点，且反射面 `FieldType.Name == "unknown"` 有运行期后果 → 保留为独立 change（bug B3）。
        if (name == "unknown") { return new Z42UnknownType(); }
        if (ImportedSymbolLoader._isPrim(name)) { return Z42ClassType.Builtin(name); }
        // add-argument-type-check R5/R7：**imported 委托类型名 → Z42FuncType**。
        // 本地解析器 `SymbolTable.ResolveTypeP:238-254` 早已把 Func/Action/Predicate 映射成结构
        // Z42FuncType（这三个名是内建、全仓无对应 class/interface 声明），imported 侧却没有同款分支 →
        // 退化成同名 `Z42ClassType("Action")`。后果两条：
        //   ① lambda 实参拿不到 Z42FuncType 目标 ⇒ `Thread.Start(() => {…})` 的 lambda 定不了型
        //      （`Func<<unknown>>` → `Action` 失败）；
        //   ② `Func<int>` 与 `Func<Int32>` 判不相等（一侧结构、一侧退化类）。
        // 这与 R1（型参身份）/ R3（"unknown" 固化）同属 imported **类型保真度**缺口，按根因修产出端。
        {
            Z42Type dg = ImportedSymbolLoader._resolveDelegate(r, name, typeParams, tpCount);
            if (dg != null) { return dg; }
        }
        int _sl0 = r.Classes.Find(name); if (_sl0 >= 0) { return r.Classes.ValAt(_sl0) as Z42ClassType; }
        // fix-crosspkg-interface-impl：imported 接口名 → Z42InterfaceType（此前落 prim fallback →
        // imported 类的接口型属性/参数（Pipeline.Compiler : ICompiler）解析错型 → 赋值 E0402）。
        int _sl1 = r.Interfaces.Find(name); if (_sl1 >= 0) { return r.Interfaces.ValAt(_sl1) as Z42InterfaceType; }
        // 根因修复（infer-crosspkg-generic-instantiation）：泛型实例化串 `List<int>` /
        // `Dictionary<string,int>` → 解析基类（r.Classes）+ 递归解析类型参数 → Z42InstantiatedType。
        // 否则落 fallback prim(name) 垃圾类型；一旦该字段被跨轮 carry-forward（`var v = Other.f;`）
        // 再导出，TSIG 畸形 → 下游消费包 `undefined: <class>`（add-z42-repl 会话 List<int> 变量的
        // carry-forward 暴露：round N carry round N-1 的 var 字段，链式失真）。
        int ltIdx = name.IndexOf("<");
        if (ltIdx > 0 && name.EndsWith(">")) {
            string baseN = name.Substring(0, ltIdx);
            Z42ClassType gdef = null;
            int _sl2 = r.Classes.Find(baseN); if (_sl2 >= 0) { gdef = r.Classes.ValAt(_sl2) as Z42ClassType; }
            else {
                string gbs = ImportedSymbolLoader._shortName(baseN);
                if (gbs != baseN && r.Classes.ContainsKey(gbs)) { gdef = r.Classes.Get(gbs) as Z42ClassType; }
            }
            if (gdef != null) {
                string argsStr = name.Substring(ltIdx + 1, name.Length - ltIdx - 2);
                string[] argStrs = ImportedSymbolLoader._splitTypeArgs(argsStr);
                Z42Type[] targs = new Z42Type[argStrs.Length];
                int ai = 0;
                while (ai < argStrs.Length) {
                    targs[ai] = ImportedSymbolLoader._resolve(r, argStrs[ai], typeParams, tpCount);
                    ai = ai + 1;
                }
                return new Z42InstantiatedType(gdef, targs, argStrs.Length);
            }
        }
        // 根因修复（fix-crosspkg-fq-type-resolution）：跨命名空间、全限定书写的导入类型名
        // （如返回类型 `Std.Reflection.FieldInfo[]` 的元素 `Std.Reflection.FieldInfo`）——
        // Classes/Interfaces 以短名为键，FQ 名直接查会 miss、降级成 Z42PrimType 哨兵，导致消费包
        // 对反射对象类型（FieldInfo/PropertyInfo/MethodInfo，均在 Std.Reflection 跨命名空间）
        // 成员访问报 "member access on non-class"。FQ miss 后按短名回退，解析为真类型。
        string shortN = ImportedSymbolLoader._shortName(name);
        if (shortN != name) {
            int _sl3 = r.Classes.Find(shortN); if (_sl3 >= 0) { return r.Classes.ValAt(_sl3) as Z42ClassType; }
            int _sl4 = r.Interfaces.Find(shortN); if (_sl4 >= 0) { return r.Interfaces.ValAt(_sl4) as Z42InterfaceType; }
        }
        // GS6: 泛型型参（T/K/V 等）→ Z42GenericParamType，避免降级为 Z42PrimType
        int tp = 0;
        while (tp < tpCount) { if (typeParams[tp] == name) { return new Z42GenericParamType(name); } tp = tp + 1; }
        return Z42ClassType.Builtin(name);    // fallback（含泛型实例化串——既有 Unknown 吸收兼容）
    }

    // 无型参上下文（自由函数等）——委托四参版本。
    private static Z42Type _resolve(ImportedSymbols r, string name) {
        return ImportedSymbolLoader._resolve(r, name, new string[0], 0);
    }

    // PR6：把 ExportedParamZ 的 DefaultBlob / CallerKind 填进 Z42FuncType（跨包默认值/ caller 宏传播）。
    // pz 已是逻辑参数序（TsigReconcile._params 跳 this 槽）→ 与 sig.ParamTypes 对齐。
    private static void _fillParamDefaults(Z42FuncType sig, ExportedParamZ[] pz, int count) {
        string[] defs = new string[count];
        string[] cls = new string[count];
        int i = 0;
        while (i < count) { defs[i] = pz[i].DefaultBlob; cls[i] = pz[i].CallerKind; i = i + 1; }
        sig.ParamDefaults = defs; sig.ParamCallers = cls;
    }

    // 按顶层逗号切分泛型类型参数串（`string,List<int>` → ["string","List<int>"]），尊重嵌套 <>。
    private static string[] _splitTypeArgs(string s) {
        string[] parts = new string[2];
        int n = 0;
        int depth = 0;
        int start = 0;
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "<") { depth = depth + 1; }
            else if (ch == ">") { depth = depth - 1; }
            else if (ch == "," && depth == 0) {
                if (n == parts.Length) { string[] b = new string[parts.Length * 2]; int k = 0; while (k < n) { b[k] = parts[k]; k = k + 1; } parts = b; }
                parts[n] = s.Substring(start, i - start).Trim(); n = n + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        if (n == parts.Length) { string[] b = new string[parts.Length * 2]; int k = 0; while (k < n) { b[k] = parts[k]; k = k + 1; } parts = b; }
        parts[n] = s.Substring(start, s.Length - start).Trim(); n = n + 1;
        string[] res = new string[n];
        int j = 0; while (j < n) { res[j] = parts[j]; j = j + 1; }
        return res;
    }

    private static bool _isPrim(string n) {
        return n == "int" || n == "long" || n == "short" || n == "byte"
            || n == "uint" || n == "ulong" || n == "ushort" || n == "sbyte"
            || n == "float" || n == "double" || n == "bool" || n == "string" || n == "char"
            || n == "object" || n == "i8" || n == "i16" || n == "i32" || n == "i64"
            || n == "u8" || n == "u16" || n == "u32" || n == "u64" || n == "f32" || n == "f64" || n == "str";
    }

    private static bool _isPrelude(string pkg) { return pkg == "z42.core"; }

    // 包是否提供 usings 中任一 ns（按该包全部 TSIG 模块的 ns 判断）。
    private static bool _pkgProvidesUsing(ExportedModuleZ[] exported, string[] pkgNames, int count,
                                          string pkg, string[] usings, int usingCount) {
        int i = 0;
        while (i < count) {
            if (pkgNames[i] == pkg) {
                int u = 0;
                while (u < usingCount) {
                    if (exported[i].Namespace == usings[u]) { return true; }
                    u = u + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }
}
