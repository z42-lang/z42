// 类型检查 Pass 1（port-z42c-semantics 1A-4b）。CompilationUnit + SymbolTable → SemanticModel。
// 调度：集中式 if-is 链（D1，镜像 C# 集中 switch）。1A 范围：lit/ident/assign/free-call + decl/return/expr/block。
// 检查：var-decl 初值可赋 / return 类型可赋 / 标识符已定义 / 函数已声明。其余表达式·语句 → 1B+。
namespace Z42.Semantics;

using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;

public sealed class TypeChecker {
    public DiagnosticBag      _diags;
    public int                _loopDepth;    // break/continue 越界检查（1B）
    // lambda 捕获 frame（port-z42c-closures）：active 时 Ident 钩子检测外层命中。
    public bool _lambdaActive;
    public StrMap _lambdaLocals;
    public BoundCapture[] _lambdaCaps; public int _lambdaCapCount;
    public ConstraintChecker _constraints;  // 泛型 where 约束解析 + call-site 校验（2B）
    public string _currentNs;               // 当前 CU 命名空间（namespace-qualified free call 用）
    public OverloadBinder _overload;      // review P1-1：重载决议子绑定器（backref mediator）
    public MemberResolver _member;         // God-Class 拆分 step2：成员解析子绑定器
    public StmtBinder _stmt;               // God-Class 拆分 step3：语句绑定子绑定器
    public ExprTyper _expr;                // God-Class 拆分 step4：表达式类型检查子绑定器
    public DeclBinder _decl;               // God-Class 拆分 step5：声明绑定编排子绑定器
    public TypeChecker(DiagnosticBag diags) {
        this._diags = diags;
        this._loopDepth = 0;
        this._lambdaActive = false;
        this._constraints = new ConstraintChecker(diags);
        this._currentNs = "";
        this._overload = new OverloadBinder(this);
        this._member = new MemberResolver(this);
        this._stmt = new StmtBinder(this);
        this._expr = new ExprTyper(this);
        this._decl = new DeclBinder(this);
    }

    // add-primitive-value-boxing: 整数值 → object/接口 的隐式装箱插入点。仅**整数**需装箱
    // （int/long/short/byte 运行时同为 I64，装箱才能辨宽度做强类型 is/as/GetType）；
    // bool/char/double/string 已是独立运行时表示，无需装箱。返回原 expr 或包 BoundBox。
    // 各强转兼容处（var-decl / return / call-arg / assign / array-store）统一调用本方法保一致。
    public BoundExpr BoxIfNeeded(BoundExpr value, Z42Type target) {
        if (value == null || target == null) { return value; }
        Z42Type vt = value.Type();
        if (!(vt is Z42PrimType)) {
            // add-struct-object-boxing (PR2a)：值 struct 擦除到 object/接口 → 装箱（否则裸拷帧作用域
            // StructRef 句柄逃逸创建帧 → use-after-free）。是否真装箱（blob struct）由 codegen `_emitBox`
            // 按 `IsBlobStruct` 决定——非 blob（单字段等）struct 的 BoundBox 在 codegen 退化为透传，保持现模型。
            if (vt is Z42ClassType) {
                Z42ClassType sct = vt as Z42ClassType;
                if (sct.IsStruct) {
                    // add-struct-generic-boxing (P3a)：泛型 type-param 目标（K/V/T）也是擦除边界——struct
                    // 流入容器 type-param 且存堆时装箱（否则裸 StructRef 进容器堆数组 → GetHashCode VCall 崩 +
                    // 帧作用域句柄悬垂）。真装箱仍由 codegen `_emitBox` 按 IsBlobStruct 决定（非 blob 透传）。
                    bool erasesS = (target is Z42InterfaceType) || TypeChecker._isObjectName(target.Name())
                                   || (target is Z42GenericParamType);
                    if (erasesS) { return new BoundBox(value, sct.Name(), target, value.Span); }
                }
            }
            return value;
        }
        string fq = TypeChecker._intPrimFQ(vt.Name());
        if (fq == "") { return value; }                          // 非整数基元 → 不装箱
        bool erases = (target is Z42InterfaceType) || TypeChecker._isObjectName(target.Name());
        if (!erases) { return value; }
        return new BoundBox(value, fq, target, value.Span);
    }

    // add-struct-generic-boxing (P3a)：泛型方法/索引器返回 type-param（K/V/T），若按实例化 receiver 替换后
    // 是 **blob 值 struct** → 该返回值是**装箱后的 struct**（存入容器时装箱，见 BoxIfNeeded 的 type-param 分支）
    // → 调用方需**拆箱**回值 struct。返回目标 struct 类型（供调用点包 `BoundConvert` 触发 `_emitConvert` 的
    // AsCast 拆箱：内层 call 应以 Unknown 类型构造，使 target=blob struct ∧ src≠blob 命中拆箱臂）；否则返 null。
    public Z42Type StructUnboxTarget(Z42Type rawRet, Z42Type instRecvOrNull) {
        if (!(rawRet is Z42GenericParamType)) { return null; }
        if (!(instRecvOrNull is Z42InstantiatedType)) { return null; }
        Z42Type s = MemberResolver._substGeneric(rawRet, instRecvOrNull as Z42InstantiatedType);
        if ((s is Z42ClassType) && (s as Z42ClassType).IsStruct) { return s; }
        return null;
    }

    // add-primitive-value-boxing: 对已决议方法的实参逐位装箱（整数实参 → object/接口 形参）。
    // 就地改写 args（BoxIfNeeded 对非整数实参 / 非 object·接口形参是 no-op），返回同数组便于链式。
    // 仅覆盖声明形参位（i < ParamTypes.Length）；params 尾包的元素装箱另论（罕见，暂不处理）。
    public BoundExpr[] BoxArgs(BoundExpr[] args, int count, MethodSymbol ms) {
        if (args == null || ms == null || ms.Signature == null) { return args; }
        Z42Type[] pts = ms.Signature.ParamTypes;
        if (pts == null) { return args; }
        int i = 0;
        while (i < count && i < pts.Length && i < args.Length) {
            args[i] = this.BoxIfNeeded(args[i], pts[i]);
            i = i + 1;
        }
        return args;
    }
    private static string _intPrimFQ(string n) {
        if (n == "int"    || n == "i32") { return "Std.Int32"; }
        if (n == "long"   || n == "i64") { return "Std.Int64"; }
        if (n == "short"  || n == "i16") { return "Std.Int16"; }
        if (n == "sbyte"  || n == "i8")  { return "Std.SByte"; }
        if (n == "byte"   || n == "u8")  { return "Std.Byte"; }
        if (n == "ushort" || n == "u16") { return "Std.UInt16"; }
        if (n == "uint"   || n == "u32") { return "Std.UInt32"; }
        if (n == "ulong"  || n == "u64") { return "Std.UInt64"; }
        return "";
    }
    private static bool _isObjectName(string n) {
        return n == "object" || n == "Object" || n == "Std.Object";
    }

    public SemanticModel Infer(CompilationUnit cu, SymbolTable symbols) {
        var model = new SemanticModel(symbols);
        symbols.CurrentAliases = SymbolTable.BuildAliases(cu);   // add-type-alias：本 CU 文件级别名生效
        this._currentNs = cu.HasNamespace ? cu.Namespace : "";
        this._constraints.Resolve(cu, symbols);   // Pass 0.5：泛型 where 约束解析（2B，镜像 C# ResolveAllWhereConstraints）
        this._decl._checkDuplicateFreeFunctions(cu);     // 顶层 func 不重载（SymbolTable.Functions 名唯一键）
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind == "class" || c.Kind == "struct" || c.Kind == "record") { this._decl._bindClass(model, symbols, c); }
            } else if (d is MethodDecl) {
                MethodDecl m = d as MethodDecl;
                this._decl._bindFreeFunc(model, symbols, m);
            } else if (d is ImplDecl) {
                this._decl._bindImpl(model, symbols, d as ImplDecl);   // port-z42c-impl-block 2b
            }
            i = i + 1;
        }
        this._decl._synthCtors(model, symbols, cu);
        return model;
    }

    // 合成隐式 ctor 体（镜像 C# EmitImplicitCtor + CollectChainFieldInits）：
    // 类无显式实例 ctor 但本类或本地祖先有实例字段 init 时，发 `<ctKey>.<Name>` 体——
    // 沿基类链（root→self）的 `this.field = init` 赋值（无 base 调用，整链内联）。IrGen 据此发函数。


    // 运算符符号 → 重载方法名（与 Parser._operatorMethodName 一致；"" 表不可重载）。


    // add-type-based-overloads 根因修复：SymbolCollector 用 first-wins `ct.Methods.Put(regName, ...)` 注册方法——
    // 同 (name,arity) ≥2 的重载若 Canon 归一后撞出同一个 mangled RegKey（如 f(int) vs f(i32)，或
    // f(string) vs f(string?)），后者会静默覆盖前者，方法体无声丢失、零诊断。这里在绑体前对每个
    // (name,arity) 重载组重放同一遍 mangle，键碰撞即报错——把"静默丢方法"变成编译错误。
    // D7（2026-07-01）：泛化覆盖静态 + 实例方法（原仅静态）。协议豁免名单内的名字
    // （ToString/Equals/GetHashCode/GetType/get_Item/set_Item）不参与 mangle（SymbolCollector 同款
    // 判定），继续维持 first-wins 静默覆盖的现状（如 String.Equals(object)/Equals(string)），
    // 不在此处误报——用同一份 `SymbolCollector.IsProtocolExempt` 跳过，单一豁免名单来源。
    // 顶层（自由）函数**不重载**：它们以裸名注册进 `SymbolTable.Functions`（名唯一键——
    // 重载 mangling 仅类方法有）。同名多定义会静默覆盖，随后 `ExportedTypeExtractor._extractFunc`
    // 用 `GetFunc(name)` 取到错 arity 的符号 → `md.Params` / `sig.ParamTypes` 越界 null → 崩。
    // 这里在类型检查期显式报重复定义，把那个隐晦崩溃变成清晰诊断（同一 CU 内检测）。


    // 重复检测的 arity 预扫键：static/instance 分桶前缀，避免同名静态与实例方法（本就非法，见别处检测）
    // 在这里被误判为同一组重载。

    // impl-block 方法体绑定（port-z42c-impl-block 2b，镜像 _bindClass 的 MethodDecl 分支）：
    // 方法 this=target、target 字段入 scope；body 键 `<target>.<mkey>`（IrGen 2c 同键发函数）。

    public Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { AttributedDecl ad = d as AttributedDecl; return ad.Inner; }
        return d;
    }




    // 实例字段初始化器注入：把 `this.field = init`（声明序）绑定后前置到 ctor 体首。
    // env 已含 this + 字段（调用方 ctor 绑定时建立）。空则返回原体。


    // _bindForeach（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindFor（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindSwitchStmt（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindDoWhile（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindWhile（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindTryCatch（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindIfStmt（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindReturn（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindVarDecl（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindLocalFunction（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // _bindBlock（compiler-review P1：从 _bindStmt 抽出，逐语句 binder）。

    // ════ 语句（集中 if-is）═══════════════════════════════════════════════════

    // `var x` → 推断 init 类型；显式类型 → 解析 + 检查 init 可赋。

    // 字面量绑定（compiler-review P1：从 _bindExpr 抽出的 6 字面量分支）。

    // _bindAssign（compiler-review P1：从 _bindExpr 抽出）。

    // _bindIdent（compiler-review P1：从 _bindExpr 抽出）。

    // _bindLambdaArg（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindIndex（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindSwitchExpr（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindTernary（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindRefArg（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindArrayInit（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindArrayNew（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindCastExpr（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。
    // C 风格 (T)x（G3）→ BoundConvert（结果类型 = T）

    // _bindAsExpr（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindTypeofExpr（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindIsExpr（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // _bindNullCondMember（compiler-review P1：从 _bindExpr 抽出，逐节点 binder）。

    // ════ 表达式（集中 if-is）═════════════════════════════════════════════════

    // GS4：插值字符串绑定。每 text → BoundInterpText；每 hole → 递归 _bindExpr → BoundInterpHole。
    // 结果类型恒为 string（镜像 C# TypeChecker.Exprs case InterpolatedStrExpr）。

    // ════ 运算（集中 if-is + BinaryTypeTable，1B）═══════════════════════════════


    // 操作数约束检查（None / unknown / error → 跳过，防级联）。镜像 C# CheckBinaryOperand。
    public void _checkOperand(int kind, string req, Z42Type t, string op, Span sp) {
        if (kind == OperandKind.None) { return; }
        if ((t is Z42UnknownType) || (t is Z42ErrorType)) { return; }
        if (!TypeFacts.SatisfiesKind(kind, t)) {
            this._diags.Error(DiagnosticCodes.TypeMismatch,
                "operator `" + op + "` requires " + req + " operand, got `" + t.Name() + "`", sp);
        }
    }

    // 条件必须 bool（if/while）。error/unknown 吸收。镜像 C# RequireBool。
    public void _requireBool(Z42Type t, string context, Span sp) {
        if ((t is Z42ErrorType) || (t is Z42UnknownType)) { return; }
        if (!TypeFacts.IsBool(t)) {
            this._diags.Error(DiagnosticCodes.TypeMismatch,
                "`" + context + "` condition must be `bool`, got `" + t.Name() + "`", sp);
        }
    }

    // 浮点字面量类型：f/F 后缀 → float，否则 double（d/D/m/M 归 double）。

    // ════ 成员字段访问（1C）═══════════════════════════════════════════════════

    // _bindInstanceMemberCall（compiler-review P1 续：从 _bindMemberCall 抽接收者类型分派尾，纯搬移）。

    // _bindInstanceMember（compiler-review P1 续：从 _bindMember 抽接收者类型分派尾，纯搬移）。

    // _bindClassMemberAccess（compiler-review P1 续：从 _bindInstanceMember 抽 class 分支，纯搬移）。

    // 字段查找：本类 → base 链（迭代）。

    // 赋值兼容（含类继承 subclass→base）。error/unknown 任一侧吸收（防级联）。非 class 走 Z42Type.IsAssignableTo。



    // lambda 绑定（port-z42c-closures；expected 自声明类型）：参数类型 = 显式或 expected 对位；
    // 体在 frame 下绑定（捕获钩子激活；嵌套 lambda 延后——frame 不重入）。

    // prim 名 → stdlib 包装类 BCL 简名（镜像 C# WellKnownTypes/TypeRegistry：int→Int32 等，
    // 取代旧 CapitalizeFirst 启发式——`int→Int` 错，真名是 `Int32`；string→String 巧合相同）。

    // GS6: 判断是否为 prim 关键字（_bindMemberCall 静态路由用）。

    // GS6: 判断是否为数值 prim（_isAssignable 窄化用）。

    // prim 名 → 首字母大写（_primWrapper 的回退）。

    // 两分支公共类型（三目 / ??）：互为可赋取较宽，否则取左（C# 报错；1E 简化）。

    // default(T)（GS7 / D-8b-3 Phase 2）：泛型类型参数 → BoundDefault(paramIndex)；其他 → BoundDefault(-1)。

    // new T(args)（1D）：解析 T（须为已知类型）+ 绑定实参 + ctor 重载解析。

    // 命名实参重排 + 默认值填充（镜像 C# 调用绑定）：
    //   位置实参按序填；命名实参 `name: val`（AssignExpr，Target=ident）按形参名定位；
    //   未填形参用其 Default 表达式（无默认 → 绑定失败返回 null，回落旧 1:1 路径报常规错误）。
    // 返回长度 = md.ParamCount 的已绑定实参数组；不可适配（实参多于形参/缺默认/命名未匹配）→ null。
    // 默认参数填充（default_params）：实参数少于形参数且 callee 有 AST Decl（非 imported）→
    // 用 _adaptArgs 按默认值补齐。imported（无 Decl，默认表达式不在 TSIG，镜像 C#
    // ImportedSymbolLoader.Phase2）→ 缺省实参用 default(paramType) 填充（stdlib 默认值
    // 多为类型零值 false/0/null，故与声明默认一致，如 MulticastAction.Invoke 的
    // continueOnException=false）。否则原样返回已绑定实参。

    // add-params-varargs D1/D4：params 形参实参打包。normal form（恰 ParamsFrom+1 个实参，末位已是
    // 目标数组类型，_resolveParamsOverload 已核验）原样透传；否则 expanded form —— trailing 实参
    // （可能 0 个）打包成 BoundArrayLit 插入 ParamsFrom 槽（object[] 装箱在 codegen 是 no-op，见 design.md）。


    // ctor 方法键：重载存 Name$argCount，唯一 ctor 存 bare Name，无显式 ctor → bare Name。

    // 方法查找：本类 → base 链（迭代）。
    // 重载 arity 解析键（镜像 C# instArityKey / BindMemberCallOnPrimitive 的 primArityKey）：
    // 重载方法在 TSIG 以 `Name$arity` 存（如 String.Split→`Split$1`/`Split$2`），unique 方法存 bare。
    // 故 `Name$argCount` 键存在 → 该 overload，发 mangled 名；否则 bare。emit 名须用此键
    // （byte-identical：C# v_call 发 `Split$1` 非 `Split`）。对 unique 方法 arity 键不存在 → 退回 bare，
    // 6 个已 byte-identical 包不受影响（其调用皆 unique 方法）。


    // add-type-based-overloads + add-params-varargs：按实参类型解析重载调用，返回选中 MethodSymbol（含 RegKey）。
    // 行为保持：单 arity 候选 → 直选（不做类型 applicability，镜像旧 arity-only）；同 arity ≥2 → 类型决议。
    // D4：非 params 精确 arity 重载恒优先于任何 params 候选 —— byArity 只收 ParamsFrom<0 的候选，
    // 无该类匹配（na==0）时才落到 _resolveParamsOverload。
    // null = 无匹配（调用方走原 undefined/no-method 诊断）或歧义（已报 E0425）。

    // add-params-varargs D4：params 重载决议（仅当无非 params 精确 arity 匹配时调用）。
    // 优先级：normal form（恰 ParamsFrom+1 个实参、末位已是目标数组类型，直接透传不打包）>
    // expanded form 最具体 element type（非 object 胜 object；每层内部 >1 候选 → 歧义）。
    // 返回 null = 无 params 候选可用（调用方落回旧 bare 兜底或 undefined 诊断）。

    // 沿 base 链聚合所有源名为 name 的方法，按 RegKey 去重（most-derived 优先 → override 取派生，
    // 不同签名重载全留）。镜像 _findMethod 的 base/Object 行走。

}
