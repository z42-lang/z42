// attribute-handler-registry PR1a/PR1b — 编译期 handler 注册表（attribute 名 → kind 的唯一真相源）。
//
// PR1a（AST-phase）：把「解析后、类型检查前」的两个 AST 级 pass 收敛到单一入口 RunAst，并用
// **三路 kind 判定**（KindOf）替换散落在 AttributeSynth 的 `_isUserAttr` 名字白名单。
// PR1b（IR-phase）：把 IR 级两个子构建器（TestIndexBuilder / StubEmitter）的 attribute **名字识别**
// 也收敛进本注册表——它们的 emit **逻辑不变**，只是「哪个名字算 directive / 算 test handler」这项知识
// 从 `_isTestAttrName` / 散落的 `== "Native"` 字面量上移到这里（design §Implementation Notes：
// 「逻辑不变，识别改注册表」）。设计 SoT：docs/spec/changes/attribute-handler-registry/design.md。
//
// 三路 kind（design §消费模型）：
//   · store-meta —— 普通 `: Attribute` 类 → 反射 blob（IrAttrRef）。由 AttributeSynth 合成工厂。
//   · directive  —— 编译器原生封闭集（当前仅 `[Native]`）→ codegen 烘进 descriptor。StubEmitter 消费。
//   · handler    —— 编译期消费即弃 / 聚合成表（module-generator 形）。**内建**：test 家族驱动
//     TestIndexBuilder 扫全 CU 聚合 TIDX 表。对外 Generator/Analyzer 加载留 PR3/PR4。
//     （design 记 TestIndexBuilder 的**终态**是 store-meta + 反射发现、TIDX 退休——那是独立后续变更；
//      本 PR 标注的是**现状机制**：eager 聚合表 = handler 形。）
//
// PR1a/PR1b 是纯内部重构（byte-identical）。**PR2（后缀约定 D8）是破坏性、非 byte-identical**：
//   ① store-meta 应用名按后缀展开解析成类名（`[Route]` → `RouteAttribute`，见 StoreMetaClassName）；
//   ② test 家族全 8 名归 Handler（KindOf），消除 PR1a/1b 为保字节不动点保留的「5/3 差集」折衷——
//      Setup/Teardown/Ignore 不再走 store-meta 工厂（它们本就该是内建 handler、豁免后缀）。
//   现在 KindOf 的 Handler 集 == IsTestHandlerAttr 触发集（全 8 名），两集收敛。
namespace Z42.Semantics;

using Z42.Syntax;

// attribute 应用 `[X]` 的三路 kind。z42 无 enum → static class + int 常量（同 StructLayout）。
public static class AttrKind {
    public static int StoreMeta = 0;   // 普通 : Attribute 类 → 反射 blob
    public static int Directive = 1;   // 编译器原生封闭集（Native/…）→ 烘进 descriptor
    public static int Handler = 2;     // 编译期 handler（内建 test 聚合表；对外 Generator/Analyzer 留 PR3/4）
}

// 声明寻址：store-meta 工厂 / 将来 Generator 的 Replace/Augment 都按 DeclId 定位一个声明。
// PR1a 仅奠定概念——Key 即镜像 C# 的工厂 key 前缀（cls$C / mth$C$M / fld$C$F / fn$F / …$prm$j）。
public sealed class DeclId {
    public string Key;
    public DeclId(string key) { this.Key = key; }
}

public static class HandlerRegistry {
    // ── AST-phase 单一入口（挂载点：IncrementalDriver / IrDump ×3）──────────────────────────
    // 内建 Generator（BenchmarkDesugar）先跑，再走 store-meta 合成（AttributeSynth）——与收敛前
    // `AttributeSynth.Run(BenchmarkDesugar.Run(cu))` 语义逐字节一致。
    public static CompilationUnit RunAst(CompilationUnit cu) {
        // add-record-attribute：RecordExpand 最内层——先把 class/struct 的位置参数展开成 public(record)/
        // private(primary ctor) 字段 + 主构造器（并置 IsRecord），再让 BenchmarkDesugar / AttributeSynth
        // 看到完整成员集。
        return AttributeSynth.Run(BenchmarkDesugar.Run(RecordExpand.Run(cu)));
    }

    // ── 三路 kind 判定（替换 AttributeSynth._isUserAttr）────────────────────────────────────
    // PR2（后缀约定 D8）：test 家族**全 8 名**归 Handler（含 Setup/Teardown/Ignore）——消除 PR1a/PR1b
    // 为保字节不动点而刻意保留的「5 名 Handler / 3 名 store-meta」差集折衷（那个差集会让 [Setup] 走
    // store-meta 工厂 → 合成 `new Setup()`；D8 后 [Setup] 会按后缀展开成 `SetupAttribute` 更荒谬）。
    // 现在 KindOf 的 Handler 子集 == IsTestHandlerAttr 的触发集（全 8 名），两者收敛为同一集合。
    // 三路：Native=directive（豁免后缀）、test 全家族=handler（豁免后缀，编译器内建）、其余=store-meta
    // （按 D8 后缀展开解析成 `<name>Attribute` 类）。**本 PR 非 byte-identical**：Setup/Teardown/Ignore
    // 不再合成工厂 = 少几个死工厂；test_demo / 用到这些名字的 golden 会重生（预期）。
    public static int KindOf(string name) {
        if (HandlerRegistry.IsDirectiveAttr(name)) { return AttrKind.Directive; }
        if (HandlerRegistry.IsTestHandlerAttr(name)) { return AttrKind.Handler; }
        return AttrKind.StoreMeta;
    }

    // ── D8 后缀约定：store-meta 应用名 → 类名 ────────────────────────────────────────────────
    // `[Route]`（用名，剥后缀）解析到类 `RouteAttribute`（定义名，带后缀）。store-meta 分流的两处消费
    // ——AttributeSynth._synthFactory 的 `new <cls>(args)` 与 ClassDescBuilder 的 IrAttrRef 类型名——
    // 都经此 helper 拿到带后缀的真实类名，后缀逻辑单点收敛在注册表（design D8）。directive / handler
    // 不经此路径（豁免后缀、无 store-meta 工厂）。
    public static string AttributeSuffix = "Attribute";
    public static string StoreMetaClassName(string appliedName) {
        return appliedName + HandlerRegistry.AttributeSuffix;
    }

    // ── directive 家族（IR-phase：StubEmitter 消费）─────────────────────────────────────────
    // 编译器原生封闭集。`[Native]`（native/builtin 绑定 → 死体桩，烘进 descriptor）+ `[Suppress]`
    // （PR3c：analyzer 诊断局部关闭，**纯编译期消费、不烘 descriptor / 不写 blob**——归 directive 仅为让
    // KindOf≠StoreMeta，避免 AttributeSynth 合成反射工厂 + 免建 backing 类，同 Native 靠名字识别）。
    // Layout/Repr/Inline/Deprecated 由后续 PR 加入本集（design §Built-in directive）。
    public static bool IsDirectiveAttr(string name) {
        return HandlerRegistry.IsNativeDirective(name)
            || HandlerRegistry.IsSuppressDirective(name)
            || HandlerRegistry.IsDeprecatedDirective(name)
            || HandlerRegistry.IsRecordDirective(name);
    }

    // PR3c：`[Suppress("Id","reason")]` directive 识别（AnalyzerDriver 读，不持久化）。保留名，用户不可
    // 再定义同名 store-meta 类（同 Native）。
    public static bool IsSuppressDirective(string name) {
        return name == "Suppress";
    }

    // PR5：`[Deprecated]` / `[Deprecated("msg")]` directive 识别（D2）。归 directive 使 KindOf≠StoreMeta
    // （不合成反射工厂 / 免建 backing 类，同 Native/Suppress 靠名字识别）。**但持久化**——IrGen 把
    // deprecated 位 + 消息串烘进 method/class/field descriptor（异于 Suppress 的纯编译期消费）。
    public static bool IsDeprecatedDirective(string name) {
        return name == "Deprecated";
    }

    // PR5：`[Deprecated]` 持久化哨兵常量在 z42.ir（叶子库）= `IrDeprecation.Sentinel`（供生产 z42c.semantics
    // + 消费 z42.ir/TsigReconcile 共用；z42.ir 不能反依赖 z42c.semantics）。此处不再重复定义。

    // PR5：某声明是否带 `[Deprecated]`（IrGen 烘 deprecated 位用）。
    public static bool HasDeprecated(Decl rawMem) {
        if (!(rawMem is AttributedDecl)) { return false; }
        AttributedDecl ad = rawMem as AttributedDecl;
        int a = 0;
        while (a < ad.AttrCount) {
            if (HandlerRegistry.IsDeprecatedDirective(ad.Attrs[a].Name)) { return true; }
            a = a + 1;
        }
        return false;
    }

    // PR5：`[Deprecated("msg")]` 的 positional 消息串（无消息 / 无该 attr → ""）。同 _nativeIntrinsic 读法。
    public static string DeprecatedMsg(Decl rawMem) {
        if (!(rawMem is AttributedDecl)) { return ""; }
        AttributedDecl ad = rawMem as AttributedDecl;
        int a = 0;
        while (a < ad.AttrCount) {
            Attr at = ad.Attrs[a];
            if (HandlerRegistry.IsDeprecatedDirective(at.Name) && at.ArgCount >= 1 && (at.Args[0] is StringLitExpr)) {
                return Lexer.DecodeString((at.Args[0] as StringLitExpr).Raw);
            }
            a = a + 1;
        }
        return "";
    }

    // add-record-attribute：`[Record]` directive 识别（保留名，豁免 D8 后缀 + 无 backing 类，同 Suppress/
    // Native/Deprecated 靠名字识别）。RecordExpand（AST 期）消费它——把位置参数展开成 public 字段 + 主构造器
    // 并置 ClassDecl.IsRecord（→ ClassDescBuilder 打 zbc flags bit3）。不合成反射工厂 / 不写 store-meta blob。
    public static bool IsRecordDirective(string name) {
        return name == "Record";
    }

    // add-record-attribute：某声明是否带 `[Record]`（RecordExpand 读，决定 public 字段 + bit3 vs private 字段）。
    public static bool HasRecord(Decl rawMem) {
        if (!(rawMem is AttributedDecl)) { return false; }
        AttributedDecl ad = rawMem as AttributedDecl;
        int a = 0;
        while (a < ad.AttrCount) {
            if (HandlerRegistry.IsRecordDirective(ad.Attrs[a].Name)) { return true; }
            a = a + 1;
        }
        return false;
    }

    // StubEmitter 专用：`[Native(...)]` 绑定 directive 识别（取代散落的 `at.Name == "Native"` 字面量）。
    public static bool IsNativeDirective(string name) {
        return name == "Native";
    }

    // ── 内建 test handler 触发家族（IR-phase：TestIndexBuilder 消费）────────────────────────
    // module-generator 形：扫全 CompilationUnit、按这些 attr 聚合成 TIDX 表。全 8 名——含
    // Setup/Teardown/Ignore（取代 TestIndexBuilder._isTestAttrName）。注意这是**触发集**，与
    // KindOf 的 Handler 子集（非-store-meta 那 5 名）不同，差集 = 字节不动点陷阱（见文件头注）。
    public static bool IsTestHandlerAttr(string name) {
        if (name == "Test" || name == "Benchmark" || name == "Setup" || name == "Teardown") { return true; }
        if (name == "Ignore" || name == "Skip" || name == "ShouldThrow" || name == "Timeout") { return true; }
        return false;
    }
}
