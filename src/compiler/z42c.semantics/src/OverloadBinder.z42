// 重载决议子绑定器 OverloadBinder（compiler-review P1-1：拆 TypeChecker God-Class 第 1 步）。
// 持 TypeChecker 反向引用（_tc）作 mediator：跨界触达 _tc._bindExpr（ExprTyper 域）、
// _tc._isAssignable（转换助手）、_tc._diags（共享诊断）。同组方法互调仍 this._X。
// z42 无 partial class → 抽独立类拆文件（镜像 EmitContext/FunctionEmitter 模式）。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;

public sealed class OverloadBinder {
    private TypeChecker _tc;

    // fix-overload-ref-conversion：`_resolveOverload` 判定为**歧义**时已经报过 E0425，
    // 调用方（MemberResolver 的四个 E0401 发射点）不该再补一条「找不到方法」——
    // 同一处报两个码会让用户以为是两个问题。改动前歧义路径几乎不可达（适用性判据
    // 不认类层次 ⇒ 适用集恒空 ⇒ 直接 NoMatch），所以这个重复诊断一直没暴露。
    internal bool LastAmbiguous;
    public OverloadBinder(TypeChecker tc) { this._tc = tc; }

    // add-target-typed-new：回填延迟绑定的 target-typed new 实参（`_bindCall` 留 null 占位）。
    // 按选中签名 sig 的形参类型定型；params 尾位用元素类型；sig=null 或越界位 → 目标 null → 报 E0437。
    // 检测靠 args[i]==null（延迟位），rawArgs 提供原始 AST。已绑定位（非 null）跳过，幂等。
    public BoundExpr[] BindArgsToSignature(BoundExpr[] args, Expr[] rawArgs, int argCount, Z42FuncType sig, TypeEnv env) {
        int i = 0;
        while (i < argCount) {
            if (args[i] == null) {
                Z42Type pt = null;
                if (sig != null) {
                    if (sig.ParamsFrom >= 0 && i >= sig.ParamsFrom) {
                        Z42ArrayType at = sig.ParamTypes[sig.ParamsFrom] as Z42ArrayType;
                        if (at != null) { pt = at.Elem; }
                    } else if (i < sig.ParamCount) { pt = sig.ParamTypes[i]; }
                }
                args[i] = this._tc._expr.BindWithTarget(rawArgs[i], pt, env);
            }
            i = i + 1;
        }
        this.CheckArgTypes(args, rawArgs, argCount, sig, env);
        return args;
    }

    // add-argument-type-check：实参 → 形参的**隐式可转**检查，与赋值 / return / var-decl 同一条门
    // （`Conversion.Classify(...).ImplicitOk()`，经 `TypeChecker.CheckImplicitConvert`）。
    //
    // 为什么挂在这里：本方法是全部调用形态（free / local-fn / static / instance / interface /
    // instantiated / prim-wrapper / indirect）绑定实参的**通用汇聚点**，且恰好在构造 BoundCall 之前、
    // 默认值填充与 params 打包**之前**——即实参仍是「原始位置形状」的时刻，正是该检查的位置。
    // `sig == null` 的调用点（错误路径 / 懒加载 stub 接收者 loose-bind / Error·Unknown 接收者）
    // 签名确实不可知，故 `sig != null` 恰好等价于「签名已知、可检查」，无需逐站点接线也不会漏。
    //
    // 不短路：同一调用里多个实参不符逐条报（诊断对用户更有用）。
    internal void CheckArgTypes(BoundExpr[] args, Expr[] rawArgs, int argCount, Z42FuncType sig, TypeEnv env) {
        if (sig == null) { return; }
        int fixedEnd = argCount;                              // 定长段上界
        if (sig.ParamCount < fixedEnd) { fixedEnd = sig.ParamCount; }
        if (sig.ParamsFrom >= 0 && sig.ParamsFrom < fixedEnd) { fixedEnd = sig.ParamsFrom; }
        int i = 0;
        while (i < fixedEnd) {
            this._checkOneArg(args, rawArgs, i, sig.ParamTypes[i], env);
            RefArgCheck.CheckSymmetry(this._tc, args, i, sig);
            i = i + 1;
        }
        // params 尾位：展开形态逐位按**元素**类型检查；规范形态（直接传数组）由下方 IsAssignableTo 放行。
        if (sig.ParamsFrom >= 0) {
            int pf = sig.ParamsFrom;
            Z42ArrayType at = sig.ParamTypes[pf] as Z42ArrayType;
            if (at != null) {
                bool normalForm = (argCount == sig.ParamCount) && args[pf] != null
                                  && args[pf].Type() != null && args[pf].Type().IsAssignableTo(at);
                if (!normalForm) {
                    int t = pf;
                    while (t < argCount) { this._checkOneArg(args, rawArgs, t, at.Elem, env); t = t + 1; }
                }
            }
        }
    }

    // add-generic-type-arg-inference：**代换后补检查**——只查那些「原签名里含泛型形参、因而被
    // `Conversion` 分支 B 擦除放行」的形参位，用代换后的具体类型重查一遍。
    //
    // 🔴 为什么必须按位门控，不能直接对代换后的整条签名再调一次 `CheckArgTypes`：
    // 形参类型是**具体类型**的位（`void PutAt(T v, int i)` 里的 `int`）在 `_withDefaults` 内部
    // 那次 `CheckArgTypes` 里**已经查过并报过**了，再查一遍就是同一 span、同一消息报两条。
    // 实测过（阶段 A 初版）：`b.PutAt("ok", "bad")` 报 2 条一模一样的 E0402。
    // 用 `_hasGenericParam(orig)` 作门 ⇒ 「补的正好是原先漏的那些位」，零重复由构造保证。
    //
    // orig 与 subst 必须是同一条签名的代换前/后（ParamCount / ParamsFrom 一致）。
    internal void CheckSubstitutedArgs(BoundExpr[] args, Expr[] rawArgs, int argCount,
                                       Z42FuncType orig, Z42FuncType subst, TypeEnv env) {
        if (orig == null || subst == null) { return; }
        int fixedEnd = argCount;
        if (subst.ParamCount < fixedEnd) { fixedEnd = subst.ParamCount; }
        if (subst.ParamsFrom >= 0 && subst.ParamsFrom < fixedEnd) { fixedEnd = subst.ParamsFrom; }
        int i = 0;
        while (i < fixedEnd) {
            if (Conversion._hasGenericParam(orig.ParamTypes[i])) {
                this._checkOneArg(args, rawArgs, i, subst.ParamTypes[i], env);
            }
            i = i + 1;
        }
        // params 尾位：同款门控（原元素类型含型参才补查），其余镜像 CheckArgTypes。
        if (subst.ParamsFrom >= 0) {
            int pf = subst.ParamsFrom;
            if (pf < orig.ParamCount && Conversion._hasGenericParam(orig.ParamTypes[pf])) {
                Z42ArrayType at = subst.ParamTypes[pf] as Z42ArrayType;
                if (at != null) {
                    bool normalForm = (argCount == subst.ParamCount) && args[pf] != null
                                      && args[pf].Type() != null && args[pf].Type().IsAssignableTo(at);
                    if (!normalForm) {
                        int t = pf;
                        while (t < argCount) { this._checkOneArg(args, rawArgs, t, at.Elem, env); t = t + 1; }
                    }
                }
            }
        }
    }

    // 单个实参的检查入口（供不经本汇聚点的路径复用：ctor 位置实参、`_adaptArgs` 的命名实参/可选参）。
    internal void CheckArg(BoundExpr a, Z42Type pt, Span sp, TypeEnv env) {
        if (a == null || pt == null) { return; }
        // make-enum-distinct-type：`_isEnumSide` 跳过已摘除（理由见 `_checkOneArg`）。
        // 这条路（ctor 位置实参 / 命名实参 / 可选参）**不经**上面的汇聚点，当年的跳过是两处各写
        // 一遍的——摘的时候必须同样两处都摘；只摘汇聚点那处，enum 形参在 ctor 与命名实参位就仍然
        // 不检查（"看着修好了、其实半边还瞎"）。
        this._tc.CheckImplicitConvert(a, pt, env.Symbols, sp, "argument");
    }

    private void _checkOneArg(BoundExpr[] args, Expr[] rawArgs, int i, Z42Type pt, TypeEnv env) {
        if (args[i] == null || pt == null) { return; }
        // make-enum-distinct-type（2026-09-08）：**`_isEnumSide` 跳过已摘除**。
        // add-argument-type-check 当时在这里留了个有意的洞——enum-as-int 模型下 `E.Member` 是
        // `BoundLitInt(long)`、enum 类型名却是孤立 `Z42ClassType`，转换格里无边相连，于是
        // `Alloc(target, GCHandleType.Weak)` 会被误判成 `long → GCHandleType` 不可转。那是模型
        // 自身的不自洽（欠债表 bug D），不是用户少写 cast，所以当时选择不发声而非逼用户补 cast。
        // 现在 enum 已是独立类型（`E.Member` 的静态类型就是 `E`），该实参**天然匹配**，洞的前提
        // 消失 ⇒ 跳过必须摘掉，否则 enum 形参位永远不检查 = 又一道从不发声的假保障。
        // span 指到**实参本身**（而非调用点），定位更准。
        Span sp = args[i].Span;
        if (rawArgs != null && i < rawArgs.Length && rawArgs[i] != null) { sp = rawArgs[i].Span; }
        this._tc.CheckImplicitConvert(args[i], pt, env.Symbols, sp, "argument");
    }

    // check-constraint-iface-method-args：型参收者（`where T : IEq` 的 `T`）调约束接口方法时，`Self`
    // 形参位经 `MemberResolver._substSelfSig` 精确换成型参 `rt` ⇒ 仍是裸型参 ⇒ `Conversion` 分支 B 擦除
    // 「具体实参 → 裸型参形参」（`a.Same("nope")` 静默放行、运行期从具体类型读出不存在字段）。这里补
    // 方向敏感的严格检查：门控 `_containsSelf`（来自 Self 的位，比替换面多下钻 Func，守「禁止侧比替换侧宽」），
    // 命中位的实参**完全不含型参且非 error/unknown**（即具体类型）→ E0463。实参也含型参（`T`-to-`T` 走
    // Identity、`U`-to-`T` 已报 E0402）或 error/unknown（absorb 不级联）→ 保持今天行为。只产诊断、不碰
    // 绑定发射（零字节漂移）。与 E0454（接口收者、逆变禁止）的分工见 design D2。由 MemberResolver 的
    // 型参收者路径调用（`BindArgsToSignature` 之后）。
    internal void CheckConstraintIfaceArgs(BoundExpr[] args, Expr[] rawArgs, int argCount, Z42FuncType orig,
                                           string tpName, string memName, string ifaceName) {
        if (orig == null) { return; }
        int fixedEnd = argCount;
        if (orig.ParamCount < fixedEnd) { fixedEnd = orig.ParamCount; }
        if (orig.ParamsFrom >= 0 && orig.ParamsFrom < fixedEnd) { fixedEnd = orig.ParamsFrom; }
        int i = 0;
        while (i < fixedEnd) {
            if (MemberResolver._containsSelf(orig.ParamTypes[i])) {
                this._checkOpaqueParamArg(args, rawArgs, i, tpName, memName, ifaceName);
            }
            i = i + 1;
        }
        // params 尾位（防御性；stdlib 零命中 `params Self[]`）：原元素类型含 Self 才补查展开位。
        if (orig.ParamsFrom >= 0) {
            int pf = orig.ParamsFrom;
            Z42ArrayType at = orig.ParamTypes[pf] as Z42ArrayType;
            if (at != null && MemberResolver._containsSelf(at.Elem)) {
                int t = pf;
                while (t < argCount) { this._checkOpaqueParamArg(args, rawArgs, t, tpName, memName, ifaceName); t = t + 1; }
            }
        }
    }

    // 单个 Self 形参位的严格判据：实参是**具体类型**（非型参、非 error/unknown）⇒ 不可赋给不透明型参 ⇒ E0463。
    // 不走 CheckImplicitConvert（那会再过 Conversion 被分支 B 擦）；直接按「含不含型参」判并发码。
    private void _checkOpaqueParamArg(BoundExpr[] args, Expr[] rawArgs, int i, string tpName, string memName, string ifaceName) {
        if (i >= args.Length || args[i] == null) { return; }
        Z42Type at = args[i].Type();
        if (at == null || (at is Z42ErrorType) || (at is Z42UnknownType)) { return; }
        if (Conversion._hasGenericParam(at)) { return; }   // `T`-to-`T` / 含型参：今天已正确处理
        Span sp = args[i].Span;
        if (rawArgs != null && i < rawArgs.Length && rawArgs[i] != null) { sp = rawArgs[i].Span; }
        // 语义层用字面量 "E0463" 发码（同 E0449–E0462，避 core→semantics 冷启动 stale-cache）。
        this._tc._diags.Error("E0463",
            "cannot pass `" + at.Name() + "` to a parameter of type parameter `" + tpName + "`: method `"
            + memName + "` comes from constraint `where " + tpName + " : " + ifaceName
            + "` — an opaque type parameter accepts only values of that same type parameter", sp);
    }

    // generic-inference-lambda-args：从非-lambda 实参 + lambda 标注推断部分方法级型参，只代换 Func
    // 形参位得到「绑定用」签名。仅对**有本地 Decl 的泛型方法**生效（导入/间接方法拿不到有序型参名，
    // 与既有 arity/where 校验同一道门，不新增跨包能力）。InferPreBinding 对无信息位天然跳过、
    // SubstituteFuncParams 对无绑定/无 Func 位 no-op ⇒ 非泛型/普通调用零开销、零改动。
    private MethodSymbol _inferFuncParamSubst(MethodSymbol ms, BoundExpr[] args, Expr[] rawArgs, int rawArgCount, TypeEnv env) {
        if (ms == null || !ms.HasDecl || ms.Decl == null || ms.Signature == null) { return ms; }
        if (ms.Decl.TypeParams.Count == 0) { return ms; }
        Z42Type[] part = TypeArgInference.InferPreBinding(ms.Signature,
            ms.Decl.TypeParams.Names, ms.Decl.TypeParams.Count, args, rawArgs, rawArgCount, env);
        return MethodTypeArgSubst.SubstituteFuncParams(ms, ms.Decl.TypeParams.Names, ms.Decl.TypeParams.Count, part);
    }

    // add-call-arity-diagnostics：`staticForm` = 调用点是**静态形式**（`Class.m(...)` / `int.m(...)` / `A.B.Class.m(...)`）。
    // 静态形式选中**实例**方法 = 「接收者作首参」写法（`Int32.ToString(n)`），实参数必须恰为形参数 + 1。
    internal BoundExpr[] _withDefaults(MethodSymbol ms, BoundExpr[] args, Expr[] rawArgs, int rawArgCount, TypeEnv env, Span sp, bool staticForm) {
        // add-call-arity-diagnostics：实参个数校验。此前这里对「个数不符」**全程不报**——少传且缺位无默认值时
        // 原样返回不足的实参（同包）或补零值（跨包，连运行期签名判定都拦不住），多传则直接发码。
        // `arityReported` 保证一次调用最多一条（下面三处判定互斥地各报各的形态）。
        bool recvFirst = staticForm && !ms.IsStatic && ms.Signature != null && ms.Signature.ParamsFrom < 0;
        bool arityReported = false;
        if (recvFirst && rawArgCount != ms.Signature.ParamCount + 1) {
            this._reportArity(ms, true, rawArgCount, ms.Signature.ParamCount + 1, "", sp);
            arityReported = true;
        }
        // complete-named-arguments：**命名实参必须在任何绑定步骤之前处理**。
        //
        // 🔴 为什么是「之前」：下面第一步 `BindArgsToSignature` 会把 `_bindCall` 延迟下来的
        // `null` 槽**按位置**重新绑（`BindWithTarget(rawArgs[i], ParamTypes[i])`）——命名实参
        // 的槽位这时还没确定，按位置绑等于把 `y = 2` 当普通表达式绑，`y` 立刻 `undefined`。
        // `_adaptArgs` 自己按形参名把 raw 实参绑到正确的槽（含目标类型、类型检查、可选参填充），
        // 所以命名调用整条路交给它，不要先经过位置绑定。
        //
        // 此前命名实参只有**构造函数**真能用：`_bindNew` 直接把 raw args 交给 `_adaptArgs`，
        // 而方法/静态/自由调用都要先过这里。
        if (CallParams.CanName(ms) && this._hasNamedArg(rawArgs, rawArgCount, env)) {
            BoundExpr[] named = this._adaptArgs(ms, rawArgs, rawArgCount, env, sp);
            if (named != null) { return named; }
            // 适配不了（名字对不上 / 重复 / 实参多于形参）→ 落回原路，由既有诊断报。
        }
        // generic-inference-lambda-args：绑定 lambda 延迟位**之前**，从非-lambda 实参 + lambda 标注推断
        // 部分方法级型参、**只代换 Func 形参位** ⇒ 无标注/有标注 lambda 都拿到具体形参类型能编、能跑。
        // 非-Func 形参位不动 ⇒ 非-lambda 实参绑定/装箱/params/默认值逐字节不变（design I1'/D1）。
        // 显式 `<>` 路径 ms.Signature 已由 ForExplicitTypeArgs 全代换成具体 ⇒ 此处 InferPreBinding
        // 推不出型参、SubstituteFuncParams no-op，天然不重复。
        ms = this._inferFuncParamSubst(ms, args, rawArgs, rawArgCount, env);
        // add-target-typed-new：先回填延迟的 target-typed new 实参（按 ms 形参类型），再走装箱/默认值。
        // 必须在 BoxArgs 之前——BoxArgs 遍历 args 会对 null 位崩。
        args = this.BindArgsToSignature(args, rawArgs, rawArgCount, ms.Signature, env);
        // add-primitive-value-boxing: 实参整数 → object/接口 形参 装箱（本方法是 5 处调用点的
        // 公共汇聚步——就地按 ms 形参类型逐位装箱；BoxArgs 对非整数/非 object·接口位 no-op）。
        // params 尾包（object[]/T[] 元素）不在此覆盖：ParamTypes[pf] 是数组类型 → BoxIfNeeded no-op（罕见）。
        args = this._tc.BoxArgs(args, rawArgCount, ms, env.Symbols);
        // add-params-varargs：选中的方法带 params 形参 → 走独立的打包路径（既非默认参数填充，
        // 也不复用 _adaptArgs 的命名实参匹配；_resolveOverload/_resolveParamsOverload 已选定 ms）。
        if (ms.Signature != null && ms.Signature.ParamsFrom >= 0) {
            return this._withParamsExpansion(ms, args, rawArgCount, sp, env.Symbols);
        }
        if (ms.HasDecl && ms.Decl != null && rawArgCount < ms.Decl.ParamCount) {
            BoundExpr[] ad = this._adaptArgs(ms, rawArgs, rawArgCount, env, sp);
            if (ad != null) { return ad; }
            // 补不齐：缺位里有无默认值的形参 → E1005。算不出缺谁（命名实参名字对不上 / 重复）→ 交既有诊断。
            string miss = recvFirst ? "" : this._firstMissingRequired(ms.Decl, rawArgs, rawArgCount, env);
            if (!arityReported && miss != "") {
                this._reportArity(ms, false, rawArgCount, ms.Decl.ParamCount, "`" + miss + "`", sp);
                arityReported = true;
            }
        }
        if ((!ms.HasDecl || ms.Decl == null) && ms.Signature != null
            && rawArgCount < ms.Signature.ParamCount) {
            int pc = ms.Signature.ParamCount;
            int missAt = this._crossPkgMissingRequired(ms.Signature, rawArgCount);
            if (!arityReported && !recvFirst && missAt >= 0) {
                this._reportArity(ms, false, rawArgCount, pc, "#" + (missAt + 1).ToString(), sp);
                arityReported = true;
            }
            BoundExpr[] filled = new BoundExpr[pc];
            int i = 0;
            while (i < rawArgCount) { filled[i] = args[i]; i = i + 1; }
            while (i < pc) {
                filled[i] = this._crossPkgDefault(ms.Signature, i, env, sp);
                i = i + 1;
            }
            return filled;
        }
        if (!arityReported && !recvFirst && ms.Signature != null && ms.Signature.ParamsFrom < 0
            && args.Length > ms.Signature.ParamCount) {
            this._reportArity(ms, false, args.Length, ms.Signature.ParamCount, "", sp);
        }
        return args;
    }

    // add-call-arity-diagnostics：普通调用实参个数不符的**唯一**发码点（消息形状对齐构造器 E0426）。
    // `missing` 非空 = 少传且缺位无默认值（形参名 `name` = 同包 / `#k` = 跨包序号——导入签名不带形参名）。
    internal void _reportArity(MethodSymbol ms, bool recvFirst, int got, int expected, string missing, Span sp) {
        string who = ms.ContainingTypeName != null && ms.ContainingTypeName != "" ? ms.ContainingTypeName + "." + ms.Name : ms.Name;
        OverloadBinder.ReportArity(this._tc._diags, "`" + who + "`", recvFirst, got, expected, missing, sp);
    }

    internal static void ReportArity(DiagnosticBag diags, string who, bool recvFirst, int got, int expected, string missing, Span sp) {
        string tail = "; got " + got.ToString() + " argument(s)";
        if (recvFirst) {
            diags.Error(got > expected ? "E1006" : "E1005", "instance method " + who + " called in static form takes the receiver as its first argument: expects "
                + expected.ToString() + " argument(s)" + tail, sp);
        } else if (missing != "") {
            diags.Error("E1005", who + " is missing required argument " + missing + " (no default value)" + tail, sp);
        } else if (got > expected) {
            diags.Error("E1006", "too many arguments to " + who + ": expects " + expected.ToString() + tail, sp);
        } else {
            diags.Error("E1005", "too few arguments to " + who + ": expects " + expected.ToString() + tail, sp);
        }
    }

    // 同包：按「前 N 个位置实参 + 命名实参按名」标记已给的形参，返回第一个**既没给、也无默认值**的形参名；
    // 命名实参对不上任何形参时返回 ""（那是另一种错误，交既有诊断，不冒充「缺实参」）。
    private string _firstMissingRequired(MethodDecl md, Expr[] rawArgs, int rawArgCount, TypeEnv env) {
        int pc = md.ParamCount;
        bool[] given = new bool[pc];
        int pos = 0;
        int i = 0;
        while (i < rawArgCount) {
            if (rawArgs != null && i < rawArgs.Length && ExprTyper.IsNamedArg(rawArgs[i], env)) {
                string nm = ((rawArgs[i] as AssignExpr).Target as IdentExpr).Name;
                int idx = 0 - 1;
                int p = 0;
                while (p < pc) { if (md.Params[p].Name == nm) { idx = p; } p = p + 1; }
                if (idx < 0) { return ""; }
                given[idx] = true;
            } else if (pos < pc) {
                given[pos] = true;
                pos = pos + 1;
            }
            i = i + 1;
        }
        int k = 0;
        while (k < pc) {
            if (!given[k] && md.Params[k].Default == null) { return md.Params[k].Name; }
            k = k + 1;
        }
        return "";
    }

    // 跨包：从第 `from` 位起第一个既无 caller 宏、也无 `$Default` 的形参序号；全有 → -1。
    // 判据与 `_crossPkgDefault` 取默认值的两个来源逐字对应（它在这种位上只能补零值）。
    internal int _crossPkgMissingRequired(Z42FuncType sig, int from) {
        int i = from;
        while (i < sig.ParamCount) {
            bool caller = sig.ParamCallers != null && i < sig.ParamCallers.Length && sig.ParamCallers[i] != null && sig.ParamCallers[i] != "";
            bool dflt = sig.ParamDefaults != null && i < sig.ParamDefaults.Length && sig.ParamDefaults[i] != null && sig.ParamDefaults[i] != "";
            if (!caller && !dflt) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    // 局部函数：签名不携带默认值（`StmtBinder` 注册时只有形参类型），故按精确个数校验。
    internal void _checkLocalFnArity(string name, Z42FuncType sig, int got, Span sp) {
        if (sig == null || sig.ParamsFrom >= 0 || got == sig.ParamCount) { return; }
        OverloadBinder.ReportArity(this._tc._diags, "local function `" + name + "`", false, got, sig.ParamCount, "", sp);
    }

    // PR6：跨包省略实参的默认值物化——从导入签名的 `$Default` ConstBlob 解码 → AST → 重绑（复用
    // BindWithTarget 的类型强转 / array / new），替代旧的 `BoundDefault(T,-1)` **零值**（修跨包塌零 bug）。
    // 无 ConstBlob（真无默认值）→ 回落零值占位（不崩）；该形态已由调用方经 `_crossPkgMissingRequired` 报 E1005（add-call-arity-diagnostics）。
    internal BoundExpr _crossPkgDefault(Z42FuncType sig, int i, TypeEnv env, Span sp) {
        // PR6b：caller 宏跨包注入（ParamCallers[i] = "member"/"line"/"file"/"module"，由
        // ImportedSymbolLoader 从 `$Caller:*` 哨兵填）→ 注入调用点上下文字面量（先于 $Default 判定）。
        if (sig.ParamCallers != null && i < sig.ParamCallers.Length && sig.ParamCallers[i] != null && sig.ParamCallers[i] != "") {
            return this._callerLiteral(sig.ParamCallers[i], sig.ParamTypes[i], sp);
        }
        if (sig.ParamDefaults != null && i < sig.ParamDefaults.Length && sig.ParamDefaults[i] != null && sig.ParamDefaults[i] != "") {
            ConstBlobReader rdr = new ConstBlobReader(sig.ParamDefaults[i], sp);
            Expr e = rdr.Read();
            if (e != null) { return this._tc._expr.BindWithTarget(e, sig.ParamTypes[i], env); }
        }
        return new BoundDefault(sig.ParamTypes[i], 0 - 1, sp);
    }

    // PR6b：caller 宏默认值 → 调用点上下文字面量。kind ∈ {member,line,file,module}。
    // member = enclosing 成员名（_curMemberName）；line/file = 调用表达式 Span 的行号/文件；
    // module = 调用点命名空间（_currentNs）。字符串走三引号 raw 形式（Lexer.DecodeString 逐字保留，
    // 免转义处理，值内不含 `"""`——成员名/命名空间/文件路径皆安全）。类型取形参声明类型（定义侧
    // 已校验 member/file/module=string、line=int，故直接吻合、无需再转换）。
    internal BoundExpr _callerLiteral(string kind, Z42Type pty, Span sp) {
        if (kind == "line") {
            return new BoundLitInt(sp.Line.ToString(), pty, sp);
        }
        string val = "";
        if (kind == "member") { val = this._tc._curMemberName; }
        else if (kind == "file") { val = sp.File; }
        else if (kind == "module") { val = this._tc._currentNs; }
        return new BoundLitStr("\"\"\"" + val + "\"\"\"", pty, sp);
    }

    internal BoundExpr[] _withParamsExpansion(MethodSymbol ms, BoundExpr[] args, int rawArgCount, Span sp, SymbolTable syms) {
        Z42FuncType sig = ms.Signature;
        int pf = sig.ParamsFrom;
        Z42ArrayType at = sig.ParamTypes[pf] as Z42ArrayType;
        Z42Type elem = at.Elem;
        if (rawArgCount == sig.ParamCount && args[pf].Type().IsAssignableTo(at)) {
            return args;
        }
        int packCount = rawArgCount - pf;
        BoundExpr[] packed = new BoundExpr[packCount];
        int i = 0;
        // add-primitive-value-boxing: params 尾包元素按元素类型装箱（`params object[]` 收整数
        // 实参 → 逐个装箱成精确宽度）。BoxArgs 在 _withDefaults 入口按 ParamTypes[pf]=数组类型
        // 判定 → 对尾位 no-op，故此处补按 elem（元素类型）装箱，镜像 _bindArrayInit。
        while (i < packCount) { packed[i] = this._tc.BoxIfNeeded(args[pf + i], elem); packed[i] = this._tc.ConvertIfNeeded(packed[i], elem, syms); i = i + 1; }   // tighten-implicit-conversions；add-user-conversions
        BoundExpr arrLit = new BoundArrayLit(packed, packCount, PrimModel.SurfaceName(elem.Name()), new Z42ArrayType(elem), sp);
        BoundExpr[] finalArgs = new BoundExpr[sig.ParamCount];
        int k = 0;
        while (k < pf) { finalArgs[k] = args[k]; k = k + 1; }
        finalArgs[pf] = arrLit;
        return finalArgs;
    }

    // fix-overload-defaults-named-args：有没有「形参比实参多、多出的都带默认值」的非 params 候选（廉价预判，免得每次都建实参形态）。
    private bool _anyNeedsDefaults(MethodSymbol[] all, int argCount) {
        int i = 0;
        while (i < all.Length) {
            Z42FuncType sig = all[i].Signature;
            if (sig != null && sig.ParamsFrom < 0 && sig.ParamCount > argCount) { return true; }
            i = i + 1;
        }
        return false;
    }

    // fix-overload-defaults-named-args：映射决议 + 歧义诊断（无匹配时返回 null，由调用方报「找不到」）。
    internal MethodSymbol _resolveMappedOrReport(MethodSymbol[] cands, ArgShape shape, string name, Span sp,
                                                 SymbolTable symbols) {
        OverloadResult r = OverloadResolver.ResolveMapped(cands, cands.Length, shape, symbols);
        if (r.IsResolved()) { return r.Method; }
        if (r.IsAmbiguous()) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded `" + name + "`; add an explicit cast to disambiguate", sp);
        }
        return null;
    }

    // fix-overload-defaults-named-args：由调用点的实参建出决议用的实参形态。
    //   · 命名实参（`ExprTyper.IsNamedArg`）→ 名字 + 值的类型；位置实参按出现顺序
    //   · 已绑定的位置实参取其类型；延迟实参（target-typed `new()` / lambda，`args` 里为 null）按通配（null）
    //   · `args == null`（构造器路径尚未绑定）时就地绑定非延迟的 raw 实参取类型
    internal ArgShape _argShape(BoundExpr[] args, Expr[] rawArgs, int argCount, TypeEnv env) {
        int named = 0;
        int i = 0;
        while (i < argCount) {
            if (rawArgs != null && i < rawArgs.Length && ExprTyper.IsNamedArg(rawArgs[i], env)) { named = named + 1; }
            i = i + 1;
        }
        ArgShape a = new ArgShape(argCount - named, named);
        int pos = 0;
        int nm = 0;
        i = 0;
        while (i < argCount) {
            Expr raw = (rawArgs != null && i < rawArgs.Length) ? rawArgs[i] : null;
            if (raw != null && ExprTyper.IsNamedArg(raw, env)) {
                AssignExpr ae = raw as AssignExpr;
                a.Names[nm] = (ae.Target as IdentExpr).Name;
                a.NamedTypes[nm] = this._typeOfArgExpr(ae.Value, env);
                nm = nm + 1;
            } else {
                Z42Type t = null;
                if (args != null && i < args.Length && args[i] != null) { t = args[i].Type(); }
                else if (raw != null) { t = this._typeOfArgExpr(raw, env); }
                a.PosTypes[pos] = t;
                pos = pos + 1;
            }
            i = i + 1;
        }
        return a;
    }

    private Z42Type _typeOfArgExpr(Expr e, TypeEnv env) {
        if (ExprTyper.IsTargetTypedNew(e) || ExprTyper.IsLambdaArg(e)) { return null; }
        BoundExpr b = this._tc._expr._bindExpr(e, env);
        if (b == null) { return null; }
        Z42Type t = b.Type();
        if ((t is Z42ErrorType) || (t is Z42UnknownType)) { return null; }
        return t;
    }

    // complete-named-arguments：raw 实参里有没有命名实参（判据与 `_bindCall` 的延迟判据同一份）。
    internal bool _hasNamedArg(Expr[] rawArgs, int rawArgCount, TypeEnv env) {
        if (rawArgs == null) { return false; }
        int i = 0;
        while (i < rawArgCount) {
            if (i < rawArgs.Length && ExprTyper.IsNamedArg(rawArgs[i], env)) { return true; }
            i = i + 1;
        }
        return false;
    }

    // fix-crosspkg-named-args：`ms` 可以是本地方法（按 MethodDecl 归位、补默认值表达式）或导入方法（按签名上的
    // ParamNames 归位、缺位走 `_crossPkgDefault`）。形参名 → 序号统一经 `CallParams`，与重载决议同一份判据。
    // 导入方法没有形参名 → 不可适配（null，交既有路径）。
    internal BoundExpr[] _adaptArgs(MethodSymbol ms, Expr[] callArgs, int callArgCount, TypeEnv env, Span sp) {
        if (!CallParams.CanName(ms)) { return null; }
        MethodDecl md = CallParams.DeclOf(ms);
        int pc = CallParams.Count(ms);
        if (callArgCount > pc) { return null; }
        BoundExpr[] slots = new BoundExpr[pc];
        bool[] filled = new bool[pc];
        int pos = 0;
        int i = 0;
        while (i < callArgCount) {
            Expr a = callArgs[i];
            // restore-named-arguments 🔴 **既有 bug 修复**：此前这里把**任何**
            // `AssignExpr(Ident, …)` 都当命名实参，不看那个标识符是不是作用域内的变量。
            // 于是一个货真价实的赋值实参 `f(who = "Bob")`（who 是局部变量）被误判成
            // 「名为 who 的命名实参」→ 没有这个形参 → 整个 `_adaptArgs` 返回 null →
            // **默认参数填充被跳过**，可选形参静默留 null（实测：`Greet(who = "Bob")`
            // 打印 `null, Bob` 而非 `Hello, Bob`；种子编译器同样如此，非本 change 引入）。
            // 判据统一到 `ExprTyper.IsNamedArg`（与 `_bindCall` 的延迟判据同一份）。
            if (ExprTyper.IsNamedArg(a, env)) {
                AssignExpr ae = a as AssignExpr;
                string nm = (ae.Target as IdentExpr).Name;
                int idx = CallParams.IndexOf(ms, nm);
                if (idx < 0) { return null; }                 // 命名实参无匹配形参 → 不可适配
                if (filled[idx]) { return null; }
                // add-target-typed-new：命名实参按对应形参类型绑定（支持 `f(x: new())`）。
                Z42Type npt = this._adaptParamType(ms, md, idx, env);
                slots[idx] = this._tc._expr.BindWithTarget(ae.Value, npt, env); filled[idx] = true;
                // add-argument-type-check：命名实参路径不经 `_checkArgTypes` 汇聚点（本方法直接产
                // 形参序 slots），须就地检查——否则 `f(x: wrongType)` 与 ctor 的命名实参成为漏网。
                this.CheckArg(slots[idx], npt, ae.Value.Span, env);
            } else {
                if (pos >= pc) { return null; }
                // add-target-typed-new：位置实参按对应形参类型绑定（支持 `f(new())`）。
                Z42Type ppt = this._adaptParamType(ms, md, pos, env);
                slots[pos] = this._tc._expr.BindWithTarget(a, ppt, env); filled[pos] = true;
                // 🔴 `params` 尾参、**等 arity**、且实参本身不是数组 → 它是**一个元素**，
                // 该按**元素类型**校验（打包由调用方做）。
                //
                // 此前一律拿形参声明类型（`object[]`）比 ⇒ `new P(new R())` 对
                // `P(params object[] xs)` 在这里就报「cannot assign R to Object[]」。
                // 实参多于形参那一侧不会走到这儿（上面 `callArgCount > pc` 已 return null，
                // 由调用方的 params 展开处理），所以坏的恰好只有「恰好一个实参」这一种形态。
                Z42Type chk = ppt;
                if (this._isParamsSlot(ms, md, pos) && (ppt is Z42ArrayType)
                    && slots[pos] != null && slots[pos].Type() != null
                    && !slots[pos].Type().IsAssignableTo(ppt)) {
                    chk = (ppt as Z42ArrayType).Elem;
                }
                this.CheckArg(slots[pos], chk, a.Span, env);
                pos = pos + 1;
            }
            i = i + 1;
        }
        int k = 0;
        while (k < pc) {
            if (!filled[k] && this._isParamsSlot(ms, md, k) && (this._adaptParamType(ms, md, k, env) is Z42ArrayType)) {
                // fix-crosspkg-named-args：`params` 尾参没被给（`P(head: "h")`）= 空尾包，与位置调用
                // `_withParamsExpansion` 打的包同形。此前这里当「缺实参且无默认」返回 null ⇒ 命名实参调用 params 方法一律失败。
                Z42Type pelem = (this._adaptParamType(ms, md, k, env) as Z42ArrayType).Elem;
                slots[k] = new BoundArrayLit(new BoundExpr[0], 0, PrimModel.SurfaceName(pelem.Name()), new Z42ArrayType(pelem), sp);
            } else if (!filled[k] && md == null) {
                // 导入：缺位必须有 `$Default` / caller 宏，取值与位置调用的跨包补位同一条（_crossPkgDefault）。
                if (this._crossPkgMissingRequired(ms.Signature, k) == k) { return null; }
                slots[k] = this._crossPkgDefault(ms.Signature, k, env, sp);
            } else if (!filled[k]) {
                Expr dflt = md.Params[k].Default;
                if (dflt == null) { return null; }   // 缺实参且无默认 → 不可适配
                if (MacroRegistry.IsMacro(dflt)) {
                    // PR6b：同包 caller 宏注入（跨包对称走 _crossPkgDefault）。截在 _bindExpr 前——
                    // 否则 IdentExpr("$macro:*") 会落到 ExprTyper._bindIdent 报 E0450（误用检测）。
                    slots[k] = this._callerLiteral(MacroRegistry.KindOf(MacroRegistry.NameOf(dflt)), env.ResolveType(md.Params[k].Type), sp);
                } else {
                    slots[k] = this._tc._expr._bindExpr(dflt, env);
                }
            }
            k = k + 1;
        }
        return slots;
    }

    private bool _isParamsSlot(MethodSymbol ms, MethodDecl md, int i) {
        if (md != null) { return md.Params[i].IsParams; }
        return ms.Signature.ParamsFrom == i;
    }

    // `_adaptArgs` 的形参类型：本地按声明的类型表达式在调用环境解析（沿用既有口径），导入取签名上的已解析类型。
    private Z42Type _adaptParamType(MethodSymbol ms, MethodDecl md, int i, TypeEnv env) {
        if (md != null) { return env.ResolveType(md.Params[i].Type); }
        return ms.Signature.ParamTypes[i];
    }

    internal string _ctorKey(Z42ClassType ct, int argCount) {
        string name = ct.Name();
        string ak = name + "$" + argCount.ToString();
        // fix-ctor-init-silent-bugs：静态 ctor 恒全签名 mangle ⇒ 无参静态 ctor 正好注册在 `Name$0`，
        // 只看键在不在会把它当成实例 ctor 选中。
        int akSlot = ct.Methods.Find(ak);
        if (akSlot >= 0) {
            MethodSymbol akSym = ct.Methods.ValAt(akSlot) as MethodSymbol;
            if (akSym == null || !akSym.IsStatic) { return ak; }
        }
        // stabilize-instance-dispatch-keys：ctor 也走 primary/非-primary 键——非-primary ctor 现注册为全签名键
        // （如 `Box$2$int$int`），不再是老的 `Box$argCount`。上面 `Box$argCount` 查不到 → 按 argCount 在本类 ctor
        // 里找到匹配者返其 RegKey（primary 裸 / 非-primary 全键），否则回落裸名（单 ctor）。否则 `new Box(3,4)` 会
        // emit 裸 `Box` → 运行期 ObjNew 命中 primary(arity-1) ctor → 错 ctor（ctor_overload 回归）。
        MethodSymbol[] ctors = ct.InstanceCtors();
        int i = 0;
        while (i < ctors.Length) {
            if (ctors[i].Signature != null && ctors[i].Signature.ParamCount == argCount) { return ctors[i].RegKey; }
            i = i + 1;
        }
        return name;
    }

    internal string _overloadKey(SymbolTable symbols, Z42ClassType ct, string name, int argCount) {
        string ak = name + "$" + argCount.ToString();
        if (this._findMethod(symbols, ct, ak) != null) { return ak; }
        return name;
    }

    internal MethodSymbol _findMethod(SymbolTable symbols, Z42ClassType ct, string name) {
        Z42ClassType cur = ct;
        bool more = true;
        while (more) {
            int _sl0 = cur.Methods.Find(name); if (_sl0 >= 0) { return cur.Methods.ValAt(_sl0) as MethodSymbol; }
            if (!cur.HasBase) {
                // 无显式 base 的 class 隐式继承 Object（mirror C# object root；struct 无 Object 方法）。
                if (cur.Name() != "Object" && symbols.HasClass("Object")) { cur = symbols.GetClass("Object"); }
                else { more = false; }
            } else {
                Z42ClassType b = symbols.GetClass(cur.BaseName);
                if (b == null) { more = false; } else { cur = b; }
            }
        }
        return null;
    }

    internal MethodSymbol _resolveOverload(SymbolTable symbols, Z42ClassType ct, string name,
                                          BoundExpr[] args, int argCount, int typeArgCount, Span sp,
                                          Expr[] rawArgs, TypeEnv env) {
        this.LastAmbiguous = false;       // 每次决议独立，别让上一次的歧义把这次的「找不到」吞掉
        MethodSymbol[] all = this._collectOverloads(symbols, ct, name);
        if (all.Length == 0) { return null; }
        // fix-overload-defaults-named-args：命名实参 + 多个重载 ⇒ 按「实参映射」决议。此前命名实参在 `_bindCall` 里
        // 是延迟占位（null），被下面当成 target-typed `new` 的延迟位 ⇒ 报 E0437「需要显式类型」、再报 undefined。
        // fix-crosspkg-named-args：**单个 params 候选**同样要走映射——下面的 arity 过滤只收非 params 候选，
        // 命名实参的延迟占位（null）又会被当成 target-typed `new`，于是 `P(head: "h")` 对唯一的
        // `P(string head, params int[] xs)` 报 E0437 + undefined。`Map` 本就处理 params 的两种形态。
        bool anyParamsCand = all.Length == 1 && all[0].Signature != null && all[0].Signature.ParamsFrom >= 0;
        if ((all.Length > 1 || anyParamsCand) && rawArgs != null && env != null && this._hasNamedArg(rawArgs, argCount, env)) {
            return this._resolveMappedOrReport(all, this._argShape(args, rawArgs, argCount, env), name, sp,
                                               env == null ? null : env.Symbols);
        }
        // add-target-typed-new：延迟绑定的 target-typed new 实参（null 位）无类型 → 无法参与基于类型的重载决议。
        // arity 唯一时（下方 na==1）不需类型可直接选中；否则报 E0437 让用户写显式类名。
        bool anyDeferred = false;
        { int d = 0; while (d < argCount) { if (args[d] == null) { anyDeferred = true; } d = d + 1; } }
        // 按 arity 过滤（仅非 params 候选）
        MethodSymbol[] byArity = new MethodSymbol[all.Length];
        int na = 0;
        int i = 0;
        while (i < all.Length) {
            if (all[i].Signature.ParamsFrom < 0 && all[i].Signature.ParamCount == argCount) {
                byArity[na] = all[i]; na = na + 1;
            }
            i = i + 1;
        }
        if (na == 0) {
            // deferred 位无类型 → 跳过基于类型的 params 决议（否则 null.Type() 崩）。
            MethodSymbol viaParams = null;
            if (!anyDeferred) {
                viaParams = this._resolveParamsOverload(all, args, argCount, sp, symbols);
            }
            // fix-overload-defaults-named-args：没有形参个数恰好相等的非 params 候选时，还有「少给实参、靠默认值
            // 才适用」的候选。此前它们从不进候选集 ⇒ 要么「找不到方法」，要么静默选中能接住的 params 重载
            // （`Q(string a, int n = 2)` + `Q(params object[] xs)` 的 `Q("a")` 选了后者）。与 params 结果一起按 C# 规则比较。
            if (all.Length > 1 && env != null && this._anyNeedsDefaults(all, argCount)) {
                MethodSymbol[] pool = new MethodSymbol[all.Length];
                int pn = 0;
                int pi = 0;
                while (pi < all.Length) {
                    MethodSymbol cm = all[pi];
                    if ((cm.Signature.ParamsFrom < 0 && cm.Signature.ParamCount > argCount) || cm == viaParams) { pool[pn] = cm; pn = pn + 1; }
                    pi = pi + 1;
                }
                OverloadResult mr = OverloadResolver.ResolveMapped(pool, pn, this._argShape(args, rawArgs, argCount, env),
                                                                   env == null ? null : env.Symbols);
                if (mr.IsResolved()) { return mr.Method; }
                if (mr.IsAmbiguous()) {
                    this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                        "ambiguous call to overloaded `" + name + "`; add an explicit cast to disambiguate", sp);
                    return null;
                }
            }
            if (viaParams != null) { return viaParams; }
            // 无 arity 匹配但全类只有一个同名非 params 方法 → 返回它（镜像旧 _overloadKey 的 bare 兜底：
            // 忽略 arity，如 `Int32.ToString(cp)` 静态形式调用实例 arity-0 ToString，接收者作首参）。
            if (all.Length == 1 && all[0].Signature.ParamsFrom < 0) { return all[0]; }
            if (anyDeferred) {
                this._tc._diags.Error(DiagnosticCodes.TargetTypedNewNeedsType,
                    "target-typed `new` argument to overloaded `" + name + "` needs an explicit type", sp);
            }
            return null;
        }
        // add-array-paired-sort：泛型 arity 过滤（C# 规则）——调用带 N 个显式类型实参（`Sort<int>` → N=1）时，
        // 只有恰好声明 N 个类型形参的候选合格（`Sort<T>` 合格、`Sort<TKey,TValue>` 不合格）。**防御性**：仅当
        // 过滤后仍非空才采用——候选 TypeParamCount 未知/为 0（如某些跨包路径未回填）时不误删全部候选，保证不回归
        // 既有可用的泛型调用（无此过滤前的行为）。
        if (typeArgCount > 0 && na > 1) {
            MethodSymbol[] byTp = new MethodSymbol[na];
            int nt = 0;
            int ti = 0;
            while (ti < na) {
                if (byArity[ti].TypeParamCount == typeArgCount) { byTp[nt] = byArity[ti]; nt = nt + 1; }
                ti = ti + 1;
            }
            if (nt > 0) { byArity = byTp; na = nt; }
        }
        if (na == 1) { return byArity[0]; }   // 单 arity 候选 → 行为保持（deferred 位稍后按形参类型回填）
        // 同 arity ≥2 → type-based 决议；deferred 位无类型无法决议 → 报 E0437 让用户写显式类名。
        if (anyDeferred) {
            this._tc._diags.Error(DiagnosticCodes.TargetTypedNewNeedsType,
                "target-typed `new` argument to overloaded `" + name + "` needs an explicit type", sp);
            return null;
        }
        Z42Type[] argTypes = new Z42Type[argCount];
        int k = 0;
        while (k < argCount) { argTypes[k] = args[k].Type(); k = k + 1; }
        OverloadResult res = OverloadResolver.Resolve(byArity, na, argTypes, argCount, symbols);
        if (res.IsResolved()) { return res.Method; }
        if (res.IsAmbiguous()) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded `" + name + "`; add an explicit cast to disambiguate", sp);
            this.LastAmbiguous = true;
        }
        return null;
    }

    // add-prim-instance-type-overload（方案1）：统计 (name, argCount) 在 ct（含基链）上的同 arity
    // 非-params 重载候选数。prim 消费端（MemberResolver prim-wrapper 分支）用它判「是否同 arity 多重载」：
    // ≥2 时 bare/arity 快键会 first-wins 选错（尤跨包 imported 的 bare 别名），须走完整 _resolveOverload
    // 得正确 mangle RegKey；<2 时走原 arity-only 快路径（字节中性）。复用 _collectOverloads（RegKey 去重、
    // 走基链）+ _resolveOverload 同款 byArity 过滤（ParamsFrom<0 且 ParamCount==argCount），确保视图一致。
    internal int _sameArityOverloadCount(SymbolTable symbols, Z42ClassType ct, string name, int argCount) {
        MethodSymbol[] all = this._collectOverloads(symbols, ct, name);
        int cnt = 0;
        int i = 0;
        while (i < all.Length) {
            if (all[i].Signature.ParamsFrom < 0 && all[i].Signature.ParamCount == argCount) { cnt = cnt + 1; }
            i = i + 1;
        }
        return cnt;
    }

    private MethodSymbol _resolveParamsOverload(MethodSymbol[] all, BoundExpr[] args, int argCount, Span sp, SymbolTable symbols) {
        MethodSymbol[] cand = new MethodSymbol[all.Length];
        int nc = 0;
        int i = 0;
        while (i < all.Length) {
            Z42FuncType sig = all[i].Signature;
            if (sig.ParamsFrom >= 0 && argCount >= sig.ParamsFrom) { cand[nc] = all[i]; nc = nc + 1; }
            i = i + 1;
        }
        if (nc == 0) { return null; }
        // normal form
        MethodSymbol[] normalCand = new MethodSymbol[nc];
        int nn = 0;
        i = 0;
        while (i < nc) {
            Z42FuncType sig = cand[i].Signature;
            if (argCount == sig.ParamCount && args[sig.ParamsFrom].Type().IsAssignableTo(sig.ParamTypes[sig.ParamsFrom])) {
                normalCand[nn] = cand[i]; nn = nn + 1;
            }
            i = i + 1;
        }
        if (nn == 1) { return normalCand[0]; }
        if (nn > 1) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded params method; add an explicit cast to disambiguate", sp);
            return null;
        }
        // expanded form：非 object element type 胜 object（更具体优先）
        MethodSymbol[] specific = new MethodSymbol[nc];
        int ns = 0;
        MethodSymbol[] objectTier = new MethodSymbol[nc];
        int no = 0;
        i = 0;
        while (i < nc) {
            Z42FuncType sig = cand[i].Signature;
            Z42ArrayType at = sig.ParamTypes[sig.ParamsFrom] as Z42ArrayType;
            if (at != null) {
                bool ok = true;
                int t = sig.ParamsFrom;
                while (t < argCount) {
                    if (!TypeFactsTc._isAssignable(args[t].Type(), at.Elem, symbols)) { ok = false; }
                    t = t + 1;
                }
                if (ok) {
                    // unify-value-types Phase 1：params object[] 泛化层判别（翻转后 object→Z42ClassType(Object)，Canon 归一）。
                    if (at.Elem.CanonName() == "object") { objectTier[no] = cand[i]; no = no + 1; }
                    else { specific[ns] = cand[i]; ns = ns + 1; }
                }
            }
            i = i + 1;
        }
        if (ns == 1) { return specific[0]; }
        if (ns > 1) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded params method; add an explicit cast to disambiguate", sp);
            return null;
        }
        if (no == 1) { return objectTier[0]; }
        if (no > 1) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded params method; add an explicit cast to disambiguate", sp);
            return null;
        }
        return null;
    }

    private MethodSymbol[] _collectOverloads(SymbolTable symbols, Z42ClassType ct, string name) {
        // 去重键 = **有效签名**（简单名 + 形参规范类型），非 RegKey。这样一个派生类型自己声明的
        // 方法会**隐藏**基类中同签名的方法（C# method hiding：more-derived wins）——因基链自派生向基
        // 遍历，首见者（最派生）胜。fix-generic-struct-erasure-boxing：imported record struct 的合成
        // `Equals$1(object)`（RegKey `Equals$1`）与继承的 `Object.Equals(object)`（RegKey `Equals`）RegKey
        // 不同但签名相同——旧的 RegKey 去重会二者并存 → 同签名两候选 → 重载决议歧义 → 解析失败 → `.Equals`
        // 松绑不装箱 → 运行期 `other` 裸 StructRef → is_instance 失败 → 值相等误返 false（且伪 E0425）。
        // 按签名去重后派生合成 Equals$1 隐藏 Object.Equals → 唯一候选 → 正确装箱决议。type-based 重载
        // （不同形参类型）签名各异、不受影响；override（同 RegKey、同签名）结果不变。
        StrMap seen = new StrMap();
        MethodSymbol[] acc = new MethodSymbol[8];
        int n = 0;
        Z42ClassType cur = ct;
        bool more = true;
        while (more) {
            MethodSymbol[] here = cur.OverloadsOf(name);
            int i = 0;
            while (i < here.Length) {
                string sigKey = OverloadBinder._overloadSigKey(here[i]);
                if (!seen.ContainsKey(sigKey)) {
                    seen.Put(sigKey, "1");
                    if (n == acc.Length) {
                        MethodSymbol[] b = new MethodSymbol[acc.Length * 2];
                        int q = 0; while (q < n) { b[q] = acc[q]; q = q + 1; }
                        acc = b;
                    }
                    acc[n] = here[i]; n = n + 1;
                }
                i = i + 1;
            }
            if (!cur.HasBase) {
                if (cur.Name() != "Object" && symbols.HasClass("Object")) { cur = symbols.GetClass("Object"); }
                else { more = false; }
            } else {
                Z42ClassType b = symbols.GetClass(cur.BaseName);
                if (b == null) { more = false; } else { cur = b; }
            }
        }
        MethodSymbol[] r = new MethodSymbol[n];
        int z = 0; while (z < n) { r[z] = acc[z]; z = z + 1; }
        return r;
    }

    // fix-generic-struct-erasure-boxing：方法的**有效签名键**（简单名 + 形参规范类型，规范化别名）。
    // 供 `_collectOverloads` 按签名跨基链去重（派生隐藏基类同签名方法）。params 尾位以 `...` 标记纳入键，
    // 使 `f(int)` 与 `f(params int[])` 键相异、互不隐藏。
    private static string _overloadSigKey(MethodSymbol ms) {
        string k = ms.Name + "#";
        Z42FuncType s = ms.Signature;
        if (s == null || s.ParamTypes == null) { return k; }
        int i = 0;
        while (i < s.ParamTypes.Length) {
            if (s.ParamsFrom >= 0 && i == s.ParamsFrom) { k = k + "..."; }
            k = k + (s.ParamTypes[i] == null ? "?" : s.ParamTypes[i].CanonName()) + ",";
            i = i + 1;
        }
        return k;
    }

}