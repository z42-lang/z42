// 重载决议子绑定器 OverloadBinder（compiler-review P1-1：拆 TypeChecker God-Class 第 1 步）。
// 持 TypeChecker 反向引用（_tc）作 mediator：跨界触达 _tc._bindExpr（ExprTyper 域）、
// _tc._isAssignable（转换助手）、_tc._diags（共享诊断）。同组方法互调仍 this._X。
// z42 无 partial class → 抽独立类拆文件（镜像 EmitContext/FunctionEmitter 模式）。
namespace Z42.Semantics;
using Z42.IR;

using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;

public sealed class OverloadBinder {
    private TypeChecker _tc;
    public OverloadBinder(TypeChecker tc) { this._tc = tc; }

    // add-target-typed-new：回填延迟绑定的 target-typed new 实参（`_bindCall` 留 null 占位）。
    // 按选中签名 sig 的形参类型定型；params 尾位用元素类型；sig=null 或越界位 → 目标 null → 报 E0437。
    // 检测靠 args[i]==null（延迟位），rawArgs 提供原始 AST。已绑定位（非 null）跳过，幂等。
    public BoundExpr[] FillDeferredArgs(BoundExpr[] args, Expr[] rawArgs, int argCount, Z42FuncType sig, TypeEnv env) {
        int i = 0;
        while (i < argCount) {
            if (args[i] == null) {
                Z42Type pt = null;
                if (sig != null) {
                    if (sig.ParamsFrom >= 0 && i >= sig.ParamsFrom) {
                        Z42ArrayType at = sig.ParamTypes[sig.ParamsFrom] as Z42ArrayType;
                        if (at != null) { pt = at.Elem; }
                    } else if (i < sig.ParamCount) { pt = sig.ParamTypes[i]; }
                }
                args[i] = this._tc._expr.BindWithTarget(rawArgs[i], pt, env);
            }
            i = i + 1;
        }
        return args;
    }

    internal BoundExpr[] _withDefaults(MethodSymbol ms, BoundExpr[] args, Expr[] rawArgs, int rawArgCount, TypeEnv env, Span sp) {
        // add-target-typed-new：先回填延迟的 target-typed new 实参（按 ms 形参类型），再走装箱/默认值。
        // 必须在 BoxArgs 之前——BoxArgs 遍历 args 会对 null 位崩。
        args = this.FillDeferredArgs(args, rawArgs, rawArgCount, ms.Signature, env);
        // add-primitive-value-boxing: 实参整数 → object/接口 形参 装箱（本方法是 5 处调用点的
        // 公共汇聚步——就地按 ms 形参类型逐位装箱；BoxArgs 对非整数/非 object·接口位 no-op）。
        // params 尾包（object[]/T[] 元素）不在此覆盖：ParamTypes[pf] 是数组类型 → BoxIfNeeded no-op（罕见）。
        args = this._tc.BoxArgs(args, rawArgCount, ms, env.Symbols);
        // add-params-varargs：选中的方法带 params 形参 → 走独立的打包路径（既非默认参数填充，
        // 也不复用 _adaptArgs 的命名实参匹配；_resolveOverload/_resolveParamsOverload 已选定 ms）。
        if (ms.Signature != null && ms.Signature.ParamsFrom >= 0) {
            return this._withParamsExpansion(ms, args, rawArgCount, sp, env.Symbols);
        }
        if (ms.HasDecl && ms.Decl != null && rawArgCount < ms.Decl.ParamCount) {
            BoundExpr[] ad = this._adaptArgs(ms.Decl, rawArgs, rawArgCount, env, sp);
            if (ad != null) { return ad; }
        }
        if ((!ms.HasDecl || ms.Decl == null) && ms.Signature != null
            && rawArgCount < ms.Signature.ParamCount) {
            int pc = ms.Signature.ParamCount;
            BoundExpr[] filled = new BoundExpr[pc];
            int i = 0;
            while (i < rawArgCount) { filled[i] = args[i]; i = i + 1; }
            while (i < pc) {
                filled[i] = this._crossPkgDefault(ms.Signature, i, env, sp);
                i = i + 1;
            }
            return filled;
        }
        return args;
    }

    // PR6：跨包省略实参的默认值物化——从导入签名的 `$Default` ConstBlob 解码 → AST → 重绑（复用
    // BindWithTarget 的类型强转 / array / new），替代旧的 `BoundDefault(T,-1)` **零值**（修跨包塌零 bug）。
    // 无 ConstBlob（真无默认值）→ 回落零值（保守，绝不崩）。
    internal BoundExpr _crossPkgDefault(Z42FuncType sig, int i, TypeEnv env, Span sp) {
        // PR6b：caller 宏跨包注入（ParamCallers[i] = "member"/"line"/"file"/"module"，由
        // ImportedSymbolLoader 从 `$Caller:*` 哨兵填）→ 注入调用点上下文字面量（先于 $Default 判定）。
        if (sig.ParamCallers != null && i < sig.ParamCallers.Length && sig.ParamCallers[i] != null && sig.ParamCallers[i] != "") {
            return this._callerLiteral(sig.ParamCallers[i], sig.ParamTypes[i], sp);
        }
        if (sig.ParamDefaults != null && i < sig.ParamDefaults.Length && sig.ParamDefaults[i] != null && sig.ParamDefaults[i] != "") {
            ConstBlobReader rdr = new ConstBlobReader(sig.ParamDefaults[i], sp);
            Expr e = rdr.Read();
            if (e != null) { return this._tc._expr.BindWithTarget(e, sig.ParamTypes[i], env); }
        }
        return new BoundDefault(sig.ParamTypes[i], 0 - 1, sp);
    }

    // PR6b：caller 宏默认值 → 调用点上下文字面量。kind ∈ {member,line,file,module}。
    // member = enclosing 成员名（_curMemberName）；line/file = 调用表达式 Span 的行号/文件；
    // module = 调用点命名空间（_currentNs）。字符串走三引号 raw 形式（Lexer.DecodeString 逐字保留，
    // 免转义处理，值内不含 `"""`——成员名/命名空间/文件路径皆安全）。类型取形参声明类型（定义侧
    // 已校验 member/file/module=string、line=int，故直接吻合、无需再转换）。
    internal BoundExpr _callerLiteral(string kind, Z42Type pty, Span sp) {
        if (kind == "line") {
            return new BoundLitInt(sp.Line.ToString(), pty, sp);
        }
        string val = "";
        if (kind == "member") { val = this._tc._curMemberName; }
        else if (kind == "file") { val = sp.File; }
        else if (kind == "module") { val = this._tc._currentNs; }
        return new BoundLitStr("\"\"\"" + val + "\"\"\"", pty, sp);
    }

    internal BoundExpr[] _withParamsExpansion(MethodSymbol ms, BoundExpr[] args, int rawArgCount, Span sp, SymbolTable syms) {
        Z42FuncType sig = ms.Signature;
        int pf = sig.ParamsFrom;
        Z42ArrayType at = sig.ParamTypes[pf] as Z42ArrayType;
        Z42Type elem = at.Elem;
        if (rawArgCount == sig.ParamCount && args[pf].Type().IsAssignableTo(at)) {
            return args;
        }
        int packCount = rawArgCount - pf;
        BoundExpr[] packed = new BoundExpr[packCount];
        int i = 0;
        // add-primitive-value-boxing: params 尾包元素按元素类型装箱（`params object[]` 收整数
        // 实参 → 逐个装箱成精确宽度）。BoxArgs 在 _withDefaults 入口按 ParamTypes[pf]=数组类型
        // 判定 → 对尾位 no-op，故此处补按 elem（元素类型）装箱，镜像 _bindArrayInit。
        while (i < packCount) { packed[i] = this._tc.BoxIfNeeded(args[pf + i], elem); packed[i] = this._tc.ConvertIfNeeded(packed[i], elem, syms); i = i + 1; }   // tighten-implicit-conversions；add-user-conversions
        BoundExpr arrLit = new BoundArrayLit(packed, packCount, PrimModel.SurfaceName(elem.Name()), new Z42ArrayType(elem), sp);
        BoundExpr[] finalArgs = new BoundExpr[sig.ParamCount];
        int k = 0;
        while (k < pf) { finalArgs[k] = args[k]; k = k + 1; }
        finalArgs[pf] = arrLit;
        return finalArgs;
    }

    internal BoundExpr[] _adaptArgs(MethodDecl md, Expr[] callArgs, int callArgCount, TypeEnv env, Span sp) {
        int pc = md.ParamCount;
        if (callArgCount > pc) { return null; }
        BoundExpr[] slots = new BoundExpr[pc];
        bool[] filled = new bool[pc];
        int pos = 0;
        int i = 0;
        while (i < callArgCount) {
            Expr a = callArgs[i];
            if (a is AssignExpr && (a as AssignExpr).Target is IdentExpr) {
                AssignExpr ae = a as AssignExpr;
                string nm = (ae.Target as IdentExpr).Name;
                int idx = 0 - 1;
                int p = 0;
                while (p < pc) { if (md.Params[p].Name == nm) { idx = p; } p = p + 1; }
                if (idx < 0) { return null; }                 // 命名实参无匹配形参 → 不可适配
                if (filled[idx]) { return null; }
                // add-target-typed-new：命名实参按对应形参类型绑定（支持 `f(x: new())`）。
                slots[idx] = this._tc._expr.BindWithTarget(ae.Value, env.ResolveType(md.Params[idx].Type), env); filled[idx] = true;
            } else {
                if (pos >= pc) { return null; }
                // add-target-typed-new：位置实参按对应形参类型绑定（支持 `f(new())`）。
                slots[pos] = this._tc._expr.BindWithTarget(a, env.ResolveType(md.Params[pos].Type), env); filled[pos] = true; pos = pos + 1;
            }
            i = i + 1;
        }
        int k = 0;
        while (k < pc) {
            if (!filled[k]) {
                Expr dflt = md.Params[k].Default;
                if (dflt == null) { return null; }   // 缺实参且无默认 → 不可适配
                if (CallerMacro.IsMacro(dflt)) {
                    // PR6b：同包 caller 宏注入（跨包对称走 _crossPkgDefault）。截在 _bindExpr 前——
                    // 否则 IdentExpr("$macro:*") 会落到 ExprTyper._bindIdent 报 E0450（误用检测）。
                    slots[k] = this._callerLiteral(CallerMacro.KindOf(CallerMacro.NameOf(dflt)), env.ResolveType(md.Params[k].Type), sp);
                } else {
                    slots[k] = this._tc._expr._bindExpr(dflt, env);
                }
            }
            k = k + 1;
        }
        return slots;
    }

    internal string _ctorKey(Z42ClassType ct, int argCount) {
        string name = ct.Name();
        string ak = name + "$" + argCount.ToString();
        if (ct.Methods.ContainsKey(ak)) { return ak; }
        return name;
    }

    internal string _overloadKey(SymbolTable symbols, Z42ClassType ct, string name, int argCount) {
        string ak = name + "$" + argCount.ToString();
        if (this._findMethod(symbols, ct, ak) != null) { return ak; }
        return name;
    }

    internal MethodSymbol _findMethod(SymbolTable symbols, Z42ClassType ct, string name) {
        Z42ClassType cur = ct;
        bool more = true;
        while (more) {
            if (cur.Methods.ContainsKey(name)) { return cur.Methods.Get(name) as MethodSymbol; }
            if (!cur.HasBase) {
                // 无显式 base 的 class 隐式继承 Object（mirror C# object root；struct 无 Object 方法）。
                if (cur.Name() != "Object" && symbols.HasClass("Object")) { cur = symbols.GetClass("Object"); }
                else { more = false; }
            } else {
                Z42ClassType b = symbols.GetClass(cur.BaseName);
                if (b == null) { more = false; } else { cur = b; }
            }
        }
        return null;
    }

    internal MethodSymbol _resolveOverload(SymbolTable symbols, Z42ClassType ct, string name,
                                          BoundExpr[] args, int argCount, int typeArgCount, Span sp) {
        MethodSymbol[] all = this._collectOverloads(symbols, ct, name);
        if (all.Length == 0) { return null; }
        // add-target-typed-new：延迟绑定的 target-typed new 实参（null 位）无类型 → 无法参与基于类型的重载决议。
        // arity 唯一时（下方 na==1）不需类型可直接选中；否则报 E0437 让用户写显式类名。
        bool anyDeferred = false;
        { int d = 0; while (d < argCount) { if (args[d] == null) { anyDeferred = true; } d = d + 1; } }
        // 按 arity 过滤（仅非 params 候选）
        MethodSymbol[] byArity = new MethodSymbol[all.Length];
        int na = 0;
        int i = 0;
        while (i < all.Length) {
            if (all[i].Signature.ParamsFrom < 0 && all[i].Signature.ParamCount == argCount) {
                byArity[na] = all[i]; na = na + 1;
            }
            i = i + 1;
        }
        if (na == 0) {
            // deferred 位无类型 → 跳过基于类型的 params 决议（否则 null.Type() 崩）。
            if (!anyDeferred) {
                MethodSymbol viaParams = this._resolveParamsOverload(all, args, argCount, sp, symbols);
                if (viaParams != null) { return viaParams; }
            }
            // 无 arity 匹配但全类只有一个同名非 params 方法 → 返回它（镜像旧 _overloadKey 的 bare 兜底：
            // 忽略 arity，如 `Int32.ToString(cp)` 静态形式调用实例 arity-0 ToString，接收者作首参）。
            if (all.Length == 1 && all[0].Signature.ParamsFrom < 0) { return all[0]; }
            if (anyDeferred) {
                this._tc._diags.Error(DiagnosticCodes.TargetTypedNewNeedsType,
                    "target-typed `new` argument to overloaded `" + name + "` needs an explicit type", sp);
            }
            return null;
        }
        // add-array-paired-sort：泛型 arity 过滤（C# 规则）——调用带 N 个显式类型实参（`Sort<int>` → N=1）时，
        // 只有恰好声明 N 个类型形参的候选合格（`Sort<T>` 合格、`Sort<TKey,TValue>` 不合格）。**防御性**：仅当
        // 过滤后仍非空才采用——候选 TypeParamCount 未知/为 0（如某些跨包路径未回填）时不误删全部候选，保证不回归
        // 既有可用的泛型调用（无此过滤前的行为）。
        if (typeArgCount > 0 && na > 1) {
            MethodSymbol[] byTp = new MethodSymbol[na];
            int nt = 0;
            int ti = 0;
            while (ti < na) {
                if (byArity[ti].TypeParamCount == typeArgCount) { byTp[nt] = byArity[ti]; nt = nt + 1; }
                ti = ti + 1;
            }
            if (nt > 0) { byArity = byTp; na = nt; }
        }
        if (na == 1) { return byArity[0]; }   // 单 arity 候选 → 行为保持（deferred 位稍后按形参类型回填）
        // 同 arity ≥2 → type-based 决议；deferred 位无类型无法决议 → 报 E0437 让用户写显式类名。
        if (anyDeferred) {
            this._tc._diags.Error(DiagnosticCodes.TargetTypedNewNeedsType,
                "target-typed `new` argument to overloaded `" + name + "` needs an explicit type", sp);
            return null;
        }
        Z42Type[] argTypes = new Z42Type[argCount];
        int k = 0;
        while (k < argCount) { argTypes[k] = args[k].Type(); k = k + 1; }
        OverloadResult res = OverloadResolver.Resolve(byArity, na, argTypes, argCount);
        if (res.IsResolved()) { return res.Method; }
        if (res.IsAmbiguous()) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded `" + name + "`; add an explicit cast to disambiguate", sp);
        }
        return null;
    }

    // add-prim-instance-type-overload（方案1）：统计 (name, argCount) 在 ct（含基链）上的同 arity
    // 非-params 重载候选数。prim 消费端（MemberResolver prim-wrapper 分支）用它判「是否同 arity 多重载」：
    // ≥2 时 bare/arity 快键会 first-wins 选错（尤跨包 imported 的 bare 别名），须走完整 _resolveOverload
    // 得正确 mangle RegKey；<2 时走原 arity-only 快路径（字节中性）。复用 _collectOverloads（RegKey 去重、
    // 走基链）+ _resolveOverload 同款 byArity 过滤（ParamsFrom<0 且 ParamCount==argCount），确保视图一致。
    internal int _sameArityOverloadCount(SymbolTable symbols, Z42ClassType ct, string name, int argCount) {
        MethodSymbol[] all = this._collectOverloads(symbols, ct, name);
        int cnt = 0;
        int i = 0;
        while (i < all.Length) {
            if (all[i].Signature.ParamsFrom < 0 && all[i].Signature.ParamCount == argCount) { cnt = cnt + 1; }
            i = i + 1;
        }
        return cnt;
    }

    private MethodSymbol _resolveParamsOverload(MethodSymbol[] all, BoundExpr[] args, int argCount, Span sp, SymbolTable symbols) {
        MethodSymbol[] cand = new MethodSymbol[all.Length];
        int nc = 0;
        int i = 0;
        while (i < all.Length) {
            Z42FuncType sig = all[i].Signature;
            if (sig.ParamsFrom >= 0 && argCount >= sig.ParamsFrom) { cand[nc] = all[i]; nc = nc + 1; }
            i = i + 1;
        }
        if (nc == 0) { return null; }
        // normal form
        MethodSymbol[] normalCand = new MethodSymbol[nc];
        int nn = 0;
        i = 0;
        while (i < nc) {
            Z42FuncType sig = cand[i].Signature;
            if (argCount == sig.ParamCount && args[sig.ParamsFrom].Type().IsAssignableTo(sig.ParamTypes[sig.ParamsFrom])) {
                normalCand[nn] = cand[i]; nn = nn + 1;
            }
            i = i + 1;
        }
        if (nn == 1) { return normalCand[0]; }
        if (nn > 1) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded params method; add an explicit cast to disambiguate", sp);
            return null;
        }
        // expanded form：非 object element type 胜 object（更具体优先）
        MethodSymbol[] specific = new MethodSymbol[nc];
        int ns = 0;
        MethodSymbol[] objectTier = new MethodSymbol[nc];
        int no = 0;
        i = 0;
        while (i < nc) {
            Z42FuncType sig = cand[i].Signature;
            Z42ArrayType at = sig.ParamTypes[sig.ParamsFrom] as Z42ArrayType;
            if (at != null) {
                bool ok = true;
                int t = sig.ParamsFrom;
                while (t < argCount) {
                    if (!TypeFactsTc._isAssignable(args[t].Type(), at.Elem, symbols)) { ok = false; }
                    t = t + 1;
                }
                if (ok) {
                    // unify-value-types Phase 1：params object[] 泛化层判别（翻转后 object→Z42ClassType(Object)，Canon 归一）。
                    if (PrimModel.Canon(at.Elem.Name()) == "object") { objectTier[no] = cand[i]; no = no + 1; }
                    else { specific[ns] = cand[i]; ns = ns + 1; }
                }
            }
            i = i + 1;
        }
        if (ns == 1) { return specific[0]; }
        if (ns > 1) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded params method; add an explicit cast to disambiguate", sp);
            return null;
        }
        if (no == 1) { return objectTier[0]; }
        if (no > 1) {
            this._tc._diags.Error(DiagnosticCodes.AmbiguousOverload,
                "ambiguous call to overloaded params method; add an explicit cast to disambiguate", sp);
            return null;
        }
        return null;
    }

    private MethodSymbol[] _collectOverloads(SymbolTable symbols, Z42ClassType ct, string name) {
        // 去重键 = **有效签名**（简单名 + 形参规范类型），非 RegKey。这样一个派生类型自己声明的
        // 方法会**隐藏**基类中同签名的方法（C# method hiding：more-derived wins）——因基链自派生向基
        // 遍历，首见者（最派生）胜。fix-generic-struct-erasure-boxing：imported record struct 的合成
        // `Equals$1(object)`（RegKey `Equals$1`）与继承的 `Object.Equals(object)`（RegKey `Equals`）RegKey
        // 不同但签名相同——旧的 RegKey 去重会二者并存 → 同签名两候选 → 重载决议歧义 → 解析失败 → `.Equals`
        // 松绑不装箱 → 运行期 `other` 裸 StructRef → is_instance 失败 → 值相等误返 false（且伪 E0425）。
        // 按签名去重后派生合成 Equals$1 隐藏 Object.Equals → 唯一候选 → 正确装箱决议。type-based 重载
        // （不同形参类型）签名各异、不受影响；override（同 RegKey、同签名）结果不变。
        StrMap seen = new StrMap();
        MethodSymbol[] acc = new MethodSymbol[8];
        int n = 0;
        Z42ClassType cur = ct;
        bool more = true;
        while (more) {
            MethodSymbol[] here = cur.OverloadsOf(name);
            int i = 0;
            while (i < here.Length) {
                string sigKey = OverloadBinder._overloadSigKey(here[i]);
                if (!seen.ContainsKey(sigKey)) {
                    seen.Put(sigKey, "1");
                    if (n == acc.Length) {
                        MethodSymbol[] b = new MethodSymbol[acc.Length * 2];
                        int q = 0; while (q < n) { b[q] = acc[q]; q = q + 1; }
                        acc = b;
                    }
                    acc[n] = here[i]; n = n + 1;
                }
                i = i + 1;
            }
            if (!cur.HasBase) {
                if (cur.Name() != "Object" && symbols.HasClass("Object")) { cur = symbols.GetClass("Object"); }
                else { more = false; }
            } else {
                Z42ClassType b = symbols.GetClass(cur.BaseName);
                if (b == null) { more = false; } else { cur = b; }
            }
        }
        MethodSymbol[] r = new MethodSymbol[n];
        int z = 0; while (z < n) { r[z] = acc[z]; z = z + 1; }
        return r;
    }

    // fix-generic-struct-erasure-boxing：方法的**有效签名键**（简单名 + 形参规范类型，规范化别名）。
    // 供 `_collectOverloads` 按签名跨基链去重（派生隐藏基类同签名方法）。params 尾位以 `...` 标记纳入键，
    // 使 `f(int)` 与 `f(params int[])` 键相异、互不隐藏。
    private static string _overloadSigKey(MethodSymbol ms) {
        string k = ms.Name + "#";
        Z42FuncType s = ms.Signature;
        if (s == null || s.ParamTypes == null) { return k; }
        int i = 0;
        while (i < s.ParamTypes.Length) {
            if (s.ParamsFrom >= 0 && i == s.ParamsFrom) { k = k + "..."; }
            k = k + (s.ParamTypes[i] == null ? "?" : Z42Type.Canon(s.ParamTypes[i].Name())) + ",";
            i = i + 1;
        }
        return k;
    }

}