namespace Z42.Semantics;

using Z42.Syntax;
using Z42.IR;
using Z42.Symbols;

// 自由函数 + trait impl 的导出提取（从 ExportedTypeExtractor 分出）。hub 经 _extractCore 调度。
public static class FuncImplExtractor {

    // 提取 `impl Trait for Target { methods }`（镜像 C# ExtractImpls）。
    // target/trait 短名按本 CU 作用域解析出声明 ns → "<declNs>.<name>"，解析不到 → "<currentNs>.<name>"（fqn-tables 5d：
    // 此前查「短名 → ns」图，同短名本包覆盖导入）。
    internal static ExportedImplZ[] _extractImpls(CompilationUnit cu, string currentNs, SymbolTable symbols) {
        SymbolTable view = null;   // 按需建（多数文件没有 impl）
        ExportedImplZ[] result = new ExportedImplZ[4];
        int rc = 0;
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = ExportedTypeExtractor._unwrap(cu.Decls[i]);
            if (d is ImplDecl) {
                ImplDecl implD = d as ImplDecl;
                string targetName = FuncImplExtractor._typeShortName(implD.TargetType);
                string traitName = FuncImplExtractor._typeShortName(implD.TraitType);
                if (targetName != "" && traitName != "") {
                    if (view == null) { view = symbols.WithCu(cu); }
                    Z42ClassType target = ImplTargets.Resolve(view, implD);
                    string targetFq = target == null ? FuncImplExtractor._fqOf(targetName, currentNs, view) : target.Fqn();
                    string traitFq = FuncImplExtractor._fqOf(traitName, currentNs, view);
                    string[] argStrs = FuncImplExtractor._implArgs(implD);
                    ExportedMethodZ[] ms = new ExportedMethodZ[implD.MethodCount];
                    int mc = 0;
                    for (int mj = 0; mj < implD.MethodCount; mj = mj + 1) {
                        MethodDecl md = ExportedTypeExtractor._unwrap(implD.Methods[mj]) as MethodDecl;
                        if (md != null) {
                            ms[mc] = FuncImplExtractor._implMethod(view, md, implD.TargetParamNames);
                            mc = mc + 1;
                        }
                    }
                    if (rc == result.Length) {
                        ExportedImplZ[] b = new ExportedImplZ[result.Length * 2];
                        int k = 0; while (k < rc) { b[k] = result[k]; k = k + 1; }
                        result = b;
                    }
                    result[rc] = new ExportedImplZ(targetFq, traitFq, argStrs, argStrs.Length, ms, mc);
                    rc = rc + 1;
                }
            }
            i = i + 1;
        }
        ExportedImplZ[] trimmed = new ExportedImplZ[rc];
        int t = 0; while (t < rc) { trimmed[t] = result[t]; t = t + 1; }
        return trimmed;
    }

    private static ExportedMethodZ _implMethod(SymbolTable view, MethodDecl method, string[] classParams) {
        string[] typeParams = classParams;
        if (classParams.Length > 0 && method.TypeParams.Count > 0) {
            typeParams = new string[classParams.Length + method.TypeParams.Count];
            for (int i = 0; i < classParams.Length; i = i + 1) { typeParams[i] = classParams[i]; }
            for (int i = 0; i < method.TypeParams.Count; i = i + 1) {
                typeParams[classParams.Length + i] = method.TypeParams.Names[i];
            }
        }
        var ps = new ExportedParamZ[method.ParamCount];
        for (int i = 0; i < method.ParamCount; i = i + 1) {
            Param p = method.Params[i];
            ps[i] = new ExportedParamZ(p.Name, FuncImplExtractor._implTypeName(view, p.Type, typeParams));
        }
        string ret = method.IsCtor ? "void" : FuncImplExtractor._implTypeName(view, method.RetType, typeParams);
        string vis = DeclFacts.classVisStr(DeclFacts._visCode(method.ModFlags, 0));
        return new ExportedMethodZ(method.Name, ret, vis, Mod.Has(method.ModFlags, Mod.Static),
            Mod.Has(method.ModFlags, Mod.Virtual), Mod.Has(method.ModFlags, Mod.Abstract),
            ExportedTypeExtractor._requiredCount(method.Params, method.ParamCount), ps, method.ParamCount);
    }

    private static string _implTypeName(SymbolTable view, TypeExpr syntax, string[] typeParams) {
        if (typeParams.Length == 0) { return TypeNameResolver.TsigTypeName(syntax); }
        Z42Type resolved = view.ResolveTypeP(syntax, typeParams, typeParams.Length);
        string name = QualifiedSigTypeNames.OfResolved(resolved);
        return syntax is NullableType ? name + "?" : name;
    }

    private static string[] _implArgs(ImplDecl declaration) {
        if (declaration.TargetParamNames.Length > 0) { return declaration.TargetParamNames; }
        NamedType trait = declaration.TraitType as NamedType;
        if (trait == null) { return new string[0]; }
        string[] args = new string[trait.ArgCount];
        for (int i = 0; i < args.Length; i = i + 1) {
            args[i] = TypeNameResolver.TsigTypeName(trait.Args[i]);
        }
        return args;
    }

    // 短名 FQ 化：本 CU 作用域解析到类 / 接口 → "<declNs>.<name>"，否则 "<currentNs>.<name>"。
    private static string _fqOf(string name, string currentNs, SymbolTable view) {
        Z42ClassType ct = view.GetClass(name);
        if (ct != null) { return ct.Fqn(); }
        Z42InterfaceType it = view.GetInterface(name);
        if (it != null) { return it.Fqn(); }
        return name.IndexOf(".") >= 0 ? name : SymbolTable.QualOf(currentNs, name);
    }

    // TypeExpr → 短名（NamedType.Name；非 Named 形态 → ""，镜像 C# ExtractTypeName 返回 null）。
    private static string _typeShortName(TypeExpr t) {
        if (t is NamedType) { return (t as NamedType).Name; }
        return "";
    }


    internal static ExportedFuncZ _extractFunc(MethodDecl md, string declNs, SymbolTable symbols) {
        // free-function-overloads：按 **RegKey** 精确取 THIS 重载（FunctionsByFqn 键 = QualOf(ns, RegKey)；
        // primary 的 RegKey=裸名 ⇒ 与旧的按 md.Name 取等价，字节稳定）。重载各份 RegKey 唯一 → 取到正确签名，
        // 不再像旧的按 md.Name 取到 primary 的错签名。
        MethodSymbol ms = symbols.GetFuncIn(declNs, md.RegKey);
        ExportedParamZ[] ps = new ExportedParamZ[0];
        string ret = "void";
        int pc = 0;
        int paramsFrom = 0 - 1;
        // 保留 arity 兜底：重复/错误路径下符号可能未按预期注册；arity 不符即退回 decl 自身写法，
        // 防越界崩。正常（唯一或合法重载）路径 arity 必符 → 走上支，与旧行为一致。
        if (ms != null && ms.Signature.ParamCount == md.ParamCount) {
            Z42FuncType sig = ms.Signature;
            pc = sig.ParamCount;
            ps = new ExportedParamZ[pc];
            int i = 0;
            while (i < pc) {
                ps[i] = new ExportedParamZ(md.Params[i].Name, TypeNameResolver._hybridTypeName(md.Params[i].Type, sig.ParamTypes[i]));   // fix-crosspkg-named-args：源名
                i = i + 1;
            }
            ret = TypeNameResolver._hybridTypeName(md.RetType, sig.Ret);
            paramsFrom = sig.ParamsFrom;
        } else {
            pc = md.ParamCount;
            ps = new ExportedParamZ[pc];
            int i = 0;
            while (i < pc) {
                ps[i] = new ExportedParamZ(md.Params[i].Name, TypeNameResolver.TsigTypeName(md.Params[i].Type));
                i = i + 1;
            }
            ret = TypeNameResolver.TsigTypeName(md.RetType);
        }
        // free-function-overloads：导出名 = RegKey（primary=裸名→字节稳定；非-primary 带签名后缀）。
        // 导入侧 base 名可由 RegKey 剥首个 `$` 复原（标识符不含 `$`），故无需新增 TSIG 字段。
        ExportedFuncZ ef = new ExportedFuncZ(md.RegKey, ret, ExportedTypeExtractor._requiredCount(md.Params, pc), ps, pc);
        ef.ParamsFrom = paramsFrom;
        return ef;
    }
}
