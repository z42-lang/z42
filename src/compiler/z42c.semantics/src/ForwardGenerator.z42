// `[Forward]` 成员转发 generator（add-member-forwarding）。
//
// 用组合替代多继承：`class Service { [Forward] Logger _log; }` 让 `svc.Log(m)` 可用，
// 而**生成的是真方法**（不是绑定期把 `a.c` 改写成 `a.b.c`）—— 只有真方法才能满足接口、
// 被反射看见、被 IDE 跳转。Lombok `@Delegate` / Kotlin `by` / Rust RFC 2393 全是生成真方法。
//
// ── 三档粒度（本文件目前落 ③ 档）────────────────────────────────────────────────
//   ① `[Forward<ILogger>]`                      接口面：签名由接口钉死
//   ② `[Forward(methodof(ILogger.Log(string)))]` 名单：逐个点名，编译期可检查
//   ③ `public partial void Log(string m);`       用户写声明、generator 填 body   ← 本文件
//
// ③ 档**零保真损耗**：签名 / 参数名 / 默认值 / `params` / `ref` 全是用户手写的，generator
// 不转写任何东西 —— 这也是它是唯一支持**跨包**字段类型的一档的原因（①② 跨包拿不到参数名，
// 更拿不到 `ref`：TSIG 格式里根本不记录 ref-ness，见 proposal「适用边界」）。
//
// ── 语义规则（proposal S1–S5）──────────────────────────────────────────────────
// S1 不产生子类型 / 不产生隐式转换（只生成方法，不碰类型关系）——D 的 alias this 教训
// S2 `Object` 协议方法永不转发
// S3 不传递、不递归，只提升一层
// S4 多个 `[Forward]` 提供同名成员 → 声明处报错
// S5 外层已声明同名成员 → 不生成（③ 档天然满足：partial 声明本身就是「用户点名要这个」）
namespace Z42.Semantics;

using Std;
using Z42.Syntax;
using Z42.IR;

public sealed class ForwardGenerator : Generator {
    public string AppliedName() { return "Forward"; }
    public string[] Consumes() { return new string[0]; }
    public string[] Produces() { return new string[0]; }

    // 廉价预扫：源码里到底有没有 `[Forward]`（贴在字段上）。
    //
    // 🔴 **为什么必须有这一步**：generator 整块以 `effGenCount > 0` 为门，而
    // `PackageCompile` 明写「空（z42c 自建）→ 分支不进 → **逐字节不动**」。无条件把本
    // generator 注册进去 ⇒ 每次编译都走 union 全 fresh 重编 ⇒ 直接破坏自举字节不动点。
    // 故只有真用了 `[Forward]` 的包才注册它；没用的包一个字节都不变。
    public static bool AnyTrigger(CompilationUnit[] cus, int count) {
        int i = 0;
        while (i < count) {
            CompilationUnit cu = cus[i];
            if (cu != null) {
                int di = 0;
                while (di < cu.DeclCount) {
                    ClassDecl c = ForwardGenerator._asClass(cu.Decls[di]);
                    if (c != null && ForwardGenerator._classHasTrigger(c)) { return true; }
                    di = di + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }

    private static ClassDecl _asClass(Decl d) {
        if (d is ClassDecl) { return d as ClassDecl; }
        if (d is AttributedDecl) { return (d as AttributedDecl).Inner as ClassDecl; }
        return null;
    }

    private static bool _classHasTrigger(ClassDecl c) {
        int mi = 0;
        while (mi < c.MemberCount) {
            Decl mem = c.Members[mi];
            if (mem is AttributedDecl) {
                AttributedDecl mad = mem as AttributedDecl;
                if (mad.Inner is FieldDecl) {
                    int ai = 0;
                    while (ai < mad.AttrCount) {
                        if (mad.Attrs[ai].Name == "Forward") { return true; }
                        ai = ai + 1;
                    }
                }
            }
            mi = mi + 1;
        }
        return false;
    }

    public void Generate(GenTarget t, GenSink sink) {
        // 字段级触发：Applied 是 FieldDecl、Symbol 是外层类（见 GeneratorDriver._tryProcessFieldTriggers）。
        if (!(t.Applied is FieldDecl)) { return; }
        FieldDecl fd = t.Applied as FieldDecl;

        // ③ 档：找外层类里**声明了但没有 body** 的 partial 方法 —— 那就是用户点名要转发的面。
        //
        // 🔴 **必须走 AST，不能走 `Symbol.Methods`**：decl-only 的 partial 方法被
        // `MemberCollector`（:262「无实现即不存在，不注册桩/体」）**擦除**，压根不进 `ct.Methods`。
        // 这也正是它们需要 generator 填 body 的原因 —— 填上之前它们在符号表里不存在。
        // 故用 `t.Owner`（外层 ClassDecl）。
        ClassDecl oc = null;
        if (t.Owner is ClassDecl) { oc = t.Owner as ClassDecl; }
        else if (t.Owner is AttributedDecl) { oc = (t.Owner as AttributedDecl).Inner as ClassDecl; }
        if (oc == null) { return; }
        // 成员按**声明序**遍历（ClassDecl.Members 是有序数组，不是 hashed StrMap）⇒ 生成顺序天然
        // 确定，不需要额外 sort；这比从 Methods 走还更稳（后者迭代序不确定，见 common-pitfalls §1）。
        // 🔴 只转发**这个字段的类型真的有**的方法。
        // 一个类里可以有多个 `[Forward]` 字段，而 partial 声明是**类级**的一张总表 —— 不做这层
        // 过滤，每个字段都会试图转发别人的方法（实测：`_log` 的碎片去转发属于 `_clk` 的 `Now()`
        // → `no method Now on Logger`）。
        Z42ClassType srcT = ForwardGenerator._fieldClassType(t.Symbol, fd.Name);
        if (srcT == null) {
            sink.Error("E0463",
                "[Forward] on field `" + fd.Name + "`: its type is not a class or interface, so it has no "
                + "member surface to lift", t.Trigger.Span);
            return;
        }

        // ── 按**实参形状**选档（三档共用一个 attribute）──────────────────────────
        //   无实参            → ③ partial 声明档（下方既有路径）
        //   typeof(I)         → ① 接口面
        //   methodof(X.M(..)) → ② 逐个点名
        // 判定读的是 `Attr.Args` 的**原始 AST**，不经运行期反射对象 —— generator 跑在编译期，
        // 那些对象此刻还不存在。
        if (t.Trigger != null && t.Trigger.ArgCount > 0) {
            Expr a0 = t.Trigger.Args[0];
            if (a0 is TypeofExpr) {
                ForwardGenerator._emitIfaceTier(t, fd, srcT, a0 as TypeofExpr, oc, sink);
                return;
            }
            if (a0 is MethodOfExpr) {
                ForwardGenerator._emitNamedTier(t, fd, srcT, a0 as MethodOfExpr, oc, sink);
                return;
            }
            sink.Error("E0463",
                "[Forward(...)] takes either `typeof(SomeInterface)` (forward that interface's members) "
                + "or `methodof(Type.Member)` (forward exactly that member). Bare `[Forward]` pairs with "
                + "`partial` declarations you write yourself", t.Trigger.Span);
            return;
        }
        string body = "";
        int n = 0;
        int i = 0;
        while (i < oc.MemberCount) {
            Decl mem = oc.Members[i];
            if (mem is AttributedDecl) { mem = (mem as AttributedDecl).Inner; }
            if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                if (md.IsPartial && !md.HasBody && !ForwardGenerator._isObjectProtocol(md.Name)) {
                    body = body + ForwardGenerator._renderForwarder(md, fd.Name) + "\n";
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        if (n == 0) { return; }
        sink.Augment(t.DeclId, body);
    }



    // ── ① 接口面：`[Forward(typeof(ILogger))]` ────────────────────────────────────
    //
    // 转发面 = 该接口声明的全部方法。签名由**接口**钉死 —— 上游给实现类新增重载不会自动进来，
    // 这正是「白名单必填」的意义（接口就是那份白名单）。
    private static void _emitIfaceTier(GenTarget t, FieldDecl fd, Z42ClassType srcT,
                                       TypeofExpr tox, ClassDecl oc, GenSink sink) {
        if (!(tox.Type is NamedType)) { return; }
        string ifaceName = (tox.Type as NamedType).Name;
        Z42InterfaceType it = ForwardGenerator._lookupIface(t.Symbols, ifaceName);
        if (it == null) {
            sink.Error("E0463",
                "[Forward(typeof(" + ifaceName + "))]: `" + ifaceName + "` does not resolve to an interface. "
                + "The interface-tier form forwards exactly the members an interface declares", t.Trigger.Span);
            return;
        }
        string body = "";
        int n = 0;
        string[] keys = it.Methods.Keys();
        ForwardGenerator._sortStr(keys);   // hashed StrMap 迭代序不确定 → 必须排序，否则字节漂移
        int i = 0;
        while (i < keys.Length) {
            MethodSymbol ms = it.Methods.Get(keys[i]) as MethodSymbol;
            if (ms != null && !ForwardGenerator._isObjectProtocol(ms.Name)
                && ForwardGenerator._infoIfOwnerDeclares(sink, t, oc, ms.Name)) {
                string one = ForwardGenerator._renderFromSymbol(ms, fd.Name, true);
                if (one == "") { ForwardGenerator._notRenderable(sink, t, ms, ms.Name, t.Trigger.Span); }
                else { body = body + one + "\n"; n = n + 1; }
            }
            i = i + 1;
        }
        if (n > 0) { sink.Augment(t.DeclId, body); }
    }

    // ── ② 逐个点名：`[Forward(methodof(Logger.Log(string)))]` ──────────────────────
    //
    // methodof 在这里同时是**编译期可检查的书写形式**（名字写错 / 签名漂了 → E0459/E0460，
    // 在 attribute 实参位置就报）与 **generator 的结构化输入**（直接读 AST 的 Member）。
    private static void _emitNamedTier(GenTarget t, FieldDecl fd, Z42ClassType srcT,
                                       MethodOfExpr mo, ClassDecl oc, GenSink sink) {
        Span sp = t.Trigger.Span;
        if (ForwardGenerator._isObjectProtocol(mo.Member)) {
            sink.Error("E0465",
                "[Forward] cannot forward `" + mo.Member + "`: the Object protocol methods "
                + "(ToString / Equals / GetHashCode / GetType) are never forwarded — forwarding them "
                + "would make `" + t.Name + "` report the identity of `" + srcT.Name() + "`", sp);
            return;
        }
        if (ForwardGenerator._ownerDeclares(oc, mo.Member)) {
            sink.Info("I0466",
                "[Forward] skipped `" + mo.Member + "`: `" + t.Name + "` declares a member with that "
                + "name itself, and your own declaration wins", sp);
            return;
        }
        int hits = ForwardGenerator._countByName(srcT, mo.Member);
        if (hits == 0) {
            sink.Error("E0463",
                "[Forward] `" + srcT.Name() + "` (the type of field `" + fd.Name + "`) has no member named `"
                + mo.Member + "`. `methodof` only checked that `" + mo.OwnerName + "." + mo.Member
                + "` exists — that it lives on *this* field's type is a separate claim, and it does not hold",
                sp);
            return;
        }
        if (hits > 1) {
            sink.Error("E0465",
                "[Forward] `" + srcT.Name() + "." + mo.Member + "` has " + hits.ToString()
                + " overloads — forwarding has to emit one concrete method, so it cannot pick for you. "
                + "Use the `partial` declaration form instead: write `public partial <ret> " + mo.Member
                + "(<params>);` in `" + t.Name + "` for each overload you want lifted", sp);
            return;
        }
        MethodSymbol ms = ForwardGenerator._pickByName(srcT, mo.Member);
        string one = ForwardGenerator._renderFromSymbol(ms, fd.Name, false);
        if (one == "") { ForwardGenerator._notRenderable(sink, t, ms, mo.Member, sp); return; }
        sink.Augment(t.DeclId, one + "\n");
    }

    // ①② 档渲染不出来 —— 说清**为什么**，并给出可照抄的下一步。
    private static void _notRenderable(GenSink sink, GenTarget t, MethodSymbol ms, string name, Span sp) {
        if (ms != null && ms.Visibility == "private") {
            sink.Error("E0464",
                "[Forward] cannot forward `" + name + "`: it is private. Lifting someone else's private "
                + "implementation onto your own public surface is not what forwarding means", sp);
            return;
        }
        sink.Error("E0464",
            "[Forward] cannot forward `" + name + "`: it is declared in another package, and cross-package "
            + "metadata carries neither parameter names nor `ref`/`out` — so an equivalent signature cannot "
            + "be reconstructed (and dropping `ref` compiles silently, losing the mutation). "
            + "Use the `partial` declaration form instead: write `public partial <ret> " + name
            + "(<params>);` in `" + t.Name + "` and let the generator fill only the body", sp);
    }

    private static int _countByName(Z42ClassType ct, string name) {
        int hits = 0;
        string[] keys = ct.Methods.Keys();
        int i = 0;
        while (i < keys.Length) {
            MethodSymbol ms = ct.Methods.Get(keys[i]) as MethodSymbol;
            if (ms != null && ms.Name == name) { hits = hits + 1; }
            i = i + 1;
        }
        return hits;
    }

    // 从**符号**渲染转发方法（①② 档用；③ 档用用户手写的 AST，见 _renderForwarder）。
    //
    // 🔴 只对**本包**符号成立：`ms.Decl` 非空时形参名/ref/params/默认值一应俱全；
    // 跨包符号只有 `Z42FuncType` —— 参数名在导入时就被丢掉，`ref`/`out` 更是 TSIG 格式里
    // **根本不记录**（判定不了，而丢掉 ref 的后果是**静默**的错误语义）。
    // 故跨包一律返回 ""（不生成），由 ⑤ 组的诊断告诉用户改用 ③ 档。
    private static string _renderFromSymbol(MethodSymbol ms, string fieldName, bool fromIface) {
        if (!ms.HasDecl || ms.Decl == null) { return ""; }
        // 私有成员指不了也转不了（Lippert 四类之一）：元数据可见但重载决议不可见，
        // 而且把别人的私有实现提升到自己的公开面本身就是错的。
        //
        // ⚠️ 接口成员**不做这个判断**：符号表对「没写修饰符的成员」一律记 private
        // （`SymbolCollector._vis` 的默认值），而接口成员按定义就是公开的、本来就不写修饰符。
        // 照搬这条会让 ① 档一个方法都生成不出来（实测：Hi/Bye 全被吞）。
        if (!fromIface && ms.Visibility == "private") { return ""; }
        if (ms.Decl.IsCtor) { return ""; }   // 构造器不是可转发成员
        return ForwardGenerator._renderForwarderM(ms.Decl, fieldName, "public", false);
    }

    // S5 的 ① 档版：外层已声明 → 报 Info 并返回 false（调用方跳过这一个成员，不中断整批）。
    private static bool _infoIfOwnerDeclares(GenSink sink, GenTarget t, ClassDecl oc, string name) {
        if (!ForwardGenerator._ownerDeclares(oc, name)) { return true; }
        sink.Info("I0466",
            "[Forward] skipped `" + name + "`: `" + t.Name + "` declares a member with that name itself, "
            + "and your own declaration wins", t.Trigger.Span);
        return false;
    }

    // 外层类自己声明了同名成员？（S5：不生成，且必须**按名字**判 —— 跨碎片同名重载会让
    // 先声明的那个从方法表里**静默消失**，见 partial-types.md「跨碎片重载 → 静默覆盖」。）
    private static bool _ownerDeclares(ClassDecl oc, string name) {
        int i = 0;
        while (i < oc.MemberCount) {
            Decl mem = oc.Members[i];
            if (mem is AttributedDecl) { mem = (mem as AttributedDecl).Inner; }
            if (mem is MethodDecl) {
                MethodDecl md = mem as MethodDecl;
                // partial 声明（无 body）不算「已声明」—— 那正是 ③ 档要 generator 去填的。
                if (md.Name == name && !(md.IsPartial && !md.HasBody)) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    // 按名字取**唯一**方法符号；同名多重载 → 返回 null（② 档点名到重载时不猜，留给诊断）。
    private static MethodSymbol _pickByName(Z42ClassType ct, string name) {
        MethodSymbol found = null;
        int hits = 0;
        string[] keys = ct.Methods.Keys();
        ForwardGenerator._sortStr(keys);
        int i = 0;
        while (i < keys.Length) {
            MethodSymbol ms = ct.Methods.Get(keys[i]) as MethodSymbol;
            if (ms != null && ms.Name == name) { found = ms; hits = hits + 1; }
            i = i + 1;
        }
        if (hits != 1) { return null; }
        return found;
    }

    private static Z42InterfaceType _lookupIface(SymbolTable symbols, string name) {
        if (symbols == null) { return null; }
        return symbols.GetInterface(name);
    }

    // 字段名 → 它的类型（须是类/接口才谈得上转发）。
    private static Z42ClassType _fieldClassType(Z42ClassType owner, string fieldName) {
        if (owner == null || owner.Fields == null) { return null; }
        FieldSymbol fs = owner.Fields.Get(fieldName) as FieldSymbol;
        if (fs == null) { return null; }
        if (fs.FieldType is Z42ClassType) { return fs.FieldType as Z42ClassType; }
        return null;
    }

    // 该类型（含继承链）有没有这个名字的方法。
    //
    // 按**名字**判定而非签名：这一步回答的是「这个字段提供不提供这个成员」，签名是否匹配由
    // 生成体本身的调用去判（写错了就是一条普通的编译错误，指在生成碎片上）。
    // 跨包类型的 `Methods` 已被 TSIG 展平过继承方法；本包类型则沿 HasBase 上溯。
    private static bool _provides(Z42ClassType ct, string name) {
        Z42ClassType cur = ct;
        int hops = 0;
        while (cur != null && hops < 32) {
            string[] keys = cur.Methods.Keys();
            int i = 0;
            while (i < keys.Length) {
                MethodSymbol ms = cur.Methods.Get(keys[i]) as MethodSymbol;
                if (ms != null && ms.Name == name) { return true; }
                i = i + 1;
            }
            if (!cur.HasBase) { return false; }
            cur = null;   // 本包基类需要 SymbolTable 才能上溯，GenTarget 不提供 → v1 只看本类 + TSIG 展平面
            hops = hops + 1;
        }
        return false;
    }

    // S2：`Object` 协议方法永不转发（对齐 Lombok `@Delegate` 的 "all public **non-Object** methods"）。
    // 转发 ToString/Equals/GetHashCode 会让外层对象谎报自己是内层对象 —— 那是身份问题，不是便利问题。
    private static bool _isObjectProtocol(string name) {
        return name == "ToString" || name == "Equals" || name == "GetHashCode" || name == "GetType";
    }

    // 渲染一个转发方法：`partial <mods> <ret> <Name>(<params>) { [return] this.<field>.<Name>(<args>); }`
    //
    // 签名**逐字沿用用户写的那份**（`md` 就是用户的 partial 声明）：参数名、默认值、`params`、
    // `ref` 全部原样 —— 这正是 ③ 档零保真损耗的由来。generator 只补 body。
    private static string _renderForwarder(MethodDecl md, string fieldName) {
        return ForwardGenerator._renderForwarderM(md, fieldName, md.Mods, true);
    }

    // modsOverride：①② 档不抄源方法的修饰符，统一发 `public` —— 转发的意义就是把成员提升到
    // **外层的公开面**；而接口成员的声明本就不写修饰符（隐式 public），照抄会生成私有方法、
    // 调用点报 E0404。③ 档相反：签名整个是用户写的，原样沿用。
    // asPartial：③ 档的实现侧必须带 `partial` 才能与用户那份声明配对；①② 档**没有**声明可配对
    // （整个方法都是 generator 造的），带上 `partial` 反而是 E0434「实现找不到匹配的声明」。
    private static string _renderForwarderM(MethodDecl md, string fieldName, string modsOverride, bool asPartial) {
        string sig = "    " + modsOverride;
        if (asPartial && !ForwardGenerator._hasWord(modsOverride, "partial")) { sig = sig + " partial"; }
        sig = sig + " " + md.RetType.Dump() + " " + md.Name + "(";
        string args = "";
        int i = 0;
        while (i < md.ParamCount) {
            Param p = md.Params[i];
            if (i > 0) { sig = sig + ", "; args = args + ", "; }
            if (p.IsParams) { sig = sig + "params "; }
            if (p.IsRef) { sig = sig + "ref "; args = args + "ref "; }
            sig = sig + p.Type.Dump() + " " + p.Name;
            // 默认值只写在**声明侧**（用户那份），实现侧重复写会是 E0434 签名不一致 → 这里不带。
            args = args + p.Name;
            i = i + 1;
        }
        sig = sig + ")";
        bool isVoid = md.RetType.Dump() == "void";
        string call = "this." + fieldName + "." + md.Name + "(" + args + ");";
        if (isVoid) { return sig + " { " + call + " }"; }
        return sig + " { return this." + fieldName + "." + md.Name + "(" + args + "); }";
    }

    private static bool _hasWord(string mods, string w) {
        string[] parts = mods.Split(" ");
        int i = 0;
        while (i < parts.Length) { if (parts[i] == w) { return true; } i = i + 1; }
        return false;
    }

    // 插入排序（成员量小；生成顺序必须确定，见 Generate 里的注释）。
    private static void _sortStr(string[] a) {
        int i = 1;
        while (i < a.Length) {
            string k = a[i];
            int j = i - 1;
            while (j >= 0 && a[j].CompareTo(k) > 0) { a[j + 1] = a[j]; j = j - 1; }
            a[j + 1] = k;
            i = i + 1;
        }
    }
}
