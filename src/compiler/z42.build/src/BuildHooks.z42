namespace Z42.Build;

/// 平台无关头相位的 hook 扩展点。项目定义 `class ProjectHooks : BuildHooks`
/// 并 override 需要的钩子；默认 no-op。SDK（Pipeline）在对应头相位前后调用。
///
/// 跨平台 hook 放这里（与具体 workload 解耦）；平台专属逻辑放 WorkloadBase 子类。
public class BuildHooks {
    public virtual void BeforeCompile(IPipelineContext ctx) { }
    public virtual void AfterCompile(IPipelineContext ctx)  { }
    public virtual void BeforeTrim(IPipelineContext ctx)    { }
    public virtual void AfterTrim(IPipelineContext ctx)     { }
    public virtual void BeforeAssets(IPipelineContext ctx)  { }
    public virtual void AfterAssets(IPipelineContext ctx)   { }

    /// 产出本包携带的私有 native 库（add-native-dep-config）。**专用窄相位**：只负责现场编/拷
    /// native（如 `cargo build` 出 cdylib）到 `ctx.Dirs.Dist/<rid>/<prefix><name><suffix>` 并
    /// `ctx.AddOutput("native", <path>)` 登记。消费方（z42b publish 的 `_pubBundleProjectNativeDeps`）
    /// 沿 path-dep 闭包**只跑本相位**（不盲跑通用 BeforeAssets），把目标 rid 那份平铺进 payload。
    /// 默认 no-op。与 `WorkloadBase.NativeBuild`（平台尾相位）命名同族、职责正交。
    public virtual void ProvideNative(IPipelineContext ctx) { }
}

/// 多个 hook 按顺序组合成一个：每个相位依次调用各部分（顺序 = 构造时给的顺序）。z42b 把工程的 hook 目录与
/// `[plugins]` 里带 hook 能力位的插件（插件之间按清单声明序、包内按类全名序）组合后挂到 `Pipeline.Hooks`。
/// 某一部分抛异常即中止并向上传——与单个 hook 抛异常同样判构建失败。
public sealed class CompositeBuildHooks : BuildHooks {
    private BuildHooks[] _parts;
    private int _count;
    public CompositeBuildHooks(BuildHooks[] parts, int count) { this._parts = parts; this._count = count; }

    public override void BeforeCompile(IPipelineContext ctx) { int i = 0; while (i < this._count) { this._parts[i].BeforeCompile(ctx); i = i + 1; } }
    public override void AfterCompile(IPipelineContext ctx)  { int i = 0; while (i < this._count) { this._parts[i].AfterCompile(ctx); i = i + 1; } }
    public override void BeforeTrim(IPipelineContext ctx)    { int i = 0; while (i < this._count) { this._parts[i].BeforeTrim(ctx); i = i + 1; } }
    public override void AfterTrim(IPipelineContext ctx)     { int i = 0; while (i < this._count) { this._parts[i].AfterTrim(ctx); i = i + 1; } }
    public override void BeforeAssets(IPipelineContext ctx)  { int i = 0; while (i < this._count) { this._parts[i].BeforeAssets(ctx); i = i + 1; } }
    public override void AfterAssets(IPipelineContext ctx)   { int i = 0; while (i < this._count) { this._parts[i].AfterAssets(ctx); i = i + 1; } }
    public override void ProvideNative(IPipelineContext ctx) { int i = 0; while (i < this._count) { this._parts[i].ProvideNative(ctx); i = i + 1; } }
}
