// 声明良构约束簇：从 SymbolCollector 分出。D8 类名后缀强制（attribute/analyzer/generator，E0444/5/7）
// + partial 类型/方法校验。纯语法/AST 级检查。共享辅助 + partial 状态留 hub SymbolCollector，经 _sc 委回。
namespace Z42.Symbols;
using Z42.IR;
using Z42.Syntax;
using Z42.Core;

public sealed partial class DeclEnforcer {
    private SymbolCollector _sc;   // hub 反向引用：共享辅助 + partial 状态 + 编排
    public DeclEnforcer(SymbolCollector sc) { this._sc = sc; }

    // attribute-handler-registry PR2（D8 后缀约定）：任何直接以 `Attribute` 基类派生的用户类，其类名
    // **必须**以 `Attribute` 结尾——用名 `[X]` 剥后缀 ↔ 定义名 `XAttribute` 带后缀，AttributeSynth 按此
    // 展开合成工厂 `new XAttribute()`。违规 → E0444（把 C# 的软警告 CA1710 提成硬编译错，design D8 注）。
    // 纯语法检查（NestedFlatten 后遍历 ClassDecl，看直接基类名）；directive（`[Native]`）/ test 家族
    // 不派生 `Attribute` → 天然豁免；基类 `Attribute` 自身无 `: Attribute` 基 → 不触发。
    // （Generator/Analyzer 的后缀强制留 PR3/PR4——彼时那两 kind 才成为可加载的真类型。）
    internal void _passAttributeSuffixEnforce(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (this._baseIsAttribute(c) && !c.Name.EndsWith("Attribute")) {
                    this._sc.Diags.Error(DiagnosticCodes.AttributeSuffixRequired,
                        "attribute class `" + c.Name + "` must end with `Attribute` suffix (rename to `" + c.Name + "Attribute`; apply it as `[" + c.Name + "]`)", c.Span);
                }
            }
            i = i + 1;
        }
    }

    // add-builtin-name-clash-diagnostic：顶层 `class` / `struct` 的名字不得与内建基元的 BCL
    // 拼写相同（`Int32` / `Single` / `String` / `Object` …共 14 个）→ E0499。
    //
    // 🔴 此前**零诊断、运行期崩**。故障链四步，每步单独看都合理：
    //   ① `PrimModel.Canon` 是个**纯字符串函数**（不看 ns、不看包、不看 import），把
    //      `"Single"` 折成 `"float"`；
    //   ② `StructLayout.BuildFromSymbols` 的 `ct.IsStruct && !IsScalarValue(key)` ⇒
    //      用户这个类型**根本不进 `_defs`**；
    //   ③ `ClassDescBuilder` 的 `Layouts.IsStructType` 于是 miss ⇒ 尺寸/逐字段表一个都不填；
    //   ④ 而 `ZbcWriter` 仍按 `Flags & 4`（struct 位）**无条件**写出 struct 块 ⇒ size 0 的空块。
    // 三副面孔（实测）：普通 struct ⇒ `FieldSet: expected object, got F64(0.0)`；
    // 泛型 struct ⇒ `struct field write out of blob bounds`；`[Record]` struct ⇒
    // **编译器自己崩**（uncaught @ `AccessEmitter._pathAppend` —— 那正是 P2 的符号化守卫，
    // 它早就知道这里不对，只是所在位置只能抛、给不出用户级诊断）。
    //
    // ⭐⭐⭐ **判据问 `PrimModel.Canon` 本人，不抄那张 14 名表**：缺陷的根因就是 `Canon` 的
    // 折叠行为，照它当前的值域抄一份名单就是再造一处「判据复制」—— `Canon` 将来增减一个拼写，
    // 这里会**静默**跟不上（多一个 ⇒ 漏报、回到今天的崩溃；少一个 ⇒ 误拒合法代码）。
    //
    // ⚠️ 必须用 `Code` 而**不是** `IsScalarValue`：后者是 `c >= 0 && c <= 11`，
    // **漏掉 `string`(12) / `object`(13)**，而 `class String` / `struct Object` 实测一样会崩。
    //
    // ⚠️ 豁免用 `PreludeNs.Root()` 而不是字面量 `"Std"` —— 那个文件是 prelude ns 的唯一 SoT，
    // 它的头注写的正是「同一个事实此前在三处各写一遍字面量 …… 三份拷贝各自漂移」。
    // 用 `Root()` 而非 `Contains()`：`Std.Runtime` 也是 prelude ns，但那 14 个包装类型声明在
    // `Std`（根）；`Std.Runtime` 里若有个叫 `Single` 的类型，符号表键仍是裸名 ⇒ 照样被折
    // ⇒ **它应当被诊断**。
    //
    // ⚠️ 不管的三类（实测不受影响，加约束等于凭空扩大语言限制）：
    //   · `enum` / `interface`（`Kind != "interface"` 过滤掉后者；enum 是独立 decl 类型）
    //   · **嵌套类型** —— 本 pass 跑在 NestedFlatten 之后，届时名字是 `Outer+Single`，
    //     `Canon` 折不动 ⇒ 天然豁免。**这条靠构造成立、没有代码表达它，用测试钉住。**
    //   · 小写关键字（`struct float`）—— 词法保留字，语法层 E0202 先拦下。
    internal void _passBuiltinNameClash(CompilationUnit cu) {
        if (cu.HasNamespace && cu.Namespace == PreludeNs.Root()) { return; }
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (c.Kind != "interface") {
                    string canon = PrimModel.Canon(c.Name);
                    if (PrimModel.Code(canon) >= 0) {
                        this._sc.Diags.Error(DiagnosticCodes.BuiltinTypeNameClash,
                            "type `" + c.Name + "` collides with the built-in type `" + canon
                            + "` — `" + c.Name + "` is its BCL-style spelling, and outside namespace `"
                            + PreludeNs.Root() + "` that name is reserved (a type declared with it is"
                            + " silently treated as the primitive: its layout is never computed, so"
                            + " field access crashes at run time). Rename it.", c.Span);
                    }
                }
            }
            i = i + 1;
        }
    }

    // 直接基类里是否有 `Attribute`（或限定 `*.Attribute`）。attribute 基类现实中一律不限定（限定
    // `Std.Attribute` 触 typechecker FQN-upcast gap，见 reflection.md Deferred），限定分支仅稳妥兜底。
    private bool _baseIsAttribute(ClassDecl c) {
        return this._baseHasSimpleName(c, "Attribute");
    }

    // attribute-handler-registry PR3a（D8 后缀约定，analyzer 侧）：任何直接实现 `Analyzer` 接口的用户类，
    // 其类名**必须**以 `Analyzer` 结尾（`NoGotoAnalyzer` 等）——handler 靠接口发现、无用名 `[X]`，后缀是
    // kind 信号（design D8：Generator/Analyzer 后缀 C# 无先例、z42 自创）。违规 → E0445。与 E0444 同为纯
    // 语法检查（看直接基/接口名，不依赖可解析）；同 3 挂载点。Generator 后缀强制留 PR4（彼时 Generator 成
    // 可加载真类型）。
    internal void _passAnalyzerSuffixEnforce(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                if (this._baseHasSimpleName(c, "Analyzer") && !c.Name.EndsWith("Analyzer")) {
                    this._sc.Diags.Error(DiagnosticCodes.AnalyzerSuffixRequired,
                        "analyzer class `" + c.Name + "` must end with `Analyzer` suffix (rename to `" + c.Name + "Analyzer`)", c.Span);
                }
            }
            i = i + 1;
        }
    }

    // attribute-handler-registry PR4a（D8 后缀约定，generator 侧）：任何直接实现 `Generator`（applied，PR4a）
    // 或 `ModuleGenerator`（module，PR4c）接口的用户类，其类名**必须**以 `Generator` 结尾（`DeriveGenerator` /
    // `RouteTableGenerator` 等）——applied generator 靠接口发现、类名剥后缀即触发注解名（`[Derive]`），module
    // generator 无触发名但共用同一 kind 信号后缀（design D8）。违规 → E0447。与 E0444/E0445 同为纯语法检查
    // （看直接基/接口名，不依赖可解析）；同 3 挂载点。
    internal void _passGeneratorSuffixEnforce(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._sc._unwrap(cu.Decls[i]);
            if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                bool isGen = this._baseHasSimpleName(c, "Generator") || this._baseHasSimpleName(c, "ModuleGenerator");
                if (isGen && !c.Name.EndsWith("Generator")) {
                    this._sc.Diags.Error(DiagnosticCodes.GeneratorSuffixRequired,
                        "generator class `" + c.Name + "` must end with `Generator` suffix (rename to `" + c.Name + "Generator`)", c.Span);
                }
            }
            i = i + 1;
        }
    }

    // 直接基/接口列表里是否有简单名 `name`（或限定 `*.name`）。纯语法（不依赖 base 可解析）——E0444/E0445/
    // E0447 后缀强制共用；attribute 基类/analyzer·generator 接口现实中都不限定，限定分支仅稳妥兜底。
    private bool _baseHasSimpleName(ClassDecl c, string name) {
        int j = 0;
        while (j < c.BaseCount) {
            if (c.Bases[j] is NamedType) {
                string bn = (c.Bases[j] as NamedType).Name;
                if (bn == name || bn.EndsWith("." + name)) { return true; }
            }
            j = j + 1;
        }
        return false;
    }

    // partial 类型校验（AST 级，跨全部 CU 按名分组）：① 全部标 partial ② Kind 一致 ③ 嵌套 partial 报错。
    // （base 冲突在 _passClassStubs——需接口表分辨 base vs iface；成员重复在 _fillClass。）
    internal void _passValidatePartial(CompilationUnit[] cus, string[] files, int count) {
        ClassDecl[] frags = new ClassDecl[16];
        int nf = 0;
        int c = 0;
        while (c < count) {
            int i = 0;
            while (i < cus[c].DeclCount) {
                Decl d = this._sc._unwrap(cus[c].Decls[i]);
                if (d is ClassDecl) {
                    ClassDecl cd = d as ClassDecl;
                    if (nf == frags.Length) {
                        ClassDecl[] bb = new ClassDecl[frags.Length * 2];
                        int k = 0; while (k < nf) { bb[k] = frags[k]; k = k + 1; }
                        frags = bb;
                    }
                    frags[nf] = cd; nf = nf + 1;
                    this._checkNestedPartial(cd);
                }
                i = i + 1;
            }
            c = c + 1;
        }
        StrMap seen = new StrMap();
        int a = 0;
        while (a < nf) {
            string nm = frags[a].Name;
            if (!seen.ContainsKey(nm)) {
                seen.Put(nm, "1");
                int total = 0; int partialN = 0; string firstKind = "";
                bool kindErr = false; ClassDecl kindReport = frags[a];
                int b = 0;
                while (b < nf) {
                    if (frags[b].Name == nm) {
                        total = total + 1;
                        if (frags[b].IsPartial) { partialN = partialN + 1; }
                        if (firstKind == "") { firstKind = frags[b].Kind; }
                        else if (frags[b].Kind != firstKind) { kindErr = true; kindReport = frags[b]; }
                    }
                    b = b + 1;
                }
                if (partialN > 0) {
                    if (partialN != total) {
                        this._sc.Diags.Error(DiagnosticCodes.PartialModifierMissing,
                            "type `" + nm + "` has both partial and non-partial declarations; all must be `partial`", frags[a].Span);
                    }
                    if (kindErr) {
                        this._sc.Diags.Error(DiagnosticCodes.PartialKindMismatch,
                            "partial type `" + nm + "` declared with mismatched kinds (class/struct/interface must agree)", kindReport.Span);
                    }
                }
            }
            a = a + 1;
        }
    }

    // 嵌套类型自身 partial（v1 不支持，design D9）：外层 partial 含嵌套允许；嵌套类**自身**标 partial → 报错。
    private void _checkNestedPartial(ClassDecl outer) {
        int i = 0;
        while (i < outer.MemberCount) {
            Decl m = this._sc._unwrap(outer.Members[i]);
            if (m is ClassDecl) {
                ClassDecl inner = m as ClassDecl;
                if (inner.IsPartial) {
                    this._sc.Diags.Error(DiagnosticCodes.PartialNestedUnsupported,
                        "nested type `" + inner.Name + "` cannot be `partial` (v1 supports partial only on top-level types)", inner.Span);
                }
            }
            i = i + 1;
        }
    }

    // partial method 配对校验：每个实现必须有匹配声明（同 canonical 签名）；否则=实现无声明/签名不一致。
    // decl-only（有声明无实现）→ 已在 _fillClass 擦除，此处不报错（合法擦除）。
    internal void _passResolvePartialMethods() {
        string[] implKeys = this._sc._partialImpls.Keys();
        int i = 0;
        while (i < implKeys.Length) {
            if (!this._sc._partialDecls.ContainsKey(implKeys[i])) {
                MethodDecl implMd = this._sc._partialImpls.Get(implKeys[i]) as MethodDecl;
                this._sc.Diags.Error(DiagnosticCodes.PartialMethodSigMismatch,
                    "partial method `" + implMd.Name + "` implementation has no matching declaration (declaration and implementation signatures must match exactly)", implMd.Span);
            }
            i = i + 1;
        }
    }

}
