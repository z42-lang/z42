// 依赖引用条目的编码（deterministic-zpkg-deps）：`UsedDepNs` 的每一项是 `ns`、`ns#pkg` 或 `ns#pkg#sym`。
//
// `sym`（precise-pkg-refs）= 被引用的导入**类型或自由函数**的全名（去掉泛型实参 / 签名后缀，见 `SymKey`）。
// 它进 zpkg DEPS 段的符号表，运行期据此「这个名字在哪个包」精确加载那一个包（.NET TypeRef 的
// ResolutionScope 同理），不再按命名空间前缀猜。
//
// zpkg 的 DEPS 段由这些条目算出：带 `#pkg` 的只记那一个包（符号**实际**来自哪个包）；不带的是归属不明，
// 保守地记下该 ns 在本次扫描里的**全部**提供包。后者会随「本次构建能看到哪些包」变化，前者不会 ——
// 所以记录点要尽量给出归属包，回落只是兜底。
//
// 为什么编码进字符串而不是加字段：`UsedDepNs` 随增量缓存 meta 落盘，由 driver 原样搬运
// （IncrementalDriver / Main 构造 CachedNsMeta）。加字段 ⇒ driver 要引用新的 pipeline 符号，
// 按自举纪律得晚一个 nightly；编进现有串，driver 零改动。ns 与包名都不含 `#`。
namespace Z42.Semantics;

public static class DepRef {
    public static string Encode(string ns, string pkg) {
        if (pkg == null || pkg == "") { return ns; }
        return ns + "#" + pkg;
    }

    // 带符号：归属不明（pkg 空）时符号没有意义，退回只记 ns。
    public static string EncodeSym(string ns, string pkg, string sym) {
        if (pkg == null || pkg == "") { return ns; }
        if (sym == null || sym == "") { return ns + "#" + pkg; }
        return ns + "#" + pkg + "#" + DepRef.SymKey(sym);
    }

    // 运行期与编译期共用的符号键：去掉泛型实参（`<…>`）与重载 / arity 后缀（`$…`）。
    // 运行期 `LazyLoader` 对查找名做同样的归一（见 runtime `symbol_key`）。
    // 每次依赖记录都走这里（热路径）：一次 `ToCharArray` 单遍扫，不用两次 `IndexOf(string)`（各自物化一遍）。
    public static string SymKey(string name) {
        char[] cs = name.ToCharArray();
        int i = 0;
        while (i < cs.Length) {
            char c = cs[i];
            if (c == '<' || c == '$') { return name.Substring(0, i); }
            i = i + 1;
        }
        return name;
    }

    public static string NsOf(string entry) {
        int h = entry.IndexOf('#');
        return h < 0 ? entry : entry.Substring(0, h);
    }

    // "" = 归属不明。
    public static string PkgOf(string entry) {
        int h = entry.IndexOf('#');
        if (h < 0) { return ""; }
        string rest = entry.Substring(h + 1, entry.Length - h - 1);
        int h2 = rest.IndexOf('#');
        return h2 < 0 ? rest : rest.Substring(0, h2);
    }

    // "" = 条目不带符号（只到 ns / 包）。
    public static string SymOf(string entry) {
        int h = entry.IndexOf('#');
        if (h < 0) { return ""; }
        string rest = entry.Substring(h + 1, entry.Length - h - 1);
        int h2 = rest.IndexOf('#');
        return h2 < 0 ? "" : rest.Substring(h2 + 1, rest.Length - h2 - 1);
    }
}
