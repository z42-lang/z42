// `ImportedSymbolLoader.Load`（主文件 8 参重载）的相位体（partial 分片；fnlines 只降不升）：
// 主文件保留相位编排（激活集 → Phase1 骨架 → Phase2 填充 → Phase3 impl 合并），
// 本文件承载各相位的**单模块实现**——类/接口/枚举骨架、delegate/自由函数、接口方法填充。
// 与 .Resolve 分片（纯叶子解析）、.Fill 分片（并行填充任务类）同一分工惯例：同 partial 类、共享 private 面。
namespace Z42.Symbols;

using Z42.IR;
using Z42.Package;
using Z42.Core;   // Span（导入接口的父接口形态包成 ResolvedTypeExpr 时要，与主文件同款）

public static partial class ImportedSymbolLoader {

    // ── 激活集与建表序（decouple-pkg-activation）────────────────────────────────────────
    // **候选包全体**参与名字查找；可见性另由命名空间规则判（using / 全限定名 / 外围 ns，见
    // SymbolTable.Nominal）。候选 = prelude ∪ 允许的依赖（stdlib + 声明依赖，`allowedDeps`）
    // ∪ 提供本包某 using / 外围 ns 的包（后者保留，未声明依赖时仍走 E0497 指路）。
    // 分两档：第 0 档 = 旧口径（prelude ∪ 提供 using 的包），第 1 档 = 其余候选。建表按「先第 0 档、后第 1 档」，
    // 于是短名表的 first-wins 赢家与 arity-mangle 判定对第 0 档逐字节不变；第 1 档只补进新名字。
    // impl 合并（Phase3）只认第 0 档：它会改写被合并的导入类，等同 C# 扩展方法，须 using 才生效。
    // 返回建表序（第 0 档在前、第 1 档在后；非激活包不进），tier0 档位表由调用方声明、此处填充。
    private static int[] _activationOrder(ExportedModuleZ[] exported, string[] pkgNames, int exportedCount,
                                          string[] usings, int usingCount, string[] allowedDeps, int allowedCount,
                                          bool[] tier0, bool[] active, ref int orderN) {
        int i = 0;
        while (i < exportedCount) {
            if (ImportedSymbolLoader._isPrelude(pkgNames[i])) { tier0[i] = true; }
            else { tier0[i] = ImportedSymbolLoader._pkgProvidesUsing(exported, pkgNames, exportedCount, pkgNames[i], usings, usingCount); }
            active[i] = tier0[i] || ImportedSymbolLoader._allowedDep(pkgNames[i], allowedDeps, allowedCount);
            i = i + 1;
        }
        int[] order = new int[exportedCount];
        int n = 0;
        i = 0;
        while (i < exportedCount) { if (tier0[i]) { order[n] = i; n = n + 1; } i = i + 1; }
        i = 0;
        while (i < exportedCount) { if (active[i] && !tier0[i]) { order[n] = i; n = n + 1; } i = i + 1; }
        orderN = n;
        return order;
    }

    // ── Phase1 · 类骨架：短名 → 空成员 Z42ClassType（+ 接口名表 / 约束 / 关联类型）─────────
    // needsMangle 判定用第 0 档 / 全体两张多 arity 表（tier0 包只看 tier0，与旧口径逐字节一致）。
    private static void _skeletonClasses(ImportedSymbols r, ExportedModuleZ em, string pkgName, bool isTier0,
                                         StrMap impMultiArity, StrMap impMultiAll, string parentPkg) {
        int c = 0;
        while (c < em.ClassCount) {
            ExportedClassZ cl = em.Classes[c];
            bool needsMangle = cl.TpCount > 0 && (isTier0 ? impMultiArity : impMultiAll).ContainsKey(cl.Name);
            string clKey = needsMangle ? (cl.Name + "$" + cl.TpCount.ToString()) : cl.Name;
            // add-bare-name-ambiguity-diagnostic：**在 first-wins 守卫之外**累积声明 ns ——
            // 守卫之内只有赢家能进，那正是「同短名跨 ns 被塌掉」的地方。记的是**全部**候选包的 ns，
            // 歧义判据（`IsBareNameAmbiguous`）自己再按本文件可见性过滤。
            SymbolTable.NoteNsInto(r.ClassNsAll, clKey, em.Namespace);
            // unify-type-identity-fqn：**first-wins 只能管裸名表**。此前整个建型都被这道守卫罩着 ⇒
            // 同短名的第二份（`Demo.FqnBeta.Widget`）压根不建型，FQN 视图自然也拿不到它 ⇒
            // 限定引用只能退回剥短名撞赢家（实测 `Both.fromBeta` 绑成了 `Demo.FqnAlpha.Widget`）。
            // 现在把守卫收窄到只裹 `r.Classes.Put`，其余每份都建、按 FQN 各存一份。
            string fqnKey = em.Namespace == "" ? clKey : em.Namespace + "." + clKey;
            // report-crosspkg-duplicate-type：记「这个 FQN 由哪个包声明」——同样在 first-wins
            // 守卫之外。`pkgNames` 与 `exported` 平行，来源包名一直就在手边，只是从没被记过。
            // 同一个包的多个模块贡献同一个包名 → NoteNsInto 幂等，不会自己撞自己。
            // 🔴 父包不算「另一个包」（fix-e0606-parent-pkg-false-positive）：本次编译是
            // <parentPkg> 的测试/bench 目标时，父包按**同包**待遇加载（其类型 IsImported=false，
            // 这正是测试能看见 internal 的机制）。若还把它记进「FQN → 来源包」表，同一个类型
            // 就会既算「本包声明」又算「导入包声明」⇒ E0606（本地遮蔽导入）对**每一处**父包
            // 类型引用误报，而那正是测试该做的事。E0601（两包同 FQN）同理。
            // 一句话：这张表记的是「有几个**别的**包声明了它」，父包不在此列。
            if (!(parentPkg != "" && pkgName == parentPkg)) {
                SymbolTable.NoteNsInto(r.ClassPkgAll, fqnKey, pkgName);
            }
            if (!r.ClassesByFqn.ContainsKey(fqnKey)) {
                string baseName = "";
                bool hasBase = cl.HasBase && cl.BaseName != "Object";
                // enforce-fqn-name-identity：有 FQ 就用 FQ —— 基类句柄绑定（`_bindClassBase`）按 FQN 直接命中，
                // 不再落到裸名表猜（`Type : MemberInfo` 这类跨 ns 基类，声明方的 `using` 不随元数据走）。
                if (hasBase) { baseName = cl.BaseFqn != null && cl.BaseFqn != "" ? cl.BaseFqn : cl.BaseName; }
                Z42ClassType nct = new Z42ClassType(cl.Name, hasBase, baseName);
                // enforce-access-control：来自依赖 zpkg（跨包）→ internal 成员不可访问。
                // z42b-owns-test-targets：**例外** —— 本次编译是 <parentPkg> 的测试/bench 目标时，
                // 加载父包按同包待遇（internal 可见）。其余依赖照旧。parentPkg=="" → 恒 true（现状）。
                nct.IsImported = !(parentPkg != "" && pkgName == parentPkg);
                nct.IsSealed = cl.IsSealed;   // impl-sealed-semantics-devirt：跨包 sealed 类（继承强制 + 去虚化）
                nct.IsDeprecated = cl.IsDeprecated; nct.DeprecationMsg = cl.DeprecationMsg;   // add-deprecated-directive：跨包类级弃用（use-site 告警）
                nct.Visibility = cl.Visibility;   // enforce-class-access：跨包类声明可见性（internal 类跨包引用 deny）
                // add-crosspkg-struct-value-semantics (P4a) 根因修复：跨包 struct 值类型分类。生产方
                // ExportedTypeExtractor 把 struct-ness 编码进 ExportedClassZ.HasBase（`hasBase = !isStruct`——
                // 非-struct class 恒 HasBase=true，struct 恒 HasBase=false），故 `!cl.HasBase` 精确等价
                // isStruct。修前 imported struct 当引用类型（消费方不发 StructAlloc/FieldGetPrim）→ 与生产方
                // struct 构造函数（发 StructFieldSetPrim off=0）不一致 → 运行期 blob-bounds 崩。分类正确后
                // StructLayout.BuildFromSymbols 从字段名/类型重算布局（与生产方持久化逐字节一致）。
                //
                // ⚠️ 此处原有一条「不新增 ExportedClassZ 字段 ← bootstrap 越界」的论证，已于
                // add-associated-types  删除：它写下时（ea3f0c73, 08-12）就已失效 13 天——
                // _ensureBootstrapSelfDepLibs 的破环预建自 07596b57 (07-30) 起**总是**用当前 driver 把
                // 当前源 z42.package 建进 build-libs（不 warm-skip），z42c 源用当前源 z42.package 新 API 已是常态
                // （先例：IsSealed / Visibility / IsDeprecated / ExportedMethodZ.TypeParamCount / StrMap.Find）。
                // 唯一仍有效的约束是**种子 ABI**：新字段不得进 ctor 签名，须 ctor 内给默认值 + 构造后赋值。
                // 机制见 docs/internals/src/compiler/self-hosting.md 轴④。
                // （struct-ness 继续复用 HasBase 编码属独立技术债，登记 Deferred，不在本 change 内改。）
                nct.IsStruct = !cl.HasBase;
                // complete-generic-instantiation：类级 `[Record]`（CLASS_FLAG_RECORD，TYPE Flags bit3）。
                // 此前**从不设置** —— 唯一写入点是 `StubCollector._putClassStub`（本地类），于是
                // 导入 record 恒为 false。后果不止本 change 要用的「能否在本包重新合成」判据：
                // `ConstructTyper._bindWith` 与 `PatternBinder._bindPositional` 都以 `!IsRecord`
                // 为拒绝条件 ⇒ **跨包 record 的 `with` 与位置解构模式一律误拒**（实测 E0402
                // ``with` requires a record type` / `positional pattern requires a record type`，
                // 阴性对照见 `src/compiler/z42c.pipeline/tests/fixtures/cross-zpkg/crosspkg_record_members`）。
                // 种子 ABI 安全：IsRecord 不进 ExportedClassZ ctor 签名，默认 false、构造后赋值。
                nct.IsRecord = cl.IsRecord;
                // 类侧关联类型绑定（zbc 1.42，assoc-type-crosspkg）：`class IntBag:IEnum{type Item=int;}` 的
                // `Item=int` 经 TYPE assoc 块恢复 → Z42ClassType.AssocBinding*，供 ConstraintChecker 使用点
                // 跨包匹配（`AssocBindingOf` 不再恒空，删 IsImported 守卫后跨包错绑定/缺绑定才报得出）。
                int cab = 0;
                while (cab < cl.AssocBindingCount) { nct.AddAssocBinding(cl.AssocBindingNames[cab], cl.AssocBindingTypeNames[cab]); cab = cab + 1; }
                // unify-type-identity-fqn：**导入类的声明 ns**。此前从未设置 —— 全编译器给
                // `Z42ClassType.Namespace` 赋值的点只有 `StubCollector._putClassStub`（本地类），
                // 于是 imported 类的 `Fqn()` 恒退化成短名。`Z42Type.z42` 里那句「导入由
                // ImportedSymbolLoader 从 em.Namespace 设置」是**过期的假断言**（见 §6 防腐门）。
                // 种子 ABI 安全：Namespace 不进 ctor 签名、ctor 内默认 ""，此处构造后赋值。
                nct.Namespace = em.Namespace;
                if (cl.TpCount > 0) { nct.GenericParamNames = cl.TypeParams; nct.GenericParamCount = cl.TpCount; }
                if (needsMangle) { nct.HasArityMangle = true; nct.ArityMangleCount = cl.TpCount; }
                // fix-crosspkg-interface-impl：imported 类带上实现接口表（bare 名，TSIG 恢复）——
                // SymbolTable.Implements 据此判 class→iface 可赋性（`ICompiler c = new NoCompiler()`）。
                if (cl.InterfaceCount > 0) {
                    nct.InterfaceNames = cl.Interfaces;
                    nct.InterfaceCount = cl.InterfaceCount;
                }
                r.ClassesByFqn.Put(fqnKey, nct);
                // add-associated-types PR-1：跨包 where 约束，键与 FQN 视图同为 fqnKey —— 每个 FQN 各挂各的，
                // 同短名不同 ns 的类不再互相覆盖、也不再只有短名赢家才有约束。
                ConstraintSet ics = ImportedSymbolLoader._constraintSetOf(cl);
                if (ics != null) { r.Constraints.Put(fqnKey, ics); }
            }
            c = c + 1;
        }
    }

    // ── Phase1 · 接口骨架（供下游 _passClassStubs 基表判别：imported 接口名必须在 table.Interfaces 中）──
    private static void _skeletonInterfaces(ImportedSymbols r, ExportedModuleZ em, string pkgName, string parentPkg) {
        int ic = 0;
        while (ic < em.InterfaceCount) {
            ExportedInterfaceZ iz = em.Interfaces[ic];
            // report-crosspkg-duplicate-type：接口同款（守卫之外累积）。接口不 arity-mangle，
            // FQN 直接 ns + 裸名，与 Z42InterfaceType.Fqn() 同口径。
            if (!(parentPkg != "" && pkgName == parentPkg)) {   // 父包不算「另一个包」，见 _skeletonClasses 头注
                SymbolTable.NoteNsInto(r.ClassPkgAll,
                    em.Namespace == "" ? iz.Name : em.Namespace + "." + iz.Name, pkgName);
            }
            string ifqnKey = em.Namespace == "" ? iz.Name : em.Namespace + "." + iz.Name;
            // FQN 表每一份都留（同 FQN first-wins）。
            SymbolTable.NoteNsInto(r.IfaceNsAll, iz.Name, em.Namespace);
            if (!r.InterfacesByFqn.ContainsKey(ifqnKey)) {
                Z42InterfaceType nift = new Z42InterfaceType(iz.Name);
                nift.Namespace = em.Namespace;   // unify-type-identity-fqn：导入接口的声明 ns（与 nct.Namespace 对称）
                // complete-class-access-control ④：跨包 → internal 接口不可引用。
                // 同上例外：父包的 internal 接口对其测试目标可见。
                nift.IsImported = !(parentPkg != "" && pkgName == parentPkg);
                nift.Visibility = iz.Visibility;        // complete-class-access-control ④：跨包接口声明可见性
                // add-associated-types PR-3：导入接口的型参名进符号表（与本包 StubCollector 对称）。
                nift.TypeParamNames = iz.TypeParams; nift.TypeParamCount = iz.TpCount;
                // 关联类型名单（zbc 1.42，assoc-type-crosspkg）：接口声明的 `type Item;` 经 TYPE assoc 块恢复
                // → Z42InterfaceType.AssocTypeNames，供 ConstraintChecker 声明点 + InheritanceResolver 补齐强制
                //（删 IsImported 守卫后跨包生效）。
                int iat = 0;
                while (iat < iz.AssocTypeCount) { nift.AddAssocType(iz.AssocTypeNames[iat]); iat = iat + 1; }
                // 父接口链（fix-crosspkg-iface-basenames）：TSIG 的 BaseNames（TYPE Interfaces 块搬运，
                // 已是传递闭包）→ Z42InterfaceType.BaseNames，与本包 StubCollector 的 AddBase 对称。
                // 缺了这一步，跨包接口上调**继承来的**成员一律 E0401 —— 直接后果是实现
                // `Std.IEnumerable<T>` 的类型不能 foreach（脱糖出的 `__e.Dispose()` 走的正是
                // `IEnumerator<T> : IDisposable` 继承来的成员）。
                // ⚠️ TSIG 存 **FQ + 带泛型实参**的名（`Std.IDisposable`、`Std.IBox<T>`）
                // ⇒ 此处截掉实参、**保留命名空间**（enforce-fqn-name-identity B2.5；
                // 此前还剥短名，那会把 ns 扔掉让消费侧去猜，见 `_fqTrimTypeArgs` 抬头）。
                // 查找侧不受影响：`SymbolTable.GetInterface` 走 FQN 双键，
                // 归一 `IfaceFqnOf` 对已 FQ 的名字幂等。
                int ibn = 0;
                while (ibn < iz.BaseCount) {
                    nift.AddBase(ImportedSymbolLoader._fqTrimTypeArgs(iz.BaseNames[ibn]));
                    ibn = ibn + 1;
                }
                r.InterfacesByFqn.Put(ifqnKey, nift);   // unify-type-identity-fqn
            }
            ic = ic + 1;
        }
    }

    // ── Phase1 · 枚举常量（imported `EnumType.Member` → BoundLitInt；镜像 _passEnums 填 EnumTypes/EnumConsts）──
    private static void _skeletonEnums(ImportedSymbols r, ExportedModuleZ em, string pkgName, string parentPkg) {
        int ec = 0;
        while (ec < em.EnumCount) {
            ExportedEnumZ ez = em.Enums[ec];
            // report-crosspkg-duplicate-type：enum 同款（守卫之外累积）。
            if (!(parentPkg != "" && pkgName == parentPkg)) {   // 父包不算「另一个包」，见 _skeletonClasses 头注
                SymbolTable.NoteNsInto(r.ClassPkgAll,
                    em.Namespace == "" ? ez.Name : em.Namespace + "." + ez.Name, pkgName);
            }
            string efqn = em.Namespace == "" ? ez.Name : em.Namespace + "." + ez.Name;
            // FQN 视图与常量按 FQN 去重（first-wins）：此前它们也在下面的**短名**守卫里，同短名不同 ns 的
            // 第二个 enum 连 FQN 都进不来（引用它的源码解析不到 / 常量读到第一个的值）。
            if (!r.EnumTypeNamesByFqn.ContainsKey(efqn)) {
                r.EnumTypeNamesByFqn.Put(efqn, "enum");   // unify-type-identity-fqn
                int emi = 0;
                while (emi < ez.MemberCount) {
                    ExportedEnumMemberZ emem = ez.Members[emi];
                    r.EnumConsts.Put(efqn + "." + emem.Name, new StrBox(emem.Value.ToString()));
                    emi = emi + 1;
                }
            }
            ec = ec + 1;
        }
    }

    // ── Phase2 · delegate 与自由函数（骨架齐备后解析类型可互指）──────────────────────────
    private static void _fillDelegatesAndFunctions(ImportedSymbols r, ExportedModuleZ em, string pkgName, string parentPkg) {
        // 用户 delegate → 函数类型（与本包 `StubCollector._passDelegates` 同形：形参 / 返回按 delegate 的型参解析）。
        // 骨架齐了才解析：签名可能引用同包后面模块的类。同 FQN 跨包 first-wins（同 enum / 类）。
        int dg = 0;
        while (dg < em.DelegateCount) {
            ExportedDelegateZ dz = em.Delegates[dg];
            string dfqn = em.Namespace == "" ? dz.Name : em.Namespace + "." + dz.Name;
            if (!r.DelegatesByFqn.ContainsKey(dfqn)) {
                Z42Type[] dps = new Z42Type[dz.ParamCount];
                int dp = 0;
                while (dp < dz.ParamCount) {
                    dps[dp] = ImportedSymbolLoader._resolve(r, dz.Params[dp].TypeName, dz.TypeParams, dz.TpCount);
                    dp = dp + 1;
                }
                Z42Type dret = ImportedSymbolLoader._resolve(r, dz.ReturnType, dz.TypeParams, dz.TpCount);
                r.DelegatesByFqn.Put(dfqn, new Z42FuncType(dps, dz.ParamCount, dret));
            }
            dg = dg + 1;
        }
        // 自由函数
        int f = 0;
        while (f < em.FunctionCount) {
            ExportedFuncZ fz = em.Functions[f];
            // free-function-overloads：TSIG 里 fz.Name = **RegKey**（primary=裸名 / 非-primary=`name$arity$T`）。
            // 基名（源名）= 剥首个 `$`（标识符不含 `$`）。FuncOriginAll / 裸名歧义按**基名**记；
            // FunctionsByFqn 键与符号 RegKey 用完整 RegKey。Phase 1 无重载 ⇒ fz.Name 无 `$` ⇒ 基名==全名，字节稳定。
            int fzDollar = fz.Name.IndexOf('$');
            string fzBase = fzDollar < 0 ? fz.Name : fz.Name.Substring(0, fzDollar);
            // report-crosspkg-duplicate-function：**守卫之外**记来源（ns + 包名）。
            // 守卫之内只有赢家能进，而「这个名字有几个来源」正是守卫塌掉的那个信息。
            // 父包不算「另一个包」——与类/接口/enum 同一判据（#586，见 _skeletonClasses 头注）。
            if (!(parentPkg != "" && pkgName == parentPkg)) {
                SymbolTable.NoteNsInto(r.FuncOriginAll, fzBase, em.Namespace + "#" + pkgName);
            }
            string fzFqn = SymbolTable.QualOf(em.Namespace, fz.Name);
            if (!r.FunctionsByFqn.ContainsKey(fzFqn)) {
                // imported-generic-func-type-param-fidelity：自由函数的**函数级**型参
                // （`T IdOf<T>(T a)`）。这是 R1 当初列出却漏修的第四处（见 _tpsWith 注释）：
                // 不喂型参表 → `T` 落 `_resolve` 末尾的 Builtin 兜底成普通类 ⇒ 调用点 E0402。
                // 自由函数无外层类 ⇒ outer 为空，与 trait-impl 方法那支同形。
                string[] ftps = ImportedSymbolLoader._tpsWith(new string[0], 0, fz.TypeParams);
                int ftpc = ftps.Length;
                Z42Type[] ps = new Z42Type[fz.ParamCount];
                int j = 0;
                while (j < fz.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, fz.Params[j].TypeName, ftps, ftpc); j = j + 1; }
                Z42FuncType sig = new Z42FuncType(ps, fz.ParamCount, ImportedSymbolLoader._resolve(r, fz.ReturnType, ftps, ftpc));
                sig.ParamsFrom = fz.ParamsFrom;
                ImportedSymbolLoader._fillParamMeta(sig, fz.Params, fz.ParamCount, fz.RefInfoKnown, fz.RetIsNullable);   // PR6：跨包默认值/ caller
                // free-function-overloads：Name=基名（源名，诊断/候选分组用），RegKey=完整 RegKey（发射键）。
                MethodSymbol fsym = new MethodSymbol(fzBase, "public", sig, false, "", false, null);
                fsym.RegKey = fz.Name;
                fsym.IsDeprecated = fz.IsDeprecated; fsym.DeprecationMsg = fz.DeprecationMsg;   // fix-free-function-attrs：跨包自由函数弃用
                fsym.TypeParamCount = fz.TypeParamCount;   // 供泛型 arity 重载过滤（镜像方法侧）
                fsym.TypeParamNames = ImportedSymbolLoader._tpNames(fz.TypeParams);   // fix-explicit-type-arg-not-substituted
                r.FunctionsByFqn.Put(fzFqn, fsym);   // 源 ns + RegKey 在键里；调用点解析出 ns 后随 BoundCall 带到发射端
            }
            f = f + 1;
        }
    }

    // ── Phase2 · imported 接口方法填充（fix-crosspkg-interface-impl）─────────────────────
    // 跨包 `c.Compile(req)` / `f.Val()` 的接口派发查 Z42InterfaceType.Methods——从 TSIG 重建的
    // ExportedInterfaceZ 方法灌入（镜像 local _passMembers 的接口方法收集）。
    private static void _fillInterfaceMethods(ImportedSymbols r, ExportedModuleZ em) {
        int ifi2 = 0;
        while (ifi2 < em.InterfaceCount) {
            ExportedInterfaceZ iz2 = em.Interfaces[ifi2];
            // 按 FQN 取（短名表只有赢家 —— 按短名取会把同短名别 ns 接口的方法灌进赢家）。
            Z42InterfaceType it2 = r.InterfacesByFqn.Get(em.Namespace == "" ? iz2.Name : em.Namespace + "." + iz2.Name) as Z42InterfaceType;
            if (it2 != null) {
                // add-associated-types PR-2：接口方法签名的型参上下文 = 接口 TypeParams ∪ {"Self"}。
                // **顺带修既有缺口**：此前这里走 `_resolve(r, name)` 单参版（无型参上下文）⇒ 跨包
                // 泛型接口方法里的 `T` 落到 `Z42ClassType.Builtin("T")` 兜底垃圾类型，而非
                // Z42GenericParamType。`Self` 会踩同一个坑，故一并接上（design D5）。
                string[] itp2 = MemberCollector._withSelf(iz2.TypeParams, iz2.TpCount);
                int itpc2 = iz2.TpCount + 1;
                // 父接口的**带实参**形态（与本包 `StubCollector._addIfaceBases` 存 AST 节点同形）。
                // 骨架那一步（Phase1）只能恢复裸短名 —— 它是查找键，实参被剥掉了；沿继承链代换
                // 型参却正需要实参（`interface ILeaf : IMid<int>`）。放在 Phase2 是因为解析父接口
                // 要求**所有**骨架已建（Phase1 内父接口可能还没轮到），而 `_resolve` 认 FQ 名 +
                // 泛型实例化串，正好吃 TSIG 存的那个形态。
                int ibr = 0;
                while (ibr < it2.BaseCount && ibr < iz2.BaseCount) {
                    if (it2.BaseRefs[ibr] == null) {
                        Z42Type bt2 = ImportedSymbolLoader._resolve(r, iz2.BaseNames[ibr], itp2, itpc2);
                        if (bt2 is Z42InterfaceType) {
                            it2.BaseRefs[ibr] = new ResolvedTypeExpr(bt2, new Span(0, 0, 0, 0, ""));
                        }
                    }
                    ibr = ibr + 1;
                }
                int im2 = 0;
                while (im2 < iz2.MethodCount) {
                    ExportedMethodZ mz = iz2.Methods[im2];
                    if (!it2.Methods.ContainsKey(mz.Name)) {
                        // R1：接口级型参（**含 `Self`**，add-self-type 的 `itp2`）∪ **方法级**型参。
                        // 此前方法级一个都没喂 → `IBasicCollection<T>.AddOne(T)` 的 `T` 降级成
                        // 名为 "T" 的普通类 ⇒ `AddOne(1)` 报 `int → T`。
                        string[] itps = ImportedSymbolLoader._tpsWith(itp2, itpc2, mz.TypeParams);
                        int itpc = itps.Length;
                        Z42Type[] mps = new Z42Type[mz.ParamCount];
                        int mj2 = 0;
                        while (mj2 < mz.ParamCount) { mps[mj2] = ImportedSymbolLoader._resolve(r, mz.Params[mj2].TypeName, itps, itpc); mj2 = mj2 + 1; }
                        Z42FuncType msig = new Z42FuncType(mps, mz.ParamCount, ImportedSymbolLoader._resolve(r, mz.ReturnType, itps, itpc));
                        ImportedSymbolLoader._fillParamMeta(msig, mz.Params, mz.ParamCount, mz.RefInfoKnown, mz.RetIsNullable);   // PR6
                        // add-interface-satisfaction-check：`isStatic` 此前硬编码 `false`，
                        // 而 `mz.IsStatic` 明明就在手上 ⇒ 跨包看 `INumber.op_Add` 这类
                        // **static abstract** 接口成员会被当成实例方法。与 #523 修的四条
                        // 「imported 类型保真度」同族：元数据带着信息，导入侧把它抹平了。
                        // （`IsAbstract` 没有对应槽——`MethodSymbol` 无该字段，抽象性一律靠
                        //  `Decl.Mods` 嗅探，而导入符号 `HasDecl=false`；故只还原 IsStatic。）
                        it2.Methods.Put(mz.Name, new MethodSymbol(mz.Name, "public", msig, mz.IsStatic, iz2.Name, false, null));
                    }
                    im2 = im2 + 1;
                }
            }
            ifi2 = ifi2 + 1;
        }
    }
}
