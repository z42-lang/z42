// enforce-class-access 的**静态簇**：类级访问强制（引用点 CheckTypeRef）、暴露面校验（CheckExposure）、
// 可见性封顶（MinVisibility）——自 Binding/AccessChecker.z42 逐字搬来（semantics-split 准备：消除
// SymbolCollector→Binding 的最后一处回边）。零实例状态：只依赖 Z42Type 家族 / SymbolTable /
// DiagnosticBag / Span；AccessChecker 的**成员级**实例面（CheckAccess / 弃用检测，持 TypeChecker
// 反向引用）留在 Binding——两侧的 private 静态助手互不共享（本簇自带 _checkVisRef/_nestedOuter/
// _derivesFromOrEq/_denyType/_visRank 五件）。
namespace Z42.Symbols;

using Z42.Core;   // Span / DiagnosticBag

public static class TypeRefAccess {
    // ── access-top-scope：文件/命名空间身份归一 ─────────────────────────────────────────────
    // 顶层 private 的两侧文件身份比对经此归一：REPL 每轮是独立 CU（`repl_r0`、`repl_r1`…），若按
    // 原名比对，第 2 轮看不见第 1 轮的 private 类——REPL 语义是**会话级共享**，故 repl_r<数字>
    // 一律折叠为同一 scope key。普通源文件（含路径分隔符/后缀）不受影响。
    private static string _scopeKey(string file) {
        if (file == null) { return ""; }
        if (file.Length > 6 && file.StartsWith("repl_r")) {
            int i = 6;
            while (i < file.Length) {
                char ch = file.CharAt(i);
                if (ch < '0' || ch > '9') { return file; }
                i = i + 1;
            }
            return "<repl-session>";
        }
        return file;
    }

    // access-top-scope：嵌套名（`Outer+Inner`）的**顶层祖先**顶层作用域强制。嵌套类型自身的
    // private/protected 语义不变（外层类文本/家族）；但若顶层祖先是文件/命名空间作用域的
    // （Visibility=private/protected 且名不含 '+'），引用嵌套类型同样引用了它的家族容器，
    // 必须一并过门——否则 `file-private Outer` + `public 嵌套 Inner` 从别的文件裸用
    // `Outer.Inner` 会绕过 Outer 的门。仅对**新语义**（顶层 private/protected 祖先）生效，
    // public/internal 祖先零改动，既有代码不可能命中。
    private static void _chkTopAncestor(string declName, string declNs, string curNs,
                                        SymbolTable symbols, DiagnosticBag diags, Span sp) {
        int plus = declName.IndexOf('+');
        if (plus <= 0) { return; }   // 顶层本身 / 退化名：无祖先可查
        string top = declName.Substring(0, plus);
        string key = declNs == "" ? top : declNs + "." + top;
        Z42ClassType anc = symbols.ClassesByFqn.Get(key) as Z42ClassType;
        if (anc == null) { return; }   // 查不到（导入/前向）→ 不在此误报
        if (anc.Name().IndexOf('+') >= 0) { return; }   // 祖先自身嵌套：非顶层语义
        string vis = anc.Visibility;
        if (vis == "private") {
            if (TypeRefAccess._scopeKey(anc.DeclFile) != TypeRefAccess._scopeKey(sp.File)) {
                diags.Error(DiagnosticCodes.AccessViolation,
                    "cannot access file-scoped private class `" + top + "` (declared in another file)", sp);
            }
        } else if (vis == "protected") {
            if (anc.IsImported || anc.Namespace != curNs) {
                string hint = anc.IsImported ? " from another package"
                    : " from " + (curNs == "" ? "the global namespace" : "namespace `" + curNs + "`");
                diags.Error(DiagnosticCodes.AccessViolation,
                    "cannot access namespace-scoped protected class `" + top + "`" + hint, sp);
            }
        }
    }

    // access-top-scope：静态属主路径（`X.Member` / `X.M()` 的 X）的顶层作用域强制。_chkTypeRef 走
    // CheckTypeRef 全量；_chkStaticOwner 此前只查跨包重名（_chkTypeRefPkg），类型自身的门在这里补。
    // **只对顶层 private/protected 生效**——嵌套属主仅查顶层祖先门（嵌套自身的 private/protected
    // 家族语义走 MemberResolver 既有路径，此处不重复、也不越权），public/internal 属主零改动。
    public static void CheckTopScopeOwner(Z42ClassType ct, string curNs, SymbolTable symbols,
                                          DiagnosticBag diags, Span sp) {
        if (ct == null || ct.IsBuiltinType()) { return; }
        string nm = ct.Name();
        if (nm.IndexOf('+') >= 0) {
            TypeRefAccess._chkTopAncestor(nm, ct.Namespace, curNs, symbols, diags, sp);
            return;
        }
        if (ct.Visibility == "private" || ct.Visibility == "protected") {
            TypeRefAccess._checkVisRef(ct.Visibility, nm, ct.IsImported, ct.Namespace, ct.DeclFile,
                                       "class", "", curNs, symbols, diags, sp);
        }
    }

    // ── enforce-class-access：类级访问强制（引用点） ──────────────────────────────────────────
    // 从 currentClass 上下文**引用** resolved 类型是否允许；违规 emit E0404 到 diags（不阻断）。
    // 静态 + 显式 diag bag：绑定期（binder → _tc._diags）与收集期（SymbolCollector → 其 Diags）共用同一逻辑。
    // 语义：public 放行；private 嵌套类仅外层类文本内、**顶层=本文件**（access-top-scope）；protected
    // 外层类+派生、**顶层=本包 ∩ 同名命名空间**（access-top-scope）；internal 同包，跨包 deny。
    // curNs=引用点所在 CU 的命名空间（protected 顶层判定用）；引用文件取 sp.File（与收集端 files[] 同源）。
    // 泛型实例化递归校验（定义类 + 每个类型实参）。非类类型（prim/接口/泛型形参/未知/func）一律放行，绝不误报。
    public static void CheckTypeRef(Z42Type resolved, string currentClass, string curNs, SymbolTable symbols,
                                    DiagnosticBag diags, Span sp) {
        if (resolved is Z42InstantiatedType) {
            Z42InstantiatedType it = resolved as Z42InstantiatedType;
            TypeRefAccess.CheckTypeRef(it.Def, currentClass, curNs, symbols, diags, sp);
            int i = 0;
            while (i < it.ArgCount) { TypeRefAccess.CheckTypeRef(it.TypeArgs[i], currentClass, curNs, symbols, diags, sp); i = i + 1; }
            return;
        }
        if (resolved is Z42ClassType) {
            Z42ClassType ct = resolved as Z42ClassType;
            // unify（删 Z42PrimType）后基元 `int`≡`Std.Int32` 是 phantom Z42ClassType——永远可访问
            // （镜像旧模型：旧 Z42PrimType 本就被 `!(is Z42ClassType)` 跳过），否则会误拒所有 `int` 引用。
            if (ct.IsBuiltinType()) { return; }
            TypeRefAccess._chkTopAncestor(ct.Name(), ct.Namespace, curNs, symbols, diags, sp);
            TypeRefAccess._checkVisRef(ct.Visibility, ct.Name(), ct.IsImported, ct.Namespace, ct.DeclFile,
                                       "class", currentClass, curNs, symbols, diags, sp);
            return;
        }
        // complete-class-access-control ④：接口与类对称强制（internal 接口跨包引用 deny）。
        if (resolved is Z42InterfaceType) {
            Z42InterfaceType ift = resolved as Z42InterfaceType;
            TypeRefAccess._chkTopAncestor(ift.Name(), ift.Namespace, curNs, symbols, diags, sp);
            TypeRefAccess._checkVisRef(ift.Visibility, ift.Name(), ift.IsImported, ift.Namespace, ift.DeclFile,
                                       "interface", currentClass, curNs, symbols, diags, sp);
            return;
        }
        // fix-undefined-type-diagnostic D5：数组元素递归（覆盖 `C[]` 元素未定义）。
        if (resolved is Z42ArrayType) {
            Z42ArrayType at = resolved as Z42ArrayType;
            TypeRefAccess.CheckTypeRef(at.Elem, currentClass, curNs, symbols, diags, sp);
            return;
        }
        // fix-undefined-type-diagnostic：具名 Unknown（SymbolTable.ResolveTypeP 未解析 fallthrough
        // 携原名）= 真未定义类型 → E0443。匿名 Unknown（var 无 init / 错误恢复，UnresolvedName=="")
        // 是级联抑制哨兵，放行不误报。
        if (resolved is Z42UnknownType) {
            Z42UnknownType u = resolved as Z42UnknownType;
            // "?" = 解析器名字位的错误恢复占位（Parser._badName，已报过 E0202）——同属级联抑制（fix-parser-error-cascade）。
            if (u.UnresolvedName != "" && u.UnresolvedName != "?") {
                string mns = symbols == null ? "" : symbols.MissingUsingNs(u.UnresolvedName);
                if (mns != "") { diags.Error(DiagnosticCodes.MissingUsing, SymbolTable.MissingUsingMsg(mns), sp); }   // A5b-2c：类型在、只是没 using
                else { diags.Error(DiagnosticCodes.UndefinedType, "undefined type: " + u.UnresolvedName, sp); }
            }
            return;
        }
        // access-top-scope：命名 delegate 的顶层作用域强制（与类同规则：private=本文件、
        // protected=本包 ∩ 同名 ns）。DeclVis 仅**本地显式** private/protected 时非空——匿名函数
        // 类型与导入重建实例恒空 ⇒ 放行，与既有行为逐字一致（跨包 protected delegate 的拒需
        // 导出携带可见性，v1 未做，见 access-control.md Deferred）。
        if (resolved is Z42FuncType) {
            Z42FuncType ft = resolved as Z42FuncType;
            if (ft.DeclVis == "private") {
                // 导入（DeclImported）无文件可比，一律拒；本地走文件比对。
                if (ft.DeclImported || TypeRefAccess._scopeKey(ft.DeclFile) != TypeRefAccess._scopeKey(sp.File)) {
                    diags.Error(DiagnosticCodes.AccessViolation,
                        "cannot access file-scoped private delegate `" + ft.DeclName + "`"
                        + (ft.DeclImported ? " (declared in another package)" : " (declared in another file)"), sp);
                }
            } else if (ft.DeclVis == "protected") {
                if (ft.DeclImported || ft.DeclNs != curNs) {
                    string hint = ft.DeclImported ? " from another package"
                        : " from " + (curNs == "" ? "the global namespace" : "namespace `" + curNs + "`");
                    diags.Error(DiagnosticCodes.AccessViolation,
                        "cannot access namespace-scoped protected delegate `" + ft.DeclName + "`" + hint, sp);
                }
            }
            return;
        }
        // 其余（prim/泛型形参/匿名 func）一律放行，绝不误报。
    }

    // 类/接口共用的可见性引用校验。kind："class"/"interface"（仅诊断措辞）。isImported=声明自依赖 zpkg（跨包）。
    // access-top-scope 新语义（outer=="" 即顶层声明）：
    //   private   → 文件作用域：引用点（sp.File）与声明点（declFile）同文件（_scopeKey 归一，REPL=会话）。
    //   protected → 本包 ∩ 同名命名空间（declNs==curNs 且非 imported）：空 ns 文件已在解析期拒（E0442）。
    // 嵌套（outer!=""）语义不变：private=外层类文本；protected=外层类家族。
    private static void _checkVisRef(string vis, string declName, bool isImported, string declNs, string declFile,
                                     string kind, string currentClass, string curNs,
                                     SymbolTable symbols, DiagnosticBag diags, Span sp) {
        if (vis == "public") { return; }
        string outer = TypeRefAccess._nestedOuter(declName);
        if (vis == "private") {
            if (outer == "") {
                // 顶层 private（access-top-scope）：文件作用域。
                if (TypeRefAccess._scopeKey(declFile) == TypeRefAccess._scopeKey(sp.File)) { return; }
                diags.Error(DiagnosticCodes.AccessViolation,
                    "cannot access file-scoped private " + kind + " `" + declName + "` (declared in another file)", sp);
                return;
            }
            if (currentClass == outer || currentClass.StartsWith(outer + "+")) { return; }
            TypeRefAccess._denyType("private", declName, kind, false, diags, sp);
            return;
        }
        if (vis == "protected") {
            if (outer == "") {
                // 顶层 protected（access-top-scope）：本包 ∩ 同名命名空间。
                if (!isImported && declNs == curNs) { return; }
                string hint = isImported ? " from another package"
                    : " from " + (curNs == "" ? "the global namespace" : "namespace `" + curNs + "`");
                diags.Error(DiagnosticCodes.AccessViolation,
                    "cannot access namespace-scoped protected " + kind + " `" + declName + "`" + hint, sp);
                return;
            }
            // 嵌套 protected：外层类家族（外层类 + 派生）。
            if (TypeRefAccess._derivesFromOrEq(outer, currentClass, symbols)) { return; }
            TypeRefAccess._denyType("protected", declName, kind, false, diags, sp);
            return;
        }
        // internal（含无修饰符顶层默认）：本包声明放行；imported（跨包）deny。
        if (!isImported) { return; }
        TypeRefAccess._denyType("internal", declName, kind, true, diags, sp);
    }

    // 嵌套类外层名（剥 '+' 末段）；顶层类（无 '+'）返回 ""。
    private static string _nestedOuter(string name) {
        int lp = -1;
        int i = 0;
        while (i < name.Length) { if (name.CharAt(i) == '+') { lp = i; } i = i + 1; }
        if (lp < 0) { return ""; }
        return name.Substring(0, lp);
    }

    // cur == target，或沿 cur 基链上溯能到 target（含隐式 Object）。target=="" / cur=="" → false（无家族）。
    private static bool _derivesFromOrEq(string target, string cur, SymbolTable symbols) {
        if (target == "" || cur == "") { return false; }
        bool more = true;
        while (more) {
            if (cur == target || SymbolTable.ShortNameOf(cur) == target) { return true; }   // 导入基类名是 FQ，同上
            Z42ClassType ct = symbols.GetClass(cur);
            if (ct == null) { more = false; }
            else if (ct.HasBase) { cur = ct.BaseName; }
            else if (cur != "Object" && symbols.HasClass("Object")) { cur = "Object"; }
            else { more = false; }
        }
        return false;
    }

    private static void _denyType(string vis, string declName, string kind, bool crossPkg, DiagnosticBag diags, Span sp) {
        string disp = declName.Replace("+", ".");   // 用户面用点号（Outer.Inner），内部键为 Outer+Inner
        string msg = "cannot access " + vis + " " + kind + " `" + disp + "`";
        if (crossPkg) { msg = msg + " from another package"; }
        diags.Error(DiagnosticCodes.AccessViolation, msg, sp);
    }

    // ── complete-class-access-control ②：不一致可访问性（C# CS0050 族） ──────────────────────────
    // declVis 的声明（成员/类型）在其签名/基类列表里**暴露**了 exposed 类型；若 exposed 比 declVis
    // 更低可见性 → E0441。可见性线性 rank：public 3 > internal 2 > protected 1 > private 0（design D2，
    // 完整 accessibility-domain 偏序 Deferred）。递归穿透泛型实例化（Def+每个实参）与数组元素；非
    // 类/接口类型（prim/泛型形参/func/void/未知）rank 视 public → 不触发（绝不误报）。
    public static void CheckExposure(string declVis, Z42Type exposed, SymbolTable symbols,
                                     DiagnosticBag diags, Span sp) {
        if (exposed is Z42InstantiatedType) {
            Z42InstantiatedType it = exposed as Z42InstantiatedType;
            TypeRefAccess.CheckExposure(declVis, it.Def, symbols, diags, sp);
            int i = 0;
            while (i < it.ArgCount) { TypeRefAccess.CheckExposure(declVis, it.TypeArgs[i], symbols, diags, sp); i = i + 1; }
            return;
        }
        if (exposed is Z42ArrayType) {
            TypeRefAccess.CheckExposure(declVis, (exposed as Z42ArrayType).Elem, symbols, diags, sp);
            return;
        }
        string exVis = "public";
        string exName = "";
        string exKind = "type";
        if (exposed is Z42ClassType) {
            Z42ClassType ct = exposed as Z42ClassType;
            if (ct.IsBuiltinType()) { return; }   // unify：基元 phantom class 恒 public，不算暴露
            exVis = ct.Visibility; exName = ct.Name(); exKind = "class";
        }
        else if (exposed is Z42InterfaceType) { Z42InterfaceType ift = exposed as Z42InterfaceType; exVis = ift.Visibility; exName = ift.Name(); exKind = "interface"; }
        // access-top-scope：命名 delegate 的暴露面——仅 DeclVis 非空（本地显式 private/protected）
        // 才按其 rank 判；匿名/导入函数类型维持「视作 public 不触发」的既有口径。
        else if (exposed is Z42FuncType) {
            Z42FuncType ft = exposed as Z42FuncType;
            if (ft.DeclVis == "") { return; }
            exVis = ft.DeclVis; exName = ft.DeclName; exKind = "delegate";
        }
        else { return; }
        if (TypeRefAccess._visRank(exVis) >= TypeRefAccess._visRank(declVis)) { return; }
        string disp = exName.Replace("+", ".");
        string msg = "inconsistent accessibility: " + exKind + " `" + disp + "` (" + exVis
                   + ") is less accessible than the exposing declaration (" + declVis + ")";
        diags.Error(DiagnosticCodes.InconsistentAccessibility, msg, sp);
    }

    // 可见性线性 rank（public 最高）；null / 未知安全默认 public（最高，绝不误报）。
    private static int _visRank(string vis) {
        if (vis == "private")   { return 0; }
        if (vis == "protected") { return 1; }
        if (vis == "internal")  { return 2; }
        return 3;
    }

    // 两者中更低可见性的那个（有效可访问性 = min(成员声明, 外层类)——镜像 C# effective accessibility；
    // `internal class` 内的 `public` 成员实际只 internal 可见，故暴露 internal 类型不算泄漏，绝不误报）。
    public static string MinVisibility(string a, string b) {
        return (TypeRefAccess._visRank(a) <= TypeRefAccess._visRank(b)) ? a : b;
    }
}
