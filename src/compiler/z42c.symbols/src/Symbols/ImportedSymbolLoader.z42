// 跨包符号加载（port-z42c-import CI-3）。镜像 C# ImportedSymbolLoader 的 Phase1/2 子集：
// TSIG ExportedModuleZ → 短名 Z42ClassType 骨架（Phase1）→ 成员填充（Phase2：实例+静态方法、
// 字段、自由函数）→ impl 合并（Phase3）。激活 = 全部候选包（prelude ∪ stdlib ∪ 声明依赖 ∪ 提供 using 的包），
// 与命名空间解耦：名字查找落到哪个包就用哪个包，可见性由命名空间规则另判（decouple-pkg-activation，见 Load）。
// 延后：Phase3 impl 合并 / 接口·委托·枚举 / 泛型实例化串解析 / E0601 冲突诊断。
namespace Z42.Semantics;

using Z42.IR;
using Z42.Package;   // IParallelTask
using Z42.Core;   // Span（导入接口的父接口形态包成 ResolvedTypeExpr 时要）
using Z42.Syntax;

// string 值盒（StrMap 存 object，prim 不能 `as string` 下行 → 包一层）。
public sealed class StrBox {
    public string Value;
    // 打包串（`a|b|c`）里的项数（perf-next-cluster）。只有经 `SymbolTable.NoteNsInto` 累积的那几张表
    // （ClassNsAll / ClassPkgAll / FuncOriginAll）会 >1；其余单值 box 恒为 1，读它无害。
    // 存在的理由：热路径（每个类型引用的 E0601/E0606 判据）只要「是不是只有一项」——
    // 从串上现算要么 Split（分配数组 + N 个子串）、要么 IndexOf（单项时必须扫完整串才能确定没有分隔符），
    // 实测两种都是 profile 前几名。写时记一次、读时读字段，才是 O(1)。
    public int Count;
    public StrBox(string value) { this.Value = value; this.Count = 1; }
}

// 加载产物（镜像 C# ImportedSymbols 子集）。
public sealed class ImportedSymbols {
    public StrMap FunctionsByFqn;   // `ns.name` → MethodSymbol（自由函数；resolve-free-functions-by-namespace：此前按裸名、同名跨 ns 塌成一份）
    // add-bare-name-ambiguity-diagnostic：短名 → **全部**声明 ns（"|" 连接，加载序）。每个 active 模块都记一笔
    // （歧义判据 / 诊断指路用）。
    public StrMap ClassNsAll;
    // enforce-fqn-name-identity 阶段 2：接口短名 → **全部**声明 ns（对称 ClassNsAll，同样在
    // first-wins/last-wins 之外累积）。见 SymbolTable.IfaceNsAll 抬头。
    public StrMap IfaceNsAll;
    // 导入类的唯一登记表（对称 SymbolTable.ClassesByFqn）：键 = `<ns>.<clKey>`（clKey 已含条件 arity-mangle；
    // 全局 ns 即 clKey）。同 FQN 跨模块 first-wins。fqn-tables 5 起不再有按短名键的 `Classes` / `Interfaces`。
    public StrMap ClassesByFqn;
    // report-crosspkg-duplicate-type：**FQN → 声明它的全部包名**（值 StrBox，"|" 连接）。
    // 与 ClassNsAll 同一手法——在 first-wins 守卫**之外**累积，因为守卫之内只有赢家能进，
    // 而「有几个包声明了这个 FQN」恰恰是守卫塌掉的那个信息。类/接口/enum 共用一张表
    // （三者的 FQN 本就在同一个命名空间里，不会互相误命中）。
    public StrMap ClassPkgAll;
    // report-crosspkg-duplicate-function：自由函数名 → 全部来源（"ns#pkg"，"|" 连接）。
    // 与 ClassPkgAll 同一手法——在 first-wins 守卫**之外**累积。自由函数比类更糊：`Functions`
    // 的键是**裸名**（`ExportedFuncZ.Name` 就是 `md.Name`，没有 ns），连 FQN 视图都没有。
    public StrMap FuncOriginAll;
    public StrMap InterfacesByFqn;
    public StrMap EnumTypeNamesByFqn;   // FQN → "enum"
    public StrMap EnumConsts;       // "EnumFqn.Member" → StrBox(long 值)（镜像 SymbolTable.EnumConsts，键同为 FQN）
    public StrMap DelegatesByFqn;   // FQN → Z42FuncType（导入的用户 delegate；SymbolCollector 并进 SymbolTable.Delegates）
    // add-associated-types PR-1：导入类的 where 约束（键 = 类的 FQN 键，即 ClassesByFqn 的键，
    // 与 SymbolTable.ClassConstraintKey 口径一致）→ ConstraintSet。
    public StrMap Constraints;
    // fix-crosspkg-ns-reachability：依赖契约三件套的**搬运载体**。放在这里而不是给
    // `BuildPackageCus` 加参：本类已经是「跨包信息进符号表」的唯一通道（ClassPkgAll 就走这条），
    // 而改签名要动十几个调用点。由 `SymbolCollector._mergeImports` 并进 SymbolTable。
    public StrMap DeclaredDeps;
    public string SelfPkg;
    public bool   EnforceDeclaredDeps;
    public ImportedSymbols() {
        this.Constraints = new StrMap();
        this.FunctionsByFqn = new StrMap();
        this.ClassNsAll = new StrMap();
        this.IfaceNsAll = new StrMap();   // enforce-fqn-name-identity 阶段 2
        this.ClassesByFqn = new StrMap();          // unify-type-identity-fqn
        this.ClassPkgAll = new StrMap();           // report-crosspkg-duplicate-type
        this.DeclaredDeps = new StrMap();          // fix-crosspkg-ns-reachability
        this.SelfPkg = "";
        this.EnforceDeclaredDeps = false;
        this.FuncOriginAll = new StrMap();         // report-crosspkg-duplicate-function
        this.InterfacesByFqn = new StrMap();       // unify-type-identity-fqn
        this.EnumTypeNamesByFqn = new StrMap();    // unify-type-identity-fqn
        this.EnumConsts = new StrMap();
        this.DelegatesByFqn = new StrMap();
    }
}

public static partial class ImportedSymbolLoader {

    // add-associated-types PR-1：导入类的 IrConstraintDesc[]（IR 侧，与 zbc flag 位对应）
    // → ConstraintSet（语义侧，ConstraintChecker.Check 直接消费的形态）。无约束返回 null。
    //
    // 这是「跨包约束校验」链路的最后一段。上游：ZbcWriter 置全 bit → ZbcReader 读回
    // IrConstraintDesc → TsigReconcile 搬进 ExportedClassZ → 此处 → SymbolTable.ClassConstraints。
    // bundle 里的接口名/基类名是**裸名**，与本包路径（ConstraintChecker._fillBundle 存 nt.Name）
    // 同一口径，故 _satisfiesInterface / _satisfiesBase 对本包与导入类型的判定完全一致。
    private static ConstraintSet _constraintSetOf(ExportedClassZ cl) {
        if (cl.TpConstraintCount <= 0 || cl.TypeParamConstraints == null) { return null; }
        int pc = cl.TpCount;
        if (pc <= 0) { return null; }
        ConstraintBundle[] bundles = new ConstraintBundle[pc];
        int i = 0;
        while (i < pc) { bundles[i] = new ConstraintBundle(); i = i + 1; }
        int n = pc;
        if (cl.TpConstraintCount < n) { n = cl.TpConstraintCount; }
        bool any = false;
        int k = 0;
        while (k < n) {
            IrConstraintDesc d = cl.TypeParamConstraints[k];
            if (d != null) {
                ConstraintBundle b = bundles[k];
                b.RequiresClass  = d.RequiresClass;
                b.RequiresStruct = d.RequiresStruct;
                if (d.BaseClass != "") { b.HasBaseClass = true; b.BaseClassName = d.BaseClass; }
                if (d.TypeParamConstraint != "") { b.HasTypeParamRef = true; b.TypeParamRef = d.TypeParamConstraint; }
                b.RequiresCtor = d.RequiresCtor;
                b.RequiresEnum = d.RequiresEnum;
                int j = 0;
                while (j < d.InterfaceCount) { b.AddInterface(d.Interfaces[j]); j = j + 1; }
                // 关联类型绑定（zbc 1.42，assoc-type-crosspkg）：`where T:IEnum<Item=int>` 经 bit7 恢复
                // → ConstraintBundle.AssocBinding*，供 ConstraintChecker 使用点跨包匹配（删 IsImported 守卫）。
                int ab = 0;
                while (ab < d.AssocBindingCount) { b.AddAssocBinding(d.AssocBindingNames[ab], d.AssocBindingTypeNames[ab]); ab = ab + 1; }
                if (!b.IsEmpty()) { any = true; }
            }
            k = k + 1;
        }
        if (!any) { return null; }
        string[] pnames = cl.TypeParams;
        if (pnames == null) { pnames = new string[0]; }
        return new ConstraintSet(pnames, bundles, pc);
    }

    // exported/pkgNames 平行（DepScan 产物）；usings = cu 的 using ns 列表。
    // parentPkg（z42b-owns-test-targets）：本次编译若是 <parentPkg> 的测试/bench 目标，加载该包时
    // 按**同包**待遇 —— 不设 IsImported ⇒ 其 internal 成员可见。其余依赖照旧跨包。`""` = 现状。
    // 为什么这样就够：导出端不按可见性过滤、导入端也不过滤 ⇒ internal 成员**本来就完整在 zpkg 里**，
    // 跨包拦截只靠 IsImported 这一个布尔（AccessChecker:40）。故零格式改动、AccessChecker 一行不改。
    public static ImportedSymbols Load(ExportedModuleZ[] exported, string[] pkgNames, int exportedCount,
                                       string[] usings, int usingCount) {
        return ImportedSymbolLoader.Load(exported, pkgNames, exportedCount, usings, usingCount, "");
    }

    public static ImportedSymbols Load(ExportedModuleZ[] exported, string[] pkgNames, int exportedCount,
                                       string[] usings, int usingCount, string parentPkg) {
        return ImportedSymbolLoader.Load(exported, pkgNames, exportedCount, usings, usingCount, parentPkg, new string[0], 0);
    }

    // allowedDeps：本包声明的依赖名。stdlib（`z42.` 前缀）恒为候选，不必列。
    public static ImportedSymbols Load(ExportedModuleZ[] exported, string[] pkgNames, int exportedCount,
                                       string[] usings, int usingCount, string parentPkg,
                                       string[] allowedDeps, int allowedCount) {
        var r = new ImportedSymbols();
        // ── 激活集与建表序（`_activationOrder`，LoadPhases 分片）：第 0 档 = 旧口径 prelude ∪ 提供 using 的包，
        // 第 1 档 = 其余候选（先 0 档后 1 档建表 ⇒ 短名 first-wins 与 arity-mangle 对第 0 档逐字节不变）。
        bool[] tier0 = new bool[exportedCount];
        bool[] active = new bool[exportedCount];   // prescan 的 impMultiAll（全体候选）还要看它
        int orderN = 0;
        int[] order = ImportedSymbolLoader._activationOrder(exported, pkgNames, exportedCount, usings, usingCount,
            allowedDeps, allowedCount, tier0, active, ref orderN);
        int i = 0;   // 后续各相位循环共用的槽位（函数级槽位语义，与拆分前同款）
        int oi = 0;
        // ── Pre-scan：检测 imported 同名不同 arity 的类，泛型版需 arity-mangle（镜像 local
        // SymbolCollector pre-scan + C# NeedsMangle）。否则 arity-0 base 与 arity-N 泛型
        // （如 MulticastException / MulticastException<TResult>）撞键 → first-wins 丢泛型 →
        // new/throw/catch `C<int>` 误取 base → 运行期类型失配。
        // 两张表：第 0 档只看第 0 档（其判定与旧口径逐字节一致），第 1 档的类看全体。
        StrMap impMultiArity = ImportedSymbolLoader._multiArity(exported, exportedCount, tier0);
        StrMap impMultiAll   = ImportedSymbolLoader._multiArity(exported, exportedCount, active);
        // ── Phase1：骨架（短名 → 空成员 Z42ClassType + 接口名表）── 单模块实现见 LoadPhases 分片
        //（类 / 接口 / 枚举三段：`_skeletonClasses` / `_skeletonInterfaces` / `_skeletonEnums`）。
        oi = 0;
        while (oi < orderN) {
            i = order[oi];
            ExportedModuleZ em = exported[i];
            ImportedSymbolLoader._skeletonClasses(r, em, pkgNames[i], tier0[i], impMultiArity, impMultiAll, parentPkg);
            ImportedSymbolLoader._skeletonInterfaces(r, em, pkgNames[i], parentPkg);
            ImportedSymbolLoader._skeletonEnums(r, em, pkgNames[i], parentPkg);
            oi = oi + 1;
        }
        // ── Phase2：成员填充（骨架齐备后解析类型可互指）──
        // 类成员先填（perf-parallel-import-fill）：`_fillClass` 只读 Phase1 建好的表、只写它自己那个类对象，
        // 类与类之间互不依赖 ⇒ 按「类」分组并行（同一个类的多份——partial 跨模块——同组、保原序，由一个任务
        // 独占）。先收集再一次 ParallelFor；收集序 = 原逐模块序，所以每个类拿到的成员与登记顺序和串行逐字节一致。
        // 委托 / 自由函数 / 接口方法不依赖已填的类成员（`_resolve` 只查骨架表），仍在下面逐模块串行。
        ClassFillTask fill = new ClassFillTask(r);
        oi = 0;
        while (oi < orderN) {
            i = order[oi];
            ExportedModuleZ fem = exported[i];
            int c = 0;
            while (c < fem.ClassCount) {
                ExportedClassZ cl = fem.Classes[c];
                bool needsMangle = cl.TpCount > 0 && (tier0[i] ? impMultiArity : impMultiAll).ContainsKey(cl.Name);
                string clKey = needsMangle ? (cl.Name + "$" + cl.TpCount.ToString()) : cl.Name;
                string fqnKey = fem.Namespace == "" ? clKey : fem.Namespace + "." + clKey;
                // 填进 Phase1 为这个 FQN 建的那一份（同 FQN 多份时 first-wins 只建一份）。同一个类的多份
                // （partial 跨模块）按 fqnKey 分进同一组、保原序。不看短名表的赢家是谁。
                Z42ClassType ct = r.ClassesByFqn.Get(fqnKey) as Z42ClassType;
                if (ct != null) { fill.Add(fqnKey, ct, cl); }
                c = c + 1;
            }
            oi = oi + 1;
        }
        ParallelFor.Run(fill.GroupCount, ParallelConfig.Jobs(fill.GroupCount), fill);
        oi = 0;
        while (oi < orderN) {
            i = order[oi];
            ExportedModuleZ em = exported[i];
            ImportedSymbolLoader._fillDelegatesAndFunctions(r, em, pkgNames[i], parentPkg);   // delegate + 自由函数（LoadPhases 分片）
            ImportedSymbolLoader._fillInterfaceMethods(r, em);   // imported 接口方法 + 父接口实参（LoadPhases 分片）
            oi = oi + 1;
        }
        // ── Phase3：impl 合并（L3-Impl2；镜像 C# MergeImpls）——方法并入 imported target，trait 入其接口集 ──
        i = 0;
        while (i < exportedCount) {
            if (tier0[i]) {
                ExportedModuleZ em = exported[i];
                int c = 0;
                while (c < em.ImplCount) {
                    ImportedSymbolLoader._mergeImpl(r, em.Impls[c]);
                    c = c + 1;
                }
            }
            i = i + 1;
        }
        return r;
    }

    // 单条 impl 合并到 imported target class（镜像 C# MergeImpls 内层）。
    private static void _mergeImpl(ImportedSymbols r, ExportedImplZ im) {
        string targetShort = ImportedSymbolLoader._shortName(im.TargetFq);
        if (targetShort == "") { return; }
        // A5b-2c：target / trait 都按 IMPL 段里的 **FQ** 走 —— 剥成短名后，trait 进了 `InterfaceNames` 也只能靠
        // 已删的裸名回落归一（根表上 `IGreet` 查不到 `Demo.Target.IGreet`），`Implements` 便与它失配。
        // target 不在 FQN 视图 = 不在 import 集 → 跳过（不再剥短名去撞别的 ns 的同名类；fqn-tables 3b：全量 GREEN 0 命中）。
        Z42ClassType ct = r.ClassesByFqn.Get(im.TargetFq) as Z42ClassType;
        if (ct == null) { return; }
        string traitShort = ImportedSymbolLoader._shortName(im.TraitFq);
        if (traitShort == "") { return; }
        string traitName = ImportedSymbolLoader._fqTrimTypeArgs(im.TraitFq);
        // 注：不校验 r.Interfaces.ContainsKey(traitShort)——z42c 不 import 接口进表（会破坏
        // stdlib byte-identical），且 impl 块由生产端（greeter 编译期）已校验 trait 合法性。
        // 方法并入 target.Methods（first-wins）+ 实例方法入 OwnMethod 有序元数据
        int m = 0;
        while (m < im.MethodCount) {
            ExportedMethodZ me = im.Methods[m];
            if (!ct.Methods.ContainsKey(me.Name)) {
                // R1：trait-impl 方法的方法级型参（此前不喂 → 同款降级）。
                string[] etps = ImportedSymbolLoader._tpsWith(new string[0], 0, me.TypeParams);
                int etpc = etps.Length;
                Z42Type[] ps = new Z42Type[me.ParamCount];
                int j = 0;
                while (j < me.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, me.Params[j].TypeName, etps, etpc); j = j + 1; }
                var sig = new Z42FuncType(ps, me.ParamCount, ImportedSymbolLoader._resolve(r, me.ReturnType, etps, etpc));
                sig.ParamsFrom = me.ParamsFrom;
                ImportedSymbolLoader._fillParamMeta(sig, me.Params, me.ParamCount, me.RefInfoKnown, me.RetIsNullable);   // PR6：跨包默认值/ caller
                var sym = new MethodSymbol(me.Name, me.Visibility, sig, me.IsStatic, ct.Name(), false, null);
                sym.IsSealed = me.IsSealed;   // impl-sealed-semantics-devirt：跨包方法级 sealed（override 强制）
                sym.IsDeprecated = me.IsDeprecated; sym.DeprecationMsg = me.DeprecationMsg;   // add-deprecated-directive：跨包方法级弃用
                sym.TypeParamCount = me.TypeParamCount;   // add-array-paired-sort：跨包方法级泛型形参个数，供 arity 重载过滤
                sym.TypeParamNames = ImportedSymbolLoader._tpNames(me.TypeParams);   // fix-explicit-type-arg-not-substituted
                ct.Methods.Put(me.Name, sym);
                if (!me.IsStatic) { ct.AddOwnMethod(me.Name, me.IsVirtual, me.IsAbstract); }
            }
            m = m + 1;
        }
        // trait 并入 target 接口集（去重：AddInterfaceName 不查重 → 此处先查）
        //
        // 🔴 **B3 刻意不改成句柄比较，这不是漏网**：`_mergeImpl` 跑在 `_mergeImports` 之前、
        // 更在 `BindTypeRefs` 之前 ⇒ `ct.Interfaces[]` 全是 0（未绑定），换句柄会恒判「未见过」
        // ⇒ 重复并入。**这个相位只有名字可用。**（对称的一处：`StubCollector._ctHasIface`。）
        bool seen = false;
        int ix = 0;
        while (ix < ct.InterfaceCount) { string inm = ct.InterfaceNames[ix]; if (inm == traitName || inm == traitShort) { seen = true; } ix = ix + 1; }
        if (!seen) { ct.AddInterfaceName(traitName); }
    }

    // FQ "Demo.Target.Robot" → 短名 "Robot"（无点 → 原串）。镜像 C# SplitFqName 取 ShortName。
    private static string _shortName(string fq) {
        if (fq == "") { return ""; }
        int dot = 0 - 1;
        int i = 0;
        while (i < fq.Length) { if (fq.CharAt(i) == '.') { dot = i; } i = i + 1; }
        if (dot < 0) { return fq; }
        return fq.Substring(dot + 1, fq.Length - dot - 1);
    }

    // fix-crosspkg-iface-basenames + enforce-fqn-name-identity B2.5：
    // `Std.IComparable<Std.String>` → `Std.IComparable`。**只截泛型实参，保留命名空间。**
    //
    // 🔴 此前这里还顺手剥了短名（`→ IComparable`），理由是「与本包侧 `_addIfaceBases` 的裸名
    // 约定对齐」。那个约定已经没了 —— 归一 pass `StubCollector._qualifyIfaceBases` 把两侧的
    // `BaseNames` 都转成 FQ，对齐点从「都是裸名」变成了「都是 FQ」。继续剥的后果是**静默错值**，
    // 与类轴那条（`TsigReconcile._rebuildClass`）一模一样，只是走的是 BFS 的父链那半：
    //
    //   包 A  `interface IParent {...}` / `interface IChild : IParent` / `class Impl : IChild`
    //   主包  另声明一个同短名、成员不同的 `IParent`，然后 `IParent p = new Impl();`
    //
    // `Impl.InterfaceNames` 是生产端展开的**传递闭包**且已是 FQ ⇒ `Implements` 第一层比不中
    // ⇒ 落到 `SymbolTable._anyInterfaceDerivesFrom`，它把 `it.BaseNames[b]` 直接入队再比 target。
    // 剥名后的 `IChild.BaseNames = ["IParent"]` 被归一猜成**本地**那个 ⇒ 命中 ⇒ 静默放行，
    // 运行期才炸 `VCall: Demo.IfBase.Impl.Q not found`。
    // ⇒ 保留 ns 之后，猜这一步连同它的错误答案一起消失。
    //
    // ⚠️ 截 `<` 的顺序仍然要紧：先截实参再动 ns —— 反了的话「最后一个点」会落进实参里
    // （`Std.IComparable<Std.String>` → `String>`）。现在不剥短名了，这条只剩「先截」一半，
    // 但别把 `Substring` 的边界改掉。
    private static string _fqTrimTypeArgs(string fq) {
        int lt = fq.IndexOf('<');
        if (lt < 0) { return fq; }
        return fq.Substring(0, lt);
    }

    // add-argument-type-check R1：类/接口级型参 ∪ **方法级**型参 → `_resolve` 的型参表。
    // 此前只喂类级（`_fillClass` 的 tps）或压根不喂（接口方法 / trait-impl 方法 / 自由函数），
    // 于是 `Array.Copy<T>(T[],T[],int)`、`IBasicCollection<T>.AddOne(T)` 这类签名里的 `T` 落到
    // `_resolve` 末尾的 `Z42ClassType.Builtin(name)` 兜底 → **型参身份丢失**（成了名为 "T" 的普通类）
    // ⇒ `Conversion._classifyBuiltin` 分支 B「恰一侧泛型形参 → 擦除放行」永不触发。
    // 合并而非替换：类级与方法级可同时在场（`class C<T> { void M<U>(T t, U u) }`）。
    // fix-explicit-type-arg-not-substituted：方法级型参名的**非空**视图。
    // `_tpsWith` 合并的是「类级 ∪ 方法级」（解析签名时的可见型参上下文），而按显式类型实参
    // 代换签名时**只能**按方法级的那几个名字代——把类级也代进去会把 `Box<T>.Put(T)` 的 T
    // 当成方法级型参换掉。故这里单独取 `me.TypeParams`，不复用 `_tpsWith` 的结果。
    private static string[] _tpNames(string[] tps) {
        if (tps == null) { return new string[0]; }
        return tps;
    }

    private static string[] _tpsWith(string[] outer, int outerCount, string[] methodTps) {
        int mc = 0;
        if (methodTps != null) { mc = methodTps.Length; }
        if (mc == 0) { return outer == null ? new string[0] : outer; }
        int oc = outerCount;
        if (outer == null) { oc = 0; }
        string[] merged = new string[oc + mc];
        int i = 0;
        while (i < oc) { merged[i] = outer[i]; i = i + 1; }
        int k = 0;
        while (k < mc) { merged[oc + k] = methodTps[k]; k = k + 1; }
        return merged;
    }

    internal static void _fillClass(ImportedSymbols r, Z42ClassType ct, ExportedClassZ cl) {
        string[] tps = cl.TypeParams;
        int tpc = cl.TpCount;
        int i = 0;
        while (i < cl.FieldCount) {
            ExportedFieldZ fd = cl.Fields[i];
            if (!ct.Fields.ContainsKey(fd.Name)) {
                FieldSymbol fsym = new FieldSymbol(fd.Name, fd.Visibility,
                    ImportedSymbolLoader._resolve(r, fd.TypeName, tps, tpc), fd.IsStatic, ct.Name());
                fsym.IsDeprecated = fd.IsDeprecated; fsym.DeprecationMsg = fd.DeprecationMsg;   // add-deprecated-directive：跨包字段级弃用
                fsym.IsNullable = fd.IsNullable;   // carry-field-null-marks：跨包字段 / 属性的 `?` 标记（缺席 = 不强制）
                ct.Fields.Put(fd.Name, fsym);
                // G18-import：实例字段入 OwnField* 有序元数据（TSIG 继承字段展开；static 不入，同本地 _fillClass）。
                // fix-generic-struct-chain-access：拼写须与本地 `MemberCollector` **同一口径**（`SurfaceTypeName`
                // 已解析类型 = 短名形式，解析失败才回落原串）。导出元数据里的 `fd.TypeName` 是 FQ
                // （`Demo.StructTarget.Point`），而 `StructLayout` 按符号表裸名键判「字段是不是 struct」⇒ 照搬 FQ
                // 会把导入 struct 里的嵌套 struct 字段当成 8B 引用叶子：布局与生产方错位、读写静默错值
                // （只有嵌套 struct 恰好 8B 时偏移碰巧重合——`struct_cross_pkg` 的 `Point{int,int}` 正是如此）。
                if (!fd.IsStatic) {
                    string fsp = (fsym.FieldType is Z42UnknownType || fsym.FieldType is Z42ErrorType)
                        ? fd.TypeName : TypeNameResolver.SurfaceTypeName(fsym.FieldType);
                    ct.AddOwnField(fd.Name, fsp, fd.Visibility);
                }
            }
            i = i + 1;
        }
        ct.Methods.EnsureCapacity(cl.MethodCount);   // perf-strmap：导入方法数已知，一次到位
        i = 0;
        while (i < cl.MethodCount) {
            ExportedMethodZ m = cl.Methods[i];
            if (!ct.Methods.ContainsKey(m.Name)) {              // bare+arity 键并存，bare first-wins
                // R1：类级 tps ∪ 方法级 m.TypeParams（`Array.Copy<T>` 是「类无型参 + 方法级型参」）。
                string[] mtps = ImportedSymbolLoader._tpsWith(tps, tpc, m.TypeParams);
                int mtpc = mtps.Length;
                Z42Type[] ps = new Z42Type[m.ParamCount];
                int j = 0;
                while (j < m.ParamCount) { ps[j] = ImportedSymbolLoader._resolve(r, m.Params[j].TypeName, mtps, mtpc); j = j + 1; }
                var sig = new Z42FuncType(ps, m.ParamCount, ImportedSymbolLoader._resolve(r, m.ReturnType, mtps, mtpc));
                sig.ParamsFrom = m.ParamsFrom;
                ImportedSymbolLoader._fillParamMeta(sig, m.Params, m.ParamCount, m.RefInfoKnown, m.RetIsNullable);   // PR6：跨包默认值/ caller（静态+实例主路径）
                // z42c 既有约定：静态/实例同进 Methods（IsStatic 标真值）——D3
                // add-type-based-overloads：symbol.Name = 源名（首个 $ 前），RegKey = 完整注册键
                //   → OverloadsOf(源名) 跨包候选枚举一致（同本地）；调用方决议返回 RegKey 派发。
                // 同一个 m.Name 原来在本次迭代里被 _dollarAt 算了两遍（这里与下面注册 bare 键处）。
                int srcDol = ImportedSymbolLoader._dollarAt(m.Name);
                string srcName = (srcDol >= 0) ? m.Name.Substring(0, srcDol) : m.Name;
                var sym = new MethodSymbol(srcName, m.Visibility, sig, m.IsStatic, ct.Name(), false, null);
                sym.RegKey = m.Name;
                sym.IsSealed = m.IsSealed;   // impl-sealed-semantics-devirt：跨包方法级 sealed（override 强制）
                sym.IsDeprecated = m.IsDeprecated; sym.DeprecationMsg = m.DeprecationMsg;   // add-deprecated-directive：跨包方法级弃用
                sym.TypeParamCount = m.TypeParamCount;   // add-array-paired-sort：跨包方法级泛型形参个数，供 arity 重载过滤
                sym.TypeParamNames = ImportedSymbolLoader._tpNames(m.TypeParams);   // fix-explicit-type-arg-not-substituted
                ct.Methods.Put(m.Name, sym);
                // G18-import：实例方法入 OwnMethod* 有序元数据（TSIG 方法继承展开；static 不入）。
                if (!m.IsStatic) { ct.AddOwnMethod(m.Name, m.IsVirtual, m.IsAbstract); }
                // 重载 arity 后缀（"Substring$2"）→ 同时注册 bare 键 first-wins（镜像 C# Phase2）
                if (srcDol >= 0) {
                    string bare = srcName;
                    if (!ct.Methods.ContainsKey(bare)) { ct.Methods.Put(bare, sym); }
                }
            }
            i = i + 1;
        }
    }

    // `String.IndexOf(char)` 已是 bulk char[] 版（ToCharArray 一次 + ArrayGet 扫）；原来这里
    // 手写的循环每字符要 `s.Length` + `s.CharAt(i)` 两次 builtin 分发。
    private static int _dollarAt(string s) { return s.IndexOf('$'); }

    // PR6：把 ExportedParamZ 的 DefaultBlob / CallerKind 填进 Z42FuncType（跨包默认值/ caller 宏传播）。
    // fix-crosspkg-named-args：同批填形参**源名**（命名实参跨包归位用；来源是 SIGS 的 name_str_idx）。
    // pz 已是逻辑参数序（TsigReconcile._params 跳 this 槽）→ 与 sig.ParamTypes 对齐。
    // record-ref-in-signature：`known` = 该方法的 ref 信息是否写全了（`$RefSig` 完备性标记）。
    // **旧包传 false** ⇒ `HasRefInfo()` 为假 ⇒ 对称性检查整条跳过。不能省略这个参数按
    // 「ParamIsRef 全 false」推断——那会把旧包判成「已知全非 ref」，让引用未重编旧包、
    // 且写了 `F(ref v)` 的调用点被成批误报 E0473。见 record-ref-in-signature 的 design §D2。
    private static void _fillParamMeta(Z42FuncType sig, ExportedParamZ[] pz, int count, bool known, bool retMarked) {
        string[] defs = new string[count];
        string[] cls = new string[count];
        string[] names = new string[count];
        bool[] refs = new bool[count];
        // define-null-check-marks 3.3：跨包 `?` 标记。发射端早就把它写进 TSIG 了
        // （`TypeNameResolver._hybridTypeName` 对 `NullableType` 追加 `?`），只是加载侧
        // `_resolve` 把后缀当垃圾剥掉、标记位一位不还原 ⇒ **跨过包边界义务就没了**。
        // stdlib 对用户代码就是跨包，不补这一截，「标注 stdlib 的『可能没有』API」等于白标。
        bool[] nulls = new bool[count];
        int i = 0;
        while (i < count) {
            defs[i] = pz[i].DefaultBlob; cls[i] = pz[i].CallerKind; names[i] = pz[i].Name; refs[i] = pz[i].IsRef;
            nulls[i] = ImportedSymbolLoader._nullableMark(pz[i].IsNullable, sig.ParamTypes[i]);
            i = i + 1;
        }
        sig.ParamDefaults = defs; sig.ParamCallers = cls; sig.ParamNames = names;
        sig.ParamIsRef = refs; sig.RefInfoKnown = known;
        sig.ParamIsNullable = nulls;
        sig.RetIsNullable = ImportedSymbolLoader._nullableMark(retMarked, sig.Ret);
    }

    // 跨包 `?` 标记位。**唯一来源是哨兵**（`$Nullable` 逐形参 / `$RetNullable` 方法级），
    // 走 param/method attr-ref 旁路通道。
    //
    // 🔴 **绝不能改看类型拼写**（我栽过一次，8 处误报）：`"?"` 在这套代码里是**「类型未知」
    // 占位串**——`this` 槽（`FunctionEmitter:62/391`）、lift 形参（`:398`）、SIGS 缺名回落
    // （`TsigReconcile._params:630`）都写它。拿 `EndsWith("?")` 当判据，这些占位全被认成
    // 「标了 `?`」，`string.Substring` / `Path.Normalize` 这类根本没标的成员一律变可空
    // ⇒ 自举当场崩。**同一个字符在两套语境里含义相反**，这是 D3 零容忍的那类误报。
    //
    // 另一面：SIGS 的类型拼写里本来也**没有**真标记可读 —— `FunctionEmitter._sigTypeName`
    // 历来剥 `?`，因为那串同时是**派发键**，塞 `?` 会改键。所以旁路是唯一的路。
    //
    // **不需要 `ref` 那样的「已知」位**：`?` 的语义是「请编译器在这里强制检查」，
    // **缺席 = 不强制**（不是「保证非空」），所以旧包读不出哨兵时落成 false 恰好正确。
    //
    // ⚠️ 值类型不置位，且**复用 `TypeChecker._isNonNullableValueType`、不另写一份判据**
    // （「编译期与运行期各判各的」正是 `where T : struct` 那个 bug 的形状）。
    private static bool _nullableMark(bool marked, Z42Type resolved) {
        if (!marked) { return false; }
        if (TypeFacts.IsNonNullableValueType(resolved)) { return false; }
        return true;
    }

    private static bool _isPrelude(string pkg) { return pkg == "z42.core"; }

    // 依赖候选：stdlib（`z42.` 前缀；`z42c.*` 不算）或本包声明的依赖（与 DepIndex 准入 `_allowedForIndex` 同口径）。
    private static bool _allowedDep(string pkg, string[] allowed, int count) {
        if (pkg.StartsWith("z42.")) { return true; }
        int i = 0;
        while (i < count) { if (allowed[i] == pkg) { return true; } i = i + 1; }
        return false;
    }

    // 同短名不同 arity 的导入类名集（泛型版需 arity-mangle，镜像本地 SymbolCollector pre-scan + C# NeedsMangle）。
    // 否则 arity-0 base 与 arity-N 泛型（如 MulticastException / MulticastException<TResult>）撞键 → first-wins
    // 丢泛型 → new/throw/catch `C<int>` 误取 base → 运行期类型失配。只统计 `on[i]` 的模块。
    private static StrMap _multiArity(ExportedModuleZ[] exported, int count, bool[] on) {
        StrMap first = new StrMap();
        StrMap multi = new StrMap();
        int i = 0;
        while (i < count) {
            if (on[i]) {
                ExportedModuleZ pem = exported[i];
                int pc = 0;
                while (pc < pem.ClassCount) {
                    ExportedClassZ pcl = pem.Classes[pc];
                    string arStr = pcl.TpCount.ToString();
                    if (first.ContainsKey(pcl.Name)) {
                        StrBox fa = first.Get(pcl.Name) as StrBox;
                        if (fa.Value != arStr) { multi.Put(pcl.Name, "1"); }
                    } else { first.Put(pcl.Name, new StrBox(arStr)); }
                    pc = pc + 1;
                }
            }
            i = i + 1;
        }
        return multi;
    }

    // 包是否提供 usings 中任一 ns（按该包全部 TSIG 模块的 ns 判断）。
    private static bool _pkgProvidesUsing(ExportedModuleZ[] exported, string[] pkgNames, int count,
                                          string pkg, string[] usings, int usingCount) {
        int i = 0;
        while (i < count) {
            if (pkgNames[i] == pkg) {
                int u = 0;
                while (u < usingCount) {
                    if (exported[i].Namespace == usings[u]) { return true; }
                    u = u + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }
}
