// 测试 / bench attribute 的编译期校验（E0911–E0917）：`[Test]` / `[Benchmark]` / `[Setup]` / `[Teardown]` 的
// 位置与签名，`[Skip]` / `[Ignore]` / `[Timeout]` / `[ShouldThrow]` 的实参与孤儿使用。由 SymbolCollector 在
// 符号收集期驱动（形状校验纯语法；ShouldThrow 的异常类型链查符号表）。
//
// 编译侧只做这层校验——测试由 runner 在运行期反射发现（docs/internals/src/testing/framework.md）。
//名字表（哪些 attribute 属测试家族）只在 HandlerRegistry。
namespace Z42.Semantics;
using Z42.IR;       // StrMap
using Z42.Syntax;
using Z42.Core;
using Z42.IR.BinaryFormat;   // ZbcInstr._parseIntLit（[Timeout] 的整数字面量）

internal sealed class TestAttrEnforcer {
    private SymbolCollector _sc;   // hub 反向引用：Diags / 共享辅助
    public TestAttrEnforcer(SymbolCollector sc) { this._sc = sc; }

    // ── [Test] 家族的位置 + 签名强制（fix-test-attr-placement）──────────────────────────────
    // 补回自举迁移中丢失的 TestAttributeValidator（E0911/E0912/E0915）：那套校验随 C# 编译器退休
    // 一起被删、从未移植到 z42c，而 docs/reference/src/appendix/error-codes.md 至今写着「已启用」。
    // 后果：`[Test]` 贴实例方法编译期全绿 → runner 反射发现后无接收者调用 → 运行期才炸，且症状指不回病灶。
    //
    // 五条规则（全纯语法，不查符号表 → 与 E0444/E0445/E0447 同级、first-pass 可用）：
    //   R1 零接收者：顶层自由函数 或 static 方法      R4 非泛型
    //   R2 返回 void                                   R5 有方法体
    //   R3 无参数 —— 唯一例外：`[Benchmark]` 可取恰好一个 `Bencher` 形参（runner 建好传入，
    //      见 z42.harness `TestCase.Invoke`）。按短名做语法匹配，与 runner 认的形状一致。
    internal void _passTestAttrEnforce(CompilationUnit cu) {
        int i = 0;
        while (i < cu.DeclCount) {
            this._teWalk(cu.Decls[i], "");
            i = i + 1;
        }
    }

    // 递归下降：顶层 → 类成员（含嵌套类型）→ impl 块方法。
    // owner = 外层类型名（"" = 顶层），只用于诊断消息里的限定名。
    private void _teWalk(Decl raw, string owner) {
        // ① 本节点若是「带 attribute 的方法」，先查它。
        if (raw is AttributedDecl) {
            AttributedDecl ad = raw as AttributedDecl;
            if (ad.Inner is MethodDecl) { this._teCheck(ad, ad.Inner as MethodDecl, owner); }
            this._teOrphanCheck(ad);   // 修饰类 attr 无 kind attr 相伴（E0914），不限于方法
        }
        // ② 再下沉到容器（AttributedDecl 也可能包着 ClassDecl，故先 _unwrap）。
        Decl d = this._sc._unwrap(raw);
        if (d is ClassDecl) {
            ClassDecl c = d as ClassDecl;
            int j = 0;
            while (j < c.MemberCount) {
                // ⚠️ 跳过嵌套类型成员：NestedFlatten（本 pass 之前跑）已把它们**提升为顶层**
                // （改名 `Outer+Inner`）**但仍留在 outer.Members**——不跳会把同一个声明访问两次、
                // 报重复诊断。与其它成员 pass 的既有约定一致（「成员处理阶段忽略 ClassDecl/EnumDecl
                // 成员」，见 NestedFlatten 头注）；嵌套类型的成员由那份顶层副本覆盖。
                Decl mem = this._sc._unwrap(c.Members[j]);
                if (!(mem is ClassDecl) && !(mem is EnumDecl)) { this._teWalk(c.Members[j], c.Name); }
                j = j + 1;
            }
        } else if (d is ImplDecl) {
            ImplDecl im = d as ImplDecl;
            string tn = "";
            if (im.TargetType is NamedType) { tn = (im.TargetType as NamedType).Name; }
            int j = 0;
            while (j < im.MethodCount) { this._teWalk(im.Methods[j], tn); j = j + 1; }
        }
    }

    // 诊断锚在 **attribute 的 span**（指着 `[Test]`），不是方法 span——本 parser 的 decl span 只覆盖
    // 起始 token，且一个方法可能贴多个 attribute。
    private void _teCheck(AttributedDecl ad, MethodDecl md, string owner) {
        Attr kind = this._teKindAttr(ad);
        if (kind == null) { return; }
        string code = this._teCode(kind.Name);
        string use = "`[" + kind.Name + "]`";

        // R1 —— 位置错了就**只报这一条并返回**：贴错地方时再说「还得返回 void」只会刷屏。
        if (!md.IsFree && !Mod.Has(md.ModFlags, Mod.Static)) {
            this._sc.Diags.Error(code,
                use + " must be applied to a free function or a `static` method (got: "
                    + this._teShape(md, owner) + "); add `static`, or move it to a top-level function",
                kind.Span);
            return;
        }
        // R2..R5 各报一次 —— 一个方法可能同时「有返回值」且「有参数」，都说出来比只说第一条有用。
        if (!(md.RetType is NamedType) || (md.RetType as NamedType).Name != "void") {
            this._sc.Diags.Error(code,
                use + " must return `void` (got: `" + md.RetType.Dump() + "`)", kind.Span);
        }
        if (md.ParamCount != 0 && !(kind.Name == "Benchmark" && this._teIsBencherParam(md))) {
            string want = " must take no parameters (got: ";
            if (kind.Name == "Benchmark") { want = " must take no parameters or a single `Bencher` (got: "; }
            this._sc.Diags.Error(code, use + want + md.ParamCount.ToString() + ")", kind.Span);
        }
        if (md.TypeParams.Count != 0) {
            this._sc.Diags.Error(code, use + " cannot be applied to a generic method", kind.Span);
        }
        if (!md.HasBody) {
            this._sc.Diags.Error(code, use + " must have a method body", kind.Span);
        }
        // 实参语义（complete-test-attr-arg-checks）：位置违规已在 R1 处 return，故这里天然不叠加。
        this._teArgChecks(ad);
    }

    // ── 实参语义：E0914（[Skip] reason / [Skip]·[Ignore] 孤儿）+ E0917（[Timeout] 值域）──────
    // 纯语法：只看同一声明上的 attr 实参，不查符号表。三码常量早已存在于 z42c.core（零引用），
    // 直接引用。防的都是**静默降级**：skip 没理由、超时静默失效，全推到运行期且症状指不回病灶。
    private void _teArgChecks(AttributedDecl ad) {
        int a = 0;
        while (a < ad.AttrCount) {
            Attr at = ad.Attrs[a];
            if (at.Name == "Skip") {
                if (this._teNamedStr(at, "reason") == "") {
                    this._sc.Diags.Error(DiagnosticCodes.SkipReasonMissing,
                        "`[Skip]` requires a non-empty `reason` (e.g. `[Skip(reason: \"flaky on CI\")]`)",
                        at.Span);
                }
            } else if (at.Name == "Timeout") {
                // 非字面量视为「未给出」（只认字面量；支持命名常量属另案）。
                if (!this._teHasNamedInt(at, "milliseconds")) {
                    this._sc.Diags.Error(DiagnosticCodes.TimeoutValueInvalid,
                        "`[Timeout]` requires a `milliseconds` argument (e.g. `[Timeout(milliseconds: 5000)]`)",
                        at.Span);
                } else {
                    long ms = this._teNamedInt(at, "milliseconds");
                    if (ms <= 0) {
                        this._sc.Diags.Error(DiagnosticCodes.TimeoutValueInvalid,
                            "`[Timeout]` requires a positive `milliseconds` (got: " + ms.ToString() + ")",
                            at.Span);
                    }
                }
            }
            a = a + 1;
        }
    }

    // 修饰类 attr 必须与 kind attr 同贴：孤儿 `[Skip]` / `[Ignore]` 不贴在任何测试上，
    // 是写漏了 kind attr 的信号（runner 不会发现它，作者却以为它在跑）。独立于 _teCheck（后者要求命中
    // kind attr 才进），故由 _teWalk 单独调。
    private void _teOrphanCheck(AttributedDecl ad) {
        if (this._teKindAttr(ad) != null) { return; }
        int a = 0;
        while (a < ad.AttrCount) {
            string n = ad.Attrs[a].Name;
            if (n == "Skip" || n == "Ignore") {
                this._sc.Diags.Error(DiagnosticCodes.SkipReasonMissing,
                    "`[" + n + "]` requires `[Test]` or `[Benchmark]` on the same declaration",
                    ad.Attrs[a].Span);
            }
            a = a + 1;
        }
    }

    // 命名实参的字符串值（无 / 非字符串字面量 → ""）。形态见 DeclParser：`name: value` 译成
    // AssignExpr("=", IdentExpr(name), value)。
    private string _teNamedStr(Attr at, string key) {
        int i = 0;
        while (i < at.ArgCount) {
            if (at.Args[i] is AssignExpr) {
                AssignExpr ae = at.Args[i] as AssignExpr;
                if (ae.Target is IdentExpr && (ae.Target as IdentExpr).Name == key
                    && ae.Value is StringLitExpr) {
                    return Lexer.DecodeString((ae.Value as StringLitExpr).Raw);
                }
            }
            i = i + 1;
        }
        return "";
    }

    private bool _teHasNamedInt(Attr at, string key) {
        int i = 0;
        while (i < at.ArgCount) {
            if (at.Args[i] is AssignExpr) {
                AssignExpr ae = at.Args[i] as AssignExpr;
                if (ae.Target is IdentExpr && (ae.Target as IdentExpr).Name == key
                    && ae.Value is IntLitExpr) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    private long _teNamedInt(Attr at, string key) {
        int i = 0;
        while (i < at.ArgCount) {
            if (at.Args[i] is AssignExpr) {
                AssignExpr ae = at.Args[i] as AssignExpr;
                if (ae.Target is IdentExpr && (ae.Target as IdentExpr).Name == key
                    && ae.Value is IntLitExpr) {
                    return ZbcInstr._parseIntLit((ae.Value as IntLitExpr).Value);
                }
            }
            i = i + 1;
        }
        return 0;
    }

    // 首个命中的 kind attr（它决定诊断码）；无 → null。修饰类 attr（Skip/Ignore/ShouldThrow/Timeout）
    // 不单独触发：它们骑在同一声明上，由 kind attr 的检查覆盖。
    private Attr _teKindAttr(AttributedDecl ad) {
        int a = 0;
        while (a < ad.AttrCount) {
            if (HandlerRegistry.IsTestKindAttr(ad.Attrs[a].Name)) { return ad.Attrs[a]; }
            a = a + 1;
        }
        return null;
    }

    // 码映射：三个常量早已存在于 z42c.core（非本次新增）→ 可直接引用，无 F2 冷启动顾虑。
    // `[Benchmark] void f(Bencher b)`：恰好一个形参，类型短名 `Bencher`（或全名 `Std.Harness.Bencher`）。
    private bool _teIsBencherParam(MethodDecl md) {
        if (md.ParamCount != 1) { return false; }
        TypeExpr pt = md.Params[0].Type;
        if (!(pt is NamedType)) { return false; }
        string n = (pt as NamedType).Name;
        return n == "Bencher" || n == "Std.Harness.Bencher";
    }

    private string _teCode(string name) {
        if (name == "Benchmark") { return DiagnosticCodes.BenchmarkSignatureInvalid; }
        if (name == "Setup" || name == "Teardown") { return DiagnosticCodes.SetupTeardownSignatureInvalid; }
        return DiagnosticCodes.TestSignatureInvalid;
    }

    // 诊断里的「你贴到了什么」：instance method `MathTests.test_add` / constructor `Foo`
    private string _teShape(MethodDecl md, string owner) {
        string q = md.Name;
        // 嵌套类型经 NestedFlatten 后名为 `Outer+Inner`（元数据拼法）；诊断面向源码作者，
        // 还原成源码里写的 `Outer.Inner`。
        if (owner != "") { q = owner.Replace("+", ".") + "." + md.Name; }
        if (md.IsCtor) { return "constructor `" + q + "`"; }
        return "instance method `" + q + "`";
    }

    // ── 语义相：E0913（`[ShouldThrow<E>]` 的 E 必须派生 Exception）────────────────────────
    // 与 _passTestAttrEnforce 分开是刻意的：那条要保住「纯语法 / 零依赖 / first-pass 可用」——
    // 位置与签名是最该尽早报的一批。本 pass 需要符号表走基类链，故单列（design §1）。
    //
    // ⚠️ **刻意保守**：TypeArg 在符号表里**解析不到就不报**。符号表在若干场景下不完整
    //    （Collect(cu) 单 CU 无 imports、跨包类型取决于依赖是否已建），报「类型不存在」会误伤
    //    真实代码。宁可漏报也不误报 —— 已登记为已知缺口（design §2）。
    internal void _passTestAttrSemantic(SymbolTable table, CompilationUnit cu) {
        SymbolTable t = table.WithScopeOf(cu);   // `[ShouldThrow<X>]` 的 X 按本 CU 作用域解析
        int i = 0;
        while (i < cu.DeclCount) {
            this._tsWalk(t, cu.Decls[i]);
            i = i + 1;
        }
    }

    // 遍历面与 _teWalk 一致（顶层 / 类成员含嵌套跳过 / impl 块），只是检查内容不同。
    private void _tsWalk(SymbolTable t, Decl raw) {
        if (raw is AttributedDecl) {
            AttributedDecl ad = raw as AttributedDecl;
            if (ad.Inner is MethodDecl) { this._tsCheck(t, ad); }
        }
        Decl d = this._sc._unwrap(raw);
        if (d is ClassDecl) {
            ClassDecl c = d as ClassDecl;
            int j = 0;
            while (j < c.MemberCount) {
                Decl mem = this._sc._unwrap(c.Members[j]);
                if (!(mem is ClassDecl) && !(mem is EnumDecl)) { this._tsWalk(t, c.Members[j]); }
                j = j + 1;
            }
        } else if (d is ImplDecl) {
            ImplDecl im = d as ImplDecl;
            int j = 0;
            while (j < im.MethodCount) { this._tsWalk(t, im.Methods[j]); j = j + 1; }
        }
    }

    private void _tsCheck(SymbolTable t, AttributedDecl ad) {
        int a = 0;
        while (a < ad.AttrCount) {
            Attr at = ad.Attrs[a];
            if (at.Name == "ShouldThrow") {
                if (at.TypeArg == "") {
                    this._sc.Diags.Error(DiagnosticCodes.ShouldThrowTypeInvalid,
                        "`[ShouldThrow]` requires a type argument (e.g. `[ShouldThrow<TestFailure>]`)",
                        at.Span);
                } else if (t != null && t.HasClass(at.TypeArg)
                           && !this._tsDerivesFromException(t, at.TypeArg)) {
                    this._sc.Diags.Error(DiagnosticCodes.ShouldThrowTypeInvalid,
                        "`[ShouldThrow<" + at.TypeArg + ">]` requires a type deriving from `Exception` (got: `"
                            + at.TypeArg + "`)", at.Span);
                }
            }
            a = a + 1;
        }
    }

    // 基类链是否（传递地）到达 `Exception`；类型自身就是 Exception 也算。入口按名字查一次，之后每跳走句柄
    // （`BaseOf`）；按**短名**比较。
    private bool _tsDerivesFromException(SymbolTable t, string clsName) {
        if (clsName == "Exception") { return true; }
        Z42ClassType ct = t.GetClass(clsName);
        int hops = 0;
        while (ct != null) {
            Z42ClassType b = t.BaseOf(ct);
            if (b == null) { return false; }
            if (this._tsShortName(b.Name()) == "Exception") { return true; }
            ct = b;
            hops = SymbolTable.NextBaseHop(hops);
        }
        return false;
    }

    private string _tsShortName(string fq) {
        int lastDot = 0 - 1;
        int di = 0;
        while (di < fq.Length) { if (fq.CharAt(di) == '.') { lastDot = di; } di = di + 1; }
        if (lastDot >= 0) { return fq.Substring(lastDot + 1); }
        return fq;
    }
}
