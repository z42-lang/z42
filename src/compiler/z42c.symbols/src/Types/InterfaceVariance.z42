namespace Z42.Symbols;

/// Direction in which a generic interface parameter occurs in its declaration.
public enum InterfaceVariance {
    Invariant, Contravariant, Covariant
}

internal static class InterfaceVarianceInference {
    public const int Input = 1;
    public const int Output = 2;
    public const int Both = 3;

    public static int MethodUse(MethodSymbol method, string parameter) {
        if (method.TypeParamCount > 0) { return Both; }
        var signature = method.Signature;
        // Static members can participate in constrained dispatch.
        int useMask = TypeUse(signature.Ret, parameter, method.IsStatic ? Both : Output);
        int i = 0;
        while (i < signature.ParamCount && useMask != Both) {
            bool byRef = i < signature.ParamIsRef.Length && signature.ParamIsRef[i];
            int direction = (byRef || method.IsStatic) ? Both : Input;
            useMask = useMask | TypeUse(signature.ParamTypes[i], parameter, direction);
            i = i + 1;
        }
        return useMask;
    }

    private static int TypeUse(Z42Type type, string parameter, int direction) {
        if (type == null || type is Z42ErrorType || type is Z42UnknownType) { return Both; }
        if (type is Z42GenericParamType) { return type.Name() == parameter ? direction : 0; }
        if (type is Z42ArrayType) { return TypeUse((type as Z42ArrayType).Elem, parameter, Both); }
        if (type is Z42InstantiatedInterfaceType) {
            var iface = type as Z42InstantiatedInterfaceType;
            return NestedUses(iface.TypeArgs, iface.ArgCount, parameter);
        }
        if (type is Z42InstantiatedType) {
            var instance = type as Z42InstantiatedType;
            return NestedUses(instance.TypeArgs, instance.ArgCount, parameter);
        }
        if (type is Z42FuncType) {
            var fnType = type as Z42FuncType;
            return TypeUse(fnType.Ret, parameter, Both) | NestedUses(fnType.ParamTypes, fnType.ParamCount, parameter);
        }
        return 0;
    }

    // Until nested variance is resolved, every occurrence inside a type
    // constructor counts as both input and output.
    private static int NestedUses(Z42Type[] types, int count, string parameter) {
        int i = 0;
        while (i < count) {
            if (TypeUse(types[i], parameter, Both) != 0) { return Both; }
            i = i + 1;
        }
        return 0;
    }
}
