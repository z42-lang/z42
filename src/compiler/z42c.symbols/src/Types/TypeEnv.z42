// 类型环境（port-z42c-semantics 1A-4a）。词法嵌套 scope 链 + 全局符号表。
// 受限写法：① public 字段（同 z42c.syntax AST 约定）；② 全字段经构造器（this.）设置——
//   避免对刚 new 的同型实例做跨实例字段写（z42 此处报 E0402）；PushScope/WithClass 走构造器。
// Vars: 本层 locals/params（string → Z42Type，StrMap）。LookupVar 走父链。
namespace Z42.Semantics;
using Z42.IR;   // StrMap 统一到 z42c.ir（compiler-review §4.1）

using Z42.Syntax;
using Z42.Core;   // Span（forbid-local-shadowing：声明处）

public sealed class TypeEnv {
    public bool        HasParent;
    public TypeEnv     Parent;
    public StrMap      Vars;
    public StrMap      Consts;     // add-const-keyword：本层局部 const 值（name → ConstValue）；LookupConst 走父链
    public StrMap      LocalFns;   // impl-local-fn-l2：本层局部函数签名（name → Z42FuncType）；LookupLocalFn 走父链
    public SymbolTable Symbols;
    public bool        ClassFlag;
    public string      ClassName;
    public string[]    TypeParamNames;   // 活跃类型形参（泛型类/方法 scope，2A）。方法体内 = 类形参在前、方法形参在后（_mergeParams 序）。
    public int         TypeParamCount;
    // add-generic-methods：前导**类级**形参数（= TypeParamNames 中属类的个数，方法级从此偏移起）。
    // 方法体内判别形参归属：flatIdx < ClassTypeParamCount → 类级（读 instance.type_args）；
    // ≥ → 方法级（读 frame.method_type_args，methodIdx = flatIdx - ClassTypeParamCount）。
    // 默认 = TypeParamCount（全类级，非方法体 scope 行为不变）。
    public int         ClassTypeParamCount;
    public bool        InCtorThis;       // add-readonly-fields-opt：当前在声明类的实例 ctor 体内（接收者 this）。
                                         // readonly 字段仅此上下文可赋值。PushScope 继承（ctor 内嵌套块仍算）；
                                         // WithClass* 重置为 false；ctor 体绑定用 WithClassGenericCtor 置 true。
    // add-static-constructors：当前在声明类的**静态** ctor 体内。C# 允许静态 ctor 给本类的
    // `static readonly` 赋值（AssignTyper 据此放行）。后置赋值（不进构造签名）→ 零 call-site 涟漪，
    // 与 ClassTypeParamCount 同款做法；PushScope 继承（静态 ctor 内嵌套块仍算）。
    public bool        InStaticCtor;
    // fix-lambda-local-capture：所在 lambda / 局部函数的「本函数局部」收集表（null = 不在 lambda 内）。
    // PushScope 继承；Define 顺手登记 ⇒ lambda 体内**任何**形式的声明（var / foreach / 模式 / catch /
    // out var / 解构…）都自动算本函数局部，不会被误判成捕获。此前靠各声明点各自 `_lambdaLocals.Put`，
    // foreach 与模式变量漏了 ⇒ 被当成捕获、外层查无此变量 ⇒ 发射端塞 ConstNull（lambda 里读到 null）。
    public StrMap      FnLocals;
    // forbid-local-shadowing：本层**用户声明**的局部 / 形参 → 声明处 Span（字段、`this`、编译器合成名不进）。
    // 重名检查只看这张表 ⇒ 局部遮蔽字段（字段也在方法那层的 Vars 里）照旧合法。
    public StrMap      DeclSpans;
    // 函数边界（方法 / 访问器 / lambda / 局部函数的形参层）：重名检查沿父链走到这里为止 ——
    // 再往外是别的函数（lambda 外层）或类成员，C# 8 起允许遮蔽。
    public bool        IsFnBoundary;

    public TypeEnv(SymbolTable symbols, bool hasParent, TypeEnv parent, bool classFlag, string className,
                   string[] typeParamNames, int typeParamCount, bool inCtorThis) {
        this.Symbols = symbols;
        this.HasParent = hasParent;
        this.Parent = parent;
        this.Vars = new StrMap();
        this.Consts = new StrMap();
        this.LocalFns = new StrMap();
        this.ClassFlag = classFlag;
        this.ClassName = className;
        this.TypeParamNames = typeParamNames;
        this.TypeParamCount = typeParamCount;
        this.ClassTypeParamCount = typeParamCount;   // 默认全类级
        this.InCtorThis = inCtorThis;
        this.InStaticCtor = false;
        this.FnLocals = null;
        this.DeclSpans = new StrMap();
        this.IsFnBoundary = false;
    }

    public static TypeEnv Root(SymbolTable symbols) {
        return new TypeEnv(symbols, false, null, false, "", new string[0], 0, false);
    }

    public TypeEnv PushScope() {
        TypeEnv e = new TypeEnv(this.Symbols, true, this, this.ClassFlag, this.ClassName, this.TypeParamNames, this.TypeParamCount, this.InCtorThis);
        e.ClassTypeParamCount = this.ClassTypeParamCount;   // 嵌套块继承方法级偏移
        e.InStaticCtor = this.InStaticCtor;                 // 静态 ctor 内的嵌套块仍算静态 ctor 上下文
        e.FnLocals = this.FnLocals;                         // lambda 内的嵌套块仍登记进同一张表
        return e;
    }

    public TypeEnv WithClass(string className) {
        return new TypeEnv(this.Symbols, true, this, true, className, new string[0], 0, false);
    }

    // 泛型类 scope（携类型形参）。
    public TypeEnv WithClassGeneric(string className, string[] typeParamNames, int typeParamCount) {
        return new TypeEnv(this.Symbols, true, this, true, className, typeParamNames, typeParamCount, false);
    }

    // ctor 体 scope（携类型形参 + InCtorThis=true）：readonly 字段在此可赋值。add-readonly-fields-opt。
    public TypeEnv WithClassGenericCtor(string className, string[] typeParamNames, int typeParamCount) {
        return new TypeEnv(this.Symbols, true, this, true, className, typeParamNames, typeParamCount, true);
    }

    // add-generic-methods：方法体 scope——typeParamNames = 类形参(前) + 方法形参(后)（_mergeParams 序），
    // classParamCount = 前导类级个数。方法级 typeof(T)/new T()/default(T) 据此定位 frame 槽索引。
    public TypeEnv WithClassGenericMethod(string className, string[] typeParamNames, int typeParamCount,
                                          int classParamCount, bool inCtorThis) {
        TypeEnv e = new TypeEnv(this.Symbols, true, this, true, className, typeParamNames, typeParamCount, inCtorThis);
        e.ClassTypeParamCount = classParamCount;
        return e;
    }

    // 类型解析（携本 scope 的活跃类型形参）。
    public Z42Type ResolveType(TypeExpr te) {
        Z42Type t = this.Symbols.ResolveTypeP(te, this.TypeParamNames, this.TypeParamCount);
        // add-nested-types：内层非限定引用（`Outer` 体内写 `Inner`）——兜底实现在 SymbolTable.ResolveNested，与收集期共用。
        if ((t is Z42UnknownType) && this.ClassName != "") {
            Z42Type nt = this.Symbols.ResolveNested(te, this.TypeParamNames, this.TypeParamCount, this.ClassName);
            if (nt != null) { return nt; }
        }
        return t;
    }

    // 把本层标成函数边界（见 IsFnBoundary）。在定义形参之前调用。
    public void MarkFnBoundary() { this.IsFnBoundary = true; }

    // 形参：与 Define 相同，另记声明处（供函数体内的局部与它比对重名）。
    public void DefineParam(string name, Z42Type type, Span sp) {
        this.Define(name, type);
        this.DeclSpans.Put(name, sp);
    }

    // 用户声明的局部与谁重名：返回已声明 name 的那一层（就是本层 ⇒ 同一作用域重复；更外层 ⇒ 遮蔽外层），
    // 没有返回 null。沿父链只走到函数边界（含边界那层的形参）。
    public TypeEnv LocalConflictEnv(string name) {
        TypeEnv e = this;
        bool more = true;
        while (more) {
            if (e.DeclSpans.ContainsKey(name)) { return e; }
            if (e.IsFnBoundary || !e.HasParent) { more = false; }
            else { e = e.Parent; }
        }
        return null;
    }

    public void Define(string name, Z42Type type) {
        this.Vars.Put(name, type);
        if (this.FnLocals != null) { this.FnLocals.Put(name, type); }
    }

    // add-const-keyword：局部 const 值登记 / 父链查找。IsConstName 供赋值检查（不可对 const 赋值）。
    public void DefineConst(string name, ConstValue cv) { this.Consts.Put(name, cv); }
    public ConstValue LookupConst(string name) {
        // perf：父链逐层查同一个键 —— `GetHashCode` 是 O(n) FNV-1a 且每次调用都重算，
        // 逐层 `Find` 会把它白算 k 遍。这里取一次，逐表传给 `FindHashed`。
        int _h = name.GetHashCode();
        TypeEnv e = this;
        bool more = true;
        while (more) {
            int _sl0 = e.Consts.FindHashed(name, _h); if (_sl0 >= 0) { return e.Consts.ValAt(_sl0) as ConstValue; }
            if (e.HasParent) { e = e.Parent; } else { more = false; }
        }
        return null;
    }
    public bool IsConstName(string name) { return this.LookupConst(name) != null; }
    // 收集本层+父链全部 in-scope const（裸名 → ConstValue，内层 first-wins）供 ConstEval 求值局部 const 初始化器。
    public StrMap CollectConsts() {
        StrMap acc = new StrMap();
        TypeEnv e = this;
        bool more = true;
        while (more) {
            string[] ks = e.Consts.Keys();
            int i = 0;
            while (i < ks.Length) { acc.TryAdd(ks[i], e.Consts.Get(ks[i])); i = i + 1; }
            if (e.HasParent) { e = e.Parent; } else { more = false; }
        }
        return acc;
    }

    // impl-local-fn-l2：局部函数签名注册 / 父链查找（null = 非局部函数）。
    public void DefineLocalFn(string name, Z42FuncType sig) { this.LocalFns.Put(name, sig); }
    public Z42FuncType LookupLocalFn(string name) {
        // perf：父链逐层查同一个键 —— `GetHashCode` 是 O(n) FNV-1a 且每次调用都重算，
        // 逐层 `Find` 会把它白算 k 遍。这里取一次，逐表传给 `FindHashed`。
        int _h = name.GetHashCode();
        TypeEnv e = this;
        bool more = true;
        while (more) {
            int _sl1 = e.LocalFns.FindHashed(name, _h); if (_sl1 >= 0) { return e.LocalFns.ValAt(_sl1) as Z42FuncType; }
            if (e.HasParent) { e = e.Parent; } else { more = false; }
        }
        return null;
    }

    // 本层 → 父链查找；未找到返回 null。
    // 迭代（非递归）：z42 无法在自身方法内对 self-type 字段调自身方法（编译中类型未就绪）→ 走字段读循环。
    public Z42Type LookupVar(string name) {
        // perf：父链逐层查同一个键 —— `GetHashCode` 是 O(n) FNV-1a 且每次调用都重算，
        // 逐层 `Find` 会把它白算 k 遍。这里取一次，逐表传给 `FindHashed`。
        int _h = name.GetHashCode();
        TypeEnv e = this;
        bool more = true;
        while (more) {
            int _sl2 = e.Vars.FindHashed(name, _h); if (_sl2 >= 0) { return e.Vars.ValAt(_sl2) as Z42Type; }
            if (e.HasParent) { e = e.Parent; }
            else { more = false; }
        }
        return null;
    }

    // add-generic-methods：形参归属判别（就近优先——方法级先查）。
    // 方法级序号（在方法 TypeParams 中的位置）；非方法级返回 -1。
    public int MethodParamIndexOf(string name) {
        int i = this.ClassTypeParamCount;
        while (i < this.TypeParamCount) {
            if (this.TypeParamNames[i] == name) { return i - this.ClassTypeParamCount; }
            i = i + 1;
        }
        return -1;
    }
    // 类级序号（在类 TypeParams 中的位置）；非类级返回 -1。
    public int ClassParamIndexOf(string name) {
        int i = 0;
        while (i < this.ClassTypeParamCount) {
            if (this.TypeParamNames[i] == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    public bool        HasClass()     { return this.ClassFlag; }
    public string      CurrentClass() { return this.ClassName; }
    public SymbolTable GetSymbols()   { return this.Symbols; }
    public bool        InCtor()       { return this.InCtorThis; }   // add-readonly-fields-opt
}
