namespace Z42.Symbols;

using Z42.IR;

// Field offsets are relative to their aggregate. A branch's aggregate starts
// at PayloadOffset. A nested union retains its tag and branch layouts.
public sealed class UnionStorageField {
    public Z42Type Type;
    public int Offset;
    public int Size;
    public int Kind;
    public UnionStorageLayout Nested;
    public int ReferenceIndex;

    internal UnionStorageField(Z42Type type, int offset, int size, int kind, UnionStorageLayout nested) {
        this.Type = type;
        this.Offset = offset;
        this.Size = size;
        this.Kind = kind;
        this.Nested = nested;
    }
}

public sealed class UnionPayloadLayout {
    public UnionStorageField[] Fields;
    public int Size;
    public int Align;
    public int ReferenceCount;

    internal UnionPayloadLayout(UnionStorageField[] fields, int size, int align) {
        this.Fields = fields;
        this.Size = size;
        this.Align = align;
        foreach (var field in fields) {
            field.ReferenceIndex = this.ReferenceCount;
            if (field.Nested != null) {
                this.ReferenceCount = this.ReferenceCount + field.Nested.ReferenceCount;
            } else if (StructLeafKind.IsRef(field.Kind)) {
                this.ReferenceCount = this.ReferenceCount + 1;
            }
        }
    }
}

public sealed class UnionStorageLayout {
    public int Size;
    public int Align;
    public int TagBytes;
    public int PayloadOffset;
    public UnionPayloadLayout[] Cases;
    public UnionPayloadLayout StructFields;
    public int ReferenceCount;
    private bool _inlineStorage;

    internal UnionStorageLayout(UnionPayloadLayout fields) {
        this.Size = fields.Size;
        this.Align = fields.Align;
        this.StructFields = fields;
        this.ReferenceCount = fields.ReferenceCount;
        this._inlineStorage = UnionStorageLayout._supportsPayload(fields, false);
    }

    internal UnionStorageLayout(int size, int align, int tagBytes, int payloadOffset, UnionPayloadLayout[] cases) {
        this.Size = size;
        this.Align = align;
        this.TagBytes = tagBytes;
        this.PayloadOffset = payloadOffset;
        this.Cases = cases;
        this._inlineStorage = this.CellCount() <= 65535;
        foreach (var branch in cases) {
            if (branch.ReferenceCount > this.ReferenceCount) { this.ReferenceCount = branch.ReferenceCount; }
            if (!UnionStorageLayout._supportsPayload(branch, true)) { this._inlineStorage = false; }
        }
        if (this.ReferenceCount > 0 && this.CellCount() + this.ReferenceCount + 1 > 65535) {
            this._inlineStorage = false;
        }
    }

    public static UnionStorageLayout WideFor(Z42Type type) {
        Z42ClassType owner = UnionCaseSymbol.UnionOf(type);
        if (owner == null || owner.UnionStorage == null || owner.UnionStorage.Size <= 8) { return null; }
        return owner.UnionStorage;
    }

    // Packed values use a register. For a wide value, the cell width divides
    // its size and is at least the natural alignment of every scalar leaf.
    public int CellWidth() {
        if (this.Size <= 8 || this.Size % 8 == 0) { return 8; }
        if (this.Size % 4 == 0) { return 4; }
        return this.Size % 2 == 0 ? 2 : 1;
    }

    public int CellCount() { return this.Size <= 8 ? 1 : this.Size / this.CellWidth(); }

    public string CellTypeName() {
        int width = this.CellWidth();
        if (width == 8) { return "long"; }
        if (width == 4) { return "uint"; }
        return width == 2 ? "ushort" : "byte";
    }

    public bool SupportsInlineStorage() { return this._inlineStorage; }

    private static bool _supportsPayload(UnionPayloadLayout payload, bool allowUnion) {
        foreach (var field in payload.Fields) {
            if (field.Kind == StructLeafKind.Struct || (allowUnion && field.Kind == StructLeafKind.Union)) {
                if (!field.Nested.SupportsInlineStorage()) { return false; }
                continue;
            }
            if (StructLeafKind.IsRef(field.Kind)) { continue; }
            if (field.Kind != StructLeafKind.Prim) { return false; }
            int code = field.Type.PrimCode();
            if (code < 0) { return false; }
            int tag = PrimModel.IrTagOfCode(code);
            bool numeric = tag >= IrType.I8 && tag <= IrType.U64;
            if (!numeric && tag != IrType.Bool && tag != IrType.Char && tag != IrType.F32 && tag != IrType.F64) {
                return false;
            }
        }
        return true;
    }
}
