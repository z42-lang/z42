// 泛型约束检查器（port-z42c-semantics 2B）。从 TypeChecker 抽出，隔离约束逻辑
// （概念上镜像 C# 的 TypeChecker.Generics.cs；独立委托类而非 partial，使之能住在符号层、不依赖 Binding）。
//
// 两个职责：
//   · Resolve（Pass 0.5，镜像 C# ResolveAllWhereConstraints）：逐泛型类 where 子句 → ConstraintSet
//     登记进符号表；声明期诊断（未知型参 E0401 / class·struct 互斥 E0402）。
//   · Check（call-site，镜像 C# ValidateGenericConstraints）：泛型实例化 new Box<int>() 逐
//     (型参约束 bundle, 实参) 校验；违反报 E0402。
//
// 已校验：base-class / class / struct / 型参引用 where U:T / **interface**（含继承闭包）/
//         **enum** / **new()** —— 与运行期 validate_type_arg_constraint 的七项对齐。
//         **func-type**（validate-func-type-constraint：E0422 签名不符 / E0423 与其它约束并置）——
//         这一项运行期**没有**对应判定，只在编译期、只对本包声明的约束生效，见 _checkFuncConstraint。
//
// **跨包约束（add-associated-types PR-1）**：此前「跨包 100% 不校验」——`ClassConstraints` 的唯一
// 写入点只遍历本包 CU 的 ClassDecl，导入类型全程不碰，`Check` 第一行 `HasConstraints` 即返回。
// 现已接通：zbc TYPE 段的约束 bundle → ZbcReader → TsigReconcile → ExportedClassZ →
// ImportedSymbolLoader._constraintSetOf → SymbolTable.ClassConstraints（键 = 类的 FQN，见 SymbolTable.ClassConstraintKey）。
// 本包与导入走**同一个** _checkBundle，判定口径完全一致。
//
// 落地强度：complete-where-constraints 那轮定的「先 warning 探针再翻 error」在本项目**收不到数据**——
// z42c.driver Main.z42 的诊断呈现被 `if (art.ErrorCount > 0)` 整体门控，warning 在 CLI 上根本不打印
// （analyzer 警告同病）。故改为直接以 error 落地 + 跑完整 GREEN：全绿即零违反，证据强于看不见的
// warning。驱动隐藏 warning 本身是独立缺陷，已登记 Deferred。
//
// 🔴 DRAFT 风险表那条「基元 wrapper 归一偏差 → `Dictionary<int,int>` 编不过 → 自举链断」正是在
// 这一轮首次被真正触及（上一轮零误报只覆盖同包、不构成跨包证据）。
namespace Z42.Symbols;

using Z42.Syntax;
using Z42.Core;

public sealed class ConstraintChecker {
    private DiagnosticBag _diags;
    public ConstraintChecker(DiagnosticBag diags) { this._diags = diags; }

    // ════ Resolve（声明期 Pass 0.5）═══════════════════════════════════════════
    public void Resolve(CompilationUnit cu, SymbolTable symbols) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is MethodDecl) {
                // resolve-method-where-at-decl：**顶层自由函数**（`MethodDecl.IsFree`）的 where。
                // 它此前完全没有声明期入口——`Resolve` 只认 ClassDecl，而调用点那条又只在真被调用时才走。
                this._resolveMethodWheres(symbols, d as MethodDecl, new string[0], 0);   // 自由函数无 owner 类型参
            } else if (d is ClassDecl) {
                ClassDecl c = d as ClassDecl;
                // add-associated-types PR-1：条件由 `class || struct` 放宽到**含 interface**。此前
                // 泛型接口声明上的 where（`interface INumber<T> where T : INumber<T>`）根本不进约束
                // 模型 → 既无声明期诊断（型参写错/约束名拼错/class+struct 互斥全静默），也无从持久化
                // （ClassDescBuilder._interfaceDesc 只能建全空 bundle）。接口存独立表，见 SymbolTable。
                if (c.TypeParams.Count > 0 && c.WhereCount > 0) {
                    ConstraintSet cs = this._buildSet(symbols, c.Name, c.TypeParams, c.Wheres, c.WhereCount);
                    if (cs.AnyNonEmpty()) {
                        string ns = cu.HasNamespace ? cu.Namespace : "";
                        if (c.Kind == "interface") {
                            symbols.InterfaceConstraints.Put(SymbolTable.IfaceConstraintKey(ns, c.Name), cs);
                        } else {
                            symbols.ClassConstraints.Put(symbols.ClassConstraintKey(ns, c.Name, c.TypeParams.Count), cs);
                        }
                    }
                }
                symbols.EnclosingClass = c.Name;
                this._resolveMemberWheres(symbols, c.Members, c.MemberCount, c.TypeParams.Names, c.TypeParams.Count);
                symbols.EnclosingClass = "";
            } else if (d is UnionDecl) {
                UnionDecl u = d as UnionDecl;
                if (u.WhereCount > 0) {
                    ConstraintSet cs = this._buildSet(symbols, u.Name, u.TypeParams, u.Wheres, u.WhereCount);
                    if (cs.AnyNonEmpty()) {
                        symbols.ClassConstraints.Put(symbols.ClassConstraintKey(symbols.ScopeNs, u.Name, u.TypeParams.Count), cs);
                    }
                }
            } else if (d is ImplDecl) {
                var implementation = d as ImplDecl;
                this._resolveMemberWheres(symbols, implementation.Methods, implementation.MethodCount,
                    implementation.TargetParamNames, implementation.TargetParamNames.Length);
            }
            i = i + 1;
        }
    }

    private void _resolveMemberWheres(SymbolTable symbols, Decl[] members, int count,
                                      string[] ownerNames, int ownerCount) {
        for (int i = 0; i < count; i = i + 1) {
            var method = this._unwrap(members[i]) as MethodDecl;
            if (method != null) { this._resolveMethodWheres(symbols, method, ownerNames, ownerCount); }
        }
    }

    private void _resolveMethodWheres(SymbolTable symbols, MethodDecl md, string[] ownerNames, int ownerCount) {
        if (md.WhereCount == 0) { return; }
        if (symbols.FindMethodConstraints(md) != null) { return; }
        var method = ConstraintChecker._emptySet(md.TypeParams.Names, md.TypeParams.Count);
        var owner = ConstraintChecker._emptySet(ownerNames, ownerCount);
        for (int i = 0; i < md.WhereCount; i = i + 1) {
            WhereClause clause = md.Wheres[i];
            int slot = method.IndexOf(clause.TypeParam);
            if (slot >= 0) {
                this._fillBundle(symbols, md.Name, method.Bundles[slot], clause, method.ParamNames, method.Count, true);
            } else {
                slot = owner.IndexOf(clause.TypeParam);
                if (slot >= 0) {
                    this._fillBundle(symbols, md.Name, owner.Bundles[slot], clause, owner.ParamNames, owner.Count, true);
                } else {
                    this._diags.Error(DiagnosticCodes.UndefinedSymbol,
                        "where clause references unknown type parameter `" + clause.TypeParam + "` on `" + md.Name + "`",
                        clause.Span);
                }
            }
        }
        ConstraintChecker._qualifyMethodBounds(symbols, method);
        ConstraintChecker._qualifyMethodBounds(symbols, owner);
        symbols.RegisterMethodConstraints(md, method, owner);
    }

    private static ConstraintSet _emptySet(string[] names, int count) {
        ConstraintBundle[] bundles = new ConstraintBundle[count];
        for (int i = 0; i < count; i = i + 1) { bundles[i] = new ConstraintBundle(); }
        return new ConstraintSet(names, bundles, count);
    }

    private static void _qualifyMethodBounds(SymbolTable symbols, ConstraintSet set) {
        foreach (ConstraintBundle bundle in set.Bundles) {
            if (bundle.HasBaseClass) {
                var baseType = symbols.GetClass(bundle.BaseClassName);
                if (baseType != null) { bundle.BaseClassName = baseType.Fqn(); }
            }
            for (int i = 0; i < bundle.InterfaceCount; i = i + 1) {
                bundle.InterfaceNames[i] = SymbolTable.IfaceFqnOf(symbols, bundle.InterfaceNames[i]);
            }
        }
    }

    // ════ C：方法级 where **细化类级型参**时的调用点校验 ═════════════════════════
    // `new List<Opaque>().Sort()` —— `Sort()` 声明了 `where T : IComparable`，`T` 是 `List` 的
    // 类级型参 ⇒ 用**收者的**类型实参（`Z42InstantiatedType.TypeArgs`）验约束，违反报 E0402。
    //
    // 与既有两条同规则、同诊断（复用 `_fillBundle` / `_checkBundle`）：
    //   · 方法自己的型参 → `CheckMethod`（✅ 一直有）
    //   · 类级型参 + 类级 where → `ClassConstraints` 那条（✅ 一直有）
    //   · **类级型参 + 方法级 where（细化）→ 本方法**（🆕 此前无人校验）
    //
    // ⚠️ 只校验**被本方法的 where 提到的**那些类级型参：约束不上升为类级
    // （`List<Opaque>` 的构造 / `Add` / `Count` 必须照常可用）。
    public void CheckMethodRefinedClassParams(SymbolTable symbols, MethodDecl md,
                                              string[] ownerPnames, int ownerPc,
                                              Z42Type[] recvArgs, int recvArgCount, Span sp) {
        var entry = symbols.FindMethodConstraints(md);
        if (entry != null) {
            this._checkMethodSet(symbols, entry.Owner, recvArgs, recvArgCount, md.Name, sp);
        }
    }

    // 一个泛型类的 where 子句 → ConstraintSet（bundle 与型参声明序对齐）。
    private ConstraintSet _buildSet(SymbolTable symbols, string name, TypeParamList typeParams, WhereClause[] clauses, int count) {
        string[] pnames = typeParams.Names;
        int pc = typeParams.Count;
        ConstraintBundle[] bundles = new ConstraintBundle[pc];
        int b = 0;
        while (b < pc) { bundles[b] = new ConstraintBundle(); b = b + 1; }
        var cs = new ConstraintSet(pnames, bundles, pc);
        int w = 0;
        while (w < count) {
            WhereClause wc = clauses[w];
            int pi = cs.IndexOf(wc.TypeParam);
            if (pi < 0) {
                this._diags.Error(DiagnosticCodes.UndefinedSymbol,
                    "where clause references unknown type parameter `" + wc.TypeParam + "` on `" + name + "`",
                    wc.Span);
            } else {
                this._fillBundle(symbols, name, bundles[pi], wc, pnames, pc, true);
            }
            w = w + 1;
        }
        return cs;
    }

    // 把一条 where 子句的各约束项填进 bundle。可行子集外的约束（interface/enum/new()/func/泛型 base）静默延后。
    // 类级与方法级**共用本函数**（此前是逐字重复的两份，改校验必须同时改两处 → 已合并）；
    // 差异只有 owner 名（类名 / 方法名），参数化即可。
    // `report` —— 是否发出**声明级**诊断（未知约束名 E0443 / func 约束并置 E0423 / class·struct 互斥 E0402）。
    // resolve-method-where-at-decl：这些诊断只该在**声明期**发一次。类级本就如此（`Resolve` 是 Pass 0.5）；
    // 方法级此前**只在调用点**建 bundle ⇒ 两个症状：①被调 N 次报 N 条 ②**从不被调用就一条都不报**
    // （`where T : IFooo` 拼错名字 = 没写约束，而没人告诉你）。现在方法级也在 `Resolve` 里走一遍
    // （report=true、结果丢弃），`CheckMethod` 照旧即席建 bundle 但 **report=false**。
    private void _fillBundle(SymbolTable symbols, string ownerName, ConstraintBundle bundle, WhereClause wc,
                             string[] pnames, int pc, bool report) {
        int k = 0;
        while (k < wc.Count) {
            WhereConstraint con = wc.Constraints[k];
            if (!con.IsType) {
                if (con.Special == "class")  { bundle.RequiresClass = true; }
                if (con.Special == "struct") { bundle.RequiresStruct = true; }
                if (con.Special == "enum")   { bundle.RequiresEnum = true; }
                if (con.Special == "new()")  { bundle.RequiresCtor = true; }
            } else if (con.Type is NamedType) {
                NamedType nt = con.Type as NamedType;
                if (this._indexOfName(pnames, pc, nt.Name) >= 0) {
                    bundle.HasTypeParamRef = true; bundle.TypeParamRef = nt.Name;
                } else if (symbols.HasInterface(nt.Name)) {
                    this._fillInterfaceConstraint(symbols, bundle, nt, pnames, pc, report);
                } else if (symbols.HasClass(nt.Name)) {
                    // 泛型 base（`where T : Box<int>`）仍只记裸名——本轮不校验其类型实参
                    // （与接口的裸名匹配同口径，design D1）。
                    bundle.HasBaseClass = true; bundle.BaseClassName = nt.Name;
                } else {
                    Z42Type conT = symbols.ResolveTypeP(con.Type, pnames, pc);
                    if (conT is Z42FuncType) {
                        // fix-func-constraint-reported-unknown：`where T : Action<int>` / `Func<int, R>` /
                        // `Predicate<U>` / 用户 `delegate` —— 这些是**函数类型**，`SymbolTable.ResolveTypeP`
                        // 把它们解析成结构化 `Z42FuncType`，**不进 Classes / Interfaces 表** ⇒ 上面两个分支
                        // 都不命中 ⇒ 掉进下面那条「多半是拼错了」，报 `E0443 unknown constraint type Action`。
                        //
                        // 但它们是**合法且被支持**的约束写法（add-generic-func-constraint，
                        // `src/tests/generics/func_constraint_*.z42` 正在用、运行期也正常）。所以那条 E0443
                        // 是**事实错误**的诊断，不是「该报而暂时不该报」——本分支把它们摘出来。
                        //
                        // ⚠️ 为什么此前的探针没发现：该错误分支落地时以 warning 跑全仓实测「0 条」，
                        // 而这三个受害文件全在 `src/tests/generics/`，走 `z42c --emit-zbc` —— 那条路
                        // 丢弃全部诊断。探针看不见的地方，"0 条" 不构成证据。
                        //
                        // **validate-func-type-constraint：校验已补齐**（E0422/E0423 从留号变成真发出）。
                        // 此前这里只是「摘出来什么也不做」⇒ 约束是**只被相信、从不被检查**的元数据：
                        // binder（`MemberResolver` 的 `Z42GenericParamType` 分支）按这条签名把 `t(args)`
                        // 绑成 CallIndirect 并推断结果类型，而没有任何一处核对实参真是这个签名。
                        // 实测后果：`where T : Action<int>` 传 `Func<string,int>` 编译干净、运行期
                        // `VCall: expected object, got I64(3)`（int 被喂进 string 形参）。
                        // 约束里的型参（`Func<int,R>` 的 R / `Predicate<U>` 的 U）原样存着，
                        // 到调用点再按已解析的类型实参代换，见 `_checkFuncConstraint`。
                        bundle.HasFuncType = true; bundle.FuncType = conT;
                    } else {
                        // 既不是型参、也不是已知接口/类/函数类型 —— 多半是把约束名拼错了（`where T : IFooo`）。
                        // 此前**完全静默**：写错名字等于没写约束，而使用者以为约束生效了。
                        //
                        // 曾担心误报（z42c **不把接口的定义 import 进符号表**——ImportedSymbolLoader，
                        // 会破坏 byte-identical——故 `where T : 某导入接口` 可能 HasInterface/HasClass
                        // 皆假）。以 warning 跑全仓 + 全 stdlib 探针实测 **0 条**，故升 error。
                        if (report) {
                            this._diags.Error(DiagnosticCodes.UndefinedType,
                                "unknown constraint type `" + nt.Name + "` on `" + ownerName + "`", con.Span);
                        }
                    }
                }
            } else {
                // **非 NamedType 的约束类型**——只有字面量函数类型 `(int) -> R` / `() -> void` 走到这里
                // （`FuncTypeExpr`，见 z42c.syntax/TypeExpr.z42）。此前整条 if 链**落空**：既不报
                // E0443，也不存任何东西 ⇒ `where T : (int) -> int` 是一条彻底的空约束。
                Z42Type litT = symbols.ResolveTypeP(con.Type, pnames, pc);
                if (litT is Z42FuncType) { bundle.HasFuncType = true; bundle.FuncType = litT; }
            }
            k = k + 1;
        }
        // v1：函数类型约束与其余七项**互斥**（add-generic-func-constraint spec）。
        // 并置本身在今天是**静默无害**的（func 半边根本不校验），补上校验后它就成了一条语义未定义的
        // 写法——`where T : Func<int,int> + IDisposable` 要求 T 同时是结构化函数类型与实现某接口的类，
        // z42 的类型模型里没有这种东西。早报好过让它继续看起来合法。
        if (report && bundle.HasFuncType && !ConstraintChecker._onlyFuncType(bundle)) {
            this._diags.Error(DiagnosticCodes.InvalidFuncConstraint,
                "type parameter `" + wc.TypeParam + "` on `" + ownerName
                + "` cannot combine a function-type constraint with other constraints", wc.Span);
        }
        if (report && bundle.RequiresClass && bundle.RequiresStruct) {
            this._diags.Error(DiagnosticCodes.TypeMismatch,
                "type parameter `" + wc.TypeParam + "` cannot be both `class` and `struct` on `" + ownerName + "`",
                wc.Span);
        }
    }

    // ════ CheckDeclTypeRefs（声明位校验，check-constraints-all-type-refs H1）═══════
    // 此前约束满足性只在 `new T<>()`（ConstructTyper）与泛型方法调用（MemberResolver）两处校验；
    // 字段/属性/索引器/方法形参·返回/基类·接口列表这些**声明位**的泛型类型引用（`HashSet<NoEq> f;`
    // / `void g(Dict<Bad,V> d)`）从不校验 → 语言健全性洞。收集期 `SymbolCollector._chkTypeRefT`
    // 也解析了这些类型，但约束在 CollectAll 之后才 Resolve、当时不可查 ⇒ 只能放绑定期本 pass。
    //
    // 走 **AST 自有声明**（不走 `ct.Fields`/`ct.Methods` —— 那含继承展平成员，跨类会双报），
    // 类型上下文（类型参 + 方法型参）与 SymbolCollector._methodSymbol 逐字对齐，`ResolveTypeP` 重解析
    // 后交 `Check`（含 H2 递归）。基类位类型实参未存 Z42ClassType（只有裸名），故也从 AST c.Bases 重解析。
    // 体内位（局部/new/cast/is/as/default/typeof）由 TypeChecker._chkTypeRef 覆盖，与本 pass 不重叠。
    public void CheckDeclTypeRefs(CompilationUnit cu, SymbolTable symbols) {
        int i = 0;
        while (i < cu.DeclCount) {
            Decl d = this._unwrap(cu.Decls[i]);
            if (d is ClassDecl) { this._checkClassDeclRefs(symbols, d as ClassDecl); }
            else if (d is MethodDecl) { this._checkMethodDeclRefs(symbols, d as MethodDecl, new string[0], 0); }   // 顶层自由函数
            i = i + 1;
        }
    }

    private void _checkClassDeclRefs(SymbolTable symbols, ClassDecl c) {
        string[] tp = c.TypeParams.Names;
        int tpc = c.TypeParams.Count;
        int b = 0;
        while (b < c.BaseCount) {   // 基类 / 接口列表
            this._checkOneDeclRef(symbols, symbols.ResolveTypeP(c.Bases[b], tp, tpc), c.Bases[b].Span);
            b = b + 1;
        }
        int m = 0;
        while (m < c.MemberCount) {
            Decl mem = this._unwrap(c.Members[m]);
            if (mem is FieldDecl) {
                FieldDecl fd = mem as FieldDecl;
                this._checkOneDeclRef(symbols, symbols.ResolveTypeP(fd.Type, tp, tpc), fd.Type.Span);
            } else if (mem is PropertyDecl) {
                PropertyDecl pd = mem as PropertyDecl;
                this._checkOneDeclRef(symbols, symbols.ResolveTypeP(pd.Type, tp, tpc), pd.Type.Span);
            } else if (mem is IndexerDecl) {
                IndexerDecl ix = mem as IndexerDecl;
                this._checkOneDeclRef(symbols, symbols.ResolveTypeP(ix.RetType, tp, tpc), ix.RetType.Span);
                int p = 0;
                while (p < ix.ParamCount) {
                    this._checkOneDeclRef(symbols, symbols.ResolveTypeP(ix.Params[p].Type, tp, tpc), ix.Params[p].Type.Span);
                    p = p + 1;
                }
            } else if (mem is MethodDecl) {
                this._checkMethodDeclRefs(symbols, mem as MethodDecl, tp, tpc);
            }
            m = m + 1;
        }
    }

    private void _checkMethodDeclRefs(SymbolTable symbols, MethodDecl md, string[] tp, int tpc) {
        string[] all = this._mergeParams(tp, tpc, md.TypeParams.Names, md.TypeParams.Count);   // 类型参 + 方法型参（镜像 SymbolCollector._methodSymbol）
        int allc = tpc + md.TypeParams.Count;
        int k = 0;
        while (k < md.ParamCount) {
            this._checkOneDeclRef(symbols, symbols.ResolveTypeP(md.Params[k].Type, all, allc), md.Params[k].Type.Span);
            k = k + 1;
        }
        if (!md.IsCtor) {   // ctor RetType 是占位空名（同 SymbolCollector 跳过）
            this._checkOneDeclRef(symbols, symbols.ResolveTypeP(md.RetType, all, allc), md.RetType.Span);
        }
    }

    private void _checkOneDeclRef(SymbolTable symbols, Z42Type t, Span sp) {
        if (t is Z42InstantiatedType) { this.Check(symbols, t as Z42InstantiatedType, sp); }
    }

    private string[] _mergeParams(string[] a, int ac, string[] b, int bc) {
        string[] r = new string[ac + bc];
        int i = 0;
        while (i < ac) { r[i] = a[i]; i = i + 1; }
        int j = 0;
        while (j < bc) { r[ac + j] = b[j]; j = j + 1; }
        return r;
    }

    private void _fillInterfaceConstraint(SymbolTable symbols, ConstraintBundle bundle, NamedType nt,
                                          string[] pnames, int pc, bool report) {
        Z42InstantiatedInterfaceType iface = null;
        if (nt.ArgCount > 0 && !(nt.Args[0] is AssocBindingType)) {
            iface = symbols.ResolveTypeP(nt, pnames, pc) as Z42InstantiatedInterfaceType;
        }
        bundle.AddInterface(nt.Name, iface);
        var def = symbols.GetInterface(nt.Name);
        for (int i = 0; i < nt.ArgCount; i = i + 1) {
            var binding = nt.Args[i] as AssocBindingType;
            if (binding != null) {
                var resolved = symbols.ResolveTypeP(binding.Bound, pnames, pc);
                bundle.AddAssocBinding(binding.Name, TypeNameResolver.SurfaceTypeName(resolved));
                if (report && def != null && !def.HasAssocType(binding.Name)) {
                    this._diags.Error(DiagnosticCodes.AssocTypeBinding,
                        "interface `" + nt.Name + "` has no associated type `" + binding.Name + "`", binding.Span);
                }
            }
        }
    }

    // ════ Check（call-site 校验）═══════════════════════════════════════════════
    // `sp` = 实例化点（`new Box<D>()` 的类型位）。此前全程 `_noSpan()` → 诊断指向 `<sem> 0:0`，
    // 使用者拿到一条不知道该看哪一行的错误（complete-where-constraints PR-4）。
    public void Check(SymbolTable symbols, Z42InstantiatedType inst, Span sp) {
        // check-constraints-all-type-refs H2：递归进类型实参**先做、无条件**——嵌套泛型内层约束
        // 不能因外层无约束（下面 HasConstraints 早退）而逃逸（`List<HashSet<NoEq>>` 里内层 HashSet）。
        int r = 0;
        while (r < inst.ArgCount) {
            if (inst.TypeArgs[r] is Z42InstantiatedType) { this.Check(symbols, inst.TypeArgs[r] as Z42InstantiatedType, sp); }
            r = r + 1;
        }
        // 查询键 = 实例化所指那个类的 FQN 键（`Fqn()`，与写入侧 `ClassConstraintKey` 同形）——按短名查会让
        // 同短名的泛型类互相串味（不同 arity 的 `Foo<T>` / `Foo<T,U>`，或不同 ns 的 `A.Box<T>` / `B.Box<T>`）。
        // `cname` 仍用**裸名**：它只流进诊断文案，用户不该看到 `Foo$2` 这种内部键。
        string cname = inst.Def.Name();
        string ckey = inst.Def.Fqn();
        if (!symbols.HasConstraints(ckey)) { return; }
        ConstraintSet cs = symbols.GetConstraints(ckey);
        int n = inst.ArgCount;
        if (n > cs.Count) { n = cs.Count; }
        int i = 0;
        while (i < n) {
            ConstraintBundle b = cs.Bundles[i];
            if (!b.IsEmpty()) {
                this._checkBundle(symbols, cs.ParamNames, cs.Count, inst.TypeArgs, inst.ArgCount,
                                  b, inst.TypeArgs[i], cname, i, sp);
            }
            i = i + 1;
        }
    }

    // 逐 (bundle, 实参) 校验。类级与方法级**共用本函数**（此前是两份，差异仅「型参名/实参从
    // ConstraintSet+Z42InstantiatedType 取 还是 从平行数组取」+ 诊断 Span）——统一改用平行数组
    // + 显式 Span 参数，类级调用方把 cs.ParamNames / inst.TypeArgs 传进来即可，行为逐字等价。
    private void _checkBundle(SymbolTable symbols, string[] pnames, int pc, Z42Type[] args, int argCount,
                              ConstraintBundle b, Z42Type arg, string ownerName, int idx, Span sp) {
        string pn = pnames[idx];
        if (b.HasBaseClass && !this._satisfiesBase(symbols, arg, b.BaseClassName)) {
            this._err(arg, pn, b.BaseClassName, ownerName, sp);
        }
        if (b.RequiresClass && !this._isClassArg(symbols, arg)) {
            this._err(arg, pn, "class", ownerName, sp);
        }
        if (b.RequiresStruct && !this._isStructArg(symbols, arg)) {
            this._err(arg, pn, "struct", ownerName, sp);
        }
        if (b.HasTypeParamRef) {
            int j = this._indexOfName(pnames, pc, b.TypeParamRef);
            if (j >= 0 && j < argCount && !this._satisfiesParamRef(symbols, arg, args[j])) {
                this._err(arg, pn, b.TypeParamRef, ownerName, sp);
            }
        }
        this._checkInterfaces(symbols, pnames, pc, args, b, arg, pn, ownerName, sp);
        if (b.RequiresEnum && !this._isEnumArg(symbols, arg)) {
            this._err(arg, pn, "enum", ownerName, sp);
        }
        if (b.RequiresCtor && !this._hasNoArgCtor(symbols, arg)) {
            this._err(arg, pn, "new()", ownerName, sp);
        }
        // validate-func-type-constraint：函数类型约束。放在最后一组之前，与其余七项并列。
        if (b.HasFuncType) {
            this._checkFuncConstraint(symbols, pnames, pc, args, b.FuncType, arg, pn, ownerName, sp);
        }
        // add-associated-types PR-3：关联类型绑定要求 `where T : IEnum<Item = int>`。
        int ai = 0;
        while (ai < b.AssocBindingCount) {
            this._checkAssocBinding(symbols, arg, pn, b.AssocBindingNames[ai], b.AssocBindingTypeNames[ai], ownerName, sp);
            ai = ai + 1;
        }
    }

    private void _checkInterfaces(SymbolTable symbols, string[] pnames, int pc, Z42Type[] args,
                                  ConstraintBundle bundle, Z42Type arg, string param, string owner, Span sp) {
        for (int i = 0; i < bundle.InterfaceCount; i = i + 1) {
            var template = bundle.ConstructedInterfaces[i];
            if (template == null) {
                string name = bundle.InterfaceNames[i];
                if (!this._satisfiesInterface(symbols, arg, name)) { this._err(arg, param, name, owner, sp); }
            } else {
                var required = TypeSubst.Apply(template, new NameListMap(pnames, pc, args)) as Z42InstantiatedInterfaceType;
                if (IfaceSlotKeys.IsClosed(arg) && IfaceSlotKeys.IsClosed(required)
                    && !symbols.ImplementsInterfaceType(arg, required)) {
                    this._err(arg, param, LayoutKey.Of(required), owner, sp);
                }
            }
        }
    }

    // ════ 函数类型约束（validate-func-type-constraint）════════════════════════
    // `where T : Func<int,R>` / `Action<int>` / `Predicate<U>` / `(int) -> R` / 用户 delegate。
    //
    // 判定分三步：
    //   ① 约束里的型参按**本次调用已解析的类型实参**代换（`Predicate<U>` + U=int → `Predicate<int>`）。
    //      复用 `MethodTypeArgSubst.ByName`（它已有 Z42FuncType 分支）；代换不掉的位（类级型参等）
    //      留作**通配**，见 `_funcPosOk`。
    //   ② 实参必须是函数类型且 arity 相同。
    //   ③ 逐位比：形参位**逆变**（约束形参可传给实参形参 ⇒ 实参形参更宽）、返回位**协变**
    //      （实参返回可当约束返回用）。方向照  spec 的四条 Scenario。
    //
    // 🔴 与其余七项不同，**运行期没有对应判定**（`generics.rs::validate_type_arg_constraint` 只有七项，
    // zbc 约束 flag 位也没有 func 签名槽）⇒ 本项只在编译期成立，且只对**本包声明**的约束生效：
    // 导入 bundle 恒无 func 约束（`ImportedSymbolLoader._constraintSetOf` 无从取值）⇒ 跨包天然跳过。
    // 这是「漏报」而非「假红」，与关联类型跨包同一取舍。
    private void _checkFuncConstraint(SymbolTable symbols, string[] pnames, int pc, Z42Type[] args,
                                      Z42Type want, Z42Type arg, string pn, string ownerName, Span sp) {
        // 信息不足一律放行（同 _satisfiesInterface / _isEnumArg）。
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return; }
        Z42Type w = TypeSubst.Apply(want, new NameListMap(pnames, pc, args));
        if (!(w is Z42FuncType)) { return; }        // 代换后不再是函数类型：不该发生，保守放行
        Z42FuncType wf = w as Z42FuncType;
        if (!(arg is Z42FuncType)) {
            this._errFunc(arg, pn, wf, ownerName, sp, "it is not a function type");
            return;
        }
        Z42FuncType af = arg as Z42FuncType;
        if (af.ParamCount != wf.ParamCount) {
            this._errFunc(arg, pn, wf, ownerName, sp,
                "it takes " + af.ParamCount.ToString() + " parameter(s), the constraint requires "
                + wf.ParamCount.ToString());
            return;
        }
        int i = 0;
        while (i < wf.ParamCount) {
            // 逆变：调用方按**约束**的形参类型传值，实参那份必须接得住 ⇒ 约束形参 <: 实参形参。
            if (!ConstraintChecker._funcPosOk(symbols, wf.ParamTypes[i], af.ParamTypes[i])) {
                this._errFunc(arg, pn, wf, ownerName, sp,
                    "parameter " + (i + 1).ToString() + " is `" + af.ParamTypes[i].Name()
                    + "`, the constraint requires it to accept `" + wf.ParamTypes[i].Name() + "`");
                return;
            }
            i = i + 1;
        }
        // 协变：实参返回的东西必须当得了约束声明的返回类型。
        if (!ConstraintChecker._funcPosOk(symbols, af.Ret, wf.Ret)) {
            this._errFunc(arg, pn, wf, ownerName, sp,
                "it returns `" + af.Ret.Name() + "`, the constraint requires `" + wf.Ret.Name() + "`");
        }
    }

    // 「sub 可当 sup 用」——用于函数位的单向判定（形参位传 (约束, 实参)，返回位传 (实参, 约束)）。
    // **信息不足一律放行**：任一侧仍是型参（代换不掉的类级型参 / `Self`）、或 error/unknown。
    // 数值拓宽**刻意不放行**：间接调用按槽位传值，`Func<int,long>` 与 `Func<int,int>` 不是一回事。
    private static bool _funcPosOk(SymbolTable symbols, Z42Type sub, Z42Type sup) {
        if (sub == null || sup == null) { return true; }
        if ((sub is Z42GenericParamType) || (sup is Z42GenericParamType)) { return true; }
        if ((sub is Z42ErrorType) || (sup is Z42ErrorType)) { return true; }
        if ((sub is Z42UnknownType) || (sup is Z42UnknownType)) { return true; }
        if (sub.CanonName() == sup.CanonName()) { return true; }
        string subName = ConstraintChecker._defName(sub);
        if (subName == "") { return false; }        // 数组 / func / void：只认同名
        if (sup is Z42InterfaceType) { return symbols.Implements(subName, sup.Name()); }
        if ((sup is Z42ClassType) || (sup is Z42InstantiatedType)) {
            return symbols.IsSubclassOf(subName, ConstraintChecker._defName(sup));
        }
        return false;
    }

    // 类 / 实例化类型 → 其类定义的裸名；其余（数组 / func / void / 型参）→ ""。
    private static string _defName(Z42Type t) {
        if (t is Z42ClassType) { return t.Name(); }
        if (t is Z42InstantiatedType) { return (t as Z42InstantiatedType).Def.Name(); }
        return "";
    }

    private void _errFunc(Z42Type arg, string pn, Z42FuncType want, string ownerName, Span sp, string why) {
        this._diags.Error(DiagnosticCodes.GenericFuncConstraintViolation,
            "type argument `" + arg.Name() + "` for `" + pn + "` does not satisfy function-type constraint `"
            + want.Name() + "` on `" + ownerName + "` — " + why, sp);
    }

    // bundle 里除 func 约束外一个都没有？（E0423 的判据）
    private static bool _onlyFuncType(ConstraintBundle b) {
        return !b.HasBaseClass && !b.RequiresClass && !b.RequiresStruct && !b.HasTypeParamRef
            && b.InterfaceCount == 0 && !b.RequiresEnum && !b.RequiresCtor && b.AssocBindingCount == 0;
    }

    // `where T : IEnum<Item = int>` —— 实参 T 的类必须给出 `type Item = int;` 且绑定类型一致。
    // 未解析型参 / error / unknown 一律放行（同 _satisfiesInterface：信息不足不误报）。
    private void _checkAssocBinding(SymbolTable symbols, Z42Type arg, string pn,
                                    string bindName, string wantType, string ownerName, Span sp) {
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return; }
        Z42ClassType cls = null;
        if (arg is Z42ClassType) { cls = arg as Z42ClassType; }
        else if (arg is Z42InstantiatedType) { cls = (arg as Z42InstantiatedType).Def; }
        if (cls == null) { return; }                       // 数组 / func / void：无处安放绑定，不误报
        // assoc-type-crosspkg（zbc 1.42）：类的关联类型绑定现由 TYPE 统一 assoc 块跨包承载、导入侧
        // ImportedSymbolLoader.AddAssocBinding 恢复 ⇒ 删原 `if (cls.IsImported) return;` 守卫（此前导入类
        // AssocBindingOf 恒空、合法跨包代码被判「未绑定」假红）。跨包实参的绑定现与本包一样匹配：
        // 未绑定 → E0453；绑定类型与约束要求不符 → E0453。
        string got = cls.AssocBindingOf(bindName);
        if (got == "") {
            this._diags.Error(DiagnosticCodes.AssocTypeBinding,
                "type argument `" + arg.Name() + "` for `" + pn + "` on `" + ownerName
                + "` does not bind associated type `" + bindName + "`", sp);
            return;
        }
        if (PrimModel.Canon(got) != PrimModel.Canon(wantType)) {
            this._diags.Error(DiagnosticCodes.AssocTypeBinding,
                "type argument `" + arg.Name() + "` for `" + pn + "` on `" + ownerName
                + "` binds `" + bindName + "` to `" + got + "`, but `" + wantType + "` is required", sp);
        }
    }

    // where T : enum —— 运行期判据是 `td.is_enum()`；编译期对应 `symbols.EnumTypes`
    // （本地 + 导入两侧都 seed）。未解析型参 / error / unknown 按满足处理，同 _satisfiesInterface。
    private bool _isEnumArg(SymbolTable symbols, Z42Type arg) {
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return true; }
        if (arg is Z42ClassType) { Z42ClassType act = arg as Z42ClassType; return symbols.EnumTypes.ContainsKey(SymbolTable.DeclKey(act.Namespace, act.Name())); }
        return false;
    }

    // where T : new() —— 照抄运行期 `generics.rs`：
    //   · 基元满足；
    //   · 类实参须 **非 abstract**，且「有可用无参 ctor」——**完全没有显式 ctor 也算满足**
    //     （默认构造），只有「声明了 ctor 但没有一个能零实参调用」才不满足。
    // 「能零实参调用」的判据复用 ConstructTyper 的同款规则（params 变长 / 尾参带默认值都算）。
    // imported / 无 Decl 的 ctor 无法内省 → 不参与判定，避免误报。
    private bool _hasNoArgCtor(SymbolTable symbols, Z42Type arg) {
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return true; }
        Z42ClassType cls = null;
        if (arg is Z42ClassType) { cls = arg as Z42ClassType; }
        else if (arg is Z42InstantiatedType) { cls = (arg as Z42InstantiatedType).Def; }
        if (cls == null) { return false; }              // 数组 / func / void
        if (cls.IsScalarType()) { return true; }   // 基元恒满足（同运行期）
        if (cls.IsAbstract) { return false; }
        MethodSymbol[] ctors = cls.InstanceCtors();   // 静态 ctor 不是可 `new` 的构造器
        bool anyDeclared = false;
        int ci = 0;
        while (ci < ctors.Length) {
            MethodSymbol cm = ctors[ci];
            if (cm.HasDecl && cm.Decl != null) {
                anyDeclared = true;
                int pc = cm.Decl.ParamCount;
                bool isParams = pc > 0 && cm.Decl.Params[pc - 1].IsParams;
                if (isParams) {
                    if (pc - 1 <= 0) { return true; }   // `C(params T[] xs)` 可零实参
                } else {
                    bool ok = true;
                    int p = 0;
                    while (p < pc) { if (cm.Decl.Params[p].Default == null) { ok = false; } p = p + 1; }
                    if (ok) { return true; }            // 无参，或全部形参带默认值
                }
            }
            ci = ci + 1;
        }
        return !anyDeclared;   // 一个显式 ctor 都没有 → 默认构造 → 满足
    }

    // arg 满足接口约束（裸名匹配，design D1——不校验接口的类型实参，与运行期
    // `constraint_satisfied_by` 拿到的同样是常量池裸名，两边不产生分歧）。
    private bool _satisfiesInterface(SymbolTable symbols, Z42Type arg, string ifaceName) {
        // add-value-auto-iequatable：值类型自动满足 IEquatable（Self 版）——blob struct 的
        // Equals/GetHashCode 由编译器合成、enum 经 Std.Int64 重定向，语义上都是「自相等」；
        // 对齐 C#「所有值类型隐式实现 IEquatable<T>」，裸 struct 无三件套样板即可作
        // Dictionary/HashSet 键。运行期 reflection 自检（generics.rs constraint_satisfied_by）
        // 有同款臂，两边不分歧。裸名/限定名两种拼写都认（下方 design D1 的约束名形态）。
        string bare = ifaceName;
        int dot = ifaceName.LastIndexOf('.');
        if (dot >= 0) { bare = ifaceName.Substring(dot + 1); }
        if (bare == "IEquatable" && TypeFacts.IsNonNullableValueType(arg)) { return true; }
        if (arg is Z42ClassType) { return symbols.Implements((arg as Z42ClassType).Fqn(), ifaceName); }
        if (arg is Z42InstantiatedType) { return symbols.Implements((arg as Z42InstantiatedType).Def.Fqn(), ifaceName); }
        if (arg is Z42InterfaceType) {
            // 接口自身作实参：同名满足；否则沿父接口链判（IDerived 满足 IBase）。
            // interface-assignability：改走与其余消费点同一个出口。此前这里是**唯一**没落空的
            // 消费点（`InterfaceDerivesFrom` 比 `BaseNames` 字符串），换成 `BaseAt` 那条链后
            // 顺带认了限定拼写（`: Std.IFoo`）与链上的型参代换。
            return InterfaceClosure.IsInterfaceSubtypeByName(symbols, arg as Z42InterfaceType, ifaceName);
        }
        // 未解析的型参（`class Outer<T> { Box<T> b; }` 里的 T）：此处无从判定——T 的约束
        // 由 Outer 自己的实例化点校验。**按满足处理**，否则每个泛型类内部转发都会误报。
        if (arg is Z42GenericParamType) { return true; }
        // 数组 / func / void / error / unknown：不实现任何用户接口。error/unknown 已由别处报错，
        // 这里不叠加二次诊断。
        if ((arg is Z42ErrorType) || (arg is Z42UnknownType)) { return true; }
        return false;
    }

    private void _err(Z42Type arg, string param, string constraint, string owner, Span sp) {
        this._diags.Error(DiagnosticCodes.TypeMismatch,
            "type argument `" + arg.Name() + "` for `" + param + "` does not satisfy constraint `" + constraint + "` on `" + owner + "`",
            sp);
    }

    // arg 满足 base-class 约束：arg 是 baseName 或其子类（prim/array 不满足）。
    private bool _satisfiesBase(SymbolTable symbols, Z42Type arg, string baseName) {
        // fix-iface-satisfaction-gaps #2：未解析型参 / error / unknown 放行（与 _satisfiesInterface 统一口径）。
        // 泛型类内部转发 `new Inner<T>()` 时实参 T 尚不透明 → 由**外层实例化点**校验，此处放行免假红。
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return true; }
        // feat/delegate-base-class：函数类型满足委托族基类约束（`where TD : Delegate`，
        // internals §6 的 `.AsWeak()` 门面即此形态）。func → object 隐式转换既有（Conversion C 分支），
        // Object 约束一并认。
        if (arg is Z42FuncType) {
            return baseName == "Delegate" || baseName == "Std.Delegate"
                || baseName == "Object" || baseName == "Std.Object";
        }
        Z42ClassType target = symbols.GetClass(baseName);
        if (arg is Z42ClassType) { return symbols.IsSubclassOfType(arg as Z42ClassType, target); }
        if (arg is Z42InstantiatedType) { return symbols.IsSubclassOfType((arg as Z42InstantiatedType).Def, target); }
        return false;
    }

    // where U : T —— U 的实参须可赋给 T 的实参（同名 / 子类 / **类实现接口** / 数值拓宽）。
    private bool _satisfiesParamRef(SymbolTable symbols, Z42Type arg, Z42Type other) {
        // fix-iface-satisfaction-gaps #2：未解析型参 / error / unknown 放行（同 _satisfiesBase / _satisfiesInterface）。
        if ((arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType)) { return true; }
        if (arg.Name() == other.Name()) { return true; }
        // fix-paramref-constraint-iface：**上界是接口时必须查符号表**。
        // `Z42ClassType.IsAssignableTo`（Z42Type.z42:332）里**根本没有 `other is Z42InterfaceType`
        // 这一格**——它只判「同名 class」/「内建 canonical 归一」/「数值拓宽」⇒ 类→接口恒 false。
        // 于是底下那行 `arg.IsAssignableTo(other)` 把 `Pair<IFoo, C>`（`class C : IFoo`）判成不满足，
        // 报 E0402 **拒掉合法代码**。与 `OverloadResolver._assignable` 踩的是同一个根因：
        // `Z42Type.IsAssignableTo` **不带符号表**，漏掉的恰好是「需要类表」的那几条。
        //
        // 复用本文件已有的 `_satisfiesInterface`（裸名匹配，design D1，与运行期
        // `constraint_satisfied_by` 同一口径）——不另写一套判据。它对 arg 的每一格都**只放宽不收紧**：
        // 类→接口 / 实例化泛型→接口 / 接口→父接口三格从恒 false 变成查表，其余格（基元 / 数组 /
        // func）照旧 false，与改动前逐位相同。
        if (other is Z42InterfaceType) { return this._satisfiesInterface(symbols, arg, other.Name()); }
        if (other is Z42ClassType) {
            if (arg is Z42ClassType) { return symbols.IsSubclassOf(arg.Name(), other.Name()); }
            if (arg is Z42InstantiatedType) { return symbols.IsSubclassOf((arg as Z42InstantiatedType).Def.Name(), other.Name()); }
        }
        return arg.IsAssignableTo(other);
    }

    // 值类型判定 —— **镜像运行期** `validate_type_arg_constraint` 的 `is_value`
    // （`corelib/core/reflection/generics.rs`：`class_flags & CLASS_FLAG_STRUCT`，取不到 TypeDef 时
    // 回落基元表）。本页抬头写明「判定规则的唯一真相源是运行期，编译期照抄同一套规则，两边不
    // 各判各的」——此前这里**确实各判各的**：
    //
    //   | 实参        | 旧 `where T : class` | 旧 `where T : struct` |
    //   |------------|---------------------|----------------------|
    //   | `int` 基元  | 拒（对）             | 过（对）              |
    //   | 用户 struct | 🔴 **放行**          | 🔴 **拒**             |
    //   | `enum`      | 🔴 **放行**          | 🔴 **拒**             |
    //
    // 即 `where T : struct` 只接受六个基元 wrapper，用户自己写的 struct 一律被拒；而 `class`
    // 反过来把 struct 与 enum 全放了进去。运行期那份从一开始就是对的，两边只在**反射入口**
    // （`MakeGenericType`）才会撞上，普通调用走不到，于是一直没人发现。
    //
    // ⚠️ 不读 `arg` 自己的 `IsStruct` 位：薄类型上它可能没被填充（同 `PatternBinder
    // ._structSubjectBoxed` 的告诫）。一律按名字回符号表查真类型。
    // ⚠️ `enum` 的 `IsStruct` **是 false 且必须保持 false**（它还喂 `StructLayout` 的字段内联
    // 展平，而 enum 没有字段，见 Z42Type.z42:191）——所以这里单独并上 `IsEnum`。
    private bool _isValueTypeArg(SymbolTable symbols, Z42Type arg) {
        if (arg.IsScalarType()) { return true; }               // 六个基元 wrapper
        string n = "";
        string k = "";   // enum 表键（FQN）
        if (arg is Z42ClassType) { Z42ClassType act = arg as Z42ClassType; n = act.Name(); k = SymbolTable.DeclKey(act.Namespace, n); }
        else if (arg is Z42InstantiatedType) { n = (arg as Z42InstantiatedType).Def.Name(); k = SymbolTable.DeclKey((arg as Z42InstantiatedType).Def.Namespace, n); }
        else { return false; }
        if (symbols.EnumTypes.ContainsKey(k)) { return true; } // enum 是值类型（IsEnum 位见上）
        Z42ClassType def = symbols.GetClass(n);
        if (def == null) { return false; }                     // 查不到：按引用类型处理（同运行期的保守回落）
        return def.IsStruct;
    }

    // 实参类型没解析出来（型参未被推断 / 前面已报过错）→ 一律放行，别在上面叠加一条假的约束
    // 违反。`_isEnumArg` 与 `_hasNoArgCtor` 一直是这么做的，class/struct 两条**漏了**——于是
    // `SV v = ...; wantStruct(v);` 推断没绑住 T 时，报的是「type argument `T` 不满足 struct」，
    // 把「推断失败」说成「约束违反」，读者照着约束去改永远改不对。
    private bool _unresolved(Z42Type arg) {
        return (arg is Z42GenericParamType) || (arg is Z42ErrorType) || (arg is Z42UnknownType);
    }

    private bool _isClassArg(SymbolTable symbols, Z42Type arg) {
        if (this._unresolved(arg)) { return true; }
        if (!((arg is Z42ClassType) || (arg is Z42InstantiatedType))) { return false; }
        return !this._isValueTypeArg(symbols, arg);            // string / object / 用户 class 仍满足
    }

    private bool _isStructArg(SymbolTable symbols, Z42Type arg) {
        if (this._unresolved(arg)) { return true; }
        return this._isValueTypeArg(symbols, arg);
    }

    public void CheckMethod(SymbolTable symbols, MethodSymbol method, Z42Type[] args, int argCount, Span sp) {
        ConstraintSet constraints = method.HasDecl ? symbols.MethodConstraintsOf(method.Decl) : method.TypeParamConstraints;
        this._checkMethodSet(symbols, constraints, args, argCount, method.Name, sp);
    }

    private void _checkMethodSet(SymbolTable symbols, ConstraintSet constraints, Z42Type[] args,
                                 int argCount, string owner, Span sp) {
        if (constraints == null) { return; }
        int n = argCount < constraints.Count ? argCount : constraints.Count;
        for (int i = 0; i < n; i = i + 1) {
            ConstraintBundle bundle = constraints.Bundles[i];
            if (!bundle.IsEmpty()) {
                this._checkBundle(symbols, constraints.ParamNames, constraints.Count, args, argCount,
                                  bundle, args[i], owner, i, sp);
            }
        }
    }

    private int _indexOfName(string[] pnames, int pc, string name) {
        int i = 0;
        while (i < pc) { if (pnames[i] == name) { return i; } i = i + 1; }
        return -1;
    }

    private Decl _unwrap(Decl d) {
        if (d is AttributedDecl) { AttributedDecl ad = d as AttributedDecl; return ad.Inner; }
        return d;
    }

}
