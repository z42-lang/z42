// 文件级增量 probe（add-file-level-incremental；前身 = port-incremental-build-cache 的
// 整包 any-fresh 版）。判定 SoT = cache（zbc+meta，CacheStore），不再读上次 zpkg MODS。
//
// 两段式：
//   ① ProbeFiles —— 失效种子：源 hash ≠ meta / 条目缺失·pin 不符 / 包级源清单不一致
//      （增删文件 → 全量，spec 场景）。
//   ② Close —— 传递失效闭包，**判据在「名字」粒度上**（incr-name-level-invalidation；
//      落地 design D3 的 Deferred `incremental-future-tsig-level-invalidation`）：
//        · seedChanged = 种子失效文件里「声明面指纹变了 / 新增 / 删除」的**名字**集合；
//        · 文件 i 失效 ⟺ i 的标识符 token 集碰到 seedChanged 里任一名字；
//        · 文件 i 失效后**只有当它的声明面（方法体已剥）也提到了某个已变名字**，才把自己的
//          全部定义名并入已变集、把波继续传下去。
//      前身是「文件粒度」：`_definedOf` 把**成员名**也登记成属主名，于是任一定义了 `Name()` 的
//      文件一变，全包凡是提到 `Name` 的文件统统失效（实测 xtask：加一个方法 → `cached: 0/64`）。
//      名字粒度把「同名但没变的成员」这条假边彻底去掉：新增类型 / 新增函数 / 新增成员函数只波及
//      真正提到**新名字**或**其所属类型名**的文件。
//
//      为什么「声明面提到已变名字才继续传」是必需的、也是足够的：
//        · 必需——`A: class Foo : Bar`，`Bar` 变了则 `Foo` 的布局/vtable 跟着变，用 `Foo` 的 C
//          必须重编。A 的源没动，`Foo` 的**指纹**却不足以反映这一点，故靠这条规则接上。
//        · 足够——若 A 与 `Bar` 的唯一关联在某个**方法体**里，A 的任何声明都没变，A 的消费方
//          看到的 A 仍是原来那个 A（跨文件依赖只经声明面），不必重编。
//      粒度取「整文件的声明面」而非「逐名字的声明面」：够用且省一份 meta，方向是保守。
//
// Z42_INCR_DEBUG=1 → 种子原因 + 传播链（A invalidated-by B）。
namespace Z42.Pipeline;
using Z42.IR;

using Std;
using Std.IO;
using Z42.Project;
using Z42.Semantics;

// 名字表（token 集 / 定义名集；z42 无嵌套数组字段 → 专用小类）。
public sealed class NameListZ {
    public string[] Items;
    public int      Count;
    public NameListZ(string[] items, int count) { this.Items = items; this.Count = count; }
}

// 文件级 probe 结论。Fresh[i] 与 srcs[i] 对齐；Metas[i] 仅 !Fresh[i] 时有效。
public sealed class IncrFilePlan {
    public bool        AllCached;
    public bool[]      Fresh;
    public int         FreshCount;
    public CacheMeta[] Metas;
    public int         Total;
    // 上次构建的 cache 条目，**不论 Fresh 与否**都留着（种子失效行正是要拿它比对名字级指纹，
    // 而 Metas[i] 对失效行是 null）。无条目 → null。
    public CacheMeta[] Prev;
    public IncrFilePlan(int n) {
        this.AllCached = false;
        this.Fresh = new bool[n]; this.FreshCount = 0;
        this.Metas = new CacheMeta[n];
        this.Total = n;
        this.Prev = new CacheMeta[n];
    }
}

public static class IncrementalBuild {

    // ① 失效种子（hash/条目/清单级；闭包由 ② Close 在 parse 后补）。
    // hashes[i] = 源文本 SHA-256（调用方算一次三处复用——probe/ZbcFileZ/meta；解释执行的
    // SHA-256 每遍 ~3-4s/42 文件，重复计算曾是 D8 差价主项之一）。
    public static IncrFilePlan ProbeFiles(string[] srcs, string[] hashes, int n,
                                          string projectDir, string cacheDir) {
        bool debug = (Environment.GetEnvironmentVariable("Z42_INCR_DEBUG") ?? "") == "1";
        IncrFilePlan plan = new IncrFilePlan(n);
        // 包级源清单：数量或任一位置不符（增/删/改名）→ 全量。
        string[] last = CacheStore.LoadSrcList(cacheDir);
        bool listOk = last != null && last.Length == n;
        if (listOk) {
            int i = 0;
            while (i < n) {
                if (last[i] != IncrementalBuild.Rel(projectDir, srcs[i])) { listOk = false; }
                i = i + 1;
            }
        }
        if (!listOk) {
            if (debug) { ConsoleError.WriteLine("  [seed/src-list] package source set changed -> full"); }
            int i = 0;
            while (i < n) { plan.Fresh[i] = true; i = i + 1; }
            plan.FreshCount = n;
            return plan;
        }
        int fi = 0;
        while (fi < n) {
            string rel = IncrementalBuild.Rel(projectDir, srcs[fi]);
            CacheMeta m = CacheStore.Load(cacheDir, rel);
            if (m == null) {
                plan.Fresh[fi] = true; plan.FreshCount = plan.FreshCount + 1;
                if (debug) { ConsoleError.WriteLine("  [seed/no-entry] " + rel); }
            } else if (hashes[fi] != m.SourceHash) {
                plan.Prev[fi] = m;   // 种子失效行留着比对名字级指纹（Metas 仍置 null）
                plan.Fresh[fi] = true; plan.FreshCount = plan.FreshCount + 1;
                if (debug) { ConsoleError.WriteLine("  [seed/hash-diff] " + rel); }
            } else {
                plan.Prev[fi] = m;
                plan.Metas[fi] = m;
            }
            fi = fi + 1;
        }
        plan.AllCached = plan.FreshCount == 0;
        return plan;
    }

    // ② 传递失效闭包（名字粒度；见文件头）。
    //   tokens[i]     = 文件 i 的标识符 token 去重集（**含方法体内**）—— 失效判据
    //   surfIdents[i] = 文件 i **声明面**里的标识符去重集（体已剥）—— 传播判据
    //   names[i]      = 文件 i 定义的名字集（当前源；cached 行取自上次 meta，源未变即不变）
    //   seedChanged   = 种子失效文件里指纹变了/新增/删除的名字（调用方 diff 得出）
    // 朴素不动点迭代（包内 N 小，判据是 StrMap 命中而非 N² 边矩阵，比前身更快）。
    public static void Close(IncrFilePlan plan, string[] srcs, string projectDir,
                             NameListZ[] tokens, NameListZ[] surfIdents, NameListZ[] names,
                             NameListZ seedChanged) {
        bool debug = (Environment.GetEnvironmentVariable("Z42_INCR_DEBUG") ?? "") == "1";
        int n = plan.Total;
        StrMap changed = new StrMap();
        int c = 0;
        while (c < seedChanged.Count) { changed.Put(seedChanged.Items[c], seedChanged); c = c + 1; }
        // spread[i]：该文件的定义名是否已整体并入 changed（每文件至多一次，保证迭代收敛）。
        bool[] spread = new bool[n];
        bool moved = true;
        while (moved) {
            moved = false;
            int i = 0;
            while (i < n) {
                if (!plan.Fresh[i] && IncrementalBuild._hits(tokens[i], changed)) {
                    plan.Fresh[i] = true;
                    plan.FreshCount = plan.FreshCount + 1;
                    plan.Metas[i] = null;
                    moved = true;
                    if (debug) {
                        ConsoleError.WriteLine("  [invalidated] " + IncrementalBuild.Rel(projectDir, srcs[i])
                            + " uses-changed-name " + IncrementalBuild._firstHit(tokens[i], changed));
                    }
                }
                // 种子行与被波及行一视同仁：只有**声明面**提到了**别人**的已变名字，才把自己的
                // 定义名并入已变集继续传（`class Foo : Bar` 这类布局透传链靠它接上；只在函数体里
                // 用到则到此为止）。
                // **必须排除「自己定义的名字」**：种子文件的声明面天然提到它自己刚改的那些名字，
                // 不排除的话种子第一轮就把自己全部成员名并进已变集 —— 粒度当场退回文件级，
                // 「加一个方法 → 全包提到 `Name` 的文件统统失效」这个症状原样复发（实测复现过）。
                if (plan.Fresh[i] && !spread[i] && names[i] != null
                    && IncrementalBuild._hitsExternal(surfIdents[i], names[i], changed)) {
                    spread[i] = true;
                    int k = 0;
                    while (k < names[i].Count) {
                        if (!changed.ContainsKey(names[i].Items[k])) {
                            changed.Put(names[i].Items[k], seedChanged);
                            moved = true;
                        }
                        k = k + 1;
                    }
                    if (debug) {
                        ConsoleError.WriteLine("  [spread] " + IncrementalBuild.Rel(projectDir, srcs[i])
                            + " declares against a changed name -> its own names now suspect");
                    }
                }
                i = i + 1;
            }
        }
        plan.AllCached = plan.FreshCount == 0;
    }

    // 命中「别人的」已变名字：跳过本文件自己定义的名字（见 spread 处的说明）。
    private static bool _hitsExternal(NameListZ list, NameListZ own, StrMap changed) {
        if (list == null) { return false; }
        StrMap mine = new StrMap();
        int k = 0;
        while (own != null && k < own.Count) { mine.Put(own.Items[k], own); k = k + 1; }
        int i = 0;
        while (i < list.Count) {
            if (!mine.ContainsKey(list.Items[i]) && changed.ContainsKey(list.Items[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    private static bool _hits(NameListZ list, StrMap changed) {
        if (list == null) { return false; }
        int i = 0;
        while (i < list.Count) {
            if (changed.ContainsKey(list.Items[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    private static string _firstHit(NameListZ list, StrMap changed) {
        if (list == null) { return "?"; }
        int i = 0;
        while (i < list.Count) {
            if (changed.ContainsKey(list.Items[i])) { return list.Items[i]; }
            i = i + 1;
        }
        return "?";
    }

    // 源路径 → 项目相对（fwd-slash 归一 + projectDir 前缀剥离；镜像 driver _writeCacheZbc）。
    public static string Rel(string projectDir, string path) {
        string rel = path.Replace("\\", "/");
        string projFwd = projectDir.Replace("\\", "/");
        string prefix = projFwd.EndsWith("/") ? projFwd : projFwd + "/";
        if (rel.StartsWith(prefix)) { return rel.Substring(prefix.Length); }
        return rel;
    }
}
