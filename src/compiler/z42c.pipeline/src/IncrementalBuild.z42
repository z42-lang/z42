// 增量编译 probe（port-incremental-build-cache）。镜像 C# IncrementalBuild **最终形态**
// （ed901f01）：any fresh → 整包失效；100% 命中 → 调用方完全跳过重编/重写（保留现有
// zpkg）。混合 cached/fresh 重建因正确性问题被上游放弃，故本类型只回答「可否整体跳过」，
// 不携带 per-file 产物。设计哲学：宁可 fresh 不可错误命中。
//
// 命中条件（每文件全部满足）：
//   1. 上次 zpkg 存在且可读（版本 strict-pin 一致）
//   2. zpkg MODS 记录数 == 当前源文件数（防删文件后「全命中」保留陈旧模块——超出 C# 的防御）
//   3. MODS 含该源文件记录 且 SHA-256(当前文本) == 记录 hash
//   4. cache/<rel .z42→.zbc> 存在
//   5. 上次 zpkg TSIG 含该模块 ns
// Z42_INCR_DEBUG=1 → 逐文件 miss 原因（no-record / hash-diff / no-zbc / no-export-mod）。
namespace Z42.Pipeline;

using Std;
using Std.IO;
using Z42.Project;

// Probe 结论：AllCached=真 → 调用方跳过（还须自行确认 lastZpkg 在盘）。
public sealed class IncrProbeResult {
    public bool AllCached;
    public int  CachedCount;
    public int  TotalCount;
    public IncrProbeResult(bool allCached, int cachedCount, int totalCount) {
        this.AllCached = allCached; this.CachedCount = cachedCount; this.TotalCount = totalCount;
    }
}

public static class IncrementalBuild {

    // texts[i] = srcs[i] 的源文本（调用方已读，共用避免二次 IO）。
    public static IncrProbeResult Probe(string[] srcs, string[] texts, int n,
                                        string projectDir, string cacheDir, string lastZpkgPath) {
        bool debug = (Environment.GetEnvironmentVariable("Z42_INCR_DEBUG") ?? "") == "1";
        if (!File.Exists(lastZpkgPath)) {
            if (debug) { ConsoleError.WriteLine("  [miss/no-last-zpkg] " + lastZpkgPath); }
            return new IncrProbeResult(false, 0, n);
        }
        ZpkgInfo z = ZpkgReader.Open(File.ReadAllBytes(lastZpkgPath));
        if (z == null) {
            if (debug) { ConsoleError.WriteLine("  [miss/unreadable-zpkg] " + lastZpkgPath); }
            return new IncrProbeResult(false, 0, n);
        }
        ZpkgSourceHash[] hashes = ZpkgReader.ReadSourceHashes(z);
        if (hashes.Length == 0 || hashes.Length != n) {
            if (debug) {
                ConsoleError.WriteLine("  [miss/record-count] zpkg=" + hashes.Length.ToString()
                    + " sources=" + n.ToString());
            }
            return new IncrProbeResult(false, 0, n);
        }
        ExportedModuleZ[] tsig = ZpkgReader.ReadTsig(z);
        bool anyMiss = false;
        int cached = 0;
        int i = 0;
        while (i < n) {
            string reason = IncrementalBuild._probeOne(srcs[i], texts[i], projectDir, cacheDir,
                                                       hashes, tsig);
            if (reason == "") { cached = cached + 1; }
            else {
                anyMiss = true;
                if (debug) { ConsoleError.WriteLine("  [miss/" + reason + "] " + srcs[i]); }
            }
            i = i + 1;
        }
        // any fresh → 整包失效（镜像 C# package-invalidate：报 0/n）
        if (anyMiss) { return new IncrProbeResult(false, 0, n); }
        return new IncrProbeResult(true, cached, n);
    }

    // 单文件判定：命中返回 ""，否则 miss 原因。
    private static string _probeOne(string src, string text, string projectDir, string cacheDir,
                                    ZpkgSourceHash[] hashes, ExportedModuleZ[] tsig) {
        string rel = IncrementalBuild._rel(projectDir, src);
        ZpkgSourceHash rec = null;
        int i = 0;
        while (i < hashes.Length) {
            if (hashes[i].SourceFile == src
                || IncrementalBuild._rel(projectDir, hashes[i].SourceFile) == rel) {
                rec = hashes[i];
            }
            i = i + 1;
        }
        if (rec == null) { return "no-record"; }
        if (ZpkgBuilder.Sha256Hex(text) != rec.SourceHash) { return "hash-diff"; }
        string zbcRel = rel;
        if (zbcRel.EndsWith(".z42")) { zbcRel = zbcRel.Substring(0, zbcRel.Length - 4); }
        if (!File.Exists(Path.Join(cacheDir, zbcRel + ".zbc"))) { return "no-zbc"; }
        string ns = rec.Namespace;
        bool found = false;
        i = 0;
        while (i < tsig.Length) {
            if (tsig[i].Namespace == ns) { found = true; }
            i = i + 1;
        }
        if (!found) { return "no-export-mod"; }
        return "";
    }

    // 源路径 → 项目相对（projectDir 前缀剥离；不匹配则原样）。
    private static string _rel(string projectDir, string path) {
        string prefix = projectDir.EndsWith("/") ? projectDir : projectDir + "/";
        if (path.StartsWith(prefix)) { return path.Substring(prefix.Length); }
        return path;
    }
}
