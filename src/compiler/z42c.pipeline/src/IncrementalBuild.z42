// 文件级增量 probe（add-file-level-incremental；前身 = port-incremental-build-cache 的
// 整包 any-fresh 版）。判定 SoT = cache（zbc+meta，CacheStore），不再读上次 zpkg MODS。
//
// 两段式：
//   ① ProbeFiles —— 失效种子：源 hash ≠ meta / 条目缺失·pin 不符 / 包级源清单不一致
//      （增删文件 → 全量，spec 场景）。
//   ② Close —— 传递失效闭包：token 保守边（design D3 实现形态）——文件 i 的标识符
//      token 命中文件 j 的包内定义名（类型/自由函数/成员名）→ 边 i→j；j fresh **且 j 的
//      声明面变了** → i fresh。
//      边每次 build 从当前源重算（源不变 → 边不变），不入 meta。
//      **声明面闸门（fix-z42c-incremental-closure，落地 design D3 的 Deferred
//      `incremental-future-tsig-level-invalidation`）**：token 边极粗——`_definedOf` 把**成员名**
//      也登记成属主名，于是任一定义了 `Name()` 的文件一变，全包凡是提到 `Name` 的文件统统失效
//      （实测 xtask：改一行注释 → `cached: 0/64`）。闸门只收紧**传播的起点**：源变了但
//      **声明面**（= 去掉方法/属性/索引器体后的 token 流，见 driver 的 SurfaceHash.z42）没变的
//      文件不当传播源——改注释 / 改函数体只重编它自己。
//      依据：跨文件依赖只经声明面（内联限同 IrModule = 单 CU、逃逸/纯度摘要亦模块级、泛型走
//      运行期类型实参不单态化进调用方；唯一把值抄进消费方的 const 字段，其初值写在字段声明里
//      → 本就在声明面内）。
//      **一旦传播起来就照旧全传递**：被波及而转 fresh 的行 SurfaceChanged 保持默认 true，
//      于是「A 继承 B、C 用 A」这类**布局经中间文件透传**的链条与闸门前完全一致地失效
//      （只把「本来就不该扩散的那一跳」掐掉，不去猜哪些扩散可以省）。driver 只在两处把它
//      压成 false：种子失效但声明面相等、以及 cache 读不回来的降级行（两者源/声明面均未变）。
// Z42_INCR_DEBUG=1 → 种子原因 + 传播链（A invalidated-by B）。
namespace Z42.Pipeline;
using Z42.IR;

using Std;
using Std.IO;
using Z42.Project;
using Z42.Semantics;

// 名字表（token 集 / 定义名集；z42 无嵌套数组字段 → 专用小类）。
public sealed class NameListZ {
    public string[] Items;
    public int      Count;
    public NameListZ(string[] items, int count) { this.Items = items; this.Count = count; }
}

// 文件级 probe 结论。Fresh[i] 与 srcs[i] 对齐；Metas[i] 仅 !Fresh[i] 时有效。
public sealed class IncrFilePlan {
    public bool        AllCached;
    public bool[]      Fresh;
    public int         FreshCount;
    public CacheMeta[] Metas;
    public int         Total;
    // 上次构建记录的声明面指纹（cache 条目存在即有值，**不论** Fresh——种子失效行正是要拿它比对）；
    // 无条目 → ""。
    public string[]    PrevSurface;
    // 该文件可否当传播源。默认全 true（= 闸门前的保守行为）；driver 算出「源变了但声明面没变」
    // 的行才把它压成 false。非 Fresh 行的取值无意义（Close 只看 Fresh 行）。
    public bool[]      SurfaceChanged;
    public IncrFilePlan(int n) {
        this.AllCached = false;
        this.Fresh = new bool[n]; this.FreshCount = 0;
        this.Metas = new CacheMeta[n];
        this.Total = n;
        this.PrevSurface = new string[n];
        this.SurfaceChanged = new bool[n];
        int i = 0;
        while (i < n) { this.PrevSurface[i] = ""; this.SurfaceChanged[i] = true; i = i + 1; }
    }
}

public static class IncrementalBuild {

    // ① 失效种子（hash/条目/清单级；闭包由 ② Close 在 parse 后补）。
    // hashes[i] = 源文本 SHA-256（调用方算一次三处复用——probe/ZbcFileZ/meta；解释执行的
    // SHA-256 每遍 ~3-4s/42 文件，重复计算曾是 D8 差价主项之一）。
    public static IncrFilePlan ProbeFiles(string[] srcs, string[] hashes, int n,
                                          string projectDir, string cacheDir) {
        bool debug = (Environment.GetEnvironmentVariable("Z42_INCR_DEBUG") ?? "") == "1";
        IncrFilePlan plan = new IncrFilePlan(n);
        // 包级源清单：数量或任一位置不符（增/删/改名）→ 全量。
        string[] last = CacheStore.LoadSrcList(cacheDir);
        bool listOk = last != null && last.Length == n;
        if (listOk) {
            int i = 0;
            while (i < n) {
                if (last[i] != IncrementalBuild.Rel(projectDir, srcs[i])) { listOk = false; }
                i = i + 1;
            }
        }
        if (!listOk) {
            if (debug) { ConsoleError.WriteLine("  [seed/src-list] package source set changed -> full"); }
            int i = 0;
            while (i < n) { plan.Fresh[i] = true; i = i + 1; }
            plan.FreshCount = n;
            return plan;
        }
        int fi = 0;
        while (fi < n) {
            string rel = IncrementalBuild.Rel(projectDir, srcs[fi]);
            CacheMeta m = CacheStore.Load(cacheDir, rel);
            if (m == null) {
                plan.Fresh[fi] = true; plan.FreshCount = plan.FreshCount + 1;
                if (debug) { ConsoleError.WriteLine("  [seed/no-entry] " + rel); }
            } else if (hashes[fi] != m.SourceHash) {
                plan.PrevSurface[fi] = m.SurfaceHash;   // 种子失效行留着比对声明面（Metas 仍置 null）
                plan.Fresh[fi] = true; plan.FreshCount = plan.FreshCount + 1;
                if (debug) { ConsoleError.WriteLine("  [seed/hash-diff] " + rel); }
            } else {
                plan.PrevSurface[fi] = m.SurfaceHash;
                plan.Metas[fi] = m;
            }
            fi = fi + 1;
        }
        plan.AllCached = plan.FreshCount == 0;
        return plan;
    }

    // ② 传递失效闭包。tokens[i] = 文件 i 标识符 token 集（去重）；defined[i] = 文件 i
    // 包内定义名集。O(轮数 × N²) 朴素迭代（包内 N 小）；命中边即扩散直至不动。
    public static void Close(IncrFilePlan plan, string[] srcs, string projectDir,
                             NameListZ[] tokens, NameListZ[] defined, NameListZ partialNames) {
        bool debug = (Environment.GetEnvironmentVariable("Z42_INCR_DEBUG") ?? "") == "1";
        int n = plan.Total;
        // 边矩阵一次算好：edge[i*n+j] = i 引用 j 的定义名（i≠j）。
        // 全局定义名 → 属主文件列表（StrMap 哈希；value = IntBoxZ 链）。
        StrMap owners = new StrMap();
        int j = 0;
        while (j < n) {
            int k = 0;
            while (k < defined[j].Count) {
                string name = defined[j].Items[k];
                object cur = owners.ContainsKey(name) ? owners.Get(name) : null;
                owners.Put(name, new OwnerNodeZ(j, cur as OwnerNodeZ));
                k = k + 1;
            }
            j = j + 1;
        }
        bool[] edge = new bool[n * n];
        int i = 0;
        while (i < n) {
            int t = 0;
            while (t < tokens[i].Count) {
                if (owners.ContainsKey(tokens[i].Items[t])) {
                    OwnerNodeZ node = owners.Get(tokens[i].Items[t]) as OwnerNodeZ;
                    while (node != null) {
                        if (node.FileIdx != i) { edge[i * n + node.FileIdx] = true; }
                        node = node.Next;
                    }
                }
                t = t + 1;
            }
            i = i + 1;
        }
        // add-partial-types：partial 碎片组 clique——同名 partial 类型的全部碎片文件两两互连（双向边）。
        // 主碎片按**全碎片当前成员**发合并 TYPE record，故触任一碎片必须连带整组重编（否则主碎片 cache
        // 会残留旧布局）。owners[name] 已含该名全部属主文件（partial 碎片各自 _definedOf 都注册了类名）。
        int pn = 0;
        while (pn < partialNames.Count) {
            string pnm = partialNames.Items[pn];
            if (owners.ContainsKey(pnm)) {
                OwnerNodeZ ca = owners.Get(pnm) as OwnerNodeZ;
                while (ca != null) {
                    OwnerNodeZ cb = owners.Get(pnm) as OwnerNodeZ;
                    while (cb != null) {
                        if (ca.FileIdx != cb.FileIdx) { edge[ca.FileIdx * n + cb.FileIdx] = true; }
                        cb = cb.Next;
                    }
                    ca = ca.Next;
                }
            }
            pn = pn + 1;
        }
        // 闭包迭代。
        bool changed = true;
        while (changed) {
            changed = false;
            i = 0;
            while (i < n) {
                if (!plan.Fresh[i]) {
                    j = 0;
                    while (j < n) {
                        // 闸门：j 只有在**声明面**也变了时才够格当传播源。源没变的行
                        //（闭包/降级转 fresh）声明面必然没变 → 传播天然在一跳内收敛。
                        if (plan.Fresh[j] && plan.SurfaceChanged[j] && edge[i * n + j]) {
                            plan.Fresh[i] = true;
                            plan.FreshCount = plan.FreshCount + 1;
                            plan.Metas[i] = null;
                            changed = true;
                            if (debug) {
                                ConsoleError.WriteLine("  [invalidated] "
                                    + IncrementalBuild.Rel(projectDir, srcs[i])
                                    + " invalidated-by " + IncrementalBuild.Rel(projectDir, srcs[j]));
                            }
                            j = n;   // break：本文件已失效
                        } else { j = j + 1; }
                    }
                }
                i = i + 1;
            }
        }
        plan.AllCached = plan.FreshCount == 0;
    }

    // 源路径 → 项目相对（fwd-slash 归一 + projectDir 前缀剥离；镜像 driver _writeCacheZbc）。
    public static string Rel(string projectDir, string path) {
        string rel = path.Replace("\\", "/");
        string projFwd = projectDir.Replace("\\", "/");
        string prefix = projFwd.EndsWith("/") ? projFwd : projFwd + "/";
        if (rel.StartsWith(prefix)) { return rel.Substring(prefix.Length); }
        return rel;
    }
}

// 定义名属主链表节点（同名定义可散多文件：partial 风格 / 短名撞名——全都连边，保守）。
public sealed class OwnerNodeZ {
    public int        FileIdx;
    public OwnerNodeZ Next;
    public OwnerNodeZ(int fileIdx, OwnerNodeZ next) { this.FileIdx = fileIdx; this.Next = next; }
}
