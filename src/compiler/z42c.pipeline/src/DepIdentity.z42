// Both identities observe the complete deterministic dependency scan set, excluding self.
// CLI preserved products require executable identity (BLID, or complete bytes without BLID).
// HostTarget only substitutes file IR, and may use its validated import-surface projection.
namespace Z42.Pipeline;

using Std.IO;
using Z42.Package;

public static class DepIdentity {
    // 32 hex；没有任何依赖 zpkg 时也返回确定值（空集的哈希）。
    // hidden：与编译期扫描同一份不可见名单（口径必须一致——身份描述的就是编译看得见的那些包）。
    public static string Of(string[] dirs, int dirCount, string excludeName, WsTier tier) {
        return DepIdentity._of(dirs, dirCount, excludeName, tier, false);
    }

    public static string SurfaceOf(string[] dirs, int dirCount, string excludeName, WsTier tier) {
        return DepIdentity._of(dirs, dirCount, excludeName, tier, true);
    }

    private static string _of(string[] dirs, int dirCount, string excludeName, WsTier tier, bool surface) {
        string[] paths = ZpkgPathSort._sortedZpkgsMulti(dirs, dirCount, tier);
        string self = excludeName + ".zpkg";
        string[] parts = new string[paths.Length * 4];
        int k = 0;
        int i = 0;
        while (i < paths.Length) {
            string basename = Path.GetFileName(paths[i]);
            if (basename != self) {
                parts[k] = basename; k = k + 1;
                parts[k] = "="; k = k + 1;
                CachedZpkg ce = DepScanCache.Get(paths[i]);
                string id = surface ? DependencySurfaceIdentity.Of(ce) : "";
                parts[k] = id != "" ? id : DepIdentity._idOf(ce); k = k + 1;
                parts[k] = "\n"; k = k + 1;
            }
            i = i + 1;
        }
        return Std.Hashing.Murmur3.Hash128Hex(String.ConcatParts(parts, k));   // native-hash：串路径直哈
    }

    private static string _idOf(CachedZpkg ce) {
        if (ce.Identity != null) { return ce.Identity; }
        ZpkgInfo z = ce.Z;
        string id;
        if (z == null) {
            id = "unreadable:" + ce.Size.ToString() + ":" + ce.MtimeMs.ToString();
        } else {
            id = "";
            int s = 0;
            while (s < z.SectionCount) {
                ZpkgSection sec = z.Sections[s];
                if (sec.Tag == "BLID") { id = "blid:" + DepIdentity._hex(z.Data, sec.Offset, sec.Size); }
                s = s + 1;
            }
            if (id.Length == 0) { id = "bytes:" + Std.Hashing.Murmur3.Hash128Hex(z.Data); }
        }
        ce.Identity = id;
        return id;
    }

    private static string _hex(byte[] b, int off, int len) {
        string ds = "0123456789abcdef";
        char[] cs = new char[len * 2];
        int i = 0;
        while (i < len) {
            int v = (int)b[off + i];
            cs[i * 2] = ds.CharAt((v >> 4) & 0xF);
            cs[i * 2 + 1] = ds.CharAt(v & 0xF);
            i = i + 1;
        }
        return String.FromChars(cs);
    }
}
