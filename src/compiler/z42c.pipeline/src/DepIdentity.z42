// 依赖身份（add-dep-identity-to-cache-key）：增量缓存键里「这次编译看到的依赖」那一维。
//
// 此前缓存键只有本包源哈希 + 编译器版本号 + 格式版本，**没有依赖**：path 依赖 foo 把
// `Answer()` 改成 `Answer(int)`，消费方 bar 源码没动 ⇒ probe 全命中 ⇒ preserved 旧产物 ⇒
// 运行期 `undefined function Foo.Answer$0`（本应在编译期报错）。
//
// 口径 = 编译**实际扫描**的全部依赖 zpkg（DepScan.ScanDirs 扫的就是 libsDirs 下全部 *.zpkg，
// 编译结果是它们的函数），排除自身。每包身份取 BLID（#654 起可复现：依赖重编但输出未变 ⇒
// 身份不变 ⇒ 下游照样命中）；无 BLID（debug / indexed / 非 strip）回落整文件 Murmur3。
// 粒度是包级：任一依赖变 ⇒ 本包全量。按命名空间细分是后续优化，不影响正确性。
namespace Z42.Pipeline;

using Std;
using Std.IO;
using Std.Encoding;
using Z42.IR;

public static class DepIdentity {
    // 32 hex；没有任何依赖 zpkg 时也返回确定值（空集的哈希）。
    // hidden：与编译期扫描同一份不可见名单（口径必须一致——身份描述的就是编译看得见的那些包）。
    public static string Of(string[] dirs, int dirCount, string excludeName, string[] hidden, int hiddenN) {
        string[] paths = ZpkgPathSort._sortedZpkgsMulti(dirs, dirCount, hidden, hiddenN);
        string self = excludeName + ".zpkg";
        string[] parts = new string[paths.Length * 4];
        int k = 0;
        int i = 0;
        while (i < paths.Length) {
            string basename = Path.GetFileName(paths[i]);
            if (basename != self) {
                parts[k] = basename; k = k + 1;
                parts[k] = "="; k = k + 1;
                parts[k] = DepIdentity._idOf(DepScanCache.Get(paths[i])); k = k + 1;
                parts[k] = "\n"; k = k + 1;
            }
            i = i + 1;
        }
        return Murmur3.Hash128Hex(Utf8.GetBytes(String.ConcatParts(parts, k)));
    }

    private static string _idOf(CachedZpkg ce) {
        if (ce.Identity != null) { return ce.Identity; }
        ZpkgInfo z = ce.Z;
        string id;
        if (z == null) {
            id = "unreadable:" + ce.Size.ToString() + ":" + ce.MtimeMs.ToString();
        } else {
            id = "";
            int s = 0;
            while (s < z.SectionCount) {
                ZpkgSection sec = z.Sections[s];
                if (sec.Tag == "BLID") { id = "blid:" + DepIdentity._hex(z.Data, sec.Offset, sec.Size); }
                s = s + 1;
            }
            if (id.Length == 0) { id = "bytes:" + Murmur3.Hash128Hex(z.Data); }
        }
        ce.Identity = id;
        return id;
    }

    private static string _hex(byte[] b, int off, int len) {
        string ds = "0123456789abcdef";
        char[] cs = new char[len * 2];
        int i = 0;
        while (i < len) {
            int v = (int)b[off + i];
            cs[i * 2] = ds.CharAt((v >> 4) & 0xF);
            cs[i * 2 + 1] = ds.CharAt(v & 0xF);
            i = i + 1;
        }
        return String.FromChars(cs);
    }
}
