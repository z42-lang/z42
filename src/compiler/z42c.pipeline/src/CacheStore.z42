// cache 条目 meta 读写（add-file-level-incremental）。每个源文件的 cache 条目 =
// `<cache>/<rel 去 .z42>.zbc`（fullMode 编译产物，既有）+ 同名 `.meta`（本文件）。
// meta 是 **z42c 内部格式**（非 wire 格式，零 zbc/zpkg bump），行式文本：
//
//   z42c-meta <metaVersion>
//   z42c-fp <内容哈希>              ← 编译器语义指纹 pin（内容派生，见 CompilerFingerprint.z42）：
//                                     codegen/优化/typecheck/诊断 变化即令旧条目作废
//   zbc <ZbcVersion.Minor>          ← writer 版本 pin：任一不符 → 条目作废（Load 返回 null）
//   zpkg <ZpkgWriterZ.Minor>
//   hash <sha256hex(源文本)>
//   nsurf <name> <hash>            ← 0..n 行（**每个定义名各自的**声明面指纹——失效闭包的判据；
//                                     v5 起取代 v4 的整文件 `surface` 行）
//   sident <ident>                 ← 0..n 行（**声明面里**出现过的标识符去重集；传播判据：
//                                     被波及的文件只有「声明面提到了已变名字」才继续往下传）
//   ns <模块 namespace>            ← no-ns 单元与 build 路径同款 "main"
//   useddep <ns>                   ← 0..n 行（typecheck 实际用到的外部依赖 ns）
//   token <ident>                  ← 0..n 行（标识符 token 去重集——D3 闭包边输入；
//                                     v2 起入 meta：cached 文件零重 lex，见 D8 实测修正）
//   pool <hex(utf8)>               ← 0..n 行（模块 StringPool[1..] 原序——writer 残留，D5a）
//   labels <hex> <hex> ...         ← 每函数一行（块 label 表原文——writer 残留，D5a）
//   diag <hex(utf8)>               ← 0..n 行（该 CU 的 **per-CU typecheck 诊断**原文，v7 起；
//                                     cached 命中时回放，否则警告只在冷构建那一次可见）
//
// TSIG **不入 meta**（design D2 修正 2026-07-08）：每文件 TSIG 全包耦合（自由函数
// 兄弟泄漏 + 全包 AST 依赖），每次 build 由当前源 AST 全包重算。token 集与源一一对应
// （源不变 → token 不变），故可入 meta；标识符无空白字符，raw 存储。
// 其余串值 hex(UTF-8) 编码免转义。
// cache 可整目录删除（`z42b clean` 语义不变）；缺 meta/损坏 = 该文件按 fresh 处理。
// 包级 `package.meta`：上次构建源清单（增删文件 → 全量，spec 场景）。
namespace Z42.Package;

using Z42.Package;

using Std;
using Std.IO;
using Std.Encoding;
using Z42.IR.BinaryFormat;

// 单条目 meta（内存形态）。Rel = 项目相对源路径（fwd-slash，含 .z42）。
public sealed class CacheMeta {
    public string   Rel;
    public string   SourceHash;
    // 名字级声明面（incr-name-level-invalidation）：NsNames[k] 的声明面指纹 = NsHashes[k]。
    public string[] NsNames;    public string[] NsHashes;  public int NsCount;
    public string[] SurfIdents; public int SurfIdentCount;   // 声明面标识符去重集（传播判据）
    public string   Namespace;
    public string[] UsedDepNs;
    public int      UsedDepNsCount;
    public string[] Tokens;    public int TokenCount;      // 标识符 token 去重集（D3 边输入）
    public string[] Pool;      public int PoolCount;       // 模块池 [1..] 原序（writer 残留）
    public string[] FnLabels;  public int FnLabelsCount;   // 每函数一项 = 空格连接的 hex label 表
    // per-CU typecheck 诊断（warnings-survive-cache）。**只装 per-CU typecheck 那一层**：
    // E0436（`EnforceFileScopeAll`）与 analyzer 诊断都在其后追加、且每次构建都会重新发，
    // 存进来就会重复打印。见 `PackageCompile` 里取快照的那一点。
    // 又因为 ErrorCount>0 时根本不写 cache，这里实际只会有 **warning**。
    public string[] Diags;     public int DiagCount;
    // fix-cache-atomic-writes：同名 `.zbc` 的内容哈希（Murmur3-128 hex）。读回时校验 zbc 与 meta **配对**——
    // zbc 先写、meta 后写，中间崩溃会留下「新 zbc + 旧 meta」；源码若随后又改回旧内容，旧 meta 的
    // SourceHash 重新对上 ⇒ 命中一份由**另一版源码**编出的 zbc。
    public string   ZbcHash;
    public CacheMeta(string rel) {
        this.Rel = rel;
        this.SourceHash = "";
        this.NsNames = new string[0]; this.NsHashes = new string[0]; this.NsCount = 0;
        this.SurfIdents = new string[0]; this.SurfIdentCount = 0;
        this.Namespace = "main";
        this.UsedDepNs = new string[0]; this.UsedDepNsCount = 0;
        this.Tokens = new string[0];    this.TokenCount = 0;
        this.Pool = new string[0];      this.PoolCount = 0;
        this.FnLabels = new string[0];  this.FnLabelsCount = 0;
        this.Diags = new string[0];     this.DiagCount = 0;
        this.ZbcHash = "";
    }
}

public static class CacheStore {
    // v8（2026-09-30 fix-cache-atomic-writes）：+`zbchash <hex>` 行（zbc↔meta 配对校验）+ 末行 `end <行数>` 哨兵
    //     （半截 meta 此前只要开头几行在就被当成有效——token 列表截断 ⇒ 该失效的文件没失效）。v7 条目失效。
    // v7（2026-09-27 warnings-survive-cache）：+`diag <hex>` 行——per-CU typecheck 诊断入 meta，
    //     cached 命中时回放。此前 cached CU 的 `DiagMsgs` 被清空 ⇒ **警告只在冷构建那一次可见**
    //     （实测 W0700：第 ① 次打印，第 ② 次 `cached: 1/1` 起彻底消失，源码一字未改）。v6 条目失效。
    // v6（2026-09-15 add-dep-identity-to-cache-key）：package.meta +`deps <依赖身份>` 行——依赖包变了（BLID /
    //     内容哈希）整包作废。此前依赖改签名、消费方源码没动会命中旧产物。v5 条目失效。
    // v5（2026-09-06 incr-name-level-invalidation）：`surface` 单行 → `nsurf <name> <hash>` 多行
    //     （失效判据降到**名字**粒度）+ `sident` 行（声明面标识符，传播判据）。v4 条目失效。
    // v4（2026-09-06 fix-z42c-incremental-closure）：+surface 行（声明面指纹）——传播闸门的输入。
    //     旧条目无该行 → v3 条目失效（一次全量后即恢复增量）。
    // v3（2026-08-11 add-compiler-fingerprint-cache）：+z42c-fp 行（编译器语义指纹进 key）。v2 条目失效。
    // v2（2026-07-08）：+token 行——D8 计时实测 42 文件语料增量比全量慢 17%，根因 =
    // 闭包边输入对全部文件独立重 lex；token 入 meta 后 cached 文件零 lex。v1 条目失效。
    public static int MetaVersion = 8;

    // 编译器语义指纹 —— **已改为内容派生**（change `fingerprint-content-derived`）：
    // 值 = `CompilerFingerprint.Entries` 列表的内容哈希，来源见 `CompilerFingerprint.z42`。
    // 手工 +1 的计数器时代（1–41）的逐条理由搬到
    // `docs/internals/src/compiler/compiler-fingerprint.md`；bump 纪律见 version-bumping.md。
    //
    // ⚠️ 这里**不再有可改的数**。要让缓存失效，去 `CompilerFingerprint.Entries` 末尾追加一行 slug。
    public static string Fingerprint() { return CompilerFingerprint.Value(); }

    // rel（.z42）→ cache 内路径。与 driver `_writeCacheZbc` 同款「去 .z42」规则。
    public static string ZbcPath(string cacheDir, string rel)  { return Path.Join(cacheDir, CacheStore._stem(rel) + ".zbc"); }
    public static string MetaPath(string cacheDir, string rel) { return Path.Join(cacheDir, CacheStore._stem(rel) + ".meta"); }

    private static string _stem(string rel) {
        if (rel.EndsWith(".z42")) { return rel.Substring(0, rel.Length - 4); }
        return rel;
    }

    // 序列化（行式；集合按传入序写出——调用方保证确定性来源）。
    // 逐行进 parts 再一次 ConcatParts：`s = s + …` 在大模块（token/pool 上千行）上是平方级拷贝。
    public static string Serialize(CacheMeta m) {
        int total = 8 + m.NsCount + m.SurfIdentCount + m.UsedDepNsCount + m.TokenCount + m.PoolCount + m.FnLabelsCount + m.DiagCount;
        string[] parts = new string[total];
        int k = 0;
        parts[k] = "z42c-meta " + CacheStore.MetaVersion.ToString() + "\n"; k = k + 1;
        parts[k] = "z42c-fp " + CacheStore.Fingerprint() + "\n"; k = k + 1;
        parts[k] = "zbc " + ZbcVersion.Minor.ToString() + "\n"; k = k + 1;
        parts[k] = "zpkg " + ZpkgWriterZ.Minor.ToString() + "\n"; k = k + 1;
        parts[k] = "hash " + m.SourceHash + "\n"; k = k + 1;
        parts[k] = "ns " + m.Namespace + "\n"; k = k + 1;
        parts[k] = "zbchash " + m.ZbcHash + "\n"; k = k + 1;
        int i = 0;
        while (i < m.NsCount) { parts[k] = "nsurf " + m.NsNames[i] + " " + m.NsHashes[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.SurfIdentCount) { parts[k] = "sident " + m.SurfIdents[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.UsedDepNsCount) { parts[k] = "useddep " + m.UsedDepNs[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.TokenCount) { parts[k] = "token " + m.Tokens[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.PoolCount) { parts[k] = "pool " + CacheStore.HexEnc(m.Pool[i]) + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.FnLabelsCount) { parts[k] = "labels " + m.FnLabels[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        // 诊断原文 hex 编码：消息里可能嵌用户标识符/字面量，raw 存会撞上行式格式的换行与首空格切分。
        while (i < m.DiagCount) { parts[k] = "diag " + CacheStore.HexEnc(m.Diags[i]) + "\n"; k = k + 1; i = i + 1; }
        // 末行哨兵：前面的行数。Parse 要求它存在且计数吻合 ⇒ 截断的 meta 整条作废。
        parts[k] = "end " + k.ToString() + "\n"; k = k + 1;
        return String.ConcatParts(parts, k);
    }

    // 解析；版本 pin（metaVersion/zbc/zpkg）任一不符或格式坏 → null（= 条目作废）。
    public static CacheMeta Parse(string text, string rel) {
        CacheMeta m = new CacheMeta(rel);
        bool verOk = false;
        bool fpOk = false;
        bool zbcOk = false;
        bool zpkgOk = false;
        bool ended = false;
        int seen = 0;
        string[] lines = text.Split("\n");
        int i = 0;
        while (i < lines.Length) {
            string line = lines[i];
            i = i + 1;
            if (line.Length == 0) { continue; }
            if (ended) { return null; }   // 哨兵之后还有内容 = 坏条目
            int sp = line.IndexOf(" ");
            if (sp < 0) { return null; }
            string key = line.Substring(0, sp);
            string val = line.Substring(sp + 1);
            if (key == "end") { if (val != seen.ToString()) { return null; } ended = true; continue; }
            seen = seen + 1;
            if (key == "z42c-meta")    { verOk = (val == CacheStore.MetaVersion.ToString()); }
            else if (key == "z42c-fp") { fpOk = (val == CacheStore.Fingerprint()); }
            else if (key == "zbc")     { zbcOk = (val == ZbcVersion.Minor.ToString()); }
            else if (key == "zpkg")    { zpkgOk = (val == ZpkgWriterZ.Minor.ToString()); }
            else if (key == "hash")    { m.SourceHash = val; }
            else if (key == "nsurf") {
                // `nsurf <name> <hash>`：名字是标识符（无空格），hash 是 hex（无空格）→ 首个空格即分界。
                int gap = val.IndexOf(" ");
                if (gap <= 0) { return null; }
                m.NsNames = CacheStore._append(m.NsNames, m.NsCount, val.Substring(0, gap));
                m.NsHashes = CacheStore._append(m.NsHashes, m.NsCount, val.Substring(gap + 1));
                m.NsCount = m.NsCount + 1;
            }
            else if (key == "sident") {
                m.SurfIdents = CacheStore._append(m.SurfIdents, m.SurfIdentCount, val);
                m.SurfIdentCount = m.SurfIdentCount + 1;
            }
            else if (key == "ns")      { m.Namespace = val; }
            else if (key == "zbchash") { m.ZbcHash = val; }
            else if (key == "useddep") {
                m.UsedDepNs = CacheStore._append(m.UsedDepNs, m.UsedDepNsCount, val);
                m.UsedDepNsCount = m.UsedDepNsCount + 1;
            }
            else if (key == "token") {
                m.Tokens = CacheStore._append(m.Tokens, m.TokenCount, val);
                m.TokenCount = m.TokenCount + 1;
            }
            else if (key == "pool") {
                m.Pool = CacheStore._append(m.Pool, m.PoolCount, CacheStore.HexDec(val));
                m.PoolCount = m.PoolCount + 1;
            }
            else if (key == "labels") {
                m.FnLabels = CacheStore._append(m.FnLabels, m.FnLabelsCount, val);
                m.FnLabelsCount = m.FnLabelsCount + 1;
            }
            else if (key == "diag") {
                m.Diags = CacheStore._append(m.Diags, m.DiagCount, CacheStore.HexDec(val));
                m.DiagCount = m.DiagCount + 1;
            }
            else { return null; }   // 未知键 = 未来格式 → 按坏条目处理（宁 fresh 不误命中）
        }
        if (!verOk || !fpOk || !zbcOk || !zpkgOk || !ended) { return null; }
        if (m.ZbcHash.Length == 0) { return null; }
        if (m.SourceHash.Length == 0) { return null; }
        return m;
    }

    // 写盘（建父目录）。调用方负责 try/catch 降级（cache 写失败不致命）。
    public static void Save(string cacheDir, CacheMeta m) {
        string p = CacheStore.MetaPath(cacheDir, m.Rel);
        string parent = Path.GetDirectoryName(p);
        if (parent.Length > 0) { Directory.Create(parent); }
        File.WriteAllTextAtomic(p, CacheStore.Serialize(m));   // 原子：中途崩溃不留半截 meta
    }

    // 读盘：meta 缺失 / 解析失败 / 版本不符 / 同名 zbc 缺失 → null（该文件 fresh）。
    public static CacheMeta Load(string cacheDir, string rel) {
        string p = CacheStore.MetaPath(cacheDir, rel);
        if (!File.Exists(p)) { return null; }
        if (!File.Exists(CacheStore.ZbcPath(cacheDir, rel))) { return null; }
        try {
            return CacheStore.Parse(File.ReadAllText(p), rel);
        } catch (Exception e) {
            return null;
        }
    }

    private static string[] _append(string[] arr, int count, string v) {
        if (count < arr.Length) { arr[count] = v; return arr; }
        int cap = arr.Length == 0 ? 4 : arr.Length * 2;
        string[] b = new string[cap];
        int i = 0;
        while (i < count) { b[i] = arr[i]; i = i + 1; }
        b[count] = v;
        return b;
    }

    // ── 串 hex(UTF-8) 编解码（meta 行值免转义；label/池串可含空格、换行、任意 Unicode）──

    public static string HexEnc(string s) {
        byte[] b = Utf8.GetBytes(s);
        string ds = "0123456789abcdef";
        char[] cs = new char[b.Length * 2];
        int i = 0;
        while (i < b.Length) {
            int v = (int)b[i];
            cs[i * 2] = ds.CharAt((v >> 4) & 0xF);
            cs[i * 2 + 1] = ds.CharAt(v & 0xF);
            i = i + 1;
        }
        return String.FromChars(cs);
    }

    public static string HexDec(string hex) {
        int n = hex.Length / 2;
        byte[] b = new byte[n];
        int i = 0;
        while (i < n) {
            b[i] = (byte)((CacheStore._nib(hex.CharAt(i * 2)) << 4) | CacheStore._nib(hex.CharAt(i * 2 + 1)));
            i = i + 1;
        }
        return Utf8.GetString(b);
    }

    private static int _nib(char c) {
        if (c >= '0' && c <= '9') { return (int)c - 48; }
        if (c >= 'a' && c <= 'f') { return (int)c - 87; }
        if (c >= 'A' && c <= 'F') { return (int)c - 55; }
        return 0;
    }

    // ── 包级源清单（增删文件 → 全量；spec 场景「源文件增删」）────────────────────

    // depsId = DepIdentity.Of(...)：本次编译扫到的依赖 zpkg 身份；下次不符 ⇒ 整包全量。
    public static void SaveSrcList(string cacheDir, string[] rels, int n, string depsId) {
        string s = "z42c-meta " + CacheStore.MetaVersion.ToString() + "\n"
                 + "z42c-fp " + CacheStore.Fingerprint() + "\n"
                 + "zbc " + ZbcVersion.Minor.ToString() + "\n"
                 + "zpkg " + ZpkgWriterZ.Minor.ToString() + "\n"
                 + "deps " + depsId + "\n";
        int i = 0;
        while (i < n) { s = s + "src " + rels[i] + "\n"; i = i + 1; }
        Directory.Create(cacheDir);
        File.WriteAllTextAtomic(Path.Join(cacheDir, "package.meta"), s);   // 原子（fix-cache-atomic-writes）
    }

    // 上次源清单；缺失/pin 不符/依赖身份不符/格式坏 → null（= 全量）。
    public static string[] LoadSrcList(string cacheDir, string depsId) {
        string p = Path.Join(cacheDir, "package.meta");
        if (!File.Exists(p)) { return null; }
        string text = "";
        try { text = File.ReadAllText(p); } catch (Exception e) { return null; }
        string[] lines = text.Split("\n");
        string[] rels = new string[4];
        int n = 0;
        bool verOk = false; bool fpOk = false; bool zbcOk = false; bool zpkgOk = false; bool depsOk = false;
        int i = 0;
        while (i < lines.Length) {
            string line = lines[i];
            i = i + 1;
            if (line.Length == 0) { continue; }
            int sp = line.IndexOf(" ");
            if (sp < 0) { return null; }
            string key = line.Substring(0, sp);
            string val = line.Substring(sp + 1);
            if (key == "z42c-meta")  { verOk = (val == CacheStore.MetaVersion.ToString()); }
            else if (key == "z42c-fp") { fpOk = (val == CacheStore.Fingerprint()); }
            else if (key == "zbc")   { zbcOk = (val == ZbcVersion.Minor.ToString()); }
            else if (key == "zpkg")  { zpkgOk = (val == ZpkgWriterZ.Minor.ToString()); }
            else if (key == "deps")  { depsOk = (val == depsId); }
            else if (key == "src")   { rels = CacheStore._append(rels, n, val); n = n + 1; }
            else { return null; }
        }
        if (!verOk || !fpOk || !zbcOk || !zpkgOk || !depsOk) { return null; }
        string[] r = new string[n];
        i = 0;
        while (i < n) { r[i] = rels[i]; i = i + 1; }
        return r;
    }
}
