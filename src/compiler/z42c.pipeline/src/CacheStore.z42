// cache 条目 meta 读写（add-file-level-incremental）。每个源文件的 cache 条目 =
// `<cache>/<rel 去 .z42>.zbc`（fullMode 编译产物，既有）+ 同名 `.meta`（本文件）。
// meta 是 **z42c 内部格式**（非 wire 格式，零 zbc/zpkg bump），行式文本：
//
//   z42c-meta <metaVersion>
//   z42c-fp <CompilerFingerprint>   ← 编译器语义指纹 pin：codegen/优化/typecheck 变化即令旧条目作废
//   zbc <ZbcVersion.Minor>          ← writer 版本 pin：任一不符 → 条目作废（Load 返回 null）
//   zpkg <ZpkgWriterZ.Minor>
//   hash <sha256hex(源文本)>
//   nsurf <name> <hash>            ← 0..n 行（**每个定义名各自的**声明面指纹——失效闭包的判据；
//                                     v5 起取代 v4 的整文件 `surface` 行）
//   sident <ident>                 ← 0..n 行（**声明面里**出现过的标识符去重集；传播判据：
//                                     被波及的文件只有「声明面提到了已变名字」才继续往下传）
//   ns <模块 namespace>            ← no-ns 单元与 build 路径同款 "main"
//   useddep <ns>                   ← 0..n 行（typecheck 实际用到的外部依赖 ns）
//   token <ident>                  ← 0..n 行（标识符 token 去重集——D3 闭包边输入；
//                                     v2 起入 meta：cached 文件零重 lex，见 D8 实测修正）
//   pool <hex(utf8)>               ← 0..n 行（模块 StringPool[1..] 原序——writer 残留，D5a）
//   labels <hex> <hex> ...         ← 每函数一行（块 label 表原文——writer 残留，D5a）
//
// TSIG **不入 meta**（design D2 修正 2026-07-08）：每文件 TSIG 全包耦合（自由函数
// 兄弟泄漏 + 全包 AST 依赖），每次 build 由当前源 AST 全包重算。token 集与源一一对应
// （源不变 → token 不变），故可入 meta；标识符无空白字符，raw 存储。
// 其余串值 hex(UTF-8) 编码免转义。
// cache 可整目录删除（`z42b clean` 语义不变）；缺 meta/损坏 = 该文件按 fresh 处理。
// 包级 `package.meta`：上次构建源清单（增删文件 → 全量，spec 场景）。
namespace Z42.Project;

using Z42.Project;

using Std;
using Std.IO;
using Std.Encoding;
using Z42.IR.BinaryFormat;

// 单条目 meta（内存形态）。Rel = 项目相对源路径（fwd-slash，含 .z42）。
public sealed class CacheMeta {
    public string   Rel;
    public string   SourceHash;
    // 名字级声明面（incr-name-level-invalidation）：NsNames[k] 的声明面指纹 = NsHashes[k]。
    public string[] NsNames;    public string[] NsHashes;  public int NsCount;
    public string[] SurfIdents; public int SurfIdentCount;   // 声明面标识符去重集（传播判据）
    public string   Namespace;
    public string[] UsedDepNs;
    public int      UsedDepNsCount;
    public string[] Tokens;    public int TokenCount;      // 标识符 token 去重集（D3 边输入）
    public string[] Pool;      public int PoolCount;       // 模块池 [1..] 原序（writer 残留）
    public string[] FnLabels;  public int FnLabelsCount;   // 每函数一项 = 空格连接的 hex label 表
    public CacheMeta(string rel) {
        this.Rel = rel;
        this.SourceHash = "";
        this.NsNames = new string[0]; this.NsHashes = new string[0]; this.NsCount = 0;
        this.SurfIdents = new string[0]; this.SurfIdentCount = 0;
        this.Namespace = "main";
        this.UsedDepNs = new string[0]; this.UsedDepNsCount = 0;
        this.Tokens = new string[0];    this.TokenCount = 0;
        this.Pool = new string[0];      this.PoolCount = 0;
        this.FnLabels = new string[0];  this.FnLabelsCount = 0;
    }
}

public static class CacheStore {
    // v6（2026-09-15 add-dep-identity-to-cache-key）：package.meta +`deps <依赖身份>` 行——依赖包变了（BLID /
    //     内容哈希）整包作废。此前依赖改签名、消费方源码没动会命中旧产物。v5 条目失效。
    // v5（2026-09-06 incr-name-level-invalidation）：`surface` 单行 → `nsurf <name> <hash>` 多行
    //     （失效判据降到**名字**粒度）+ `sident` 行（声明面标识符，传播判据）。v4 条目失效。
    // v4（2026-09-06 fix-z42c-incremental-closure）：+surface 行（声明面指纹）——传播闸门的输入。
    //     旧条目无该行 → v3 条目失效（一次全量后即恢复增量）。
    // v3（2026-08-11 add-compiler-fingerprint-cache）：+z42c-fp 行（编译器语义指纹进 key）。v2 条目失效。
    // v2（2026-07-08）：+token 行——D8 计时实测 42 文件语料增量比全量慢 17%，根因 =
    // 闭包边输入对全部文件独立重 lex；token 入 meta 后 cached 文件零 lex。v1 条目失效。
    public static int MetaVersion = 6;

    // 编译器语义指纹：z42c 的 codegen / 优化 / typecheck / lowering 行为变化，但 zbc/zpkg 格式
    // Minor **不** bump 时，手动 +1。它进 cache key → 编译器语义一变即令旧 .meta 全部失效，堵住
    // 「源没变 + 格式没 bump 但编译器逻辑变了 → 误命中旧 .zbc 产物」这个正确性漏洞（todo#7）。
    // 格式 bump（zbc/zpkg Minor++）已自带失效，无需同时动本值；纯 reader/writer bug 修复也不动。
    // bump 纪律见 docs/agent/rules/version-bumping.md「编译器语义指纹」。
    // 2 (unify-object-byte-layout PR-3 chunk 2b): `_refineDirectRefKind` 把 object/interface
    //   直接字段的 field_kinds 从 GcRef(可内联) 改为 GcRefClosure(侧表)。zbc 格式未 bump（仍 1.35），
    //   故手动 +1 作废 chunk-2a 期缓存——否则旧 .zbc（object 字段=GcRef）被误命中 → runtime 内联多态字段 = bug。
    // 3 (unify-object-byte-layout PR-3 chunk 2c): `_sizeOf` 引用叶子 16→8B → struct 字节布局
    //   （size/offset/引用位图）变化。格式未 bump（struct 块结构不变、仅值），手动 +1 作废旧缓存。
    public static int CompilerFingerprint = 18;  // fix-foreach-dispose-inherited：foreach 枚举器路径的 `Dispose` 条件判据改问**继承面** （类沿 `BaseName` 链、接口交 `InterfaceClosure.FindMethod`），不再只查 `MethodsOf` 给的那张**直接**成员表。⚠️ **bump 的真正理由**：#823 引入条件化后，`Dispose` 从父接口或基类继承来的源文件**编得过**、但发码里**少了那次 `Dispose` 调用**（实测 `Std.IEnumerable<T>` 那条路 `disposed=0`，具体类型是 1）⇒ 这类源文件**哈希不变而发码变**，不 bump 就会命中 #823 那版编译器产出的缓存条目、修复对它们永不生效。⚠️ 让号实录：#820 在飞时已取 17 ⇒ 本 PR 让到 18（parallel-development.md §4.1「按合并顺序让号」）。 上一档 17：complete-generic-instantiation S1：**泛型体的单调化** —— 泛型自由函数 / 静态·实例泛型方法（含虚与 override）按**具体类型实参**各特化一份（体内布局查询按代换后的类型算，偏移随实例化烘焙），与实例化类型的特化共用同一个不动点闭包。修的是 #774 留下的**静默错值**：泛型体只编一份、按擦除布局烘焙偏移，而调用方按实例化布局造值（实测 `ReadSecond<P2>(Loc<P2,int>)` 读出 2 而非 7；虚派发读出 102 而非 107）。全用现有指令、**无格式 bump**。含泛型实例化的源文件**哈希不变而发码变**（新增特化体、调用点改派特化名）⇒ 不 bump 就会复用旧编译器产出的缓存条目（那里调用点仍指向擦除体）。上一档 16：add-iface-return-bridge：接口返回位的 struct 协变现在**真能跑** —— 实现返回具体 struct、接口声明返回引用型时，具体实现挪到 `<m>$struct`、合成桥接占裸名 vtable 槽（`struct_alloc` + `call $struct` + `__box_struct` + `ret`），类收者调用点经 `MethodSymbol.CallKey()` 指向 `$struct`、接口收者仍走裸名。⚠️ **bump 的真正理由**：这种写法**修前编得过**（编译期零诊断、照常发码），只是运行期抛 `takes 2 physical argument(s), the call passes 1` ⇒ 那类源文件**哈希不变而发码变**（现在多一个桥接函数、具体实现换了名），不 bump 就会复用旧编译器产出的缓存条目、桥接根本不存在。⚠️ 这一档 stdlib 现在**真的用上了**（`List<T> : IEnumerable<T>` + `ListEnumerator<T> : IEnumerator<T>`）⇒ 与 #795/#796 那种「stdlib 无此形状、CI 守门只会漏判」不同，本次 fingerprint 守门应当能看见输出变化。 ⚠️ 让号实录：main 上 15 已被 carry-null-marks-through-native-stubs 取走，本 PR 让到 16（parallel-development.md §4.1「按合并顺序让号」）。 上一档 15：carry-null-marks-through-native-stubs：`extern` 桩现在也写 attr-ref 块（`Attrs` / `ParamAttrs`），与 **abstract 桩**那一支对齐。此前 `IrGenMemberEmitter` 的 extern 分支压根不填这两个字段 ⇒ 源码里**已经标了** `?` 的 9 处 extern（`Environment.GetEnvironmentVariable` / `RuntimeConfig.Get`·`Describe` / `AppProperties.Get`·`Raw` / `ProcessNative.Which` 等）过了包边界哨兵就没了，导入侧标记位恒落 false。⚠️ **bump 的真正理由是诊断变**：跨包调用这些 extern 并直接解引用的源文件**此前编得过（零诊断）**、现在该报 E0478/E0479，而它们的**哈希一字未变** ⇒ 不 bump 就会命中旧条目、把新诊断整个吞掉（本线第四次栽在缓存上）；配套理由二：标了 `?` 的 extern 桩 attr 块多了哨兵 ⇒ zpkg 字节变。⚠️ 全用现有通道（骑 `$ByRef`/`$Deprecated` 那条 attr-ref 路）⇒ **无格式 bump**。实测：extern 声明里 `ref` 形参 0 处、默认值 0 处 ⇒ 顺带的 `$RefSig`/`$Default` 哨兵均为空转。 上一档 14：fix-tuple-name-substring-judgment：元组模式的判据从**名字含子串**（`IndexOf("ValueTuple") >= 0`）改为**整名精确匹配** `ValueTuple2..8` ⇒ 名字里含 ValueTuple 的**用户类型**不再被当成元组。此前实测：`struct MyValueTupleBox` 与逐字段同形的 `struct PlainBox` 只差一个名字，前者 `case (a, b)` **编译零诊断**并走 blob 偏移解构、后者报 E0402 —— 能力按名字子串分叉（漏报）。⚠️ **bump 的真正理由**：那类源文件**此前编得过**（零诊断、照常发 `StructFieldGetPrim`）⇒ 哈希不变而结果变（现在报 E0402），不 bump 会复用旧条目、新诊断永不发射。⚠️ stdlib / 语料里没有这种 lookalike 命名 ⇒ CI 的 fingerprint 守门测不到（只会漏判），按 version-bumping.md 手动 bump。　⚠️ 让号实录：#791 先合占 12（`3d525743c`）、#795 让到 13 并已合入（`dc3ec1afd`）⇒ 本 PR 让到 14（parallel-development.md §4.1「按合并顺序让号」）。 上一档 13：fix-unary-operator-overload：`operator X` 重载的两种不成立写法从**静默接受**改为报错（E0495）——表外符号（`!` / `~` / `&&` …）此前回落 `"op_" + op` 造出**非法名**，`fn @Vec.op_!$1$Vec` 真的被发进 zbc；一元 `-` 撞进表里的 `op_Subtract`、产出 `op_Subtract$1$T`。两者派发侧都查不到 ⇒ 方法**永远不可达**。⚠️ **bump 的真正理由**：这两种写法**此前编得过**（声明处零诊断、照常发码，只在使用处报一句无关的 `E0402`）⇒ 那类源文件**哈希不变而结果变**（现在编不过），不 bump 就会复用旧编译器产出的缓存条目、新诊断永不发射。⚠️ stdlib / 编译器自身一处这种声明都没有（全仓 20 处 `operator` 声明全是二元 + 表内）⇒ CI 的 fingerprint 守门测不到这条路径（只会漏判），按 version-bumping.md「这类改动仍手动 bump」。⚠️ 让号实录：#791 与本 PR 曾同取 12，#791 先合入 main（`3d525743c`）⇒ 本 PR 按 parallel-development.md §4.1「按合并顺序让号」rebase 时让到 13。 上一档 12：define-null-check-marks 3.3：`?` 标记跨包携带 —— 形参挂 `$Nullable`、返回值挂**方法级** `$RetNullable`，骑 `$ByRef`/`$Deprecated` 那条既有 attr-ref 通道 ⇒ **无格式 bump**。⚠️ **不能把 `?` 拼进 SIGS 类型名**：那串同时是**派发键**（`Find$1$string`），改它就打烂派发与全部 golden —— `FunctionEmitter._sigTypeName` 历来剥 `?` 正是这个原因（规范里「TsigTypeName 已双向拼写」是**假前提**，实测 zpkg 里一个 `?` 都没有，只有 extern 声明那条路例外）。bump 有**两条**理由，都成立：① 标了 `?` 的方法其 attr 块多了哨兵 ⇒ zpkg 字节变；② 更要紧的是**诊断变**——跨包调用点的源文件**哈希不变**，此前编得过、现在该报 E0478/E0479/E0489，不 bump 就会命中旧条目、把新诊断整个吞掉（本线第三次栽在缓存上）。 上一档 11：define-null-check-marks D5：`Expect("理由")` intrinsic（空检查义务的唯一显式逃生口）—— `x.Expect("r")` 现在合成 `ConstNull + Eq + BrCond + ConstStr + ObjNew + Throw`（全用现有指令 ⇒ **无格式 bump**，同上一档 9）。⚠️ **bump 的真正理由是懒加载 stub 收者那条路**：普通收者上 `….Expect(…)` 此前报「no method `Expect`」、编不过 ⇒ 根本不存在缓存条目；但 `_bindInstanceMemberCall` 的 `_stub` 分支（懒加载未载真类）此前是**松绑定、不报错**的 ⇒ 那类源文件**哈希不变而发码变**，不 bump 就会复用旧编译器产出的条目。⇒ 写 bump 理由时要找真那条路，别拿「新特性的用法」当理由（那些写法本来就编不过）。 上一档 10：fix-foreach-protocol-detection：`foreach` 的可迭代协议判定改看**成员面**（`ForeachProtocol.MethodsOf`/`FieldsOf`），不再只认类那条继承线 ⇒ 目标静态类型是**接口**时，此前三条路径全落空、静默落数组臂发 `array_len`（运行期抛 `ArrayLen: expected array`），现在正常走枚举器/索引路径；计数成员两档（`Count`→`Length`）也收敛到单一判定点（此前路径选择只认 `Count`、发射参数认两档，判据分叉）。全用现有指令 ⇒ **无格式 bump**。含 foreach-over-interface 的源文件**哈希不变而发码变** ⇒ 不 bump 就会复用旧编译器产出的缓存条目（那里对着一个对象发 `array_len`）。⚠️ stdlib 里没有 foreach-over-interface ⇒ CI 的 fingerprint 守门测不到这条路径（只会漏判），按 version-bumping.md「这类改动仍手动 bump」。 上一档 9：throw-on-switch-expr-no-match：`switch` 表达式的落空块从 `Br(end)` 改为合成 `ConstStr + ToStr + StrConcat + ObjNew + Throw`（全用现有指令 ⇒ **无格式 bump**）。含不穷尽 switch 表达式的源文件**哈希不变而发码变** ⇒ 不 bump 就会复用旧编译器产出的缓存条目（那里 `result` 读未初始化槽位、跑出垃圾值）。 上一档 8：record-ref-in-signature：`ref` 形参经 param attr-ref 通道跨包传播（`$ByRef` 逐形参 + `$RefSig` 方法级完备性标记，骑 zbc 1.15 既有通道 ⇒ **无格式 bump**）。每个方法的 param attr 块都多了标记 ⇒ 编出的 zpkg 字节变 ⇒ 按「编译器语义指纹」必须 bump。 上一档 7：workspace-read-cache：workspace 成员编译改为封闭（看不见拓扑序在后的成员）——此前后序成员的同名方法让依赖索引出歧义键被剔除，封闭后解析为直接调用（z42.json 实测 Dictionary.Get/Set/ContainsKey 由派发变直调）→ 输出变，bump。 上一档 6：add-implicit-base-ctor-call（#663）实例 ctor 隐式 base() + 构造器继承 / 默认构造器进符号层（codegen 与 TSIG 输出变）。再 上一档 5：unify-ir-operand-access：REGT 收集改走统一操作数接口，void 型 extern 桩结果寄存器 Unknown→Void。

    // rel（.z42）→ cache 内路径。与 driver `_writeCacheZbc` 同款「去 .z42」规则。
    public static string ZbcPath(string cacheDir, string rel)  { return Path.Join(cacheDir, CacheStore._stem(rel) + ".zbc"); }
    public static string MetaPath(string cacheDir, string rel) { return Path.Join(cacheDir, CacheStore._stem(rel) + ".meta"); }

    private static string _stem(string rel) {
        if (rel.EndsWith(".z42")) { return rel.Substring(0, rel.Length - 4); }
        return rel;
    }

    // 序列化（行式；集合按传入序写出——调用方保证确定性来源）。
    // 逐行进 parts 再一次 ConcatParts：`s = s + …` 在大模块（token/pool 上千行）上是平方级拷贝。
    public static string Serialize(CacheMeta m) {
        int total = 6 + m.NsCount + m.SurfIdentCount + m.UsedDepNsCount + m.TokenCount + m.PoolCount + m.FnLabelsCount;
        string[] parts = new string[total];
        int k = 0;
        parts[k] = "z42c-meta " + CacheStore.MetaVersion.ToString() + "\n"; k = k + 1;
        parts[k] = "z42c-fp " + CacheStore.CompilerFingerprint.ToString() + "\n"; k = k + 1;
        parts[k] = "zbc " + ZbcVersion.Minor.ToString() + "\n"; k = k + 1;
        parts[k] = "zpkg " + ZpkgWriterZ.Minor.ToString() + "\n"; k = k + 1;
        parts[k] = "hash " + m.SourceHash + "\n"; k = k + 1;
        parts[k] = "ns " + m.Namespace + "\n"; k = k + 1;
        int i = 0;
        while (i < m.NsCount) { parts[k] = "nsurf " + m.NsNames[i] + " " + m.NsHashes[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.SurfIdentCount) { parts[k] = "sident " + m.SurfIdents[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.UsedDepNsCount) { parts[k] = "useddep " + m.UsedDepNs[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.TokenCount) { parts[k] = "token " + m.Tokens[i] + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.PoolCount) { parts[k] = "pool " + CacheStore.HexEnc(m.Pool[i]) + "\n"; k = k + 1; i = i + 1; }
        i = 0;
        while (i < m.FnLabelsCount) { parts[k] = "labels " + m.FnLabels[i] + "\n"; k = k + 1; i = i + 1; }
        return String.ConcatParts(parts, k);
    }

    // 解析；版本 pin（metaVersion/zbc/zpkg）任一不符或格式坏 → null（= 条目作废）。
    public static CacheMeta Parse(string text, string rel) {
        CacheMeta m = new CacheMeta(rel);
        bool verOk = false;
        bool fpOk = false;
        bool zbcOk = false;
        bool zpkgOk = false;
        string[] lines = text.Split("\n");
        int i = 0;
        while (i < lines.Length) {
            string line = lines[i];
            i = i + 1;
            if (line.Length == 0) { continue; }
            int sp = line.IndexOf(" ");
            if (sp < 0) { return null; }
            string key = line.Substring(0, sp);
            string val = line.Substring(sp + 1);
            if (key == "z42c-meta")    { verOk = (val == CacheStore.MetaVersion.ToString()); }
            else if (key == "z42c-fp") { fpOk = (val == CacheStore.CompilerFingerprint.ToString()); }
            else if (key == "zbc")     { zbcOk = (val == ZbcVersion.Minor.ToString()); }
            else if (key == "zpkg")    { zpkgOk = (val == ZpkgWriterZ.Minor.ToString()); }
            else if (key == "hash")    { m.SourceHash = val; }
            else if (key == "nsurf") {
                // `nsurf <name> <hash>`：名字是标识符（无空格），hash 是 hex（无空格）→ 首个空格即分界。
                int gap = val.IndexOf(" ");
                if (gap <= 0) { return null; }
                m.NsNames = CacheStore._append(m.NsNames, m.NsCount, val.Substring(0, gap));
                m.NsHashes = CacheStore._append(m.NsHashes, m.NsCount, val.Substring(gap + 1));
                m.NsCount = m.NsCount + 1;
            }
            else if (key == "sident") {
                m.SurfIdents = CacheStore._append(m.SurfIdents, m.SurfIdentCount, val);
                m.SurfIdentCount = m.SurfIdentCount + 1;
            }
            else if (key == "ns")      { m.Namespace = val; }
            else if (key == "useddep") {
                m.UsedDepNs = CacheStore._append(m.UsedDepNs, m.UsedDepNsCount, val);
                m.UsedDepNsCount = m.UsedDepNsCount + 1;
            }
            else if (key == "token") {
                m.Tokens = CacheStore._append(m.Tokens, m.TokenCount, val);
                m.TokenCount = m.TokenCount + 1;
            }
            else if (key == "pool") {
                m.Pool = CacheStore._append(m.Pool, m.PoolCount, CacheStore.HexDec(val));
                m.PoolCount = m.PoolCount + 1;
            }
            else if (key == "labels") {
                m.FnLabels = CacheStore._append(m.FnLabels, m.FnLabelsCount, val);
                m.FnLabelsCount = m.FnLabelsCount + 1;
            }
            else { return null; }   // 未知键 = 未来格式 → 按坏条目处理（宁 fresh 不误命中）
        }
        if (!verOk || !fpOk || !zbcOk || !zpkgOk) { return null; }
        if (m.SourceHash.Length == 0) { return null; }
        return m;
    }

    // 写盘（建父目录）。调用方负责 try/catch 降级（cache 写失败不致命）。
    public static void Save(string cacheDir, CacheMeta m) {
        string p = CacheStore.MetaPath(cacheDir, m.Rel);
        string parent = Path.GetDirectoryName(p);
        if (parent.Length > 0) { Directory.Create(parent); }
        File.WriteAllText(p, CacheStore.Serialize(m));
    }

    // 读盘：meta 缺失 / 解析失败 / 版本不符 / 同名 zbc 缺失 → null（该文件 fresh）。
    public static CacheMeta Load(string cacheDir, string rel) {
        string p = CacheStore.MetaPath(cacheDir, rel);
        if (!File.Exists(p)) { return null; }
        if (!File.Exists(CacheStore.ZbcPath(cacheDir, rel))) { return null; }
        try {
            return CacheStore.Parse(File.ReadAllText(p), rel);
        } catch (Exception e) {
            return null;
        }
    }

    private static string[] _append(string[] arr, int count, string v) {
        if (count < arr.Length) { arr[count] = v; return arr; }
        int cap = arr.Length == 0 ? 4 : arr.Length * 2;
        string[] b = new string[cap];
        int i = 0;
        while (i < count) { b[i] = arr[i]; i = i + 1; }
        b[count] = v;
        return b;
    }

    // ── 串 hex(UTF-8) 编解码（meta 行值免转义；label/池串可含空格、换行、任意 Unicode）──

    public static string HexEnc(string s) {
        byte[] b = Utf8.GetBytes(s);
        string ds = "0123456789abcdef";
        char[] cs = new char[b.Length * 2];
        int i = 0;
        while (i < b.Length) {
            int v = (int)b[i];
            cs[i * 2] = ds.CharAt((v >> 4) & 0xF);
            cs[i * 2 + 1] = ds.CharAt(v & 0xF);
            i = i + 1;
        }
        return String.FromChars(cs);
    }

    public static string HexDec(string hex) {
        int n = hex.Length / 2;
        byte[] b = new byte[n];
        int i = 0;
        while (i < n) {
            b[i] = (byte)((CacheStore._nib(hex.CharAt(i * 2)) << 4) | CacheStore._nib(hex.CharAt(i * 2 + 1)));
            i = i + 1;
        }
        return Utf8.GetString(b);
    }

    private static int _nib(char c) {
        if (c >= '0' && c <= '9') { return (int)c - 48; }
        if (c >= 'a' && c <= 'f') { return (int)c - 87; }
        if (c >= 'A' && c <= 'F') { return (int)c - 55; }
        return 0;
    }

    // ── 包级源清单（增删文件 → 全量；spec 场景「源文件增删」）────────────────────

    // depsId = DepIdentity.Of(...)：本次编译扫到的依赖 zpkg 身份；下次不符 ⇒ 整包全量。
    public static void SaveSrcList(string cacheDir, string[] rels, int n, string depsId) {
        string s = "z42c-meta " + CacheStore.MetaVersion.ToString() + "\n"
                 + "z42c-fp " + CacheStore.CompilerFingerprint.ToString() + "\n"
                 + "zbc " + ZbcVersion.Minor.ToString() + "\n"
                 + "zpkg " + ZpkgWriterZ.Minor.ToString() + "\n"
                 + "deps " + depsId + "\n";
        int i = 0;
        while (i < n) { s = s + "src " + rels[i] + "\n"; i = i + 1; }
        Directory.Create(cacheDir);
        File.WriteAllText(Path.Join(cacheDir, "package.meta"), s);
    }

    // 上次源清单；缺失/pin 不符/依赖身份不符/格式坏 → null（= 全量）。
    public static string[] LoadSrcList(string cacheDir, string depsId) {
        string p = Path.Join(cacheDir, "package.meta");
        if (!File.Exists(p)) { return null; }
        string text = "";
        try { text = File.ReadAllText(p); } catch (Exception e) { return null; }
        string[] lines = text.Split("\n");
        string[] rels = new string[4];
        int n = 0;
        bool verOk = false; bool fpOk = false; bool zbcOk = false; bool zpkgOk = false; bool depsOk = false;
        int i = 0;
        while (i < lines.Length) {
            string line = lines[i];
            i = i + 1;
            if (line.Length == 0) { continue; }
            int sp = line.IndexOf(" ");
            if (sp < 0) { return null; }
            string key = line.Substring(0, sp);
            string val = line.Substring(sp + 1);
            if (key == "z42c-meta")  { verOk = (val == CacheStore.MetaVersion.ToString()); }
            else if (key == "z42c-fp") { fpOk = (val == CacheStore.CompilerFingerprint.ToString()); }
            else if (key == "zbc")   { zbcOk = (val == ZbcVersion.Minor.ToString()); }
            else if (key == "zpkg")  { zpkgOk = (val == ZpkgWriterZ.Minor.ToString()); }
            else if (key == "deps")  { depsOk = (val == depsId); }
            else if (key == "src")   { rels = CacheStore._append(rels, n, val); n = n + 1; }
            else { return null; }
        }
        if (!verOk || !fpOk || !zbcOk || !zpkgOk || !depsOk) { return null; }
        string[] r = new string[n];
        i = 0;
        while (i < n) { r[i] = rels[i]; i = i + 1; }
        return r;
    }
}
