// z42c 编译器的 ICompiler 实现（wire-z42b D2）。z42b 构建编排器经 z42.build 的 ICompiler 接口
// **在进程内**调本类（不 fork z42c 子进程、不依赖 z42vm 在 PATH、诊断以结构返回）。
//
// drop-legacy-compile-request：本类只是 BuildSession 的薄封装（Role = HostTarget）——编译决策全部来自
// `req.Manifest`（[optimize] / [syntax] / [lints] / [analyzers] / entry / version / 依赖核验），与 `z42c build`
// 同一判据。`req.Manifest` 为 null 直接判失败：此前那条「只看平铺字段」的旧路径与 BuildSession 各自一份编译流程，
// 已经分叉过（BuildSession 首版漏调 `HandlerRegistry.RunAst`）。依赖从磁盘解析：req.Deps 各 zpkg 的父目录集 → 解析域。
namespace Z42.Pipeline;

using Std;
using Std.IO;
using Z42.Build;
using Z42.Project;

public class Z42cCompiler : ICompiler {

    public CompileResult Compile(CompileRequest req) {
        if (req.Manifest == null) {
            return new CompileResult("", "", false,
                "z42c: CompileRequest.Manifest is required (the flat-field request form was removed; pass the project manifest)");
        }
        return Z42cCompiler._viaSession(req);
    }

    // HostTarget：packed 单产物、不解析 path 闭包（z42b 自己编排闭包）、不增量。解析域 = req.Deps 各 zpkg 的父目录集。
    private static CompileResult _viaSession(CompileRequest req) {
        string[] libs = new string[req.Deps.Length];
        int libsN = 0;
        int d = 0;
        while (d < req.Deps.Length) {
            string dir = Path.GetDirectoryName(req.Deps[d]);
            if (dir == "") { dir = "."; }
            bool seen = false;
            int k = 0;
            while (k < libsN) { if (libs[k] == dir) { seen = true; } k = k + 1; }
            if (!seen) { libs[libsN] = dir; libsN = libsN + 1; }
            d = d + 1;
        }
        CollectingReporter rep = new CollectingReporter();
        BuildOptions o = new BuildOptions(req.Manifest, req.SourceDir, BuildRole.HostTarget, req.Profile == "release", rep);
        if (req.PackageName != "") { o.Label = req.PackageName; }
        o.BaseLibs = libs; o.BaseLibsN = libsN;
        o.OutputZpkg = req.OutputZpkg;
        o.Excludes = req.Excludes; o.ExcludesCount = req.ExcludesCount;
        o.ParentPkg = req.ParentPkg;
        BuildResult br = new BuildSession(o).Run();
        CompileResult res = new CompileResult(br.OutZpkg, br.OutZsym, br.Code == BuildExit.Ok, rep.ErrorsText());
        res.Warnings = rep.WarningsText();
        return res;
    }
}
