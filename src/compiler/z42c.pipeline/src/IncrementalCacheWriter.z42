// Per-file cache persistence shared by both compilation entry points.
namespace Z42.Pipeline;
using Z42.Core;
using Z42.Package;
using Z42.Emission;

public static class IncrementalCacheWriter {
    public static string Write(string cacheDir, string projectDir, string[] srcs, string[] texts, string[] hashes,
        CompiledModuleZ[] cms, ZbcFileZ[] mods, IncrPrep prep, NameListZ[] idents, NameSurfacesZ[] surfaces,
        string depsId, LanguageFeatures feats, CuDiagSnapshot[] cuDiags) {
        try {
            // zbc 必须**先于** meta 写：meta 是「这份 zbc 有效」的证明，反过来写中途崩溃会留下新 meta 配旧 zbc。
            // parallel-parse-and-cache：逐文件 zbc 互不依赖，各写自己的文件与 zbcHashes 槽 ⇒ 可并行（jobs=1 时内联）。
            // Any failed file prevents publishing metadata for this write batch.
            string[] zbcHashes = new string[srcs.Length];
            CacheZbcTask zt = new CacheZbcTask(cacheDir, projectDir, srcs, mods, prep, zbcHashes);
            ParallelFor.Run(srcs.Length, ParallelConfig.Jobs(srcs.Length), zt);
            if (zt.Error != "") { throw new Exception(zt.Error); }
            // meta（hash/ns/usedDepNs + D5a 残留 pool/labels）+ 包级源清单。
            IncrementalCompilation.WriteMetas(cacheDir, projectDir, srcs, texts, hashes, srcs.Length,
                                         cms, mods, prep != null ? prep.Plan : null, idents, surfaces, depsId, feats,
                                         cuDiags, zbcHashes);
            return "";
        } catch (Exception e) {
            return e.Message;
        }

    }
}

// 第 i 个源文件的 cache zbc（_writeBuildCache 的并行体）。只写第 i 个槽；失败记下首条消息，由调用方整体放弃。
sealed class CacheZbcTask : IParallelTask {
    private string _cacheDir; private string _projectDir; private string[] _srcs; private ZbcFileZ[] _mods;
    private IncrPrep _prep; private string[] _hashes;
    public string Error;
    public CacheZbcTask(string cacheDir, string projectDir, string[] srcs, ZbcFileZ[] mods, IncrPrep prep, string[] hashes) {
        this._cacheDir = cacheDir; this._projectDir = projectDir; this._srcs = srcs; this._mods = mods;
        this._prep = prep; this._hashes = hashes; this.Error = "";
    }
    public void Run(int i) {
        this._hashes[i] = "";
        if (this._prep != null && !this._prep.Plan.Fresh[i]) { return; }
        try {
            this._hashes[i] = IncrementalCompilation.WriteCacheZbc(this._cacheDir, this._projectDir, this._srcs[i], this._mods[i].Module);
        } catch (Exception e) {
            if (this.Error == "") { this.Error = e.Message; }
        }
    }
}
