// 整包装配后的 `ObjNew.CtorKnown` 置位（encode-ctorless-objnew，zbc 1.39）。
//
// ## 这个 pass 解决什么
//
// `stabilize-instance-dispatch-keys` 规定 primary 构造器占**裸键**，于是零构造器类与单构造器类
// 在调用点发出的 ctor 名**同形**（都是 `Ns.C.C`）。运行期拿到「这个名字解析不到」这一个事实，
// 无法区分：
//
//   (a) 这个类本来就没有构造器            → 照常零初始化（正确）
//   (b) 构造器本该在，但装的包比编译时旧  → 依赖版本 skew，应当报错
//
// 于是 `missing_ctor_exception` 长期只能靠「有没有实参」近似判定，`argc == 0` 是个公开缺口。
//
// 本 pass 把**编译器知道的事**写进指令：凡是 ctor 名在「本包全部已发射函数 ∪ `DependencyIndex`」
// 里看得见的站点，置 `CtorKnown = true`。运行期于是能把 (a) 与 (b) 分开。
//
// ## 为什么必须等到整包装配之后
//
// 发射端（`CallEmitter._emitNew`）那一刻答案还不存在：
//
//   * z42c 为「有字段初始化器、无显式 ctor」的类**合成**隐式构造器
//     （`IrGenTypeEmitter._emitSynthCtor`），它既不是 `MethodSymbol`、也不在 `_bindNew` 时存在
//     （`DeclBinder._synthCtors` 跑在 `TypeChecker.Infer` 的全部绑定之后）；
//   * 本 CU 的 `IrModule` 看不到**同包其它文件**的函数，而 `Deps` 按设计不含本包。
//
// 装配点两者都齐了：全部文件的 IR 都已发射完毕，合成构造器就是其中一个普通的已发射函数。
//
// ## 为什么是**正向**位（缺席即保守）
//
// 反过来编码（「零构造器」发空 ctor 名）会**新引入**一种静默：编译时依赖 v2 的 `class C { }`
// 发空名，运行时装到 v1 的 `class C { C() {…} }` ⇒ v1 的构造器被悄悄跳过。正向位没有这个问题
// ——证不出来就不置位，名字原样保留，运行期行为与置位机制引入前逐字一致。
//
// ## 增量安全
//
// 每次装配**重算**全部站点（不是只置位、不是 OR）。故「A 文件的 IrModule 从增量缓存来、其中
// 某个类的构造器在 B 文件里刚被删/加」不会留下过期结论 —— cached `IrModule` 也在 `mods` 里，
// 一起被重扫、重写。
namespace Z42.Pipeline;

using Std;
using Z42.IR;

public static class CtorKnownFixup {
    // 对整包的全部 IrModule 就地置位。deps 允许为 null（单文件 / 无依赖编译）。
    public static void Apply(IrModule[] mods, int count, DependencyIndex deps) {
        if (mods == null || count <= 0) { return; }
        // ① 本包已发射函数名全集（跨全部 CU）。
        StrMap pkgFns = new StrMap();
        int mi = 0;
        while (mi < count) {
            IrModule m = mods[mi];
            if (m != null) {
                int fi = 0;
                while (fi < m.FuncCount) {
                    IrFunction f = m.Functions[fi];
                    if (f != null && f.Name != null) { pkgFns.TryAdd(f.Name, "1"); }
                    fi = fi + 1;
                }
            }
            mi = mi + 1;
        }
        // ② 逐条 ObjNew 重算。
        mi = 0;
        while (mi < count) {
            IrModule m = mods[mi];
            if (m != null) {
                int fi = 0;
                while (fi < m.FuncCount) {
                    CtorKnownFixup._fixFunction(m.Functions[fi], pkgFns, deps);
                    fi = fi + 1;
                }
            }
            mi = mi + 1;
        }
    }

    private static void _fixFunction(IrFunction f, StrMap pkgFns, DependencyIndex deps) {
        if (f == null) { return; }
        int bi = 0;
        while (bi < f.BlockCount) {
            IrBlock b = f.Blocks[bi];
            if (b != null) {
                int ii = 0;
                while (ii < b.InstrCount) {
                    if (b.Instrs[ii] is ObjNewInstr) {
                        ObjNewInstr o = b.Instrs[ii] as ObjNewInstr;
                        o.CtorKnown = CtorKnownFixup._visible(o.CtorName, pkgFns, deps);
                    }
                    ii = ii + 1;
                }
            }
            bi = bi + 1;
        }
    }

    // ctor 名在编译器视野里看得见吗？空名 = `IrLoopAllocReuse._bareObjNew` 的裸分配，从来不代表
    // 任何构造器 → 永远 false。
    private static bool _visible(string ctorName, StrMap pkgFns, DependencyIndex deps) {
        if (ctorName == null || ctorName == "") { return false; }
        if (pkgFns.ContainsKey(ctorName)) { return true; }
        // Deps.Statics 按**完整 FQ** 注册了每个依赖包的每一个已发射函数（`AddModule`），合成
        // 构造器天然在内。短类名键不查——那是 first-wins 的模糊键，会把别的包的同短名误判成命中。
        if (deps != null && deps.Statics.ContainsKey(ctorName)) { return true; }
        return false;
    }
}
