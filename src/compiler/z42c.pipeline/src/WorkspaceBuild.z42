// Workspace 成员规划的种子转发层。实现在 z42.project 的 `WorkspacePlan`（z42c / z42b 共用）。
//
// 种子 driver 自举 `z42c build --workspace` 时调的是 `Z42.Pipeline.WorkspaceBuild.Plan` / `PlanLayout`，
// 运行期加载的却是仓内新建的 z42c.pipeline ⇒ 入口与 `WsPlan` 形状须留到种子换代。
// STAGE2-DEBT(ws-plan-forwarders): 含 WorkspacePlan 的 nightly 发布后删掉本文件（WsPlan + 两个转发入口）。
namespace Z42.Pipeline;

using Z42.Project;

public sealed class WsPlan {
    public string[] Tomls;
    public string[] DistDirs;
    public string[] CacheDirs;
    public int      Count;
    public WsPlan(string[] tomls, string[] distDirs, string[] cacheDirs, int count) {
        this.Tomls = tomls; this.DistDirs = distDirs; this.CacheDirs = cacheDirs; this.Count = count;
    }
}

public static class WorkspaceBuild {
    public static string[] Plan(string wsToml) { return WorkspacePlan.Plan(wsToml); }

    public static WsPlan PlanLayout(string wsToml, string profile) {
        WorkspaceLayoutPlan p = WorkspacePlan.PlanLayout(wsToml, profile);
        return new WsPlan(p.Tomls, p.DistDirs, p.CacheDirs, p.Count);
    }
}
