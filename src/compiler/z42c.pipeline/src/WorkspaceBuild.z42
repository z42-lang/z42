// Workspace build planning (z42c-build-workspace, 2026-06-21).
//
// 端口 C# z42.Pipeline.WorkspaceBuildOrchestrator + MemberDependencyGraph 的
// 「成员发现 + dep 拓扑序」核心。z42c 受限子集：无交错数组 → flat 平行数组；
// 无 enum → 颜色/状态用 int/bool。
//
// `Plan(wsToml)` 返回**拓扑序的成员 manifest 路径**（叶子在前），driver 据此
// 逐个 `_build`。同层（互不依赖）按 member 名 Ordinal 排序，与 C#
// TopologicalLayers（层内 name-sort）逐字节一致。
//
// 当前仅支持 `members = ["*"]`（z42c + stdlib 唯一用法）：workspace 目录下每个
// 「恰含一份 *.z42.toml」的子目录 = 一个 member。显式 path / 多 pattern 留 follow-up。
namespace Z42.Pipeline;

using Std;
using Std.IO;
using Z42.Project;

// 成员发现结果：flat 平行数组（z42 无交错数组）。
//   Tomls[i] / Names[i] = 成员 i 的 manifest 路径 / [project].name
//   Deps 为 flat：成员 i 的依赖名 = DepFlat[DepOff[i] .. DepOff[i]+DepLen[i]]
public sealed class WsMembers {
    public string[] Tomls;
    public string[] Names;
    public string[] DepFlat;
    public int[]    DepOff;
    public int[]    DepLen;
    public int      Count;
    public WsMembers(string[] tomls, string[] names, string[] depFlat,
                     int[] depOff, int[] depLen, int count) {
        this.Tomls = tomls; this.Names = names; this.DepFlat = depFlat;
        this.DepOff = depOff; this.DepLen = depLen; this.Count = count;
    }
}

// 拓扑序的 per-member 构建计划（Milestone 2 drop-in 布局）。
//   Tomls[i] = 成员 i 的 manifest 路径（叶子在前）
//   DistDirs[i] = 成员 i 的产物 dist 目录（= 展开 [workspace.build].output_dir 模板 + "/dist"）
//   CacheDirs[i] = 成员 i 的 cache 目录（cache-dir-layout：[workspace.build].cache_dir 模板，没配置 = "${output_dir}/.cache"）
public sealed class WsPlan {
    public string[] Tomls;
    public string[] DistDirs;
    public string[] CacheDirs;
    public int      Count;
    public WsPlan(string[] tomls, string[] distDirs, string[] cacheDirs, int count) {
        this.Tomls = tomls; this.DistDirs = distDirs; this.CacheDirs = cacheDirs; this.Count = count;
    }
}

public static class WorkspaceBuild {

    // wsToml → 拓扑序的成员 manifest 路径数组（叶子在前；环 → 抛 Exception）。
    public static string[] Plan(string wsToml) {
        WorkspaceManifest ws = ManifestLoader.LoadWorkspace(wsToml);
        string wsDir = Path.GetDirectoryName(wsToml);
        if (wsDir == "") { wsDir = "."; }

        WsMembers m = WorkspaceBuild.DiscoverMembers(wsDir, ws);
        int[] order = WorkspaceBuild.TopoOrder(m);   // 成员索引的拓扑序
        string[] ordered = new string[m.Count];
        int i = 0;
        while (i < m.Count) { ordered[i] = m.Tomls[order[i]]; i = i + 1; }
        return ordered;
    }

    // Milestone 2 drop-in：拓扑序成员 + 每成员 dist 目录（无须 --output-dir）。
    // dist = resolve([workspace.build].output_dir 模板, ctx) + "/dist"，镜像 C#
    // CentralizedBuildLayout.ResolveWorkspace（dist_dir 默认 ${output_dir}/dist）。
    // 未声明 output_dir 时用默认模板 `artifacts/${project_name}/${profile}`（unify-build-layout）。
    // profile = "release" / "debug"（${profile} 替换）。
    public static WsPlan PlanLayout(string wsToml, string profile) {
        WorkspaceManifest ws = ManifestLoader.LoadWorkspace(wsToml);
        // 未声明 [workspace.build].output_dir → 默认模板（WorkspaceLayout.OutputTemplate），不再返回 null。
        string wsDir = Path.GetDirectoryName(wsToml);
        if (wsDir == "") { wsDir = "."; }

        WsMembers m = WorkspaceBuild.DiscoverMembers(wsDir, ws);
        int[] order = WorkspaceBuild.TopoOrder(m);
        string[] tomls = new string[m.Count];
        string[] dists = new string[m.Count];
        string[] caches = new string[m.Count];
        int i = 0;
        while (i < m.Count) {
            int idx = order[i];
            string toml = m.Tomls[idx];
            string name = m.Names[idx];
            string memberDir = Path.GetDirectoryName(toml);
            if (memberDir == "") { memberDir = "."; }
            // 成员布局的唯一实现在 z42.project 的 WorkspaceLayout（unify-build-layout）——
            // 单独构建成员 / path 依赖代建 / 产物查询（BuildLayout.Resolve）用的是同一套规则。
            string outAbs = WorkspaceLayout.MemberOutputDir(ws, wsDir, memberDir, name, profile);
            tomls[i] = toml;
            dists[i] = Path.Join(outAbs, "dist");
            caches[i] = WorkspaceBuild.ResolveMemberCacheDir(ws, wsDir, memberDir, name, profile, outAbs);
            i = i + 1;
        }
        return new WsPlan(tomls, dists, caches, m.Count);
    }

    // 成员 cache 目录（cache-dir-layout）—— 实现在 z42.project 的 WorkspaceLayout.MemberCacheDir
    //（unify-build-layout：与 BuildLayout.Resolve 的成员布局共用）。保留本入口供既有调用方。
    public static string ResolveMemberCacheDir(WorkspaceManifest ws, string wsDir, string memberDir,
                                               string name, string profile, string outAbs) {
        return WorkspaceLayout.MemberCacheDir(ws, wsDir, memberDir, name, profile, outAbs);
    }

    // 成员发现（fix-workspace-member-discovery）：按 `[workspace] members` 逐条展开（缺省 = `["*"]`），
    // 再按 `exclude` 剔除，清单经 `ManifestLocator.FindIn` 定位（认 `z42.toml` 与 `<name>.z42.toml`）。
    // 此前恒只扫 wsDir 下一层、只认 `*.z42.toml`，`members` / `exclude` 解析出来无人读取 ⇒
    // 手册示范的 `members = ["libs/*", "apps/*"]` 建不出任何成员、`exclude` 形同虚设、`z42 new` 生成的
    // 裸名 `z42.toml` 工程进不了 workspace。
    //   · 展开：段内 `*` / `?` 通配（逐段匹配子目录）；显式路径（无通配）必须存在且恰有一份清单，否则抛；
    //     通配展开出的目录没有清单就跳过（`members = ["*"]` 会扫到 artifacts/ 之类）。清单有歧义一律抛（WS005）。
    //   · `exclude`：按成员相对 wsDir 的路径做段级 glob（`PathGlob`）。
    //   · 去重 + Ordinal 排序（确定性，common-pitfalls §1）。
    public static WsMembers DiscoverMembers(string wsDir, WorkspaceManifest ws) {
        string[] pats = ws.Members;
        int patN = ws.MemberCount;
        if (patN == 0) { pats = new string[1]; pats[0] = "*"; patN = 1; }
        string[] rels = new string[8];
        int relN = 0;
        int pi = 0;
        while (pi < patN) {
            string pat = pats[pi].Replace("\\", "/");
            pi = pi + 1;
            if (pat.StartsWith("./")) { pat = pat.Substring(2, pat.Length - 2); }
            string[] segs = PathGlob.Split(pat);
            bool explicitPath = true;
            int si = 0;
            while (si < segs.Length) { if (PathGlob.HasWildcard(segs[si])) { explicitPath = false; } si = si + 1; }
            string[] found = WorkspaceBuild._expandMemberPattern(wsDir, segs);
            if (explicitPath && found.Length == 0) {
                throw new Exception("workspace: member `" + pats[pi - 1] + "` does not exist under " + wsDir);
            }
            int fi = 0;
            while (fi < found.Length) {
                if (WorkspaceBuild.IndexOfName(rels, relN, found[fi]) < 0) {
                    if (relN == rels.Length) {
                        string[] bigger = new string[rels.Length * 2];
                        int k = 0; while (k < relN) { bigger[k] = rels[k]; k = k + 1; }
                        rels = bigger;
                    }
                    rels[relN] = found[fi]; relN = relN + 1;
                }
                fi = fi + 1;
            }
        }
        string[] sorted = new string[relN];
        int ri = 0; while (ri < relN) { sorted[ri] = rels[ri]; ri = ri + 1; }
        sorted = WorkspaceBuild.SortStrings(sorted);
        // 第一遍：收集 member toml + name。
        string[] tomls = new string[relN];
        string[] names = new string[relN];
        int count = 0;
        int e = 0;
        while (e < relN) {
            string rel = sorted[e];
            e = e + 1;
            if (WorkspaceBuild._excludedMember(rel, ws)) { continue; }
            string dir = Path.Join(wsDir, rel);
            ManifestLocation loc = ManifestLocator.FindIn(dir);
            if (loc.Kind == ManifestLocateKind.Ambiguous) {
                throw new Exception("workspace: member directory `" + rel + "` has more than one manifest (WS005): "
                    + String.Join(", ", loc.Candidates));
            }
            if (loc.Kind != ManifestLocateKind.Project) { continue; }   // 无清单（通配扫到的普通目录）/ 嵌套 workspace
            ProjectManifest pm = ManifestLoader.Load(loc.ManifestPath);
            tomls[count] = loc.ManifestPath;
            names[count] = pm.Project.Name;
            count = count + 1;
        }
        // 第二遍：每 member 的 workspace 内依赖（flat）。
        string[] depFlat = new string[count * count];   // 上界：每对一条边
        int[]    depOff  = new int[count];
        int[]    depLen  = new int[count];
        int flat = 0;
        int i = 0;
        while (i < count) {
            ProjectManifest pm = ManifestLoader.Load(tomls[i]);
            depOff[i] = flat;
            int len = 0;
            int d = 0;
            while (d < pm.DepCount) {
                string dn = pm.Deps[d].Name;
                d = d + 1;
                // 仅保留指向本 workspace 内成员的边。
                if (WorkspaceBuild.IndexOfName(names, count, dn) >= 0) {
                    depFlat[flat] = dn;
                    flat = flat + 1;
                    len = len + 1;
                }
            }
            depLen[i] = len;
            i = i + 1;
        }
        return new WsMembers(tomls, names, depFlat, depOff, depLen, count);
    }

    // 一条 members 模式 → 命中的成员目录（相对 wsDir，`/` 分隔）。逐段扩张：字面段直接拼（存在才留），
    // 通配段枚举子目录后逐个 `PathGlob.MatchSeg`。
    private static string[] _expandMemberPattern(string wsDir, string[] segs) {
        string[] frontier = new string[1]; frontier[0] = "";
        int fn = 1;
        int si = 0;
        while (si < segs.Length) {
            string seg = segs[si];
            si = si + 1;
            string[] next = new string[8];
            int nn = 0;
            int fi = 0;
            while (fi < fn) {
                string baseRel = frontier[fi];
                fi = fi + 1;
                string baseDir = baseRel.Length == 0 ? wsDir : Path.Join(wsDir, baseRel);
                if (!PathGlob.HasWildcard(seg)) {
                    string cand = baseRel.Length == 0 ? seg : baseRel + "/" + seg;
                    if (Directory.Exists(Path.Join(wsDir, cand))) { next = WorkspaceBuild._push(next, nn, cand); nn = nn + 1; }
                    continue;
                }
                if (!Directory.Exists(baseDir)) { continue; }
                string[] entries = WorkspaceBuild.SortStrings(Directory.Enumerate(baseDir));
                int ei = 0;
                while (ei < entries.Length) {
                    // `Directory.Enumerate` 返回**条目名**，不是路径——此前直接拿名字去 `Directory.Exists`，
                    // 只在 cwd 恰好是 workspace 根时才对（从别处 `z42c build <path>/z42.workspace.toml` 即全落空）。
                    string name = Path.GetFileName(entries[ei]);
                    ei = ei + 1;
                    string full = Path.Join(baseDir, name);
                    if (!Directory.Exists(full)) { continue; }
                    if (!PathGlob.MatchSeg(name, 0, seg, 0)) { continue; }
                    string cand = baseRel.Length == 0 ? name : baseRel + "/" + name;
                    next = WorkspaceBuild._push(next, nn, cand); nn = nn + 1;
                }
            }
            frontier = next; fn = nn;
        }
        string[] r = new string[fn];
        int k = 0; while (k < fn) { r[k] = frontier[k]; k = k + 1; }
        return r;
    }

    private static bool _excludedMember(string rel, WorkspaceManifest ws) {
        int i = 0;
        while (i < ws.ExcludeCount) {
            string pat = ws.Exclude[i].Replace("\\", "/");
            if (pat.StartsWith("./")) { pat = pat.Substring(2, pat.Length - 2); }
            if (PathGlob.Match(rel, pat)) { return true; }
            i = i + 1;
        }
        return false;
    }

    private static string[] _push(string[] a, int n, string v) {
        if (n == a.Length) {
            string[] b = new string[a.Length * 2];
            int k = 0; while (k < n) { b[k] = a[k]; k = k + 1; }
            a = b;
        }
        a[n] = v;
        return a;
    }

    // O(N²) 拓扑：每轮发射「全部依赖已发射」的成员（按 member 名 Ordinal 排序），
    // 等价 C# TopologicalLayers（层内 name-sort）。无进展但未全发射 → 环。
    public static int[] TopoOrder(WsMembers m) {
        int n = m.Count;
        bool[] done = new bool[n];
        int[]  order = new int[n];
        int    oc = 0;
        // 预排序的成员索引（按 name Ordinal）—— 保证就绪集发射序确定。
        int[] byName = WorkspaceBuild.IndicesByName(m.Names, n);
        while (oc < n) {
            bool progress = false;
            int k = 0;
            while (k < n) {
                int idx = byName[k];
                k = k + 1;
                if (done[idx]) { continue; }
                if (WorkspaceBuild.AllDepsDone(m, idx, done)) {
                    order[oc] = idx;
                    oc = oc + 1;
                    done[idx] = true;
                    progress = true;
                }
            }
            if (!progress) {
                throw new Exception("z42c build --workspace: circular member dependency");
            }
        }
        return order;
    }

    // 成员 idx 的全部 workspace 内依赖是否都已发射。
    public static bool AllDepsDone(WsMembers m, int idx, bool[] done) {
        int off = m.DepOff[idx];
        int len = m.DepLen[idx];
        int j = 0;
        while (j < len) {
            string dn = m.DepFlat[off + j];
            j = j + 1;
            int di = WorkspaceBuild.IndexOfName(m.Names, m.Count, dn);
            if (di < 0) { continue; }       // 外部 dep（理论上已过滤）
            if (!done[di]) { return false; }
        }
        return true;
    }

    // names[0..count) 中 name 的索引；无 → -1。
    public static int IndexOfName(string[] names, int count, string name) {
        int i = 0;
        while (i < count) {
            if (names[i] == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // 0..n-1 按 names[i] Ordinal 升序的索引数组（插入排序，n 小）。
    public static int[] IndicesByName(string[] names, int n) {
        int[] idx = new int[n];
        int i = 0;
        while (i < n) { idx[i] = i; i = i + 1; }
        int a = 1;
        while (a < n) {
            int cur = idx[a];
            int b = a - 1;
            while (b >= 0 && WorkspaceBuild.StrLess(names[cur], names[idx[b]])) {
                idx[b + 1] = idx[b];
                b = b - 1;
            }
            idx[b + 1] = cur;
            a = a + 1;
        }
        return idx;
    }

    // x < y（Ordinal）。z42 string.CompareTo 是 Ordinal（DepScan._sortedZpkgs 同款）。
    public static bool StrLess(string x, string y) {
        return x.CompareTo(y) < 0;
    }

    // 字符串数组 Ordinal 升序（插入排序，确定性）。
    public static string[] SortStrings(string[] arr) {
        int n = arr.Length;
        string[] r = new string[n];
        int i = 0;
        while (i < n) { r[i] = arr[i]; i = i + 1; }
        int a = 1;
        while (a < n) {
            string cur = r[a];
            int b = a - 1;
            while (b >= 0 && WorkspaceBuild.StrLess(cur, r[b])) {
                r[b + 1] = r[b];
                b = b - 1;
            }
            r[b + 1] = cur;
            a = a + 1;
        }
        return r;
    }
}
