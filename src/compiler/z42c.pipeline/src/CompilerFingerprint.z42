namespace Z42.Package;

public static class CompilerFingerprint {
    private static string _value = CompilerFingerprint._identify();

    public static string Value() {
        return CompilerFingerprint._value;
    }

    private static string _identify() {
        bool entropy = false;
        foreach (string capability in Platform.Capabilities()) {
            if (capability == "program-content-identity") {
                string? identity = CompilerFingerprint._programIdentity();
                if (identity != null) { return "program:" + identity; }
            }
            if (capability == "entropy") { entropy = true; }
        }
        // A bootstrap VM or unresolved package closure cannot share disk caches
        // with another compiler invocation.
        return entropy ? "session:" + Guid.NewGuid().ToString() : "";
    }

    // Keep bootstrapping with a core package that predates the query.
    private static string? _programIdentity() {
        foreach (var method in typeof(ModuleSearch).GetMethods()) {
            if (method.Name == "ProgramContentIdentity") {
                return method.Invoke(null, new object[0]) as string;
            }
        }
        return null;
    }
}
