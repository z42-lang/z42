// 编译器语义指纹的**内容派生**来源（change `fingerprint-content-derived`，2026-09-27）。
//
// 指纹 = 下面这张 `Entries` 列表的**内容哈希**。每条语义变更**追加一行自己的 slug**，
// 不再手工 +1。完整规则与历史见
// `docs/internals/src/compiler/compiler-fingerprint.md` 与 `version-bumping.md`。
//
// ── 为什么换掉那个手工计数器（两条实测损害，都在 2026-09-27 当天发生）──────────────
//
// ① **撞号 / 让号**：同一天两次 —— #883 原取 36 被 #885 抢走让到 37；#892 原取 38 被 #891
//    抢走让到 39。号是「先合先得」，后到的必须回头改自己的 PR。
// ② 🔴 **正文被整行覆盖而丢失**：#897（指纹 40，E0403）的**整条理由**被 #898 的合并吃掉 ——
//    两个 PR 都基于 39、都改**同一行**，后合的整行胜出，**git 没报冲突**。main 上一度是
//    41 → 39，40 那一档凭空消失（`NeverCompletes` 在链里零出现）。那条正文已在本 change 补回文档。
//
// 列表方案把两者**结构性**消掉：**没有号可抢**；两个 PR 各追加一行，合并只会**两行都留下**
// （能自动合并则自动，冲突时正解是「都留」而不是「谁让号」）。
//
// ── 为什么不去哈希编译器全部源码 ────────────────────────────────────────────────
//
// 实测那会让**每次注释编辑**都全量失效：空跑 12.0s / 改一行注释 18.0s / 指纹变一次 **26.8s**
// （`cached: 0/123`）⇒ 内循环 +50%，还连带 stdlib 全量。本方案只在**人记录了一条语义变更**时
// 才变，零额外失效。代价：仍需人判断「这次要不要记」——与计数器时代相同，由 CI 守门兜底。
namespace Z42.Package;

using Std;
// `ZpkgBuilder.SourceHashHex` 就在本命名空间（`Z42.Package`，见 z42.package/src/ZpkgBuilder.z42）——
// 不需要额外 using。⚠️ 别写 `using Z42.IR.BinaryFormat`：那是 zbc 二进制格式的命名空间，
// 与 ZpkgBuilder 不同（#896 把包名 z42.ir 改成 z42.package，命名空间没跟着改，容易看混）。

public static class CompilerFingerprint {

    // 🔴 **只许在末尾追加，不许改动/删除既有条目**：改了等于让一批本该命中的缓存作废
    // （安全方向，但白付一次全量）；删了会让指纹回退、可能**误命中**更早的条目。
    //
    // `baseline-41` = 换方案前计数器到 41 时的编译器语义。1–41 的逐条理由在
    // `docs/internals/src/compiler/compiler-fingerprint.md`，不在这里堆。
    public static string[] Entries = new string[] {
        "baseline-41",
        "fingerprint-content-derived",
        "fix-paramref-constraint-iface",
        "enforce-fqn-name-identity",
        // relocate-compiler-domain-libs：编译器域包挪去 `src/compiler/` 后，driver 的解析域组成变了
        // —— `_compilerDomainDirs()`（落点改 `programs/z42c/`）+ `${compiler_libs}` 路径宏 +
        // **编译器域目录排在框架之后**（排前面会让整套 stdlib 被判成 vendored 私有包）。
        // 指纹门实测：`编译器输出变了：1 个包（z42.json）`。
        "relocate-compiler-domain-libs",
        // fqn-typeref-base-chain（enforce-fqn-name-identity B4）：`IsSubclassOf` 沿 base 链的
        // 相等判定改走**名义身份句柄**。
        //
        // 🔴 **累加的理由是「行为实测变了」，不是「指纹门红了」** —— 这个区别要紧：门在两侧
        // driver 不同代时会因漂移而红（见 memory `fingerprint-gate-false-red-generation-drift`），
        // 照那种红 bump 是治症状、下个 PR 照样红。
        //
        // 本条的依据是**撤掉改动跑探针**拿到的直接观测：`BaseName` **从不经过归一 pass**
        // （`_passQualifyIfaceNames` 只归一接口那两根轴）⇒ 它存的是源码里写的**短名**。
        // 修前：`namespace Demo; class A {} class B : A {}` 下，拿**短名**查基类答 true，
        // 拿**限定名**（Demo.A）查同一个继承关系却答 **false** —— 换个拼写就答错。
        // 句柄化后两种拼写解析到同一个 id ⇒ 都答 true。
        //
        // ⚠️ **本块注释里不要出现双引号**：`_fpEntryCount` 是数 `Entries` 块里的引号对
        // （`n / 2`），它**不跳过注释** ⇒ 注释里每写一对引号就虚增一条「条目」，
        // CI 日志里打印的编译器身份数字会随之失真（实测：6 条被数成 10）。
        // 精确判定走 `_fingerprintSourceOf` 全文比较，不受影响；坏的是**可读性**。
        // ⇒ 那类源文件**哈希一字未变而判定结果变** ⇒ 不 bump 就会命中旧缓存条目、让修复
        //   永不生效（与 #791 / #806 / #850 同一条理由）。
        "fqn-typeref-base-chain",
        // fix-nested-ctor-key：嵌套类型的 ctor 键（`Outer+Inner` 的 ctor 注册在 `Inner`）——
        // 发射变了（无参那格此前压根不发 Call、带参那格发的是错名），源码哈希一字未变。
        "fix-nested-ctor-key",
        // fix-compound-assign-operand-check：复合赋值改走与二元运算同一条绑定路径 ⇒ 既发新诊断
        // （bool/函数值/对象上的 `op=`），又改发射（用户 `op_Add` 现在真的被派发）。
        "fix-compound-assign-operand-check",
        // fix-delegate-param-default：委托形参默认值改为声明处报错（纯新增诊断，不动发射）。
        "fix-delegate-param-default",
        // enforce-attribute-const-args：attribute 实参白名单（E0500）。纯新增诊断、不动发射，
        // 但「诊断变了而源码哈希未变」正是最需要失效缓存的那一档（规则第 1 行明确含「发出的诊断」）。
        "enforce-attribute-const-args",
        // fix-static-form-receiver-slot：「接收者作首参」的静态形式此前整条实参流水线错位一格
        // （接收者占 args[0] 却仍按 ParamTypes[0] 检查/装箱/填默认值）⇒ 正确调用被拒、末参从不检查、
        // 错接收者可能放行。改动既发新诊断（receiver 位 E0402）又改发射（带参形态此前编不过）。
        "fix-static-form-receiver-slot",
        // unify-type-subst：类级 / 接口 / Self / 方法级型参代换统一为一份完整递归（TypeSubst）。此前
        // `_substGeneric` 不下钻接口实例与函数类型 ⇒ 泛型类成员返回 `IGet<T>` / `Func<T,int>` 时 `T` 漏给调用方：
        // 该拒的放行（`string s = b.AsGet().Get();` 零诊断）、该过的误报（`+ 1` got T）。既发新诊断又改推断类型。
        "unify-type-subst",
        // fix-enum-type-identity（A5b-2b-2）：嵌套 enum 类型位与 `E.Member` 常量读造出的 enum 类型此前 Namespace 为空，
        // 按 FQN 的门在这条轴上是瞎的（跨包同 FQN 嵌套 enum 零诊断）。产物字节恒等（A-B 对账 19 包），但新发 E0601。
        "fix-enum-type-identity",
        // fix-class-base-scope（A5b-2b-3）：基类句柄改按声明方作用域绑定、15 处基类链走查收敛到 BaseOf ——
        // 同包两个 ns 各有同名基类时不再误报 E0402 / E0427（此前取决于文件顺序）。
        "fix-class-base-scope",
        // using-csharp-enclosing-ns：外围命名空间按 C# 规则隐式可见且优先于 using —— 同名冲突时解析答案变、
        // E0456 / E0436 放宽。stdlib 19 包字节不变。
        "using-csharp-enclosing-ns",
        // using-add-missing：z42.core 的 Type / AssemblyLoadContext 补了 using Std.Reflection —— 模块元数据的 using 列表变了，
        // 依赖 z42.core 的包解析导入签名时答案随之变（bench-pr 指纹门实测 z42.json +11B）。编译器本身字节未变。
        "using-add-missing",
        // using-csharp-strict-gate：同包跨 ns 与纯类型注解也计入 E0436（每文件记录用到的 ns）—— 新发诊断。
        "using-csharp-strict-gate"
    };

    // 指纹值：`Entries` 逐条以 `\n` 连接后取内容哈希（`mmh3:` 前缀，同 SourceHash）。
    // 只算一次并缓存 —— `Serialize` / `Parse` 每个 CU 都要它。
    private static string _cached = "";

    public static string Value() {
        if (CompilerFingerprint._cached != "") { return CompilerFingerprint._cached; }
        string joined = "";
        int i = 0;
        while (i < CompilerFingerprint.Entries.Length) {
            if (i > 0) { joined = joined + "\n"; }
            joined = joined + CompilerFingerprint.Entries[i];
            i = i + 1;
        }
        CompilerFingerprint._cached = ZpkgBuilder.SourceHashHex(joined);
        return CompilerFingerprint._cached;
    }

    // 条目数 —— CI 守门用它做**可打印**的身份片段（追加一条即变）。
    public static int Count() { return CompilerFingerprint.Entries.Length; }
}
