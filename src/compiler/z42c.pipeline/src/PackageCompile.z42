// 包编译核心（extract-compile-pipeline-api）：源+依赖 → 组装好的 in-memory ZpkgFileZ + 结构化诊断。
//
// 从 z42c.driver/_build 抽出的**纯核心**（依赖解析 ⑥ → 包级编译 ⑧ → 组装 ⑩）：不落盘、不写
// Console、不返回 ExitCode、不做增量 probe。z42c.driver（CLI）与 Z42cCompiler（z42b 进程内编译，
// wire-z42b 落地）共享本实现。落盘 / 呈现 / 增量策略留调用方（见 design.md D1/D2）。
//
// 增量作**输入**（Cus/CachedMods/CachedMetas）——driver 传增量产物，Z42cCompiler 传全量 parse + null。
// 依赖从磁盘 LibsDirs 解析（design D3；DeclaredDeps 取名字串数组，故本核心不依赖 manifest 模型）。
namespace Z42.Pipeline;

using Std;
using Z42.Core;       // DiagnosticBag / Diagnostic / DiagnosticSeverity（analyzer 诊断合入）
using Z42.Syntax;
using Z42.Semantics;
using Z42.IR;
using Z42.Project;

// cached 文件的 UsedDepNs 回填元数据（driver 增量 meta → 本核心；typecheck 本轮跳过时从 meta 补）。
// 用 pipeline 本地类型承载，避免核心反向依赖 driver 的 IncrementalDriver.Meta（依赖方向：driver→pipeline）。
public sealed class CachedNsMeta {
    public string[] UsedDepNs; public int UsedDepNsCount;
    public CachedNsMeta(string[] usedDepNs, int count) {
        this.UsedDepNs = usedDepNs; this.UsedDepNsCount = count;
    }
}

// 编译核心输入（纯数据；调用方备齐内存源 + 已 parse 的 CU + 依赖目录 + manifest 派生标量）。
public sealed class CompileInputs {
    public string[] Texts; public string[] Files; public string[] SrcHashes; public int SrcCount;
    public CompilationUnit[] Cus;          // 已 parse（driver 增量复用 / Z42cCompiler 全量 ParseAllTk）
    public IrModule[] CachedMods;          // 增量 cached IrModule（null = 全量）
    public CachedNsMeta[] CachedMetas;     // 平行 cached UsedDepNs 回填（null / 逐项 null 允许）
    // manifest 派生标量（composed ProjectManifest → 这些；核心不认 toml，解耦 manifest 模型）
    public string Name; public string Version; public string Kind;   // "exe" / "lib"
    public bool HasEntry; public string Entry;
    public bool IsRelease;
    // add-compiler-inlining：可独立开关的优化集（OptSet 位）。-1 = 未显式设置 → 取 profile 默认
    // （release=All / debug=None）。Z42cCompiler 解析 toml/CLI 后显式设置以覆盖。
    public int OptSet;
    // 依赖解析（磁盘目录——design D3；DeclaredDeps 是依赖名白名单，DepIndex 过滤用）
    public string[] LibsDirs; public int LibsDirsN;
    public string[] DeclaredDeps; public int DepCount;
    // scan-provider（perf-optimize-repl-eval ②，realize extract 延后的 scan-provider）：
    // 非 null → **跳过整个 DepScan.ScanDirs**，直接用传入的已建 DepScanResult。REPL 每轮复用缓存
    // 静态 scan（+ ExtendWithPackage 增量并入前轮 Vars）→ 消除 ~98% 的每轮开销。null = 现状（磁盘扫描）。
    public DepScanResult CachedScan;
    // attribute-handler-registry PR3a-load：外部 analyzer zpkg 路径（[analyzers] 段解析后由调用方
    // 按名在 LibsDirs 解析到 `<name>.zpkg`）。非空 → 编译期加载并驱动，诊断合入 per-file Cms；
    // 空（z42c 自建）→ 分支不进 → 逐字节不动。D9：加载进编译器、不链入目标程序。
    public string[] AnalyzerZpkgs; public int AnalyzerZpkgCount;
    // attribute-handler-registry PR3b：[lints] 决策器（由 driver 从 manifest 中性字段构造）。null →
    // AnalyzerDriver 用 LintConfig.Empty()（仅 EnabledByDefault + DefaultSeverity，无覆盖/无 WAE）。
    // 仅在 AnalyzerZpkgCount>0 时相关；z42c 自建无 analyzer → 不参与 → 逐字节不动。
    public LintConfig Lints;
    public CompileInputs() {
        this.CachedScan = null; this.OptSet = -1;
        this.AnalyzerZpkgs = new string[0]; this.AnalyzerZpkgCount = 0;
        this.Lints = null;
    }
}

// 组装好的 in-memory 包 + 结果状态。ErrorCount>0 时 Z/Mods 为 null，调用方按 Cms 逐文件呈现诊断。
public sealed class CompileArtifacts {
    public ZpkgFileZ Z;                                  // 组装好的包（未写盘）；ErrorCount>0 时 null
    public ZbcFileZ[] Mods; public int ModCount;        // ErrorCount>0 时 null
    public CompiledModuleZ[] Cms; public int CmCount;   // 恒有（driver 逐文件错误呈现）
    public int ErrorCount;
    public string EntryStatus;   // "ok" | "ambiguous" | "missing"（isExe 专属；调用方定报错措辞）
    // 本次编译用到的依赖 scan（perf ②）：CachedScan 为 null 时是本核心新建的、非 null 时回显传入的。
    // REPL 首轮据此缓存静态 scan；后续轮把它作 CachedScan 传回 + ExtendWithPackage 增量并入本轮包。
    public DepScanResult Scan;
    public CompileArtifacts(ZpkgFileZ z, ZbcFileZ[] mods, int modCount,
                            CompiledModuleZ[] cms, int cmCount, int errorCount, string entryStatus) {
        this.Z = z; this.Mods = mods; this.ModCount = modCount;
        this.Cms = cms; this.CmCount = cmCount; this.ErrorCount = errorCount; this.EntryStatus = entryStatus;
        this.Scan = null;
    }
}

public static class PackageCompile {

    // 纯核心：⑥依赖解析 → ⑧包级编译 → ⑩组装。零落盘 / 零 Console / 零 ExitCode。
    public static CompileArtifacts Compile(CompileInputs inp) {
        // ── ⑥ 跨包依赖解析（libsDirs 扫描 → DepIndex + nsMap + usings 聚合 → ImportedSymbols）──
        // perf ②：inp.CachedScan 非 null → 跳过 DepScan.ScanDirs，直接复用（REPL 每轮省 ~98%）。
        DepScanResult scan = null;
        ImportedSymbols imported = null;
        DependencyIndex depIndex = null;
        if (inp.CachedScan != null) {
            scan = inp.CachedScan;                                    // 复用（scan-provider）
        } else if (inp.LibsDirsN > 0) {
            scan = DepScan.ScanDirs(inp.LibsDirs, inp.LibsDirsN, inp.Name, inp.DeclaredDeps, inp.DepCount);   // 排除 self-zpkg
        }
        if (scan != null) {
            depIndex = scan.Index;
            // 全工程 usings 聚合（首现序去重；镜像 C# LoadExternalImported 跨文件聚合）
            string[] allUsings = new string[8];
            int auc = 0;
            int ui = 0;
            while (ui < inp.SrcCount) {
                string[] us = IrDump.UsingsOf(inp.Cus[ui]);   // F1：已 parse 的 CU 在手，免每文件全 reparse
                int j = 0;
                while (j < us.Length) {
                    bool seen = false;
                    int k = 0;
                    while (k < auc) { if (allUsings[k] == us[j]) { seen = true; } k = k + 1; }
                    if (!seen) {
                        if (auc == allUsings.Length) {
                            string[] b = new string[allUsings.Length * 2];
                            int m2 = 0; while (m2 < auc) { b[m2] = allUsings[m2]; m2 = m2 + 1; }
                            allUsings = b;
                        }
                        allUsings[auc] = us[j]; auc = auc + 1;
                    }
                    j = j + 1;
                }
                ui = ui + 1;
            }
            imported = ImportedSymbolLoader.Load(scan.Exported, scan.ExportedPkg, scan.ExportedCount,
                                                 allUsings, auc);
        }

        // ── ⑧ 包级编译（全文件先 parse 合并收集符号，再逐文件产物；cached 跳过 typecheck/codegen）──
        IrModule[] cachedMods = inp.CachedMods;
        // add-compiler-inlining：OptSet -1（未设）→ 取 profile 默认（release=All / debug=None）。
        int optSet = inp.OptSet;
        if (optSet < 0) { optSet = Opt.ProfileDefault(inp.IsRelease); }
        CompiledModuleZ[] cms = IrDump.BuildPackageCus(inp.Texts, inp.Files, inp.SrcCount, inp.Cus,
                                                       depIndex, imported, inp.IsRelease, cachedMods, optSet);
        // cached 的 UsedDepNs 是 typecheck 产物（本轮跳过）→ 从 meta 回填（源不变即不变）。
        if (cachedMods != null && inp.CachedMetas != null) {
            int ci = 0;
            while (ci < inp.SrcCount) {
                if (cachedMods[ci] != null && inp.CachedMetas[ci] != null) {
                    cms[ci].UsedDepNs = inp.CachedMetas[ci].UsedDepNs;
                    cms[ci].UsedDepNsCount = inp.CachedMetas[ci].UsedDepNsCount;
                }
                ci = ci + 1;
            }
        }

        // ── attribute-handler-registry PR3a-load：外部 analyzer（[analyzers] 段声明的 handler zpkg）──
        // gated on 非空 → z42c 自建无 [analyzers] → 该分支不进 → 逐字节不动。analyzer 诊断合入 per-file
        // Cms（默认 Warning 级不增 ErrorCount → 不 fail 编译，但对调用方可见）。放在错误门**前**，让
        // analyzer 报的 Error 级也能拦编译。
        if (inp.AnalyzerZpkgCount > 0) {
            PackageCompile._runAnalyzers(inp, cms);
        }

        // 诊断门（聚合）：任一文件有错 → 不组装，携 Cms 返回供调用方逐文件呈现。
        int totalErr = 0;
        int fi = 0;
        while (fi < inp.SrcCount) { if (cms[fi].ErrorCount > 0) { totalErr = totalErr + cms[fi].ErrorCount; } fi = fi + 1; }
        if (totalErr > 0) {
            CompileArtifacts errArt = new CompileArtifacts(null, null, 0, cms, inp.SrcCount, totalErr, "");
            errArt.Scan = scan;   // perf ②：回显 scan（首轮出错也让调用方缓存已建 scan）
            return errArt;
        }

        // ── ⑩ 组装：ZbcFileZ[] → BuildDependencyMap → BuildPackedD → ZpkgFileZ ──
        bool isExe = inp.Kind == "exe";
        ZbcFileZ[] mods = new ZbcFileZ[inp.SrcCount];
        int i = 0;
        while (i < inp.SrcCount) {
            CompiledModuleZ cm = cms[i];
            IrModule irm = cm.Module;
            string rel = inp.Files[i];   // SourceFile = 发现到的完整路径原样（C# CLI 字节实证）
            string[] exports = new string[irm.FuncCount];
            int e = 0;
            while (e < irm.FuncCount) { exports[e] = irm.Functions[e].Name; e = e + 1; }
            string modNs = cm.Namespace;
            if (modNs == "") { modNs = "main"; }   // no-ns 单元 ns="main"（C# build 字节实证）
            mods[i] = new ZbcFileZ(rel, inp.SrcHashes[i], modNs, exports, irm.FuncCount, irm);
            mods[i].Usings = cm.Usings;       mods[i].UsingCount = cm.UsingCount;
            mods[i].UsedDepNs = cm.UsedDepNs; mods[i].UsedDepNsCount = cm.UsedDepNsCount;
            i = i + 1;
        }
        // TSIG：BuildPackageCus 已产 per-file Exported（PS-1）
        ExportedModuleZ[] exported = new ExportedModuleZ[inp.SrcCount];
        i = 0;
        while (i < inp.SrcCount) { exported[i] = cms[i].Exported; i = i + 1; }
        // DEPS 条目（usings ∪ usedDepNs → nsMap）
        ZpkgDepList depList = new ZpkgDepList(new ZpkgDepZ[0], 0);
        if (scan != null) {
            depList = ZpkgBuilder.BuildDependencyMap(mods, inp.SrcCount, scan.NsNames, scan.NsFiles, scan.NsCount, inp.Name + ".zpkg");
        }
        ZpkgFileZ z = ZpkgBuilder.BuildPackedD(inp.Name, inp.Version, isExe, inp.HasEntry, inp.Entry,
                                               mods, inp.SrcCount, depList.Items, depList.Count);
        z.Exported = exported;
        z.ExportedCount = inp.SrcCount;
        string entryStatus = "ok";
        if (isExe) {
            if (z.Entry == "<ambiguous>") { entryStatus = "ambiguous"; }
            else if (z.Entry == "") { entryStatus = "missing"; }
        }
        CompileArtifacts okArt = new CompileArtifacts(z, mods, inp.SrcCount, cms, inp.SrcCount, 0, entryStatus);
        okArt.Scan = scan;   // perf ②：回显 scan 供调用方缓存 + 后续 ExtendWithPackage
        return okArt;
    }

    // 加载 [analyzers] zpkg → 对每个已 parse 的 CU 跑 AnalyzerDriver → 诊断合入 cms[i]（PR3a-load）。
    private static void _runAnalyzers(CompileInputs inp, CompiledModuleZ[] cms) {
        Analyzer[] analyzers = AnalyzerLoader.Load(inp.AnalyzerZpkgs, inp.AnalyzerZpkgCount);
        if (analyzers.Length == 0) { return; }
        int i = 0;
        while (i < inp.SrcCount) {
            CompilationUnit cu = inp.Cus[i];
            if (cu != null) {
                DiagnosticBag bag = new DiagnosticBag();
                AnalyzerDriver.Run(analyzers, analyzers.Length, cu, bag, inp.Lints);
                if (bag.Count() > 0) { PackageCompile._mergeDiags(cms[i], bag); }
            }
            i = i + 1;
        }
    }

    // 把 analyzer 诊断 append 进 CompiledModuleZ（格式镜像 IrDump BuildModule*）。仅 Error 级增 ErrorCount
    // （analyzer 默认 Warning → 不 fail 编译，仅可见）。
    private static void _mergeDiags(CompiledModuleZ cm, DiagnosticBag bag) {
        int add = bag.Count();
        int oldn = cm.DiagCount;
        string[] nw = new string[oldn + add];
        int q = 0;
        while (q < oldn) { nw[q] = cm.DiagMsgs[q]; q = q + 1; }
        int b = 0;
        while (b < add) {
            Diagnostic dg = bag.Get(b);
            nw[oldn + b] = dg.Span.File + "(" + dg.Span.Line.ToString() + "," + dg.Span.Column.ToString()
                         + "): " + dg.Code + ": " + dg.Message;
            if (dg.Severity == DiagnosticSeverity.Error) { cm.ErrorCount = cm.ErrorCount + 1; }
            b = b + 1;
        }
        cm.DiagMsgs = nw; cm.DiagCount = oldn + add;
    }
}
