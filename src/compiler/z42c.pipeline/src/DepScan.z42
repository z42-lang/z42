// libs 目录扫描（port-z42c-import CI-2）。镜像 C# PackageCompiler.Helpers.BuildDepIndex +
// BuildTarget.ScanLibsForNamespaces。z42c 运行期 Z42_LIBS 是单目录（flat），扫描该目录全部
// lib-kind zpkg：**prelude-first + Ordinal 排序**（common-pitfalls §1 + fix-depindex 同款），
// 一次扫描产出三件：DependencyIndex（签名键表）/ nsMap（ns→zpkg basename，DEPS 用）/
// TSIG ExportedModuleZ 池（ImportedSymbolLoader 输入）。
namespace Z42.Pipeline;

using Std;
using Std.IO;
using Z42.IR;
using Z42.Project;

// 一次扫描的产物束。
public sealed class DepScanResult {
    public DependencyIndex   Index;
    public string[]          NsNames;      public int NsCount;       // nsMap 平行数组
    public string[]          NsFiles;
    public ExportedModuleZ[] Exported;     public int ExportedCount; // 全部 TSIG 模块
    public string[]          ExportedPkg;                            // 平行：每模块来源包名
    // 保留 TsigReconcile world（perf-optimize-repl-eval ②）：供 ExtendWithPackage 增量并入
    // 新包时复用（跨包 base 链解析），避免重建。ScanDirs 填；一次性调用方可忽略。
    public ReconWorldPkg[]   Wp;           public int WpCount;
    // 惰性扫描（lazy-repl-depscan）：ScanDirsLazy 只对 prelude 做 Rebuild/DepIndex，但 **eager
    // BuildWorld 全部**（world 完整 → base 链天然可解，无闭包风险）。下列保留每个已 Open 的包，供
    // EnsurePackageLoaded 按需 Rebuild + DepIndex（world 已全，正确性有保障）。ScanDirs（非惰性）
    // 不填这些（Loaded 全 true 语义 = 全量已加载，EnsurePackageLoaded no-op）。
    public ZpkgInfo[] Opened;      // 已 Open 的 lib 包（与 OpenedDirs/OpenedNames/Loaded 平行）
    public string[]   OpenedDirs;  // 各包所在目录（Rebuild 的 pkgDir，indexed 包读散装 zbc 需要）
    public string[]   OpenedNames; // 各包 basename（"z42.io.zpkg"）——FileOf(ns) 定位后据此找索引
    public bool[]     Loaded;      // 各包是否已产出 Exported/DepIndex
    public int        OpenedCount;
    public DepScanResult(DependencyIndex index,
                         string[] nsNames, string[] nsFiles, int nsCount,
                         ExportedModuleZ[] exported, string[] exportedPkg, int exportedCount) {
        this.Index = index;
        this.NsNames = nsNames; this.NsFiles = nsFiles; this.NsCount = nsCount;
        this.Exported = exported; this.ExportedPkg = exportedPkg; this.ExportedCount = exportedCount;
        this.Wp = null; this.WpCount = 0;
        this.Opened = new ZpkgInfo[0]; this.OpenedDirs = new string[0];
        this.OpenedNames = new string[0]; this.Loaded = new bool[0]; this.OpenedCount = 0;
    }
    // ns → zpkg basename（未知 → ""）。
    public string FileOf(string ns) {
        int i = 0;
        while (i < this.NsCount) {
            if (this.NsNames[i] == ns) { return this.NsFiles[i]; }
            i = i + 1;
        }
        return "";
    }
}

public static class DepScan {
    // prelude 包名单（镜像 C# PreludePackages.Names）。
    public static bool IsPrelude(string pkgName) { return pkgName == "z42.core"; }

    // declaredDeps/declaredCount = 本工程 manifest 声明的依赖包名（z42c.* 等）。declaredCount>0 时
    // **DepIndex 只索引 stdlib(z42.* 前缀) + 声明依赖**（镜像 C# BuildDepIndex allowedPkgs 过滤），
    // 否则非声明的同名 instance 方法（如 flat 目录里 z42c.semantics 的 IrGen.Intern 撞 z42c.ir 的
    // ZbcStringPool.Intern）会让键歧义被 Seal 剔除 → bare VCall（应 FQ call）。nsMap/TSIG 不过滤
    // （DEPS 用全名单 first-wins；ImportedSymbols 由 using 激活过滤）。
    public static DepScanResult Scan(string libsDir, string excludeName, string[] declaredDeps, int declaredCount) {
        // 单目录 = 多目录的退化形态（Milestone 1 flat dist / 单工程 Z42_LIBS 走这里）。
        string[] one = new string[1];
        one[0] = libsDir;
        return DepScan.ScanDirs(one, 1, excludeName, declaredDeps, declaredCount);
    }

    // Milestone 2（per-member 布局）：成员产物落各自 dist 目录，故兄弟解析需扫**多个** libsDir。
    // dirs[0..dirCount) 全部 *.zpkg 合并后**prelude-first + Ordinal**（按 basename）排序——
    // first-wins 跨目录确定（common-pitfalls §1：成员名唯一，无跨目录同名碰撞）。单目录调用方
    // 经 Scan 退化到此（dirCount=1），扫描序与旧 _sortedZpkgs 一致 → 产物 byte-identical。
    public static DepScanResult ScanDirs(string[] dirs, int dirCount, string excludeName, string[] declaredDeps, int declaredCount) {
        var index = new DependencyIndex();
        string[] nsNames = new string[8];
        string[] nsFiles = new string[8];
        int nsCount = 0;
        ExportedModuleZ[] exported = new ExportedModuleZ[8];
        string[] exportedPkg = new string[8];
        int exportedCount = 0;
        // 包不导入自己：构建某包时把它自己的 .zpkg 排除出扫描（flat libs 含 self 时——
        // 否则同包符号经 DepIndex 解析 → 自依赖 DEPS + FQ 调用，与 C#[libs 不含 self]不一致）。
        string excludeZpkg = excludeName + ".zpkg";
        string[] paths = DepScan._sortedZpkgsMulti(dirs, dirCount);
        if (paths.Length == 0) {
            return new DepScanResult(index, nsNames, nsFiles, 0, exported, exportedPkg, 0);
        }
        // drop-tsig-expt（unify P3）：先预开全部 dep zpkg → world，供 TsigReconcile.Rebuild 解析
        // 跨包 base 链（imported 祖先字段/方法从 dep 包 TYPE/SIGS 取，替代已删的 TSIG 段）。
        // perf（perf-optimize-repl-eval ①）：每个 zpkg 只 `File.ReadAllBytes + ZpkgReader.Open`
        // 一次——解码结果存进平行 `opened[]`，下面主循环直接复用，不再重读重解一遍（原双读在
        // REPL 每轮全量 DepScan 里成倍放大，是 ~3.5s/eval 的一部分）。
        ZpkgInfo[] opened = new ZpkgInfo[paths.Length];
        ZpkgInfo[] world = new ZpkgInfo[paths.Length];
        string[] worldDirs = new string[paths.Length];
        int worldCount = 0;
        int wpi = 0;
        while (wpi < paths.Length) {
            ZpkgInfo wz = ZpkgReader.Open(File.ReadAllBytes(paths[wpi]));
            opened[wpi] = wz;
            if (wz != null && !wz.IsExe) {
                world[worldCount] = wz; worldDirs[worldCount] = Path.GetDirectoryName(paths[wpi]);
                worldCount = worldCount + 1;
            }
            wpi = wpi + 1;
        }
        // drop-tsig-expt P3：world 解析一次，跨全部 Rebuild 复用（避免 O(deps×world) 次包重解析）。
        ReconWorldPkg[] wp = TsigReconcile.BuildWorld(world, worldDirs, worldCount);
        int pi = 0;
        while (pi < paths.Length) {
            ZpkgInfo z = opened[pi];   // perf ①：复用预开阶段的解码结果，不重读 paths[pi]
            string basename = Path.GetFileName(paths[pi]);
            if (z != null && !z.IsExe) {  // lib-kind only
                // nsMap：NSPC 全名单 first-wins（**含 self**；BuildDependencyMap 用 selfZpkgFile 过滤自依赖
                // 镜像 C# ScanLibsForNamespaces 不排除 self → BuildDependencyMap 排除——确保 self
                // namespace 映射到 self.zpkg 而非被其他声明同 ns 的包抢占）
                string[] nss = ZpkgReader.ReadNamespaces(z);
                int i = 0;
                while (i < nss.Length) {
                    if (DepScan._nsIndexOf(nsNames, nsCount, nss[i]) < 0) {
                        if (nsCount == nsNames.Length) {
                            string[] b1 = new string[nsNames.Length * 2];
                            string[] b2 = new string[nsNames.Length * 2];
                            int k = 0;
                            while (k < nsCount) { b1[k] = nsNames[k]; b2[k] = nsFiles[k]; k = k + 1; }
                            nsNames = b1; nsFiles = b2;
                        }
                        nsNames[nsCount] = nss[i];
                        nsFiles[nsCount] = basename;
                        nsCount = nsCount + 1;
                    }
                    i = i + 1;
                }
                // DepIndex 和 TSIG：排除 self（避免自引用；镜像 C# BuildDepIndex excludeName 语义）
                if (basename != excludeZpkg) {
                    // DepIndex：每模块 SIGS 签名（声明依赖过滤——镜像 C# BuildDepIndex allowedPkgs）
                    if (declaredCount == 0 || DepScan._allowedForIndex(z.Name, declaredDeps, declaredCount)) {
                        ZpkgModuleSigs[] mods = ZpkgReader.ReadModuleSigs(z);
                        i = 0;
                        while (i < mods.Length) {
                            index.AddModule(mods[i].Functions, mods[i].FuncCount, mods[i].Namespace);
                            i = i + 1;
                        }
                    }
                    // drop-tsig-expt（unify P3）：从 TYPE/SIGS/IMPL 重建（替代已删 TSIG 段）。
                    ExportedModuleZ[] tsig = TsigReconcile.Rebuild(z, Path.GetDirectoryName(paths[pi]), wp, worldCount);
                    i = 0;
                    while (i < tsig.Length) {
                        if (exportedCount == exported.Length) {
                            ExportedModuleZ[] b1 = new ExportedModuleZ[exported.Length * 2];
                            string[] b2 = new string[exported.Length * 2];
                            int k = 0;
                            while (k < exportedCount) { b1[k] = exported[k]; b2[k] = exportedPkg[k]; k = k + 1; }
                            exported = b1; exportedPkg = b2;
                        }
                        exported[exportedCount] = tsig[i];
                        exportedPkg[exportedCount] = z.Name;
                        exportedCount = exportedCount + 1;
                        i = i + 1;
                    }
                }
            }
            pi = pi + 1;
        }
        index.Seal();
        DepScanResult res = new DepScanResult(index, nsNames, nsFiles, nsCount, exported, exportedPkg, exportedCount);
        res.Wp = wp; res.WpCount = worldCount;   // 保留 world 供 ExtendWithPackage（perf ②）
        return res;
    }

    // perf-optimize-repl-eval ②：把「刚编出的一个包」增量并入已建 scan（不重扫全世界）。
    // 用于 REPL carry-forward——每轮 emit 的 Repl.R{N} 包（含 Vars{N} 静态类）并进缓存的静态
    // scan，使下一轮编译期能引用 Vars{N}，而无需把它落盘再全量重扫（DepScan 占每轮 ~98%）。
    // 复用 scan.Wp（静态 world）做 TsigReconcile.Rebuild——repl 包无跨包 base 链，静态 world 足够。
    // scan 被**原地修改**（Index / 平行数组增长）；返回同一对象方便链式。
    public static DepScanResult ExtendWithPackage(DepScanResult scan, byte[] bytes, string pkgName) {
        ZpkgInfo z = ZpkgReader.Open(bytes);
        if (z == null || z.IsExe) { return scan; }
        string basename = pkgName + ".zpkg";
        // ① namespaces：新 ns 追加到 nsMap（first-wins，已存在则跳过）
        string[] nss = ZpkgReader.ReadNamespaces(z);
        int i = 0;
        while (i < nss.Length) {
            if (DepScan._nsIndexOf(scan.NsNames, scan.NsCount, nss[i]) < 0) {
                if (scan.NsCount == scan.NsNames.Length) {
                    string[] b1 = new string[scan.NsNames.Length * 2];
                    string[] b2 = new string[scan.NsNames.Length * 2];
                    int k = 0;
                    while (k < scan.NsCount) { b1[k] = scan.NsNames[k]; b2[k] = scan.NsFiles[k]; k = k + 1; }
                    scan.NsNames = b1; scan.NsFiles = b2;
                }
                scan.NsNames[scan.NsCount] = nss[i];
                scan.NsFiles[scan.NsCount] = basename;
                scan.NsCount = scan.NsCount + 1;
            }
            i = i + 1;
        }
        // ② DepIndex：本包 SIGS 注册（repl 包非 self，无需 exclude）
        ZpkgModuleSigs[] mods = ZpkgReader.ReadModuleSigs(z);
        i = 0;
        while (i < mods.Length) {
            scan.Index.AddModule(mods[i].Functions, mods[i].FuncCount, mods[i].Namespace);
            i = i + 1;
        }
        scan.Index.Seal();
        // ③ 先把本包并入 world（perf ② 增量）：TsigReconcile._rebuildClass 按 FQ 名在 world 里
        // `_locate` 类自身 + base 链再读 SIGS 方法。REPL 声明的类/enum 只在本增量包里，不入 world
        // 就定位不到自身 → 导出 0 方法（`no method` / undefined enum）。并入后，本包及后续增量包
        // 的类型元数据（含实例方法、enum、跨声明 base 链）都能完整重建。
        if (scan.WpCount == scan.Wp.Length) {
            ReconWorldPkg[] wb = new ReconWorldPkg[scan.Wp.Length * 2 + 1];
            int wk = 0;
            while (wk < scan.WpCount) { wb[wk] = scan.Wp[wk]; wk = wk + 1; }
            scan.Wp = wb;
        }
        scan.Wp[scan.WpCount] = new ReconWorldPkg(ZpkgReader.ReadModuleTypes(z, ""), ZpkgReader.ReadModuleSigs(z));
        scan.WpCount = scan.WpCount + 1;
        // ④ Exported（TSIG 重建）：world 现含本包 → 类型/方法/enum 完整重建。
        ExportedModuleZ[] tsig = TsigReconcile.Rebuild(z, "", scan.Wp, scan.WpCount);
        i = 0;
        while (i < tsig.Length) {
            if (scan.ExportedCount == scan.Exported.Length) {
                ExportedModuleZ[] b1 = new ExportedModuleZ[scan.Exported.Length * 2];
                string[] b2 = new string[scan.Exported.Length * 2];
                int k = 0;
                while (k < scan.ExportedCount) { b1[k] = scan.Exported[k]; b2[k] = scan.ExportedPkg[k]; k = k + 1; }
                scan.Exported = b1; scan.ExportedPkg = b2;
            }
            scan.Exported[scan.ExportedCount] = tsig[i];
            scan.ExportedPkg[scan.ExportedCount] = z.Name;
            scan.ExportedCount = scan.ExportedCount + 1;
            i = i + 1;
        }
        return scan;
    }

    // ── 惰性扫描（lazy-repl-depscan）─────────────────────────────────────────────
    // 首轮只对 prelude 做昂贵的 Rebuild/DepIndex，但 **eager BuildWorld 全部**（world 完整 →
    // base 链天然可解、零闭包风险）+ 全量廉价 nsMap。其余包在 `EnsurePackageLoaded` 按需产出
    // Exported/DepIndex。实测：全量 4343ms → 首轮 ~1s（open+BuildWorld）+ 每新引用包 ~120ms。
    // 仅用于 REPL 交互路径；build/test 全量编译仍走 ScanDirs（byte-identical 不受影响）。
    public static DepScanResult ScanDirsLazy(string[] dirs, int dirCount, string excludeName, string[] declaredDeps, int declaredCount) {
        var index = new DependencyIndex();
        string[] nsNames = new string[8];
        string[] nsFiles = new string[8];
        int nsCount = 0;
        ExportedModuleZ[] exported = new ExportedModuleZ[8];
        string[] exportedPkg = new string[8];
        int exportedCount = 0;
        string excludeZpkg = excludeName + ".zpkg";
        string[] paths = DepScan._sortedZpkgsMulti(dirs, dirCount);
        if (paths.Length == 0) {
            return new DepScanResult(index, nsNames, nsFiles, 0, exported, exportedPkg, 0);
        }
        // Open 全部 → world（eager BuildWorld 需完整 world）；同时留存 lib 包供按需 Rebuild。
        ZpkgInfo[] opened = new ZpkgInfo[paths.Length];
        ZpkgInfo[] world = new ZpkgInfo[paths.Length];
        string[] worldDirs = new string[paths.Length];
        int worldCount = 0;
        // lib-only 平行留存
        ZpkgInfo[] libOpened = new ZpkgInfo[paths.Length];
        string[] libDirs = new string[paths.Length];
        string[] libNames = new string[paths.Length];
        bool[] libLoaded = new bool[paths.Length];
        int libCount = 0;
        int wpi = 0;
        while (wpi < paths.Length) {
            ZpkgInfo wz = ZpkgReader.Open(File.ReadAllBytes(paths[wpi]));
            opened[wpi] = wz;
            if (wz != null && !wz.IsExe) {
                world[worldCount] = wz; worldDirs[worldCount] = Path.GetDirectoryName(paths[wpi]);
                worldCount = worldCount + 1;
            }
            wpi = wpi + 1;
        }
        // eager：全 world 一次性解析（TYPE/SIGS）——base 链完整、按需 Rebuild 正确。
        ReconWorldPkg[] wp = TsigReconcile.BuildWorld(world, worldDirs, worldCount);
        int pi = 0;
        while (pi < paths.Length) {
            ZpkgInfo z = opened[pi];
            string basename = Path.GetFileName(paths[pi]);
            if (z != null && !z.IsExe) {
                // nsMap：全量（触发时靠它 FileOf(ns) 定位包）
                string[] nss = ZpkgReader.ReadNamespaces(z);
                int i = 0;
                while (i < nss.Length) {
                    if (DepScan._nsIndexOf(nsNames, nsCount, nss[i]) < 0) {
                        if (nsCount == nsNames.Length) {
                            string[] b1 = new string[nsNames.Length * 2];
                            string[] b2 = new string[nsNames.Length * 2];
                            int k = 0;
                            while (k < nsCount) { b1[k] = nsNames[k]; b2[k] = nsFiles[k]; k = k + 1; }
                            nsNames = b1; nsFiles = b2;
                        }
                        nsNames[nsCount] = nss[i];
                        nsFiles[nsCount] = basename;
                        nsCount = nsCount + 1;
                    }
                    i = i + 1;
                }
                // 留存该 lib 包供按需加载（记录目录/名/初始未加载）
                libOpened[libCount] = z; libDirs[libCount] = Path.GetDirectoryName(paths[pi]);
                libNames[libCount] = basename;
                // prelude：现在就 Rebuild + DepIndex（首轮可用）；其余：留待 EnsurePackageLoaded。
                bool isPrelude = DepScan.IsPrelude(z.Name);
                libLoaded[libCount] = isPrelude;
                libCount = libCount + 1;
                if (isPrelude && basename != excludeZpkg) {
                    if (declaredCount == 0 || DepScan._allowedForIndex(z.Name, declaredDeps, declaredCount)) {
                        ZpkgModuleSigs[] mods = ZpkgReader.ReadModuleSigs(z);
                        i = 0;
                        while (i < mods.Length) {
                            index.AddModule(mods[i].Functions, mods[i].FuncCount, mods[i].Namespace);
                            i = i + 1;
                        }
                    }
                    ExportedModuleZ[] tsig = TsigReconcile.Rebuild(z, Path.GetDirectoryName(paths[pi]), wp, worldCount);
                    i = 0;
                    while (i < tsig.Length) {
                        if (exportedCount == exported.Length) {
                            ExportedModuleZ[] g1 = new ExportedModuleZ[exported.Length * 2];
                            string[] g2 = new string[exported.Length * 2];
                            int k = 0;
                            while (k < exportedCount) { g1[k] = exported[k]; g2[k] = exportedPkg[k]; k = k + 1; }
                            exported = g1; exportedPkg = g2;
                        }
                        exported[exportedCount] = tsig[i];
                        exportedPkg[exportedCount] = z.Name;
                        exportedCount = exportedCount + 1;
                        i = i + 1;
                    }
                }
            }
            pi = pi + 1;
        }
        index.Seal();
        DepScanResult res = new DepScanResult(index, nsNames, nsFiles, nsCount, exported, exportedPkg, exportedCount);
        res.Wp = wp; res.WpCount = worldCount;
        res.Opened = libOpened; res.OpenedDirs = libDirs; res.OpenedNames = libNames;
        res.Loaded = libLoaded; res.OpenedCount = libCount;
        return res;
    }

    // 按需加载命名空间 `ns` 所在的**全部**包：对每个做 Rebuild（world 已完整 → base 链正确）+
    // DepIndex。**不是 first-wins**——多个包可共享同一 ns（如 Std），全量 ScanDirs 会把它们都
    // Rebuild、其符号都进 Exported（ImportedSymbolLoader 按 ns 激活全部匹配模块）；故惰性必须
    // 加载所有声明该 ns 的包，否则与全量不一致（漏共享 ns 的次包符号）。幂等；未知 ns / 非惰性
    // scan（OpenedCount==0）no-op。lazy-repl-depscan。
    public static void EnsurePackageLoaded(DepScanResult scan, string ns) {
        int i = 0;
        while (i < scan.OpenedCount) {
            if (!scan.Loaded[i]) {
                string[] nss = ZpkgReader.ReadNamespaces(scan.Opened[i]);
                if (DepScan._nsIndexOf(nss, nss.Length, ns) >= 0) {
                    DepScan._loadOpenedPackage(scan, i);
                }
            }
            i = i + 1;
        }
    }

    // 把第 idx 个已 Open 的 lib 包产出 Exported/DepIndex 并并入 scan（对完整 world 重建）。
    private static void _loadOpenedPackage(DepScanResult scan, int idx) {
        ZpkgInfo z = scan.Opened[idx];
        ZpkgModuleSigs[] mods = ZpkgReader.ReadModuleSigs(z);
        int i = 0;
        while (i < mods.Length) {
            scan.Index.AddModule(mods[i].Functions, mods[i].FuncCount, mods[i].Namespace);
            i = i + 1;
        }
        scan.Index.Seal();
        ExportedModuleZ[] tsig = TsigReconcile.Rebuild(z, scan.OpenedDirs[idx], scan.Wp, scan.WpCount);
        i = 0;
        while (i < tsig.Length) {
            if (scan.ExportedCount == scan.Exported.Length) {
                ExportedModuleZ[] g1 = new ExportedModuleZ[scan.Exported.Length * 2 + 1];
                string[] g2 = new string[scan.Exported.Length * 2 + 1];
                int k = 0;
                while (k < scan.ExportedCount) { g1[k] = scan.Exported[k]; g2[k] = scan.ExportedPkg[k]; k = k + 1; }
                scan.Exported = g1; scan.ExportedPkg = g2;
            }
            scan.Exported[scan.ExportedCount] = tsig[i];
            scan.ExportedPkg[scan.ExportedCount] = z.Name;
            scan.ExportedCount = scan.ExportedCount + 1;
            i = i + 1;
        }
        scan.Loaded[idx] = true;
    }

    // 多目录合并 + prelude-first（"0_"+name）+ Ordinal 排序（按 basename）。
    // 不存在的目录跳过（per-member 布局下后续成员 dist 在建本成员时尚空）。
    private static string[] _sortedZpkgsMulti(string[] dirs, int dirCount) {
        // 第一遍：统计总数。
        int total = 0;
        int di = 0;
        while (di < dirCount) {
            if (Directory.Exists(dirs[di])) { total = total + Path.Glob(dirs[di], "*.zpkg").Length; }
            di = di + 1;
        }
        // 第二遍：合并到 flat 数组。
        string[] paths = new string[total];
        int pc = 0;
        di = 0;
        while (di < dirCount) {
            if (Directory.Exists(dirs[di])) {
                string[] hits = Path.Glob(dirs[di], "*.zpkg");
                int hi = 0;
                while (hi < hits.Length) { paths[pc] = hits[hi]; pc = pc + 1; hi = hi + 1; }
            }
            di = di + 1;
        }
        // 同名包跨目录去重（first-wins）：某包同时在成员 dist 与 Z42_LIBS（外部 stdlib
        // 种子）出现时只扫一次，避免 DepIndex 重复 AddModule → 歧义键被 Seal 剔除。
        // 单目录调用方无重名（一目录不会有两份同名文件）→ 此步 no-op，Milestone 1 byte-identical 不变。
        return DepScan._dedupByBasename(DepScan._sortZpkgKeys(paths));
    }

    // 排序后的 paths 中，每个 basename 仅保留首次出现（first-wins）。
    private static string[] _dedupByBasename(string[] paths) {
        string[] seen = new string[paths.Length];
        int seenCount = 0;
        string[] kept = new string[paths.Length];
        int keptCount = 0;
        int i = 0;
        while (i < paths.Length) {
            string b = Path.GetFileName(paths[i]);
            if (DepScan._nsIndexOf(seen, seenCount, b) < 0) {
                seen[seenCount] = b; seenCount = seenCount + 1;
                kept[keptCount] = paths[i]; keptCount = keptCount + 1;
            }
            i = i + 1;
        }
        if (keptCount == paths.Length) { return kept; }
        string[] r = new string[keptCount];
        i = 0;
        while (i < keptCount) { r[i] = kept[i]; i = i + 1; }
        return r;
    }

    // prelude-first（"0_"+name）+ Ordinal 排序（镜像 C# BuildDepIndex 的 sortedPaths）。
    private static string[] _sortZpkgKeys(string[] paths) {
        // 排序键并行数组 + 插入排序
        string[] keys = new string[paths.Length];
        int i = 0;
        while (i < paths.Length) {
            string name = Path.GetFileNameWithoutExtension(paths[i]);
            if (DepScan.IsPrelude(name)) { keys[i] = "0_" + name; }
            else { keys[i] = "1_" + name; }
            i = i + 1;
        }
        i = 1;
        while (i < paths.Length) {
            string k = keys[i];
            string p = paths[i];
            int j = i - 1;
            bool more = j >= 0;
            while (more) {
                if (keys[j].CompareTo(k) > 0) {
                    keys[j + 1] = keys[j]; paths[j + 1] = paths[j];
                    j = j - 1; more = j >= 0;
                } else { more = false; }
            }
            keys[j + 1] = k;
            paths[j + 1] = p;
            i = i + 1;
        }
        return paths;
    }

    // DepIndex 准入：stdlib（z42. 前缀；z42c.X 不匹配）∨ 声明依赖名（镜像 C# isStdlib || allowedPkgs.Contains）。
    private static bool _allowedForIndex(string pkgName, string[] declaredDeps, int declaredCount) {
        if (pkgName.StartsWith("z42.")) { return true; }
        int i = 0;
        while (i < declaredCount) {
            if (declaredDeps[i] == pkgName) { return true; }
            i = i + 1;
        }
        return false;
    }

    private static int _nsIndexOf(string[] a, int n, string s) {
        int i = 0;
        while (i < n) {
            if (a[i] == s) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }
}
