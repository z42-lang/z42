// libs 目录扫描（port-z42c-import CI-2）。镜像 C# PackageCompiler.Helpers.BuildDepIndex +
// BuildTarget.ScanLibsForNamespaces。z42c 运行期 Z42_LIBS 是单目录（flat），扫描该目录全部
// lib-kind zpkg：**prelude-first + Ordinal 排序**（common-pitfalls §1 + fix-depindex 同款），
// 一次扫描产出三件：DependencyIndex（签名键表）/ nsMap（ns→zpkg basename，DEPS 用）/
// TSIG ExportedModuleZ 池（ImportedSymbolLoader 输入）。
namespace Z42.Pipeline;

using Std;
using Std.IO;
using Z42.IR;
using Z42.IR.BinaryFormat;
using Z42.Project;


// libs 目录扫描主入口 + 惰性扫描 + 增量并包 + 按需加载/reconcile 编排（refactor-depscan-concern-split）。
// 数据类见 DepScanTypes.z42；ns 索引缓存见 NsIndexCache.z42；路径排序见 ZpkgPathSort.z42；reconcile 辅助见 DepReconcile.z42。
public static class DepScan {
    // prelude 包名单（镜像 C# PreludePackages.Names）。用于 ① _sortedZpkgsMulti prelude-first 排序
    // （nsMap first-wins 确定性）② ImportedSymbolLoader 免-using 可见性。**注意**：lazy-prelude 后
    // ScanDirsLazy 不再据此 *eager reconcile* prelude（改按需 E0401 加载），但排序/可见性判据仍需它。
    public static bool IsPrelude(string pkgName) { return pkgName == "z42.core"; }

    // declaredDeps/declaredCount = 本工程 manifest 声明的依赖包名（z42c.* 等）。declaredCount>0 时
    // **DepIndex 只索引 stdlib(z42.* 前缀) + 声明依赖**（镜像 C# BuildDepIndex allowedPkgs 过滤），
    // 否则非声明的同名 instance 方法（如 flat 目录里 z42c.semantics 的 IrGen.Intern 撞 z42c.ir 的
    // ZbcStringPool.Intern）会让键歧义被 Seal 剔除 → bare VCall（应 FQ call）。nsMap/TSIG 不过滤
    // （DEPS 用全名单 first-wins；ImportedSymbols 由 using 激活过滤）。
    public static DepScanResult Scan(string libsDir, string excludeName, string[] declaredDeps, int declaredCount) {
        // 单目录 = 多目录的退化形态（Milestone 1 flat dist / 单工程 Z42_LIBS 走这里）。
        string[] one = new string[1];
        one[0] = libsDir;
        return DepScan.ScanDirs(one, 1, excludeName, declaredDeps, declaredCount);
    }

    // Milestone 2（per-member 布局）：成员产物落各自 dist 目录，故兄弟解析需扫**多个** libsDir。
    // dirs[0..dirCount) 全部 *.zpkg 合并后**prelude-first + Ordinal**（按 basename）排序——
    // first-wins 跨目录确定（common-pitfalls §1：成员名唯一，无跨目录同名碰撞）。单目录调用方
    // 经 Scan 退化到此（dirCount=1），扫描序与旧 _sortedZpkgs 一致 → 产物 byte-identical。
    public static DepScanResult ScanDirs(string[] dirs, int dirCount, string excludeName, string[] declaredDeps, int declaredCount) {
        var index = new DependencyIndex();
        string[] nsNames = new string[8];
        string[] nsFiles = new string[8];
        int nsCount = 0;
        ExportedModuleZ[] exported = new ExportedModuleZ[8];
        string[] exportedPkg = new string[8];
        int exportedCount = 0;
        // 包不导入自己：构建某包时把它自己的 .zpkg 排除出扫描（flat libs 含 self 时——
        // 否则同包符号经 DepIndex 解析 → 自依赖 DEPS + FQ 调用，与 C#[libs 不含 self]不一致）。
        string excludeZpkg = excludeName + ".zpkg";
        string[] paths = ZpkgPathSort._sortedZpkgsMulti(dirs, dirCount);
        if (paths.Length == 0) {
            return new DepScanResult(index, nsNames, nsFiles, 0, exported, exportedPkg, 0);
        }
        // drop-tsig-expt（unify P3）：先预开全部 dep zpkg → world，供 TsigReconcile.Rebuild 解析
        // 跨包 base 链（imported 祖先字段/方法从 dep 包 TYPE/SIGS 取，替代已删的 TSIG 段）。
        // perf（perf-optimize-repl-eval ①）：每个 zpkg 只 `File.ReadAllBytes + ZpkgReader.Open`
        // 一次——解码结果存进平行 `opened[]`，下面主循环直接复用，不再重读重解一遍（原双读在
        // REPL 每轮全量 DepScan 里成倍放大，是 ~3.5s/eval 的一部分）。
        ZpkgInfo[] opened = new ZpkgInfo[paths.Length];
        CachedZpkg[] cached = new CachedZpkg[paths.Length];   // F2：进程级 memo 条目（tsig 懒填）
        ZpkgInfo[] world = new ZpkgInfo[paths.Length];
        string[] worldDirs = new string[paths.Length];
        int worldCount = 0;
        int wpi = 0;
        while (wpi < paths.Length) {
            CachedZpkg ce = DepScanCache.Get(paths[wpi]);   // F2：缓存 Open（命中零文件 I/O + 零重解码）
            ZpkgInfo wz = ce.Z;
            opened[wpi] = wz;
            cached[wpi] = ce;
            if (wz != null && !wz.IsExe) {
                world[worldCount] = wz; worldDirs[worldCount] = Path.GetDirectoryName(paths[wpi]);
                worldCount = worldCount + 1;
            }
            wpi = wpi + 1;
        }
        // lazy-type-world：惰性 world（不再一次性全量解析）。ScanDirs 仍 Rebuild 全部包，故 Wp 经
        // 各 Rebuild 的 EnsureFq 按需填满——总解析量不变、消除 BuildWorld 与 Rebuild 的双重解析。
        LazyReconWorld lazyWorld = new LazyReconWorld(world, worldDirs, worldCount);
        int pi = 0;
        while (pi < paths.Length) {
            ZpkgInfo z = opened[pi];   // perf ①：复用预开阶段的解码结果，不重读 paths[pi]
            string basename = Path.GetFileName(paths[pi]);
            if (z != null && !z.IsExe) {  // lib-kind only
                // nsMap：NSPC 全名单 first-wins（**含 self**；BuildDependencyMap 用 selfZpkgFile 过滤自依赖
                // 镜像 C# ScanLibsForNamespaces 不排除 self → BuildDependencyMap 排除——确保 self
                // namespace 映射到 self.zpkg 而非被其他声明同 ns 的包抢占）
                string[] nss = ZpkgReader.ReadNamespaces(z);
                int i = 0;
                while (i < nss.Length) {
                    if (DepScan._nsIndexOf(nsNames, nsCount, nss[i]) < 0) {
                        if (nsCount == nsNames.Length) {
                            string[] b1 = new string[nsNames.Length * 2];
                            string[] b2 = new string[nsNames.Length * 2];
                            int k = 0;
                            while (k < nsCount) { b1[k] = nsNames[k]; b2[k] = nsFiles[k]; k = k + 1; }
                            nsNames = b1; nsFiles = b2;
                        }
                        nsNames[nsCount] = nss[i];
                        nsFiles[nsCount] = basename;
                        nsCount = nsCount + 1;
                    }
                    i = i + 1;
                }
                // DepIndex 和 TSIG：排除 self（避免自引用；镜像 C# BuildDepIndex excludeName 语义）
                if (basename != excludeZpkg) {
                    // DepIndex：每模块 SIGS 签名（声明依赖过滤——镜像 C# BuildDepIndex allowedPkgs）
                    if (declaredCount == 0 || ZpkgPathSort._allowedForIndex(z.Name, declaredDeps, declaredCount)) {
                        // F2-邻：ReadModuleSigs 是 z 字节纯函数、跨成员恒定 → 进程级 memo（命中零重解码 SIGS）。
                        // AddModule 仍每成员执行（按 declaredDeps 建各自过滤 index，不可跨成员共享）。
                        ZpkgModuleSigs[] mods = cached[pi].Mods;
                        if (mods == null) {
                            mods = ZpkgReader.ReadModuleSigs(z);
                            cached[pi].Mods = mods;
                        }
                        i = 0;
                        while (i < mods.Length) {
                            index.AddModule(mods[i].Functions, mods[i].FuncCount, mods[i].Namespace);
                            i = i + 1;
                        }
                    }
                    // drop-tsig-expt（unify P3）：从 TYPE/SIGS/IMPL 重建（替代已删 TSIG 段）。
                    // F2：该包 TSIG 只依赖自身 + 祖先（拓扑序保证在场），跨成员恒定 → 进程级 memo，命中零重建。
                    ExportedModuleZ[] tsig;
                    if (cached[pi].Tsig != null) {
                        tsig = cached[pi].Tsig;
                    } else {
                        tsig = TsigReconcile.Rebuild(z, Path.GetDirectoryName(paths[pi]), lazyWorld);
                        cached[pi].Tsig = tsig;
                    }
                    i = 0;
                    while (i < tsig.Length) {
                        if (exportedCount == exported.Length) {
                            ExportedModuleZ[] b1 = new ExportedModuleZ[exported.Length * 2];
                            string[] b2 = new string[exported.Length * 2];
                            int k = 0;
                            while (k < exportedCount) { b1[k] = exported[k]; b2[k] = exportedPkg[k]; k = k + 1; }
                            exported = b1; exportedPkg = b2;
                        }
                        exported[exportedCount] = tsig[i];
                        exportedPkg[exportedCount] = z.Name;
                        exportedCount = exportedCount + 1;
                        i = i + 1;
                    }
                }
            }
            pi = pi + 1;
        }
        index.Seal();
        DepScanResult res = new DepScanResult(index, nsNames, nsFiles, nsCount, exported, exportedPkg, exportedCount);
        res.World = lazyWorld;   // 保留惰性 world 供 ExtendWithPackage / EnsurePackageLoaded 复用
        return res;
    }

    // perf-optimize-repl-eval ②：把「刚编出的一个包」增量并入已建 scan（不重扫全世界）。
    // 用于 REPL carry-forward——每轮 emit 的 Repl.R{N} 包（含 Vars{N} 静态类）并进缓存的静态
    // scan，使下一轮编译期能引用 Vars{N}，而无需把它落盘再全量重扫（DepScan 占每轮 ~98%）。
    // 把 repl 包 AppendPackage 进惰性 world 再 Rebuild——使其类可 _locate 自身 + 跨声明 base 链解析。
    // scan 被**原地修改**（Index / 平行数组增长）；返回同一对象方便链式。
    public static DepScanResult ExtendWithPackage(DepScanResult scan, byte[] bytes, string pkgName) {
        ZpkgInfo z = ZpkgReader.Open(bytes);
        if (z == null || z.IsExe) { return scan; }
        string basename = pkgName + ".zpkg";
        // ① namespaces：新 ns 追加到 nsMap（first-wins，已存在则跳过）
        string[] nss = ZpkgReader.ReadNamespaces(z);
        int i = 0;
        while (i < nss.Length) {
            if (DepScan._nsIndexOf(scan.NsNames, scan.NsCount, nss[i]) < 0) {
                if (scan.NsCount == scan.NsNames.Length) {
                    string[] b1 = new string[scan.NsNames.Length * 2];
                    string[] b2 = new string[scan.NsNames.Length * 2];
                    int k = 0;
                    while (k < scan.NsCount) { b1[k] = scan.NsNames[k]; b2[k] = scan.NsFiles[k]; k = k + 1; }
                    scan.NsNames = b1; scan.NsFiles = b2;
                }
                scan.NsNames[scan.NsCount] = nss[i];
                scan.NsFiles[scan.NsCount] = basename;
                scan.NsCount = scan.NsCount + 1;
            }
            i = i + 1;
        }
        // ② DepIndex：本包 SIGS 注册（repl 包非 self，无需 exclude）
        ZpkgModuleSigs[] mods = ZpkgReader.ReadModuleSigs(z);
        i = 0;
        while (i < mods.Length) {
            scan.Index.AddModule(mods[i].Functions, mods[i].FuncCount, mods[i].Namespace);
            i = i + 1;
        }
        scan.Index.Seal();
        // ③ 先把本包并入惰性 world（lazy-type-world）：TsigReconcile._rebuildClass 按 FQ 名在 world 里
        // `_locate` 类自身 + base 链再读 SIGS 方法。REPL 声明的类/enum 只在本增量包里，不入 world
        // 就定位不到自身 → 导出 0 方法（`no method` / undefined enum）。AppendPackage 并入 + 登记其
        // 命名空间到路由表，本包及后续增量包的类型元数据（含实例方法、enum、跨声明 base 链）都能完整重建。
        scan.World.AppendPackage(z, "");
        // ④ Exported（TSIG 重建）：world 现含本包 → 类型/方法/enum 完整重建（EnsureFq 按需解析祖先）。
        ExportedModuleZ[] tsig = TsigReconcile.Rebuild(z, "", scan.World);
        i = 0;
        while (i < tsig.Length) {
            if (scan.ExportedCount == scan.Exported.Length) {
                ExportedModuleZ[] b1 = new ExportedModuleZ[scan.Exported.Length * 2];
                string[] b2 = new string[scan.Exported.Length * 2];
                int k = 0;
                while (k < scan.ExportedCount) { b1[k] = scan.Exported[k]; b2[k] = scan.ExportedPkg[k]; k = k + 1; }
                scan.Exported = b1; scan.ExportedPkg = b2;
            }
            scan.Exported[scan.ExportedCount] = tsig[i];
            scan.ExportedPkg[scan.ExportedCount] = z.Name;
            scan.ExportedCount = scan.ExportedCount + 1;
            i = i + 1;
        }
        return scan;
    }

    // ── 惰性扫描（lazy-repl-depscan + lazy-type-world）───────────────────────────
    // 首轮只对 prelude 做 Rebuild/DepIndex + 全量廉价 nsMap；其余包在 `EnsurePackageLoaded` 按需
    // 产出 Exported/DepIndex。**lazy-type-world**：类型世界 `LazyReconWorld` 按包懒填——不再一次性
    // 全量解析 world 的 TYPE/SIGS，Rebuild 基类链遇祖先按命名空间路由只解析引用闭包（实测 `1+2`
    // 解析 14/34 包 = prelude + 默认 using 闭包，且**不随库总量增长**）。仅用于 REPL 交互路径；
    // build/test 全量编译走 ScanDirs（同惰性 world，Rebuild 全部包 → 填满，byte-identical 不受影响）。
    public static DepScanResult ScanDirsLazy(string[] dirs, int dirCount, string excludeName, string[] declaredDeps, int declaredCount) {
        var index = new DependencyIndex();
        string[] nsNames = new string[8];
        string[] nsFiles = new string[8];
        int nsCount = 0;
        ExportedModuleZ[] exported = new ExportedModuleZ[8];
        string[] exportedPkg = new string[8];
        int exportedCount = 0;
        string excludeZpkg = excludeName + ".zpkg";
        string[] paths = ZpkgPathSort._sortedZpkgsMulti(dirs, dirCount);
        if (paths.Length == 0) {
            return new DepScanResult(index, nsNames, nsFiles, 0, exported, exportedPkg, 0);
        }
        // repl-scan-nsindex-cache: 试命中 ns 索引（指纹匹配）→ 跳过 open-all，只 open prelude + 引用闭包。
        string fp = NsIndexCache._libsFingerprint(paths);
        string idxPath = NsIndexCache._nsIndexPath(dirs, dirCount);
        NsIndexEntry[] idxHit = NsIndexCache._readNsIndex(idxPath, fp, paths.Length);
        if (idxHit != null) {
            return NsIndexCache._scanFromIndex(paths, idxHit, excludeName, excludeZpkg, declaredDeps, declaredCount);
        }
        // Open 全部 → world（建惰性 LazyReconWorld + nsMap 路由）；同时留存 lib 包供按需 Rebuild。
        ZpkgInfo[] opened = new ZpkgInfo[paths.Length];
        ZpkgInfo[] world = new ZpkgInfo[paths.Length];
        string[] worldDirs = new string[paths.Length];
        int worldCount = 0;
        // lib-only 平行留存
        ZpkgInfo[] libOpened = new ZpkgInfo[paths.Length];
        string[] libDirs = new string[paths.Length];
        string[] libNames = new string[paths.Length];
        bool[] libLoaded = new bool[paths.Length];
        int libCount = 0;
        // repl-scan-nsindex-cache: 未命中——顺带收集每 *.zpkg 的 (basename,isExe,ns) → 写索引；
        // 及每 lib 包的 path + ns 列表（惰性 EnsurePackageLoaded / 惰性 open 用）。
        NsIndexEntry[] entries = new NsIndexEntry[paths.Length];
        string[] libPaths = new string[paths.Length];
        string[] nsFlat = new string[16]; int[] nsStart = new int[paths.Length]; int[] nsLen = new int[paths.Length]; int nsFlatN = 0;
        int wpi = 0;
        while (wpi < paths.Length) {
            ZpkgInfo wz = ZpkgReader.Open(File.ReadAllBytes(paths[wpi]));
            opened[wpi] = wz;
            bool isExe = (wz == null || wz.IsExe);
            entries[wpi] = new NsIndexEntry(Path.GetFileName(paths[wpi]), isExe, new string[0]);   // nss 于主循环回填
            if (wz != null && !wz.IsExe) {
                world[worldCount] = wz; worldDirs[worldCount] = Path.GetDirectoryName(paths[wpi]);
                worldCount = worldCount + 1;
            }
            wpi = wpi + 1;
        }
        // lazy-type-world：惰性 world（不再 eager 全量 BuildWorld）。prelude Rebuild + 后续按需
        // Rebuild 时经 World.EnsureFq 只解析引用到的祖先包（首次 eval O(引用闭包)）。
        LazyReconWorld lazyWorld = new LazyReconWorld(world, worldDirs, worldCount);
        int pi = 0;
        while (pi < paths.Length) {
            ZpkgInfo z = opened[pi];
            string basename = Path.GetFileName(paths[pi]);
            if (z != null && !z.IsExe) {
                // nsMap：全量（触发时靠它 FileOf(ns) 定位包）
                string[] nss = ZpkgReader.ReadNamespaces(z);
                int i = 0;
                while (i < nss.Length) {
                    if (DepScan._nsIndexOf(nsNames, nsCount, nss[i]) < 0) {
                        if (nsCount == nsNames.Length) {
                            string[] b1 = new string[nsNames.Length * 2];
                            string[] b2 = new string[nsNames.Length * 2];
                            int k = 0;
                            while (k < nsCount) { b1[k] = nsNames[k]; b2[k] = nsFiles[k]; k = k + 1; }
                            nsNames = b1; nsFiles = b2;
                        }
                        nsNames[nsCount] = nss[i];
                        nsFiles[nsCount] = basename;
                        nsCount = nsCount + 1;
                    }
                    i = i + 1;
                }
                // 留存该 lib 包供按需加载（记录目录/名/初始未加载）
                libOpened[libCount] = z; libDirs[libCount] = Path.GetDirectoryName(paths[pi]);
                libNames[libCount] = basename;
                // repl-scan-nsindex-cache: 回填索引条目（真实 nss）+ 惰性 open/EnsurePackageLoaded 所需 path + ns 列表
                // repl-type-nsindex：顺带提取每 ns 的类型短名（cold-start 一次性 ~159ms/26 包，落盘缓存）。
                NsIndexEntry ent = new NsIndexEntry(basename, false, nss);
                ent.NsTypes = NsIndexCache._extractNsTypes(z, Path.GetDirectoryName(paths[pi]), nss);
                entries[pi] = ent;
                libPaths[libCount] = paths[pi];
                nsStart[libCount] = nsFlatN; nsLen[libCount] = nss.Length;
                int nb = 0;
                while (nb < nss.Length) {
                    if (nsFlatN == nsFlat.Length) {
                        string[] d1 = new string[nsFlat.Length * 2];
                        int dk = 0; while (dk < nsFlatN) { d1[dk] = nsFlat[dk]; dk = dk + 1; }
                        nsFlat = d1;
                    }
                    nsFlat[nsFlatN] = nss[nb]; nsFlatN = nsFlatN + 1; nb = nb + 1;
                }
                // lazy-prelude（repl-lazy-prelude）：**不再 eager reconcile prelude**。所有 lib 包初始未加载，
                // 首次引用其符号时 _compileSrc 的 E0401 回退按需加载（含 prelude）。`1+1` 类纯表达式零包加载。
                libLoaded[libCount] = false;
                libCount = libCount + 1;
            }
            pi = pi + 1;
        }
        index.Seal();
        DepScanResult res = new DepScanResult(index, nsNames, nsFiles, nsCount, exported, exportedPkg, exportedCount);
        res.World = lazyWorld;
        res.Opened = libOpened; res.OpenedDirs = libDirs; res.OpenedNames = libNames;
        res.Loaded = libLoaded; res.OpenedCount = libCount;
        res.OpenedPaths = libPaths;
        res.OpenedNsFlat = nsFlat; res.OpenedNsStart = nsStart; res.OpenedNsLen = nsLen;
        NsIndexCache._fillTypeMap(res, entries, paths.Length);   // repl-type-nsindex：填类型→ns 索引
        // repl-scan-nsindex-cache: 落盘 ns 索引（下次启动指纹命中 → 跳过 open-all）。只读 libs 写失败静默。
        NsIndexCache._writeNsIndex(idxPath, fp, entries, paths.Length);
        return res;
    }

    // 按需加载命名空间 `ns` 所在的**全部**包：对每个做 Rebuild（world 已完整 → base 链正确）+
    // DepIndex。**不是 first-wins**——多个包可共享同一 ns（如 Std），全量 ScanDirs 会把它们都
    // Rebuild、其符号都进 Exported（ImportedSymbolLoader 按 ns 激活全部匹配模块）；故惰性必须
    // 加载所有声明该 ns 的包，否则与全量不一致（漏共享 ns 的次包符号）。幂等；未知 ns / 非惰性
    // scan（OpenedCount==0）no-op。lazy-repl-depscan。
    public static void EnsurePackageLoaded(DepScanResult scan, string ns) {
        int i = 0;
        while (i < scan.OpenedCount) {
            if (!scan.Loaded[i]) {
                // repl-scan-nsindex-cache: 用存储的 ns 列表判该包是否声明 ns（不 open 未命中的包）；
                // 无 ns 列表（理论上不达——两条 ScanDirsLazy 路径都填）→ 回退 ReadNamespaces（需 Opened 非 null）。
                bool declares = false;
                if (i < scan.OpenedNsLen.Length) {
                    int st = scan.OpenedNsStart[i]; int ln = scan.OpenedNsLen[i]; int k = 0;
                    while (k < ln) { if (scan.OpenedNsFlat[st + k] == ns) { declares = true; } k = k + 1; }
                } else if (scan.Opened[i] != null) {
                    string[] nss = ZpkgReader.ReadNamespaces(scan.Opened[i]);
                    if (DepScan._nsIndexOf(nss, nss.Length, ns) >= 0) { declares = true; }
                }
                if (declares) { DepReconcile._loadOpenedPackage(scan, i); }
            }
            i = i + 1;
        }
    }

    // repl-per-symbol-reconcile（completer 批量）：**读 `ns` 模块一次**，把其中短名 ∈ cands 的类型各 reconcile
    // （ReconcileOneFromDesc，不重读）追加进 scan.Exported。比「每候选各调 EnsureTypeLoaded 各读一次模块」快得多
    // （首次 Console：每活跃 ns 只读一次，而非候选×ns 次重复读大 Std 模块）。声明 ns 的包经 FileOf 定位 + 惰性
    // open。找到并追加任一 → true。幂等：已在 Exported 的同类跳过。找不到包/无匹配 → false（调用方回退整包）。
    public static bool ReconcileCandidatesInNs(DepScanResult scan, string ns, string[] cands, int candCount) {
        string basename = scan.FileOf(ns);
        if (basename.Length == 0) { return false; }
        int idx = 0 - 1;
        int i = 0;
        while (i < scan.OpenedCount) { if (scan.OpenedNames[i] == basename) { idx = i; } i = i + 1; }
        if (idx < 0) { return false; }
        ZpkgInfo z = scan.Opened[idx];
        if (z == null && idx < scan.OpenedPaths.Length) {
            z = ZpkgReader.Open(File.ReadAllBytes(scan.OpenedPaths[idx]));
            scan.Opened[idx] = z;
        }
        ZpkgModuleTypes mt = ZpkgReader.ReadOneModuleTypes(z, scan.OpenedDirs[idx], ns);   // 读一次
        string pkgName = DepScan._nameOfBasename(basename);
        bool added = false;
        int t = 0;
        while (t < mt.ClassCount) {
            string fq = mt.Classes[t].Name;
            string shortName = DepScan._shortOf(fq);
            if (DepReconcile._inCands(shortName, cands, candCount) && !DepReconcile._typeInExported(scan, ns, shortName, fq)) {
                ExportedClassZ cls = TsigReconcile.ReconcileOneFromDesc(mt.Classes[t], ns, scan.World);
                if (cls != null) { DepReconcile._appendExportedClass(scan, ns, pkgName, cls); added = true; }
            }
            t = t + 1;
        }
        return added;
    }

    // basename "z42.io.zpkg" → 包名 "z42.io"（IsPrelude 判据）。
    private static string _nameOfBasename(string basename) {
        if (basename.EndsWith(".zpkg")) { return basename.Substring(0, basename.Length - 5); }
        return basename;
    }

    internal static string _shortOf(string fq) {
        int i = fq.Length - 1;
        while (i >= 0) { if ((int)fq.CharAt(i) == 46) { return fq.Substring(i + 1); } i = i - 1; }
        return fq;
    }

    internal static int _nsIndexOf(string[] a, int n, string s) {
        int i = 0;
        while (i < n) {
            if (a[i] == s) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }
}
