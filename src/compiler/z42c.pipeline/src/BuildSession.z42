// 包构建会话（add-build-session）：「读清单 → 决议全部旋钮 → 组 CompileInputs → PackageCompile → 写产物」
// 这一层的唯一实现。今天它服务 z42b 的 `ICompiler` 路径（`Z42cCompiler`，Role = HostTarget）；第二步
// `unify-driver-on-build-session` 让 z42c CLI 的 `Main._build` 也变成它的薄封装，届时补齐其余角色
// （增量 / indexed dist / path 闭包 / 多 exe 目标）。设计见 变更 add-build-session/design.md。
//
// 两条纪律：
//   · **不打印**：诊断、进度一律经 `IBuildReporter`。z42c 与 z42b 的呈现通道不同（stderr + `z42c build:` 前缀
//     vs `ctx.Warn`），会话不替任何一方做决定。
//   · **角色显式**：`BuildRole` 替换 `_build` 里靠 `libsDirsCount` / `tier` 形状推断调用方的隐式约定。
namespace Z42.Pipeline;

using Std.IO;
using Z42.Syntax;
using Z42.Symbols;
using Z42.Package;
using Z42.Project;
using Z42.Emission;

// 调用方角色。本 change 只实现 HostTarget / AnalyzerChild；其余在第二步随 driver 迁移补齐。
public static class BuildRole {
    public static int Root          = 0;   // z42c build <toml>（顶层）
    public static int WsFlat        = 1;   // workspace flat 成员（共用 --output-dir）
    public static int WsMember      = 2;   // workspace per-member 成员
    public static int ClosureChild  = 3;   // path 依赖闭包代建
    public static int AnalyzerChild = 4;   // [plugins] 工程 path 条目代建
    public static int HostTarget    = 5;   // z42b ICompiler：packed 单产物、不解析 path 闭包、不增量
}

// `_resolvePlugins` 的结果：编译器侧插件 zpkg 路径（长度恰为 Count）。
public sealed class PluginPaths {
    public string[] Paths; public int Count;
    public PluginPaths(string[] paths, int count) { this.Paths = paths; this.Count = count; }
}

public static class BuildExit {
    public static int Ok         = 0;
    public static int BuildError = 1;   // 编译 / 构建失败（诊断已经 reporter 呈现）
    public static int UsageError = 2;   // 清单用法错误（未知旋钮名 / pack 冲突）
}

// 呈现通道。isError=false 的 Diags 是警告；Fail 是不属于某个源文件的构建级错误行。
public interface IBuildReporter {
    void Progress(string line);
    void Diags(bool isError, string origin, string[] msgs, int count);
    void Fail(string line);
}

// 收集型 reporter：z42b 路径用它把错误 / 警告回填进 CompileResult。
public sealed class CollectingReporter : IBuildReporter {
    public string[] ErrorLines;   public int ErrorCount;
    public string[] WarningLines; public int WarningCount;
    public CollectingReporter() {
        this.ErrorLines = new string[4]; this.ErrorCount = 0;
        this.WarningLines = new string[4]; this.WarningCount = 0;
    }
    public void Progress(string line) { }
    public void Diags(bool isError, string origin, string[] msgs, int count) {
        int i = 0;
        while (i < count) {
            if (isError) { this._addErr(msgs[i]); } else { this._addWarn(msgs[i]); }
            i = i + 1;
        }
    }
    public void Fail(string line) { this._addErr(line); }
    public string ErrorsText() { return CollectingReporter._join(this.ErrorLines, this.ErrorCount); }
    public string WarningsText() { return CollectingReporter._join(this.WarningLines, this.WarningCount); }
    private void _addErr(string s) {
        if (this.ErrorCount == this.ErrorLines.Length) { this.ErrorLines = CollectingReporter._grow(this.ErrorLines, this.ErrorCount); }
        this.ErrorLines[this.ErrorCount] = s; this.ErrorCount = this.ErrorCount + 1;
    }
    private void _addWarn(string s) {
        if (this.WarningCount == this.WarningLines.Length) { this.WarningLines = CollectingReporter._grow(this.WarningLines, this.WarningCount); }
        this.WarningLines[this.WarningCount] = s; this.WarningCount = this.WarningCount + 1;
    }
    private static string[] _grow(string[] a, int n) {
        string[] b = new string[a.Length * 2];
        int i = 0; while (i < n) { b[i] = a[i]; i = i + 1; }
        return b;
    }
    private static string _join(string[] a, int n) {
        string[] parts = new string[n * 2];
        int k = 0;
        int i = 0;
        while (i < n) { if (i > 0) { parts[k] = "\n"; k = k + 1; } parts[k] = a[i]; k = k + 1; i = i + 1; }
        return String.ConcatParts(parts, k);
    }
}

public sealed class BuildOptions {
    public ProjectManifest Manifest;
    public string          Label;         // 错误行里的清单名（toml 路径 / 派生清单的包名）
    public string          ProjectDir;    // 源根（[sources] glob 相对它）
    public int             Role;
    public bool            IsRelease;
    public int             CliAdd;        // --opt / --no-opt 的位（z42b 恒 0）
    public int             CliRemove;
    public string[]        BaseLibs;      // 依赖解析域（调用方决议：z42b = req.Deps 的父目录集）
    public int             BaseLibsN;
    public string          OutputZpkg;    // "" = 按 BuildLayout 的 dist/<name>.zpkg
    public string[]        Excludes;      // [sources] exclude（z42b 已并入 hooks 目录）；null = 用清单的
    public int             ExcludesCount;
    public string          ParentPkg;     // 测试 / bench 目标的父包（其 internal 可见）；"" = 普通编译
    public IBuildReporter  Reporter;
    public BuildOptions(ProjectManifest pm, string projectDir, int role, bool isRelease, IBuildReporter reporter) {
        this.Manifest = pm; this.Label = pm.Project.Name; this.ProjectDir = projectDir; this.Role = role;
        this.IsRelease = isRelease; this.CliAdd = 0; this.CliRemove = 0;
        this.BaseLibs = new string[0]; this.BaseLibsN = 0; this.OutputZpkg = "";
        this.Excludes = null; this.ExcludesCount = 0; this.ParentPkg = ""; this.Reporter = reporter;
    }
}

public sealed class BuildResult {
    public int    Code;
    public string OutZpkg;
    public string OutZsym;   // "" = 无 sidecar
    public BuildResult(int code, string zpkg, string zsym) { this.Code = code; this.OutZpkg = zpkg; this.OutZsym = zsym; }
}

public sealed class BuildSession {
    private BuildOptions _o;

    public BuildSession(BuildOptions o) { this._o = o; }

    // retire-member-dep-decls 阶段 2：SDK 计划的成员感知版——本工程若是某 workspace 的成员，成员名
    // 并入放行集（计划非空 ⇒ 编译器目录挂载；成员清单空声明后这是唯一挂载通道，原先借清单条目当
    // 种子）。只动 plan（编译域），不回写 pm——那会污染 zpkg DEPS。
    private static SdkLibPlan _memberAwarePlan(ProjectManifest pm, string projectDir, string[] libs, int libsN) {
        return SdkLibs.PlanForMembers(pm, libs, libsN, pm.Project.IsPlugin(),
                                      WorkspaceMemberDeps.EnclosingMemberNames(projectDir));
    }

    [Suppress("style.fnLinesHard", "122 body lines；拆分见 code-organization.md")]
    public BuildResult Run() {
        BuildOptions o = this._o;
        ProjectManifest pm = o.Manifest;
        IBuildReporter rep = o.Reporter;
        // ① 旋钮决议。HostTarget / AnalyzerChild 的产物都要被别人加载 ⇒ packed。
        KnobResult kn = ManifestKnobs.Resolve(pm, o.Label, o.IsRelease, o.CliAdd, o.CliRemove, true);
        if (kn.ErrorCount > 0) {
            int ke = 0;
            while (ke < kn.ErrorCount) { rep.Fail(kn.Errors[ke]); ke = ke + 1; }
            return BuildSession._fail(BuildExit.UsageError);
        }
        // ② 源发现（include 缺省 `**/*.z42`；exclude 由调用方给出时以调用方为准——z42b 已并入 hooks 目录）。
        string[] incs = pm.Sources.Include;
        int incN = pm.Sources.IncludeCount;
        if (incN == 0) { incs = new string[1]; incs[0] = "**/*.z42"; incN = 1; }
        string[] excs = o.Excludes != null ? o.Excludes : pm.Sources.Exclude;
        int excN = o.Excludes != null ? o.ExcludesCount : pm.Sources.ExcludeCount;
        string[] srcs = SourceDiscovery.DiscoverWithExclude(o.ProjectDir, incs, incN, excs, excN);
        if (srcs.Length == 0) {
            rep.Fail("no .z42 sources under " + o.ProjectDir);
            return BuildSession._fail(BuildExit.BuildError);
        }
        string[] texts = new string[srcs.Length];
        string[] hashes = new string[srcs.Length];
        int i = 0;
        while (i < srcs.Length) {
            texts[i] = File.ReadAllText(srcs[i]);
            hashes[i] = ZpkgBuilder.SourceHashHex(texts[i]);
            i = i + 1;
        }
        // ③ 解析域：调用方给的基础域 + SDK 库（add-sdk-libs，规则同 driver，见 SdkLibs.z42）：exe / lib 按名声明的
        //    SDK 库（+ 闭包）可见，插件工程全部可见；不放行的进扫描 tier 的 Hidden。成员工程自带的
        //    workspace 可见性：这里把成员名并进 SDK 放行集（计划非空 ⇒ 编译器目录挂载——成员清单
        //    空声明后这是唯一挂载通道）；扫描 tier 的成员放行与 E0497 契约在 `PackageCompile._resolveDeps`。
        string[] libs = o.BaseLibs;
        int libsN = o.BaseLibsN;
        SdkLibPlan sdkPlan = BuildSession._memberAwarePlan(pm, o.ProjectDir, libs, libsN);
        if (sdkPlan.DirsN > 0) {
            libs = SdkLibs.AppendDirs(libs, libsN, sdkPlan);
            libsN = libsN + sdkPlan.DirsN;
        }
        // ④ [plugins] → 编译器侧插件 zpkg 路径（名字条目查解析域；`.zpkg` path 直用；工程 path 以
        //    AnalyzerChild 代建）。只带 hook 位的插件归 z42b 的 hook 加载，这里跳过；一个编译器侧插件都没有 → null。
        // deps-plugin-routing（④前置）：[dependencies] 分流解析一次——routedNames = 全位（含 hook-only，
        // 供 ⑤ 豁免与 E0497 白名单排除），depAzPaths = 编译器侧位（并入 azPaths）。失败在此报。
        bool depsFailed = false;
        string[] routedNames = null;
        string[] depAzPaths = this._depsPluginPaths(pm, libs, libsN, ref depsFailed, ref routedNames);
        if (depsFailed) { return BuildSession._fail(BuildExit.BuildError); }
        string[] azPaths = null;
        if (pm.PluginCount > 0) {
            PluginPaths pp0 = this._resolvePlugins(pm, libs, libsN);
            if (pp0 == null) { return BuildSession._fail(BuildExit.BuildError); }
            if (pp0.Count > 0) { azPaths = pp0.Paths; }
        }
        if (depAzPaths != null) { azPaths = BuildSession._mergePaths(azPaths, depAzPaths); }
        // ⑤ 声明的依赖必须在解析域里（此前 z42b 路径把解析域下所有 zpkg 都当成已声明，这条从不触发）。
        //    deps-plugin-routing：插件包条目（读头自述）从检查里摘出去——它们经插件目录 / .zpkg path
        //    解析进工具链、不在运行期解析域（④ 前置的 routedNames；污染拦截也在那里）。
        string[] routedDeps = routedNames;
        string[] declared = new string[pm.DepCount];
        int dn = 0;
        int dd = 0;
        while (dd < pm.DepCount) {
            string dname = pm.Deps[dd].Name;
            bool routed = false;
            if (routedDeps != null) {
                int rk = 0;
                while (rk < routedDeps.Length) { if (routedDeps[rk] == dname) { routed = true; break; } rk = rk + 1; }
            }
            dd = dd + 1;
            if (routed) { continue; }
            string dpath = BuildSession._findInLibs(libs, libsN, dname + ".zpkg");
            if (dpath == "") {
                rep.Fail("[dependencies] `" + dname + "` 未找到 " + dname + ".zpkg；已查找："
                    + BuildSession._dirList(libs, libsN) + "。检查包名拼写，或先构建该依赖。");
                return BuildSession._fail(BuildExit.BuildError);
            }
            declared[dn] = dname; dn = dn + 1;
        }
        // ⑥ 解析（带 [syntax] 特性门）→ 组 CompileInputs → 编译。
        CompilationUnit[] cus = new CompilationUnit[srcs.Length];
        int pi = 0;
        while (pi < srcs.Length) {
            Parser pp = new Parser(texts[pi], srcs[pi]);
            pp._features = kn.Features;
            // AST 相位单一入口（store-meta 合成）——与 driver `ParseAllTk`、
            // `IrDump.ParseAll` 同款。漏掉它字段 / 参数 / 属性上的自定义 attribute 就进不了产物元数据
            // （stdlib reflection / json 的 [JsonProperty] 单测实测判红）。
            cus[pi] = HandlerRegistry.RunAst(pp.ParseCompilationUnit());
            pi = pi + 1;
        }
        CompileInputs inp = new CompileInputs();
        inp.Texts = texts; inp.Files = srcs; inp.SrcHashes = hashes; inp.SrcCount = srcs.Length;
        inp.Cus = cus; inp.CachedMods = null; inp.CachedMetas = null;
        inp.Name = pm.Project.Name; inp.Version = pm.Project.Version; inp.Kind = pm.Project.Kind;
        inp.HasEntry = pm.Project.HasEntry; inp.Entry = pm.Project.Entry;
        inp.IsRelease = o.IsRelease;
        inp.Features = kn.Features;
        inp.OptSet = kn.OptSet;
        inp.LibsDirs = libs; inp.LibsDirsN = libsN;
        inp.Tier = SdkLibs.MergeTier(null, sdkPlan);
        string[] declaredAll = SdkLibs.ExtendDeclared(declared, dn, sdkPlan);
        inp.DeclaredDeps = declaredAll; inp.DepCount = declaredAll.Length;
        inp.EnforceDeclaredDeps = true;          // 真的读了一份清单 ⇒ 执行依赖契约（E0497），同 z42c build
        inp.ParentPkg = o.ParentPkg;
        if (!_attachCarried(inp, pm, o, azPaths)) { return null; }   // 显式插件挂载 + 1c 携带（失败即构建失败）
        inp.Lints = kn.Lints;
        CompileArtifacts art = PackageCompile.Compile(inp);
        // ⑦ 诊断：逐 CU（上界 art.CmCount——generator 产出的 CU 排在用户 CU 之后，标 <generated>）。
        int ci2 = 0;
        while (ci2 < art.CmCount) {
            CompiledModuleZ cm = art.Cms[ci2];
            string origin = ci2 < srcs.Length ? srcs[ci2] : "<generated>";
            if (cm.DiagCount > 0) { rep.Diags(cm.ErrorCount > 0, origin, cm.DiagMsgs, cm.DiagCount); }
            ci2 = ci2 + 1;
        }
        if (art.ErrorCount > 0) { return BuildSession._fail(BuildExit.BuildError); }
        bool isExe = pm.Project.Kind == "exe";
        if (isExe && art.EntryStatus == "ambiguous") {
            rep.Fail("multiple Main candidates; set [project].entry explicitly");
            return BuildSession._fail(BuildExit.BuildError);
        }
        if (isExe && art.EntryStatus == "missing") {
            rep.Fail("kind=exe but no Main() found in " + o.ProjectDir);
            return BuildSession._fail(BuildExit.BuildError);
        }
        // ⑧ 写产物：packed；strip 时主包剥 DBUG 且**必写** .zsym（此前 z42b 主包照剥、.zsym 却被丢）。
        // 可复现 build_id：SourceFile 相对源根、SourceHash 置空（同 driver `_stabilizeSourceIdentity`）。
        int si = 0;
        while (si < art.Z.ModuleCount) {
            ZbcFileZ sm = art.Z.Modules[si];
            sm.SourceFile = IncrementalBuild.Rel(o.ProjectDir, sm.SourceFile);
            sm.SourceHash = "";
            si = si + 1;
        }
        string outZpkg = o.OutputZpkg;
        if (outZpkg == "") {
            outZpkg = Path.Join(BuildLayout.Resolve(pm, o.ProjectDir, o.IsRelease).DistDir, pm.Project.Name + ".zpkg");
        }
        ZpkgWriteResult wres = ZpkgWriterZ.WritePackedWithSidecar(art.Z, kn.Strip);
        string outDir = Path.GetDirectoryName(outZpkg);
        if (outDir.Length > 0) { Directory.Create(outDir); }
        File.WriteAllBytes(outZpkg, wres.Main);
        string zsym = "";
        if (wres.HasSidecar) {
            zsym = outZpkg.EndsWith(".zpkg") ? outZpkg.Substring(0, outZpkg.Length - 5) + ".zsym" : outZpkg + ".zsym";
            File.WriteAllBytes(zsym, wres.Sidecar);
        }
        rep.Progress("wrote -> " + outZpkg);
        return new BuildResult(BuildExit.Ok, outZpkg, zsym);
    }

    // [plugins] 条目 → 编译器侧插件 zpkg 路径（按清单顺序）；失败经 reporter 报错并返回 null。
    //   · 源集条目（include/exclude，对齐 [tests]）与工程 / 免清单 path：合成或定位清单 →
    //     AnalyzerChild 会话代建 → 取其产物；
    //   · 名字条目：解析域里找 `<name>.zpkg`；`.zpkg` path：现成产物（相对工程目录）。
    // 拿到 zpkg 后按 `PluginZpkg.Inspect` 校验名字与能力位；只收带 analyzer / generator 位的。
    // 代建产物**不并入**消费方解析域（插件只加载进工具链进程）。
    private PluginPaths _resolvePlugins(ProjectManifest pm, string[] libs, int libsN) {
        IBuildReporter rep = this._o.Reporter;
        string[] paths = new string[pm.PluginCount];
        int n = 0;
        int ai = 0;
        while (ai < pm.PluginCount) {
            DepEntry e = pm.Plugins[ai];
            string aname = e.Name;
            ai = ai + 1;
            string got = "";
            if (e.IncludeCount > 0 || (e.Path.Length > 0 && !e.Path.EndsWith(".zpkg"))) {
                got = this._buildPluginProject(e);
                if (got == "") { return null; }
            } else if (e.Path.Length == 0) {
                got = BuildSession._findInLibs(libs, libsN, aname + ".zpkg");
                if (got == "") {
                    rep.Fail("[plugins] `" + aname + "` 未找到 " + aname + ".zpkg；已查找：" + BuildSession._dirList(libs, libsN) + "。");
                    return null;
                }
            } else {
                got = Path.IsRooted(e.Path) ? e.Path : Path.Join(this._o.ProjectDir, e.Path);
                if (!File.Exists(got)) {
                    rep.Fail("[plugins] `" + aname + "` 的 path 指向 " + got + "，文件不存在。");
                    return null;
                }
            }
            PluginInspection pi = PluginZpkg.Inspect(got, aname);
            if (pi.Error.Length > 0) { rep.Fail(pi.Error); return null; }
            if (PluginCaps.ForCompiler(pi.Caps)) { paths[n] = got; n = n + 1; }
        }
        string[] trimmed = new string[n];
        int t = 0;
        while (t < n) { trimmed[t] = paths[t]; t = t + 1; }
        return new PluginPaths(trimmed, n);
    }

    // [dependencies] 里按 zpkg 头自述分流出的**编译器侧**插件包（deps-plugin-routing）。口径与
    // z42c.driver `_pluginDepZpkgs` 一致：名字条目 = libs 先（命中插件 ⇒ 污染报错）、插件目录
    //（PluginDirs.Search()）后；`.zpkg` path 直连；工程目录条目不在此（kind = "plugin" 的 path 依赖
    // 被上游拒绝——源码形态的插件引用属于 [plugins]）。hook 位归 z42b（builder_hooks._loadDepsHooks）。
    // 返回 null = 无编译器侧分流；routedNames = **全位**分流名（含 hook-only；null = 无）；failed = true = 诊断已报。
    private string[] _depsPluginPaths(ProjectManifest pm, string[] libs, int libsN, ref bool failed, ref string[] routedNames) {
        IBuildReporter rep = this._o.Reporter;
        string[] acc = new string[pm.DepCount > 0 ? pm.DepCount : 1];
        string[] names = new string[pm.DepCount > 0 ? pm.DepCount : 1];
        int n = 0; int nn = 0;
        int di = 0;
        while (di < pm.DepCount) {
            DepEntry de = pm.Deps[di];
            di = di + 1;
            string dgot = this._depPluginZpkg(de, libs, libsN, ref failed);
            if (failed) { return null; }
            if (dgot.Length == 0) { continue; }
            ZpkgInfo dp = null;
            try { dp = ZpkgReader.Open(File.ReadAllBytes(dgot), dgot); } catch (Exception ex) { dp = null; }
            if (dp == null || !PluginCaps.IsPlugin(dp.PluginCaps)) { continue; }
            PluginInspection dpi = PluginZpkg.Inspect(dgot, de.Name);
            if (dpi.Error.Length > 0) { rep.Fail(dpi.Error); failed = true; return null; }
            names[nn] = de.Name; nn = nn + 1;
            if (PluginCaps.ForCompiler(dpi.Caps)) { acc[n] = dgot; n = n + 1; }
        }
        if (nn > 0) {
            string[] rn = new string[nn];
            int q = 0;
            while (q < nn) { rn[q] = names[q]; q = q + 1; }
            routedNames = rn;
        }
        if (n == 0) { return null; }
        string[] r = new string[n];
        int k = 0;
        while (k < n) { r[k] = acc[k]; k = k + 1; }
        return r;
    }

    // 一个 [dependencies] 条目 → 插件 zpkg 路径（"" = 不是插件 / 不归分流）；failed = 诊断已报。
    // 名字条目：libs 先（命中插件 ⇒ 污染报错）、插件目录后；.zpkg path 直连；工程目录条目恒 ""。
    private string _depPluginZpkg(DepEntry de, string[] libs, int libsN, ref bool failed) {
        IBuildReporter rep = this._o.Reporter;
        if (de.Path.Length == 0) {
            string dfile = de.Name + ".zpkg";
            int dd = 0;
            while (dd < libsN) {
                string cand = Path.Join(libs[dd], dfile);
                if (File.Exists(cand)) {
                    ZpkgInfo h = null;
                    try { h = ZpkgReader.Open(File.ReadAllBytes(cand), cand); } catch (Exception ex) { h = null; }
                    if (h != null && PluginCaps.IsPlugin(h.PluginCaps)) {
                        rep.Fail("[dependencies] `" + de.Name + "`（" + cand + "）是插件包（"
                            + PluginCaps.Describe(h.PluginCaps) + "）——插件包不进运行期解析域："
                            + "把它移到插件目录（Z42_PLUGINS / <sdk>/plugins）后按名依赖，或改写到 [plugins] 段。");
                        failed = true;
                    }
                    return "";   // 普通库（或读不开）：存在性归编译侧校验，不认领
                }
                dd = dd + 1;
            }
            string[] pdirs = PluginDirs.Search();
            int pd = 0;
            while (pd < pdirs.Length) {
                string cand = Path.Join(pdirs[pd], dfile);
                if (File.Exists(cand)) { return cand; }
                pd = pd + 1;
            }
            return "";
        }
        if (!de.Path.EndsWith(".zpkg")) { return ""; }
        string full = Path.IsRooted(de.Path) ? de.Path : Path.Join(this._o.ProjectDir, de.Path);
        return File.Exists(full) ? full : "";
    }

    // azPaths ∪ depPaths（azPaths 可能 null）；都空 → null。
    private static string[] _mergePaths(string[] azPaths, string[] depPaths) {
        int a = (azPaths == null ? 0 : azPaths.Length);
        string[] r = new string[a + depPaths.Length];
        int i = 0;
        while (i < a) { r[i] = azPaths[i]; i = i + 1; }
        int j = 0;
        while (j < depPaths.Length) { r[a + j] = depPaths[j]; j = j + 1; }
        return r;
    }

    // path 条目的插件（工程目录 / 免清单目录 / 单文件）+ 源集条目（include/exclude）：定位（或合成）
    // 清单 → 校验 → AnalyzerChild 子会话代建 → 产物路径；失败报错返回 ""。免清单（源集 / 单文件 /
    // 目录）由 PluginSynth 合成最小清单（落消费方 cache 目录）→ 与工程条目同路（与 z42c.driver
    // PluginRefs / z42b builder_hooks 同口径）。
    private string _buildPluginProject(DepEntry e) {
        IBuildReporter rep = this._o.Reporter;
        string aname = e.Name;
        string cacheDir = BuildLayout.Resolve(this._o.Manifest, this._o.ProjectDir, this._o.IsRelease).CacheDir;
        string atoml = this._pluginEntryToml(e, cacheDir);
        if (atoml.Length == 0) { return ""; }
        ProjectManifest apm = ManifestLoader.Load(atoml);
        if (!apm.Project.IsPlugin() || apm.Project.Name != aname) {
            rep.Fail("[plugins] `" + aname + "` 指向的工程 " + atoml + " 须是 kind = \"plugin\" 且名为 `"
                + aname + "`（实际 kind = \"" + apm.Project.Kind + "\"、name = `" + apm.Project.Name + "`）。");
            return "";
        }
        if (apm.DepCount > 0 && BuildSession._hasPathDep(apm)) {
            rep.Fail("[plugins] `" + aname + "` 自带 path 依赖；本构建路径暂不代建插件的依赖闭包，"
                + "请先用 `z42c build " + atoml + "` 构建它。");
            return "";
        }
        // 插件工程的解析域 = 消费方基础域（stdlib）；编译器域在子会话里按 kind 并入。
        BuildOptions co = new BuildOptions(apm, Path.GetDirectoryName(atoml), BuildRole.AnalyzerChild,
                                           this._o.IsRelease, rep);
        co.Label = atoml;
        co.BaseLibs = this._o.BaseLibs; co.BaseLibsN = this._o.BaseLibsN;
        BuildResult cr = new BuildSession(co).Run();
        if (cr.Code != BuildExit.Ok) {
            rep.Fail("[plugins] `" + aname + "` 的工程构建失败（见上）。");
            return "";
        }
        return cr.OutZpkg;
    }

    private static bool _hasPathDep(ProjectManifest pm) {
        int i = 0;
        while (i < pm.DepCount) { if (pm.Deps[i].Path.Length > 0) { return true; } i = i + 1; }
        return false;
    }

    // 条目（源集 / 单文件 / 免清单目录 / 工程目录）→ 插件工程清单路径（定位或 PluginSynth 合成）；
    // 失败经 reporter 报错返回 ""。
    private string _pluginEntryToml(DepEntry e, string cacheDir) {
        IBuildReporter rep = this._o.Reporter;
        string aname = e.Name;
        if (e.IncludeCount > 0) {
            if (e.Path.Length > 0) {
                rep.Fail("[plugins] `" + aname + "` 同时写了 include 与 path——二者互斥：源码集用 include/exclude"
                    + "（相对本工程目录），插件工程用 path。");
                return "";
            }
            string stoml = PluginSynth.SynthSet(cacheDir, aname, this._o.ProjectDir, e.Include, e.IncludeCount, e.Exclude, e.ExcludeCount);
            if (stoml.Length == 0) {
                rep.Fail("[plugins] `" + aname + "` 的源集 include 一个 .z42 都没匹配到——检查 glob"
                    + "（须以文件模式收尾，如 `hooks/**/*.z42`）。");
            }
            return stoml;
        }
        string adir = Path.Join(this._o.ProjectDir, e.Path);
        if (e.Path.EndsWith(".z42")) {
            string asrc = Path.IsRooted(e.Path) ? e.Path : adir;
            if (!File.Exists(asrc)) {
                rep.Fail("[plugins] `" + aname + "` 的 path 指向 " + asrc + "，文件不存在。");
                return "";
            }
            string ftoml = PluginSynth.SynthFile(cacheDir, aname, asrc);
            if (ftoml.Length == 0) {
                rep.Fail("[plugins] `" + aname + "` 的单文件插件清单合成失败（源文件 " + asrc + "）。");
            }
            return ftoml;
        }
        ManifestLocation aloc = ManifestLocator.FindIn(adir);
        if (aloc.Kind == ManifestLocateKind.Project) { return aloc.ManifestPath; }
        if (aloc.Kind == ManifestLocateKind.NotFound && Directory.Exists(adir)) {
            string dtoml = PluginSynth.SynthDir(cacheDir, aname, adir);
            if (dtoml.Length == 0) {
                rep.Fail("[plugins] `" + aname + "` 的 path 指向 " + adir
                    + "，那里既没有工程清单，也没有任何 .z42 源文件。");
            }
            return dtoml;
        }
        rep.Fail("[plugins] `" + aname + "` 的 path 指向 " + adir + "，那里没有单个工程清单。");
        return "";
    }


    private static string _findInLibs(string[] libs, int n, string file) {
        int d = 0;
        while (d < n) {
            string cand = Path.Join(libs[d], file);
            if (File.Exists(cand)) { return cand; }
            d = d + 1;
        }
        return "";
    }

    private static string _dirList(string[] libs, int n) {
        if (n == 0) { return "(无依赖目录)"; }
        string s = "";
        int d = 0;
        while (d < n) { s = s + (d > 0 ? ", " : "") + libs[d]; d = d + 1; }
        return s;
    }

    private static BuildResult _fail(int code) { return new BuildResult(code, "", ""); }
}

// 编译器域包的解析域 —— 「显式引用编译器域库」的落点（relocate-compiler-domain-libs）。
//
// 插件工程（`kind = "plugin"`）要 `[dependencies]` 到编译器的契约包（`z42c.semantics` 的
// `Generator`/`ModuleGenerator`/`GenSink`/`GenTarget`），而这些 zpkg **不在** `libs/` ——
// 那正是 proposal 记下的症状：契约在 SDK 目录里、却不在解析器会去看的地方，于是插件作者
// 拿到的是一句位置在别处的 `E0443 undefined type: ModuleGenerator`，没有任何东西诊断它。
//
// 🔴 **落点是 `programs/z42c/`，不是独立的 `compiler-libs/`**（User  裁：避免复杂）。
// 旧实现探的 `Z42_HOME/compiler-libs` 与 `<sdk>/compiler-libs` **在发布态恒不存在** ——
// 实测今天的 nightly SDK 里没有那个目录，`z42c.semantics.zpkg` 躺在 `programs/z42c/`；
// 两条组装路只有 `package dev-sdk` 那条建了它，发布 tarball 里没有 ⇒ **批 1 声称打通的「用户能写
// generator」在发布态一直是空的**，只有开发树靠第 ③ 档命中。改指真实存在的那个目录即修复。
//
// 探测序（存在者为准；一个都没有 → 空数组，调用方照旧只看 libs/）：
//   ① 开发树：自 `Z42_LIBS` 逐级上溯（至多 4 级），第一个含 `build/compiler/z42c.driver/release/dist/` 的
//      祖先（即 `artifacts/`）命中
//      （driver 是 exe，dist 里是它的**自包含闭包** —— 与 SDK 的 `programs/z42c/` 同形。此前指
//      `z42c.semantics` 的 dist，那里只有它自己：analyzer 的契约包碰巧够用，`z42.project` 等其它编译器域
//      包在开发树里就引用不到（tidy-xtask-config 里 xtask 改为 `${compiler_libs}` 引用时实测）。）
//   ② `Z42_HOME/programs/z42c/`                 —— SDK 安装态（launcher 转发时已设）
//   ③ `Z42_PORTABLE_VM` 反推 SDK 根 → `<sdk>/programs/z42c/`
// 开发树排在 SDK 前：`Z42_LIBS` 是显式给的编译期依赖面，它在开发树里 ⇒ 编译器域也取同一棵树。SDK 变量常是从
// 外层继承来的（xtask 经 SDK apphost 启动，`Z42_PORTABLE_VM` 传给每个子进程）——排在前面时，开发树里按名声明的
// 编译器包会对着那份 SDK 里上一版的包解析。SDK 安装态 `Z42_LIBS = <sdk>/libs`，上溯找不到开发树，①落空。
// ②③ 与 `ReplCompilerHost._findCompilerZpkg`（scripting 定位编译器组件）是**同一套落点**。
//
// unify-driver-knobs：driver 的 `_compilerDomainDirs` 已删，driver 与 BuildSession 共用本类（此前两份逐行相同）。
public static class CompilerDomain {
    public static string[] Dirs() {
        string[] found = new string[3];
        int n = 0;
        // ① 不按固定层数上溯：stdlib flat 在 artifacts/ 下的深度属于 xtask 的布局，换位置时编译器不该跟着改。
        string anc = Environment.GetEnvironmentVariable("Z42_LIBS", "");
        int up = 0;
        while (anc.Length > 0 && up < 4) {
            anc = Path.GetDirectoryName(anc);
            if (anc.Length == 0) { break; }
            string dev = Path.Join(anc, Path.Join("build", Path.Join("compiler", Path.Join("z42c.driver", Path.Join("release", "dist")))));
            if (Directory.Exists(dev)) { n = CompilerDomain._add(found, n, dev); break; }
            up = up + 1;
        }
        string home = Environment.GetEnvironmentVariable("Z42_HOME", "");
        if (home.Length > 0) { n = CompilerDomain._add(found, n, Path.Join(home, Path.Join("programs", "z42c"))); }
        string pv = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM", "");
        if (pv.Length > 0) {
            string sdk = Path.GetDirectoryName(Path.GetDirectoryName(pv));
            n = CompilerDomain._add(found, n, Path.Join(sdk, Path.Join("programs", "z42c")));
        }
        string[] r = new string[n];
        int i = 0; while (i < n) { r[i] = found[i]; i = i + 1; }
        return r;
    }

    private static int _add(string[] found, int n, string dir) {
        if (!Directory.Exists(dir)) { return n; }
        int i = 0;
        while (i < n) { if (found[i] == dir) { return n; } i = i + 1; }
        found[n] = dir;
        return n + 1;
    }
}

// 显式插件挂载 + 1c 携带（[plugins.export] → PLGS 段条目）。解析失败（诊断已打印）→ false（构建失败）。
bool _attachCarried(CompileInputs inp, ProjectManifest pm, BuildOptions o, string[] azPaths) {
    if (azPaths != null) { inp.AnalyzerZpkgs = azPaths; inp.AnalyzerZpkgCount = azPaths.Length; }
    if (pm.PluginExportCount == 0) { return true; }
    PluginCarryZ[] carried = PluginCarry.Resolve(pm, o.ProjectDir, o.IsRelease);
    if (carried == null) { return false; }
    inp.CarriedPlugins = carried; inp.CarriedCount = carried.Length;
    return true;
}
