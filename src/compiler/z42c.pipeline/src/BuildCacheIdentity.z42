// Entry-specific dependency observations plus effective options, syntax and manifest identity guard cached IR.
namespace Z42.Pipeline;
using Z42.Project;

public static class BuildCacheIdentity {
    public static string Of(ProjectManifest pm, int effOptSet, bool isRelease, string[] libsDirs, int libsDirsN, WsTier scanTier) {
        string depsId = DepIdentity.Of(libsDirs, libsDirsN, pm.Project.Name, scanTier);
        return BuildCacheIdentity._context(pm, effOptSet, isRelease, depsId);
    }

    public static string ForHost(ProjectManifest pm, int effOptSet, bool isRelease, string[] libsDirs, int libsDirsN, WsTier scanTier, string cacheDir, bool useSurface) {
        if (!useSurface) { return BuildCacheIdentity._context(pm, effOptSet, isRelease,
            "host-bytes:" + DepIdentity.Of(libsDirs, libsDirsN, pm.Project.Name, scanTier)); }
        string depsId = DependencySurfaceCache.Of(libsDirs, libsDirsN, pm.Project.Name, scanTier, cacheDir);
        return BuildCacheIdentity._context(pm, effOptSet, isRelease, "host-surface:" + depsId);
    }

    private static string _context(ProjectManifest pm, int effOptSet, bool isRelease, string depsId) {
        depsId = depsId + "|opt" + effOptSet.ToString();
        int sd = 0;
        while (sd < pm.SyntaxCount) {
            depsId = depsId + "|syn:" + pm.SyntaxNames[sd] + "=" + (pm.SyntaxValues[sd] ? "1" : "0");
            sd = sd + 1;
        }
        depsId = depsId + "|mf:" + pm.Project.Name + "@" + pm.Project.Version
               + "/" + pm.Project.Kind
               + "/" + (pm.Project.HasEntry ? pm.Project.Entry : "-")
               + "/" + (isRelease ? "rel" : "dbg");
        int mdi = 0;
        while (mdi < pm.DepCount) {
            depsId = depsId + "|dep:" + pm.Deps[mdi].Name;
            mdi = mdi + 1;
        }
        return depsId;
    }
}
