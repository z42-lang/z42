// 内建行数 lint（style.* 规则）——原 xtask `check lines` / `check fnlines` 两道门禁的下沉。
//
// 为什么住编译器：门禁的度量对象是 z42 源码，编译器每次构建本就持有 AST + 源文本，
// 在这里做是「顺路」；且方法识别从文本启发式（缩进/括号猜方法头）升级为 AST 确证。
// 配置与抑制零新机制，全部复用 attribute-handler-registry 的既有面：
//   · 清单 `[lints]`：规则 severity 覆盖（精确 Id / `style.*` 通配 / warnings_as_errors）；
//   · 源内抑制：方法级 `[Suppress("style.fnLinesHard", "理由")]`、文件级 `#suppress style.fileLinesHard "理由"`
//    （不闭合延伸到 EOF）。原 gates.toml 棘轮基线由此退役——被抑制的条目各自带理由、可见可 grep，
//     代价是失去「基线内不许膨胀」那条（抑制条目可增长）；拆完函数删标记即收口。
//
// 规则默认全部关闭（EnabledByDefault=false）：code-organization.md 的 886/500/60/40 是本仓约定，
// 不强加给所有用户工程；阈值是规则内常量（原门禁里也是硬编码，不扩 [lints] 值语法）。
// 规则 Id 走 `style.` 域前缀（analyzer 规则 Id 是自由串，`webgen.*` / `H0002` 先例），
// 不占 DiagnosticCodes——那是 E/W 诊断码域，受 diagcodes 门禁双向对账。
//
// 度量口径与原门禁一致（阈值语义不变）：
//   · 文件行数 = 文本行计数（非空行以外全计）；
//   · 函数体行数 = 方法体 `{` 行与配对 `}` 行**之间**的非空、非 `//` 行数；单行体计 0。
//     `{` 由 AST 锚定（MethodDecl.Body 的 Span 恰是 `{` token），配对 `}` 按行剥字面量后数括号深度
//     （移植原门禁的 _fnStripLiterals/_fnBraceDelta/_fnBodyLines）。局部函数 / lambda 不入统计
//     （只遍历声明树，不入语句体）；abstract / 接口方法 / 合成构造器跳过。
//
// 自举不动点：cfg 未启用（Active=false）时整趟不进——与 analyzer 段同款 gate，未启用即逐字节不动；
// 启用后诊断也只进 CompiledModuleZ.DiagMsgs，从不进 zbc/zpkg 字节（Error 级才拦编译）。
namespace Z42.Pipeline;

using Z42.Core;       // DiagnosticBag / Span
using Z42.Syntax;     // CompilationUnit / Decl 系 / Lexer
using Z42.Analyzers;  // DiagRule / LintConfig / AnalyzerSeverity

public static class LineLint {
    // 阈值（code-organization.md；与原 xtask 门禁一致）。
    public static int FileLimitHard() { return 886; }
    public static int FileLimitSoft() { return 500; }
    public static int FnLimitHard()   { return 60; }
    public static int FnLimitSoft()   { return 40; }

    // 四条规则。软限只提示（Info），硬限 Warning（[lints] 可升 error / warnings_as_errors）。
    public static DiagRule FileLinesRule = new DiagRule(
        "style.fileLines", "文件行数软限", "file is over the soft line limit (advisory)",
        "Style", AnalyzerSeverity.Info, false);
    public static DiagRule FileLinesHardRule = new DiagRule(
        "style.fileLinesHard", "文件行数硬限", "file is over the hard line limit — split it",
        "Style", AnalyzerSeverity.Warning, false);
    public static DiagRule FnLinesRule = new DiagRule(
        "style.fnLines", "函数体行数软限", "method body is over the soft line limit (advisory)",
        "Style", AnalyzerSeverity.Info, false);
    public static DiagRule FnLinesHardRule = new DiagRule(
        "style.fnLinesHard", "函数体行数硬限", "method body is over the hard line limit — extract helpers",
        "Style", AnalyzerSeverity.Warning, false);

    // cfg 是否启用了任一 style 规则（未启用 → 调用方整趟跳过：FrontLine 不建 bag、BuildRun 不禁 preserved）。
    public static bool Active(LintConfig cfg) {
        if (cfg == null) { return false; }
        return cfg.Resolve(LineLint.FileLinesHardRule) >= 0 || cfg.Resolve(LineLint.FnLinesHardRule) >= 0
            || cfg.Resolve(LineLint.FileLinesRule) >= 0 || cfg.Resolve(LineLint.FnLinesRule) >= 0;
    }

    // 对一个 CU（+其源文本）跑全部 style 规则；诊断进 bag（severity 经 LintConfig 决策）。
    public static void Check(CompilationUnit cu, string text, LintConfig cfg, DiagnosticBag bag) {
        if (cu == null || text == null) { return; }

        LineIndex lx = new LineIndex(text);
        // 文件级：total > 硬限 → 只报硬限；介于软硬之间 → 只报软限（提示，不重复计）。
        int total = lx.Total;
        if (total > LineLint.FileLimitHard()) {
            LineLint._report(bag, cfg, cu.Span, LineLint.FileLinesHardRule,
                "文件 " + total.ToString() + " 行，超过 " + LineLint.FileLimitHard().ToString()
                + " 行硬限——拆分它（code-organization.md；豁免：文件顶部 #suppress style.fileLinesHard \"理由\"）", cu);
        } else if (total > LineLint.FileLimitSoft()) {
            LineLint._report(bag, cfg, cu.Span, LineLint.FileLinesRule,
                "文件 " + total.ToString() + " 行，超过 " + LineLint.FileLimitSoft().ToString() + " 行软限（提示，考虑拆分）", cu);
        }

        int i = 0;
        while (i < cu.DeclCount) {
            LineLint._walkDecl(cu.Decls[i], lx, cfg, bag, cu);
            i = i + 1;
        }
    }

    // 声明树遍历（不入语句体 ⇒ 局部函数 / lambda 天然排除）。
    private static void _walkDecl(Decl d, LineIndex lx, LintConfig cfg, DiagnosticBag bag, CompilationUnit cu) {
        if (d == null) { return; }
        Attr[] attrs = null; int attrCount = 0;
        Decl inner = d;
        if (d is AttributedDecl) {
            AttributedDecl ad = d as AttributedDecl;
            attrs = ad.Attrs; attrCount = ad.AttrCount;
            inner = ad.Inner;
        }
        if (inner is MethodDecl) {
            MethodDecl m = inner as MethodDecl;
            if (m.HasBody && !m.IsSynthesized) {
                LineLint._checkFn(m, attrs, attrCount, lx, cfg, bag, cu);
            }
            return;
        }
        if (inner is ClassDecl) {
            ClassDecl cd = inner as ClassDecl;
            int i = 0;
            while (i < cd.MemberCount) { LineLint._walkDecl(cd.Members[i], lx, cfg, bag, cu); i = i + 1; }
            return;
        }
        if (inner is ImplDecl) {
            ImplDecl im = inner as ImplDecl;
            int i = 0;
            while (i < im.MethodCount) { LineLint._walkDecl(im.Methods[i], lx, cfg, bag, cu); i = i + 1; }
            return;
        }
    }

    // 一个方法的体行数检查。位置报在方法头首 token（SuppressionSet 的字节区间以 token 偏移为准）。
    private static void _checkFn(MethodDecl m, Attr[] attrs, int attrCount, LineIndex lx,
                                 LintConfig cfg, DiagnosticBag bag, CompilationUnit cu) {
        int body = LineLint._fnBodyLines(m, lx);
        if (body < 0) { return; }
        if (body > LineLint.FnLimitHard()) {
            LineLint._reportFn(bag, cfg, m.Span, attrs, attrCount, cu, LineLint.FnLinesHardRule,
                body, LineLint.FnLimitHard(), "硬限——抽取 helper（code-organization.md；豁免：[Suppress(\"style.fnLinesHard\", \"理由\")]）");
        } else if (body > LineLint.FnLimitSoft()) {
            LineLint._reportFn(bag, cfg, m.Span, attrs, attrCount, cu, LineLint.FnLinesRule,
                body, LineLint.FnLimitSoft(), "软限（提示，考虑抽取）");
        }
    }

    private static void _reportFn(DiagnosticBag bag, LintConfig cfg, Span at, Attr[] attrs, int attrCount,
                                  CompilationUnit cu, DiagRule rule, int body, int limit, string tail) {
        // 方法级抑制先行：`[Suppress("style.*", …)]` 命中即整条丢弃（镜像 AnalyzerDriver._pushSuppress 的读法）。
        if (LineLint._hasSuppressAttr(attrs, attrCount, rule.Id)) { return; }
        LineLint._report(bag, cfg, at, rule, "函数体 " + body.ToString() + " 行，超过 " + limit.ToString() + " 行" + tail, cu);
    }

    // 报告共用体：`#suppress` 区间命中即丢弃 → LintConfig 决策 severity（抑制/禁用 → 不报）。
    private static void _report(DiagnosticBag bag, LintConfig cfg, Span at, DiagRule rule, string msg,
                                CompilationUnit cu) {
        int i = 0;
        while (i < cu.SuppressRegionCount) {
            SuppressRegion rg = cu.SuppressRegions[i];
            if (rg.RuleId == rule.Id && at.Start >= rg.Start && at.Start < rg.End) { return; }
            i = i + 1;
        }
        int eff = cfg.Resolve(rule);
        if (eff < 0) { return; }
        if (eff == AnalyzerSeverity.Error) { bag.Error(rule.Id, msg, at); return; }
        if (eff == AnalyzerSeverity.Warning) { bag.Warning(rule.Id, msg, at); return; }
        bag.Info(rule.Id, msg, at);
    }

    // `[Suppress("Id", …)]`：从 AttributedDecl 的 attrs 按名读首参字符串字面量（与 AnalyzerDriver._pushSuppress 同一形状）。
    private static bool _hasSuppressAttr(Attr[] attrs, int attrCount, string ruleId) {
        if (attrs == null) { return false; }
        int i = 0;
        while (i < attrCount) {
            Attr at = attrs[i];
            if (at.Name == SuppressionSet.Directive && at.ArgCount >= 1 && at.Args[0] is StringLitExpr) {
                if (Lexer.DecodeString((at.Args[0] as StringLitExpr).Raw) == ruleId) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    // 方法体行数：Body.Span 锚定 `{` token（BlockStmt 的 Span 恰是 `{`——decl Span 只盖首 token 的通病
    // 在这里反而是便利）；从该行起按剥字面量后的括号深度找配对 `}` 行，数两行**之间**的非空、非 `//` 行。
    // 返回 -1 = 不可测（锚点不是 `{`——表达式体等合成形态；或括号不配对——畸形源）。
    // 只走本方法覆盖的行；逐行量（括号增量 / 是否计数）由 LineIndex 每文件算一次。
    private static int _fnBodyLines(MethodDecl m, LineIndex lx) {
        if (!(m.Body is BlockStmt)) { return 0 - 1; }
        int open = (m.Body as BlockStmt).Span.Start;
        if (open < 0 || open >= lx.Text.Length || lx.Text.CharAt(open) != '{') { return 0 - 1; }
        int hdr = lx.LineAt(open);
        int depth = lx.Delta[hdr];
        if (depth <= 0) { return 0 - 1; }
        int body = 0;
        int j = hdr + 1;
        while (j < lx.Count && depth > 0) {
            depth = depth + lx.Delta[j];
            if (depth > 0 && lx.Counted[j]) { body = body + 1; }
            j = j + 1;
        }
        if (depth != 0) { return 0 - 1; }   // 到 EOF 没配上——畸形源，别误报
        return body;
    }

}

// 一个文件的逐行量，按 `Split("\n")` 的行下标：每行括号增量（字符串 / 字符字面量与 `//` 注释里的括号不计，
// 原门禁 _fnStripLiterals + _fnBraceDelta 的口径）、是否计入体行数（Trim 后非空且不以 `//` 开头）、行首偏移，
// 外加文件行数（`\n` 个数，末行无换行再 +1）。一次遍历全文字符数组算完，不 Split、不逐行建串。
// 此前每个方法都把整个文件重新 Split + 逐行剥字面量（剥法本身逐字符拼串），编 z42.core 时占约三成编译耗时。
internal sealed class LineIndex {
    public string Text;
    public int    Count;
    public int    Total;
    public int[]  Delta;
    public bool[] Counted;
    private int[] _starts;

    public LineIndex(string text) {
        this.Text = text;
        char[] cs = text.ToCharArray();
        int len = cs.Length;
        int n = 1;
        int k = 0;
        while (k < len) { if (cs[k] == '\n') { n = n + 1; } k = k + 1; }
        this.Count = n;
        this.Total = len > 0 && cs[len - 1] != '\n' ? n : n - 1;
        this.Delta = new int[n];
        this.Counted = new bool[n];
        this._starts = new int[n];
        int start = 0;
        int li = 0;
        while (li < n) {
            int end = start;
            while (end < len && cs[end] != '\n') { end = end + 1; }
            this._starts[li] = start;
            this.Delta[li] = LineIndex._braceDelta(cs, start, end);
            int s = start;
            while (s < end && cs[s].IsWhiteSpace()) { s = s + 1; }
            this.Counted[li] = s < end && !(cs[s] == '/' && s + 1 < end && cs[s + 1] == '/');
            start = end + 1;
            li = li + 1;
        }
    }

    // offset 所在行号（0 基）：行首偏移表上二分，取最后一个 start <= offset 的行。
    public int LineAt(int offset) {
        int lo = 0; int hi = this.Count - 1;
        while (lo < hi) {
            int mid = (lo + hi + 1) / 2;
            if (this._starts[mid] <= offset) { lo = mid; } else { hi = mid - 1; }
        }
        return lo;
    }

    // [from, to) 一行：跳过字符串 / 字符字面量，遇 `//` 截止，数其余位置的 `{` / `}`。
    private static int _braceDelta(char[] cs, int from, int to) {
        int d = 0; int i = from;
        while (i < to) {
            char c = cs[i];
            if (c == '/' && i + 1 < to && cs[i + 1] == '/') { break; }
            if (c == '"') {
                i = i + 1;
                while (i < to) {
                    if (cs[i] == '\\') { i = i + 2; continue; }
                    if (cs[i] == '"') { break; }
                    i = i + 1;
                }
                i = i + 1;
                continue;
            }
            if (c == '\'') {
                if (i + 2 < to && cs[i + 2] == '\'') { i = i + 3; continue; }
                if (i + 3 < to && cs[i + 1] == '\\' && cs[i + 3] == '\'') { i = i + 4; continue; }
            }
            if (c == '{') { d = d + 1; } else if (c == '}') { d = d - 1; }
            i = i + 1;
        }
        return d;
    }
}
