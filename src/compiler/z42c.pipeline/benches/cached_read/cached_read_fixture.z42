namespace CachedReadFixture;
using Std.IO;
using Z42.Core;
using Z42.Pipeline;
using Z42.Package;
using Z42.IR.BinaryFormat;
using Z42.Emission;

public sealed class CacheFixture {
    public string Root;
    public string Cache;
    public string[] Sources;
    public string[] Texts;
    public string[] Hashes;
    public string[] Expected;
    // Callers own the directory before construction, including failed setup.
    public CacheFixture(string root, int count) {
        string[] texts = new string[count]; int i = 0;
        while (i < count) {
            texts[i] = "namespace T; string Pick" + i.ToString()
                + "(int n) { if (n > 0) { return \"left\"; } return \"right\"; }\n";
            i = i + 1;
        }
        this._initialize(root, texts, false);
    }
    public CacheFixture(string root, string[] texts) { this._initialize(root, texts, true); }
    private void _initialize(string root, string[] texts, bool sharedPackage) {
        this.Root = root; this.Texts = texts;
        this.Cache = Path.Join(root, "cache"); Directory.Create(this.Cache);
        int count = texts.Length;
        this.Sources = new string[count]; this.Hashes = new string[count]; this.Expected = new string[count];
        int i = 0;
        while (i < count) {
            this.Sources[i] = Path.Join(root, "F" + i.ToString() + ".z42");
            this.Hashes[i] = ZpkgBuilder.SourceHashHex(texts[i]); i = i + 1;
        }
        CompiledModuleZ[] cms = new CompiledModuleZ[count];
        if (sharedPackage) { cms = IrDump.BuildPackage(texts, this.Sources, count, null, null, false); }
        else {
            i = 0;
            while (i < count) {
                cms[i] = IrDump.BuildModuleD(texts[i], this.Sources[i], null, null); i = i + 1;
            }
        }
        ZbcFileZ[] mods = new ZbcFileZ[count]; string[] zbcHashes = new string[count]; i = 0;
        while (i < count) {
            if (cms[i].ErrorCount != 0) { throw new Exception("cache fixture source failed: " + String.ConcatParts(cms[i].DiagMsgs, cms[i].DiagCount)); }
            mods[i] = new ZbcFileZ(this.Sources[i], this.Hashes[i], cms[i].Namespace, cms[i].Usings, cms[i].UsingCount, cms[i].Module);
            zbcHashes[i] = IncrementalCompilation.WriteCacheZbc(this.Cache, root, this.Sources[i], cms[i].Module);
            this.Expected[i] = Std.Hashing.Murmur3.Hash128Hex(ZbcWriter.Write(cms[i].Module).ToBytes()); i = i + 1;
        }
        IncrementalCompilation.WriteMetas(this.Cache, root, this.Sources, texts, this.Hashes, count,
            cms, mods, null, null, null, "fixture-deps", new LanguageFeatures(), null, zbcHashes);
    }
    public IncrPrep Read() {
        return IncrementalCompilation.Prepare(this.Sources, this.Sources, this.Texts, this.Hashes, this.Sources.Length,
            this.Root, this.Cache, "fixture-deps", false, new LanguageFeatures(), false);
    }
    public void Check(IncrPrep prep) {
        int i = 0;
        while (i < this.Sources.Length) {
            if (prep.Plan.Fresh[i] || prep.Cached[i] == null
                || Std.Hashing.Murmur3.Hash128Hex(ZbcWriter.Write(prep.Cached[i]).ToBytes()) != this.Expected[i]) {
                throw new Exception("restored cache differs at " + i.ToString());
            }
            i = i + 1;
        }
    }
    public string Rel(int i) { return IncrementalBuild.Rel(this.Root, this.Sources[i]); }
}
