// BuildSession 单测（add-build-session）：一次清单驱动的包编译。锁住 z42b 此前走不到的清单决策——
// [syntax] / [optimize] / pack / entry / strip——以及「消息只经 reporter、BuildSession 自己不打印」。
namespace Z42cPipelineBuildSessionTests;

using Std.IO;
using Z42.Pipeline;
using Z42.Project;
using Std.Harness;

string _tmpRoot() {
    string t = Environment.GetEnvironmentVariable("TMPDIR", "");
    if (t == "") { t = Environment.GetEnvironmentVariable("TEMP", ""); }
    if (t == "") { t = "/tmp"; }
    return Path.Join(t, "z42c-buildsession-tests");
}

// 造工程夹具：<tmp>/<name>/{z42.toml, src/<file>}（清单缺省 include = `src/**/*.z42`）；返回工程目录。
string _mkProj(string name, string toml, string file, string src) {
    string dir = Path.Join(_tmpRoot(), name);
    if (Directory.Exists(dir)) { Directory.Delete(dir, true); }
    Directory.Create(dir);
    File.WriteAllText(Path.Join(dir, "z42.toml"), toml);
    Directory.Create(Path.Join(dir, "src"));
    File.WriteAllText(Path.Join(dir, Path.Join("src", file)), src);
    return dir;
}

BuildResult _run(string dir, bool release, CollectingReporter rep) {
    ProjectManifest pm = ManifestLoader.Load(Path.Join(dir, "z42.toml"));
    BuildOptions o = new BuildOptions(pm, dir, BuildRole.HostTarget, release, rep);
    o.OutputZpkg = Path.Join(dir, "out/app.zpkg");
    return new BuildSession(o).Run();
}

string _hdr(string name, string kind) {
    return "[project]\nname = \"" + name + "\"\nversion = \"0.1.0\"\nkind = \"" + kind + "\"\n";
}

[Test]
void test_plain_lib_builds() {
    string dir = _mkProj("plain", _hdr("bs.plain", "lib"), "lib.z42", "int Helper() { return 1; }\n");
    CollectingReporter rep = new CollectingReporter();
    BuildResult r = _run(dir, false, rep);
    Assert.Equal("", rep.ErrorsText());
    Assert.Equal(BuildExit.Ok, r.Code);
    Assert.Equal(true, File.Exists(r.OutZpkg));
    Assert.Equal("", r.OutZsym);   // debug：不剥、无 sidecar
}

// [syntax] 关掉的特性必须报 E0301（此前 z42b 路径静默忽略 [syntax]）。
[Test]
void test_syntax_section_takes_effect() {
    string toml = _hdr("bs.syntax", "lib") + "\n[syntax]\nternary = false\n";
    string dir = _mkProj("syntax", toml, "lib.z42", "int Pick(bool b) { return b ? 1 : 2; }\n");
    CollectingReporter rep = new CollectingReporter();
    BuildResult r = _run(dir, false, rep);
    Assert.Equal(BuildExit.BuildError, r.Code);
    Assert.Equal(true, rep.ErrorsText().Contains("E0301"));
}

// [optimize] 未知名 = 用法错误，不开编（与 CLI `--opt 乱写` 同口径）。
[Test]
void test_unknown_optimize_name_is_usage_error() {
    string toml = _hdr("bs.opt", "lib") + "\n[optimize]\nno-such-pass = true\n";
    string dir = _mkProj("opt", toml, "lib.z42", "int Helper() { return 1; }\n");
    CollectingReporter rep = new CollectingReporter();
    BuildResult r = _run(dir, false, rep);
    Assert.Equal(BuildExit.UsageError, r.Code);
    Assert.Equal(true, rep.ErrorsText().Contains("unknown optimization `no-such-pass`"));
}

// `kind` 写错 = 用法错误（此前静默当成 lib 编完）。
[Test]
void test_unknown_kind_is_usage_error() {
    string dir = _mkProj("kind", _hdr("bs.kind", "exx"), "lib.z42", "int Helper() { return 1; }\n");
    CollectingReporter rep = new CollectingReporter();
    BuildResult r = _run(dir, false, rep);
    Assert.Equal(BuildExit.UsageError, r.Code);
    Assert.Equal(true, rep.ErrorsText().Contains("unknown kind \"exx\""));
}

// 本路径只产 packed ⇒ 显式 `pack = false` 是用法错误（而非悄悄出一个 packed）。
[Test]
void test_pack_false_rejected_on_packed_only_path() {
    string toml = "[project]\nname = \"bs.pack\"\nversion = \"0.1.0\"\nkind = \"lib\"\npack = false\n";
    string dir = _mkProj("pack", toml, "lib.z42", "int Helper() { return 1; }\n");
    CollectingReporter rep = new CollectingReporter();
    BuildResult r = _run(dir, false, rep);
    Assert.Equal(BuildExit.UsageError, r.Code);
    Assert.Equal(true, rep.ErrorsText().Contains("pack=false"));
}

// `[project] entry` 不是清单键：z42b 路径与 `z42c build` 同一份键审计，当场报错并说清怎么改（不静默忽略）。
[Test]
void test_manifest_entry_rejected() {
    string toml = "[project]\nname = \"bs.entry\"\nversion = \"0.1.0\"\nkind = \"exe\"\nentry = \"App.Start\"\n";
    string dir = _mkProj("entry", toml, "app.z42",
        "namespace App;\nvoid Main() { }\n");
    CollectingReporter rep = new CollectingReporter();
    BuildResult r = _run(dir, false, rep);
    Assert.Equal(true, r.Code != BuildExit.Ok);
    Assert.Equal(true, rep.ErrorsText().Contains("[project] `entry` is not a manifest key"));
}

// release ⇒ strip：主包剥 DBUG、旁挂 .zsym（此前 z42b 写死 strip=false）。
[Test]
void test_release_strips_with_sidecar() {
    string dir = _mkProj("strip", _hdr("bs.strip", "lib"), "lib.z42", "int Helper() { return 1; }\n");
    CollectingReporter rep = new CollectingReporter();
    BuildResult r = _run(dir, true, rep);
    Assert.Equal("", rep.ErrorsText());
    Assert.Equal(BuildExit.Ok, r.Code);
    Assert.Equal(true, r.OutZsym != "");
    Assert.Equal(true, File.Exists(r.OutZsym));
}

// 声明了却找不到的依赖：失败且点名（与 `z42c build` 同一核验）。
[Test]
void test_missing_declared_dep_reported() {
    string toml = _hdr("bs.dep", "lib") + "\n[dependencies]\n\"no.such.pkg\" = \"0.1.0\"\n";
    string dir = _mkProj("dep", toml, "lib.z42", "int Helper() { return 1; }\n");
    CollectingReporter rep = new CollectingReporter();
    BuildResult r = _run(dir, false, rep);
    Assert.Equal(true, r.Code != BuildExit.Ok);
    Assert.Equal(true, rep.ErrorsText().Contains("no.such.pkg"));
}

// ── CompilerDomain 探测序：开发树（自 Z42_LIBS 上溯）排在 SDK 变量之前 ─────────────────────────────
// xtask 经 SDK apphost 启动，`Z42_PORTABLE_VM` 被每个子进程继承；开发树里跑的 driver / z42b 的编译器目录
// 必须是本树的 driver dist，而不是那份 SDK 的 `programs/z42c/`（否则按名声明的编译器包对着上一版解析）。

string _mkDir(string path) {
    Directory.Create(path);
    return path;
}

void _setEnv(string k, string v) {
    if (v == "") { Environment.UnsetEnvironmentVariable(k); } else { Environment.SetEnvironmentVariable(k, v); }
}

// 在给定的三个变量下取 Dirs()，取完还原（TestRunner 顺序执行，进程环境改动不会漏到并发的用例）。
string[] _domainWith(string libs, string home, string portableVm) {
    string oldLibs = Environment.GetEnvironmentVariable("Z42_LIBS", "");
    string oldHome = Environment.GetEnvironmentVariable("Z42_HOME", "");
    string oldPv = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM", "");
    _setEnv("Z42_LIBS", libs);
    _setEnv("Z42_HOME", home);
    _setEnv("Z42_PORTABLE_VM", portableVm);
    string[] r = CompilerDomain.Dirs();
    _setEnv("Z42_LIBS", oldLibs);
    _setEnv("Z42_HOME", oldHome);
    _setEnv("Z42_PORTABLE_VM", oldPv);
    return r;
}

string _cdRoot() {
    string root = Path.Join(_tmpRoot(), "compiler-domain");
    if (Directory.Exists(root)) { Directory.Delete(root, true); }
    return root;
}

[Test]
void test_compiler_domain_dev_tree_before_inherited_sdk() {
    string root = _cdRoot();
    string art = Path.Join(root, "tree", "artifacts");
    string dev = _mkDir(Path.Join(art, "build", "compiler", "z42c.driver", "release", "dist"));
    string libs = _mkDir(Path.Join(art, "libs"));
    string home = _mkDir(Path.Join(root, "home", "programs", "z42c"));
    string seed = _mkDir(Path.Join(root, "seed", "programs", "z42c"));
    string[] d = _domainWith(libs, Path.Join(root, "home"), Path.Join(root, "seed", "bin", "z42vm"));
    Assert.Equal(3, d.Length);
    Assert.Equal(dev, d[0]);
    Assert.Equal(home, d[1]);
    Assert.Equal(seed, d[2]);
}

[Test]
void test_compiler_domain_sdk_libs_skip_dev_tree() {
    string root = _cdRoot();
    string libs = _mkDir(Path.Join(root, "sdk", "libs"));
    string sdk = _mkDir(Path.Join(root, "sdk", "programs", "z42c"));
    string[] d = _domainWith(libs, "", Path.Join(root, "sdk", "bin", "z42vm"));
    Assert.Equal(1, d.Length);
    Assert.Equal(sdk, d[0]);
}
