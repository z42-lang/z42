namespace CompilerContractBoundaryTests;
using Std.IO;
using Std.Harness;
using Z42.Build;
using Z42.Project;

[Test]
void test_dynamic_compiler_contract_invokes_real_compile() {
    ICompiler compiler = ModuleLoader.Create("Z42.Pipeline.Z42cCompiler") as ICompiler;
    Assert.True(compiler != null);
    string dir = File.CreateTempDir("compiler-contract-boundary");
    try {
        File.WriteAllText(Path.Join(dir, "source.z42"), "public int Answer() { return 7; }\n");
        string output = Path.Join(dir, "compiled.zpkg");
        var req = new CompileRequest(dir, output, new string[0], "debug", false, true, "lib", new string[0], 0);
        req.Manifest = ManifestLoader.ParseText("[project]\nname=\"contract.boundary\"\nversion=\"0.1.0\"\nkind=\"lib\"\n[sources]\ninclude=[\"source.z42\"]\n");
        CompileResult result = compiler.Compile(req);
        Assert.True(result.Ok); Assert.Equal("", result.Diagnostics);
        Assert.Equal(output, result.Zpkg); Assert.True(File.Exists(output));
    } finally { Directory.Delete(dir, true); }
}

[Test]
void test_dynamic_repl_contract_invokes_real_round() {
    IReplCompiler compiler = ModuleLoader.Create("Z42.Pipeline.Z42cReplCompiler") as IReplCompiler;
    Assert.True(compiler != null);
    string[] dirs = new string[] { Environment.GetEnvironmentVariable("Z42_LIBS", "") };
    object world = compiler.CreateWorld(dirs, dirs.Length, new string[0], 0);
    Assert.True(world != null);
    ReplCompileResult round = compiler.CompileRound(world, "ContractRound", "public int Answer() { return 7; }", new string[0], 0);
    Assert.Equal(0, round.ErrorCount); Assert.True(round.Bytes.Length > 0);
    compiler.ExtendWorld(world, round.Bytes, "ContractRound");
    Assert.True(compiler.NamespaceNames(world) != null);
}
