// 关联类型的跨包行为（assoc-type-crosspkg，zbc 1.42 已打通跨包 wire 承载）。
//
// 正例：接口关联类型名单（`type Item;`）+ 类侧绑定（`type Item = int;`）现由 zbc TYPE 统一 assoc 块
// 跨包承载、约束绑定（`where T:IEnum<Item=int>`）由约束 bundle bit7 承载。删三处 IsImported 守卫后，
// 跨包关联类型**真正被校验**：IntBag 绑 Item=int、Holder 约束要求 int ⇒ 正确匹配放行 + 运行 7/9/11。
// 错绑定的判别力见姊妹负例 `assoc_type_cross_pkg_mismatch`（StrBag 绑 string → E0453）。
namespace DemoATarget;

public interface IEnum { type Item; }

public class IntBag : IEnum {
    type Item = int;
    public int v;
    public IntBag(int v0) { this.v = v0; }
    public int Get() { return this.v; }
}
