namespace Demo.CsApp;

using Std.IO;
using Demo.CsTarget;

// fix-call-arity-skew：sealed 类的实例方法被**去虚化成直接 Call**（走 method_tokens / cross_cell，不走 VCall）解析到了、但签名容不下实参时不再照常调用。
void Main() {
    Box b = new Box(7);
    try {
        Console.WriteLine("label " + b.Label());
    } catch (MissingSymbolException e) {
        Console.WriteLine("caught MissingSymbolException");
    }
    Console.WriteLine("after");
}
