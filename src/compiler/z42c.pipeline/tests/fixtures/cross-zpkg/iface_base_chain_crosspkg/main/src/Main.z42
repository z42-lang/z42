// 消费方：经**导入的接口静态类型**调用继承来的成员。
//
// `l.Tag()` 隔着两层继承（`ILeaf` → `IMid<int>` → `IBase`）—— 导入侧没恢复出父接口链时这一行
// 是 E0401。`l.Get()` 走一层**泛型**父接口：型参没按 `IMid<int>` 的实参代换的话，返回的是裸
// `T`，`+ 1` 立刻 E0402（这正是「跨包 BaseRefs 有没有带上实参」的判别点）。
namespace Demo.IfChainApp;

using Std.IO;
using Demo.IfChain;

void Main() {
    ILeaf l = new Leaf(5);
    Console.WriteLine(l.Twice().ToString());       // 自有成员
    Console.WriteLine((l.Get() + 1).ToString());   // 继承自 IMid<int>：返回位须是 int，不是 T
    Console.WriteLine(l.Tag().ToString());         // 继承自 IBase（隔两层）

    // 中间层的静态类型上同样成立（这里 `IMid<int>` 是**写出来的**实例化接口）。
    IMid<int> m = new Leaf(9);
    Console.WriteLine(m.Get().ToString());
    Console.WriteLine(m.Tag().ToString());
}
