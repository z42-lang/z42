// 跨包初始化顺序 = **实际加载顺序**（User 裁决 2026-09-22），不排序、不预扫、
// 与清单里的依赖声明顺序无关（清单里 A 在 B 前，实际先跑的是 B）。
//
// 每个包在**首次被用到**时才加载（运行期按引用表精确加载定义 `Pong` / `Ping` 的那一个包），
// 它的 init 随之在那一刻跑：B 的 init 夹在 `start` 与 `Pong` 的结果之间，A 的 init 夹在
// `Pong` 与 `Ping` 的结果之间。
namespace Demo.OrderApp;

using Std.IO;
using Demo.OrderA;
using Demo.OrderB;

void Main() {
    Console.WriteLine("start");
    Console.WriteLine(Pong(1).ToString());   // 先触达 B
    Console.WriteLine(Ping(1).ToString());   // 后触达 A
}
