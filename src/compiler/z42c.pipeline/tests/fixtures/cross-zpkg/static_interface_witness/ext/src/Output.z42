namespace Demo.WitnessImpl;

using Demo.WitnessContract;
using Std.IO;

public struct Seven : IRefWriter {
    public static int Create() { return 7; }
    public static void Write(int value) { Console.WriteLine(value); }
    public static void Write(string value) { Console.WriteLine("wrong overload"); }
    public static void Update(int value) { Console.WriteLine("wrong value overload"); }
    public static void Update(ref int value) { value = value + 50; }
}

public class Nine : IWriter {
    static Nine() { Console.WriteLine("init"); }
    public static int Create() { return 9; }
    public static void Write(int value) { Console.WriteLine(value); }
}

public class ReferenceWriter : IReferenceWriter {
    public int Value;

    public ReferenceWriter(int value) { this.Value = value; }
    public static ReferenceWriter Create() { return new ReferenceWriter(36); }
    public static void Replace(ref ReferenceWriter value) { value = new ReferenceWriter(value.Value + 10); }
    public static void Write(ReferenceWriter value) { Console.WriteLine(value.Value); }
    public static void Write(string value) { Console.WriteLine("wrong Self overload"); }
}

public class BlobWriter : IBlobWriter {
    public static Payload Create() { return new Payload(41, "original"); }

    public static void Write(Payload value) {
        value.Number = value.Number + 1;
        Console.WriteLine(value.Number);
        Console.WriteLine(value.Label);
        value.Label = "changed";
    }

    public static void Write(int value) { Console.WriteLine("wrong Payload overload"); }
}

public struct SelfPoint : ISelfWriter {
    public int X;
    public int Y;
    public SelfPoint(int x, int y) { this.X = x; this.Y = y; }
    public static void Write(SelfPoint value) {
        value.X = value.X + 1;
        Console.WriteLine(value.X + value.Y);
    }
}

public struct SelfPacket : ISelfWriter {
    public long Prefix;
    public string Label;
    public int Count;
    public SelfPacket(long prefix, string label, int count) {
        this.Prefix = prefix;
        this.Label = label;
        this.Count = count;
    }
    public static void Write(SelfPacket value) {
        Console.WriteLine(value.Label);
        value.Label = "changed";
        value.Count = value.Count + 1;
        Console.WriteLine(value.Prefix + value.Count);
    }
}
