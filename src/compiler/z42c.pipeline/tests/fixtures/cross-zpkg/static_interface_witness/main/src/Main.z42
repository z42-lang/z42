namespace Demo.WitnessApp;

using Demo.WitnessImpl;
using Std.IO;

void Main() {
    Demo.WitnessContract.Forward<Seven>();
    Demo.WitnessContract.Dispatch<Nine>();
    Demo.WitnessLocal.DispatchLocal();
    ReferenceWriter value = Demo.WitnessContract.ForwardSelf(new ReferenceWriter(27));
    Console.WriteLine(value.Value + 1);
    Demo.WitnessContract.Payload payload = Demo.WitnessContract.ForwardBlob<BlobWriter>();
    Console.WriteLine(payload.Number);
    Console.WriteLine(payload.Label);
    Console.WriteLine(Demo.WitnessContract.ForwardUpdate<Seven>(4));
    Console.WriteLine(Demo.WitnessContract.ReplaceSelf(value).Value);
    SelfPoint point = new SelfPoint(3, 4);
    Demo.WitnessContract.ForwardValueSelf(point);
    Console.WriteLine(point.X);
    SelfPacket packet = new SelfPacket(20L, "packet", 5);
    Demo.WitnessContract.ForwardValueSelf(packet);
    Console.WriteLine(packet.Count);
    Console.WriteLine(packet.Label);
    SelfPoint createdPoint = Demo.WitnessContract.ForwardCreateValueSelf<SelfPoint>();
    SelfPacket createdPacket = Demo.WitnessContract.ForwardCreateValueSelf<SelfPacket>();
    GC.Collect();
    Console.WriteLine(createdPoint.X + createdPoint.Y);
    Console.WriteLine(createdPacket.Count);
    Console.WriteLine(createdPacket.Label);
    try {
        Demo.WitnessContract.ForwardCreateValueSelf<FailingSelfFactory>();
    } catch (InvalidOperationException error) {
        Console.WriteLine(error.Message);
    }
}
