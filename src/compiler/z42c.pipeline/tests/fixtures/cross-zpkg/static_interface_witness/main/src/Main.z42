namespace Demo.WitnessApp;

using Demo.WitnessImpl;
using Std.IO;

void Main() {
    Demo.WitnessContract.Forward<Seven>();
    Demo.WitnessContract.Dispatch<Nine>();
    Demo.WitnessLocal.DispatchLocal();
    ReferenceWriter value = Demo.WitnessContract.ForwardSelf(new ReferenceWriter(27));
    Console.WriteLine(value.Value + 1);
    Demo.WitnessContract.Payload payload = Demo.WitnessContract.ForwardBlob<BlobWriter>();
    Console.WriteLine(payload.Number);
    Console.WriteLine(payload.Label);
    Console.WriteLine(Demo.WitnessContract.ForwardUpdate<Seven>(4));
    Console.WriteLine(Demo.WitnessContract.ReplaceSelf(value).Value);
}
