namespace Demo.WitnessContract;

public interface IWriter {
    static int Create();
    static void Write(int value);
}

public void Dispatch<T>() where T : IWriter {
    T.Write(T.Create());
}

public void Forward<T>() where T : IWriter {
    Dispatch<T>();
}

public interface IReferenceWriter {
    static Self Create();
    static void Write(Self value);
    static void Replace(ref Self value);
}

public T DispatchSelf<T>(T seed) where T : class + IReferenceWriter {
    T.Write(seed);
    T result = T.Create();
    T.Write(result);
    return result;
}

public U ForwardSelf<U>(U seed) where U : class + IReferenceWriter {
    return DispatchSelf(seed);
}

public struct Payload {
    public int Number;
    public string Label;

    public Payload(int number, string label) {
        this.Number = number;
        this.Label = label;
    }
}

public interface IBlobWriter {
    static Payload Create();
    static void Write(Payload value);
}

public Payload DispatchBlob<T>() where T : IBlobWriter {
    Payload value = T.Create();
    T.Write(value);
    return value;
}

public Payload ForwardBlob<T>() where T : IBlobWriter {
    return DispatchBlob<T>();
}

public interface IRefWriter : IWriter {
    static void Update(ref int value);
}

public int UpdateValue<T>(int seed) where T : IRefWriter {
    T.Write(T.Create());
    T.Update(ref seed);
    return seed;
}

public int ForwardUpdate<T>(int seed) where T : IRefWriter {
    return UpdateValue<T>(seed);
}

public T ReplaceSelf<T>(T seed) where T : class + IReferenceWriter {
    T.Replace(ref seed);
    return seed;
}

public interface ISelfWriter {
    static void Write(Self value);
}

public void WriteValueSelf<T>(T value) where T : struct + ISelfWriter {
    T.Write(value);
    T.Write(value);
}

public void ForwardValueSelf<T>(T value) where T : struct + ISelfWriter {
    WriteValueSelf(value);
}
