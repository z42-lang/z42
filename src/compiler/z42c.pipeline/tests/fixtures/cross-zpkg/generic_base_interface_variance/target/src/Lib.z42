namespace GenericBaseVariance;

public class Cat {}
public class Crate<A,B> {}
public class Mid<A,B> : Crate<B,A> {}
public class Leaf<X> : Mid<int,X> {}
public class Fixed : Crate<Cat,int> {}

public interface ISource<T> { T Read(); }
public interface ISink<T> { string Put(T value); }

public class Source : ISource<Leaf<Cat>> {
    public Leaf<Cat> Read() { return new Leaf<Cat>(); }
}

public class Sink : ISink<Crate<Cat,int>>, ISink<Leaf<Cat>> {
    public string Put(Crate<Cat,int> value) { return "base"; }
    public string Put(Leaf<Cat> value) { return "leaf"; }
}

public class FixedSource : ISource<Fixed> {
    public Fixed Read() { return new Fixed(); }
}
