namespace Demo.NestLayoutApp;

using Std.IO;
using Demo.NestLayoutTarget;
using Demo.NestLayoutExt;

void Main() {
    // 导入 struct 内嵌导入 12B struct：读（修复前 b.x 读到 a.z 附近 → 3）
    Seg s = new Seg(new Point3(1, 2, 3), new Point3(4, 5, 6), 7L);
    Console.WriteLine(s.b.x);         // 4
    Console.WriteLine(s.b.z);         // 6
    Console.WriteLine(s.tag);         // 7
    // 写穿嵌套字段，兄弟字段不被踩
    s.b.y = 50;
    Console.WriteLine(s.b.y);         // 50
    Console.WriteLine(s.a.z);         // 3
    Console.WriteLine(s.tag);         // 7
    // 整字段读出 = 值副本
    Point3 p = s.a;
    p.x = 99;
    Console.WriteLine(s.a.x);         // 1
    // transitive：ext.Frame 内嵌 target.Point3（修复前 w/h 错位 → 9 / 10）
    Frame f = new Frame(new Point3(7, 8, 9), 10, 11);
    Console.WriteLine(f.origin.z);    // 9
    Console.WriteLine(f.w);           // 10
    Console.WriteLine(f.h);           // 11
    Console.WriteLine(f.Area());      // 110  跨包方法按生产方布局读
    // 跨包泛型 struct 套 struct 的链式读写
    Pair<Point3, string> pr = new Pair<Point3, string>(new Point3(21, 22, 23), "s");
    Console.WriteLine(pr.First.z);    // 23
    pr.First.y = 220;
    Console.WriteLine(pr.First.y);    // 220
    Console.WriteLine(pr.Second);     // s

    CheckImportedEquals();
    CheckImportedUnboxLayout();
}

void CheckImportedUnboxLayout() {
    object boxed = BoxIntPair();
    Pair<int, int> value = (Pair<int, int>)boxed;
    Assert.Equal(-7, value.First);
    Assert.Equal(42, value.Second);
    value.First = 5;
    Assert.Equal(-7, ((Pair<int, int>)boxed).First);
    Assert.Equal(42, ((Pair<int, int>)boxed).Second);
    Assert.Equal(typeof(Pair<int, int>), boxed.GetType());
    if (boxed is Pair<int, int> matched) {
        Assert.Equal(-7, matched.First);
    } else {
        Assert.True(false);
    }
    bool rejected = false;
    try { Pair<long, long> wrong = (Pair<long, long>)boxed; }
    catch (InvalidCastException) { rejected = true; }
    Assert.True(rejected);

    Pair<Point3, long> nested = (Pair<Point3, long>)BoxNestedPair();
    Assert.Equal(3, nested.First.z);
    Assert.Equal(4294967297L, nested.Second);
}

void CheckImportedEquals() {
    Pair<int, int> ints = new Pair<int, int>(-7, 42);
    object consumerInts = ints;
    object producerInts = BoxIntPair();
    Assert.Equal(consumerInts.GetType(), producerInts.GetType());
    Assert.True(consumerInts.Equals(producerInts));
    Assert.True(producerInts.Equals(consumerInts));
    Assert.Equal(consumerInts.GetHashCode(), producerInts.GetHashCode());
    Assert.Equal(ints.GetHashCode(), producerInts.GetHashCode());
    object differentInts = new Pair<int, int>(-7, 43);
    Assert.False(producerInts.Equals(differentInts));
    Assert.True(producerInts.GetHashCode() != differentInts.GetHashCode());

    object producerNested = BoxNestedPair();
    object consumerNested = new Pair<Point3, long>(new Point3(1, 2, 3), 4294967297L);
    Assert.True(producerNested.Equals(consumerNested));
    Assert.True(consumerNested.Equals(producerNested));
    Assert.Equal(producerNested.GetHashCode(), consumerNested.GetHashCode());

    object producerFloat = BoxFloatPair();
    object consumerFloat = new Pair<float, int>(0.0f, 42);
    Assert.True(producerFloat.Equals(consumerFloat));
    Assert.True(consumerFloat.Equals(producerFloat));
    Assert.Equal(producerFloat.GetHashCode(), consumerFloat.GetHashCode());

    Pair<string, string> direct = new Pair<string, string>("a", "b");
    object producerBox = BoxStringPair();
    object consumerBox = direct;
    Assert.True(consumerBox.Equals(producerBox));
    Assert.True(direct.Equals((Pair<string, string>)producerBox));

    FloatCell<int> value = new FloatCell<int>(1, 0.0f);
    object same = new FloatCell<int>(1, -0.0f);
    object differentValue = new FloatCell<int>(1, 1.0f);
    object differentType = new FloatCell<long>(1L, 0.0f);
    object boxed = value;
    Assert.True(value.Equals(same));
    Assert.True(boxed.Equals(same));
    Assert.False(value.Equals(differentValue));
    Assert.False(boxed.Equals(differentValue));
    Assert.False(value.Equals(differentType));
    Assert.False(boxed.Equals(differentType));

    CustomCell<int> custom = new CustomCell<int>(1, 0.0f);
    object boxedCustom = custom;
    Assert.True(custom.Equals(differentType));
    Assert.True(boxedCustom.Equals(differentType));
    Assert.Equal(913, custom.GetHashCode());
    Assert.Equal(913, boxedCustom.GetHashCode());
}
