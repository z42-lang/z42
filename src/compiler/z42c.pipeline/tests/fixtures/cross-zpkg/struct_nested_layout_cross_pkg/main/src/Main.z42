namespace Demo.NestLayoutApp;

using Std.IO;
using Demo.NestLayoutTarget;
using Demo.NestLayoutExt;

void Main() {
    // 导入 struct 内嵌导入 12B struct：读（修复前 b.x 读到 a.z 附近 → 3）
    Seg s = new Seg(new Point3(1, 2, 3), new Point3(4, 5, 6), 7L);
    Console.WriteLine(s.b.x);         // 4
    Console.WriteLine(s.b.z);         // 6
    Console.WriteLine(s.tag);         // 7
    // 写穿嵌套字段，兄弟字段不被踩
    s.b.y = 50;
    Console.WriteLine(s.b.y);         // 50
    Console.WriteLine(s.a.z);         // 3
    Console.WriteLine(s.tag);         // 7
    // 整字段读出 = 值副本
    Point3 p = s.a;
    p.x = 99;
    Console.WriteLine(s.a.x);         // 1
    // transitive：ext.Frame 内嵌 target.Point3（修复前 w/h 错位 → 9 / 10）
    Frame f = new Frame(new Point3(7, 8, 9), 10, 11);
    Console.WriteLine(f.origin.z);    // 9
    Console.WriteLine(f.w);           // 10
    Console.WriteLine(f.h);           // 11
    Console.WriteLine(f.Area());      // 110  跨包方法按生产方布局读
    // 跨包泛型 struct 套 struct 的链式读写
    Pair<Point3, string> pr = new Pair<Point3, string>(new Point3(21, 22, 23), "s");
    Console.WriteLine(pr.First.z);    // 23
    pr.First.y = 220;
    Console.WriteLine(pr.First.y);    // 220
    Console.WriteLine(pr.Second);     // s
}
