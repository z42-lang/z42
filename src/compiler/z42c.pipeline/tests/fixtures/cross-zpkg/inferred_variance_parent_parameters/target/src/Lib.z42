namespace PerParameterVariance;

public class Animal {}
public class Cat : Animal {}
public interface IContext<C> { C Context(); }
public interface ISink<C,T> : IContext<C> { string Put(T value); }
public class DualSink : ISink<int,Animal>, ISink<int,Cat> {
    public int Context() { return 42; }
    public string Put(Animal value) { return "animal"; }
    public string Put(Cat value) { return "cat"; }
}
