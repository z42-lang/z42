namespace DemoInfer;

public interface IValue<T> {}
public interface IChild<T> : IValue<T> {}
public class Closed : IChild<string> {}
public class Open<T> : IValue<T[]> {}
public class Both : IValue<string>, IValue<int> {}

public class Base<T> : IValue<T> {}
public class Middle<U> : Base<U[]> {}
public class Leaf<V> : Middle<V> {}
public class Fixed : Leaf<int> {}

public class Pair<A, B> {}
public class Scoped<U> : Base<Pair<U, DemoInferArgs.Marker>[]> {}

public interface IStored<T> {
    T Read();
    void Write(T value);
    int Tag();
}

public class Storage<T> : IStored<T> {
    public T Value;
    public T[] Items;
    public DemoInferArgs.T Qualified;
    public virtual T Read() { return this.Value; }
    public void Write(T value) { this.Value = value; }
    public virtual int Tag() { return 1; }
    public Type Argument() { return typeof(T); }
}

public class Forward<U> : Storage<U> {
    public int Middle;
}

public class Relay<V> : Forward<V> {}
