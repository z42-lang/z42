namespace ImportedGenericIface;

public interface IEcho {
    T Echo<T>(T value);
    T Bounded<T>(T value) where T : struct;
}

public class Echoer : IEcho {
    public T Echo<T>(T value) { return value; }
    public T Bounded<T>(T value) where T : struct { return value; }
}

public interface IPair<X> {
    B Pick<A, B>(X outer, A first, B second);
}

public class IntPair : IPair<int> {
    public B Pick<A, B>(int outer, A first, B second) { return second; }
}
