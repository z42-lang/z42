namespace Demo.StructApp;

using Demo.StructTarget;
using Demo.StructExt;

// 跨包传参 copy-in：修改副本不动原值。
int Bump(Point p) { p.x = p.x + 100; return p.x; }

void Main() {
    Point p = new Point(1, 2);
    Assert.Equal(1, p.x);
    Assert.Equal(3, p.Sum());          // 跨包 struct 方法
    p.x = 5;
    Assert.Equal(5, p.x);
    Point q = p;                       // 值复制
    q.x = 42;
    Assert.Equal(5, p.x);             // q 改动不动 p
    Assert.Equal(42, q.x);
    Assert.Equal(105, Bump(p));       // 副本 5+100
    Assert.Equal(5, p.x);             // Bump 不动 p
    Line line = new Line(new Point(1, 2), new Point(3, 4));
    Assert.Equal(1, line.a.x);        // 嵌套
    Assert.Equal(4, line.b.y);
    line.a.x = 100;
    Assert.Equal(100, line.a.x);
    Assert.Equal(3, line.b.x);        // 兄弟字段独立
    // transitive：ext.Rect 内嵌 imported target.Point
    Rect rc = new Rect(new Point(7, 8), 3, 4);
    Assert.Equal(7, rc.origin.x);     // 跨包 struct 内嵌 imported struct 字段
    Assert.Equal(3, rc.w);
    Assert.Equal(12, rc.Area());
}
