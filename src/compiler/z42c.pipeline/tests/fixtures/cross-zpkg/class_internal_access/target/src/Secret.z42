// enforce-crosspkg-internal-class ②：生产方 A 定义 internal 类（跨包不可引用）+ public 类（可引用）。
// 消费方 B（main/src/Main.z42）引用 Secret → 期望 E0404 `from another package`；引用 Api → 放行。
namespace Demo.AclIntTarget;

// 无修饰符顶层类 → 默认 internal（封闭层 = 模块）。跨包引用应被拒。
class Secret {
    public int V() { return 42; }
}

// 显式 internal，语义同上。
internal class SecretExplicit {
    public int W() { return 7; }
}

// public 顶层类 → 跨包引用放行（对照组）。
public class Api {
    public int Ok() { return 1; }
}
