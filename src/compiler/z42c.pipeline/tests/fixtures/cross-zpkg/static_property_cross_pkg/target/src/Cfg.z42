namespace Sp.Base;
using Std;

// add-static-properties：静态属性的访问器此前从不进 TSIG 的 static 方法段 ⇒ 导入侧看不到。
// 带静态 ctor：主包对 Cfg 的第一次使用是读属性 = 调静态访问器。fix-crosspkg-static-call-cctor 之前
// 这一形态下依赖包的静态 ctor 不执行（连带注入其体首的 `Level = 2` 初始化器），#643 时只能不写静态 ctor 绕开。
public class Cfg {
    public static int Level { get; set; } = 2;
    public static string Name => "cfg";
    public static int Ro { get; }
    static Cfg() { Ro = 8; }
}
