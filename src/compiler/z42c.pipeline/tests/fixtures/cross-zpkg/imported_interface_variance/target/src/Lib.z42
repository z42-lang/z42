namespace DemoVarianceTarget;

public class Animal {}
public class Cat : Animal {}
public interface ISink<T> { string Put(T value); }

public class DualSink : ISink<Animal>, ISink<Cat> {
    public string Put(Animal value) { return "animal"; }
    public string Put(Cat value) { return "cat"; }
}

public interface IMap<TIn,TOut> { TOut Apply(TIn value); }

public class DualMap : IMap<Animal,Cat>, IMap<Cat,Animal> {
    public Cat Apply(Animal value) { return new Cat(); }
    public Animal Apply(Cat value) { return new Animal(); }
}

public class Delivery {
    public static string Deliver(ISink<Cat> sink, int marker = 7) {
        return marker == 7 ? sink.Put(new Cat()) : "wrong default";
    }
}
