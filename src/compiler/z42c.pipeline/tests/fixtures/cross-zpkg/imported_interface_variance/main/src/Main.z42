namespace DemoVarianceApp;

using Std;
using Std.IO;
using DemoVarianceTarget;

void Main() {
    DualSink dual = new DualSink();
    ISink<Animal> source = dual;
    ISink<Cat> converted = source;
    Console.WriteLine(converted.Put(new Cat()));
    Console.WriteLine(Delivery.Deliver(sink: source));
    Console.WriteLine(VarianceOverloads.Choose(source));
    Console.WriteLine(VarianceOverloads.Choose(wanted: converted));
    Console.WriteLine(ChooseFree(source));
    Console.WriteLine(ChooseFree(wanted: converted));

    DualMap dualMap = new DualMap();
    IMap<Animal,Cat> map = dualMap;
    IMap<Cat,Animal> exact = dualMap;
    IMap<Cat,Animal> projected = map;
    Console.WriteLine(exact.Apply(new Cat()) is Cat ? "cat" : "animal");
    Console.WriteLine(projected.Apply(new Cat()) is Cat ? "cat" : "animal");

    object boxed = dual;
    Assert.True(boxed is ISink<Animal>);
    Assert.True(boxed is ISink<Cat>);
    Assert.False(boxed is ISink<string>);
    Assert.False(typeof(ISink<string>).IsAssignableFrom(boxed.GetType()));
    Assert.Equal(2, boxed.GetType().GetInterfaces().Length);
    var targets = new ISink<string>[1];
    Assert.Throws("InvalidCastException", () => targets.SetValue(boxed, 0));
}
