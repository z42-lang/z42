namespace ProbeB;
using Std.IO;
using A;   // using-csharp-rules：限定名也得 using（规则 4）；两边都 using 后裸名 Foo 歧义，限定名照样消歧
using B;
void Main() {
    object y = new B.Foo(2);
    Console.WriteLine(y.GetType().FullName);
    Console.WriteLine((y is A.Foo).ToString());
    Console.WriteLine((y is B.Foo).ToString());
}
