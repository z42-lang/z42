namespace Z42cPipelinePkgCompileTests;

using Std.Harness;
using Z42.IR;
using Z42.Package;
using Z42.Pipeline;
using Z42.Symbols;

[Test]
void test_inferred_interface_variance_survives_packed_package() {
    var art = PackageCompile.Compile(_inputs(
        "namespace VarianceFixture; public interface IMap<K,V,Unused> { V Lookup(K key); } "
        + "public interface IByRef<T> { void Update(ref T item); }", "lib"));
    Assert.Equal(0, art.ErrorCount);
    var pkg = ZpkgReader.Open(ZpkgWriterZ.WritePacked(art.Z, false).ToBytes());
    string[] dirs = new string[]{""};
    var world = new LazyReconWorld(new ZpkgInfo[]{pkg}, dirs, 1);
    var modules = TsigReconcile.Rebuild(pkg, "", world);
    string[] pkgNames = new string[modules.Length];
    int i = 0;
    while (i < modules.Length) {
        pkgNames[i] = "demo";
        i = i + 1;
    }
    var imported = ImportedSymbolLoader.Load(modules, pkgNames, modules.Length,
                                             new string[]{"VarianceFixture"}, 1);
    var map = imported.InterfacesByFqn.Get("VarianceFixture.IMap") as Z42InterfaceType;
    Assert.Equal(true, map != null && map.IsImported);
    Assert.Equal(true, map.ParameterVariance(0) == InterfaceVariance.Contravariant);
    Assert.Equal(true, map.ParameterVariance(1) == InterfaceVariance.Covariant);
    Assert.Equal(true, map.ParameterVariance(2) == InterfaceVariance.Invariant);
    var byRef = imported.InterfacesByFqn.Get("VarianceFixture.IByRef") as Z42InterfaceType;
    Assert.Equal(true, byRef != null && byRef.ParameterVariance(0) == InterfaceVariance.Invariant);

    // Simulate a package compiled before the producer emitted variance data.
    var types = ZpkgReader.ReadModuleTypes(pkg, "");
    foreach (var module in types) {
        foreach (var desc in module.Classes) {
            if (desc.Name == "VarianceFixture.IMap") { desc.AttrCount = 0; }
        }
    }
    var oldModules = TsigReconcile.Rebuild(pkg, "", world, types, ZpkgReader.ReadModuleSigs(pkg));
    var oldImport = ImportedSymbolLoader.Load(oldModules, pkgNames, oldModules.Length,
                                              new string[]{"VarianceFixture"}, 1);
    var oldMap = oldImport.InterfacesByFqn.Get("VarianceFixture.IMap") as Z42InterfaceType;
    Assert.Equal(true, oldMap != null && oldMap.ParameterVariance(0) == InterfaceVariance.Invariant);
    Assert.Equal(true, oldMap.ParameterVariance(1) == InterfaceVariance.Invariant);
}

[Test]
void test_interface_variance_metadata_rejects_invalid_payloads() {
    var good = new IrAttrRef(IrIfaceVariance.Sentinel, "io-");
    var badChar = new IrAttrRef(IrIfaceVariance.Sentinel, "i?o");
    Assert.Equal("io-", IrIfaceVariance.Read(new IrAttrRef[]{good}, 1, 3));
    Assert.Equal("", IrIfaceVariance.Read(new IrAttrRef[]{good}, 1, 2));
    Assert.Equal("", IrIfaceVariance.Read(new IrAttrRef[]{badChar}, 1, 3));
    Assert.Equal("", IrIfaceVariance.Read(new IrAttrRef[]{good, good}, 2, 3));
}
