// PackageCompile 单测（extract-compile-pipeline-api）：验证抽出的编译核心
// 「源+依赖 → 组装好的 ZpkgFileZ + 结构化诊断」，不落盘、诊断结构返回、entry 决议。
namespace Z42cPipelinePkgCompileTests;

using Std;
using Std.IO;
using Std.Test;
using Std.Reflection;   // Activator（PR4d VM 执行 golden：外部 generator 产物真跑）
using Z42.Pipeline;
using Z42.Semantics;
using Z42.Project;
using Z42.IR;
using Z42.IR.BinaryFormat;

// PR4d VM 执行 golden 用：把编好的 consumer zpkg 并入 live VM（可 Type.GetType + Activator + 虚调用）。
// native 是 VM builtin（种子恒在），返回值忽略——只要加载副作用。同 GeneratorLoader/AnalyzerLoader Path-B。
static class _VmLoad {
    [Native("__load_module")]
    public static extern object load(string path);
}

// ── attribute-handler-registry PR3a-load：外部 analyzer zpkg 编译期加载端到端 ─────────────────
// 编译一个实现 Z42.Syntax.Analyzer 的 fixture → 临时 zpkg → 经 CompileInputs.AnalyzerZpkgs 喂给
// PackageCompile → 断言 analyzer 的 Z9002 诊断合入 consumer 的 per-file Cms。**非提交二进制**（fixture
// 现编 → 免格式-bump 脆性），走真实 AnalyzerLoader（两路加载 + 反射实例化）+ AnalyzerDriver 全链。

// 单文件 no-dep 工程 → CompileInputs（LibsDirs 空，Cus 现 parse）。
CompileInputs _inputs(string src, string kind) {
    string[] texts = new string[1]; texts[0] = src;
    string[] files = new string[1]; files[0] = "a.z42";
    string[] hashes = new string[1]; hashes[0] = "DEADBEEF";
    CompileInputs cin = new CompileInputs();
    cin.Texts = texts; cin.Files = files; cin.SrcHashes = hashes; cin.SrcCount = 1;
    cin.Cus = IrDump.ParseAll(texts, files, 1);
    cin.CachedMods = null; cin.CachedMetas = null;
    cin.Name = "demo"; cin.Version = "0.1.0"; cin.Kind = kind;
    cin.HasEntry = false; cin.Entry = "";
    cin.IsRelease = false;
    cin.LibsDirs = new string[0]; cin.LibsDirsN = 0;
    cin.DeclaredDeps = new string[0]; cin.DepCount = 0;
    return cin;
}

// 同上但指定 LibsDirs（真实依赖世界）+ 包名 —— CachedScan / ExtendWithPackage 测试用。
CompileInputs _inputsLibs(string ns, string fname, string[] dirs, string name) {
    CompileInputs cin = _inputs("namespace " + ns + ";\nint " + fname + "() { return 1; }\n", "lib");
    cin.Name = name;
    cin.LibsDirs = dirs; cin.LibsDirsN = dirs.Length;
    return cin;
}

[Test]
void test_exe_with_main_assembles_ok() {
    CompileArtifacts art = PackageCompile.Compile(_inputs("namespace T;\nint Main() { return 0; }\n", "exe"));
    Assert.Equal(0, art.ErrorCount);
    Assert.Equal(1, art.ModCount);
    Assert.Equal("ok", art.EntryStatus);
    Assert.Equal("demo", art.Z.Name);
}

[Test]
void test_lib_no_entry_ok() {
    CompileArtifacts art = PackageCompile.Compile(_inputs("namespace T;\nint Add(int a, int b) { return a + b; }\n", "lib"));
    Assert.Equal(0, art.ErrorCount);
    Assert.Equal("ok", art.EntryStatus);   // lib 不校验 entry
}

[Test]
void test_exe_missing_main_entry_status() {
    CompileArtifacts art = PackageCompile.Compile(_inputs("namespace T;\nint Helper() { return 1; }\n", "exe"));
    // exe 无 Main → 组装成功但 EntryStatus=missing（调用方据此报错）；非编译错误
    Assert.Equal(0, art.ErrorCount);
    Assert.Equal("missing", art.EntryStatus);
}

[Test]
void test_bad_source_returns_diagnostics_no_assembly() {
    CompileArtifacts art = PackageCompile.Compile(_inputs("namespace T;\nint Bad() { return zzzUndefined; }\n", "lib"));
    // 有编译错误 → 不组装（Z=null），诊断结构返回（Cms 携逐文件诊断供调用方呈现）
    Assert.Equal(true, art.ErrorCount > 0);
    Assert.Equal(1, art.CmCount);
    Assert.Equal(true, art.Cms[0].ErrorCount > 0);
}

// perf-optimize-repl-eval ②：LibsDirsN>0 时 Compile 建 scan 并回显 art.Scan；
// 把它作 CachedScan 传回第二次编译 → 跳过 DepScan、结果照常。（REPL 每轮复用的核心路径）
[Test]
void test_cached_scan_reused() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }   // 无 libs 环境（不该发生于 test harness）→ 跳过
    string[] dirs = libs.Split(":");
    CompileArtifacts a1 = PackageCompile.Compile(_inputsLibs("R1", "F1", dirs, "repl_r1"));
    Assert.Equal(0, a1.ErrorCount);
    Assert.Equal(true, a1.Scan != null);          // scan 建好且回显
    // 第二次：传 CachedScan → 直接复用（不再 DepScan.ScanDirs），编译照常成功
    CompileInputs in2 = _inputsLibs("R2", "F2", dirs, "repl_r2");
    in2.CachedScan = a1.Scan;
    CompileArtifacts a2 = PackageCompile.Compile(in2);
    Assert.Equal(0, a2.ErrorCount);
    Assert.Equal(1, a2.ModCount);
    Assert.Equal(true, a2.Scan != null);           // 复用路径也回显 scan（= 传入的 CachedScan）
}

// perf-optimize-repl-eval ⑤：ExtendWithPackage 把一个刚编出的包增量并入已建 scan
//（REPL carry-forward 的机制）——并入后该包的命名空间在 scan 里可见。
[Test]
void test_extend_with_package_adds_namespace() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }
    string[] dirs = libs.Split(":");
    CompileArtifacts a1 = PackageCompile.Compile(_inputsLibs("ExtNs", "F", dirs, "repl_ext"));
    Assert.Equal(0, a1.ErrorCount);
    int before = a1.Scan.NsCount;
    byte[] bytes = ZpkgWriterZ.WritePacked(a1.Z, false).ToBytes();
    DepScan.ExtendWithPackage(a1.Scan, bytes, "repl_ext");
    // 新包命名空间 ExtNs 并入 → NsCount 增长，且能 FileOf 命中
    Assert.Equal(true, a1.Scan.NsCount > before);
    Assert.Equal("repl_ext.zpkg", a1.Scan.FileOf("ExtNs"));
}

// ── PR3a-load 外部 analyzer 加载端到端 ──────────────────────────────────────────

// fixture analyzer 源：实现 Z42.Syntax.Analyzer，报告空 catch（Z9002）。类名带 Analyzer 后缀（E0445）；
// 独立命名空间/类名（避免与 z42c.semantics 测试模块里 NoEmptyCatchAnalyzer 在 live VM 撞名）。
string _fixtureAnalyzerSrc() {
    return "namespace AnalyzerLoadFixture;\n"
        + "using Z42.Syntax;\n"
        + "using Z42.Core;\n"
        + "public class FixtureNoEmptyCatchAnalyzer : Analyzer {\n"
        + "    public DiagRule[] SupportedRules() { DiagRule[] r = new DiagRule[1]; r[0] = FixtureNoEmptyCatchAnalyzer._rule(); return r; }\n"
        + "    public int[] ObservedKinds() { int[] k = new int[1]; k[0] = SyntaxKind.CatchClause; return k; }\n"
        + "    public void OnSyntaxNode(int kind, object node, DiagSink diags) {\n"
        + "        if (kind == SyntaxKind.CatchClause) {\n"
        + "            CatchClause c = node as CatchClause;\n"
        + "            if (c.Body is BlockStmt) { BlockStmt b = c.Body as BlockStmt; if (b.Count == 0) { diags.Report(FixtureNoEmptyCatchAnalyzer._rule(), c.Span); } }\n"
        + "        }\n"
        + "    }\n"
        + "    static DiagRule _rule() { return new DiagRule(\"Z9002\", \"empty catch\", \"empty catch swallows exception\", \"Correctness\", AnalyzerSeverity.Warning, true); }\n"
        + "}\n";
}

// 编译 fixture analyzer（依赖 z42c.syntax + z42c.core）→ CompileInputs。
CompileInputs _fixtureAnalyzerInputs(string[] dirs) {
    string[] texts = new string[1]; texts[0] = _fixtureAnalyzerSrc();
    string[] files = new string[1]; files[0] = "fixture_analyzer.z42";
    string[] hashes = new string[1]; hashes[0] = "FIXTUREAZ";
    CompileInputs cin = new CompileInputs();
    cin.Texts = texts; cin.Files = files; cin.SrcHashes = hashes; cin.SrcCount = 1;
    cin.Cus = IrDump.ParseAll(texts, files, 1);
    cin.CachedMods = null; cin.CachedMetas = null;
    cin.Name = "demo.analyzerfixture"; cin.Version = "0.1.0"; cin.Kind = "lib";
    cin.HasEntry = false; cin.Entry = "";
    cin.IsRelease = false;
    cin.LibsDirs = dirs; cin.LibsDirsN = dirs.Length;
    string[] deps = new string[2]; deps[0] = "z42c.syntax"; deps[1] = "z42c.core";
    cin.DeclaredDeps = deps; cin.DepCount = 2;
    return cin;
}

string _tmpRoot() {
    string t = Environment.GetEnvironmentVariable("TMPDIR") ?? "";
    if (t == "") { t = Environment.GetEnvironmentVariable("TEMP") ?? ""; }
    if (t == "") { t = "/tmp"; }
    return Path.Join(t, "z42c-analyzer-load-tests");
}

bool _cmsHasCode(CompileArtifacts art, string code) {
    int i = 0;
    while (i < art.CmCount) {
        CompiledModuleZ cm = art.Cms[i];
        int di = 0;
        while (di < cm.DiagCount) {
            if (cm.DiagMsgs[di].Contains(code)) { return true; }
            di = di + 1;
        }
        i = i + 1;
    }
    return false;
}

[Test]
void test_external_analyzer_loaded_and_reports() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }   // 无 libs 环境（不该发生于 test harness）→ 跳过
    string[] dirs = libs.Split(":");
    // 1. 现编 fixture analyzer → 临时 zpkg（非提交二进制）
    CompileArtifacts aArt = PackageCompile.Compile(_fixtureAnalyzerInputs(dirs));
    Assert.Equal(0, aArt.ErrorCount);
    string tmp = _tmpRoot();
    Directory.Create(tmp);
    string azPath = Path.Join(tmp, "demo.analyzerfixture.zpkg");
    byte[] bytes = ZpkgWriterZ.WritePacked(aArt.Z, false).ToBytes();
    File.WriteAllBytes(azPath, bytes);
    // 2. 编一个含空 catch 的 consumer，AnalyzerZpkgs 指向 fixture → 走真实 AnalyzerLoader + driver。
    //    typeless `catch { }`（Parser 支持，类型/变量可省）→ 无 deps 即可 typecheck 干净。
    CompileInputs cin = _inputs("namespace Consumer;\nint risky() { return 1; }\nint M() { int r = 0; try { r = risky(); } catch { } return r; }\n", "lib");
    cin.Name = "demo.consumer";
    string[] az = new string[1]; az[0] = azPath;
    cin.AnalyzerZpkgs = az; cin.AnalyzerZpkgCount = 1;
    CompileArtifacts cArt = PackageCompile.Compile(cin);
    // analyzer 诊断为 Warning → 不 fail 编译（ErrorCount 不增），但合入 per-file Cms 可见
    Assert.Equal(0, cArt.ErrorCount);
    Assert.Equal(true, _cmsHasCode(cArt, "Z9002"));
}

// 现编 fixture analyzer → 写临时 zpkg，返回其路径（PR3b [lints] 端到端复用）。
string _writeFixtureZpkg(string[] dirs) {
    CompileArtifacts aArt = PackageCompile.Compile(_fixtureAnalyzerInputs(dirs));
    Assert.Equal(0, aArt.ErrorCount);
    string tmp = _tmpRoot();
    Directory.Create(tmp);
    string azPath = Path.Join(tmp, "demo.analyzerfixture.zpkg");
    File.WriteAllBytes(azPath, ZpkgWriterZ.WritePacked(aArt.Z, false).ToBytes());
    return azPath;
}

// 空-catch consumer + AnalyzerZpkgs 指向 fixture，可带 [lints] 决策器。
CompileInputs _consumerWithAnalyzer(string azPath, LintConfig cfg) {
    CompileInputs cin = _inputs("namespace Consumer;\nint risky() { return 1; }\nint M() { int r = 0; try { r = risky(); } catch { } return r; }\n", "lib");
    cin.Name = "demo.consumer";
    string[] az = new string[1]; az[0] = azPath;
    cin.AnalyzerZpkgs = az; cin.AnalyzerZpkgCount = 1;
    cin.Lints = cfg;
    return cin;
}

// ── PR3b：[lints] severity 决策端到端（CompileInputs.Lints → _runAnalyzers → LintConfig）─────

[Test]
void test_lints_none_suppresses_end_to_end() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }
    string azPath = _writeFixtureZpkg(libs.Split(":"));
    // [lints] Z9002 = "none" → 抑制，consumer Cms 不含 Z9002
    string[] keys = new string[1]; keys[0] = "Z9002";
    string[] sevs = new string[1]; sevs[0] = "none";
    LintConfig cfg = new LintConfig(keys, sevs, 1, false);
    CompileArtifacts cArt = PackageCompile.Compile(_consumerWithAnalyzer(azPath, cfg));
    Assert.Equal(0, cArt.ErrorCount);
    Assert.Equal(false, _cmsHasCode(cArt, "Z9002"));
}

[Test]
void test_lints_warnings_as_errors_fails_compile() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }
    string azPath = _writeFixtureZpkg(libs.Split(":"));
    // warnings-as-errors → Z9002（默认 Warning）升 Error → consumer ErrorCount>0（拦编译）
    LintConfig cfg = new LintConfig(new string[0], new string[0], 0, true);
    CompileArtifacts cArt = PackageCompile.Compile(_consumerWithAnalyzer(azPath, cfg));
    Assert.Equal(true, cArt.ErrorCount > 0);
    Assert.Equal(true, _cmsHasCode(cArt, "Z9002"));
}

[Test]
void test_no_analyzers_no_extra_diags() {
    // 无 [analyzers]（AnalyzerZpkgCount=0）→ 空 catch 不触发 analyzer 诊断（byte-identical 路径）
    CompileArtifacts art = PackageCompile.Compile(
        _inputs("namespace C2;\nint risky() { return 1; }\nint M() { int r = 0; try { r = risky(); } catch { } return r; }\n", "lib"));
    Assert.Equal(0, art.ErrorCount);
    Assert.Equal(false, _cmsHasCode(art, "Z9002"));
}

// ── PR3c：局部抑制端到端（全量编译，走 AnalyzerLoader + AnalyzerDriver.Run 抑制判定）──────────

// consumer 源：`#suppress Z9002` … `#restore Z9002` 圈住空 catch。指定 AnalyzerZpkgs。
CompileInputs _consumerPragmaSuppress(string azPath) {
    CompileInputs cin = _inputs("namespace Consumer;\nint risky() { return 1; }\n"
        + "int M() { int r = 0; #suppress Z9002 \"gen\" try { r = risky(); } catch { } #restore Z9002 return r; }\n", "lib");
    cin.Name = "demo.consumer";
    string[] az = new string[1]; az[0] = azPath;
    cin.AnalyzerZpkgs = az; cin.AnalyzerZpkgCount = 1;
    return cin;
}

// consumer 源：`[Suppress("Z9002")]` 贴自由函数 M（含空 catch）。验 directive 分类全量编译干净 + 抑制。
CompileInputs _consumerAttrSuppress(string azPath) {
    CompileInputs cin = _inputs("namespace Consumer;\nint risky() { return 1; }\n"
        + "[Suppress(\"Z9002\")] int M() { int r = 0; try { r = risky(); } catch { } return r; }\n", "lib");
    cin.Name = "demo.consumer";
    string[] az = new string[1]; az[0] = azPath;
    cin.AnalyzerZpkgs = az; cin.AnalyzerZpkgCount = 1;
    return cin;
}

[Test]
void test_suppress_pragma_end_to_end() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }
    string azPath = _writeFixtureZpkg(libs.Split(":"));
    // `#suppress`/`#restore` 圈住空 catch → 抑制，consumer Cms 不含 Z9002；编译干净
    CompileArtifacts cArt = PackageCompile.Compile(_consumerPragmaSuppress(azPath));
    Assert.Equal(0, cArt.ErrorCount);
    Assert.Equal(false, _cmsHasCode(cArt, "Z9002"));
}

[Test]
void test_suppress_attr_end_to_end() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }
    string azPath = _writeFixtureZpkg(libs.Split(":"));
    // `[Suppress("Z9002")]` = directive（纯编译期）→ 全量编译不因缺 SuppressAttribute 类而报错
    // （ErrorCount=0），且抑制生效（Cms 不含 Z9002）。这条同时验 directive 分类与抑制两件事。
    CompileArtifacts cArt = PackageCompile.Compile(_consumerAttrSuppress(azPath));
    Assert.Equal(0, cArt.ErrorCount);
    Assert.Equal(false, _cmsHasCode(cArt, "Z9002"));
}

// ── attribute-handler-registry PR4d：外部 generator zpkg 编译期加载 + VM 执行 golden ─────────────
// 编译一个实现 Z42.Semantics.Generator（applied）+ ModuleGenerator 的 fixture → 临时 zpkg → 经
// CompileInputs.GeneratorZpkgs（driver 从 `[analyzers]` 段填，D9 单段覆盖两类）喂给 PackageCompile →
// GeneratorLoader 两路加载（发现 `: Generator`/`: ModuleGenerator` + 反射实例化）→ 引擎 splice/merge。
// **VM 执行 golden**：把编好的 consumer zpkg 并入 live VM（__load_module）→ CreateInstance 生成的类型 →
// 调 ToString() → 断言生成方法体**真运行**（生成用数值→ToString 规避三层引号嵌套；`(40+2)`→"42" /
// entity 计数→"2"）。**非提交二进制**（fixture 现编 → 免格式-bump 脆性），走真实外部加载全链。

// fixture 源：一个 zpkg 混含 applied generator（StringifyGenerator，Augment override ToString）+ module
// generator（RegistryGenerator，TypesWith<EntityAttribute> 计数 → AddSource EntityRegistry）+ EntityAttribute
// （供 module 的 typeof 解析；名字桥接 consumer 的 `[Entity]`）。类名带 Generator/Attribute 后缀（E0447/E0444）。
string _fixtureGeneratorSrc() {
    return "namespace GeneratorLoadFixture;\n"
        + "using Std;\n"
        + "using Z42.Semantics;\n"
        + "public class EntityAttribute : Attribute { public EntityAttribute() { } }\n"
        // applied：Augment 被贴类 override ToString → (40+2).ToString() == \"42\"（无嵌套字符串字面量）。
        + "public class StringifyGenerator : Generator {\n"
        + "    public string AppliedName() { return \"Stringify\"; }\n"
        + "    public void Generate(GenTarget t, GenSink sink) {\n"
        + "        sink.Augment(t.DeclId, \"public override string ToString() { return (40 + 2).ToString(); }\");\n"
        + "    }\n"
        + "}\n"
        // module：TypesWith<EntityAttribute> 计数 n → 生成 EntityRegistry（count()==n，ToString 返回其字符串）。
        + "public class RegistryGenerator : ModuleGenerator {\n"
        + "    public void Generate(GenContext ctx, GenSink sink) {\n"
        + "        GenType[] ts = ctx.TypesWith<EntityAttribute>();\n"
        + "        int n = ts.Length;\n"
        + "        if (n == 0) { return; }\n"   // 无实体 → 不产空注册表（也避免无实体消费方 compile 里串味 ModConsumer.EntityRegistry）
        + "        sink.AddSource(\"registry.z42\", \"namespace ModConsumer; class EntityRegistry { public int count() { return \" + n.ToString() + \"; } public override string ToString() { return this.count().ToString(); } }\");\n"
        + "    }\n"
        + "}\n";
}

// 编 fixture generator（依赖 z42c.semantics；Std=prelude 提供 Attribute）→ 临时 zpkg，返回其路径。
string _writeFixtureGeneratorZpkg(string[] dirs) {
    string[] texts = new string[1]; texts[0] = _fixtureGeneratorSrc();
    string[] files = new string[1]; files[0] = "fixture_generator.z42";
    string[] hashes = new string[1]; hashes[0] = "FIXTUREGEN";
    CompileInputs cin = new CompileInputs();
    cin.Texts = texts; cin.Files = files; cin.SrcHashes = hashes; cin.SrcCount = 1;
    cin.Cus = IrDump.ParseAll(texts, files, 1);
    cin.CachedMods = null; cin.CachedMetas = null;
    cin.Name = "demo.generatorfixture"; cin.Version = "0.1.0"; cin.Kind = "lib";
    cin.HasEntry = false; cin.Entry = "";
    cin.IsRelease = false;
    cin.LibsDirs = dirs; cin.LibsDirsN = dirs.Length;
    string[] deps = new string[1]; deps[0] = "z42c.semantics";
    cin.DeclaredDeps = deps; cin.DepCount = 1;
    CompileArtifacts aArt = PackageCompile.Compile(cin);
    Assert.Equal(0, aArt.ErrorCount);
    string tmp = _tmpRoot();
    Directory.Create(tmp);
    string gzPath = Path.Join(tmp, "demo.generatorfixture.zpkg");
    File.WriteAllBytes(gzPath, ZpkgWriterZ.WritePacked(aArt.Z, false).ToBytes());
    return gzPath;
}

// 编好的 consumer zpkg → 落盘 → __load_module → Type.GetType(fqn) → CreateInstance → ToString()。
string _loadAndToString(CompileArtifacts cArt, string zpkgName, string typeFqn) {
    string tmp = _tmpRoot();
    Directory.Create(tmp);
    string czPath = Path.Join(tmp, zpkgName);
    File.WriteAllBytes(czPath, ZpkgWriterZ.WritePacked(cArt.Z, false).ToBytes());
    _VmLoad.load(czPath);                       // Path-B：并入 live VM
    Type t = Type.GetType(typeFqn);
    Assert.Equal(true, t != null);
    object o = Activator.CreateInstance(t);
    Assert.Equal(true, o != null);
    return o.ToString();                        // 虚派发命中生成的 override（golden）
}

// CONTROL-2：手写**两文件 partial**（override 在第二碎片，无 generator）→ lib → __load_module → ToString。
// 决定性区分：applied Augment = 原类 + 合成 partial 碎片（两 CU/模块）。若本控制返回类名 = __load_module
// 对多模块 partial 的方法/vtable wiring 有局限（非引擎问题）；若返回 "42" = 手写多模块 partial 经加载 OK
// → applied 的问题出在引擎合成 partial（IsPartial 标志 vs 源 keyword）与手写有别。
[Test]
void test_handwritten_multimodule_partial_via_load_control() {
    string[] texts = new string[2];
    texts[0] = "namespace Pc;\npartial class Pw { }\n";
    texts[1] = "namespace Pc;\nusing Std;\npartial class Pw { public override string ToString() { return (40 + 2).ToString(); } }\n";
    string[] files = new string[2]; files[0] = "pa.z42"; files[1] = "pb.z42";
    string[] hashes = new string[2]; hashes[0] = "PA"; hashes[1] = "PB";
    CompileInputs cin = new CompileInputs();
    cin.Texts = texts; cin.Files = files; cin.SrcHashes = hashes; cin.SrcCount = 2;
    cin.Cus = IrDump.ParseAll(texts, files, 2);
    cin.CachedMods = null; cin.CachedMetas = null;
    cin.Name = "demo.partialctrl"; cin.Version = "0.1.0"; cin.Kind = "lib";
    cin.HasEntry = false; cin.Entry = "";
    cin.IsRelease = false;
    cin.LibsDirs = new string[0]; cin.LibsDirsN = 0;
    cin.DeclaredDeps = new string[0]; cin.DepCount = 0;
    CompileArtifacts cArt = PackageCompile.Compile(cin);
    Assert.Equal(0, cArt.ErrorCount);
    string s = _loadAndToString(cArt, "demo.partialctrl.zpkg", "Pc.Pw");
    Assert.Equal("42", s);
}

// CONTROL: 手写 lib（override ToString，无 generator）→ write zpkg → __load_module → CreateInstance →
// ToString。隔离 __load_module 是否保留 override vtable（若返回类名 = vtable 未保留 → 非 generator 问题）。
[Test]
void test_handwritten_tostring_via_load_control() {
    CompileInputs cin = _inputs("namespace CtrlNs;\nclass Ctrl { public override string ToString() { return (40 + 2).ToString(); } }\n", "lib");
    cin.Name = "demo.ctrl";
    CompileArtifacts cArt = PackageCompile.Compile(cin);
    Assert.Equal(0, cArt.ErrorCount);
    string s = _loadAndToString(cArt, "demo.ctrl.zpkg", "CtrlNs.Ctrl");
    Assert.Equal("42", s);
}

[Test]
void test_external_applied_generator_vm_execution_golden() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }   // 无 libs 环境（不该发生于 test harness）→ 跳过
    string[] dirs = libs.Split(":");
    string gzPath = _writeFixtureGeneratorZpkg(dirs);
    // consumer：`[Stringify] class Widget {}`（无 ToString）。GeneratorZpkgs 指向 fixture → 外部加载
    // StringifyGenerator → Augment override ToString。ordering fixup 剥 `[Stringify]` 触发 attr。
    CompileInputs cin = _inputs("namespace GenConsumer;\n[Stringify] class Widget { }\n", "lib");
    cin.Name = "demo.genconsumer.applied";
    cin.LibsDirs = dirs; cin.LibsDirsN = dirs.Length;   // override ToString 需 Std.Object 可见以链 vtable 槽
    string[] gz = new string[1]; gz[0] = gzPath;
    cin.GeneratorZpkgs = gz; cin.GeneratorZpkgCount = 1;
    CompileArtifacts cArt = PackageCompile.Compile(cin);
    Assert.Equal(0, cArt.ErrorCount);
    // VM 执行：生成的 ToString 若真跑 → "42"（若来自 object 默认 ToString 则不是）。证外部 applied 生成体运行。
    string s = _loadAndToString(cArt, "demo.genconsumer.applied.zpkg", "GenConsumer.Widget");
    Assert.Equal("42", s);
}

[Test]
void test_external_module_generator_vm_execution_golden() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }
    string[] dirs = libs.Split(":");
    string gzPath = _writeFixtureGeneratorZpkg(dirs);
    // consumer：自定义 EntityAttribute（供 `[Entity]` store-meta 合成）+ 2 个 `[Entity]` 类 + 1 非实体。
    // module generator（外部加载）TypesWith<EntityAttribute> 按名匹配 → n=2 → 生成 EntityRegistry。
    CompileInputs cin = _inputs("namespace ModConsumer;\nusing Std;\n"
        + "public class EntityAttribute : Attribute { public EntityAttribute() { } }\n"
        + "[Entity] class Foo { }\n[Entity] class Bar { }\nclass Plain { }\n", "lib");
    cin.Name = "demo.genconsumer.module";
    cin.LibsDirs = dirs; cin.LibsDirsN = dirs.Length;   // 消费者用 Std.Attribute 基类 → 需 libs 解析
    string[] gz = new string[1]; gz[0] = gzPath;
    cin.GeneratorZpkgs = gz; cin.GeneratorZpkgCount = 1;
    CompileArtifacts cArt = PackageCompile.Compile(cin);
    Assert.Equal(0, cArt.ErrorCount);
    // VM 执行：生成的 EntityRegistry.ToString() == count().ToString() == "2"（module 发现了 2 个 [Entity]）。
    string s = _loadAndToString(cArt, "demo.genconsumer.module.zpkg", "ModConsumer.EntityRegistry");
    Assert.Equal("2", s);
}

[Test]
void test_no_generator_zpkgs_no_change() {
    // 无 GeneratorZpkgs（GeneratorZpkgCount=0）→ 不加载、gate 不进 → 普通类照常编译（byte-identical 路径）。
    CompileArtifacts art = PackageCompile.Compile(
        _inputs("namespace Plain;\nclass Widget { public int v() { return 1; } }\n", "lib"));
    Assert.Equal(0, art.ErrorCount);
    Assert.Equal(1, art.ModCount);
}
