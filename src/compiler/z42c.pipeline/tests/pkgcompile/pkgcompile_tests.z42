// PackageCompile 单测（extract-compile-pipeline-api）：验证抽出的编译核心
// 「源+依赖 → 组装好的 ZpkgFileZ + 结构化诊断」，不落盘、诊断结构返回、entry 决议。
namespace Z42cPipelinePkgCompileTests;

using Std;
using Std.IO;
using Std.Test;
using Z42.Pipeline;
using Z42.Semantics;
using Z42.Project;
using Z42.IR;

// 单文件 no-dep 工程 → CompileInputs（LibsDirs 空，Cus 现 parse）。
CompileInputs _inputs(string src, string kind) {
    string[] texts = new string[1]; texts[0] = src;
    string[] files = new string[1]; files[0] = "a.z42";
    string[] hashes = new string[1]; hashes[0] = "DEADBEEF";
    CompileInputs cin = new CompileInputs();
    cin.Texts = texts; cin.Files = files; cin.SrcHashes = hashes; cin.SrcCount = 1;
    cin.Cus = IrDump.ParseAll(texts, files, 1);
    cin.CachedMods = null; cin.CachedMetas = null;
    cin.Name = "demo"; cin.Version = "0.1.0"; cin.Kind = kind;
    cin.HasEntry = false; cin.Entry = "";
    cin.IsRelease = false;
    cin.LibsDirs = new string[0]; cin.LibsDirsN = 0;
    cin.DeclaredDeps = new string[0]; cin.DepCount = 0;
    return cin;
}

// 同上但指定 LibsDirs（真实依赖世界）+ 包名 —— CachedScan / ExtendWithPackage 测试用。
CompileInputs _inputsLibs(string ns, string fname, string[] dirs, string name) {
    CompileInputs cin = _inputs("namespace " + ns + ";\nint " + fname + "() { return 1; }\n", "lib");
    cin.Name = name;
    cin.LibsDirs = dirs; cin.LibsDirsN = dirs.Length;
    return cin;
}

[Test]
void test_exe_with_main_assembles_ok() {
    CompileArtifacts art = PackageCompile.Compile(_inputs("namespace T;\nint Main() { return 0; }\n", "exe"));
    Assert.Equal(0, art.ErrorCount);
    Assert.Equal(1, art.ModCount);
    Assert.Equal("ok", art.EntryStatus);
    Assert.Equal("demo", art.Z.Name);
}

[Test]
void test_lib_no_entry_ok() {
    CompileArtifacts art = PackageCompile.Compile(_inputs("namespace T;\nint Add(int a, int b) { return a + b; }\n", "lib"));
    Assert.Equal(0, art.ErrorCount);
    Assert.Equal("ok", art.EntryStatus);   // lib 不校验 entry
}

[Test]
void test_exe_missing_main_entry_status() {
    CompileArtifacts art = PackageCompile.Compile(_inputs("namespace T;\nint Helper() { return 1; }\n", "exe"));
    // exe 无 Main → 组装成功但 EntryStatus=missing（调用方据此报错）；非编译错误
    Assert.Equal(0, art.ErrorCount);
    Assert.Equal("missing", art.EntryStatus);
}

[Test]
void test_bad_source_returns_diagnostics_no_assembly() {
    CompileArtifacts art = PackageCompile.Compile(_inputs("namespace T;\nint Bad() { return zzzUndefined; }\n", "lib"));
    // 有编译错误 → 不组装（Z=null），诊断结构返回（Cms 携逐文件诊断供调用方呈现）
    Assert.Equal(true, art.ErrorCount > 0);
    Assert.Equal(1, art.CmCount);
    Assert.Equal(true, art.Cms[0].ErrorCount > 0);
}

// perf-optimize-repl-eval ②：LibsDirsN>0 时 Compile 建 scan 并回显 art.Scan；
// 把它作 CachedScan 传回第二次编译 → 跳过 DepScan、结果照常。（REPL 每轮复用的核心路径）
[Test]
void test_cached_scan_reused() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }   // 无 libs 环境（不该发生于 test harness）→ 跳过
    string[] dirs = libs.Split(":");
    CompileArtifacts a1 = PackageCompile.Compile(_inputsLibs("R1", "F1", dirs, "repl_r1"));
    Assert.Equal(0, a1.ErrorCount);
    Assert.Equal(true, a1.Scan != null);          // scan 建好且回显
    // 第二次：传 CachedScan → 直接复用（不再 DepScan.ScanDirs），编译照常成功
    CompileInputs in2 = _inputsLibs("R2", "F2", dirs, "repl_r2");
    in2.CachedScan = a1.Scan;
    CompileArtifacts a2 = PackageCompile.Compile(in2);
    Assert.Equal(0, a2.ErrorCount);
    Assert.Equal(1, a2.ModCount);
    Assert.Equal(true, a2.Scan != null);           // 复用路径也回显 scan（= 传入的 CachedScan）
}

// perf-optimize-repl-eval ⑤：ExtendWithPackage 把一个刚编出的包增量并入已建 scan
//（REPL carry-forward 的机制）——并入后该包的命名空间在 scan 里可见。
[Test]
void test_extend_with_package_adds_namespace() {
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS") ?? "";
    if (libs == "") { return; }
    string[] dirs = libs.Split(":");
    CompileArtifacts a1 = PackageCompile.Compile(_inputsLibs("ExtNs", "F", dirs, "repl_ext"));
    Assert.Equal(0, a1.ErrorCount);
    int before = a1.Scan.NsCount;
    byte[] bytes = ZpkgWriterZ.WritePacked(a1.Z, false).ToBytes();
    DepScan.ExtendWithPackage(a1.Scan, bytes, "repl_ext");
    // 新包命名空间 ExtNs 并入 → NsCount 增长，且能 FileOf 命中
    Assert.Equal(true, a1.Scan.NsCount > before);
    Assert.Equal("repl_ext.zpkg", a1.Scan.FileOf("ExtNs"));
}
