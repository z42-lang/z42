// Z42cCompiler 端到端单测（wire-z42b D2）：经 ICompiler 契约把 SourceDir 编成 app.zpkg
// （源发现 + 读盘 + PackageCompile 核心 + 写盘），验证 Ok/Zpkg/诊断 与 entry 决议。
namespace Z42cPipelineZ42cCompilerTests;

using Std;
using Std.IO;
using Z42.Pipeline;
using Z42.Build;
using Z42.Project;   // ZpkgReader（读回 MODS 头的 SourceFile / SourceHash）

string _tmpRoot() {
    string t = Environment.GetEnvironmentVariable("TMPDIR", "");
    if (t == "") { t = Environment.GetEnvironmentVariable("TEMP", ""); }
    if (t == "") { t = "/tmp"; }
    return Path.Join(t, "z42c-z42ccompiler-tests");
}

// 造一个含单源文件的工程夹具，返回 (dir, outZpkg)。
string _mkProj(string name, string file, string src) {
    string dir = Path.Join(_tmpRoot(), name);
    Directory.Create(dir);
    File.WriteAllText(Path.Join(dir, file), src);
    return dir;
}

[Test]
void test_compiles_hello_exe() {
    string dir = _mkProj("hello", "main.z42", "int Main() { return 0; }\n");
    string outZpkg = Path.Join(dir, "app.zpkg");
    CompileRequest req = new CompileRequest(dir, outZpkg, new string[0], "debug", false, false, "exe", new string[0], 0);
    CompileResult res = new Z42cCompiler().Compile(req);
    Assert.Equal("", res.Diagnostics);
    Assert.Equal(true, res.Ok);
    Assert.Equal(outZpkg, res.Zpkg);
    Assert.Equal(true, File.Exists(outZpkg));
}

[Test]
void test_no_main_reports_missing_entry() {
    // kind=exe 无 Main() → missing entry → Ok=false（exe 专属校验）。
    string dir = _mkProj("nomain", "lib.z42", "int Helper() { return 1; }\n");
    string outZpkg = Path.Join(dir, "app.zpkg");
    CompileRequest req = new CompileRequest(dir, outZpkg, new string[0], "debug", false, false, "exe", new string[0], 0);
    CompileResult res = new Z42cCompiler().Compile(req);
    Assert.Equal(false, res.Ok);
    Assert.Equal("", res.Zpkg);
}

[Test]
void test_compiles_lib_no_main() {
    // kind=lib 无 Main() 应编译成功（add-z42b-compile-then-test：直接编测试工程的基础，
    // 测试模块是 lib 式、无 Main、只有 [Test]）。
    string dir = _mkProj("libnomain", "lib.z42", "int Helper() { return 1; }\n");
    string outZpkg = Path.Join(dir, "app.zpkg");
    CompileRequest req = new CompileRequest(dir, outZpkg, new string[0], "debug", false, false, "lib", new string[0], 0);
    CompileResult res = new Z42cCompiler().Compile(req);
    Assert.Equal("", res.Diagnostics);
    Assert.Equal(true, res.Ok);
    Assert.Equal(true, File.Exists(outZpkg));
}

[Test]
void test_empty_sourcedir_reports_no_sources() {
    string dir = Path.Join(_tmpRoot(), "empty");
    Directory.Create(dir);
    CompileRequest req = new CompileRequest(dir, Path.Join(dir, "app.zpkg"), new string[0], "debug", false, false, "exe", new string[0], 0);
    CompileResult res = new Z42cCompiler().Compile(req);
    Assert.Equal(false, res.Ok);
}

// ── 可复现 build_id（reproducible-build-id）───────────────────────────────────
// 同一份源 + 同一编译器 ⇒ release 主 zpkg 逐字节一致（build_id 是它的哈希，随之一致）：
// 换目录编、只改注释/空白都不变；真改代码必须变。MODS 头 SourceFile = 源根相对路径、SourceHash 为空。

byte[] _buildRelease(string dir, string src) {
    Directory.Create(dir);
    File.WriteAllText(Path.Join(dir, "lib.z42"), src);
    string outZpkg = Path.Join(dir, "app.zpkg");
    CompileRequest req = new CompileRequest(dir, outZpkg, new string[0], "release", true, false, "lib", new string[0], 0);
    CompileResult res = new Z42cCompiler().Compile(req);
    Assert.Equal("", res.Diagnostics);
    Assert.Equal(true, res.Ok);
    return File.ReadAllBytes(outZpkg);
}

bool _bytesEq(byte[] a, byte[] b) {
    if (a.Length != b.Length) { return false; }
    int i = 0;
    while (i < a.Length) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

[Test]
void test_release_zpkg_reproducible_across_dirs_and_comments() {
    string src = "namespace R;\npublic static class K {\n    public static int Add(int a, int b) { return a + b; }\n}\n";
    string commented = "// 顶部注释\n\nnamespace R;\npublic static class K {\n    // 成员注释\n    public static int Add(int a, int b)  { return a + b; }\n}\n";
    // 包名取源根尾目录名 ⇒ 各夹具尾名同为 pkg，只让父目录不同。
    byte[] a = _buildRelease(Path.Join(_tmpRoot(), Path.Join("repro-a", "pkg")), src);
    byte[] b = _buildRelease(Path.Join(_tmpRoot(), Path.Join("repro-b", Path.Join("deeper", "pkg"))), src);
    byte[] c = _buildRelease(Path.Join(_tmpRoot(), Path.Join("repro-c", "pkg")), commented);
    byte[] d = _buildRelease(Path.Join(_tmpRoot(), Path.Join("repro-d", "pkg")), src.Replace("a + b", "a - b"));
    Assert.Equal(true, _bytesEq(a, b));    // 换目录
    Assert.Equal(true, _bytesEq(a, c));    // 只改注释 / 空白 / 行号
    Assert.Equal(false, _bytesEq(a, d));   // 真改代码
    ZpkgSourceHash[] hs = ZpkgReader.ReadSourceHashes(ZpkgReader.Open(a));
    Assert.Equal(1, hs.Length);
    Assert.Equal("lib.z42", hs[0].SourceFile);
    Assert.Equal("", hs[0].SourceHash);
}
