// REPL 惰性世界（lazy-repl-depscan）语义单测。
//
// 锁两件事：
//   ① EnsurePackageLoaded 的**多包共享 ns 非 first-wins** 语义 —— 同一 ns 由两个包声明时，
//      按需加载必须把**两个包都** reconcile（与全量 ScanDirs 同口径），否则共享 ns 的次包符号
//      在 REPL 里静默缺席。这是 CompileRound 的 IntrinsicNs 预加载所依赖的正确性前提。
//   ② Z42cReplCompiler.IntrinsicNs 清单覆盖编译器隐式合成类型引用的全部 ns（单一真相）。
namespace Z42cPipelineReplWorldTests;

using Std.IO;
using Z42.Pipeline;
using Z42.Package;
using Z42.Emission;   // IrDump（ParseAll）
using Std.Harness;

// 无依赖的最小 lib 包（只用裸基元，LibsDirs 留空即可编）。
CompileInputs _pkgInputs(string name, string src) {
    string[] texts = new string[1]; texts[0] = src;
    string[] files = new string[1]; files[0] = "a.z42";
    string[] hashes = new string[1]; hashes[0] = "DEADBEEF";
    CompileInputs cin = new CompileInputs();
    cin.Texts = texts; cin.Files = files; cin.SrcHashes = hashes; cin.SrcCount = 1;
    cin.Cus = IrDump.ParseAll(texts, files, 1);
    cin.CachedMods = null; cin.CachedMetas = null;
    cin.Name = name; cin.Version = "0.1.0"; cin.Kind = "lib";
    cin.HasEntry = false; cin.Entry = "";
    cin.IsRelease = false;
    cin.LibsDirs = new string[0]; cin.LibsDirsN = 0;
    cin.DeclaredDeps = new string[0]; cin.DepCount = 0;
    return cin;
}

// 内存编一个共享 ns 的小包并落盘。返回写入路径。
string _writeSharedPkg(string dir, string name, string typeName) {
    CompileArtifacts art = PackageCompile.Compile(_pkgInputs(name,
        "namespace Shared.Ns;\npublic class " + typeName + " { public int V() { return 1; } }\n"));
    Assert.Equal(0, art.ErrorCount);
    string p = Path.Join(dir, name + ".zpkg");
    File.WriteAllBytes(p, ZpkgWriterZ.WritePacked(art.Z, false).ToBytes());
    return p;
}

// Exported 里是否已有 (ns, 裸类名)。
bool _exportedHas(DepScanResult scan, string ns, string shortName) {
    int i = 0;
    while (i < scan.ExportedCount) {
        if (scan.Exported[i].Namespace == ns) {
            int c = 0;
            while (c < scan.Exported[i].ClassCount) {
                if (scan.Exported[i].Classes[c].Name == shortName) { return true; }
                c = c + 1;
            }
        }
        i = i + 1;
    }
    return false;
}

[Test]
void test_shared_ns_loads_all_declaring_packages() {
    // 两个包都声明 ns "Shared.Ns"，各带一个类。
    string dir = File.CreateTempDir("replworld-sharedns");
    _writeSharedPkg(dir, "shared.first", "Alpha");
    _writeSharedPkg(dir, "shared.second", "Beta");

    // 惰性骨架（REPL 的世界形态）：路由索引就位、包未 reconcile。
    string[] dirs = new string[1]; dirs[0] = dir;
    DepScanResult scan = DepScan.ScanDirsLazy(dirs, 1, "", new string[0], 0);
    Assert.Equal(false, _exportedHas(scan, "Shared.Ns", "Alpha"));
    Assert.Equal(false, _exportedHas(scan, "Shared.Ns", "Beta"));

    // 按需加载该 ns：**两个**声明包都得进来（非 first-wins）。
    DepScan.EnsurePackageLoaded(scan, "Shared.Ns");
    Assert.Equal(true, _exportedHas(scan, "Shared.Ns", "Alpha"));
    Assert.Equal(true, _exportedHas(scan, "Shared.Ns", "Beta"));

    // 幂等：重复加载不再翻倍。
    int before = scan.ExportedCount;
    DepScan.EnsurePackageLoaded(scan, "Shared.Ns");
    Assert.Equal(before, scan.ExportedCount);

    Directory.Delete(dir, true);
}

[Test]
void test_intrinsic_ns_covers_compiler_synthesized_types() {
    // 单一真相守卫：IntrinsicNs 必须覆盖编译器隐式合成类型引用的全部 ns。
    // 与 TypeOpTyper（Type / Std.Reflection.*）和 CollectionTyper（Std.Collections.*）对账——
    // 加新的隐式合成类型而忘了同步清单时，这条测试红。
    Assert.True(_hasNs(Z42cReplCompiler.IntrinsicNs, "Std"));                 // typeof → Std.Type
    Assert.True(_hasNs(Z42cReplCompiler.IntrinsicNs, "Std.Reflection"));      // methodof/fieldof/propertyof
    Assert.True(_hasNs(Z42cReplCompiler.IntrinsicNs, "Std.Collections"));     // List/Dict 字面量
}

bool _hasNs(string[] nss, string ns) {
    int i = 0;
    while (i < nss.Length) { if (nss[i] == ns) { return true; } i = i + 1; }
    return false;
}
