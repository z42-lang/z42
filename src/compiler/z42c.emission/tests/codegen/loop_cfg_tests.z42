namespace LoopCfgRegression;
using Z42.Optimization;
using LoopCfgBench;
using Z42.IR;
using Std.Harness;

[Test]
void test_sparse_cfg_matches_dense_reference() {
    int trial = 0;
    while (trial < 264) {
        IrFunction f = LoopCfgFixture.Make(2 + trial % 131, trial % 4);
        LoopCfg sparse = IrLoopUtil.BuildCfg(f);
        DenseCfg dense = DenseLoopReference.BuildCfg(f);
        Assert.Equal(dense.Dom.Length, sparse.Dom.Length);
        int i = 0;
        while (i < dense.Dom.Length) { Assert.Equal(dense.Dom[i], sparse.Dom[i]); i = i + 1; }
        bool[] a = IrLoopUtil.Headers(sparse);
        bool[] b = DenseLoopReference.Headers(dense);
        i = 0;
        while (i < sparse.N) {
            Assert.Equal(b[i], a[i]);
            if (a[i]) {
                bool[] sa = IrLoopUtil.LoopBody(sparse, i);
                bool[] sb = DenseLoopReference.LoopBody(dense, i);
                int k = 0;
                while (k < sparse.N) { Assert.Equal(sb[k], sa[k]); k = k + 1; }
                Assert.Equal(DenseLoopReference.CleanPreheader(f, dense, i, sb),
                    IrLoopUtil.CleanPreheader(f, sparse, i, sa));
            }
            i = i + 1;
        }
        trial = trial + 1;
    }
}

[Test]
void test_sparse_cfg_skips_exception_regions_and_tiny_functions() {
    Assert.True(IrLoopUtil.BuildCfg(LoopCfgFixture.Make(1, 0)) == null);
    IrFunction f = LoopCfgFixture.Make(4, 1);
    f.ExcCount = 1;
    Assert.True(IrLoopUtil.BuildCfg(f) == null);
}

[Test]
void test_cfg_label_index_preserves_first_duplicate_and_missing_targets() {
    IrFunction f = LoopCfgFixture.Make(128, 1);
    f.Blocks[32].Label = "b1";
    LoopCfg cfg = IrLoopUtil.BuildCfg(f);
    DenseCfg dense = DenseLoopReference.BuildCfg(f);
    Assert.Equal(1, cfg.S0[127]);
    Assert.Equal(-1, cfg.S0[31]);
    int i = 0;
    while (i < cfg.N) { Assert.Equal(dense.S0[i], cfg.S0[i]); Assert.Equal(dense.S1[i], cfg.S1[i]); i = i + 1; }
    i = 0;
    while (i < cfg.Dom.Length) { Assert.Equal(dense.Dom[i], cfg.Dom[i]); i = i + 1; }
}
