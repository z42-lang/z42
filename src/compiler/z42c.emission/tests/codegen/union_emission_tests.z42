namespace Z42cEmissionUnionTests;

using Std.Harness;
using Z42.Emission;
using Z42.IR;

[Test]
void test_wide_union_requires_runtime_layout_support() {
    var result = IrDump.BuildModuleD("union U { End, Pair(int, int) } U Make() => U.End;", "union.z42", null, null);
    Assert.Equal(1, result.ErrorCount);
    Assert.True(result.DiagMsgs[0].Contains("E0501"));
}

[Test]
void test_package_union_rejects_emission_before_compiling_consumers() {
    string[] sources = new string[]{
        "U Make() => U.End;",
        "union U { End, Bytes(string) }",
    };
    string[] files = new string[]{ "consumer.z42", "union.z42" };
    CompiledModuleZ[] result = IrDump.BuildPackage(sources, files, sources.Length, null, null, false);
    Assert.Equal(0, result[0].ErrorCount);
    IrModule consumer = result[0].Module;
    Assert.Equal(0, consumer.FuncCount);
    Assert.Equal(1, result[1].ErrorCount);
    Assert.True(result[1].DiagMsgs[0].Contains("E0501"));
}

[Test]
void test_packed_union_can_be_constructed_and_matched_across_files() {
    string[] sources = new string[]{
        "U Make(int n) => U.Bytes(n); int Read(U u) => u switch { U.End => 0, U.Bytes(n) => n };",
        "union U { End, Bytes(int) }",
    };
    string[] files = new string[]{ "consumer.z42", "union.z42" };
    CompiledModuleZ[] result = IrDump.BuildPackage(sources, files, sources.Length, null, null, false);
    Assert.Equal(0, result[0].ErrorCount);
    Assert.Equal(0, result[1].ErrorCount);
    Assert.Equal(2, result[0].Module.FuncCount);
}

[Test]
void test_packed_union_storage_and_exports_require_metadata() {
    string prefix = "public union U { End, Bytes(int) } ";
    Assert.True(IrDump.BuildModuleD(prefix + "class C { public U Field; }", "field.z42", null, null).DiagMsgs[0].Contains("E0501"));
    Assert.True(IrDump.BuildModuleD(prefix + "public U Make() => U.End;", "export.z42", null, null).DiagMsgs[0].Contains("E0501"));
    Assert.True(IrDump.BuildModuleD(prefix + "int F() { var a = new U[1]; return a.Length; }", "array.z42", null, null).DiagMsgs[0].Contains("E0501"));
}
