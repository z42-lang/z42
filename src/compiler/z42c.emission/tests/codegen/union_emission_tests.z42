namespace Z42cEmissionUnionTests;

using Std.Harness;
using Z42.Emission;
using Z42.IR;

[Test]
void test_aggregate_union_allocates_extraction_slots_once_and_skips_wildcards() {
    string source = "struct P { public int X; public int Y; } union U { End, Pair(P) } "
        + "int Read(U u, int n) { while (n > 0) { if (u is U.Pair(p)) { n = n - p.X; } else { return n; } } return n; } "
        + "bool Has(U u) => u is U.Pair(_);";
    var result = IrDump.BuildModuleD(source, "union.z42", null, null);
    Assert.Equal(0, result.ErrorCount);
    IrModule module = result.Module;
    int slots = 0;
    for (int f = 0; f < module.FuncCount; f = f + 1) {
        IrFunction fn = module.Functions[f];
        for (int b = 0; b < fn.BlockCount; b = b + 1) {
            IrBlock block = fn.Blocks[b];
            for (int i = 0; i < block.InstrCount; i = i + 1) {
                if (block.Instrs[i] is StructAllocInstr allocation && allocation.TypeName == "P") {
                    Assert.Equal("Read", fn.Name);
                    Assert.Equal(0, b);
                    Assert.Equal(8, allocation.Size);
                    slots = slots + 1;
                }
            }
        }
    }
    Assert.Equal(1, slots);
}

[Test]
void test_aggregate_union_with_reference_leaf_requires_runtime_support() {
    string source = "struct R { public string Name; } struct S { public R Inner; } union U { End, Value(S) }";
    var result = IrDump.BuildModuleD(source, "union.z42", null, null);
    Assert.Equal(1, result.ErrorCount);
    Assert.True(result.DiagMsgs[0].Contains("E0501"));
}

[Test]
void test_float_and_double_union_values_use_their_scalar_layouts() {
    string source = "union Narrow { Value(float), End } union Wide { Value(double), End } "
        + "Narrow Pack(float x) => Narrow.Value(x); Wide Store(double x) => Wide.Value(x);";
    var result = IrDump.BuildModuleD(source, "union.z42", null, null);
    Assert.Equal(0, result.ErrorCount);
    IrModule module = result.Module;
    Assert.Equal(1, module.ClassCount);
    Assert.Equal("$union.Wide", module.Classes[0].Name);
    Assert.Equal(16, module.Classes[0].StructSize);
}

[Test]
void test_wide_union_allocates_exact_layout_slots_at_function_entry() {
    string source = "union U { End, Pair(int, int) } U Make(int n) { U u = U.End; while (n > 0) { u = U.Pair(n, n); n = n - 1; } return u; }";
    var result = IrDump.BuildModuleD(source, "union.z42", null, null);
    Assert.Equal(0, result.ErrorCount);
    IrModule module = result.Module;
    Assert.Equal(1, module.ClassCount);
    Assert.Equal("$union.U", module.Classes[0].Name);
    Assert.Equal(3, module.Classes[0].FieldCount);
    IrFunction make = module.Functions[0];
    int slots = 0;
    for (int b = 0; b < make.BlockCount; b = b + 1) {
        IrBlock block = make.Blocks[b];
        for (int i = 0; i < block.InstrCount; i = i + 1) {
            if (block.Instrs[i] is StructAllocInstr allocation) {
                Assert.Equal(0, b);
                Assert.Equal(12, allocation.Size);
                slots = slots + 1;
            }
        }
    }
    Assert.Equal(2, slots);
}

[Test]
void test_package_union_rejects_emission_before_compiling_consumers() {
    string[] sources = new string[]{
        "U Make() => U.End;",
        "union U { End, Bytes(string) }",
    };
    string[] files = new string[]{ "consumer.z42", "union.z42" };
    CompiledModuleZ[] result = IrDump.BuildPackage(sources, files, sources.Length, null, null, false);
    Assert.Equal(0, result[0].ErrorCount);
    IrModule consumer = result[0].Module;
    Assert.Equal(0, consumer.FuncCount);
    Assert.Equal(1, result[1].ErrorCount);
    Assert.True(result[1].DiagMsgs[0].Contains("E0501"));
}

[Test]
void test_wide_union_can_be_constructed_and_matched_across_files() {
    string[] sources = new string[]{
        "namespace Demo; U Make(int n) => U.Pair(n, n); int Read(U u) => u switch { U.End => 0, U.Pair(a, b) => a + b };",
        "namespace Demo; union U { End, Pair(int, int) }",
    };
    string[] files = new string[]{ "consumer.z42", "union.z42" };
    CompiledModuleZ[] result = IrDump.BuildPackage(sources, files, sources.Length, null, null, false);
    Assert.Equal(0, result[0].ErrorCount);
    Assert.Equal(0, result[1].ErrorCount);
    Assert.Equal(2, result[0].Module.FuncCount);
    Assert.Equal("$union.Demo.U", result[1].Module.Classes[0].Name);
}

[Test]
void test_packed_union_storage_and_exports_require_metadata() {
    string prefix = "public union U { End, Bytes(int) } ";
    Assert.True(IrDump.BuildModuleD(prefix + "class C { public U Field; }", "field.z42", null, null).DiagMsgs[0].Contains("E0501"));
    Assert.True(IrDump.BuildModuleD(prefix + "public U Make() => U.End;", "export.z42", null, null).DiagMsgs[0].Contains("E0501"));
    Assert.True(IrDump.BuildModuleD(prefix + "int F() { var a = new U[1]; return a.Length; }", "array.z42", null, null).DiagMsgs[0].Contains("E0501"));
}
