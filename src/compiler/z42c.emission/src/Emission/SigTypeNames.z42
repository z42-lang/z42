namespace Z42.Emission;

using Z42.Semantics;
using Z42.IR;

// 已解析类型 → SIGS 持久化拼写（fqn-tables 5b 从 FunctionEmitter 抽出：方法签名与 extern / abstract 桩共用一份）。
// 用户声明的类 / 接口 / enum 写 FQN，构造泛型与实例化接口为 `<基名 FQN><实参…>`；基元包装名、型参等照 `Name()`。
public static class SigTypeNames {
    // unify-type-identity-fqn：**已解析类型** → 持久化文法串（泛型实参递归用；与 FunctionEmitter._sigTypeName 同口径，
    // 但入参是 Z42Type 而非 TypeExpr——实参在 Z42InstantiatedType 里已是解析好的类型对象）。
    public static string OfResolved(Z42Type t) {
        if (t == null) { return "unknown"; }
        if (t is Z42UnknownType) { return "unknown"; }
        if (t is Z42ArrayType) { return SigTypeNames.OfResolved((t as Z42ArrayType).Elem) + "[]"; }
        if (t is Z42ClassType) {
            Z42ClassType ct = t as Z42ClassType;
            if (ct.PrimCode() < 0 && ct.Namespace != "") { return ct.Fqn(); }
        }
        if (t is Z42InstantiatedInterfaceType) {   // 同 _sigTypeName：先于接口分支
            Z42InstantiatedInterfaceType tii = t as Z42InstantiatedInterfaceType;
            if (tii.Namespace != "") { return SigTypeNames.InstIface(tii); }
        }
        if (t is Z42InterfaceType) {
            Z42InterfaceType it = t as Z42InterfaceType;
            if (it.Namespace != "") { return it.Fqn(); }
        }
        if (t is Z42InstantiatedType) {
            Z42InstantiatedType it2 = t as Z42InstantiatedType;
            Z42ClassType d = it2.Def;
            string bn = (d != null && d.PrimCode() < 0 && d.Namespace != "") ? d.Fqn() : t.Name();
            if (d != null && d.PrimCode() < 0 && d.Namespace != "") {
                string acc = bn + "<";
                int ai = 0;
                while (ai < it2.ArgCount) {
                    if (ai > 0) { acc = acc + ", "; }
                    acc = acc + SigTypeNames.OfResolved(it2.TypeArgs[ai]);
                    ai = ai + 1;
                }
                return acc + ">";
            }
        }
        // ⚠️ **不能**用 PrimModel.SurfaceName —— 那会把实参从 `Int32` 改写成 `int`，等于顺手统一了
        // SIGS 与 TYPE 的实参拼写差异，违反本 change 的裁决 D2「只 FQ 化类名成分、不动实参拼写」。
        // 原路径 `Z42InstantiatedType.Name()` 用的就是 `Name()`，此处逐字保持。
        // （实测破坏：ext 导出签名 `Kv<String, Int32>[]` 变成 `Kv<string, int>[]` ⇒
        //  generic_struct_array_cross_pkg 的 main 整个导入失效。）
        return t.Name();
    }

    // 实例化接口 → `<基名 FQN><实参…>`（实参同 OfResolved 文法）。
    public static string InstIface(Z42InstantiatedInterfaceType ii) {
        string acc = ii.Fqn() + "<";
        int ai = 0;
        while (ai < ii.ArgCount) {
            if (ai > 0) { acc = acc + ", "; }
            acc = acc + SigTypeNames.OfResolved(ii.TypeArgs[ai]);
            ai = ai + 1;
        }
        return acc + ">";
    }
}
