namespace Z42.Emission;

using Z42.Symbols;

public static class SigTypeNames {
    public static string OfResolved(Z42Type type) { return QualifiedSigTypeNames.OfResolved(type); }
    public static string Func(Z42FuncType type) { return QualifiedSigTypeNames.Func(type); }
    public static string InstIface(Z42InstantiatedInterfaceType type) { return QualifiedSigTypeNames.InstIface(type); }
}
