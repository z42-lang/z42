// IrGen 无状态低层助手（compiler-review P1-3 收官）——纯谓词/数组增长/元数据填充集中 static class。
namespace Z42.Emission;

using Z42.Semantics;

using Z42.Syntax;
using Z42.IR;

public static class IrGenFacts {

    public static int _irTypeTag(TypeExpr te) {
        if (te is NamedType) {
            string nm = (te as NamedType).Name;
            if (nm == "int" || nm == "uint") { return IrType.I32; }
            if (nm == "long" || nm == "ulong") { return IrType.I64; }
            if (nm == "bool") { return IrType.Bool; }
            if (nm == "float") { return IrType.F32; }
            if (nm == "double") { return IrType.F64; }
            if (nm == "byte" || nm == "sbyte" || nm == "short" || nm == "ushort") { return IrType.I32; }
            if (nm == "string") { return IrType.Str; }
            if (nm == "char") { return IrType.Char; }
            if (nm == "void") { return IrType.Void; }
            return IrType.Ref;   // class / interface / opaque named → Ref（镜像 C#）
        }
        if (te is ArrayType) { return IrType.Ref; }   // T[] → Ref
        return IrType.Unknown;
    }

    public static IrFunction[] _pushFunc(IrFunction[] arr, int count, IrFunction irf) {
        if (count == arr.Length) {
            IrFunction[] bigger = new IrFunction[arr.Length * 2];
            int k = 0; while (k < count) { bigger[k] = arr[k]; k = k + 1; }
            arr = bigger;
        }
        arr[count] = irf;
        return arr;
    }

    public static IrClassDesc[] _pushClass(IrClassDesc[] arr, int count, IrClassDesc cd) {
        if (count == arr.Length) {
            IrClassDesc[] bigger = new IrClassDesc[arr.Length * 2];
            int k = 0; while (k < count) { bigger[k] = arr[k]; k = k + 1; }
            arr = bigger;
        }
        arr[count] = cd;
        return arr;
    }

    // fix-call-arity-skew（zbc 1.40）：METHOD_FLAG_SRET。由 FunctionEmitter 在返回 blob 值 struct 时置位——那是全仓
    // 唯一决定 sret 调用约定的地方（`RetIsStruct = true`）。与 _methodFlags 的修饰符位**按位或**合并，不得互相覆盖。
    public static int MethodFlagSret = 8;


    public static int _methodFlags(string mods) {
        int f = 0;
        // impl-sealed-semantics-devirt：sealed 方法必是 override（简写 `sealed` == `sealed override`）→ 亦置
        // virtual 位（bit0），确保裸 `sealed` 无 override 词时虚派发位仍正确。
        if (DeclFacts._hasWord(mods, "virtual") || DeclFacts._hasWord(mods, "override") || DeclFacts._hasWord(mods, "abstract") || DeclFacts._hasWord(mods, "sealed")) { f = f | 1; }
        if (DeclFacts._hasWord(mods, "abstract")) { f = f | 2; }
        if (DeclFacts._hasWord(mods, "sealed"))   { f = f | 4; }   // bit2=sealed（METHOD_FLAG_SEALED，zbc 1.30）
        return f;
    }

    public static void _fillParamMeta(IrFunction irf, MethodDecl md, bool isInstance) {
        int off = 0; if (isInstance) { off = 1; }
        int total = md.ParamCount + off;
        string[] names = new string[total];
        int[] kinds = new int[total];
        long[] vals = new long[total];
        string[] strs = new string[total];
        if (isInstance) { names[0] = "this"; kinds[0] = 0; vals[0] = 0; strs[0] = ""; }
        int minArg = md.ParamCount;   // 逻辑：默认全必填
        bool foundDefault = false;
        int p = 0;
        while (p < md.ParamCount) {
            names[p + off] = md.Params[p].Name;
            // PR6：SIGS default_kind 已退休——参数默认值的唯一真相源是 param attr-ref `$Default`
            // 哨兵（ConstBlob，ClassDescBuilder._paramAttrRefs 写、Rust 反射读、跨包 OverloadBinder 注入）。
            // 此处只保留 minArg（首个默认值下标 = 必填数，喂 IsOptional）；kind/val/str 恒写 0/""。
            if (md.Params[p].Default != null && !foundDefault) { minArg = p; foundDefault = true; }
            kinds[p + off] = 0; vals[p + off] = 0; strs[p + off] = "";
            p = p + 1;
        }
        int paramsFrom = 255;
        if (md.ParamCount > 0 && md.Params[md.ParamCount - 1].IsParams) { paramsFrom = md.ParamCount - 1; }
        irf.MinArg = minArg; irf.ParamsFrom = paramsFrom;
        irf.ParamNames = names; irf.ParamDefaultKinds = kinds; irf.ParamDefaultVals = vals; irf.ParamDefaultStrs = strs;
    }

}