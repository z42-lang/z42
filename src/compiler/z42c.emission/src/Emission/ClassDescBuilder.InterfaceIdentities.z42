namespace Z42.Emission;

using Std.Collections;
using Z42.IR;
using Z42.Symbols;
using Z42.Syntax;

public sealed partial class ClassDescBuilder {
    // Use the existing private TYPE attribute channel so old packages and readers
    // can keep their legacy interface table. A partial closure cannot replace that table.
    private void _addClosedInterfaceIdentities(IrClassDesc cd, ClassDecl declaration, Z42ClassType owner) {
        if (owner == null || owner.InterfaceCount == 0 || (owner.IsPartial && declaration.TypeParams.Count == 0)) {
            return;
        }
        SymbolTable symbols = this._scope();
        var pending = new List<Z42InterfaceType>();
        int i = 0;
        while (i < declaration.BaseCount) {
            var parent = symbols.ResolveTypeP(declaration.Bases[i],
                declaration.TypeParams.Names, declaration.TypeParams.Count) as Z42InterfaceType;
            if (parent != null) { pending.Add(parent); }
            i = i + 1;
        }
        // An impl block contributes a name without a bound reference in this declaration.
        if (pending.Count != owner.InterfaceCount) { return; }

        var names = new List<string>();
        var parameters = this._interfaceParameterMarkers(declaration.TypeParams.Names,
            declaration.TypeParams.Count, owner.Fqn());
        var seen = new StrMap();
        bool hasConstructed = false;
        i = 0;
        while (i < pending.Count) {
            Z42InterfaceType iface = pending[i];
            i = i + 1;
            var instance = iface as Z42InstantiatedInterfaceType;
            if (instance == null && iface.TypeParamCount > 0) { return; }
            Z42Type template = parameters == null ? iface : TypeSubst.Apply(iface, parameters);
            if (!IfaceSlotKeys.IsClosed(template)) { return; }
            string name = LayoutKey.Of(template);
            if (name == "") { return; }
            if (seen.ContainsKey(name)) { continue; }
            seen.Put(name, "1");
            names.Add(name);
            hasConstructed = hasConstructed || instance != null;
            if (!this._appendClosedInterfaceParents(symbols, iface, pending)) { return; }
        }
        if (!hasConstructed) { return; }
        string tag = parameters == null ? IrImplementedInterface.Closed : IrImplementedInterface.Template;
        this._emitInterfaceNames(cd, names, tag);
    }

    private bool _appendClosedInterfaceParents(SymbolTable symbols, Z42InterfaceType iface, List<Z42InterfaceType> pending) {
        int i = 0;
        while (i < iface.BaseCount) {
            // The complete closure needs the original declaration's bound reference.
            if (i >= iface.BaseRefs.Length || !(iface.BaseRefs[i] is ResolvedTypeExpr)) { return false; }
            Z42InterfaceType parent = InterfaceClosure.BaseAt(symbols, iface, i);
            if (parent == null) { return false; }
            pending.Add(parent);
            i = i + 1;
        }
        return true;
    }

    private NameListMap _interfaceParameterMarkers(string[] names, int count, string owner) {
        if (count == 0) { return null; }
        var markers = new Z42Type[count];
        int i = 0;
        while (i < count) {
            markers[i] = new Z42ClassType("$cta:" + i.ToString() + "@" + owner, false, "");
            i = i + 1;
        }
        return new NameListMap(names, count, markers);
    }

    private void _emitInterfaceNames(IrClassDesc cd, List<string> names, string tag) {
        var attrs = new IrAttrRef[cd.AttrCount + names.Count];
        int i = 0;
        while (i < cd.AttrCount) { attrs[i] = cd.Attrs[i]; i = i + 1; }
        int j = 0;
        while (j < names.Count) {
            attrs[i + j] = new IrAttrRef(tag, names[j]);
            j = j + 1;
        }
        cd.Attrs = attrs;
        cd.AttrCount = attrs.Length;
    }
}
