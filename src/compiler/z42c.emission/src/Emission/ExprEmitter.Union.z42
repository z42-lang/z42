namespace Z42.Emission;

using Z42.IR;
using Z42.IR.BinaryFormat;
using Z42.Semantics;
using Z42.Symbols;

public sealed partial class ExprEmitter {
    internal TypedReg _emitUnionConstruction(BoundCall call, TypedReg storage = null) {
        UnionStorageLayout layout = UnionCaseSymbol.UnionOf(call.Type()).UnionStorage;
        UnionPayloadLayout branch = layout.Cases[call.UnionCase.Tag];
        var parts = new UnionValueParts(layout, branch.ReferenceCount);
        parts.Cells[0] = this._unionI64((long)call.UnionCase.Tag);
        for (int i = 0; i < call.ArgCount; i = i + 1) {
            int slot = call.UnionArgumentOrder[i];
            UnionStorageField field = branch.Fields[slot];
            TypedReg value = this.Emit(call.Args[slot]);
            this._packUnionField(parts, layout.PayloadOffset + field.Offset, field, value);
        }
        return this._materializeUnion(parts, call.Type(), layout, storage);
    }

    internal TypedReg _emitUnionTagMatch(TypedReg packed, Z42Type type, UnionStorageLayout layout, int tag) {
        TypedReg word = layout.Size > 8 ? this._readUnionCell(packed, type, layout, 0) : packed;
        TypedReg actual = this._unionMask(word, layout.TagBytes);
        TypedReg result = this._ctx.Alloc(IrType.Bool);
        this._ctx.Emit(new EqInstr(result, actual, this._unionI64((long)tag)));
        return result;
    }

    internal TypedReg _emitUnionField(TypedReg packed, Z42Type type, UnionStorageLayout layout, UnionStorageField field) {
        int offset = layout.PayloadOffset + field.Offset;
        if (field.Nested != null) {
            return this._unpackUnionAggregate(packed, type, layout, offset, field);
        }
        if (StructLeafKind.IsRef(field.Kind)) {
            return this._readUnionReference(packed, field.ReferenceIndex, this._ctx.ToIrType(field.Type));
        }
        return this._unpackUnionScalar(packed, type, layout, offset, field);
    }

    private TypedReg _unpackUnionScalar(TypedReg packed, Z42Type type, UnionStorageLayout layout,
                                       int offset, UnionStorageField field) {
        int width = layout.CellWidth();
        TypedReg word = this._readUnionCell(packed, type, layout, offset / width);
        TypedReg shifted = this._shiftUnionRight(word, offset % width);
        int tag = this._ctx.ToIrType(field.Type);
        TypedReg result = this._ctx.Alloc(tag);
        if (tag == IrType.Bool) {
            TypedReg bits = this._unionMask(shifted, field.Size);
            this._ctx.Emit(new EqInstr(result, bits, this._unionI64(1L)));
        } else if (tag == IrType.F32 || tag == IrType.F64) {
            string intrinsic = tag == IrType.F32 ? "__single_from_bits" : "__double_from_bits";
            this._ctx.Emit(new BuiltinInstr(result, intrinsic, new TypedReg[] { shifted }, 1));
        } else {
            // Character conversion checks the code point, so remove adjacent fields first.
            TypedReg bits = tag == IrType.Char ? this._unionMask(shifted, field.Size) : shifted;
            this._ctx.Emit(new ConvertInstr(result, bits));
        }
        return result;
    }

    private void _mergeUnionBits(TypedReg[] cells, int width, int offset, TypedReg value, int bytes) {
        int at = offset / width;
        int shift = (offset % width) * 8;
        TypedReg bits = this._unionMask(value, bytes);
        if (shift != 0) {
            TypedReg shifted = this._ctx.Alloc(IrType.I64);
            this._ctx.Emit(new ShlInstr(shifted, bits, this._unionI64((long)shift)));
            bits = shifted;
        }
        if (cells[at] != null) {
            TypedReg joined = this._ctx.Alloc(IrType.I64);
            this._ctx.Emit(new BitOrInstr(joined, cells[at], bits));
            bits = joined;
        }
        cells[at] = bits;
    }

    private TypedReg _shiftUnionRight(TypedReg word, int bytes) {
        if (bytes == 0) { return word; }
        TypedReg shifted = this._ctx.Alloc(IrType.I64);
        this._ctx.Emit(new ShrInstr(shifted, word, this._unionI64((long)bytes * 8L)));
        return shifted;
    }

    private TypedReg _materializeUnion(UnionValueParts parts, Z42Type type, UnionStorageLayout layout,
                                       TypedReg storage = null) {
        if (layout.Size <= 8) { return parts.Cells[0]; }
        if (storage == null) { storage = this._allocWideUnion(type, layout); }
        if (layout.ReferenceCount == 0) {
            this._writeUnionCells(storage, type, layout, parts.Cells);
        } else {
            this._storeReferenceUnion(storage, parts);
        }
        return storage;
    }

    private void _writeUnionCells(TypedReg storage, Z42Type type, UnionStorageLayout layout, TypedReg[] cells) {
        string name = PackedUnion.StorageName(UnionCaseSymbol.UnionOf(type).Fqn());
        int kind = Tag.FromName(layout.CellTypeName());
        TypedReg zero = null;
        for (int i = 0; i < cells.Length; i = i + 1) {
            TypedReg value = cells[i];
            if (value == null) {
                if (zero == null) { zero = this._unionI64(0L); }
                value = zero;
            }
            this._ctx.Emit(new StructFieldSetPrimInstr(storage, name, new int[] { i }, kind, value));
        }
    }

    private TypedReg _readUnionCell(TypedReg storage, Z42Type type, UnionStorageLayout layout, int cell) {
        if (layout.Size <= 8) { return storage; }
        TypedReg result = this._ctx.Alloc(IrType.I64);
        if (layout.ReferenceCount > 0) {
            this._ctx.Emit(new BuiltinInstr(result, "__union_cell", new TypedReg[] { storage, this._unionI64((long)cell) }, 2));
            return result;
        }
        string name = PackedUnion.StorageName(UnionCaseSymbol.UnionOf(type).Fqn());
        this._ctx.Emit(new StructFieldGetPrimInstr(result, storage, name, new int[] { cell }, Tag.FromName(layout.CellTypeName())));
        return result;
    }

    internal TypedReg _allocWideUnion(Z42Type type, UnionStorageLayout layout) {
        string name = PackedUnion.StorageName(UnionCaseSymbol.UnionOf(type).Fqn());
        TypedReg slot = this._ctx.Alloc(IrType.Ref);
        this._ctx.Emit(new StructAllocInstr(slot, name, layout.Size));
        return slot;
    }

    internal TypedReg _emitMatchSubject(BoundExpr expr) {
        return this._snapshotUnion(this.Emit(expr), expr.Type());
    }

    internal TypedReg _snapshotUnion(TypedReg value, Z42Type type) {
        if (UnionCaseSymbol.UnionOf(type) == null) { return value; }
        UnionStorageLayout layout = UnionStorageLayout.WideFor(type);
        if (layout != null) {
            TypedReg slot = this._allocWideUnion(type, layout);
            this._ctx.Emit(new StructCopyInstr(slot, value, layout.Size));
            return slot;
        }
        TypedReg copy = this._ctx.Alloc(IrType.I64);
        this._ctx.Emit(new CopyInstr(copy, value));
        return copy;
    }

    private TypedReg _unionPayloadBits(TypedReg value, Z42Type type) {
        TypedReg result = this._ctx.Alloc(IrType.I64);
        int tag = this._ctx.ToIrType(type);
        if (tag == IrType.F32 || tag == IrType.F64) {
            string intrinsic = tag == IrType.F32 ? "__single_to_bits" : "__double_to_bits";
            this._ctx.Emit(new BuiltinInstr(result, intrinsic, new TypedReg[] { value }, 1));
            return result;
        }
        if (tag != IrType.Bool) {
            this._ctx.Emit(new ConvertInstr(result, value));
            return result;
        }
        string yes = this._ctx.Fresh("union_bool_true");
        string no = this._ctx.Fresh("union_bool_false");
        string end = this._ctx.Fresh("union_bool_end");
        this._ctx.EndBlock(new BrCondTerm(value, yes, no));
        this._ctx.StartBlock(yes);
        this._ctx.Emit(new ConstI64Instr(result, "1"));
        this._ctx.EndBlock(new BrTerm(end));
        this._ctx.StartBlock(no);
        this._ctx.Emit(new ConstI64Instr(result, "0"));
        this._ctx.EndBlock(new BrTerm(end));
        this._ctx.StartBlock(end);
        return result;
    }

    private TypedReg _unionMask(TypedReg word, int bytes) {
        if (bytes == 8) { return word; }
        long mask = (1L << (bytes * 8)) - 1L;
        TypedReg result = this._ctx.Alloc(IrType.I64);
        this._ctx.Emit(new BitAndInstr(result, word, this._unionI64(mask)));
        return result;
    }

    private TypedReg _unionI64(long value) {
        TypedReg result = this._ctx.Alloc(IrType.I64);
        this._ctx.Emit(new ConstI64Instr(result, value.ToString()));
        return result;
    }
}
