// 共享 codegen 状态 + 低层助手（port-z42c-codegen，CG-1E 前 refactor）。
// z42 无 partial class（C# 把 FunctionEmitter 拆 17 文件不可移植）→ 抽公共状态到 EmitContext：
// FunctionEmitter（函数入口/语句/控制流）与 ExprEmitter（表达式）共用同一个 ctx，
// 各自文件控制在行数限内。受限写法：public 字段 + 集合 typed array+count。
namespace Z42.Emission;

using Z42.Syntax;
using Z42.Semantics;

using Z42.Core;
using Z42.IR;
using Z42.Optimization;

public sealed class EmitContext {
    public SymbolTable Symbols;
    public IrGen       Gen;          // 字符串 intern
    public StrMap      Locals;       // name → TypedReg（object 下行）
    public StrMap      Fields;       // 实例方法自身字段名集合（裸 ident → field_get reg0）
    public string      OwnerStructName; // add-struct-value-semantics A-use：当前方法所属类若为 **blob 值 struct**，
                                        // 存其短名（供 `this.x`/裸字段 access 翻转到 StructFieldGet/SetPrim）；否则 ""。
    public string      OwnerClassName;  // add-struct-heap-inline (P3b)：当前实例方法所属类短名（含非-struct class；
                                        // 供裸 `pt`/`pt.x` 内联 struct 字段 access 解析对象相对 offset）；静态/无 owner 为 ""。
    public Z42ClassType OwnerCt;        // fqn-tables 5d：当前方法所属类的**类型对象**（无 owner 为 null）——限定 OwnerStructName /
                                        // OwnerClassName 用它的声明 ns，不再按短名查图。
    // add-struct-value-semantics A-use：当前函数返回 blob 值 struct 时走 **sret** 约定——caller 预留返回
    // blob 作隐藏末尾参数传入，callee `return s` → StructCopy(SretReg, s)+ret void。RetIsStruct 置位时
    // SretReg=末尾参数寄存器、RetStructSize=blob 字节数。
    public bool        RetIsStruct;
    public int         RetStructSize;
    public TypedReg    SretReg;
    public StrMap      ReadonlyFields; // add-readonly-fields-opt：其中声明为 readonly 的字段名子集（裸 ident field_get 打 Readonly 标志）
    // fix-autoprop-getonly-backing-write：本类**实例属性**名 → 后备字段名（auto-property 为 `__prop_X`；
    // 计算属性无存储 → ""）。属性在符号表以**源名**登记 FieldSymbol 供类型检查，但存储叫 __prop_X ——
    // 裸 ident 若走 Fields 的 field_get/field_set 就打在不存在的字段上（读回 Null / 写进虚空）。
    // 有了这张表，裸 `X` 与 `this.X` 一样走访问器：读 VCall get_X；写 VCall set_X，无 setter 则落 __prop_X。
    // 静态属性不入表（其访问不经 reg0），维持既有行为。
    public StrMap      InstProps;
    public StrMap      InstPropHasSet;   // 上表中额外有 set_X 的子集
    public StrMap      ConstLocals;    // add-const-keyword：局部 const 名 → ConstValue（裸 ident 引用替换为字面量；存储正常发射，全替换后 DCE 清理）
    public IrBlock[]   Blocks;   public int BlockCount;
    public IrInstr[]   Cur;      public int CurCount;     // 当前块指令累积
    public string      CurLabel; public bool Ended;       // 当前块已终结
    public int         NextReg;  public int MaxReg;  public int LabelSeq;
    public string[]    ContLabels; public string[] BreakLabels; public int LoopDepth;  // 循环标签栈
    // fix-finally-nonlocal-exit：每层「循环/switch」入栈时的 finally 栈深，break/continue 各一个——
    // break 目标 = 本层结束（floor=本层入栈深）；continue 目标对 switch 是**外层循环**（floor 继承外层），
    // 故二者可不同。退出该层时只跑 floor..当前深 之间的 finally（跨越本层边界的那些）。
    public int[]       BreakFinFloor; public int[] ContFinFloor;
    public int[]       RegTags;   public int RegTagCount;   // reg id → IrType 标签（REGT，byte-identical）
    public IrLineEntry[] Lines;  public int LineCount;  public int LastLine;   // DBUG 行表（同行去重，镜像 C# TrackLine）
    private string _tlPath; private string _tlBase;   // TrackLine 的文件名缓存：同一函数的语句几乎都来自同一文件
    public string Ns;   // 根命名空间（""=无；名字限定 BP-0，镜像 C# QualifyName）
    public DependencyIndex Deps;       // 跨包调用索引（CI-4；null=无依赖）
    public StrMap ImportedClassNs;     // imported 短类名 → ns（StrBox；IC-1：VCall 依赖追踪 + ObjNew FQ；**含本包跨-ns 自有类**，G17b）
    public string[] ActiveNs; public int ActiveNsCount;  // path C：本 CU 活跃命名空间集（usings + 本 ns，prelude-first）→ 静态调用 using-scoped 消歧
    public StrMap LocalClasses;        // 本包**自有声明**类名集（G18 修正：ChainHasMethod 反劫持守卫须仅认本地类，镜像 C# ClassRegistry）
    public IrExcEntry[] ExcTable; public int ExcCount;       // 异常表（port-z42c-try）
    public string CurFnName;                                  // lift 命名用（port-z42c-closures）
    public int LambdaIdx;                                     // 本函数 lambda 计数（镜像 NextLambdaIndex）
    public bool InLambdaEnv;                                  // lift env 版：BoundCapturedIdent → array_get env(reg0)
    public string[] CaptureNames; public int CaptureNameCount;  // 当前 lifted lambda 的捕获名（env 布局序）→ 嵌套 lambda 解析外层捕获
    public StrMap LocalFnNames;     // impl-local-fn-l2：局部函数 local 名 → lifted 名（free call emit 改写）

    public EmitContext(SymbolTable symbols, IrGen gen) {
        this._tlPath = null; this._tlBase = "";
        this.Symbols = symbols; this.Gen = gen;
        this.Locals = new StrMap(); this.Fields = new StrMap(); this.ReadonlyFields = new StrMap();
        this.InstProps = new StrMap(); this.InstPropHasSet = new StrMap();
        this.OwnerStructName = "";
        this.OwnerClassName = "";
        this.OwnerCt = null;
        this.RetIsStruct = false; this.RetStructSize = 0; this.SretReg = null;
        this.ConstLocals = new StrMap();
        this.Blocks = new IrBlock[4]; this.BlockCount = 0;
        this.NextReg = 0; this.MaxReg = 0; this.LabelSeq = 0;
        this.ContLabels = new string[4]; this.BreakLabels = new string[4];
        this.BreakFinFloor = new int[4]; this.ContFinFloor = new int[4]; this.LoopDepth = 0;
        this.RegTags = new int[8]; this.RegTagCount = 0;
        this.Lines = new IrLineEntry[8]; this.LineCount = 0; this.LastLine = 0;
        this.Ns = "";
        this.Deps = null;
        this.ImportedClassNs = null;
        this.ActiveNs = null; this.ActiveNsCount = 0;
        this.ExcTable = new IrExcEntry[2]; this.ExcCount = 0;
        this.CurFnName = ""; this.LambdaIdx = 0; this.InLambdaEnv = false;
        this.CaptureNames = new string[0]; this.CaptureNameCount = 0;
        this.LocalFnNames = new StrMap();
    }

    public void AddExc(IrExcEntry e) {
        if (this.ExcCount == this.ExcTable.Length) {
            IrExcEntry[] b = new IrExcEntry[this.ExcTable.Length * 2];
            int k = 0; while (k < this.ExcCount) { b[k] = this.ExcTable[k]; k = k + 1; }
            this.ExcTable = b;
        }
        this.ExcTable[this.ExcCount] = e;
        this.ExcCount = this.ExcCount + 1;
    }


    // 类名限定（镜像 C# QualifyClassName）：imported 类 → 其原 ns 前缀；否则按模块 ns 限定。
    public string QualifyClass(string name) {
        if (this.ImportedClassNs != null && this.ImportedClassNs.ContainsKey(name)) {
            StrBox b = this.ImportedClassNs.Get(name) as StrBox;
            if (b != null) { return b.Value + "." + name; }
        }
        return this.Qualify(name);
    }

    // fqn-tables 5d：按**类型对象**限定 —— `name` 是该类型在 IR 里的名字（短名 / `Name$N` / 实例化布局名，
    // 由调用方给，原样保留），ns 取类型自己的声明 ns。发射端拿到的短名大多来自已解析类型（导入成员签名里的接收者
    // 类型等），按短名查「短名 → ns」图会撞同短名的别的类（探针实测：`Std.Scripting.List` 遮住 `Std.Collections.List`、
    // `Std.Json` 里 `Object` 被限定成 `Std.Json.Object`）。类型没有 ns（全局 ns 类型、兜底合成类型）时回落 QualifyClass。
    public string QualifyType(Z42Type t, string name) {
        if (EmitContext.BaseHasDot(name)) { return name; }   // 调用方给的已是限定名（源码写的 `Std.Exception` 等）
        string ns = EmitContext.DeclNsOf(t);
        return ns != "" ? ns + "." + name : this.QualifyClass(name);
    }

    // struct / class **布局名**（StructLayout 的键：短名 / `Name$N` / 实例化名）的限定：ns 取算出该布局的那个类
    // （`StructLayout.OwnerOf`），与布局同源；布局表不认识的名字回落 QualifyClass。
    // 只限定基名、实参原样（`Pair<P2,int>` → `Demo.Pair<P2,int>`；实参可能本身是带点的 FQN）。
    public string QualifyLayout(string layoutName) {
        int lt = layoutName.IndexOf('<');
        string baseN = lt < 0 ? layoutName : layoutName.Substring(0, lt);
        string suffix = lt < 0 ? "" : layoutName.Substring(lt, layoutName.Length - lt);
        Z42ClassType o = this.Gen != null && this.Gen.Layouts != null ? this.Gen.Layouts.OwnerOf(baseN) : null;
        if (o == null) { return this.QualifyClass(baseN) + suffix; }
        return this.QualifyType(o, baseN) + suffix;
    }

    // **本 CU 源码里写下的**类型名（`[SymAvailable]` 的 owner、属性名等）的限定：按本 CU 作用域解析（外围 ns → FQN →
    // using → prelude，同 `SymbolTable.GetClass`），ns 取解析到的类型；解析不到回落 QualifyClass。
    // ⚠️ 只给源码写的名字用——从已解析类型拿到的短名要用 QualifyType（作用域里同短名的可能是别的类）。
    public string QualifySource(string name) {
        if (EmitContext.BaseHasDot(name) || this.Symbols == null) { return this.QualifyClass(name); }
        Z42ClassType ct = this.Symbols.GetClass(name);
        if (ct != null) { return this.QualifyType(ct, name); }
        Z42InterfaceType it = this.Symbols.GetInterface(name);
        if (it != null) { return this.QualifyType(it, name); }
        string ek = this.Symbols.EnumKey(name);
        if (ek != null) { return ek; }
        return this.QualifyClass(name);
    }

    // 名字的**基名部分**（`<` 之前）是否已带 ns —— 实参里的点不算。
    public static bool BaseHasDot(string name) {
        int lt = name.IndexOf('<');
        int dot = name.IndexOf('.');
        return dot >= 0 && (lt < 0 || dot < lt);
    }

    // 类型的声明 ns（类 / 构造泛型的定义 / 接口 / 实例化接口 / enum）；其余（基元、型参、数组、未知）为 ""。
    public static string DeclNsOf(Z42Type t) {
        if (t == null) { return ""; }
        if (t is Z42InstantiatedType) {
            Z42ClassType d = (t as Z42InstantiatedType).Def;
            return d == null ? "" : d.Namespace;
        }
        if (t is Z42ClassType) {
            Z42ClassType ct = t as Z42ClassType;
            return ct.PrimCode() >= 0 ? "" : ct.Namespace;
        }
        if (t is Z42InterfaceType) { return (t as Z42InterfaceType).Namespace; }
        return "";
    }

    // is / as / cast 的目标类型名限定（fix-boxed-primitive-is-as）：基元别名（string/int/…）→
    // FQ 包装类（Std.String / Std.Int32 …），否则 QualifyClass。基元关键字不该被当前 ns 限定
    // ——`QualifyClass("string")` 曾无 imported 命中 → 误加当前 ns 前缀（"I.string"），致
    // `is/as <prim>` 运行时永不匹配。
    public string QualifyTypeName(string name) {
        if (name == "object") { return "Std.Object"; }   // 万物基类别名（不走 ns 限定）
        string w = EmitContext._primWrapper(name);
        if (w != name) { return "Std." + w; }   // 是基元别名 → FQ 包装类
        return this.QualifyClass(name);
    }

    // receiver 类链是否自有该方法（IC-1 反劫持守卫）。**仅本地声明类**——镜像 C#
    // ReceiverChainHasMethod 走 codegen `ClassRegistry`（只含本包声明/编译的类，不含 imported）。
    // 非本地类（imported / 外部，不在 LocalClasses）→ 停止返回 false，交由 DepIndex instance 捷径
    // 走 FQ Call（`Ns.Class.Method`）：①imported receiver（z42c.syntax `_diags.Error` → `Z42.Core.
    // DiagnosticBag.Error`）。本地类（含本包跨-ns 自有类如 z42c.ir BinaryFormat 段）→ 认 vtable-owned
    // → VCall，不误劫持到同名外部方法（G18 修正：原误用含自有跨-ns 类的 ImportedClassNs → ByteWriter.
    // ToHex 被劫持到 Std.Numerics.BigInt.ToHex 等虚假 DEPS）。
    public bool ChainHasMethod(string clsName, string method0) {
        // add-iface-return-bridge：调用点传进来的是 `MethodSymbol.CallKey()`，被桥接的方法带
        // `$struct` 后缀；而 `Methods` 映射键仍是 `RegKey`（裸名）⇒ 必须先剥回来，否则本该
        // 「自有」的方法查不到、IC-1 反劫持守卫（调用方的 `owns`）静默失效。
        string method = MethodSymbol.StripCallKey(method0);
        // 泛型实例化名（List<string>）→ 裸名（List）查 LocalClasses/SymbolTable。
        string bare = clsName;
        int bi = 0;
        bool foundAngle = false;
        while (bi < bare.Length && !foundAngle) {
            if (bare.CharAt(bi) == '<') { bare = bare.Substring(0, bi); foundAngle = true; }
            bi = bi + 1;
        }
        // IC-3 prim→wrapper：prim 别名（"string"）→ 包装类名（"String"）再查 LocalClasses
        // 镜像 C# ReceiverChainHasMethod 经 QualifyClassName 把 prim 映射到 "Std.String" 等
        // FQ 类名在 ClassRegistry 查找；z42c 用短名 LocalClasses，故只需 bare→wrapper 映射。
        string lookup = EmitContext._primWrapper(bare);
        if (!this.Symbols.HasClass(lookup)) { return false; }
        Z42ClassType ct = this.Symbols.GetClass(lookup);
        // 入口按名字查一次，之后每跳走句柄（`_nextBase`）。此前每跳都按 `BaseName` 短名重查 ——
        // 跨 ns 同短名（`A.Foo : B.Foo`）会查回自己，靠 32 跳上限才停下。
        int hops = 0;
        while (ct != null) {
            if (this.LocalClasses == null || !this.LocalClasses.ContainsKey(ct.Name())) { return false; }   // 非本地声明类 → 不算 vtable-owned
            if (ct.Methods.ContainsKey(method)) { return true; }
            if (!ct.HasBase || ct.BaseName == "") { return false; }
            ct = this._nextBase(ct);
            hops = SymbolTable.NextBaseHop(hops);
        }
        return false;
    }

    // 基类链上一跳：先走句柄（`BaseOf`）。此前按 `BaseName` 字符串 `GetClass` —— 那是在**调用方** CU 的作用域里
    // 解析**声明方**写的短名，声明方的 `using` 在这里不可得（z42.net 里 `: Stream` 的类被别的 ns 调用时）⇒ 落裸名回落。
    // 句柄没绑上（泛型基 `Bag<T>` 的 `_refOfClass` 不剥实参 ⇒ `Base == 0`）时保留原路径：剥尖括号按名字查。
    private Z42ClassType _nextBase(Z42ClassType ct) {
        Z42ClassType nx = this.Symbols.BaseOf(ct);
        if (nx != null) { return nx; }
        string bare = ct.BaseName;
        int bi = 0;
        while (bi < bare.Length) { if (bare.CharAt(bi) == '<') { bare = bare.Substring(0, bi); bi = bare.Length; } else { bi = bi + 1; } }
        if (!this.Symbols.HasClass(bare)) { return null; }
        return this.Symbols.GetClass(bare);
    }

    // receiver 静态类型的该方法是否**虚**（virtual / abstract / 经 override 参与 vtable）。
    // 跨 zpkg 具体基类 override 的根因修复：imported 类走 ChainHasMethod 恒 false → 落 DepIndex
    // instance 直呼捷径（FQ Call `Ns.Base.M`），把基类实现**编译期钉死** → 子类 override 永不
    // 生效（`BuildHooks h = new ProjectHooks(); h.BeforeAssets()` 只跑基类 no-op）。虚方法必须
    // VCall 交由运行时按接收者实际 type_desc.vtable 派发。此处独立于 ChainHasMethod（后者刻意
    // 只认本地类做反劫持），专判「imported 虚方法」这一必须 VCall 的子集。
    //
    // imported 类的 OwnMethod*（TSIG 已展开继承方法到每个类）直接携带 virtual/abstract flag，
    // 故查接收者自身 Z42ClassType 即可命中「接收者静态类型 = 基类本身」的主场景；再沿 BaseName
    // 走一次链（经 Symbols）兜住「静态类型是某中间类、方法虚自更上层」。prim 接收者（string/int，
    // Type() 非 Z42ClassType）→ false → 仍走既有 prim 派发，不受影响。
    public bool ReceiverMethodIsVirtual(Z42Type recvType, string method0) {
        // add-iface-return-bridge：同 ChainHasMethod —— 查的是符号表里的方法（键=RegKey），
        // 而调用点给的是 CallKey()。不剥后缀 ⇒ 被桥接的 imported 虚方法被判成非虚 ⇒ 落 DepIndex
        // 直呼捷径 ⇒ 子类 override 永不生效（fix-crosspkg-virtual-override 那条 bug 的形状）。
        string method = MethodSymbol.StripCallKey(method0);
        Z42ClassType ct = recvType as Z42ClassType;
        int hops = 0;
        while (ct != null) {
            int i = 0;
            while (i < ct.OwnMethodCount) {
                string nm = ct.OwnMethodNames[i];
                // OwnMethodNames 可能是 arity 后缀键（"M$1"）；bare 前缀匹配。
                bool hit = nm == method;
                if (!hit && nm.Length > method.Length && nm.StartsWith(method)
                    && nm.CharAt(method.Length) == '$') { hit = true; }
                if (hit && (ct.OwnMethodIsVirtual[i] || ct.OwnMethodIsAbstract[i])) { return true; }
                i = i + 1;
            }
            if (!ct.HasBase || ct.BaseName == "") { return false; }
            if (this.Symbols == null) { return false; }
            ct = this._nextBase(ct);
            if (ct == null) { return false; }
            hops = SymbolTable.NextBaseHop(hops);
        }
        return false;
    }

    // ── add-sealed-devirt：基于 sealed 的去虚化 ──────────────────────────────
    // devirt 是否启用（Opt.Devirt 位；Gen.OptSet 由 IrGen.Generate 顶设）。
    public bool DevirtEnabled() {
        if (this.Gen == null) { return false; }
        return Opt.Has(this.Gen.OptSet, Opt.Devirt);
    }

    // receiver 静态类型若是**可去虚化候选类**返回其 Z42ClassType，否则 null。
    // 「候选」= 可限定（本地/imported）类——不要求整类 sealed、不再排除泛型（extend-sealed-devirt-more ②）。
    // 是否真能去虚化由 ResolveSealedTarget 在声明点判定 `classSealed || 方法级 sealed`（sealed override
    // 使非 sealed 类上的 sealed 方法也唯一）。泛型实例（`Box<int>`，Z42InstantiatedType）解包到 `.Def`——
    // 泛型是类型擦除 + 条件 arity-mangle，目标名走 `_classShortName`（Name$N or Name）逐字节匹配 IrGen。
    // 调用方把本类 IsSealed 作 classSealed 传入：sealed 类无条件命中（原 add-sealed-devirt 行为），
    // 非 sealed 类只在方法本身 sealed 时命中。
    public Z42ClassType DevirtReceiverClass(Z42Type recvType) {
        Z42ClassType ct = recvType as Z42ClassType;
        if (ct == null) {
            Z42InstantiatedType it = recvType as Z42InstantiatedType;   // Box<int> → 解包定义类 Box
            if (it != null) { ct = it.Def; }
        }
        if (ct == null) { return null; }
        // extend-sealed-devirt-imported：本地（QualifyClass=当前 ns）或 imported（QualifyClass 经
        // ImportedClassNs=源 ns）——两者 QualifyClass 都能给出与发射一致的 FQ；两者皆非则不去虚化。
        if (!this._devirtQualifiable(ct)) { return null; }
        return ct;
    }

    // instance-call-by-receiver：prim 接收者（`string` / `int` …，OwnerClass 是关键字小写）的包装类（`Std.String` …），
    // 仅当它是**导入**类时返回（编译 z42.core 自身时包装类是本地类，交给本地路径）。
    public Z42ClassType ImportedPrimWrapperClass(string ownerClass) {
        if (this.Symbols == null || ownerClass == null || ownerClass == "") { return null; }
        Z42ClassType w = this.Symbols.GetClass(TypeFactsTc._primWrapper(ownerClass));
        if (w == null || !w.IsImported) { return null; }
        return w;
    }

    // 类的 IR 短名（镜像 IrGen._classIrShortName）：泛型类若以 `Name$N` 键注册（同名多 arity 重载）→ 返回
    // `Name$N`，否则裸 `Name`。去虚化目标名 + ImportedClassNs 查键都用它，逐字节匹配 IrGen 发射。
    private string _classShortName(Z42ClassType ct) {
        if (ct.GenericParamCount > 0) {
            string mk = ct.Name() + "$" + ct.GenericParamCount.ToString();
            if (this.Symbols != null && this.Symbols.HasClass(mk)) { return mk; }
        }
        return ct.Name();
    }

    // 去虚化目标名可否用 `QualifyClass(shortName)+"."+RegKey` 精确构造：本地声明类（LocalClasses 裸名键，
    // QualifyClass=当前 ns）或 imported 类（ImportedClassNs 条件 mangle 短名键，QualifyClass=源 ns）。
    // 两者皆非 → QualifyClass 会误加当前 ns → 不可去虚化（回落 VCall）。非泛型下 `_classShortName==Name` →
    // 与旧 `_devirtQualifiable(name)` 逐字节等价（零回归）。
    private bool _devirtQualifiable(Z42ClassType ct) {
        if (this.LocalClasses != null && this.LocalClasses.ContainsKey(ct.Name())) { return true; }
        if (this.ImportedClassNs != null && this.ImportedClassNs.ContainsKey(this._classShortName(ct))) { return true; }
        return false;
    }

    // 全限定名 fq 是否为**依赖包已发射的真实函数**（DependencyIndex.AddModule 把每个跨包函数按其
    // 完整 FQ 注册进 Statics，行 110）。imported sealed 去虚化用它排除「TSIG 展平的继承方法」——
    // 派生类 Methods 命中但本类未声明时，`QualifyClass(派生类)+key` 不在 Deps → 回落基链上溯。
    private bool _depHasFunction(string fq) {
        if (this.Deps == null) { return false; }
        int i = this.Deps.Statics.Find(fq);
        if (i < 0) { return false; }
        DepCallEntry e = this.Deps.Statics.ValAt(i) as DepCallEntry;
        // 🔴 **键存在 ≠ 有一个真叫这个名字的函数**（fix-devirt-bare-name-alias）。
        // `DependencyIndex.AddModule` 给 mangle 名（`Name$N$T`）**额外注册裸名别名**
        // （`Cls.Name` 与 `ns.Cls.Name`，见 DependencyIndex.z42 那两处 `TryAdd`），供
        // 调用点按裸名消歧用。而本谓词的**两个调用方都把 `fq` 直接当直呼目标名**
        // （`ResolveSealedTarget` / `NarrowPrimTarget`）⇒ 命中一个别名就会发出一条
        // 指向**不存在的函数名**的直接 Call。
        //
        // 实测 4 行可复现：`typeof(int).GetType().FullName` 在 `--opt-all` 下报
        // `undefined function \`Std.Type.GetType\`` —— 真身是 `Std.Type.GetType$1$string`
        // （`Std.Type` 声明 `static extern Type GetType(string)`，而裸名 `GetType` 又被
        // TSIG 从 `Std.Object` 的实例方法展平进 `Type.Methods`，两者在裸名上撞车）。
        // `--release --no-opt devirt` 通过 ⇒ 单变量锁定 Devirt。
        //
        // 判据收紧为「entry 的**真名**与 fq 逐字相同」：非重载方法 fq == QualifiedName 照旧命中
        // （零回归），只有「别名命中而真名不同」这一格被拒 —— 那一格本来就必错。
        return e != null && e.QualifiedName == fq;
    }

    // fix-narrow-prim-instance-dispatch：窄基元接收者 → 其包装类上该方法的**已发射 FQ**（查不到 → ""）。
    //
    // 为什么需要这条：运行期的 prim 派发由 `primitive_class_name(obj_val)` **从 Value 反推**类
    // （`interp/exec_vcall.rs`：`Value::I64 => Std.Int32`、`Value::F64 => Std.Double`），而
    // `sbyte/short/byte/ushort/uint/ulong/long` 同为 `Value::I64`、`float` 是 `Value::F64` ⇒
    // 这 8 个包装类型上声明的实例方法**运行期一个都到不了**，全落到 Int32/Double 的同名方法。
    // 长期无人发现，只因它们的实现与 Int32/Double 版恰好等价；实测真正分道的有两处：
    // `UInt64.ToString`（> i64::MAX 打成负数）与 `Single.GetHashCode`（实际走 Double 的 64 位折叠）。
    //
    // 基元是 **sealed 值类型、没有虚派发**，所以编译期直呼在语义上就是对的（同 blob 值 struct
    // 实例调用早已走静态 Call）。这里只覆盖「运行期反推会给错类」的 8 个；`int`/`double`/`bool`/
    // `char`/`string` 反推本就正确，不动它们 —— 既零字节漂移，也不碰 runtime 对 string/装箱基元
    // 的既有特殊处理。
    public string NarrowPrimTarget(Z42Type recvType, string methodKey) {
        Z42ClassType ct = recvType as Z42ClassType;
        if (ct == null) { return ""; }
        // ⚠️ 必须先 Canon 归一：同一个 `ulong` 会以**两种拼写**到达这里 —— 显式类型标注 / 强制转换
        // 经 `SymbolTable.BuiltinType` 解析时，若包装类在作用域内会**直接返回包装类**（`Name()=="UInt64"`），
        // 而从方法签名推断出来的则保留关键字（`"ulong"`）。只认其中一种会漏掉一半调用点
        // （实测：`ulong a = …; a.ToString()` 漏、`UInt64.Parse(…).ToString()` 中）。
        string canon = PrimModel.Canon(ct.Name());
        if (!EmitContext.IsRuntimeAmbiguousPrim(canon)) { return ""; }
        string wrapper = PrimModel.Wrapper(canon);
        if (wrapper == "" || wrapper == canon) { return ""; }
        string fq = this.QualifyClass(wrapper) + "." + methodKey;
        // 必须校验「确为已发射函数」：查不到就回落 VCall（= 今天的行为），**永不 miscall**。
        // 本地 prim 类（编 z42.core 自身时）不在 Deps 里，用 LocalClasses 判。
        if (this.LocalClasses != null && this.LocalClasses.ContainsKey(wrapper)) { return fq; }
        if (this._depHasFunction(fq)) { return fq; }
        return "";
    }

    // 运行期由 Value 反推会得到**错类**的基元。入参须是 `PrimModel.Canon` 的结果（关键字拼写）。
    public static bool IsRuntimeAmbiguousPrim(string kw) {
        if (kw == "sbyte" || kw == "short" || kw == "byte" || kw == "ushort") { return true; }
        if (kw == "uint" || kw == "ulong" || kw == "long") { return true; }
        return kw == "float";
    }

    // add-method-reference：解析 `methodof(T.M)` 的目标 FQ 名 —— **必须沿基链找真正的声明类**。
    //
    // 为什么不能直接用 receiver 类拼名：TSIG 把**继承**方法展平进每个派生类的 `Methods`
    // （`ImportedSymbolLoader._fillClass`），所以 `ct.Methods` 命中 **≠** 该方法声明于本类。
    // 跨包实测（`src/compiler/z42c.pipeline/tests/fixtures/cross-zpkg/methodof_cross_pkg`）：`methodof(Leaf.Tag)` 里 Tag 声明在
    // 另一个包的基类 `Mo.Base.Tagged`，拿 Leaf 拼名得到 `Mo.Ext.Leaf.Tag` —— 一个**从未发射的
    // 函数**，运行期才炸。这与 `ResolveSealedTarget` 遇到的是同一个坑，解法也同一个：用
    // `Deps.Statics`（跨包已发射函数按 FQ 建键）校验，未命中就继续上溯。
    //
    // 本地类不查 Deps（Deps 不含本包函数）：`SymbolCollector` 只把**声明于本类**的方法填进
    // `Methods`，故本地类命中即声明类。
    //
    // 返回 "" = 没找到可发射的目标 → 调用方按 BoundMethodOf.DeclOwnerFq 兜底（并由 runtime 的
    // `__methodof` 存在性检查兜最后一道，宁可响错也不静默半填充）。
    public string ResolveMethodOfTarget(Z42ClassType startCt, string methodKey) {
        Z42ClassType ct = startCt;
        int hops = 0;
        while (ct != null) {
            if (ct.Methods.ContainsKey(methodKey)) {
                string fq = ct.Fqn() + "." + methodKey;
                if (this.LocalClasses != null && this.LocalClasses.ContainsKey(ct.Name())) { return fq; }
                if (this._depHasFunction(fq)) { return fq; }
                // imported 且 Deps 无此 FQ ⇒ 本类只是继承、并未声明 → 继续沿基链上溯。
            }
            if (!ct.HasBase) { return ""; }
            if (this.Symbols == null) { return ""; }
            ct = this.Symbols.BaseOf(ct);   // A5：走句柄
            hops = SymbolTable.NextBaseHop(hops);
        }
        return "";
    }

    // 解析 sealed receiver 上方法调用的**直接目标 FQ 名**（`QualifyClass(定义类)+"."+RegKey`，
    // 逐字节匹配 IrGen 的 `_q(_classIrShortName)+"."+md.RegKey`）。methodKey = BoundCall.MethodName
    // （MemberResolver 已置为**解析后 ms.RegKey**，重载已消歧、无需重解析）。沿 startCt→base 链找
    // **最近声明该键且非 abstract 的可限定（本地或 imported）类**（= declClass）。泛型类走
    // `_classShortName` 的条件 arity-mangle（extend-sealed-devirt-more ②）。
    //
    // 去虚化安全判据（extend-sealed-devirt-more）：declClass 是 startCt 的自身或某基类
    // （链向上找），故运行期类型 R ≤ startCt ≤ declClass。命中 declClass 后：
    //   · classSealed（整类 sealed）：R==startCt，目标必唯一 → 命中（原 add-sealed-devirt）。
    //   · 否则 ms.IsSealed（sealed override）：declClass 下无人能 override 该方法，R ≤ declClass →
    //     R 的最派生 M == declClass.M，目标唯一 → 命中。
    //   · 两者皆非：R 可在 declClass 下再 override → 目标不唯一 → ""（回落 VCall，永远安全）。
    // 越界（不可限定基类/abstract/未找到）→ ""。imported：extend-sealed-devirt-imported。
    public string ResolveSealedTarget(Z42ClassType startCt, string methodKey, int argc, bool classSealed) {
        // add-iface-return-bridge：被桥接的方法**不 devirt**。
        // 这里产的是**直接 Call 的目标名**，若剥掉 `$struct` 去查表，拼出来的目标就指到桥接上
        // （无 sret）而调用点按具体返回类型传了 sret 槽 ⇒ 反向 arity 失配。devirt 只是优化，
        // 这一罕见形状回落 VCall（按 `$struct` 名派发，实测可行）永远正确 —— 宁可少一次优化，
        // 不要拼一个可能指错的目标名。
        if (methodKey.EndsWith("$struct")) { return ""; }
        Z42ClassType ct = startCt;
        int hops = 0;
        while (ct != null) {
            // 只在**可限定**类上构造目标名（QualifyClass 给出与 IrGen 发射一致的 FQ——本地=当前 ns、
            // imported=ImportedClassNs 源 ns；泛型经 _classShortName 的 $N 条件 mangle）。
            if (!this._devirtQualifiable(ct)) { return ""; }
            if (ct.Methods.ContainsKey(methodKey)) {
                MethodSymbol ms = ct.Methods.Get(methodKey) as MethodSymbol;
                if (ms == null) { return ""; }
                // abstract 无 body 不可直呼（sealed 具体类应已 override，防御性）。
                if (ms.HasDecl && ms.Decl != null && Mod.Has(ms.Decl.ModFlags, Mod.Abstract)) { return ""; }
                // sealed override 门控：非整类 sealed 时，只有方法本身 sealed 才目标唯一（见上判据）。
                bool sealedHere = classSealed || ms.IsSealed;
                // 目标名用 _classShortName（泛型条件 $N mangle）逐字节匹配 IrGen `_q(_classIrShortName)`。
                string fq = this.QualifyType(ct, this._classShortName(ct)) + "." + methodKey;
                // 本地类：SymbolCollector 只填**声明于本类**的方法 → Methods 命中即「本类声明」=declClass，
                // 目标就是本类发射的函数（Deps 不含本包函数，不能拿 Deps 校验）。sealed 判据成立才去虚化。
                if (this.LocalClasses != null && this.LocalClasses.ContainsKey(ct.Name())) {
                    if (!sealedHere) { return ""; }   // declClass 非 sealed → 可再 override → 回落
                    return fq;
                }
                // imported 类：TSIG 把**继承**方法展平进每个派生类的 Methods（ImportedSymbolLoader
                // _fillClass 行 266-293）→ Methods 命中**不等于**本类声明。若本类只是继承而非声明，
                // `QualifyClass(派生类)+"."+key` 指向一个从未发射的函数（如 demo.sld.Leaf.Tag，真身是
                // demo.base.Tagged.Tag）→ 运行期 undefined function。故用 Deps（跨包已发射函数按 FQ 建键，
                // DependencyIndex.AddModule 行 110）校验该 FQ 确为真实发射函数：命中→本类确有该函数=declClass；
                // 未命中→本类仅继承，继续沿基链上溯找真正声明类（其 FQ 会命中 Deps）。
                if (this._depHasFunction(fq)) {
                    // 找到 declClass。sealed 判据不成立 → 目标可再 override → 回落 VCall（不再上溯：
                    // 更派生声明已定 dispatch，基类的 sealed 与否不影响 R 的目标）。
                    if (!sealedHere) { return ""; }
                    // 直接 Call 的目标在 declClass 的包里，而本文件的依赖集（`CuCompile.DepRefsOf`）只记
                    // **接收者类型**的包 —— 依赖集不看代码生成。declClass 是别的包里的基类时不去虚化、回落 VCall：
                    // 按运行期类型分派，基类所在的包由接收者所在包自己的 DEPS 负责。罕见形状，只少一次优化。
                    if (ct != startCt && this.Symbols.ImportedPkgOf(ct.Fqn()) != this._pkgOfClass(startCt)) { return ""; }
                    return fq;
                }
                // 本类仅继承该方法（FQ 非真实发射）→ 不在此返回，继续沿基链上溯找 declClass。
            }
            // 沿基链上溯（去泛型尖括号，同 ReceiverMethodIsVirtual）。
            if (!ct.HasBase || ct.BaseName == "") { return ""; }
            if (this.Symbols == null) { return ""; }
            ct = this._nextBase(ct);
            if (ct == null) { return ""; }
            hops = SymbolTable.NextBaseHop(hops);
        }
        return "";
    }

    // prim 别名 → 包装类名。**转发到 `PrimModel.Wrapper`（唯一真相）**（converge-prim-wrapper）。
    //
    // 🔴 原注释写的是「镜像 `TypeChecker._primWrapper`」—— 而它指的那个函数**早已不存在**
    // （`TypeChecker` 里只剩一句提到它的注释）。一份声称镜像某处的实现，其镜像对象是个鬼：
    // 这正是「注释即第二份真相、且先于代码腐坏」的标准形态。
    //
    // 三份旧实现已经不一致（详见 `TypeFactsTc._primWrapper` 的注释）；本份独有的错是
    // **缺 `object` 分支** ⇒ `_primWrapper("object")` 返回 `object`。它在 `QualifyTypeName`
    // 里被前置的 `if (name == "object")` 挡住了，但 `ChainHasMethod` 没有那层挡 ⇒
    // `object` 收者查 `LocalClasses["object"]` 必然落空。
    private static string _primWrapper(string n) {
        return PrimModel.Wrapper(n);
    }

    // 类的声明 ns 是否异于当前模块 ns（跨-ns，含 imported）。G18i：`as`-cast 到跨-ns 类后字段读
    // 结果 tag → Unknown（镜像 C#：cast-to-cross-ns-class 不加载目标类字段；param/var 已声明类型则加载）。
    public bool IsCrossNs(string clsName) {
        if (this.ImportedClassNs == null || !this.ImportedClassNs.ContainsKey(clsName)) { return false; }
        StrBox b = this.ImportedClassNs.Get(clsName) as StrBox;
        if (b == null) { return false; }
        return b.Value != this.Ns;
    }

    // 类的归属包（本包 / 归属不明 → ""）：跨包 devirt 门用。
    private string _pkgOfClass(Z42ClassType ct) {
        if (this.LocalClasses != null && this.LocalClasses.ContainsKey(ct.Name())) { return ""; }
        return this.Symbols.ImportedPkgOf(ct.Fqn());
    }

    // 名字限定（镜像 C# QualifyName）：已含 '.' 视为已限定；ns 空则原样。
    public string Qualify(string name) {
        if (this.Ns == "") { return name; }
        int i = 0;
        while (i < name.Length) {
            if (name.CharAt(i) == '.') { return name; }
            i = i + 1;
        }
        return this.Ns + "." + name;
    }

    // 每语句记源码行（镜像 C# FunctionEmitter.TrackLine）：行号≤0 或与上条同行 → 跳过；
    // blockIdx = 当前块（= 已封块数），instrIdx = 当前块内指令数；file 取 basename（跨机器可复现）。
    public void TrackLine(Span sp) {
        if (sp.Line <= 0 || sp.Line == this.LastLine) { return; }
        this.LastLine = sp.Line;
        // 每条语句都从完整路径倒扫截文件名，编 z42c.semantics 时占 ~1% —— 路径没变就复用上一次的结果。
        string file = this._tlBase;
        if (this._tlPath == null || sp.File != this._tlPath) {
            file = EmitContext.BaseName(sp.File);
            this._tlPath = sp.File; this._tlBase = file;
        }
        bool hasFile = file != "";
        if (this.LineCount == this.Lines.Length) {
            IrLineEntry[] bigger = new IrLineEntry[this.Lines.Length * 2];
            int i = 0; while (i < this.LineCount) { bigger[i] = this.Lines[i]; i = i + 1; }
            this.Lines = bigger;
        }
        this.Lines[this.LineCount] = new IrLineEntry(this.BlockCount, this.CurCount, sp.Line, hasFile, file, sp.Column);
        this.LineCount = this.LineCount + 1;
    }

    // 末路径段（同切 `/` 与 `\`，镜像 C# BaseName——结果与产出路径的 OS 无关）。空 → ""。
    public static string BaseName(string path) {
        if (path == "") { return ""; }
        int cut = 0 - 1;
        int i = path.Length - 1;
        bool more = i >= 0;
        while (more) {
            char c = path.CharAt(i);
            if (c == '/' || c == '\\') { cut = i; more = false; }
            else { i = i - 1; more = i >= 0; }
        }
        if (cut < 0) { return path; }
        return path.Substring(cut + 1, path.Length - cut - 1);
    }

    // 局部变量表快照（镜像 C# SnapshotLocalVarTable：全部 locals 按 RegId 升序——hash 序经排序后确定）。
    public IrLocalVarEntry[] SnapshotLocals() {
        string[] names = this.Locals.Keys();
        int n = names.Length;
        IrLocalVarEntry[] r = new IrLocalVarEntry[n];
        int i = 0;
        while (i < n) {
            TypedReg tr = this.Locals.Get(names[i]) as TypedReg;
            r[i] = new IrLocalVarEntry(names[i], tr.Id);
            i = i + 1;
        }
        // 插入排序 by RegId
        i = 1;
        while (i < n) {
            IrLocalVarEntry key = r[i];
            int j = i - 1;
            bool m2 = j >= 0;
            while (m2) {
                if (r[j].RegId > key.RegId) { r[j + 1] = r[j]; j = j - 1; m2 = j >= 0; }
                else { m2 = false; }
            }
            r[j + 1] = key;
            i = i + 1;
        }
        return r;
    }

    // 线性寄存器分配（不复用）。记 reg→tag（REGT）。
    public TypedReg Alloc(int tag) {
        TypedReg r = new TypedReg(this.NextReg, tag);
        this.RecordReg(this.NextReg, tag);
        this.NextReg = this.NextReg + 1;
        if (this.NextReg > this.MaxReg) { this.MaxReg = this.NextReg; }
        return r;
    }

    // 记 reg id 的类型标签（params/this 直接构造 TypedReg 时也须记，使 RegTags 全覆盖 0..MaxReg）。
    public void RecordReg(int id, int tag) {
        while (id >= this.RegTags.Length) {
            int[] bigger = new int[this.RegTags.Length * 2];
            int i = 0; while (i < this.RegTagCount) { bigger[i] = this.RegTags[i]; i = i + 1; }
            this.RegTags = bigger;
        }
        this.RegTags[id] = tag;
        if (id + 1 > this.RegTagCount) { this.RegTagCount = id + 1; }
    }

    public void Emit(IrInstr ins) {
        if (this.CurCount == this.Cur.Length) {
            IrInstr[] bigger = new IrInstr[this.Cur.Length * 2];
            int i = 0; while (i < this.CurCount) { bigger[i] = this.Cur[i]; i = i + 1; }
            this.Cur = bigger;
        }
        this.Cur[this.CurCount] = ins;
        this.CurCount = this.CurCount + 1;
    }

    public void StartBlock(string label) {
        this.CurLabel = label; this.Cur = new IrInstr[8]; this.CurCount = 0; this.Ended = false;
    }

    public void EndBlock(IrTerminator term) {
        if (this.Ended) { return; }
        if (this.BlockCount == this.Blocks.Length) {
            IrBlock[] bigger = new IrBlock[this.Blocks.Length * 2];
            int i = 0; while (i < this.BlockCount) { bigger[i] = this.Blocks[i]; i = i + 1; }
            this.Blocks = bigger;
        }
        this.Blocks[this.BlockCount] = new IrBlock(this.CurLabel, this.Cur, this.CurCount, term, true);
        this.BlockCount = this.BlockCount + 1;
        this.Ended = true;
    }

    public string Fresh(string hint) {
        string r = hint + "_" + this.LabelSeq.ToString();
        this.LabelSeq = this.LabelSeq + 1;
        return r;
    }

    // breakFloor/contFloor = 分别在 break/continue 退出本层时应跑到的 finally 底深（FunctionEmitter
    // 传入）。真循环两者相等（=入栈时 finally 深）；switch 的 continue 转发外层循环，contFloor 继承外层。
    public void PushLoop(string contL, string breakL, int breakFloor, int contFloor) {
        if (this.LoopDepth == this.ContLabels.Length) {
            string[] bc = new string[this.ContLabels.Length * 2];
            string[] bb = new string[this.BreakLabels.Length * 2];
            int[]    kf = new int[this.BreakFinFloor.Length * 2];
            int[]    cf = new int[this.ContFinFloor.Length * 2];
            int i = 0;
            while (i < this.LoopDepth) {
                bc[i] = this.ContLabels[i]; bb[i] = this.BreakLabels[i];
                kf[i] = this.BreakFinFloor[i]; cf[i] = this.ContFinFloor[i]; i = i + 1;
            }
            this.ContLabels = bc; this.BreakLabels = bb; this.BreakFinFloor = kf; this.ContFinFloor = cf;
        }
        this.ContLabels[this.LoopDepth] = contL;
        this.BreakLabels[this.LoopDepth] = breakL;
        this.BreakFinFloor[this.LoopDepth] = breakFloor;
        this.ContFinFloor[this.LoopDepth] = contFloor;
        this.LoopDepth = this.LoopDepth + 1;
    }
    public void   PopLoop()     { this.LoopDepth = this.LoopDepth - 1; }
    public bool   InLoop()      { return this.LoopDepth > 0; }
    public string CurBreak()    { return this.BreakLabels[this.LoopDepth - 1]; }
    public string CurContinue() { return this.ContLabels[this.LoopDepth - 1]; }
    public int    CurBreakFinFloor() { return this.BreakFinFloor[this.LoopDepth - 1]; }
    public int    CurContFinFloor()  { return this.ContFinFloor[this.LoopDepth - 1]; }

    // Z42Type → IrType 标签（z42c.ir 是无依赖叶子不能引用 Z42Type，故映射在 semantics 侧）。
    public int ToIrType(Z42Type t) {
        if (t is Z42VoidType) { return IrType.Void; }
        // unify-value-types Phase 1（2.2 双路）：翻转后内建（int→Int32 phantom struct）以 Z42ClassType
        // 承载——按名归一到内建 IR 标签，须在通用 ClassType→Ref 之前。IsBuiltin 覆盖 Scalar 值类型 +
        // string/object；IrTag 保留 string→Str、object→Ref（与历史 PrimTag 逐字节同义）。翻转前无内建名
        // Z42ClassType 流经此处（源码不以 wrapper/FQ 名声明类型），故此分支当前对 self-host 输出中立。
        if (t is Z42ClassType) { int _c = t.PrimCode(); if (_c >= 0) { return PrimModel.IrTagOfCode(_c); } }
        if (t is Z42ClassType) { return IrType.Ref; }
        if (t is Z42ArrayType) { return IrType.Ref; }
        // Interface / InstantiatedType / GenericParam / Error / func → Unknown(0x00)
        // 镜像 C# ToIrType: only PrimType/ClassType/ArrayType/OptionType/NullType→Ref；
        // 其余（含接口、泛型实例化、泛型形参）→ Unknown。
        return IrType.Unknown;
    }

    // prim 名（关键字或 BCL 包装名，ResolveType 不规范化）→ IrType 标签。
    public int PrimTag(string n) {
        if (n == "int" || n == "Int32") { return IrType.I32; }
        if (n == "long" || n == "Int64") { return IrType.I64; }
        if (n == "sbyte" || n == "SByte") { return IrType.I8; }
        if (n == "short" || n == "Int16") { return IrType.I16; }
        if (n == "byte" || n == "Byte") { return IrType.U8; }
        if (n == "ushort" || n == "UInt16") { return IrType.U16; }
        if (n == "uint" || n == "UInt32") { return IrType.U32; }
        if (n == "ulong" || n == "UInt64") { return IrType.U64; }
        if (n == "float" || n == "Single") { return IrType.F32; }
        if (n == "double" || n == "Double") { return IrType.F64; }
        if (n == "bool" || n == "Boolean") { return IrType.Bool; }
        if (n == "char" || n == "Char") { return IrType.Char; }
        if (n == "string" || n == "String") { return IrType.Str; }
        return IrType.Ref;   // object / 未知 → ref
    }
}

