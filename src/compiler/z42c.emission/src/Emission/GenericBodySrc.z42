// complete-generic-instantiation S1-f：一个**可特化的泛型体**的来源。
//
// ## 为什么要带着 `Model`
//
// `IrGen` 由 `CuCompile._compileCu` **按编译单元**创建，`SemanticModel` 也是
// （`TypeChecker.Infer(cu, …)` 每 CU 一份）。发射特化体要 `model.GetBody(key)` 取**绑定后的体**，
// 而泛型的声明常在**别的文件**里 ⇒ 本 CU 的 model 里没有它 ⇒ `EmitMethod` 的 `model.HasBody(...)`
// 恒假 ⇒ **静默什么都不发**，调用点却已派发到特化名 ⇒ 运行期
// `MissingSymbolException: undefined function Demo.Loc<P2,int>.Loc`（#774 既有缺陷）。
//
// 故登记表除了 AST，还必须带上**该 AST 所属 CU 的 model**。
//
// Package emission binds generic declaration files before building the specialization registry.
// Fresh files reuse that binding for ordinary emission as well.
namespace Z42.Emission;

using Z42.Semantics;

using Z42.Syntax;

public sealed class GenericBodySrc {
    public Decl          Raw;        // 带 attribute 包装的声明（`HandlerRegistry.HasRecord` 要认 `[Record]`）
    public SemanticModel Model;      // **该声明所属 CU** 的 model —— 体查找必须用它，不能用当前 CU 的
    public string        OwnerFq;    // 成员：所属类的 FQN（= `Z42ClassType.Fqn()`，arity-mangle 时 `ns.Name$N`）；自由函数为 ""
    public string        RegKey;     // 成员的注册键（用于「同名覆写」闭包）；非实例方法为 ""
    public string        BodyKey;    // `Model` 里的体键（`SemanticModel` 按 CU 建，一个 CU 一个 ns ⇒ 短键：`RegKey` / `Owner.RegKey`）

    public GenericBodySrc(Decl raw, SemanticModel model, string ownerFq, string regKey, string bodyKey) {
        this.Raw = raw; this.Model = model; this.OwnerFq = ownerFq; this.RegKey = regKey; this.BodyKey = bodyKey;
    }
}
