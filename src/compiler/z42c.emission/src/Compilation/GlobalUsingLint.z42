// 包级 `global using` 告警：全包没有任何文件用到的 `global using X;` ⇒ W0607。
// 跑在**整包编译之后**、作用于编译产物（`CompiledModuleZ` 的用法集合与诊断列表），与 `CuPreprocess._enforceFileScope`
// 同属编排层；单文件那半（多余 / 重复 `using`）是声明期规则，住 Validation 的 `UsingLint`，两者共用其 `_has`。
namespace Z42.Emission;

using Z42.Semantics;

using Z42.Syntax;
using Z42.Core;

public static class GlobalUsingLint {
    // using-csharp-rules 3.6：`global using X;` **全包**没有任何文件用到 X ⇒ W0607（报在声明它的那一行）。
    // 判据：每个文件的 `UsedNs`（与 E0436 同一份集合）。cached 文件的这一项由 meta 回填（2.9）——
    // 少了它就会把只被 cached 文件用到的 global using 误报成没用。
    // 不判：包里有错误（同 `Check`：用法集合不可信）；编译器注入的副本（`Injected`）；prelude（`Check` 已在声明处报过）。
    public static void Check(CompilationUnit[] cus, CompiledModuleZ[] cms, int n) {
        int e = 0;
        while (e < n) { if (cms[e] != null && cms[e].ErrorCount > 0) { return; } e = e + 1; }
        int i = 0;
        while (i < n) {
            if (cus[i] != null && cms[i] != null) {
                int di = 0;
                while (di < cus[i].DeclCount) {
                    Decl d = cus[i].Decls[di];
                    di = di + 1;
                    if (!(d is UsingDecl)) { continue; }
                    UsingDecl u = d as UsingDecl;
                    if (!u.IsGlobal || u.Injected || PreludeNs.Contains(u.Name)) { continue; }
                    if (GlobalUsingLint._usedAnywhere(cms, n, u.Name)) { continue; }
                    string file = u.Span != null && u.Span.File != "" ? u.Span.File : (cus[i].Span != null ? cus[i].Span.File : "");
                    cms[i].Add(Diagnostic.Warning(DiagnosticCodes.UnnecessaryUsing,
                        "unnecessary `global using " + u.Name + ";` — no file in the package uses it",
                        new Span(u.Span.Start, u.Span.End, u.Span.Line, u.Span.Column, file)));
                }
            }
            i = i + 1;
        }
    }

    private static bool _usedAnywhere(CompiledModuleZ[] cms, int n, string ns) {
        int i = 0;
        while (i < n) {
            if (cms[i] != null) {
                if (cms[i].UsedNs != null && UsingLint._has(cms[i].UsedNs, cms[i].UsedNs.Length, ns)) { return true; }
            }
            i = i + 1;
        }
        return false;
    }
}
