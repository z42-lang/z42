// The compiler is a declared package dependency; construction remains lazy.
namespace Z42.Scripting;
using Z42.Build;
using Z42.Pipeline;

public static class ReplCompilerHost {
    private static IReplCompiler Cached;
    public static IReplCompiler Get() {
        if (ReplCompilerHost.Cached == null) { ReplCompilerHost.Cached = new Z42cReplCompiler(); }
        return ReplCompilerHost.Cached;
    }
}
