// 驱动测试：REPL 识别多 token 类型名的变量声明（fix-repl-generic-decl-classify）。
// 泛型 `List<int> a = new()`、限定名 `Std.Collections.List<int> b = new()`、数组
// `int[] arr = new int[3]`、嵌套泛型 `Dictionary<string,int> d = new()` 都应被 Classifier
// 判为 var 声明（此前只认单 token 类型 → 漏判成局部变量 / 误解析成比较链，`a` 跨轮未定义）。
// 直接驱动 Std.Scripting.Script.Eval 跨轮，与 expected_output.txt 对账。
// 经 warm-z42c 回路运行（Z42_LIBS = z42.scripting + z42c.* + stdlib）。
namespace ReplGenericDeclTest;

using Std;
using Std.IO;
using Std.Scripting;

void Main() {
    ScriptState s = Script.Create();

    // 泛型类型声明 → 跨轮持久
    _step(s, "List<int> a = new()");
    _step(s, "a.Add(5)");
    _step(s, "a.Add(9)");
    _step(s, "a.Count");                              // 2
    // 限定名 + 泛型
    _step(s, "Std.Collections.List<int> b = new()");
    _step(s, "b.Add(7)");
    _step(s, "b.Count");                              // 1
    // 数组类型
    _step(s, "int[] arr = new int[3]");
    _step(s, "arr.Length");                           // 3
    // 嵌套泛型 + 索引
    _step(s, "Dictionary<string, int> d = new()");
    _step(s, "d[\"k\"] = 42");
    _step(s, "d[\"k\"]");                             // 42
    // 回归护栏：普通比较表达式不得被误判为声明
    _step(s, "int p = 3");
    _step(s, "p < 5");                                // true
    // var 仍走推断路径
    _step(s, "var v = a.Count");
    _step(s, "v");                                    // 2
}

// 打印一步结果：失败 → 错误文本（去空白）；有值 → 值；否则 → "ok"。
void _step(ScriptState s, string input) {
    EvalResult r = Script.Eval(s, input);
    if (!r.Success) { Console.WriteLine(r.Error.Trim()); return; }
    if (r.HasValue && r.Value != null) { Console.WriteLine("" + r.Value); return; }
    Console.WriteLine("ok");
}
