// (T)expr 数值转换（G3；目标 tag 在 Dst.Type）。镜像 C# ConvertInstr。
public sealed class ConvertInstr : IrUnInstr {
    public ConvertInstr(TypedReg dst, TypedReg src) { this.Dst = dst; this.Src = src; }
    public override string Dump() { return this.Dst.Dump() + " = convert " + IrType.Name(this.Dst.Type) + " " + this.Src.Dump(); }
    public override IrInstr Clone() { return new ConvertInstr(this.Dst, this.Src); }
}

// ToStr（GS4 interpolation）：dst = src.ToString()；镜像 C# ToStrInstr opcode 0x1F。
public sealed class ToStrInstr : IrUnInstr {
    public ToStrInstr(TypedReg dst, TypedReg src) { this.Dst = dst; this.Src = src; }
    public override string Dump() { return this.Dst.Dump() + " = to_str " + this.Src.Dump(); }
    public override IrInstr Clone() { return new ToStrInstr(this.Dst, this.Src); }
}
