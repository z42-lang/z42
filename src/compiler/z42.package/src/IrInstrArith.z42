// ── 字符串拼接（CG-1E）：a + b（string）。──────────────────────────────────────────
public sealed class StrConcatInstr : IrBinInstr {
    public StrConcatInstr(TypedReg dst, TypedReg a, TypedReg b) { this.Dst = dst; this.A = a; this.B = b; }
    public override string Dump() { return this.Dst.Dump() + " = str_concat " + this.A.Dump() + ", " + this.B.Dump(); }
    public override IrInstr Clone() { return new StrConcatInstr(this.Dst, this.A, this.B); }
}

// ── 一元（CG-1E）─────────────────────────────────────────────────────────────────
public sealed class NotInstr : IrUnInstr {
    public NotInstr(TypedReg dst, TypedReg src) { this.Dst = dst; this.Src = src; }
    public override string Dump() { return this.Dst.Dump() + " = not " + this.Src.Dump(); }
    public override IrInstr Clone() { return new NotInstr(this.Dst, this.Src); }
}
public sealed class NegInstr : IrUnInstr {
    public NegInstr(TypedReg dst, TypedReg src) { this.Dst = dst; this.Src = src; }
    public override string Dump() { return this.Dst.Dump() + " = neg " + IrType.Name(this.Dst.Type) + " " + this.Src.Dump(); }
    public override IrInstr Clone() { return new NegInstr(this.Dst, this.Src); }
}
public sealed class BitNotInstr : IrUnInstr {
    public BitNotInstr(TypedReg dst, TypedReg src) { this.Dst = dst; this.Src = src; }
    public override string Dump() { return this.Dst.Dump() + " = bit_not " + IrType.Name(this.Dst.Type) + " " + this.Src.Dump(); }
    public override IrInstr Clone() { return new BitNotInstr(this.Dst, this.Src); }
