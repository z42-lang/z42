// 已迁到 core `Std.Hashing.Murmur3`（编译器零 extern）。本类只剩转发：上一个 nightly 的 driver 运行期
// 仍按 `Z42.IR.Murmur3.*` 解析这几个符号，同轮删掉会让自举中途 `undefined function`（见 self-hosting.md
// 「改名：编译期与运行期是两个解析面」）。
// STAGE2-DEBT(z42ir-murmur3-forward,2026-10-29): nightly 含本提交后删除本文件（调用点已全部改调 Std.Hashing.Murmur3）
namespace Z42.IR;


public static class Murmur3 {
    public static byte[] Hash128(byte[] data) { return Std.Hashing.Murmur3.Hash128(data); }

    public static string Hash128Hex(byte[] data) { return Std.Hashing.Murmur3.Hash128Hex(data); }

    public static string HashHexOfStr(string text) { return Std.Hashing.Murmur3.Hash128Hex(text); }

    public static string HashHexOfBytes(byte[] data) { return Std.Hashing.Murmur3.Hash128Hex(data); }
}
