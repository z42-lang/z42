// IR 指令基类 + 统一操作数接口（unify-ir-operand-access）。
// 镜像 C# z42.IR/IrModule.cs 的 IrInstr record 层次；class 继承 + virtual（基类给安全默认，不用 abstract）。
// class-per-instruction（User 裁决 D2）：每条指令一个 class。指令类按类别分文件：
//   IrInstrConst.z42  ── 常量 / 类型参数物化 / 静态读 / load_fn / typeof（仅定义 Dst，无读操作数）
//   IrInstrArith.z42  ── copy / 二元算术·比较·位·移位·串拼接 / 一元
//   IrInstrCall.z42   ── 调用族（call / builtin / call.native / vcall / call_ind / mk_clos）+ 取址 + 静态写
//   IrInstrObject.z42 ── 字段 / 对象 / 数组 / is·as / blob 值类型
// Dump 形如 ir.md：`%2 = add i64 %0, %1` / `%3 = const.i64 5`。
//
// ── 统一操作数接口 ──────────────────────────────────────────────────────────────
// 每条指令自己回答「定义哪个寄存器 / 读哪些寄存器 / 携带哪些入池字符串 / 如何克隆」，消费者
// （IrOptInfo 读写计数与改写、IrInline 克隆重映射、ZbcWriter REGT 收集、ZbcInstr 串池预扫、逃逸分析
// 兜底规则）统一走接口迭代，不再各自维护逐指令 if-is 链。新增指令 = 加 class + 实现本接口 + WriteInstr/
// ZbcReaderInstr 编解码，其余消费者自动覆盖。
//   - DefReg / SetDefReg：该指令**写入**的寄存器；纯副作用指令（field_set / static_set / array_set /
//     struct_copy / struct_fset_prim）无定义 → null / 忽略。注意 StructCopy 的 `Dst` 字段是被写的**句柄**
//     （读操作数），不是定义。
//   - ReadCount / ReadAt / SetReadAt：读操作数按**固定顺序**（= REGT 访问序 = C# VisitInstrRegs 的
//     "dst 先、操作数序"去掉 dst；REGT 首个非 Unknown 赢，顺序进 byte-identical 前提）。
//   - StrCount / StrAt：入 STRS 池的字符串操作数，顺序 = 池化序（ZbcInstr.InternStrings 的既有序）。
//   - Clone：浅克隆——操作数数组复制（克隆体可独立 SetReadAt），TypedReg 实例共享（只读传递），
//     字符串数组/标量原样。
//   - Write：编码成 zbc 字节（布局跟着指令类走；ZbcEncoder 提供头部 / 操作数 / 串池 / token 写法）。
//   - TagReg：指令头 tag 字节取自哪个寄存器的类型。默认 = 定义寄存器；纯写入类取被写的值，
//     const.i32/i64 的 tag 是字面常量 → null。读端按它区分「解码带类型」与「只有 id」的寄存器。
//   - IsPure：可删性（temp-DCE / LICM / 纯函数推断用）。**白名单**：仅明确不抛、不调用户码、不写内存、
//     不分配的指令覆写为 true；Div/Rem（除零）、ArrayLen/FieldGet/ArrayGet（NPE / 越界）、ToStr（调
//     ToString）、调用族 / ObjNew / 各种 set（副作用）、StaticGet（可能触发静态初始化）、数组 / 闭包 /
//     串拼接 / LoadFn（分配）一律 false。新指令默认 false（保留），安全。
namespace Z42.IR;

using Z42.IR.BinaryFormat;   // ZbcEncoder（Write 编码）

public class IrInstr {
    public virtual string Dump() { return "?instr"; }

    // 定义寄存器；无定义者 null。
    public virtual TypedReg DefReg() { return null; }
    // 改写定义寄存器；无定义者忽略。
    public virtual void SetDefReg(TypedReg r) { }
    // 读操作数个数 / 第 i 个读操作数（越界 null）/ 改写第 i 个读操作数（越界忽略）。
    public virtual int ReadCount() { return 0; }
    public virtual TypedReg ReadAt(int i) { return null; }
    public virtual void SetReadAt(int i, TypedReg r) { }
    // 入池字符串操作数个数 / 第 i 个（越界 null）。
    public virtual int StrCount() { return 0; }
    public virtual string StrAt(int i) { return null; }
    // 浅克隆（见文件头）。基类不可实例化 → null。
    public virtual IrInstr Clone() { return null; }
    // zbc 编码（见文件头）。未覆写 = 新增指令忘了接编码 → 当场抛，指名是哪一条（不静默少写一条指令）。
    public virtual void Write(ZbcEncoder e) {
        throw new Exception("zbc writer: no encoding for IR instruction `" + this.Dump() + "`");
    }
    // 指令头 tag 的来源寄存器（见文件头）。
    public virtual TypedReg TagReg() { return this.DefReg(); }
    // 可删性白名单（见文件头）。
    public virtual bool IsPure() { return false; }

    // 克隆助手：复制 TypedReg 数组（元素共享）。
    public static TypedReg[] CloneRegs(TypedReg[] a) {
        if (a == null) { return null; }
        TypedReg[] n = new TypedReg[a.Length];
        int i = 0;
        while (i < a.Length) { n[i] = a[i]; i = i + 1; }
        return n;
    }
}

// ── 共享形状基类（减少逐类样板；消费者仍按具体类判 opcode 语义）────────────────────
// 仅定义 Dst、无读操作数：Const* / DefaultOf / MethodTypeArg / MethodDefault / StaticGet / LoadFn / Typeof / StructAlloc。
public class IrDefOnlyInstr : IrInstr {
    public TypedReg Dst;
    public override TypedReg DefReg() { return this.Dst; }
    public override void SetDefReg(TypedReg r) { this.Dst = r; }
}

// 一元：Dst = op Src（copy / neg / not / bit_not / convert / to_str）。
public class IrUnInstr : IrInstr {
    public TypedReg Dst;
    public TypedReg Src;
    public override TypedReg DefReg() { return this.Dst; }
    public override void SetDefReg(TypedReg r) { this.Dst = r; }
    public override int ReadCount() { return 1; }
    public override TypedReg ReadAt(int i) { if (i == 0) { return this.Src; } return null; }
    public override void SetReadAt(int i, TypedReg r) { if (i == 0) { this.Src = r; } }
}

// 二元：Dst = op A, B（算术 / 比较 / 位 / 移位 / 串拼接）。
public class IrBinInstr : IrInstr {
    public TypedReg Dst;
    public TypedReg A;
    public TypedReg B;
    public override TypedReg DefReg() { return this.Dst; }
    public override void SetDefReg(TypedReg r) { this.Dst = r; }
    public override int ReadCount() { return 2; }
    public override TypedReg ReadAt(int i) { if (i == 0) { return this.A; } if (i == 1) { return this.B; } return null; }
    public override void SetReadAt(int i, TypedReg r) { if (i == 0) { this.A = r; } else if (i == 1) { this.B = r; } }
}
