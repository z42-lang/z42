// packed `.zpkg` 读取器子集（port-z42c-import CI-1）。镜像 C# ZpkgReader 的消费侧所需面：
// META（名/版本/entry/kind）/ NSPC / SIGS（签名条目 → IrFunction stub）/ TSIG（→ ExportedModuleZ）。
// **不解码 FUNC 体**（DependencyIndex 只需签名——C# survey 实证）；indexed 模式/DBUG/REGT 不读。
namespace Z42.Package;

using Std;
using Std.IO;
using Std.Encoding;
using Z42.IR;
using Z42.IR.BinaryFormat;   // reconcile: ZbcReader.ReadTypeAt（MODS 内嵌 TYPE 解析）

// META 元信息 + 解析后的池/目录（一次解析多次取段）。
public sealed class ZpkgInfo {
    public string        Name;
    public string        Version;
    public string        Entry;       // "" = lib
    public bool          IsExe;
    public bool          Packed;      // false = indexed 主文件（FILE 目录，add-indexed-zpkg-min-patch）
    public string[]      Pool;        public int PoolCount;
    public ZpkgSection[] Sections;    public int SectionCount;
    public byte[]        Data;
    public ZpkgInfo(string name, string version, string entry, bool isExe, bool packed,
                    string[] pool, int poolCount, ZpkgSection[] sections, int sectionCount, byte[] data) {
        this.Name = name; this.Version = version; this.Entry = entry; this.IsExe = isExe;
        this.Packed = packed;
        this.Pool = pool; this.PoolCount = poolCount;
        this.Sections = sections; this.SectionCount = sectionCount; this.Data = data;
    }
    public bool HasSection(string tag) { return SectionDir.Find(this.Sections, tag) != null; }
    public ZpkgSection Section(string tag) { return SectionDir.Find(this.Sections, tag); }
}

public static class ZpkgReader {

    // 已经就某个 `<major>.<minor>` 报过告警的记录。一个过期的 libs 目录里常有几十个同代旧包，
    // 逐个报会把真信号淹在噪声里 ⇒ **按版本去重，一个旧版本一行**。
    private static string[] _skewWarned = new string[8];
    private static int _skewWarnedCount = 0;

    // 版本失配**必须说出来**（restore-emit-zbc-diagnostics 同族）。此前这里是一条静默 `return null`：
    // 依赖包被整包跳过，而跳过不会失败——它在很远的地方以满屏 `E0401: undefined: DiagnosticCodes` /
    // `E0443: undefined type: Span` 的形态浮出来，离真因十万八千里（实测为此二分了三轮）。
    // 措辞对齐 VM 侧那条好报错（`src/runtime/src/app.rs` 的 `version_mismatch_hint`）：在**检测点**
    // 点名，并给出修它的命令。
    private static void _warnVersionSkew(string origin, int major, int minor) {
        string ver = major.ToString() + "." + minor.ToString();
        int i = 0;
        while (i < ZpkgReader._skewWarnedCount) {
            if (ZpkgReader._skewWarned[i] == ver) { return; }      // 同一个旧版本只报一次
            i = i + 1;
        }
        if (ZpkgReader._skewWarnedCount == ZpkgReader._skewWarned.Length) {
            string[] grown = new string[ZpkgReader._skewWarnedCount * 2];
            int k = 0;
            while (k < ZpkgReader._skewWarnedCount) { grown[k] = ZpkgReader._skewWarned[k]; k = k + 1; }
            ZpkgReader._skewWarned = grown;
        }
        ZpkgReader._skewWarned[ZpkgReader._skewWarnedCount] = ver;
        ZpkgReader._skewWarnedCount = ZpkgReader._skewWarnedCount + 1;

        string who = origin == "" ? "a .zpkg" : "`" + origin + "`";
        ConsoleError.WriteLine("warning: skipping " + who + " — it was built for z42 package format "
            + ver + ", this toolchain reads "
            + ZpkgWriterZ.Major.ToString() + "." + ZpkgWriterZ.Minor.ToString()
            + " (strict-pin: there is no cross-version compatibility).");
        ConsoleError.WriteLine("  A skipped package is invisible to dependency resolution, so this usually "
            + "resurfaces far from here as bogus `undefined: <Type>` / `undefined function` errors.");
        ConsoleError.WriteLine("  Rebuild it against this toolchain (`xtask build stdlib`), or run the "
            + "toolchain that produced it. Further packages built for " + ver
            + " are skipped without repeating this.");
    }

    // 供测试与诊断：已就多少个**不同的**旧格式版本报过告警（去重后的条数）。
    public static int SkewWarningCount() { return ZpkgReader._skewWarnedCount; }

    // 解析 header/目录/META/STRS（其余段惰性按需）。非 packed / 坏 magic → null（调用方静默跳过）；
    // **版本不匹配 → null 并在 stderr 上点名**（见 `_warnVersionSkew`）。
    public static ZpkgInfo Open(byte[] data) {
        return ZpkgReader.Open(data, "");
    }

    // `origin` = 这份字节的出处（文件路径，或 REPL 那种内存包的包名），仅用于告警措辞；空串 = 不知道。
    public static ZpkgInfo Open(byte[] data, string origin) {
        if (data.Length < 16) { return null; }
        if ((int)data[0] != 90 || (int)data[1] != 80 || (int)data[2] != 75 || (int)data[3] != 0) { return null; }   // "ZPK\0"
        // strict-pin（add-params-varargs 5.4）：跨包扫描（DepScan.ScanDirs）会把 libsDirs 下所有
        // z42.*.zpkg 当数据盲读——版本不匹配的包（如 minor bump 前构建的旧 stdlib）其 TSIG/SIGS
        // 字节布局已变，不校验直接按新布局解析会读出垃圾偏移量甚至越界崩溃。此处比照 Rust
        // zbc_reader 的 strict-pin 原则，major/minor 任一不符即视为不可读 → 跳过（但会先点名，见下）。
        var vc = new ZpkgCursor(data, 4);
        int major = vc.U16();
        int minor = vc.U16();
        if (major != ZpkgWriterZ.Major || minor != ZpkgWriterZ.Minor) {
            ZpkgReader._warnVersionSkew(origin, major, minor);
            return null;
        }
        var c = new ZpkgCursor(data, 8);
        int flags = c.U16();
        int secCount = c.U16();
        // indexed 主文件放行（add-indexed-zpkg-min-patch）：段面同 packed（MODS→FILE），
        // 跨包消费面（NSPC/SIGS/TSIG/IMPL）同构可读。SymOnly sidecar 仍拒。
        if ((flags & 4) != 0) { return null; }
        bool packed = (flags & 1) != 0;
        bool isExe = (flags & 2) != 0;
        ZpkgSection[] secs = SectionDir.Read(data, secCount);
        // META：name/version/entry（u16 长 + UTF-8）
        string name = "";
        string version = "";
        string entry = "";
        ZpkgSection meta = SectionDir.Find(secs, "META");
        if (meta != null) {
            var m = new ZpkgCursor(data, meta.Offset);
            name = ZpkgReader._str(m);
            version = ZpkgReader._str(m);
            entry = ZpkgReader._str(m);
        }
        // STRS segment-dict（zpkg 0.25）→ 池；段索引越界 → 拒绝（strict）。
        string[] pool = new string[0];
        ZpkgSection strs = SectionDir.Find(secs, "STRS");
        if (strs != null) {
            pool = StrsCodec.Decode(data, strs.Offset);
            if (pool == null) { return null; }
        }
        int poolCount = pool.Length;
        return new ZpkgInfo(name, version, entry, isExe, packed, pool, poolCount, secs, secCount, data);
    }

    // NSPC → ns 名列表。
    public static string[] ReadNamespaces(ZpkgInfo z) {
        ZpkgSection s = z.Section("NSPC");
        if (s == null) { return new string[0]; }
        var c = new ZpkgCursor(z.Data, s.Offset);
        int n = c.U32();
        string[] r = new string[n];
        int i = 0;
        while (i < n) { r[i] = z.Pool[c.U32()]; i = i + 1; }
        return r;
    }

    // DEPS 段 → 本包声明的依赖 **zpkg 文件名**（如 `z42.core.zpkg`）。
    //
    // 段布局（`ZpkgWriterZ._buildDeps`）：`u32 depCount` + 每项 `u32 fileIdx` / `u16 nsCount`
    // / `u32[] nsIdx`。这里只要文件名，命名空间按 count 跳过。
    //
    // **为什么需要它**（add-deployment-model 批 2 support）：给 exe 装配**传递闭包**要知道
    // 「某个依赖自己依赖了谁」。这份信息一直在 zpkg 里，但**只有 Rust 侧解码**
    // （`metadata/zbc_reader/zpkg.rs`）—— z42 侧读不出来，于是 `_bundleExeDeps` 只能搬直接依赖。
    // 另一条路（顺着源码树的 toml 找）在 repo 外整个失效（publisher 今天就是那样），不能用。
    //
    // 🔴 **support 阶段：本方法今天无人调用** ⇒ 产物逐字节不变、可立即合并。
    // ✅ 阶段 2 已落地（#849）：`_bundleExeDeps` 用它按 DEPS 段建按名/产物引用的传递闭包。
    //    （此前这里写着「消费要等它随 nightly 进种子之后」—— 消费落地后没人回来改这句，
    //     于是支持侧的注释变成假话。这类腐坏现在由 `xtask test stage2` 的双向棘轮盯着。）
    public static string[] ReadDependencies(ZpkgInfo z) {
        ZpkgSection s = z.Section("DEPS");
        if (s == null) { return new string[0]; }
        var c = new ZpkgCursor(z.Data, s.Offset);
        int n = c.U32();
        string[] r = new string[n];
        int i = 0;
        while (i < n) {
            r[i] = z.Pool[c.U32()];
            int ns = c.U16();
            int j = 0;
            while (j < ns) { c.U32(); j = j + 1; }
            i = i + 1;
        }
        return r;
    }

    // SIGS + MODS/FILE 头 → 每模块 (ns, IrFunction 签名 stub 列表)。
    // SIGS 条目布局 = zbc WriteSigEntries（名/арity/retTag/retIdx/exec/static/paramTypes/tp 块/attr 块）。
    // packed：MODS 只读头（ns/src/hash/fnCount/firstSigIdx）+ 按 len 跳过五个体；
    // indexed：FILE 条目（同五字段 + zbcHash u32，无体）——配对逻辑同构。
    public static ZpkgModuleSigs[] ReadModuleSigs(ZpkgInfo z) {
        ZpkgSection sig = z.Section("SIGS");
        ZpkgSection mods = z.Packed ? z.Section("MODS") : z.Section("FILE");
        if (sig == null || mods == null) { return new ZpkgModuleSigs[0]; }
        // 全量 SIGS 平铺
        var c = new ZpkgCursor(z.Data, sig.Offset);
        int total = c.U32();
        IrFunction[] all = new IrFunction[total];
        int i = 0;
        while (i < total) {
            // 签名 stub：体为空（消费侧不需要）；P1 元数据（vis/mflags/minArg/paramsFrom/参数名与默认值/
            // 方法级泛型形参名/方法与参数 attr）全灌——TsigReconcile / ImportedSymbolLoader 消费。
            all[i] = SigsCodec.ToFunction(SigsCodec.ReadEntry(c, z.Pool), new IrBlock[0], 0, 0);
            i = i + 1;
        }
        // MODS/FILE 头切分
        var m = new ZpkgCursor(z.Data, mods.Offset);
        int modCount = m.U32();
        ZpkgModuleSigs[] r = new ZpkgModuleSigs[modCount];
        i = 0;
        while (i < modCount) {
            string ns = z.Pool[m.U32()];
            m.U32();                            // src
            m.U32();                            // hash
            int fnCount = m.U16();
            int firstSig = m.U32();
            if (z.Packed) {
                int k = 0;
                while (k < 5) {                 // func/type/dbug/regt/tidx 五个 len+体
                    int len = m.U32();
                    m.Pos = m.Pos + len;
                    k = k + 1;
                }
            } else {
                m.U32();                        // FILE：zbcHash idx（消费面不需要）
            }
            IrFunction[] fns = new IrFunction[fnCount];
            int j = 0;
            while (j < fnCount) { fns[j] = all[firstSig + j]; j = j + 1; }
            r[i] = new ZpkgModuleSigs(ns, fns, fnCount);
            i = i + 1;
        }
        return r;
    }

    // MODS/FILE → 每模块 TYPE 段体解析（reconcile P2 / drop-tsig-expt P3）。
    // packed：MODS 记录第二个 len+体是 TYPE 字节（与 zbc TYPE 段同构）→ ZbcReader.ReadTypeAt。
    // indexed（drop-tsig-expt）：TYPE 在散装 zbc → 经 FILE 目录 + pkgDir 逐个 load 完整 zbc
    // （各自含局部池）→ ZbcReader.Read → 取 Classes。pkgDir="" 时 indexed 返空（无路径上下文）。
    public static ZpkgModuleTypes[] ReadModuleTypes(ZpkgInfo z, string pkgDir) {
        if (!z.Packed) { return ZpkgReader._readIndexedTypes(z, pkgDir); }
        ZpkgSection mods = z.Section("MODS");
        if (mods == null) { return new ZpkgModuleTypes[0]; }
        var m = new ZpkgCursor(z.Data, mods.Offset);
        int modCount = m.U32();
        ZpkgModuleTypes[] r = new ZpkgModuleTypes[modCount];
        int i = 0;
        while (i < modCount) {
            string ns = z.Pool[m.U32()];
            m.U32();                            // src
            m.U32();                            // hash
            m.U16();                            // fnCount
            m.U32();                            // firstSig
            int funcLen = m.U32();              // ① func 体（跳过）
            m.Pos = m.Pos + funcLen;
            int typeLen = m.U32();              // ② TYPE 体
            IrClassDesc[] classes = new IrClassDesc[0];
            if (typeLen > 0) {
                classes = ZbcReader.ReadTypeAt(z.Data, m.Pos, z.Pool);
                m.Pos = m.Pos + typeLen;
            }
            int k = 0;
            while (k < 3) {                     // ③④⑤ dbug/regt/tidx（跳过）
                int len = m.U32();
                m.Pos = m.Pos + len;
                k = k + 1;
            }
            r[i] = new ZpkgModuleTypes(ns, classes, classes.Length);
            i = i + 1;
        }
        return r;
    }

    // repl-per-symbol-reconcile（T2 Phase 1）：只读 `targetNs` 一个命名空间的 TYPE——packed 经 MODS 目录长度
    // 前缀跳过非目标模块。**关键：一个 ns 可跨多个 MODS 条目（module=源文件，同 ns 的多个源文件）→ 必须
    // 合并所有匹配 ns 的模块**（按 MODS 顺序累积 classes），否则漏掉同 ns 其他文件的类/方法（DiagnosticBag
    // bug）。产出 == `ReadModuleTypes(z)` 中所有 ns 模块的 classes 合并（同 ReadTypeAt、同 MODS 序）→ byte-identical。
    public static ZpkgModuleTypes ReadOneModuleTypes(ZpkgInfo z, string pkgDir, string targetNs) {
        IrClassDesc[] acc = new IrClassDesc[8]; int accn = 0;
        if (!z.Packed) {
            ZpkgModuleTypes[] all = ZpkgReader._readIndexedTypes(z, pkgDir);
            int a = 0;
            while (a < all.Length) {
                if (all[a].Namespace == targetNs) {
                    int c = 0;
                    while (c < all[a].ClassCount) {
                        if (accn == acc.Length) { IrClassDesc[] b = new IrClassDesc[acc.Length * 2]; int k = 0; while (k < accn) { b[k] = acc[k]; k = k + 1; } acc = b; }
                        acc[accn] = all[a].Classes[c]; accn = accn + 1; c = c + 1;
                    }
                }
                a = a + 1;
            }
            return new ZpkgModuleTypes(targetNs, acc, accn);
        }
        ZpkgSection mods = z.Section("MODS");
        if (mods == null) { return new ZpkgModuleTypes(targetNs, acc, 0); }
        var m = new ZpkgCursor(z.Data, mods.Offset);
        int modCount = m.U32();
        int i = 0;
        while (i < modCount) {
            string ns = z.Pool[m.U32()];
            m.U32(); m.U32(); m.U16(); m.U32();   // src / hash / fnCount / firstSig（跳过头）
            int funcLen = m.U32();                 // ① func 体
            m.Pos = m.Pos + funcLen;
            int typeLen = m.U32();                 // ② TYPE 体
            if (ns == targetNs && typeLen > 0) {
                IrClassDesc[] classes = ZbcReader.ReadTypeAt(z.Data, m.Pos, z.Pool);
                int c = 0;
                while (c < classes.Length) {
                    if (accn == acc.Length) { IrClassDesc[] b = new IrClassDesc[acc.Length * 2]; int k = 0; while (k < accn) { b[k] = acc[k]; k = k + 1; } acc = b; }
                    acc[accn] = classes[c]; accn = accn + 1; c = c + 1;
                }
            }
            m.Pos = m.Pos + typeLen;               // 跳过 TYPE 体（不提前 return，故恒跳）
            int k = 0;
            while (k < 3) { int len = m.U32(); m.Pos = m.Pos + len; k = k + 1; }   // ③④⑤ dbug/regt/tidx
            i = i + 1;
        }
        return new ZpkgModuleTypes(targetNs, acc, accn);
    }

    // repl-per-symbol-reconcile（T2 Phase 1）：只读 `targetNs` 的 SIGS——**合并同 ns 的所有模块**函数（按
    // ReadModuleSigs 的 MODS 序），与 ReadOneModuleTypes 的 classes 合并平行对齐 → 方法前缀匹配能命中该 ns
    // 全部文件里的类方法（DiagnosticBag 跨文件 bug）。产出 == 整包 ns 模块函数合并、同序 → byte-identical。
    public static ZpkgModuleSigs ReadOneModuleSigs(ZpkgInfo z, string targetNs) {
        ZpkgModuleSigs[] all = ZpkgReader.ReadModuleSigs(z);
        IrFunction[] acc = new IrFunction[8]; int accn = 0;
        int i = 0;
        while (i < all.Length) {
            if (all[i].Namespace == targetNs) {
                int f = 0;
                while (f < all[i].FuncCount) {
                    if (accn == acc.Length) { IrFunction[] b = new IrFunction[acc.Length * 2]; int k = 0; while (k < accn) { b[k] = acc[k]; k = k + 1; } acc = b; }
                    acc[accn] = all[i].Functions[f]; accn = accn + 1; f = f + 1;
                }
            }
            i = i + 1;
        }
        return new ZpkgModuleSigs(targetNs, acc, accn);
    }

    // indexed 主文件的 FILE 目录 → 每个散装 zbc 相对主文件所在目录的路径（`<src_rel 去 .z42>.zbc`，
    // 与 `_readIndexedTypes` / Rust load_zpkg_indexed 同一走法）。packed → 空数组。
    // 用途：exe 装配 indexed 依赖时连它的散装 zbc 一起拷（fix-bundle-indexed-deps）。
    public static string[] ReadIndexedZbcRels(ZpkgInfo z) {
        if (z.Packed) { return new string[0]; }
        ZpkgSection file = z.Section("FILE");
        if (file == null) { return new string[0]; }
        var m = new ZpkgCursor(z.Data, file.Offset);
        int modCount = m.U32();
        string[] r = new string[modCount];
        int i = 0;
        while (i < modCount) {
            m.U32();                            // ns
            string srcRel = z.Pool[m.U32()];
            m.U32(); m.U16(); m.U32(); m.U32(); // src hash / fnCount / firstSig / zbcHash
            string stem = srcRel;
            if (stem.EndsWith(".z42")) { stem = stem.Substring(0, stem.Length - 4); }
            r[i] = stem + ".zbc";
            i = i + 1;
        }
        return r;
    }

    // indexed 散装 TYPE 读取（drop-tsig-expt P3）：FILE 目录每条 (ns, src_rel) → 散装 zbc 路径
    // `<pkgDir>/<src_rel 去 .z42>.zbc`（镜像 Rust load_zpkg_indexed）→ ZbcReader.Read → Classes。
    private static ZpkgModuleTypes[] _readIndexedTypes(ZpkgInfo z, string pkgDir) {
        ZpkgSection file = z.Section("FILE");
        if (file == null || pkgDir == "") { return new ZpkgModuleTypes[0]; }
        var m = new ZpkgCursor(z.Data, file.Offset);
        int modCount = m.U32();
        ZpkgModuleTypes[] r = new ZpkgModuleTypes[modCount];
        int i = 0;
        while (i < modCount) {
            string ns = z.Pool[m.U32()];
            string srcRel = z.Pool[m.U32()];   // 项目相对源路径（.z42, fwd-slash）
            m.U32();                            // src hash
            m.U16();                            // fnCount
            m.U32();                            // firstSig
            m.U32();                            // zbcHash idx
            string stem = srcRel;
            if (stem.EndsWith(".z42")) { stem = stem.Substring(0, stem.Length - 4); }
            string zbcPath = Path.Join(pkgDir, stem + ".zbc");
            IrClassDesc[] classes = new IrClassDesc[0];
            if (File.Exists(zbcPath)) {
                IrModule mod = ZbcReader.Read(File.ReadAllBytes(zbcPath));
                if (mod != null) { r[i] = new ZpkgModuleTypes(ns, mod.Classes, mod.ClassCount); i = i + 1; continue; }
            }
            r[i] = new ZpkgModuleTypes(ns, classes, classes.Length);
            i = i + 1;
        }
        return r;
    }

    // MODS 头 → 每模块 (源文件, 源 SHA-256, ns)。增量 probe 消费面
    // （port-incremental-build-cache）：与 ReadModuleSigs 同一游标走法，只取头三个池索引。
    public static ZpkgSourceHash[] ReadSourceHashes(ZpkgInfo z) {
        ZpkgSection mods = z.Section("MODS");
        if (mods == null) { return new ZpkgSourceHash[0]; }
        var m = new ZpkgCursor(z.Data, mods.Offset);
        int modCount = m.U32();
        ZpkgSourceHash[] r = new ZpkgSourceHash[modCount];
        int i = 0;
        while (i < modCount) {
            string ns = z.Pool[m.U32()];
            string src = z.Pool[m.U32()];
            string hash = z.Pool[m.U32()];
            m.U16();                            // fnCount
            m.U32();                            // firstSigIdx
            int k = 0;
            while (k < 5) {                     // func/type/dbug/regt/tidx 五个 len+体
                int len = m.U32();
                m.Pos = m.Pos + len;
                k = k + 1;
            }
            r[i] = new ZpkgSourceHash(src, hash, ns);
            i = i + 1;
        }
        return r;
    }

    // 读 IMPL → 按位置挂到 r[mi].Impls（镜像 C# ReadImplSection；老 zpkg 无 IMPL → 留空）。
    public static void ReadImplInto(ZpkgInfo z, ExportedModuleZ[] r, int modCount) {
        ZpkgSection s = z.Section("IMPL");
        if (s == null) { return; }
        var c = new ZpkgCursor(z.Data, s.Offset);
        int imc = c.U16();
        int mi = 0;
        while (mi < imc) {
            c.U32();                              // ns idx（位置匹配，不用）
            int implCount = c.U16();
            ExportedImplZ[] impls = new ExportedImplZ[implCount];
            int ii = 0;
            while (ii < implCount) {
                string targetFq = z.Pool[c.U32()];
                string traitFq = z.Pool[c.U32()];
                int argc = c.U8();
                string[] args = new string[argc];
                int a = 0;
                while (a < argc) { args[a] = z.Pool[c.U32()]; a = a + 1; }
                int mthCount = c.U16();
                ExportedMethodZ[] ms = new ExportedMethodZ[mthCount];
                int m = 0;
                while (m < mthCount) { ms[m] = ZpkgReader._method(c, z); m = m + 1; }
                impls[ii] = new ExportedImplZ(targetFq, traitFq, args, argc, ms, mthCount);
                ii = ii + 1;
            }
            if (mi < r.Length && implCount > 0) { r[mi].Impls = impls; r[mi].ImplCount = implCount; }
            mi = mi + 1;
        }
    }

    // ── 私有助手 ─────────────────────────────────────────────────────────────

    private static ExportedMethodZ _method(ZpkgCursor c, ZpkgInfo z) {
        string name = z.Pool[c.U32()];
        string ret = z.Pool[c.U32()];
        string vis = z.Pool[c.U32()];
        int flags = c.U8();
        int minArg = c.U16();
        int pc = c.U8();
        int paramsFrom = ZpkgReader._paramsFromInt(c.U8());
        ExportedParamZ[] ps = new ExportedParamZ[pc];
        int i = 0;
        while (i < pc) {
            string pn = z.Pool[c.U32()];
            ps[i] = new ExportedParamZ(pn, z.Pool[c.U32()]);
            i = i + 1;
        }
        ExportedMethodZ em = new ExportedMethodZ(name, ret, vis,
                                   (flags & 1) != 0, (flags & 2) != 0, (flags & 4) != 0,
                                   minArg, ps, pc);
        em.ParamsFrom = paramsFrom;
        return em;
    }

    // add-params-varargs：TSIG 字节 0xFF（255）哨兵 ↔ in-memory -1（design D2）。
    private static int _paramsFromInt(int paramsFromByte) {
        if (paramsFromByte == 255) { return 0 - 1; }
        return paramsFromByte;
    }

    private static string _str(ZpkgCursor c) {
        int len = c.U16();
        return c.Str(len);
    }
}

// MODS 头条目（增量 probe：源文件 → 上次构建的源 hash + ns）。
public sealed class ZpkgSourceHash {
    public string SourceFile;
    public string SourceHash;
    public string Namespace;
    public ZpkgSourceHash(string sourceFile, string sourceHash, string ns) {
        this.SourceFile = sourceFile; this.SourceHash = sourceHash; this.Namespace = ns;
    }
}

// 模块签名组（ns + SIGS stub 列表）。
public sealed class ZpkgModuleSigs {
    public string       Namespace;
    public IrFunction[] Functions;
    public int          FuncCount;
    // perf-tsig-reconcile-index：按类分桶的函数索引（懒建，见 SigsClassIndex.Ensure；null = 未建）。
    public StrIndex     ByClassHead;
    public int[]        ByClassNext;
    public ZpkgModuleSigs(string ns, IrFunction[] functions, int funcCount) {
        this.Namespace = ns; this.Functions = functions; this.FuncCount = funcCount;
    }
}

// 每模块 TYPE 段解析结果（reconcile-tsig-from-runtime-sections）。
public sealed class ZpkgModuleTypes {
    public string        Namespace;
    public IrClassDesc[] Classes;
    public int           ClassCount;
    public ZpkgModuleTypes(string ns, IrClassDesc[] classes, int classCount) {
        this.Namespace = ns; this.Classes = classes; this.ClassCount = classCount;
    }
}
