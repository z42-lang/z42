namespace Z42.IR;

// TYPE 的接口方法没有独立属性块。按方法槽分组，每个类型形参一条记录，顺序与声明一致。
public static class IrIfaceMethodGenerics {
    private static string _sentinel = "$IfaceMethodGeneric";

    public static IrAttrRef Encode(int slot, string name, IrConstraintDesc desc) {
        var d = desc == null ? new IrConstraintDesc() : desc;
        string flags = (d.RequiresClass ? "c" : "-") + (d.RequiresStruct ? "s" : "-")
            + (d.RequiresCtor ? "n" : "-") + (d.RequiresEnum ? "e" : "-");
        string values = slot.ToString() + "\n" + name + "\n" + flags + "\n" + d.BaseClass + "\n" + d.TypeParamConstraint;
        string interfaces = "";
        int i = 0;
        while (i < d.InterfaceCount) {
            if (i > 0) { interfaces = interfaces + "\t"; }
            interfaces = interfaces + d.Interfaces[i];
            i = i + 1;
        }
        string associated = "";
        int j = 0;
        while (j < d.AssocBindingCount) {
            if (j > 0) { associated = associated + "\t"; }
            associated = associated + d.AssocBindingNames[j] + "\t" + d.AssocBindingTypeNames[j];
            j = j + 1;
        }
        return new IrAttrRef(_sentinel, values + "\n" + interfaces + "\n" + associated);
    }

    public static void Restore(IrAttrRef[] attrs, int count, int slot, ExportedMethodZ method) {
        string prefix = slot.ToString() + "\n";
        int arity = 0;
        int i = 0;
        while (i < count) {
            if (_matches(attrs[i], prefix)) { arity = arity + 1; }
            i = i + 1;
        }
        if (arity == 0) { return; }
        string[] names = new string[arity];
        IrConstraintDesc[] constraints = new IrConstraintDesc[arity];
        int p = 0;
        i = 0;
        while (i < count) {
            if (_matches(attrs[i], prefix)) {
                string[] parts = attrs[i].FactoryFunc.Split("\n");
                if (parts.Length != 7 || parts[1] == "" || parts[2].Length != 4) {
                    throw new InvalidOperationException("invalid interface method generic metadata");
                }
                names[p] = parts[1];
                constraints[p] = _constraint(parts);
                p = p + 1;
            }
            i = i + 1;
        }
        method.TypeParams = names;
        method.TypeParamCount = arity;
        method.TypeParamConstraints = constraints;
    }

    private static bool _matches(IrAttrRef attr, string prefix) {
        return attr.TypeName == _sentinel && attr.FactoryFunc.StartsWith(prefix);
    }

    private static IrConstraintDesc _constraint(string[] parts) {
        var d = new IrConstraintDesc();
        string flags = parts[2];
        d.RequiresClass = flags.CharAt(0) == 'c';
        d.RequiresStruct = flags.CharAt(1) == 's';
        d.RequiresCtor = flags.CharAt(2) == 'n';
        d.RequiresEnum = flags.CharAt(3) == 'e';
        d.BaseClass = parts[3];
        d.TypeParamConstraint = parts[4];
        if (parts[5] != "") {
            d.Interfaces = parts[5].Split("\t");
            d.InterfaceCount = d.Interfaces.Length;
        }
        if (parts[6] != "") {
            string[] pairs = parts[6].Split("\t");
            if (pairs.Length % 2 != 0) {
                throw new InvalidOperationException("invalid interface method associated type constraints");
            }
            d.AssocBindingCount = pairs.Length / 2;
            d.AssocBindingNames = new string[d.AssocBindingCount];
            d.AssocBindingTypeNames = new string[d.AssocBindingCount];
            int i = 0;
            while (i < d.AssocBindingCount) {
                d.AssocBindingNames[i] = pairs[i * 2];
                d.AssocBindingTypeNames[i] = pairs[i * 2 + 1];
                i = i + 1;
            }
        }
        return d;
    }
}
