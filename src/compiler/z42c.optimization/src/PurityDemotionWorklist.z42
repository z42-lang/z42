namespace Z42.Optimization;

using Z42.IR;

// Negative propagation for one immutable module snapshot. Bodies are invalidated
// once; a name is removed only when its last active provider is invalidated.
internal sealed class PurityDemotionWorklist {
    private IrModule _module;
    private StrMap _pure;
    private bool[] _active;
    private int[] _providers;
    private bool[] _dropped;
    private int[] _heads;
    private int[] _callers;
    private int[] _next;
    private int[] _queue;
    private int _tail;

    private PurityDemotionWorklist(IrModule m, StrMap pure, bool[] active) {
        this._module = m; this._active = active; this._pure = pure;
        // The input set is never mutated here, so its hash slots are stable name IDs.
        int cap = pure.Capacity();
        this._providers = new int[cap]; this._dropped = new bool[cap];
        this._heads = new int[cap]; this._queue = new int[pure.Count()]; this._tail = 0;
        int fi = 0;
        while (fi < m.FuncCount) {
            if (active[fi]) {
                int name = pure.Find(m.Functions[fi].Name);
                this._providers[name] = this._providers[name] + 1;
            }
            fi = fi + 1;
        }
        int edges = PurityDemotionWorklist._edgeCapacity(m, active);
        this._callers = new int[edges]; this._next = new int[edges];
        this._build();
    }

    public static StrMap Finish(IrModule m, StrMap pure, bool[] active) {
        var graph = new PurityDemotionWorklist(m, pure, active);
        bool[] used = pure.UsedArr();
        int slot = 0;
        while (slot < used.Length) {
            if (used[slot] && graph._providers[slot] == 0) { graph._drop(slot); }
            slot = slot + 1;
        }
        if (graph._tail == 0) { return pure; }
        int head = 0;
        while (head < graph._tail) {
            int edge = graph._heads[graph._queue[head]]; head = head + 1;
            while (edge > 0) {
                graph._invalidate(graph._callers[edge - 1]); edge = graph._next[edge - 1];
            }
        }
        int count = 0; slot = 0;
        while (slot < used.Length) {
            if (used[slot] && graph._providers[slot] > 0) { count = count + 1; }
            slot = slot + 1;
        }
        StrMap result = new StrMap(count);
        if (count == 0) { return result; }
        slot = 0;
        while (slot < used.Length) {
            if (used[slot] && graph._providers[slot] > 0) { result.Put(pure.KeyAt(slot), "1"); }
            slot = slot + 1;
        }
        return result;
    }

    private void _drop(int name) {
        if (this._dropped[name]) { return; }
        this._dropped[name] = true;
        this._queue[this._tail] = name; this._tail = this._tail + 1;
    }

    private void _invalidate(int fi) {
        if (!this._active[fi]) { return; }
        this._active[fi] = false;
        int name = this._pure.Find(this._module.Functions[fi].Name);
        this._providers[name] = this._providers[name] - 1;
        if (this._providers[name] == 0) { this._drop(name); }
    }

    private static int _edgeCapacity(IrModule m, bool[] active) {
        int count = 0; int fi = 0;
        while (fi < m.FuncCount) {
            if (active[fi]) {
                int bi = 0;
                while (bi < m.Functions[fi].BlockCount) {
                    IrBlock block = m.Functions[fi].Blocks[bi]; int ii = 0;
                    while (ii < block.InstrCount) {
                        if (block.Instrs[ii] is CallInstr) { count = count + 1; }
                        ii = ii + 1;
                    }
                    bi = bi + 1;
                }
            }
            fi = fi + 1;
        }
        return count;
    }

    private void _build() {
        int edge = 0; int fi = 0;
        while (fi < this._module.FuncCount) {
            if (this._active[fi]) {
                int bi = 0;
                while (bi < this._module.Functions[fi].BlockCount) {
                    IrBlock block = this._module.Functions[fi].Blocks[bi]; int ii = 0;
                    while (ii < block.InstrCount) {
                        if (block.Instrs[ii] is CallInstr) {
                            int callee = this._pure.Find((block.Instrs[ii] as CallInstr).Func);
                            if (callee >= 0) {
                                this._callers[edge] = fi; this._next[edge] = this._heads[callee];
                                this._heads[callee] = edge + 1; edge = edge + 1;
                            } else { this._invalidate(fi); }
                        }
                        ii = ii + 1;
                    }
                    bi = bi + 1;
                }
            }
            fi = fi + 1;
        }
    }
}
