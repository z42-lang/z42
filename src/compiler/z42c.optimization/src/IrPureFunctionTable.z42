// IrPureFunctionTable —— 纯函数推断（add-pure-call-opt）。
//
// 给每个同模块函数算「是否纯」：pure(f) ⟺ f 的每条指令都是「IsPure 白名单内」或「对纯函数的
// CallInstr」或「readonly 字段读（FieldGetInstr.Readonly）」，且没有块以 throw 终结。纯 = 同参数
// 同结果 + 无副作用 + 不抛 → 其调用可被 CSE 消重 / LICM 外提。摘要互相依赖（f 调 g）→ 模块单调
// 不动点。方向与 IrEscapeSummary **相反**：escape 乐观全 false 上升；pure 乐观全纯，发现副作用/读
// 可变/抛/调非纯就**降级**，单调收缩到不动点。imported / 无体函数 → 未登记 → 保守非纯。
// 设计见 docs/spec/changes/add-pure-call-opt/design.md（Decision 2/4）。
//
// StrMap 无 Remove（compiler-z42c.md 踩坑）→ 不动点每轮**重建** pure 集（单调收缩，几轮收敛）。
namespace Z42.Optimization;

using Z42.IR;

// 纯函数集：名字在集中 = 纯。查 O(1)。跨包/无体/被降级 → 不在集 → IsPure 返 false（保守）。
// 另带「可投机执行」子集（IsSpeculatable）：LICM 把调用提到**可能零迭代**的 pre-header 时用它，
// 见 IrPureFunctionTable._computeSpeculatable 的头注。
public sealed class PureTable {
    private StrMap _set;    // funcName → "1"（纯）
    private StrMap _spec;   // funcName → "1"（纯 ∧ 可投机）

    public PureTable(StrMap set, StrMap spec) { this._set = set; this._spec = spec; }

    public bool IsPure(string name) { return this._set.ContainsKey(name); }

    public bool IsSpeculatable(string name) { return this._spec.ContainsKey(name); }
}

public sealed class IrPureFunctionTable {

    // 模块入口：单调不动点算全模块纯度。
    public static PureTable Compute(IrModule m) {
        // 乐观初值：每个有体函数先当纯（无体 abstract/extern 不登记 → 永远非纯，调用点保守）。
        StrMap pure = new StrMap();
        int fi = 0;
        while (fi < m.FuncCount) {
            IrFunction f = m.Functions[fi];
            if (f.BlockCount > 0) { pure.Put(f.Name, "1"); }
            fi = fi + 1;
        }
        // 单调收缩不动点：反复重建——用当前 pure 集判每个函数，只保留仍纯的。集合只缩不增 →
        //   某轮无函数被降级即收敛。重建避开 StrMap 无 Remove。
        bool changed = true;
        while (changed) {
            changed = false;
            StrMap next = new StrMap();
            fi = 0;
            while (fi < m.FuncCount) {
                IrFunction f = m.Functions[fi];
                if (f.BlockCount > 0) {
                    bool isP = IrPureFunctionTable._isFuncPure(f, pure);
                    if (isP) { next.Put(f.Name, "1"); }
                    else if (pure.ContainsKey(f.Name)) { changed = true; }   // 本轮从纯降级
                }
                fi = fi + 1;
            }
            pure = next;
        }
        return new PureTable(pure, IrPureFunctionTable._computeSpeculatable(m, pure));
    }

    // ── 可投机执行（fix-release-opt-soundness；fix-licm-no-recursive-speculation）──────────────
    // 「纯」够 CSE 用：同一处两次调用，第一次抛/不返回则第二次根本到不了，消重不改语义。但 LICM
    // 把调用提到 pre-header 是**投机**——循环一次都不转时，原程序根本不调用它。所以额外要求：
    //   · 不含 FieldGet：纯允许 readonly 字段读，而接收者（形参）可能是 null → 投机调用凭空抛 NPE；
    //   · 控制流无环：含 `while (k > 0) {}` 的函数可能不终止 → 投机调用挂死；
    //   · **不递归**（直接或互相）：不终止的递归同理，投机执行会在原本不执行的地方栈溢出；
    //   · 只调可投机的函数。
    // 用**最小**不动点（从空集往上长）：一个函数入集当且仅当它的每个 callee 已在集中 ⇒ 递归环上的函数
    // 永远等不到彼此入集，天然被排除。代价：`fib` 这类递归纯函数不再外提（User 2026-09-30 裁决：正确性
    // 优先；add-pure-call-opt 的 ~200× bench 随之回退，CSE 消重不受影响）。
    private static StrMap _computeSpeculatable(IrModule m, StrMap pure) {
        StrMap spec = new StrMap();
        bool changed = true;
        while (changed) {
            changed = false;
            int fi = 0;
            while (fi < m.FuncCount) {
                IrFunction f = m.Functions[fi];
                if (!spec.ContainsKey(f.Name) && pure.ContainsKey(f.Name)
                    && !IrPureFunctionTable._hasFieldGet(f) && IrPureFunctionTable._isAcyclic(f)
                    && IrPureFunctionTable._callsOnly(f, spec)) {
                    spec.Put(f.Name, "1");
                    changed = true;
                }
                fi = fi + 1;
            }
        }
        return spec;
    }

    private static bool _hasFieldGet(IrFunction f) {
        int b = 0;
        while (b < f.BlockCount) {
            IrBlock blk = f.Blocks[b];
            int ii = 0;
            while (ii < blk.InstrCount) { if (blk.Instrs[ii] is FieldGetInstr) { return true; } ii = ii + 1; }
            b = b + 1;
        }
        return false;
    }

    private static bool _callsOnly(IrFunction f, StrMap set) {
        int b = 0;
        while (b < f.BlockCount) {
            IrBlock blk = f.Blocks[b];
            int ii = 0;
            while (ii < blk.InstrCount) {
                if (blk.Instrs[ii] is CallInstr && !set.ContainsKey((blk.Instrs[ii] as CallInstr).Func)) { return false; }
                ii = ii + 1;
            }
            b = b + 1;
        }
        return true;
    }

    // 块图无环（无回边）：迭代式三色 DFS。找不到的跳转目标按「有环」保守处理。
    private static bool _isAcyclic(IrFunction f) {
        int n = f.BlockCount;
        if (n == 0) { return true; }
        StrIndex byLabel = new StrIndex();
        int i = 0;
        while (i < n) { byLabel.Put(f.Blocks[i].Label, i); i = i + 1; }
        int[] color = new int[n];      // 0 白 / 1 灰（在栈上）/ 2 黑
        int[] stack = new int[n];
        int[] next  = new int[n];      // 每块下一条待访问的出边序号
        int sp = 0;
        stack[0] = 0; color[0] = 1; sp = 1;
        while (sp > 0) {
            int u = stack[sp - 1];
            int v = IrPureFunctionTable._succ(f.Blocks[u], next[u], byLabel);
            next[u] = next[u] + 1;
            if (v == -2) { color[u] = 2; sp = sp - 1; continue; }   // 出边用尽
            if (v < 0) { return false; }                             // 目标找不到 → 保守
            if (color[v] == 1) { return false; }                     // 回边
            if (color[v] == 0) { color[v] = 1; stack[sp] = v; sp = sp + 1; }
        }
        return true;
    }

    // 块 b 的第 k 条后继块号；用尽返回 -2，目标 label 查不到返回 -1。
    private static int _succ(IrBlock b, int k, StrIndex byLabel) {
        if (!b.HasTerm) { return -2; }
        string lbl = "";
        if (b.Term is BrTerm) { if (k > 0) { return -2; } lbl = (b.Term as BrTerm).Label; }
        else if (b.Term is BrCondTerm) {
            if (k == 0) { lbl = (b.Term as BrCondTerm).TrueLabel; }
            else if (k == 1) { lbl = (b.Term as BrCondTerm).FalseLabel; }
            else { return -2; }
        } else { return -2; }
        return byLabel.Get(lbl);
    }

    // f 是否纯（用给定 pure 集判 callee）：每块终结子非 throw；每条指令属纯白名单/纯调用/readonly-fget。
    private static bool _isFuncPure(IrFunction f, StrMap pure) {
        int b = 0;
        while (b < f.BlockCount) {
            IrBlock blk = f.Blocks[b];
            if (blk.HasTerm && blk.Term is ThrowTerm) { return false; }   // 会抛 → 非纯（LICM no-throw）
            int ii = 0;
            while (ii < blk.InstrCount) {
                if (!IrPureFunctionTable._isInstrPure(blk.Instrs[ii], pure)) { return false; }
                ii = ii + 1;
            }
            b = b + 1;
        }
        return true;
    }

    // 单条指令是否保纯：IsPure 白名单 / readonly 字段读 / 对纯函数的直接调用。其余全破坏纯度
    //   （FieldSet/StaticSet/ArraySet 写、非 readonly FieldGet·StaticGet·ArrayGet·ArrayLen 读可变、
    //    ObjNew/ArrayNew*/MkClos/StrConcat/ToStr 分配、Div/Rem 陷阱、Builtin/CallNative IO、
    //    VCall/CallIndirect 动态派发、调非纯 CallInstr）。
    private static bool _isInstrPure(IrInstr ins, StrMap pure) {
        if (ins.IsPure()) { return true; }
        if (ins is FieldGetInstr) { return (ins as FieldGetInstr).Readonly; }   // readonly 字段读确定
        if (ins is CallInstr) { return pure.ContainsKey((ins as CallInstr).Func); }
        return false;
    }
}
