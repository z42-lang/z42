// z42.doc DocMd 单测：reference 包页的 markdown 渲染（页首 / 标题 / 包路径 / //! 正文 / warning /
// 类型签名总览块 / 成员参数表 / 异常 / 示例）。
namespace Z42DocMdTests;

using Z42.Doc;
using Std.Harness;

DocIndex _index(string src) {
    DocIndex ix = new DocIndex();
    ix.AddAll(SyntaxIndexer.IndexSource(src, "Random.z42"));
    return ix;
}

[Test]
void test_package_page_structure() {
    DocIndex ix = _index(
        "//! 伪随机数：给同一个 seed 得到同一串数。\n"
        + "//!\n"
        + "//! 适合测试 fixture。\n"
        + "//! @warning 不是 CSPRNG\n"
        + "namespace Std.Random;\n"
        + "\n"
        + "/// PCG 伪随机数发生器。\n"
        + "public class Random {\n"
        + "    /// 固定 seed。\n"
        + "    /// @param seed 种子\n"
        + "    public Random(long seed) { }\n"
        + "\n"
        + "    /// 返回 [min, max) 内的整数。\n"
        + "    /// @param min 下界\n"
        + "    /// @param max 上界\n"
        + "    /// @throws ArgumentException `max <= min`\n"
        + "    public int NextIntRange(int min, int max) { return min; }\n"
        + "}\n");
    string page = DocMd.PackagePage("z42.random", "src/libraries/z42.random", ix);

    // 页首注释 + 标题 + 包路径行。
    Assert.Contains("<!-- 由 z42 doc 生成，勿手改。源：src/libraries/z42.random/ -->", page);
    Assert.Contains("# z42.random —— 伪随机数：给同一个 seed 得到同一串数。", page);
    Assert.Contains("> 包路径 `src/libraries/z42.random/`；命名空间 `Std.Random`", page);
    // //! 正文 + warning。
    Assert.Contains("适合测试 fixture。", page);
    Assert.Contains("> ⚠️ 不是 CSPRNG", page);
    // 类型标题 + 类型文档 + 源码位置 + 签名总览块。
    Assert.Contains("## Random", page);
    Assert.Contains("PCG 伪随机数发生器。", page);
    Assert.Contains("`Random.z42:", page);
    Assert.Contains("public class Random {", page);
    Assert.Contains("Random(long seed)", page);
    Assert.Contains("int NextIntRange(int min, int max)", page);
    // 成员标题 + 参数表 + 异常。
    Assert.Contains("### Random(long seed)", page);
    Assert.Contains("| `seed` | 种子 |", page);
    Assert.Contains("### int NextIntRange(int min, int max)", page);
    Assert.Contains("| `min` | 下界 |", page);
    Assert.Contains("| `max` | 上界 |", page);
    Assert.Contains("抛 `ArgumentException`：`max <= min`", page);
}

[Test]
void test_private_members_excluded() {
    // reference 页是公开 API：private 成员不进签名总览块、也不单独成节。
    DocIndex ix = _index(
        "namespace App;\n"
        + "/// 类。\npublic class C {\n"
        + "    /// 公开方法。\n    public void Pub() { }\n"
        + "    private int _secret;\n"
        + "    private void Hidden() { }\n"
        + "}\n");
    string page = DocMd.PackagePage("p", "src", ix);
    Assert.Contains("### void Pub()", page);
    Assert.True(!page.Contains("_secret"));
    Assert.True(!page.Contains("Hidden"));
}

[Test]
void test_type_split_pages() {
    // split = "type"：每个顶层类型一页，索引页列链接清单。
    DocIndex ix = _index(
        "//! 核心类型。\n"
        + "//!\n"
        + "//! 分类型拆页。\n"
        + "namespace Std;\n"
        + "\n"
        + "/// 数学工具。\n"
        + "public class Math {\n"
        + "    /// 取绝对值。\n"
        + "    /// @param x 输入\n"
        + "    public int Abs(int x) { return x; }\n"
        + "}\n"
        + "\n"
        + "/// 文本。\n"
        + "public class Text {\n"
        + "    /// 转大写。\n"
        + "    public string Upper(string s) { return s; }\n"
        + "}\n");
    DocItem[] tops = DocMd.TopLevelTypes(ix, "Std");
    Assert.Equal(2, tops.Length);
    _eq("Math", tops[0].Name);
    _eq("Text", tops[1].Name);

    // 类型页：标题 = pkg.Type（只写一次，不重复类型名标题），成员是 ###。
    TypeGroup[] groups = DocMd.TopLevelTypeGroups(ix, "Std");
    Assert.Equal(2, groups.Length);
    string tp = DocMd.TypePage("z42.core", "src/libraries/z42.core", "Std", groups[0], ix);
    Assert.Contains("# z42.core.Math", tp);
    Assert.Contains("> 包路径 `src/libraries/z42.core/`；命名空间 `Std`", tp);
    Assert.True(!tp.Contains("\n# Math"));
    Assert.Contains("数学工具。", tp);
    Assert.Contains("`Random.z42:", tp);
    Assert.Contains("### int Abs(int x)", tp);
    Assert.Contains("| `x` | 输入 |", tp);

    // 索引页：//! 概述 + 类型链接清单。
    string ti = DocMd.TypeIndex("z42.core", "src/libraries/z42.core", ix);
    Assert.Contains("# z42.core —— 核心类型。", ti);
    Assert.Contains("分类型拆页。", ti);
    Assert.Contains("- [Math](core.Math.md)", ti);
    Assert.Contains("- [Text](core.Text.md)", ti);
}

[Test]
void test_type_split_same_name_groups() {
    // 同名声明分组：泛型委托各元数合并成一页（每个声明一个 `##` 节，节题带泛型参数）；
    // partial 跨文件的同 Id 声明并为一个代表（成员按 Id 聚合，不重复渲染）。
    DocIndex ix = _index(
        "namespace Std;\n"
        + "/// 一参数。\n"
        + "public delegate void Action<T>(T a);\n"
        + "/// 两参数。\n"
        + "public delegate void Action<T1,T2>(T1 a, T2 b);\n"
        + "\n"
        + "/// 列表。\n"
        + "public partial class List<T> {\n"
        + "    /// 加元素。\n    public void Add(T item) { }\n"
        + "}\n"
        + "\n"
        + "public partial class List<T> {\n"
        + "    /// 个数。\n    public int Count() { return 0; }\n"
        + "}\n");
    TypeGroup[] groups = DocMd.TopLevelTypeGroups(ix, "Std");
    Assert.Equal(2, groups.Length);
    _eq("Action", groups[0].Name);
    Assert.Equal(2, groups[0].Decls.Length);
    _eq("List", groups[1].Name);
    Assert.Equal(1, groups[1].Decls.Length);

    // 合并页：页标题一次，两个声明各一节，节题带元数；索引页只链接一次。
    string ap = DocMd.TypePage("z42.core", "src/libraries/z42.core", "Std", groups[0], ix);
    Assert.Contains("# z42.core.Action", ap);
    Assert.Contains("## Action<T>", ap);
    Assert.Contains("## Action<T1,T2>", ap);
    Assert.Contains("一参数。", ap);
    Assert.Contains("两参数。", ap);

    // partial 去重：两个文件的成员都在同一节里，类型文档取有 /// 的代表。
    string lp = DocMd.TypePage("z42.core", "src/libraries/z42.core", "Std", groups[1], ix);
    Assert.Contains("列表。", lp);
    Assert.Contains("### void Add(T item)", lp);
    Assert.Contains("### int Count()", lp);

    string ti = DocMd.TypeIndex("z42.core", "src", ix);
    Assert.Equal(1, _count(ti, "- [Action](core.Action.md)"));
    Assert.Equal(1, _count(ti, "- [List](core.List.md)"));
}

int _count(string haystack, string needle) {
    // z42 的 IndexOf 无 (string, int) 起点重载，用剩余片段迭代。
    int n = 0;
    string rest = haystack;
    int at = rest.IndexOf(needle);
    while (at >= 0) {
        n = n + 1;
        rest = rest.Substring(at + needle.Length);
        at = rest.IndexOf(needle);
    }
    return n;
}

[Test]
void test_type_split_multi_namespace() {
    // 多命名空间包：Namespaces 列全、TypeIndex 链接清单覆盖所有命名空间的类型（跨文件，每文件一个 namespace）。
    DocIndex ix = new DocIndex();
    ix.AddAll(SyntaxIndexer.IndexSource(
        "//! 核心。\nnamespace Std;\n"
        + "/// 数学。\npublic class Math { public int Abs(int x) { return x; } }\n", "A.z42"));
    ix.AddAll(SyntaxIndexer.IndexSource(
        "namespace Std.IO;\n"
        + "/// 控制台。\npublic class Console { public void Write(string s) { } }\n", "B.z42"));
    string[] nss = DocMd.Namespaces(ix);
    Assert.Equal(2, nss.Length);
    _eq("Std", nss[0]);
    _eq("Std.IO", nss[1]);
    string ti = DocMd.TypeIndex("z42.core", "src", ix);
    Assert.Contains("- [Math](core.Math.md)", ti);
    Assert.Contains("- [Console](core.Console.md)", ti);
}

void _eq(string expected, string actual) {
    if (expected != actual) { Assert.Fail("expected <" + expected + ">\n     got <" + actual + ">"); }
}

[Test]
void test_package_page_delegate_and_enum() {
    // 委托只有签名（无体）；枚举成员进总览块、不单独成节。
    DocIndex ix = _index(
        "namespace App;\n"
        + "/// 回调。\npublic delegate void Handler(int code);\n"
        + "/// 种类。\npublic enum Kind {\n"
        + "    /// 圆形。\n    Round,\n"
        + "    Polygon\n"
        + "}\n");
    string page = DocMd.PackagePage("z42.shapes", "src", ix);
    Assert.Contains("```z42\npublic delegate void Handler(int code)\n```", page);
    Assert.Contains("public enum Kind {", page);
    Assert.Contains("Round", page);
    Assert.Contains("Polygon", page);
    // 枚举成员不单独成 ### 节。
    Assert.True(!page.Contains("### Round"));
}
