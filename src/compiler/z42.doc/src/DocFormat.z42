// `z42 doc` 的文本输出。刻意极简：主要读者是 agent，每多一行都是 token。位置一律 `path:line`，
// 拿到后按行号精确读实现即可。
namespace Z42.Doc;

using Std.Text;

public static class DocFormat {
    // 单个符号：签名 + 所属 + 结构化 doc（摘要 / 正文 / tag / 示例）+ 位置。
    public static string Show(DocItem it) {
        StringBuilder sb = new StringBuilder();
        sb.Append(it.Sig);
        if (it.Parent.Length > 0) { sb.Append("    ").Append(it.Parent); }
        sb.Append("\n");
        sb.Append(DocFormat.ShowDoc(it.Doc));
        sb.Append("  @ ").Append(DocFormat.Loc(it)).Append("\n");
        return sb.ToString();
    }

    // doc 原文 → 结构化文本：摘要一行、正文逐行、单行 tag 各一行、示例另起。@hidden 条目由
    // 调用方过滤，这里不特判。
    public static string ShowDoc(string doc) {
        DocComment c = DocParser.Parse(doc);
        StringBuilder sb = new StringBuilder();
        if (c.Summary.Length > 0) { sb.Append("  ").Append(c.Summary).Append("\n"); }
        if (c.Body.Length > 0) {
            string[] bl = c.Body.Split("\n");
            int i = 0;
            while (i < bl.Length) {
                string t = bl[i].Trim();
                if (t.Length == 0) { sb.Append("\n"); }
                else { sb.Append("  ").Append(t).Append("\n"); }
                i = i + 1;
            }
        }
        int j = 0;
        while (j < c.Tags.Length) {
            sb.Append("  ").Append(DocFormat._tagLine(c.Tags[j])).Append("\n");
            j = j + 1;
        }
        int k = 0;
        while (k < c.Examples.Length) {
            DocExample ex = c.Examples[k];
            string mode = ex.Mode == "run" ? "" : "[" + ex.Mode + "]";
            sb.Append("  example").Append(mode).Append(":\n");
            string[] cl = ex.Code.Split("\n");
            int m = 0;
            while (m < cl.Length) { sb.Append("      ").Append(cl[m]).Append("\n"); m = m + 1; }
            k = k + 1;
        }
        return sb.ToString();
    }

    // 一条单行 tag → `tag Name  Text`（throws / param / typeparam 带名字，returns / see / warning 不带）。
    private static string _tagLine(DocTag t) {
        if (t.Tag == "throws")   { return DocFormat._named(t, "throws"); }
        if (t.Tag == "param")    { return DocFormat._named(t, "param"); }
        if (t.Tag == "typeparam") { return DocFormat._named(t, "typeparam"); }
        if (t.Tag == "returns")  { return "returns " + t.Text; }
        if (t.Tag == "see")      { return "see " + t.Text; }
        if (t.Tag == "warning")  { return "warning: " + t.Text; }
        return t.Tag + (t.Name.Length > 0 ? " " + t.Name : "") + (t.Text.Length > 0 ? "  " + t.Text : "");
    }

    private static string _named(DocTag t, string tag) {
        return tag + " " + t.Name + (t.Text.Length > 0 ? "  " + t.Text : "");
    }

    // 类型 / 命名空间轮廓：头一行 + 摘要，然后每个成员一行 `<可见性><签名>  <摘要>  :<行>`。
    // 可见性按 UML 写一个字符：+ public、# protected、~ internal、- private。
    public static string Outline(DocItem head, DocItem[] members) {
        StringBuilder sb = new StringBuilder();
        sb.Append(head.Kind).Append(" ").Append(head.Id);
        if (head.File.Length > 0) { sb.Append("    ").Append(DocFormat.Loc(head)); }
        sb.Append("\n");
        string hs = head.Summary();
        if (hs.Length > 0) { sb.Append("  ").Append(hs).Append("\n"); }
        int w = 0;
        int i = 0;
        while (i < members.Length) {
            int l = DocFormat._shortSig(members[i]).Length;
            if (l > w) { w = l; }
            i = i + 1;
        }
        if (w > 56) { w = 56; }
        i = 0;
        while (i < members.Length) {
            DocItem m = members[i];
            string sig = DocFormat._shortSig(m);
            sb.Append("  ").Append(DocFormat._visMark(m.Vis)).Append(sig);
            int pad = w - sig.Length;
            if (pad < 0) { pad = 0; }
            sb.Append("".PadRight(pad + 2));
            string sum = m.Summary();
            if (sum.Length > 0) { sb.Append(DocFormat._clip(sum, 60)).Append("  "); }
            if (m.File == head.File) { sb.Append(":").Append(m.Line.ToString()); }
            else { sb.Append(DocFormat.Loc(m)); }
            sb.Append("\n");
            i = i + 1;
        }
        return sb.ToString();
    }

    // 多个候选：每个一行。
    public static string Candidates(DocItem[] items) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < items.Length) {
            sb.Append(items[i].Kind).Append(" ").Append(items[i].Id).Append("    ").Append(DocFormat.Loc(items[i])).Append("\n");
            i = i + 1;
        }
        return sb.ToString();
    }

    // 搜索结果：每条一行 `Id  摘要  位置`。
    public static string SearchResults(DocItem[] items) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < items.Length) {
            DocItem it = items[i];
            sb.Append(it.Id);
            string sum = it.Summary();
            if (sum.Length > 0) { sb.Append("  ").Append(DocFormat._clip(sum, 60)); }
            sb.Append("  ").Append(DocFormat.Loc(it)).Append("\n");
            i = i + 1;
        }
        return sb.ToString();
    }

    // 机器可读：条目数组（字段名与 DocItem 一致，另加 summary）。
    public static string Json(DocItem[] items) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[");
        int i = 0;
        while (i < items.Length) {
            DocItem it = items[i];
            if (i > 0) { sb.Append(","); }
            sb.Append("\n  {");
            DocFormat._jf(sb, "id", it.Id, true);
            DocFormat._jf(sb, "kind", it.Kind, false);
            DocFormat._jf(sb, "name", it.Name, false);
            DocFormat._jf(sb, "parent", it.Parent, false);
            DocFormat._jf(sb, "pkg", it.Pkg, false);
            DocFormat._jf(sb, "sig", it.Sig, false);
            DocFormat._jf(sb, "vis", it.Vis, false);
            DocFormat._jf(sb, "loc", DocFormat.Loc(it), false);
            DocFormat._jf(sb, "summary", it.Summary(), false);
            DocFormat._jf(sb, "doc", it.Doc, false);
            sb.Append("}");
            i = i + 1;
        }
        if (items.Length > 0) { sb.Append("\n"); }
        sb.Append("]\n");
        return sb.ToString();
    }

    public static string Loc(DocItem it) { return it.File + ":" + it.Line.ToString(); }

    // 轮廓里的签名去掉访问修饰符（可见性已经用一个字符标出）。
    private static string _shortSig(DocItem m) {
        string s = m.Sig;
        if (s.StartsWith("public "))    { return s.Substring(7); }
        if (s.StartsWith("private "))   { return s.Substring(8); }
        if (s.StartsWith("protected ")) { return s.Substring(10); }
        if (s.StartsWith("internal "))  { return s.Substring(9); }
        return s;
    }

    private static string _visMark(string vis) {
        if (vis == "public")    { return "+"; }
        if (vis == "protected") { return "#"; }
        if (vis == "internal")  { return "~"; }
        return "-";
    }

    private static string _clip(string s, int max) {
        if (s.Length <= max) { return s; }
        return s.Substring(0, max - 1) + "…";
    }

    private static void _jf(StringBuilder sb, string key, string val, bool first) {
        if (!first) { sb.Append(", "); }
        sb.Append("\"").Append(key).Append("\": \"").Append(DocFormat._esc(val)).Append("\"");
    }

    private static string _esc(string s) {
        return s.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n").Replace("\t", "\\t").Replace("\r", "\\r");
    }
}
