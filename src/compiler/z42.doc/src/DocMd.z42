// mdbook 渲染器：把一个包的语法级索引渲染成 `reference/stdlib/<pkg>.md` 的 markdown。
// 只读语法级索引 + DocParser，不碰语义级 `.zdoc`；跨页锚点（Doc ID slug）与嵌套类型展开归迁移期。
// 页面结构见 docs/reference/src/stdlib/（参考页骨架：概述 / 约定 / 逐项条目）。
namespace Z42.Doc;

using Std.Text;

public static class DocMd {
    // 源码链接基址（如 "https://github.com/z42-lang/z42/blob/main"，取自 book.toml 的
    // git-repository-url 口径）。空 → 位置行是纯 `file:line` 文本；非空 → 渲染成链接，
    // 显示文本仍是 file:line（可 grep），目标 <base>/<file>#L<line>。由 xtask doc gen 设置。
    public static string SourceBase = "";

    // 一包一页。pkgPath 相对索引根（如 "src/libraries/z42.random"），写进页首注释与包路径行。
    // pkgName 是分发单元名（"z42.random"）；命名空间 Id 从 `//!` 条目或顶层成员的 Parent 取。
    public static string PackagePage(string pkgName, string pkgPath, DocIndex ix) {
        StringBuilder sb = new StringBuilder();
        DocItem ns = DocMd._namespaceItem(ix);
        DocComment nd = (ns != null) ? DocParser.Parse(ns.Doc) : new DocComment();
        string nsId = (ns != null) ? ns.Id : DocMd._inferNamespace(ix);

        sb.Append("<!-- 由 z42 doc 生成，勿手改。源：").Append(pkgPath).Append("/ -->\n\n");
        sb.Append("# ").Append(pkgName);
        if (nd.Summary.Length > 0) { sb.Append(" —— ").Append(nd.Summary); }
        sb.Append("\n\n");
        sb.Append("> 包路径 `").Append(pkgPath).Append("/`；命名空间 `").Append(nsId).Append("`\n");
        if (nd.Body.Length > 0) { sb.Append("\n").Append(nd.Body).Append("\n"); }
        DocMd._warnings(sb, nd);
        sb.Append("\n");

        DocItem[] tops = ix.Members(nsId);
        int i = 0;
        while (i < tops.Length) {
            if (tops[i].IsType() && tops[i].Vis == "public") { DocMd._type(sb, ix, tops[i], "## "); }
            i = i + 1;
        }
        return sb.ToString();
    }

    // 顶层 public 类型：`split = "type"` 的候选（未分组；分组见 TopLevelTypeGroups）。
    public static DocItem[] TopLevelTypes(DocIndex ix, string nsId) {
        DocItem[] all = ix.Members(nsId);
        DocItem[] acc = new DocItem[all.Length];
        int n = 0;
        int i = 0;
        while (i < all.Length) {
            if (all[i].IsType() && all[i].Vis == "public") { acc[n] = all[i]; n = n + 1; }
            i = i + 1;
        }
        DocItem[] r = new DocItem[n];
        Array.Copy(acc, r, n);
        return r;
    }

    // 顶层 public 类型按名字分组（`split = "type"` 一个名字一页）：
    // 同 Id 的多次声明（partial 跨文件）并为一个代表——成员本就按 Id 聚合，代表优先取写了 `///` 的
    // （通常是主声明，签名也带基类列表）；同名不同 Id（泛型委托各元数、`MulticastException` /
    // `<TResult>`）逐个收进同组，合并渲染。页名 `<短名>.<Type>.md` 依赖同包各命名空间无同名类型。
    public static TypeGroup[] TopLevelTypeGroups(DocIndex ix, string nsId) {
        DocItem[] tops = DocMd.TopLevelTypes(ix, nsId);
        TypeGroup[] groups = new TypeGroup[tops.Length];
        int n = 0;
        int i = 0;
        while (i < tops.Length) {
            DocItem t = tops[i];
            int g = -1;
            int j = 0;
            while (j < n) { if (groups[j].Name == t.Name) { g = j; break; } j = j + 1; }
            if (g < 0) { groups[n] = new TypeGroup(t); n = n + 1; }
            else if (groups[g].Decls[0].Id == t.Id) {
                if (groups[g].Decls[0].Doc.Length == 0 && t.Doc.Length > 0) { groups[g].Decls[0] = t; }
            } else { groups[g].Add(t); }
            i = i + 1;
        }
        TypeGroup[] r = new TypeGroup[n];
        Array.Copy(groups, r, n);
        return r;
    }

    // 一个同名组一页（`split = "type"`）：标题 `<pkg>.<Type>` 只写一次。单声明直接渲染；
    // 多声明每个一个 `##` 节，节题带泛型参数（`Action<T1,T2>`）以示区分。
    public static string TypePage(string pkgName, string pkgPath, string nsId, TypeGroup g, DocIndex ix) {
        StringBuilder sb = new StringBuilder();
        sb.Append("<!-- 由 z42 doc 生成，勿手改。源：").Append(pkgPath).Append("/ -->\n\n");
        sb.Append("# ").Append(pkgName).Append(".").Append(g.Name).Append("\n\n");
        sb.Append("> 包路径 `").Append(pkgPath).Append("/`；命名空间 `").Append(nsId).Append("`\n\n");
        int i = 0;
        while (i < g.Decls.Length) {
            if (g.Decls.Length > 1) { sb.Append("## ").Append(DocMd._declName(g.Decls[i])).Append("\n\n"); }
            DocMd._loc(sb, g.Decls[i]);
            DocMd._typeDoc(sb, g.Decls[i]);
            DocMd._typeBody(sb, ix, g.Decls[i]);
            i = i + 1;
        }
        return sb.ToString();
    }

    // 命名空间 Id：`//!` 条目优先，否则从顶层成员 Parent 反推。给 type-split 的调用方（xtask）用。
    public static string NamespaceId(DocIndex ix) {
        DocItem ns = DocMd._namespaceItem(ix);
        return (ns != null) ? ns.Id : DocMd._inferNamespace(ix);
    }

    // 包内全部命名空间 Id（去重，按出现顺序）。多命名空间的包（如 z42.core）按它逐命名空间拆类型。
    // 只取命名空间条目与类型的 Parent——成员的 Parent 是类型名（如 Std.Math），不是命名空间。
    public static string[] Namespaces(DocIndex ix) {
        string[] acc = new string[8];
        int n = 0;
        int i = 0;
        while (i < ix.Count()) {
            DocItem it = ix.At(i);
            string ns = "";
            if (it.Kind == DocKind.Namespace) { ns = it.Id; }
            else if (it.IsType()) { ns = it.Parent; }
            if (ns.Length > 0 && !DocMd._contains(acc, n, ns)) {
                if (n == acc.Length) { string[] g = new string[n * 2]; Array.Copy(acc, g, n); acc = g; }
                acc[n] = ns; n = n + 1;
            }
            i = i + 1;
        }
        if (n == 0) {
            string inferred = DocMd._inferNamespace(ix);
            if (inferred.Length > 0) { acc[0] = inferred; n = 1; }
        }
        string[] r = new string[n];
        Array.Copy(acc, r, n);
        return r;
    }

    private static bool _contains(string[] a, int n, string v) {
        int i = 0;
        while (i < n) { if (a[i] == v) { return true; } i = i + 1; }
        return false;
    }

    // `split = "type"` 的索引页：命名空间概述（//!）+ 每个类型的链接清单。
    public static string TypeIndex(string pkgName, string pkgPath, DocIndex ix) {
        StringBuilder sb = new StringBuilder();
        DocItem ns = DocMd._namespaceItem(ix);
        DocComment nd = (ns != null) ? DocParser.Parse(ns.Doc) : new DocComment();
        string nsId = DocMd.NamespaceId(ix);

        sb.Append("<!-- 由 z42 doc 生成，勿手改。源：").Append(pkgPath).Append("/ -->\n\n");
        sb.Append("# ").Append(pkgName);
        if (nd.Summary.Length > 0) { sb.Append(" —— ").Append(nd.Summary); }
        sb.Append("\n\n");
        sb.Append("> 包路径 `").Append(pkgPath).Append("/`；命名空间 `").Append(nsId).Append("`\n");
        if (nd.Body.Length > 0) { sb.Append("\n").Append(nd.Body).Append("\n"); }
        DocMd._warnings(sb, nd);
        sb.Append("\n");

        string shortName = (pkgName.StartsWith("z42.")) ? pkgName.Substring(4) : pkgName;
        string[] nss = DocMd.Namespaces(ix);
        int i = 0;
        while (i < nss.Length) {
            TypeGroup[] groups = DocMd.TopLevelTypeGroups(ix, nss[i]);
            int j = 0;
            while (j < groups.Length) {
                sb.Append("- [").Append(groups[j].Name).Append("](").Append(shortName).Append(".").Append(groups[j].Name).Append(".md)\n");
                j = j + 1;
            }
            i = i + 1;
        }
        sb.Append("\n");
        return sb.ToString();
    }

    private static DocItem _namespaceItem(DocIndex ix) {
        int i = 0;
        while (i < ix.Count()) {
            if (ix.At(i).Kind == DocKind.Namespace) { return ix.At(i); }
            i = i + 1;
        }
        return null;
    }

    // 从条目反推包根目录（相对索引根）：取第一个有 File 的条目，去掉末尾的 /src 或 /tests。
    // 只用于页首「源：<目录>/」注释，不求精确。
    public static string PkgDir(DocIndex ix) {
        int i = 0;
        while (i < ix.Count()) {
            string f = ix.At(i).File;
            if (f.Length > 0) {
                int slash = f.LastIndexOf('/');
                string dir = (slash >= 0) ? f.Substring(0, slash) : "";
                if (dir.EndsWith("/src") || dir.EndsWith("/tests")) { dir = dir.Substring(0, dir.Length - 4); }
                return dir;
            }
            i = i + 1;
        }
        return "";
    }

    // 包是否写了 `//!`（命名空间概述）：`xtask doc gen` 只为写了的包生成页。
    public static bool HasNamespaceDoc(DocIndex ix) {
        int i = 0;
        while (i < ix.Count()) {
            if (ix.At(i).Kind == DocKind.Namespace && ix.At(i).Doc.Length > 0) { return true; }
            i = i + 1;
        }
        return false;
    }

    // 没有 `//!` 时，从第一个顶层成员的 Parent 反推命名空间 Id。
    private static string _inferNamespace(DocIndex ix) {
        int i = 0;
        while (i < ix.Count()) {
            DocItem it = ix.At(i);
            if (it.Parent.Length > 0 && (it.IsType() || it.Kind == DocKind.Func)) { return it.Parent; }
            i = i + 1;
        }
        return "";
    }

    // 一个类型一节：heading（`## `）+ 源码位置 + 类型文档 + 签名总览块 + 每个成员 `###`。
    private static void _type(StringBuilder sb, DocIndex ix, DocItem t, string heading) {
        sb.Append(heading).Append(t.Name).Append("\n\n");
        DocMd._loc(sb, t);
        DocMd._typeDoc(sb, t);
        DocMd._typeBody(sb, ix, t);
    }

    // 源码位置行：`file:line`（相对仓库根，与 `z42 doc` 输出的 `@` 行同一来源）。
    // 只在生成页里出现——每次 `xtask doc gen` 重写，行号不会过期；手写书页仍禁行号（doc-system）。
    // SourceBase 非空时是链接（网页点击直达源码行），显示文本不变。
    private static void _loc(StringBuilder sb, DocItem it) {
        if (it.File.Length == 0) { return; }
        if (DocMd.SourceBase.Length > 0) {
            sb.Append("[`").Append(it.File).Append(":").Append(it.Line.ToString()).Append("`](")
              .Append(DocMd.SourceBase).Append("/").Append(it.File).Append("#L").Append(it.Line.ToString()).Append(")\n\n");
        } else {
            sb.Append("`").Append(it.File).Append(":").Append(it.Line.ToString()).Append("`\n\n");
        }
    }

    // 类型文档（摘要 / 正文 / warning），不含标题；包页与 split=type 页共用。
    private static void _typeDoc(StringBuilder sb, DocItem t) {
        DocComment d = DocParser.Parse(t.Doc);
        if (d.Summary.Length > 0) { sb.Append(d.Summary).Append("\n"); }
        if (d.Body.Length > 0) { sb.Append("\n").Append(d.Body).Append("\n"); }
        DocMd._warnings(sb, d);
        sb.Append("\n");
    }

    // 声明名（带泛型参数）：从签名截取 `Name<...>`，到首个 `(` / `:` / `{` / 空格为止，
    // 如 `Action<T1,T2>`、`MulticastException<TResult>`。合并页的节题用它区分同名声明。
    private static string _declName(DocItem t) {
        string sig = t.Sig;
        int at = sig.IndexOf(t.Name);
        if (at < 0) { return t.Name; }
        int end = at + t.Name.Length;
        while (end < sig.Length) {
            char c = sig[end];
            if (c == '(' || c == ':' || c == '{' || c == ' ') { break; }
            end = end + 1;
        }
        return sig.Substring(at, end - at);
    }

    // 类型主体：签名总览块 + 成员索引行 + 每个成员 `###`（不含标题与类型文档）。
    // 重载委托/partial 类的合并页复用。
    private static void _typeBody(StringBuilder sb, DocIndex ix, DocItem t) {
        DocItem[] ms = ix.Members(t.Id);
        // 签名总览块：类型签名 + 每成员一行（只列 public；委托没有体，只写签名）。
        if (t.Kind == DocKind.Delegate) {
            sb.Append("```z42\n").Append(t.Sig).Append("\n```\n\n");
        } else {
            sb.Append("```z42\n").Append(t.Sig).Append(" {\n");
            int i = 0;
            while (i < ms.Length) {
                if (ms[i].Vis == "public") { sb.Append("    ").Append(DocMd._memberSig(ms[i])).Append("\n"); }
                i = i + 1;
            }
            sb.Append("}\n```\n\n");
            DocMd._memberIndex(sb, ms);
        }

        // 每个 public 成员一节；枚举成员只进总览块，嵌套类型归迁移期展开。
        int j = 0;
        while (j < ms.Length) {
            if (ms[j].Vis == "public" && !ms[j].IsType() && ms[j].Kind != DocKind.EnumMember) { DocMd._member(sb, ms[j]); }
            j = j + 1;
        }
    }

    // 成员索引行：一串锚点链接（`[Length](#DocId) · …`），页内点击直达成员小节。
    // mdBook 的 SUMMARY 不支持锚点条目，侧边栏到类型为止；成员级导航由这里补。
    private static void _memberIndex(StringBuilder sb, DocItem[] ms) {
        string s = "";
        int i = 0;
        while (i < ms.Length) {
            DocItem m = ms[i];
            if (m.Vis == "public" && !m.IsType() && m.Kind != DocKind.EnumMember) {
                if (s.Length > 0) { s = s + " · "; }
                s = s + "[`" + m.Name + "`](#" + DocMd._anchorHref(m) + ")";
            }
            i = i + 1;
        }
        if (s.Length > 0) { sb.Append("成员：").Append(s).Append("\n\n"); }
    }

    // 锚点 href：Doc ID 里的 `<` `>` 空格百分号编码（浏览器解码后与 <a id> 的原文匹配）。
    // Doc ID 按构造不含其他需编码字符：`+` `.` `,` `()` `[]` 在 fragment 里按字面匹配。
    private static string _anchorHref(DocItem m) {
        string id = m.Id;
        string r = "";
        int i = 0;
        while (i < id.Length) {
            char c = id.CharAt(i);
            if (c == '<')       { r = r + "%3C"; }
            else if (c == '>')  { r = r + "%3E"; }
            else if (c == ' ')  { r = r + "%20"; }
            else                { r = r + c.ToString(); }
            i = i + 1;
        }
        return r;
    }

    // 一个成员一节：`<a id>` 锚点（Doc ID，跨页符号链接将来也指向它）+ `###` + 源码位置 +
    // 签名 + 正文 + @param 表 + @throws + @example。
    private static void _member(StringBuilder sb, DocItem m) {
        DocComment d = DocParser.Parse(m.Doc);
        sb.Append("<a id=\"").Append(m.Id).Append("\"></a>\n");
        sb.Append("### ").Append(DocMd._memberSig(m)).Append("\n\n");
        DocMd._loc(sb, m);
        if (d.Summary.Length > 0) { sb.Append(d.Summary).Append("\n"); }
        if (d.Body.Length > 0) { sb.Append("\n").Append(d.Body).Append("\n"); }
        DocMd._warnings(sb, d);
        DocTag[] ps = DocMd._tags(d, "param");
        if (ps.Length > 0) {
            sb.Append("\n| 参数 | 说明 |\n|---|---|\n");
            int i = 0;
            while (i < ps.Length) { sb.Append("| `").Append(ps[i].Name).Append("` | ").Append(ps[i].Text).Append(" |\n"); i = i + 1; }
        }
        DocTag[] th = DocMd._tags(d, "throws");
        int j = 0;
        while (j < th.Length) {
            sb.Append("\n抛 `").Append(th[j].Name).Append("`：").Append(th[j].Text).Append("\n");
            j = j + 1;
        }
        int k = 0;
        while (k < d.Examples.Length) {
            sb.Append("\n```z42\n").Append(d.Examples[k].Code).Append("\n```\n");
            k = k + 1;
        }
        sb.Append("\n");
    }

    // 去掉访问修饰符（可见性在参考页里由上下文自明）。
    private static string _memberSig(DocItem m) {
        string s = m.Sig;
        if (s.StartsWith("public "))    { return s.Substring(7); }
        if (s.StartsWith("private "))   { return s.Substring(8); }
        if (s.StartsWith("protected ")) { return s.Substring(10); }
        if (s.StartsWith("internal "))  { return s.Substring(9); }
        return s;
    }

    private static void _warnings(StringBuilder sb, DocComment d) {
        int i = 0;
        while (i < d.Tags.Length) {
            if (d.Tags[i].Tag == "warning") { sb.Append("\n> ⚠️ ").Append(d.Tags[i].Text).Append("\n"); }
            i = i + 1;
        }
    }

    private static DocTag[] _tags(DocComment d, string tag) {
        DocTag[] acc = new DocTag[4];
        int n = 0;
        int i = 0;
        while (i < d.Tags.Length) {
            if (d.Tags[i].Tag == tag) { acc = DocMd._pushTag(acc, n, d.Tags[i]); n = n + 1; }
            i = i + 1;
        }
        DocTag[] r = new DocTag[n];
        Array.Copy(acc, r, n);
        return r;
    }

    private static DocTag[] _pushTag(DocTag[] a, int n, DocTag v) {
        DocTag[] b = a;
        if (n == a.Length) { b = new DocTag[a.Length * 2]; Array.Copy(a, b, n); }
        b[n] = v;
        return b;
    }
}

// 同名类型组：`split = "type"` 的拆分单位（一个名字一页）。z42 无交错数组，用包装类装一组声明。
// 组内要么是一个声明（常态），要么是同名不同 Id 的多个声明（泛型委托各元数等）；partial 的
// 多次声明在 TopLevelTypeGroups 里已并为一个代表，不会进同组。
public sealed class TypeGroup {
    public string Name;
    public DocItem[] Decls;

    public TypeGroup(DocItem first) {
        this.Name = first.Name;
        this.Decls = new DocItem[1];
        this.Decls[0] = first;
    }

    public void Add(DocItem t) {
        DocItem[] grown = new DocItem[this.Decls.Length + 1];
        Array.Copy(this.Decls, grown, this.Decls.Length);
        grown[this.Decls.Length] = t;
        this.Decls = grown;
    }
}
