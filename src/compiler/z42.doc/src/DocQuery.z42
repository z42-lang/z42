// `z42 doc` 的查询编排：建索引 → 解析名字 → 选输出形态。纯函数式地返回输出文本与退出码，
// z42d 只负责解析命令行和打印，便于单测。
namespace Z42.Doc;

using Std.IO;
using Std.Text;

public sealed class DocQueryOptions {
    public string Query;     // 符号名（Doc ID、限定名后缀或短名）
    public string Search;    // 非空 = 按名字与摘要搜索
    public bool   Members;   // 类型 / 命名空间轮廓
    public bool   Json;
    public bool   Private;   // 轮廓与搜索里也列 private 成员（直接查名字时总是可见）
    public string Pkg;       // 非空 = 只看这个包
    public string Root;      // 索引根（绝对路径）
    public string CachePath; // "" = 不用缓存
    public string Page;      // 非空 = 书页路径：解析页里引用的符号，输出 `符号 → file:line`
    public string Docs;      // 非空 = 反查：哪些书页 / README 引用了这个符号
    public DocQueryOptions() {
        this.Query = ""; this.Search = ""; this.Members = false; this.Json = false; this.Private = false;
        this.Pkg = ""; this.Root = ""; this.CachePath = ""; this.Page = ""; this.Docs = "";
    }
}

public sealed class DocQueryResult {
    public string Out;
    public string Err;
    public int    Exit;   // 0 命中；1 没有匹配；2 用法错误
    public DocQueryResult(string o, string e, int exit) { this.Out = o; this.Err = e; this.Exit = exit; }
}

public static class DocQuery {
    public static DocQueryResult Run(DocQueryOptions o) {
        if (o.Query.Length == 0 && o.Search.Length == 0 && o.Page.Length == 0 && o.Docs.Length == 0) {
            return new DocQueryResult("", "z42 doc: give a symbol name, --search <text>, --page <md>, or --docs <sym>", 2);
        }
        DocIndex ix = DocQuery.BuildIndex(o.Root, o.Pkg, o.CachePath);
        // 外部索引（仓库里 Rust 运行时的条目）放在索引根的 artifacts/doc/ 下；过期提示随结果一起给出。
        string warn = ExternalIndex.LoadDir(o.Root, Path.Join(o.Root, "artifacts/doc"), o.Pkg, ix);
        DocQueryResult r = DocQuery._answer(o, ix);
        if (warn.Length > 0) { r.Err = (r.Err.Length > 0) ? warn + r.Err : warn.TrimEnd(); }
        return r;
    }

    // 一页书里的符号引用 → 当前位置。读页头声明的范围，解析每个反引号符号，逐行输出 `符号 → file:line`。
    private static DocQueryResult _page(DocQueryOptions o, DocIndex ix) {
        string path = o.Page;
        if (!Path.IsRooted(path)) { path = Path.Join(o.Root, path); }
        if (!File.Exists(path)) { return new DocQueryResult("", "z42 doc: --page not found: " + o.Page, 2); }
        DocPage page = DocRefs.Extract(File.ReadAllText(path));
        DocRefs.Resolve(page, ix);
        return DocQuery._ok(DocRefs.Report(page));
    }

    // 反查：扫 docs/**/*.md 与 src/**/README.md，列出引用给定符号的页与行。
    private static DocQueryResult _docs(DocQueryOptions o, DocIndex ix) {
        string[] pages = DocQuery.BookPages(o.Root);
        StringBuilder sb = new StringBuilder();
        int n = 0;
        int i = 0;
        while (i < pages.Length) {
            DocPage page = DocRefs.Extract(File.ReadAllText(pages[i]));
            DocRefs.Resolve(page, ix);
            int j = 0;
            while (j < page.Refs.Length) {
                DocRef r = page.Refs[j];
                if (r.Target != null && DocQuery._matches(r.Target, o.Docs)) {
                    sb.Append(DocQuery._rel(o.Root, pages[i])).Append(":").Append(r.Line.ToString()).Append("  ").Append(r.Text).Append("\n");
                    n = n + 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        if (n == 0) { return DocQuery._none(o.Docs); }
        return DocQuery._ok(sb.ToString());
    }

    // 反查的命中判定：Id 或限定名等于查询，或以 `.查询` / `::查询` 结尾。
    private static bool _matches(DocItem it, string q) {
        if (it.Id == q || it.QualifiedName() == q) { return true; }
        return it.Id.EndsWith("." + q) || it.Id.EndsWith("::" + q) || it.Id.EndsWith("+" + q);
    }

    // 仓库相对路径（`/` 分隔）。
    private static string _rel(string root, string abs) {
        if (abs.StartsWith(root + "/")) { return abs.Substring(root.Length + 1); }
        return abs;
    }

    // 书页清单（docs/**/*.md + src/**/README.md）。`check doc-refs` 门禁复用同一份口径。
    public static string[] BookPages(string root) {
        DocQuery._StrAcc acc = new DocQuery._StrAcc();
        string docs = Path.Join(root, "docs");
        if (Directory.Exists(docs)) { DocQuery._mdWalk(docs, acc); }
        string src = Path.Join(root, "src");
        if (Directory.Exists(src)) { DocQuery._readmeWalk(src, acc); }
        string[] r = new string[acc.N];
        Array.Copy(acc.Items, r, acc.N);
        return r;
    }

    private static void _mdWalk(string dir, DocQuery._StrAcc acc) {
        string[] names = Directory.Enumerate(dir);
        int i = 0;
        while (i < names.Length) {
            string abs = Path.Join(dir, names[i]);
            if (Directory.Exists(abs)) { if (!names[i].StartsWith(".")) { DocQuery._mdWalk(abs, acc); } }
            else if (names[i].EndsWith(".md")) { acc.Add(abs); }
            i = i + 1;
        }
    }

    private static void _readmeWalk(string dir, DocQuery._StrAcc acc) {
        string[] names = Directory.Enumerate(dir);
        int i = 0;
        while (i < names.Length) {
            string abs = Path.Join(dir, names[i]);
            if (Directory.Exists(abs)) { if (!names[i].StartsWith(".")) { DocQuery._readmeWalk(abs, acc); } }
            else if (names[i] == "README.md") { acc.Add(abs); }
            i = i + 1;
        }
    }

    private sealed class _StrAcc {
        public string[] Items;
        public int N;
        public _StrAcc() { this.Items = new string[64]; this.N = 0; }
        public void Add(string s) {
            if (this.N == this.Items.Length) { string[] g = new string[this.Items.Length * 2]; Array.Copy(this.Items, g, this.N); this.Items = g; }
            this.Items[this.N] = s; this.N = this.N + 1;
        }
    }

    private static DocQueryResult _answer(DocQueryOptions o, DocIndex ix) {
        if (o.Page.Length > 0) { return DocQuery._page(o, ix); }
        if (o.Docs.Length > 0) { return DocQuery._docs(o, ix); }
        if (o.Search.Length > 0) {
            DocItem[] hits = DocQuery._visible(ix.Search(o.Search), o.Private);
            if (hits.Length == 0) { return DocQuery._none(o.Search); }
            return DocQuery._ok(o.Json ? DocFormat.Json(hits) : DocFormat.SearchResults(hits));
        }
        // 命名空间：没写 `//!` 时没有命名空间条目，按「有顶层成员挂在它下面」认。
        DocItem nsHead = DocQuery._namespaceHead(ix, o.Query);
        if (nsHead != null) {
            DocItem[] tops = DocQuery._visible(ix.Members(nsHead.Id), o.Private);
            if (o.Json) { return DocQuery._ok(DocFormat.Json(tops)); }
            return DocQuery._ok(DocFormat.Outline(nsHead, tops));
        }
        DocItem[] m = ix.Find(o.Query);
        if (m.Length == 0) { return DocQuery._none(o.Query); }
        if (o.Members) {
            DocItem head = DocQuery._singleContainer(m);
            if (head == null) { return DocQuery._ok(DocFormat.Candidates(m)); }
            DocItem[] mem = DocQuery._visible(ix.Members(head.Id), o.Private);
            if (o.Json) { return DocQuery._ok(DocFormat.Json(mem)); }
            return DocQuery._ok(DocFormat.Outline(head, mem));
        }
        if (o.Json) { return DocQuery._ok(DocFormat.Json(m)); }
        // 一个命中，或全是同一个名字的重载 → 逐个展开；否则列候选。
        if (m.Length == 1 || DocQuery._sameName(m)) {
            string s = "";
            int i = 0;
            while (i < m.Length) { if (i > 0) { s = s + "\n"; } s = s + DocFormat.Show(m[i]); i = i + 1; }
            return DocQuery._ok(s);
        }
        return DocQuery._ok(DocFormat.Candidates(m));
    }

    // 索引根下（可按包过滤）全部源文件的语法级索引。
    public static DocIndex BuildIndex(string root, string pkg, string cachePath) {
        SourceFile[] all = SourceTree.Collect(root);
        if (pkg.Length == 0) { return IndexCache.Build(root, all, cachePath); }
        SourceFile[] keep = new SourceFile[all.Length];
        int n = 0;
        int i = 0;
        while (i < all.Length) { if (all[i].Pkg == pkg) { keep[n] = all[i]; n = n + 1; } i = i + 1; }
        SourceFile[] r = new SourceFile[n];
        Array.Copy(keep, r, n);
        return IndexCache.Build(root, r, "");   // 子集不写共享缓存，免得把整份缓存冲掉
    }

    private static DocItem _namespaceHead(DocIndex ix, string q) {
        DocItem first = null;
        int i = 0;
        while (i < ix.Count()) {
            DocItem it = ix.At(i);
            if ((it.Kind == DocKind.Namespace || it.Kind == DocKind.Module) && it.Id == q) { return it; }
            if (first == null && it.Parent == q && (it.IsType() || it.Kind == DocKind.Func)) { first = it; }
            i = i + 1;
        }
        if (first == null) { return null; }
        // 合成的表头没有源码位置（File 为空）：轮廓里每个成员都写完整路径。
        DocItem h = new DocItem(q, DocKind.Namespace, q, "", "namespace " + q, 0, "public", "");
        h.Pkg = first.Pkg;
        return h;
    }

    // --members 的对象：命中里唯一的容器（类型 / 命名空间 / Rust 模块；同名的容器与成员并存时取容器）。
    private static DocItem _singleContainer(DocItem[] m) {
        DocItem found = null;
        int i = 0;
        while (i < m.Length) {
            if (m[i].IsContainer()) {
                if (found != null && found.Id != m[i].Id) { return null; }
                found = m[i];
            }
            i = i + 1;
        }
        return found;
    }

    private static bool _sameName(DocItem[] m) {
        int i = 1;
        while (i < m.Length) { if (m[i].QualifiedName() != m[0].QualifiedName()) { return false; } i = i + 1; }
        return true;
    }

    private static DocItem[] _visible(DocItem[] items, bool includePrivate) {
        if (includePrivate) { return items; }
        DocItem[] acc = new DocItem[items.Length];
        int n = 0;
        int i = 0;
        while (i < items.Length) { if (items[i].Vis != "private") { acc[n] = items[i]; n = n + 1; } i = i + 1; }
        DocItem[] r = new DocItem[n];
        Array.Copy(acc, r, n);
        return r;
    }

    private static DocQueryResult _ok(string s) { return new DocQueryResult(s, "", 0); }

    private static DocQueryResult _none(string q) {
        return new DocQueryResult("", "z42 doc: no symbol matches `" + q + "`", 1);
    }
}
