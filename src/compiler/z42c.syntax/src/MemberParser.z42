// 成员子解析器（compiler-review P1-2 收官：DeclParser 拆 <500）。类成员 + 参数/方法尾。
// 持 _p：游标原语 + _p._typeP/_exprP/_stmtP + _p._declP（修饰符/属性）。
namespace Z42.Syntax;

using Z42.Core;

public sealed class MemberParser {
    private Parser _p;
    public MemberParser(Parser p) { this._p = p; }

    internal Decl _parseMember(string className, bool isClass) {
        int docTok = this._p._mark();
        AttrList attrs = this._p._declP._parseAttributes();
        int docAfterAttrs = this._p._mark();
        string mods = this._p._declP._parseModifiers();
        Decl d = this._parseMemberBody(mods, className, attrs, isClass);   // add-record-attribute：attrs 供嵌套类型位置参数判 [Record]
        if (attrs.Count > 0) { d = new AttributedDecl(attrs.Items, attrs.Count, d, d.Span); }
        this._p._attachDoc(d, docTok, docAfterAttrs);
        return d;
    }

    [Suppress("style.fnLinesHard", "95 body lines；拆分见 code-organization.md")]
    private Decl _parseMemberBody(string mods, string className, AttrList attrs, bool isClass) {
        Span sp = this._p._peek().Span;
        // add-nested-types：嵌套类型声明（class/struct/interface/enum/record）作为成员 → 委托 DeclParser
        // 的类型声明解析（其成员体再递归 _parseMember，故深层嵌套天然支持）。NestedFlatten 稍后把它们
        // 提升为顶层 `Outer+Inner`。须在 `_parseType()` 之前拦截，否则 `class Inner` 被误解析为属性。
        int nk = this._p._peek().Kind;
        if (nk == TokenKind.Class || nk == TokenKind.Struct || nk == TokenKind.Interface) {
            string nkind = "class";
            if (nk == TokenKind.Struct) { nkind = "struct"; }
            else if (nk == TokenKind.Interface) { nkind = "interface"; }
            return this._p._declP._parseTypeDecl(mods, nkind, attrs);
        }
        if (nk == TokenKind.Enum)   { return this._p._declP._parseEnum(mods); }
        // fix-nested-delegate-decl（欠债表 bug B1）：嵌套 `delegate` 声明。此前这里无分支 ⇒
        // `delegate` 落到下方 `_parseType()` 被当成一个名叫 `delegate` 的类型 ⇒ 整条声明报废
        // （E0202 三连 + `undefined type: delegate`），该 delegate 类型**整体消失**。
        // 展平沿用 NestedFlatten（改名 `Outer+Inner`，与嵌套 class/enum 同机制），
        // 引用侧写 `Outer.Inner`（SymbolTable.ResolveTypeP 的 dots→`+` 兜底）。
        if (nk == TokenKind.Delegate) { return this._p._declP._parseDelegate(mods); }
        // add-associated-types PR-3：关联类型成员 `type Item;` / `type Item = int;`。
        // `type` **不是关键字**（全仓大量用它作普通标识符：变量名、参数名、属性名），加进 lexer 会
        // 一次性破坏所有那些源码。故与 class/enum/implicit 同款，在 `_parseType()` **之前**前瞻拦截；
        // 且要求三个 token 全中（`type` + 标识符 + `;`/`=`）。
        //
        // ⚠️ 这条前瞻**确实会**吃掉一种既有写法：类型名恰好叫 `type` 的字段声明
        // （`type x;` / `type x = ...;`）。已实测全仓 `src/` **零命中**，且没有任何
        // 名为 `type` 的 class/struct/interface/enum ⇒ 今天不存在这种声明。这是**刻意接受的**代价：
        // 换来 `type` 不进 lexer（进 lexer 会一次性废掉所有把 `type` 当变量/参数/属性名的源码，
        // 那才是真的破坏面）。方法与属性不受影响——`type Foo() {…}` / `type Foo { get; }` 的第三个
        // token 是 `(` / `{`，前瞻不命中。
        if (this._p._peek().Kind == TokenKind.Identifier && this._p._peek().Text == "type"
            && this._p._peekAt(1).Kind == TokenKind.Identifier
            && (this._p._peekAt(2).Kind == TokenKind.Semicolon || this._p._peekAt(2).Kind == TokenKind.Eq)) {
            this._p._advance();                          // 'type'
            string atName = this._p._peek().Text;
            this._p._advance();                          // 名
            bool atHasBound = false;
            TypeExpr atBound = this._p._typeP._emptyType();
            if (this._p._peek().Kind == TokenKind.Eq) {
                this._p._advance();                      // '='
                atBound = this._p._typeP._parseType();
                atHasBound = true;
            }
            this._p._expect(TokenKind.Semicolon, ";");
            return new AssocTypeDecl(mods, atName, atHasBound, atBound, sp);
        }
        // 构造器：标识符(==类名) 紧跟 '('
        if (this._p._peek().Kind == TokenKind.Identifier && this._p._peek().Text == className
            && this._p._peekAt(1).Kind == TokenKind.LParen) {
            string cname = this._p._peek().Text;
            this._p._advance();
            return this._parseMethodTail(mods, false, true, this._p._typeP._emptyType(), cname, this._p._typeP._emptyTypeParams(), sp);
        }
        // add-user-conversions：用户自定义转换 `public static implicit operator Target(Source s)` /
        // `explicit operator ...` → 方法名 op_Implicit / op_Explicit（镜像 C#）。须先于 _parseType 拦截，
        // 因 implicit/explicit 后接 `operator`+目标类型（=返回类型），不是普通成员类型。
        if (this._p._peek().Kind == TokenKind.Implicit || this._p._peek().Kind == TokenKind.Explicit) {
            bool isImplicit = this._p._peek().Kind == TokenKind.Implicit;
            this._p._advance();   // 'implicit' / 'explicit'
            this._p._expect(TokenKind.Operator, "operator");
            TypeExpr target = this._p._typeP._parseType();   // 转换目标 = 返回类型
            string convName = "op_Implicit";
            if (!isImplicit) { convName = "op_Explicit"; }
            return this._parseMethodTail(mods, false, false, target, convName, this._p._typeP._emptyTypeParams(), sp);
        }
        TypeExpr type = this._p._typeP._parseType();
        // GS5：索引器 `T this[params] { get {...} set {...} }`（`this` 是标识符不是关键字）
        if (this._p._peek().Kind == TokenKind.Identifier && this._p._peek().Text == "this"
            && this._p._peekAt(1).Kind == TokenKind.LBracket) {
            return this._parseIndexer(mods, type, sp);
        }
        if (this._p._peek().Kind == TokenKind.Operator) {
            return this._parseOperator(mods, type, sp, isClass);
        }
        string name = this._p._peek().Text;
        if (this._p._peek().Kind == TokenKind.Identifier) { this._p._advance(); }
        else if (this._isWordKeyword(this._p._peek().Kind)) {
            // 同参数名位置的关键字恢复（见 _parseParamList）：报准 + 消费防脱轨。
            this._p._diags.Error(DiagnosticCodes.ExpectedToken,
                "cannot use keyword '" + name + "' as a member name", this._p._peek().Span);
            this._p._advance();
        }
        else { this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected member name", this._p._peek().Span); }
        if (ProtocolNames.IsCompoundAssignName(name)) {
            this._p._diags.Error(DiagnosticCodes.OperatorNotOverloadable,
                "member name `" + name + "` is reserved for compound assignment operators", sp);
        }
        // 泛型方法 `T Make<T>(...)`：成员名后的 `<` 必为类型形参（字段不会有 `<`）。
        TypeParamList mTypeParams = this._p._typeP._parseTypeParams();
        if (this._p._peek().Kind == TokenKind.LParen) {
            return this._parseMethodTail(mods, false, false, type, name, mTypeParams, sp);
        }
        if (this._p._peek().Kind == TokenKind.LBrace) {
            return this._parseProperty(mods, type, name, sp);
        }
        if (this._p._peek().Kind == TokenKind.FatArrow) {
            // add-expression-bodied-members：`T P => e;` ≡ `T P { get { return e; } }`（只读计算属性）。
            // 此前落到下方字段分支 ⇒ `expected ';'` 连环 + `undefined type: =>`。
            PropertyDecl epd = new PropertyDecl(mods, type, name, true, "", false, "", false, new NullLitExpr(sp), sp);
            epd.HasGetBody = true; epd.GetBody = this._parseArrowBody(false);
            return epd;
        }
        bool hasInit = false;
        Expr init = new NullLitExpr(sp);
        if (this._p._peek().Kind == TokenKind.Eq) { this._p._advance(); init = this._p._exprP._parseExpr(0); hasInit = true; }
        this._p._expectSemi();
        return new FieldDecl(mods, type, name, hasInit, init, sp);
    }

    private Decl _parseOperator(string mods, TypeExpr type, Span sp, bool isClass) {
        this._p._advance();   // 'operator'
        string opSym = this._p._peek().Text;
        Span   opSp  = this._p._peek().Span;
        this._p._advance();   // 运算符符号 token（+ - * / %）
        string compoundName = ProtocolNames.CompoundAssign(opSym);
        if (compoundName != "") {
            MethodDecl md = this._parseMethodTail(mods, false, false, type, compoundName,
                this._p._typeP._emptyTypeParams(), sp) as MethodDecl;
            if (!isClass || md.ModFlags != Mod.Public || !md.HasBody || md.ParamCount != 1
                || md.Params[0].IsRef || md.Params[0].IsParams || md.Params[0].Default != null) {
                this._p._diags.Error(DiagnosticCodes.OperatorNotOverloadable,
                    "operator `" + opSym + "` must be a public instance class member with a body and one required by-value parameter", opSp);
            }
            return md;
        }
        string opName   = MemberParser._operatorMethodName(opSym);   // 二元表（16 条）
        string unaryName = MemberParser._unaryOperatorMethodName(opSym);   // fix-unary-op-overload：一元表（4 条）
        bool opListed = opName != "" || unaryName != "";
        // 表外符号仍给个名字，只为让这条成员**继续解析完**（否则后面的 `(...)` / 方法体会
        // 级联出一串位置在别处的假错）。同一个类里两个不可重载的符号因此仍互不同名，不会
        // 再多冒一条假的「重复成员」。本轮必报错 ⇒ 这个名字到不了发射端。
        if (opName == "") { opName = unaryName != "" ? unaryName : "op_" + opSym; }
        Decl opDecl = this._parseMethodTail(mods, false, false, type, opName, this._p._typeP._emptyTypeParams(), sp);
        // fix-unary-op-overload：`-` / `+` 一元与二元同符号——名字算出的那一刻 arity 还
        // 不知道（既有 ⚠️ 不变），解析完按形参个数定形：一元形态改挂一元名。
        if (opDecl is MethodDecl) {
            MethodDecl md = opDecl as MethodDecl;
            if (md.ParamCount == 2 && MemberParser._operatorMethodName(opSym) != "") {
                // 二元形态照旧
            }
            else if (md.ParamCount == 1 && unaryName != "") {
                md.Name = unaryName;
            }
            else if (!opListed) {
                this._p._diags.Error(DiagnosticCodes.OperatorNotOverloadable,
                    "operator `" + opSym + "` cannot be overloaded — z42 overloads only the binary"
                    + " operators `+ - * / % == != < > <= >= & | ^ << >> >>>` and the unary"
                    + " operators `- + ! ~` and compound assignments `+= -=`", opSp);
            }
            else {
                this._p._diags.Error(DiagnosticCodes.OperatorNotOverloadable,
                    "operator `" + opSym + "` overload must take exactly "
                    + (unaryName != "" && MemberParser._operatorMethodName(opSym) == "" ? "one parameter" : "two parameters")
                    + " — z42 has no other arity for this operator", opSp);
            }
        }
        return opDecl;
    }

    private Decl _parseIndexer(string mods, TypeExpr retType, Span sp) {
        this._p._advance();   // consume 'this'
        this._p._expect(TokenKind.LBracket, "[");
        Param[] params_ = new Param[4];
        int pc = 0;
        while (this._p._peek().Kind != TokenKind.RBracket && this._p._peek().Kind != TokenKind.Eof) {
            if (pc > 0) { this._p._expect(TokenKind.Comma, ","); }
            TypeExpr pt = this._p._typeP._parseType();
            string pn = "";
            if (this._p._peek().Kind == TokenKind.Identifier) { pn = this._p._peek().Text; this._p._advance(); }
            if (pc == params_.Length) {   // fix-parser-fixed-arrays：此前定长 4，第 5 个索引器参数即编译器崩溃
                Param[] bigger = new Param[params_.Length * 2];
                Array.Copy(params_, bigger, pc);
                params_ = bigger;
            }
            params_[pc] = new Param(pt, pn, sp);
            pc = pc + 1;
        }
        this._p._expect(TokenKind.RBracket, "]");
        bool hasGet = false; Stmt getBody = new BlockStmt(new Stmt[0], 0, sp);
        bool hasSet = false; Stmt setBody = new BlockStmt(new Stmt[0], 0, sp);
        if (this._p._peek().Kind == TokenKind.FatArrow) {   // add-expression-bodied-members：只读索引器 `=> e;`
            getBody = this._parseArrowBody(false);
            return new IndexerDecl(mods, retType, params_, pc, true, getBody, false, setBody, sp);
        }
        this._p._expect(TokenKind.LBrace, "{");
        while (this._p._peek().Kind != TokenKind.RBrace && this._p._peek().Kind != TokenKind.Eof) {
            string acc = this._p._peek().Text;
            if (this._p._peek().Kind == TokenKind.Identifier && acc == "get") {
                this._p._advance();
                // fix-iface-self-completeness-gaps A3：区分有体 `get {…}`/`get => e`（类索引器）与无体 `get;`
                // （接口/抽象索引器，accessor-only）——镜像 `_parseProperty`。此前无条件走 `_parseAccessorBody`
                // ⇒ 接口 `get;` 的 `;` 被当块体解析、吞掉接口闭合 `}`，后续声明被错误嵌进接口。
                if (this._p._peek().Kind == TokenKind.LBrace || this._p._peek().Kind == TokenKind.FatArrow) {
                    getBody = this._parseAccessorBody(false); hasGet = true;
                } else {
                    this._p._expectSemi(); hasGet = true;
                }
            } else if (this._p._peek().Kind == TokenKind.Identifier && acc == "set") {
                this._p._advance();
                if (this._p._peek().Kind == TokenKind.LBrace || this._p._peek().Kind == TokenKind.FatArrow) {
                    setBody = this._parseAccessorBody(true); hasSet = true;
                } else {
                    this._p._expectSemi(); hasSet = true;
                }
            } else {
                this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected 'get' or 'set' in indexer", this._p._peek().Span);
                this._p._advance();
            }
        }
        this._p._expect(TokenKind.RBrace, "}");
        return new IndexerDecl(mods, retType, params_, pc, hasGet, getBody, hasSet, setBody, sp);
    }

    private Decl _parseProperty(string mods, TypeExpr type, string name, Span sp) {
        this._p._advance();   // {
        bool hasGet = false; string getMods = "";
        bool hasSet = false; string setMods = "";
        bool hasGetBody = false; Stmt getBody = null;   // add-property-getter：计算 getter 块体
        bool hasSetBody = false; Stmt setBody = null;   // add-property-custom-setter：自定义 setter 块体
        while (this._p._peek().Kind != TokenKind.RBrace && this._p._peek().Kind != TokenKind.Eof) {
            string accMods = "";
            while (this._p._declP._isVisibilityModifier(this._p._peek().Kind)) {
                if (accMods != "") { accMods = accMods + " "; }
                accMods = accMods + this._p._peek().Text;
                this._p._advance();
            }
            string acc = this._p._peek().Text;
            if (this._p._peek().Kind == TokenKind.Identifier && (acc == "get" || acc == "set")) {
                this._p._advance();
                if (this._p._peek().Kind == TokenKind.LBrace || this._p._peek().Kind == TokenKind.FatArrow) {
                    // add-property-getter / add-property-custom-setter：带体访问器（`get { ... }` / `set { ... }`）
                    // ——捕获块体，镜像 indexer get/set body。add-expression-bodied-members：`get => e;` / `set => e;`
                    // 同款脱糖（setter 体为 void）。混合 auto+带体在 MemberCollector 报 E0464。
                    if (acc == "get") { getBody = this._parseAccessorBody(false); hasGetBody = true; hasGet = true; getMods = accMods; }
                    else { setBody = this._parseAccessorBody(true); hasSetBody = true; hasSet = true; setMods = accMods; }
                } else {
                    this._p._expectSemi();   // auto property（`get;` / `set;`）
                    if (acc == "get") { hasGet = true; getMods = accMods; }
                    else { hasSet = true; setMods = accMods; }
                }
            } else {
                this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected 'get' or 'set' accessor", this._p._peek().Span);
                this._p._advance();
            }
        }
        this._p._expect(TokenKind.RBrace, "}");
        bool hasInit = false;
        Expr init = new NullLitExpr(sp);
        if (this._p._peek().Kind == TokenKind.Eq) {
            this._p._advance(); init = this._p._exprP._parseExpr(0); hasInit = true; this._p._expectSemi();
        }
        // add-property-custom-setter：两个访问器都在时，要么都 auto、要么都带体——z42 无 `field` 关键字，
        // auto 半边（合成读/写 __prop_X）与带体半边（自管存储）会读写错位（`get;` 读 __prop_X，`set { _x=value; }`
        // 写 _x）。混合 → E0474。
        if (hasGet && hasSet && (hasGetBody != hasSetBody)) {
            this._p._diags.Error(DiagnosticCodes.MixedPropertyAccessors,
                "property `" + name + "` cannot mix an auto accessor with a bodied accessor — make both auto (`{ get; set; }`) or both bodied (`{ get { ... } set { ... } }`)", sp);
        }
        PropertyDecl pd = new PropertyDecl(mods, type, name, hasGet, getMods, hasSet, setMods, hasInit, init, sp);
        if (hasGetBody) { pd.HasGetBody = true; pd.GetBody = getBody; }
        if (hasSetBody) { pd.HasSetBody = true; pd.SetBody = setBody; }
        return pd;
    }

    // 访问器体：块 `{ ... }` 或表达式体 `=> e;`（add-expression-bodied-members）。
    private Stmt _parseAccessorBody(bool isVoid) {
        if (this._p._peek().Kind == TokenKind.FatArrow) { return this._parseArrowBody(isVoid); }
        return this._p._stmtP._parseBlock();
    }

    // 表达式体 `=> expr;`（当前 token 是 `=>`）脱糖成单语句块：非 void → `{ return expr; }`，
    // void → `{ expr; }`。方法 / 属性 / 索引器共用 ⇒ 下游只见块体，零新 AST 节点。
    private Stmt _parseArrowBody(bool isVoid) {
        this._p._advance();   // =>
        Span esp = this._p._peek().Span;
        Expr ev = this._p._exprP._parseExpr(0);
        this._p._expectSemi();
        Stmt[] one = new Stmt[1];
        if (isVoid) { one[0] = new ExprStmt(ev, esp); }
        else { one[0] = new ReturnStmt(true, ev, esp); }
        return new BlockStmt(one, 1, esp);
    }

    // E0207 / E0208：params 形参的形状约束（数组、不与 ref/默认值同现）。
    private void _checkParamsShape(Param prm, TypeExpr pt, bool isRef, Span paramsTok) {
        if (!(pt is ArrayType)) { this._p._diags.Error(DiagnosticCodes.ParamsNotArray, "'params' parameter type must be an array 'T[]'", pt.Span); }
        if (isRef || prm.Default != null) { this._p._diags.Error(DiagnosticCodes.ParamsModifierConflict, "'params' cannot combine with 'ref'/'out' or a default value", paramsTok); }
    }

    [Suppress("style.fnLinesHard", "64 body lines；拆分见 code-organization.md")]
    public ParamList _parseParamList(bool allowDocs = false) {
        Span sp = this._p._peek().Span;
        this._p._expect(TokenKind.LParen, "(");
        Param[] ps = new Param[8];
        int pc = 0;
        if (this._p._peek().Kind != TokenKind.RParen) {
            while (true) {
                // param-docs：类型位置参数允许前置 `///`（挂到 Param.Doc，record 展开的字段由此带文档）。
                DocBlock pdoc = allowDocs ? this._p._claimDocHere() : null;
                // add-parameter-attribute-reflection：参数前置 `[Attr(...)]`（在 ref/type 之前）。
                AttrList pattrs = null;
                if (this._p._peek().Kind == TokenKind.LBracket) { pattrs = this._p._declP._parseAttributes(); }
                // add-params-varargs：`params` 修饰（在类型前）。末参约束（E0206）在循环外统一检查。
                bool isParams = false;
                Span paramsTok = this._p._peek().Span;
                if (this._p._peek().Kind == TokenKind.Params) { this._p._advance(); isParams = true; }
                // simplify-ref-parameters：三态收敛为单一 `ref`（传地址，零契约）。`out` / `in` 作
                // 形参修饰符改报 E0471 + 迁移提示。消费掉 token 保持解析同步（不消费会从这里脱轨：
                // 参数列表提前闭合、方法体被撕成垃圾成员——同下面 _isWordKeyword 那条的教训）。
                bool isRef = false;
                if (this._p._peek().Kind == TokenKind.Ref) { this._p._advance(); isRef = true; }
                else if (this._p._peek().Kind == TokenKind.Out) {
                    Span obs = this._p._peek().Span; this._p._advance();
                    this._p._diags.Error(DiagnosticCodes.ObsoleteParamModifier,
                        "`out` is no longer a parameter modifier — use `ref` (`out T x` -> `ref T x`; " +
                        "the slot is zero-initialised, so the caller need not assign before the call)", obs);
                    isRef = true;   // 按 ref 继续解析，避免级联错
                }
                else if (this._p._peek().Kind == TokenKind.In) {
                    Span obs = this._p._peek().Span; this._p._advance();
                    this._p._diags.Error(DiagnosticCodes.ObsoleteParamModifier,
                        "`in` is no longer a parameter modifier — use `T x` (by value; the compiler passes " +
                        "large value types by alias automatically when the callee never writes them), " +
                        "or `ref T x` if the callee must write back", obs);
                    isRef = false;  // 按按值继续解析
                }
                TypeExpr pt = this._p._typeP._parseType();
                string pn = this._p._peek().Text;
                if (this._p._peek().Kind == TokenKind.Identifier) { this._p._advance(); }
                else if (this._isWordKeyword(this._p._peek().Kind)) {
                    // fix-parse-diags-dropped：关键字占了参数名位置（如 `string module`——
                    // `module` 是保留关键字）→ 精准报错 + 消费该 token 保持解析同步。
                    // 不消费会从这里脱轨：参数列表提前闭合、方法体被撕成垃圾成员，
                    // 配合 parse 诊断丢失曾产出静默 miscompile（方法被无声吞掉）。
                    this._p._diags.Error(DiagnosticCodes.ExpectedToken,
                        "cannot use keyword '" + pn + "' as a parameter name", this._p._peek().Span);
                    this._p._advance();
                }
                else { this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected parameter name", this._p._peek().Span); }
                if (pc == ps.Length) {
                    Param[] b = new Param[ps.Length * 2];
                    Array.Copy(ps, b, pc);
                    ps = b;
                }
                Param prm = new Param(pt, pn, pt.Span);
                prm.IsRef = isRef;
                prm.IsParams = isParams;
                if (pattrs != null) { prm.Attrs = pattrs.Items; prm.AttrCount = pattrs.Count; }
                if (pdoc != null) { prm.Doc = pdoc; }
                if (this._p._peek().Kind == TokenKind.Eq) {   // GS1：默认参数值 `int x = expr`
                    this._p._advance();
                    prm.Default = this._p._exprP._parseExpr(0);
                }
                if (isParams) { this._checkParamsShape(prm, pt, isRef, paramsTok); }
                ps[pc] = prm; pc = pc + 1;
                if (this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); } else { break; }
            }
        }
        // params 必须是最后一个参数（E0206）：任何标记 IsParams 但不在末位的报错。
        int pk = 0;
        while (pk < pc - 1) {
            if (ps[pk].IsParams) { this._p._diags.Error(DiagnosticCodes.ParamsNotLast, "'params' must be the last parameter", ps[pk].Span); }
            pk = pk + 1;
        }
        this._p._expect(TokenKind.RParen, ")");
        return new ParamList(ps, pc, sp);
    }

    // 词形关键字判定（名字位置的诊断恢复用）：查词法器的关键字表（唯一真相）。此前写死 TokenKind
    // `9..93` 区间，漏掉后来追加在 149+ 的 partial/readonly/const/with/methodof ⇒ 参数名写成 `with`
    // 等词时恰好走进下面注释警告过的脱轨级联（fix-parser-silent-misparse）。
    // 标点/字面量/EOF 不在内——它们出现在名字位置时不消费（沿用原恢复策略）。
    bool _isWordKeyword(int k) {
        if (this._p._lx.IsKeywordKind(k)) { return true; }
        if (k == TokenKind.True || k == TokenKind.False || k == TokenKind.Params) { return true; }
        return false;
    }

    public static string _operatorMethodName(string op) {
        if (op == "+") { return "op_Add"; }
        if (op == "-") { return "op_Subtract"; }
        if (op == "*") { return "op_Multiply"; }
        if (op == "/") { return "op_Divide"; }
        if (op == "%") { return "op_Modulo"; }
        // add-comparison-operators：比较/相等/位运算符方法名（对齐 C#，与派发侧 TypeFactsTc._operatorMethodNameTc
        // 一致）。此前这些落到 `op_" + op` = 非法名 `op_==` 等，声明的运算符永远派发不到。
        if (op == "==") { return "op_Equality"; }
        if (op == "!=") { return "op_Inequality"; }
        if (op == "<")  { return "op_LessThan"; }
        if (op == ">")  { return "op_GreaterThan"; }
        if (op == "<=") { return "op_LessThanOrEqual"; }
        if (op == ">=") { return "op_GreaterThanOrEqual"; }
        if (op == "&")  { return "op_BitwiseAnd"; }
        if (op == "|")  { return "op_BitwiseOr"; }
        if (op == "^")  { return "op_ExclusiveOr"; }
        if (op == "<<") { return "op_LeftShift"; }
        if (op == ">>") { return "op_RightShift"; }
        if (op == ">>>") { return "op_UnsignedRightShift"; }   // fix-ushr（C# 11 对齐）
        // 表外符号 = **不可重载**，与派发侧 `TypeFactsTc._operatorMethodNameTc` 同一约定
        // （`TypeChecker.z42` 那句「`""` 表不可重载」记的就是它）。此前这里回落 `"op_" + op`
        // 替表外符号**造了个名字**，于是声明侧「有」而派发侧「无」——两侧对同一个问题给出相反
        // 答案，非法名 `op_!` 因此一路进到发码。唯一的判据放在这一份表里。
        return "";
    }

    // fix-unary-op-overload：一元可重载表（C# 镜像命名）。`-` / `+` 与二元同符号——
    // 按形参个数分流（一元形态在 _parseMethodTail 解析完后改名）。`++` / `--` 刻意不在
    // 表里（自增走数值域脱糖；z42 无 true/false operator）。
    public static string _unaryOperatorMethodName(string op) {
        if (op == "-") { return "op_UnaryNegation"; }
        if (op == "+") { return "op_UnaryPlus"; }
        if (op == "!") { return "op_LogicalNot"; }
        if (op == "~") { return "op_OnesComplement"; }
        return "";
    }

    public Decl _parseMethodTail(string mods, bool isFree, bool isCtor, TypeExpr retType, string name, TypeParamList typeParams, Span sp) {
        ParamList pl = this._parseParamList();
        WhereList wl = this._p._typeP._parseWhereClause();
        // ctor 构造器初始化 `: base(args)` / `: this(args)` — 解析并存储（isCtor；
        // 记录 base vs this：this 委托同类 ctor，base 调用基类 ctor）。
        Expr[] baseArgs = new Expr[0];
        int baseArgCount = 0;
        bool isThisInit = false;
        bool hasCtorInit = false;
        if (isCtor && this._p._peek().Kind == TokenKind.Colon) {
            this._p._advance();   // :
            if (this._p._peek().Kind == TokenKind.Identifier) {
                if (this._p._peek().Text == "this") { isThisInit = true; }
                this._p._advance();
            }  // base / this
            if (this._p._peek().Kind == TokenKind.LParen) {
                this._p._advance();   // (
                Expr[] ba = new Expr[4];
                int ban = 0;
                if (this._p._peek().Kind != TokenKind.RParen) {
                    while (true) {
                        if (ban == ba.Length) {
                            Expr[] bg = new Expr[ba.Length * 2];
                            Array.Copy(ba, bg, ban);
                            ba = bg;
                        }
                        ba[ban] = this._p._exprP._parseExpr(0); ban = ban + 1;
                        if (this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); }
                        else { break; }
                    }
                }
                this._p._expect(TokenKind.RParen, ")");
                baseArgs = ba; baseArgCount = ban;
                hasCtorInit = true;
            }
        }
        bool hasBody = false;
        Stmt body = new BlockStmt(new Stmt[0], 0, sp);
        if (this._p._peek().Kind == TokenKind.LBrace) { body = this._p._stmtP._parseBlock(); hasBody = true; }
        else if (this._p._peek().Kind == TokenKind.FatArrow) {
            // 表达式体 `=> expr;`（此前未处理 → hasBody=false → 函数被丢弃）。
            bool isVoid = !isCtor && retType is NamedType && (retType as NamedType).Name == "void";
            body = this._parseArrowBody(isVoid);
            hasBody = true;
        }
        else { this._p._expectSemi(); }
        MethodDecl md = new MethodDecl(mods, isFree, isCtor, retType, name, typeParams, wl.Items, wl.Count, pl.Items, pl.Count, hasBody, body, baseArgs, baseArgCount, isThisInit, sp);
        md.HasCtorInit = hasCtorInit;
        md.IsPartial = Mod.Has(Mod.Parse(mods), Mod.Partial);   // add-partial-types：声明侧 HasBody=false / 实现侧 HasBody=true
        return md;
    }

}
