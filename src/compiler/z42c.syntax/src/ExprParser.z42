// 表达式子解析器（compiler-review P1-2：拆 Parser God-Class step2）。Pratt 优先级爬升。
// 持 Parser 反向引用 _p：游标原语 + 跨界 _p._typeP._parseType（类型）/_p._isTypeKeyword/_p._parseBlock。
namespace Z42.Syntax;

using Z42.Core;

public sealed partial class ExprParser {
    private Parser _p;
    public ExprParser(Parser p) { this._p = p; }

    public Expr _parseExpr(int minBp) {
        // lambda 检测（port-z42c-closures；镜像 C# IsLambdaStart）：IDENT => / ( … ) =>
        if (this._isLambdaStart()) { return this._parseLambda(); }
        Expr left = this._parsePrefix();
        while (true) {
            int k = this._p._peek().Kind;
            // ── 后缀一档（概念 bp 90，**无守卫**；等价性见 ParseTable.PostfixBp 与 V2 断言）──
            int pf = ParseTable.Postfix(k);
            // 成员访问 / `?.`（已移除，按普通 `.` 继续防级联）—— `_applyMemberPostfix`。
            if (pf == PostfixKind.Member || pf == PostfixKind.MemberNullCond) { left = this._applyMemberPostfix(left, pf); continue; }
            // 调用 / 多下标 / 后置 ++ -- —— `_applyCallIndexInc`。
            if (pf == PostfixKind.Call || pf == PostfixKind.Index || pf == PostfixKind.PostIncDec) { left = this._applyCallIndexInc(left, pf); continue; }
            // 泛型调用尝试 `名<T,…>(args)` / 闭合泛型静态成员 —— `_tryGenericCall`（null = 回滚，落下面二元 '<'）。
            // 🔴 属后缀一档、**不受 minBp 约束**（`a + f<int>(x)` 以 minBp=71 进来也要认）——见 ParseTable 抬头。
            if (pf == PostfixKind.GenericCallTry) {
                Expr g = this._tryGenericCall(left);
                if (g != null) { left = g; continue; }
            }
            // ── led 一档：绑定力/角色/特性名三样都来自 ParseTable，守卫只此**一道**
            //（此前是九处各写一遍的 `minBp <= N`：85/85/60/60/25/20/10 + `_infixBp`）。
            int bp = ParseTable.LeftBp(k);
            if (bp == 0 || bp < minBp) { break; }
            // 特性门：报了 E0301 后**仍按启用继续解析**（同 `?.`/`??` 的防级联手法）。
            string feat = ParseTable.Feature(k);
            if (feat != "") { this._p._requireFeature(feat, this._p._peek().Span); }
            int led = ParseTable.Led(k);
            // switch 表达式（postfix 形，bp 85）：`subject switch { p => b, _ => d }` —— `_parseSwitchExpr`。
            if (led == LedKind.PostfixSwitch) { left = this._parseSwitchExpr(left); continue; }
            // with 表达式（postfix，bp 85）：`target with { F = v, x }`（模式匹配 D：record 非破坏式更新）
            if (led == LedKind.PostfixWith) {
                Span wsp = this._p._peek().Span;
                this._p._advance();
                left = this._parseWithBody(left, wsp);
                continue;
            }
            // is（bp 60）：结构化模式（模式匹配核心 A1 + or/@ 放开）或 老 type/type+bind —— `_parseIsPattern`。
            if (led == LedKind.IsPattern) { left = this._parseIsPattern(left); continue; }
            // as（bp 60，右侧为类型）
            if (led == LedKind.As) {
                this._p._advance();
                TypeExpr ty = this._p._typeP._parseTypeBeforeExpr();   // `x as T ? a : b` 的 `?` 归三目
                left = new AsExpr(left, ty, left.Span);
                continue;
            }
            // `??` 已移除（E0480，与 `?.` 同码 —— 两者是同一个口子的两种写法）—— `_errNullCoalesce`。
            if (led == LedKind.NullCoalesce) { this._errNullCoalesce(bp); continue; }   // 只取 left
            // 三目 ?:（右结合，bp 20）
            if (led == LedKind.Ternary) {
                this._p._advance();
                Expr thenE = this._parseExpr(0);
                this._p._expect(TokenKind.Colon, ":");
                Expr elseE = this._parseExpr(bp);               // 右结合 ⇒ 同 bp
                left = new TernaryExpr(left, thenE, elseE, left.Span);
                continue;
            }
            // 赋值 / 复合赋值（右结合，bp 10）
            if (led == LedKind.Assign) {
                string aop = this._p._peek().Text;
                this._p._advance();
                Expr rhs = this._parseExpr(bp);                 // 右结合 ⇒ 同 bp
                left = new AssignExpr(aop, left, rhs, left.Span);
                continue;
            }
            // 二元（左结合；`bp` 已由上面那道统一守卫取到并校验过）
            if (led != LedKind.Binary) { break; }
            string op = this._p._peek().Text;
            this._p._advance();
            Expr right = this._parseExpr(bp + 1);
            left = new BinaryExpr(op, left, right, left.Span);
        }
        return left;
    }

    // ── 后缀：成员访问（`.`）与 `?.`（已移除——按普通 `.` 继续解析避免级联错，同 E0471 手法）──
    private Expr _applyMemberPostfix(Expr left, int pf) {
        if (pf == PostfixKind.Member) {
            this._p._advance();
            Token nameTok = this._p._peek();
            string name = nameTok.Text;
            if (this._p._peek().Kind == TokenKind.Identifier) { this._p._advance(); }
            else { this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected member name after '.'", this._p._peek().Span); }
            // Span 仍复用 target 的（既有诊断位置不变）；NameSpan 记成员名自身区间，
            // 供成员解析类诊断把下划线收窄到出问题的那个名字（⑦ span 地基）。
            MemberExpr me = new MemberExpr(left, name, left.Span);
            me.NameSpan = nameTok.Span;
            return me;
        }
        // define-null-check-marks：`?.` 已移除。它是 User 点名的「让问题逃掉」的口子之一——
        // 把「可能为 null」静默向下传播，最终在离现场很远的地方崩。
        //
        // ⚠️ 顺带修掉一个真 bug：原脱糖把接收者**绑定了两次**（一次在 `access` 里、
        // 一次作 `recv`），所以 `F()?.X` 会**调用 F 两次**。原注释自述
        // 「简单接收者双求值无副作用；goldens 均为局部接收者」——即已知而未修。
        Span qds = this._p._peek().Span;
        this._p._advance();
        this._p._diags.Error(DiagnosticCodes.ObsoleteNullOperator,
            "`?.` is no longer supported — write the check out: "
            + "`var t = <target>; if (t != null) { t.<member> }` "
            + "(the old form silently propagated null to somewhere far from the cause)", qds);
        string nname = this._p._peek().Text;
        if (this._p._peek().Kind == TokenKind.Identifier) { this._p._advance(); }
        else { this._p._diags.Error(DiagnosticCodes.ExpectedToken, "expected member name after '?.'", this._p._peek().Span); }
        MemberExpr qme = new MemberExpr(left, nname, left.Span);
        qme.NameSpan = qds;
        return qme;
    }

    // ── 后缀：调用 / 多下标 / 后置 ++ -- ────────────────────────────────────────────
    private Expr _applyCallIndexInc(Expr left, int pf) {
        if (pf == PostfixKind.Call) { this._p._advance(); return this._parseCall(left); }
        if (pf == PostfixKind.Index) {
            this._p._advance();
            // 逗号分隔的多下标：单维 obj[i]、多维索引器 obj[a, b]（派发 get_Item/set_Item）。
            // 至少一个下标（obj[] 非法，由首个 _parseExpr 在 ']' 上产出诊断，保持非空不变式）。
            Expr[] idxs = new Expr[8];
            int ic = 0;
            idxs[ic] = this._parseExpr(0); ic = ic + 1;
            while (this._p._peek().Kind == TokenKind.Comma) {
                this._p._advance();
                if (ic == idxs.Length) {   // fix-parser-fixed-arrays：此前定长 8，第 9 个下标即编译器崩溃
                    Expr[] bigger = new Expr[idxs.Length * 2];
                    Array.Copy(idxs, bigger, ic);
                    idxs = bigger;
                }
                idxs[ic] = this._parseExpr(0); ic = ic + 1;
            }
            this._p._expect(TokenKind.RBracket, "]");
            return new IndexExpr(left, idxs, ic, left.Span);
        }
        // 后置 ++ / --（无右操作数，结合性同 . / () / []）
        string pop = this._p._peek().Text;
        this._p._advance();
        return new UnaryExpr(pop, left, left.Span);
    }

    // ── 后缀：泛型方法调用 `名<T,...>(args)` 的 `<` 歧义消解（add-generic-methods）─────────
    // 仅当 <类型列表> 后紧跟 '(' 才判为泛型调用；否则回滚游标/诊断/_pendingGt，落到二元 '<'
    //（`LeftBp(Lt) = 60` / `Led = Binary`）。返回 null = 回滚（调用方继续 led 段）。
    private Expr _tryGenericCall(Expr left) {
        int posMark = this._p._mark();
        int diagMark = this._p._diags.Count();
        int gtMark = this._p._pendingGt;
        TypeExpr[] targs = this._p._typeP._tryParseCallTypeArgs();
        if (targs != null && this._p._peek().Kind == TokenKind.LParen) {
            this._p._advance();                       // consume '('
            CallExpr gcall = this._parseCall(left) as CallExpr;
            gcall.TypeArgs = targs; gcall.TypeArgCount = targs.Length;
            return gcall;
        }
        // complete-generic-class-identity P5-b：**闭合泛型上的静态成员** `GBox<int>.Count`。
        //
        // `<类型列表>` 后紧跟 `.` ⇒ 左边是一个**类型引用**（`GBox<int>`），不是比较。
        // 这个形状无歧义：二元 `<` 的右操作数后面不可能紧跟 `>` 再跟 `.`
        //（`a < b > .c` 里 `>` 之后缺操作数）。与 C# 的消歧规则同源
        //（C# 是「`>` 后跟 `(` `)` `]` `}` `:` `;` `,` `.` `?` `==` `!=` 之一才算类型实参」）。
        //
        // 实参挂到左边的 `IdentExpr` 上（不新造节点 —— 见 `IdentExpr.TypeArgs` 的注释），
        // 后续 `.` 由上面既有的成员访问分支照常接手。
        if (targs != null && this._p._peek().Kind == TokenKind.Dot && (left is IdentExpr)) {
            IdentExpr tid = left as IdentExpr;
            tid.TypeArgs = targs; tid.TypeArgCount = targs.Length;
            return left;   // 命中静态成员形态：left 引用不变（实参已就地挂上）
        }
        this._p._reset(posMark);
        this._p._diags.TruncateTo(diagMark);
        this._p._pendingGt = gtMark;
        return null;
    }

    // ── led：switch 表达式（`subject switch { p => b, _ => d }`，臂收集）──────────────────
    private Expr _parseSwitchExpr(Expr left) {
        Span swsp = this._p._peek().Span;
        this._p._advance();
        this._p._expect(TokenKind.LBrace, "{");
        SwitchArm[] arms = new SwitchArm[8];
        int ac = 0;
        while (this._p._peek().Kind != TokenKind.RBrace && this._p._peek().Kind != TokenKind.Eof) {
            if (ac == arms.Length) {
                SwitchArm[] big = new SwitchArm[arms.Length * 2];
                Array.Copy(arms, big, ac);
                arms = big;
            }
            Span asp = this._p._peek().Span;
            bool hasPat = true;
            Pattern pat = null;
            Expr guard = null;
            if (this._p._peek().Kind == TokenKind.Underscore) { this._p._advance(); hasPat = false; }   // 顶层 `_` = 默认臂（byte-identical 保持）
            else {
                this._p._requireFeature(FeatureNames.PatternMatch, this._p._peek().Span);
                pat = this._p._patP._parsePattern();
                if (this._p._peek().Kind == TokenKind.If) { this._p._advance(); guard = this._parseExpr(ParseTable.AboveAssign()); }
            }
            this._p._expect(TokenKind.FatArrow, "=>");
            Expr armBody = this._parseExpr(ParseTable.AboveAssign());
            arms[ac] = new SwitchArm(hasPat, pat, guard, armBody, asp); ac = ac + 1;
            if (this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); } else { break; }
        }
        this._p._expect(TokenKind.RBrace, "}");
        return new SwitchExpr(left, arms, ac, swsp);
    }

    // ── led：is（结构化模式 / or-链 / @ 绑定，或老 type / type+bind——byte-identical 保持）──
    private Expr _parseIsPattern(Expr left) {
        this._p._advance();
        int nk = this._p._peek().Kind;
        // `@` 绑定：`x is name @ P`（标识符后紧跟 `@` → At-模式，类型名后永不合法跟 `@`，无歧义）。
        // 经 _parsePattern（含 `@` + 可能的 or-链）。放开自 complete-pattern-engine：@ 入 is。
        if (nk == TokenKind.Identifier && this._p._peekAt(1).Kind == TokenKind.At) {
            this._p._requireFeature(FeatureNames.PatternMatch, this._p._peek().Span);
            Pattern pat = this._p._patP._parsePattern();
            return new IsPatternExpr(left, pat, left.Span);
        }
        // 结构化前瞻：字面量/负号/_/{/关系算子 → 结构化模式（老 is 从不以这些开头）。
        // 用 _parsePrimaryPattern 取首 alt，再判 `|` 续 or-链（`x is 1 | 2` 现为 or-模式；旧解析
        // `(x is 1) | 2` = bool|int 恒类型错、无合法程序回归 —— 放开自 complete-pattern-engine）。
        if (this._p._patP._isPatternLead(nk)) {
            this._p._requireFeature(FeatureNames.PatternMatch, this._p._peek().Span);
            Pattern pat = this._p._patP._parsePrimaryPattern();
            if (this._p._peek().Kind == TokenKind.Pipe) { pat = this._p._patP._continueOrChain(pat); }
            return new IsPatternExpr(left, pat, left.Span);
        }
        // 类型引导：解析类型后看后随（`x is T ? a : b` 的 `?` 归三目，见 `_parseTypeBeforeExpr`）。
        TypeExpr ty = this._p._typeP._parseTypeBeforeExpr();
        int nk2 = this._p._peek().Kind;
        if (nk2 == TokenKind.LParen || nk2 == TokenKind.LBrace) {
            // `(`/`{` → 结构化（位置/属性），可续 or-链：`x is Circle(r) | Square(r)`。
            this._p._requireFeature(FeatureNames.PatternMatch, ty.Span);
            Pattern pat = this._p._patP._continueFromType(ty, ty.Span);
            if (this._p._peek().Kind == TokenKind.Pipe) { pat = this._p._patP._continueOrChain(pat); }
            return new IsPatternExpr(left, pat, left.Span);
        }
        if (nk2 == TokenKind.Pipe) {
            // 纯类型名 or-模式：`x is Circle | Square`（旧解析 (x is Circle)|Square 中 Square 作值恒错）。
            this._p._requireFeature(FeatureNames.PatternMatch, ty.Span);
            Pattern first = new NamePattern(ty, "", ty.Span);
            Pattern pat = this._p._patP._continueOrChain(first);
            return new IsPatternExpr(left, pat, left.Span);
        }
        string bind = "";   // 老 is：`x is T` / `x is T v`（byte-identical，不入模式引擎）
        if (nk2 == TokenKind.Identifier) { bind = this._p._peek().Text; this._p._advance(); }
        return new IsExpr(left, ty, bind, left.Span);
    }

    // ── led：`??` 已移除的诊断块（E0480）。仍按原优先级（右结合，bp 25）**完整解析掉右侧**，
    //    否则 `a ?? b ? c : d` 之类会从表达式脱轨、级联出一串无关错误（同 E0471 / `?.` 的手法）。
    //    调用方继续时只取左侧：类型与后续检查都按 `a` 走，诊断更贴近真实意图。
    private void _errNullCoalesce(int bp) {
        Span qqs = this._p._peek().Span;
        this._p._advance();
        Expr rr = this._parseExpr(bp);                  // 右结合 ⇒ 同 bp
        this._p._diags.Error(DiagnosticCodes.ObsoleteNullOperator,
            "`??` is no longer supported — write the fallback out: "
            + "`var v = <left>; if (v == null) { v = <right>; }`. "
            + "For \"read a setting with a default\", prefer an API that takes the default "
            + "(e.g. `Environment.GetEnvironmentVariable(name, \"\")`)", qqs);
    }


    // restore-named-arguments：解析**一个**调用实参，识别命名形态 `name: value`。
    //
    // 这一半是自举迁移时丢的：原 spec（add-named-arguments）在 **C#** 编译器里
    // 实现了 `IDENT :` 前瞻（`ExprParser.Atoms.cs`），C# 编译器移除后没人移植过来
    // ⇒ 语义层（`OverloadBinder._adaptArgs`，注释里写的正是 `f(x: new())`）一直在等一个
    // 永远不会到来的形态，而当时仓库根的演示文件整个用的都是这个语法、
    // **从来没有被编译过**（顶层 examples 无人编，见 gate-toplevel-examples）。
    //
    // 载体沿用语义层已经认的 `AssignExpr("=", Ident, value)` —— 不新增 AST 节点，
    // `_adaptArgs` / `_hasNamedArg` 一行不用改就认得它。
    //
    // 🔴 不与三元 `a ? b : c` 相撞：那里的 `:` 出现在内层表达式**之后**，而本前瞻要求
    // `:` 紧跟在实参**开头**的标识符后（`IDENT` 必须是该实参的第 0 个 token）。
    // 已实测：三元实参 / Dict 字面量 `{ "a": 1 }` / `switch case 1:` 全部不受影响。
    private Expr _parseCallArg() {
        if (this._p._peek().Kind == TokenKind.Identifier
            && this._p._peekAt(1).Kind == TokenKind.Colon) {
            Token nmTok = this._p._peek();
            this._p._advance();   // IDENT
            this._p._advance();   // ':'
            Expr nv = this._parseExpr(0);
            return new AssignExpr("=", new IdentExpr(nmTok.Text, nmTok.Span), nv, nmTok.Span);
        }
        return this._parseExpr(0);
    }

    private Expr _parseCall(Expr callee) {
        Expr[] args = new Expr[8];
        int n = 0;
        if (this._p._peek().Kind != TokenKind.RParen) {
            while (true) {
                if (n == args.Length) {
                    Expr[] bigger = new Expr[args.Length * 2];
                    Array.Copy(args, bigger, n);
                    args = bigger;
                }
                Expr arg = null;
                // simplify-ref-parameters：调用点只认 `ref`。`out` / `in` 报 E0471 + 迁移提示，
                // 但仍按 ref 实参继续解析（消费 token 保持同步，避免级联错）。
                bool isRefArg = false;
                if (this._p._peek().Kind == TokenKind.Ref) { isRefArg = true; }
                else if (this._p._peek().Kind == TokenKind.Out) {
                    this._p._diags.Error(DiagnosticCodes.ObsoleteParamModifier,
                        "`out` is no longer an argument modifier — use `ref` (`out v` -> `ref v`, " +
                        "`out var v` -> `ref var v`)", this._p._peek().Span);
                    isRefArg = true;
                }
                else if (this._p._peek().Kind == TokenKind.In) {
                    this._p._diags.Error(DiagnosticCodes.ObsoleteParamModifier,
                        "`in` is no longer an argument modifier — pass the value directly", this._p._peek().Span);
                    isRefArg = true;
                }
                if (isRefArg) {
                    Token refTok = this._p._peek(); this._p._advance();
                    if (this._p._peek().Kind == TokenKind.Var) {   // `ref var n` 内联声明
                        this._p._advance();   // var
                        string vn = this._p._peek().Text;
                        if (this._p._peek().Kind == TokenKind.Identifier) { this._p._advance(); }
                        RefArgExpr ova = new RefArgExpr(new IdentExpr(vn, refTok.Span), refTok.Span);
                        ova.IsVarDecl = true; ova.VarName = vn;
                        arg = ova;
                    } else if (this._p._peek().Kind == TokenKind.Underscore) {
                        // `ref _` 丢弃符：编译器分配隐藏零值槽，`_` 不进作用域。
                        Span dsp = this._p._peek().Span; this._p._advance();
                        // 丢弃符的隐藏名在此定死：`_$d<源偏移>`。带 `$` ⇒ 用户在源码里**写不出**
                        // 这个标识符 ⇒ 天然引用不到；带偏移 ⇒ 同一调用里多个 `ref _` 互不冲突。
                        // 语义层 `_bindRefArg` 直接沿用这个名字（不再另行生成，避免两处算法漂移）。
                        string dn = "_$d" + dsp.Start.ToString();
                        RefArgExpr dsc = new RefArgExpr(new IdentExpr(dn, dsp), refTok.Span);
                        dsc.IsDiscard = true; dsc.VarName = dn;
                        arg = dsc;
                    } else {
                        arg = new RefArgExpr(this._parseExpr(0), refTok.Span);
                    }
                } else { arg = this._parseCallArg(); }
                args[n] = arg; n = n + 1;
                if (this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); }
                else { break; }
            }
        }
        this._p._expect(TokenKind.RParen, ")");
        return new CallExpr(callee, args, n, callee.Span);
    }

    // add-user-conversions：`(Ident)X` 中 X 若能无歧义地起一个 cast 操作数（标识符/字面量/new），则整体是 cast。
    // 排除 `-`/`+`/`!`/`~`/`(` 等能延续为二元或调用的起始，避免误判 `(a)-b`、`(f)(x)`。
    private static bool _castOperandStart(int k) {
        if (k == TokenKind.Identifier) { return true; }
        if (k == TokenKind.IntLiteral || k == TokenKind.FloatLiteral) { return true; }
        if (k == TokenKind.StringLiteral || k == TokenKind.CharLiteral) { return true; }
        if (k == TokenKind.InterpolatedStringLiteral || k == TokenKind.RawStringLiteral) { return true; }
        if (k == TokenKind.True || k == TokenKind.False) { return true; }
        if (k == TokenKind.New) { return true; }
        return false;
    }

    // 能否开始一个表达式 —— 与下面 `_parsePrefix` 的分发**同一张名单**（改一处必须改另一处）。
    // 供类型位消歧用：`x is T ? …` 的 `?` 后随若能开始表达式，就是三目而非可空后缀。
    internal bool _canStartExpr(int k) {
        if (k == TokenKind.LBracket || k == TokenKind.LBrace || k == TokenKind.LParen) { return true; }
        if (k == TokenKind.Minus || k == TokenKind.Bang || k == TokenKind.Tilde || k == TokenKind.Plus) { return true; }
        if (k == TokenKind.PlusPlus || k == TokenKind.MinusMinus) { return true; }
        if (k == TokenKind.Typeof || k == TokenKind.Methodof || k == TokenKind.New || k == TokenKind.Default) { return true; }
        if (k == TokenKind.IntLiteral || k == TokenKind.CharLiteral || k == TokenKind.FloatLiteral) { return true; }
        if (k == TokenKind.StringLiteral || k == TokenKind.RawStringLiteral || k == TokenKind.InterpolatedStringLiteral) { return true; }
        if (k == TokenKind.True || k == TokenKind.False || k == TokenKind.Null) { return true; }
        if (k == TokenKind.Identifier) { return true; }
        return this._p._isTypeKeyword(k);
    }

    private Expr _parsePrefix() {
        Token t = this._p._peek();
        int k = t.Kind;
        // 集合字面量：前缀 `[`（数组/重复/spread）与表达式位 `{`（List/Dict/空）。
        // 位置消歧（D1）：语句位 `{` 在 Parser.ParseStatement 已路由到 block，只有表达式位到此。
        if (k == TokenKind.LBracket) { return this._parseArrayLit(t); }
        if (k == TokenKind.LBrace)   { return this._parseBraceLit(t); }
        if (k == TokenKind.Minus || k == TokenKind.Bang || k == TokenKind.Tilde || k == TokenKind.Plus) {
            this._p._advance();
            Expr operand = this._parseExpr(ParseTable.UnaryBp());
            return new UnaryExpr(t.Text, operand, t.Span);
        }
        // 前置 ++/--（此前 prefix 解析未处理 → ++i 无法解析）。用 "pre++"/"pre--" 区别于
        // 后置 "++"/"--"（emitter 据此返回新值 vs 旧值）。
        if (k == TokenKind.PlusPlus || k == TokenKind.MinusMinus) {
            this._p._advance();
            Expr operand = this._parseExpr(ParseTable.UnaryBp());
            return new UnaryExpr("pre" + t.Text, operand, t.Span);
        }
        // cast 家族（`(Type)` / `(T[])` / `(T)operand` / 闭合泛型回溯）——见 Prefix 分片 `_parseCastPrefix`；
        // 返回 null（含回溯失败落回分组）时继续下面的分发。
        Expr cast = this._parseCastPrefix(t, k);
        if (cast != null) { return cast; }
        if (k == TokenKind.LParen) { return this._parseParenPrefix(t); }   // 分组 / 元组（Prefix 分片）
        if (k == TokenKind.Typeof) {
            this._p._advance();
            this._p._expect(TokenKind.LParen, "(");
            TypeExpr tty = this._p._typeP._parseType();
            this._p._expect(TokenKind.RParen, ")");
            return new TypeofExpr(tty, t.Span);
        }
        if (k == TokenKind.Methodof) {
            this._p._advance();
            this._p._expect(TokenKind.LParen, "(");
            return this._p._methodOfP._parseTarget(t.Span);
        }
        // new 家族（target-typed / 数组字面量初始化 / 带 size 数组 / ctor 实参 + 对象初始化器）
        // ——见 Prefix 分片 `_parseNewPrefix`。
        if (k == TokenKind.New) { return this._parseNewPrefix(t); }
        if (k == TokenKind.IntLiteral)    { this._p._advance(); return new IntLitExpr(t.Text, t.Span); }
        if (k == TokenKind.CharLiteral)   { this._p._advance(); return new CharLitExpr(ExprParser._unescapeChar(t.Text), t.Span); }
        if (k == TokenKind.FloatLiteral)  { this._p._advance(); return new FloatLitExpr(t.Text, t.Span); }
        if (k == TokenKind.StringLiteral) { this._p._advance(); return new StringLitExpr(t.Text, t.Span); }
        if (k == TokenKind.RawStringLiteral) { this._p._advance(); return new StringLitExpr(t.Text, t.Span); }
        if (k == TokenKind.InterpolatedStringLiteral) { this._p._advance(); return this._parseInterpolated(t); }
        if (k == TokenKind.True)          { this._p._advance(); return new BoolLitExpr(true, t.Span); }
        if (k == TokenKind.False)         { this._p._advance(); return new BoolLitExpr(false, t.Span); }
        if (k == TokenKind.Null)          { this._p._advance(); return new NullLitExpr(t.Span); }
        if (k == TokenKind.Default) {
            this._p._advance();
            this._p._expect(TokenKind.LParen, "(");
            TypeExpr ty = this._p._typeP._parseType();
            this._p._expect(TokenKind.RParen, ")");
            return new DefaultExpr(ty, t.Span);
        }
        if (k == TokenKind.Identifier)    { return this._parseIdentPrefix(t); }   // identifier + 宏哨兵（Prefix 分片）
        // GS6: 类型关键字在 primary 表达式位置（int.Parse / string.FromChars 等）→ IdentExpr(keyword)
        if (this._p._isTypeKeyword(k)) { this._p._advance(); return new IdentExpr(t.Text, t.Span); }
        // EOF 处缺操作数（如 `1 +`）→ 可恢复不完整，供 REPL 续读；否则真正的表达式语法错。
        this._p._errorOrIncomplete(DiagnosticCodes.UnexpectedToken, "unexpected token in expression");
        this._p._advance();
        return new IdentExpr("<error>", t.Span);
    }

    // 对象初始化器体 `{ F1 = v1, x, .. }`（已消费到 `{` 前）。条目：`Ident = expr` 或裸 `Ident`（简写）。
    // with 表达式体 `{ F = v, x }`（模式匹配 D）。复用对象初始化器的字段体文法（`F = v` / 简写 `x` / 尾逗号）；
    // `..base` 结构更新 defer。产出 WithExpr（target 已解析，wsp = `with` 关键字 span）。
    private Expr _parseWithBody(Expr target, Span wsp) {
        this._p._expect(TokenKind.LBrace, "{");
        string[] names = new string[8];
        Expr[] values = new Expr[8];
        int fc = 0;
        if (this._p._peek().Kind != TokenKind.RBrace) {
            while (true) {
                if (this._p._peek().Kind == TokenKind.DotDot) {
                    this._p._diags.Error(DiagnosticCodes.UnexpectedToken,
                        "spread `..base` in `with` expression is not yet supported", this._p._peek().Span);
                    this._p._advance();
                    this._parseExpr(0);
                } else {
                    if (fc == names.Length) {
                        string[] nb = new string[names.Length * 2];
                        Expr[] vb = new Expr[values.Length * 2];
                        Array.Copy(names, nb, fc); Array.Copy(values, vb, fc);
                        names = nb; values = vb;
                    }
                    Token fn = this._p._peek();
                    this._p._expect(TokenKind.Identifier, "field name in `with` expression");
                    names[fc] = fn.Text;
                    if (this._p._peek().Kind == TokenKind.Eq) {
                        this._p._advance();   // =
                        values[fc] = this._parseExpr(0);
                    } else {
                        values[fc] = new IdentExpr(fn.Text, fn.Span);   // 字段简写：x ≡ x = x
                    }
                    fc = fc + 1;
                }
                if (this._p._peek().Kind == TokenKind.Comma) {
                    this._p._advance();
                    if (this._p._peek().Kind == TokenKind.RBrace) { break; }   // 尾逗号
                } else { break; }
            }
        }
        this._p._expect(TokenKind.RBrace, "}");
        return new WithExpr(target, names, values, fc, wsp);
    }

    private Expr _parseObjInit(TypeExpr ty, Expr[] args, int argCount, Token t) {
        this._p._advance();   // {
        string[] names = new string[8];
        Expr[] values = new Expr[8];
        int fc = 0;
        if (this._p._peek().Kind != TokenKind.RBrace) {
            while (true) {
                if (this._p._peek().Kind == TokenKind.DotDot) {
                    // 结构更新 ..base 延后（依赖 struct 值语义）——明确报错而非静默误解析。
                    this._p._diags.Error(DiagnosticCodes.UnexpectedToken,
                        "struct update `..base` in object initializer is not yet supported", this._p._peek().Span);
                    this._p._advance();
                    this._parseExpr(0);
                } else {
                    if (fc == names.Length) {
                        string[] nb = new string[names.Length * 2];
                        Expr[] vb = new Expr[values.Length * 2];
                        Array.Copy(names, nb, fc); Array.Copy(values, vb, fc);
                        names = nb; values = vb;
                    }
                    Token fn = this._p._peek();
                    this._p._expect(TokenKind.Identifier, "field name in object initializer");
                    names[fc] = fn.Text;
                    if (this._p._peek().Kind == TokenKind.Eq) {
                        this._p._advance();   // =
                        values[fc] = this._parseExpr(0);
                    } else {
                        values[fc] = new IdentExpr(fn.Text, fn.Span);   // 字段简写：x ≡ x = x
                    }
                    fc = fc + 1;
                }
                if (this._p._peek().Kind == TokenKind.Comma) {
                    this._p._advance();
                    if (this._p._peek().Kind == TokenKind.RBrace) { break; }   // 尾逗号
                } else { break; }
            }
        }
        this._p._expect(TokenKind.RBrace, "}");
        return new ObjInitExpr(ty, args, argCount, names, values, fc, t.Span);
    }

    // 前缀 `[` → 数组字面量 `[e0, e1, ..]` / 重复 `[value; count]` / spread `[..a, x, ..b]`。
    private Expr _parseArrayLit(Token t) {
        this._p._advance();   // [
        if (this._p._peek().Kind == TokenKind.RBracket) {   // 空数组 []
            this._p._advance();
            return new ArrayLitExpr(new Expr[0], new bool[0], 0, t.Span);
        }
        bool firstSpread = false;
        if (this._p._peek().Kind == TokenKind.DotDot) { firstSpread = true; this._p._advance(); }
        Expr first = this._parseExpr(0);
        // 重复填充 `[value; count]`（非 spread 且下一个是 `;`）
        if (!firstSpread && this._p._peek().Kind == TokenKind.Semicolon) {
            this._p._advance();   // ;
            Expr count = this._parseExpr(0);
            this._p._expect(TokenKind.RBracket, "]");
            return new ArrayRepeatExpr(first, count, t.Span);
        }
        Expr[] elems = new Expr[8];
        bool[] spreads = new bool[8];
        int en = 0;
        elems[0] = first; spreads[0] = firstSpread; en = 1;
        while (this._p._peek().Kind == TokenKind.Comma) {
            this._p._advance();   // ,
            if (this._p._peek().Kind == TokenKind.RBracket) { break; }   // 尾逗号容忍
            if (en == elems.Length) {
                Expr[] b = new Expr[elems.Length * 2];
                bool[] bs = new bool[spreads.Length * 2];
                Array.Copy(elems, b, en); Array.Copy(spreads, bs, en);
                elems = b; spreads = bs;
            }
            bool sp = false;
            if (this._p._peek().Kind == TokenKind.DotDot) { sp = true; this._p._advance(); }
            elems[en] = this._parseExpr(0); spreads[en] = sp; en = en + 1;
        }
        this._p._expect(TokenKind.RBracket, "]");
        return new ArrayLitExpr(elems, spreads, en, t.Span);
    }

    // 表达式位 `{` → List 字面量 `{e0, ..}`（裸元素）/ Dict `{k0: v0, ..}`（冒号对）/ 空 `{}`。
    // 内容消歧（D1）：首元素后见 `:` → Dict；否则 List。空 `{}` → 目标类型定（EmptyBraceLitExpr）。
    private Expr _parseBraceLit(Token t) {
        this._p._advance();   // {
        if (this._p._peek().Kind == TokenKind.RBrace) {   // 空 {}
            this._p._advance();
            return new EmptyBraceLitExpr(t.Span);
        }
        Expr first = this._parseExpr(0);
        if (this._p._peek().Kind == TokenKind.Colon) {   // Dict：k: v
            this._p._advance();   // :
            Expr firstVal = this._parseExpr(0);
            Expr[] keys = new Expr[8];
            Expr[] vals = new Expr[8];
            int dn = 0;
            keys[0] = first; vals[0] = firstVal; dn = 1;
            while (this._p._peek().Kind == TokenKind.Comma) {
                this._p._advance();   // ,
                if (this._p._peek().Kind == TokenKind.RBrace) { break; }   // 尾逗号容忍
                if (dn == keys.Length) {
                    Expr[] bk = new Expr[keys.Length * 2];
                    Expr[] bv = new Expr[vals.Length * 2];
                    Array.Copy(keys, bk, dn); Array.Copy(vals, bv, dn);
                    keys = bk; vals = bv;
                }
                keys[dn] = this._parseExpr(0);
                this._p._expect(TokenKind.Colon, ":");
                vals[dn] = this._parseExpr(0);
                dn = dn + 1;
            }
            this._p._expect(TokenKind.RBrace, "}");
            return new DictLitExpr(keys, vals, dn, t.Span);
        }
        // List：裸元素
        Expr[] elems = new Expr[8];
        int en = 0;
        elems[0] = first; en = 1;
        while (this._p._peek().Kind == TokenKind.Comma) {
            this._p._advance();   // ,
            if (this._p._peek().Kind == TokenKind.RBrace) { break; }   // 尾逗号容忍
            if (en == elems.Length) {
                Expr[] b = new Expr[elems.Length * 2];
                Array.Copy(elems, b, en);
                elems = b;
            }
            elems[en] = this._parseExpr(0); en = en + 1;
        }
        this._p._expect(TokenKind.RBrace, "}");
        return new ListLitExpr(elems, en, t.Span);
    }

    private bool _isLambdaStart() {
        if (this._p._peek().Kind == TokenKind.Identifier && this._p._peekAt(1).Kind == TokenKind.FatArrow) { return true; }
        if (this._p._peek().Kind == TokenKind.LParen) {
            int depth = 0;
            int o = 0;
            while (o < 64) {
                int k = this._p._peekAt(o).Kind;
                if (k == TokenKind.LParen) { depth = depth + 1; }
                else if (k == TokenKind.RParen) {
                    depth = depth - 1;
                    if (depth == 0) { return this._p._peekAt(o + 1).Kind == TokenKind.FatArrow; }
                }
                else if (k == TokenKind.Eof) { return false; }
                o = o + 1;
            }
        }
        return false;
    }

    private Expr _parseLambda() {
        Span sp = this._p._peek().Span;
        LambdaParam[] ps = new LambdaParam[4];
        int pc = 0;
        if (this._p._peek().Kind == TokenKind.Identifier) {           // 单参无括号
            Token t = this._p._peek();
            this._p._advance();
            ps[0] = new LambdaParam(false, null, t.Text, t.Span);
            pc = 1;
        } else {                                                    // ( [Type] name, ... )
            this._p._advance();                                        // (
            bool more = this._p._peek().Kind != TokenKind.RParen;
            while (more) {
                if (pc == ps.Length) {
                    LambdaParam[] b = new LambdaParam[ps.Length * 2];
                    Array.Copy(ps, b, pc);
                    ps = b;
                }
                // 类型形态：下一 token 后还有 Identifier → 带类型（镜像 C# 探测）
                bool typed = this._p._peekAt(1).Kind == TokenKind.Identifier;
                if (typed) {
                    TypeExpr te = this._p._typeP._parseType();
                    Token pn = this._p._peek();
                    this._p._expect(TokenKind.Identifier, "lambda param name");
                    ps[pc] = new LambdaParam(true, te, pn.Text, pn.Span);
                } else {
                    Token pn = this._p._peek();
                    this._p._expect(TokenKind.Identifier, "lambda param name");
                    ps[pc] = new LambdaParam(false, null, pn.Text, pn.Span);
                }
                pc = pc + 1;
                if (this._p._peek().Kind == TokenKind.Comma) { this._p._advance(); }
                else { more = false; }
            }
            this._p._expect(TokenKind.RParen, ")");
        }
        this._p._expect(TokenKind.FatArrow, "=>");
        if (this._p._peek().Kind == TokenKind.LBrace) {
            Stmt blk = this._p.ParseStatement();
            return new LambdaExpr(ps, pc, true, null, blk, sp);
        }
        Expr body = this._parseExpr(ParseTable.AtAssign());         // 含赋值层（`=> x = y` = `=> (x=y)`，镜像 C#；逗号仍停）
        return new LambdaExpr(ps, pc, false, body, null, sp);
    }

    private static char _unescapeChar(string tokenText) {
        if (tokenText.Length < 3) { return '?'; }
        string decoded = Lexer.DecodeString(tokenText);
        if (decoded.Length > 0) { return decoded.CharAt(0); }
        return '?';
    }



}