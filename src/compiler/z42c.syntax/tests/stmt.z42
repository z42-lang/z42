// z42c.syntax 语句解析单测：var-decl / return / expr-stmt / block / if / while
//   / foreach / break / continue / throw / ternary（incr 1-5）
//   + for / do-while / switch / try-catch-finally（incr 6a）。
namespace Z42cSyntaxStmtTests;

using Std;
using Std.Test;
using Z42.Syntax;
using Z42.Core;

string parseStmt(string src) {
    var p = new Parser(src, "t.z42");
    var s = p.ParseStatement();
    return s.Dump();
}

[Test]
void test_var_decl() {
    Assert.Equal("(decl var x 1)", parseStmt("var x = 1;"));
    Assert.Equal("(decl int y (+ 2 3))", parseStmt("int y = 2 + 3;"));
    Assert.Equal("(decl Foo f bar)", parseStmt("Foo f = bar;"));   // 自定义类型
}

// add-const-keyword：局部 const 声明前缀 → VarDeclStmt.IsConst（Dump 前缀 decl-const）。
[Test]
void test_const_local() {
    Assert.Equal("(decl-const int n 8)", parseStmt("const int n = 8;"));
    Assert.Equal("(decl-const int m (* n 2))", parseStmt("const int m = n * 2;"));
}

[Test]
void test_return() {
    Assert.Equal("(return)", parseStmt("return;"));
    Assert.Equal("(return (+ x 1))", parseStmt("return x + 1;"));
}

[Test]
void test_expr_stmt() {
    Assert.Equal("(expr (call f 1))", parseStmt("f(1);"));
    Assert.Equal("(expr (= x 5))", parseStmt("x = 5;"));
    Assert.Equal("(expr (call (. obj method) a b))", parseStmt("obj.method(a, b);"));
}

[Test]
void test_block() {
    Assert.Equal("(block (decl var x 1) (return x))", parseStmt("{ var x = 1; return x; }"));
    Assert.Equal("(block)", parseStmt("{ }"));
}

[Test]
void test_if() {
    Assert.Equal("(if a (return 1))", parseStmt("if (a) return 1;"));
    Assert.Equal("(if a (expr (= x 1)) (expr (= x 2)))", parseStmt("if (a) x = 1; else x = 2;"));
}

[Test]
void test_while() {
    Assert.Equal("(while (< i 10) (expr (= i (+ i 1))))", parseStmt("while (i < 10) i = i + 1;"));
}

[Test]
void test_nested() {
    Assert.Equal("(if a (block (while b (expr (call c)))))",
                 parseStmt("if (a) { while (b) c(); }"));
}

[Test]
void test_foreach() {
    Assert.Equal("(foreach var x items (expr (call f x)))",
                 parseStmt("foreach (var x in items) f(x);"));
    Assert.Equal("(foreach int n (. obj nums) (block (expr (= sum (+ sum n)))))",
                 parseStmt("foreach (int n in obj.nums) { sum = sum + n; }"));
}

[Test]
void test_break_continue() {
    Assert.Equal("(block (break) (continue))", parseStmt("{ break; continue; }"));
    Assert.Equal("(while a (block (if b (break))))", parseStmt("while (a) { if (b) break; }"));
}

[Test]
void test_throw() {
    Assert.Equal("(throw err)", parseStmt("throw err;"));
    Assert.Equal("(throw (call (. ex Make) msg))", parseStmt("throw ex.Make(msg);"));
}

[Test]
void test_ternary_in_stmt() {
    Assert.Equal("(return (?: (> a b) a b))", parseStmt("return a > b ? a : b;"));
}

[Test]
void test_for() {
    Assert.Equal("(for (decl int i 0) (< i 10) (= i (+ i 1)) (expr (call f i)))",
                 parseStmt("for (int i = 0; i < 10; i = i + 1) f(i);"));
    Assert.Equal("(for _ _ _ (break))", parseStmt("for (;;) break;"));   // 三段全省
    Assert.Equal("(for (expr (= i 0)) (< i n) (= i (+ i 1)) (block (expr (= sum (+ sum i)))))",
                 parseStmt("for (i = 0; i < n; i = i + 1) { sum = sum + i; }"));   // init 为 expr-stmt
}

[Test]
void test_do_while() {
    Assert.Equal("(do (expr (call x)) (< i 10))", parseStmt("do x(); while (i < 10);"));
    Assert.Equal("(do (block (expr (= i (+ i 1)))) (< i n))",
                 parseStmt("do { i = i + 1; } while (i < n);"));
}

[Test]
void test_switch() {
    Assert.Equal("(switch x (case 1 (return a)) (case 2 (return b)) (default (return c)))",
                 parseStmt("switch (x) { case 1: return a; case 2: return b; default: return c; }"));
    // 空分支贯穿（case 1 无语句直落 case 2）
    Assert.Equal("(switch x (case 1) (case 2 (expr (call f)) (break)))",
                 parseStmt("switch (x) { case 1: case 2: f(); break; }"));
}

[Test]
void test_try() {
    Assert.Equal("(try (block (expr (call f))) (catch Exception e (block (expr (call g)))))",
                 parseStmt("try { f(); } catch (Exception e) { g(); }"));
    // 仅类型无变量 + finally
    Assert.Equal("(try (block (expr (call a))) (catch Error _ (block (expr (call b)))) (finally (block (expr (call c)))))",
                 parseStmt("try { a(); } catch (Error) { b(); } finally { c(); }"));
    // 裸 catch（无类型无变量）
    Assert.Equal("(try (block (expr (call a))) (catch _ _ (block (expr (call b)))))",
                 parseStmt("try { a(); } catch { b(); }"));
}

// ── span（add-z42c-source-spans）────────────────────────────────────────────────
[Test]
void test_stmt_spans() {
    // 第 2 行的 return：span 行/列指向起始 token
    var p = new Parser("int F() {\n    return 5;\n}", "t.z42");
    var cu = p.ParseCompilationUnit();
    MethodDecl f = cu.Decls[0] as MethodDecl;
    BlockStmt body = f.Body as BlockStmt;
    Assert.Equal(2, body.Stmts[0].Span.Line);
    Assert.Equal(5, body.Stmts[0].Span.Column);
    Assert.Equal("t.z42", body.Stmts[0].Span.File);
}

// ── `using` / `namespace` 只能在文件顶部（2026-09-05）────────────────────────
//
// 语言本来就不接受它们出现在语句位置，但此前是一路级联出 4 条互不相关的错误
// （unexpected token in expression → expected ';' → 两条 undefined），没有一条说得出
// 真正原因。这些用例钉住「一条说清楚的诊断 + 恢复后不再连锁误报」。

int countCode(DiagnosticBag bag, string code) {
    int n = 0;
    int i = 0;
    while (i < bag.Count()) {
        if (bag.Get(i).Code == code) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

[Test]
void test_using_in_function_body_is_one_clear_error() {
    var p = new Parser("void Main() { int a = 1; using Std.Toml; int b = 2; }", "t.z42");
    p.ParseCompilationUnit();
    var bag = p.Diagnostics();
    Assert.Equal(1, countCode(bag, DiagnosticCodes.DeclarationInStatement));
    // 恢复到分号后继续解析：不再有 E0201/E0202 的连锁误报。
    Assert.Equal(0, countCode(bag, DiagnosticCodes.UnexpectedToken));
    Assert.Equal(0, countCode(bag, DiagnosticCodes.ExpectedToken));
}

[Test]
void test_namespace_in_function_body_is_reported_too() {
    var p = new Parser("void Main() { namespace Foo; }", "t.z42");
    p.ParseCompilationUnit();
    Assert.Equal(1, countCode(p.Diagnostics(), DiagnosticCodes.DeclarationInStatement));
}

[Test]
void test_global_using_in_function_body_is_reported() {
    var p = new Parser("void Main() { global using Std.Toml; }", "t.z42");
    p.ParseCompilationUnit();
    Assert.Equal(1, countCode(p.Diagnostics(), DiagnosticCodes.DeclarationInStatement));
}

[Test]
void test_top_level_using_still_parses() {
    // 非破坏：文件顶部的 using / global using / namespace 一如既往。
    var p = new Parser("namespace N;\nusing Std;\nglobal using Std.IO;\nvoid Main() { }", "t.z42");
    p.ParseCompilationUnit();
    Assert.Equal(0, countCode(p.Diagnostics(), DiagnosticCodes.DeclarationInStatement));
    Assert.False(p.Diagnostics().HasErrors());
}

// ── 文件级 `namespace` 的位置约束（2026-09-10 fix-multiple-file-scoped-namespaces）─────
//
// z42 的编译单元只有**一个**命名空间（`CompilationUnit.Namespace` 是单值），但 parser 的
// `namespace` 分支在顶层声明循环里、每命中一次就整个覆盖 `ns` ⇒ 此前**静默 last-wins**：
// 声明在 `namespace First;` 底下的类被登记进最后那个 ns，连限定名都随之解析错
// （实测 `A.Helper.Who()` 打印的是 B 的实现）。这不是「少报一条诊断」，是**解析到错误的类型**。
//
// 🔴 全仓实测：多 `namespace` 的文件 **0 个**、`namespace` 排在声明之后的文件 **0 个**
// ⇒ 这条诊断在真实代码上永远不响，**下面这几条用例就是它唯一的门**。
//
// ⚠️ 断言用**字面量** "E0457" 而非 `DiagnosticCodes.FileScopedNamespaceMisplaced`：与发码侧同一纪律
// （新增 core→syntax 跨成员符号会撞 F2 冷启动 stale-cache，见 DiagnosticCodes.z42 该条注释）。

[Test]
void test_second_file_scoped_namespace_is_reported() {
    // 退回对照：撤掉 Parser 里的 `if (hasNs)` 分支后本条变 0（静默 last-wins = 改动前行为）。
    var p = new Parser("namespace First;\nvoid A() { }\nnamespace Last;\nvoid B() { }", "t.z42");
    p.ParseCompilationUnit();
    Assert.Equal(1, countCode(p.Diagnostics(), "E0457"));
}

[Test]
void test_duplicate_namespace_keeps_the_first() {
    // 恢复策略钉死：保留**第一个**（读者对文件顶部那一行的直觉），不被后来者覆盖。
    var p = new Parser("namespace First;\nvoid A() { }\nnamespace Last;\n", "t.z42");
    var cu = p.ParseCompilationUnit();
    Assert.Equal("First", cu.Namespace);
}

[Test]
void test_namespace_after_type_declaration_is_reported() {
    // 单个 namespace 但排在类声明之后 —— 同一类静默错配（它会回溯作用到上面那个类）。
    var p = new Parser("class X { }\nnamespace N;\n", "t.z42");
    p.ParseCompilationUnit();
    Assert.Equal(1, countCode(p.Diagnostics(), "E0457"));
}

[Test]
void test_namespace_after_usings_is_fine() {
    // using / global using / using alias **不算**声明：namespace 排在它们之后合法。
    var p = new Parser("using Std;\nglobal using Std.IO;\nnamespace N;\nvoid Main() { }", "t.z42");
    var cu = p.ParseCompilationUnit();
    Assert.Equal(0, countCode(p.Diagnostics(), "E0457"));
    Assert.Equal("N", cu.Namespace);
}

[Test]
void test_single_namespace_at_top_reports_nothing() {
    // 正常写法（全仓 100% 是这个形状）不受影响。
    var p = new Parser("namespace N;\nusing Std;\nclass X { }\nvoid Main() { }", "t.z42");
    p.ParseCompilationUnit();
    Assert.Equal(0, countCode(p.Diagnostics(), "E0457"));
    Assert.False(p.Diagnostics().HasErrors());
}
