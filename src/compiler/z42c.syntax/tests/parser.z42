// z42c.syntax Parser（Pratt 表达式）单测：用 Dump() 的 s-expression 断言结构 + 优先级。
namespace Z42cSyntaxParserTests;

using Z42.Syntax;
using Std.Harness;

// 辅助：解析表达式并返回其 s-expression dump。
string parse(string src) {
    var p = new Parser(src, "t.z42");
    var e = p.ParseExpression();
    return e.Dump();
}

[Test]
void test_literal_and_ident() {
    Assert.Equal("42", parse("42"));
    Assert.Equal("3.14", parse("3.14"));
    Assert.Equal("true", parse("true"));
    Assert.Equal("false", parse("false"));
    Assert.Equal("null", parse("null"));
    Assert.Equal("foo", parse("foo"));
    Assert.Equal("\"hi\"", parse("\"hi\""));
}

[Test]
void test_simple_binary() {
    Assert.Equal("(+ 1 2)", parse("1 + 2"));
    Assert.Equal("(* a b)", parse("a * b"));
}

[Test]
void test_precedence_mul_over_add() {
    Assert.Equal("(+ 1 (* 2 3))", parse("1 + 2 * 3"));
    Assert.Equal("(+ (* 1 2) 3)", parse("1 * 2 + 3"));
}

[Test]
void test_parens_override_precedence() {
    Assert.Equal("(* (+ 1 2) 3)", parse("(1 + 2) * 3"));
}

[Test]
void test_left_associativity() {
    Assert.Equal("(- (- a b) c)", parse("a - b - c"));
    Assert.Equal("(/ (/ a b) c)", parse("a / b / c"));
}

[Test]
void test_logical_precedence() {
    // && 绑定紧于 ||
    Assert.Equal("(|| (&& a b) c)", parse("a && b || c"));
    Assert.Equal("(|| a (&& b c))", parse("a || b && c"));
}

[Test]
void test_comparison_and_arithmetic() {
    // + 紧于 ==
    Assert.Equal("(== 1 (+ 2 3))", parse("1 == 2 + 3"));
    Assert.Equal("(< (+ a b) c)", parse("a + b < c"));
}

[Test]
void test_unary() {
    Assert.Equal("(- x)", parse("-x"));
    Assert.Equal("(! a)", parse("!a"));
    // 一元紧于二元：!a && b → (&& (! a) b)
    Assert.Equal("(&& (! a) b)", parse("!a && b"));
    // -a * b → (* (- a) b)
    Assert.Equal("(* (- a) b)", parse("-a * b"));
}

[Test]
void test_mixed_complex() {
    Assert.Equal("(|| (== (+ 1 (* 2 3)) 7) done)", parse("1 + 2 * 3 == 7 || done"));
}

[Test]
void test_member_access() {
    Assert.Equal("(. a b)", parse("a.b"));
    Assert.Equal("(. (. a b) c)", parse("a.b.c"));   // 左结合
}

[Test]
void test_call() {
    Assert.Equal("(call f)", parse("f()"));
    Assert.Equal("(call f 1 2)", parse("f(1, 2)"));
    Assert.Equal("(call (. a b) c)", parse("a.b(c)"));   // 调用作用于成员
}

[Test]
void test_index() {
    Assert.Equal("(index a 0)", parse("a[0]"));
    Assert.Equal("(index (. a items) i)", parse("a.items[i]"));
}

[Test]
void test_index_multidim() {
    // 多维索引器使用侧：逗号分隔多下标（派发 get_Item/set_Item）。
    Assert.Equal("(index m 0 1)", parse("m[0, 1]"));
    Assert.Equal("(index x a b c)", parse("x[a, b, c]"));
    Assert.Equal("(index m (+ r 1) (* c 2))", parse("m[r + 1, c * 2]"));
    // 链式：先多维索引，再成员访问。
    Assert.Equal("(. (index m i j) Value)", parse("m[i, j].Value"));
}

[Test]
void test_assign_right_assoc() {
    Assert.Equal("(= x 1)", parse("x = 1"));
    Assert.Equal("(= a (= b c))", parse("a = b = c"));        // 右结合
    Assert.Equal("(= x (+ 1 2))", parse("x = 1 + 2"));        // = 最松
}

[Test]
void test_ternary() {
    Assert.Equal("(?: a b c)", parse("a ? b : c"));
    Assert.Equal("(?: (> x 0) 1 2)", parse("x > 0 ? 1 : 2"));   // 条件含比较
    Assert.Equal("(?: a b (?: c d e))", parse("a ? b : c ? d : e"));  // 右结合
    Assert.Equal("(= x (?: a b c))", parse("x = a ? b : c"));   // = 比 ?: 更松
}

[Test]
void test_bitwise_precedence() {
    Assert.Equal("(| (& a b) c)", parse("a & b | c"));   // & (48) 紧于 | (44)
    Assert.Equal("(| a (& b c))", parse("a | b & c"));
    Assert.Equal("(<< a (+ 2 1))", parse("a << 2 + 1"));  // + (70) 紧于 << (65)
    Assert.Equal("(^ (& a b) c)", parse("a & b ^ c"));   // & (48) 紧于 ^ (46)
}

// define-null-check-marks：`??` 已移除（E0480，与 `?.` 同码）。
// 这里只钉**结构**——解析继续时只取左侧，故 `a ?? b` 的 dump 就是 `a`。
// 诊断码与解析同步的断言在 decl.z42（`parseErrorCodes` 在那个命名空间）。
[Test]
void test_null_coalescing_parses_as_left_operand() {
    Assert.Equal("a", parse("a ?? b"));
    Assert.Equal("a", parse("a ?? b ?? c"));
}

[Test]
void test_is_as() {
    Assert.Equal("(is x Foo)", parse("x is Foo"));
    Assert.Equal("(as x Bar)", parse("x as Bar"));
    Assert.Equal("(is (+ a b) int)", parse("a + b is int"));    // + (70) 紧于 is (60)
    Assert.Equal("(is x List<int>)", parse("x is List<int>"));  // 泛型类型
}

[Test]
void test_compound_assign() {
    Assert.Equal("(+= x 1)", parse("x += 1"));
    Assert.Equal("(*= (. a b) c)", parse("a.b *= c"));
    Assert.Equal("(|= flags mask)", parse("flags |= mask"));
}

[Test]
void test_new() {
    Assert.Equal("(new Foo 1 2)", parse("new Foo(1, 2)"));
    Assert.Equal("(new List<int>)", parse("new List<int>()"));
    Assert.Equal("(call (. (new Point x y) Dist))", parse("new Point(x, y).Dist()"));
}

// incr 6d-1：TypeExpr 结构化（经 is/as/new）。验证嵌套泛型 >>/>>> 拆分、限定名、数组、nullable。
[Test]
void test_type_expr_forms() {
    Assert.Equal("(is x Dict<string,int>)", parse("x is Dict<string, int>"));   // 空格归一
    Assert.Equal("(as y List<List<int>>)", parse("y as List<List<int>>"));      // 嵌套 >>
    Assert.Equal("(is z Map<K,List<V>>)", parse("z is Map<K, List<V>>"));       // 内层 List 与外层 Map 共享 >>
    Assert.Equal("(is a A<B<C<int>>>)", parse("a is A<B<C<int>>>"));            // 三层 >>>（GtGt+Gt 拆分）
    Assert.Equal("(new Foo.Bar<int>)", parse("new Foo.Bar<int>()"));           // 限定名 + 泛型
    Assert.Equal("(is b int[])", parse("b is int[]"));                          // 数组
    Assert.Equal("(as c T?)", parse("c as T?"));                               // nullable
    Assert.Equal("(is d List<int>[])", parse("d is List<int>[]"));             // 泛型 + 数组
}

// `is T` / `as T` 后的 `?`：同 C#，后随能开始表达式 ⇒ 三目；否则 ⇒ 可空后缀。
// 「零诊断」一并核（此前 `o is List<Entry> ? a : b` 把 `List<Entry>?` 吞成可空类型，在 `a` 处报 E0202）。
string parseClean(string src) {
    var p = new Parser(src, "t.z42");
    var e = p.ParseExpression();
    int errs = p.Diagnostics().ErrorCount();
    if (p._peek().Kind != TokenKind.Eof) { return "LEFTOVER " + e.Dump(); }
    if (errs != 0) { return "ERR " + e.Dump(); }
    return e.Dump();
}

[Test]
void test_is_as_type_then_ternary() {
    Assert.Equal("(?: (is o Foo) a b)", parseClean("o is Foo ? a : b"));
    Assert.Equal("(?: (is o List<Entry>) a b)", parseClean("o is List<Entry> ? a : b"));
    Assert.Equal("(?: (is o Map<K,List<V>>) 1 2)", parseClean("o is Map<K, List<V>> ? 1 : 2"));   // 嵌套 >>
    Assert.Equal("(?: (is o List<int>[]) a b)", parseClean("o is List<int>[] ? a : b"));          // 泛型数组
    Assert.Equal("(?: (is o int[]) a b)", parseClean("o is int[] ? a : b"));
    Assert.Equal("(?: (is o Foo.Bar<int>) (- 1) \"s\")", parseClean("o is Foo.Bar<int> ? -1 : \"s\""));
    Assert.Equal("(?: (as o List<int>) a b)", parseClean("o as List<int> ? a : b"));
    Assert.Equal("(?: (is o string) (new Foo) null)", parseClean("o is string ? new Foo() : null"));
    Assert.Equal("(= x (?: (is o List<int>) (call f) (call g)))", parseClean("x = o is List<int> ? f() : g()"));
    Assert.Equal("(?: (is o Circle) (?: (is o List<int>) 1 2) 3)",
        parseClean("o is Circle ? o is List<int> ? 1 : 2 : 3"));                                   // 三目嵌套
    // 带绑定 / 结构化模式 / or-链之后接三目
    Assert.Equal("(?: (is o List<int>) (. l Count) 0)", parseClean("o is List<int> l ? l.Count : 0"));
    Assert.Equal("(?: (is-pat o (or (name Foo) (name List<int>))) 1 2)", parseClean("o is Foo | List<int> ? 1 : 2"));
}

[Test]
void test_is_as_genuine_nullable_kept() {
    Assert.Equal("(as c T?)", parseClean("c as T?"));                                    // EOF
    Assert.Equal("(as c List<int>?)", parseClean("(c as List<int>?)"));                  // `)`
    Assert.Equal("(== (as c Foo?) null)", parseClean("c as Foo? == null"));              // `==` 不能开始表达式
    Assert.Equal("(&& (is c Foo?) ok)", parseClean("c is Foo? && ok"));
    Assert.Equal("(?: (as c Foo?) a b)", parseClean("c as Foo? ? a : b"));                // 可空 + 三目
    Assert.Equal("(?: (as c int[]?) a b)", parseClean("c as int[]? ? a : b"));
    Assert.Equal("(as c Map<K,List<V>>?)", parseClean("c as Map<K, List<V>>?"));         // `>>` 拆分后 `?` 归外层
    Assert.Equal("(as c A<B<C<int>>>?)", parseClean("c as A<B<C<int>>>?"));
}

// ── add-partial-types: partial 修饰符解析（Dump 经 Mods 渲染 "partial"）──────────
string parseUnit(string src) {
    var p = new Parser(src, "t.z42");
    return p.ParseCompilationUnit().Dump();
}

[Test]
void test_parse_partial_type_modifiers() {
    Assert.Equal(true, parseUnit("partial class Foo { }").IndexOf("class partial Foo") >= 0);
    Assert.Equal(true, parseUnit("partial struct S { }").IndexOf("struct partial S") >= 0);
    Assert.Equal(true, parseUnit("partial interface I { }").IndexOf("interface partial I") >= 0);
}

[Test]
void test_parse_partial_method_no_body() {
    // partial method 声明侧无 body：解析成功，Dump 显示 "method partial ..." 且无体块。
    string d = parseUnit("class C { partial void M(); }");
    Assert.Equal(true, d.IndexOf("method partial void M") >= 0);
}

// 插值串拆段：普通字符按段整段切出，转义 / `{{` `}}` 并入同一文本段；洞按嵌套深度切。
[Test]
void test_interpolated_string_parts() {
    var p = new Parser("$\"a\\tb{{c}}{x + 1}d{y}\"", "t.z42");
    var e = p.ParseExpression() as InterpolatedStringExpr;
    Assert.Equal(4, e.PartCount);
    Assert.Equal("a\tb{c}", (e.Parts[0] as InterpText).Text);
    Assert.Equal("(+ x 1)", (e.Parts[1] as InterpHole).Inner.Dump());
    Assert.Equal("d", (e.Parts[2] as InterpText).Text);
    Assert.Equal("y", (e.Parts[3] as InterpHole).Inner.Dump());
    Assert.Equal(0, p.Diagnostics().Count());
}

// 边界：首洞 / 尾文本 / 洞内嵌套串含 `}` / 纯文本无洞 / 末尾 `}}`；同一 Parser 连续多洞复用同一子解析器
// （`Parser.HoleParser`），嵌套插值走子解析器自己的那一个——两层各自独立、互不重入。
[Test]
void test_interpolated_string_edges_and_nested() {
    var p = new Parser("$\"{d[\"}\"]} tail\"", "t.z42");
    var e = p.ParseExpression() as InterpolatedStringExpr;
    Assert.Equal(2, e.PartCount);
    Assert.Equal(" tail", (e.Parts[1] as InterpText).Text);
    var p2 = new Parser("$\"plain}}\"", "t.z42");
    var e2 = p2.ParseExpression() as InterpolatedStringExpr;
    Assert.Equal(1, e2.PartCount);
    Assert.Equal("plain}", (e2.Parts[0] as InterpText).Text);
    var p3 = new Parser("$\"{$\"{a}b\"}c{n}\"", "t.z42");
    var e3 = p3.ParseExpression() as InterpolatedStringExpr;
    Assert.Equal(3, e3.PartCount);
    var inner = (e3.Parts[0] as InterpHole).Inner as InterpolatedStringExpr;
    Assert.Equal(2, inner.PartCount);
    Assert.Equal("a", (inner.Parts[0] as InterpHole).Inner.Dump());
    Assert.Equal("b", (inner.Parts[1] as InterpText).Text);
    Assert.Equal("c", (e3.Parts[1] as InterpText).Text);
    Assert.Equal("n", (e3.Parts[2] as InterpHole).Inner.Dump());   // 第二个洞：复用的子解析器已 Reset
    Assert.Equal(0, p3.Diagnostics().Count());
}
