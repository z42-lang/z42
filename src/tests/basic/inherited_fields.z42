namespace Demo;

class Animal {
    string name;
    int age;

    public Animal(string n, int a) {
        name = n;
        age = a;
    }

    public string Describe() {
        return $"{name} (age {age})";
    }
}

class Dog : Animal {
    string breed;

    // add-implicit-base-ctor-call：Animal 只有带参构造器，没写 `: base(..)` 会报 E0469。
    // 体内仍用裸名写继承字段（本用例要验的就是裸名访问继承字段）。
    public Dog(string n, int a, string b) : base(n, a) {
        name = n;
        age = a;
        breed = b;
    }

    public string Info() {
        // Access inherited fields (name, age) with bare names
        return $"{name} is a {breed}, age {age}";
    }
}

void Main() {
    var a = new Animal("Cat", 3);
    Assert.Equal("Cat (age 3)", a.Describe());

    var d = new Dog("Rex", 5, "Labrador");
    Assert.Equal("Rex is a Labrador, age 5", d.Info());
    Assert.Equal("Rex (age 5)", d.Describe());
}
