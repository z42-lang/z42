// prim 收者（string / 数值 / char…）上没有任何重载适用时，必须**编译期**判错。
//
// 回归来源：`MemberResolver` 的 prim 收者路径在 `_resolveOverload` 返回 null 时无条件落到
// **松绑定**（按裸名发调用、返回类型 Unknown，交运行期 DepIndex 解析），于是
// `"a,b".Split(',')` 编得过、再崩在 `Std.String.Split` 里（`VCall: expected object, got Char`）——
// char 既不适用 `Split(string)` 也不适用 `Split(char[])`，本就该在编译期拦下。
// 类收者路径一直是对的（只有 stub 受者才松绑定，否则报「没有这个方法」）；prim 路径少了那个分支。
//
// ⚠️ 本文件只钉**正面**（合法调用照常工作）。「非法调用要报错」在本目录**没有**门
// ——期望编译报错的用例不放这里（见 `src/tests/README.md`），由
// `z42c.semantics/tests/typecheck/prim_member/` 的 `SemanticDump` 断言钉。
// （原注释指的 `prim_overload_no_match_err/` 从来没被建出来过；2026-09-24 补上真门时订正。）
namespace Demo;

void Main() {
    string s = "a,b,c";

    // Split 的三个重载各自都要能正常选中
    Assert.Equal(3, s.Split(",").Length);
    Assert.Equal(3, s.Split(",", 0).Length);
    Assert.Equal(6, s.Split(s.ToCharArray()).Length);

    // 同名多 arity（Substring 的两个重载）不受影响
    Assert.Equal("b,c", s.Substring(2));
    Assert.Equal("a,b", s.Substring(0, 3));

    // char 能合法加宽成 int 的地方仍然合法（'a' == 97）
    Assert.Equal(97, (int)'a');

    // 其它 prim 收者
    Assert.Equal("5", (5).ToString());
    Assert.Equal("x", 'x'.ToString());
    Assert.True(s.Equals("a,b,c"));
    Assert.Equal(2, s.IndexOf("b"));
}
