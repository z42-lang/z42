// 实现标准库的**泛型接口** `Std.IEnumerable<T>` / `Std.IEnumerator<T>`，并经接口静态类型用起来。
//
// 这是全仓第一个写出 `: IEnumerable<int>` 的类型。走到这一步补了三个独立缺陷：
//   ① 跨包泛型接口退化成「名字带尖括号的伪 Class」⇒ 满足性校验 E0412 假红（#779）
//   ② 经接口静态类型访问成员不按接收者实参代换型参 ⇒ `e.Current` 静态类型是 `T`
//      （`+ 1` 报 E0402 "got T"），且形参位的 `T` 接受任何实参（漏报）
//   ③ foreach 协议判定只认类那条继承线（#777）—— 由 foreach_ienumerable.z42 的 ⑥ 钉住
//
// ⚠️ **仍然不能对这个类型写 `foreach`**，也不能调 `e.Dispose()`：两者都要走
// `IEnumerator<T> : IDisposable` **继承来的** `Dispose`，而**跨包导入的接口丢失了父接口链** ——
// `ExportedInterfaceZ` 没有 BaseNames 字段，导入侧因此恢复不出继承关系（本地接口的继承已由
// #778 修好，跨包这条是独立的一洞）。数据其实在 zbc 里（TYPE 段的 Interfaces 块，zbc 1.17 起
// 已含传递基接口），缺的只是搬运 + 恢复 ⇒ 无需格式 bump，但要给 z42.ir 加字段再被 semantics
// 引用 = 新跨成员符号，按 bootstrap-seed 纪律得跨一个 nightly，故独立立项。
// 那一条修好后，这里就能直接 `foreach (int x in seq)`。
namespace Demo.ImplementStdIEnumerable;

using Std;
using Std.Collections;

class CountEnum : IEnumerator<int> {
    int _pos;
    int _end;
    public CountEnum(int end) { this._pos = 0; this._end = end; }
    public bool MoveNext() {
        if (this._pos < this._end) { this._pos = this._pos + 1; return true; }
        return false;
    }
    public int Current { get { return this._pos - 1; } }
    public void Dispose() { }
}

class CountSeq : IEnumerable<int> {
    int _end;
    public CountSeq(int end) { this._end = end; }
    public IEnumerator<int> GetEnumerator() { return new CountEnum(this._end); }
}

void Main() {
    CountSeq seq = new CountSeq(4);

    // ① 经具体类型取枚举器并手工驱动到底。
    IEnumerator<int> e = seq.GetEnumerator();
    int count = 0;
    while (e.MoveNext()) { count = count + 1; }
    Assert.Equal(4, count);

    // ② 经**接口静态类型**取枚举器 —— `IEnumerable<int>.GetEnumerator()` 的返回类型必须仍带
    //    实参（`IEnumerator<int>`），否则这一行的赋值接不上。
    IEnumerable<int> asIface = seq;
    IEnumerator<int> e2 = asIface.GetEnumerator();
    int count2 = 0;
    while (e2.MoveNext()) { count2 = count2 + 1; }
    Assert.Equal(4, count2);

    // ③ `Current` 经接口静态类型读出来就是 int，能直接参与 int 运算
    //    （型参未代换时这里报 E0402 "operator + requires numeric operand, got T"）。
    IEnumerator<int> e3 = seq.GetEnumerator();
    e3.MoveNext();
    int first = e3.Current;
    Assert.Equal(0, first);
    Assert.Equal(1, first + 1);

    // ④ 累加元素：元素类型确实是 int 而非 T / Object。
    IEnumerator<int> e4 = asIface.GetEnumerator();
    int sum = 0;
    while (e4.MoveNext()) { sum = sum + e4.Current; }
    Assert.Equal(6, sum);            // 0+1+2+3

    // ⑤ 空序列：接口路径同样正常收敛。
    IEnumerator<int> e5 = new CountSeq(0).GetEnumerator();
    int empties = 0;
    while (e5.MoveNext()) { empties = empties + 1; }
    Assert.Equal(0, empties);
}
