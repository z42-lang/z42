// add-osr-loop-tiering: a function called exactly ONCE but running a hot inner
// loop. Call-count tiering never upgrades it (count = 1), so under --mode jit it
// starts on the interpreter and OSR (on-stack replacement) takes it native once the
// loop's back-edge count crosses Z42_OSR_THRESHOLD. The result must be byte-for-byte
// identical to the pure interpreter run — that equivalence is what this golden pins.
namespace OsrTest;

using Std.IO;

long HotSum(long n) {
    long total = 0L;
    long i = 0L;
    while (i < n) {
        total = total + i;
        i = i + 1L;
    }
    return total;
}

void Main() {
    // 50000 iterations comfortably crosses the default OSR threshold (10000):
    // the tail of the loop runs as native code, the head on the interpreter.
    // Sum of 0..49999 = 49999 * 50000 / 2 = 1249975000.
    long r = HotSum(50000L);
    Console.WriteLine(r.ToString());
}
