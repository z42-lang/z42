// `default` 位置无关：只有所有 case 都不匹配时才走它，写在哪一行都一样。
//
// 回归来源：emitter 曾经就地发射 default 并直接跳出发射循环，于是写在 default **之后**的
// case 根本没被 emit —— 永远不可达，且零诊断。`switch (2) { default: …; case 2: … }` 打的是
// default。这里把 default 放在首 / 中 / 末三个位置各钉一遍。
namespace Demo;

string Pick(int n) {
    switch (n) {
        case 1: return "one";
        default: return "other";
        case 2: return "two";
        case 3: return "three";
    }
}

string PickFirst(string s) {
    switch (s) {
        default: return "other";
        case "a": return "aye";
        case "b": return "bee";
    }
}

string PickLast(int n) {
    switch (n) {
        case 1: return "one";
        case 2: return "two";
        default: return "other";
    }
}

// switch 里的 continue 要透传外层循环；default 写在前面也不能改变这一点。
int SumSkippingTwo(int hi) {
    int total = 0;
    int i = 0;
    while (i < hi) {
        i = i + 1;
        switch (i) {
            default: break;
            case 2: continue;
        }
        total = total + i;
    }
    return total;
}

void Main() {
    // default 夹在中间：它后面的 case 仍然可达
    Assert.Equal("one", Pick(1));
    Assert.Equal("two", Pick(2));
    Assert.Equal("three", Pick(3));
    Assert.Equal("other", Pick(9));

    // default 写在最前：所有 case 仍然可达
    Assert.Equal("aye", PickFirst("a"));
    Assert.Equal("bee", PickFirst("b"));
    Assert.Equal("other", PickFirst("z"));

    // default 写在最后：一如既往
    Assert.Equal("one", PickLast(1));
    Assert.Equal("two", PickLast(2));
    Assert.Equal("other", PickLast(9));

    // 1 + 3 + 4 = 8（2 被 continue 跳过）
    Assert.Equal(8, SumSkippingTwo(4));
}
