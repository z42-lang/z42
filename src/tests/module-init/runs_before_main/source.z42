using Std.IO;

// add-module-init-hook：**主包自己的** `[ModuleInit]` 在 `Main` 的第一行之前跑完。
//
// 主包不经惰性加载器，但它的类型经 `seed_lazy_loader_types` 同样流过 `insert_type`
// ⇒ 自动登记（那条路此前直接写 type_registry、绕过漏斗，主包的初始化器因此静默不跑）。
class Boot {
    [ModuleInit]
    static void Init() { Console.WriteLine("init"); }
}

void Main() {
    Console.WriteLine("t1");
    Console.WriteLine("t2");
}
