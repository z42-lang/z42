// add-boxed-struct-identity (P4b): struct 字段反射 + 装箱引用身份端到端。
//   验证：① boxed struct FieldInfo.GetValue（基元/string/嵌套 struct 返 boxed 快照）；
//   ② FieldInfo.SetValue 就地写穿共享盒 + 别名可见（C# 引用身份）；③ 装箱前原 struct 值不受影响
//   （值语义拷贝）；④ 嵌套 struct 快照独立于父（值语义）。
namespace Demo;
using Std;
using Std.IO;
using Std.Reflection;

struct Point {
    int x;
    int y;
    string tag;
}

struct Line {
    Point a;
    Point b;
}

// add-object-inline-struct-reflection (P4b-B): heap classes with inline struct fields.
class Widget {
    int id;
    Point origin;   // inlined into the object's struct_bytes (dead slot placeholder)
    string label;
}

class Frame {
    Line edge;      // inline struct whose struct itself nests structs + ref leaves
}

FieldInfo field(Type t, string name) {
    FieldInfo[] fs = t.GetFields();
    int i = 0;
    while (i < fs.Length) {
        if (fs[i].Name == name) { return fs[i]; }
        i = i + 1;
    }
    return null;
}

void Main() {
    Point p = new Point();
    p.x = 10;
    p.y = 20;
    p.tag = "hi";

    object boxed = p;
    Type tp = typeof(Point);

    // ① GetValue：基元 + string
    Console.WriteLine((int)field(tp, "x").GetValue(boxed));       // 10
    Console.WriteLine((int)field(tp, "y").GetValue(boxed));       // 20
    Console.WriteLine((string)field(tp, "tag").GetValue(boxed));  // hi

    // ② SetValue 写穿 + 引用身份（别名 alias 看见变更）
    object alias = boxed;
    field(tp, "x").SetValue(boxed, 99);
    field(tp, "tag").SetValue(boxed, "bye");
    Console.WriteLine((int)field(tp, "x").GetValue(alias));       // 99
    Console.WriteLine((string)field(tp, "tag").GetValue(alias));  // bye

    // ③ 装箱前原 struct 值不受影响（装箱是拷贝，值语义）
    Console.WriteLine(p.x);                                        // 10

    // ④ 嵌套 struct 字段：GetValue 返 boxed 快照
    Line ln = new Line();
    ln.a.x = 1;
    ln.a.y = 2;
    ln.a.tag = "A";
    ln.b.x = 3;
    ln.b.y = 4;
    ln.b.tag = "B";
    object boxedLine = ln;
    object boxedA = field(typeof(Line), "a").GetValue(boxedLine);
    Console.WriteLine((int)field(tp, "x").GetValue(boxedA));      // 1
    Console.WriteLine((string)field(tp, "tag").GetValue(boxedA)); // A

    // 改嵌套快照不影响父（值语义快照）
    field(tp, "x").SetValue(boxedA, 777);
    object boxedA2 = field(typeof(Line), "a").GetValue(boxedLine);
    Console.WriteLine((int)field(tp, "x").GetValue(boxedA2));     // 1

    // ⑤ 对象内联 struct 字段反射（P4b-B）
    Widget w = new Widget();
    w.id = 7;
    w.origin.x = 100;
    w.origin.y = 200;
    w.origin.tag = "orig";
    w.label = "widget";
    Type tw = typeof(Widget);

    // 普通 slot 字段仍走 slot 路径（未被内联路径误吞）
    Console.WriteLine((int)field(tw, "id").GetValue(w));         // 7
    Console.WriteLine((string)field(tw, "label").GetValue(w));   // widget

    // 内联 struct 字段 GetValue → boxed 快照
    object wo = field(tw, "origin").GetValue(w);
    Console.WriteLine((int)field(tp, "x").GetValue(wo));         // 100
    Console.WriteLine((string)field(tp, "tag").GetValue(wo));    // orig

    // SetValue 写穿对象共享字节区（引用身份），从对象字段直接读验证
    Point np = new Point();
    np.x = 555;
    np.y = 666;
    np.tag = "set";
    object npBoxed = np;
    field(tw, "origin").SetValue(w, npBoxed);
    Console.WriteLine(w.origin.x);                               // 555
    Console.WriteLine(w.origin.tag);                             // set
    object wo2 = field(tw, "origin").GetValue(w);
    Console.WriteLine((int)field(tp, "y").GetValue(wo2));        // 666

    // GetValue 返回快照，改它不回写对象（值语义）
    field(tp, "x").SetValue(wo2, 111);
    Console.WriteLine(w.origin.x);                               // 555（未变）

    // ⑥ 对象内联嵌套 struct 字段（Line 含两个 Point，引用叶子展平）
    Frame fr = new Frame();
    fr.edge.a.x = 11;
    fr.edge.a.tag = "ea";
    fr.edge.b.y = 22;
    object frEdge = field(typeof(Frame), "edge").GetValue(fr);   // boxed Line
    object frA = field(typeof(Line), "a").GetValue(frEdge);      // boxed Point
    Console.WriteLine((int)field(tp, "x").GetValue(frA));        // 11
    Console.WriteLine((string)field(tp, "tag").GetValue(frA));   // ea
}
