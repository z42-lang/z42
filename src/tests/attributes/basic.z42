namespace Demo;

using Std;

// add-attribute-reflection (C3) + attribute-handler-registry PR2 (D8 suffix):
// user-defined attribute classes applied to a class, read back via reflection as
// live, cached instances. Naming follows D8: the class carries the `Attribute`
// suffix (`RouteAttribute`) and is applied with the suffix stripped (`[Route]`);
// z42 enforces the suffix as a hard error (E0444), stricter than C#'s CA1710.
// Init path stays single (named args + default values); instances are cached.

class RouteAttribute : Attribute {
    public string Path;
    public string Method;
    public RouteAttribute(string path, string method = "GET") {
        this.Path = path;
        this.Method = method;
    }
}

class DocAttribute : Attribute {
    public string Text;
    public DocAttribute(string text) {
        this.Text = text;
    }
}

[Route("/users", method: "POST")]
[Doc("user controller")]
class UsersController {
    public int Id;
}

[Route("/health")]
class HealthCheck {
}

void Main() {
    Type t = typeof(UsersController);

    // All attributes — live instances, in application order.
    Attribute[] attrs = t.GetCustomAttributes();
    Assert.Equal(2, attrs.Length);

    // Typed lookup + field access via downcast.
    Attribute ra = t.GetAttribute(typeof(RouteAttribute));
    Assert.NotNull(ra);
    RouteAttribute r = (RouteAttribute) ra;
    Assert.Equal("/users", r.Path);
    Assert.Equal("POST", r.Method);

    Attribute da = t.GetAttribute(typeof(DocAttribute));
    Assert.NotNull(da);
    DocAttribute d = (DocAttribute) da;
    Assert.Equal("user controller", d.Text);

    // Default constructor parameter (single init path): method defaults to GET.
    Type ht = typeof(HealthCheck);
    RouteAttribute hr = (RouteAttribute) ht.GetAttribute(typeof(RouteAttribute));
    Assert.Equal("/health", hr.Path);
    Assert.Equal("GET", hr.Method);

    // Absent attribute → null.
    Assert.Null(ht.GetAttribute(typeof(DocAttribute)));

    // Cached: repeated calls on the same Type return the same instances.
    Attribute[] attrs2 = t.GetCustomAttributes();
    Assert.True(attrs[0] == attrs2[0]);
    Assert.True(attrs[1] == attrs2[1]);
}
