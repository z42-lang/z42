namespace PerParameterVariance;

class Animal {}
class Cat : Animal {}
interface IContext<C> { C Context(); }
interface ISink<C,T> : IContext<C> { string Put(T value); }
class DualSink : ISink<int,Animal>, ISink<int,Cat> {
    public int Context() { return 42; }
    public string Put(Animal value) { return "animal"; }
    public string Put(Cat value) { return "cat"; }
}
void Main() {
    DualSink dual = new DualSink();
    ISink<int,Cat> exact = dual;
    Assert.Equal("cat", exact.Put(new Cat()));
    ISink<int,Animal> source = dual;
    ISink<int,Cat> converted = source;
    Assert.Equal("animal", converted.Put(new Cat()));
    Assert.Equal(42, converted.Context());
}
