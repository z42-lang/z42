namespace ClosedBaseVariance;

class Animal {}
class Cat : Animal {}
interface ITag { string Tag(); }
interface ILabel<T> { T Label(); }
interface ISink<T> : ITag, ILabel<int> { string Put(T value); }

class DualSink : ISink<Animal>, ISink<Cat> {
    public string Tag() { return "tag"; }
    public int Label() { return 42; }
    public string Put(Animal value) { return "animal"; }
    public string Put(Cat value) { return "cat"; }
}

void Main() {
    DualSink dual = new DualSink();
    ISink<Cat> exact = dual;
    Assert.Equal("cat", exact.Put(new Cat()));
    ISink<Animal> source = dual;
    ISink<Cat> narrowed = source;
    Assert.Equal("animal", narrowed.Put(new Cat()));
    Assert.Equal("tag", narrowed.Tag());
    Assert.Equal(42, narrowed.Label());
}
