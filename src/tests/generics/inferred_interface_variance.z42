namespace InferredVariance;

using Std;

class Animal {}
class Cat : Animal {}
class Kitten : Cat {}

interface IProducer<T> { T Get(); }
interface ISink<T> { string Put(T value); }

class CatSource : IProducer<Cat> {
    public Cat Get() { return new Cat(); }
}

class KittenSource : IProducer<Kitten> {
    public Kitten Get() { return new Kitten(); }
}

class VarianceOverloads {
    public static string Choose(IProducer<Animal> source) { return "animal"; }
    public static string Choose(IProducer<Cat> source) {
        return source.Get() is Kitten ? "cat from kitten" : "cat";
    }
}

class DualSink : ISink<Animal>, ISink<Cat> {
    public int Marker = 9;
    public string Put(Animal value) { return "animal"; }
    public string Put(Cat value) { return "cat"; }
}

class GenericSink<T> : ISink<T> {
    public string Put(T value) { return "generic"; }
}

struct StructSink : ISink<Animal> {
    public int Marker;
    public string Put(Animal value) { return "struct"; }
}

interface IMap<TIn,TOut,TState> {
    TOut Apply(TIn value, TState state);
    TState State();
}

class DualMap : IMap<Animal,Cat,int>, IMap<Cat,Animal,int> {
    public Cat Apply(Animal value, int state) { return new Cat(); }
    public Animal Apply(Cat value, int state) { return new Animal(); }
    public int State() { return 42; }
}

class Holder {
    public ISink<Cat> Sink;
}

class Delivery {
    public string Result;

    public Delivery(ISink<Cat> sink, int marker = 7) {
        this.Result = marker == 7 ? sink.Put(new Cat()) : "wrong default";
    }
}

string Deliver(ISink<Cat> sink, int marker = 7) {
    return marker == 7 ? sink.Put(new Cat()) : "wrong default";
}

string ChooseFree(int marker) { return "int"; }
string ChooseFree(IProducer<Animal> input) { return "free animal"; }
string ChooseFree(IProducer<Cat> input) {
    return input.Get() is Kitten ? "free cat from kitten" : "free cat";
}

IProducer<Animal> Widen(IProducer<Cat> cats) {
    return cats;
}

string SendKitten(ISink<Kitten> sink) {
    return sink.Put(new Kitten());
}

void Main() {
    IProducer<Cat> cats = new CatSource();
    IProducer<Animal> animals = Widen(cats);
    IProducer<Kitten> kittens = new KittenSource();
    Assert.Equal("animal", VarianceOverloads.Choose(animals));
    Assert.Equal("cat", VarianceOverloads.Choose(cats));
    Assert.Equal("cat from kitten", VarianceOverloads.Choose(source: kittens));
    Assert.Equal("int", ChooseFree(7));
    Assert.Equal("free animal", ChooseFree(animals));
    Assert.Equal("free cat", ChooseFree(cats));
    Assert.Equal("free cat from kitten", ChooseFree(input: kittens));
    Assert.Equal(true, animals.Get() is Cat);
    Assert.Equal(true, Object.ReferenceEquals(cats, animals));
    object widened = animals;
    Assert.Equal(true, widened is IProducer<Animal>);
    Assert.Equal(true, (widened as IProducer<Animal>).Get() is Cat);

    DualSink dual = new DualSink();
    ISink<Animal> source = dual;
    ISink<Cat> exactTarget = dual;
    Assert.Equal("cat", exactTarget.Put(new Cat()));

    Holder holder = new Holder();
    holder.Sink = source;
    Assert.Equal("animal", holder.Sink.Put(new Cat()));

    ISink<Cat> converted = source;
    Assert.Equal("animal", converted.Put(new Cat()));
    Assert.Equal("animal", SendKitten(converted));
    Assert.Equal("animal", SendKitten(source));
    Assert.Equal("animal", Deliver(source));
    Assert.Equal("animal", Deliver(sink: source));
    Assert.Equal("animal", (new Delivery(source)).Result);
    Assert.Equal("animal", (new Delivery(sink: source)).Result);
    ISink<Kitten> twice = converted;
    object chained = twice;
    Assert.Equal("animal", (chained as ISink<Cat>).Put(new Cat()));
    Assert.Equal(true, Object.ReferenceEquals(exactTarget, converted));

    object boxedView = converted;
    Assert.Equal(true, boxedView is ISink<Cat>);
    Assert.Equal("animal", (boxedView as ISink<Cat>).Put(new Cat()));
    Assert.Equal(true, boxedView is DualSink);
    DualSink original = (DualSink)boxedView;
    Assert.Equal("cat", original.Put(new Cat()));
    Assert.Equal(9, original.Marker);

    ISink<Animal> boxedStruct = new StructSink();
    ISink<Cat> narrowedStruct = boxedStruct;
    Assert.Equal("struct", narrowedStruct.Put(new Cat()));

    ISink<Animal> generic = new GenericSink<Animal>();
    ISink<Cat> genericNarrowed = generic;
    Assert.Equal("generic", genericNarrowed.Put(new Cat()));

    DualMap dualMap = new DualMap();
    IMap<Animal,Cat,int> map = dualMap;
    IMap<Cat,Animal,int> exactMap = dualMap;
    Assert.Equal(false, exactMap.Apply(new Cat(), 1) is Cat);
    IMap<Cat,Animal,int> projectedMap = map;
    Assert.Equal(true, projectedMap.Apply(new Cat(), 1) is Cat);
    Assert.Equal(42, projectedMap.State());
    Assert.Equal(true, Object.ReferenceEquals(exactMap, projectedMap));

    IProducer<Cat> absent = null;
    IProducer<Animal> widenedNull = absent;
    Assert.Equal(true, Object.ReferenceEquals(null, widenedNull));
}
