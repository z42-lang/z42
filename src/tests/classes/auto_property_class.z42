// Auto-property: get-set + readonly forms.

class Box {
    public int Width { get; set; }
    public int Height { get; set; }
    public string Label { get; }   // readonly

    Box(int w, int h, string label) {
        this.Width  = w;
        this.Height = h;
        // get-only property: writable only inside the ctor, by its source name.
        // (Writing `__prop_Label` directly used to be the workaround — `this.Label = label`
        // silently wrote a phantom field; fix-autoprop-getonly-backing-write.)
        this.Label = label;
    }
}

void Main() {
    var b = new Box(3, 4, "first");
    Assert.Equal(3, b.Width);
    Assert.Equal(4, b.Height);
    Assert.Equal("first", b.Label);

    // Setter dispatch
    b.Width = 10;
    Assert.Equal(10, b.Width);

    // Property in expression
    Assert.Equal(14, b.Width + b.Height);
}
