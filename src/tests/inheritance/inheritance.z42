namespace Demo;

class Animal {
    public string Name;

    public Animal(string name) {
        this.Name = name;
    }

    public string Describe() {
        return $"Animal: {this.Name}";
    }
}

class Dog : Animal {
    string Breed;

    // add-implicit-base-ctor-call：Animal 只有带参构造器，须显式 `: base(..)`（否则 E0469）。
    public Dog(string name, string breed) : base(name) {
        this.Name = name;
        this.Breed = breed;
    }

    public string Describe() {
        return $"Dog: {this.Name} ({this.Breed})";
    }
}

void Main() {
    var a = new Animal("Cat");
    var d = new Dog("Rex", "Husky");
    Assert.Equal("Animal: Cat",        a.Describe());
    Assert.Equal("Dog: Rex (Husky)",   d.Describe());
    Assert.Equal("Rex",                d.Name);
}
