namespace Demo.VarApp;

using Std.IO;
using Demo.VarTarget;
using Demo.VarExt;

// 跨包 var 字段消费（方法体内，被依赖包已初始化）。修复前均 E0402（读到「var」）。
void Main() {
    Console.WriteLine(Config.Count + 100);   // int 算术 → 105
    Console.WriteLine(Config.Name + "!");     // string 拼接 → z42!
    Console.WriteLine(Extra.Label + "!");     // ext 包 var 字段 → ext!
}
