using Demo.IfaceStatTarget;

// ❌ INum2.MakeZero 是 static abstract；这里实现成 instance 方法 → 跨包满足性校验报 E0412。
struct Bad : INum2 {
    public int MakeZero() { return 0; }
}

void Main() {
    Console.WriteLine("iface static mismatch fixture");
}
