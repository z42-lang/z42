// unify-type-identity-fqn：与 ext 包**同短名**的 Widget，分居两个 ns。
namespace Demo.FqnAlpha;

public class Widget { public int a; }
public interface IMark { int Tag(); }
public enum Shade { Light, Dark }

// 在自己的 ns 里用**非限定**短名引用 —— 修前持久化成 "Widget"，与 Demo.FqnBeta.Widget 撞键。
public class HolderA {
    public Widget w;
    public IMark  m;
    public Shade  s;
}
