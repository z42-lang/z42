namespace Demo.FreeFuncBase;

// A namespace-level (free) function, exported and bare-called across zpkg.
// Regression for fix-imported-free-func-namespace: a bare call to an imported
// free function must be qualified to THIS declaring ns (Demo.FreeFuncBase),
// not the caller's ns.
int Square(int x) {
    return x * x;
}

// imported-generic-func-type-param-fidelity：**泛型**自由函数，跨包调用。
// 修复前导入侧型参 `T` 退化成名为 "T" 的普通类 ⇒ `IdOf(p)` 报
// `E0402: cannot assign int to T (argument)`（显式实参 `IdOf<int>(p)` 同样不救）。
T IdOf<T>(T a) {
    return a;
}
