// add-iface-return-bridge：实现返回**具体 struct**、接口声明返回**引用型**的协变。
//
// 修前：编译期零诊断，运行期 `Std.MissingSymbolException: … takes 2 physical argument(s),
// the call passes 1` —— sret 由**调用点的静态返回类型**决定（`CallEmitter._isBlobStruct(c.Type())`），
// 接口调用点看到的是引用返回 ⇒ 不传隐藏返回槽，而被调方按 sret 编译。
// 修后：桥接占裸名 vtable 槽（接口派发按方法名索引），具体实现挪到 `<m>$struct`：
//   fn @C.m(this) -> <接口声明的返回类型>   { struct_alloc + call @C.m$struct + __box_struct + ret }
//
// ⭐ 判别力成对：**一字段** struct（标量 repr = 自描述 Value）修前就是对的，本测试也覆盖它
// —— 若哪天判据从「blob」放宽成「凡 struct 返回」，那一组会因为多出无谓装箱而暴露。

interface IThing { int V(); }

// ── 两字段 = blob struct（走 sret）：修前崩的就是这一档 ──────────────────
[Record] struct Two(int _a) : IThing {
    int _b;
    public int V() { return this._a; }
}
interface IBox { IThing Get(); }
class Impl : IBox {
    public Two Get() { return new Two(11); }
}

// ── 一字段 = 标量 repr（不走 sret）：修前修后都该对，且**不该**被桥接 ─────
[Record] struct One(int _v) : IThing {
    public int V() { return this._v * 10; }
}
class OneBox : IBox {
    public One Get() { return new One(7); }
}

// ── 虚覆盖一致性：基类实现接口、子类 override 同一方法 ──────────────────
// 标记打在**声明接口的那个类**（Base）上，子类的 override 是另一个 MethodSymbol、从不经过接口
// 满足性校验 ⇒ 不把标记沿基链下推，就会出现「Base 改名+桥接，Derived 覆盖仍占裸名且带 sret」，
// 对 Derived 实例走接口派发时同一个崩溃换个入口回来（实测过：`Derived.Get … passes 1`）。
class VBase : IBox {
    public virtual Two Get() { return new Two(1); }
}
class VDerived : VBase {
    public override Two Get() { return new Two(2); }
}

// ── 泛型档：实例化返回类型（`MyIter<T>`），blob 名要经 `_blobStructName` 解 ──
interface IMyIter<T> { bool MoveNext(); T Current { get; } void Dispose(); }
interface IMyEnum<T> { IMyIter<T> GetEnumerator(); }
// ⚠️ 字段用 `T[]`（引用）而**不是**裸 `T`：`[Record] struct X<T>(T _f)` 这种**型参主构造器
// 字段**从方法返回后会读出零值 —— 这是与本 change 无关的**既有**缺陷（同 main 基线实测一致：
// `ia.Current` 读 0 而非 7）。踩上它会让本 fixture 因为别的 bug 变红、指向错误的方向。
[Record] struct MyIter<T>(T[] _xs) : IMyIter<T> {
    int _pos;
    public bool MoveNext() { this._pos = this._pos + 1; return this._pos <= this._xs.Length; }
    public T Current { get { return this._xs[this._pos - 1]; } }
    public void Dispose() { }
}
class MyColl<T> : IMyEnum<T> {
    T[] _xs;
    public MyColl(T[] xs) { this._xs = xs; }
    public MyIter<T> GetEnumerator() { return new MyIter<T>(this._xs); }
}

void Main() {
    // 两字段 blob：经接口静态类型调用 —— 修前这一行运行期抛 MissingSymbolException
    IBox b = new Impl();
    Assert.Equal(11, b.Get().V());

    // 一字段标量：对照组（修前就对，桥接不该介入）
    IBox o = new OneBox();
    Assert.Equal(70, o.Get().V());

    // 具体静态类型直接调：仍拿到 struct 本身（无装箱快路径没被桥接夺走）
    // 注：变量别起名 `impl` —— 它是关键字（`impl` 块），当变量名会撞出一串 E0202/E0401。
    Impl concrete = new Impl();
    Two two = concrete.Get();
    Assert.Equal(11, two.V());

    // 虚覆盖：经接口派发到子类覆盖（拿 2 而非基类的 1），且 Base 静态类型的直接调用也要对
    IBox vb = new VDerived();
    Assert.Equal(2, vb.Get().V());
    VBase vbase = new VDerived();
    Assert.Equal(2, vbase.Get().V());

    // 泛型档 + foreach 经接口静态类型（foreach 脱糖后就是经接口调 GetEnumerator）
    IMyEnum<int> e = new MyColl<int>(new int[] { 9 });
    int sum = 0;
    foreach (int v in e) { sum = sum + v; }
    Assert.Equal(9, sum);

    // 泛型档 + **具体静态类型直接调**：这条与上面 foreach 走的是不同绑定路径
    // （`MemberResolver` 的泛型实例化收者分支），此前它用 `itms.RegKey`（裸名）而调用点按具体
    // 返回类型传了 sret ⇒ `MyColl.GetEnumerator … takes 1 physical argument(s), the call passes 2`。
    // ⭐ 判别靠**值语义**而不是看 IR：`--dump-ir` 在这条路上不加载导入符号，读它会被误导。
    // struct 是值类型 ⇒ 拷贝后两者独立；若错走桥接拿到装箱别名，两者同体、下面就会读出 9。
    MyColl<int> mc = new MyColl<int>(new int[] { 7, 8 });
    MyIter<int> ia = mc.GetEnumerator();
    MyIter<int> ib = ia;      // 值拷贝
    ia.MoveNext();            // 只推进 ia
    ib.MoveNext();            // ib 独立 ⇒ 这是它的第一次
    Assert.Equal(7, ib.Current);
}
