// feat/delegate-invocation-list 回归 golden：多播 `GetInvocationList()`——strong 通道
// 处理器快照（COW：取之后再订阅/退订不影响本数组）、元素可直接当委托调用；advanced 包装通道
// 不可材料化（文档言明）。
// （#1921 曾同载族基类单播版——恒 [自身]、信息量为零，2026-11-23 User 裁定删除；
//  多播枚举是 GetInvocationList 的真实需求方，保留。）
namespace Demo;

using Std;
using Std.IO;

class L {
    public int N;
    public void Tick(int n) { this.N = this.N + n; }
}

void Main() {
    L l = new L();
    Action<int> mg = l.Tick;

    // ── 多播 strong 通道快照 + COW ─────────────────────────────────────────
    var bus = new MulticastAction<int>();
    Action<int> h1 = (int k) => { l.N = l.N + k; };
    Action<int> h2 = (int k) => { l.N = l.N - k; };
    bus.Subscribe(h1);
    bus.Subscribe(h2);
    Action<int>[] snap = bus.GetInvocationList();
    Console.WriteLine("bus-len " + snap.Length.ToString());
    bus.Subscribe((int k) => { });            // 快照后再订阅
    Console.WriteLine("snap-still " + snap.Length.ToString());
    Console.WriteLine("bus-now " + bus.GetInvocationList().Length.ToString());
    bus.Unsubscribe(h1);
    Console.WriteLine("after-unsub " + bus.GetInvocationList().Length.ToString());

    // ── 快照元素直接当委托调用 ──────────────────────────────────────────
    l.N = 0;
    Action<int>[] s2 = bus.GetInvocationList();
    if (s2.Length > 0) { s2[0](3); }
    Console.WriteLine("N " + l.N.ToString()); // h2(3) ⇒ -3

    // ── MulticastPredicate 同款 ─────────────────────────────────────────
    var preds = new MulticastPredicate<int>();
    preds.Subscribe((int x) => x > 0);
    preds.Subscribe((int x) => x % 2 == 0);
    Console.WriteLine("pred-len " + preds.GetInvocationList().Length.ToString());
}
