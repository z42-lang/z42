// fix-post-inc-nonident: ++/-- on NON-ident lvalues (`arr[i]`, `obj.field`,
// `obj.Prop`) must actually read-modify-write and return the right value.
// Before the fix these were silently dropped (emitter only handled BoundIdent /
// BoundStaticGet): `arr[0]++` left arr[0] unchanged and evaluated to the old
// value with no side effect, no diagnostic.

class Counter {
    public int n;
}

class Boxed {
    public int V { get; set; }
}

void Main() {
    // ── array element ────────────────────────────────────────────────────────
    var arr = new int[] { 10, 20, 30 };

    var a0 = arr[0]++;          // post: returns OLD (10), arr[0] -> 11
    Assert.Equal(10, a0);
    Assert.Equal(11, arr[0]);

    var a1 = ++arr[1];          // pre: returns NEW (21), arr[1] -> 21
    Assert.Equal(21, a1);
    Assert.Equal(21, arr[1]);

    arr[2]--;                   // statement context, no value used
    Assert.Equal(29, arr[2]);

    var a2 = --arr[2];          // pre-dec: returns NEW (28), arr[2] -> 28
    Assert.Equal(28, a2);
    Assert.Equal(28, arr[2]);

    // the OTHER elements must be untouched by any of the above
    Assert.Equal(11, arr[0]);
    Assert.Equal(21, arr[1]);

    // ── instance field (via another object, so it binds BoundMember) ─────────
    var c = new Counter();
    c.n = 5;

    var f0 = c.n++;             // post: returns OLD (5), c.n -> 6
    Assert.Equal(5, f0);
    Assert.Equal(6, c.n);

    var f1 = ++c.n;             // pre: returns NEW (7), c.n -> 7
    Assert.Equal(7, f1);
    Assert.Equal(7, c.n);

    c.n--;
    Assert.Equal(6, c.n);

    // ── auto-property (must route through get_V / set_V) ─────────────────────
    var b = new Boxed();
    b.V = 100;

    var p0 = b.V++;            // post: returns OLD (100), b.V -> 101
    Assert.Equal(100, p0);
    Assert.Equal(101, b.V);

    var p1 = ++b.V;           // pre: returns NEW (102), b.V -> 102
    Assert.Equal(102, p1);
    Assert.Equal(102, b.V);
}
