// migrate-stdlib-to-params：String.Concat(params string[]) / String.Format(params object[])
// 覆盖 expanded form（超原固定-arity 上限）、normal-form 数组直传、混类型装箱、重复占位符。
// 注：空 params（`Concat()` / `Format(fmt)` 无实参）触发独立的空数组字面量 codegen 缺陷，
// 见 change proposal「已知限制」，不在本回归用例内。
using Std.IO;
void Main() {
    // Concat：1 参 / 4 参（超原 Concat(a,b,c) 3-arg 上限）/ normal-form 数组直传
    Console.WriteLine(string.Concat("solo"));
    Console.WriteLine(string.Concat("a", "b", "c", "d"));
    string[] xs = new string[] { "x", "y", "z" };
    Console.WriteLine(string.Concat(xs));

    // Format：单占位符 int 装箱 / 3 占位符（超原 2-arg 上限）/ 重复占位符 / 混类型
    Console.WriteLine(string.Format("{0}", 7));
    Console.WriteLine(string.Format("{0}+{1}+{2}", 1, 2, 3));
    Console.WriteLine(string.Format("{0} and {0}", "dup"));
    Console.WriteLine(string.Format("{0} is {1}", "age", 42));
}
