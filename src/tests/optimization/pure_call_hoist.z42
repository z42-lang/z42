// add-pure-call-opt e2e：热循环内反复调**纯函数**——
//   ① fib（**递归纯**、不可内联）循环不变调用 —— fix-licm-no-recursive-speculation 起**不再**
//      外提（递归可能不终止，零迭代循环里投机执行会栈溢出；User 2026-09-30 裁决正确性优先），
//      本格现在守的是「不外提也照样对」；
//   ② scaled 读**参数对象的 readonly 字段**仍判纯（readonly 值不变，复用 readonly 协同）+
//      同参两次 → 块内 CSE 消重。
// **优化前后结果必须一致**（正确性主门；pure-call 只改 IR、不改语义）。

int fib(int n) { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); }   // 纯（递归+算术+分支）

class Cfg { public readonly int factor; public Cfg(int f) { this.factor = f; } }
int scaled(Cfg c, int k) { return k * c.factor; }                             // 纯（读 readonly 字段+参数）

void Main() {
    Cfg cfg = new Cfg(3);
    long total = 0L;
    int i = 0;
    int k = 20;
    while (i < 10) {
        // fib(20)=6765；scaled(cfg,20)=60，两次=120 → 每迭代 6885
        total = total + (long)(fib(k) + scaled(cfg, k) + scaled(cfg, k));
        i = i + 1;
    }
    Assert.Equal(68850L, total);   // 10 * 6885
}
