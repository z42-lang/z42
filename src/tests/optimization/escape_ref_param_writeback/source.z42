// fix-ref-param-escape 回归：`ref` 形参的出口写回是逃逸汇点。
//
// 运行时的 ref 走「入口 copy-in / 出口 copy-out」（impl-ref-out-in-runtime）：callee 退出前
// 把**参数寄存器的终值**存回 caller 的 lvalue。callee 的 IR 完全看不见 `ref` 修饰，所以逃逸分析
// 若不特殊处理，就会把「即将被写回 caller 的新分配」判成不逃逸 → 栈分配在 callee 帧 → caller 拿到
// 的是已退出帧的悬垂句柄，读它时 VM 抛
//   `stack-alloc array handle used after its creating frame exited`。
//
// ⚠️ 本例必须带 `opt_all` sidecar：`--emit-zbc` 的默认优化集**不开** StackAlloc
//（见 IrDump.EmitZbcDefaultOpt），不开就根本走不到逃逸分析，这条断言会变成永远绿的摆设。
class Box {
    public int V;
    public Box(int v) { this.V = v; }
}

// ① 最小复现（归档 change add-learn-book-examples-gate 记的那条）：ref 数组重新赋值
void FillArray(ref string[] a) {
    a = new string[2];
    a[0] = "x";
    a[1] = "y";
}

// ② 出参形态 + 对象分配（ObjNew 与 ArrayNew 走同一条写回路径）
// simplify-ref-parameters：原为 `out Box b`；`out` 已并入 `ref`（槽位零值 ⇒ 两侧都无义务）。
void MakeBox(ref Box b) {
    b = new Box(42);
}

// ③ 再深一层：写回的数组在**更深的帧**里分配，经两级写回回到 Main
void FillNested(ref int[] a) { _inner(ref a); }
void _inner(ref int[] a) {
    a = new int[3];
    a[0] = 7; a[1] = 8; a[2] = 9;
}

// 帧 arena 复用噪声：在读取写回值**之前**再开一帧分配，踩脏悬垂句柄原先占的槽位
//（否则误栈分配可能碰巧还读得出正确值，测试变成假绿）
int Churn(int n) {
    int[] t = new int[8];
    int i = 0;
    while (i < t.Length) { t[i] = n + i; i = i + 1; }
    return t[0];
}

string Concat(string acc, string[] parts) {
    int i = 0;
    while (i < parts.Length) { acc = acc + parts[i]; i = i + 1; }
    return acc;
}

void Main() {
    string[] got = new string[0];
    FillArray(ref got);
    Assert.Equal(1, Churn(1));
    Assert.Equal(2, got.Length);
    Assert.Equal("xy", Concat("", got));

    MakeBox(ref var b);
    Assert.Equal(1, Churn(1));
    Assert.Equal(42, b.V);

    int[] nums = new int[0];
    FillNested(ref nums);
    Assert.Equal(1, Churn(1));
    Assert.Equal(3, nums.Length);
    Assert.Equal(24, nums[0] + nums[1] + nums[2]);
}
