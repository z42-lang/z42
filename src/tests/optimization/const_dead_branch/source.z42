using Std.IO;

// add-const-keyword e2e：常量条件死分支消除。const bool 条件 → br.cond(常量)→br 折叠 +
// 不可达块移除。**优化前后行为一致**（死分支本就不该执行）——死分支里的输出绝不出现。
class Flags {
    const bool Debug = false;
    const bool Release = true;
}

void heavy() { Console.WriteLine("HEAVY-SHOULD-NOT-PRINT"); }

void Main() {
    if (Flags.Debug) { heavy(); }        // const false → then 块（含 heavy）不可达
    if (Flags.Release) { Console.WriteLine("release-on"); }
    else { Console.WriteLine("RELEASE-ELSE-SHOULD-NOT-PRINT"); }
    const bool localOff = false;
    if (localOff) { Console.WriteLine("LOCAL-THEN-SHOULD-NOT-PRINT"); }
    else { Console.WriteLine("local-else"); }
    Console.WriteLine("done");
}
