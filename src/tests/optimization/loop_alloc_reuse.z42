// add-loop-alloc-hoist-reuse e2e：循环体内每迭代 new 一对象 + 一数组，两者都迭代内局部、
// 可复用 → 本 pass 会 hoist 分配到 pre-header + 循环体重初始化。**开 / 关本 pass 结果
// 必须一致**（正确性主门）。
class Point {
    public int X;
    public int Y;
    public Point(int x, int y) { this.X = x; this.Y = y; }
}

void Main() {
    long sum = 0L;
    int i = 0;
    while (i < 5) {
        Point p = new Point(i, i + 1);   // 对象复用候选（迭代内局部、ctor 单块）
        int[] a = new int[3];            // 数组复用候选（size=3、常量下标读前写全）
        a[0] = p.X;
        a[1] = p.Y;
        a[2] = p.X + p.Y;
        sum = sum + (long)(a[0] + a[1] + a[2]);
        i = i + 1;
    }
    // i=0:2  i=1:6  i=2:10  i=3:14  i=4:18
    Assert.Equal(50L, sum);
}
