using Std.IO;

// add-loop-alloc-hoist-reuse 安全兜底 e2e：循环携带对象（`head = new Node(i, head)` 每迭代引用上一个）
// → C2（前向 copy 闭包含多赋值 head）失败 → 本 pass **必须不复用**（否则链表被单一复用对象改写、崩坏）。
// 手算结果 = 0+1+2+3 = 6。开/关本 pass 必须都得 6。
class Node {
    public int V;
    public Node Next;
    public Node(int v, Node next) { this.V = v; this.Next = next; }
}

void Main() {
    Node head = null;
    int i = 0;
    while (i < 4) {
        head = new Node(i, head);   // 循环携带：C2 失败 → 不复用（每节点须独立）
        i = i + 1;
    }
    int sum = 0;
    Node cur = head;
    while (cur != null) {
        sum = sum + cur.V;
        cur = cur.Next;
    }
    Console.WriteLine(sum);
}
