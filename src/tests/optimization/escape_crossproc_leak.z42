// add-crossproc-escape-summary e2e（C 安全兜底）：对象经辅助函数**泄漏到静态字段**、
// 且分配它的帧已退出后才被读。摘要须正确识别 Keep 的 param0 逃逸 → Alloc 里的 a
// **不栈分配**（走堆），否则 Alloc 帧退出后悬垂。
class Box {
    public int V;
    public Box(int v) { this.V = v; }
}

class Holder {
    public static Box Saved;
}

void Keep(Box b) { Holder.Saved = b; }        // b 存静态 → param0 逃逸

void Alloc(int n) {
    Box a = new Box(n);
    Keep(a);                                   // a 传给逃逸 param → a 逃逸 → 不栈分配
}

void Main() {
    Alloc(7);                                  // a 在 Alloc 帧分配、逃逸到 Holder.Saved；帧随即退出
    Assert.Equal(7, Holder.Saved.V);           // 帧退出后仍可读 → 对象存活（误栈分配则悬垂）
}
