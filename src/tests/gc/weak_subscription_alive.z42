// 2026-05-04 D-1b add-weak-ref-subscription-wrapper alive-side 用例。
// 验证 Std.WeakRef<TD> 在 listener 仍 alive 时正常调度（与 weak_subscription_lapsed
// 镜像）。Listener 由 Main 主帧持强引用，invoke 应触发 OnTick。
//
// tidy-test-layout (2026-09-06)：原为 golden，OnTick 打印一行、由 expected_output.txt
// 核对。改成 OnTick 往静态 log 追加、末尾 Assert.Equal——「谁被调用了、按什么顺序」
// 从此是一条显式断言，不再是一份需要人眼比对的输出，侧车文件随之删除。
namespace Demo;
using Std;

public class Listener {
    public static string Log = "";
    public int Id;
    public Listener(int id) { this.Id = id; }
    public void OnTick(int x) { Listener.Log = Listener.Log + $"L{this.Id}:{x};"; }
}

void Main() {
    var bus = new MulticastAction<int>();
    var l1 = new Listener(1);
    var l2 = new Listener(2);

    bus.SubscribeAdvanced(new WeakRef<Action<int>>(l1.OnTick));
    bus.SubscribeAdvanced(new WeakRef<Action<int>>(l2.OnTick));

    // listener 仍由 Main 强持，weak 不影响调度
    bus.Invoke(10);
    Assert.Equal("L1:10;L2:10;", Listener.Log);
}
