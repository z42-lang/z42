namespace Demo;
using Std;

// add-gc-softref: basic soft handle — unlimited heap keeps target alive.
//
// tidy-test-layout (2026-09-06): was a Console.WriteLine golden whose
// expected_output.txt spelled out "before gc: alive / after gc: alive /
// null target: null". Every line was a liveness predicate printed as prose, so
// asserting the predicate directly says the same thing and drops the sidecar.
// The `interp_only` marker stays — soft-handle timing is interpreter-specific.

class Box {
    public int Value;
    public Box(int v) { this.Value = v; }
}

void Main() {
    // Create object + soft handle.
    Box b = new Box(42);
    SoftHandle h = SoftHandle.Create(b);

    // Before GC — target should be alive.
    Assert.NotNull(h.Get());

    // Force GC on unlimited heap — soft ref must survive.
    GC.ForceCollect();
    Assert.NotNull(h.Get());
    Assert.Equal(42, b.Value);

    // A soft handle over a null target reads back null.
    SoftHandle hn = SoftHandle.Create(null);
    Assert.Null(hn.Get());
}
