// add-gc-oom-exception (2026-05-25): verify Std.OutOfMemoryException is
// thrown and catchable when strict OOM mode rejects an object allocation.
//
// tidy-test-layout (2026-09-06): the golden printed "caught OOM / ok / done";
// all three restate one predicate, now asserted directly. The heap limit is
// restored BEFORE asserting — under a 1-byte strict-OOM heap even the assertion
// machinery would be at the mercy of the limit it is testing.
namespace Demo;
using Std;

public class BigObj {
    public int X;
    public BigObj(int x) { this.X = x; }
}

void Main() {
    // Set a tiny heap limit and enable strict OOM.
    GC.SetMaxHeapBytes(1);
    GC.SetStrictOOM(true);

    // Object allocation should throw OutOfMemoryException.
    bool caught = false;
    try {
        var obj = new BigObj(42);
    } catch (OutOfMemoryException e) {
        caught = true;
    }

    // Restore unlimited heap so the assertion below runs unconstrained.
    GC.SetMaxHeapBytes(0);
    GC.SetStrictOOM(false);

    Assert.True(caught);

    // Allocation works again once the limit is lifted.
    var ok = new BigObj(7);
    Assert.Equal(7, ok.X);
}
