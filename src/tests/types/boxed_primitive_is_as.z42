// fix-boxed-primitive-is-as：基元值存进 object 后，is/as 该基元类型须正确匹配
// （曾恒 false/null：编译器把 prim 别名误加 ns 前缀 + 运行时不识别基元值）。
void Main() {
    object o = "hi";
    Assert.True(o is string);            // 基元 string is-a string
    Assert.Equal("hi", o as string);     // as 取回原值（非 null）
    Assert.True(o is object);            // 所有基元 is-a object

    object n = 42;
    Assert.True(n is int);
    Assert.True(!(n is string));         // int 不是 string
    Assert.True(n is object);

    object b = true;
    Assert.True(b is bool);
    Assert.True(!(b is int));

    object d = 3.14;
    Assert.True(d is double);
    Assert.True(!(d is int));            // double ≠ int（F64 ≠ I64）

    object c = 'x';
    Assert.True(c is char);

    // 未命中 → as 返 null
    string s = n as string;
    Assert.True(s == null);

    // add-primitive-value-boxing：整数存进 object **装箱**为带精确宽度 type_desc 的堆对象
    // （Std.Int64 / Std.Byte / Std.Int32…），is/as/GetType 走真 type_desc → **强类型**：
    // 声明宽度精确匹配、跨宽度 is 为 false（取代 fix-boxed-primitive-is-as 的松匹配过渡）。
    object l = 9L;
    Assert.True(l is long);              // 9L 定宽 long → 装箱 Std.Int64
    Assert.True(!(l is int));            // 强类型：Int64 ≠ Int32（曾松匹配 true）
    Assert.True(l is object);
    Assert.Equal("Int64", l.GetType().Name);   // GetType 保留装箱宽度（不拆箱 this）
    Assert.Equal(9L, l as long);         // 精确类 as → 拆箱返 inner

    object by = (byte)7;
    Assert.True(by is byte);             // (byte)7 → 装箱 Std.Byte
    Assert.True(!(by is int));           // 强类型：Byte ≠ Int32
    Assert.Equal("Byte", by.GetType().Name);

    object i = 42;                       // 无后缀 + 在 int 界内 → int
    Assert.True(i is int);
    Assert.True(!(i is long));           // 强类型：Int32 ≠ Int64
    Assert.Equal("Int32", i.GetType().Name);
}
