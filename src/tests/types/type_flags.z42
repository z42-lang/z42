// add-reflection-type-flags (2026-06-10): Type.IsAbstract / IsSealed reflect
// class modifiers, persisted in the zbc TYPE-section flags byte (zbc 1.12).
abstract class Shape {
    public int x;
}

sealed class Token {
    public int id;
}

class Plain {
    public int v;
}

class Derived : Shape {   // concrete subclass of an abstract base
    public int y;
}

// add-reflection-value-record-flags: struct → IsValueType, [Record] → IsRecord.
struct Vec2 {
    public int x;
    public int y;
}

[Record] class Pair(int a, int b);

// [Record] struct → both bits: IsValueType (struct) AND IsRecord ([Record]).
[Record] struct RecPair(int a, int b);

void Main() {
    Type ts = typeof(Shape);
    Assert.True(ts.IsAbstract);
    Assert.False(ts.IsSealed);

    Type tk = typeof(Token);
    Assert.False(tk.IsAbstract);
    Assert.True(tk.IsSealed);

    Type tp = typeof(Plain);
    Assert.False(tp.IsAbstract);
    Assert.False(tp.IsSealed);
    Assert.False(tp.IsValueType);   // plain class is a reference type
    Assert.False(tp.IsRecord);

    // struct → IsValueType; record → IsRecord (each its own flag bit).
    Type tv = typeof(Vec2);
    Assert.True(tv.IsValueType);
    Assert.False(tv.IsRecord);

    Type tr = typeof(Pair);
    Assert.True(tr.IsRecord);
    Assert.False(tr.IsValueType);   // [Record] class = reference type

    // [Record] struct sets BOTH bits — value type (bit2) and is-record (bit3).
    Type trs = typeof(RecPair);
    Assert.True(trs.IsRecord);
    Assert.True(trs.IsValueType);

    // Modifiers do not propagate through inheritance.
    Type td = typeof(Derived);
    Assert.False(td.IsAbstract);
    Assert.False(td.IsSealed);

    // fix-type-reflection-names: a primitive Type is now the real `Std.Int32`
    // struct handle (typeof(int) ≡ (5).GetType()) → IsValueType true (int is a
    // value type). Not abstract / sealed / record. Never errors.
    Type ti = typeof(int);
    Assert.False(ti.IsAbstract);
    Assert.False(ti.IsSealed);
    Assert.True(ti.IsValueType);
    Assert.False(ti.IsRecord);
}
