// 2026-07-23 add-reflection-instance-nested-generic-args: obj.GetType() on a
// nested generic instance (new Box<Pair<int,string>>()) now surfaces the inner
// Pair<int,string> as a recursive constructed Type — mirroring typeof. ObjNew
// emits its type-args via _typeofArgName (FQ + bracketed), so instance and typeof
// reflection agree. Reuses the runtime bracket parser from nested_generic_args.

namespace Demo;

using Std;

class Box<T> { public T Value; }
class Pair<K, V> { public K Key; public V Val; }

void Main() {
    // ── Nested generic instance: obj.GetType() matches typeof ──────────────
    Box<Pair<int, string>> b = new Box<Pair<int, string>>();
    Type t = b.GetType();
    Assert.True(t.Name == "Box");
    Assert.True(t.IsGenericType);
    Assert.False(t.IsGenericTypeDefinition);

    Type[] outer = t.GetGenericArguments();
    Assert.True(outer.Length == 1);
    Type inner = outer[0];                        // Pair<int,string>
    Assert.True(inner.Name == "Pair");
    Assert.True(inner.IsGenericType);             // real handle (was false pre-fix)
    Assert.False(inner.IsGenericTypeDefinition);

    Type[] innerArgs = inner.GetGenericArguments();
    Assert.True(innerArgs.Length == 2);
    Assert.True(innerArgs[0].Name == "int");
    Assert.True(innerArgs[1].Name == "string");   // no leading space (was " string")

    // ── obj.GetType() == typeof for the same constructed type ──────────────
    Type viaTypeof = typeof(Box<Pair<int, string>>);
    Assert.True(viaTypeof.GetGenericArguments()[0].GetGenericArguments()[1].Name
                == inner.GetGenericArguments()[1].Name);

    // ── Flat instance generics unregressed ─────────────────────────────────
    Box<int> bi = new Box<int>();
    Type[] biArgs = bi.GetType().GetGenericArguments();
    Assert.True(biArgs.Length == 1);
    Assert.True(biArgs[0].Name == "int");
}
