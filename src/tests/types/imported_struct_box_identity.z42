namespace ImportedStructBoxIdentity;

object ThroughMethod<T>(ValueTuple2<T, T> value) { return value; }
ValueTuple2<T, T> UnboxMethod<T>(object value) { return (ValueTuple2<T, T>)value; }

class ThroughClass<T> {
    public object Wrap(ValueTuple2<T, T> value) { return value; }
}

void Main() {
    object first = (1, 2);
    object same = (1, 2);
    object wider = (1L, 2L);

    Assert.Equal(typeof(ValueTuple2<int, int>), first.GetType());
    Assert.Equal(typeof(ValueTuple2<long, long>), wider.GetType());
    Assert.True(first is ValueTuple2<int, int>);
    Assert.False(first is ValueTuple2<long, long>);
    Assert.True(first.Equals(same));
    Assert.False(first.Equals(wider));
    Assert.Equal(first.GetHashCode(), same.GetHashCode());

    ValueTuple2<int, int> value = (ValueTuple2<int, int>)first;
    Assert.Equal(1, value.Item1);
    Assert.Equal(2, value.Item2);
    Assert.True(value.Equals(same));
    Assert.True(value.Equals((1, 2)));
    Assert.False(value.Equals((1, 3)));
    Assert.False(value.Equals(wider));
    Assert.False(value.Equals((1L, 2L)));
    object boxedAgain = value;
    Assert.Equal(first.GetType(), boxedAgain.GetType());

    object fromMethod = ThroughMethod<int>(value);
    object fromClass = new ThroughClass<int>().Wrap(value);
    Assert.Equal(first.GetType(), fromMethod.GetType());
    Assert.Equal(first.GetType(), fromClass.GetType());
    object fromMethodLong = ThroughMethod<long>((1L, 2L));
    Assert.Equal(wider.GetType(), fromMethodLong.GetType());
    Assert.False(fromMethod.Equals(fromMethodLong));
    Assert.True(first.Equals(fromMethod));
    Assert.Equal(2, UnboxMethod<int>(fromClass).Item2);

    bool rejected = false;
    try { ValueTuple2<long, long> wrong = (ValueTuple2<long, long>)first; }
    catch (InvalidCastException) { rejected = true; }
    Assert.True(rejected);
    bool sharedRejected = false;
    try { UnboxMethod<long>(fromClass); }
    catch (InvalidCastException) { sharedRejected = true; }
    Assert.True(sharedRejected);
}
