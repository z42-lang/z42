// enforce-value-type-non-null：值类型字段 / 静态字段无初始化器时必须是零值，不是 Null。
//
// fix-generic-typeparam-field-zero 补上**泛型型参字段**那格 —— 此前这个用例只有非泛型，
// 于是「零初始化已经是对的」这个结论被记成了比实测更宽的样子，泛型那格漏了整整一轮。
class Holder {
    public int    N;
    public bool   B;
    public char   C;
    public double D;
    public long   L;
}
class Stat {
    public static int SN;
    public static bool SB;
}
class GBox<T> { public T V; public GBox() { } }
class Multi<A, B> { public A X; public B Y; public Multi() { } }
class Mixed<T> { public int N; public T V; public Mixed() { } }
// 继承格：派生类本身不是泛型，型参字段是从闭合基类继承来的
class DInt  : GBox<int>  { public DInt()  { } }
class DBool : GBox<bool> { public DBool() { } }
// 泛型 struct 格：存储走 struct blob 的叶子，不是对象槽
struct GStruct<T>  { public T F; }
struct GStruct2<T> { public T F; public int N; }

void Main() {
    Holder h = new Holder();
    Assert.Equal(0, h.N);
    Assert.Equal(false, h.B);
    Assert.Equal(0.0, h.D);
    Assert.Equal(0L, h.L);
    Assert.Equal(1, h.N + 1);          // 算术：Null 会炸 type mismatch
    Assert.Equal(0, Stat.SN);
    Assert.Equal(false, Stat.SB);
    Assert.Equal(1, Stat.SN + 1);

    // ── 泛型型参字段：零值按**实例化**取，不是按声明（声明里 T 是 ref 槽 ⇒ 零值曾是 Null）──
    GBox<int> gi = new GBox<int>();
    Assert.Equal(0, gi.V);
    Assert.Equal(1, gi.V + 1);         // 算术：Null 会炸 type mismatch（catch 抓不到）
    int y = gi.V;
    Assert.Equal(0, y);                // 值类型局部里绝不能装 Null

    // bool 是这类缺陷的头号探针：Null 会让 `== true` 与 `== false` **同时为假**，
    // 而 `if` 直接崩 `BrCond expects bool, got Null`。三格都要断言。
    GBox<bool> gb = new GBox<bool>();
    Assert.Equal(false, gb.V == true);
    Assert.Equal(true,  gb.V == false);
    if (gb.V) { Assert.Equal(1, 2); }  // 走到这里就说明 if 把零值判成了真

    GBox<double> gd = new GBox<double>();
    Assert.Equal(0.0, gd.V);

    // 多型参：按名字映射到正确的下标（不是跟字段表位置配对）
    Multi<int, string> m = new Multi<int, string>();
    Assert.Equal(0, m.X);
    Assert.Equal(true, m.Y == null);   // 🔒 引用型参的零值本来就是 null，不得被改写

    // 具体类型字段与型参字段混在一个类里，两者都要对
    Mixed<int> mx = new Mixed<int>();
    Assert.Equal(0, mx.N);
    Assert.Equal(0, mx.V);

    // 🔒 T 是引用类型时不介入
    GBox<string> gs = new GBox<string>();
    Assert.Equal(true, gs.V == null);

    // ── 下面两格曾经是这条不变式唯一的两个缺口 ──────────────────────────────
    // 它们与上面那些**不是同一条实现路径**：运行期分配点根本看不到实参
    //（派生类的 base 拼写不带实参；struct 布局只有 offset/kind、没有叶子的声明类型），
    // 所以只能由编译期的泛型实例化单调化解决（complete-generic-instantiation）。
    // ⇒ 这两条断言钉的是**那条线**的成果，别把它们当成分配点那层的回归。

    // ① 继承来的型参字段 —— **存储**已经是零值了
    DInt d = new DInt();
    Assert.Equal(0, d.V);
    DBool dbl = new DBool();
    Assert.Equal(false, dbl.V == true);
    Assert.Equal(true,  dbl.V == false);   // Null 会让这两条同时为假
    //
    // ⚠️ 这一格**只能断言到这里**：继承来的型参字段在**编译期仍被当成 `T`**（没有按闭合基类
    // `GBox<int>` 代换）⇒ 下面两行今天编不过，各报 E0402：
    //     Assert.Equal(1, d.V + 1);   // operator `+` requires numeric operand, got `T`
    //     if (dbl.V) { … }            // `if` condition must be `bool`, got `T`
    // 那是**编译期代换**的缺口（另一条线：complete-generic-instantiation），与本页钉的
    // **存储零值**是两件事。⇒ 那个缺口补上后，把这两行取消注释。

    // ② 泛型 struct 的型参字段 —— 这一格连**编译期类型**都已代换（算术 / `if` 都能写），
    //    与 ① 的差别本身就是个结论：两格不是同一条实现路径。
    GStruct<int> gst = new GStruct<int>();
    Assert.Equal(0, gst.F);
    Assert.Equal(1, gst.F + 1);
    GStruct2<bool> gst2 = new GStruct2<bool>();
    Assert.Equal(false, gst2.F == true);
    Assert.Equal(true,  gst2.F == false);
    Assert.Equal(0, gst2.N);           // 同一个 struct 里的具体类型字段也要对
}
