// 2026-07-24 add-enum-parse-isdefined: Enum.Parse(type, name) -> value (inverse
// of GetName; throws on unknown name, case-sensitive) + Enum.IsDefined(type,
// value). Reads the existing enum_members metadata — no format change.

namespace Test;

using Std;

enum Status {
    Ok = 0,
    NotFound = 404,
    ServerError = 500,
}

void Main() {
    // ── Parse: name → value ────────────────────────────────────────────────
    Assert.True(Enum.Parse(typeof(Status), "Ok") == 0);
    Assert.True(Enum.Parse(typeof(Status), "NotFound") == 404);
    Assert.True(Enum.Parse(typeof(Status), "ServerError") == 500);

    // ── Round-trip: GetName(Parse(n)) == n ─────────────────────────────────
    Assert.Equal("NotFound", Enum.GetName(typeof(Status), Enum.Parse(typeof(Status), "NotFound")));

    // ── Parse throws on unknown name (C# Enum.Parse semantics) ─────────────
    bool threwUnknown = false;
    try { long v = Enum.Parse(typeof(Status), "Nope"); }
    catch (Exception e) { threwUnknown = true; }
    Assert.True(threwUnknown);

    // ── Case-sensitive: "notfound" (lowercase) is NOT a member → throws ────
    bool threwCase = false;
    try { long v = Enum.Parse(typeof(Status), "notfound"); }
    catch (Exception e) { threwCase = true; }
    Assert.True(threwCase);

    // ── IsDefined ──────────────────────────────────────────────────────────
    Assert.True(Enum.IsDefined(typeof(Status), 404));
    Assert.True(Enum.IsDefined(typeof(Status), 0));
    Assert.False(Enum.IsDefined(typeof(Status), 999));
    Assert.False(Enum.IsDefined(typeof(Status), 403));
}
