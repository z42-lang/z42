// 2026-07-23 add-reflection-nested-generic-args: typeof(Box<Pair<int,string>>)
// now carries the inner Pair<int,string> as a recursive constructed Type (was
// collapsed to the bare definition name "Pair"). GetGenericArguments() on a
// nested arg recurses to arbitrary depth. Flat generics (Box<int>) unregressed.

namespace Demo;

using Std;

class Box<T> {
    public T Value;
}

class Pair<K, V> {
    public K Key;
    public V Val;
}

void Main() {
    // ── One-level nesting: typeof(Box<Pair<int,string>>) ───────────────────
    Type bp = typeof(Box<Pair<int, string>>);
    Assert.True(bp.IsGenericType);
    Assert.False(bp.IsGenericTypeDefinition);

    Type[] outer = bp.GetGenericArguments();
    Assert.True(outer.Length == 1);
    Type inner = outer[0];                        // the Pair<int,string> arg
    Assert.True(inner.Name == "Pair");            // base definition simple name
    Assert.True(inner.IsGenericType);
    Assert.False(inner.IsGenericTypeDefinition);  // constructed, not definition

    // The nested arg keeps its own type args [int, string] (the whole point).
    Type[] innerArgs = inner.GetGenericArguments();
    Assert.True(innerArgs.Length == 2);
    Assert.True(innerArgs[0].Name == "Int32");
    Assert.True(innerArgs[1].Name == "String");

    // ── Multi-level nesting: typeof(Box<Pair<Box<int>,string>>) ────────────
    Type deep = typeof(Box<Pair<Box<int>, string>>);
    Type[] dOuter = deep.GetGenericArguments();
    Assert.True(dOuter.Length == 1);
    Type dPair = dOuter[0];                        // Pair<Box<int>, string>
    Assert.True(dPair.Name == "Pair");
    Type[] dPairArgs = dPair.GetGenericArguments();
    Assert.True(dPairArgs.Length == 2);
    Type dBox = dPairArgs[0];                      // Box<int>
    Assert.True(dBox.Name == "Box");
    Assert.True(dBox.IsGenericType);
    Type[] dBoxArgs = dBox.GetGenericArguments();
    Assert.True(dBoxArgs.Length == 1);
    Assert.True(dBoxArgs[0].Name == "Int32");
    Assert.True(dPairArgs[1].Name == "String");   // the string leaf

    // ── Flat (non-nested) generics unregressed ─────────────────────────────
    Type bi = typeof(Box<int>);
    Type[] biArgs = bi.GetGenericArguments();
    Assert.True(biArgs.Length == 1);
    Assert.True(biArgs[0].Name == "Int32");
    Assert.True(biArgs[0].GetGenericArguments().Length == 0);   // leaf: no args

    Type pis = typeof(Pair<int, string>);
    Type[] pisArgs = pis.GetGenericArguments();
    Assert.True(pisArgs.Length == 2);
    Assert.True(pisArgs[0].Name == "Int32");
    Assert.True(pisArgs[1].Name == "String");
}
