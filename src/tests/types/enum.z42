// enum 语义（make-enum-distinct-type, 2026-09-08 起）：enum 是**独立类型**，不是整数别名。
//
// 本文件此前成文断言的正是旧的 **enum-as-int** 模型（`Assert.Equal(404, Status.NotFound)` /
// `Direction.North == 0` 直接拿枚举成员当整数用）。那个模型自相矛盾——成员是 long、类型名却是
// 一个谁也转不进去的孤立类，导致 `Direction d = Direction.North;` 在 var-decl 就编不过，即
// 「z42 无法产生任何 enum 类型的值」。新语义下：
//   · `E.Member` 的静态类型就是 `E`  ⇒ 可赋值 / 传参 / return / 作字段
//   · enum ↔ 整数**双向都要显式 cast**（对齐 C#，`0` 字面量无例外）
//   · `==`/`!=`/关系比较要求两侧同一个 enum；与整数比较须先 cast
// 验「底层值是多少」的断言因此一律写成 `(long)E.Member`——意图是读底层整数，就把它显式读出来。

namespace Test;

enum Direction {
    North,
    South,
    East,
    West,
}

enum Status {
    Ok = 0,
    NotFound = 404,
    ServerError = 500,
}

string describe(int d) {
    return d switch {
        0 => "north",
        1 => "south",
        2 => "east",
        3 => "west",
        _ => "unknown",
    };
}

void main() {
    // 底层值（自动编号，0 基）——读底层整数须显式 (long)
    Assert.Equal(0L, (long)Direction.North);
    Assert.Equal(1L, (long)Direction.South);
    Assert.Equal(2L, (long)Direction.East);
    Assert.Equal(3L, (long)Direction.West);

    // 显式赋值的底层值
    Assert.Equal(0L,   (long)Status.Ok);
    Assert.Equal(404L, (long)Status.NotFound);
    Assert.Equal(500L, (long)Status.ServerError);

    // enum 成员现在能产生 enum 类型的值（旧模型下这行 var-decl 就编不过）
    Direction dir = Direction.East;
    Assert.Equal("east", describe((int)dir));

    // enum 之间比较：同类型直接比，无须 cast
    Assert.Equal(false, Direction.South == Direction.North);
    Assert.Equal(true,  Direction.North == Direction.North);
    Assert.Equal(true,  Direction.North != Direction.South);

    // 与整数比较须显式 cast（`Direction.North == 0` 现在是编译错误）
    Assert.Equal(true, (long)Direction.North == 0L);
    Assert.Equal(true, (long)Status.NotFound == 404L);

    // 关系比较（C# 允许 enum 比大小；底层按 i64 比）
    Assert.Equal(true, Direction.North < Direction.West);
    Assert.Equal(true, Status.ServerError >= Status.NotFound);

    // 双向 cast 往返
    Direction back = (Direction)2;
    Assert.Equal(true, back == Direction.East);

    // ── 装箱：盒带 enum 自己的类型描述（1.5）────────────────────────────────
    // 改前 enum 值擦除到 object 会退化成 `Int32`——与同一个值 `typeof` / `GetType()`
    // 都答 `Direction` 自相矛盾。装箱后运行期表示仍是 i64（`Type.z42` 的 i64 承诺不变），
    // 变的只是盒上挂的 TypeDesc。
    object boxed = dir;
    Assert.Equal("Direction", boxed.GetType().Name);
    Assert.Equal(true, boxed is Direction);
    Assert.Equal(2L, (long)((Direction)boxed));      // 拆箱往返
    Assert.Equal("Direction", dir.GetType().Name);   // 未装箱的静态折叠，与上面同答案

    // 数组元素 store 也是擦除点（此前**整条 assign 路径没有装箱点**，对 long 一样错）
    object[] slot = new object[2];
    slot[0] = dir;
    slot[1] = 7L;
    Assert.Equal("Direction", slot[0].GetType().Name);
    Assert.Equal("Int64", slot[1].GetType().Name);   // 改前得 "Int32"

    // ── 字符串化：四条路必须同答案（C# `Enum.ToString`）─────────────────────
    Assert.Equal("East", dir.ToString());        // 直接调用
    Assert.Equal("East", boxed.ToString());      // 经 object
    Assert.Equal("East", "" + dir);              // 字符串拼接
    Assert.Equal("East", $"{dir}");              // 插值
    // 未定义值（越界 cast）→ 数字，同 C#
    Assert.Equal("9", ((Direction)9).ToString());
}
