// Test: boxing a null-valued nullable value type yields a null reference
//
// 回归防线 —— fix-box-null-nullable（2026-09-18）之前，下面任何一次装箱都会抛
// `Std.Exception: __box_prim: expected integer value, got Null`（一条内部实现名）。
//
// 背景：z42 的 `?` 是纯标注、类型解析期**擦除**（`int x = null;` 本身就能编能跑），
// 所以「int 槽里装着 Null」是语言允许的状态，而编译器仍会在 prim→object 转换点
// 无条件发 `__box_prim`。行为对齐 C#：`int? n = null; object o = n;` 得 `o == null`。

void Main() {
    // ── 装箱到 object ────────────────────────────────────────────────────
    int? n = null;
    object o = n;
    Assert.Equal(true, o == null);

    // 有值的照常装箱，不受影响
    int? m = 7;
    object p = m;
    Assert.Equal(false, p == null);
    Assert.Equal(7, (int)p);

    // ── 其它整数宽度同理（都走同一个 __box_prim）────────────────────────
    long? l = null;
    object lo = l;
    Assert.Equal(true, lo == null);

    byte? b = null;
    object bo = b;
    Assert.Equal(true, bo == null);

    // ── 擦除的直接形态：未标 `?` 也能装 null ─────────────────────────────
    int raw = null;
    object ro = raw;
    Assert.Equal(true, ro == null);

    // ── 插值路径此前就是对的，不能被改坏 ────────────────────────────────
    Assert.Equal("null", $"{n}");
    Assert.Equal("7", $"{m}");

    // ── ?? 仍按运行期的实际值工作 ────────────────────────────────────────
    Assert.Equal(-1, n ?? -1);
    Assert.Equal(7, m ?? -1);
}
