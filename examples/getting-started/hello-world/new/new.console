# ANCHOR: new
$ z42 new hello
Created executable project `hello` in hello/

  cd hello
  z42 run
# ANCHOR_END: new
# ANCHOR: files
$ cd hello
$ ls
README.md
src/
z42.toml
$ cat z42.toml
[project]
name = "hello"
version = "0.1.0"
kind = "exe"

[sources]
include = ["src/**/*.z42"]
$ cat src/Main.z42
namespace Hello;

using Std.IO;

void Main() {
    Console.WriteLine("Hello, World!");
}
# ANCHOR_END: files
# ANCHOR: run
$ z42 run
Hello, World!
# ANCHOR_END: run
