using Std.IO;

// ANCHOR: decl
int Layout(int columns) {
    int gutter = 8;

    // 局部函数：只在 Layout 里可见，能直接用外层的 gutter
    int Width(int span) => span * 100 + (span - 1) * gutter;

    return Width(columns);
}
// ANCHOR_END: decl

// ANCHOR: recur
// 递归：函数调用自己，必须有一个不再递归的出口
int Fib(int n) {
    if (n < 2) {
        return n;          // 出口
    }
    return Fib(n - 1) + Fib(n - 2);
}
// ANCHOR_END: recur

void Main() {
    Console.WriteLine(Layout(3));
    Console.WriteLine(Fib(10));
}
