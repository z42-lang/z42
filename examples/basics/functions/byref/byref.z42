using Std.IO;

// ANCHOR: decl
// ref：调用方的变量本身被传进来，方法的写入传得回去
void Increment(ref int x) {
    x = x + 1;
}

// 「可能没有」的值类型结果：bool 说成没成，ref 出参带值
bool TryLength(string s, ref int length) {
    length = s.Length;
    return length > 0;
}
// ANCHOR_END: decl

void Main() {
    // ANCHOR: call
    int count = 0;
    Increment(ref count);        // 调用点也要写 ref
    Increment(ref count);
    Console.WriteLine(count);

    if (TryLength("hey", ref var n)) {   // ref var 就地声明一个新变量
        Console.WriteLine(n);
    }

    int noInit;                  // 没写初始化器也行——被 ref 取址的槽位自动取零值
    Increment(ref noInit);
    Console.WriteLine(noInit);
    // ANCHOR_END: call
}
