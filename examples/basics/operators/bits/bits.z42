using Std.IO;

void Main() {
    // ANCHOR: code
    int flags = 6;    // 二进制 0110

    Console.WriteLine(flags & 3);    // 与：两位都是 1 才是 1
    Console.WriteLine(flags | 3);    // 或：有一位是 1 就是 1
    Console.WriteLine(flags ^ 3);    // 异或：两位不同才是 1
    Console.WriteLine(~flags);       // 取反
    Console.WriteLine(1 << 3);       // 左移 3 位 = 乘以 8
    Console.WriteLine(-8 >> 1);      // 右移保留符号位
    // ANCHOR_END: code
}
