using Std.IO;

interface IBase { void A(); }
interface IDerived : IBase { void B(); }

class Impl : IDerived {
    public void A() { Console.WriteLine("A"); }
    public void B() { Console.WriteLine("B"); }
}

void Main() {
    IDerived d = new Impl();
    d.B();                  // IDerived 自己声明的
    d.A();                  // 继承自 IBase —— 一样能调

    IBase b = new Impl();   // 类 → 它的任一祖先接口，可以
    b.A();
}
