using Std.IO;

interface IBase { void A(); }
interface IDerived : IBase { void B(); }   // 语法能过，但继承不生效

class Impl : IDerived {
    public void A() { Console.WriteLine("A"); }
    public void B() { Console.WriteLine("B"); }
}

void Main() {
    IDerived d = new Impl();
    d.B();
    d.A();        // ✗ 继承来的成员看不见
}
