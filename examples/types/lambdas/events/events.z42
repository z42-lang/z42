using Std.IO;

// ANCHOR: decl
class Button {
    // 多播事件：可以挂任意多个处理器，显式创建多播对象
    public MulticastAction<int> Clicked = new MulticastAction<int>();

    // 单播事件：至多一个处理器，默认是 null
    public Action<string> KeyDown;

    public void Click(int x)     { this.Clicked.Invoke(x); }
    public void Key(string k)    { var h = this.KeyDown; if (h != null) { h.Invoke(k); } }
}
// ANCHOR_END: decl

void Main() {
    // ANCHOR: multi
    Button b = new Button();
    b.Clicked += x => Console.WriteLine("  处理器一：" + x);
    b.Clicked += x => Console.WriteLine("  处理器二：" + (x * 2));
    Console.WriteLine("挂了 " + b.Clicked.Count() + " 个处理器");
    b.Click(5);
    // ANCHOR_END: multi

    // ANCHOR: uni
    b.Key("Esc");                                  // 还没挂，什么都不发生
    b.KeyDown = (string k) => Console.WriteLine("  按下了 " + k);
    b.Key("Enter");
    b.KeyDown = null;
    b.Key("Esc");
    // ANCHOR_END: uni
}
