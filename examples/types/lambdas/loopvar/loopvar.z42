using Std.IO;
using Std.Collections;

void Main() {
    // ANCHOR: loop
    List<() -> int> fns = new List<() -> int>();
    foreach (int i in new int[] { 1, 2, 3 }) {
        fns.Add(() => i);          // 每轮捕获的是那一轮的 i
    }
    foreach (() -> int f in fns) {
        Console.WriteLine(f());    // 1 2 3 —— 不是 3 3 3
    }
    // ANCHOR_END: loop
}
