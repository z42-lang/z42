namespace Demo.App;

using Std.IO;
using Demo.Geometry;   // 同一个包里的另一个 namespace，也要 using

void Main() {
    Point p = new Point(3, 4);
    Console.WriteLine("(" + p.X + ", " + p.Y + ")");

    try { Boom(); }
    catch (Exception e) { Console.WriteLine(e.StackTrace); }
}

void Boom() { throw new Exception("看限定名"); }
