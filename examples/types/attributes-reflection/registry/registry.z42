using Std.IO;
using Std.Reflection;

// ANCHOR: attr
class CommandAttribute : Attribute {
    public string Name;
    public string Help;
    public CommandAttribute(string name, string help = "（无说明）") {
        this.Name = name;
        this.Help = help;
    }
}
// ANCHOR_END: attr

// ANCHOR: commands
class Tools {
    [Command("greet", help: "跟某人打招呼")]
    public static void Greet(string who) { Console.WriteLine("你好，" + who + "！"); }

    [Command("shout", help: "大声重复一遍")]
    public static void Shout(string what) { Console.WriteLine(what.ToUpper() + "!!!"); }

    // 没贴 [Command]，就不进命令表
    public static void Internal(string x) { Console.WriteLine("内部用"); }
}
// ANCHOR_END: commands

// ANCHOR: driver
// 列出所有命令：读的是 attribute 里的数据，不是方法名
void listCommands() {
    foreach (MethodInfo m in typeof(Tools).GetMethods()) {
        object a = m.GetAttribute(typeof(CommandAttribute));
        if (a == null) { continue; }
        CommandAttribute cmd = (CommandAttribute) a;
        Console.WriteLine("  " + cmd.Name + " —— " + cmd.Help);
    }
}

// 按名字派发：找到贴着对应 [Command] 的方法，反射调用它
bool run(string name, string arg) {
    foreach (MethodInfo m in typeof(Tools).GetMethods()) {
        object a = m.GetAttribute(typeof(CommandAttribute));
        if (a == null) { continue; }
        if (((CommandAttribute) a).Name != name) { continue; }
        object[] args = new object[1];
        args[0] = arg;
        m.Invoke(null, args);
        return true;
    }
    return false;
}
// ANCHOR_END: driver

void Main() {
    // ANCHOR: use
    Console.WriteLine("可用命令：");
    listCommands();

    run("greet", "小明");
    run("shout", "hello");
    Console.WriteLine(run("nope", "x") ? "跑了" : "没有 nope 这个命令");
    // ANCHOR_END: use
}
