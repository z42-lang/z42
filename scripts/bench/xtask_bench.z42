// xtask — e2e benchmarks + A/B regression gates. Compiles src/benches/scenarios/*.z42, runs hyperfine on z42vm
// per scenario, then merges the hyperfine JSONs into artifacts/reports/benches/e2e.json. Gate semantics
// (same-runner A/B, resample-on-suspicion, thresholds) live in docs/internals/src/devinfra/benchmarking.md.
namespace Z42Xtask;

using Std.IO;
using Std.Json;

// ── 场景分层 ──────────────────────────────────────────────────────────────────────────────
// 每个场景在头部注释里声明 `// tier: gate` 或 `// tier: full`：
//   gate —— PR 门禁测量的那一小组代表性场景（`bench --tier gate`）。
//   full —— 其余场景，本地 / 按需跑（`bench` 默认 --tier all）。
// 分层不只是省时间：它把每个 PR 的比较次数压小，直接减掉不做多重比较校正带来的期望假红（见 book 判红语义页）。
// 未声明 tier 的场景按 `full` 记 —— 新场景必须**显式选择加入**门禁，且跳过时
// 一定打印（与 requires-caps 的跳过同款），不做静默排除。
string _benchScenarioTier(string src) {
    string[] lines = src.Split("\n");
    for (int i = 0; i < lines.Length; i = i + 1) {
        string ln = lines[i].Trim();
        if (ln.StartsWith("// tier:")) {
            // 只取第一个词 —— 声明行后面允许接理由（`// tier: gate — 为什么在门禁里`）。
            string rest = ln.Substring(8).Trim();
            int sp = rest.IndexOf(" ");
            string t = sp >= 0 ? rest.Substring(0, sp) : rest;
            if (t == "gate") { return "gate"; }
            return "full";
        }
    }
    return "full";
}

// 场景 tier 是否命中 `--tier` 选择器（空 / "all" = 全要）。
bool _benchTierWanted(string want, string have) {
    if (want.Length == 0 || want == "all") { return true; }
    return want == have;
}

// ── 被测工具链 + 场景选择（`_bench` 与 `_benchAb` 共用；两条路径只差测量体）──────────────────
// 只有一份前奏（工具链 / 探针 / mode 展开）+ 枚举 + tier / requires-caps / mode 跳过：谁进门禁、谁被跳过、
// 为什么，两条路径同口径。

// 被测（PR 侧）工具链 + 探针结果 + 要扫的 mode。Rc != 0 ⇒ 工具链缺件 / 场景配置错误（已打印，调用方原样返回）。
class BenchEnv {
    public int Rc;
    public string Root;
    public string ScenDir;      // src/benches/scenarios
    public string ResultsDir;   // artifacts/reports/benches
    public string Vm;           // release z42vm
    public string Libs;         // 纯 stdlib flat：场景只用 stdlib，z42c.driver 的 dist 自包含 ⇒ 编译与运行的 Z42_LIBS 都是它
    public string Driver;       // z42c.driver.zpkg（场景经 z42c 编译）
    public VmCaps Caps;
    public string[] Modes;
    public BenchEnv() {
        this.Rc = 0; this.Root = ""; this.ScenDir = ""; this.ResultsDir = "";
        this.Vm = ""; this.Libs = ""; this.Driver = ""; this.Caps = null; this.Modes = new string[0];
    }
}

// _ensureToolchainDeps builds z42vm / stdlib / z42c.driver only if missing — CI bench bootstraps xtask alone
// (against nightly .z42/libs), so the source-built tree may start empty; a dev who changed z42c runs
// `build compiler` themselves. Probe the measured VM once and expand --mode.
BenchEnv _benchEnv(string modeOpt) {
    BenchEnv e = new BenchEnv();
    e.Root = _root();
    e.ScenDir = Path.Join(e.Root, "src/benches/scenarios");
    e.ResultsDir = _benchDir(e.Root);
    Directory.Create(e.ResultsDir);
    e.Rc = _ensureToolchainDeps(e.Root);
    if (e.Rc != 0) { return e; }
    e.Vm = _builtVm(e.Root, "release");
    e.Libs = _libsDir(e.Root);
    e.Driver = _driverZpkg(e.Root, "release");
    e.Caps = _epProbe(e.Vm, e.Libs, _epEnsureProbe(e.Root, e.Vm, e.Driver, e.Libs));
    e.Modes = _epModesToSweep(modeOpt);
    return e;
}

// 一个选中的场景。
class BenchScenario {
    public string Name;        // 文件基名（结果条目名）
    public string Ns;          // namespace → 入口 `<Ns>.Main`
    public string Src;         // 源文件绝对路径
    public bool ReportsPause;  // 头部声明 `// gc-pause: report`
    public BenchScenario() { this.Name = ""; this.Ns = ""; this.Src = ""; this.ReportsPause = false; }
}

// 场景选择：排序枚举（文件系统序跨 OS 不确定，--quick 的「前 2 个」与结果序都依赖它），按 --tier 与
// `// requires-caps:` 过滤；跳过一律打印理由，不做静默排除。--quick = 枚举序上的前 2 个 .z42（含被跳过的）。
// 场景缺 namespace 是配置错误：打印并置 e.Rc = 2。
BenchScenario[] _benchSelectScenarios(BenchEnv e, string tier, bool quick) {
    string[] files = _sortedStrings(Directory.Enumerate(e.ScenDir));
    BenchScenario[] picked = new BenchScenario[files.Length];
    int n = 0;
    int count = 0;
    for (int fi = 0; fi < files.Length; fi = fi + 1) {
        string f = files[fi];
        if (!f.EndsWith(".z42")) { continue; }
        if (quick && count >= 2) { break; }
        count = count + 1;
        string name = f.Substring(0, f.Length - 4);
        string src = Path.Join(e.ScenDir, f);
        string srcText = File.ReadAllText(src);
        string ns = _extractNamespace(srcText);
        if (ns.Length == 0) { ConsoleError.WriteLine("error: no namespace in " + f); e.Rc = 2; break; }
        string stier = _benchScenarioTier(srcText);
        if (!_benchTierWanted(tier, stier)) {
            Console.WriteLine("  ⊘ skip " + name + ": tier=" + stier + " (--tier " + tier + ")");
            continue;
        }
        string[] missing = _epCapsMissing(_epScenarioRequiredCaps(srcText), e.Caps.Caps);
        if (missing.Length > 0) {
            Console.WriteLine("  ⊘ skip " + name + ": missing cap(s) " + _epJsonStrArr(missing)
                + " (VM caps=" + _epJsonStrArr(e.Caps.Caps) + ")");
            continue;
        }
        BenchScenario s = new BenchScenario();
        s.Name = name; s.Ns = ns; s.Src = src; s.ReportsPause = _benchScenarioReportsPause(srcText);
        picked[n] = s; n = n + 1;
    }
    BenchScenario[] tight = new BenchScenario[n];
    int k = 0;
    while (k < n) { tight[k] = picked[k]; k = k + 1; }
    return tight;
}

// mode 这一格在被测 VM 上可跑？不可跑（如 interp-only VM 上的 jit）打印理由——never silently dropped。
bool _benchModeRunnable(BenchEnv e, string name, string m) {
    string status = _epCellStatus(_epTiersForMode(m), new string[0], e.Caps.ExecModes);
    if (status == "runnable") { return true; }
    Console.WriteLine("  ⊘ skip " + name + " [" + m + "]: " + status
        + " (VM exec_modes=" + _epJsonStrArr(e.Caps.ExecModes) + ")");
    return false;
}

// `bench` (no subcommand) — e2e hyperfine scenario runner; BenchCommand routes
// --diff / --ab / --micro-diff to their handlers, this is the bare-e2e path.
int _bench(BenchCommand cmd) {
    bool quick = cmd.Quick;
    string warmup = quick ? "1" : "3";
    string runs = quick ? "3" : "10";
    string tier = cmd.Tier;
    BenchEnv e = _benchEnv(cmd.Mode);
    if (e.Rc != 0) { return e.Rc; }
    BenchScenario[] scen = _benchSelectScenarios(e, tier, quick);
    if (e.Rc != 0) { return e.Rc; }
    string work = Directory.CreateTempDir("xtask-bench");

    string benchmarks = "";
    int nb = 0;
    for (int si = 0; si < scen.Length; si = si + 1) {
        BenchScenario s = scen[si];
        // Compile once — the .zbc is mode-agnostic; only the measured run differs.
        string zbc = Path.Join(work, s.Name + ".zbc");
        int cc = _exec(_z42cProc(e.Vm, e.Libs, e.Driver)
            .Arg("--emit-zbc").Arg(s.Src).Arg(zbc));
        if (cc != 0) { return cc; }
        for (int mi = 0; mi < e.Modes.Length; mi = mi + 1) {
            string m = e.Modes[mi];
            if (!_benchModeRunnable(e, s.Name, m)) { continue; }
            string[] tiers = _epTiersForMode(m);
            string outJson = Path.Join(work, s.Name + "-" + m + "-bench.json");
            Console.WriteLine("→ Benchmarking " + s.Name + " [" + m
                + "] (warmup=" + warmup + ", runs=" + runs + ")...");
            int hc = _exec(_z42Proc("hyperfine", e.Libs)
                .Arg("--warmup").Arg(warmup).Arg("--runs").Arg(runs)
                .Arg("--export-json").Arg(outJson).Arg("--shell=none")
                .Arg("--command-name").Arg(s.Name + "-" + m)
                .Arg(e.Vm + " " + zbc + " " + s.Ns + ".Main --mode " + m));
            if (hc != 0) { return hc; }
            if (nb > 0) { benchmarks = benchmarks + ",\n"; }
            benchmarks = benchmarks + _benchObj(outJson, s.Name, runs, tiers, e.Caps);
            nb = nb + 1;
            // `// gc-pause: report` scenarios also yield pause metrics.
            if (s.ReportsPause) {
                PauseMedian pm = _benchPauseRun(e.Vm, zbc, s.Ns + ".Main", m, e.Libs, quick ? 1 : 3);
                if (pm.Rc != 0) { return 2; }
                benchmarks = benchmarks + ",\n" + _benchPauseObj(s.Name, "max", pm.MaxMs, pm.Samples, tiers, e.Caps)
                    + ",\n" + _benchPauseObj(s.Name, "p99", pm.P99Ms, pm.Samples, tiers, e.Caps);
                nb = nb + 2;
            }
        }
    }

    string commit = _gitOut(e.Root, "rev-parse", "--short", "HEAD");
    string branch = _gitOut(e.Root, "rev-parse", "--abbrev-ref", "HEAD");
    string doc = "{\n  \"schema_version\": 2,\n  \"commit\": \"" + commit
        + "\",\n  \"branch\": \"" + branch + "\",\n  \"z42vm_version\": \"" + _epVmVersion(e.Vm)
        + "\",\n  \"timestamp\": \"" + _utcNow() + "\",\n  \"benchmarks\": [\n"
        + benchmarks + "\n  ]\n}\n";
    string outFile = Path.Join(e.ResultsDir, "e2e.json");
    File.WriteAllText(outFile, doc);
    Console.WriteLine("✅ E2E bench complete (" + nb.ToString() + " results). Results: " + outFile);
    return 0;
}

// ── 同-runner A/B 对照门禁 ──────────────────────────────────────────────────────────────
// The regression verdict of one scenario's A/B comparison (base vs pr, both
// compiled + measured on the SAME runner, seconds apart). See `_abVerdict`.
class AbVerdict {
    public double Ratio;      // pr_mean / base_mean  (>1 = pr slower)
    public double RLower;     // 95% lower bound of the true ratio (SEM-propagated)
    public double RUpper;     // 95% upper bound
    public string Verdict;    // "regression" | "faster" | "overlap" | "no-data"
    public bool IsRegression;
    public bool HasCi;        // false = stddev/n missing → bare-ratio fallback (no-ci)
    public int Rounds;        // measurement rounds behind the interval: 1 = single-round
                              // SEM; k>1 = resampled, interval from the BETWEEN-ROUND
                              // ratio dispersion (see _abResampleVerdict).
    public AbVerdict() {
        this.Ratio = 1.0; this.RLower = 1.0; this.RUpper = 1.0;
        this.Verdict = "overlap"; this.IsRegression = false; this.HasCi = true;
        this.Rounds = 1;
    }
}

// Pure regression verdict from two same-runner measurements. Because base & pr
// are measured on the SAME machine seconds apart, the machine speed factor k
// cancels in ratio = pr/base, so the within-run SEM is usable here (unlike a
// cross-runner baseline diff). thr = fractional regression threshold (0.10 = 10%);
// Z = 1.96 (95%). Missing stddev/n (n≤1 or stddev≤0) → bare-ratio (no-ci).
//   relSE = sqrt((SEM_p/mean_p)^2 + (SEM_b/mean_b)^2)      // quotient error prop
//   R_lower = ratio*(1 - Z*relSE);  regression ⟺ R_lower > 1 + thr
AbVerdict _abVerdict(double baseMean, double baseStddev, double baseN,
                     double prMean, double prStddev, double prN, double thr) {
    AbVerdict v = new AbVerdict();
    if (baseMean <= 0.0 || prMean <= 0.0) { v.Verdict = "no-data"; return v; }
    v.Ratio = prMean / baseMean;
    bool haveCi = baseStddev > 0.0 && prStddev > 0.0 && baseN > 1.0 && prN > 1.0;
    if (!haveCi) {
        v.HasCi = false;
        v.RLower = v.Ratio; v.RUpper = v.Ratio;
        _abClassify(v, thr);
        return v;
    }
    double semB = baseStddev / Math.Sqrt(baseN);
    double semP = prStddev / Math.Sqrt(prN);
    double relB = semB / baseMean;
    double relP = semP / prMean;
    double relSE = Math.Sqrt(relP * relP + relB * relB);
    double z = 1.96;
    v.RLower = v.Ratio * (1.0 - z * relSE);
    v.RUpper = v.Ratio * (1.0 + z * relSE);
    _abClassify(v, thr);
    return v;
}

// Fill Verdict/IsRegression from R_lower/R_upper vs the threshold band.
void _abClassify(AbVerdict v, double thr) {
    if (v.RLower > 1.0 + thr) { v.Verdict = "regression"; v.IsRegression = true; }
    else if (v.RUpper < 1.0 - thr) { v.Verdict = "faster"; }
    else { v.Verdict = "overlap"; }
}

// ── 可疑即复测（benchmarking.md §5「可疑即复测」）──────────────────────────────────────
// Final verdict for an entry that round 1 flagged as a regression, recomputed from k INDEPENDENT same-runner
// ratios (one per round). `_abVerdict`'s interval comes from the WITHIN-run variance of one hyperfine
// invocation and does not model between-process variance (CPU frequency, page cache, allocator/GC start state,
// code layout), so it is ~3x too narrow; the dispersion OF THE RATIOS across re-measurements of the SAME two
// binaries is the estimate that sees it.
//
//   R_lower = mean(ratios) − t(1-sided 95%, df=k-1) · sd(ratios)/sqrt(k)
//   regression ⟺ R_lower > 1 + thr        (same rule as every other path)
//
// ONE-SIDED on purpose, unlike `_abVerdict`'s two-sided Z=1.96: the gate asks a one-sided question, and at k=3
// the two-sided quantile (4.303) would blunt the margin enough to wave a real +20% regression through.
//
// COVERED BY `bench --ab-selftest` (pure function, see _abSelfTest).
AbVerdict _abResampleVerdict(double[] ratios, double thr) {
    AbVerdict v = new AbVerdict();
    int k = ratios.Length;
    v.Rounds = k;
    // k<2 has no between-round dispersion to speak of — the caller must not get a
    // verdict that looks resampled when it is not.
    if (k < 2) { v.Verdict = "no-data"; v.HasCi = false; return v; }
    double sum = 0.0;
    for (int i = 0; i < k; i = i + 1) {
        if (ratios[i] <= 0.0) { v.Verdict = "no-data"; v.HasCi = false; return v; }
        sum = sum + ratios[i];
    }
    double mean = sum / (double)k;
    double ss = 0.0;
    for (int i = 0; i < k; i = i + 1) { double d = ratios[i] - mean; ss = ss + d * d; }
    double sd = Math.Sqrt(ss / (double)(k - 1));
    double se = sd / Math.Sqrt((double)k);
    double t = _abTCrit95(k - 1);
    v.Ratio = mean;
    v.RLower = mean - t * se;
    v.RUpper = mean + t * se;
    _abClassify(v, thr);
    return v;
}

// One-sided 95% Student-t critical value, by degrees of freedom. Small df is the
// whole point here (k=3 ⇒ df=2 ⇒ 2.920), so the table is exact where it matters
// and falls back to the normal quantile once df is large enough not to.
double _abTCrit95(int df) {
    if (df <= 1) { return 6.314; }
    if (df == 2) { return 2.920; }
    if (df == 3) { return 2.353; }
    if (df == 4) { return 2.132; }
    if (df == 5) { return 2.015; }
    if (df == 6) { return 1.943; }
    if (df == 7) { return 1.895; }
    if (df == 8) { return 1.860; }
    if (df == 9) { return 1.833; }
    return 1.645;
}

// Result of running one scenario×mode A/B comparison.
class AbOutcome {
    public int Rc;            // 0 = ok, 2 = tool error (compile/hyperfine failed)
    public bool IsRegression;
    public bool Resampled;    // consumed one unit of the caller's resample budget
    public string Json;       // one ab.json result fragment ("" on error)
    public AbOutcome() { this.Rc = 0; this.IsRegression = false; this.Resampled = false; this.Json = ""; }
}

// Compile `src` to a .zbc with the given toolchain (vm+driver, Z42_LIBS=libs).
int _abEmitZbc(string vm, string driver, string libs, string src, string zbc) {
    return _exec(_z42cProc(vm, libs, driver)
        .Arg("--emit-zbc").Arg(src).Arg(zbc));
}

// One measurement round of one scenario×mode: hyperfine BOTH commands in a single
// invocation (same runner, adjacent → between-run drift cancels within the round).
// The `env Z42_LIBS=… <vm> …` prefix lets one hyperfine invocation run each side
// under its own libs (--shell=none execs `env`, a real binary; CI/dev are unix).
class AbRound {
    public int Rc;            // 0 = ok, 2 = tool error (hyperfine failed / unusable means)
    public double BaseMean; public double BaseSd;   // seconds
    public double PrMean;   public double PrSd;
    public AbRound() {
        this.Rc = 0; this.BaseMean = 0.0; this.BaseSd = 0.0; this.PrMean = 0.0; this.PrSd = 0.0;
    }
    public double Ratio() { return this.PrMean / this.BaseMean; }
}

AbRound _abOneRound(string work, string name, string m, int round,
    string baseCmd, string prCmd, string warmup, string runs) {
    AbRound o = new AbRound();
    string outJson = Path.Join(work, name + "-" + m + "-ab-r" + round.ToString() + ".json");
    Console.WriteLine("→ A/B " + name + " [" + m + "] round " + round.ToString()
        + " (warmup=" + warmup + ", runs=" + runs + ")...");
    int hc = _exec(new Process("hyperfine")
        .Arg("--warmup").Arg(warmup).Arg("--runs").Arg(runs)
        .Arg("--export-json").Arg(outJson).Arg("--shell=none")
        .Arg("--command-name").Arg(name + "-base").Arg(baseCmd)
        .Arg("--command-name").Arg(name + "-pr").Arg(prCmd));
    if (hc != 0) { o.Rc = 2; return o; }
    JsonValue res = JsonValue.Parse(File.ReadAllText(outJson)).Get("results");
    JsonValue b = res.At(0);
    JsonValue p = res.At(1);
    o.BaseMean = b.Get("mean").AsDouble();   o.BaseSd = b.Get("stddev").AsDouble();
    o.PrMean   = p.Get("mean").AsDouble();   o.PrSd   = p.Get("stddev").AsDouble();
    if (o.BaseMean <= 0.0 || o.PrMean <= 0.0) { o.Rc = 2; }
    return o;
}

// One scenario×mode A/B: compile base.zbc + pr.zbc, measure round 1, and — when
// round 1 says "regression" and the caller still has resample budget — re-measure
// the SAME two binaries `extraRounds` more times and re-decide from the
// between-round ratio dispersion (see _abResampleVerdict for why the single-round
// interval cannot be trusted on its own).
//
// Only a round-1 REGRESSION is resampled. `faster` and `overlap` are not: the gate
// is one-sided, so refining a verdict that cannot fail the job buys nothing, and
// the cost argument rests on suspicion being rare.
AbOutcome _abOneScenario(string work, string name, string ns, string m, string src,
    string baseVm, string baseDriver, string baseLibs,
    string prVm, string prDriver, string prLibs,
    string warmup, string runs, double thr, int extraRounds) {
    AbOutcome o = new AbOutcome();
    string baseZbc = Path.Join(work, name + "-base.zbc");
    string prZbc   = Path.Join(work, name + "-pr.zbc");
    if (_abEmitZbc(baseVm, baseDriver, baseLibs, src, baseZbc) != 0) { o.Rc = 2; return o; }
    if (_abEmitZbc(prVm,   prDriver,   prLibs,   src, prZbc)   != 0) { o.Rc = 2; return o; }
    string baseCmd = "env Z42_LIBS=" + baseLibs + " " + baseVm + " " + baseZbc + " " + ns + ".Main --mode " + m;
    string prCmd   = "env Z42_LIBS=" + prLibs   + " " + prVm   + " " + prZbc   + " " + ns + ".Main --mode " + m;
    AbRound r1 = _abOneRound(work, name, m, 1, baseCmd, prCmd, warmup, runs);
    if (r1.Rc != 0) { o.Rc = 2; return o; }
    double nRuns = Double.Parse(runs);
    AbVerdict v = _abVerdict(r1.BaseMean, r1.BaseSd, nRuns, r1.PrMean, r1.PrSd, nRuns, thr);
    string ratios = r1.Ratio().ToString();
    if (v.IsRegression && extraRounds > 0) {
        Console.WriteLine("  ? " + name + " [" + m + "] round-1 regression (ratio="
            + r1.Ratio().ToString() + ") → resampling " + extraRounds.ToString()
            + " more round(s); the verdict comes from the between-round dispersion");
        double[] rs = new double[extraRounds + 1];
        rs[0] = r1.Ratio();
        for (int i = 0; i < extraRounds; i = i + 1) {
            AbRound rn = _abOneRound(work, name, m, i + 2, baseCmd, prCmd, warmup, runs);
            if (rn.Rc != 0) { o.Rc = 2; return o; }
            rs[i + 1] = rn.Ratio();
            ratios = ratios + "," + rs[i + 1].ToString();
        }
        o.Resampled = true;
        v = _abResampleVerdict(rs, thr);
    }
    o.IsRegression = v.IsRegression;
    o.Json = _abResultJson(name, m, r1, v, ratios);
    _abPrint(name, m, v);
    return o;
}

// one ab.json result object. Means/stddevs are ROUND 1's (hyperfine seconds → ms);
// `round_ratios` carries every round's ratio so a resampled verdict can be re-derived
// from the artifact without re-running the job.
string _abResultJson(string name, string m, AbRound r1, AbVerdict v, string ratios) {
    return "    {\n      \"name\": \"" + name + "\",\n      \"mode\": \"" + m + "\""
        + ",\n      \"base_mean_ms\": " + (r1.BaseMean * 1000.0).ToString()
        + ",\n      \"base_stddev_ms\": " + (r1.BaseSd * 1000.0).ToString()
        + ",\n      \"pr_mean_ms\": " + (r1.PrMean * 1000.0).ToString()
        + ",\n      \"pr_stddev_ms\": " + (r1.PrSd * 1000.0).ToString()
        + ",\n      \"rounds\": " + v.Rounds.ToString()
        + ",\n      \"round_ratios\": [" + ratios + "]"
        + ",\n      \"ratio\": " + v.Ratio.ToString() + ",\n      \"r_lower\": " + v.RLower.ToString()
        + ",\n      \"r_upper\": " + v.RUpper.ToString() + ",\n      \"verdict\": \"" + v.Verdict + "\"\n    }";
}

// human-readable one-line A/B verdict.
void _abPrint(string name, string m, AbVerdict v) {
    string sym = "≈";
    if (v.Verdict == "regression") { sym = "↑"; }
    else if (v.Verdict == "faster") { sym = "↓"; }
    string tag = v.HasCi ? "" : " (no-ci)";
    // k>1 ⇒ the interval came from between-round dispersion, not the within-run SEM.
    // Say so on the line: the two are not the same evidence and read identically otherwise.
    if (v.Rounds > 1) { tag = tag + " (resampled k=" + v.Rounds.ToString() + ")"; }
    Console.WriteLine("  " + name + " [" + m + "]  " + sym + " " + v.Verdict + tag
        + "  ratio=" + v.Ratio.ToString() + "  R_lower=" + v.RLower.ToString()
        + "  R_upper=" + v.RUpper.ToString());
}

// `bench --ab --base-vm V --base-libs L --base-driver D [--mode M] [--threshold-time T] [--quick]`
// Same-runner A/B regression gate. For each scenario×mode: compile with the base
// toolchain and the PR toolchain, hyperfine both on this runner, and verdict via
// `_abVerdict`. Writes artifacts/reports/benches/ab.json. Exit: 0 = no regression, 1 =
// regression(s), 2 = tool error / bad args. bench-baselines/bench-update untouched.
int _benchAb(BenchCommand cmd) {
    string baseVm = cmd.BaseVm;
    string baseLibs = cmd.BaseLibs;
    string baseDriver = cmd.BaseDriver;
    if (baseVm.Length == 0 || baseLibs.Length == 0 || baseDriver.Length == 0) {
        ConsoleError.WriteLine("error: bench --ab requires --base-vm, --base-libs and --base-driver");
        return 2;
    }
    bool quick = cmd.Quick;
    string warmup = quick ? "1" : "3";
    string runs = quick ? "3" : "10";
    double thr = 0.10;
    string tt = cmd.ThresholdTime;
    if (tt.Length > 0) { thr = Double.Parse(tt); }
    // Resample: extra rounds for an entry round 1 flagged (0 = off, the rollback knob). Default 2 ⇒ k=3 ratios ⇒
    // df=2. Cost lands only on flagged entries, so a clean PR pays nothing at all.
    int extraRounds = cmd.ResampleRounds;
    if (extraRounds < 0) { ConsoleError.WriteLine("error: --resample-rounds must be >= 0"); return 2; }
    // Budget cap. Resampling is priced on suspicion being RARE; if a PR flags more
    // entries than this, that is itself evidence of a real, broad regression, so the
    // remaining entries keep their round-1 verdict (which fails the job) instead of
    // spending unbounded runner time to confirm what is already the likely answer.
    int resampleBudget = 3;
    // pause gate = pr_max > cap AND pr_max > base_max*(1+thr)（见 xtask_bench_pause.z42 头注）。
    double pauseCap = cmd.PauseCapMs;
    double pauseThr = cmd.ThresholdPause;
    string tier = cmd.Tier;
    // PR（被测）侧工具链 + 探针 + 场景选择与 `_bench` 同一份（门禁只测 gate 层：CI 传 --tier gate）。
    BenchEnv e = _benchEnv(cmd.Mode);
    if (e.Rc != 0) { return e.Rc; }
    BenchScenario[] scen = _benchSelectScenarios(e, tier, quick);
    if (e.Rc != 0) { return e.Rc; }
    string work = Directory.CreateTempDir("xtask-bench-ab");

    string items = "";
    int nb = 0; int regr = 0; int toolErr = 0;
    for (int si = 0; si < scen.Length; si = si + 1) {
        BenchScenario s = scen[si];
        for (int mi = 0; mi < e.Modes.Length; mi = mi + 1) {
            string m = e.Modes[mi];
            if (!_benchModeRunnable(e, s.Name, m)) { continue; }
            int mayResample = resampleBudget > 0 ? extraRounds : 0;
            AbOutcome o = _abOneScenario(work, s.Name, s.Ns, m, s.Src,
                baseVm, baseDriver, baseLibs, e.Vm, e.Driver, e.Libs, warmup, runs, thr, mayResample);
            if (o.Rc != 0) { toolErr = toolErr + 1; continue; }
            if (o.Resampled) { resampleBudget = resampleBudget - 1; }
            if (o.IsRegression && mayResample == 0 && extraRounds > 0) {
                Console.WriteLine("  ⚠️  resample budget exhausted — this verdict is the "
                    + "single-round one (see _abResampleVerdict on why that interval is optimistic)");
            }
            if (nb > 0) { items = items + ",\n"; }
            items = items + o.Json; nb = nb + 1;
            if (o.IsRegression) { regr = regr + 1; }
            if (s.ReportsPause) {
                AbOutcome po = _abPauseScenario(s.Name, m, baseVm, Path.Join(work, s.Name + "-base.zbc"), baseLibs,
                    e.Vm, Path.Join(work, s.Name + "-pr.zbc"), e.Libs, s.Ns + ".Main", pauseCap, pauseThr);
                if (po.Rc != 0) { toolErr = toolErr + 1; continue; }
                items = items + ",\n" + po.Json; nb = nb + 1;
                if (po.IsRegression) { regr = regr + 1; }
            }
        }
    }
    _abWriteJson(e.Root, e.ResultsDir, items);
    return _abFinish(nb, regr, toolErr);
}

// wrap accumulated A/B result fragments in the ab-v1 envelope → artifacts/reports/benches/ab.json.
void _abWriteJson(string root, string resultsDir, string items) {
    string commit = _gitOut(root, "rev-parse", "--short", "HEAD");
    string branch = _gitOut(root, "rev-parse", "--abbrev-ref", "HEAD");
    string doc = "{\n  \"schema\": \"ab-v1\",\n  \"commit\": \"" + commit
        + "\",\n  \"branch\": \"" + branch + "\",\n  \"timestamp\": \"" + _utcNow()
        + "\",\n  \"results\": [\n" + items + "\n  ]\n}\n";
    File.WriteAllText(Path.Join(resultsDir, "ab.json"), doc);
}

// summary line + exit code for the A/B run.
int _abFinish(int nb, int regr, int toolErr) {
    Console.WriteLine("");
    if (toolErr > 0) {
        Console.WriteLine("⚠️  " + toolErr.ToString() + " scenario(s) errored (compile/hyperfine)");
        return 2;
    }
    if (regr > 0) {
        Console.WriteLine("❌ " + regr.ToString() + " regression(s) — R_lower > 1+thr (out of "
            + nb.ToString() + " same-runner A/B comparisons)");
        return 1;
    }
    Console.WriteLine("✅ no regression (same-runner A/B; " + nb.ToString() + " comparisons)");
    return 0;
}

// `bench --ab-selftest` — unit-check the `_abVerdict` pure function (locally
// runnable; no z42vm scenario spawning). Exit 0 = all pass, 1 = failure(s).
//
// `_abVerdict` is the e2e A/B gate — the ONE hard red in bench-pr.yml — and it
// cannot be driven by a JSON fixture the way `_benchDiff`/`_benchMicroDiff` are (it
// takes two real toolchains measured on one runner), so this unit check is its
// only mechanical coverage. bench-pr.yml runs it in the verdict self-check step.
//
// The cases are chosen so each ingredient of the rule has one that flips when that ingredient breaks:
//   real-regression           +20% tight, thr 0.10 ⇒ red
//   separated-under-threshold THE SAME NUMBERS at thr 0.25 ⇒ NOT red. The only pair that differs solely in
//       thr — without it the suite would still pass if the threshold stopped being consulted at all
//       (the `lo > 0` vs `lo > thr` class of bug).
//   noisy-overlap             +15% but 20x the stddev ⇒ interval spans 1 ⇒ noise
//   faster                    -20% tight ⇒ never a red
//   no-ci-regression          stddev 0 ⇒ bare-ratio fallback, HasCi=false
//
// `_abResampleVerdict` DECIDES the flagged entries once resampling is on, so it is covered too:
//   resample-real-regression  three tight ratios ~+30% ⇒ red even at thr 0.15
//   resample-drift-rescued    round 1 saw +60%, rounds 2-3 saw +5%/+10% ⇒ the between-round dispersion
//       swallows it ⇒ NOT red. Its mean ratio (1.25) is deliberately ABOVE 1+thr so the case fails if the
//       interval width is ever lost — a drift case whose mean sits under the threshold asserts nothing.
//   resample-threshold-sensitive  the same +20% numbers red at 0.15, quiet at 0.25 — the thr-sensitivity
//       guard for THIS path.
//   resample-too-few-rounds   k=1 ⇒ no-data + HasCi=false, so a degenerate call can never come back looking
//       like a resampled verdict.
int _abSelfTest() {
    int fails = 0;
    AbVerdict a = _abVerdict(100.0, 1.0, 10.0, 120.0, 1.0, 10.0, 0.10);
    fails = fails + _abExpect("real-regression", a, "regression", true);
    AbVerdict e = _abVerdict(100.0, 1.0, 10.0, 120.0, 1.0, 10.0, 0.25);
    fails = fails + _abExpect("separated-under-threshold", e, "overlap", false);
    AbVerdict b = _abVerdict(100.0, 20.0, 10.0, 115.0, 20.0, 10.0, 0.10);
    fails = fails + _abExpect("noisy-overlap", b, "overlap", false);
    AbVerdict c = _abVerdict(100.0, 1.0, 10.0, 80.0, 1.0, 10.0, 0.10);
    fails = fails + _abExpect("faster", c, "faster", false);
    AbVerdict d = _abVerdict(100.0, 0.0, 10.0, 120.0, 0.0, 10.0, 0.10);
    fails = fails + _abExpect("no-ci-regression", d, "regression", true);
    if (d.HasCi) { Console.WriteLine("  FAIL no-ci-regression: expected HasCi=false"); fails = fails + 1; }

    // ── _abResampleVerdict ──
    double[] tight = new double[3]; tight[0] = 1.30; tight[1] = 1.32; tight[2] = 1.29;
    AbVerdict f = _abResampleVerdict(tight, 0.15);
    fails = fails + _abExpect("resample-real-regression", f, "regression", true);
    if (f.Rounds != 3) { Console.WriteLine("  FAIL resample-real-regression: expected Rounds=3"); fails = fails + 1; }

    // mean(ratios) = 1.25 is ITSELF above 1+0.15 — only the between-round dispersion
    // rescues it, so this case falsifies "the interval width got lost" (t=0 / SEM
    // substituted in), which a drift case with a below-threshold mean cannot do.
    double[] drift = new double[3]; drift[0] = 1.60; drift[1] = 1.05; drift[2] = 1.10;
    AbVerdict g = _abResampleVerdict(drift, 0.15);
    fails = fails + _abExpect("resample-drift-rescued", g, "overlap", false);

    double[] mid = new double[3]; mid[0] = 1.20; mid[1] = 1.21; mid[2] = 1.19;
    fails = fails + _abExpect("resample-threshold-sensitive@0.15",
        _abResampleVerdict(mid, 0.15), "regression", true);
    fails = fails + _abExpect("resample-threshold-sensitive@0.25",
        _abResampleVerdict(mid, 0.25), "overlap", false);

    double[] one = new double[1]; one[0] = 1.30;
    AbVerdict h = _abResampleVerdict(one, 0.15);
    fails = fails + _abExpect("resample-too-few-rounds", h, "no-data", false);
    if (h.HasCi) { Console.WriteLine("  FAIL resample-too-few-rounds: expected HasCi=false"); fails = fails + 1; }

    fails = fails + _abPauseSelfTest();   // pause gate

    if (fails == 0) { Console.WriteLine("✅ _abVerdict + _abResampleVerdict + pause selftest: 14/14 passed"); return 0; }
    Console.WriteLine("❌ _abVerdict + _abResampleVerdict selftest: " + fails.ToString() + " failure(s)");
    return 1;
}

int _abExpect(string label, AbVerdict v, string wantVerdict, bool wantRegr) {
    if (v.Verdict == wantVerdict && v.IsRegression == wantRegr) {
        Console.WriteLine("  ok " + label + ": " + v.Verdict + " (ratio=" + v.Ratio.ToString()
            + " R_lower=" + v.RLower.ToString() + " R_upper=" + v.RUpper.ToString() + ")");
        return 0;
    }
    Console.WriteLine("  FAIL " + label + ": got verdict=" + v.Verdict
        + " regr=" + (v.IsRegression ? "true" : "false")
        + " want verdict=" + wantVerdict + " regr=" + (wantRegr ? "true" : "false"));
    return 1;
}

// ── micro/stdlib tier same-runner A/B ──
//
// `bench --micro-diff --current <prMicro.json> --baseline <baseMicro.json> [--threshold-time T]`
//
// The micro tier runs `[Benchmark]`s IN-PROCESS under z42b, so (unlike the e2e
// tier's per-scenario isolated z42vm) base and pr stdlib cannot be co-loaded. The
// same-runner A/B is therefore achieved by capturing TWO isolated `bench stdlib
// --json` baselines on THIS runner — one in the base(merge-base) tree, one in the
// PR tree — and diffing them here. Because both were measured on the same machine,
// the machine speed factor cancels in ratio = pr/base, making the SEM (from the Bencher mean/stddev)
// statistically valid — exactly as for the e2e A/B, just base-batch then pr-batch instead of hyperfine's
// adjacent double-command.
//
// Per benchmark (matched by name + mode key so interp/jit never cross-compare),
// `_abVerdict` on mean_ns/stddev_ns/samples. Regression ⟺ R_lower > 1+thr. A
// benchmark present in PR but absent from base (renamed / newly added) is skipped —
// no base counterpart to compare against. Exit: 0 = no regression, 1 = regression(s),
// 2 = bad args / missing file.
//
// COVERED BY FIXTURES: src/benches/testdata/micro-base.json + micro-*.json
// (single round) and micro-rs-*-r{1,2,3}.json (resampled), run by bench-pr.yml's
// verdict self-check at BOTH thr 0.15 (the one the gate uses) and 0.25 — pure
// JSON, seconds, before the ~20 min of measurement. Single round, seven cases:
// regress / overlap / improve on the SEM path, separated-under-threshold (the
// thr-sensitive one: red at 0.15, pass at 0.25), fallback-regress /
// fallback-overlap on the no-SEM interval path, and unmatched (three entries
// whose name or mode key has no base counterpart, each blown up 3x — if matching
// ever went loose they would turn red instead of being skipped). Resampled, four:
// rs-drift / rs-real / rs-mid / rs-missing (see the self-check step for what each
// one guards). Change the rule ⇒ update the fixtures and the expected table.
int _benchMicroDiff(BenchCommand cmd) {
    string root = _root();
    string current = cmd.Current;
    if (current.Length == 0) { current = Path.Join(_benchDir(root), "micro-pr.json"); }
    string baseline = cmd.Baseline;
    if (baseline.Length == 0) { baseline = Path.Join(_benchDir(root), "micro-base.json"); }
    double thr = 0.10;
    string tt = cmd.ThresholdTime;
    if (tt.Length > 0) { thr = Double.Parse(tt); }
    // Resample: comma-separated round files, pr and base in lockstep.
    // One file each = the single-round SEM path. k>=2 = the resampled
    // path: the interval comes from the between-round dispersion of the ratios.
    string[] curPaths  = current.Split(",");
    string[] basePaths = baseline.Split(",");
    if (curPaths.Length != basePaths.Length) {
        ConsoleError.WriteLine("error: --current and --baseline must list the same number of rounds ("
            + curPaths.Length.ToString() + " vs " + basePaths.Length.ToString() + ")");
        return 2;
    }
    int k = curPaths.Length;
    JsonValue[] curDocs  = new JsonValue[k];
    JsonValue[] baseDocs = new JsonValue[k];
    for (int i = 0; i < k; i = i + 1) {
        string cp = _absUnder(root, curPaths[i].Trim());
        string bp = _absUnder(root, basePaths[i].Trim());
        if (!File.Exists(cp)) { ConsoleError.WriteLine("error: micro current not found: " + curPaths[i]); return 2; }
        if (!File.Exists(bp)) { ConsoleError.WriteLine("error: micro baseline not found: " + basePaths[i]); return 2; }
        curDocs[i]  = JsonValue.Parse(File.ReadAllText(cp)).Get("benchmarks");
        baseDocs[i] = JsonValue.Parse(File.ReadAllText(bp)).Get("benchmarks");
    }
    JsonValue curBs  = curDocs[0];
    JsonValue baseBs = baseDocs[0];
    if (k > 1) {
        Console.WriteLine("Micro A/B RESAMPLED (" + k.ToString()
            + " rounds, interval from between-round dispersion; gate: R_lower > 1+" + thr.ToString() + "):");
    } else {
        Console.WriteLine("Micro A/B (same-runner base vs pr; gate: R_lower > 1+" + thr.ToString() + "):");
    }

    // `--suspects <path>`: names of entries this (round-1) pass flags, one per line,
    // for the caller to decide whether resampling is worth starting. Always written
    // when asked — an empty file is the "nothing suspicious" answer, and callers test
    // it with `[ -s ]`, so not writing it would read as "no suspects" on a crash.
    string suspectsPath = cmd.Suspects;
    string suspects = "";

    int regr = 0; int compared = 0; int newb = 0; int dropped = 0;
    int j = 0;
    while (j < curBs.Count()) {
        JsonValue c = curBs.At(j);
        string name   = c.Get("name").AsString();
        string metric = c.Get("metric").AsString();
        string mkey   = _epBenchModeKey(c);
        JsonValue b = _findBenchObj(baseBs, name, metric, mkey);
        if (b == null) { newb = newb + 1; j = j + 1; continue; }
        AbVerdict v = new AbVerdict();
        if (k > 1) {
            v = _microResampled(curDocs, baseDocs, k, name, metric, mkey, thr);
            if (v.Verdict == "no-data") {
                // Present in round 1 but not in every round. A benchmark that comes and
                // goes between rounds is not evidence of a regression — keep it OUT of
                // the gate, but say so: silently dropping gate entries is how a gate
                // goes blind.
                Console.WriteLine("  ⚠️  " + name + " [" + mkey + "]: missing from some round — excluded from the gate");
                dropped = dropped + 1;
                j = j + 1;
                continue;
            }
        } else {
            v = _microVerdict(b, c, thr);
        }
        compared = compared + 1;
        _abPrint(name, mkey, v);
        if (v.IsRegression) { regr = regr + 1; suspects = suspects + name + "\n"; }
        j = j + 1;
    }
    if (newb > 0) {
        Console.WriteLine("  (" + newb.ToString() + " new benchmark(s) with no base match — skipped)");
    }
    if (dropped > 0) {
        Console.WriteLine("  (" + dropped.ToString() + " benchmark(s) excluded — not present in every round)");
    }
    if (suspectsPath.Length > 0) { File.WriteAllText(_absUnder(root, suspectsPath), suspects); }
    Console.WriteLine("");
    if (regr > 0) {
        Console.WriteLine("❌ " + regr.ToString() + " micro regression(s) — R_lower > 1+thr (of "
            + compared.ToString() + " same-runner comparisons)");
        return 1;
    }
    Console.WriteLine("✅ no micro regression (same-runner A/B; " + compared.ToString() + " compared)");
    return 0;
}

// One benchmark's resampled verdict: its ratio in EVERY round, then
// `_abResampleVerdict`. Returns a "no-data" verdict when the entry is not matched
// in all k rounds (the caller excludes it from the gate and says so).
AbVerdict _microResampled(JsonValue[] curDocs, JsonValue[] baseDocs, int k,
                          string name, string metric, string mkey, double thr) {
    double[] ratios = new double[k];
    for (int i = 0; i < k; i = i + 1) {
        JsonValue ci = _findBenchObj(curDocs[i], name, metric, mkey);
        JsonValue bi = _findBenchObj(baseDocs[i], name, metric, mkey);
        if (ci == null || bi == null) { AbVerdict miss = new AbVerdict(); miss.Verdict = "no-data"; miss.HasCi = false; return miss; }
        double bm = _microMean(bi);
        double cm = _microMean(ci);
        if (bm <= 0.0 || cm <= 0.0) { AbVerdict miss = new AbVerdict(); miss.Verdict = "no-data"; miss.HasCi = false; return miss; }
        ratios[i] = cm / bm;
    }
    return _abResampleVerdict(ratios, thr);
}

// Per-benchmark micro verdict. Prefer the SEM path (Bencher mean/stddev) when BOTH baselines carry it;
// otherwise (a baseline without mean_ns/stddev_ns, = -1) fall back to the INTERVAL-AWARE min/max comparison —
// both baselines always carry value + ci_lower/ci_upper. Same R_lower > 1+thr criterion either way
// (via _abClassify).
AbVerdict _microVerdict(JsonValue b, JsonValue c, double thr) {
    if (_microHasSem(b) && _microHasSem(c)) {
        return _abVerdict(_microMean(b), _microSd(b), _microN(b),
                          _microMean(c), _microSd(c), _microN(c), thr);
    }
    AbVerdict v = new AbVerdict();
    double baseV = b.Get("value").AsDouble();
    double prV   = c.Get("value").AsDouble();
    if (baseV <= 0.0 || prV <= 0.0) { v.Verdict = "no-data"; return v; }
    v.Ratio = prV / baseV;
    if (!_microHasCiBounds(b) || !_microHasCiBounds(c)) {
        v.HasCi = false; v.RLower = v.Ratio; v.RUpper = v.Ratio;
        _abClassify(v, thr);
        return v;
    }
    // Ratio CI from the min/max intervals: [pr.lo/base.hi, pr.hi/base.lo]. A
    // regression needs pr's fastest sample to still exceed base's slowest by the
    // threshold (R_lower > 1+thr) — overlapping intervals ⇒ noise ⇒ not a regression.
    double bLo = b.Get("ci_lower").AsDouble(); double bHi = b.Get("ci_upper").AsDouble();
    double cLo = c.Get("ci_lower").AsDouble(); double cHi = c.Get("ci_upper").AsDouble();
    if (bHi <= 0.0 || bLo <= 0.0) { v.RLower = v.Ratio; v.RUpper = v.Ratio; v.HasCi = false; _abClassify(v, thr); return v; }
    v.RLower = cLo / bHi;
    v.RUpper = cHi / bLo;
    _abClassify(v, thr);
    return v;
}

// SEM usable ⟺ mean present + stddev>0 + samples>1 (matches _abVerdict's haveCi).
bool _microHasSem(JsonValue b) {
    double mean = -1.0; double sd = -1.0; double n = 0.0;
    return b.TryGetValue<double>("mean_ns", ref mean)     && mean >= 0.0
        && b.TryGetValue<double>("stddev_ns", ref sd)     && sd > 0.0
        && b.TryGetValue<double>("samples", ref n)        && n > 1.0;
}
bool _microHasCiBounds(JsonValue b) {
    JsonValue lo = null; JsonValue hi = null;
    return b.TryGet("ci_lower", ref lo) && b.TryGet("ci_upper", ref hi);
}

// Point estimate for a micro benchmark object: prefer mean_ns; fall back to
// value (median) when mean_ns is absent/-1 (older baseline).
double _microMean(JsonValue b) {
    double mean = -1.0;
    if (b.TryGetValue<double>("mean_ns", ref mean) && mean >= 0.0) { return mean; }
    return b.Get("value").AsDouble();
}
// Dispersion: stddev_ns, or 0 (→ _abVerdict no-ci fallback) when absent/-1.
double _microSd(JsonValue b) {
    double sd = -1.0;
    if (b.TryGetValue<double>("stddev_ns", ref sd) && sd >= 0.0) { return sd; }
    return 0.0;
}
// Sample count n for SEM = stddev/sqrt(n); 0 (→ no-ci) when absent.
double _microN(JsonValue b) {
    double n = 0.0;
    b.TryGetValue<double>("samples", ref n);
    return n;
}

// `bench --diff [--current P] [--baseline P] [--threshold-time T] [--threshold-memory M] [--quiet]`
// Compares current bench results
// against a baseline (both conform to src/benches/baseline-schema.json): per-benchmark
// delta = (cur - base) / base. Interval-aware gate — a regression requires BOTH
// delta > --threshold-time (default 0.05) / --threshold-memory (default 0.10) AND
// the current confidence interval separated from the baseline's (cur.ci_lower >
// base.ci_upper). Overlapping intervals ⇒ noise ⇒ not a regression (marked
// (overlap)). A side lacking ci_lower/ci_upper falls back to the bare-mean-ratio
// gate (marked (no-ci)). Exit codes: 0 = no regression, 1 = regression, 2 = tool error.
int _benchDiff(BenchCommand cmd) {
    string root = _root();
    string current = cmd.Current;
    if (current.Length == 0) { current = Path.Join(_benchDir(root), "e2e.json"); }
    string baseline = cmd.Baseline;
    double thrTime = 0.05;
    string tt = cmd.ThresholdTime;
    if (tt.Length > 0) { thrTime = Double.Parse(tt); }
    double thrMem = cmd.ThresholdMemory;
    bool quiet = cmd.Quiet;
    // 没有「自动挑一份主分支基线」的默认值：`--diff` 必须显式给 --baseline <path>（本地优化前后对比的正常用法）。
    if (baseline.Length == 0) {
        ConsoleError.WriteLine("error: bench --diff requires an explicit --baseline <path>");
        ConsoleError.WriteLine("  hint: capture one first, e.g. `xtask bench` then copy artifacts/reports/benches/e2e.json aside");
        return 2;
    }
    string curPath  = _absUnder(root, current);
    string basePath = _absUnder(root, baseline);
    if (!File.Exists(curPath))  { ConsoleError.WriteLine("error: current results not found: " + current); return 2; }
    if (!File.Exists(basePath)) { ConsoleError.WriteLine("error: baseline not found: " + baseline); return 2; }

    JsonValue cur  = JsonValue.Parse(File.ReadAllText(curPath));
    JsonValue base_ = JsonValue.Parse(File.ReadAllText(basePath));
    JsonValue curBs  = cur.Get("benchmarks");
    JsonValue baseBs = base_.Get("benchmarks");

    if (!quiet) {
        Console.WriteLine("Comparing:");
        Console.WriteLine("  current:  " + cur.Get("commit").AsString() + "  (" + current + ")");
        Console.WriteLine("  baseline: " + base_.Get("commit").AsString() + "  (" + baseline + ")");
        Console.WriteLine("  gate: delta>" + thrTime.ToString() + " (time) / " + thrMem.ToString() + " (mem) AND CI-separated = regression");
        Console.WriteLine("");
    }

    int regressions = 0;
    int total = 0;
    // current-driven diff (matches baseline by name+metric; (new) when absent).
    int j = 0;
    while (j < curBs.Count()) {
        JsonValue c = curBs.At(j);
        string name   = c.Get("name").AsString();
        string metric = c.Get("metric").AsString();
        double curV   = c.Get("value").AsDouble();
        string unit   = c.Get("unit").AsString();
        string mkey   = _epBenchModeKey(c);
        total = total + 1;
        string label = name + " [" + metric + " " + mkey + "]";
        JsonValue baseObj = _findBenchObj(baseBs, name, metric, mkey);
        if (baseObj == null) {
            if (!quiet) { Console.WriteLine("  " + label + "  (new)  " + curV.ToString() + " " + unit); }
            j = j + 1; continue;
        }
        double baseV = baseObj.Get("value").AsDouble();
        if (baseV == 0.0) {
            if (!quiet) { Console.WriteLine("  " + label + "  baseline=0 (skip)"); }
            j = j + 1; continue;
        }
        double delta = (curV - baseV) / baseV;
        bool isMem = (metric == "memory" || unit == "bytes" || unit == "KB" || unit == "MB");
        double thr = isMem ? thrMem : thrTime;
        string sym = "≈";
        string note = "";
        // Interval-aware gate: a regression must be BOTH large (|delta| > thr) AND
        // statistically distinguishable (current CI separated from baseline CI).
        // Overlapping intervals ⇒ the mean shift is within measurement noise ⇒ ≈,
        // no matter how big delta looks.
        if (_hasCi(c) && _hasCi(baseObj)) {
            double cLo = c.Get("ci_lower").AsDouble();
            double cHi = c.Get("ci_upper").AsDouble();
            double bLo = baseObj.Get("ci_lower").AsDouble();
            double bHi = baseObj.Get("ci_upper").AsDouble();
            if (delta > thr && cLo > bHi) { sym = "↑"; regressions = regressions + 1; }
            else if (delta < (0.0 - thr) && cHi < bLo) { sym = "↓"; }
            else if (delta > thr || delta < (0.0 - thr)) { note = " (overlap)"; }
        } else {
            // Fallback: a side lacks ci_lower/ci_upper → bare-mean-ratio gate.
            note = " (no-ci)";
            if (delta > thr) { sym = "↑"; regressions = regressions + 1; }
            else if (delta < (0.0 - thr)) { sym = "↓"; }
        }
        if (!quiet || sym == "↑") {
            Console.WriteLine("  " + label + "  " + baseV.ToString() + " " + unit
                + " → " + curV.ToString() + " " + unit + "  " + sym + " " + (delta * 100.0).ToString() + "%" + note);
        }
        j = j + 1;
    }
    // baseline-only (removed) annotations — informational, never a regression.
    if (!quiet) {
        int k = 0;
        while (k < baseBs.Count()) {
            JsonValue b = baseBs.At(k);
            string name   = b.Get("name").AsString();
            string metric = b.Get("metric").AsString();
            string mkey   = _epBenchModeKey(b);
            if (_findBenchValue(curBs, name, metric, mkey) < 0.0) {
                Console.WriteLine("  " + name + " [" + metric + " " + mkey + "]  (removed)  "
                    + b.Get("value").AsDouble().ToString() + " " + b.Get("unit").AsString());
            }
            k = k + 1;
        }
    }

    // derive interp/jit speedup where both were measured.
    _printSpeedups(curBs);

    Console.WriteLine("");
    if (regressions > 0) {
        Console.WriteLine("❌ " + regressions.ToString() + " regression(s) — delta over threshold AND CI-separated (out of " + total.ToString() + " benchmarks)");
        return 1;
    }
    Console.WriteLine("✅ no regression (interval-aware; " + total.ToString() + " benchmarks compared)");
    return 0;
}

// value of the benchmark matching name+metric+mode-key, or -1.0 if absent.
// mkey ("<mode_label>@<os>/<arch>") keeps interp-vs-jit
// and cross-platform results from ever comparing against each other.
double _findBenchValue(JsonValue benchmarks, string name, string metric, string mkey) {
    int i = 0;
    while (i < benchmarks.Count()) {
        JsonValue b = benchmarks.At(i);
        if (b.Get("name").AsString() == name && b.Get("metric").AsString() == metric
            && _epBenchModeKey(b) == mkey) {
            return b.Get("value").AsDouble();
        }
        i = i + 1;
    }
    return -1.0;
}

// like _findBenchValue but returns the whole benchmark object (or null if absent),
// so the interval-aware gate can read ci_lower/ci_upper off the baseline entry.
JsonValue _findBenchObj(JsonValue benchmarks, string name, string metric, string mkey) {
    int i = 0;
    while (i < benchmarks.Count()) {
        JsonValue b = benchmarks.At(i);
        if (b.Get("name").AsString() == name && b.Get("metric").AsString() == metric
            && _epBenchModeKey(b) == mkey) {
            return b;
        }
        i = i + 1;
    }
    return null;
}

// true iff the benchmark carries both confidence-interval bounds (present & non-null).
// Get() throws on a missing key and AsDouble() throws on null, so guard before reading.
bool _hasCi(JsonValue b) {
    JsonValue lo = null; JsonValue hi = null;
    if (!b.TryGet("ci_lower", ref lo) || lo.IsNull()) { return false; }
    if (!b.TryGet("ci_upper", ref hi) || hi.IsNull()) { return false; }
    return true;
}

// for each (name, metric, platform) measured under
// BOTH interp and jit, print the interp/jit speedup (>1 = jit faster). Iterates
// the jit-labelled entries and looks up the matching interp entry. Informational
// only — not a schema field, never a regression signal.
void _printSpeedups(JsonValue benchmarks) {
    bool header = false;
    int i = 0;
    while (i < benchmarks.Count()) {
        JsonValue b = benchmarks.At(i);
        JsonValue p = null;
        if (b.TryGet("profile", ref p)) {
            if (p.Get("mode_label").AsString() == "jit") {
                string name    = b.Get("name").AsString();
                string metric  = b.Get("metric").AsString();
                JsonValue plat = p.Get("platform");
                string suffix  = "@" + plat.Get("os").AsString() + "/" + plat.Get("arch").AsString();
                double jitV    = b.Get("value").AsDouble();
                double interpV = _findBenchValue(benchmarks, name, metric, "interp" + suffix);
                if (interpV > 0.0 && jitV > 0.0) {
                    if (!header) {
                        Console.WriteLine("");
                        Console.WriteLine("Speedup (interp/jit, >1 = jit faster):");
                        header = true;
                    }
                    double ratio = interpV / jitV;
                    Console.WriteLine("  " + name + " [" + metric + suffix + "]  " + ratio.ToString() + "x");
                }
            }
        }
        i = i + 1;
    }
}

// one benchmark object from a hyperfine export JSON (time values are seconds → ms).
// carries the schema-v2 `profile` (mode composition +
// platform + probed caps) so interp/jit results never compare against each other.
string _benchObj(string hjson, string name, string runs, string[] tiers, VmCaps vm) {
    JsonValue r0 = JsonValue.Parse(File.ReadAllText(hjson)).Get("results").At(0);
    string val = (r0.Get("mean").AsDouble() * 1000.0).ToString();
    string lo  = (r0.Get("min").AsDouble()  * 1000.0).ToString();
    string hi  = (r0.Get("max").AsDouble()  * 1000.0).ToString();
    return "    {\n      \"name\": \"" + name + "\",\n      \"tier\": \"z42-e2e\""
        + ",\n      \"metric\": \"time\",\n      \"value\": " + val
        + ",\n      \"unit\": \"ms\",\n      \"ci_lower\": " + lo
        + ",\n      \"ci_upper\": " + hi + ",\n      \"samples\": " + runs
        + ",\n      \"profile\": " + _epProfileJson(tiers, new string[0], vm) + "\n    }";
}
