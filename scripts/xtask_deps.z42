// xtask — `deps check` impl (unify-scripts-into-xtask, 2026-06-05; 收敛为唯一只读
// 校验 simplify-xtask-deps, 2026-07-07)。流程：
//   跨平台工具告警（rust/node，warning-only）
//   → project drift（Cargo.toml 版本）
//   → 各平台 presence（_setup*(mode="check")，复用 install 侧检查）+ 投影 drift
//   → wasm 工具 min 版本真校验（替换旧恒真假检查 `_check(wpm, wpm)`）
//
// presence 退出码策略：CI build-and-test 在没有 android/ios SDK 的 runner 上裸跑
// `deps check`——presence 缺失在那里是预期的，因此只有显式 `--os <p>`（调用者声明
// 自己开发平台 p）时 presence 失败才致败；drift 与机器无关，恒致败。
//
// 从 versions.toml 拿期望值，扫"投影"文件（Cargo.toml / build.gradle.kts /
// ios/Package.swift）验证一致性。scalar 解析复用 shared xtask_versions.z42 的
// _scalarStr。Entry: `xtask deps check [--os <p>]`.
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Toml;
using Std.Regex;
using Std.Cli;

int _depsCheckRun(string os) {
    if (os.Length > 0 && os != "android" && os != "ios" && os != "wasm") {
        ConsoleError.WriteLine("deps check --os: unknown platform '" + os + "' (android|ios|wasm)");
        return 2;
    }
    string root = _root();
    string tomlPath = Path.Join(root, "versions.toml");
    if (!File.Exists(tomlPath)) {
        ConsoleError.WriteLine("error: versions.toml not found at " + tomlPath);
        return 2;
    }
    TomlValue toml = TomlValue.Parse(File.ReadAllText(tomlPath));
    int driftFail = 0;
    int presenceFail = 0;

    Console.WriteLine("── toolchain (cross-platform) ───────────────────────────────────────────");
    _checkRust(toml);
    _checkNode(toml);

    Console.WriteLine("── project ──────────────────────────────────────────────────────────────");
    string cargoText = File.ReadAllText(Path.Join(root, _runtimeManifest()));
    string wantVer = _scalarStr(toml.Get("project").Get("version"));
    string gotVer  = _extractCargoWorkspaceVersion(cargoText);
    driftFail = driftFail + _check("src/runtime/Cargo.toml [workspace.package].version", wantVer, gotVer);

    if (os == "" || os == "android") {
        if (_setupAndroid(root, toml, "check", false) != 0) { presenceFail = presenceFail + 1; }
        _emulatorStatus(root, toml);
        driftFail = driftFail + _checkAndroidProjectionDrift(root, toml);
    }
    if (os == "" || os == "ios") {
        if (_setupIos(root, toml, "check") != 0) { presenceFail = presenceFail + 1; }
        driftFail = driftFail + _checkIosProjectionDrift(root, toml);
    }
    if (os == "" || os == "wasm") {
        if (_setupWasm(root, toml, "check", false) != 0) { presenceFail = presenceFail + 1; }
        presenceFail = presenceFail + _checkWasmToolMins(toml);
    }

    Console.WriteLine("─────────────────────────────────────────────────────────────────────────");
    return _depsCheckVerdict(os, driftFail, presenceFail);
}

// 汇总退出码：drift 恒致败；presence 仅显式 --os 时致败（裸跑 = 信息性，CI 兼容）。
int _depsCheckVerdict(string os, int driftFail, int presenceFail) {
    if (driftFail > 0) {
        ConsoleError.WriteLine("error: versions.toml drift detected — update the source files to match versions.toml");
        ConsoleError.WriteLine("       See versions.toml → field comments (→ filename) for which file to fix.");
        return 1;
    }
    if (presenceFail > 0) {
        if (os.Length > 0) {
            ConsoleError.WriteLine("error: missing " + os + " deps — run: xtask deps install --os " + os);
            return 1;
        }
        Console.WriteLine("note: some platform deps missing (informational on a bare run; `deps check --os <p>` enforces, `deps install --os <p>` installs)");
    }
    Console.WriteLine("All version checks passed.");
    return 0;
}

// ── 平台投影 drift（versions.toml ↔ 源文件；单实现 SoT）──────────────────────

int _checkAndroidProjectionDrift(string root, TomlValue toml) {
    string gradleText = File.ReadAllText(Path.Join(root, "src/toolchain/workload/android/platform/z42vm/build.gradle.kts"));
    int fail = 0;
    string wantMin = _scalarStr(toml.Get("platform").Get("android").Get("min_api"));
    string gotMin  = _firstMatchGroup(gradleText, "minSdk\\s*=\\s*([0-9]+)", 1);
    fail = fail + _check("build.gradle.kts  minSdk", wantMin, gotMin);
    string wantTgt = _scalarStr(toml.Get("platform").Get("android").Get("target_api"));
    string gotTgt  = _firstMatchGroup(gradleText, "compileSdk\\s*=\\s*([0-9]+)", 1);
    fail = fail + _check("build.gradle.kts  compileSdk", wantTgt, gotTgt);
    return fail;
}

// iOS 锚点：committed host harness 的 Package.swift（`swift test` 用）。SDK 包的
// Package.swift 由 xtask_package_ios.z42 运行期从 versions.toml 生成（结构上不可能
// drift），故唯一残留的硬编码投影是这份 harness——drift 检查钉在它上面
// （migrate-scripts-to-z42, 2026-06-04 锚点迁移史见 git）。
int _checkIosProjectionDrift(string root, TomlValue toml) {
    string pkgSwiftText = File.ReadAllText(Path.Join(root, "src/toolchain/workload/ios/platform/Package.swift"));
    int fail = 0;
    string wantIos = _scalarStr(toml.Get("platform").Get("ios").Get("min_ios"));
    string gotIos  = _firstMatchGroup(pkgSwiftText, "\\.iOS\\(\\.v([0-9]+)\\)", 1) + ".0";
    fail = fail + _check("ios/Package.swift  .iOS(.v<major>)", wantIos, gotIos);
    string wantMac = _scalarStr(toml.Get("platform").Get("ios").Get("min_macos"));
    string gotMac  = _firstMatchGroup(pkgSwiftText, "\\.macOS\\(\\.v([0-9]+)\\)", 1) + ".0";
    fail = fail + _check("ios/Package.swift  .macOS(.v<major>)", wantMac, gotMac);
    return fail;
}

// wasm 工具 min 版本真校验（替换旧 `_check(wpm, wpm)` 自比恒真的假检查）。
// wasm-pack 的 presence 由 _setupWasm(check) 负责，这里只在已安装时比版本；
// wasm-tools 是可选工具，同样仅在场时比版本。
int _checkWasmToolMins(TomlValue toml) {
    int fail = 0;
    string wpm = _scalarStr(toml.Get("build").Get("wasm").Get("wasm_pack_min"));
    if (_have("wasm-pack")) {
        string v = _nthWord(_cmdOut("wasm-pack", new string[]{ "--version" }), 1);
        if (v.Length > 0 && _verKey(v) < _verKey(wpm)) {
            ConsoleError.WriteLine("  ✗ wasm-pack " + v + " < versions.toml min " + wpm);
            fail = fail + 1;
        } else {
            Console.WriteLine("  ✓ wasm-pack " + v + " (≥ " + wpm + ")");
        }
    }
    string wtm = _scalarStr(toml.Get("build").Get("wasm").Get("wasm_tools_min"));
    if (_have("wasm-tools")) {
        string v2 = _nthWord(_cmdOut("wasm-tools", new string[]{ "--version" }), 1);
        if (v2.Length > 0 && _verKey(v2) < _verKey(wtm)) {
            ConsoleError.WriteLine("  ✗ wasm-tools " + v2 + " < versions.toml min " + wtm);
            fail = fail + 1;
        } else {
            Console.WriteLine("  ✓ wasm-tools " + v2 + " (≥ " + wtm + ")");
        }
    }
    return fail;
}

// emulator tier 状态行——纯信息性。emulator 零命令面（User 裁决 2026-07-07）：
// 由 `test platform android run` 用到时自动安装，deps check 只报告不装。
void _emulatorStatus(string root, TomlValue toml) {
    string sdkDir = Path.Join(root, _vget(toml, "build.android.install_root"));
    if (File.Exists(Path.Join(sdkDir, "emulator/emulator"))) {
        Console.WriteLine("  ✓ emulator tier (auto-managed)");
    } else {
        Console.WriteLine("  - emulator tier not installed (auto-installs on `test platform android run`; ~4GB)");
    }
}

// ── 输出与解析助手 ────────────────────────────────────────────────────────────

// 同 bash check()：want == got → ✓，否则 ✗ + 计 1 失败。
int _check(string desc, string want, string got) {
    if (want == got) {
        Console.WriteLine("  ✓ " + _padRight(desc, 50) + " " + got);
        return 0;
    } else {
        ConsoleError.WriteLine("  ✗ " + _padRight(desc, 50) + " want=" + want + " got=" + got);
        return 1;
    }
}

// 左对齐到 width 列；超长不截断。
string _padRight(string s, int width) {
    if (s.Length >= width) { return s; }
    string acc = s;
    int n = width - s.Length;
    int i = 0;
    while (i < n) { acc = acc + " "; i = i + 1; }
    return acc;
}

// _scalarStr 现由 shared xtask_versions.z42 提供（同 Z42Xtask 命名空间）。

// 第一个 regex match 的指定 group；找不到返回 ""（同 bash `head -1` 失败时空）。
string _firstMatchGroup(string text, string pattern, int groupIdx) {
    Regex r = Regex.Compile(pattern);
    Match m = r.Find(text);
    if (m == null) { return ""; }
    return m.Group(groupIdx);
}

// 等价 bash awk 块：找到 [workspace.package] section，取该 section 内第一个
// `version = "..."` 行。section 边界由 `[...]` 起始的下一行决定。
string _extractCargoWorkspaceVersion(string cargoText) {
    string[] lines = cargoText.Split("\n");
    Regex verLine = Regex.Compile("^\\s*version\\s*=\\s*\"([^\"]+)\"");
    bool inSection = false;
    int i = 0;
    while (i < lines.Length) {
        string line = lines[i];
        if (line.StartsWith("[workspace.package]")) { inSection = true; i = i + 1; continue; }
        if (line.StartsWith("[")) { inSection = false; i = i + 1; continue; }
        if (inSection) {
            Match m = verLine.Find(line);
            if (m != null) { return m.Group(1); }
        }
        i = i + 1;
    }
    return "";
}

// ── `deps check` 命令入口（relocate-xtask-handlers, 2026-09-05 从 xtask.z42 搬来） ──

// `deps check [--os <p>]` — 唯一只读校验：presence + versions.toml drift（逻辑在
// xtask_deps.z42 :: _depsCheckRun，in-process 直调）。presence 仅显式 --os 时计入
// 退出码——CI 的 build-and-test 在无平台 SDK 的 runner 上裸跑本命令（只把 drift
// 当门禁），语义详见 xtask_deps.z42 头注释。
int _depsCheck(ParseResult r) {
    Stopwatch sw = _procStart("deps check");
    int __rc = _depsCheckRun(r.GetOption("os"));
    if (__rc == 0) { _procEnd("deps check", sw); }
    return __rc;
}
