// xtask — deps install (migrate-scripts-to-z42): native port of the former
// scripts/setup-tools.sh. Verify/install the toolchain declared in versions.toml.
// Source-of-truth = versions.toml (parsed with Std.Toml, no python).
//
// 依赖两层模型（simplify-xtask-deps, User 裁决 2026-07-07）：
//   平台必备 — 该平台构建/测试没它就跑不了，`deps install --os <p>` 直接装：
//     android = rust targets + cargo-ndk + JDK check + build SDK (cmdline-tools
//               + platforms;<p> + build-tools;<bt> + platform-tools + ndk;<ver>)
//     ios     = rust targets (+ extra host slice) + Xcode check
//     wasm    = rust targets + wasm-pack + hermetic node（wasm 测试面必备）
//   用到才装 — 重型/兜底依赖，消费步骤检测缺失后自动装，零命令面：
//     android emulator tier（emulator + system-image + AVD + Gradle，~4GB）
//       → `test platform android run`（AndroidBackend.RunTests）自动装
//     node 兜底 → wasm RunTests hermetic+PATH 均缺时自动装
//
// 只读校验（presence + drift）统一在 `deps check`（xtask_deps.z42）；
// env 导出在 `deps env`（本文件 _depsEnv）。install 只装，不查不导。
//
// Same Z42Xtask namespace; calls _root/_exec/_have... defined here + in xtask.z42.
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Toml;
using Std.Cli;

// Args from a Std.Cli ParseResult: --os <platform> / --force.
int _depsInstall(ParseResult r) {
    bool force = r.GetFlag("force");
    string platform = r.GetOption("os");
    if (platform.Length > 0 && platform != "android" && platform != "ios" && platform != "wasm") {
        ConsoleError.WriteLine("deps install --os: unknown platform '" + platform + "' (android|ios|wasm)"); return 2;
    }
    string root = _root();
    TomlValue toml = TomlValue.Parse(File.ReadAllText(Path.Join(root, "versions.toml")));

    string[] platforms;
    if (platform.Length > 0) { platforms = new string[1]; platforms[0] = platform; }
    else { platforms = new string[3]; platforms[0] = "android"; platforms[1] = "ios"; platforms[2] = "wasm"; }

    Console.WriteLine("── toolchain (cross-platform) ──");
    _checkRust(toml);
    _checkNode(toml);

    int rc = 0;
    int p = 0;
    while (p < platforms.Length) {
        int c = 0;
        if (platforms[p] == "android")   { c = _setupAndroid(root, toml, "install", force); }
        else if (platforms[p] == "ios")  { c = _setupIos(root, toml, "install"); }
        else if (platforms[p] == "wasm") { c = _setupWasm(root, toml, "install", force); }
        if (c != 0) { rc = c; }
        p = p + 1;
    }

    if (rc == 0) {
        Console.WriteLine("");
        Console.WriteLine("✅ setup complete");
        Console.WriteLine("   For ANDROID_NDK_HOME export, run:");
        Console.WriteLine("     eval \"$(z42 xtask.zpkg deps env)\"");
        Console.WriteLine("   Android emulator tier (instrumentation tests) auto-installs on `test platform android run`.");
    }
    return rc;
}

// `deps env [--os android]` — eval 用的环境导出：stdout 只输出 export 行（可
// `eval "$(...)"`)，一切提示/错误走 stderr。目前只有 android 有可导出 env
// （ANDROID_NDK_HOME）；--os 缺省即 android。
int _depsEnv(ParseResult r) {
    string os = r.GetOption("os");
    if (os.Length == 0) { os = "android"; }
    if (os == "ios" || os == "wasm") {
        ConsoleError.WriteLine("# deps env: no env exports for '" + os + "' (android only)");
        return 0;
    }
    if (os != "android") {
        ConsoleError.WriteLine("deps env --os: unknown platform '" + os + "' (android|ios|wasm)");
        return 2;
    }
    string root = _root();
    TomlValue toml = TomlValue.Parse(File.ReadAllText(Path.Join(root, "versions.toml")));
    string home = _resolveNdkHome(root, toml);
    if (home.Length == 0) {
        ConsoleError.WriteLine("# android: NDK not found; run z42 xtask.zpkg deps install --os android");
        return 1;
    }
    Console.WriteLine("export ANDROID_NDK_HOME=\"" + home + "\"");
    return 0;
}

// ── node installer (was install-node-local.sh; 现为内部函数，无命令面) ───────
// 调用方：_setupWasm（wasm 必备直装）+ WasmBackend.RunTests（用到才装兜底）。

// Download Node.js LTS into artifacts/tools/node/ (no system PATH changes).
// Idempotent; force redownloads. POSIX-only (.tar.gz); Windows → MSI.
int _depsInstallNode(bool force) {
    string root = _root();
    TomlValue toml = TomlValue.Parse(File.ReadAllText(Path.Join(root, "versions.toml")));
    string nodeVersion = _vget(toml, "toolchain.node.version");   // SoT: versions.toml
    string installDir = Path.Join(root, "artifacts/tools/node");
    string nodeBin = Path.Join(installDir, "bin/node");

    // Idempotence.
    if (File.Exists(nodeBin) && !force) {
        string cur = _cmdOut(nodeBin, new string[]{ "--version" });
        if (cur == "v" + nodeVersion) {
            Console.WriteLine("Node.js v" + nodeVersion + " already installed at " + installDir + " (skip; --force to reinstall)");
            Console.WriteLine(nodeBin);
            return 0;
        }
        Console.WriteLine("existing node " + cur + " differs from target v" + nodeVersion + "; reinstalling");
    }

    // OS / arch.
    string os = _detectOs();
    if (os == "windows") {
        ConsoleError.WriteLine("error: auto-extract is POSIX-only. On Windows install Node.js from the official MSI:");
        ConsoleError.WriteLine("       https://nodejs.org/en/download  (see docs/workflow/windows.md)");
        return 1;
    }
    string arch = Platform.Arch();          // "arm64" / "x86_64" / ...
    string nodeArch = "";
    if (arch == "arm64" || arch == "aarch64") { nodeArch = "arm64"; }
    else if (arch == "x86_64" || arch == "x64") { nodeArch = "x64"; }
    else { ConsoleError.WriteLine("error: unsupported arch " + arch); return 1; }

    string name = "node-v" + nodeVersion + "-" + os + "-" + nodeArch;
    string url = "https://nodejs.org/dist/v" + nodeVersion + "/" + name + ".tar.gz";

    string tmp = Directory.CreateTempDir("node-dl");
    string tarball = Path.Join(tmp, name + ".tar.gz");
    Console.WriteLine("fetching " + url);
    int dc = _exec(new Process("curl").Arg("--fail").Arg("--location").Arg("--silent").Arg("--show-error").Arg("-o").Arg(tarball).Arg(url));
    if (dc != 0) { ConsoleError.WriteLine("error: node download failed"); return dc; }

    Console.WriteLine("extracting to " + installDir);
    Directory.Create(Path.Join(root, "artifacts/tools"));
    if (Directory.Exists(installDir)) { Directory.Delete(installDir, true); }
    int xc = _exec(new Process("tar").Arg("-xzf").Arg(tarball).Arg("-C").Arg(tmp));
    if (xc != 0) { return xc; }
    int mc = _exec(new Process("mv").Arg(Path.Join(tmp, name)).Arg(installDir));
    if (mc != 0) { return mc; }

    if (!File.Exists(nodeBin)) { ConsoleError.WriteLine("error: " + nodeBin + " missing after extract"); return 1; }
    string nodeVer = _cmdOut(nodeBin, new string[]{ "--version" });
    Console.WriteLine("");
    Console.WriteLine("Node.js installed locally — no system PATH changes.");
    Console.WriteLine("  node: " + nodeVer + "  → " + nodeBin);
    Console.WriteLine("  prepend to PATH:  export PATH=\"" + Path.Join(installDir, "bin") + ":$PATH\"");
    return 0;
}

// versions.toml access (_vget/_vgetList/_scalarStr) now lives in the shared
// xtask_versions.z42 module — same Z42Xtask namespace, so callers are unchanged.

// ── host helpers ─────────────────────────────────────────────────────────────
// _have (is <bin> on PATH) is the shared tool-presence primitive in xtask_common.z42.

string _detectOs() {
    if (Platform.IsWindows()) { return "windows"; }
    if (Platform.IsMacOS())   { return "darwin"; }
    return "linux";
}

// stdout of a command, trimmed; "" on failure.
string _cmdOut(string bin, string[] args) {
    try {
        ProcessResult r = new Process(bin).Args(args).Stderr(Stdio.Null()).Run();
        if (r.ExitCode != 0) { return ""; }
        return r.Stdout.Trim();
    } catch (Exception e) { return ""; }
}

// major.minor → comparable int (1.79 → 1079); only the first two components.
int _verKey(string ver) {
    string[] parts = ver.Split(".");
    int major = 0;
    int minor = 0;
    if (parts.Length >= 1) { major = _parseIntOr(parts[0], 0); }
    if (parts.Length >= 2) { minor = _parseIntOr(parts[1], 0); }
    return major * 1000 + minor;
}

int _parseIntOr(string s, int fallback) {
    try { return int.Parse(s); } catch (Exception e) { return fallback; }
}

// ── cross-platform toolchain checks (warning-only) ───────────────────────────

void _checkRust(TomlValue toml) {
    if (!_have("rustc")) { ConsoleError.WriteLine("error: rustc not found. Install via https://rustup.rs"); return; }
    string wantChannel = _vget(toml, "toolchain.rust.channel");
    string wantMin = _vget(toml, "toolchain.rust.min_version");
    // rustc --version → "rustc 1.79.0 (...)"
    string vline = _cmdOut("rustc", new string[]{ "--version" });
    string actual = _nthWord(vline, 1);
    if (actual.Length == 0) { ConsoleError.WriteLine("warning: cannot parse rustc version; skip check"); return; }
    if (_verKey(actual) < _verKey(wantMin)) {
        ConsoleError.WriteLine("warning: rustc " + actual + " < versions.toml min " + wantMin + " (" + wantChannel + " channel)");
        ConsoleError.WriteLine("         consider: rustup update " + wantChannel);
    } else {
        Console.WriteLine("  ✓ rustc " + actual + " (≥ " + wantMin + ")");
    }
}

void _checkNode(TomlValue toml) {
    if (!_have("node")) { return; }   // only wasm tests need node; silent skip
    string wantMin = _vget(toml, "toolchain.node.min_version");
    string v = _cmdOut("node", new string[]{ "-v" });   // "v22.11.0"
    if (v.StartsWith("v")) { v = v.Substring(1); }
    int major = _parseIntOr(_nthDot(v, 0), 0);
    if (major > 0 && major < _parseIntOr(wantMin, 0)) {
        ConsoleError.WriteLine("warning: node v" + v + " < versions.toml min v" + wantMin);
    } else {
        Console.WriteLine("  ✓ node v" + v);
    }
}

string _nthWord(string s, int n) {
    string[] w = s.Split(" ");
    if (n < w.Length) { return w[n]; }
    return "";
}

// _firstLine (first line of a string) lives in the shared xtask_golden.z42.

string _nthDot(string s, int n) {
    string[] p = s.Split(".");
    if (n < p.Length) { return p[n]; }
    return "";
}

// ── rust target / cargo crate ensure ─────────────────────────────────────────

int _ensureRustTarget(string t, string mode) {
    string installed = _cmdOut("rustup", new string[]{ "target", "list", "--installed" });
    if (_hasLine(installed, t)) {
        Console.WriteLine("  ✓ rust target " + t);
        return 0;
    }
    if (mode == "check") { ConsoleError.WriteLine("  ✗ rust target " + t + " (missing)"); return 1; }
    Console.WriteLine("  rustup target add " + t);
    return _exec(new Process("rustup").Arg("target").Arg("add").Arg(t));
}

int _ensureCargoInstall(string crate, string bin, string mode) {
    if (_have(bin)) { Console.WriteLine("  ✓ " + bin); return 0; }
    if (mode == "check") { ConsoleError.WriteLine("  ✗ " + bin + " (missing; cargo install " + crate + " --locked)"); return 1; }
    Console.WriteLine("  cargo install " + crate + " --locked");
    return _exec(new Process("cargo").Arg("install").Arg(crate).Arg("--locked"));
}

bool _hasLine(string text, string want) {
    foreach (var line in text.Split("\n")) {
        if (line.Trim() == want) { return true; }
    }
    return false;
}

// ── android ──────────────────────────────────────────────────────────────────

string _ndkInstallDir(string root, TomlValue toml) {
    return Path.Join(root, _vget(toml, "build.android.install_root") + "/ndk/" + _vget(toml, "build.android.ndk.version"));
}

string _resolveNdkHome(string root, TomlValue toml) {
    string local = _ndkInstallDir(root, toml);
    if (Directory.Exists(local)) { return local; }
    string env = Environment.GetEnvironmentVariable("ANDROID_NDK_HOME") ?? "";
    if (env.Length > 0 && Directory.Exists(env)) { return env; }
    return "";
}

// mode: "install" | "check"（check 供 deps check 复用，verify-only 不装）。
int _setupAndroid(string root, TomlValue toml, string mode, bool force) {
    Console.WriteLine("── android ──");
    int rc = 0;
    // native cross-compile essentials: rust targets + cargo-ndk
    foreach (var t in _vgetList(toml, "platform.android.rust_targets")) {
        int c = _ensureRustTarget(t, mode); if (c != 0) { rc = c; }
    }
    int cc = _ensureCargoInstall("cargo-ndk", "cargo-ndk", mode); if (cc != 0) { rc = cc; }

    // build SDK (JDK + cmdline-tools + platforms + build-tools + platform-tools + NDK)
    if (mode == "check") {
        int c = _checkAndroidBuildSdk(root, toml); if (c != 0) { rc = c; }
    } else {
        int c = _depsInstallAndroidSdk(force, "build"); if (c != 0) { rc = c; }
    }
    return rc;
}

// Verify-only: JDK + NDK + the build SDK packages (platforms / build-tools) present.
int _checkAndroidBuildSdk(string root, TomlValue toml) {
    int rc = 0;
    int jdkMin = _parseIntOr(_vget(toml, "build.android.jdk_min"), 0);
    if (_have("javac")) {
        int jdkMajor = _parseIntOr(_nthDot(_nthWord(_cmdOut("javac", new string[]{ "-version" }), 1), 0), 0);
        if (jdkMajor < jdkMin) { ConsoleError.WriteLine("  ✗ JDK " + jdkMajor.ToString() + " < required " + jdkMin.ToString()); rc = 1; }
        else { Console.WriteLine("  ✓ JDK " + jdkMajor.ToString() + " (≥ " + jdkMin.ToString() + ")"); }
    } else {
        ConsoleError.WriteLine("  ✗ javac not on PATH (need JDK " + jdkMin.ToString() + "+)"); rc = 1;
    }
    string ndkVer = _vget(toml, "build.android.ndk.version");
    if (_resolveNdkHome(root, toml).Length > 0) {
        Console.WriteLine("  ✓ NDK " + ndkVer + " at " + _resolveNdkHome(root, toml));
    } else {
        ConsoleError.WriteLine("  ✗ NDK " + ndkVer + " missing (run: z42 xtask.zpkg deps install --os android)"); rc = 1;
    }
    string sdkDir = Path.Join(root, _vget(toml, "build.android.install_root"));
    string platformVer = _vget(toml, "build.android.sdk.platform");
    string btVer = _vget(toml, "build.android.sdk.build_tools");
    if (Directory.Exists(Path.Join(sdkDir, "platforms/" + platformVer))) { Console.WriteLine("  ✓ SDK " + platformVer); }
    else { ConsoleError.WriteLine("  ✗ SDK " + platformVer + " missing"); rc = 1; }
    if (Directory.Exists(Path.Join(sdkDir, "build-tools/" + btVer))) { Console.WriteLine("  ✓ build-tools " + btVer); }
    else { ConsoleError.WriteLine("  ✗ build-tools " + btVer + " missing"); rc = 1; }
    return rc;
}

// ── ios ────────────────────────────────────────────────────────────────────

// mode: "install" | "check"。
int _setupIos(string root, TomlValue toml, string mode) {
    Console.WriteLine("── ios ──");
    int rc = 0;
    foreach (var t in _vgetList(toml, "platform.ios.rust_targets")) {
        int c = _ensureRustTarget(t, mode); if (c != 0) { rc = c; }
    }
    if (toml.Get("build").ContainsKey("ios") && toml.Get("build").Get("ios").ContainsKey("extra_rust_targets")) {
        foreach (var t in _vgetList(toml, "build.ios.extra_rust_targets")) {
            int c = _ensureRustTarget(t, mode); if (c != 0) { rc = c; }
        }
    }
    string xcodeMin = _vget(toml, "build.ios.xcode_min");
    if (_have("xcodebuild")) {
        // `xcodebuild -version` → "Xcode 16.4\nBuild version 16F6"; take line 1, word 1.
        string xv = _nthWord(_firstLine(_cmdOut("xcodebuild", new string[]{ "-version" })), 1);
        Console.WriteLine("  ✓ Xcode " + xv + " (want ≥ " + xcodeMin + ")");
    } else {
        ConsoleError.WriteLine("  ✗ xcodebuild missing (run: xcode-select --install)");
    }
    return rc;
}

// ── wasm ───────────────────────────────────────────────────────────────────

// wasm 平台必备：rust targets + wasm-pack + hermetic node。node 从"用户手动 step"
// 升为 wasm 必备（simplify-xtask-deps, User 裁决 2026-07-07）——wasm 测试面
// （pkg-nodejs smoke + Playwright）没有 node 跑不了。mode: "install" | "check"。
int _setupWasm(string root, TomlValue toml, string mode, bool force) {
    Console.WriteLine("── wasm ──");
    int rc = 0;
    foreach (var t in _vgetList(toml, "platform.wasm.rust_targets")) {
        int c = _ensureRustTarget(t, mode); if (c != 0) { rc = c; }
    }
    int cc = _ensureCargoInstall("wasm-pack", "wasm-pack", mode); if (cc != 0) { rc = cc; }
    if (mode == "check") {
        int kc = _checkWasmNode(root, toml); if (kc != 0) { rc = kc; }
    } else {
        int nc = _depsInstallNode(force); if (nc != 0) { rc = nc; }
    }
    return rc;
}

// wasm 必备的 node presence 校验：hermetic artifacts/tools/node 优先；PATH node
// 版本 ≥ toolchain.node.min_version 也接受。两者皆无 → ✗。
int _checkWasmNode(string root, TomlValue toml) {
    string hermetic = Path.Join(root, "artifacts/tools/node/bin/node");
    if (File.Exists(hermetic)) {
        Console.WriteLine("  ✓ node (hermetic) " + _cmdOut(hermetic, new string[]{ "--version" }));
        return 0;
    }
    string wantMin = _vget(toml, "toolchain.node.min_version");
    if (_have("node")) {
        string v = _cmdOut("node", new string[]{ "-v" });   // "v22.11.0"
        if (v.StartsWith("v")) { v = v.Substring(1); }
        if (_parseIntOr(_nthDot(v, 0), 0) >= _parseIntOr(wantMin, 0)) {
            Console.WriteLine("  ✓ node v" + v + " (PATH, ≥ v" + wantMin + ")");
            return 0;
        }
        ConsoleError.WriteLine("  ✗ node v" + v + " < min v" + wantMin + " (run: deps install --os wasm)");
        return 1;
    }
    ConsoleError.WriteLine("  ✗ node missing (run: deps install --os wasm; wasm test run also auto-installs)");
    return 1;
}
