// xtask — `build runtime`：直接驱动 cargo 构建 z42vm。
namespace Z42Xtask;

using Std.Time;   // Stopwatch — _procStart/_procEnd 进程计时标记

int _buildRuntime() {
    Stopwatch sw = _procStart("build runtime (cargo z42vm)");
    // --locked：Cargo.lock 入库，与 `test runtime` 一致；CI 的 bootstrap 也走这里。
    int __rc = _buildRuntimeProfile("release");
    if (__rc == 0) { _procEnd("build runtime (cargo z42vm)", sw); }
    return __rc;
}


int _buildRuntimeProfile(string profile) {
    int c = _exec(_componentTargets(_componentCargo("build", _root(), profile, _cargoTargetDir(_root()))));
    if (c == 0) { c = _componentBuildCompression(_root(), _detectHostRid(), profile, true, _cargoOutFor(_root(), _detectHostRid(), profile)); }
    if (c == 0) { _componentCopyStd(_cargoOutFor(_root(), _detectHostRid(), profile)); }
    return c;
}
