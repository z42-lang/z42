// xtask — build toolchain / build workload.
//
// Symmetry with `build compiler`↔src/compiler & `build stdlib`↔src/libraries:
//   build workload  ↔ src/toolchain/workload/*  (kind=lib; launcher's deps)
//   build toolchain ↔ src/toolchain/{launcher,builder,devtools,interactive} apphosts
//
// SoT: every toolchain output/publish path is READ from the component's own z42.toml
// (`[build].dist_dir`, `[platform.desktop].publish_dir`), NEVER hardcoded here.
namespace Z42Xtask;

using Std.IO;
using Std.Time;
using Std.Collections;
using Z42.Package;
using Z42.IR;

// Ensure the toolchain build prereqs (z42vm + stdlib + self-contained z42c.driver) EXIST — build only what's
// missing. Unlike `_buildCompiler`, this does NOT force a z42c `--workspace` rebuild on a warm tree:
// `build workload` / `build toolchain` compile the toolchain, not the compiler — a dev who changed z42c runs
// `build compiler` themselves.
int _ensureToolchainDeps(string root) {
    if (!File.Exists(_builtVm(root, "release"))) {
        int r = _buildRuntime(); if (r != 0) { return r; }
    }
    if (!File.Exists(Path.Join(_libsDir(root), "z42.core.zpkg"))) {
        int r = _buildStdlib(); if (r != 0) { return r; }
    }
    if (!File.Exists(Path.Join(_selfContainedDriverDir(root), "z42c.driver.zpkg"))) {
        int r = _buildCompiler(); if (r != 0) { return r; }
    }
    // z42.repl 不单独建：它是 z42.interactive 的私有 path 依赖，z42c build z42.interactive 时自动建闭包并
    // colocate 进 z42i payload（programs/z42i/），不进共享 libs。
    return 0;
}

// 用**调用方给定**的 (vm, driver, libs) 编 z42b 并校验产物。
//
// 为什么参数化而不是让本函数自己解析：各调用点的 vm/driver/libs 来源**各不相同**——
//   test stdlib：支持 `--toolchain` override（ovVm/ovDriver/ovLibs）
//   test compiler：按 profile 取（_driverZpkg(root, profile)）
//   test toolchain builder（manifest 目标夹具）：固定 release
//   package ci：release + `_toolchainCompileLibs`
// **能统一的只有「怎么编 + 怎么校验」，输入不能统一** —— 强行统一就会把 override / profile 语义弄丢。

int _buildZ42bWith(string root, string vm, string driverZpkg, string libs) {
    _syncBuilderPins(root);
    int rc = _exec(_z42cProc(vm, libs, driverZpkg).Arg("build").Arg(_z42bToml()).Arg("--release")
        .WorkingDirectory(root));
    if (rc != 0) { ConsoleError.WriteLine("  ✗ z42b (z42.builder.zpkg) build failed"); return rc; }
    string zpkg = _toolchainZpkg(root, _z42bToml());
    if (!File.Exists(zpkg)) {
        ConsoleError.WriteLine("error: z42.builder.zpkg not found at " + zpkg);
        return 1;
    }
    return 0;
}

// 确保 z42b 已按**当前 z42c** 编好（`build toolchain z42b` 用，`package ci` 消费它的产物：自行解析 release 工具链）。
//
// 为什么无条件重编而非 File.Exists 就跳过：z42b 是 zpkg，必须与当前 z42c 的 zpkg
// 格式一致（strict-pin）——「存在」≠「可用」，上一格式版本的 z42.builder.zpkg 会在
// 运行期被 z42vm 直接拒。而它只是几个小文件的 z42c 增量编译，源未变时近 no-op。
// libs = `_toolchainCompileLibs`（纯 stdlib flat；z42b 的编译器包按名声明、从编译器目录解析，见那里的头注）。
int _ensureZ42b(string root) {
    int pc = _ensureToolchainDeps(root); if (pc != 0) { return pc; }
    return _buildZ42bWith(root, _builtVm(root, "release"), _driverZpkg(root, "release"),
                          _toolchainCompileLibs(root));
}

// ── build workload ───────────────────────────────────────────────────────────
// Compile the workload libs → 各自的 dist（见 `_workloadTomls` 头注）。launcher 的 z42c build 不依赖这一步的
// 产物位置（它走 path 依赖，自己会建），这里保留是因为 `build workload` 本身是个面向人的命令。
// Prereq: z42vm + z42c + stdlib present (build-if-missing; warm ≈ no-op).
int _buildWorkload() {
    string root = _root();
    Stopwatch sw = _procStart("build workload (toolchain workload libs)");
    int pc = _ensureToolchainDeps(root); if (pc != 0) { return pc; }
    string vm = _builtVm(root, "release");
    string z42cDir = _selfContainedDriverDir(root);
    string libs = _toolchainCompileLibs(root);
    foreach (var toml in _workloadTomls()) {
        _vNormal("  workload: " + toml);
        int c = _z42cBuildToml(vm, z42cDir, libs, toml);
        if (c != 0) { ConsoleError.WriteLine("  ✗ workload build failed: " + toml); return c; }
    }
    _procEnd("build workload (toolchain workload libs)", sw);
    return 0;
}

// Build the shared z42 test-agent → app.zpkg (idempotent: skip if present).
string _ensureTestAgent(string root) {
    string toml = Path.Join(root, "src/toolchain/workload/test/agent/z42.testagent.z42.toml");
    string zpkg = _toolchainZpkg(root, toml);   // 按 toml 的 [build] 解析，不写死
    if (File.Exists(zpkg)) { return zpkg; }
    Console.WriteLine("  build test-agent → z42.testagent.zpkg");
    int c = _exec(_releaseZ42c(root).Arg("build").Arg(toml).Arg("--release"));
    if (c != 0) { return ""; }
    return zpkg;
}

// ── build toolchain ──────────────────────────────────────────────────────────
// Validate the managed closure rooted at the app, plus colocated native libraries.
// Other applications may share dist; unrelated managed packages are not payload members.
bool _payloadRelative(string name) {
    if (name.Length == 0 || name.StartsWith("/") || name.Contains(":") || name.Contains("\\")) { return false; }
    foreach (var part in name.Split("/")) {
        if (part.Length == 0 || part == "." || part == "..") { return false; }
    }
    return true;
}

int _payloadMissing(string distDir, string payloadDir, string projName) {
    List<string> queue = new List<string>();
    queue.Add(projName + ".zpkg");
    StrMap seen = new StrMap();
    int cursor = 0;
    int missing = 0;
    while (cursor < queue.Count) {
        string name = queue[cursor]; cursor = cursor + 1;
        if (!_payloadRelative(name) || Path.GetFileName(name) != name || !name.EndsWith(".zpkg")) {
            throw new Exception("unsafe payload dependency: " + name);
        }
        if (!seen.TryAdd(name, "")) { continue; }
        string source = Path.Join(distDir, name);
        if (!File.Exists(source)) {
            if (cursor == 1) { throw new Exception("missing payload application: " + source); }
            continue; // SDK/shared dependencies stay external, as in z42b publish.
        }
        ZpkgInfo info = ZpkgReader.Open(File.ReadAllBytes(source), source);
        if (info == null || info.Name + ".zpkg" != name) { throw new Exception("invalid payload package: " + source); }
        if (cursor != 1 && !File.Exists(Path.Join(payloadDir, name))) {
            ConsoleError.WriteLine("  ✗ payload missing dependency: " + name); missing = missing + 1;
        }
        if (!info.Packed) {
            foreach (var rel in ZpkgReader.ReadIndexedZbcRels(info)) {
                if (!_payloadRelative(rel)) { throw new Exception("unsafe payload member: " + rel); }
                if (!File.Exists(Path.Join(payloadDir, rel))) { missing = missing + 1; }
            }
        }
        queue.AddRange(ZpkgReader.ReadDependencies(info));
    }
    foreach (var name in Directory.Enumerate(distDir)) {
        if ((name.EndsWith(".dylib") || name.EndsWith(".so") || name.EndsWith(".dll"))
            && File.Exists(Path.Join(distDir, name)) && !File.Exists(Path.Join(payloadDir, name))) {
            ConsoleError.WriteLine("  ✗ payload missing native library: " + name); missing = missing + 1;
        }
    }
    return missing;
}

int _assertPayloadComplete(string root, string tomlPath) {
    string abs = _absToml(root, tomlPath);
    string distDir = _toolchainDistDir(root, tomlPath);
    string payloadRel = _tomlField(abs, "platform.desktop.payload", "");
    if (payloadRel.Length == 0) { return 0; }   // legacy flat：zpkg 原地嵌入，无 payload 目录
    string projName = _tomlField(abs, "project.name", "");
    string payloadDir = Path.GetDirectoryName(Path.Join(_desktopPublishDir(root, tomlPath), payloadRel));
    if (!Directory.Exists(distDir) || !Directory.Exists(payloadDir)) {
        ConsoleError.WriteLine("  ✗ payload 完整性: 目录不存在 (dist=" + distDir + " payload=" + payloadDir + ")");
        return 1;
    }
    return _payloadMissing(distDir, payloadDir, projName) > 0 ? 1 : 0;
}

// Publish the toolchain apphosts (launcher / z42b / z42d / z42i + z42c) → each toml's publish_dir. Auto-builds
// workloads first (launcher depends on them). z42b compiled first since it publishes the others. Every
// output/publish location is read from the component toml. 这是 SDK 的全部编译步骤 —— `package dev-sdk` 只把
// 这些产物组装起来。
int _buildToolchain() {
    string root = _root();
    Stopwatch sw = _procStart("build toolchain (apphosts via publish)");
    int wc = _buildWorkload(); if (wc != 0) { return wc; }   // + z42c/stdlib/z42vm prereq
    string vm = _builtVm(root, "release");
    string z42cDir = _selfContainedDriverDir(root);
    string libs = _toolchainCompileLibs(root);
    string rid = _detectHostRid();
    // native apphost stub (shared by every apphost; z42b publish patches a copy).
    int sc = _exec(_cargoRelease(_runtimeCargoConfig())
        .Arg("--manifest-path").Arg("src/toolchain/workload/desktop/platform/apphost/Cargo.toml"));
    if (sc != 0) { ConsoleError.WriteLine("  ✗ apphost stub cargo build failed"); return sc; }
    string cargoOut = _cargoOutFor(root, rid, "release");
    string apphostStub = Path.Join(cargoOut, Platform.IsWindows() ? "apphost.exe" : "apphost");
    // z42b must exist before it can publish the others.
    string builderToml = _z42bToml();
    int bc = _z42cBuildToml(vm, z42cDir, libs, builderToml);
    if (bc != 0) { ConsoleError.WriteLine("  ✗ z42b build failed"); return bc; }
    string z42bZpkg = _toolchainZpkg(root, builderToml);
    // compile + publish each apphost → its own publish_dir (from toml).
    foreach (var toml in _toolchainApphostTomls()) {
        int c = _z42cBuildToml(vm, z42cDir, libs, toml);
        if (c != 0) { ConsoleError.WriteLine("  ✗ compile failed: " + toml); return c; }
        string pubDir = _desktopPublishDir(root, toml);
        _vNormal("  publish: " + toml + " → " + pubDir);
        c = _z42bPublish(vm, z42bZpkg, libs, apphostStub, toml, rid, pubDir);
        if (c != 0) { ConsoleError.WriteLine("  ✗ publish failed: " + toml); return c; }
        c = _assertPayloadComplete(root, toml);
        if (c != 0) { return c; }
    }
    string z42cToml = _z42cDriverToml();
    int zc = _z42bPublish(vm, z42bZpkg, libs, apphostStub, z42cToml, rid, _desktopPublishDir(root, z42cToml));
    if (zc != 0) { ConsoleError.WriteLine("  ✗ z42c apphost publish failed"); return zc; }
    zc = _assertPayloadComplete(root, z42cToml);
    if (zc != 0) { return zc; }
    _procEnd("build toolchain (apphosts via publish)", sw);
    return 0;
}
