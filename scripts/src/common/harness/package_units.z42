// xtask — stdlib [Test] unit layer（lib 级编排在 test/stdlib/runner.z42）。
//
// **转发 z42b** —— `--list` 拿单元清单，再按 jobs 分批并行拉起 `z42b <verb> <toml> --name <unit>`。
// 发现规则与单元编译全部在 z42b 那一侧，xtask 只管并行与聚合。
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

// ── 转发 z42b ────────────────────────────────────────────────────────────────
//
// 每单元一次 `z42b test <真 manifest> --name <unit>`：in-process 编译，父包只建一次、各单元共用缓存。
//
// **并行留在 xtask**：并行测试执行必须分进程（单 VM 内 ModuleLoader 按命名空间去重、first-wins），
// 而 z42b 定位不到自己（`__env_args` 只给 `--` 之后的参数）—— xtask 知道 vm + builder zpkg 路径，
// 所以由它来批量拉起。

// 问 z42b 要单元清单（`--list`：只列不跑）。发现规则只有 z42b 一份，不在 xtask 复制。
// ok=false 表示 z42b 自己报错了（调用方判红）。
string[] _listUnitsViaZ42b(string root, string projToml, string kind, string filter,
                           string mode, TargetTooling tooling, ref bool ok) {
    Process p = tooling.UnitProcess(root, projToml, kind, mode).Arg("--list");
    if (filter.Length > 0) { p = p.Arg("--filter").Arg(filter); }
    ProcessResult r = p.Run();
    if (r.ExitCode != 0) {
        ConsoleError.WriteLine("  ❌ z42b " + kind + " --list 失败 (rc=" + r.ExitCode.ToString() + ")");
        ConsoleError.Write(r.Stderr);
        ok = false;
        return new string[0];
    }
    ok = true;
    return _nonEmptyLines(r.Stdout);
}

string[] _nonEmptyLines(string s) {
    List<string> res = new List<string>();
    foreach (var raw in s.Split("\n")) {
        string t = raw.Trim();
        if (t.Length > 0) { res.Add(t); }
    }
    return res.ToArray();
}

// 并行跑单元：每 `jobs` 个一批 spawn `z42b <verb> <toml> --name <unit>`，等齐后按批内顺序
// 打印（输出顺序确定，不随调度漂移）。返回失败数。
// agg != null → capture 模式（bench 基线）：要 `--format json`，把每次调用的 TestReport 喂给
// 聚合器而不是原样打印：每单元一次调用恰好输出一个 TestReport 对象，正是 `addModuleJson`
// 期待的形状。
int _runUnitsViaZ42b(string root, string projToml, string[] names, string kind,
                     int jobs, string mode, TargetTooling tooling,
                     string lib, MicroBenchAgg agg) {
    bool capture = (agg != null);
    // 产物不落源码树（见 _devTargetOutRoot）；z42b 不认 `--out-root` 时不传（见 _z42bSupportsOutRoot）。
    string outRoot = _z42bSupportsOutRoot(tooling.Vm, tooling.BuilderZpkg, tooling.Libs) ? _devTargetOutRoot(root, projToml, kind) : "";
    int failed = 0;
    int i = 0;
    while (i < names.Length) {
        int bsz = jobs;
        // 第一个单元单独跑：它负责把父包建好，其余单元带 --reuse-parent 复用。z42b 的进程内编译器
        // 无增量，不这样做每个单元都把父包全量重编一遍，而且同批并发的几个进程会同时写同一个父包的
        // build/dist。
        if (i == 0) { bsz = 1; }
        if (i + bsz > names.Length) { bsz = names.Length - i; }
        ProcessHandle[] rh = new ProcessHandle[bsz];
        int b = 0;
        while (b < bsz) {
            Process pr = tooling.UnitProcess(root, projToml, kind, mode).Arg("--name").Arg(names[i + b]);
            if (outRoot.Length > 0) { pr = pr.Arg("--out-root").Arg(outRoot); }
            if (i > 0) { pr = pr.Arg("--reuse-parent"); }
            if (capture) { pr = pr.Arg("--format").Arg("json"); }
            rh[b] = pr.Spawn();
            b = b + 1;
        }
        b = 0;
        while (b < bsz) {
            ProcessResult rr = rh[b].Wait();
            // capture（json 模式）：即使部分 bench 失败，stdout 仍是一个完整 TestReport（逐条带 status）。
            // 只要能解析就聚合（addModuleJson 只收有 bench_stats 的通过项），让部分失败的
            // 单元仍贡献它通过的那些。
            string outp = rr.Stdout.Trim();
            if (capture && outp.StartsWith("{")) {
                agg.addModuleJson(outp, lib);
                string note = (rr.ExitCode != 0) ? " (partial: some benches failed)" : "";
                Console.WriteLine("  captured " + names[i + b] + note);
            } else {
                Console.Write(rr.Stdout);
                if (rr.Stderr.Length > 0) { Console.Write(rr.Stderr); }
            }
            if (rr.ExitCode != 0) {
                failed = failed + 1;
                // 汇总行只给个数（「N file(s) failed」），失败单元的 PASS 行又可能全绿（退出码来自编译期 / 收尾）——
                // 不点名的话只能整段日志人工排查。
                Console.WriteLine("  ✗ " + names[i + b] + " (exit " + rr.ExitCode.ToString() + ")");
            }
            b = b + 1;
        }
        i = i + bsz;
    }
    return failed;
}

// ── z42b 能力探测：`--out-root` ─────────────────────────────────────────────────
//
// xtask 并不总是驱动**同一代**的 z42b：bench A/B（bench-pr.yml 的「Micro A/B gate」base 侧）
// 用本树的 xtask 驱动 **base 树**现建的 z42b，不认这个旗标的 z42b 会直接 `unknown option` 失败。
// 先看 `test --help` 里有没有，没有就不传（产物回落到清单目录旁）。每个 z42b 路径只探测一次。
class Z42bCaps {
    public static string ProbedFor = "";
    public static bool   OutRoot = false;
}

bool _z42bSupportsOutRoot(string vm, string builderZpkg, string libs) {
    if (Z42bCaps.ProbedFor == builderZpkg) { return Z42bCaps.OutRoot; }
    bool ok = false;
    try {
        ProcessResult r = _z42bProc(vm, libs).Arg(builderZpkg).Arg("--").Arg("test").Arg("--help")
            .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
        ok = (r.Stdout + r.Stderr).IndexOf("--out-root") >= 0;
    } catch (Exception e) { ok = false; }
    Z42bCaps.ProbedFor = builderZpkg;
    Z42bCaps.OutRoot = ok;
    return ok;
}
