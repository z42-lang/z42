// Whole-round micro captures share one policy between local runs and CI.
namespace Z42Xtask;

using Std.IO;
using Std.Collections;
using Std.Cli;
using Z42.Project;

class MicroCapture {
    public string Root = "";
    public virtual int Capture(string tree, string vm, string libs, string driver, string output, string owners) {
        // Separate processes keep repo-root and tool-discovery caches isolated per tree.
        var process = new Process("bash").Arg(Path.Join(this.Root.Length > 0 ? this.Root : _root(), ".github/ci/xtask"))
            .Args(new string[]{ "bench", "stdlib", "--json", output, "--no-build", "--mode", "interp",
                "--vm", vm, "--libs", libs, "--driver", driver });
        if (owners.Length > 0) { process.Args(new string[]{ "--owners", owners }); }
        return _execIn(process, tree);
    }
}

int _benchMicroAbAt(string root, BenchCommand cmd, MicroCapture capture) {
    var report = new MicroExecution();
    try {
        int code = _benchMicroAbRun(root, cmd, new MicroTimedCapture(capture, report));
        report.ExitCode = code; report.Outcome = code == 0 ? "success" : "failed";
        return code;
    } finally { report.Save(root); }
}

int _benchMicroAbRun(string root, BenchCommand cmd, MicroCapture capture) {
    if (cmd.BaseVm.Length == 0 || cmd.BaseLibs.Length == 0 || cmd.PrVm.Length == 0 || cmd.PrLibs.Length == 0) {
        ConsoleError.WriteLine("micro A/B requires --base-vm, --base-libs, --pr-vm and --pr-libs"); return 2;
    }
    string owners = _microBenchOwners(cmd);
    Console.WriteLine("micro scope: " + (owners.Length > 0 ? owners : "all packages"));
    string dir = _benchDir(root); Directory.Create(dir);
    var pr = new List<string>(); var baseline = new List<string>();
    var firstSuspects = new List<MicroBenchmarkKey>();
    var diff = new BenchCommand();
    diff.ThresholdTime = cmd.ThresholdTime.Length > 0 ? cmd.ThresholdTime : "0.15";
    string suspects = Path.Join(dir, "micro-suspects.txt");
    string regressions = Path.Join(dir, "micro-regressions.txt");
    if (File.Exists(suspects)) { File.Delete(suspects); }
    if (File.Exists(regressions)) { File.Delete(regressions); }
    // Rounds 2+ recapture only the suspects' packages (fail-safe: an unmappable
    // suspect name keeps the full scope). The resampled verdict requires every
    // first-round suspect in every round, including the confirmation window.
    string resampleOwners = "";
    for (int round = 1; round <= 3; round = round + 1) {
        string suffix = round == 1 ? ".json" : "-r" + round.ToString() + ".json";
        string current = Path.Join(dir, "micro-pr" + suffix); pr.Add(current);
        string previous = Path.Join(dir, "micro-base" + suffix); baseline.Add(previous);
        string scope = round == 1 ? owners : resampleOwners;
        int rc = _microCapturePair(root, cmd, capture, round, current, previous, scope);
        if (rc != 0) { return rc; }
        if (round == 2) { continue; }
        diff.Current = String.Join(",", pr.ToArray()); diff.Baseline = String.Join(",", baseline.ToArray());
        diff.Suspects = round == 1 ? suspects : regressions;
        int verdict = round == 1 ? _benchMicroDiff(diff, null, firstSuspects) : _benchMicroDiff(diff, firstSuspects);
        if (verdict > 1) { return verdict; }
        if (round == 1) {
            if (!File.Exists(suspects)) { throw new Exception("micro round 1 did not write suspects"); }
            if (File.ReadAllText(suspects).Length == 0) {
                Console.WriteLine("✅ micro round 1: no suspects; no resampling needed"); return 0;
            }
            resampleOwners = _microSuspectOwnersSafe(File.ReadAllText(suspects));
            Console.WriteLine("── micro suspects; recapture " + (resampleOwners.Length > 0
                ? "suspect packages (" + resampleOwners + ") for two rounds ──"
                : "two complete rounds (suspects did not map to packages) ──") + "\n" + File.ReadAllText(suspects));
        } else {
            // Rotating single-regression guard: exactly one survivor after k=3 gets
            // one cheap confirmation round; the verdict is recomputed over rounds
            // 2..4 so the round that raised the suspicion cannot alone fail the gate.
            if (verdict == 1 && File.Exists(regressions) && _countLines(File.ReadAllText(regressions)) == 1) {
                Console.WriteLine("── single flagged regression; one confirmation round (verdict over rounds 2-4) ──");
                string r4pr = Path.Join(dir, "micro-pr-r4.json"); pr.RemoveAt(0);
                string r4base = Path.Join(dir, "micro-base-r4.json"); baseline.RemoveAt(0);
                rc = _microCapturePair(root, cmd, capture, 4, r4pr, r4base, resampleOwners);
                if (rc != 0) { return rc; }
                pr.Add(r4pr); baseline.Add(r4base);
                diff.Current = String.Join(",", pr.ToArray()); diff.Baseline = String.Join(",", baseline.ToArray());
                diff.Suspects = "";
                return _benchMicroDiff(diff, firstSuspects);
            }
            return verdict;
        }
    }
    return 2;
}

int _microCapturePair(
    string root, BenchCommand cmd, MicroCapture capture, int round, string current, string previous, string owners
) {
    bool prFirst = _abPrFirst(true, round);
    foreach (var head in new bool[]{ prFirst, !prFirst }) {
        string tree = head ? cmd.PrTree : cmd.BaseTree;
        string vm = head ? cmd.PrVm : cmd.BaseVm;
        string libs = _microPath(root, head ? cmd.PrLibs : cmd.BaseLibs);
        string driver = head ? cmd.PrDriver : cmd.BaseDriver;
        string output = head ? current : previous;
        if (File.Exists(output)) { File.Delete(output); }
        int rc = capture.Capture(_microPath(root, tree), _microPath(root, vm), libs,
            driver.Length > 0 ? _microPath(root, driver) : Path.Join(libs, "z42c.driver.zpkg"), output, owners);
        if (rc != 0) { return rc; }
        if (!File.Exists(output)) { ConsoleError.WriteLine("micro capture did not write " + output); return 2; }
    }
    return 0;
}

int _countLines(string text) {
    int lines = 0;
    foreach (var raw in text.Split("\n")) { if (raw.Trim().Length > 0) { lines = lines + 1; } }
    return lines;
}

// All benchmark-owning package names of THIS repository, sorted — the vocabulary
// suspects map onto. The work root the orchestrator received holds captures, not
// sources, so enumeration always goes through the repository root.
string[] _microAllBenchOwnerNames() {
    var names = new List<string>();
    foreach (var project in _allUnitProjects(_root(), "bench")) { names.Add(ManifestLoader.Load(project).Project.Name); }
    string[] ordered = names.ToArray(); _sortStrings(ordered);
    return ordered;
}

// Fail-safe wrapper: an unreadable vocabulary keeps the full scope instead of
// narrowing (or crashing) the gate.
string _microSuspectOwnersSafe(string suspects) {
    try {
        return _microSuspectOwners(_microAllBenchOwnerNames(), suspects);
    } catch (Exception e) {
        Console.WriteLine("  (suspect packages could not be enumerated — keeping the full scope: " + e.Message + ")");
        return "";
    }
}

// Suspect benchmark names -> owning packages (longest prefix match, deduplicated,
// sorted). Any name that does not map onto a known package returns "" so the
// caller keeps the full scope instead of silently narrowing the gate.
string _microSuspectOwners(string[] ownerNames, string suspects) {
    var matched = new List<string>();
    foreach (var raw in suspects.Split("\n")) {
        string name = raw.Trim();
        if (name.Length == 0) { continue; }
        string owner = "";
        foreach (var candidate in ownerNames) {
            if ((name == candidate || name.StartsWith(candidate + ".")) && candidate.Length > owner.Length) { owner = candidate; }
        }
        if (owner.Length == 0) { return ""; }
        if (!matched.Contains(owner)) { matched.Add(owner); }
    }
    string[] ordered = matched.ToArray(); _sortStrings(ordered);
    return String.Join(",", ordered);
}

string _microPath(string root, string path) { return Path.IsRooted(path) ? path : Path.Join(root, path); }

string _microOwnerNames(string[] projects) {
    var names = new List<string>();
    foreach (var project in projects) { names.Add(ManifestLoader.Load(project).Project.Name); }
    string[] ordered = names.ToArray(); _sortStrings(ordered);
    return String.Join(",", ordered);
}

string _microPlanOwners(FlowConfig cfg, FlowPlan plan) {
    if (!_strIn(_flowOutputs(cfg, plan), "bench_stdlib")) { throw new CliException("plan selects no script benchmarks"); }
    foreach (var step in plan.Steps) {
        if (!step.Prerequisite && _strIn(cfg.Find(step.Id).Outputs, "bench_stdlib") && step.Owner.Length == 0) { return ""; }
    }
    string[] projects = _flowUnitProjects(cfg, plan, "bench", "");
    if (projects.Length == 0) { throw new CliException("plan has no benchmark owners"); }
    return _microOwnerNames(projects);
}

string _microBenchOwners(BenchCommand cmd) {
    if (cmd.Plan.Length > 0 && cmd.Owners.Length > 0) { throw new CliException("choose --plan or --owners"); }
    string root = _root();
    if (cmd.Plan.Length > 0) {
        FlowConfig cfg = _flowConfigFor(root);
        return _microPlanOwners(cfg, _flowReadPlan(cfg, cmd.Plan, root));
    }
    return cmd.Owners.Length == 0 ? "" : _microOwnerNames(_ownerUnitProjects(root, "bench", cmd.Owners));
}
