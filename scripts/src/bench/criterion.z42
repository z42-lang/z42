namespace Z42Xtask;

using Std.IO;
using Std.Json;

int _benchCriterionReport(string home) {
    int regressions = 0;
    foreach (var file in _sortedStrings(Path.GlobRecursive(home, "*/change/estimates.json"))) {
        JsonValue v = JsonValue.Parse(File.ReadAllText(file));
        if (!v.ContainsKey("mean")) { continue; }
        JsonValue mean = v.Get("mean");
        if (!mean.ContainsKey("point_estimate") || !mean.ContainsKey("confidence_interval")) { continue; }
        JsonValue ci = mean.Get("confidence_interval");
        if (!ci.ContainsKey("lower_bound") || !ci.ContainsKey("upper_bound") || mean.Get("point_estimate").IsNull()
            || ci.Get("lower_bound").IsNull() || ci.Get("upper_bound").IsNull()) { continue; }
        double point = mean.Get("point_estimate").AsDouble();
        double lo = ci.Get("lower_bound").AsDouble(); double hi = ci.Get("upper_bound").AsDouble();
        string name = Path.GetFileName(Path.GetDirectoryName(Path.GetDirectoryName(file)));
        string tag = _criterionTag(point, lo);
        if (tag == "REGRESSION") { regressions = regressions + 1; }
        Console.WriteLine(tag + " " + name + ": " + (point * 100.0).ToString() + "% (CI [" + (lo * 100.0).ToString() + "%, " + (hi * 100.0).ToString() + "%], width " + ((hi - lo) * 100.0).ToString() + "pp)");
    }
    Console.WriteLine(regressions.ToString() + " Criterion regressions; informational, does not fail the job");
    return 0;
}

string _criterionTag(double point, double lower) { return lower > 0.25 ? "REGRESSION" : point > 0.25 ? "SUSPECT" : "STABLE"; }
