namespace Z42Xtask;

using Std.Cli;
using Std.IO;
using Std.Regex;

class CiToolOps {
    public virtual ProcessResult Run(string exe, string[] args) {
        try {
            ProcessResult r = new Process(exe).Args(args).Run();
            if (r.ExitCode != 0) { ConsoleError.WriteLine(r.Stdout + r.Stderr); }
            return r;
        } catch (ProcessStartException e) {
            ConsoleError.WriteLine(e.Message);
            return new ProcessResult(exe, 127, "", e.Message, new byte[0], new byte[0]);
        }
    }
}

bool _ciToolVersion(CiToolOps ops, string binary, string name, string version) {
    if (!File.Exists(binary)) { return false; }
    ProcessResult r = ops.Run(binary, new string[]{ "--version" });
    return r.ExitCode == 0 && Regex.Compile("^" + name + " (version )?v?" + version.Replace(".", "\\.") + "($|[ \\r\\n(])").IsMatch(r.Stdout.Trim());
}

class SetupCiToolCommand : Command {
    [Option(help: "installation directory (default: artifacts/tools/<tool>)")] public string Root = "";
    [Option(help: "reinstall even when the pinned version is cached")] public bool Force;
    [Option(help: "validate installed tools without downloading or building")] public bool Check;
    public SetupCiToolCommand(string name) : base(name, "install pinned " + name) {}
    public override int Run() {
        if (this.Check && this.Force) { throw new CliException("--check cannot be combined with --force"); }
        string target = this.Root.Length == 0 ? Path.Join(_root(), "artifacts/tools/" + this.CommandName()) : Path.Normalize(Path.IsRooted(this.Root) ? this.Root : Path.Join(Environment.GetCurrentDirectory(), this.Root));
        string stage = _xtaskWork(_root(), "install-" + this.CommandName());
        if (!this.Check) { _resetDir(stage); }
        try {
            var ops = new CiToolOps();
            int code = this.Check ? (_ciToolsReady(_root(), target, this.CommandName(), ops) ? 0 : 1)
                : this.CommandName() == "book-tools" ? _ciInstallBooks(_root(), target, stage, _detectHostRid(), this.Force, ops)
                : _ciInstallWasm(_root(), target, stage, this.Force, ops);
            if (code != 0) { return code; }
            string bin = Path.Join(target, "bin");
            string output = Environment.GetEnvironmentVariable("GITHUB_PATH", "");
            if (output.Length > 0) { File.AppendAllText(output, bin + "\n"); }
            Console.WriteLine((this.Check ? "Validated tools: " : "Installed tools: ") + bin); return 0;
        } finally { if (!this.Check) { Directory.Delete(stage, true); } }
    }
}

bool _ciToolsReady(string root, string target, string kind, CiToolOps ops) {
    string suffix = Platform.OS() == "windows" ? ".exe" : "";
    bool valid = kind == "wasm-opt" ? _ciWasmReady(root, target, ops)
        : _ciToolVersion(ops, Path.Join(target, "bin/mdbook" + suffix), "mdbook", _vRead(root, "toolchain.mdbook.version"))
            && _ciToolVersion(ops, Path.Join(target, "bin/mdbook-mermaid" + suffix), "mdbook-mermaid", _vRead(root, "toolchain.mdbook-mermaid.version"));
    if (!valid) { ConsoleError.WriteLine("Missing or invalid pinned " + kind + " installation: " + target); }
    return valid;
}
