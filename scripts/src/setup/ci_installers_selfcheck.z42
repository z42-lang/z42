namespace Z42Xtask;

using Std.IO;
using Std.Collections;

class CiToolFixture : CiToolOps {
    public string Mode = "valid";
    public string Archive = "";
    public int FailAt;
    public List<string> Calls = new List<string>();
    public override ProcessResult Run(string exe, string[] args) {
        this.Calls.Add(exe + " " + String.Join(" ", args));
        if (this.FailAt > 0 && this.Calls.Count == this.FailAt) { return _ciResult(23, "failed fixture process"); }
        if (exe == "curl") {
            if (this.Mode == "http" || this.Mode == "failure") { return _ciResult(22, ""); }
            string path = args[args.Length - 2];
            if (this.Mode == "html") { File.WriteAllText(path, "<html>unavailable</html>"); }
            else { File.Copy(this.Archive, path); }
        } else if (exe == "tar") {
            return new Process(exe).Args(args).Run();
        } else if (exe == "install") {
            File.Copy(args[2], args[3]);
        } else if (exe == "cargo") {
            if (this.Mode == "failure") { return _ciResult(37, ""); }
            _ciWrite(args[6], "bin/" + args[1], args[1] + " v" + args[3]);
        } else if (exe == "cmake" && args[0] == "--build") {
            if (this.Mode == "failed-build") { return _ciResult(27, ""); }
            _ciWrite(args[1], "bin/wasm-opt", "wasm-opt version " + (this.Mode == "wrong-version" ? "129" : _vRead(_root(), "toolchain.binaryen.version")));
        } else if (exe != "git" && exe != "cmake") {
            _gateAssert(args.Length == 1 && args[0] == "--version", "version probe has no shell arguments");
            return _ciResult(0, File.ReadAllText(exe));
        }
        return _ciResult(0, "");
    }
}

int _ciInstallerChecks(string kind) {
    try {
        if (kind == "book" || kind == "all") { _ciBookInstallerChecks(); }
        if (kind == "wasm" || kind == "all") { _ciWasmInstallerChecks(); }
        return 0;
    } catch (Exception e) { ConsoleError.WriteLine("CI installer: " + e.Message); return 1; }
}

void _ciBookInstallerChecks() {
    string dir = _xtaskWork(_root(), "ci book installer"); _resetDir(dir);
    try {
        foreach (var name in new string[]{ "mdbook", "mdbook-mermaid" }) {
            _ciWrite(dir, "archive/" + name, name + " v" + _vRead(_root(), "toolchain." + name + ".version"));
        }
        string archive = Path.Join(dir, "valid.tgz");
        new Process("tar").Args(new string[]{ "-czf", archive, "-C", Path.Join(dir, "archive"), "mdbook", "mdbook-mermaid" }).Run().EnsureSuccess();
        _gateAssert(!_ciToolVersion(new CiToolFixture(), Path.Join(dir, "archive/mdbook"), "mdbook", "0.4.4"), "version matching rejects numeric prefixes");
        foreach (var mode in new string[]{ "valid", "http", "html", "failure", "other-host" }) {
            string target = Path.Join(dir, mode); var ops = new CiToolFixture(); ops.Mode = mode; ops.Archive = archive;
            int code = _ciInstallBooks(_root(), target, dir, mode == "other-host" ? "macos-arm64" : "linux-x64", false, ops);
            _gateAssert(code == (mode == "failure" ? 37 : 0), "book installer propagates " + mode);
            string calls = String.Join("\n", ops.Calls.ToArray());
            _gateAssert(calls.Contains("cargo install mdbook ") == (mode != "valid"), "release avoids cargo; invalid download falls back");
            if (mode == "failure") { _gateAssert(!calls.Contains("mdbook-mermaid"), "first error stops the second installer"); }
            else {
                _gateAssert(_ciToolVersion(ops, Path.Join(target, "bin/mdbook"), "mdbook", _vRead(_root(), "toolchain.mdbook.version")), "book version validated");
                int before = ops.Calls.Count;
                _gateAssert(_ciInstallBooks(_root(), target, dir, "linux-x64", false, ops) == 0 && ops.Calls.Count == before + 2, "cached books only probe versions");
            }
        }
    } finally { Directory.Delete(dir, true); }
    Console.WriteLine("  ✓ book installer: release, HTTP/HTML fallback, cache and cargo failure");
}

void _ciWasmInstallerChecks() {
    string dir = _xtaskWork(_root(), "ci wasm installer"); _resetDir(dir);
    try {
        for (int fail = 1; fail <= 6; fail = fail + 1) {
            string target = Path.Join(dir, "failure " + fail.ToString()); var failed = new CiToolFixture(); failed.FailAt = fail;
            _gateAssert(_ciInstallWasm(_root(), target, dir, false, failed) == 23 && failed.Calls.Count == fail,
                "every git/configure/build failure stops immediately with its exit code");
        }
        foreach (var mode in new string[]{ "build", "failed-build", "wrong-version", "stale-cache" }) {
            string target = Path.Join(dir, mode); string stage = Path.Join(dir, mode + " stage"); Directory.Create(stage);
            var ops = new CiToolFixture(); ops.Mode = mode;
            if (mode == "stale-cache") { _ciWrite(target, "bin/wasm-opt", "wasm-opt version 129"); }
            int code = _ciInstallWasm(_root(), target, stage, false, ops);
            int expected = mode == "failed-build" ? 27 : mode == "wrong-version" ? 1 : 0;
            _gateAssert(code == expected, "wasm installer propagates " + mode);
            string calls = String.Join("\n", ops.Calls.ToArray());
            _gateAssert(calls.Contains(_vRead(_root(), "toolchain.binaryen.revision")) && calls.Contains("-DBUILD_SHARED_LIBS=OFF") && calls.Contains("--target wasm-opt --parallel 2"), "pinned static source build");
            if (expected == 0) {
                int before = ops.Calls.Count;
                _gateAssert(_ciInstallWasm(_root(), target, stage, false, ops) == 0 && ops.Calls.Count == before + 1, "validated revision cache avoids rebuild");
                _ciWrite(target, "revision", "stale revision"); before = ops.Calls.Count;
                _gateAssert(_ciInstallWasm(_root(), target, stage, false, ops) == 0 && ops.Calls.Count > before + 1, "wrong revision rebuilds even with matching version");
            } else { _gateAssert(!File.Exists(Path.Join(target, "revision")), "failed installs never publish a cache receipt"); }
        }
    } finally { Directory.Delete(dir, true); }
    Console.WriteLine("  ✓ wasm installer: pinned static build, cache, version and failure");
}
