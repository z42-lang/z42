namespace Z42Xtask;

using Std.IO;

int _checkFlows() {
    try {
        FlowConfig cfg = _flowLoad(Path.Join(_root(), "scripts/flows.toml"));
        _flowPlannerChecks(cfg);
        _flowGitChecks(cfg);
        _ciSelectionChecks(cfg);
        _ciRetryChecks();
        _ciUploadChecks();
        _ciBootstrapChecks();
        _ciGoldenChecks();
        if (_ciInstallerChecks("all") != 0) { return 1; }
        _checkChangedPlans(cfg);
        _checkOutsideGatePlans(cfg);
        _selfcheckChangedGit();
        Console.WriteLine("✓ flows: configuration, ownership, impact, prerequisites, fallback");
        return 0;
    } catch (Exception e) { ConsoleError.WriteLine("flows: " + e.Message); return 1; }
}

void _flowPlannerChecks(FlowConfig cfg) {
    string root = _root();
    _gateAssert(_componentCargoProfile(root, "debug") == "dev" && _componentDirName(root, "debug") == "debug", "debug build prerequisite separates Cargo profile from output directory");
    string[] libraries = _flowLocalCommands(cfg, _flowSelect(cfg, new string[]{ "src/libraries/z42.core/src/String.z42", "src/libraries/z42.io/src/Process.z42" }, root));
    _gateAssert(_strIn(libraries, "xtask test stdlib z42.core") && _strIn(libraries, "xtask test stdlib z42.io"), "impact groups preserve each workspace owner");
    FlowPlan runtime = _flowSelect(cfg, new string[]{ "src/runtime/tests/native.rs" }, root);
    _gateAssert(_flowHas(runtime.Steps, "runtime") && !_flowHas(runtime.Steps, "e2e"), "private runtime stays narrow");
    _gateAssert(!_strIn(_flowOutputs(cfg, runtime), "platform"), "private runtime does not package");
    FlowPlan production = _flowSelect(cfg, new string[]{ "src/runtime/tests/data/numz42-c/numz42.c" }, root);
    _gateAssert(_flowHas(production.Steps, "e2e") && _strIn(_flowOutputs(cfg, production), "platform"), "build.rs C input keeps consumers");
    FlowPlan sdk = _flowSelect(cfg, new string[]{ "scripts/src/test/sdk/verify.z42", "unknown.config" }, root);
    _gateAssert(_flowHas(sdk.Steps, "green") && _flowHas(sdk.Steps, "sdk"), "full gate preserves external SDK checks");
    FlowPlan docs = _flowSelect(cfg, new string[]{ "README.md", "docs/internals/src/devinfra/ci.md" }, root);
    _gateAssert(docs.DocsOnly && !docs.Publish && _flowHas(docs.Steps, "docs"), "docs select actual validation");
    FlowPlan learn = _flowSelect(cfg, new string[]{ "docs/learn/src/basics.md", "README.md" }, root);
    _gateAssert(!learn.DocsOnly && _flowHas(learn.Steps, "learn"), "learn keeps transcripts");
    string minimal = "version = 1\nfull = [\"check\"]\n[flows.check]\ncommand = [\"check\", \"flows\"]\nrequires = [\"build\"]\n[flows.build]\naffects = [\"unrelated\"]\n[flows.unrelated]\n[[inputs]]\nid = \"test\"\ninclude = [\"tests/**\"]\nselect = [\"check\"]\n";
    FlowConfig tiny = _flowParse(minimal);
    FlowPlan p = _flowSelect(tiny, new string[]{ "tests/deleted file.z42" }, root);
    _gateAssert(p.Steps.Length == 2 && p.Steps[0].Id == "build" && p.Steps[1].Id == "check", "requires sorts but never propagates impact");
    FlowConfig dual = _flowParse(minimal.Replace("select = [\"check\"]", "select = [\"check\", \"build\"]").Replace("[flows.build]", "[flows.build]\noutputs = [\"build_changed\"]"));
    _gateAssert(_strIn(_flowOutputs(dual, _flowSelect(dual, new string[]{ "tests/case.z42" }, root)), "build_changed"), "an impacted node retains its role when also required");
    var argv = new FlowStep("check", "owner with spaces", "", "argv regression", false);
    string[] expanded = _flowExpandArgs(new string[]{ "test", "stdlib", "{owner}" }, argv);
    _gateAssert(expanded.Length == 3 && expanded[2] == argv.Owner, "command context preserves argument boundaries");
    tiny.Find("check").Command = new string[]{ "check", "xtask-no-such-check" };
    tiny.Find("unrelated").Command = new string[]{ "check", "versions" };
    _gateAssert(_flowExecute(tiny, new FlowStep[]{ argv, new FlowStep("unrelated", "", "", "later", false) }, false) == 2, "flow execution preserves the first failing command exit");
    _flowExpectBad(minimal.Replace("requires = [\"build\"]", "requires = [\"missing\"]"), "unknown reference");
    _flowExpectBad(minimal.Replace("[flows.build]", "[flows.build]\nrequires = [\"check\"]"), "execution cycle");
    _flowExpectBad(minimal.Replace("[flows.unrelated]", "[flows.unrelated]\naffects = [\"build\"]"), "impact cycle");
    FlowPlan unknownScript = _flowSelect(cfg, new string[]{ "scripts/src/common/new-owner.z42" }, root);
    _gateAssert(_strIn(_flowOutputs(cfg, unknownScript), "platform") && _flowHas(unknownScript.Steps, "sdk"), "unclassified scripts retain full CI and SDK obligations");
    _gateAssert(_strIn(_flowLocalCommands(cfg, _flowSelect(cfg, new string[]{ "scripts/src/package/desktop.z42" }, root)), "xtask package sdk --verify"), "local packaging changes verify SDK outside GREEN");
    foreach (var helper in new string[]{ "scripts/src/common/cargo_artifacts.z42", "scripts/src/common/cargo_capture.rs" }) {
        FlowPlan capture = _flowSelect(cfg, new string[]{ helper }, root);
        _gateAssert(capture.Publish && _flowHas(capture.Steps, "sdk") && _flowHas(capture.Steps, "green") && _strIn(_flowOutputs(cfg, capture), "platform"), "Cargo artifact helpers select SDK and platform publication");
    }
    FlowPlan fullPlan = _flowSelect(cfg, new string[]{ "scripts/src/test/gate.z42" }, root);
    _gateAssert(_flowJobSteps(cfg, fullPlan, "compiler-checks").Length > 0 && _strIn(_flowOutputs(cfg, fullPlan), "stdlib"), "full gate retains delegated CI obligations");
    _flowExpectBad(minimal.Replace("command =", "ci_command =").Replace("[\"check\", \"flows\"]", "[\"bash\"]"), "external CI command");
    _flowExpectBad(minimal.Replace("command =", "commnad ="), "unknown field");
    _flowExpectBad(minimal.Replace("version = 1", "version = 2"), "schema version");
}

void _flowExpectBad(string text, string why) {
    bool rejected = false;
    try { _flowParse(text); } catch (Exception e) { rejected = true; }
    _gateAssert(rejected, "flow config rejects " + why);
}

// Existing local change contracts are checked on FlowPlan directly, once in the flows stage.
void _checkChangedPlans(FlowConfig cfg) {
    string root = _root();
    _gateAssert(String.Join(";", _flowTestCommands(new string[]{ "README.md", ".gitignore" })) == "xtask test docs links", "documentation gets local validation");
    FlowPlan mixed = _flowSelect(cfg, new string[]{ "src/libraries/z42.core/tests/a.z42", "src/runtime/tests/a.rs", "src/libraries/z42.core/tests/b.z42" }, root);
    string[] commands = _flowLocalCommands(cfg, mixed);
    _gateAssert(commands.Length == 2 && _strIn(commands, "xtask test stdlib z42.core") && _strIn(commands, "xtask test runtime"), "owner commands deduplicate and keep runtime outside GREEN");
    string skip = _flowSkipStages(cfg, mixed);
    _gateAssert(!_skipHas(skip, "stdlib") && !_skipHas(skip, "rust-units") && _skipHas(skip, "compiler"), "mixed inputs use the same stage union as CI");
    foreach (var member in new string[]{ "z42c.emission", "z42.package", "z42.scripting" }) {
        FlowPlan plan = _flowSelect(cfg, new string[]{ "src/compiler/" + member + "/tests/unit/a.z42" }, root);
        _gateAssert(String.Join(",", _flowStages(cfg, plan)) == "compiler,stdlib", "compiler private tests keep both discovery formats");
    }
    FlowPlan bench = _flowSelect(cfg, new string[]{ "src/compiler/z42c.optimization/benches/cfg_bench.z42" }, root);
    _gateAssert(String.Join(",", _flowStages(cfg, bench)) == "bench,compiler", "private compiler benchmarks keep codegen consumers");
    FlowPlan source = _flowSelect(cfg, new string[]{ "src/compiler/z42c.optimization/src/IrOpt.z42" }, root);
    _gateAssert(_strIn(_flowStages(cfg, source), "stdlib"), "production compiler source keeps consumers");
    _gateAssert(_strIn(_flowTestCommands(new string[]{ "examples/basics/hello/source.z42" }), "xtask test docs examples basics/hello"), "chapter context survives planning");
    foreach (var file in new string[]{ "native_interop_e2e.rs", "data/embedding_hello/source.z42" }) {
        FlowPlan plan = _flowSelect(cfg, new string[]{ "src/runtime/tests/" + file }, root);
        _gateAssert(String.Join(",", _flowStages(cfg, plan)) == "rust-units", "private runtime keeps Rust coverage");
    }
    FlowPlan native = _flowSelect(cfg, new string[]{ "src/runtime/tests/data/numz42-c/numz42.c" }, root);
    _gateAssert(_strIn(_flowStages(cfg, native), "stdlib"), "build.rs C input changes consumers");
}

void _checkOutsideGatePlans(FlowConfig cfg) {
    string root = _root(); string sdk = "scripts/src/test/sdk/verify.z42";
    foreach (var path in new string[]{ sdk, "src/toolchain/launcher/tests/fixtures/package/case/expect.toml", "scripts/install-z42.sh" }) {
        FlowPlan plan = _flowSelect(cfg, new string[]{ path }, root);
        _gateAssert(!_flowHas(plan.Steps, "green") && _flowLocalSteps(cfg, plan).Length == 1 && _flowStages(cfg, plan).Length == 0, "SDK verification belongs outside GREEN");
        _gateAssert(String.Join(";", _flowLocalCommands(cfg, plan)) == "xtask package sdk --verify", "SDK selects verification command");
    }
    foreach (var order in new string[]{ "first", "last" }) {
        string[] paths = order == "first" ? new string[]{ "unknown.config", sdk } : new string[]{ sdk, "unknown.config" };
        FlowPlan plan = _flowSelect(cfg, paths, root);
        string[] commands = _flowLocalCommands(cfg, plan);
        _gateAssert(commands[0] == "xtask test" && _strIn(commands, "xtask package sdk --verify") && _strIn(commands, "xtask test runtime"), "full fallback preserves external obligations in either order");
        _gateAssert(_flowSkipStages(cfg, plan).Length == 0, "full fallback keeps every scoped stage");
    }
    _gateAssert(_flowHas(_flowSelect(cfg, new string[]{ "scripts/src/package/desktop.z42" }, root).Steps, "green"), "production packaging keeps full GREEN");
    _gateAssert(_flowTestCommands(new string[]{ "scripts/src/test/sdk/README.md" })[0] == "xtask test docs links", "SDK docs route to docs validation");
}

string[] _flowTestCommands(string[] changed, string root = "") {
    if (root.Length == 0) { root = _root(); }
    FlowConfig cfg = _flowConfigFor(root);
    return _flowLocalCommands(cfg, _flowSelect(cfg, changed, root));
}
