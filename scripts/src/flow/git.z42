namespace Z42Xtask;

using Std.IO;
using Std.Json;
using Std.Crypto;
using Std.Encoding;

string _flowDigest(string text) { return Sha256.HashStringHex(text); }

string _flowCommit(string root, string reference) {
    return _gitOutput(new string[]{ "-C", root, "rev-parse", "--verify", reference + "^{commit}" }).Trim();
}

string[] _flowDiff(string root, string base_, string head) {
    return _dedupeNonEmpty(_gitOutput(new string[]{ "-C", root, "diff", "--no-relative", "--no-renames", "--name-only", "-z", base_, head, "--" }).Split("\0"));
}

string _flowSnapshot(string root) {
    string text = _gitOutput(new string[]{ "-C", root, "status", "--porcelain=v1", "-z", "--untracked-files=all" });
    text = text + _gitOutput(new string[]{ "-C", root, "diff", "--no-ext-diff", "--binary", "HEAD", "--" });
    foreach (var file in _changedFiles("HEAD", root)) {
        string path = Path.Join(root, file);
        if (File.Exists(path)) { text = text + "\0" + file + "\0" + _flowDigestBytes(path); }
    }
    return _flowDigest(text);
}

string _flowDigestBytes(string path) { return Hex.Encode(Sha256.Hash(File.ReadAllBytes(path))); }

FlowPlan _flowCreate(FlowConfig cfg, FlowPlanCommand options, string root) {
    string base_ = options.Base; string head = options.Head;
    string policy = head.Length == 0 ? "local" : "commits";
    bool full = options.Full;
    string fallback = "";
    if (options.EventFile.Length > 0) {
        JsonValue ev = JsonValue.Parse(File.ReadAllText(options.EventFile));
        string name = Environment.GetEnvironmentVariable("GITHUB_EVENT_NAME", "");
        head = Environment.GetEnvironmentVariable("GITHUB_SHA", "HEAD");
        policy = "ci";
        if (name == "pull_request") { base_ = ev.Get("pull_request").Get("base").Get("sha").AsString(); }
        else if (name == "push") { base_ = ev.Get("before").AsString(); }
        else { full = true; fallback = "event requires full validation: " + name; }
        if (base_.Length == 0 || base_ == "0000000000000000000000000000000000000000") {
            full = true; fallback = "missing event base";
        }
    }
    if (base_.Length == 0) { base_ = "HEAD"; }
    string[] files = new string[0];
    string resolvedBase = "";
    string resolvedHead = _flowCommit(root, head.Length == 0 ? "HEAD" : head);
    try {
        if (!full) {
            // Shallow CI checkouts may not contain the event's base commit.
            if (policy == "ci") {
                ProcessResult fetch = new Process("git").Arg("-C").Arg(root).Arg("fetch").Arg("--no-tags").Arg("--depth=1").Arg("origin").Arg(base_).Run();
                if (fetch.ExitCode != 0) { throw new Exception("cannot fetch event base"); }
            }
            resolvedBase = _flowCommit(root, base_);
            if (options.MergeBase) { resolvedBase = _gitOutput(new string[]{ "-C", root, "merge-base", resolvedBase, resolvedHead }).Trim(); }
            files = policy == "local" ? _changedFiles(resolvedBase, root) : _flowDiff(root, resolvedBase, resolvedHead);
        }
    } catch (Exception e) {
        full = true; fallback = "cannot read diff: " + e.Message;
    }
    FlowPlan plan = _flowSelect(cfg, files, root, full);
    plan.Base = resolvedBase; plan.Head = resolvedHead; plan.Policy = policy;
    plan.Fallback = fallback; plan.Full = full;
    if (policy == "ci") {
        plan.Event = Environment.GetEnvironmentVariable("GITHUB_EVENT_NAME", "");
        plan.ReleaseRequired = Environment.GetEnvironmentVariable("XTASK_RELEASE_REQUIRED", "");
    }
    if (policy == "local") { plan.Tree = _flowSnapshot(root); }
    return plan;
}
