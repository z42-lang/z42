// Local change commands and GREEN skips consume the same flow plan as CI.
namespace Z42Xtask;

using Std.IO;
using Std.Time;

int _testChangedRun(string base_, bool dryRun) {
    Stopwatch sw = _procStart("test changed");
    Console.WriteLine("[test-changed] base = " + base_);
    string root;
    string[] changed;
    try {
        root = _changedGitRoot();
        changed = _changedFiles(base_, root);
    } catch (Exception e) {
        ConsoleError.WriteLine("[test-changed] error: " + e.Message);
        return 2;
    }
    if (changed.Length == 0) {
        Console.WriteLine("[test-changed] no changed files; nothing to run");
        return 0;
    }
    FlowConfig cfg = _flowConfigFor(root);
    FlowPlan plan = _flowSelect(cfg, changed, root);
    Console.WriteLine("[test-changed] changed files (" + changed.Length.ToString() + "):");
    foreach (var file in changed) { Console.WriteLine("  " + file); }
    Console.WriteLine("[test-changed] plan:");
    foreach (var command in _flowLocalCommands(cfg, plan)) { Console.WriteLine("  → " + command); }
    if (dryRun) {
        _changedStageSkips(cfg, plan);
        Console.WriteLine("[test-changed] --dry-run: not executing");
        return 0;
    }
    int rc = _flowExecute(cfg, _flowLocalSteps(cfg, plan), false);
    if (rc == 0) { _procEnd("test changed", sw); }
    return rc;
}

// Explicit change runs fail on unreadable Git inputs; incremental GREEN retains every stage.
string _changedGateSkips(string base_) {
    Console.WriteLine("[test --changed] base = " + base_);
    string root;
    string[] changed;
    try {
        root = _changedGitRoot();
        _flowCommit(root, base_);
        changed = _changedFiles(base_, root);
    } catch (Exception e) {
        Console.WriteLine("[test --changed] 无法读取改动 —— 全跑: " + e.Message);
        return "";
    }
    FlowConfig cfg = _flowConfigFor(root);
    return _changedStageSkips(cfg, _flowSelect(cfg, changed, root));
}

string _changedStageSkips(FlowConfig cfg, FlowPlan plan) {
    string need = String.Join(",", _flowStages(cfg, plan));
    string skip = _flowSkipStages(cfg, plan);
    Console.WriteLine("[test --changed] " + plan.Files.Length.ToString() + " 个改动文件；需要的重 stage: "
        + (need.Length == 0 ? "（无）" : need) + "；跳过: " + (skip.Length == 0 ? "（无）" : skip));
    return skip;
}

int _testChanged(string baseArg, bool dryRun) {
    string base_ = baseArg.Length > 0 ? baseArg : Environment.GetEnvironmentVariable("Z42_TEST_CHANGED_BASE", "HEAD");
    return _testChangedRun(base_.Length == 0 ? "HEAD" : base_, dryRun);
}
