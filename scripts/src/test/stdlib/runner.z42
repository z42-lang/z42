// xtask — `test stdlib|bench [lib]`：stdlib（与编译器域库）的 [Test] / [Benchmark] 跑测器。
// 备工具链后逐包转发 z42b（发现 / 编译 / 运行都在 z42b；单元级并行见 common/harness/package_units.z42），
// 汇总结果；`--shard k/n` 按单元数均衡分包。
namespace Z42Xtask;

using Std.IO;
using Std.Time;
using Std.Collections;
using Std.Cli;

int _testLib(LibUnitsCommand c, string kind, string jsonOut) {
    Stopwatch sw = _procStart((kind == "bench") ? "bench stdlib" : "test stdlib");
    string lib = c.Lib;
    string[] projects;
    int[] sh = _parseShard(c.Shard);
    if (sh[1] > 0 && lib.Length > 0) {
        throw new CliException("--shard cannot be combined with a single library");
    }
    if (c.Plan.Length > 0) {
        if (lib.Length > 0) { throw new CliException("--plan cannot be combined with a single library"); }
        FlowConfig cfg = _flowConfigFor(_root());
        projects = _flowUnitProjects(cfg, _flowReadPlan(cfg, c.Plan, _root()), kind, c.Shard);
    } else if (sh[1] > 0) {
        projects = _shardUnitProjects(_root(), kind, sh[0], sh[1]);
        Console.WriteLine("→ shard " + sh[0].ToString() + "/" + sh[1].ToString()
            + ": " + projects.Length.ToString() + " projects");
    } else if (lib.Length > 0) {
        projects = new string[] { _selectUnitProject(_allUnitProjects(_root(), kind), lib) };
    } else {
        projects = _allUnitProjects(_root(), kind);
    }
    // `bench stdlib --json <out>` → capture aggregated bench_stats into a baseline file
    // (median_ns primary metric). Only for bench; the test path passes "".
    MicroBenchAgg agg = (jsonOut.Length > 0) ? new MicroBenchAgg() : null;
    // --vm/--driver/--libs: optional explicit toolchain override (see _testLibCore).
    int __rc = _testLibCore(kind, projects, c.NoBuild, c.Filter, c.Jobs, c.Mode, agg, c.Vm, c.Driver, c.Libs);
    if (agg != null) {
        string outPath = _absUnder(_root(), jsonOut);
        Directory.Create(Path.GetDirectoryName(outPath));   // 结果目录（reports/benches）可能还不存在
        File.WriteAllText(outPath, agg.toSchemaV2(_root()));
        Console.WriteLine("wrote baseline -> " + jsonOut + " (" + agg.count().ToString() + " benchmarks)");
    }
    if (__rc == 0) { _procEnd((kind == "bench") ? "bench stdlib" : "test stdlib", sw); }
    return __rc;
}

int _testLibCore(string kind, string[] projects, bool noBuild, string filter, string jobs, string mode, MicroBenchAgg agg,
                 string ovVm, string ovDriver, string ovLibs) {
    // 已选中的真实工程清单；test / bench 目标由 z42b 按同一份清单发现与执行。
    // ovVm/ovDriver/ovLibs (empty = derive from in-tree): when all set, use that PROVIDED
    // toolchain (vm + z42c.driver.zpkg + flat libs dir) and skip the in-tree rebuild — the
    // micro A/B base capture (bench-pr.yml) points these at the base toolchain the e2e A/B uses.
    // 调用方已完成全库 / 单库 / 分片选择；空集合是合法空分片，不能扩大或准备工具链。
    if (projects.Length == 0) {
        Console.WriteLine("  no libraries selected; nothing to run");
        return 0;
    }
    List<string> dirs = new List<string>();
    foreach (var toml in projects) { dirs.Add(Path.GetDirectoryName(toml)); }
    return _testPkgsCore(kind, "stdlib", dirs.ToArray(), noBuild, filter, jobs, mode, agg, ovVm, ovDriver, ovLibs);
}

// 共用的 [Test] / [Benchmark] 跑测器：给定一组包（目录，工程清单按 ManifestLocator 定位），先备工具链
// （z42vm + stdlib + z42b），再逐包转发给 z42b。`suite` 只用于汇总行（stdlib / toolchain）。
int _testPkgsCore(string kind, string suite, string[] dirs, bool noBuild, string filter,
                  string jobs, string mode, MicroBenchAgg agg, string ovVm, string ovDriver, string ovLibs) {
    string label  = (kind == "bench") ? "bench" : "test";
    if (jobs.Length == 0) { jobs = "1"; }   // forwarded to z42b
    string root = _root();
    bool useOverride = ovVm.Length > 0 && ovDriver.Length > 0 && ovLibs.Length > 0;
    if (!noBuild && !useOverride) {
        Console.WriteLine("→ Preparing tooling (z42vm + stdlib; release)...");
        // ⚠ z42vm FIRST — stdlib is self-built BY z42vm, so a VM older than
        // src/runtime/ blows up the very first stage with an error that points
        // nowhere near the cause (a builtin added in this tree but missing from
        // the stale VM surfaces as `unknown builtin __x` →
        // `z42c --workspace self-build failed`). _buildStdlib's own VM guard is
        // build-if-MISSING, so it cannot catch staleness; cargo is the only thing
        // that knows whether the runtime sources changed, and it is a ~0.2s no-op
        // when they did not.
        int c = _buildRuntime(); if (c != 0) { return c; }
        c = _buildStdlib(); if (c != 0) { return c; }
        // _buildStdlib already self-builds z42c (_buildCompilerViaZ42c); test units
        // compile through that z42c. A trailing _buildCompiler would be a redundant
        // byte-identical gen2 self-build.
    }
    // compile toolchain: z42vm + z42c.driver.zpkg + Z42_LIBS = 纯 stdlib flat。driver 的 dist
    // 自包含；编译器域的测试库（_allUnitProjects）按名声明的编译器包由 driver 从编译器目录解析；z42b 运行期
    // 加载编译器包经 `_z42bProc`（z42b 启动点统一挂）。override（--vm/--driver/--libs，bench A/B 的
    // base 侧）照旧用调用方给的目录。
    string vm = useOverride ? ovVm : _builtVm(root, "release");
    string driverZpkg = useOverride ? ovDriver : _driverZpkg(root, "release");
    string libs = useOverride ? ovLibs : _libsDir(root);
    // The reflective runner is z42b (z42.builder.zpkg) on z42vm: it discovers [Test]/[Benchmark]
    // functions by runtime reflection and exits 0 (all passed) / 1 (any failure). Its deps resolve
    // from `libs`, the same flat dir the test units compile against.
    // Build z42b unconditionally (even under --no-build): an incremental compile, near-no-op when
    // current, and it guarantees the runner exists AND its zpkg format matches the current z42c.
    string builderZpkg = _toolchainZpkg(root, _z42bToml());
    Console.WriteLine("→ Building z42b (z42.builder.zpkg; reflective test runner)...");
    int bcRC = _buildZ42bWith(root, vm, driverZpkg, libs);
    if (bcRC != 0) { return bcRC; }
    int totalFailed = 0;
    int totalFiles = 0;
    int libsTested = 0;
    // `jobs` = unit-level batch width (how many units compile+run concurrently).
    // Default 1 = serial.
    int jobsN = 1;
    try { jobsN = int.Parse(jobs); } catch (Exception e) { jobsN = 1; }
    if (jobsN < 1) { jobsN = 1; }
    // mode forwarded to z42b: "" / "interp" → in-process interp;
    // "jit" → runner forces subprocess fork of z42vm --mode jit.
    if (mode.Length == 0) { mode = "interp"; }
    // Per lib: _runLibKind (common/harness/manifest_targets.z42) lints the manifest's explicit targets, then
    // forwards to z42b (discovery: [tests]/[benches] section + explicit [[test]]/[[bench]]).
    int pi = 0;
    while (pi < dirs.Length) {
        int f = _runLibKind(root, dirs[pi], kind, label, filter,
                            builderZpkg, jobsN, mode, vm, driverZpkg, libs, agg,
                            ref totalFiles, ref libsTested);
        if (f < 0) { return 2; }
        totalFailed = totalFailed + f;
        pi = pi + 1;
    }
    Console.WriteLine("");
    Console.WriteLine("════════════════════════════════════════════════");
    // 孤儿源守卫（「tests/ 有 .z42 源、却没产出任何单元」= 假绿）住在 z42b 里（_dtOrphanSourceDir），
    // 转发时逐 lib 生效 —— 判据只该有一处。
    if (totalFailed > 0) {
        Console.WriteLine("  ❌ " + suite + " " + label + ": " + totalFailed.ToString()
            + " file(s) failed (of " + totalFiles.ToString() + " in " + libsTested.ToString() + " lib(s))");
        return 1;
    }
    Console.WriteLine("  ✅ " + suite + " " + label + ": all " + totalFiles.ToString()
        + " file(s) passed (in " + libsTested.ToString() + " lib(s))");
    return 0;
}
