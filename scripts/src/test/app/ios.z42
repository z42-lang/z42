// xtask — iOS platform backend (IPlatformBackend). Needs Xcode.
//   ① BuildProject : cargo build × (ios targets + macOS host slice) → xcframework
//   ② Assets       : fixtures → Tests/.../test-fixtures; stdlib → Resources/stdlib (+ test bundle)
//   ③ RunTests     : z42b's ios driver (builder_device_ios.z42) — one `xcodebuild test`
//                    on a simulator (R1–R7 + embedded, one boot).
namespace Z42Xtask;

using Std.IO;
using Std.Toml;
using Std.Collections;

public class IosBackend : IPlatformBackend {
    public string Name() { return "ios"; }

    public AssetLayout Assets(string root) {
        string here = _deviceHost(root, "ios");
        string[] stdlibDirs = new string[] {
            Path.Join(here, "Resources/stdlib"), Path.Join(here, "Tests/Z42VMTests/Resources/stdlib") };
        return new AssetLayout(Path.Join(here, "Tests/Z42VMTests/Resources/test-fixtures"),
                               stdlibDirs, false);
    }

    // ① cargo build each target → assemble Z42VM.xcframework (device + sim + macOS).
    public int BuildProject(string root) {
        if (!_requireTool("xcodebuild", "Xcode required for iOS build")) { return 1; }
        if (!_requireTool("cargo", "https://rustup.rs")) { return 1; }
        // rust crate 在源码位置编；xcframework 输出到宿主副本（SwiftPM 的 binaryTarget 在那里找它）。
        string manifest = Path.Join(root, _runtimeManifest());
        string here = _deviceHost(root, "ios");
        string targetDir = _cargoTargetDir(root);
        string libName = "examples/libz42-default.a";

        TomlValue toml = _vparse(root);
        string[] iosTargets = _vgetList(toml, "platform.ios.rust_targets");
        string[] extra      = _vgetList(toml, "build.ios.extra_rust_targets");
        // Match packaging's _iosRustc: pin the iOS deployment target so the C
        // deps (zlib-ng in z42-compression) compile for the same min version as
        // the rlibs — otherwise the device link fails (___chkstk_darwin / 10.0
        // vs 18.5 mismatch).
        string iosMin = _vReadOr(root, "platform.ios.min_ios", "16.0");

        int c = _iosCargoTargets(manifest, targetDir, iosTargets, iosMin);  if (c != 0) { return c; }
        c = _iosCargoTargets(manifest, targetDir, extra, iosMin);           if (c != 0) { return c; }

        // Assemble xcframework from device + simulator + macOS slices.
        string dev = Path.Join(targetDir, Path.Join("aarch64-apple-ios/release", libName));
        string sim = Path.Join(targetDir, Path.Join("aarch64-apple-ios-sim/release", libName));
        string mac = Path.Join(targetDir, Path.Join("aarch64-apple-darwin/release", libName));
        string xcf = Path.Join(here, "Z42VM.xcframework");
        if (Directory.Exists(xcf)) { Directory.Delete(xcf, true); }

        Console.WriteLine("  xcodebuild -create-xcframework -> " + xcf);
        return _exec(new Process("xcodebuild").Arg("-create-xcframework")
            .Arg("-library").Arg(dev)
            .Arg("-library").Arg(sim)
            .Arg("-library").Arg(mac)
            .Arg("-output").Arg(xcf));
    }

    // ③ ONE `xcodebuild test -scheme Z42VM` runs R1–R7 (Z42VMTests) + the embedded corpus
    // (Z42EmbeddedTests) in a single simulator boot; z42b resolves the sim UDID and writes
    // junit.xml. Requires a prior `test app ios bundle` (xcframework + Resources/embedded corpus).
    public int RunTests(string root) {
        return _runIosTesthost(root, "iossim-arm64");
    }
}

int _iosCargoTargets(string manifest, string targetDir, string[] targets, string iosMin) {
    string root = _root();
    foreach (var target in targets) {
        string rid = _componentRidForTarget(root, target);
        int c = _componentBuildStaticLibraries(root, rid, "release"); if (c != 0) { return c; }
        string cargo = _componentPlatformOut(root, rid, "release", false);
        string dest = Path.Join(targetDir, target + "/release/examples/libz42-default.a");
        Directory.Create(Path.GetDirectoryName(dest));
        c = _exec(new Process("libtool").Arg("-static").Arg("-o").Arg(dest)
            .Arg(Path.Join(cargo, "examples/libz42.a")).Arg(Path.Join(cargo, "libz42_compression.a")));
        if (c != 0) { return c; }
    }
    return 0;
}

// 只编 `test app desktop --rid <ios>` 需要的切片 —— macOS host（`swift test` 要用）+ rid 对应的部署切片
// （ios-arm64 → 真机，iossim-arm64 → 模拟器，空 → 两者）—— 再拼成 `<rtDir>/native/Z42VM.xcframework`
// （runtime pack 的同形布局）；z42b 把它铺进宿主工程（SwiftPM 的 binaryTarget 在那里找它）。
// IPHONEOS_DEPLOYMENT_TARGET 取 versions.toml 的 platform.ios.min_ios：C 依赖（zlib-ng）要和 rlib 的
// 最低版本一致，否则真机链接失败。
int _buildIosXcframework(string root, string rid, string rtDir) {
    if (!_requireTool("xcodebuild", "Xcode required for iOS build")) { return 1; }
    if (!_requireTool("cargo", "https://rustup.rs")) { return 1; }
    string manifest = Path.Join(root, _runtimeManifest());
    string targetDir = _cargoTargetDir(root);
    string libName = "examples/libz42-default.a";
    // 切片按 [platform.ios].rust_targets 选：rid 留空 = 全部（ios 域登记了真机 + 模拟器两个 triple），
    // 否则只留与该 rid 的 triple 同 OS 的目标（真机 rid 只编真机切片，模拟器 rid 只编模拟器切片）。
    string os = rid.Length == 0 ? "ios" : _tripleOs(_ridToCargo(rid));
    List<string> targets = new List<string>();
    targets.Add("aarch64-apple-darwin");
    foreach (var t in _vgetList(_vparse(root), "platform.ios.rust_targets")) {
        if (_tripleOs(t) == os) { targets.Add(t); }
    }
    string iosMin = _vReadOr(root, "platform.ios.min_ios", "16.0");
    int c = _iosCargoTargets(manifest, targetDir, targets.ToArray(), iosMin);
    if (c != 0) { return c; }
    Directory.Create(Path.Join(rtDir, "native"));
    string xcf = Path.Join(rtDir, "native/Z42VM.xcframework");
    if (Directory.Exists(xcf)) { Directory.Delete(xcf, true); }
    Console.WriteLine("  xcodebuild -create-xcframework -> " + xcf);
    Process xb = new Process("xcodebuild").Arg("-create-xcframework");
    foreach (var t in targets) {
        xb = xb.Arg("-library").Arg(Path.Join(targetDir, t + "/release/" + libName));
    }
    return _exec(xb.Arg("-output").Arg(xcf));
}
