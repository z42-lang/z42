// 用独立小仓库验证诊断码检查，不依赖真实仓库的码号或任何基线。
namespace Z42Xtask;

using Std.IO;

int _selfcheckDiagCodes(string root) {
    string dir = _xtaskWork(root, "diagcodes-selfcheck");
    _dcFixture(dir);
    _dcExpect(dir, 0, "registered literal needs no baseline");
    _dcFixtureWrite(dir, "src/emitter.z42", "DiagnosticCodes.First;\n");
    _dcExpect(dir, 0, "registered constant reference");
    _dcFixtureWrite(dir, "src/emitter.z42", "DiagnosticCodes.First; DiagnosticCodes.Ghost;\n");
    _dcExpect(dir, 1, "unknown constant reference");
    _dcFixtureWrite(dir, "src/emitter.z42", "\"E0001\"; \"E0002\";\n");
    _dcExpect(dir, 1, "unregistered literal");
    _dcFixture(dir);
    _dcFixtureWrite(dir, _dcRegistryPath(),
        "public static string First = \"E0001\";\npublic static string Second = \"E0001\";\n");
    _dcExpect(dir, 1, "duplicate registration");
    _dcFixtureWrite(dir, _dcRegistryPath(), "");
    _dcExpect(dir, 1, "empty registry");
    _dcFixture(dir);
    File.Delete(Path.Join(dir, _dcRegistryPath()));
    _dcExpect(dir, 1, "missing registry");
    _dcSelfcheckDocAndCoverage(dir);
    Console.WriteLine("  ✅ diagnostic checks: registration, references, documentation, liveness, coverage");
    return 0;
}

// ci-shell 的取值扫描：会触发 set -u 的引用要报；转义的美元号、GitHub 表达式、带默认值与特殊参数不报。
int _selfcheckCiShell() {
    _csExpectUses("echo \"$A ${B}\" ${#C}", "A,B,C", "plain, braced and length references");
    _csExpectUses("echo \\$env:X \\${Y}", "", "escaped dollars are literal");
    _csExpectUses("echo \\\\$Z", "Z", "an escaped backslash leaves the expansion");
    _csExpectUses("x=${{ github.sha }} ${U:-d} ${V+x} $1 $@ $?", "", "expressions, defaults and special parameters");
    Console.WriteLine("  ✅ ci-shell scanner: references, escapes, expressions, defaults");
    return 0;
}

// RID 的数据推导：本机 RID 探测与 workflow 投影解析（check versions 用）。
int _selfcheckRidDerivation() {
    string root = _root();
    foreach (var rid in _vRidsOfCategory(root, "desktop")) {
        string triple = _vRidTriple(root, rid);
        _rdAssert(_hostRidFor(root, _tripleOs(triple), _tripleArch(triple)) == rid, "host " + rid + " round-trips through its triple");
    }
    _rdAssert(_hostRidFor(root, "freebsd", "x86_64") == "freebsd-x86_64-unsupported", "unregistered host is reported, not guessed");
    _rdAssert(_tripleOs("aarch64-apple-ios-sim") == "ios" && _tripleOs("aarch64-linux-android") == "android"
        && _tripleOs("x86_64-unknown-linux-gnu") == "linux" && _tripleOs("wasm32-unknown-unknown") == "wasm", "triple OS names");
    string rel = "    include:\n      - { rid: a-x64, runs-on: r, rust-target: x86_64-pc-windows-msvc }\n      - { rid: b, runs-on: r, rust-target: wasm32-unknown-unknown }\n";
    _rdAssert(String.Join(",", _wfReleaseMatrix(rel)) == "a-x64=x86_64-pc-windows-msvc,b=wasm32-unknown-unknown", "release matrix rows");
    string ci = "jobs:\n  other:\n    matrix:\n      include:\n        - { os: o, platform: no-x64 }\n"
        + "  host-package:\n    strategy:\n      matrix:\n        include:\n          - { os: u, platform: linux-x64 }\n          - { os: w, platform: windows-x64 }\n"
        + "  package-ios:\n    steps:\n      - run: |\n          for rid in ios-arm64 iossim-arm64; do\n            xtask package runtime --rid \"$rid\"\n          done\n"
        + "          xtask package runtime --rid browser-wasm --archive\n";
    _rdAssert(String.Join(",", _wfJobMatrixValues(ci, "host-package", "platform")) == "linux-x64,windows-x64", "matrix values stay inside their job");
    _rdAssert(String.Join(",", _wfPackagedRids(ci)) == "ios-arm64,iossim-arm64,browser-wasm", "loop lists and literal --rid, not $rid");
    Console.WriteLine("  ✅ RID derivation: host detection round-trip, workflow projection parsing");
    return 0;
}

void _rdAssert(bool ok, string what) { if (!ok) { throw new Exception("rid derivation: " + what); } }

void _csExpectUses(string line, string expected, string what) {
    string got = String.Join(",", _csUsesIn(line).ToArray());
    if (got != expected) { throw new Exception("ci-shell scanner: " + what + ": expected [" + expected + "] got [" + got + "]"); }
}

void _dcSelfcheckDocAndCoverage(string dir) {
    _dcFixture(dir);
    _dcFixtureWrite(dir, _dcDocPath(), "| E0002 | test | active |\n");
    _dcExpect(dir, 1, "documentation agrees with registry");
    _dcFixtureWrite(dir, _dcDocPath(), "| E0001 | test | 零发射点 |\n");
    _dcExpect(dir, 1, "live code cannot be marked inactive");
    _dcFixtureWrite(dir, "src/emitter.z42", "// \"E0001\" is not an emission site\n");
    _dcExpect(dir, 0, "test references and source comments do not make a code live");
    _dcFixtureWrite(dir, _dcDocPath(), "| E0001 | test | active |\n");
    _dcExpect(dir, 1, "inactive code cannot be marked live");
    _dcFixture(dir);
    _dcFixtureWrite(dir, "src/tests/code.txt", "");
    _dcFixtureWrite(dir, "src/tests/comment.z42", "// E0001\n");
    _dcExpect(dir, 1, "comments alone do not cover a live code");
    _dcFixtureWrite(dir, "src/tests/assert.z42", "DiagnosticCodes.First;\n");
    _dcExpect(dir, 0, "test constant reference provides coverage");
}

void _dcFixture(string dir) {
    _resetDir(dir);
    _dcFixtureWrite(dir, _dcRegistryPath(), "public static string First = \"E0001\";\n");
    _dcFixtureWrite(dir, _dcDocPath(), "| E0001 | test | active |\n");
    _dcFixtureWrite(dir, "src/emitter.z42", "\"E0001\";\n");
    _dcFixtureWrite(dir, "src/tests/code.txt", "E0001\n");
}

void _dcFixtureWrite(string dir, string rel, string text) {
    string path = Path.Join(dir, rel);
    Directory.Create(Path.GetDirectoryName(path));
    File.WriteAllText(path, text);
}

void _dcExpect(string dir, int expected, string scenario) {
    int actual = _checkDiagCodesAt(dir);
    if (actual != expected) {
        throw new Exception("diagnostic selfcheck: " + scenario + "; expected "
            + expected.ToString() + ", got " + actual.ToString());
    }
}
