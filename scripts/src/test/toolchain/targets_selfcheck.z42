// 夹具清单定位与实际 z42b 发现链路：候选名完整匹配去重，缺失名称不执行目标。
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

int _selfcheckFixtureTargets(string root, TargetTooling tt) {
    _selfcheckFixtureManifest(root);
    string dir = _xtaskWork(root, "fixture-target-selection");
    _resetDir(dir);
    File.WriteAllText(Path.Join(dir, "source.z42"),
        "namespace FixtureSelection;\nusing Std.IO;\nvoid Main() { Environment.Exit(97); }\n");
    foreach (var kind in new string[]{ "test", "bench" }) {
        string toml = Path.Join(dir, "z42.toml");
        string manifest = "[project]\nname = \"fixture-selection\"\nversion = \"0.1.0\"\nkind = \"lib\"\n"
            + "[tests]\nauto = false\n[benches]\nauto = false\n";
        foreach (var name in new string[]{ "exit_ok", "ok" }) {
            manifest = manifest + "[[" + kind + "]]\nname = \"" + name + "\"\n"
                + "harness = false\nentry = \"FixtureSelection.Main\"\ninclude = [\"source.z42\"]\n";
        }
        File.WriteAllText(toml, manifest);
        int matched = 0;
        var available = new List<string>();
        // 两个夹具可以暴露同名目标；重复发现不应重复提示，也不能吞掉名称的子串。
        foreach (var fixture in new string[]{ "first", "second" }) {
            int failed = _runFixtureKind(root, fixture, toml, kind, kind, "missing", tt, ref matched, available);
            if (failed != 0 || matched != 0 || String.Join(", ", available.ToArray()) != "exit_ok, ok") {
                throw new Exception("fixture targets: " + kind + " candidate names, deduplication or missing selection");
            }
        }
    }
    Directory.Delete(dir, true);
    Console.WriteLine("  ✅ fixture targets: test/bench, exact names, deduplication, missing selection");
    return 0;
}

void _selfcheckFixtureManifest(string root) {
    string dir = _xtaskWork(root, "fixture-manifest-selection");
    _resetDir(dir);
    if (_findManifest(Path.Join(dir, "missing")).ManifestPath != "" || _findManifest(dir).ManifestPath != "") {
        throw new Exception("fixture manifest: absent project must not select a parent");
    }
    File.WriteAllText(Path.Join(dir, "expect.toml"), "exit = 0\n");
    File.WriteAllText(Path.Join(dir, "Cargo.toml"), "[package]\n");
    if (_findManifest(dir).ManifestPath != "") { throw new Exception("fixture manifest: unrelated TOML selected as a project"); }
    string a = Path.Join(dir, "a.z42.toml");
    string b = Path.Join(dir, "b.z42.toml");
    File.WriteAllText(a, "");
    if (_findManifest(dir).ManifestPath != a) { throw new Exception("fixture manifest: unique named project not selected"); }
    File.WriteAllText(b, "");
    bool rejected = false;
    try { _findManifest(dir); }
    catch (Exception e) { rejected = e.Message.Contains("a.z42.toml") && e.Message.Contains("b.z42.toml"); }
    if (!rejected) { throw new Exception("fixture manifest: ambiguous projects must list both candidates"); }
    string bare = Path.Join(dir, "z42.toml");
    File.WriteAllText(bare, "");
    if (_findManifest(dir).ManifestPath != bare) { throw new Exception("fixture manifest: bare project must take precedence"); }
    File.Delete(bare); File.Delete(a); File.Delete(b);
    string workspace = Path.Join(dir, "z42.workspace.toml");
    File.WriteAllText(workspace, "");
    if (_findManifest(dir).ManifestPath != workspace) { throw new Exception("fixture manifest: workspace not selected"); }
    Directory.Delete(dir, true);
    Console.WriteLine("  ✅ fixture manifest: missing, unrelated TOML, named, ambiguous, bare priority, workspace");
}
