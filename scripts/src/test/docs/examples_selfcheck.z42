// 验证实际 examples stage 的跳过与外部 SDK 消费路径不触发工具链构建。
namespace Z42Xtask;

using Std.IO;
using Std.Collections;
using Std.Threading;

int _selfcheckExamplesStage() {
    _selfcheckExampleParallel();
    string root = _root();
    string dir = _xtaskWork(root, "examples-stage");
    string? home = Environment.GetEnvironmentVariable("Z42_HOME");
    _resetDir(dir);
    try {
        RepoRoot.Value = dir;
        Environment.UnsetEnvironmentVariable("Z42_HOME");
        bool found = false;
        foreach (var stage in _gateStages(true)) {
            if (stage.Key != "examples") { continue; }
            found = true;
            _gateAssert(_runGateStages(new GateStage[]{ stage }, "examples", new List<StageTiming>()) == 0,
                "skipped examples must not prepare SDK");
        }
        _gateAssert(found, "examples stage is registered");
        _gateAssert(!Directory.Exists(Path.Join(dir, "artifacts")), "listing and skipping stages must not build");

        // 空手册无 transcript；SDK 标记足以锁住入口选择，无须再启动编译器。
        Directory.Create(Path.Join(dir, "docs/learn/src"));
        File.WriteAllText(Path.Join(dir, "docs/learn/src/SUMMARY.md"), "# Summary\n");
        Directory.Create(Path.Join(dir, "examples"));
        string sdk = Path.Join(dir, "external-sdk");
        Directory.Create(Path.Join(sdk, "programs/launcher"));
        File.WriteAllText(Path.Join(sdk, Platform.IsWindows() ? "z42.exe" : "z42"), "external SDK marker");
        File.WriteAllText(Path.Join(sdk, "programs/launcher/launcher.zpkg"), "external SDK marker");
        Environment.SetEnvironmentVariable("Z42_HOME", sdk);
        _gateAssert(_gateExamples() == 0, "examples must consume explicit SDK");
        _gateAssert(!Directory.Exists(Path.Join(dir, "artifacts")), "explicit SDK must not prepare local SDK");
    } finally {
        RepoRoot.Value = root;
        if (home == null) { Environment.UnsetEnvironmentVariable("Z42_HOME"); }
        else { Environment.SetEnvironmentVariable("Z42_HOME", home); }
        Directory.Delete(dir, true);
    }
    Console.WriteLine("  ✅ examples stage: skip and explicit SDK without local build");
    return 0;
}

class ExampleVisits { public int[] Counts = new int[3]; }

void _selfcheckExampleParallel() {
    var ready = new Channel<int>();
    var release = new Channel<int>();
    var visits = new Mutex<ExampleVisits>(new ExampleVisits());
    ExampleRunResult[] results = _runExampleSessions(new string[]{ "0", "1", "2" }, 2, (string name) => {
        int i = int.Parse(name);
        visits.Lock((ExampleVisits v) => { v.Counts[i] = v.Counts[i] + 1; return v; });
        if (i == 0) { ready.Send(1); release.Recv(); }
        if (i == 1) { ready.Recv(); release.Send(1); }
        if (i == 2) { throw new Exception("fixture session failure"); }
        var result = new ExampleRunResult(); result.Steps = i + 1;
        result.Diagnostics = name;
        return result;
    });
    _gateAssert(results[0].Steps == 1 && results[1].Steps == 2 && results[0].Diagnostics == "0"
        && results[1].Diagnostics == "1", "parallel sessions overlap and retain ordered results");
    _gateAssert(results[2].Failed && results[2].Diagnostics.Contains("fixture session failure"), "worker exceptions fail their session");
    _gateAssert(visits.Read<bool>((ExampleVisits v) => v.Counts[0] == 1 && v.Counts[1] == 1 && v.Counts[2] == 1), "each session executes exactly once");
    _gateAssert(_runExampleSessions(new string[0], 0, (string name) => new ExampleRunResult()).Length == 0, "empty example queue starts no workers");
    _gateAssert(_runExampleSessions(new string[]{ "one" }, 8, (string name) => new ExampleRunResult()).Length == 1, "worker count can exceed session count");
    var invalid = new ExamplesOptions(); invalid.Jobs = -1;
    _gateAssert(_testExamples(invalid) != 0, "negative jobs fail before SDK preparation");
    string dir = Directory.CreateTempDir("xtask-example-order");
    try {
        Directory.Create(Path.Join(dir, "child"));
        File.WriteAllText(Path.Join(dir, "child/value.txt"), "ordered");
        string path = Path.Join(dir, "test.console");
        File.WriteAllText(path, "$ cd child\n$ cat value.txt\nordered\n");
        ExampleRunResult[] runs = _runExampleSessions(new string[]{ path, path }, 2,
            (string c) => _runTranscript("", c, 1000, false, false));
        _gateAssert(!runs[0].Failed && !runs[1].Failed && runs[0].Steps == 2 && runs[1].Steps == 2,
            "concurrent transcripts keep ordered commands in independent sandboxes");
        _gateAssert(!File.Exists(Path.Join(dir, "value.txt")), "transcript working directories do not escape the sandbox");
    } finally { Directory.Delete(dir, true); }
    Console.WriteLine("  ✓ examples parallel: overlap, exactly once, ordered results, exceptions, empty queue and sandbox isolation");
}
