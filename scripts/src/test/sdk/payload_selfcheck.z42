namespace Z42Xtask;
using Std.IO;
using Z42.Package;

void _payloadFixture(string dir, string name, string dep) {
    ZpkgDepZ[] deps = new ZpkgDepZ[1];
    int count = 0;
    if (dep.Length > 0) { deps[0] = new ZpkgDepZ(dep + ".zpkg", new string[0], 0); count = 1; }
    ZpkgFileZ z = ZpkgBuilder.BuildPackedD(name, "0.1.0", false, false, "", new ZbcFileZ[0], 0, deps, count);
    File.WriteAllBytes(Path.Join(dir, name + ".zpkg"), ZpkgWriterZ.WritePacked(z, false).ToBytes());
}

int _testPayloadClosure() {
    string work = Path.Join(_root(), "artifacts/test/payload-closure");
    if (Directory.Exists(work)) { Directory.Delete(work, true); }
    string dist = Path.Join(work, "dist"); string payload = Path.Join(work, "payload");
    Directory.Create(dist); Directory.Create(payload);
    _payloadFixture(dist, "app", "direct");
    _payloadFixture(dist, "direct", "transitive");
    _payloadFixture(dist, "transitive", "direct"); // cycle must terminate
    _payloadFixture(payload, "direct", "transitive");
    _payloadFixture(payload, "transitive", "direct");
    File.WriteAllText(Path.Join(dist, "unrelated.zpkg"), "not a package");
    if (_payloadMissing(dist, payload, "app") != 0) { throw new Exception("unrelated dist package entered payload closure"); }
    File.Delete(Path.Join(payload, "transitive.zpkg"));
    if (_payloadMissing(dist, payload, "app") != 1) { throw new Exception("missing transitive dependency was accepted"); }
    _payloadFixture(dist, "transitive", "external"); // external SDK dependency allowed
    _payloadFixture(payload, "transitive", "external");
    if (_payloadMissing(dist, payload, "app") != 0) { throw new Exception("external SDK dependency rejected"); }
    File.WriteAllText(Path.Join(dist, "editor.so"), "native");
    if (_payloadMissing(dist, payload, "app") != 1) { throw new Exception("missing native library accepted"); }
    Directory.Delete(work, true);
    Console.WriteLine("  ✓ payload closure: unrelated / transitive / cycle / external / native");
    return 0;
}
