// xtask — 打包命令的 `--archive` / `package release` 自检。
//
// 与同目录其它 selfcheck 同一形态：xtask 是 exe，反射 [Test] runner 看不到它 ⇒ 不匹配就抛。
// 由 packages.toml 自检聚合（`package sdk --verify` 的第一步）。
//
// 不碰真实产物：在 xtask 的自检目录（`_xtaskWork`）下造齐 versions.toml 全部 RID 的**假包目录**（各放一个小文件；桌面
// workload 放 `apphost-<rid>`），外加一个 debug profile 的噪声目录，逐个目录出归档（`--archive` 的那一步，归档与包目录
// 同在一处，同 artifacts/packages/），再在同一个目录上 release。锁住：
//   · 命名映射（sdk / runtime / desktop workload / 平台 workload 只由主 RID 出 / test workload）；
//   · 噪声目录（非 release profile）不进归档；
//   · Windows RID 出 .zip，其余 .tar.gz，且 release-index 用的名字与 `--archive` 出的同源；
//   · release 合并出一份含全部桌面 RID apphost 的桌面 workload、删掉逐 RID 中间件，SHA256SUMS 与 index 齐全；
//     与包目录同处一个目录不干扰（SHA256SUMS 只收归档文件）。
// 期望计数全部从 [rid.*] / [workload] 表推出（加 RID 不用改这里）。
namespace Z42Xtask;

using Std.Collections;
using Std.IO;
using Std.Json;

void _relAssert(string what, bool cond) {
    if (!cond) { throw new Exception("package-release: " + what + ": failed"); }
}

void _relFakePkg(string from, string name, string file) {
    string d = Path.Join(from, name);
    Directory.Create(d);
    File.WriteAllText(Path.Join(d, file), name + "\n");
}

int _testPackagesRelease() {
    Console.WriteLine("── --archive / release self-check ──");
    string root = _root();
    string ver = _versionsGet(root);
    string label = "0.0.0-selfcheck";
    string work = _xtaskWork(root, "selfcheck-release");
    if (Directory.Exists(work)) { Directory.Delete(work, true); }
    string dist = Path.Join(work, "packages");   // 包目录与归档同处（= artifacts/packages）
    Directory.Create(dist);

    try {
        _relTarRoundtrip(work);
        _relZipRoundtrip(work);
        // ── 命名映射（纯函数）──
        _relAssert("sdk", _relArchiveName("z42-" + ver + "-linux-x64-release", ver, label) == "z42-sdk-" + label + "-linux-x64.tar.gz");
        _relAssert("sdk (windows → zip)", _relArchiveName("z42-" + ver + "-windows-x64-release", ver, label) == "z42-sdk-" + label + "-windows-x64.zip");
        _relAssert("platform tooling (primary)", _relArchiveName("z42-" + ver + "-android-arm64-release", ver, label) == "z42-workload-" + label + "-android.tar.gz");
        _relAssert("platform tooling (non-primary → none)", _relArchiveName("z42-" + ver + "-android-x64-release", ver, label) == "");
        _relAssert("debug profile → none", _relArchiveName("z42-" + ver + "-linux-x64-debug", ver, label) == "");
        _relAssert("other version → none", _relArchiveName("z42-0.0.1-linux-x64-release", ver, label) == "");
        _relAssert("desktop piece (windows → zip)", _relArchiveName("z42-workload-" + ver + "-desktop-windows-x64", ver, label) == "z42-workload-" + label + "-desktop-windows-x64.zip");
        _relAssert("windows ext", _relArchiveExt("windows-x64") == ".zip");
        _relAssert("unix ext", _relArchiveExt("macos-arm64") == ".tar.gz");
        _relAssert("index sdk name = archive name", _sdkName(label, "windows-x64") == _relArchiveName("z42-" + ver + "-windows-x64-release", ver, label));
        _relAssert("index runtime name = archive name", _rtName(label, "macos-arm64") == _relArchiveName("z42-runtime-" + ver + "-macos-arm64", ver, label));

        // ── 端到端：假包目录 → 逐个出归档 → index ──
        string[] rids = _relRids();
        int nD = _vRidsOfCategory(root, "desktop").Length;   // 桌面 RID：sdk + runtime + desktop 零件
        int nP = rids.Length - nD;                            // 平台 RID：runtime
        int nW = _vCrossWorkloads(root).Length;               // 平台 workload：每个恰由一个主 RID 出（`check versions` 守）
        _relAssert("rid table non-empty", nD > 0 && nP > 0 && nW > 0);
        foreach (var rid in rids) {
            _relFakePkg(dist, "z42-" + ver + "-" + rid + "-release", "manifest.toml");
            _relFakePkg(dist, "z42-runtime-" + ver + "-" + rid, "manifest.toml");
            if (_relIsDesktop(rid)) { _relFakePkg(dist, "z42-workload-" + ver + "-desktop-" + rid, "apphost-" + rid); }
        }
        _relFakePkg(dist, "z42-workload-" + ver + "-test", "manifest.toml");
        _relFakePkg(dist, "z42-" + ver + "-linux-x64-debug", "manifest.toml");   // 噪声

        foreach (var d in _sortedStrings(Directory.Enumerate(dist))) {
            _relAssert("archive " + d, _pkgArchiveDir(Path.Join(dist, d), ver, label, dist) >= 0);
        }
        // nD × (sdk + runtime + desktop 零件) + nP 平台 runtime + nW 平台 workload + test
        int wantArch = nD * 3 + nP + nW + 1;
        int nArch = Path.Glob(dist, "z42-*.tar.gz").Length + Path.Glob(dist, "z42-*.zip").Length;
        _relAssert("archive count " + wantArch.ToString() + " (got " + nArch.ToString() + ")", nArch == wantArch);
        _relAssert("windows sdk is zip", File.Exists(Path.Join(dist, "z42-sdk-" + label + "-windows-x64.zip")));
        _relAssert("no non-primary workload", !File.Exists(Path.Join(dist, "z42-workload-" + label + "-iossim.tar.gz")));
        foreach (var archive in Path.Glob(dist, "z42-*.tar.gz")) { _relCanonicalEntries(archive); }
        foreach (var archive in Path.Glob(dist, "z42-*.zip")) { _relCanonicalEntries(archive); }

        _relAssert("release rc", _packageRelease(label, dist, "nightly", "nightly", "nightly") == 0);
        string merged = Path.Join(dist, "z42-workload-" + label + "-desktop.tar.gz");
        _relAssert("merged desktop workload", File.Exists(merged));
        _relCanonicalEntries(merged);
        _relAssert("per-RID desktop pieces removed", Path.Glob(dist, "z42-workload-" + label + "-desktop-*").Length == 0);
        string x = Path.Join(work, "x");
        Directory.Create(x);
        _relAssert("extract merged", _exec(new Process("tar").Arg("-xzf").Arg(merged).Arg("-C").Arg(x)) == 0);
        _relAssert("merged has " + nD.ToString() + " apphosts", Path.Glob(x, "apphost-*").Length == nD);
        // 合并后：nD × (sdk + runtime) + desktop + nP runtime + nW workload + test
        int wantSums = nD * 2 + nP + nW + 2;
        string sums = File.ReadAllText(Path.Join(dist, "SHA256SUMS"));
        int lines = sums.Trim().Split("\n").Length;
        _relAssert("SHA256SUMS has " + wantSums.ToString() + " lines (got " + lines.ToString() + ")", lines == wantSums);
        _relAssert("release-index.json", File.Exists(Path.Join(dist, "release-index.json")));
        JsonValue wls = JsonValue.Parse(File.ReadAllText(Path.Join(dist, "release-index.json"))).Get("workloads");
        foreach (var wl in _vWorkloads(root)) {
            JsonValue e = wls.Get(wl);
            _relAssert("index " + wl + " host = [workload.hosts]",
                _relJoin(e.Get("host")) == String.Join(",", _vWorkloadHosts(root, wl)));
            string want = wl == "desktop" ? "" : String.Join(",", _vRidsOfCategory(root, wl));
            _relAssert("index " + wl + " runtimes = its category's RIDs", _relJoin(e.Get("runtimes")) == want);
        }
        _relAssert("index test workload", _relJoin(wls.Get("test").Get("host")) == "*" && wls.Get("test").Get("runtimes").Count() == 0);
        // release-notes.md：每个 RID / workload 的归档都在表里；nightly 的安装命令不带版本，其它渠道带上版本。
        string notes = File.ReadAllText(Path.Join(dist, "release-notes.md"));
        foreach (var rid in _vRidNames(root)) {
            _relAssert("notes list " + rid, notes.Contains("| " + _vRidTitle(root, rid) + " |")
                && notes.Contains("`" + _rtName(label, rid) + "`"));
            if (_relIsDesktop(rid)) { _relAssert("notes list SDK " + rid, notes.Contains("`" + _sdkName(label, rid) + "`")); }
        }
        foreach (var wl in _vWorkloads(root)) {
            _relAssert("notes list workload " + wl, notes.Contains("`" + _wlArchiveName(label, wl) + "`"));
        }
        _relAssert("nightly install command", notes.Contains("install-z42.sh | sh\n") && !notes.Contains("--version"));
        _relAssert("stable notes", _releaseGenNotes(label, dist, "stable", "1.2.3") == 0);
        notes = File.ReadAllText(Path.Join(dist, "release-notes.md"));
        _relAssert("stable install pins its version", notes.Contains("| sh -s -- --version 1.2.3\n")
            && notes.Contains("$env:Z42_VERSION = \"1.2.3\"; irm "));
    } catch (Exception e) {
        ConsoleError.WriteLine("  ✗ " + e.Message);
        return 1;
    }
    Directory.Delete(work, true);
    Console.WriteLine("  ✓ archive / release: 命名映射 + 归档计数 + 桌面 workload 合并 + SHA256SUMS + index");
    return 0;
}

void _relCanonicalEntries(string archive) {
    Process list = archive.EndsWith(".zip") ? new Process("unzip").Arg("-Z1") : new Process("tar").Arg("-tf");
    foreach (var entry in list.Arg(archive).Run().EnsureSuccess().Stdout.Split("\n")) {
        _relAssert("canonical archive entry " + entry, entry != "." && !entry.StartsWith("./") && !entry.Contains("/./")
            && (!archive.EndsWith(".zip") || !entry.Contains("\\")));
    }
}

void _relZipRoundtrip(string work) {
    string source = Path.Join(work, "zip input's files");
    Directory.Create(Path.Join(source, "libs/nested")); Directory.Create(Path.Join(source, "empty"));
    File.WriteAllText(Path.Join(source, "libs/nested/with spaces.zpkg"), "nested bytes");
    File.WriteAllText(Path.Join(source, ".hidden"), "hidden bytes");
    string archive = Path.Join(work, "zip output's archive.zip");
    _relAssert("zip roundtrip", _relZipDir(source, archive) == 0);
    _relCanonicalEntries(archive);
    string target = Path.Join(work, "zip output"); Directory.Create(target);
    new Process("unzip").Arg("-q").Arg(archive).Arg("-d").Arg(target).Run().EnsureSuccess();
    _relAssert("zip preserves nested paths", File.ReadAllText(Path.Join(target, "libs/nested/with spaces.zpkg")) == "nested bytes");
    _relAssert("zip preserves hidden files", File.ReadAllText(Path.Join(target, ".hidden")) == "hidden bytes");
    _relAssert("zip preserves empty directories", Directory.Exists(Path.Join(target, "empty")));
}

void _relTarRoundtrip(string work) {
    string source = Path.Join(work, "tar input"); Directory.Create(source);
    Directory.Create(Path.Join(source, "empty")); Directory.Create(Path.Join(source, "bin"));
    string[] names = Platform.IsWindows() ? new string[]{ ".hidden", "with spaces", "-C", "@archive", "中文" }
        : new string[]{ ".hidden", "with spaces", "-C", "@archive", "中文", "line\nbreak" };
    foreach (var name in names) { File.WriteAllText(Path.Join(source, name), name); }
    string tool = Path.Join(source, "bin/tool"); File.WriteAllText(tool, "#!/bin/sh\nexit 0\n");
    if (!Platform.IsWindows()) {
        new Process("chmod").Arg("+x").Arg(tool).Run().EnsureSuccess();
        File.SymLink("bin/tool", Path.Join(source, "current"));
    }
    string archive = Path.Join(work, "tar roundtrip.tar.gz");
    _relAssert("tar roundtrip", _exec(_relTar(source, archive)) == 0);
    _relCanonicalEntries(archive);
    string target = Path.Join(work, "tar output"); Directory.Create(target);
    new Process("tar").Arg("-xf").Arg(archive).Arg("-C").Arg(target).Run().EnsureSuccess();
    foreach (var name in names) { _relAssert("tar preserves " + name, File.ReadAllText(Path.Join(target, name)) == name); }
    _relAssert("tar preserves empty directories", Directory.Exists(Path.Join(target, "empty")));
    if (!Platform.IsWindows()) {
        _relAssert("tar preserves executability", _exec(new Process(Path.Join(target, "bin/tool"))) == 0);
        _relAssert("tar preserves symlinks", new Process("readlink").Arg(Path.Join(target, "current")).Run().EnsureSuccess().Stdout.Trim() == "bin/tool");
    }
    string empty = Path.Join(work, "empty input"); Directory.Create(empty);
    string emptyArchive = Path.Join(work, "empty.tar.gz");
    _relAssert("empty tar", _exec(_relTar(empty, emptyArchive)) == 0);
    _relAssert("empty tar has no synthetic root", new Process("tar").Arg("-tf").Arg(emptyArchive).Run().EnsureSuccess().Stdout.Length == 0);
}

// JSON 字符串数组 → "a,b"（与 String.Join 的期望值对比）。
string _relJoin(JsonValue arr) {
    var xs = new List<string>();
    for (int i = 0; i < arr.Count(); i = i + 1) { xs.Add(arr.At(i).AsString()); }
    return String.Join(",", xs.ToArray());
}
