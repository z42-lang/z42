namespace Z42Xtask;
using Std.IO;
using Std.Json;

int _testCargoArtifactInputs() {
    _testHostToolVm();
    _testPackagedDesktopPreparation();
    string work = _xtaskWork(_root(), "cargo-artifacts-selfcheck");
    _resetDir(work);
    try {
        string target = Path.Join(work, "separate target/library unit");
        string host = Path.Join(work, "separate host/macro unit");
        string native = Path.Join(work, "native inputs");
        string rlib = JsonValue.Stringify(JsonValue.OfString(Path.Join(target, "libbackend.rlib")));
        string macro = JsonValue.Stringify(JsonValue.OfString(Path.Join(host, "macro.dll")));
        string link = JsonValue.Stringify(JsonValue.OfString("native=" + native));
        string json = "{\"reason\":\"compiler-message\"}\n"
            + "{\"reason\":\"compiler-artifact\",\"filenames\":[" + rlib + "," + rlib + "]}\n"
            + "{\"reason\":\"compiler-artifact\",\"filenames\":[" + macro + "]}\n"
            + "{\"reason\":\"build-script-executed\",\"linked_paths\":[" + link + "]}\n"
            + "{\"reason\":\"build-finished\",\"success\":true}\n";
        File.WriteAllText(Path.Join(work, "cargo-artifacts.jsonl"), json);
        string[] paths = _cargoRecordedSearchPaths(work);
        if (paths.Length != 3 || !_strIn(paths, "dependency=" + target)
            || !_strIn(paths, "dependency=" + host) || !_strIn(paths, "native=" + native)) {
            throw new Exception("cargo-artifacts: target/host/native paths or deduplication failed");
        }
        File.WriteAllText(Path.Join(work, "cargo-artifacts.jsonl"), "{\"reason\":\"build-finished\",\"success\":true}\n");
        bool rejected = false;
        try { _cargoRecordedSearchPaths(work); } catch (Exception e) { rejected = true; }
        if (!rejected) { throw new Exception("cargo-artifacts: empty artifact graph accepted"); }
        _testStagedStdInputs(work);
    } finally { Directory.Delete(work, true); }
    Console.WriteLine("  PASS Cargo artifact paths and producer-owned Rust std");
    return 0;
}

void _testStagedStdInputs(string work) {
    string source = Path.Join(work, "producer");
    string dest = Path.Join(work, "consumer");
    Directory.Create(source); Directory.Create(dest);
    string pattern = _componentStdPattern();
    string name = pattern.Replace("*", "producer");
    string stale = Path.Join(dest, pattern.Replace("*", "obsolete"));
    File.WriteAllText(Path.Join(source, name), "producer std");
    File.WriteAllText(stale, "obsolete std");
    _componentCopyStagedStd(source, dest);
    if (File.Exists(stale) || File.ReadAllText(Path.Join(dest, name)) != "producer std") {
        throw new Exception("cargo-artifacts: producer std was replaced by local rustup or stale std survived");
    }
    File.Delete(Path.Join(source, name));
    bool rejected = false;
    try { _componentCopyStagedStd(source, dest); } catch (Exception e) { rejected = true; }
    if (!rejected) { throw new Exception("cargo-artifacts: missing producer std accepted"); }
    File.WriteAllText(Path.Join(source, name), "producer std");
    File.WriteAllText(Path.Join(source, pattern.Replace("*", "conflict")), "conflicting std");
    rejected = false;
    try { _componentCopyStagedStd(source, dest); } catch (Exception e) { rejected = true; }
    if (!rejected) { throw new Exception("cargo-artifacts: ambiguous producer std accepted"); }
    if (File.ReadAllText(Path.Join(dest, name)) != "producer std") {
        throw new Exception("cargo-artifacts: rejected copy changed destination");
    }
}

void _testHostToolVm() {
    string root = _root();
    string tree = _xtaskWork(root, "host-tool-vm");
    _resetDir(tree);
    try {
        Directory.Create(Path.Join(tree, "src/runtime/.cargo"));
        File.Copy(Path.Join(root, _runtimeCargoConfig()), Path.Join(tree, _runtimeCargoConfig()));
        string name = Platform.IsWindows() ? "z42vm.exe" : "z42vm";
        string ordinary = _builtVm(tree, "release");
        string component = Path.Join(_componentCargoOut(tree, "release"), name);
        string debug = Path.Join(_componentCargoOut(tree, "debug"), name);
        foreach (var path in new string[]{ ordinary, component, debug }) {
            Directory.Create(Path.GetDirectoryName(path)); File.WriteAllText(path, "producer entry");
        }
        _gateAssert(_hostToolVm(tree, "release") == ordinary, "host tools retain the ordinary producer when present");
        File.Delete(ordinary);
        _gateAssert(_hostToolVm(tree, "release") == component, "read-only consumers can use the package producer without rebuilding");
        _gateAssert(_builtVm(tree, "release") == ordinary, "consumer selection never redirects Cargo outputs");
        File.WriteAllText(component, "");
        bool rejected = false;
        try { _hostToolVm(tree, "release"); } catch (Exception e) { rejected = true; }
        _gateAssert(rejected, "empty release entries do not silently select debug");
        _gateAssert(_hostToolVm(tree, "release", true) == debug, "only callers requesting debug fallback use it");
        File.Delete(debug); rejected = false;
        try { _hostToolVm(tree, "release", true); } catch (Exception e) { rejected = true; }
        _gateAssert(rejected, "no host producer is an error");
    } finally { Directory.Delete(tree, true); }
    Console.WriteLine("  PASS host tool VM: ordinary/package producer, strict output paths, explicit debug and missing entries");
}

void _testPackagedDesktopPreparation() {
    string root = _root();
    string tree = _xtaskWork(root, "packaged-desktop-preparation");
    string? previous = Environment.GetEnvironmentVariable("Z42_RUNTIME_DIR");
    _resetDir(tree);
    try {
        Directory.Create(Path.Join(tree, "scripts"));
        File.Copy(Path.Join(root, "scripts/versions.toml"), Path.Join(tree, "scripts/versions.toml"));
        string pkg = Path.Join(tree, "runtime"); Directory.Create(pkg);
        RepoRoot.Value = tree;
        Environment.SetEnvironmentVariable("Z42_RUNTIME_DIR", pkg);
        var command = new TestAppCommand();
        _gateAssert(command.Invoke(new string[]{ "desktop", "build" }) != 0, "missing packaged native payload is rejected");
        _gateAssert(!Directory.Exists(Path.Join(tree, "artifacts")), "packaged C ABI validation does not prepare an unused builder or ordinary VM");
        Directory.Create(Path.Join(pkg, "native"));
        File.WriteAllText(Path.Join(pkg, "native/libz42.a"), "packaged native marker");
        var present = new TestAppCommand();
        _gateAssert(present.Invoke(new string[]{ "desktop", "build" }) == 0, "packaged build consumes native payload without requiring source toolchain");
        _gateAssert(!Directory.Exists(Path.Join(tree, "artifacts")), "valid packaged build creates no compiler artifacts");
    } finally {
        RepoRoot.Value = root;
        if (previous == null) { Environment.UnsetEnvironmentVariable("Z42_RUNTIME_DIR"); }
        else { Environment.SetEnvironmentVariable("Z42_RUNTIME_DIR", previous); }
        Directory.Delete(tree, true);
    }
    Console.WriteLine("  PASS packaged desktop: native payload errors without builder preparation");
}
