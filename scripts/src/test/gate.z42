// xtask — GREEN 与 e2e 编排，以及执行和列表共用的 stage 登记、skip 校验与计时。
namespace Z42Xtask;

using Std.IO;
using Std.Time;
using Std.Collections;
using Std.Cli;

// stage 耗时无条件输出，便于默认 verbosity 的 CI 日志定位瓶颈。

// stage 计时账本：名字 + 毫秒并行列表。
public sealed class StageLogZ {
    public List<string> Names;
    public List<long> Ms;
    public StageLogZ() { Names = new List<string>(); Ms = new List<long>(); }
    public void Add(string n, long ms) { Names.Add(n); Ms.Add(ms); }
}

StageRun _stageStart(string name) {
    Console.WriteLine("\n=== stage: " + name + " ===");
    StageRun r = new StageRun();
    r.Name = name;
    r.Sw = Stopwatch.StartNew();
    return r;
}

// 一个在跑的 stage：`_stageStart` 返回，`_stageEnd` 从它取名——名字只在 start 处写一遍。
class StageRun {
    public string Name;
    public Stopwatch Sw;
    public StageRun() { this.Name = ""; this.Sw = null; }
}

void _stageEnd(StageLogZ log, StageRun r) {
    long ms = r.Sw.Elapsed().TotalMilliseconds();
    log.Add(r.Name, ms);
    Console.WriteLine("--- stage: " + r.Name + " — " + _fmtDur(ms) + " ---");
}

// 降序耗时表 + 占比。
void _stageSummary(StageLogZ log, long totalMs) {
    if (log.Names.Count == 0) { return; }
    var order = new List<int>();
    for (int i = 0; i < log.Names.Count; i++) { order.Add(i); }
    order.Sort((a, b) => log.Ms[b] > log.Ms[a] ? 1 : (log.Ms[b] < log.Ms[a] ? -1 : 0));
    Console.WriteLine("\n── stage wall-clock (降序) ──");
    foreach (var k in order) {
        long pct = totalMs > 0 ? (log.Ms[k] * 100) / totalMs : 0;
        Console.WriteLine("  " + _padRight(log.Names[k], 48) + _fmtDur(log.Ms[k])
            + "  (" + pct.ToString() + "%)");
    }
    Console.WriteLine("  " + _padRight("TOTAL", 48) + _fmtDur(totalMs));
}

// ── test e2e ────────────────────────────────────────────────────────────────

// `test e2e [--dir <cat>] [--file <path>] [--mode interp|jit] [--no-rebuild] [--jobs=N]`
// — the src/tests end-to-end suite (single-source goldens + multi-package fixtures):
//   - default (no --dir/--file): run the golden runner over all categories, THEN the
//     cross-zpkg and multi-exe harnesses.
//   - `--dir cross-zpkg` / `--dir multi-exe`: only that harness.
//   - `--dir <cat>`: only that src/tests category's goldens (skips cross-zpkg + libs).
//   - `--file <path>`: a single golden case (name or source-path substring).
// The golden runner (_runVmGoldensF) and the cross-zpkg runner (_testCrossZpkgCore)
// stay separate harnesses; this only routes between them.
int _testE2e(TestE2eCommand c) {
    Stopwatch sw = _procStart("test e2e");
    string dir = c.Dir;
    string file = c.File;
    string modes = c.Mode.Length > 0 ? c.Mode : "interp jit";
    bool rebuild = !c.NoRebuild;
    bool noBuild = c.NoBuild;
    string[] mw = _splitWords(modes);
    string xmode = mw.Length > 0 ? mw[0] : "interp";   // cross-zpkg runs a single mode
    int[] shard = _parseShard(c.Shard);
    if (shard[1] > 0 && (dir == "cross-zpkg" || dir == "multi-exe")) {
        throw new CliException("--shard selects golden cases, not cross-zpkg or multi-exe fixtures");
    }
    int __rc;
    if (dir == "cross-zpkg") {
        // cross-zpkg only: build unless the caller opted out (--no-rebuild/--no-build)
        __rc = _testCrossZpkgCore(xmode, noBuild || !rebuild);
    } else if (dir == "multi-exe") {
        // multi-exe only: same build/consume prep as cross-zpkg.
        __rc = _testMultiExeCore(xmode, noBuild || !rebuild);
    } else {
        __rc = _testE2eCore(modes, rebuild, noBuild, c.Jobs, shard, dir, file);
        // default (no --dir/--file narrowing, and NOT sharded) also runs the cross-zpkg +
        // multi-exe harnesses once; the golden run above already built the toolchain (or --no-rebuild
        // was set), so cross-zpkg consumes it (noBuild=true) rather than rebuilding.
        // When sharded (CI vm-jit `--shard N/4`), skip it here: cross-zpkg is a fixed
        // multi-package set, NOT sharded, so running it per-shard is Nx redundant — the
        // CI drives it once via an explicit `--dir cross-zpkg` step. Local full runs
        // (`xtask test e2e`, unsharded) still get it.
        if (__rc == 0 && dir.Length == 0 && file.Length == 0 && shard[1] == 0) {
            __rc = _testCrossZpkgCore(xmode, true);
            if (__rc == 0) { __rc = _testMultiExeCore(xmode, true); }
        }
    }
    if (__rc == 0) { _procEnd("test e2e", sw); }
    return __rc;
}

// regen goldens for a test stage: --toolchain active OR --no-build set → z42c+stdlib
// already present, only regen the golden .zbc (_regenGolden, --toolchain-aware);
// else full _regenCore (rebuild stdlib + runtime + goldens). Shared: _testE2eCore + _testAll.
int _regenForTest(bool haveTc, bool noBuild) {
    return _regenForTestF(haveTc, noBuild, "", "");
}

// Filtered variant: on the warm path (_regenGolden), narrow the recompiled golden
// set to the --dir/--file selection so `test e2e --file X --no-build` recompiles
// only case X. The cold full-rebuild path (_regenCore: stdlib+runtime+all goldens)
// is unaffected — it's the "I changed the toolchain, rebuild everything" path.
int _regenForTestF(bool haveTc, bool noBuild, string dirFilter, string fileFilter) {
    return (haveTc || noBuild) ? _regenGoldenF(dirFilter, fileFilter) : _regenCore(true);
}

// cargo-build the DEBUG z42vm + z42-compression cdylib — the runtime the VM golden
// runner resolves (artifacts/build/runtime/debug/z42vm; JIT dlopens the compressor).
// Shared: _testE2eCore + _testAll.
int _buildDebugVmAndCompression() {
    return _buildRuntimeProfile("debug");
}

int _testE2eCore(string modes, bool rebuild, bool noBuild, string jobs, int[] shard, string dirFilter, string fileFilter) {
    if (jobs.Length == 0) { jobs = "1"; }
    // --toolchain / --no-build: consume an already-built z42c+stdlib → regen goldens
    // only; else full rebuild.
    bool haveTc = _toolchainDir(_root()).Length > 0;
    // Build the debug z42vm BEFORE regen (see _testAll): regen resolves the debug
    // vm, so a stale one lacking a new builtin panics during regen. Skipped under a
    // toolchain (its vm is used instead).
    if (!haveTc) {
        int cb = _buildDebugVmAndCompression();
        if (cb != 0) { return cb; }
    }
    if (rebuild) {
        int c = _regenForTestF(haveTc, noBuild, dirFilter, fileFilter);
        if (c != 0) { return c; }
    }
    // modes is a space-separated token string (e.g. "interp jit"); split to the
    // string[] _runVmGoldensF expects. jobs parses to int (default 1 on garbage).
    string[] modeList = _splitWords(modes);
    int jobsN = 1;
    try { jobsN = int.Parse(jobs); } catch (Exception e) { jobsN = 1; }
    return _runVmGoldensF(modeList, jobsN, shard[0], shard[1], dirFilter, fileFilter);
}

// ── cross-zpkg harness (invoked by `test e2e`) ──────────────────────────────

// cross-zpkg 与 multi-exe 两个 fixture harness 的**共用**构建前置：确保 debug z42vm
//（cargo，跑 fixtures）+ stdlib + z42c（种子自建，编 fixtures）就位。
//
// `--toolchain` 激活时整个跳过——工具链已供给 z42c+stdlib+z42vm，没有可建的东西。
// `noBuild` 同理（`test` 的 build wave / `test e2e` 的 golden run 已建过，或 --no-rebuild）。
// 返回 0 = 就位；非 0 = 构建失败的 rc，调用方直接透传。
//
// ⚠️ 这里的**次序**只此一份（z42vm 必须先于 stdlib 自建——stdlib 正是用 z42vm 建的），
// 别再在别处复制一份构建波。
int _ensureFixtureToolchain(bool noBuild) {
    if (noBuild || _toolchainDir(_root()).Length > 0) { return 0; }
    int cr = _buildDebugVmAndCompression();
    if (cr != 0) { return cr; }
    string root = _root();
    if (!File.Exists(Path.Join(_libsDir(root), "z42.core.zpkg"))) {
        int cs = _buildStdlib(); if (cs != 0) { return cs; }
    }
    return _buildCompiler();   // z42c 自建（种子）
}

int _testCrossZpkgCore(string mode, bool noBuild) {
    int c = _ensureFixtureToolchain(noBuild); if (c != 0) { return c; }
    return _testCrossZpkgImpl(mode);
}

// ── xtask test (unified GREEN gate) ───────────────────────────────────────────

// True if the comma/space-separated `skip` list names `stage`. Lets CI decompose
// the monolithic gate: test-host legs run `test --skip stdlib,cross-zpkg` while
// dedicated parallel jobs (stdlib-interp shards / cross-zpkg-interp) cover those
// stages — cutting the per-leg critical path. Local `xtask test` passes skip="" →
// full gate.
bool _skipHas(string skip, string stage) {
    return skip.Length > 0 && _strIn(_splitWords(skip.Replace(",", " ")), stage);
}

// stage 的名称、skip 键、改动分流类别与执行函数只在此登记；列表只读元数据，不调用 Body。
// Changes 是 `test changed` 跳过它的依据："" = 恒跑（构建波、goldens、秒级的全仓静态检查）；
// "rust" = 只随 Rust 运行时改动；"z42" = 执行 z42 代码，编译器 / stdlib / 运行时的改动都影响它。
class GateStage {
    public string Key;
    public string Name;
    public string Changes;
    public Func<int> Body;
    public GateStage(string key, string name, Func<int> body) {
        this.Key = key; this.Name = name; this.Changes = ""; this.Body = body;
    }
    public GateStage(string key, string name, string changes, Func<int> body) {
        this.Key = key; this.Name = name; this.Changes = changes; this.Body = body;
    }
}

GateStage[] _gateStages(bool noBuild) {
    return new GateStage[]{
        new GateStage("", "build wave (debug vm + regen)", () => _gateBuildWave(noBuild)),
        new GateStage("rust-units", "rust units (lib tests + test-target build)", "rust", () => _testRuntimeUnits()),
        // interp 本地必跑；JIT 由独立 CI job 覆盖。
        new GateStage("", "e2e goldens (interp; jit → vm-jit-consistency)",
            () => _testE2eCore("interp", false, false, "4", new int[2], "", "")),
        new GateStage("cross-zpkg", "e2e cross-zpkg", "z42", () => _testCrossZpkgCore("interp", true)),
        new GateStage("multi-exe", "e2e multi-exe", "z42", () => _testMultiExeCore("interp", true)),
        new GateStage("stdlib", "stdlib [Test]", "z42",
            () => _testLibCore("test", _allUnitProjects(_root(), "test"), true, "", "4", "interp", null, "", "", "")),
        new GateStage("toolchain", "toolchain [Test]", "z42", () => _testToolchainCore("", true, "", false)),
        // 只验 benchmark 语料能跑；时间回归由 bench-pr.yml 的 A/B 判定。
        new GateStage("bench", "stdlib [Benchmark]", "z42",
            () => _testLibCore("bench", _allUnitProjects(_root(), "bench"), true, "", "4", "interp", null, "", "", "")),
        new GateStage("targets", "manifest targets ([[test]] + [[example]])", "z42", () => _gateTargets()),
        new GateStage("examples", "examples (learn book transcripts)", "z42", () => _gateExamples()),
        new GateStage("docs", "docs (relative links)", () => _testDocs(_root())),
        new GateStage("compiler", "compiler", "z42", () => _testCompiler(true)),
        new GateStage("gcgen", "gc modes (z42c.semantics build)", "z42", () => _testGcModes()),
        new GateStage("vscode", "vscode-syntax", () => _testVscodeSyntax()),
        new GateStage("diagcodes", "diagcodes", () => _checkDiagCodes()),
        new GateStage("ci-shell", "ci-shell", () => _checkCiShell()),
        new GateStage("proc-env", "proc-env", () => _checkProcEnv()),
        new GateStage("layout", "layout", () => _checkLayout()),
        new GateStage("versions", "versions", () => _checkVersions()),
        new GateStage("doc-lints", "doc-lints", () => _checkDocLints())
    };
}

// debug VM 先于 regen，避免陈旧 VM 缺新增 builtin 而使整个构建波提前失败。
int _gateBuildWave(bool noBuild) {
    bool haveTc = _toolchainDir(_root()).Length > 0;
    int bc = _buildDebugVmAndCompression();
    return bc != 0 ? bc : _regenForTest(haveTc, noBuild);
}

int _gateTargets() {
    int rc = _testTargetsCore("test", "", true);
    return rc != 0 ? rc : _testManifestExamples(true);
}

int _listGateStages() {
    Console.WriteLine("skip key\tstage (execution order)");
    foreach (var stage in _gateStages(false)) {
        Console.WriteLine((stage.Key.Length == 0 ? "(required)" : stage.Key) + "\t" + stage.Name);
    }
    return 0;
}

// 未知 skip 键在任何构建 / 测试开始前报错，避免拼写错误被静默忽略。
string _unknownGateSkip(GateStage[] stages, string skip) {
    foreach (var key in _splitWords(skip.Replace(",", " "))) {
        bool known = false;
        foreach (var stage in stages) {
            if (stage.Key.Length > 0 && stage.Key == key) { known = true; break; }
        }
        if (!known) { return key; }
    }
    return "";
}

int _runGateStages(GateStage[] stages, string skip, StageLogZ log) {
    string bad = _unknownGateSkip(stages, skip);
    if (bad.Length > 0) {
        ConsoleError.WriteLine("error: unknown gate stage in --skip: " + bad + " (see xtask test --list)");
        return 2;
    }
    foreach (var stage in stages) {
        if (stage.Key.Length > 0 && _skipHas(skip, stage.Key)) { continue; }
        StageRun run = _stageStart(stage.Name);
        int rc = stage.Body();
        if (rc != 0) { return rc; }
        _stageEnd(log, run);
    }
    return 0;
}

// 顺序、首败短路、skip 与只读列表均消费同一张 stage 表。
int _testAll(bool noBuild, string skip) {
    Stopwatch sw = _procStart("test");
    StageLogZ log = new StageLogZ();
    int rc = _runGateStages(_gateStages(noBuild), skip, log);
    if (rc != 0) { return rc; }
    Console.WriteLine("\n✅ GREEN — all stages passed");
    _stageSummary(log, sw.Elapsed().TotalMilliseconds());
    _procEnd("test", sw);
    return 0;
}

// SDK 只在 stage 实际执行时准备；显式工具链直接消费，不改写它。
// --no-build 跳过 z42c / stdlib 构建波，apphost 与开发 SDK 仍由本 stage 准备。
int _gateExamples() {
    string sdk = _toolchainDir(_root());
    if (sdk.Length == 0) {
        int c = _buildToolchain(); if (c != 0) { return c; }
        c = _packageDevSdk(""); if (c != 0) { return c; }
    }
    ExamplesOptions eo = new ExamplesOptions();
    eo.Filter = ""; eo.Sdk = sdk; eo.BookOnly = false; eo.Bless = false; eo.Keep = false; eo.TimeoutS = 120;
    return _testExamples(eo);
}

// ── shard parsing (shared: _testE2eCore + the test-lib harness) ──────────────

// 空参数表示不分片；显式参数必须为 1 <= k <= n，错误须在任何构建前交给 CLI 返回 2。
int[] _parseShard(string s) {
    int[] r = new int[2]; r[0] = 0; r[1] = 0;
    if (s.Length == 0) { return r; }
    string[] parts = s.Split("/");
    if (parts.Length == 2) {
        try { r[0] = int.Parse(parts[0]); r[1] = int.Parse(parts[1]); }
        catch (Exception e) { r[1] = 0; }
    }
    if (r[0] < 1 || r[1] < 1 || r[0] > r[1]) {
        throw new CliException("invalid --shard '" + s + "' (expected k/n with 1 <= k <= n)");
    }
    return r;
}

