// 用独立 Git 仓库和索引验证真实读取失败；不接触工作树自身的索引。
namespace Z42Xtask;

using Std.IO;

int _selfcheckChangedGit() {
    string dir = _xtaskWork(_root(), "changed-git");
    string cwd = Environment.GetCurrentDirectory();
    string? index = Environment.GetEnvironmentVariable("GIT_INDEX_FILE");
    _resetDir(dir);
    // 本自检串行运行；cwd / 环境在 finally 中恢复，后续 stage 不受影响。
    try {
        Environment.SetCurrentDirectory(dir);
        string fixtureIndex = Path.Join(dir, "fixture-index");
        Environment.SetEnvironmentVariable("GIT_INDEX_FILE", fixtureIndex);
        _gitOutput(new string[]{ "init", "--quiet" });
        File.WriteAllText(Path.Join(dir, ".gitignore"), "fixture-index*\n");
        File.WriteAllText(Path.Join(dir, "README.md"), "base\n");
        _writeChangedWorkspaces(dir);
        _gitOutput(new string[]{ "add", "." });
        _gitOutput(new string[]{ "-c", "user.name=xtask", "-c", "user.email=xtask@example.invalid",
            "-c", "commit.gpgsign=false", "commit", "--quiet", "-m", "fixture" });
        _gateAssert(_changedFiles("HEAD").Length == 0, "clean Git diff remains empty");
        _gateAssert(_changedGateSkips("HEAD") == String.Join(",", _changedScopedStages()), "clean diff skips scoped stages");

        _checkWorkspaceChangedGit(dir);

        File.WriteAllText(Path.Join(dir, "README.md"), "changed\n");
        Directory.Create(Path.Join(dir, "src/runtime/tests"));
        File.WriteAllText(Path.Join(dir, "src/runtime/tests/new.rs"), "// untracked\n");
        string[] files = _changedFiles("HEAD");
        _gateAssert(String.Join(",", files) == "README.md,src/runtime/tests/new.rs", "tracked and untracked Git changes");
        _gateAssert(!_skipHas(_changedGateSkips("HEAD"), "rust-units"), "untracked runtime test keeps Rust units");

        _checkSdkChangedGit(dir);

        // rev-parse 仍成功，但 diff / ls-files 会因损坏索引失败。
        File.WriteAllText(fixtureIndex, "bad index");
        _gateAssert(_isInGitRepo(), "bad-index fixture is still a Git repository");
        _gateAssert(_testChangedRun("HEAD", true) == 2, "bad index must fail explicit changed command");
        _gateAssert(_changedGateSkips("HEAD").Length == 0, "bad index must keep every stage");
        File.Delete(fixtureIndex);

        _gateAssert(_testChangedRun("xtask-missing-base", true) == 2, "invalid base must fail explicit changed command");
        _gateAssert(_changedGateSkips("xtask-missing-base").Length == 0, "invalid base must keep every stage");
    } finally {
        Environment.SetCurrentDirectory(cwd);
        if (index == null) { Environment.UnsetEnvironmentVariable("GIT_INDEX_FILE"); }
        else { Environment.SetEnvironmentVariable("GIT_INDEX_FILE", index); }
        Directory.Delete(dir, true);
    }
    Console.WriteLine("  ✅ changed Git: workspace owners, rename, tracked/untracked, bad index, invalid base");
    return 0;
}

void _writeChangedWorkspaces(string root) {
    _writeTestProject(Path.Join(root, "src/libraries/groups/src/renamed"), "named.z42.toml", "lib.declared");
    _writeTestProject(Path.Join(root, "src/libraries/groups/src/ignored"), "z42.toml", "lib.ignored");
    File.WriteAllText(_libsWsToml(root),
        "[workspace]\nmembers = [\"groups/src/*\"]\nexclude = [\"groups/src/ignored\"]\n");
    _writeTestProject(Path.Join(root, "src/compiler/groups/tests/other"), "z42.toml", "compiler.declared");
    File.WriteAllText(_compilerWsToml(root), "[workspace]\nmembers = [\"groups/tests/*\"]\n");
}

void _checkWorkspaceChangedGit(string root) {
    string lib = "src/libraries/groups/src/renamed";
    string newTest = lib + "/tests/é case.z42";
    File.WriteAllText(Path.Join(root, newTest), "// test input\n");
    _gateAssert(String.Join(";", _changedFiles("HEAD")) == newTest, "Git preserves literal paths");
    _gateAssert(String.Join(";", _buildChangedPlan(_changedFiles("HEAD"), root)) == "xtask test stdlib lib.declared",
        "nested member uses the declared name");
    string skip = _changedGateSkips("HEAD");
    _gateAssert(!_skipHas(skip, "stdlib") && _skipHas(skip, "compiler") && _skipHas(skip, "rust-units"),
        "private library tests stay narrow even under a workspace directory named src");
    File.Delete(Path.Join(root, newTest));

    string ws = _libsWsToml(root);
    string saved = File.ReadAllText(ws);
    File.WriteAllText(ws, saved + "# modified\n");
    _gateAssert(String.Join(";", _buildChangedPlan(_changedFiles("HEAD"), root)) == "xtask test stdlib;xtask test e2e",
        "workspace manifest chooses the library domain without a package argument");
    File.WriteAllText(ws, saved);

    _gitOutput(new string[]{ "mv", lib + "/source.z42", lib + "/tests/renamed.z42" });
    string[] renamed = _changedFiles("HEAD");
    _gateAssert(String.Join(";", renamed) == lib + "/source.z42;" + lib + "/tests/renamed.z42",
        "rename selects both the former source and the new test");
    _gateAssert(String.Join(";", _buildChangedPlan(renamed, root)) == "xtask test",
        "custom source outside conventional directories preserves full coverage after rename");
    _gitOutput(new string[]{ "restore", "--staged", "--worktree", "--", lib });

    _gateAssert(String.Join(";", _buildChangedPlan(new string[]{ "src/compiler/groups/tests/other/benches/case.z42" }, root))
        == "xtask bench stdlib compiler.declared;xtask test compiler", "compiler bench uses owner-relative path and declared name");
    _gateAssert(String.Join(";", _buildChangedPlan(new string[]{ "src/libraries/groups/src/ignored/tests/case.z42" }, root))
        == "xtask test", "excluded project cannot become a named test command");
    Directory.Delete(Path.Join(root, lib), true);
    _gateAssert(String.Join(";", _buildChangedPlan(_changedFiles("HEAD"), root)) == "xtask test",
        "removed member falls back to full coverage");
    _gitOutput(new string[]{ "restore", "--worktree", "--", lib });
    _gateAssert(_changedFiles("HEAD").Length == 0, "workspace fixture restored");
}

void _checkSdkChangedGit(string dir) {
    File.WriteAllText(Path.Join(dir, "README.md"), "base\n");
    File.Delete(Path.Join(dir, "src/runtime/tests/new.rs"));
    string sdk = Path.Join(dir, "scripts/src/test/sdk");
    Directory.Create(sdk);
    File.WriteAllText(Path.Join(sdk, "new.z42"), "// untracked SDK verifier\n");
    string fixture = Path.Join(dir, "src/toolchain/launcher/tests/fixtures/package/case");
    Directory.Create(fixture);
    File.WriteAllText(Path.Join(fixture, "expect.toml"), "# SDK fixture\n");
    _gateAssert(String.Join(";", _buildChangedPlan(_changedFiles("HEAD"))) == "xtask package sdk --verify",
        "real Git SDK roles select one verification command");
    _gateAssert(_changedGateSkips("HEAD") == String.Join(",", _changedScopedStages()),
        "SDK verification does not claim GREEN stages");
    Directory.Create(Path.Join(dir, "scripts/common"));
    File.WriteAllText(Path.Join(dir, "scripts/src/common/shared.z42"), "// untracked shared script\n");
    _gateAssert(String.Join(";", _buildChangedPlan(_changedFiles("HEAD"))) == "xtask test;xtask package sdk --verify",
        "real Git full fallback preserves SDK verification");
    _gateAssert(_testChangedRun("HEAD", true) == 0, "mixed SDK dry run");
}
