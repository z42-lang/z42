// xtask — VM golden-test runner (`test e2e`), interp / jit mode. The golden-walk +
// entry-derivation helpers live in common/golden.z42.
//
// Each golden case's source + sidecars live in src; the compiled .zbc lives in the
// artifacts mirror (_goldenArtifactDir — keeps src/ free of build output):
//   src/tests/<cat>/<name>/source.z42 + expected_output.txt
//     → artifacts/build/tests/<cat>/<name>/source.zbc                     (dir)
//   src/libraries/<lib>/tests/<name>/source.z42
//     → artifacts/build/libraries/<lib>/release/tests/<name>/source.zbc   (dir)
//   src/tests/<cat>/<name>.z42 + <name>.expected_output.txt
//     → artifacts/build/tests/<cat>/<name>.zbc                            (flat)
//
// For each case: derive entry name from the .z42 source (`<namespace>.Main` > `Main` >
// `<namespace>.main` > `main`), then run `z42vm <artifact> <entry> --mode <mode>` and
// require a zero exit and empty stderr, then compare stdout against the expected file.
//
// Parallel mode: spawn `jobs` subprocesses per batch via Process.Spawn,
// wait on the batch, then aggregate. Output is collected into per-job
// strings and printed in original order so the terminal stays readable.
//
// Goldens deliberately run against the DEBUG vm binary (keeps debug-assertions +
// overflow-checks coverage); the caller _testE2eCore builds it first.
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

// Returns 0 if every case in every mode passes, 1 on any failure (or setup error).
// shardK/shardN (both > 0) split the golden set across parallel CI machines: a
// shard keeps cases whose stable enumeration index ≡ shardK-1 (mod shardN). 0/0 =
// run all. The empty-set guard runs on the FULL set so a (legitimately) empty shard
// is not an error.
// `test e2e` sub-selection: dirFilter narrows to one src/tests/<cat>; fileFilter
// matches a case by name or a source-path substring. Both "" = run everything.
int _runVmGoldensF(string[] modes, int jobs, int shardK, int shardN, string dirFilter, string fileFilter) {
    string root = _root();
    if (jobs < 1) { jobs = 1; }

    // --toolchain: run goldens on the toolchain's z42vm (release) when a toolchain is
    // selected; else the build-tree debug binary.
    string vmBin = _activeVm(root, "debug");
    if (!File.Exists(vmBin)) {
        ConsoleError.WriteLine("error: VM binary not found at " + vmBin);
        ConsoleError.WriteLine("       Build via: (cd src/runtime && cargo build)");
        return 1;
    }

    // Pin each golden VM's Z42_LIBS to the freshly-built stdlib so it resolves the
    // NEW z42.core, not whatever stale Z42_LIBS the xtask apphost inherited (e.g.
    // an installed .z42/libs). Without this, a golden using a brand-new stdlib
    // function/extern fails at run time with "undefined function" against a stale
    // z42.core, even though it compiled fine. Mirrors the regen step's stdlibDist selection.
    // Z42_HOME (--toolchain) may be an SDK layout (has libs/) or a managed layout
    // (runtimes/, no libs/); use the toolchain libs only when they actually exist,
    // else the build-tree stdlib.
    string tc = _toolchainDir(root);
    string tcLibs = (tc.Length > 0) ? _toolchainLibs(tc) : "";
    string goldenLibs = (tcLibs.Length > 0 && File.Exists(Path.Join(tcLibs, "z42.core.zpkg")))
        ? tcLibs : _libsDir(root);

    int overallPass = 0;
    int overallFail = 0;

    foreach (var mode in modes) {
        Console.WriteLine("══════════════════════════════════════");
        Console.WriteLine(" Mode: " + mode);
        Console.WriteLine("══════════════════════════════════════");

        _Case[] cases = _enumerateCasesF(root, mode, dirFilter, fileFilter);
        if (cases.Length == 0) {
            if (dirFilter.Length > 0 || fileFilter.Length > 0) {
                ConsoleError.WriteLine("❌ no golden cases match --dir/--file filter.");
            } else {
                ConsoleError.WriteLine("❌ no runnable golden fixtures found.");
                ConsoleError.WriteLine("   Hint: run `xtask build test` first.");
            }
            return 1;
        }
        if (shardN > 0) {
            List<_Case> f = new List<_Case>();
            for (int ci = shardK - 1; ci < cases.Length; ci = ci + shardN) { f.Add(cases[ci]); }
            cases = f.ToArray();
            Console.WriteLine(" shard " + shardK.ToString() + "/" + shardN.ToString()
                + ": " + cases.Length.ToString() + " cases");
        }

        int[] pf = _runVmCases(cases, vmBin, goldenLibs, mode, jobs);
        Console.WriteLine("");
        Console.WriteLine("  Result: " + pf[0].ToString() + " passed, "
            + pf[1].ToString() + " failed");
        Console.WriteLine("");

        overallPass = overallPass + pf[0];
        overallFail = overallFail + pf[1];
    }

    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Total: " + overallPass.ToString() + " passed, "
        + overallFail.ToString() + " failed");
    Console.WriteLine("══════════════════════════════════════");

    if (overallFail > 0) {
        return 1;
    }
    return 0;
}

// Run all cases for one mode — sequential (jobs<=1) or parallel batches.
// Returns [pass, fail].
int[] _runVmCases(_Case[] cases, string vmBin, string libs, string mode, int jobs) {
    var runnable = new List<_Case>();
    int fail = 0;
    foreach (var c in cases) {
        if (File.Exists(c.artifact)) {
            runnable.Add(c);
        } else {
            Console.WriteLine("  FAIL: " + c.name + " (missing bytecode)");
            Console.WriteLine("    " + c.artifact);
            fail = fail + 1;
        }
    }
    if (fail > 0) { Console.WriteLine("    Hint: run `xtask build test` to regenerate golden bytecode."); }
    if (jobs > 1) {
        int[] result = _runVmBatch(runnable.ToArray(), vmBin, libs, mode, jobs);
        result[1] = result[1] + fail;
        return result;
    }
    int pass = 0;
    foreach (var c in runnable) {
        if (_runOneCase(vmBin, libs, c, mode)) { pass = pass + 1; }
        else { fail = fail + 1; }
    }
    return new int[] { pass, fail };
}

// Parallel: spawn `jobs` cases per batch, wait on the batch, then judge + print
// failures in original order so the terminal stays readable. Returns [pass, fail].
int[] _runVmBatch(_Case[] cases, string vmBin, string libs, string mode, int jobs) {
    int pass = 0;
    int fail = 0;
    int i = 0;
    while (i < cases.Length) {
        int batchSize = jobs;
        if (i + batchSize > cases.Length) { batchSize = cases.Length - i; }

        ProcessHandle[] handles = new ProcessHandle[batchSize];
        _Case[]         batch   = new _Case[batchSize];
        int b = 0;
        while (b < batchSize) {
            batch[b] = cases[i + b];
            handles[b] = _spawnCase(vmBin, libs, batch[b], mode);
            b = b + 1;
        }

        b = 0;
        while (b < batchSize) {
            ProcessResult r = handles[b].Wait();
            if (_checkGoldenResult(batch[b], r)) {
                pass = pass + 1;
            } else {
                fail = fail + 1;
            }
            b = b + 1;
        }
        i = i + batchSize;
    }
    return new int[] { pass, fail };
}

// ── Case shape ───────────────────────────────────────────────────────────

class _Case {
    public string name;
    public string artifact;     // .zbc path
    public string expected;     // expected_output.txt path
    public string entryName;    // <ns>.Main / Main / <ns>.main / main

    public _Case(string name, string artifact, string expected, string entryName) {
        this.name = name;
        this.artifact = artifact;
        this.expected = expected;
        this.entryName = entryName;
    }
}

// ── Execution ────────────────────────────────────────────────────────────

bool _runOneCase(string vmBin, string libs, _Case c, string mode) {
    ProcessResult r;
    try {
        r = _z42Proc(vmBin, libs)
            .Arg(c.artifact).Arg(c.entryName).Arg("--mode").Arg(mode)
            .Run();
    } catch (Exception e) {
        Console.WriteLine("  FAIL: " + c.name);
        Console.WriteLine("    (spawn error: " + e.Message + ")");
        return false;
    }
    return _checkGoldenResult(c, r);
}

ProcessHandle _spawnCase(string vmBin, string libs, _Case c, string mode) {
    return _z42Proc(vmBin, libs)
        .Arg(c.artifact).Arg(c.entryName).Arg("--mode").Arg(mode)
        .Stdout(Stdio.Pipe())
        .Stderr(Stdio.Pipe())
        .Spawn();
}

bool _checkGoldenResult(_Case c, ProcessResult r) {
    string expected = "";
    if (File.Exists(c.expected)) { expected = File.ReadAllText(c.expected); }
    string failure = _goldenResultFailure(expected, r);
    if (failure.Length == 0) { return true; }
    Console.WriteLine("  FAIL: " + c.name);
    Console.WriteLine(failure);
    return false;
}

string _goldenResultFailure(string expected, ProcessResult r) {
    string failure = "";
    if (r.ExitCode != 0) { failure = "    expected exit 0, got " + r.ExitCode.ToString() + "\n"; }
    if (r.Stderr.Length > 0) { failure = failure + "    stderr: " + _firstLines(r.Stderr, 4) + "\n"; }
    string expectedStdout = _stripTrailingNewlines(expected);
    string actualStdout = _stripTrailingNewlines(r.Stdout);
    if (actualStdout != expectedStdout) {
        string[] wanted = expectedStdout.Length == 0 ? new string[0] : expectedStdout.Split("\n");
        string[] actual = actualStdout.Length == 0 ? new string[0] : actualStdout.Split("\n");
        int i = 0;
        while (i < wanted.Length && i < actual.Length && wanted[i] == actual[i]) { i = i + 1; }
        failure = failure + "    stdout line " + (i + 1).ToString() + "\n"
            + "      expected: " + (i < wanted.Length ? wanted[i] : "<end of output>") + "\n"
            + "      actual:   " + (i < actual.Length ? actual[i] : "<end of output>");
    }
    return _stripTrailingNewlines(failure);
}

// ── Enumeration ──────────────────────────────────────────────────────────

// Run-golden selection over the shared walk (_walkGoldenCorpus, common/golden.z42).
// Select and shard by source so missing mirror artifacts fail on the owning shard
// without changing the assignment of the remaining cases.
_Case[] _enumerateCasesF(string root, string mode, string dirFilter, string fileFilter) {
    List<_Case> cases = new List<_Case>();
    foreach (var e in _walkGoldenCorpus(root)) {
        if (e.seg == "lib-file" || !e.hasSource) { continue; }
        if (mode == "jit" && e.interpOnly) { continue; }
        if (e.isLib) {
            // Library golden tests are not a src/tests category, so a --dir <cat>
            // filter excludes them entirely.
            if (dirFilter.Length > 0) { continue; }
            if (fileFilter.Length > 0 && !_e2eIncluded("", e.name, e.src, "", fileFilter)) { continue; }
            // [Test]/[Benchmark] dir tests (e.g. z42.crypto/tests/secp256k1) have no
            // Main and are run by `xtask test stdlib` via z42b — the golden runner
            // must skip them (else "entry function …Main not found").
            if (e.hasTestMethods) { continue; }
        } else {
            if (_isExcludedDirName(e.cat, e.name)) { continue; }
            if (!_e2eIncluded(e.cat, e.name, e.src, dirFilter, fileFilter)) { continue; }
        }
        // run-golden .zbc lives in the artifacts mirror, not beside source.z42. Sidecars
        // (expected_output.txt, interp_only, source.z42 for entry derivation) stay in src.
        cases.Add(new _Case(e.name, _entryZbc(root, e), e.expected, _deriveEntry(e.src)));
    }
    return cases.ToArray();
}
