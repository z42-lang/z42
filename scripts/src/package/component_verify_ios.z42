// Exercise the production iOS exporter with the actual published Framework set.
namespace Z42Xtask;
using Std.IO;
using Std.Cli;

int _componentIosVerifyExport(string root, string pkg, string zbc, string work) {
    string source = Path.Join(work, "export-probe");
    Directory.Create(source);
    File.Copy(Path.Join(root, "src/toolchain/workload/ios/appbuilder/export.z42"), Path.Join(source, "export.z42"));
    File.WriteAllText(Path.Join(source, "probe.z42"),
        "namespace ComponentExportProbe;\nusing Std.IO;\nusing Z42.Workload.Ios;\n"
        + "void Main() { string[] args = Environment.GetCommandLineArgs(); IosExport.Generate(args[0], \"ComponentExport\", \"org.z42.component-export\", \"ComponentExport\", \"16.0\", args[1], args[2]); }\n");
    string manifest = Path.Join(source, "z42.toml");
    File.WriteAllText(manifest,
        "[project]\nname=\"component.ios.export\"\nkind=\"exe\"\n"
        + "[sources]\ninclude=[\"*.z42\"]\n[build]\noutput_dir=\"build\"\n");
    int c = _exec(_z42cProcMode(_builtVm(root, "release"), _libsDir(root), _driverZpkg(root, "release"), "interp")
        .Arg("build").Arg(manifest));
    if (c != 0) { return c; }
    string project = Path.Join(work, "xcode-consumer");
    c = _exec(_z42Proc(_builtVm(root, "release"), _libsDir(root)).Arg("--mode").Arg("interp")
        .Arg(Path.Join(source, "build/dist/component.ios.export.zpkg")).Arg("--").Arg(project).Arg(zbc).Arg(pkg));
    if (c != 0) { return c; }
    foreach (var stem in _iosFrameworkStems("iossim-arm64")) {
        if (!File.Exists(Path.Join(project, stem + ".framework/" + stem))) {
            throw new CliException("exported Xcode project omitted runtime framework " + stem);
        }
    }
    string build = Path.Join(work, "xcode-build");
    c = _exec(new Process("xcodebuild")
        .Arg("-project").Arg(Path.Join(project, "ComponentExport.xcodeproj"))
        .Arg("-scheme").Arg("ComponentExport").Arg("-configuration").Arg("Release")
        .Arg("-sdk").Arg("iphonesimulator").Arg("-arch").Arg("arm64")
        .Arg("-derivedDataPath").Arg(build).Arg("CODE_SIGNING_ALLOWED=NO").Arg("build"));
    if (c != 0) { return c; }
    string app = Path.Join(build, "Build/Products/Release-iphonesimulator/ComponentExport.app");
    foreach (var stem in _iosFrameworkStems("iossim-arm64")) {
        if (!File.Exists(Path.Join(app, "Frameworks/" + stem + ".framework/" + stem))) {
            throw new CliException("built Xcode app omitted runtime framework " + stem);
        }
    }
    string dependencies = _cmdOut("otool", new string[]{ "-L", Path.Join(app, "ComponentExport") });
    if (dependencies.Contains("z42_profiler.framework")) {
        throw new CliException("Xcode app eagerly links the optional profiler");
    }
    return 0;
}
