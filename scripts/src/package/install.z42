// xtask — 把 packages.toml 的组件**直接装进包目录**（不经暂存根）。
//
// 一个包（sdk / runtime）= 按 `[package.<name>].include` 的顺序，把每个组件装到它在包里的落点：
//   · cargo-bin（z42vm，带 native_closure 动态闭包）/ cargo-native / stdlib-glob / editor-assets —— 从构建产物拷到 `dest`；
//   · apphost（launcher / z42c / z42b / z42d / z42i）—— `z42b publish --output <包目录>`，组件自带的
//     `[platform.desktop] bin/payload` 决定落点（`bin/<名>` + `programs/<名>/`），工程路径取 packages.toml 的 `project`。
//
// 为什么不经暂存：固定形态组件本就是从构建产物拷出来的；apphost 组件 publish 不清空 `--output`、各落各的
// 子目录，可以直接发布进包目录；apphost 组件的工程路径只读 packages.toml。
// packages.toml 是「哪个包装哪些组件」的唯一声明；本文件只按 kind 分派「怎么装」。
//
// apphost-stub（desktop workload 的 per-RID stub）不经这里：它只进 workload-desktop 包，由
// `_buildDesktopWorkload` 自己装（落点按 RID 变）。
namespace Z42Xtask;

using Std.IO;

// 装组件需要的构建上下文。runtime 包只用到 CargoOut；apphost 组件要求后五项齐全（缺则报错，不静默跳过）。
class _PkgInstallCtx {
    public string CargoOut;      // 宿主/目标 RID 的 cargo 输出目录（libz42.* 等组件动态库）
    public string LauncherOut;   // z42vm 静态 std 启动器图的输出目录；空 = 回落 CargoOut
    public string HostVm;        // 跑 z42b 的宿主 z42vm
    public string Z42bZpkg;      // 已编好的 z42.builder.zpkg
    public string Libs;          // z42b 自身的解析面（_toolchainCompileLibs）
    public string ApphostStub;   // 未 patch 的 apphost 模板（Z42_APPHOST_TEMPLATE）
    public string Rid;
    public _PkgInstallCtx() {
        this.CargoOut = ""; this.LauncherOut = ""; this.HostVm = ""; this.Z42bZpkg = ""; this.Libs = ""; this.ApphostStub = ""; this.Rid = "";
    }
}

// 按 `[package.<packageName>].include` 顺序把每个组件装进 pkgDir。任一组件失败 ⇒ 立即返回非 0（不留半个包当成功）。
int _pkgInstallPackage(_PackagesConfig cfg, string root, string packageName, string pkgDir, _PkgInstallCtx ctx) {
    foreach (var comp in _pkgcfgResolveInclude(cfg, packageName)) {
        int c = _pkgInstallComponent(root, comp, pkgDir, ctx);
        if (c != 0) {
            ConsoleError.WriteLine("error: [package." + packageName + "] component '" + comp.name
                + "' (kind=" + comp.kind + ") failed to install into " + pkgDir);
            return c;
        }
        Console.WriteLine("      ✓ " + comp.name);
    }
    return 0;
}

int _pkgInstallComponent(string root, _PkgComponent comp, string pkgDir, _PkgInstallCtx ctx) {
    if (comp.kind == "cargo-bin" && comp.name == "z42vm") { return _pkgInstallZ42vm(ctx, pkgDir); }
    if (comp.kind == "cargo-native")  { return _pkgInstallNative(root, ctx.CargoOut, pkgDir); }
    if (comp.kind == "stdlib-glob")   { return _pkgCopyLibs(_libsDir(root), pkgDir); }
    if (comp.kind == "editor-assets") { return _pkgInstallEditorAssets(root, pkgDir) > 0 ? 0 : 1; }
    if (comp.kind == "apphost")       { return _pkgInstallApphost(comp, pkgDir, ctx); }
    ConsoleError.WriteLine("error: packages.toml component '" + comp.name + "' kind '" + comp.kind
        + "' cannot be installed into a package here (apphost-stub belongs to the desktop workload)");
    return 1;
}

// [component.z42vm] kind=cargo-bin, dest="bin/z42vm"。取静态 std 启动器图（LauncherOut）的
// 产物 —— bin/ 只有 exe 本体，共享 Rust std 只随 native/ 分发；未建启动器的开发流程回落组件动态图。
int _pkgInstallZ42vm(_PkgInstallCtx ctx, string pkgDir) {
    string cargoOut = ctx.LauncherOut.Length > 0 ? ctx.LauncherOut : ctx.CargoOut;
    if (cargoOut.Length == 0) { ConsoleError.WriteLine("error: z42vm: no cargo output dir"); return 1; }
    string bin = Path.Join(pkgDir, "bin");
    Directory.Create(bin);
    _copyIfExists(Path.Join(cargoOut, "z42vm"), Path.Join(bin, "z42vm"));
    _copyIfExists(Path.Join(cargoOut, "z42vm.exe"), Path.Join(bin, "z42vm.exe"));
    if (!File.Exists(Path.Join(bin, "z42vm")) && !File.Exists(Path.Join(bin, "z42vm.exe"))) {
        ConsoleError.WriteLine("error: z42vm not built in " + cargoOut);
        return 1;
    }
    _makeExe(Path.Join(bin, "z42vm"));
    // native_closure：z42vm 的动态闭包（组件动态库 + 恰好一份共享 std）装进同包 native/ ——
    // 运行期发现路径 <exe>/../native/ 与之咬合。旧树无该字段时回退（有 CargoOut 即装，保持
    // native-ext 时代的 SDK 内容不变）。
    if (cargoOut.Length > 0) {
        _componentInstallLibraries(cargoOut, pkgDir);
    }
    // NB: the host-only REPL editor cdylib (libz42_repl) is NOT put into bin/ — it
    // ships in programs/z42i/ beside the interactive apphost payload, colocated there by
    // z42.repl's ProvideNative build hook during `z42b publish`.
    // Keeping it out of the shared bin/ stops the eager ext scanner (native::ext) from
    // warning `ignoring unknown lib repl` on every VM run.
    return 0;
}

// [component.native] kind=cargo-native, dest="native/" — the libz42 embedding libs + the C ABI headers
// + the stdlib ext dylibs (an embedded VM dlopens them too). Runtime package only.
int _pkgInstallNative(string root, string cargoOut, string pkgDir) {
    if (cargoOut.Length == 0) { ConsoleError.WriteLine("error: native: no cargo output dir"); return 1; }
    _componentInstallLibraries(cargoOut, pkgDir, true);
    _componentCopyRequired(_componentStaticArchive(cargoOut), Path.Join(pkgDir, Platform.IsWindows() ? "native/z42.lib" : "native/libz42.a"));
    _componentCopyStaticFiles(Path.GetDirectoryName(Path.GetDirectoryName(_componentStaticArchive(cargoOut))),
        Path.Join(pkgDir, "native"), _detectHostRid());
    _copyAbiHeaders(root, Path.Join(pkgDir, "native/include"));
    return 0;
}

// [component.<apphost>] kind=apphost — `z42b publish <project> --output <pkgDir>`（部署已编好的字节，--no-build）。
// publish 不清空 --output，各组件落在自己的 bin/<名> + programs/<名>/，互不覆盖。
int _pkgInstallApphost(_PkgComponent comp, string pkgDir, _PkgInstallCtx ctx) {
    if (comp.project.Length == 0) {
        ConsoleError.WriteLine("error: apphost component '" + comp.name + "' has no `project` in packages.toml");
        return 1;
    }
    if (ctx.HostVm.Length == 0 || ctx.Z42bZpkg.Length == 0 || ctx.ApphostStub.Length == 0 || ctx.Rid.Length == 0) {
        ConsoleError.WriteLine("error: apphost component '" + comp.name + "' needs z42b + apphost stub (not built for this package)");
        return 1;
    }
    return _z42bPublish(ctx.HostVm, ctx.Z42bZpkg, ctx.Libs, ctx.ApphostStub, comp.project, ctx.Rid, pkgDir);
}

// Copy the two C ABI headers (z42_abi.h + z42_host.h) from the runtime source
// tree into a package's include dir. Single source-path SoT for every packaging
// backend that ships the embed headers. Creates destIncludeDir
// itself — 谁写谁建，见 _pkgSetupDir 注释。
void _copyAbiHeaders(string root, string destIncludeDir) {
    Directory.Create(destIncludeDir);
    File.Copy(Path.Join(root, "src/runtime/include/z42_abi.h"), Path.Join(destIncludeDir, "z42_abi.h"));
    File.Copy(Path.Join(root, "src/runtime/include/z42_host.h"), Path.Join(destIncludeDir, "z42_host.h"));
    File.Copy(Path.Join(root, "src/runtime/include/z42_native.h"), Path.Join(destIncludeDir, "z42_native.h"));
}

// Runtime package (z42-runtime-<ver>-<rid>) scaffold: compute the pkg dir, print
// the banner, reset it, and create native/ (the ios/wasm/android builders File.Copy
// their VM libs straight into it). libs/ + native/include/ are created by their own
// writers（谁写谁建，见 _pkgSetupDir 注释）. Returns pkgDir. Single SoT for the
// runtime-pack name format + base layout (shared by ios/android/wasm runtime
// builders). Debug profile appends "-<profile>" to the name.
string _runtimePkgScaffold(string root, string rid, string version, string profile) {
    bool rel = (profile == "release");
    string pkgName = "z42-runtime-" + version + "-" + rid + (rel ? "" : "-" + profile);
    string pkgDir = Path.Join(_packagesDir(root), pkgName);
    Console.WriteLine("Runtime package: " + pkgName);
    if (Directory.Exists(pkgDir)) { Directory.Delete(pkgDir, true); }
    Directory.Create(Path.Join(pkgDir, "native"));
    return pkgDir;
}

// Runtime package 收尾（`_runtimePkgScaffold` 的另一半，ios / android / wasm 共用）：装 stdlib libs/，然后跑门。
// runtime pack 才是 libs/ + native/include/ 的真正落点 —— 门必须跑在这里（workload pack 一个
// source-derived 文件都不装）。stepLabel 是各 builder 自己的 "[k/n]" 步号。
int _runtimePkgFinish(string root, string pkgDir, string rid, string stepLabel, string profile = "release") {
    Console.WriteLine("  " + stepLabel + " libs/");
    int c = _pkgCopyLibs(_libsDir(root), pkgDir); if (c != 0) { return c; }
    string cat = _ridCategory(rid);
    _rtEmitRuntimeManifest(pkgDir, rid, profile, _versionsGet(root),
        (cat == "android" || cat == "ios") ? "mixed" : "static",
        _componentPlatformOut(root, rid, profile, false));
    Console.WriteLine("  ✓ runtime package: " + pkgDir);
    return _pkgFinish(root, pkgDir, "runtime", rid);
}

// [component.editor-assets] kind=editor-assets, dest="editors/" — editors/<target>/ from the in-repo asset dirs.
// 这些是 `z42d install <target>` 的**输入**：装了 SDK 就能装编辑器集成，不需要仓库。
// **模板不进包**——`*.tpl.json` 是 xtask 生成器的输入，
// 用户扩展目录里出现它只会造成困惑。返回拷贝的文件数。
int _pkgInstallEditorAssets(string root, string pkgDir) {
    string dest = Path.Join(pkgDir, "editors/vscode");
    Directory.Create(dest);
    string src = Path.Join(root, "src/toolchain/devtools/vscode");
    int n = 0;
    foreach (var name in Directory.Enumerate(src)) {
        if (name.EndsWith(".tpl.json")) { continue; }
        string from = Path.Join(src, name);
        string to = Path.Join(dest, name);
        if (Directory.Exists(from)) {
            Directory.Create(to);
            foreach (var inner in Directory.Enumerate(from)) {
                if (inner.EndsWith(".tpl.json")) { continue; }
                File.Copy(Path.Join(from, inner), Path.Join(to, inner));
                n = n + 1;
            }
        } else {
            File.Copy(from, to);
            n = n + 1;
        }
    }
    return n;
}

// Builds src/runtime once for (rid, profile): z42vm + libz42 (static + cdylib) + z42-compression. The package
// installers above copy from the resulting cargoOut. NB: the REPL editor cdylib (libz42_repl) is NOT built here —
// z42.repl's build hook (ProvideNative) compiles crates/z42-repl during `z42b publish` of z42.interactive and
// colocates it into the z42i payload.
int _pkgBuildRuntime(string rid, string profile) {
    if (rid != _detectHostRid()) { throw new Std.Cli.CliException("desktop component packages must be built on the target RID"); }
    return _componentBuild(_root(), profile);
}
