// Desktop runtime component build and installation, shared by SDK and runtime packages.
namespace Z42Xtask;
using Std.IO;
using Std.Cli;

string _componentBuildDir(string root) { return Path.Join(_buildMirror(root, Path.Join(root, "src/runtime")), "components"); }
// 命名归 [runtime.naming] 模板（packages.toml）；rid 空 = 宿主 RID。
string _componentLibrary(string stem, string rid = "") {
    if (rid.Length == 0) { rid = _detectHostRid(); }
    return _rtDynamicName(_root(), stem, rid);
}
// R0：编译参数的家在 runtime 自身——rustflags 默认 = .cargo/config.toml（按平台），
// LTO 关闭 = [profile.release-dynamic]，features 预设 = Cargo 命名别名；xtask 只传名。
// 静态图 / 启动器图仍以 RUSTFLAGS env（prefer-dynamic=no）整体覆盖 config 默认。
// R0 树探测：config-dynamic.toml 是新机制（独立 rustflags 配置 + release-dynamic profile）
// 的标志物。bench A/B 等场景里 PR 的新 xtask 会构建 base-src 的**旧树**（无该文件、
// Cargo.toml 无 [profile.release-dynamic]）—— 此时整套回退 R0 前的旧机制
// （--release + RUSTFLAGS/LTO env），两代树的产物目录与调用形态各自成立。
bool _componentR0Tree(string root) {
    return File.Exists(Path.Join(root, "src/runtime/.cargo/config-dynamic.toml")) || _componentAliasTree(root);
}
// R1f：单文件 config.toml 的 [alias] 图配方（≈ CMakePresets）存在与否。旧树（bench base-src
// 等）没有配方 —— 回退 R0 前的 env 调用形态。alias 仅经目录发现生效，调用方 cwd 须在 src/runtime。
bool _componentAliasTree(string root) {
    string cfg = Path.Join(root, "src/runtime/.cargo/config.toml");
    return File.Exists(cfg) && File.ReadAllText(cfg).Contains("z42-dynamic");
}
// alias 进程基座：cwd=src/runtime（alias 发现条件），阻断继承的 rustflags 环境通道。
Process _componentAliasProc(string root, string alias) {
    return new Process("cargo").Arg(alias)
        .WorkingDirectory(Path.Join(root, "src/runtime"))
        .EnvRemove("RUSTFLAGS").EnvRemove("CARGO_ENCODED_RUSTFLAGS").Env("CARGO_TERM_COLOR", "never");
}
// cargo --profile 名（dev 的产物目录叫 debug）与产物目录名分开，勿混用。
string _componentCargoProfile(string root, string profile) {
    if (profile == "debug") { return "dev"; }
    return (_componentR0Tree(root) && profile == "release") ? "release-dynamic" : profile;
}

string _componentDirName(string root, string profile) { return (_componentR0Tree(root) && profile == "release") ? "release-dynamic" : profile; }
string _componentCargoOut(string root, string profile) { return Path.Join(_componentBuildDir(root), _componentDirName(root, profile)); }
Process _componentCargo(string verb, string root, string profile, string targetDir = "") {
    if (targetDir.Length == 0) { targetDir = _componentBuildDir(root); }
    // R1f：配方树走 cargo z42-dynamic（参数全在 src/runtime/.cargo/config.toml 的 [alias]）。
    if (_componentAliasTree(root)) {
        return _componentAliasProc(root, "z42-dynamic")
            .Arg("--target-dir").Arg(targetDir)
            .Arg("--profile").Arg(_componentCargoProfile(root, profile));
    }
    Process p = new Process("cargo").Arg(verb).Arg("--config").Arg(Path.Join(root, _runtimeCargoConfig()))
        .WorkingDirectory(root).Arg("--locked")
        .Arg("--manifest-path").Arg(Path.Join(root, _runtimeManifest()))
        .Arg("--target-dir").Arg(targetDir);
    if (_componentR0Tree(root)) {
        p = p.Arg("--config").Arg(Path.Join(root, "src/runtime/.cargo/config-dynamic.toml"))
            .Arg("--profile").Arg(_componentCargoProfile(root, profile));
        return p;
    }
    // 旧树：R0 前的调用形态（env flags + --release）。
    string flags = "-C prefer-dynamic -C rpath";
    if (Platform.IsMacOS()) { flags = flags + " -C link-arg=-Wl,-rpath,@loader_path"; }
    else if (Platform.IsLinux()) { flags = flags + " -C link-arg=-Wl,-rpath,$ORIGIN -C link-arg=-Wl,-rpath,$ORIGIN/../native"; }
    p = p.EnvRemove("CARGO_ENCODED_RUSTFLAGS").Env("RUSTFLAGS", flags).Env("CARGO_PROFILE_RELEASE_LTO", "false");
    if (profile == "release") { p = p.Arg("--release"); }
    return p;
}
Process _componentTargets(Process build, string root) {
    if (_componentAliasTree(root)) { return build; }   // 配方已含 -p/features
    Process p = build
        .Arg("-p").Arg("z42")
        .Arg("-p").Arg("z42-interp").Arg("-p").Arg("z42-jit")
        .Arg("--no-default-features");
    // 旧树（bench base-src 等）没有 R0 的命名别名，回退展开串。
    if (_componentR0Tree(root)) { return p.Arg("--features").Arg("z42/desktop-dynamic,z42-interp/dynamic,z42-jit/dynamic"); }
    return p.Arg("--features").Arg("z42/cli,z42/interp,z42/jit,z42/shared-core,z42/native-interop,z42/net,z42/tls"
        + ",z42-interp/shared-core,z42-interp/jit,z42-interp/native-interop,z42-jit/shared-core");
}

int _componentBuild(string root, string profile) {
    // One graph unifies the shared core's features for both dynamic backends and host.
    Process build = _componentTargets(_componentCargo("build", root, profile), root)
        .Arg("--all-targets").Arg("--message-format=json-render-diagnostics");
    // Development targets and every library are in one graph, so transitive
    // dependency features cannot produce a second, incompatible core image.
    ProcessResult result = build.Stderr(Stdio.Inherit()).Run();
    if (result.ExitCode != 0) { return result.ExitCode; }
    File.WriteAllText(Path.Join(_componentCargoOut(root, profile), "component-test-executable.txt"),
        _componentArtifactExecutable(result.Stdout));
    return _componentBuildCompression(root, _detectHostRid(), profile, true);
}

void _componentCopyRequired(string source, string destination) {
    if (!File.Exists(source)) { throw new CliException("dynamic runtime artifact is missing: " + source); }
    File.Copy(source, destination);
}
int _packageDynamicRuntime(string rid, string profile, bool noBuild, bool verify) {
    string root = _root();
    string host = _detectHostRid();
    if (rid.Length == 0) { rid = host; }
    if (rid != host || _ridCategory(rid) != "desktop") {
        throw new CliException("dynamic runtime components require a native desktop build on the target RID");
    }
    if (!noBuild) { int seed = _buildStdlib(); if (seed != 0) { return seed; } }
    int c = _componentBuild(root, profile); if (c != 0) { return c; }
    string version = _versionsGet(root);
    string name = "z42-runtime-" + version + "-" + rid + "-dynamic" + (profile == "release" ? "" : "-" + profile);
    string pkg = Path.Join(_packagesDir(root), name);
    _resetDir(pkg);
    string native = Path.Join(pkg, "native");
    Directory.Create(native);
    string cargo = _componentCargoOut(root, profile);
    _componentInstallLibraries(cargo, pkg, true);
    _copyAbiHeaders(root, Path.Join(native, "include"));
    c = _pkgCopyLibs(_libsDir(root), pkg); if (c != 0) { return c; }
    c = _componentRelocate(native); if (c != 0) { return c; }
    _rtEmitRuntimeManifest(pkg, rid, profile, version, "dynamic", "");
    c = _pkgFinish(root, pkg, "runtime-dynamic", rid); if (c != 0) { return c; }
    if (verify) { return _componentVerify(root, pkg, profile); }
    return 0;
}

// importLibs：Windows 下是否随包拷动态库的导入库（<stem>.dll.lib）。runtime 包要
// （嵌入者直接链接组件而非 dlopen，见 z42_host.h 的 register_static_* 协议）；
// SDK 不要 —— z42vm 只 dlopen，链接期文件纯属负载。
void _componentInstallLibraries(string cargo, string pkg, bool importLibs = false) {
    // R1 统一复制器入口：动态闭包（可选 import lib）+ 恰好一份共享 std。
    string rid = _detectHostRid();
    _RtCopy[] closure = _rtResolveClosure(_root(), rid, cargo);
    _rtExecuteCopies(closure, pkg, true);
    if (importLibs && rid.StartsWith("windows-")) {
        foreach (var c in closure) {
            string il = _rtImportLibName(_root(), c.Stem);
            _componentCopyRequired(Path.Join(cargo, il), Path.Join(Path.Join(pkg, "native"), il));
        }
    }
    _componentCopyStd(Path.Join(pkg, "native"));
}

// z42vm 启动器单独出一图：静态 Rust std（prefer-dynamic=no），exe 自身不再依赖共享
// libstd —— bin/ 里只有 z42vm 本体，共享 std 只随 native/ 分发（z42.dll 的依赖由
// launcher 的 LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|DEFAULT_DIRS 从 dll 自己的目录解析）。
// 与组件动态图分开的 target-dir 防止 rustflags 串扰；bin 不引用 lib crate 的代码，
// 链接期未被引用的 rlib 自然不进 exe。identity 由 build.rs 计算（输入不含 rustflags），
// 与动态图的 COMPONENT_BUILD_ID 一致，launcher 的 same-build 校验不变。
// 与 components/、components/static 平级的第三棵树（rustflags 互不串扰）；profile 子目录由 cargo 生成
// （--release ⇒ <launcher>/<profile>/z42vm，同另两棵图的约定）。
string _componentLauncherDir(string root) { return Path.Join(_componentBuildDir(root), "launcher"); }
string _componentLauncherOut(string root, string profile) { return Path.Join(_componentLauncherDir(root), profile); }
int _componentBuildLauncher(string root, string profile) {
    if (_componentAliasTree(root)) {
        Process a = _componentAliasProc(root, "z42-launcher")
            .Arg("--target-dir").Arg(_componentLauncherDir(root));
        if (profile == "release") { a = a.Arg("--release"); }
        return _execIn(a, Path.Join(root, "src/runtime"));
    }
    Process p = _cargoCmd("build", _runtimeCargoConfig()).WorkingDirectory(root).Arg("--locked")
        .Arg("--manifest-path").Arg(_runtimeManifest())
        .Arg("--target-dir").Arg(_componentLauncherDir(root))
        .Arg("-p").Arg("z42").Arg("--bin").Arg("z42vm")
        .Arg("--no-default-features").Arg("--features").Arg("z42/cli,z42/component-loading")
        .EnvRemove("CARGO_ENCODED_RUSTFLAGS");
    // 静态 std 启动器；macOS 预留 load-command 余量，否则打包期 install_name_tool
    // -add_rpath 报 "larger updated load commands do not fit"。
    string flags = "-C prefer-dynamic=no";
    if (Platform.IsMacOS()) { flags = flags + " -C link-arg=-Wl,-headerpad_max_install_names"; }
    p = p.Env("RUSTFLAGS", flags);
    if (profile == "release") { p = p.Arg("--release"); }
    return _exec(p);
}

void _componentCopyStd(string native, string target = "") {
    string[] args = target.Length == 0 ? new string[]{ "--print", "target-libdir" } : new string[]{ "--print", "target-libdir", "--target", target };
    string stdDir = _cmdOut("rustc", args);
    bool windows = target.Length == 0 ? Platform.IsWindows() : target.Contains("windows");
    bool apple = target.Length == 0 ? Platform.IsMacOS() : target.Contains("apple");
    string suffix = windows ? ".dll" : (apple ? ".dylib" : ".so");
    string pattern = (windows ? "std-*" : "libstd-*") + suffix;
    string[] std = Path.Glob(stdDir, pattern);
    if (std.Length != 1) { throw new CliException("expected one matching shared Rust std in " + stdDir); }
    File.Copy(std[0], Path.Join(native, Path.GetFileName(std[0])));
}

int _componentBuildStatic(string root, string profile) {
    return _componentBuildStaticLibraries(root, _detectHostRid(), profile);
}

// 静态图仍走 --release（目录名不带 -dynamic 后缀）；从动态图目录名推导时映射回去。
string _componentStaticProfileName(string cargoProfile) { return cargoProfile == "release-dynamic" ? "release" : cargoProfile; }
string _componentStaticArchive(string cargo) {
    string name = Platform.IsWindows() ? "z42.lib" : "libz42.a";
    return Path.Join(Path.GetDirectoryName(cargo), "static/" + _componentStaticProfileName(Path.GetFileName(cargo)) + "/examples/" + name);
}
