// Assemble C archives from rlibs belonging to one static core/engine graph.
namespace Z42Xtask;
using Std.IO;
using Std.Cli;

int _componentBuildStaticLibraries(string root, string rid, string profile) {
    string features = "z42/static-embedding,z42/" + _componentPlatformPreset(rid).Replace(",", ",z42/");
    Process p = _componentPlatformCargo("build", root, rid, profile, false)
        .Arg("-p").Arg("z42").Arg("-p").Arg("z42-interp").Arg("--lib").Arg("--examples")
        .Arg("--no-default-features");
    if (_componentTargetHasJit(rid)) {
        p = p.Arg("-p").Arg("z42-jit");
        features = features + ",z42-interp/jit,z42-jit/jit";
    }
    if (rid != "browser-wasm") { features = features + ",z42-interp/native-interop"; }
    int c = _execIn(p.Arg("--features").Arg(features), _componentPlatformWorkingDirectory(root, rid));
    if (c != 0) { return c; }
    c = _componentStaticArchiveFromRlib(root, rid, profile, "z42_interp");
    if (c != 0) { return c; }
    c = _componentBuildCompression(root, rid, profile, false);
    if (c != 0 || !_componentTargetHasJit(rid)) { return c; }
    return _componentStaticArchiveFromRlib(root, rid, profile, "z42_jit");
}

int _componentStaticArchiveFromRlib(string root, string rid, string profile, string stem, string cargo = "") {
    if (cargo.Length == 0) { cargo = _componentPlatformOut(root, rid, profile, false); }
    string rlib = Path.Join(cargo, "lib" + stem + ".rlib");
    if (!File.Exists(rlib)) { throw new CliException("static graph did not produce " + rlib); }
    string work = _xtaskWork(root, "component-static-" + rid + "-" + profile);
    Directory.Create(work);
    string stub = Path.Join(work, stem + ".rs");
    File.WriteAllText(stub, "pub use " + stem + "::*;\n");
    Process p = new Process("rustc").WorkingDirectory(root)
        .Arg("--edition=2021").Arg("--crate-name").Arg(stem + "_static")
        .Arg("--crate-type=staticlib").Arg("--target").Arg(_ridToCargo(rid))
        .Arg("--extern").Arg(stem + "=" + rlib)
        .Arg("-L").Arg("dependency=" + cargo).Arg("-L").Arg("dependency=" + Path.Join(cargo, "deps"))
        .Arg("-L").Arg("dependency=" + Path.Join(_componentStaticDir(root, rid), profile + "/deps"))
        .Arg("-C").Arg("lto=no").Arg("-C").Arg("prefer-dynamic=no")
        .Arg("--print").Arg("native-static-libs")
        .Arg(stub).Arg("-o").Arg(Path.Join(cargo, _componentStaticName(stem, rid))).Stderr(Stdio.Pipe());
    if (rid.StartsWith("ios")) { p = p.Env("IPHONEOS_DEPLOYMENT_TARGET", _vReadOr(root, "platform.ios.min_ios", "16.0")); }
    ProcessResult result = p.Run();
    Console.Write(result.Stdout); ConsoleError.Write(result.Stderr);
    if (result.ExitCode != 0) { return result.ExitCode; }
    string output = result.Stdout + "\n" + result.Stderr;
    string prefix = "native-static-libs:";
    int start = output.IndexOf(prefix);
    string flags = start < 0 ? "" : output.Substring(start + prefix.Length).Split("\n")[0].Trim();
    if (flags.Length == 0 && rid != "browser-wasm") { throw new CliException("rustc did not report native dependencies for " + stem); }
    File.WriteAllText(Path.Join(cargo, stem + "-link.txt"), flags);
    _componentStageStaticImportLibs(cargo, flags);
    return 0;
}

// MSVC 目标的 native-static-libs 可能点名第三方导入库（如 windows-sys 的 windows.0.52.0.lib）——
// 它们不在系统 LIB 搜索路径里：cargo 既可能写进 <cargo>/deps/，也可能只在 registry 的
// windows-targets 家族 crate（windows_x86_64_msvc-* 等）源码 lib/ 下。静态档案的嵌入方需要它们，
// 故定位后暂存到 <cargo>/ 根（随档案一起进包；_componentCopyStaticFiles 按 link.txt 名单拷贝）。
// 系统库（kernel32.lib 等）永远不在这两处，因此不会进包。
void _componentStageStaticImportLibs(string cargo, string flags) {
    foreach (var flag in flags.Split(" ")) {
        if (!flag.EndsWith(".lib")) { continue; }
        string dep = Path.Join(Path.Join(cargo, "deps"), flag);
        if (File.Exists(dep)) {
            if (!File.Exists(Path.Join(cargo, flag))) { File.Copy(dep, Path.Join(cargo, flag)); }
            continue;
        }
        string registry = _componentRegistryImportLib(flag);
        if (registry.Length > 0) { File.Copy(registry, Path.Join(cargo, flag)); }
    }
}

// 按 import lib 文件名在 cargo registry 的 windows-targets 家族 crate 里定位原件；找不到返回 ""。
string _componentRegistryImportLib(string name) {
    string home = Environment.GetEnvironmentVariable("CARGO_HOME", "");
    if (home.Length == 0) {
        home = Path.Join(Environment.GetEnvironmentVariable(Platform.IsWindows() ? "USERPROFILE" : "HOME", ""), ".cargo");
    }
    string srcRoot = Path.Join(home, Path.Join("registry", "src"));
    if (!Directory.Exists(srcRoot)) { return ""; }
    foreach (var hash in Directory.Enumerate(srcRoot)) {
        foreach (var crate in Directory.Enumerate(Path.Join(srcRoot, hash))) {
            if (!crate.StartsWith("windows_")) { continue; }
            string candidate = Path.Join(Path.Join(Path.Join(srcRoot, hash), crate), Path.Join("lib", name));
            if (File.Exists(candidate)) { return candidate; }
        }
    }
    return "";
}

void _componentCopyStaticLibraries(string root, string native, string rid, string profile) {
    _componentCopyStaticFiles(_componentPlatformOut(root, rid, profile, false), native, rid);
}

void _componentCopyStaticFiles(string cargo, string native, string rid) {
    foreach (var stem in new string[]{ "z42_interp", "z42_jit", "z42_compression" }) {
        if (stem == "z42_jit" && !_componentTargetHasJit(rid)) { continue; }
        string name = _componentStaticName(stem, rid);
        _componentCopyRequired(Path.Join(cargo, name), Path.Join(native, name));
        // link.txt 不再随包：flags 由 _rtEmitRuntimeManifest 写进包内 manifest.toml 的
        // [components.<stem>].link_flags；此处仍从构建侧 link.txt 读第三方导入库名单。
        // 第三方导入库（已在 <cargo>/ 暂存或仍在 deps/）随档案进包，嵌入方才能链接。
        foreach (var flag in File.ReadAllText(Path.Join(cargo, stem + "-link.txt")).Split(" ")) {
            if (!flag.EndsWith(".lib")) { continue; }
            string staged = Path.Join(cargo, flag);
            string inDeps = Path.Join(Path.Join(cargo, "deps"), flag);
            string source = File.Exists(staged) ? staged : (File.Exists(inDeps) ? inDeps : "");
            if (source.Length > 0) { File.Copy(source, Path.Join(native, flag)); }
        }
    }
}
