// xtask 项目 build hook（wire-z42b build-hook 终章）。
//
// 目的：`z42 publish scripts/xtask.z42.toml` 免装 desktop workload——apphost stub 的
// 源码就在本仓（src/toolchain/workload/desktop/platform/apphost/），hook 现场 cargo
// 编出来并登记 kind="apphost-stub"，publish 的 stub 解析序取①（见 builder_publish.z42），
// 去掉 `z42 workload install desktop` 的下载依赖。
//
// 注入约定（builder_hooks.z42）：`namespace Build;` + `class ProjectHooks : BuildHooks`，
// 由 z42b 用注入的同一 ICompiler 编译本目录 → ModuleLoader.Load → 反射实例化。
// 注意：本文件也会被 xtask 自身的 [sources] `**/*.z42` glob 扫进 xtask.zpkg（多一个
// 不被调用的类，无害）；hook 生效路径只经 manifest `[build] hooks` 显式声明。
namespace Build;

using Std;
using Std.IO;
using Z42.Build;

public class ProjectHooks : BuildHooks {

    // publish 前编 apphost stub：cargo（release）→ 登记产物路径。失败只 Warn 不抛——
    // z42b 落回 Z42_APPHOST_TEMPLATE（已装 workload）路径。
    public override void BeforeAssets(IPipelineContext ctx) {
        string repo = Path.Join(ctx.Dirs.Source, "..");   // 本 toml 在 scripts/ → 仓根
        string manifest = Path.Join(repo, "src/toolchain/workload/desktop/platform/apphost/Cargo.toml");
        if (!ctx.Exists(manifest)) {
            ctx.Warn("xtask hooks: apphost Cargo.toml not found: " + manifest);
            return;
        }
        string targetDir = Path.Join(ctx.Dirs.Intermediate, "apphost-target");
        ctx.Log("xtask hooks: cargo build --release (apphost stub)…");
        string[] args = new string[6];
        args[0] = "build"; args[1] = "--release";
        args[2] = "--manifest-path"; args[3] = manifest;
        args[4] = "--target-dir"; args[5] = targetDir;
        ExecResult r = ctx.Exec("cargo", args);
        if (r.ExitCode != 0) {
            ctx.Warn("xtask hooks: cargo build failed (rc=" + r.ExitCode.ToString() + ")");
            ctx.Warn(r.Stderr);
            return;
        }
        string stub = Path.Join(targetDir, Path.Join("release", "apphost"));
        if (!ctx.Exists(stub) && ctx.Exists(stub + ".exe")) { stub = stub + ".exe"; }
        ctx.AddOutput("apphost-stub", stub);
        ctx.Log("xtask hooks: apphost stub ready: " + stub);

        // embed-workload-publish: also provision --self-contained's embed 三件套
        // (embed apphost linking libz42 + stdlib libs [+ dynamic libz42]) so
        // `z42 publish --self-contained` works with no manual Z42_EMBED_* env.
        this._embedArtifacts(ctx, repo);
    }

    // Build + register the self-contained embed artifacts. embed apphost links
    // libz42 (reused if built, else cargo staticlib); stdlib libs = the flat
    // alllibs dir; dynamic (bonus) only when libz42.dylib already exists (no
    // forced cdylib build per publish).
    void _embedArtifacts(IPipelineContext ctx, string repo) {
        string libA = Path.Join(repo, "artifacts/build/runtime/release/libz42.a");
        if (!ctx.Exists(libA)) {
            ctx.Log("xtask hooks: cargo rustc --crate-type=staticlib (libz42.a)…");
            ExecResult rc = ctx.Exec("cargo", new string[]{ "rustc", "--release",
                "--manifest-path", Path.Join(repo, "src/runtime/Cargo.toml"),
                "--lib", "--crate-type=staticlib" });
            if (rc.ExitCode != 0 || !ctx.Exists(libA)) {
                ctx.Warn("xtask hooks: libz42.a build failed; --self-contained needs Z42_EMBED_*");
                return;
            }
        }
        string src = Path.Join(repo, "src/toolchain/workload/desktop/shell/apphost_embed.c");
        string outHost = Path.Join(ctx.Dirs.Intermediate, "apphost-embed-static");
        ExecResult r2 = ctx.Exec("cc", this._ccStatic(src, outHost, libA));
        if (r2.ExitCode == 0 && ctx.Exists(outHost)) {
            ctx.AddOutput("embed-apphost-static", outHost);
            ctx.Log("xtask hooks: embed apphost (static) ready");
        } else {
            ctx.Warn("xtask hooks: embed apphost (static) cc failed (rc=" + r2.ExitCode.ToString() + ")");
        }
        string flat = Path.Join(repo, "artifacts/.scratch/alllibs/release");
        if (ctx.Exists(flat)) { ctx.AddOutput("embed-libs", flat); }

        // dynamic bonus: only if libz42.dylib is already built (avoid a forced
        // cdylib cargo build every publish).
        string dylib = Path.Join(repo, "artifacts/build/runtime/release/libz42.dylib");
        if (ctx.Exists(dylib)) {
            string staged = Path.Join(ctx.Dirs.Intermediate, "libz42.dylib");
            File.Copy(dylib, staged, true);
            ctx.Exec("install_name_tool", new string[]{ "-id", "@rpath/libz42.dylib", staged });
            string outDyn = Path.Join(ctx.Dirs.Intermediate, "apphost-embed-dynamic");
            ExecResult r4 = ctx.Exec("cc", this._ccDynamic(src, outDyn, ctx.Dirs.Intermediate));
            if (r4.ExitCode == 0 && ctx.Exists(outDyn)) {
                ctx.AddOutput("embed-apphost-dynamic", outDyn);
                ctx.AddOutput("embed-dylib", staged);
                ctx.Log("xtask hooks: embed apphost (dynamic) ready");
            }
        }
    }

    string[] _ccStatic(string src, string outHost, string libA) {
        if (Platform.IsMacOS()) {
            return new string[]{ "-O2", "-o", outHost, src, libA, "-liconv", "-lc", "-lm" };
        }
        return new string[]{ "-O2", "-o", outHost, src, libA,
            "-lc", "-lm", "-lpthread", "-ldl", "-lrt", "-lgcc_s" };
    }

    string[] _ccDynamic(string src, string outDyn, string libDir) {
        if (Platform.IsMacOS()) {
            return new string[]{ "-O2", "-o", outDyn, src, "-L", libDir, "-lz42",
                "-Wl,-rpath,@loader_path", "-liconv", "-lc", "-lm" };
        }
        return new string[]{ "-O2", "-o", outDyn, src, "-L", libDir, "-lz42",
            "-Wl,-rpath,$ORIGIN", "-lc", "-lm", "-lpthread", "-ldl", "-lrt", "-lgcc_s" };
    }
}
