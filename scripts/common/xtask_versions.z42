// xtask — the single versions.toml reader. Two access styles:
//   - TomlValue-based (_vget/_vgetList): read keys from an already-parsed doc.
//   - root-based (_vRead/_vReadOr/_v*): read through `_vparse`, which parses once per process.
namespace Z42Xtask;

using Std.Collections;
using Std.IO;
using Std.Toml;

// Scalar TomlValue → string (int 23 → "23", bool true → "true"). Throws on non-scalar.
string _scalarStr(TomlValue v) {
    if (v.IsString()) { return v.AsString(); }
    if (v.IsLong())   { return v.AsLong().ToString(); }
    if (v.IsDouble()) { return v.AsDouble().ToString(); }
    if (v.IsBool())   { return v.AsBool().ToString(); }
    throw new Exception("versions.toml: expected scalar, got " + v.KindName());
}

// Dotted-path scalar as string, on an already-parsed TomlValue.
string _vget(TomlValue toml, string dotted) {
    TomlValue node = toml;
    foreach (var key in dotted.Split(".")) {
        node = node.Get(key);
    }
    return _scalarStr(node);
}

// Dotted-path array → elements as strings.
string[] _vgetList(TomlValue toml, string dotted) {
    TomlValue node = toml;
    foreach (var key in dotted.Split(".")) {
        node = node.Get(key);
    }
    string[] xs = new string[node.Count()];
    for (int i = 0; i < xs.Length; i = i + 1) { xs[i] = _scalarStr(node.At(i)); }
    return xs;
}

// versions.toml 的位置（scripts/ 下 —— 读它的几乎全是 xtask）。
// 全部读取方都经这里，别再各自 Path.Join(root, …)。
string _versionsPath(string root) { return Path.Join(root, "scripts/versions.toml"); }

// 进程内缓存：xtask 是短命进程、不写 versions.toml，一次运行里每个 root 只读一遍、解析一遍。
static class VersionsCache {
    public static string Root = "";
    public static TomlValue? Doc = null;
}

// Parse versions.toml into a TomlValue (cached per root; callers only read it).
TomlValue _vparse(string root) {
    TomlValue? doc = VersionsCache.Doc;
    if (doc != null && VersionsCache.Root == root) { return doc; }
    TomlValue parsed = TomlValue.Parse(File.ReadAllText(_versionsPath(root)));
    VersionsCache.Doc = parsed;
    VersionsCache.Root = root;
    return parsed;
}

// Dotted-path scalar from versions.toml.
// Throws if the file or key is missing — use _vReadOr when a default is wanted.
string _vRead(string root, string dotted) {
    return _vget(_vparse(root), dotted);
}

// Like _vRead but returns `fallback` on any error (missing file / missing key).
string _vReadOr(string root, string dotted, string fallback) {
    if (!File.Exists(_versionsPath(root))) { return fallback; }
    try { return _vget(_vparse(root), dotted); }
    catch (Exception e) { return fallback; }
}

// Parse an arbitrary toml file (relative to root) → array of strings at a dotted
// path. Used to derive the stdlib member list from z42.workspace.toml's
// default_members (single source of truth — no hand-maintained duplicate).
string[] _vgetListFromFile(string root, string relPath, string dotted) {
    TomlValue toml = TomlValue.Parse(File.ReadAllText(Path.Join(root, relPath)));
    return _vgetList(toml, dotted);
}

// ── [workload] / [rid.*] 登记 ────────────────────────────────────────────────
// versions.toml 的两张枚举表：workload 名单与目标 RID（名字 ↔ triple ↔ 类别 ↔ 主 RID）。
// 读不到表（旧文件/漏段）时返回空 / unknown —— 调用方把「空名单」当配置错误报出，不静默回落
// 到代码里另抄的名单。

bool _strIn(string[] xs, string x) {
    foreach (var s in xs) { if (s == x) { return true; } }
    return false;
}

// 用 sep 连接字符串数组（错误信息里列参数域用，如 "android|ios|wasm"）。
string _joinStrings(string[] xs, string sep) { return String.Join(sep, xs); }

// 全部 workload（[workload].members，文件序）。desktop = 宿主 workload，恒在列。
string[] _vWorkloads(string root) {
    return _vgetList(_vparse(root), "workload.members");
}

// 跨平台 workload（= members 去 desktop）：`setup --os` / `setup check --os` 的参数域。
string[] _vCrossWorkloads(string root) {
    List<string> xs = new List<string>();
    foreach (var m in _vWorkloads(root)) { if (m != "desktop") { xs.Add(m); } }
    return xs.ToArray();
}

// [rid.*] 表节点；文件缺 rid 段时返回 null（调用方按配置错误处理）。
TomlValue _vRidTable(string root) {
    TomlValue doc = _vparse(root);
    return doc.ContainsKey("rid") ? doc.Get("rid") : null;
}

// 全部登记的 RID（排序——release 索引 / 归档汇总要确定性顺序）。
string[] _vRidNames(string root) {
    TomlValue t = _vRidTable(root);
    return t == null ? new string[0] : _sortedStrings(t.Keys());
}

// RID 的 cargo triple；未登记返回 ""。
string _vRidTriple(string root, string rid) {
    TomlValue t = _vRidTable(root);
    return (t == null || !t.ContainsKey(rid)) ? "" : _scalarStr(t.Get(rid).Get("triple"));
}

// RID 类别（desktop | ios | android | wasm）；未登记返回 "unknown"。
string _vRidCategory(string root, string rid) {
    TomlValue t = _vRidTable(root);
    return (t == null || !t.ContainsKey(rid)) ? "unknown" : _scalarStr(t.Get(rid).Get("category"));
}

// 是否该平台 workload 归档的主 RID；未登记 / 未标一律 false。
bool _vRidPrimary(string root, string rid) {
    TomlValue t = _vRidTable(root);
    if (t == null || !t.ContainsKey(rid)) { return false; }
    TomlValue e = t.Get(rid);
    return e.ContainsKey("primary") && e.Get("primary").AsBool();
}

// 某类别下的全部 RID（排序）。
string[] _vRidsOfCategory(string root, string category) {
    List<string> xs = new List<string>();
    foreach (var rid in _vRidNames(root)) { if (_vRidCategory(root, rid) == category) { xs.Add(rid); } }
    return xs.ToArray();
}

// ── z42b 构建期常量（生成物，不入库）─────────────────────────────────────────
// 正主是 z42b 自己的 build hook（src/toolchain/builder/core/hooks/hooks.z42，BeforeCompile 生成）——
// 用户 `z42 build` 编 z42b 不需要 xtask。但 xtask 自举 z42b 走 z42c driver 直编，**driver 不执行 hook**
// （hooks 只由 z42b 编排读），所以这里替它渲染同样内容（文本须与 hook 的 _render 逐字一致）。
// 无条件重生成、内容不变不写盘 ⇒ 不会与 versions.toml 漂移，无需 drift 检查。
string _builderPinsPath(string root) { return Path.Join(root, "src/toolchain/builder/core/builder_pins.z42"); }

void _syncBuilderPins(string root) {
    TomlValue toml = _vparse(root);
    string text = "// GENERATED from scripts/versions.toml — do not edit, not committed.\n"
        + "namespace Z42Builder;\n\n"
        + "// = versions.toml platform.ios.min_ios\n"
        + "string _pinIosMin() { return \"" + _vget(toml, "platform.ios.min_ios") + "\"; }\n";
    string path = _builderPinsPath(root);
    if (File.Exists(path) && File.ReadAllText(path) == text) { return; }
    File.WriteAllText(path, text);
}

// ── RID + version helpers ───────────────────────────────────────────────────

string _detectHostRid() {
    string arch = Platform.Arch();
    if (Platform.IsMacOS())   { if (arch == "x86_64") { return "macos-x64-unsupported"; } return "macos-arm64"; }
    if (Platform.IsWindows()) { return "windows-x64"; }
    // linux
    if (arch == "aarch64" || arch == "arm64") { return "linux-arm64"; }
    return "linux-x64";
}

// RID → 类别 / cargo triple：versions.toml `[rid.*]` 的唯一登记（不在表里 = unknown / ""，
// 如 Intel mac 的 macos-x64-unsupported——versions.toml 只承诺 arm64，不支持的 host 在此止步，
// 而不是按前缀猜一个类别继续往下走）。
string _ridCategory(string rid) { return _vRidCategory(_root(), rid); }

string _ridToCargo(string rid) { return _vRidTriple(_root(), rid); }

// versions.toml [project].version; "" when versions.toml is absent.
string _versionsGet(string root) {
    return _vReadOr(root, "project.version", "");
}

// ── cargo wrappers ──────────────────────────────────────────────────────────

// compile-once host reuse: when building for the HOST rid, pass an EMPTY target so
// cargo reuses the default host build dir (artifacts/build/runtime/<profile>) that
// ci-bootstrap / xtask-bootstrap-artifact already warmed (z42vm + cranelift + deps
// compiled, Swatinem-cached) instead of recompiling everything under a redundant
// --target <host-triple> tree. Cross RIDs (ios/android/wasm) keep their triple.
string _cargoTargetFor(string rid) {
    return (rid == _detectHostRid()) ? "" : _ridToCargo(rid);
}
