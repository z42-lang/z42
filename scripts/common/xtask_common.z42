// xtask shared infrastructure: repo root + process exec, z42c invocation, toolchain
// selector, verbosity, cold-start seed resolution, built-binary paths, cargo builders.
namespace Z42Xtask;

using Std.Collections;
using Std.IO;
using Std.Time;   // Stopwatch — diagnostic-level elapsed timing

// ── 源码常量 / zpkg 头 ───────────────────────────────────────────────────────

// 源码里 `<decl><n>;` 的 n（如 "public static int CompilerFingerprint = "）；读不到 → -1。
// **从源码树读、不用编进 xtask 的常量**：xtask 自身可能是旧二进制，编进去的版本号会跟着
// 一起旧，那就正好在最需要它的场合失效。
int _srcIntConst(string file, string decl) {
    if (!File.Exists(file)) { return -1; }
    string t = File.ReadAllText(file);
    int k = t.IndexOf(decl);
    if (k < 0) { return -1; }
    int s = k + decl.Length;
    int e = s;
    while (e < t.Length && t.CharAt(e) >= '0' && t.CharAt(e) <= '9') { e = e + 1; }
    if (e == s) { return -1; }
    return int.Parse(t.Substring(s, e - s));
}

// 本源码树的 zpkg 格式 minor（z42.package 的写端常量 = SoT，与 Rust 读端 strict-pin 同步）。
int _treeZpkgMinor(string root) {
    return _srcIntConst(Path.Join(root, "src/compiler/z42.package/src/ZpkgWriter.z42"),
        "public static int Minor = ");
}

// 一个 .zpkg 文件头里的格式 minor；文件不在 / 太短 / 坏 magic → -1。
// 头布局见 `z42.package` 的 `ZpkgWriterZ._assemble`：'Z''P''K' 0 | major:u16le | minor:u16le | …
int _zpkgFileMinor(string file) {
    if (!File.Exists(file)) { return -1; }
    byte[] b = File.ReadAllBytes(file);
    if (b.Length < 16) { return -1; }
    int b0 = b[0]; int b1 = b[1]; int b2 = b[2]; int b3 = b[3];
    if (b0 != 90 || b1 != 80 || b2 != 75 || b3 != 0) { return -1; }   // "ZPK\0"
    int lo = b[6]; int hi = b[7];
    return lo + hi * 256;
}

// ── repo root + process exec ─────────────────────────────────────────────────

// 进程内缓存：xtask 不切换 cwd，仓库根一次运行内不变，只问一次 git。
static class RepoRoot {
    public static string Value = "";
}

// Repo root via git (spawned directly — no bash), falling back to CWD.
string _root() {
    if (RepoRoot.Value.Length > 0) { return RepoRoot.Value; }
    ProcessResult r = new Process("git").Arg("rev-parse").Arg("--show-toplevel").Run();
    RepoRoot.Value = r.ExitCode == 0 ? r.Stdout.Trim() : Environment.GetCurrentDirectory();
    return RepoRoot.Value;
}

// resolve a possibly-relative path under the repo root (absolute paths unchanged).
string _absUnder(string root, string p) {
    if (p.StartsWith("/")) { return p; }
    return Path.Join(root, p);
}

// `git <a> <b> <c>` at root, stdout trimmed; "unknown" on failure.
string _gitOut(string root, string a, string b, string c) {
    ProcessResult r = new Process("git").Arg(a).Arg(b).Arg(c).WorkingDirectory(root).Run();
    if (r.ExitCode == 0) { return r.Stdout.Trim(); }
    return "unknown";
}

// Run a prepared Process at the repo root, inheriting stdio; return its exit code.
int _exec(Process p) {
    return p.WorkingDirectory(_root())
        .Stdout(Stdio.Inherit())
        .Stderr(Stdio.Inherit())
        .Run().ExitCode;
}

// Like _exec but runs in an explicit working directory — passing a WorkingDirectory
// to _exec is silently overridden to _root().
int _execIn(Process p, string wd) {
    return p.WorkingDirectory(wd)
        .Stdout(Stdio.Inherit())
        .Stderr(Stdio.Inherit())
        .Run().ExitCode;
}

// ── z42c 编译执行模式 + workspace 构建 ───────────────────────────────────────

// z42c 编译（xtask 驱动 z42vm 跑 z42c.driver）走 interp 还是 jit 的单一开关。
// **默认 jit**：四平台 z42c workspace 编译 interp==jit 逐字节一致，自举不动点的信任基线在 JIT。
// 逃生舱 Z42C_BUILD_MODE=interp|jit（格式-bump 窗口 / 确定性审计 / 调试时回解释器）。
string _z42cMode() {
    string m = Environment.GetEnvironmentVariable("Z42C_BUILD_MODE", "");
    if (m == "interp" || m == "jit") { return m; }
    return "jit";
}

// z42c `build --workspace --release` 的单一封装：stdlib / compiler gen1 / gen2
// 三处 workspace 构建共用，把「gen1、gen2 必须完全同参」的自举不动点不变量从注释纪律
// 固化成代码（三处仅 driver / cwd / libs 不同，mode 恒同经 _z42cMode()）。
// noIncremental：凡是「必须真编一遍才有意义」的构建（不动点 gen2、编译器输出对比）传 true——
// 命中 cache 等于没测。增量开关不改变产物字节（cache 正确性前提），故不破坏 gen1==gen2 同参不变量。
int _z42cWorkspaceBuild(string vm, string driver, string cwd, string libs, bool noIncremental) {
    return _z42cWorkspaceBuild(vm, driver, cwd, libs, noIncremental, "");
}

// `libs` = 编译期依赖面（`Z42_LIBS`）；`runLibs` 非空 ⇒ driver 自己运行期先从那里加载（上一代 driver 自举，
// 见 `_z42cProcSeed`）。
int _z42cWorkspaceBuild(string vm, string driver, string cwd, string libs, bool noIncremental,
                        string runLibs) {
    Process p = _z42cProcSeed(vm, libs, runLibs, driver)
        .Arg("build").Arg("--workspace").Arg("--release");
    if (noIncremental) { p = p.Arg("--no-incremental"); }
    return p
        .WorkingDirectory(cwd)
        .Stdout(_verbAtLeast(3) ? Stdio.Inherit() : Stdio.Null()).Stderr(Stdio.Inherit())
        .Run().ExitCode;
}

// 单包 `build <toml> --release --output-dir <out>`：把一个成员 zpkg 直接写到 <out>/<name>.zpkg
// （非 workspace 布局）。冷启动破 z42c⇄z42.package 环用（_ensureBootstrapSelfDepLibs）：种子 driver
// 先把当前源码的 z42.package 编进 build-libs，让 fresh z42c 对着真 z42.package 编译+运行。
// `runLibs` 同 `_z42cWorkspaceBuild`。
int _z42cBuildPackage(string vm, string driver, string tomlPath, string libs, string outputDir,
                      string runLibs) {
    return _z42cProcSeed(vm, libs, runLibs, driver)
        .Arg("build").Arg(tomlPath).Arg("--release").Arg("--output-dir").Arg(outputDir)
        .Stdout(_verbAtLeast(3) ? Stdio.Inherit() : Stdio.Null()).Stderr(Stdio.Inherit())
        .Run().ExitCode;
}

// Verify each member's canonical workspace product (the per-member dist derived
// from `wsToml`'s [workspace.build].output_dir template) exists + is non-empty.
// Prints per-member ✓ (verbosity-gated, --detailed) / ✗ (always). Returns the fail
// count (0 = all present). Shared by `build stdlib` + `test compiler` verify loops.
int _verifyMemberZpkgs(string wsToml, string[] members, string profile) {
    int fail = 0;
    foreach (var m in members) {
        string zpkg = Path.Join(_memberDist(wsToml, m, profile), m + ".zpkg");
        if (File.Exists(zpkg) && File.GetSize(zpkg) > 0L) {
            _vDetailed("    ✓ " + m + ".zpkg (" + File.GetSize(zpkg).ToString() + " bytes)");
        } else {
            Console.WriteLine("    ✗ " + m + ".zpkg — workspace product missing at " + zpkg);
            fail = fail + 1;
        }
    }
    return fail;
}

// Make xtask's z42vm visible to child tool subprocesses whose FindVm() locates
// z42vm via (1) Z42VM env, (2) artifacts/build/runtime/..., (3) PATH. The launcher
// exports Z42_PORTABLE_VM (the vm we run on) but NOT Z42VM, and in download/portable
// mode there is no z42vm at the default build path before the first build-stdlib —
// so FindVm fails. Export our own vm as Z42VM (inherited by spawned Commands) so
// every delegated compile/run resolves it. No-op in dev where _z42vm() is a bare
// name (PATH).
void _ensureDriverVm() {
    string cur = Environment.GetEnvironmentVariable("Z42VM", "");
    if (cur.Length > 0) { return; }
    string vm = _z42vm();
    if (File.Exists(vm)) { Environment.SetEnvironmentVariable("Z42VM", vm); }
}

// Resolve the z42vm this process is running on, to execute compiled zpkgs.
// The launcher exports Z42_PORTABLE_VM (portable) / sets Z42_HOME (installed/dev).
string _z42vm() {
    string pv = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM", "");
    if (pv.Length > 0) { return pv; }
    string vmname = Platform.IsWindows() ? "z42vm.exe" : "z42vm";
    string home = Environment.GetEnvironmentVariable("Z42_HOME", "");
    if (home.Length > 0) {
        // Z42_HOME spans two layouts: SDK/toolchain root (<home>/bin/z42vm — a
        // portable SDK or a `--toolchain <dir>`) and managed install
        // (<home>/launcher/z42vm). Prefer whichever exists.
        string binVm = Path.Join(home, Path.Join("bin", vmname));
        if (File.Exists(binVm)) { return binVm; }
        return Path.Join(home, Path.Join("launcher", vmname));
    }
    return vmname;
}

// ── string / collection helpers (shared across modules) ─────────────────────

/// Non-mutating sort: copy then sort the copy in place via `_sortStrings`
/// (xtask_golden.z42). Deterministic ascending (load-order determinism rule).
string[] _sortedStrings(string[] src) {
    string[] arr = new string[src.Length];
    Array.Copy(src, arr, src.Length);
    _sortStrings(arr);
    return arr;
}

// Split a string on ASCII whitespace (space / tab / newline), dropping empties.
string[] _splitWords(string s) {
    List<string> words = new List<string>();
    int i = 0;
    while (i < s.Length) {
        while (i < s.Length && _isWordSep(s.CharAt(i))) { i = i + 1; }
        int start = i;
        while (i < s.Length && !_isWordSep(s.CharAt(i))) { i = i + 1; }
        if (i > start) { words.Add(s.Substring(start, i - start)); }
    }
    return words.ToArray();
}

bool _isWordSep(char c) { return c == ' ' || c == '\t' || c == '\n'; }

// ── toolchain selector (--toolchain <dir>) ───────────────────────────────────

// The SDK toolchain root in `.z42` layout (programs/z42c/*.zpkg + libs/ + bin/), or
// "" when unset. Read from Z42_HOME — the single "SDK root" var, set either by the
// launcher/install or by the global `--toolchain <dir>` option (which exports
// Z42_HOME so every helper + spawned child sees it). A MANAGED Z42_HOME uses a different layout
// (runtimes/<ver>/ + config.toml, no programs//bin/z42vm); callers guard on programs/
// (_seedSdkDir) or bin/z42vm existence (_activeVm) and fall back to the build tree when
// this root is not an SDK-toolchain layout. Relative → repo root.
string _toolchainDir(string root) {
    string tc = Environment.GetEnvironmentVariable("Z42_HOME", "");
    if (tc.Length == 0) { return ""; }
    if (Path.IsRooted(tc)) { return tc; }
    return Path.Join(root, tc);
}

// stdlib flat libs dir inside a `.z42` toolchain: <dir>/libs
string _toolchainLibs(string tcDir) {
    return Path.Join(tcDir, "libs");
}

// z42c driver-home inside a `.z42` toolchain: <dir>/programs/z42c (driver + its
// sibling members colocated, so the VM resolves them next to the entry zpkg).
string _toolchainDriverHome(string tcDir) {
    return Path.Join(Path.Join(tcDir, "programs"), "z42c");
}

// z42vm binary inside a `.z42` toolchain: <dir>/bin/z42vm[.exe] (release).
string _toolchainVm(string tcDir) {
    string vmname = Platform.IsWindows() ? "z42vm.exe" : "z42vm";
    return Path.Join(Path.Join(tcDir, "bin"), vmname);
}

// Active z42vm for compile/run: the toolchain's bin/z42vm when --toolchain is set,
// else the build-tree binary for `profile` ("debug"/"release"). Consumer paths
// (cross-zpkg / regen / vm goldens) call this so a downloaded current-sdk supplies
// the VM with no cargo build.
string _activeVm(string root, string profile) {
    string tc = _toolchainDir(root);
    if (tc.Length > 0) {
        // Only when Z42_HOME is an SDK-toolchain layout (bin/z42vm present); a managed
        // Z42_HOME (runtimes/, no bin/z42vm) falls through to the build-tree binary.
        string tcVm = _toolchainVm(tc);
        if (File.Exists(tcVm)) { return tcVm; }
    }
    return _builtVm(root, profile);
}

// ── verbosity (MSBuild-style, cumulative): quiet<minimal<normal<detailed<diag ─
//
// Set via the global `--verbosity` / `-v <level>` option, stashed in Z42_VERBOSITY
// so spawned children inherit it.
//   quiet(0)      errors only
//   minimal(1)    + ▶/✔ start & end markers per process         (default)
//   normal(2)     + the final resolved result of each step
//   detailed(3)   + the step-by-step selection process + child per-file output
//   diagnostic(4) + per-process elapsed time

// Normalize a --verbosity value (full name or first-letter abbrev) to 0..4, or -1.
int _normVerbosity(string s) {
    if (s == "q" || s == "quiet")         { return 0; }
    if (s == "m" || s == "minimal")       { return 1; }
    if (s == "n" || s == "normal")        { return 2; }
    if (s == "d" || s == "detailed")      { return 3; }
    if (s == "diag" || s == "diagnostic") { return 4; }
    return -1;
}

string _verbName(int level) {
    if (level <= 0) { return "quiet"; }
    if (level == 1) { return "minimal"; }
    if (level == 2) { return "normal"; }
    if (level == 3) { return "detailed"; }
    return "diagnostic";
}

// Current level (default minimal). Reads Z42_VERBOSITY; unset/unknown → minimal.
int _verbosity() {
    string v = Environment.GetEnvironmentVariable("Z42_VERBOSITY", "");
    if (v.Length == 0) { return 1; }
    int lvl = _normVerbosity(v);
    if (lvl < 0) { return 1; }
    return lvl;
}

bool _verbAtLeast(int level) { return _verbosity() >= level; }
void _vlog(int level, string msg) { if (_verbosity() >= level) { Console.WriteLine(msg); } }
void _vNormal(string msg)   { _vlog(2, msg); }   // final chosen result
void _vDetailed(string msg) { _vlog(3, msg); }   // selection-process detail

// Noisy child sub-tool stdout is gated inline as
//   `.Stdout(_verbAtLeast(3) ? Stdio.Inherit() : Stdio.Null())`
// so the default minimal stays clean of z42c per-file "wrote ->" spam.

// Begin a tracked process: prints "▶ <name>" at minimal+; returns a Stopwatch for
// _procEnd's diagnostic timing.
Stopwatch _procStart(string name) {
    _vlog(1, "▶ " + name);
    return Stopwatch.StartNew();
}
// End a tracked process: prints "✔ <name>" at minimal+; at diagnostic, elapsed ms.
void _procEnd(string name, Stopwatch sw) {
    _vlog(1, "✔ " + name);
    if (_verbosity() >= 4) {
        Console.WriteLine("  ⏱ " + name + " — " + sw.Elapsed().TotalMilliseconds().ToString() + " ms");
    }
}

// 人类可读时长："45.2s" / "3m07s"。CI 日志里一眼可读，不用心算毫秒。
string _fmtDur(long ms) {
    long totalSec = ms / 1000;
    if (totalSec < 60) {
        return totalSec.ToString() + "." + ((ms % 1000) / 100).ToString() + "s";
    }
    long s = totalSec % 60;
    return (totalSec / 60).ToString() + "m" + (s < 10 ? "0" : "") + s.ToString() + "s";
}

// ── cold-start seed resolution (shared: build compiler / build stdlib + CI) ───
//
// A cold tree has no in-tree z42c/stdlib seed. Instead of erroring, resolve one
// from the downloaded/installed SDK (or an explicit override) and stage it into the
// in-tree layout so the normal self-build runs. WARM trees are left untouched — the
// in-tree gen1 is exactly what the second build re-seeds from to reach the gen2
// byte-identical fixpoint, so it must win over the SDK.

// SDK toolchain root (.z42 layout: programs/z42c + libs + bin). Order:
// Z42_HOME (--toolchain sets it, else launcher/install) → the SDK running this xtask
// (Z42_PORTABLE_VM = <sdk>/bin/z42vm ⇒ <sdk>) → repo-local ./.z42. "" if none.
// A managed-layout Z42_HOME (runtimes/, no programs/) fails the programs/ guard and is
// skipped — only an SDK-toolchain-layout root qualifies as a seed source.
string _seedSdkDir(string root) {
    string tc = _toolchainDir(root);
    if (tc.Length > 0 && Directory.Exists(Path.Join(tc, "programs"))) {
        _vDetailed("    sdk: Z42_HOME/--toolchain → " + tc + "  ✓"); return tc;
    }
    if (tc.Length > 0) { _vDetailed("    sdk: Z42_HOME=" + tc + "  (no programs/ — managed layout? skip)"); }
    else { _vDetailed("    sdk: Z42_HOME unset"); }
    string pv = Environment.GetEnvironmentVariable("Z42_PORTABLE_VM", "");
    if (pv.Length > 0) {
        string sdk = Path.GetDirectoryName(Path.GetDirectoryName(pv));   // <sdk>/bin/z42vm ⇒ <sdk>
        if (sdk.Length > 0 && Directory.Exists(Path.Join(sdk, "programs"))) {
            _vDetailed("    sdk: Z42_PORTABLE_VM → " + sdk + "  ✓"); return sdk;
        }
        _vDetailed("    sdk: Z42_PORTABLE_VM=" + pv + " ⇒ " + sdk + "  (no programs/, skip)");
    } else { _vDetailed("    sdk: Z42_PORTABLE_VM unset"); }
    string local = Path.Join(root, ".z42");
    if (Directory.Exists(Path.Join(local, "programs"))) {
        _vDetailed("    sdk: ./.z42 → " + local + "  ✓"); return local;
    }
    _vDetailed("    sdk: ./.z42 absent — no SDK found");
    return "";
}

// z42c seed dir (z42c.driver.zpkg + sibling compiler members) = <sdk>/programs/z42c. "" if no SDK.
string _seedDriverHome(string root) {
    _vDetailed("  seed·z42c: resolving driver-home ← SDK");
    string sdk = _seedSdkDir(root);
    if (sdk.Length > 0) { return _toolchainDriverHome(sdk); }
    return "";
}

// stdlib seed dir (flat z42.*.zpkg). Z42_LIBS (explicit, only when it actually holds
// stdlib — it doubles as the runtime load path, which may point at an empty output
// dir) wins; else <sdk>/libs. "" if neither resolves.
string _seedStdlibDir(string root) {
    _vDetailed("  seed·stdlib: resolving stdlib dist");
    string libs = Environment.GetEnvironmentVariable("Z42_LIBS", "");
    if (libs.Length > 0) {
        if (!Path.IsRooted(libs)) { libs = Path.Join(root, libs); }
        if (File.Exists(Path.Join(libs, "z42.core.zpkg"))) {
            _vDetailed("  seed·stdlib: Z42_LIBS → " + libs + "  ✓"); return libs;
        }
        _vDetailed("  seed·stdlib: Z42_LIBS=" + libs + "  (no z42.core.zpkg, fall back to SDK)");
    } else { _vDetailed("  seed·stdlib: Z42_LIBS unset → SDK"); }
    string sdk = _seedSdkDir(root);
    if (sdk.Length > 0) { return _toolchainLibs(sdk); }
    return "";
}

// 冷启动 staged 种子时，`_ensureSeed` 把**种子 stdlib 的出处**记在这里 —— 那就是这个 driver
// 那一代的运行期 libs，是**构造保证**的（它就是从那儿来的）。暖树不 set。
static class SeedStage {
    static string _stdlibFrom = "";
    public static void NoteStdlibFrom(string dir) { SeedStage._stdlibFrom = dir; }
    public static string StdlibFrom() { return SeedStage._stdlibFrom; }
}

// 种子 driver 的运行期 libs 该从哪儿取，按可信度排序 —— 判据始终是「**这个 driver 是哪一代**」：
//
// ① **本轮 `_ensureSeed` staged 种子的出处**（冷启动）。种子从哪儿来，它那一代的库就在那儿，
//    构造保证。⚠️ 这条必须排第一：暖 stdlib + 冷 compiler 目录（`rm -rf artifacts/build/compiler`
//    再 `build compiler`，调试时的常规动作）下，`Z42_LIBS` 可能指着**当前源**的 flat，而 driver
//    刚从 SDK staged ⇒ 两者不同代，拿 env 就会让种子 driver 崩在旧 FQN 上。
// ② **本进程启动时的 `Z42_LIBS`**（暖树：driver 是树内自建那代）。谁启动 xtask，谁就知道这个
//    种子该配哪一代库；`ci-bootstrap` 正是这么传的（快路径 = 下载的种子 libs；
//    **格式 bump 在飞时 = 两代路径产出的当代 stdlib**）。
// ③ **SDK libs**（`Z42_HOME/libs`，其次仓内 dev 装 `.z42/`）—— 本地 apphost 启动时会自己把
//    `Z42_LIBS` 设成 SDK libs，所以 ② 和 ③ 在本地通常同值。
//
// 🔴 为什么 ③ 不能无条件排前面：「SDK 就是种子那一代」这个假设**只在没有格式 bump 时成立**。
//    zpkg/zbc 格式 bump 在飞时 SDK 还是**上一代格式**，拿它补 run-libs 会被 strict-pin 当场拒收
//    （`zpkg minor N not supported …`）。
//
// ⚠️ 这里**故意不加**「minor 必须等于本树写端」的门：两代自举的 gen0 那一腿本就要用**旧** VM
//    跑旧格式的种子，那道门会当场误报。判「配没配对」得比对**正在用的那个 VM**，不是源码树。
string _seedLibsSource(string root) {
    string staged = SeedStage.StdlibFrom();
    if (staged.Length > 0 && Directory.Exists(staged)) { return staged; }
    string env = Environment.GetEnvironmentVariable("Z42_LIBS", "");
    if (env.Length > 0 && Directory.Exists(env)) { return env; }
    string tc = _toolchainDir(root);
    string libs = tc.Length > 0 ? _toolchainLibs(tc) : "";
    if (libs.Length > 0 && Directory.Exists(libs)) { return libs; }
    libs = _toolchainLibs(Path.Join(root, ".z42"));
    if (Directory.Exists(libs)) { return libs; }
    return "";
}

// ── 种子代的运行期 libs 快照 ─────────────────────────────────────────────────
//
// **为什么需要它**：自举时跑的是**上一代** z42c 二进制。它运行期要加载那一代的 stdlib
// （按它自己编译时的 FQN 调用），而它正在编译的源码要解析**当前源**新建出来的库。
// 两件事若共用 flat 一个目录 ⇒ 预建一覆盖 flat，种子 driver 自己就崩（改名/删符号时必然）。
//
// 种子 driver 的调用把这里挂成运行期 probing、flat 当 `Z42_LIBS`（编译期面，见 `_z42cProcSeed`）。
// driver 换代之后的调用两者同代，只用 flat。
//
// 🔴 **快照每轮重取**，不做「已存在就跳过」：跳过会让它停留在更早的一代，而 driver 已经换过代
//    —— 那正是这一路反复吃亏的「陈旧快照假装是权威」。
string _seedRunLibs(string root, string profile) {
    return _compilerWsWork(root, Path.Join("seed-run-libs", profile));
}

// 注：锚不能是「自建**开始前**的 flat 快照」—— flat 会被 `_ensureBootstrapSelfDepLibs` 覆盖成当前源（快照晚于覆盖、
// 或上一轮跑到一半，拿到的就是新代 ⇒ 种子 driver `MissingSymbolException`）。锚是**上一次自建成功时**的 flat
// stdlib（`_snapshotDriverGenLibs`），那一刻它正是新 driver 编译时对着的那一代，见 `_relocateSeedRunLibs`。

// 供种覆盖了成员 m 的 dist ⇒ 作废它的增量 cache（让 workspace 自建按当前源重编，而不是 preserved 种子产物），
// 并让 zsym 与种子 zpkg 配对：种子带 zsym 就用它的，不带就删掉 dist 里上一次构建留下的那份。
void _seedInvalidateMember(string root, string m, string profile, string dist, string seedDir) {
    string cache = _memberCache(_compilerWsToml(root), m, profile);
    if (Directory.Exists(cache)) { Directory.Delete(cache, true); }
    string seedSym = Path.Join(seedDir, m + ".zsym");
    string distSym = Path.Join(dist, m + ".zsym");
    if (File.Exists(distSym)) { File.Delete(distSym); }
    if (File.Exists(seedSym)) { File.Copy(seedSym, distSym); }
}

// Ensure an in-tree z42c + stdlib seed exists so the self-build (and its gen2
// byte-identical fixpoint) can run. No-op when the in-tree seed is already present
// (WARM). When absent (COLD), stage the resolved seed (Z42_LIBS / Z42_HOME
// (--toolchain) / apphost SDK) into the in-tree layout. Returns 0 on success (or
// already warm), 1 if no seed source.
int _ensureSeed(string root) {
    string profile = "release";
    string flatDir = _libsFlatDist(root, profile);
    string inDriver = _driverZpkg(root, profile);
    string inCore = Path.Join(flatDir, "z42.core.zpkg");
    // 🔴 **只缺 flat ≠ 冷树**。flat 是 stdlib 成员 dist 汇聚出的视图（clean intermediate、手动删都会让它没了），
    // 而 driver 还是本树当前那一代。若落到下面的整树供种 ⇒ 用**上一代**种子覆盖当前的编译器成员 dist，
    // 而增量缓存还在 ⇒ workspace 自建「preserved」把种子产物当本代留下（gen1≠gen2）。
    // 只缺 flat 时只给 flat 铺种子 stdlib，编译器一个不碰；随后 `build stdlib` 按当前源重建。
    int wantGen = _treeZpkgMinor(root);
    if (File.Exists(inDriver) && File.GetSize(inDriver) > 0L && !File.Exists(inCore)
        && (wantGen <= 0 || _zpkgFileMinor(inDriver) == wantGen)) {
        string seedLibs = _seedStdlibDir(root);
        if (seedLibs.Length > 0) {
            _vNormal("  seed: flat 缺失、driver 是本代 → 只铺种子 stdlib 进 flat（不动编译器）← " + seedLibs);
            SeedStage.NoteStdlibFrom(seedLibs);
            Directory.Create(flatDir);
            _copyAll(seedLibs, flatDir, "z42.*.zpkg");
            _copyAll(seedLibs, flatDir, "z42.*.zsym");
            if (File.Exists(inCore)) { return 0; }
        }
    }
    if (File.Exists(inDriver) && File.GetSize(inDriver) > 0L
        && File.Exists(inCore) && File.GetSize(inCore) > 0L) {
        // ⚠️ 「在不在」不等于「能用」：老一代 in-tree 产物被无声复用时，失败形态是运行期崩在
        // 某个未初始化的静态量上，与「种子过期」毫无字面关系。
        // 所以这里加一道**代际校验**：产物的格式 minor 必须等于本源码树写端的 minor。
        int want = _treeZpkgMinor(root);
        int gotDriver = _zpkgFileMinor(inDriver);
        int gotCore = _zpkgFileMinor(inCore);
        // 读不到源码常量（文件改名 / 结构变了）⇒ **不判、不删**，退回旧行为。
        // 这道校验是防呆，不该自己变成新的故障源。
        if (want <= 0 || (gotDriver == want && gotCore == want)) {
            _vDetailed("  seed: in-tree warm present — reuse (no staging)");
            return 0;
        }
        // 总是打印（不走 _vNormal）：这是一次**丢弃产物**的纠正动作，而且它一旦发生，
        // 就是用户理解「为什么这次构建特别慢 / 为什么上一次崩得莫名其妙」的唯一线索。
        Console.WriteLine("  seed: in-tree warm is a format generation behind (zpkg minor driver="
            + gotDriver.ToString() + " stdlib=" + gotCore.ToString()
            + ", this tree writes " + want.ToString() + ") — discarding and cold-staging");
        // 整代作废：同一代产出的编译器产物与 stdlib dist 要一起丢 —— 留一半下来只会在
        // 下一层撞上同样的错代问题（devinfra/build.md §3「warm 判据带代际校验」）。
        if (Directory.Exists(_compilerBuildRoot(root))) { Directory.Delete(_compilerBuildRoot(root), true); }
        if (Directory.Exists(_libsBuildRoot(root))) { Directory.Delete(_libsBuildRoot(root), true); }
    }

    Stopwatch sw = _procStart("seed cold-start (stage z42c + stdlib from SDK)");
    string driverHome = _seedDriverHome(root);
    string stdlibDir = _seedStdlibDir(root);
    if (driverHome.Length == 0 || stdlibDir.Length == 0) {
        ConsoleError.WriteLine("error: no z42c seed. Provide one of:");
        ConsoleError.WriteLine("  --toolchain <sdk>  /  Z42_HOME=<sdk>   (.z42 layout: programs/z42c + libs)");
        ConsoleError.WriteLine("  Z42_LIBS=<stdlib dist>                 (stdlib only; z42c seed still needs Z42_HOME)");
        ConsoleError.WriteLine("  ./scripts/install-z42.sh → ./.z42      (auto-detected when xtask runs via that SDK)");
        return 1;
    }
    _vNormal("  seed: z42c   ← " + driverHome);
    _vNormal("  seed: stdlib ← " + stdlibDir);
    // 记下出处：种子 driver 的运行期 libs 就该是它那一代，见 `_seedLibsSource` ①。
    SeedStage.NoteStdlibFrom(stdlibDir);
    // 本树上一个 driver 的代际锚与种子不同代 ⇒ 作废（否则 `_relocateSeedRunLibs` 拿它压过种子 stdlib）。
    string staleAnchor = _driverGenLibs(root, profile);
    if (Directory.Exists(staleAnchor)) { Directory.Delete(staleAnchor, true); }

    // 种子本身也可能落后一代（刚 bump 完格式、新 nightly 还没发）。这里**只告警不失败**：
    // 「上一版 z42c 能编当前源」是 分阶段引入纪律（self-hosting.md），落后一代未必不能用；
    // 但一旦真的不能用，失败形态会是运行期崩在某个静态表上，那时这行是唯一的线索。
    int wantSeed = _treeZpkgMinor(root);
    int gotSeed = _zpkgFileMinor(Path.Join(driverHome, "z42c.driver.zpkg"));
    if (wantSeed > 0 && gotSeed > 0 && gotSeed != wantSeed) {
        ConsoleError.WriteLine("  ⚠ seed is a format generation behind: zpkg minor "
            + gotSeed.ToString() + " (this tree writes " + wantSeed.ToString() + ")");
        ConsoleError.WriteLine("    refresh with ./scripts/install-z42.sh --force"
            + "  (a stale seed fails LATER, as a runtime crash on some uninitialized static)");
    }

    // 🔴 供种的期望清单来自**当前** `_compilerMembers()`，而种子是**上一代** —— **成员集合一变，
    // 这里立刻不匹配**，且只在冷启动（走供种）暴露，本地 warm 树看不见。
    // ⇒ **挪动编译器成员集合前，先想「上一代种子里这个文件在哪」**。
    // **新增成员**（种子那一代还没有它）不算缺：供种只给 dist 预置一份可用的上一代，
    // 随后的 `build --workspace` 按拓扑序从当前源建出每个成员。缺了就跳过、打一行提示；唯独 driver 必须有
    // （它就是种子本身，下面的种子 driver 要靠它跑）。若一律报错 ⇒ 新增成员的 PR 冷启动必红，而 nightly
    // 只从绿的 main 发布 ⇒ 永远拿不到带新成员的种子（死锁）。
    //
    // 🔴 **成员 dist 与它的增量缓存必须出自同一次构建**。往 dist 里放种子产物时，同时作废该成员的 cache、删掉
    // 配不上的 zsym（种子的 programs/z42c 不带 zsym）—— 否则随后的 workspace 自建判「源没变」直接 preserved，
    // 种子那一代的产物就冒充了当前源的产物。
    foreach (var m in _compilerMembers(root)) {
        string dst = _compilerMemberDist(root, m, profile);
        Directory.Create(dst);
        _copyAll(driverHome, dst, m + ".zpkg");
        if (File.Exists(Path.Join(dst, m + ".zpkg"))) {
            _seedInvalidateMember(root, m, profile, dst, driverHome);
        }
        if (!File.Exists(Path.Join(dst, m + ".zpkg"))) {
            if (m == "z42c.driver") {
                ConsoleError.WriteLine("error: seed missing " + m + ".zpkg in " + driverHome);
                return 1;
            }
            _vNormal("  seed: no " + m + ".zpkg (member newer than the seed) — built from source by the workspace build");
        }
    }
    // 自举纪律：种子 driver 的兄弟集可能含当前 members 已没有的包。它运行时按 entry-dir 解析兄弟，
    // 缺一个就 undefined。故把 driverHome 的**全部 z42c.* 兄弟**铺到 driver dist，令种子 driver
    // 自包含可跑。gen1 起用当前成员就地覆盖，遗留兄弟无害闲置。
    string driverDist = _driverDist(root, profile);
    Directory.Create(driverDist);
    _copyAll(driverHome, driverDist, "z42c.*.zpkg");
    _copyAll(driverHome, driverDist, "z42c.*.zsym");
    Directory.Create(flatDir);
    _copyAll(stdlibDir, flatDir, "z42.*.zpkg");
    _copyAll(stdlibDir, flatDir, "z42.*.zsym");
    if (!File.Exists(inCore)) {
        ConsoleError.WriteLine("error: seed stdlib missing z42.core.zpkg in " + stdlibDir);
        return 1;
    }
    _procEnd("seed cold-start (stage z42c + stdlib from SDK)", sw);
    return 0;
}

// ── artifact paths (absolute, repo-root-relative) ────────────────────────────

// stdlib flat dist (= the Z42_LIBS value the compiler + VM load stdlib from):
//   artifacts/intermediate/libraries/flat/release.
// This is the CANONICAL build-tree path — where the producer command (build stdlib)
// WRITES. Consumers that must honour an active `--toolchain` resolve the toolchain
// first themselves (`_activeVm` / `_toolchainLibs`) and fall back here.
// ⚠️ scripts/xtask_hooks.z42（embed-libs）另写了一份（hooks 工程调不到本函数），改这里要同步。
string _libsDir(string root) {
    return _libsFlatDist(root, "release");
}

// Absolute path to a cargo-built binary under artifacts/build/runtime/<profile>/,
// WITH the platform exe suffix. Critical for File.Exists checks on Windows: the
// real file is `z42vm.exe`, and File.Exists("...z42vm") returns false there even
// though Process() auto-resolves the .exe. Always route built-binary lookups
// through this helper so the gate doesn't false-fail on Windows.
string _builtBin(string root, string profile, string name) {
    string bin = Platform.IsWindows() ? (name + ".exe") : name;
    string dir = _runtimeOut(root, profile);
    return Path.Join(dir, bin);
}

// Convenience: the built z42vm for a profile ("debug" / "release").
string _builtVm(string root, string profile) {
    return _builtBin(root, profile, "z42vm");
}

// ── source paths (relative — passed to --manifest-path from cwd=root) ──

// the Rust VM/runtime cargo manifest (--manifest-path): src/runtime/Cargo.toml
string _runtimeManifest() { return "src/runtime/Cargo.toml"; }

// The one cargo config (target-dir = artifacts/build/runtime, wasm rustflags) lives in
// src/runtime/.cargo and governs every crate: the runtime workspace *and* the toolchain
// platform crates (apphost / wasm / ios / android) — all share target-dir artifacts/build/runtime
// (cargo separates them by <profile>/ vs <triple>/<profile>/ and per-crate artifact names).
// cargo finds .cargo/config.toml by walking up from its *cwd*, never from --manifest-path,
// and src/toolchain/** is not under src/runtime — so every cargo call, including wasm-pack /
// cargo-ndk run inside a platform crate dir, names the config explicitly (--config).
string _runtimeCargoConfig() { return "src/runtime/.cargo/config.toml"; }

// `cargo <verb> --config <abs config>` — the base for every cargo invocation. The path is
// absolute so it holds under any WorkingDirectory.
Process _cargoCmd(string verb, string config) {
    return new Process("cargo").Arg(verb).Arg("--config").Arg(Path.Join(_root(), config));
}

// ── bin-invocation builders (return a Process; callers add args + _exec) ─────

// `cargo build --release --config <config>` — the common Rust build prefix. Callers append
// `.Arg("-q")` / `.Arg("--manifest-path").Arg(m)` / `--features` / `-p` /
// `--target` etc. then `_exec` it. (cargo ignores flag order, so the few
// `-q`-before-manifest sites are unaffected.)
Process _cargoRelease(string config) {
    return _cargoCmd("build", config).Arg("--release");
}

// ── tool presence ────────────────────────────────────────────────────────────

// "is <bin> on PATH" (PATHEXT-aware on Windows). Shared primitive: deps-install presence checks +
// package-time tooling gates.
bool _have(string bin) { return Process.Which(bin) != null; }

// `<bin>` 不在 PATH 上 ⇒ 打一行 `error: <bin> not found (<hint>)` 并返回 false（调用方 return 1）。
// 平台测试 backend（desktop / ios / android）与 embedded 的入口门。
bool _requireTool(string bin, string hint) {
    if (Process.Which(bin) != null) { return true; }
    ConsoleError.WriteLine("error: " + bin + " not found (" + hint + ")");
    return false;
}

// stdout of a command, trimmed; "" on failure.
string _cmdOut(string bin, string[] args) {
    try {
        ProcessResult r = new Process(bin).Args(args).Stderr(Stdio.Null()).Run();
        if (r.ExitCode != 0) { return ""; }
        return r.Stdout.Trim();
    } catch (Exception e) { return ""; }
}

// 文件的 sha256（小写 hex）；失败 → ""。走系统工具（Std.Crypto.Sha256 是纯脚本实现，解释模式下对几百 MB 的
// 归档太慢）：macOS 只有 `shasum`，Linux 必有 `sha256sum`；两者都打 "<hash>  <file>"，取首 token。
// 发布归档 SHA256SUMS（package/）与下载件 pin 校验（install/）共用。
string _sha256Hex(string path) {
    string outp = Platform.IsMacOS() ? _cmdOut("shasum", new string[] { "-a", "256", path })
                                     : _cmdOut("sha256sum", new string[] { path });
    int sp = outp.IndexOf(" ");
    string hex = sp > 0 ? outp.Substring(0, sp) : outp;
    return hex.Trim().ToLower();
}
