// xtask — 门禁棘轮与白名单的单一配置 `scripts/test/gates.toml` 的读写面。
//
// 机器维护区由各门的 `--update` 重写（`# z42-gates:<name>-begin/end` 标记之间），
// 手写配置区（白名单等）按需增改。
//
// 只提供两个原语：读一张表（_gatesSection，缺失返回空表）与重写一个机器区段
//（_gatesWriteSection，标记不存在则追加到文件尾）。解析用 Std.Toml；重写走文本拼接——
// TomlValue.Stringify 不保留注释与格式，手写区不能被机器区重写波及。
namespace Z42Xtask;

using Std.IO;
using Std.Text;
using Std.Toml;

string _gatesTomlPath(string root) { return Path.Join(root, "scripts/test/gates.toml"); }

// 读 `[<name>]` 表；文件或表不存在 → 空表（「没配置」与「清零」同形）。
TomlValue _gatesSection(string root, string name) {
    string p = _gatesTomlPath(root);
    if (!File.Exists(p)) { return TomlValue.OfTable(); }
    TomlValue doc = null;
    try { doc = TomlValue.Parse(File.ReadAllText(p)); }
    catch (Exception ex) {
        ConsoleError.WriteLine("  ✗ gates.toml 解析失败：" + ex.Message);
        return TomlValue.OfTable();
    }
    TomlValue t = null;
    if (doc.TryGet(name, ref t) && t.IsTable()) { return t; }
    return TomlValue.OfTable();
}

// 重写 `# z42-gates:<name>-begin … # z42-gates:<name>-end` 之间的机器区段。
// bodyLines 为区段正文（含 `[<name>]` 表头行）；标记对不存在则连同标记一起追加到文件尾。
void _gatesWriteSection(string root, string name, string[] bodyLines, int bn) {
    string p = _gatesTomlPath(root);
    string beginMark = "# z42-gates:" + name + "-begin";
    string endMark = "# z42-gates:" + name + "-end";
    StringBuilder nb = new StringBuilder();
    nb.Append(beginMark).Append("（xtask check ").Append(name).Append(" --update 维护）\n");
    int i = 0;
    while (i < bn) { nb.Append(bodyLines[i]).Append("\n"); i = i + 1; }
    nb.Append(endMark).Append("\n");
    string block = nb.ToString();
    string text = "";
    if (File.Exists(p)) { text = File.ReadAllText(p); }
    int b = text.IndexOf(beginMark);
    if (b < 0) {
        string sep = "";
        if (text.Length > 0 && !text.EndsWith("\n")) { sep = "\n"; }
        File.WriteAllTextAtomic(p, text + sep + "\n" + block);
        return;
    }
    int e = text.Substring(b).IndexOf(endMark);
    if (e < 0) {
        ConsoleError.WriteLine("  ✗ gates.toml 缺 " + endMark + "——手工补回成对标记");
        return;
    }
    e = b + e;
    int tail = e + endMark.Length;
    string tailRest = text.Substring(tail);
    if (tailRest.StartsWith("\n")) { tail = tail + 1; tailRest = tailRest.Substring(1); }
    File.WriteAllTextAtomic(p, text.Substring(0, b) + block + tailRest);
}

// toml 基本字符串引号（路径 / 日期这类只可能含反斜杠与引号的值）。
string _tomlQuote(string s) {
    return "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
}
