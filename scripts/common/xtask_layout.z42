// xtask — build-tree layout paths (unify-xtask-paths-from-toml, 2026-08-29).
//
// ONE home for the artifacts/build/... layout that xtask navigates. Two kinds:
//
//   ① per-member products (libraries / compiler workspaces) — the SINGLE SOURCE OF
//      TRUTH is `[workspace.build].output_dir` in the workspace.toml, resolved by
//      z42.project's `WorkspaceLayout` (the very code z42c's PlanLayout and
//      BuildLayout.Resolve use). Change the toml template → xtask follows automatically.
//
//   ② xtask-invented conventions with NO toml home — the flat stdlib dist (all
//      members hard-linked into one Z42_LIBS dir), the cargo runtime output dir,
//      the build roots xtask scans/stages. These live here as single definitions.
//
//   ③ the top-level `artifacts/` buckets (tools / packages / reports / .z42 …).
//      centralize-xtask-layout（2026-09-30）：这些
//      此前散落在 ~35 个使用点、各写一遍字面量，理由是「一次性目录、没有布局含义」。但整理
//      artifacts/ 布局时恰恰要逐个挪它们 —— 散着就得逐个找。现在每个桶**只在这里定义一次**，
//      使用点只写桶名 + 自己的子目录名。`xtask layout` 把它们打印成目录树，也按相对路径给 CI / 脚本查询。
//
// Same Z42Xtask namespace as the rest of xtask, so callers use bare names.
namespace Z42Xtask;

using Std.IO;
using Std.Cli;   // ParseResult（`_layoutCmd`）
// ⚠️ 这个命名空间**不能随手改名**：xtask 是**两头都挂在上一代 SDK 上**的消费者 —— CI 用下载的
// nightly SDK libs **编译** xtask.zpkg，之后又用**本轮新建的 flat** 当 `Z42_LIBS` **运行**它。
// 抹掉旧 FQN 的改名会让其中一头必炸（实测两种排法各炸一头）。
//
// 🔴 要动它，别按直觉「在 `z42.project` 里加一版并存」——**那条实测编不出来**（同包内两套同短名类
// 串味 `E0401`，且种子 z42c 一样如此），另立兼容包也没用（运行期按 **zpkg 文件名**解析，没有任何
// `DEPS` 指向它）。可行形态 = **编译期 overlay + 运行期旁置**，配方与四段实测判据见
// `docs/spec/archive/2026-09-27-rename-project-namespaces/design.md` §6.1/§6.2。
// （B3b 已按该形态一步落完，2026-09-27；那两段 CI 接线是一代过渡形态、当天即撤。）
using Z42.Project;   // ManifestLoader / WorkspaceManifest / PathTemplate / TemplateContext

// ── source-of-truth workspace manifests (per-member layout templates) ─────────

// The stdlib workspace whose [workspace.build].output_dir drives every
// artifacts/build/libraries/<member>/<profile>/dist product.
string _libsWsToml(string root) { return Path.Join(root, "src/libraries/z42.workspace.toml"); }

// The compiler workspace whose template drives artifacts/build/compiler/<member>/...
string _compilerWsToml(string root) { return Path.Join(root, "src/compiler/z42.workspace.toml"); }

// ── per-member dist (READ FROM workspace.toml — single source with z42c) ──────

// Collapse `x/..` segments. z42 stdlib has no Path.Normalize, and the output_dir
// templates use `../../` to ascend from the workspace dir to the repo root; without
// this the joined path keeps literal `..`, which is filesystem-equivalent but breaks
// xtask's textual path handling (e.g. prefix-strip staging) and muddies diffs.
string _cleanPath(string p) {
    bool rooted = p.Length > 0 && (p.CharAt(0) == '/');
    string[] segs = p.Split("/");
    string[] stack = new string[segs.Length];
    int top = 0;
    int i = 0;
    while (i < segs.Length) {
        string s = segs[i];
        if (s.Length == 0 || s == ".") { i = i + 1; continue; }
        if (s == ".." && top > 0 && stack[top - 1] != "..") { top = top - 1; i = i + 1; continue; }
        stack[top] = s; top = top + 1;
        i = i + 1;
    }
    if (top == 0) { return rooted ? "/" : ""; }
    string r = "";
    int j = 0;
    while (j < top) {
        if (j == 0) { r = rooted ? ("/" + stack[j]) : stack[j]; }
        else { r = r + "/" + stack[j]; }
        j = j + 1;
    }
    return r;
}

// Per-member dist / cache directory — 委托 z42.project 的 `WorkspaceLayout`（z42c 的 `PlanLayout` 与
// `BuildLayout.Resolve` 的成员布局用的同一份实现，unify-build-layout；此前这里是它的手抄）。
string _memberDist(string wsToml, string member, string profile) {
    return _cleanPath(Path.Join(_memberOutputDir(wsToml, member, profile), "dist"));
}
string _memberCache(string wsToml, string member, string profile) {
    WorkspaceManifest ws = ManifestLoader.LoadWorkspace(wsToml);
    string wsDir = Path.GetDirectoryName(wsToml);
    string outAbs = _memberOutputDir(wsToml, member, profile);
    return _cleanPath(WorkspaceLayout.MemberCacheDir(ws, wsDir, "", member, profile, outAbs));
}
string _memberOutputDir(string wsToml, string member, string profile) {
    WorkspaceManifest ws = ManifestLoader.LoadWorkspace(wsToml);
    return _cleanPath(WorkspaceLayout.MemberOutputDir(ws, Path.GetDirectoryName(wsToml), "", member, profile));
}

// Workspace build root = the output_dir template's literal prefix (everything before the first
// `${…}`), resolved against the workspace dir. e.g. "../../artifacts/build/compiler/${project_name}/…"
// → <root>/artifacts/build/compiler. The dir xtask scans / stages / cleans per member.
string _wsBuildRoot(string wsToml) {
    string tpl = WorkspaceLayout.OutputTemplate(ManifestLoader.LoadWorkspace(wsToml));
    int k = tpl.IndexOf("${");
    string prefix = k >= 0 ? tpl.Substring(0, k) : tpl;
    string wsDir = Path.GetDirectoryName(wsToml);
    return _cleanPath(Path.IsRooted(prefix) ? prefix : Path.Join(wsDir, prefix));
}

// `p` relative to the repo root (both cleaned); "" when `p` is not under root. Used to mirror
// a toml-resolved product dir into a staging tree at the same relative location.
string _rootRel(string root, string p) {
    string r = _cleanPath(root.Replace("\\", "/"));
    string u = _cleanPath(p.Replace("\\", "/"));
    if (u.StartsWith(r + "/")) { return u.Substring(r.Length + 1, u.Length - r.Length - 1); }
    return "";
}

// per-member dist dirs for the two workspaces.
string _libMemberDist(string root, string member, string profile) {
    return _memberDist(_libsWsToml(root), member, profile);
}
string _compilerMemberDist(string root, string member, string profile) {
    return _memberDist(_compilerWsToml(root), member, profile);
}

// per-member <name>.zpkg full paths.
string _libMemberZpkg(string root, string member, string profile) {
    return Path.Join(_libMemberDist(root, member, profile), member + ".zpkg");
}
string _compilerMemberZpkg(string root, string member, string profile) {
    return Path.Join(_compilerMemberDist(root, member, profile), member + ".zpkg");
}

// z42c driver dist / zpkg (the self-host seed entry). Just the compiler member
// "z42c.driver" — named for its many call sites.
string _driverDist(string root, string profile) { return _compilerMemberDist(root, "z42c.driver", profile); }
string _driverZpkg(string root, string profile) { return _compilerMemberZpkg(root, "z42c.driver", profile); }

// z42c driver 的「home」= 它自己 release dist 的目录：自包含（z42c.driver.zpkg + z42c.* 兄弟 + 它那一代的
// stdlib 闭包），z42vm 从入口 zpkg 所在目录解析依赖，被编译代码的 stdlib 另走 Z42_LIBS。driver 未构建返回 ""。
string _driverHome(string root) {
    string d = _driverZpkg(root, "release");
    return File.Exists(d) ? Path.GetDirectoryName(d) : "";
}

// ── build-tree roots + conventions (single definitions; no toml home) ─────────

// artifacts/build — the root under which everything xtask BUILDS is written
// (distinct from artifacts/xtask, xtask's own product).
string _buildDir(string root) { return Path.Join(_artifactsDir(root), "build"); }

// stdlib / compiler workspace build roots (staged / scanned / cleaned) — from the workspace.toml
// output_dir template prefix, not hardcoded.
string _libsBuildRoot(string root) { return _wsBuildRoot(_libsWsToml(root)); }
string _compilerBuildRoot(string root) { return _wsBuildRoot(_compilerWsToml(root)); }

// artifacts/build/libraries/dist/<profile> — the FLAT stdlib dist (all members
// hard-linked into one dir = the Z42_LIBS the compiler + VM load from). An xtask
// aggregation, not a workspace.toml field.
string _libsFlatDist(string root, string profile) {
    return Path.Join(_libsBuildRoot(root), "dist/" + profile);
}

// artifacts/build/runtime — cargo's target-dir for every Rust crate: the runtime workspace
// (z42vm / native libs) and the toolchain platform crates (apphost, wasm / ios / android).
// Governed by `target-dir` in src/runtime/.cargo/config.toml, not a z42 workspace.toml —
// keep the two in sync. Host builds land in <profile>/, cross builds in <triple>/<profile>/.
string _cargoTargetDir(string root) { return Path.Join(_buildDir(root), "runtime"); }

// artifacts/build/runtime/<profile> — host cargo output dir for z42vm / native libs.
string _runtimeOut(string root, string profile) {
    return Path.Join(_cargoTargetDir(root), profile);
}

// ── build/ 与 intermediate/：都逐路径镜像 src/ ──────────────────────────────────
//
// 规则（docs/internals/src/devinfra/artifacts-layout.md §1）：**build/ 只放编译产物**——各包的
// `<profile>/{dist,cache}`、z42b 测试 / bench 目标（`<profile>/{tests,bench}`）、golden `.zbc`、cargo 的 target
// 目录；**intermediate/ 放其余一切**——夹具的暂存拷贝、harness 工作目录、平台测试的 bundle / 宿主工程副本、
// 编译器自举快照、xtask 自检目录。两边都按 owner 在 src 下的位置镜像，于是「某个东西写到哪去了」只有一个
// 答案；没有共享的 scratch 桶，也就没有按名字撞车。

// `src/<rel>` → `artifacts/build/<rel>`。已经在 artifacts/build/ 下的路径原样返回。其它位置是调用方的 bug。
string _buildMirror(string root, string path) {
    return _mirrorUnder(root, path, _buildDir(root), "_buildMirror");
}

// `src/<rel>` → `artifacts/intermediate/<rel>`。已经在 intermediate/ 下的路径（夹具的暂存拷贝）原样返回，
// 这样「对一个工程目录求它的工作位置」不必关心这个工程是源码还是拷贝。
string _workMirror(string root, string path) {
    return _mirrorUnder(root, path, _intermediateDir(root), "_workMirror");
}

string _mirrorUnder(string root, string path, string base, string who) {
    string p = _cleanPath(path.Replace("\\", "/"));
    string b = _cleanPath(base);
    if (p == b || p.StartsWith(b + "/")) { return p; }
    string srcRoot = _cleanPath(Path.Join(root, "src"));
    if (p.StartsWith(srcRoot + "/")) { return Path.Join(b, p.Substring(srcRoot.Length + 1)); }
    if (p.StartsWith("src/")) { return Path.Join(b, p.Substring(4)); }
    throw new Exception(who + ": path is under neither src/ nor " + b + ": " + path);
}

// 组件 `componentSrc`（`src/...`）的工作目录 `artifacts/intermediate/<rel>/<name>`；name 为空 = 组件根。
string _workOut(string root, string componentSrc, string name) {
    string t = _workMirror(root, componentSrc);
    return name.Length == 0 ? t : Path.Join(t, name);
}

// 一个工程目录（源码，或它在 intermediate/ 下的暂存拷贝）所属组件的工作根：镜像路径里有 `tests` 段
// （夹具拷贝住在 `<组件>/tests/fixtures/…`）就截到它之前，即组件本身；否则就是该工程的镜像。
string _workRootOf(string root, string path) {
    string m = _workMirror(root, path);
    string base = _cleanPath(_intermediateDir(root));
    string rel = m.Length > base.Length ? m.Substring(base.Length + 1) : "";
    string acc = base;
    foreach (var seg in rel.Split("/")) {
        if (seg.Length == 0) { continue; }
        if (seg == "tests") { return acc; }
        acc = Path.Join(acc, seg);
    }
    return m;
}

// xtask 自身的自检工作目录 `artifacts/intermediate/xtask/<name>`。xtask 不在 src/ 里，它的编译产物也不在
// build/ 里（`artifacts/xtask/`），工作目录照规则归 intermediate/。
string _xtaskWork(string root, string name) {
    return Path.Join(Path.Join(_intermediateDir(root), "xtask"), name);
}

// 编译器 workspace 级（不属于某个成员）的中间物 `artifacts/intermediate/compiler/<name>`：自举快照
// （selfhost-gen1）、种子 driver 的运行期 stdlib（seed-run-libs）、driver 重编 stdlib 时的稳定副本（stdlib-run）。
string _compilerWsWork(string root, string name) { return Path.Join(_workMirror(root, "src/compiler"), name); }

// xtask's own product — resolved from scripts/xtask.z42.toml [build] (dist_dir/output_dir).
string _xtaskZpkg(string root) { return _toolchainZpkg(root, "scripts/xtask.z42.toml"); }

// z42b dev 目标（test / bench）的产物根 —— 传给 `z42b test|bench --out-root`（fix-z42b-source-tree-outputs）。
// 不传时 z42b 写 `<清单目录>/artifacts/…`，而 stdlib / 编译器成员的清单没有 [build] ⇒ 落进源码树。
// 它们是编译产物，落 build/，形状与运行时一致：`<镜像>/<profile>/{tests,bench}`（profile = debug：xtask 调
// z42b 不带 --release）。
//   stdlib / 编译器 workspace 成员 → 成员输出目录 `<m>/debug/{tests,bench}`；`clean tests|bench` 按同一位置删；
//   src/toolchain 下的工程 → `build/<rel>/debug/{tests,bench}`；
//   其它工程（实际只有 z42b 自身夹具的暂存拷贝，住在 intermediate/）→ 所属组件工作根下的 dev-targets/<name>/<tests|bench>。
// ⚠️ 必须是成员输出目录下的**子目录**，不能是输出目录本身：z42b 会在 out-root 下建父包，放在
//    `<output_dir>/dist` 就会覆盖 z42c 建的正式成员产物。
string _devTargetOutRoot(string root, string toml, string kind) {
    string sub = (kind == "bench") ? "bench" : "tests";
    string name = ManifestLoader.Load(toml).Project.Name;
    string tu = _cleanPath(toml.Replace("\\", "/"));
    if (tu.StartsWith(_cleanPath(Path.Join(root, "src/libraries")) + "/")) {
        return Path.Join(Path.GetDirectoryName(_memberDist(_libsWsToml(root), name, "debug")), sub);
    }
    if (tu.StartsWith(_cleanPath(Path.Join(root, "src/compiler")) + "/")) {
        return Path.Join(Path.GetDirectoryName(_memberDist(_compilerWsToml(root), name, "debug")), sub);
    }
    if (tu.StartsWith(_cleanPath(Path.Join(root, "src/toolchain")) + "/")) {
        return Path.Join(Path.Join(_buildMirror(root, Path.GetDirectoryName(toml)), "debug"), sub);
    }
    return Path.Join(Path.Join(_workRootOf(root, Path.GetDirectoryName(toml)), "dev-targets/" + name), sub);
}

// ── ③ top-level artifacts/ buckets (single definitions) ────────────────────────
//
// 每个桶只在这里定义，使用点不写 `"artifacts/…"` 字面量。`_layoutKeys` / `_layoutPath` 把它们列给 `xtask layout`。

// artifacts/ — the single output root.
string _artifactsDir(string root) { return Path.Join(root, "artifacts"); }

// artifacts/intermediate/ — 不是编译产物、也不是发布资产的一切（见上方「build/ 与 intermediate/」）。
string _intermediateDir(string root) { return Path.Join(_artifactsDir(root), "intermediate"); }

// 旧的共享工作目录桶 artifacts/tmp 与更早的 artifacts/.scratch —— 只供 `xtask clean all` 清理旧工作树
// 里的残留。不要往这里写：工作目录归 intermediate/ 下的 owner（见上方「build/ 与 intermediate/」）。
string _legacyTmpDir(string root) { return Path.Join(_artifactsDir(root), "tmp"); }
string _legacyScratchDir(string root) { return Path.Join(_artifactsDir(root), ".scratch"); }

// （artifacts/build/views/<profile>/all —— alllibs，2026-10-01 删除：`Z42_LIBS` 只是 stdlib flat，
//  编译器包运行期走 `_compilerProbingPaths`、编译期由 driver 从编译器目录解析。旧树里的残留由 `clean all` 随 build/ 删。）

// artifacts/tools — downloaded third-party tools (node / android-sdk / gradle / playwright).
string _toolsDir(string root) { return Path.Join(_artifactsDir(root), "tools"); }

// artifacts/.z42 — the local dev SDK assembled by `build sdk` (default `--sdk` of `test examples`).
string _devSdkDir(string root) { return Path.Join(_artifactsDir(root), ".z42"); }

// 旧的 artifacts/publish（打包暂存根）—— drop-package-staging（2026-10-01）起组件直接装进包目录，不再写这里。
// 只供 `xtask clean all` 清理旧工作树里的残留。不要往这里写。
string _legacyPubStagingDir(string root) { return Path.Join(_artifactsDir(root), "publish"); }

// artifacts/packages — assembled package dirs (z42-<ver>-<rid>-<profile>…).
string _packagesDir(string root) { return Path.Join(_artifactsDir(root), "packages"); }

// artifacts/packages/archives — release archives + SHA256SUMS + release-index.json（`package archive` /
// `package finalize` 的输出）。曾是顶层 `artifacts/release/`；它只装 package 系列命令的产物，2026-10-02 起
// 收进 `packages/`（simplify-layout）。子目录而不与包目录平级：`package archive` 遍历 `packages/` 下的
// 包目录去打包，归档放同层会被当成待打包项（`_relArchiveBase` 只认包目录名，`archives` 天然被跳过）。
string _archivesDir(string root) { return Path.Join(_packagesDir(root), "archives"); }
// 旧位置：只供 `clean all` 清走残留，不再有人写。
string _legacyReleaseDir(string root) { return Path.Join(_artifactsDir(root), "release"); }

// artifacts/reports — 给人与 CI 看的**结果**（不是构建产物，`clean all` 也不删）：一个桶、按种类分子目录。
string _reportsDir(string root) { return Path.Join(_artifactsDir(root), "reports"); }

// artifacts/reports/tests — 平台测试的 junit（每个平台一个子目录：<platform>/junit.xml）。
string _testReportsDir(string root) { return Path.Join(_reportsDir(root), "tests"); }

// artifacts/reports/bench — benchmark 结果 JSON（e2e.json / ab.json / micro-*.json）。
string _benchDir(string root) { return Path.Join(_reportsDir(root), "bench"); }

// artifacts/reports/profile — `xtask profile` 报告（每个被测脚本一个子目录）。
string _profileDir(string root) { return Path.Join(_reportsDir(root), "profile"); }

// 旧位置（三个结果目录曾是 artifacts/ 的顶层桶）：只供 `clean all` 清走残留，不再有人写。
string[] _legacyReportDirs(string root) {
    return new string[]{ Path.Join(_artifactsDir(root), "test-reports"),
                         Path.Join(_artifactsDir(root), "bench"),
                         Path.Join(_artifactsDir(root), "profile") };
}

// ── `xtask layout`：artifacts/ 的目录树 ───────────────────────────────────────
//
// 条目 = 相对 artifacts/ 的路径（它同时是查询用的 key）+ 层级 + 一句说明。名字就是磁盘上的目录名：
// build/ 下的子目录直接枚举 src/ 的一级目录（build/ 逐路径镜像 src/，新组件自动出现），不另起
// `vm` / `compiler-build` 这类别名。路径由各自的单一定义函数算出，改布局时这里自动跟上。
public sealed class LayoutEntriesZ {
    public string[] Rel;     // 相对 artifacts/ 的路径（目录带尾 /）；不在 artifacts/ 下时是绝对路径
    public string[] Name;    // 显示名：相对父条目的那一段
    public int[] Depth;
    public string[] Desc;
    public string[] Abs;
    public int Count;
    public LayoutEntriesZ() {
        Rel = new string[32]; Name = new string[32]; Depth = new int[32];
        Desc = new string[32]; Abs = new string[32]; Count = 0;
    }
    public void Add(string rel, string name, int depth, string desc, string abs) {
        if (Count >= Rel.Length) { return; }
        Rel[Count] = rel; Name[Count] = name; Depth[Count] = depth; Desc[Count] = desc; Abs[Count] = abs;
        Count = Count + 1;
    }
}

// abs 相对 artifacts/ 的路径；dir = true 加尾 /。不在 artifacts/ 下（如 --toolchain 指向外部 SDK）原样返回。
string _layoutRel(string root, string abs, bool dir) {
    string a = _cleanPath(_artifactsDir(root).Replace("\\", "/"));
    string p = _cleanPath(abs.Replace("\\", "/"));
    string rel = p.StartsWith(a + "/") ? p.Substring(a.Length + 1) : p;
    return dir ? rel + "/" : rel;
}

// child 相对 parent 的显示名（parent 不是它的前缀时用完整 rel）。
string _layoutName(string parentRel, string rel) {
    return (parentRel.Length > 0 && rel.StartsWith(parentRel)) ? rel.Substring(parentRel.Length) : rel;
}

string _layoutBuildDesc(string d) {
    if (d == "runtime")   { return "cargo target-dir"; }
    if (d == "libraries") { return "stdlib 各成员 <lib>/<profile>/"; }
    if (d == "compiler")  { return "编译器各成员 <member>/<profile>/"; }
    if (d == "toolchain") { return "工具链各组件（含 workload 的 appbuilder 与 test agent）"; }
    if (d == "tests")     { return "src/tests golden 的 .zbc"; }
    if (d == "bench")     { return "性能场景探针的 .zbc"; }
    return "";
}

LayoutEntriesZ _layoutEntries(string root) {
    LayoutEntriesZ e = new LayoutEntriesZ();
    string build = _layoutRel(root, _buildDir(root), true);
    e.Add(build, build, 0, "编译产物（含测试的 .zbc / z42b 测试目标），逐路径镜像 src/", _buildDir(root));
    foreach (var d in _enumDirsSorted(Path.Join(root, "src"))) {
        string abs = Path.Join(_buildDir(root), d);
        string rel = _layoutRel(root, abs, true);
        e.Add(rel, _layoutName(build, rel), 1, _layoutBuildDesc(d), abs);
        if (d == "runtime") {
            string vm = _builtVm(root, "release");
            string vrel = _layoutRel(root, vm, false);
            e.Add(vrel, _layoutName(rel, vrel), 2, "VM 二进制", vm);
        }
        if (d == "libraries") {
            string flat = _libsDir(root);
            string frel = _layoutRel(root, flat, true);
            e.Add(frel, _layoutName(rel, frel), 2, "扁平 stdlib = Z42_LIBS", flat);
        }
    }
    string im = _layoutRel(root, _intermediateDir(root), true);
    e.Add(im, im, 0, "中间物：夹具暂存拷贝、harness 工作目录、设备测试 bundle / 宿主副本 …，逐路径镜像 src/", _intermediateDir(root));
    string ic = _layoutRel(root, _workMirror(root, "src/compiler"), true);
    e.Add(ic, _layoutName(im, ic), 1, "编译器 workspace 级自举中间物（selfhost-gen1 / seed-run-libs / stdlib-run）", _workMirror(root, "src/compiler"));
    string ix = _layoutRel(root, Path.GetDirectoryName(_xtaskWork(root, "x")), true);
    e.Add(ix, _layoutName(im, ix), 1, "xtask 自检的工作目录", Path.GetDirectoryName(_xtaskWork(root, "x")));
    string xz = _xtaskZpkg(root);
    string xdir = Path.GetDirectoryName(xz);
    string xrel = _layoutRel(root, xdir, true);
    e.Add(xrel, xrel, 0, "xtask 自身（xtask.zpkg）", xdir);
    string sdk = _layoutRel(root, _devSdkDir(root), true);
    e.Add(sdk, sdk, 0, "dev SDK（build sdk）", _devSdkDir(root));
    string pk = _layoutRel(root, _packagesDir(root), true);
    e.Add(pk, pk, 0, "组装好的发行包", _packagesDir(root));
    string ar = _layoutRel(root, _archivesDir(root), true);
    e.Add(ar, _layoutName(pk, ar), 1, "发布归档 + SHA256SUMS + release-index.json", _archivesDir(root));
    string tl = _layoutRel(root, _toolsDir(root), true);
    e.Add(tl, tl, 0, "下载的第三方工具（node / android-sdk / playwright-browsers …）", _toolsDir(root));
    string rp = _layoutRel(root, _reportsDir(root), true);
    e.Add(rp, rp, 0, "给人与 CI 看的结果", _reportsDir(root));
    string rt = _layoutRel(root, _testReportsDir(root), true);
    e.Add(rt, _layoutName(rp, rt), 1, "平台测试 junit：<platform>/junit.xml", _testReportsDir(root));
    string rb = _layoutRel(root, _benchDir(root), true);
    e.Add(rb, _layoutName(rp, rb), 1, "bench 结果 JSON", _benchDir(root));
    string rf = _layoutRel(root, _profileDir(root), true);
    e.Add(rf, _layoutName(rp, rf), 1, "profile 报告：<script>/", _profileDir(root));
    return e;
}

// `xtask layout [path]`：无参 = 打印 artifacts/ 的目录树（首行是 artifacts/ 的绝对路径，其余相对它、按层级缩进）；
// 带参 = 该条目的绝对路径（给 CI / 脚本：`libs=$(xtask layout build/libraries/dist/release)`）。
// 参数就是树里显示的相对路径，尾 / 可有可无。未知 → exit 2 并列出全部路径。
int _layoutCmd(ParseResult r) {
    string root = _root();
    string key = r.GetPositional(0).Replace("\\", "/");
    LayoutEntriesZ e = _layoutEntries(root);
    if (key.Length > 0) {
        string k = key.EndsWith("/") ? key.Substring(0, key.Length - 1) : key;
        int i = 0;
        while (i < e.Count) {
            string rel = e.Rel[i].EndsWith("/") ? e.Rel[i].Substring(0, e.Rel[i].Length - 1) : e.Rel[i];
            if (rel == k) { Console.WriteLine(e.Abs[i]); return 0; }
            i = i + 1;
        }
        ConsoleError.WriteLine("xtask layout: unknown path '" + key + "'. paths:");
        int j = 0;
        while (j < e.Count) { ConsoleError.WriteLine("  " + e.Rel[j]); j = j + 1; }
        return 2;
    }
    Console.WriteLine("artifacts: " + _artifactsDir(root));
    int n = 0;
    while (n < e.Count) {
        string label = "".PadRight(e.Depth[n] * 2) + e.Name[n];
        Console.WriteLine(e.Desc[n].Length > 0 ? label.PadRight(28) + e.Desc[n] : label);
        n = n + 1;
    }
    return 0;
}
