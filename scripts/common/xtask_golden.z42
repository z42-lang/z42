// xtask — shared golden-test infrastructure (unify-scripts-into-xtask, 2026-06-05).
// Generic enumeration/array helpers that the folded test commands (build test / test
// e2e / test dist) all need — defined ONCE here instead of a private
// copy per script. Golden-walk + entry-derivation helpers also live here.
// Same Z42Xtask namespace.
namespace Z42Xtask;

using Std;
using Std.IO;

// Enumerate immediate subdirectories of `dir`, returning sorted basenames.
// Filters Directory.Enumerate results (which can include files) to dirs only.
// Sort enforces cross-OS determinism per common-pitfalls.md §1.
string[] _enumDirsSorted(string dir) {
    if (!Directory.Exists(dir)) { return new string[0]; }
    string[] entries = Directory.Enumerate(dir);
    // First pass: count subdirs
    int n = 0;
    int i = 0;
    while (i < entries.Length) {
        if (Directory.Exists(Path.Join(dir, entries[i]))) { n = n + 1; }
        i = i + 1;
    }
    string[] subs = new string[n];
    int j = 0;
    i = 0;
    while (i < entries.Length) {
        if (Directory.Exists(Path.Join(dir, entries[i]))) {
            subs[j] = entries[i];
            j = j + 1;
        }
        i = i + 1;
    }
    _sortStrings(subs);
    return subs;
}

// In-place insertion sort (deterministic; common-pitfalls.md §1).
void _sortStrings(string[] arr) {
    int i = 1;
    while (i < arr.Length) {
        string key = arr[i];
        int j = i - 1;
        while (j >= 0 && key.CompareTo(arr[j]) < 0) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
        i = i + 1;
    }
}

// Append `v` at index `count`, growing (×2) when the backing array is full.
string[] _append(string[] arr, int count, string v) {
    if (count < arr.Length) {
        arr[count] = v;
        return arr;
    }
    int newCap = arr.Length * 2;
    if (newCap < 4) { newCap = 4; }
    string[] bigger = new string[newCap];
    int i = 0;
    while (i < count) { bigger[i] = arr[i]; i = i + 1; }
    bigger[count] = v;
    return bigger;
}

// ── unified golden-corpus walk (unify-golden-corpus-walk, 2026-09-05) ────────
//
// ONE filesystem traversal of the golden corpus, shared by all four consumers
// (`build test` regen, `test e2e`, `test dist`, `test embedded` / `test list`).
// Before this, each consumer had its own ~100-line copy of the same three-layout
// walk, kept in sync by hand via "mirrors XXX" comments — and they HAD drifted.
//
// The walk is deliberately policy-FREE: it reports every case it finds plus the
// facts a consumer needs to decide (category, sidecars, artifact-mirror
// location, whether the dir holds `[Test]` methods). Inclusion policy stays at
// the four call sites, where the sets differ ON PURPOSE:
//
//   consumer             excluded cats        extra filters
//   build test  (assets) _isNonRegenCat       —
//   test e2e    (vm)     _isNonRunnableCat    _isExcludedDirName · mirror .zbc exists · interp_only
//   test dist            _isNonRunnableCat    _isTestRunnerSource · interp_only
//   test embedded/list   _isNonRunnableCat    _isExcludedDirName
//
// (`_isNonRegenCat` keeps zbc-format / zpkg-format — those ARE regenerated as
// byte baselines — while the three runners drop them: no stdout to diff.)
//
// Segments, emitted in this order (the pre-existing regen / e2e / dist order):
//   "tests-dir"   src/tests/<cat>/<name>/source.z42
//   "lib-dir"     src/libraries/<lib>/tests/<name>/       (golden OR [Test] dir-unit)
//   "tests-flat"  src/tests/<cat>/<name>.z42
//   "lib-file"    src/libraries/<lib>/tests/<name>.z42    (stdlib [Test] file unit)
// Within a segment: category/lib sorted, then case name sorted — determinism per
// common-pitfalls.md §1 (this also replaces the unsorted `Path.Glob` the flat
// walks used to trust).
class _GoldenEntry {
    public string seg;            // tests-dir | lib-dir | tests-flat | lib-file
    public string cat;            // src/tests category, or lib name for lib-*
    public string name;           // case name (dir name / file basename, no ext)
    public string entryName;      // raw directory-entry basename (name, or name + ".z42")
    public string dir;            // dir holding the sidecars (case dir; cat/tests dir when flat)
    public string src;            // source .z42 path (may not exist — see hasSource)
    public string expected;       // expected_output.txt path (dir-mode) / <name>.expected_output.txt (flat)
    public string relUnderSrc;    // path under src/ for _goldenArtifactDir (dir of the .zbc)
    public string zbcName;        // "source.zbc" (dir-mode) / "<name>.zbc" (flat)
    public bool   isLib;          // came from src/libraries/<lib>/tests
    public bool   hasSource;      // src exists on disk
    public bool   interpOnly;     // interp_only sidecar present → no jit run
    public bool   hasTestMethods; // lib-dir only: some .z42 in dir declares [Test]

    public _GoldenEntry() {
        this.seg = ""; this.cat = ""; this.name = ""; this.entryName = "";
        this.dir = ""; this.src = ""; this.expected = ""; this.relUnderSrc = "";
        this.zbcName = ""; this.isLib = false; this.hasSource = false;
        this.interpOnly = false; this.hasTestMethods = false;
    }
}

// Absolute path of this entry's golden .zbc in the artifacts mirror.
string _entryZbc(string root, _GoldenEntry e) {
    return Path.Join(_goldenArtifactDir(root, e.relUnderSrc), e.zbcName);
}

_GoldenEntry[] _appendEntry(_GoldenEntry[] arr, int n, _GoldenEntry v) {
    if (n < arr.Length) { arr[n] = v; return arr; }
    _GoldenEntry[] bigger = new _GoldenEntry[arr.Length * 2 + 8];
    int i = 0;
    while (i < n) { bigger[i] = arr[i]; i = i + 1; }
    bigger[n] = v;
    return bigger;
}

_GoldenEntry[] _walkGoldenCorpus(string root) {
    _GoldenEntry[] es = new _GoldenEntry[512];
    int n = 0;

    string testsRoot = Path.Join(root, "src/tests");
    string[] cats = _enumDirsSorted(testsRoot);
    string libsRoot = Path.Join(root, "src/libraries");
    string[] libs = _enumDirsSorted(libsRoot);

    // 1. src/tests/<cat>/<name>/source.z42
    int ci = 0;
    while (ci < cats.Length) {
        string cat = cats[ci];
        string catDir = Path.Join(testsRoot, cat);
        string[] names = _enumDirsSorted(catDir);
        int ni = 0;
        while (ni < names.Length) {
            string name = names[ni];
            string dir = Path.Join(catDir, name);
            _GoldenEntry e = new _GoldenEntry();
            e.seg = "tests-dir"; e.cat = cat; e.name = name; e.entryName = name;
            e.dir = dir;
            e.src = Path.Join(dir, "source.z42");
            e.expected = Path.Join(dir, "expected_output.txt");
            e.relUnderSrc = Path.Join(Path.Join("tests", cat), name);
            e.zbcName = "source.zbc";
            e.hasSource = File.Exists(e.src);
            e.interpOnly = File.Exists(Path.Join(dir, "interp_only"));
            es = _appendEntry(es, n, e); n = n + 1;
            ni = ni + 1;
        }
        ci = ci + 1;
    }

    // 2. src/libraries/<lib>/tests/<name>/ — golden dirs AND [Test] dir-units.
    int li = 0;
    while (li < libs.Length) {
        string lib = libs[li];
        string tdir = Path.Join(libsRoot, lib + "/tests");
        if (Directory.Exists(tdir)) {
            string[] names = _enumDirsSorted(tdir);
            int ni = 0;
            while (ni < names.Length) {
                string name = names[ni];
                string dir = Path.Join(tdir, name);
                _GoldenEntry e = new _GoldenEntry();
                e.seg = "lib-dir"; e.cat = lib; e.name = name; e.entryName = name;
                e.dir = dir; e.isLib = true;
                e.src = Path.Join(dir, "source.z42");
                e.expected = Path.Join(dir, "expected_output.txt");
                e.relUnderSrc = Path.Join(Path.Join(Path.Join("libraries", lib), "tests"), name);
                e.zbcName = "source.zbc";
                e.hasSource = File.Exists(e.src);
                e.interpOnly = File.Exists(Path.Join(dir, "interp_only"));
                e.hasTestMethods = _dirHasTestMethods(dir);
                es = _appendEntry(es, n, e); n = n + 1;
                ni = ni + 1;
            }
        }
        li = li + 1;
    }

    // 3. src/tests/<cat>/<name>.z42 (flat mode; sidecars are <name>.<sidecar>)
    ci = 0;
    while (ci < cats.Length) {
        string cat = cats[ci];
        string catDir = Path.Join(testsRoot, cat);
        string[] entries = _sortedStrings(Directory.Enumerate(catDir));
        int ei = 0;
        while (ei < entries.Length) {
            string f = entries[ei];
            if (f.EndsWith(".z42")) {
                string name = f.Substring(0, f.Length - 4);
                _GoldenEntry e = new _GoldenEntry();
                e.seg = "tests-flat"; e.cat = cat; e.name = name; e.entryName = f;
                e.dir = catDir;
                e.src = Path.Join(catDir, f);
                e.expected = Path.Join(catDir, name + ".expected_output.txt");
                e.relUnderSrc = Path.Join("tests", cat);
                e.zbcName = name + ".zbc";
                e.hasSource = File.Exists(e.src);
                e.interpOnly = File.Exists(Path.Join(catDir, name + ".interp_only"));
                es = _appendEntry(es, n, e); n = n + 1;
            }
            ei = ei + 1;
        }
        ci = ci + 1;
    }

    // 4. src/libraries/<lib>/tests/<name>.z42 — stdlib [Test] file units.
    li = 0;
    while (li < libs.Length) {
        string lib = libs[li];
        string tdir = Path.Join(libsRoot, lib + "/tests");
        if (Directory.Exists(tdir)) {
            string[] entries = _sortedStrings(Directory.Enumerate(tdir));
            int ei = 0;
            while (ei < entries.Length) {
                string f = entries[ei];
                if (f.EndsWith(".z42")) {
                    string name = f.Substring(0, f.Length - 4);
                    _GoldenEntry e = new _GoldenEntry();
                    e.seg = "lib-file"; e.cat = lib; e.name = name; e.entryName = f;
                    e.dir = tdir; e.isLib = true;
                    e.src = Path.Join(tdir, f);
                    e.hasSource = true;
                    es = _appendEntry(es, n, e); n = n + 1;
                }
                ei = ei + 1;
            }
        }
        li = li + 1;
    }

    _GoldenEntry[] tight = new _GoldenEntry[n];
    int t = 0;
    while (t < n) { tight[t] = es[t]; t = t + 1; }
    return tight;
}

// ── golden-walk exclusions (added by test-vm fold) ───────────────────────────

// Categories whose golden is NOT "run z42vm and diff stdout": cross-zpkg and
// multi-exe are multi-package / multi-target project e2e runs handled by their
// own runners; zbc-format / zpkg-format are byte-format goldens (no stdout).
// Deliberately NOT the same set as regen's _isNonRegenCat, which KEEPS the two
// format categories (they are the byte baselines it exists to refresh).
bool _isNonRunnableCat(string cat) {
    return cat == "cross-zpkg" || cat == "multi-exe" || cat == "zbc-format" || cat == "zpkg-format"
        || cat == "manifest-targets";
}

// ── golden-zbc artifact mirror (mirror-build-output-per-component, 2026-06-16) ─
//
// Run-golden compiled `.zbc` is build output, not source — it lives under
// `artifacts/build/` mirroring the src layout *per component* (same convention
// stdlib/z42c package builds already use: `artifacts/build/libraries/<lib>`,
// `artifacts/build/compiler/<member>`), NOT beside `source.z42`:
//   src/tests/<rel>            → artifacts/build/tests/<rel>
//   src/libraries/<lib>/<rel>  → artifacts/build/libraries/<lib>/<rel>
// i.e. strip the leading `src/` and re-root under `artifacts/build/`. regen
// writes here; the `test e2e` golden runner + Rust `zbc_compat` read here.
//
// ONE exception (handled by the caller, not this helper): the byte-baseline
// goldens under `src/tests/zbc-format/` are checked in and regen overwrites them
// in place so `git diff` flags real format drift — regen special-cases that cat.
//
// `relUnderSrc` is the case dir relative to `src/` (e.g. `"tests/basic/hello"`
// or `"libraries/z42.math/tests/math"`); returns the absolute mirror dir.
string _goldenArtifactDir(string root, string relUnderSrc) {
    return Path.Join(root, Path.Join("artifacts/build", relUnderSrc));
}

// Pre-existing known-deferred cases (cross-zpkg static-init bug).
bool _isExcludedDirName(string cat, string name) {
    if (cat == "gc" && name == "composite_ref_weak_mode") return true;
    if (cat == "delegates" && name == "multicast_subscription_refs") return true;
    return false;
}

// ── entry-name derivation (added by test-vm fold) ────────────────────────────

// Mirror bash derive_entry: priority `<ns>.Main > Main > <ns>.main > main`.
string _deriveEntry(string srcFile) {
    if (!File.Exists(srcFile)) return "Main";
    string content = File.ReadAllText(srcFile);
    string ns = _extractNamespace(content);
    bool hasUpper = _hasMain(content, "Main");
    bool hasLower = _hasMain(content, "main");
    string fnName = "Main";
    if (hasUpper) { fnName = "Main"; }
    else if (hasLower) { fnName = "main"; }
    if (ns.Length > 0) { return ns + "." + fnName; }
    return fnName;
}

// Find first `namespace <Identifier>;` line; return the identifier (or "").
string _extractNamespace(string content) {
    int i = 0;
    while (i < content.Length) {
        // Skip leading whitespace on a line.
        int lineStart = i;
        while (i < content.Length && (content.CharAt(i) == ' ' || content.CharAt(i) == '\t')) { i = i + 1; }
        // Check for "namespace ".
        if (i + 10 <= content.Length
                && content.Substring(i, 10) == "namespace "
                && _isWordEnd(content, i + 9)) {
            int n = i + 10;
            // Skip whitespace.
            while (n < content.Length && (content.CharAt(n) == ' ' || content.CharAt(n) == '\t')) { n = n + 1; }
            int idStart = n;
            while (n < content.Length && _isIdentChar(content.CharAt(n))) { n = n + 1; }
            if (n > idStart) {
                return content.Substring(idStart, n - idStart);
            }
        }
        // Advance to next line.
        while (i < content.Length && content.CharAt(i) != '\n') { i = i + 1; }
        if (i < content.Length) { i = i + 1; }
    }
    return "";
}

bool _isWordEnd(string s, int i) {
    if (i >= s.Length) return true;
    char c = s.CharAt(i);
    return c == ' ' || c == '\t';
}

bool _isIdentChar(char c) {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
        || (c >= '0' && c <= '9') || c == '_' || c == '.';
}

// Bash: `grep -c '\bvoid\s+<name>\s*('` — count > 0 means found.
bool _hasMain(string content, string name) {
    int i = 0;
    while (i < content.Length) {
        int idx = _indexOfFrom(content, "void", i);
        if (idx < 0) return false;
        // Require `\b` before void (start of string or non-ident).
        if (idx > 0 && _isIdentChar(content.CharAt(idx - 1))) {
            i = idx + 1;
            continue;
        }
        int p = idx + 4;
        // Require whitespace after "void".
        if (p >= content.Length
            || (content.CharAt(p) != ' ' && content.CharAt(p) != '\t')) {
            i = idx + 1;
            continue;
        }
        while (p < content.Length
            && (content.CharAt(p) == ' ' || content.CharAt(p) == '\t')) { p = p + 1; }
        // Check name (case-sensitive).
        if (p + name.Length > content.Length
            || content.Substring(p, name.Length) != name) {
            i = idx + 1;
            continue;
        }
        int after = p + name.Length;
        // Boundary after name + optional whitespace + '('.
        if (after < content.Length && _isIdentChar(content.CharAt(after))) {
            i = idx + 1;
            continue;
        }
        int q = after;
        while (q < content.Length
            && (content.CharAt(q) == ' ' || content.CharAt(q) == '\t')) { q = q + 1; }
        if (q < content.Length && content.CharAt(q) == '(') {
            return true;
        }
        i = idx + 1;
    }
    return false;
}

int _indexOfFrom(string s, string needle, int start) {
    int n = needle.Length;
    int limit = s.Length - n;
    int i = start;
    while (i <= limit) {
        if (s.Substring(i, n) == needle) return i;
        i = i + 1;
    }
    return -1;
}

// ── string helpers (added by test-vm fold) ───────────────────────────────────

string _firstLine(string s) {
    int i = 0;
    while (i < s.Length && s.CharAt(i) != '\n') { i = i + 1; }
    return s.Substring(0, i);
}

// _splitWords moved to xtask_common.z42 (shared string/collection helpers).

string _stripTrailingNewlines(string s) {
    int end = s.Length;
    while (end > 0 && (s.CharAt(end - 1) == '\n' || s.CharAt(end - 1) == '\r')) {
        end = end - 1;
    }
    if (end == s.Length) return s;
    return s.Substring(0, end);
}
