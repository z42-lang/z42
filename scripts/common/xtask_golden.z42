// xtask — shared golden-test infrastructure: enumeration/array helpers, the golden-corpus
// walk, the golden .zbc artifact mirror, and entry-name derivation.
namespace Z42Xtask;

using Std.Collections;
using Std.IO;

// Enumerate immediate subdirectories of `dir`, returning sorted basenames.
// Filters Directory.Enumerate results (which can include files) to dirs only.
// Sort enforces cross-OS determinism per the load-order determinism rule.
string[] _enumDirsSorted(string dir) {
    if (!Directory.Exists(dir)) { return new string[0]; }
    List<string> subs = new List<string>();
    foreach (var e in Directory.Enumerate(dir)) {
        if (Directory.Exists(Path.Join(dir, e))) { subs.Add(e); }
    }
    string[] arr = subs.ToArray();
    _sortStrings(arr);
    return arr;
}

// In-place insertion sort (deterministic; load-order determinism rule).
void _sortStrings(string[] arr) {
    int i = 1;
    while (i < arr.Length) {
        string key = arr[i];
        int j = i - 1;
        while (j >= 0 && key.CompareTo(arr[j]) < 0) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
        i = i + 1;
    }
}

// ── unified golden-corpus walk ───────────────────────────────────────────────
//
// ONE filesystem traversal of the golden corpus, shared by every consumer
// (`build test` regen, `test e2e`, `package sdk --verify`, `test app desktop` / `test list`)
// so the layouts cannot drift between hand-kept copies.
//
// The walk is deliberately policy-FREE: it reports every case it finds plus the
// facts a consumer needs to decide (category, sidecars, artifact-mirror
// location, whether the dir holds `[Test]` methods). Inclusion policy (excluded
// categories / dirs, interp_only, mirror .zbc presence) stays at the call sites,
// where the sets differ ON PURPOSE.
//
// Every src/tests category is a runnable language golden (test-layout.md). The
// wire-format byte baselines live in z42.package's tests/fixtures/ and are only
// regenerated, never run — `build test` appends them itself (_formatZbcFixtureCases).
//
// Segments, emitted in this order:
//   "tests-dir"   src/tests/<cat>/<name>/source.z42
//   "lib-dir"     src/libraries/<lib>/tests/<name>/       (golden OR [Test] dir-unit)
//   "tests-flat"  src/tests/<cat>/<name>.z42
//   "lib-file"    src/libraries/<lib>/tests/<name>.z42    (stdlib [Test] file unit)
// Within a segment: category/lib sorted, then case name sorted (load-order
// determinism rule).
class _GoldenEntry {
    public string seg;            // tests-dir | lib-dir | tests-flat | lib-file
    public string cat;            // src/tests category, or lib name for lib-*
    public string name;           // case name (dir name / file basename, no ext)
    public string entryName;      // raw directory-entry basename (name, or name + ".z42")
    public string dir;            // dir holding the sidecars (case dir; cat/tests dir when flat)
    public string src;            // source .z42 path (may not exist — see hasSource)
    public string expected;       // expected_output.txt path (dir-mode) / <name>.expected_output.txt (flat)
    public string relUnderSrc;    // path under src/ for _goldenArtifactDir (dir of the .zbc)
    public string zbcName;        // "source.zbc" (dir-mode) / "<name>.zbc" (flat)
    public bool   isLib;          // came from src/libraries/<lib>/tests
    public bool   hasSource;      // src exists on disk
    public bool   interpOnly;     // interp_only sidecar present → no jit run
    public bool   optAll;         // opt_all sidecar present → 用 `--emit-zbc --opt-all` 按 release 全优化编
                                  //（逃逸分析等 pass 在 emit-zbc 默认集里是关的）
    public bool   hasTestMethods; // lib-dir only: some .z42 in dir declares [Test]

    public _GoldenEntry() {
        this.seg = ""; this.cat = ""; this.name = ""; this.entryName = "";
        this.dir = ""; this.src = ""; this.expected = ""; this.relUnderSrc = "";
        this.zbcName = ""; this.isLib = false; this.hasSource = false;
        this.interpOnly = false; this.optAll = false; this.hasTestMethods = false;
    }
}

// Absolute path of this entry's golden .zbc in the artifacts mirror.
string _entryZbc(string root, _GoldenEntry e) {
    return Path.Join(_goldenArtifactDir(root, e.relUnderSrc), e.zbcName);
}

_GoldenEntry[] _walkGoldenCorpus(string root) {
    List<_GoldenEntry> es = new List<_GoldenEntry>();
    string testsRoot = Path.Join(root, "src/tests");
    string[] cats = _enumDirsSorted(testsRoot);
    string libsRoot = Path.Join(root, "src/libraries");
    string[] libs = _enumDirsSorted(libsRoot);

    // 1. src/tests/<cat>/<name>/source.z42
    foreach (var cat in cats) {
        string catDir = Path.Join(testsRoot, cat);
        foreach (var name in _enumDirsSorted(catDir)) {
            es.Add(_goldenDirEntry("tests-dir", cat, name, Path.Join(catDir, name),
                Path.Join(Path.Join("tests", cat), name), false));
        }
    }

    // 2. src/libraries/<lib>/tests/<name>/ — golden dirs AND [Test] dir-units.
    foreach (var lib in libs) {
        string tdir = Path.Join(libsRoot, lib + "/tests");
        foreach (var name in _enumDirsSorted(tdir)) {
            es.Add(_goldenDirEntry("lib-dir", lib, name, Path.Join(tdir, name),
                Path.Join(Path.Join(Path.Join("libraries", lib), "tests"), name), true));
        }
    }

    // 3. src/tests/<cat>/<name>.z42 (flat mode; sidecars are <name>.<sidecar>)
    foreach (var cat in cats) {
        string catDir = Path.Join(testsRoot, cat);
        foreach (var f in _z42FilesSorted(catDir)) {
            string name = f.Substring(0, f.Length - 4);
            _GoldenEntry e = _newGoldenEntry("tests-flat", cat, name, f, catDir, false);
            e.src = Path.Join(catDir, f);
            e.expected = Path.Join(catDir, name + ".expected_output.txt");
            e.relUnderSrc = Path.Join("tests", cat);
            e.zbcName = name + ".zbc";
            e.hasSource = File.Exists(e.src);
            e.interpOnly = File.Exists(Path.Join(catDir, name + ".interp_only"));
            e.optAll     = File.Exists(Path.Join(catDir, name + ".opt_all"));
            es.Add(e);
        }
    }

    // 4. src/libraries/<lib>/tests/<name>.z42 — stdlib [Test] file units.
    foreach (var lib in libs) {
        string tdir = Path.Join(libsRoot, lib + "/tests");
        if (!Directory.Exists(tdir)) { continue; }
        foreach (var f in _z42FilesSorted(tdir)) {
            _GoldenEntry e = _newGoldenEntry("lib-file", lib, f.Substring(0, f.Length - 4), f, tdir, true);
            e.src = Path.Join(tdir, f);
            e.hasSource = true;
            es.Add(e);
        }
    }
    return es.ToArray();
}

_GoldenEntry _newGoldenEntry(string seg, string cat, string name, string entryName, string dir, bool isLib) {
    _GoldenEntry e = new _GoldenEntry();
    e.seg = seg; e.cat = cat; e.name = name; e.entryName = entryName; e.dir = dir; e.isLib = isLib;
    return e;
}

// Dir-mode case (tests-dir / lib-dir): source + sidecars live in the case dir.
_GoldenEntry _goldenDirEntry(string seg, string cat, string name, string dir, string relUnderSrc, bool isLib) {
    _GoldenEntry e = _newGoldenEntry(seg, cat, name, name, dir, isLib);
    e.src = Path.Join(dir, "source.z42");
    e.expected = Path.Join(dir, "expected_output.txt");
    e.relUnderSrc = relUnderSrc;
    e.zbcName = "source.zbc";
    e.hasSource = File.Exists(e.src);
    e.interpOnly = File.Exists(Path.Join(dir, "interp_only"));
    e.optAll     = File.Exists(Path.Join(dir, "opt_all"));
    if (isLib) { e.hasTestMethods = _dirHasTestMethods(dir); }
    return e;
}

// `*.z42` entry names directly in `dir`, sorted.
string[] _z42FilesSorted(string dir) {
    List<string> fs = new List<string>();
    foreach (var f in _sortedStrings(Directory.Enumerate(dir))) { if (f.EndsWith(".z42")) { fs.Add(f); } }
    return fs.ToArray();
}

// ── golden-zbc artifact mirror ───────────────────────────────────────────────
//
// Run-golden compiled `.zbc` is build output, not source — it lives under
// `artifacts/build/` mirroring the src layout, NOT beside `source.z42`:
//   src/tests/<rel>                  → artifacts/build/tests/<rel>
//   src/libraries/<lib>/<rel>        → artifacts/build/libraries/<lib>/release/<rel>
// A workspace member's goldens sit under its `release/` profile dir, next to its `dist/` / `cache/`
// (artifacts-layout.md §2: inside a member, everything is per profile, like `build/runtime/<profile>/`;
// goldens are compiled by the release driver). `src/tests` has no owner package, so no profile layer.
// regen writes here; the `test e2e` golden runner + Rust `zbc_compat` read here.
//
// Not routed through here: the wire-format byte baselines under
// `src/compiler/z42.package/tests/fixtures/zbc-format/` are checked in and regen
// overwrites them in place so `git diff` flags real format drift
// (_formatZbcFixtureCases).
//
// `relUnderSrc` is the case dir relative to `src/` (e.g. `"tests/basic/hello"`
// or `"libraries/z42.math/tests/math"`); returns the absolute mirror dir.
string _goldenArtifactDir(string root, string relUnderSrc) {
    string[] segs = relUnderSrc.Replace("\\", "/").Split("/");
    if (segs.Length > 2 && (segs[0] == "libraries" || segs[0] == "compiler")) {
        string[] rest = new string[segs.Length - 2];
        Array.Copy(segs, 2, rest, 0, rest.Length);
        return Path.Join(Path.Join(Path.Join(Path.Join(_buildDir(root), segs[0]), segs[1]), "release"),
            String.Join("/", rest));
    }
    return Path.Join(_buildDir(root), relUnderSrc);
}

// Pre-existing known-deferred cases (cross-zpkg static-init bug).
bool _isExcludedDirName(string cat, string name) {
    if (cat == "gc" && name == "composite_ref_weak_mode") return true;
    if (cat == "delegates" && name == "multicast_subscription_refs") return true;
    return false;
}

// ── entry-name derivation ────────────────────────────────────────────────────

// Entry priority: `<ns>.Main > Main > <ns>.main > main`.
string _deriveEntry(string srcFile) {
    if (!File.Exists(srcFile)) return "Main";
    string content = File.ReadAllText(srcFile);
    string ns = _extractNamespace(content);
    string fnName = (!_hasMain(content, "Main") && _hasMain(content, "main")) ? "main" : "Main";
    return ns.Length > 0 ? ns + "." + fnName : fnName;
}

// Find first `namespace <Identifier>;` line; return the identifier (or "").
string _extractNamespace(string content) {
    int i = 0;
    while (i < content.Length) {
        // Skip leading whitespace on a line.
        int lineStart = i;
        while (i < content.Length && (content.CharAt(i) == ' ' || content.CharAt(i) == '\t')) { i = i + 1; }
        // Check for "namespace ".
        if (i + 10 <= content.Length
                && content.Substring(i, 10) == "namespace "
                && _isWordEnd(content, i + 9)) {
            int n = i + 10;
            // Skip whitespace.
            while (n < content.Length && (content.CharAt(n) == ' ' || content.CharAt(n) == '\t')) { n = n + 1; }
            int idStart = n;
            while (n < content.Length && (_isIdentChar(content.CharAt(n)) || content.CharAt(n) == '.')) { n = n + 1; }
            if (n > idStart) {
                return content.Substring(idStart, n - idStart);
            }
        }
        // Advance to next line.
        while (i < content.Length && content.CharAt(i) != '\n') { i = i + 1; }
        if (i < content.Length) { i = i + 1; }
    }
    return "";
}

bool _isWordEnd(string s, int i) {
    if (i >= s.Length) return true;
    char c = s.CharAt(i);
    return c == ' ' || c == '\t';
}

// True when the source has `\bvoid\s+<name>\s*(`.
bool _hasMain(string content, string name) {
    int i = 0;
    while (i < content.Length) {
        int idx = _indexOfFrom(content, "void", i);
        if (idx < 0) return false;
        // Require `\b` before void (start of string or non-ident).
        if (idx > 0 && _isIdentChar(content.CharAt(idx - 1))) {
            i = idx + 1;
            continue;
        }
        int p = idx + 4;
        // Require whitespace after "void".
        if (p >= content.Length
            || (content.CharAt(p) != ' ' && content.CharAt(p) != '\t')) {
            i = idx + 1;
            continue;
        }
        while (p < content.Length
            && (content.CharAt(p) == ' ' || content.CharAt(p) == '\t')) { p = p + 1; }
        // Check name (case-sensitive).
        if (p + name.Length > content.Length
            || content.Substring(p, name.Length) != name) {
            i = idx + 1;
            continue;
        }
        int after = p + name.Length;
        // Boundary after name + optional whitespace + '('.
        if (after < content.Length && _isIdentChar(content.CharAt(after))) {
            i = idx + 1;
            continue;
        }
        int q = after;
        while (q < content.Length
            && (content.CharAt(q) == ' ' || content.CharAt(q) == '\t')) { q = q + 1; }
        if (q < content.Length && content.CharAt(q) == '(') {
            return true;
        }
        i = idx + 1;
    }
    return false;
}

int _indexOfFrom(string s, string needle, int start) {
    int n = needle.Length;
    int limit = s.Length - n;
    int i = start;
    while (i <= limit) {
        if (s.Substring(i, n) == needle) return i;
        i = i + 1;
    }
    return -1;
}

// ── string helpers ───────────────────────────────────────────────────────────

string _firstLine(string s) {
    int nl = s.IndexOf('\n');
    return nl < 0 ? s : s.Substring(0, nl);
}

string _stripTrailingNewlines(string s) {
    int end = s.Length;
    while (end > 0 && (s.CharAt(end - 1) == '\n' || s.CharAt(end - 1) == '\r')) {
        end = end - 1;
    }
    if (end == s.Length) return s;
    return s.Substring(0, end);
}
