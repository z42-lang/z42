// xtask — 文件系统原语（scripts-batch3-layering, 2026-09-06）。
//
// 这些是**不属于任何命令族**、被 common/ build/ test/ package/ 多方共用的最底层
// 操作。此前它们散落在各命令族的实现文件里，造成三条反向依赖：
//
//   common/xtask_common.z42  ──_copyAll──►  build/xtask_compiler.z42   ❌ 底层反调上层
//   build/xtask_stdlib.z42   ──_makeExe─►  package/xtask_package.z42  ❌ 平级族互调
//   package/xtask_release.z42──_resetDir►  build/xtask_compiler.z42   ❌ 平级族互调
//
// 收拢到 common/ 后依赖只剩一个方向：**build / test / package / install 各族 → common/**，
// 族与族之间不再互相 include。namespace 扁平 + 裸名互调，所以「谁定义」纯粹是可读性
// 问题——但恰恰因为编译器不会拦，反向依赖只能靠这条约定守住。规则见 scripts/README.md
// 「目录分层」一节。
//
// 刻意**没有**收进来的（判据：只有一个文件用，或语义属于某个族而非通用原语）：
//   - `_copyIfNewer`（build/xtask_compiler.z42）—— 只在同文件用；
//   - `_stageCopyExt`（build/xtask_stdlib.z42）—— 只在同文件用，且**故意不吞异常**
//     （staging CI artifact，拷贝失败必须炸而非静默产出残包），与下面 best-effort 的
//     `_copyAll` 语义相反，不能合并；
//   - `_rmIfExists`（build/xtask_clean.z42）—— 只在同文件用；
//   - `_pkgCopyLibs` / `_copyNativeLibs`（package/xtask_package.z42）—— 不是原语：带
//     `<dir>/libs` `<dir>/native` 的**布局语义** + 报错文案 + 返回码，只在 package/ 内用
//     （含 `package dev-sdk`）。
namespace Z42Xtask;

using Std.IO;

// reset 一个私有目录（删后建）。
void _resetDir(string d) {
    if (Directory.Exists(d)) { Directory.Delete(d, true); }
    Directory.Create(d);
}

// ── 写入前先断链：拷贝永不「穿透」硬链接 ──────────────────────────────────────
//
// 🔴 `File.Copy` / `File.WriteAllBytes` 都是 **truncate 语义、保留 inode**。于是往一个
// **硬链接**上写，会把同 inode 的**所有**路径一起改掉 —— 包括那个你没打算碰的源文件。
//
// 这不是理论风险，`_assembleStdlibFlatView` 今天就在造这种别名（flat 里每个 zpkg 与
// 对应成员 dist 同 inode，实测 `links=2`）。实测（2026-09-28，临时目录）：
//   member/p.zpkg ← 硬链接 → flat/p.zpkg，然后 `cp seed.zpkg flat/p.zpkg`
//   ⇒ **member/p.zpkg 的内容当场变成 seed 的字节**。
// 可达路径就在供种里：`_ensureSeed` 的 `_copyAll(stdlibDir, flatDir, "z42.*.zpkg")`
// 把种子 stdlib 拷进 flat ⇒ 成员 dist 被静默改写成种子字节；而它**只拷 zpkg、不拷 zsym**
// ⇒ 留下 zpkg 新、zsym 旧的**撕开的配对** —— 那正是 relocate-compiler-domain-libs 第 6 轮
// 「一条 `build_id mismatch` WARN 让 1128 个 golden 假红」的同一个机制。
//
// ⇒ 两个函数写入前都先 `File.Delete(dst)`：unlink 只断这一条链、不动别名的其它路径，
// 之后 `File.Copy` 建的是**新文件**。代价是每文件多一次 unlink，换掉整类「改了 A 结果 B
// 也变了」的隐形耦合。**不去掉 `_linkAll` 的硬链接本身** —— 它省的是真金白银（cross-zpkg
// 一轮 ≈198MB 纯拷贝），有害的是「写到别名上」，不是「有别名」。
void _unlinkIfExists(string path) {
    if (File.Exists(path)) { try { File.Delete(path); } catch (Exception e) { /* best-effort */ } }
}

// 把 path 换成内容相同的**独立 inode**（硬链接别名从此不再共享写入）。之后就地写它不会穿透到别的
// 链接名上——z42c 写产物是就地写，往 hard-link 视图（stdlib flat）里写之前要先过这一步。
void _breakHardLink(string path) {
    if (!File.Exists(path)) { return; }
    // 原子写 = 临时文件 + rename 覆盖目录项：新 inode 换上，别名仍指向旧 inode；中途失败原文件不动。
    try { File.WriteAllBytesAtomic(path, File.ReadAllBytes(path)); }
    catch (Exception e) { /* best-effort：失败即保持原状 */ }
}

// 字节比较。两族共用（test 族的增量对账 / build 族的 `_assertStdlibNotShadowed`）⇒ 按头注
// 的判据（不止一个文件用 + 是通用原语）收在这里。
bool _bytesEqual(byte[] a, byte[] b) {
    if (a.Length != b.Length) { return false; }
    int i = 0;
    while (i < a.Length) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}

// COPY（非 hard-link）srcDir 下匹配文件到 dstDir。私有目录 + 拷贝避免 _linkAll
// 的 hard-link inode 别名污染（共享目录被 rebuild 会把 per-member 源弄坏）。
void _copyAll(string srcDir, string dstDir, string pattern) {
    if (!Directory.Exists(srcDir)) { return; }
    string[] hits = Path.Glob(srcDir, pattern);
    int i = 0;
    while (i < hits.Length) {
        string dstPath = Path.Join(dstDir, Path.GetFileName(hits[i]));
        // Guard self-copy: File.Copy(X, X) opens the dest for write FIRST (truncating
        // X to 0) then reads the now-empty source → silently zeroes the file. Reachable
        // when a caller's src and dst resolve to the same dir (e.g. _ensureSeed staging
        // stdlib while Z42_LIBS already points at the flat dist). Skip it.
        if (hits[i] != dstPath) {
            _unlinkIfExists(dstPath);   // 先断链（见本段头注）：别写到别人的 inode 上
            try { File.Copy(hits[i], dstPath); }
            catch (Exception e) { /* skip */ }
        }
        i = i + 1;
    }
}

// Hard-link srcDir's matches into flatDir; fall back to Copy across filesystems
// (mirrors bash `cp -l ... || cp`).
void _linkAll(string srcDir, string flatDir, string pattern) {
    if (!Directory.Exists(srcDir)) { return; }
    string[] hits = Path.Glob(srcDir, pattern);
    int i = 0;
    while (i < hits.Length) {
        string dst = Path.Join(flatDir, Path.GetFileName(hits[i]));
        if (hits[i] == dst) { i = i + 1; continue; }   // 自链接：断了就没得链了
        // dst 已存在时 `File.Link` 本就会失败并**退回 File.Copy** —— 那次 copy 同样会穿透。
        // 先断链让「link 成功」成为常态路径，copy 兜底也不再写到别名上。
        _unlinkIfExists(dst);
        try { File.Link(hits[i], dst); }
        catch (Exception e) {
            try { File.Copy(hits[i], dst); } catch (Exception e2) { /* skip */ }
        }
        i = i + 1;
    }
}

void _cleanGlob(string dir, string pattern) {
    string[] hits = Path.Glob(dir, pattern);
    int i = 0;
    while (i < hits.Length) {
        try { File.Delete(hits[i]); } catch (Exception e) { /* best-effort */ }
        i = i + 1;
    }
}

void _copyIfExists(string src, string dst) {
    if (File.Exists(src)) { File.Copy(src, dst); }
}

void _makeExe(string path) {
    if (File.Exists(path)) { File.MakeExecutable(path); }
}

// ── 测试夹具「拷出去再编」（isolate-xtask-fixture-builds）────────────────────────
//
// 夹具工程（`<组件>/tests/fixtures/<suite>/**`）没有 `[build]`，z42c 按单工程默认布局把 dist /
// cache / generated 写在**工程目录旁边**；xtask 还在旁边建 `libs/` 中转目录。结果是每跑一轮
// e2e，源码树里就多出几百个产物目录（实测 ~670）。
//
// 做法：每轮把整棵夹具源码树拷到它在 `artifacts/intermediate/` 下的镜像位置（`_workMirror`，先整棵重置），
// 之后的构建 / 运行全部在
// 拷贝里进行。好处不只是源码树干净：
//   · 每轮从零开始 —— 彻底消掉「上一轮留在源码树里的旧格式 zpkg 赢过本轮产物」这一整类假红
//     （2026-09-27 实测 52 个 cross-zpkg 失败，见 `_spawnBuildPkgE` 的头注）；
//   · 对任何 z42c（含种子）都有效，不依赖 z42c 的 `--output-dir` 是否接管 cache。
// 拷贝时跳过 `artifacts/` / `dist/`（旧工作树里的残留），其余原样（夹具间的相对 path 依赖不变）。
string _stageFixtureTree(string root, string srcRel) {
    string dst = _workMirror(root, srcRel);
    _resetDir(dst);
    _copySourceTree(Path.Join(root, srcRel), dst);
    return dst;
}

void _copySourceTree(string src, string dst) {
    Directory.Create(dst);
    foreach (var name in _sortedStrings(Directory.Enumerate(src))) {
        string s = Path.Join(src, name);
        string d = Path.Join(dst, name);
        if (Directory.Exists(s)) {
            if (name != "artifacts" && name != "dist") { _copySourceTree(s, d); }
        } else {
            File.Copy(s, d);
        }
    }
}
