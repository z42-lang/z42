// xtask CLI layer (migrate-xtask-launcher-to-std-cli).
//
// Builds the Std.Cli nested SubcommandRouter for xtask and dispatches a
// resolved command to its handler. Replaces the former hand-written
// if-else chains in xtask.z42 (Main / _build / _test / _deps). Each leaf
// declares its flags/options/positionals via ArgParser, so `-h` works at
// every level and help text is generated (no hand-written _help()).
//
// `test`, `setup` and `bench` carry a default action (no subcommand = full gate /
// install / e2e) via SubcommandRouter.SetDefault; `--toolchain` / `--verbosity` are
// root persistent options (accepted before or after the subcommand).
//
// This file is the CLI **core** only: global options, the root tree, the top-level _dispatch fan-out, and their helpers. Each
// command FAMILY's router + dispatch pair lives beside its siblings in
// scripts/cli/xtask_cli_<family>.z42 (split-xtask-cli) — the pairs
// are mutually zero-coupled, so keeping them here only made this file long.
// Adding a command family = add a file there + one AddRouter line in _cliRoot
// + one line in _dispatch.
namespace Z42Xtask;

using Std.IO;
using Std.Cli;

// ── entry: the whole Main body (resolve + dispatch) → exit code ──────────────

int _runCli(string[] argv) {
    SubcommandRouter root = _cliRoot();
    try {
        // `run` forwards everything after it verbatim to the launcher (its own options and
        // `--` app tail included), so only the prefix up to `run` goes through the router.
        int ri = _indexOf(argv, "run");
        if (ri >= 0) {
            CommandResolution pre = root.Resolve(_slice(argv, 0, ri + 1));
            if (pre.IsMatch() && pre.Path().Length == 1 && pre.Path()[0] == "run") {
                _applyGlobals(pre);
                return _run(_slice(argv, ri + 1, argv.Length));
            }
        }
        // A leaf ArgParser raises CliException on unknown flag / missing value /
        // bad positional count — surface it cleanly (Resolve only routes; it does
        // not swallow option-level errors).
        CommandResolution res = root.Resolve(argv);
        _applyGlobals(res);
        if (res.IsHelp()) {
            Console.WriteLine(res.HelpText());
            return 0;
        }
        if (res.IsUnknown()) {
            ConsoleError.WriteLine(res.ErrorMessage());
            Console.WriteLine(res.HelpText());
            return 2;
        }
        return _dispatch(res);
    } catch (CliException e) {
        ConsoleError.WriteLine("xtask: " + e.Message);
        return 2;
    }
}

// Global options → process env, inherited by every child: --toolchain sets Z42_HOME (the
// single "SDK root"; every locator redirects to that `.z42`); --verbosity sets Z42_VERBOSITY
// (read by _verbosity). An invalid level is a usage error.
void _applyGlobals(CommandResolution res) {
    string tc = res.PersistentOption("toolchain");
    if (tc.Length > 0) { Environment.SetEnvironmentVariable("Z42_HOME", tc); }
    string v = res.PersistentOption("verbosity");
    if (v.Length == 0) { return; }
    int lvl = _normVerbosity(v);
    if (lvl < 0) {
        throw new CliException("invalid --verbosity '" + v
            + "' (use q[uiet] | m[inimal] | n[ormal] | d[etailed] | diag[nostic])");
    }
    Environment.SetEnvironmentVariable("Z42_VERBOSITY", _verbName(lvl));
}

// ── root tree ────────────────────────────────────────────────────────────────

SubcommandRouter _cliRoot() {
    SubcommandRouter root = new SubcommandRouter("xtask", "z42 repo dev CLI");
    root.AddPersistentOption("toolchain", "", "use a .z42 SDK layout (programs/z42c + libs + bin)", "");
    root.AddPersistentOption("verbosity", "v", "q[uiet] | m[inimal] (default) | n[ormal] | d[etailed] | diag[nostic]", "");

    root.AddRouter("build", "build components", _buildRouter());

    root.AddRouter("package", "assemble from built artifacts (sdk / runtime / workload [--archive] · dev-sdk · ci · release)", _packageRouter());

    root.AddRouter("test", "run tests (no subcommand = full GREEN gate)", _testRouter());
    root.Add("check", "static checks — no build, no test run (diagcodes / versions / docs-api …; no name = all)", _checkParser());
    root.AddRouter("setup", "prepare this machine (no subcommand = install; vscode / check)", _setupRouter());
    root.AddRouter("bench", "benchmarks (no subcommand = e2e)", _benchRouter());
    root.AddRouter("doc", "generate reference stdlib pages and index Rust crates (gen / index)", _docRouter());

    // plan-script-profiling P0: profile one .z42 script across four dimensions
    // (native CPU/heap via samply/dhat + hyperfine wall-clock + peak-RSS +
    // counter摘要). No dimension flag = all four → report.md. See xtask_profile.z42.
    ArgParser profile = new ArgParser("xtask profile", "profile a .z42 script (cpu/heap/threads/e2e)");
    profile.AddPositional("script", "<script.z42> to profile");
    profile.AddFlag("cpu", "", "native CPU flamegraph via samply");
    profile.AddFlag("heap", "", "heap profile via dhat (builds a throwaway dhat-heap VM)");
    profile.AddFlag("threads", "", "concurrency counters + per-thread timeline hint");
    profile.AddFlag("e2e", "", "wall-clock (hyperfine) + peak-RSS + counters");
    profile.AddFlag("all", "", "run all four dimensions → report.md");
    profile.AddOption("mode", "", "interp|jit (measured mode; default jit)", "jit");
    root.Add("profile", "profile a .z42 script (cpu/heap/threads/e2e; no flag = all)", profile);

    // centralize-xtask-layout: 产物布局的查询口（CI / 脚本按 key 取路径，不再各自写死）。
    ArgParser layout = new ArgParser("xtask layout", "print the artifacts/ tree (no path) or one entry's absolute path");
    layout.AddOptionalPositional("path", "an entry's path relative to artifacts/, e.g. intermediate/libraries/flat/release or reports/benches (see `xtask layout`)");
    root.Add("layout", "print the artifacts/ tree (no path) or one entry's absolute path", layout);

    ArgParser clean = new ArgParser("xtask clean", "remove build artifacts");
    clean.AddOptionalPositional("target", "tests|bench|intermediate|all (default: production cache/dist)");
    root.Add("clean", "remove build artifacts", clean);

    // Listed for `xtask -h` only: _runCli forwards everything after `run` to the launcher.
    root.Add("run", "run a zpkg / .z42 via the launcher (args after `run` are forwarded verbatim)",
        new ArgParser("xtask run", "run a zpkg / .z42 via the launcher"));

    return root;
}

// ── dispatch (resolved command → handler) ─────────────────────────────────────

int _dispatch(CommandResolution res) {
    string[] p = res.Path();
    if (p.Length == 0) { return 2; }
    ParseResult r = res.Result();
    string top = p[0];
    if (top == "build")          { return _dispatchBuild(p, r); }
    if (top == "package")        { return _dispatchPackage(p, r); }
    if (top == "test")           { return _dispatchTest(p, r); }
    if (top == "check")          { return _check(r); }
    if (top == "setup")          { return _dispatchSetup(p, r); }
    if (top == "bench")          { return _dispatchBench(p, r); }
    if (top == "doc")            { return _dispatchDoc(p, r); }
    if (top == "profile")        { return _profile(r); }
    if (top == "clean")          { return _clean(r); }
    if (top == "layout")         { return _layoutCmd(r); }
    // `run` is forwarded in _runCli before dispatch — not reached here.
    return 2;
}

// ── small helpers ─────────────────────────────────────────────────────────────

int _indexOf(string[] arr, string s) {
    int i = 0;
    while (i < arr.Length) { if (arr[i] == s) { return i; } i = i + 1; }
    return -1;
}

string[] _slice(string[] arr, int from, int to) {
    string[] outArr = new string[to - from];
    int j = 0;
    while (j < outArr.Length) { outArr[j] = arr[from + j]; j = j + 1; }
    return outArr;
}
