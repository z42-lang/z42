// xtask CLI — `package` 命令族：router + dispatch。拆分背景见
// scripts/cli/xtask_cli_build.z42 头部。
namespace Z42Xtask;

using Std.IO;
using Std.Cli;

// package = **组装**（把已编好的产物摆成某种布局），按产物命名：
//   sdk / runtime / workload   发行包；都可带 `--archive [--label]` 在包目录旁出发布归档（本地即可），
//                              `sdk --verify` 再在这份 SDK 上跑 packages.toml 自检 + 发行包夹具 + golden
//   dev-sdk / ci               开发态布局（`.z42` SDK / CI 的构建树 zpkg 快照）
//   release <label>            CI 汇总 job 专用：合并 4 份逐 RID 桌面 workload → SHA256SUMS → release-index.json
//                              （要 9 个 RID 的全部归档，单机凑不齐）
// profile 是 --profile 选项（release|debug），不是位置参数。
SubcommandRouter _packageRouter() {
    SubcommandRouter pkg = new SubcommandRouter("xtask package", "assemble packages / layouts from built artifacts");

    ArgParser sdk = new ArgParser("xtask package sdk", "assemble the host SDK package");
    sdk.AddOption("profile", "", "release|debug (default release)", "release");
    sdk.AddOption("variant", "", "package variant suffix", "");
    sdk.AddFlag("no-build", "", "assemble from existing z42c+stdlib artifacts (CI warm)");
    sdk.AddFlag("verify", "", "then verify: packages.toml self-checks + package fixtures + goldens on THIS SDK (builds the host desktop workload if missing)");
    _addArchiveOpts(sdk);
    pkg.Add("sdk", "assemble the host SDK package", sdk);

    ArgParser rt = new ArgParser("xtask package runtime", "assemble the runtime package (native+stdlib; platform via --rid)");
    rt.AddOption("rid", "", "target RID (default: host)", "");
    rt.AddOption("profile", "", "release|debug (default release)", "release");
    rt.AddOption("variant", "", "package variant suffix", "");
    rt.AddFlag("no-build", "", "assemble from existing z42c+stdlib artifacts (CI warm)");
    _addArchiveOpts(rt);
    pkg.Add("runtime", "assemble the runtime package (native+stdlib; --rid for platform)", rt);

    ArgParser wl = new ArgParser("xtask package workload", "build a per-RID desktop workload (--rid), or the payload-only test workload (`test`)");
    wl.AddOption("rid", "", "desktop workload for this RID (default: host)", "");
    wl.AddOption("profile", "", "release|debug (default release)", "release");
    wl.AddOptionalPositional("kind", "test = the payload-only capability workload (default: per-RID desktop workload)");
    _addArchiveOpts(wl);
    pkg.Add("workload", "per-RID desktop workload (--rid), or `workload test`", wl);

    ArgParser dev = new ArgParser("xtask package dev-sdk", "assemble the built toolchain into a .z42 layout (--toolchain / learn-book examples consume it)");
    dev.AddOption("out", "", "output dir (default: artifacts/.z42)", "");
    pkg.Add("dev-sdk", "assemble built z42c + stdlib + z42vm (+ published apphosts) → .z42 layout", dev);

    ArgParser ci = new ArgParser("xtask package ci", "snapshot the built tree's zpkgs (z42c + stdlib + xtask + z42b) → <dest>, repo-relative, for the CI toolchain-<os> artifact");
    ci.AddOptionalPositional("dest", "destination dir (required)");
    pkg.Add("ci", "built-tree zpkg snapshot → <dest> (CI toolchain-<os> artifact; downstream jobs restore it in place)", ci);

    ArgParser rel = new ArgParser("xtask package release", "merge the per-RID desktop workloads, then SHA256SUMS + release-index.json over every RID's release archives");
    rel.AddOptionalPositional("label", "<LABEL> (e.g. 0.3.0 or nightly)");
    rel.AddOption("dir", "", "archive dir (default: artifacts/packages)", "");
    rel.AddOption("channel", "", "channel (default: stable)", "");
    rel.AddOption("tag", "", "tag (default: v<LABEL>)", "");
    rel.AddOption("version", "", "version (default: <LABEL>)", "");
    pkg.Add("release", "CI release aggregate over all RIDs' archives: merge desktop workloads → SHA256SUMS → release-index.json", rel);

    return pkg;
}

void _addArchiveOpts(ArgParser p) {
    p.AddFlag("archive", "", "also write the release archive next to the package dir (artifacts/packages/z42-…{.tar.gz,.zip}); release profile only");
    p.AddOption("label", "", "--archive: version label in archive names (default: versions.toml version; CI nightly: nightly)", "");
}

int _dispatchPackage(string[] p, ParseResult r) {
    string sub = p.Length > 1 ? p[1] : "";
    if (sub == "dev-sdk")         { return _packageDevSdk(r.GetOption("out")); }
    if (sub == "ci")              { return _packageCi(r.GetPositional(0)); }
    if (sub == "release") {
        return _packageRelease(r.GetPositional(0), r.GetOption("dir"), r.GetOption("channel"),
            r.GetOption("tag"), r.GetOption("version"));
    }
    bool archive = r.GetFlag("archive");
    if (archive && r.GetOption("profile") != "release") {
        ConsoleError.WriteLine("xtask package " + sub + ": --archive only applies to --profile release (only release packages are published)");
        return 2;
    }
    int c = 2;
    if (sub == "sdk")     { c = _packageSdk(r.GetOption("profile"), r.GetOption("variant"), r.GetFlag("no-build")); }
    if (sub == "runtime") { c = _packageRuntime(r.GetOption("rid"), r.GetOption("profile"), r.GetOption("variant"), r.GetFlag("no-build")); }
    if (sub == "workload") {
        string kind = r.GetPositional(0);
        if (kind == "test")         { c = _buildTestWorkload(_root(), _versionsGet(_root()), r.GetOption("profile")); }
        else if (kind.Length == 0)  { c = _packageWorkloadBuild(r.GetOption("rid"), r.GetOption("profile")); }
        else {
            ConsoleError.WriteLine("xtask package workload: unknown kind '" + kind + "' (test; none = per-RID desktop workload)");
            return 2;
        }
    }
    if (c != 0) { return c; }
    // 先出归档、再验证：--verify 可能顺带打一份桌面 workload，它不属于本次要出归档的产出。
    if (archive) { c = _pkgArchiveOutputs(r.GetOption("label")); if (c != 0) { return c; } }
    if (sub == "sdk" && r.GetFlag("verify")) { return _packageVerify(PackageOutputs.All()[0]); }
    return 0;
}
