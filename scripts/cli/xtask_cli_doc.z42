// xtask CLI — `doc` 命令族：reference stdlib 包页的生成 / 漂移门禁 + Rust crate 索引。
namespace Z42Xtask;

using Std.Cli;

SubcommandRouter _docRouter() {
    SubcommandRouter d = new SubcommandRouter("xtask doc", "generate reference stdlib pages and index Rust crates");
    d.Add("gen", "regenerate reference stdlib pages (only packages with a //! doc)",
        new ArgParser("xtask doc gen", "regenerate reference stdlib pages from source doc comments"));
    d.Add("index", "index the Rust runtime crates → artifacts/doc/rust.idx (z42 doc then finds Rust symbols too)",
        new ArgParser("xtask doc index", "index the Rust runtime crates → artifacts/doc/rust.idx"));
    return d;
}

int _dispatchDoc(string[] p, ParseResult r) {
    string sub = p.Length > 1 ? p[1] : "";
    if (sub == "gen") { return _docGen(); }
    if (sub == "index") { return _docIndex(); }
    return 2;
}
