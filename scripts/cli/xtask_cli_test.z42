// xtask CLI — `test` 命令族：router + dispatch。拆分背景见 scripts/cli/xtask_cli_build.z42 头部。
namespace Z42Xtask;

using Std.IO;
using Std.Cli;

// `xtask test` 按「契约属于谁」归类（test-layout.md §1 的 owner 表）：
//   (无子命令)  完整 GREEN gate [--no-build] [--skip <csv>]（在 xtask_cli.z42 的 shim 里解析，router 不支持默认动作）
//   changed     按改动推导该跑的命令
//   e2e / stdlib / compiler / toolchain / runtime   各 owner 的用例
//   app         嵌入宿主里跑（desktop / wasm / ios / android）
//   docs        文档链接 + 学习手册示例
//   list        用例目录（只读）
// 不跑用例的静态检查在 `xtask check`（xtask_cli_check.z42）；打包自检在 `xtask package check|verify`。
SubcommandRouter _testRouter() {
    SubcommandRouter t = new SubcommandRouter("xtask test",
        "run tests (no subcommand = the full GREEN gate: xtask test [--no-build] [--skip <csv>])");
    ArgParser changed = new ArgParser("xtask test changed", "only changed-area tests");
    changed.AddFlag("dry-run", "", "print the plan, don't run");
    changed.AddOptionalPositional("base", "git base ref (default: HEAD)");
    t.Add("changed", "only changed-area tests", changed);
    ArgParser e2e = new ArgParser("xtask test e2e", "src/tests end-to-end suite (goldens + cross-zpkg)");
    e2e.AddFlag("no-rebuild", "", "skip rebuild before run");
    e2e.AddFlag("no-build", "", "regen goldens only — skip z42c+stdlib rebuild (consume bootstrap output)");
    e2e.AddOption("dir", "", "run only src/tests/<cat> (e.g. classes, cross-zpkg)", "");
    e2e.AddOption("file", "", "run one case (name or source-path substring)", "");
    e2e.AddOption("mode", "", "interp|jit (default: both)", "");
    e2e.AddOption("jobs", "", "parallel jobs", "");
    e2e.AddOption("shard", "", "k/n: run shard k of n golden cases (for parallel CI)", "");
    t.Add("e2e", "src/tests end-to-end (goldens + cross-zpkg; --dir/--file to narrow)", e2e);
    // read-only catalog of the case-granular corpus (tidy-test-system): what cases
    // exist, how to run one, which platforms can run it — no source-reading needed.
    ArgParser list = new ArgParser("xtask test list", "list the case-granular test corpus (goldens + stdlib [Test])");
    list.AddOption("dir", "", "only this bucket (src/tests <cat> or stdlib <lib>)", "");
    list.AddOption("filter", "", "only cases whose name contains this substring", "");
    list.AddOption("kind", "", "golden | test | all (default: all)", "");
    list.AddFlag("json", "", "emit JSON instead of the human table");
    t.Add("list", "catalog the case-granular corpus (--dir/--filter/--kind/--rid/--json)", list);
    ArgParser stdlib = new ArgParser("xtask test stdlib", "stdlib [Test] (all or one)");
    stdlib.AddFlag("no-build", "", "skip tooling rebuild");
    stdlib.AddOption("filter", "k", "test-name filter", "");
    stdlib.AddOption("jobs", "", "parallel unit batch width", "");
    stdlib.AddOption("mode", "", "interp|jit (default: interp; jit forks z42vm)", "");
    stdlib.AddOption("shard", "", "k/n: run shard k of n libs (balanced; for parallel CI)", "");
    // extend-ab-bench-micro-criterion: _testLib 无条件读这三个 → test/bench 两侧都注册。
    stdlib.AddOption("vm", "", "override: prebuilt z42vm (with --driver/--libs → skip in-tree build)", "");
    stdlib.AddOption("driver", "", "override: prebuilt z42c.driver.zpkg", "");
    stdlib.AddOption("libs", "", "override: prebuilt flat libs dir (stdlib + z42c siblings)", "");
    stdlib.AddOptionalPositional("lib", "single lib (default: all)");
    t.Add("stdlib", "stdlib [Test] (all or one)", stdlib);
    // 编译器：不带 part = GREEN 里那三项（自举不动点 + [Test] 单元 + e2e）；其余是按需跑的专项。
    ArgParser compiler = new ArgParser("xtask test compiler", "z42c: self-host fixpoint + [Test] units + e2e (no part); or one on-demand check");
    compiler.AddOptionalPositional("part", "incremental | fingerprint | bootstrap (default: fixpoint + units + e2e)");
    compiler.AddOption("base", "", "fingerprint: base source tree root (its stdlib already built by the base compiler)", "");
    compiler.AddOption("base-driver", "", "fingerprint: the base side's driver zpkg (tells whether both sides are the same binary)", "");
    compiler.AddOption("rid", "", "bootstrap: target RID (default: host)", "");
    t.Add("compiler", "z42c fixpoint + units + e2e; or incremental | fingerprint | bootstrap", compiler);
    // 工具链组件（test-layout §1）：各工程 tests/ 的 [Test] 单元 + builder 的 manifest 目标夹具。
    ArgParser toolchain = new ArgParser("xtask test toolchain", "toolchain components: [Test] units (src/toolchain/<comp>/**/tests) + builder's manifest-target fixtures");
    toolchain.AddFlag("no-build", "", "skip tooling rebuild");
    toolchain.AddOption("filter", "k", "test-name filter", "");
    toolchain.AddOption("target", "", "builder fixtures: one manifest target by name", "");
    toolchain.AddOptionalPositional("comp", "component dir (builder / interactive …) or package name (z42.repl); default: all");
    t.Add("toolchain", "toolchain components' units + builder manifest-target fixtures", toolchain);
    t.Add("runtime", "Rust VM unit tests (cargo test src/runtime, serialized)",
        new ArgParser("xtask test runtime", "Rust VM unit/integration harness (--test-threads=1)"));
    // 嵌入宿主（test-layout §6）：desktop 也是一个宿主平台（C ABI 宿主），与 wasm / iOS / Android 同一条流水线。
    ArgParser app = new ArgParser("xtask test app", "embedding hosts end-to-end: R1–R7 + embedded corpus bundle + run on the host / device");
    app.AddOptionalPositional("platform", "desktop | wasm | ios | android | all (all = every platform this host supports; others are skipped with a reason)");
    app.AddOptionalPositional("step", "one step only: stage | build | assets | bundle | run (default: the whole pipeline)");
    app.AddOption("filter", "", "only embedded cases whose name contains this substring", "");
    app.AddOption("shard", "", "k/n: run shard k of n of the embedded corpus (R1–R7 runs on shard 1 only)", "");
    app.AddOption("format", "", "desktop run report: json | pretty | tap (default: json)", "");
    app.AddOption("zbc", "", "desktop: run one .zbc or one golden case dir instead of a corpus bundle", "");
    t.Add("app", "embedding hosts: desktop / wasm / ios / android / all (unsupported hosts are skipped)", app);
    // 文档（三本书）：不带 kind = 两样都跑。
    ArgParser docs = new ArgParser("xtask test docs", "documentation: relative links resolve + learn-book examples replay");
    docs.AddOptionalPositional("kind", "links | examples (default: both)");
    docs.AddOptionalPositional("path", "examples: only transcripts under examples/<path> (default: all)");
    docs.AddFlag("update", "", "links: rewrite the dead-link baseline (only to drop fixed ones — never to admit new ones)");
    docs.AddOption("sdk", "", "examples: SDK to run `z42` from (default: artifacts/.z42 — build it with `xtask build sdk`)", "");
    docs.AddFlag("book-only", "", "examples: only check docs/learn ↔ examples references (no SDK needed)");
    docs.AddFlag("bless", "", "examples: rewrite mismatching expected output with the actual output");
    docs.AddFlag("keep", "", "examples: keep every sandbox directory (failed ones are always kept)");
    docs.AddOption("timeout", "", "examples: per-step timeout in seconds", "120");
    t.Add("docs", "documentation: links + learn-book examples", docs);
    return t;
}

int _dispatchTest(string[] p, ParseResult r) {
    string sub = p.Length > 1 ? p[1] : "";
    if (sub == "changed")      { return _testChanged(r); }
    if (sub == "e2e")          { return _testE2e(r); }
    if (sub == "list")         { return _testList(r); }        // read-only case catalog
    if (sub == "stdlib")       { return _testLib(r, "test"); }
    if (sub == "compiler")     { return _testCompilerCmd(r); }
    if (sub == "toolchain")    { return _testToolchain(r); }
    if (sub == "runtime")      { return _testRuntime(); }
    if (sub == "app")          { return _testApp(r); }        // 嵌入宿主（test-layout §6）
    if (sub == "docs")         { return _testDocsCmd(r); }
    return 2;
}

// `test compiler [part]`。
int _testCompilerCmd(ParseResult r) {
    string part = r.GetPositional(0);
    if (part == "")            { return _testCompiler(false); }   // 自举不动点 + units + e2e
    if (part == "incremental") { return _testIncremental(r); }   // 文件级增量暴力对账（D4/D8）
    if (part == "fingerprint") { return _testFingerprint(r); }   // 编译器输出变 ⇒ 版本号必须累加
    if (part == "bootstrap")   { return _bootstrapCheck(r.GetOption("rid")); }   // staged-bootstrap 边界检查
    ConsoleError.WriteLine("xtask test compiler: unknown part '" + part + "' (incremental | fingerprint | bootstrap; none = fixpoint + units + e2e)");
    return 2;
}

// `test docs [links|examples] [path]`：不带 kind = 先链接（秒级）再示例（要 SDK）。
int _testDocsCmd(ParseResult r) {
    string kind = r.GetPositional(0);
    if (kind != "" && kind != "links" && kind != "examples") {
        ConsoleError.WriteLine("xtask test docs: unknown kind '" + kind + "' (links | examples; none = both)");
        return 2;
    }
    if (kind == "" || kind == "links") {
        int c = _testDocs(_root(), r.GetFlag("update")); if (c != 0 || kind == "links") { return c; }
    }
    return _testExamples(_examplesOptions(r));
}

ExamplesOptions _examplesOptions(ParseResult r) {
    ExamplesOptions o = new ExamplesOptions();
    o.Filter = r.GetPositional(1);   // `test docs examples <path>`
    o.Sdk = r.GetOption("sdk");
    o.BookOnly = r.GetFlag("book-only");
    o.Bless = r.GetFlag("bless");
    o.Keep = r.GetFlag("keep");
    string t = r.GetOption("timeout");
    o.TimeoutS = 120;
    if (t.Length > 0) { try { o.TimeoutS = int.Parse(t); } catch (Exception e) { o.TimeoutS = 120; } }
    return o;
}
