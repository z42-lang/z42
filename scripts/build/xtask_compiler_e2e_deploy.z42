// xtask — exe 私有依赖的复制判据 e2e 门（add-deployment-model 批 1）。
//
// **守的是什么**：`z42c build` 决定「这个依赖要不要复制进 exe 的 dist」时用的判据。
//
// 此前的判据是「`<srcRoot>/libraries/<name>` 存在 ⇒ 真-stdlib ⇒ 不复制」，而 `_srcRoot`
// 靠向上找「同时含 libraries/ 与 compiler/ 的目录」—— **用户机器上恒为空**，整条判据退化成
// `dep.StartsWith("z42.")`：**按名字前缀猜一个包是不是框架**。后果之一就是本门这一格 ——
// 一个确实躺在框架目录（`Z42_LIBS`）里、但名字不以 `z42.` 开头的包，会被当成私有依赖
// 复制进每一个用到它的 exe 的 dist 里。
//
// 现在判据是「**在不在 shipped `libs/`**」（= publisher 一直在用的那条）。它是「这台机器上的
// 框架在哪」这个**运行期事实**，repo 内外都成立；srcRoot 那条只在开发树里成立。
//
// 🔴 工程必须落在 **repo 之外**（`/tmp`）：放在 repo 内 `_srcRoot` 找得到根，走的是目录判据，
// 旧代码在那儿是对的 —— 门也就看不见差别了。**这个缺陷只在用户机器上发生。**
//
// ⚠️ **本门盖不到的另一半**（2026-09-25 被 CI 抓到后补记）：判据不能写成「这个名字在
// Z42_LIBS 里存在吗」—— 构建期 Z42_LIBS 若**混装了非框架包**（CI 的 bench A/B 就是这么拼的：
// `.ab-base-alllibs` = stdlib + 全部 compiler member），`z42c.pipeline` 会被判成框架而不复制，
// 于是 `z42c.driver` 的自包含 bundle 缺件、z42b 的 `_findCompilerZpkg` 探测③ 落空 ⇒
// `no compiler injected`。**本地 GREEN 看不见**（本地 Z42_LIBS 是干净的 stdlib flat dist）。
// 故判据改用「它是**从哪个目录**找到的」。这一格由 `test compiler` 的自举 + CI 的 bench A/B
// 共同守着，本门只守「repo 外不按名字前缀猜」那一格。
namespace Z42Xtask;

using Std;
using Std.IO;

string _e2eDeployLibSrc() {
    return "namespace DeployFx;\n\npublic class Helper { public int V() { return 7; } }\n";
}

string _e2eDeployAppSrc() {
    return "namespace DeployApp;\n\nusing Std.IO;\nusing DeployFx;\n\nvoid Main() { Console.WriteLine(new Helper().V().ToString()); }\n";
}

// repo 外的临时根（`_srcRoot` 上溯到 / 都找不到 libraries/+compiler/ ⇒ 返回 ""）。
string _e2eDeployRoot() { return Path.Join("/tmp", "z42c-e2e-deploy"); }

int _e2eDeployPredicateChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp  = _e2eDeployRoot();
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }
    string libsDir = Path.Join(tmp, "libs");
    string appDir  = Path.Join(tmp, "app");
    string fxDir   = Path.Join(tmp, "fx");
    Directory.Create(libsDir); Directory.Create(appDir); Directory.Create(fxDir);

    // 私有框架目录 = stdlib 扁平 dist 的副本（下面再把 fx 包塞进去）。
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) {
        File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si])));
        si = si + 1;
    }

    // ① 建一个**名字不以 `z42.` 开头**的库，把产物放进框架目录。
    File.WriteAllText(Path.Join(fxDir, "fx.z42"), _e2eDeployLibSrc());
    File.WriteAllText(Path.Join(fxDir, "deployfx.z42.toml"),
        "[project]\nname    = \"deployfx\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n"
        + "[sources]\ninclude = [\"*.z42\"]\n");
    ProcessResult lb = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build")
        .Arg(Path.Join(fxDir, "deployfx.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (lb.ExitCode != 0) {
        Console.WriteLine("  ✗ deploy 判据: 框架库 fixture 编译失败: " + lb.Stderr);
        return 1;
    }
    File.Copy(Path.Join(Path.Join(fxDir, "dist"), "deployfx.zpkg"), Path.Join(libsDir, "deployfx.zpkg"));

    // ② 一个 exe **按名**依赖它 —— 它此刻确实在框架目录里。
    File.WriteAllText(Path.Join(appDir, "app.z42"), _e2eDeployAppSrc());
    string appToml = Path.Join(appDir, "deployapp.z42.toml");
    File.WriteAllText(appToml,
        "[project]\nname    = \"deployapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
        + "entry   = \"DeployApp.Main\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
        + "[dependencies]\n\"deployfx\" = \"0.1.0\"\n");
    ProcessResult ab = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (ab.ExitCode != 0) {
        Console.WriteLine("  ✗ deploy 判据: exe fixture 编译失败: " + ab.Stderr);
        return 1;
    }

    // ③ 框架包**不得**被复制进 exe 的 dist —— 它在 libs/ 里，运行期从那儿解析。
    string copied = Path.Join(Path.Join(appDir, "dist"), "deployfx.zpkg");
    if (File.Exists(copied)) {
        Console.WriteLine("  ✗ deploy 判据: 框架目录里的 `deployfx` 仍被复制进 exe dist"
            + " —— 判据还在按名字前缀猜（它不叫 z42.* 就当成私有依赖）");
        return 1;
    }

    // ④ **对照**：产物必须真能跑 —— 否则「没复制」可能只是因为整个构建没做事。
    ProcessResult rr = new Process(vm).Arg(Path.Join(Path.Join(appDir, "dist"), "deployapp.zpkg"))
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (rr.ExitCode != 0 || rr.Stdout.IndexOf("7") < 0) {
        Console.WriteLine("  ✗ deploy 判据: 没复制，但产物也跑不起来（rc=" + rr.ExitCode.ToString()
            + " stdout=" + rr.Stdout + "）—— 框架解析断了");
        return 1;
    }

    Console.WriteLine("  ✓ 复制判据：框架目录里的包不进 exe dist，且运行期从 libs/ 解析得到");
    return 0;
}

// ── `probing-paths`：声明一组运行期搜索目录（add-deployment-model 批 3）───────────────
//
// **守的是什么**：`[profile.<n>.runtime] probing-paths` 能不能让一个**既不在 exe 目录、也不在
// libs/** 的依赖在运行期被找到。这是「配置了就不复制过去」那条路的后半段——前半段（构建期
// 不复制）由上面那格守着。
//
// 三格：
//   ① 依赖只在 `shared/` 时，**不配** probing-paths → 必须跑不起来（对照：证明下面那格是它
//      起的作用，不是依赖碰巧还能从别处解析到）；
//   ② 配上之后 → 跑得起来；
//   ③ 改掉 manifest 里的值、源码一字不动 → 侧车必须跟着变。
//      🔴 ③ 不是凑数：`[profile.*.runtime]` **不进源 hash**（它不影响编译产物），于是「只改运行时
//      配置」恰好全命中增量缓存 ⇒ 走 preserved 早退 ⇒ 侧车留在上一次的值。实测踩到过：把
//      probing-paths 改掉重建，构建报成功而侧车纹丝不动——**用户改了旋钮，产物里还是旧配置**。
string _e2eProbeLibSrc() { return "namespace ProbeFx;\n\npublic class Helper { public int V() { return 99; } }\n"; }

string _e2eProbeAppSrc() {
    return "namespace ProbeApp;\n\nusing Std.IO;\nusing ProbeFx;\n\nvoid Main() { Console.WriteLine(new Helper().V().ToString()); }\n";
}

string _e2eProbeAppToml(string probing) {
    string s = "[project]\nname    = \"probeapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
             + "entry   = \"ProbeApp.Main\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
             + "[dependencies]\n\"probefx\" = \"0.1.0\"\n";
    if (probing.Length > 0) {
        s = s + "\n[profile.release.runtime]\nprobing-paths = \"" + probing + "\"\n";
    }
    return s;
}

int _e2eProbingPathChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp  = Path.Join("/tmp", "z42c-e2e-probing");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }
    string libsDir = Path.Join(tmp, "libs");
    string shared  = Path.Join(tmp, "shared");
    string appDir  = Path.Join(tmp, "app");
    string fxDir   = Path.Join(tmp, "fx");
    Directory.Create(libsDir); Directory.Create(shared); Directory.Create(appDir); Directory.Create(fxDir);
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si]))); si = si + 1; }

    // 依赖：先建好、放进 libs（编译期要解析得到它——probing-paths 只管运行期）。
    File.WriteAllText(Path.Join(fxDir, "fx.z42"), _e2eProbeLibSrc());
    File.WriteAllText(Path.Join(fxDir, "probefx.z42.toml"),
        "[project]\nname    = \"probefx\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n");
    ProcessResult lb = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build")
        .Arg(Path.Join(fxDir, "probefx.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (lb.ExitCode != 0) { Console.WriteLine("  ✗ probing-paths: 依赖 fixture 编译失败: " + lb.Stderr); return 1; }
    string fxZpkg = Path.Join(Path.Join(fxDir, "dist"), "probefx.zpkg");
    File.Copy(fxZpkg, Path.Join(libsDir, "probefx.zpkg"));
    File.Copy(fxZpkg, Path.Join(shared, "probefx.zpkg"));

    File.WriteAllText(Path.Join(appDir, "app.z42"), _e2eProbeAppSrc());
    string appToml = Path.Join(appDir, "probeapp.z42.toml");
    string appZpkg = Path.Join(Path.Join(appDir, "dist"), "probeapp.zpkg");

    // ① 不配 probing-paths，且运行时 libs 里没有它 → 必须跑不起来。
    File.WriteAllText(appToml, _e2eProbeAppToml(""));
    ProcessResult b0 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b0.ExitCode != 0) { Console.WriteLine("  ✗ probing-paths: exe fixture 编译失败: " + b0.Stderr); return 1; }
    // 目标机：libs 里没有该依赖，只有 shared/。
    File.Delete(Path.Join(libsDir, "probefx.zpkg"));
    ProcessResult r0 = new Process(vm).Arg(appZpkg).Env("Z42_LIBS", libsDir)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (r0.ExitCode == 0) {
        Console.WriteLine("  ✗ probing-paths: 没配 probing-paths 竟也跑通了 —— 下一格就失去判别力");
        return 1;
    }

    // ② 配上 → 跑得起来（相对 entry zpkg 所在目录）。
    File.WriteAllText(appToml, _e2eProbeAppToml("../../shared"));
    File.Copy(Path.Join(shared, "probefx.zpkg"), Path.Join(libsDir, "probefx.zpkg"));   // 编译期要它
    ProcessResult b1 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b1.ExitCode != 0) { Console.WriteLine("  ✗ probing-paths: 配上后编译失败: " + b1.Stderr); return 1; }
    File.Delete(Path.Join(libsDir, "probefx.zpkg"));
    ProcessResult r1 = new Process(vm).Arg(appZpkg).Env("Z42_LIBS", libsDir)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (r1.ExitCode != 0 || r1.Stdout.IndexOf("99") < 0) {
        Console.WriteLine("  ✗ probing-paths: 配了却没生效（rc=" + r1.ExitCode.ToString()
            + " stdout=" + r1.Stdout + " stderr=" + r1.Stderr + "）");
        return 1;
    }

    // ③ 只改旋钮值、源码不动 → 侧车必须跟着变（preserved 早退不得把它落下）。
    File.Copy(Path.Join(shared, "probefx.zpkg"), Path.Join(libsDir, "probefx.zpkg"));
    File.WriteAllText(appToml, _e2eProbeAppToml("../../CHANGED"));
    ProcessResult b2 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b2.ExitCode != 0) { Console.WriteLine("  ✗ probing-paths: 改旋钮后重建失败: " + b2.Stderr); return 1; }
    string side = Path.Join(Path.Join(appDir, "dist"), "probeapp.runtimeconfig.toml");
    string body = File.Exists(side) ? File.ReadAllText(side) : "";
    if (body.IndexOf("CHANGED") < 0) {
        Console.WriteLine("  ✗ probing-paths: 改了 manifest 的旋钮值，侧车却没跟着变"
            + " —— 源码没动就全命中缓存、preserved 早退把侧车落下了。侧车内容: " + body);
        return 1;
    }

    Console.WriteLine("  ✓ probing-paths：声明的目录真被搜到，且改旋钮值侧车跟着变");
    return 0;
}

// ── `[dependencies]` 的 zpkg 产物引用（add-deployment-model）──────────────────────────────
//
// **守的是什么**：`path` 指向一个已构建的 `.zpkg` 文件时，能不能像 C# 引用 DLL 那样直接用 ——
// 不代建、编译期解析得到、运行期自动随产物走。
//
// 在此之前 `path` 只有一种语义（工程目录 + z42c 代建），指向 zpkg 会得到
// 「期望恰 1 份 *.z42.toml，实得 0」**而且是个未捕获异常** —— 一条指向错误方向的诊断，
// 外加一段 z42c 内部栈帧。
//
// 四格：
//   ① 引用得到 + **自动复制进 dist** + 跑得起来（复制不需要额外机制：`_bundleExeDeps` 的
//      「从哪个目录找到的」判据看到它不是从 shipped libs/ 来的，自然判复制）；
//   ② 文件不存在 → 明确说「该文件不存在」，并提示两种 path 形态的区别；
//   ③ zpkg 里的包名与清单 key 不一致 → 拒绝（指错文件是最容易犯的错）；
//   ④ 指向**没有 manifest 的目录** → 干净的错误退出，**不得是未捕获异常**。
string _e2eZrefLibSrc() { return "namespace ZrefVendor;\n\npublic class Greeter { public string Hello() { return \"vendored\"; } }\n"; }

string _e2eZrefAppSrc() {
    return "namespace ZrefApp;\n\nusing Std.IO;\nusing ZrefVendor;\n\nvoid Main() { Console.WriteLine(new Greeter().Hello()); }\n";
}

string _e2eZrefAppToml(string key, string path) {
    return "[project]\nname    = \"zrefapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
         + "entry   = \"ZrefApp.Main\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[dependencies]\n\"" + key + "\" = { path = \"" + path + "\" }\n";
}

int _e2eZpkgRefChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp  = Path.Join("/tmp", "z42c-e2e-zref");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }
    string libsDir = Path.Join(tmp, "libs");
    string vendor  = Path.Join(tmp, "vendor");
    string libSrc  = Path.Join(tmp, "vendorsrc");
    string appDir  = Path.Join(tmp, "app");
    Directory.Create(libsDir); Directory.Create(vendor);
    Directory.Create(Path.Join(libSrc, "src")); Directory.Create(appDir);
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si]))); si = si + 1; }

    // 先建出被引用的产物，放进一个**不是** libs/ 的 vendored 目录。
    File.WriteAllText(Path.Join(Path.Join(libSrc, "src"), "lib.z42"), _e2eZrefLibSrc());
    File.WriteAllText(Path.Join(libSrc, "zrefvendor.z42.toml"),
        "[project]\nname    = \"zrefvendor\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"src/*.z42\"]\n");
    ProcessResult lb = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build")
        .Arg(Path.Join(libSrc, "zrefvendor.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (lb.ExitCode != 0) { Console.WriteLine("  ✗ zpkg 产物引用: 被引用库编译失败: " + lb.Stderr); return 1; }
    File.Copy(Path.Join(Path.Join(libSrc, "dist"), "zrefvendor.zpkg"), Path.Join(vendor, "zrefvendor.zpkg"));

    File.WriteAllText(Path.Join(appDir, "app.z42"), _e2eZrefAppSrc());
    string appToml = Path.Join(appDir, "zrefapp.z42.toml");
    string appZpkg = Path.Join(Path.Join(appDir, "dist"), "zrefapp.zpkg");

    // ① 正常引用：编过 + 复制进 dist + 跑得起来。
    File.WriteAllText(appToml, _e2eZrefAppToml("zrefvendor", "../vendor/zrefvendor.zpkg"));
    ProcessResult b1 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b1.ExitCode != 0) {
        Console.WriteLine("  ✗ zpkg 产物引用: 指向已构建的 zpkg 竟编不过: " + b1.Stderr);
        return 1;
    }
    if (!File.Exists(Path.Join(Path.Join(appDir, "dist"), "zrefvendor.zpkg"))) {
        Console.WriteLine("  ✗ zpkg 产物引用: 被引用的产物没有随 exe 进 dist —— 拷出去就跑不起来");
        return 1;
    }
    ProcessResult r1 = new Process(vm).Arg(appZpkg).Env("Z42_LIBS", libsDir)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (r1.ExitCode != 0 || r1.Stdout.IndexOf("vendored") < 0) {
        Console.WriteLine("  ✗ zpkg 产物引用: 产物跑不起来（rc=" + r1.ExitCode.ToString()
            + " stdout=" + r1.Stdout + " stderr=" + r1.Stderr + "）");
        return 1;
    }

    // ② 文件不存在。
    File.WriteAllText(appToml, _e2eZrefAppToml("zrefvendor", "../vendor/nosuch.zpkg"));
    ProcessResult b2 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b2.ExitCode == 0 || b2.Stderr.IndexOf("不存在") < 0) {
        Console.WriteLine("  ✗ zpkg 产物引用: 指向不存在的文件没被明确拒绝: " + b2.Stderr);
        return 1;
    }

    // ③ 包名与 key 不一致 —— 指错文件最容易犯。
    File.WriteAllText(appToml, _e2eZrefAppToml("othername", "../vendor/zrefvendor.zpkg"));
    ProcessResult b3 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b3.ExitCode == 0 || b3.Stderr.IndexOf("须一致") < 0) {
        Console.WriteLine("  ✗ zpkg 产物引用: 包名对不上却收下了: " + b3.Stderr);
        return 1;
    }

    // ④ 指向没有 manifest 的目录 → 干净退出，不得是未捕获异常。
    File.WriteAllText(appToml, _e2eZrefAppToml("zrefvendor", "../vendor"));
    ProcessResult b4 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string all4 = b4.Stdout + b4.Stderr;
    if (b4.ExitCode == 0) {
        Console.WriteLine("  ✗ zpkg 产物引用: 目录里没有 manifest 竟然成功了");
        return 1;
    }
    if (all4.IndexOf("uncaught exception") >= 0) {
        Console.WriteLine("  ✗ zpkg 产物引用: 以未捕获异常收场 —— 看起来像 z42c 崩了: " + all4);
        return 1;
    }
    if (all4.IndexOf("z42.toml") < 0) {
        Console.WriteLine("  ✗ zpkg 产物引用: 判红了但没说清缺什么: " + all4);
        return 1;
    }

    Console.WriteLine("  ✓ zpkg 产物引用：引用得到 + 随产物走 + 三条错误各自说清");
    return 0;
}

// ── `deploy = "copy" | "shared"`（add-deployment-model 批 4 use）──────────────────────────
//
// **守的是什么**：清单里显式声明的部署方式能不能压过默认判据。
// 默认判据（批 1）是「从哪个目录找到的」：shipped `libs/` 里的不复制，其余复制。
// `deploy` 是它的**显式覆盖**。
//
// 四格：
//   ① 未声明 → 框架包不复制（默认判据照常生效，也是下面几格的**对照**）；
//   ② `copy` → **强制复制框架包**（显式要自包含，即使它在 libs/ 里）；
//   ③ `shared` → **强制不复制**（即使它不在 libs/ 里）；
//   ④ 非法取值（`"Copy"` / typo）→ 报错。不校验的话会被当成未声明静默走默认判据
//      —— 又一个「配了以为生效」。
string _e2eDeployAppSrc2() { return "namespace DeployUseApp;\n\nusing Std.IO;\n\nvoid Main() { Console.WriteLine(\"ok\"); }\n"; }

string _e2eDeployUseToml(string depSpec) {
    return "[project]\nname    = \"deployuse\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
         + "entry   = \"DeployUseApp.Main\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[dependencies]\n\"z42.io\" = " + depSpec + "\n";
}

int _e2eDeployUseChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp  = Path.Join("/tmp", "z42c-e2e-deployuse");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }
    string libsDir = Path.Join(tmp, "libs");
    string appDir  = Path.Join(tmp, "app");
    Directory.Create(libsDir); Directory.Create(appDir);
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si]))); si = si + 1; }
    File.WriteAllText(Path.Join(appDir, "app.z42"), _e2eDeployAppSrc2());
    string appToml = Path.Join(appDir, "deployuse.z42.toml");
    string distDir = Path.Join(appDir, "dist");
    string copied  = Path.Join(distDir, "z42.io.zpkg");
    // 🔴 每格构建前必须清 dist：`_bundleExeDeps` 只**写入**、不清理，上一格复制进去的副本
    // 会被下一格当成「本格复制了」。初稿没清，③ 读到 ② 的残留 ⇒ 门报「shared 没能阻止复制」，
    // 而实现是好的 —— **门自己的状态污染**。

    // ① 未声明 → 不复制（对照）。
    if (Directory.Exists(distDir)) { try { Directory.Delete(distDir, true); } catch (Exception e) {} }
    File.WriteAllText(appToml, _e2eDeployUseToml("\"0.1.0\""));
    ProcessResult b1 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b1.ExitCode != 0) { Console.WriteLine("  ✗ deploy use: 基线构建失败: " + b1.Stderr); return 1; }
    if (File.Exists(copied)) {
        Console.WriteLine("  ✗ deploy use: 未声明时框架包竟被复制 —— 默认判据坏了，下面几格失去对照");
        return 1;
    }

    // ② copy → 强制复制框架包。
    if (Directory.Exists(distDir)) { try { Directory.Delete(distDir, true); } catch (Exception e) {} }
    File.WriteAllText(appToml, _e2eDeployUseToml("{ version = \"0.1.0\", deploy = \"copy\" }"));
    ProcessResult b2 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b2.ExitCode != 0) { Console.WriteLine("  ✗ deploy use: deploy=copy 构建失败: " + b2.Stderr); return 1; }
    if (!File.Exists(copied)) {
        Console.WriteLine("  ✗ deploy use: `deploy = \"copy\"` 没能压过「在 libs/ 里就不复制」");
        return 1;
    }

    // ③ shared → 强制不复制。用 vendored 副本（不在 libs/），否则默认判据本来就不复制、测不出。
    string vend = Path.Join(tmp, "vendor");
    Directory.Create(vend);
    File.Copy(Path.Join(libsDir, "z42.io.zpkg"), Path.Join(vend, "z42.io.zpkg"));
    if (Directory.Exists(distDir)) { try { Directory.Delete(distDir, true); } catch (Exception e) {} }
    File.WriteAllText(appToml, _e2eDeployUseToml("{ path = \"../vendor/z42.io.zpkg\", deploy = \"shared\" }"));
    ProcessResult b3 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b3.ExitCode != 0) { Console.WriteLine("  ✗ deploy use: deploy=shared 构建失败: " + b3.Stderr); return 1; }
    if (File.Exists(copied)) {
        Console.WriteLine("  ✗ deploy use: `deploy = \"shared\"` 没能阻止复制 —— 声明了共享却仍自包含");
        return 1;
    }

    // ④ 非法取值。
    File.WriteAllText(appToml, _e2eDeployUseToml("{ version = \"0.1.0\", deploy = \"Copy\" }"));
    ProcessResult b4 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string all4 = b4.Stdout + b4.Stderr;
    if (b4.ExitCode == 0 || all4.IndexOf("不是合法取值") < 0) {
        Console.WriteLine("  ✗ deploy use: 非法取值没被拒绝（会被当成未声明静默走默认判据）: " + all4);
        return 1;
    }

    Console.WriteLine("  ✓ deploy 声明：copy 压过默认、shared 阻止复制、非法取值被拒");
    return 0;
}

// ── `probing-paths` 的数组写法（2026-09-26）────────────────────────────────────────────────
//
// **守的是什么**：路径列表的分隔符是**平台相关**的（unix `:` / windows `;`），所以「在清单里写
// 多条」一旦落成一个字符串，就绑死了一个平台 —— #842 正是这么红的（`probing-paths = "../a:../b"`
// 在 `package-host(windows-x64)` 整串被当成一条不存在的路径）。
//
// 数组形态让清单无歧义，而**摊平只发生在运行这个应用的那台机器上**（VM 知道自己的分隔符）。
// 改前：`ManifestLoader._profileKnobs` **静默跳过数组** ⇒ 用户写了数组等于没配 —— 又一个
// 「配了以为生效」，而且没有任何东西会说话。
//
// 两格：① 侧车里是**TOML 数组**（不是拼好的字符串）；② 两个共享目录都解析得到、跑得起来。
string _e2ePpArrLibSrc(string ns, string cls, string who) {
    return "namespace " + ns + ";\n\npublic class " + cls + " { public string Who() { return \"" + who + "\"; } }\n";
}

int _e2eProbingArrayChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp  = Path.Join("/tmp", "z42c-e2e-pparr");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }
    string libsDir = Path.Join(tmp, "libs");
    Directory.Create(libsDir);
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si]))); si = si + 1; }

    // 两个库，各建各的，产物分别放进两个**不同的**共享目录（单条字符串写法在跨平台清单里必错，
    // 这正是数组要解决的场景）。
    string[] names = new string[2]; names[0] = "pparr_a"; names[1] = "pparr_b";
    string[] clss  = new string[2]; clss[0]  = "Ka";     clss[1]  = "Kb";
    string[] nss   = new string[2]; nss[0]   = "PparrA"; nss[1]   = "PparrB";
    int li = 0;
    while (li < 2) {
        string bd = Path.Join(tmp, "build_" + names[li]);
        Directory.Create(bd);
        File.WriteAllText(Path.Join(bd, "x.z42"), _e2ePpArrLibSrc(nss[li], clss[li], names[li]));
        File.WriteAllText(Path.Join(bd, names[li] + ".z42.toml"),
            "[project]\nname    = \"" + names[li] + "\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n"
            + "[sources]\ninclude = [\"x.z42\"]\n\n[dependencies]\n\"z42.core\" = \"0.1.0\"\n");
        ProcessResult lb = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build")
            .Arg(Path.Join(bd, names[li] + ".z42.toml")).Arg("--release")
            .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
        if (lb.ExitCode != 0) { Console.WriteLine("  ✗ probing 数组: 预建 " + names[li] + " 失败: " + lb.Stderr); return 1; }
        string shDir = Path.Join(tmp, "sh_" + names[li]);
        Directory.Create(shDir);
        File.Copy(Path.Join(Path.Join(bd, "dist"), names[li] + ".zpkg"), Path.Join(shDir, names[li] + ".zpkg"));
        li = li + 1;
    }

    string appDir = Path.Join(tmp, "app");
    Directory.Create(appDir);
    File.WriteAllText(Path.Join(appDir, "app.z42"),
        "namespace PparrApp;\n\nusing Std.IO;\nusing PparrA;\nusing PparrB;\n\n"
        + "void Main() { Console.WriteLine(new Ka().Who() + \"+\" + new Kb().Who()); }\n");
    // probing-paths 相对 **entry zpkg 所在目录**（= app/dist/）⇒ 上溯两级才到 tmp。
    string appToml = Path.Join(appDir, "pparr_app.z42.toml");
    File.WriteAllText(appToml,
        "[project]\nname    = \"pparr_app\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
        + "entry   = \"PparrApp.Main\"\npack    = true\n\n[sources]\ninclude = [\"app.z42\"]\n\n"
        + "[dependencies]\n\"z42.core\" = \"0.1.0\"\n\"z42.io\" = \"0.1.0\"\n"
        + "\"pparr_a\" = { path = \"../sh_pparr_a/pparr_a.zpkg\", deploy = \"shared\" }\n"
        + "\"pparr_b\" = { path = \"../sh_pparr_b/pparr_b.zpkg\", deploy = \"shared\" }\n\n"
        + "[profile.release.runtime]\nprobing-paths = [\"../../sh_pparr_a\", \"../../sh_pparr_b\"]\n");
    ProcessResult b = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b.ExitCode != 0) { Console.WriteLine("  ✗ probing 数组: 应用构建失败: " + b.Stderr); return 1; }

    // ① 侧车里必须是 TOML 数组 —— 若被拼成一条字符串，就又把平台假设烤进产物了。
    string side = Path.Join(Path.Join(appDir, "dist"), "pparr_app.runtimeconfig.toml");
    string sideText = "";
    try { sideText = File.ReadAllText(side); } catch (Exception e) { sideText = ""; }
    if (sideText.IndexOf("probing-paths = [") < 0) {
        Console.WriteLine("  ✗ probing 数组: 侧车里不是 TOML 数组（清单写了数组却被摊成字符串/丢弃）:\n" + sideText);
        return 1;
    }
    // ② 两个共享目录都要解析得到。
    ProcessResult r = new Process(vm).Arg(Path.Join(Path.Join(appDir, "dist"), "pparr_app.zpkg"))
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string ro = r.Stdout + r.Stderr;
    if (r.ExitCode != 0 || ro.IndexOf("pparr_a+pparr_b") < 0) {
        Console.WriteLine("  ✗ probing 数组: 数组里的两条路径没都生效: " + ro);
        return 1;
    }
    Console.WriteLine("  ✓ probing-paths 数组：侧车保持数组形态、两条共享目录都解析得到");
    return 0;
}

// ── `z42b build` 的 path 依赖闭包（2026-09-26）────────────────────────────────────────────
//
// **守的是什么**：闭包解析此前只写在 z42c.driver 的 `_build` 上；z42b 的编排路（`z42b build`，
// 带 rid/workload/hooks 那条）**完全不解析 path 依赖** ⇒ repo 外对着
// `dep = { path = "../foo" }` 的工程连编译都过不了（实测 `E0494: 命名空间 ... 不存在`）。
// repo 内看着能用，只因依赖早已预建进 libs —— 所以 fixture **必须落 repo 外**，否则门看不见差别
// （同 `_e2eDeployPredicateChecks` 头注那条）。
//
// 解析器已从 z42c.pipeline 搬进 z42.project（零编译器依赖）⇒ driver 与 z42b **共用同一份**。
// 两格：① 两层链 `app → mid → leaf` 编得过（改前这里就断）；② 闭包成员随产物走、拷出去跑得起来。
int _e2eZ42bClosureChecks(string root, string vm) {
    string z42b = _toolchainZpkg(root, _z42bToml());
    if (!File.Exists(z42b)) {
        Console.WriteLine("  ⚠ z42b 闭包: z42.builder.zpkg 不在（" + z42b + "）—— 跳过");
        return 0;
    }
    string flat = _libsFlatDist(root, "release");
    string tmp  = Path.Join("/tmp", "z42c-e2e-z42bclos");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }
    string libsDir = Path.Join(tmp, "libs");
    Directory.Create(libsDir);
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si]))); si = si + 1; }

    string leafDir = Path.Join(tmp, "leaf");
    string midDir  = Path.Join(tmp, "mid");
    string appDir  = Path.Join(tmp, "app");
    Directory.Create(leafDir); Directory.Create(midDir); Directory.Create(appDir);
    File.WriteAllText(Path.Join(leafDir, "leaf.z42"), _e2eClosureLeafSrc());
    File.WriteAllText(Path.Join(midDir,  "mid.z42"),  _e2eClosureMidSrc());
    File.WriteAllText(Path.Join(appDir,  "app.z42"),  _e2eClosureAppSrc());
    File.WriteAllText(Path.Join(leafDir, "ncleaf.z42.toml"), _e2eZ42bLibToml("ncleaf", ""));
    File.WriteAllText(Path.Join(midDir,  "ncmid.z42.toml"),
        _e2eZ42bLibToml("ncmid", "\"ncleaf\" = { path = \"../leaf\" }\n"));
    File.WriteAllText(Path.Join(appDir,  "ncapp.z42.toml"), _e2eZ42bExeToml());

    string appToml = Path.Join(appDir, "ncapp.z42.toml");
    ProcessResult b = new Process(vm).Arg(z42b).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string all = b.Stdout + b.Stderr;
    // ① 编得过（改前：E0494 命名空间不存在）。
    if (b.ExitCode != 0) {
        Console.WriteLine("  ✗ z42b 闭包: `z42b build` 建不了带 path 依赖的工程 —— 编排路没解析闭包: " + all);
        return 1;
    }
    // ② 闭包成员随产物走 + 拷出去跑得起来。
    string dist = Path.Join(Path.Join(Path.Join(Path.Join(appDir, "artifacts"), "ncapp"), "release"), "dist");
    string runDir = Path.Join(tmp, "run");
    Directory.Create(runDir);
    foreach (var z in Path.Glob(dist, "*.zpkg")) { File.Copy(z, Path.Join(runDir, Path.GetFileName(z))); }
    if (!File.Exists(Path.Join(runDir, "ncleaf.zpkg"))) {
        Console.WriteLine("  ✗ z42b 闭包: 间接依赖 ncleaf 没随产物走 —— 拷出去会死在 mid 的方法里");
        return 1;
    }
    ProcessResult rr = new Process(vm).Arg(Path.Join(runDir, "ncapp.zpkg"))
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string ro = rr.Stdout + rr.Stderr;
    if (rr.ExitCode != 0 || ro.IndexOf("leaf") < 0) {
        Console.WriteLine("  ✗ z42b 闭包: 拷出去跑不起来: " + ro);
        return 1;
    }
    Console.WriteLine("  ✓ z42b build 的 path 闭包：两层链编得过、闭包随产物走、拷出去照样跑");
    return 0;
}

string _e2eZ42bLibToml(string name, string extraDep) {
    return "[project]\nname    = \"" + name + "\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n"
         + "[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[dependencies]\n\"z42.core\" = \"0.1.0\"\n" + extraDep;
}

string _e2eZ42bExeToml() {
    return "[project]\nname    = \"ncapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
         + "entry   = \"NcApp.Main\"\npack    = true\n\n"
         + "[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[dependencies]\n\"z42.core\" = \"0.1.0\"\n\"z42.io\" = \"0.1.0\"\n"
         + "\"ncmid\" = { path = \"../mid\" }\n";
}

// ── `deploy` 声明校验提到清单层（add-deployment-model 批 4.3）────────────────────────────
//
// **守的是什么**：`deploy` 的校验此前住在 `_bundleExeDeps` 里，而那个函数**只在 exe 分支跑** ⇒
//   · `kind = "lib"` 里写 `deploy = "Copy"`（大写 typo）→ 校验从未执行、静默无效；
//   · `kind = "analyzer"` 里写任何 `deploy` → 那个键在编译期扩展上没有意义，也没人说话；
//   · `[analyzers]` 条目写 `deploy` → 同上（它与 `[dependencies]` 共用 `DepEntry`，键写得出来）。
// 三格都是同一个形状：**配了，没报错，就是不生效**。校验移到 `_build` 开头后对所有 kind 生效。
//
// ⚠️ exe 的非法取值那格在 `_e2eDeployUseChecks` ④ 已有 —— 这里刻意只盖**非-exe** 那半，
// 否则两个门守同一件事，其中一个坏了不会有人知道。
string _e2eDeclLibSrc() { return "namespace DvLib;\n\npublic class A { public int F() { return 1; } }\n"; }

string _e2eDeclToml(string kind, string depSpec, string analyzersSection) {
    return "[project]\nname    = \"dvdecl\"\nversion = \"0.1.0\"\nkind    = \"" + kind + "\"\n\n"
         + "[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[dependencies]\n\"z42.core\" = \"0.1.0\"\n\"z42.io\" = " + depSpec + "\n" + analyzersSection;
}

int _e2eDeployDeclChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp  = Path.Join("/tmp", "z42c-e2e-deploydecl");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }
    string libsDir = Path.Join(tmp, "libs");
    string prjDir  = Path.Join(tmp, "prj");
    Directory.Create(libsDir); Directory.Create(prjDir);
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si]))); si = si + 1; }
    File.WriteAllText(Path.Join(prjDir, "a.z42"), _e2eDeclLibSrc());
    string toml = Path.Join(prjDir, "dvdecl.z42.toml");

    // ① 对照：lib + 合法取值 → 照样编过（否则下面三格的红说明不了任何事）。
    File.WriteAllText(toml, _e2eDeclToml("lib", "{ version = \"0.1.0\", deploy = \"shared\" }", ""));
    ProcessResult b1 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(toml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (b1.ExitCode != 0) {
        Console.WriteLine("  ✗ deploy 声明: lib + 合法 deploy 竟构建失败（对照格坏了）: " + b1.Stdout + b1.Stderr);
        return 1;
    }

    // ② lib 里的非法取值 —— 改前这格静默通过。
    File.WriteAllText(toml, _e2eDeclToml("lib", "{ version = \"0.1.0\", deploy = \"Copy\" }", ""));
    ProcessResult b2 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(toml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string a2 = b2.Stdout + b2.Stderr;
    if (b2.ExitCode == 0 || a2.IndexOf("不是合法取值") < 0) {
        Console.WriteLine("  ✗ deploy 声明: **lib** 工程里的非法取值没被拒绝 —— 校验只对 exe 生效: " + a2);
        return 1;
    }

    // ③ analyzer 工程的依赖写 deploy（取值合法，但在编译期扩展上没有意义）。
    File.WriteAllText(toml, _e2eDeclToml("analyzer", "{ version = \"0.1.0\", deploy = \"copy\" }", ""));
    ProcessResult b3 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(toml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string a3 = b3.Stdout + b3.Stderr;
    if (b3.ExitCode == 0 || a3.IndexOf("kind = \"analyzer\"") < 0) {
        Console.WriteLine("  ✗ deploy 声明: analyzer 工程的依赖写 deploy 没被拒绝: " + a3);
        return 1;
    }

    // ④ `[analyzers]` 条目写 deploy。
    File.WriteAllText(toml, _e2eDeclToml("lib", "\"0.1.0\"",
        "\n[analyzers]\n\"some.handler\" = { version = \"0.1.0\", deploy = \"copy\" }\n"));
    ProcessResult b4 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(toml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string a4 = b4.Stdout + b4.Stderr;
    if (b4.ExitCode == 0 || a4.IndexOf("[analyzers]") < 0) {
        Console.WriteLine("  ✗ deploy 声明: [analyzers] 条目写 deploy 没被拒绝: " + a4);
        return 1;
    }

    Console.WriteLine("  ✓ deploy 声明校验对所有 kind 生效：lib 的 typo、analyzer 工程、[analyzers] 条目都被拒");
    return 0;
}

// ── 按名/产物引用的**传递闭包**（add-deployment-model 批 2.2 use）────────────────────────
//
// **守的是什么**：`app → mid → leaf` 时 `leaf` 也得随产物走。
//
// 此前只搬直接依赖：`dist/` 里只有 `mid.zpkg`，拷到别处运行会**死在 mid 的方法里**
// （`MissingSymbolException: type NcLeaf.Deep`）—— 症状位置离原因很远，报的是「mid 的代码有问题」，
// 而实际是「打包漏了 leaf」。
//
// 依赖名从 **zpkg 的 DEPS 段**读（`ReadDependencies`，#826 support），不是源码树的 toml ——
// 那条路在 repo 外整个失效（publisher 今天就是那样，见 tasks 批 2）。
//
// ⭐ path 依赖的闭包早由 #811 搬齐，这一格补的是**按名/产物引用**那一半。
string _e2eClosureLeafSrc() { return "namespace NcLeaf;\n\npublic class Deep { public string Who() { return \"leaf\"; } }\n"; }
string _e2eClosureMidSrc()  { return "namespace NcMid;\n\nusing NcLeaf;\n\npublic class Mid { public string Call() { return new Deep().Who(); } }\n"; }
string _e2eClosureAppSrc()  { return "namespace NcApp;\n\nusing Std.IO;\nusing NcMid;\n\nvoid Main() { Console.WriteLine(new Mid().Call()); }\n"; }

string _e2eClosureLibToml(string name, string dep) {
    string s = "[project]\nname    = \"" + name + "\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n"
             + "[sources]\ninclude = [\"src/*.z42\"]\n";
    if (dep.Length > 0) { s = s + "\n[dependencies]\n\"" + dep + "\" = \"0.1.0\"\n"; }
    return s;
}

int _e2eNamedClosureChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp  = Path.Join("/tmp", "z42c-e2e-closure");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }
    string libsDir = Path.Join(tmp, "libs");
    string vendor  = Path.Join(tmp, "vendor");
    string leafDir = Path.Join(tmp, "leafsrc");
    string midDir  = Path.Join(tmp, "midsrc");
    string appDir  = Path.Join(tmp, "app");
    Directory.Create(libsDir); Directory.Create(vendor); Directory.Create(appDir);
    Directory.Create(Path.Join(leafDir, "src")); Directory.Create(Path.Join(midDir, "src"));
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si]))); si = si + 1; }

    // leaf → 建好后临时放进 libs（mid 编译期要解析它）。
    File.WriteAllText(Path.Join(Path.Join(leafDir, "src"), "Leaf.z42"), _e2eClosureLeafSrc());
    File.WriteAllText(Path.Join(leafDir, "ncleaf.z42.toml"), _e2eClosureLibToml("ncleaf", ""));
    ProcessResult lb = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build")
        .Arg(Path.Join(leafDir, "ncleaf.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (lb.ExitCode != 0) { Console.WriteLine("  ✗ 传递闭包: leaf 编译失败: " + lb.Stderr); return 1; }
    File.Copy(Path.Join(Path.Join(leafDir, "dist"), "ncleaf.zpkg"), Path.Join(libsDir, "ncleaf.zpkg"));

    // mid（依赖 leaf）。
    File.WriteAllText(Path.Join(Path.Join(midDir, "src"), "Mid.z42"), _e2eClosureMidSrc());
    File.WriteAllText(Path.Join(midDir, "ncmid.z42.toml"), _e2eClosureLibToml("ncmid", "ncleaf"));
    ProcessResult mb = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build")
        .Arg(Path.Join(midDir, "ncmid.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (mb.ExitCode != 0) { Console.WriteLine("  ✗ 传递闭包: mid 编译失败: " + mb.Stderr); return 1; }

    // 两个都挪进 vendor（离开 libs/）⇒ 它们是「非框架依赖」，该随产物走。
    File.Copy(Path.Join(Path.Join(midDir, "dist"), "ncmid.zpkg"), Path.Join(vendor, "ncmid.zpkg"));
    File.Copy(Path.Join(libsDir, "ncleaf.zpkg"), Path.Join(vendor, "ncleaf.zpkg"));
    File.Delete(Path.Join(libsDir, "ncleaf.zpkg"));

    // app 只声明 mid —— leaf 是**间接**依赖，用户不该被要求声明它。
    File.WriteAllText(Path.Join(appDir, "app.z42"), _e2eClosureAppSrc());
    string appToml = Path.Join(appDir, "ncapp.z42.toml");
    File.WriteAllText(appToml,
        "[project]\nname    = \"ncapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
        + "entry   = \"NcApp.Main\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
        + "[dependencies]\n\"ncmid\" = { path = \"../vendor/ncmid.zpkg\" }\n");
    ProcessResult ab = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(appToml).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (ab.ExitCode != 0) { Console.WriteLine("  ✗ 传递闭包: app 编译失败: " + ab.Stderr); return 1; }

    string distDir = Path.Join(appDir, "dist");
    if (!File.Exists(Path.Join(distDir, "ncmid.zpkg"))) {
        Console.WriteLine("  ✗ 传递闭包: 直接依赖都没进 dist —— 基线就坏了");
        return 1;
    }
    if (!File.Exists(Path.Join(distDir, "ncleaf.zpkg"))) {
        Console.WriteLine("  ✗ 传递闭包: **间接**依赖 ncleaf 没随产物走 —— 拷出去会死在 mid 的方法里");
        return 1;
    }
    // 对照：产物真能跑（leaf 在 libs/ 里已被删，只能从 dist 解析到）。
    ProcessResult rr = new Process(vm).Arg(Path.Join(distDir, "ncapp.zpkg")).Env("Z42_LIBS", libsDir)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (rr.ExitCode != 0 || rr.Stdout.IndexOf("leaf") < 0) {
        Console.WriteLine("  ✗ 传递闭包: 文件都在却跑不起来（rc=" + rr.ExitCode.ToString()
            + " stdout=" + rr.Stdout + " stderr=" + rr.Stderr + "）");
        return 1;
    }

    Console.WriteLine("  ✓ 传递闭包：间接依赖随产物走，两层链拷出去照样跑");
    return 0;
}
