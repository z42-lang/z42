// xtask — `build compiler` / `test compiler`：z42c 自建（z42c builds z42c，src/compiler → artifacts/build/compiler）
// 与测试（产物存在性 + [Test] 单元 + e2e 夹具 + 自举不动点）。
// 自举纪律、破环预建、运行期 / 编译期 libs 分离的设计见 docs/internals/src/compiler/self-hosting.md。
namespace Z42Xtask;

using Std.IO;
using Std.Time;

// z42c 自建走自种子路径：种子 = 现有 canonical z42c dist；冷树由 `_ensureSeed` 从 SDK 供种。
int _buildCompiler() {
    string root = _root();
    string profile = "release";
    Stopwatch sw = _procStart("build compiler (z42c self-build)");
    int sc0 = _ensureSeed(root); if (sc0 != 0) { return sc0; }   // warm no-op / cold: stage SDK seed → in-tree
    int rc = _buildRuntime(); if (rc != 0) { return rc; }   // cargo release z42vm 跑种子 driver
    string vm = _builtVm(root, "release");
    string stdlibFlat = _libsFlatDist(root, profile);
    if (!File.Exists(Path.Join(stdlibFlat, "z42.core.zpkg"))) {
        int sc = _buildStdlib(); if (sc != 0) { return sc; }
    }
    string[] members = _compilerMembers(root);
    int r = _buildCompilerViaZ42c(root, profile, members, vm, stdlibFlat);
    if (r == 0) { _procEnd("build compiler (z42c self-build)", sw); }
    return r;
}

// 把其余编译器成员的 zpkg 复制进 z42c.driver 的 dist，使 driver **自包含**
// （可直接跑，兄弟包从自身目录解析，Z42_LIBS 只需 stdlib）。幂等（删+拷覆盖）。
// z42c build(exe) 本身会 bundle；此处对种子 / 旧版 z42c 建的 driver 兜底，保证下游一律跑自包含 driver。
//
// 🔴 **zpkg 与 zsym 成对拷**：只拷 zpkg 会留下上一代的 zsym ⇒ 加载时 `build_id mismatch` WARN，
// 且 driver bundle 与成员 dist 不再是同一份产物。
void _ensureDriverSelfContained(string root, string profile, string[] members) {
    string driverDist = _driverDist(root, profile);
    foreach (var m in members) {
        if (m == "z42c.driver") { continue; }
        string memberDist = _compilerMemberDist(root, m, profile);
        if (memberDist != driverDist) { _copyZpkgPair(memberDist, driverDist, m); }
    }
    // 破环窗口：`_ensureBootstrapSelfDepLibs` 刚把**当前源**的前端（z42c.core / z42c.syntax）预建进 flat，
    // 比成员 dist 里上一代的新 ⇒ 用它，让 workspace 自建（及其重试）用的 driver 认得当前源新增的前端符号
    // （缺了就是冷启动 semantics 报 `undefined type`、重试也收敛不了）。自建完成后预建包已从 flat 清走
    // （`_purgeBootstrapPrebuildsFromFlat` 在最后一次自包含之前），这里自然不起作用 ⇒ 最终 bundle = 成员产物。
    string flat = _libsFlatDist(root, profile);
    _copyZpkgPair(flat, driverDist, "z42c.core");
    _copyZpkgPair(flat, driverDist, "z42c.syntax");
}

// <name>.zpkg + 同名 .zsym 从 srcDir 拷到 dstDir（各自存在才拷；先删后拷，断开可能的硬链）。
void _copyZpkgPair(string srcDir, string dstDir, string name) {
    _copyIfNewer(Path.Join(srcDir, name + ".zpkg"), Path.Join(dstDir, name + ".zpkg"));
    _copyIfNewer(Path.Join(srcDir, name + ".zsym"), Path.Join(dstDir, name + ".zsym"));
}

// 备种子 driver 的运行期 libs（run-libs）= 它那一代的 stdlib 锚（`_driverGenLibs`），同时把成员 dist 清成
// 「只有成员」（老 driver 建的 dist 里 colocated 的外部包副本一并搬进 run-libs）。两个理由（详见 self-hosting.md
// 「运行期 libs 与编译期 libs 分离」）：
//
// ① 运行期（代际锚）：本轮 flat 会被 `_ensureBootstrapSelfDepLibs` 覆盖成当前源，快照晚于覆盖就拿到新代，
//    种子 driver 随即 `MissingSymbolException` ⇒ **本轮的 flat 不能当「代」的锚**。锚在自建成功那一刻记
//    （`_snapshotDriverGenLibs`），与 driver 同代是构造保证。
//
// ② 编译期（遮蔽）：z42c 的 workspace 解析面是「全成员 dist + 外部档」，按 basename 命中、成员 dist 在前 ⇒
//    成员 dist 里上一代的外部包副本会遮蔽 flat 里当前源的新版（命名空间改名后报 `E0494: 命名空间 … 不存在`）。
//    ⚠️ 新旧两份可能**同尺寸**，只核对文件大小会被骗过去；判别看 zsym 的 STRS 段，且命名空间按**段**存
//       （`\x03Z42\x07Package`），整串在二进制里 grep 不到。
//    根因（解析分档按 basename 混档）该修在 z42c 侧，但跑自建的是种子 driver、修法要跨一个 nightly 才生效，
//    故编排侧先解。
//
// 搬空后由调用方 `_ensureDriverSelfContained` 把成员 + fresh 前端补回 driver bundle（前端与 flat 同代 ⇒ 不遮蔽）。
// 返回搬了几个；0 = 既无锚也无 bundle（冷启动刚从 SDK 供种，`_ensureSeed` 已作废旧锚）。
int _relocateSeedRunLibs(string root, string profile, string[] members, string dst) {
    _resetDir(dst);
    int moved = 0;
    foreach (var m in members) {
        string dist = _compilerMemberDist(root, m, profile);
        if (!Directory.Exists(dist)) { continue; }
        foreach (var hit in Path.Glob(dist, "*.zpkg")) {
            string name = Path.GetFileNameWithoutExtension(hit);
            if (_strIn(members, name)) { continue; }   // 成员产物归成员 dist，不碰
            _moveZpkgPair(dist, dst, name);
            moved = moved + 1;
        }
    }
    // 锚：driver 那一代编译时对着的 stdlib。z42c 不把 stdlib 复制进 exe 的 dist（判为框架），所以锚由 xtask 自己记。
    // 上面搬出来的与锚同代，已在的不覆盖。
    string anchor = _driverGenLibs(root, profile);
    if (Directory.Exists(anchor)) {
        foreach (var g in Path.Glob(anchor, "*.zpkg")) {
            string name = Path.GetFileNameWithoutExtension(g);
            if (File.Exists(Path.Join(dst, name + ".zpkg"))) { continue; }
            _copyZpkgPair(anchor, dst, name);
            moved = moved + 1;
        }
    }
    return moved;
}

// 自建刚产出的 driver 编译时对着的 stdlib = 此刻 flat 里的 stdlib 成员 ⇒ 快照进 `_driverGenLibs`，作为下一次
// 用它当种子时的运行期 libs（代际锚，见 `_relocateSeedRunLibs` 头注）。每次自建成功都重取（锚必须跟 driver 同代）。
void _snapshotDriverGenLibs(string root, string profile, string stdlibFlat) {
    string[] libs = _stdlibList(root);
    if (libs.Length == 0) { return; }   // 读不到成员清单就不记：缺锚回落 SDK 补齐，好过记一份错的
    string anchor = _driverGenLibs(root, profile);
    _resetDir(anchor);
    foreach (var lib in libs) { _copyZpkgPair(stdlibFlat, anchor, lib); }
}

// <name>.zpkg + 同名 .zsym 从 srcDir 搬到 dstDir（先拷后删；dst 已存在则覆盖）。
void _moveZpkgPair(string srcDir, string dstDir, string name) {
    foreach (var ext in new string[]{ ".zpkg", ".zsym" }) {
        string src = Path.Join(srcDir, name + ext);
        string dst = Path.Join(dstDir, name + ext);
        if (!File.Exists(src)) { continue; }
        if (File.Exists(dst)) { File.Delete(dst); }
        File.Copy(src, dst);
        File.Delete(src);
    }
}

// 用种子那一代的 libs（`_seedLibsSource`：启动时的 `Z42_LIBS` 优先、其次 SDK）补齐 run-libs 的缺口。
// 锚 / bundle 是主来源（与 driver 同代），但可能不完整（冷启动刚从 SDK 供种的 driver 没有 bundle；清理过的树
// 只剩零星几个）——判据是「**齐了吗**」而非「搬到了吗」。不无条件取 SDK：格式 bump 在飞时 SDK 还是上一代
// 格式、会被 strict-pin 拒收（见 `_seedLibsSource` 头注）。
int _topUpSeedRunLibs(string root, string dst, string[] members) {
    string sdkLibs = _seedLibsSource(root);
    if (sdkLibs.Length == 0) { return 0; }
    // 来源目录打进日志：一眼可判是走了 `Z42_LIBS` 还是回落了 SDK。
    _vNormal("  run-libs 缺口来源: " + sdkLibs);
    int filled = 0;
    foreach (var hit in Path.Glob(sdkLibs, "*.zpkg")) {
        string name = Path.GetFileNameWithoutExtension(hit);
        if (_strIn(members, name)) { continue; }
        if (File.Exists(Path.Join(dst, name + ".zpkg"))) { continue; }   // bundle 已提供 = 更可信
        _copyZpkgPair(sdkLibs, dst, name);
        filled = filled + 1;
    }
    return filled;
}

// 既无 bundle 也无 SDK 的末路回落：flat。改命名空间 / 删符号类变更在这种树上救不了，明说而不是静默走错代。
void _seedRunLibsFallbackFlat(string root, string profile, string dst, string stdlibFlat) {
    _copyAll(stdlibFlat, dst, "*.zpkg");
    _copyAll(stdlibFlat, dst, "*.zsym");
    _vNormal("  ⚠ seed run-libs ← flat（既无 bundle 也无 SDK libs）——改命名空间/删符号类变更在这种树上救不了");
}

// 覆盖复制（存在即删后拷，断开可能的硬链）；src 不存在则跳过（冷启动首刷时 libraries dist 可能尚未产出前端库，
// 由 _ensureBootstrapSelfDepLibs 建好后的重试刷再命中）。
void _copyIfNewer(string src, string dst) {
    if (File.Exists(src) && src != dst) {
        if (File.Exists(dst)) { File.Delete(dst); }
        File.Copy(src, dst);
    }
}

// z42c self-build：用现有 z42c.driver.zpkg 作种子编译器，一句 `build --workspace` 按拓扑序重建全部编译器成员到
// 各自 dist。driver 先自包含化 → 直接跑；`stdlibFlat` 作 Z42_LIBS（编译期依赖面），种子 driver 运行期的 Std.*
// 走 seed run-libs（见下）。
int _buildCompilerViaZ42c(string root, string profile, string[] members, string vm, string stdlibFlat) {
    _vNormal("  building z42c via z42c (--workspace)");
    _ensureDriverSelfContained(root, profile, members);   // 种子 driver 自包含 → 可直接跑
    string driver = _driverZpkg(root, profile);
    // ── 按 driver 的「代」分开运行期 / 编译期 libs ──
    // 这里跑的是**上一代** driver：运行期要加载那一代的 stdlib（`seedRun`，挂成运行期 probing），编译期要解析
    // **当前源**新建的库（flat 作 `Z42_LIBS`，见 `_z42cProcSeed`）。两者共用 flat 时，预建一覆盖、种子 driver
    // 自己就崩（改名 / 删符号必踩）。driver 换代之后的步骤只用 flat。锚为何不取 flat 见 `_relocateSeedRunLibs` 头注。
    string seedRun = _seedRunLibs(root, profile);
    int movedLibs = _relocateSeedRunLibs(root, profile, members, seedRun);
    int filledLibs = _topUpSeedRunLibs(root, seedRun, members);
    if (movedLibs + filledLibs > 0) {
        _vNormal("  seed run-libs ← driver 代际锚/bundle " + movedLibs.ToString()
                 + " + SDK 补齐 " + filledLibs.ToString() + "（外部包搬出成员 dist）");
    } else {
        _seedRunLibsFallbackFlat(root, profile, seedRun, stdlibFlat);
    }
    // 冷启动破 z42c⇄z42.package 环（须在 workspace build 前）。失败即判红，见 `_prebuildOne`。
    if (_ensureBootstrapSelfDepLibs(root, vm, driver, stdlibFlat, seedRun) != 0) { return 1; }
    // 预建刚把当前源的库写进 flat ⇒ 此刻把成员 + **fresh** 前端补回 driver bundle
    // （与 flat 同代 ⇒ 不遮蔽；外部包已搬进 run-libs，不再回到成员 dist）。
    _ensureDriverSelfContained(root, profile, members);
    string compilerDir = Path.Join(root, "src/compiler");
    int rc = _z42cWorkspaceBuild(vm, driver, compilerDir, stdlibFlat, false, seedRun);
    // 跨成员符号新增（如 z42c.syntax 新增类型被 z42c.semantics 消费）的冷启动收敛：自包含时 bundle 的是 dist 里的
    // **旧**兄弟包，driver 用它解析 `Z42.Syntax.*` ⇒ 消费成员首遍 `no field` / `undefined type`。首遍已按拓扑序把
    // 兄弟 dist 建 fresh ⇒ 重新自包含 + 重试一遍即收敛；真编译错重试仍失败。常规构建首遍即过。
    if (rc != 0) {
        _vNormal("  self-build 首遍失败 → 用本轮 fresh 成员 dist 重新自包含 driver + 重试（跨成员符号新增冷启动收敛）");
        _ensureDriverSelfContained(root, profile, members);
        // 重试仍用种子代 driver ⇒ 同样分开两个面。
        rc = _z42cWorkspaceBuild(vm, driver, compilerDir, stdlibFlat, false, seedRun);
    }
    if (rc != 0) { ConsoleError.WriteLine("  ✗ z42c --workspace self-build failed"); return 1; }
    _snapshotDriverGenLibs(root, profile, stdlibFlat);
    // 先清 flat 里的破环预建，再做最后一次自包含：反过来的话，`_ensureDriverSelfContained` 会把 flat 里
    // **单包预建**的 z42c.core / z42c.syntax 盖在刚自建出的成员产物上 ⇒ 新 driver 带的前端与成员 dist 不是同一份。
    _purgeBootstrapPrebuildsFromFlat(root, stdlibFlat);
    _ensureDriverSelfContained(root, profile, members);   // 新 gen driver 自包含 = 成员产物
    return 0;
}

// 破环预建（`_ensureBootstrapSelfDepLibs`）往 flat 写的编译器域包只服务上面那次 workspace 自建，自建完成即清走，
// 让 flat 回到规范形态 = **只有 stdlib 成员**（同 `build stdlib` 末步 `_assembleStdlibFlatView`）。
// flat = 开发树的 `Z42_LIBS`：留着的话，用开发树工具链编的工程会把 `z42.project` 等判成「框架包」（不复制 ⇒
// 运行期 `MissingSymbolException`），`deploy = "sdk"` 的校验也会误判。这些包在各自成员 dist 里都有，清掉不丢东西；
// `z42.core` 是 stdlib 成员，留着。
void _purgeBootstrapPrebuildsFromFlat(string root, string stdlibFlat) {
    string[] libs = _stdlibList(root);
    if (libs.Length == 0) { return; }   // 读不到成员清单就不动：宁可留脏，不可误删 stdlib
    int purged = 0;
    foreach (var f in Path.Glob(stdlibFlat, "*")) {
        if (!(f.EndsWith(".zpkg") || f.EndsWith(".zsym"))) { continue; }
        if (_strIn(libs, Path.GetFileNameWithoutExtension(f))) { continue; }
        try { File.Delete(f); purged = purged + 1; } catch (Exception e) { /* best-effort，同 _cleanGlob */ }
    }
    if (purged > 0) { _vNormal("  flat 清走破环预建的非 stdlib 包 " + purged.ToString() + " 个（回到规范形态）"); }
}

// 破环预建清单（**序 = 依赖序**；断链 / 预建 / 日志同读这一份，加一项 = 这里加一行）。
// 成员 = z42c 自依赖链上须先于 workspace 自建 fresh 进 flat 的当前源库：
//   z42.core      一切的地基（隐式 prelude）；z42c 的消费面含其新增门面（如 Std.BitConverter）
//   z42.project   轴②：driver 编译期消费 ProjectManifest 的 [plugins] 段字段
//   z42.build     轴②：z42c.pipeline 编译期消费 IReplCompiler / ReplCompileResult
//   z42.package   轴④主环：z42c **运行期**依赖（IR 模型 + zbc/zpkg 后端，ZpkgBuilder）
//   z42c.core     可移植前端，semantics/pipeline/driver 的共享库依赖
//   z42c.syntax   同上（依赖 z42c.core，排其后）
// 轴② / 轴④ 与「不 warm-skip」的理由见 self-hosting.md「轴 ④ 的破环预建」。序内约束：z42.build 依赖
// z42.project；z42c.syntax 依赖 z42c.core；z42.package 与 z42.project / z42.build 互不依赖（相对序可换）。
// 各包真实 import 关系见 src/compiler/z42.workspace.toml 头注。
string[] _bootstrapPrebuilds() {
    return new string[]{ "z42.core", "z42.project", "z42.build", "z42.package", "z42c.core", "z42c.syntax" };
}

// 破环预建成员的 toml，按目录约定探测：stdlib 域在 src/libraries/，编译器域在 src/compiler/
// （物理位置即域声明）。清单成员必居其一；探测不到时 `_prebuildOne` 以「no zpkg produced」判红。
string _bootstrapToml(string root, string name) {
    string libToml = Path.Join(root, "src/libraries/" + name + "/" + name + ".z42.toml");
    if (File.Exists(libToml)) { return libToml; }
    return Path.Join(root, "src/compiler/" + name + "/" + name + ".z42.toml");
}

// 冷启动破环（self-hosting.md「轴 ④ 的破环预建」）：z42c 运行期依赖 z42.package 等自依赖库，而它们由 z42c 构建。
// workspace 自建前先用当前 driver（冷启动 = 上一 nightly 种子）把**当前源**的这些库按 `_bootstrapPrebuilds` 序编进
// flat，fresh z42c 才对着真库编译 + 运行（否则 z42c 消费新 API 时编译期 `unknown type`；emit 的调用钉在种子自带的
// 旧库上时运行期 `undefined function`）。
// **不 warm-skip**：「已在 flat 就跳过」等价于假设 z42c 不消费这些库的新 API，不成立；源未变时增量缓存近零成本。
// `runLibs` = 种子代运行期 libs（driver 自己加载用）；`stdlibFlat` = 产物落点 + 编译期解析面。
int _ensureBootstrapSelfDepLibs(string root, string vm, string driver, string stdlibFlat,
                                 string runLibs) {
    string[] prebuilt = _bootstrapPrebuilds();
    _vNormal("  bootstrap: (re)building current-source " + String.Join(" + ", prebuilt)
             + " into build-libs（破 z42c⇄stdlib 轴④环）");
    // 🔴 先断链再写：flat 由 `_assembleStdlibFlatView` 从成员 dist 硬链接装配，z42c 就地写产物 ⇒ 直接写 flat 会
    // 穿透到规范 dist，随后 `build stdlib` 增量命中就把这份对着种子 run-libs 编的预建版当规范产物留下（DEPS 成环、
    // 字节逐代翻转）。断链 = 内容复制成独立 inode（预建失败时 flat 照旧可用）。
    foreach (var p in prebuilt) {
        _breakHardLink(Path.Join(stdlibFlat, p + ".zpkg"));
        _breakHardLink(Path.Join(stdlibFlat, p + ".zsym"));
    }
    // 逐个按清单序预建（每项进 flat 的理由与序约束见 `_bootstrapPrebuilds` 头注）。
    foreach (var p in prebuilt) {
        if (_prebuildOne(vm, driver, _bootstrapToml(root, p), p, runLibs, stdlibFlat) != 0) { return 1; }
    }
    return 0;
}

// 预建一个包进 flat。**失败即判红**：继续下去 workspace 自建会对着 flat 里的旧包编——成功也是错的组合，失败报的
// 是下游无关错误。
// 判据是「产物写出来没有」而非退出码：先输出到干净临时目录，产物在 ⇒ 拷进 flat。存在而退出码非零只警告——旧
// nightly 的 z42c 在 Windows 上会在写完 zpkg 之后写增量缓存时崩（os error 3），产物是好的（CI ci-bootstrap 同口径）。
// 不直接写 flat 再删旧文件：run-libs 回落到 flat 时（`_seedRunLibsFallbackFlat`），正在跑的 driver 自己也从这里加载库。
int _prebuildOne(string vm, string driver, string toml, string name, string runLibs, string stdlibFlat) {
    string tmp = Path.Join(Path.GetDirectoryName(stdlibFlat), ".prebuild-" + name);
    _resetDir(tmp);
    int rc = _z42cBuildPackage(vm, driver, toml, stdlibFlat, tmp, runLibs);
    string built = Path.Join(tmp, name + ".zpkg");
    if (!File.Exists(built)) {
        ConsoleError.WriteLine("  ✗ bootstrap: build " + name + " failed (" + rc.ToString() + ") — no " + name + ".zpkg produced");
        return 1;
    }
    if (rc != 0) {
        ConsoleError.WriteLine("  ⚠ bootstrap: build " + name + " exited " + rc.ToString() + " but wrote " + name + ".zpkg (tolerated: seed crashed after writing)");
    }
    File.Copy(built, Path.Join(stdlibFlat, name + ".zpkg"));
    string sym = Path.Join(tmp, name + ".zsym");
    if (File.Exists(sym)) { File.Copy(sym, Path.Join(stdlibFlat, name + ".zsym")); }
    Directory.Delete(tmp, true);
    return 0;
}

// 防 zpkg 格式版本 skew 假失败：单独跑 `test compiler` 时，若某变更 bump 了 zpkg 格式而 z42vm 停在旧版，加载期会把
// 每个单元判成 "cannot read zpkg metadata"。故显式重建 z42vm；z42b 由 `_testCompilerUnits` 用当前 z42c 重建
// （cached 时近 no-op）。
int _ensureCompilerTooling() {
    Console.WriteLine("  ensuring tooling fresh (z42vm; release)");
    return _buildRuntime();   // z42vm（z42b 运行所需的当前格式 reader）
}

// 产物存在性 smoke + [Test] 单元 + e2e 夹具 + 自举不动点。成员清单取 workspace 的 default_members（单一事实源，
// 同 _stdlibList）。noBuild=true：调用方（`test`）已在构建波里建过 z42c，跳过重建；单独 `test compiler` 传 false。
int _testCompiler(bool noBuild) {
    Stopwatch sw = _procStart("test compiler");
    if (!noBuild) {
        int tc = _ensureCompilerTooling();
        if (tc != 0) { return tc; }
        int bc = _buildCompiler();
        if (bc != 0) { return bc; }
    }

    string root = _root();
    string profile = "release";
    string[] members = _compilerMembers(root);

    int fail = _verifyMemberZpkgs(_compilerWsToml(root), members, profile);
    int ok = members.Length - fail;

    Console.WriteLine("");
    Console.WriteLine("test compiler: " + ok.ToString() + "/"
        + members.Length.ToString() + " zpkg present");
    if (fail > 0) { return 1; }

    // ── z42c [Test] units ────────────────────────────────────────────────
    int __rc = _testCompilerUnits(root, profile, members);
    if (__rc == 0) { _procEnd("test compiler", sw); }
    return __rc;
}

// 逐个编 + 跑 z42c 的 [Test] 单元（经 z42b）。
// 解析面：Z42_LIBS = 纯 stdlib flat。编译期，单元按名声明的编译器包由 driver 从编译器目录解析；运行期，z42b 及它为
// 每个 [Test] 方法 fork 的子 VM 经 `_z42bProc` 拿到各编译器成员 dist。不把 stdlib + 编译器成员拼进一个目录当
// Z42_LIBS：编译器 dist 里的 stdlib 副本会遮蔽新 stdlib。
// 单元布局：src/compiler/<member>/tests/<unit>/{<name>.z42.toml + *.z42}，kind=lib；z42.harness 自动可用。
int _testCompilerUnits(string root, string profile, string[] members) {
    string flat = _libsDir(root);   // 纯 stdlib；编译器包见上方头注

    string vm     = _builtVm(root, "release");
    string driverZpkg = _driverZpkg(root, profile);
    // 单元经 z42b 跑；这里建 z42b（已是最新时增量命中）。
    string builderZpkg = _toolchainZpkg(root, _z42bToml());
    int bc = _buildZ42bWith(root, vm, driverZpkg, flat);
    if (bc != 0) { return bc; }

    int totalFailed = 0;
    int totalUnits = 0;
    foreach (var member in members) {
        string testsDir = Path.Join(root, "src/compiler/" + member + "/tests");
        if (Directory.Exists(testsDir)) {
            foreach (var unit in _sortedStrings(Directory.Enumerate(testsDir))) {
                string unitDir = Path.Join(testsDir, unit);
                if (!Directory.Exists(unitDir)) { continue; }
                string[] tomls = Path.Glob(unitDir, "*.z42.toml");
                if (tomls.Length == 0) { continue; }
                totalUnits = totalUnits + 1;
                Console.WriteLine("");
                Console.WriteLine("── z42c test: " + member + " / " + unit + " ──");
                // compile (release/packed) with z42c；stdlib 从 flat、单元声明的编译器包从编译器目录解析；
                // 输出落单元 toml 的 [build] output_dir 镜像。
                // 编译器目录由 _z42cProc 显式指向本树刚建的 driver dist（不指时单元会对着种子 SDK 里的旧编译器包编）。
                ProcessResult br = _z42cProc(vm, flat, driverZpkg)
                    .Arg("build").Arg(tomls[0]).Arg("--release")
                    .Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit()).Run();
                if (br.ExitCode != 0) {
                    Console.WriteLine("  ✗ compile failed: " + unit);
                    totalFailed = totalFailed + 1;
                    continue;
                }
                // 产物经单元 toml 的 [build] output_dir 落到镜像：
                //   src/compiler/<member>/tests/<unit> → artifacts/build/compiler/<member>/release/tests/<unit>/dist
                string mirrorDist = Path.Join(
                    Path.Join(_compilerBuildRoot(root), member + "/release/tests/" + unit),
                    "dist");
                string[] zps = Path.Glob(mirrorDist, "*.zpkg");
                // 编译成功却在镜像里找不到产物 ⇒ 判失败：否则路径错位会表现成「跑了 0 个、全部通过」的假绿。
                if (zps.Length == 0) {
                    Console.WriteLine("  ✗ no zpkg produced at " + mirrorDist);
                    totalFailed = totalFailed + 1;
                    continue;
                }
                // Run each produced test zpkg through z42b's runner, which discovers the
                // [Test] functions by runtime reflection.
                foreach (var zp in zps) {
                    int rc = _z42bProc(vm, flat)
                        .Arg("--mode").Arg(_z42cMode()).Arg(builderZpkg)
                        .Arg("--").Arg("test").Arg(zp)
                        .Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit()).Run().ExitCode;
                    if (rc != 0) { totalFailed = totalFailed + 1; }
                }
            }
        }
    }

    Console.WriteLine("");
    if (totalFailed > 0) {
        Console.WriteLine("❌ z42c [Test]: " + totalFailed.ToString() + " unit(s) failed (of "
            + totalUnits.ToString() + ")");
        return 1;
    }
    Console.WriteLine("✅ z42c [Test]: all " + totalUnits.ToString() + " unit(s) passed (compiled + run)");
    int ec = _testCompilerE2e(root, vm, flat);
    if (ec != 0) { return ec; }
    return _testSelfHostByteIdentical(root, vm, members, profile);
}

// Self-host 不动点：gen1 = 现有 canonical dist（`build compiler` 的 `--workspace` 产物）；gen2 = 用 gen1 自己的
// driver 再跑一遍同参 `--workspace` → 覆盖 canonical dist，应逐段等于 gen1 快照（BLID 除外）。
// gen1 / gen2 必须同路径：单包 + 胖 flat 构建会拉入更大且非确定的依赖闭包（目录扫描序非确定），测不出不动点。
int _testSelfHostByteIdentical(string root, string vm, string[] members, string profile) {
    Console.WriteLine("");
    Console.WriteLine("── z42c self-host 不动点：--workspace 再建一遍应逐字节复现 ──");

    string driverZpkg = _driverZpkg(root, profile);
    string stdlibFlat = _libsFlatDist(root, profile);

    // gen1 快照：把现有 canonical dist 的各 <member>.zpkg 拷到独立目录（随后 gen2 会覆盖 canonical dist）。
    string snapDir = _compilerWsWork(root, "selfhost-gen1");
    _resetDir(snapDir);
    foreach (var m in members) {
        string src = _compilerMemberZpkg(root, m, profile);
        if (!File.Exists(src)) {
            Console.WriteLine("  ✗ gen1 missing (先跑 build compiler): " + src);
            return 1;
        }
        File.Copy(src, Path.Join(snapDir, m + ".zpkg"));
    }

    // gen2：用 gen1 的自包含 driver 再跑 --workspace → 覆盖 canonical dist。与 gen1
    // （_buildCompilerViaZ42c）**完全同参**由共用的 _z42cWorkspaceBuild 从结构上保证
    // （不动点 gen1==gen2 的前提）。
    _ensureDriverSelfContained(root, profile, members);
    int rc = _z42cWorkspaceBuild(vm, driverZpkg, Path.Join(root, "src/compiler"), stdlibFlat, true);   // gen2 必须真编，命中 cache 等于没测
    if (rc != 0) { Console.WriteLine("  ✗ gen2 --workspace 构建失败"); return 1; }
    _ensureDriverSelfContained(root, profile, members);

    int ok = 0;
    int fail = 0;
    foreach (var member in members) {
        byte[] want = File.ReadAllBytes(Path.Join(snapDir, member + ".zpkg"));  // gen1
        byte[] got = File.ReadAllBytes(                                          // gen2
            _compilerMemberZpkg(root, member, profile));
        // Section-level compare: ignore BLID (16B BLAKE3-128 build_id tail).
        if (!_sectionsEqualIgnoreBlid(got, want)) {
            Console.WriteLine("  ✗ sections mismatch: " + member + " (gen2 " + got.Length.ToString() + "B vs gen1 " + want.Length.ToString() + "B)");
            fail = fail + 1;
        } else {
            Console.WriteLine("  ✓ " + member + " (sections byte-identical, BLID ignored)");
            ok = ok + 1;
        }
    }

    Console.WriteLine("");
    if (fail > 0) {
        Console.WriteLine("❌ z42c self-host 不动点: " + fail.ToString() + "/" + members.Length.ToString() + " packages gen1≠gen2");
        return 1;
    }
    Console.WriteLine("✅ z42c self-host 不动点: " + ok.ToString() + "/" + members.Length.ToString() + " packages gen1==gen2 (--workspace)");
    return 0;
}

// Compare zpkg files section-by-section, ignoring BLID (deferred in z42c).
// Header: "ZPK\0"[4]+major[2]+minor[2]+flags[2]+secCount[2]+reserved[4] = 16B.
// Directory: secCount * 12B (tag[4]+offset[4]+size[4]), starting at byte 16.
// BLID = bytes [66,76,73,68] ('B','L','I','D' in ASCII).
bool _sectionsEqualIgnoreBlid(byte[] got, byte[] want) {
    if (got.Length < 16 || want.Length < 16) { return false; }
    int gotSec  = _zpkgU16(got, 10);
    int wantSec = _zpkgU16(want, 10);
    // For each section in got, find matching section(s) in want and compare data
    for (int gi = 0; gi < gotSec; gi = gi + 1) {
        int gd   = 16 + gi * 12;
        int goff = _zpkgU32(got, gd + 4);
        int gsiz = _zpkgU32(got, gd + 8);
        bool found = false;
        for (int wi = 0; wi < wantSec; wi = wi + 1) {
            int wd = 16 + wi * 12;
            if (!_zpkgTagEq(got, gd, want, wd)) { continue; }
            found = true;
            if (_zpkgU32(want, wd + 8) != gsiz) { return false; }
            int woff = _zpkgU32(want, wd + 4);
            for (int bi = 0; bi < gsiz; bi = bi + 1) {
                if (got[goff + bi] != want[woff + bi]) { return false; }
            }
        }
        if (!found) { return false; }
    }
    // Verify want has no extra sections besides BLID
    for (int wi = 0; wi < wantSec; wi = wi + 1) {
        int wd = 16 + wi * 12;
        bool isBlid = want[wd] == 66 && want[wd+1] == 76 && want[wd+2] == 73 && want[wd+3] == 68;
        if (isBlid) { continue; }
        bool foundInGot = false;
        for (int gi = 0; gi < gotSec; gi = gi + 1) {
            if (_zpkgTagEq(got, 16 + gi * 12, want, wd)) { foundInGot = true; break; }
        }
        if (!foundInGot) { return false; }
    }
    return true;
}

// 4-byte section tag at a[ai..] == b[bi..].
bool _zpkgTagEq(byte[] a, int ai, byte[] b, int bi) {
    return a[ai] == b[bi] && a[ai+1] == b[bi+1] && a[ai+2] == b[bi+2] && a[ai+3] == b[bi+3];
}

int _zpkgU16(byte[] data, int off) {
    return (int)data[off] | ((int)data[off + 1] << 8);
}

int _zpkgU32(byte[] data, int off) {
    int lo = (int)data[off] | ((int)data[off+1] << 8);
    int hi = (int)data[off+2] | ((int)data[off+3] << 8);
    return lo | (hi << 16);
}
