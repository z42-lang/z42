// xtask — `build compiler` / `test compiler` impl
// (scaffold-z42c-selfhost, 2026-06-07).
//
// Builds the z42 self-host compiler workspace (src/compiler — 7 子包 1:1 镜像 C#
// bootstrap 的 7 项目) and smoke-tests that all 7 z42c.<sub>.zpkg are produced.
// Mirrors xtask_stdlib.z42 (_buildStdlib) but targets src/compiler →
// artifacts/build/compiler.
//
// NO Z42_LIBS needed: the C# z42c resolves declared workspace siblings from the
// CURRENT workspace — WorkspaceBuildOrchestrator threads each member's dist dir
// into BuildLibsDirs (scaffold-z42c-selfhost dogfood #1 root-cause fix). So a
// plain `build --workspace` finds z42c.core → z42c.syntax → … → z42c.driver.
//
// 0.3.x: this is opt-in soak (NOT in the default `test` GREEN gate). byte-identical
// 对账留待 0.3.3 起子系统有真实产物时上；本期只做 build + 产物存在性 smoke。
namespace Z42Xtask;

using Std.IO;
using Std.Time;

// z42c 自建走自种子路径（z42c builds z42c）。
// 种子 = 现有 canonical z42c dist（self-seed；clean/CI 由下载 nightly 提供）。
// 缺种子 → 明确报错指引 bootstrap。
int _buildCompiler() {
    string root = _root();
    string profile = "release";
    Stopwatch sw = _procStart("build compiler (z42c self-build)");
    int sc0 = _ensureSeed(root); if (sc0 != 0) { return sc0; }   // warm no-op / cold: stage SDK seed → in-tree
    int rc = _buildRuntime(); if (rc != 0) { return rc; }   // cargo release z42vm 跑种子 driver
    string vm = _builtVm(root, "release");
    string stdlibFlat = _libsFlatDist(root, profile);
    if (!File.Exists(Path.Join(stdlibFlat, "z42.core.zpkg"))) {
        int sc = _buildStdlib(); if (sc != 0) { return sc; }   // A1 warm 种子路径
    }
    string[] members = _compilerMembers(root);
    int r = _buildCompilerViaZ42c(root, profile, members, vm, stdlibFlat);
    if (r == 0) { _procEnd("build compiler (z42c self-build)", sw); }
    return r;
}

// 把 6 个非-driver member 的 zpkg 复制进 z42c.driver 的 dist，使 driver **自包含**
// （可直接跑，兄弟包从自身目录解析，Z42_LIBS 只需 stdlib）。幂等（删+拷覆盖）。
// z42c build(exe) 本已 bundle（simplify-compiler-build 阶段1）；此处对种子/旧版 z42c
// 建的 driver 兜底，保证下游一律跑自包含 driver，无需拼 colocated 目录。
void _ensureDriverSelfContained(string root, string profile, string[] members) {
    string driverDist = _driverDist(root, profile);
    int i = 0;
    while (i < members.Length) {
        string m = members[i];
        i = i + 1;
        if (m == "z42c.driver") { continue; }
        string src = _compilerMemberZpkg(root, m, profile);
        string dst = Path.Join(driverDist, m + ".zpkg");
        if (File.Exists(src) && src != dst) {
            if (File.Exists(dst)) { File.Delete(dst); }
            File.Copy(src, dst);
        }
    }
    // 前端库（route A 后 z42c.core + z42c.syntax 已挪入 src/libraries，非 compiler member）也被 driver
    // 自包含 bundle。它们不在 members 循环里 → 若只刷 member，driver 会一直带**旧种子前端**（如缺新增
    // syntax 节点 TupleExpr），冷启动 semantics self-build 报 `undefined type`、且内部环重试无法收敛
    // （见 _buildCompilerViaZ42c line 72）。故须从 fresh libraries dist 同步这两个前端库进 driver bundle，
    // 使重试用的 driver 认得当前源新增的前端符号（post-#317 冷启动收敛的必要环节）。
    string libDist = _libsFlatDist(root, profile);
    _copyIfNewer(Path.Join(libDist, "z42c.core.zpkg"),   Path.Join(driverDist, "z42c.core.zpkg"));
    _copyIfNewer(Path.Join(libDist, "z42c.syntax.zpkg"), Path.Join(driverDist, "z42c.syntax.zpkg"));
}

// 覆盖复制（存在即删后拷）；src 不存在则跳过（冷启动首刷时 libraries dist 可能尚未产出前端库，
// 由 _ensureBootstrapSelfDepLibs 建好后的重试刷再命中）。
// 种子 driver 的运行期 libs = **它自己 dist 里那份 colocated 闭包**（搬到 run-libs），
// 不是 flat 的快照。同时把成员 dist 清成「只有成员」——一举解决两件事：
//
// ① 运行期（代际锚）：`Z42_LIBS` 要给种子 driver **它编译时那一代**的库。此前从 flat 快照，
//    而 flat 正是本轮要被 `_ensureBootstrapSelfDepLibs` 覆盖成当前源的目录 —— 上一轮跑到一半、
//    或快照晚于预建，快照拿到的就是新代，种子 driver 随即
//    `MissingSymbolException: Z42.Build.Project.ManifestLoader.LoadWorkspace`（B3 实测；
//    `Z42.Build.Project` 是当时的旧名，B3b 已改叫 `Z42.Project`）。
//    **flat 是会变的，不能当「代」的锚**。driver 的 dist 里躺的闭包（`z42c build` 对 exe 的
//    colocate + `_ensureDriverSelfContained`）与 driver 同代是**构造保证**的 —— 换它当锚。
//
// ② 编译期（遮蔽）：z42c 的 workspace 解析面是 `libsDirs = 全成员 dist + 外部档`
//    （WorkspaceBuild.z42），纯 basename 命中、**成员 dist 排在前**。成员 dist 同时是运行期
//    载荷目录，于是上一代 colocate 的外部包副本会盖住 flat 里刚建好的当前源新版：
//      z42c.driver/release/dist/z42.package.zpkg（种子代，声明 `Z42.Project`）
//      遮蔽 flat 的 z42.package.zpkg（当前源，声明 `Z42.Package`）
//      ⇒ z42c.semantics 报 `E0494: 命名空间 Z42.Package 不存在`，而 flat 里明明有。
//    ⚠️ 两份还**同尺寸**（`Z42.Project` / `Z42.Package` 都 12 字符）——只核对文件大小会被骗
//       过去；判别要看 zsym 的 STRS 段，且命名空间按**段**存（`\x03Z42\x07Package`），
//       整串 `Z42.Package` 在二进制里 grep 不到。
//    根因（解析分档按 basename 混档）该修在 z42c 侧，但那个修法自己也受种子纪律约束
//    （跑 workspace 构建的是**种子** driver ⇒ 要跨一个 nightly 才生效），故编排侧先解。
//
// 搬空后由调用方 `_ensureDriverSelfContained` 把成员 + fresh 前端补回 driver bundle
// （前端与 flat 同代 ⇒ 不构成遮蔽）。返回搬了几个；0 = 这个 driver 没带 bundle
// （冷启动刚从 SDK staged）⇒ 回落 SDK libs（`_ensureSeed` 正是从那儿取的种子，同代）。
int _relocateSeedRunLibs(string root, string profile, string[] members, string dst) {
    _resetDir(dst);
    int moved = 0;
    int mi = 0;
    while (mi < members.Length) {
        string dist = _compilerMemberDist(root, members[mi], profile);
        mi = mi + 1;
        if (!Directory.Exists(dist)) { continue; }
        string[] hits = Path.Glob(dist, "*.zpkg");
        int hi = 0;
        while (hi < hits.Length) {
            string name = Path.GetFileNameWithoutExtension(hits[hi]);
            hi = hi + 1;
            if (_isCompilerMember(members, name)) { continue; }   // 成员产物归成员 dist，不碰
            _moveZpkgPair(dist, dst, name);
            moved = moved + 1;
        }
    }
    return moved;
}

// <name>.zpkg + 同名 .zsym 从 srcDir 搬到 dstDir（先拷后删；dst 已存在则覆盖）。
void _moveZpkgPair(string srcDir, string dstDir, string name) {
    string[] exts = new string[2];
    exts[0] = ".zpkg"; exts[1] = ".zsym";
    int i = 0;
    while (i < exts.Length) {
        string src = Path.Join(srcDir, name + exts[i]);
        string dst = Path.Join(dstDir, name + exts[i]);
        i = i + 1;
        if (!File.Exists(src)) { continue; }
        if (File.Exists(dst)) { File.Delete(dst); }
        File.Copy(src, dst);
        File.Delete(src);
    }
}

bool _isCompilerMember(string[] members, string name) {
    int i = 0;
    while (i < members.Length) { if (members[i] == name) { return true; } i = i + 1; }
    return false;
}

// 用**种子那一代的 libs**（`_seedLibsSource`：启动时的 `Z42_LIBS` 优先、其次 SDK）补齐缺口。
// bundle 是**主**来源（与 driver 同代是构造保证的），但它可能**不完整**：冷启动刚从 SDK
// staged 的 driver 根本没 bundle；被清理过的树只剩零星几个（B3 实测：我自己先按「化石」删掉
// 23 个，剩 2 个 ⇒ 种子 driver 连 `Std.IO.Environment` 都找不到）。所以判据不是「搬到了吗」
// 而是「**齐了吗**」—— 缺的从 `_seedLibsSource` 补。**不是无条件的 SDK**：格式 bump 在飞时
// SDK 还是上一代格式、会被 strict-pin 拒收（见 `_seedLibsSource` 头注）。
int _topUpSeedRunLibs(string root, string dst, string[] members) {
    string sdkLibs = _seedLibsSource(root);
    if (sdkLibs.Length == 0) { return 0; }
    // 把**来源目录**打进日志：这条链在 CI 上红过两次，而两次都因为「到底从哪儿补的」只能靠推断。
    // 名字打出来，下次看一眼日志就能判是走了 `Z42_LIBS` 还是回落了 SDK。
    _vNormal("  run-libs 缺口来源: " + sdkLibs);
    string[] hits = Path.Glob(sdkLibs, "*.zpkg");
    int filled = 0;
    int i = 0;
    while (i < hits.Length) {
        string name = Path.GetFileNameWithoutExtension(hits[i]);
        i = i + 1;
        if (_isCompilerMember(members, name)) { continue; }
        if (File.Exists(Path.Join(dst, name + ".zpkg"))) { continue; }   // bundle 已提供 = 更可信
        _copyIfNewer(Path.Join(sdkLibs, name + ".zpkg"), Path.Join(dst, name + ".zpkg"));
        _copyIfNewer(Path.Join(sdkLibs, name + ".zsym"), Path.Join(dst, name + ".zsym"));
        filled = filled + 1;
    }
    return filled;
}

// 既无 bundle 也无 SDK 的末路回落：flat。改命名空间/删符号类变更在这种树上救不了，明说而不是
// 静默走错代（静默的代价见 `_relocateSeedRunLibs` 头注列的两种撞法）。
void _seedRunLibsFallbackFlat(string root, string profile, string dst, string stdlibFlat) {
    _copyAll(stdlibFlat, dst, "*.zpkg");
    _copyAll(stdlibFlat, dst, "*.zsym");
    _vNormal("  ⚠ seed run-libs ← flat（既无 bundle 也无 SDK libs）——改命名空间/删符号类变更在这种树上救不了");
}

void _copyIfNewer(string src, string dst) {
    if (File.Exists(src) && src != dst) {
        if (File.Exists(dst)) { File.Delete(dst); }
        File.Copy(src, dst);
    }
}

// z42c self-build：用现有 z42c.driver.zpkg 作种子编译器，一句 `build --workspace`
// 按拓扑序重建 7 个 z42c.* 到各自 dist（兄弟包由 workspace dist 自动解析——旧「E0402
// wrinkle」已不复现）。driver 先自包含化 → 直接跑，无需拼 selfbuild-runlibs；`stdlibFlat`
// （稳定的现有 stdlib）作 Z42_LIBS 供种子 driver 运行期 Std.*（编译器构建不动 stdlib）。
int _buildCompilerViaZ42c(string root, string profile, string[] members, string vm, string stdlibFlat) {
    _vNormal("  building z42c via z42c (--workspace)");
    _ensureDriverSelfContained(root, profile, members);   // 种子 driver 自包含 → 可直接跑
    string driver = _driverZpkg(root, profile);
    // ── 按 driver 的「代」分开运行期/编译期 libs（rename-project-namespaces B2）──────────────
    //
    // 这一段跑的是**上一代** driver：它运行期要加载**那一代**的 stdlib（按它编译时的 FQN 调用），
    // 而它编译的源码要解析**当前源**新建出来的库。此前两者共用 `stdlibFlat` 一个目录 ⇒ 下面的
    // 预建一覆盖 flat，种子 driver 自己就崩（改名/删符号这类变更必然踩到）。
    //
    // 现在：先把 flat 快照成种子代的运行期面（**必须在预建覆盖之前**），随后种子 driver 的调用
    // 用 `Z42_LIBS=快照` + `--compile-libs=flat`。driver 换代之后的步骤（`build stdlib` 步骤 4 等）
    // 仍照旧用 flat 当两者 —— 那时 driver 与 flat 同代。详见
    // `docs/spec/archive/2026-09-27-rename-project-namespaces/design.md` §3 的代际表。
    // 🔴 **只有在 driver 认 `--compile-libs` 时才分开两个面**。种子 driver 若早于该旗标会
    // **静默忽略**它 ⇒ `Z42_LIBS`（此处本想设成种子代快照）会被当成编译期面，冷树上那个快照
    // 还是空的 ⇒ `z42.package 未找到`（CI compile-toolchain 实测红）。不认就逐字退回旧行为。
    bool splitLibs = _driverSupportsCompileLibs(vm, driver);
    string seedRun = stdlibFlat;
    string compileLibs = "";
    if (splitLibs) {
        // 代际锚 = driver 自己 dist 里的 colocated 闭包（搬进 run-libs），**不是** flat 的快照。
        // 理由与 flat 为何当不了锚见 `_relocateSeedRunLibs` 头注。
        seedRun = _seedRunLibs(root, profile);
        int movedLibs = _relocateSeedRunLibs(root, profile, members, seedRun);
        int filledLibs = _topUpSeedRunLibs(root, seedRun, members);
        if (movedLibs + filledLibs > 0) {
            _vNormal("  seed run-libs ← driver bundle " + movedLibs.ToString()
                     + " + SDK 补齐 " + filledLibs.ToString() + "（外部包搬出成员 dist）");
        } else {
            _seedRunLibsFallbackFlat(root, profile, seedRun, stdlibFlat);
        }
        compileLibs = stdlibFlat;
    } else {
        _vNormal("  seed driver 不认 --compile-libs（早于该旗标）→ 运行期/编译期共用 flat（旧行为）");
    }
    _ensureBootstrapSelfDepLibs(root, vm, driver, stdlibFlat, seedRun);  // 冷启动破 z42c⇄z42.package 环（须在 workspace build 前）
    // 预建刚把当前源的库写进 flat ⇒ 此刻把成员 + **fresh** 前端补回 driver bundle
    // （与 flat 同代 ⇒ 不遮蔽；外部包已搬进 run-libs，不再回到成员 dist）。
    if (splitLibs) { _ensureDriverSelfContained(root, profile, members); }
    string compilerDir = Path.Join(root, "src/compiler");
    int rc = _z42cWorkspaceBuild(vm, driver, compilerDir, seedRun, false, compileLibs);
    // 跨成员符号新增（如 z42c.syntax 新增类型/字段被 z42c.semantics 消费）冷启动收敛（破 z42c⇄z42c 内部环）：
    // 上面 line 67 的自包含把当时 dist 里的**旧**兄弟包（如上一 nightly 种子的 z42c.syntax）打进 driver，
    // 而 driver 作编译器运行时解析 semantics 源里的 `Z42.Syntax.*` 用其**自身加载的旧兄弟包**（遮蔽 fresh
    // dist）→ 消费成员 `no field`/`undefined type` 首遍失败。首遍已把兄弟 dist 建 fresh（拓扑序：syntax 在
    // semantics 前先产出）→ 用 fresh 兄弟 dist 重新自包含 driver + 重试一遍即收敛（与 _ensureBootstrapSelfDepLibs
    // 破环同精神：被依赖成员须先于消费者 fresh）。真编译错重试仍失败。warm/常规构建首遍即过、不触发。
    if (rc != 0) {
        _vNormal("  self-build 首遍失败 → 用本轮 fresh 成员 dist 重新自包含 driver + 重试（跨成员符号新增冷启动收敛）");
        _ensureDriverSelfContained(root, profile, members);
        // 重试仍用种子代 driver ⇒ 同样分开两个面。
        rc = _z42cWorkspaceBuild(vm, driver, compilerDir, seedRun, false, compileLibs);
    }
    if (rc != 0) { ConsoleError.WriteLine("  ✗ z42c --workspace self-build failed"); return 1; }
    _ensureDriverSelfContained(root, profile, members);   // 新 gen driver 自包含（幂等兜底）
    _purgeBootstrapPrebuildsFromFlat(root, stdlibFlat);
    return 0;
}

// 破环预建（`_ensureBootstrapSelfDepLibs`）往 flat 里写的编译器域包，只服务上面那次 workspace 自建（编译期解析面
// = flat）。自建完成即清走，让 flat 回到规范形态 = **只有 stdlib 成员**（与 `build stdlib` 末步
// `_assembleStdlibFlatView` 产出的一致）。
//
// 为什么不能留着（add-sdk-libs 阶段 3 前置，2026-10-01）：flat = 开发树的 `Z42_LIBS`。此前它们一直躺到下一次
// `build stdlib`，这段窗口里用开发树工具链编的工程会在 `Z42_LIBS` 里看到 `z42.project` 等 SDK 库 ⇒ 被判「框架包」
// （不复制，运行期 `MissingSymbolException`），`deploy = "sdk"` 的校验也会误判「不是 SDK 库」；打包、alllibs
// 之类按 flat 取东西的地方也一直得防着它（`_pkgCopyLibs` 头注）。
// 当前源的这几个包在各自的成员 dist 里都有（workspace 自建刚产出），清掉 flat 里的副本不丢任何东西。
// `z42.core` 是 stdlib 成员，留着（当前源产物，`build stdlib` 会再按规范重装）。
void _purgeBootstrapPrebuildsFromFlat(string root, string stdlibFlat) {
    string[] libs = _stdlibList(root);
    if (libs.Length == 0) { return; }   // 读不到成员清单就不动：宁可留脏，不可误删 stdlib
    string[] hits = Path.Glob(stdlibFlat, "*");
    int purged = 0;
    int i = 0;
    while (i < hits.Length) {
        string f = hits[i];
        i = i + 1;
        if (!(f.EndsWith(".zpkg") || f.EndsWith(".zsym"))) { continue; }
        string name = Path.GetFileNameWithoutExtension(f);
        bool isLib = false;
        int j = 0;
        while (j < libs.Length) {
            if (libs[j] == name) { isLib = true; break; }
            j = j + 1;
        }
        if (isLib) { continue; }
        try { File.Delete(f); purged = purged + 1; } catch (Exception e) { /* best-effort，同 _cleanGlob */ }
    }
    if (purged > 0) { _vNormal("  flat 清走破环预建的非 stdlib 包 " + purged.ToString() + " 个（回到规范形态）"); }
}

// 冷启动破环：z42c 运行期依赖 z42.package（stdlib 库——IR 模型 + zbc/zpkg 后端，含
// Z42.Project.ZpkgBuilder），但 z42.package 由 z42c 构建 → 循环。冷启动时（fresh checkout /
// CI 新 runner）flat dist 里还没有 z42.package，若直接建 z42c，编译器只能拿**种子**自带的
// z42c.ir/z42c.project 作 Z42.IR/Z42.Project 的命名空间兜底来解析 —— 于是 fresh z42c emit
// 的 `Z42.Project.ZpkgBuilder.Sha256Hex` 调用是钉在种子 z42c.project 上的，运行期加载真正
// 的 z42.package 时解析不到 → `undefined function ...Sha256Hex`。破环（converge-z42c-ir-metadata
// 两代自举）：先用当前 driver（冷启动=上一 nightly 种子，自带等价 ZpkgBuilder）把当前源码的
// z42.package 单独编进 build-libs，再建 z42c —— fresh z42c 就对着**真 z42.package** 编译+运行，一致。
// **不 warm-skip**（lazy-type-world 2026-07-30 修）：早先「z42.package 已在 flat dist 就跳过」的
// 幂等假设 = 「z42c 不消费 z42.package 的**新** API」。当 z42c 自身源码用到当前源 z42.package 里新增的
// 类型/方法（如 `LazyReconWorld`），而 flat dist 里躺的是**上一 nightly 种子带来的旧 z42.package**
// （CI 冷启动 stage 的就是它）时，warm-skip 会让 z42c 的 workspace self-build 对着旧 z42.package 编
// z42c.pipeline → `unknown type LazyReconWorld` 编译失败。故**总是**用当前 driver 把当前源 z42.package
// 建进 build-libs（覆盖种子旧版）——z42c 永远对着**当前源** z42.package 编译，破了 z42c⇄z42.package 的
// 「新 API 需晚一 nightly」轴④约束。warm dev 代价：z42c build 增量缓存命中下近零（源未变 → probe
// 跳过实际重编）；源变了本就该重建。随后 `build stdlib` 全量 workspace 仍用 fresh z42c 覆盖为规范产物。
// `runLibs` = 种子代的运行期 libs 快照（driver 自己加载用）；`stdlibFlat` 仍是**产物落点 +
// 编译期解析面**。分开的理由见调用点注释与 design.md §3。
void _ensureBootstrapSelfDepLibs(string root, string vm, string driver, string stdlibFlat,
                                 string runLibs) {
    _vNormal("  bootstrap: (re)building current-source z42.core + z42.project + z42.build + z42.package + z42c.core + z42c.syntax into build-libs（破 z42c⇄stdlib 轴④环）");
    // consolidate-core-intrinsics (A1): 当前源 z42.package 现调 Std.BitConverter（当前源 z42.core 新增门面）。
    // 冷/首暖构建时 flat 里躺的是种子/上一次的旧 z42.core（缺 BitConverter），若直接单包编 z42.package 会
    // `undefined function`。故先用同款「先预建覆盖种子」模式把**当前源 z42.core** 建进 flat，再建 z42.package。
    // 与下面 z42.package 同理由：z42c 运行期自依赖链上的当前源库，必须先于消费者进 flat（轴 ④）。
    string coreToml = Path.Join(root, "src/libraries/z42.core/z42.core.z42.toml");
    int rcCore = _z42cBuildPackage(vm, driver, coreToml, runLibs, stdlibFlat, stdlibFlat);
    if (rcCore != 0) { ConsoleError.WriteLine("  ✗ bootstrap: build z42.core failed (" + rcCore.ToString() + ")"); }
    // attribute-handler-registry PR3a-load：z42c.driver **编译期**消费 z42.project 的 ProjectManifest
    // （新增 `[analyzers]` 段的 Analyzers/AnalyzerCount 字段）。z42c workspace self-build 早于 step-4
    // 全量 stdlib 重建 → 若不先把当前源 z42.project 建进 flat，driver 会对着**旧** z42.project 编 →
    // `no field AnalyzerCount on ProjectManifest`（轴②：z42c 源新用一个 stdlib API，须先于 z42c 自建进
    // flat）。与 z42.core/z42.package 同款「先预建覆盖种子」。z42.project 依赖 z42.core（已上预建）+ io/toml（flat 已有）。
    string projToml = Path.Join(root, "src/compiler/z42.project/z42.project.z42.toml");
    int rcProj = _z42cBuildPackage(vm, driver, projToml, runLibs, stdlibFlat, stdlibFlat);
    if (rcProj != 0) { ConsoleError.WriteLine("  ✗ bootstrap: build z42.project failed (" + rcProj.ToString() + ")"); }
    // sink-repl-compile-facade：z42c.pipeline **编译期**消费 z42.build 的新 API（`IReplCompiler` +
    // `ReplCompileResult`，供 REPL 编译门面 `Z42cReplCompiler` 实现）。同 z42.project/z42.package 的轴② ——
    // z42c 源新用一个 stdlib API，须先把**当前源** z42.build 建进 flat，否则 z42c 自建 z42c.pipeline
    // 会对着**旧**（种子）z42.build 编 → `E0443: undefined type IReplCompiler`。z42.build 依赖
    // z42.core（已上预建）+ z42.io（flat 已有）+ z42.project（已上预建）。
    string buildToml = Path.Join(root, "src/compiler/z42.build/z42.build.z42.toml");
    int rcBuild = _z42cBuildPackage(vm, driver, buildToml, runLibs, stdlibFlat, stdlibFlat);
    if (rcBuild != 0) { ConsoleError.WriteLine("  ✗ bootstrap: build z42.build failed (" + rcBuild.ToString() + ")"); }
    string irToml = Path.Join(root, "src/compiler/z42.package/z42.package.z42.toml");
    int rc = _z42cBuildPackage(vm, driver, irToml, runLibs, stdlibFlat, stdlibFlat);
    if (rc != 0) { ConsoleError.WriteLine("  ✗ bootstrap: build z42.package failed (" + rc.ToString() + ")"); }
    // converge-z42-syntax-lib（route A 地基）：z42c.core + z42c.syntax（可移植前端）已挪入
    // src/libraries/，成 z42c.semantics/pipeline/driver 的**共享库**依赖。冷启动 flat 里躺的是
    // 上一 nightly 种子的旧 z42c.core/syntax；z42c 自建期若不先把**当前源**建进 flat，semantics/
    // pipeline 会对着旧前端编（`no field`/`undefined type` 首遍失败——见 line 72 内部环重试）。
    // 与 z42.package 同款「不 warm-skip、先预建覆盖种子」，让 fresh z42c 永远对着当前源前端编译+运行。
    // 顺序：z42c.core 靠 z42.core（隐式 prelude，已上建）；z42c.syntax 靠 z42c.core（先于它建）。
    string z42cCoreToml = Path.Join(root, "src/compiler/z42c.core/z42c.core.z42.toml");
    int rcZc = _z42cBuildPackage(vm, driver, z42cCoreToml, runLibs, stdlibFlat, stdlibFlat);
    if (rcZc != 0) { ConsoleError.WriteLine("  ✗ bootstrap: build z42c.core failed (" + rcZc.ToString() + ")"); }
    string z42cSynToml = Path.Join(root, "src/compiler/z42c.syntax/z42c.syntax.z42.toml");
    int rcZs = _z42cBuildPackage(vm, driver, z42cSynToml, runLibs, stdlibFlat, stdlibFlat);
    if (rcZs != 0) { ConsoleError.WriteLine("  ✗ bootstrap: build z42c.syntax failed (" + rcZs.ToString() + ")"); }
}

// 防 zpkg 版本 skew 假失败（2026-06-10）：z42c 测试单元先被 z42c 编成 zpkg，再交
// z42b（z42.builder.zpkg）在 z42vm 上加载运行。两端写/读的 zpkg 格式版本必须一致。
// 完整 `xtask test` 在跑前重建 stdlib+runtime+driver+z42b，但 `test compiler` 原本
// 只检查工具存在、从不重建 —— 一旦某并行变更 bump 了 zpkg 格式（如把 minor 撞到
// 0.13），停在旧版的 z42vm 会在加载期把每个 unit 全判 "cannot read zpkg metadata"
// （空输出＝假失败）。故此处显式重建 runtime(z42vm)。z42b 由 _testCompilerUnits 自身
// 用当前 z42c 重建（cached 时近 no-op），格式始终随当前源码。
int _ensureCompilerTooling() {
    Console.WriteLine("  ensuring tooling fresh (z42vm; release)");
    return _buildRuntime();   // z42vm（z42b 运行所需的当前格式 reader）
}

// smoke: build + assert each z42c.<sub>.zpkg product exists & is non-empty.
// member list derives from the workspace manifest's default-members (single
// source of truth; cf. _stdlibList). member name == [project].name == zpkg
// basename, so the product path is build/compiler/<name>/release/dist/<name>.zpkg.
// noBuild=true: skip the tooling + z42c rebuild (the caller — `test all` — already
// built z42c fresh in its build wave; rebuilding here was z42c's 2nd/3rd full
// self-build in one gate run). Standalone `test compiler` passes false.
int _testCompiler(bool noBuild) {
    Stopwatch sw = _procStart("test compiler");
    if (!noBuild) {
        int tc = _ensureCompilerTooling();   // 重建 runtime+runner+driver，防版本 skew 假失败
        if (tc != 0) { return tc; }
        int bc = _buildCompiler();
        if (bc != 0) { return bc; }
    }

    string root = _root();
    string profile = "release";
    string[] members = _compilerMembers(root);

    int fail = _verifyMemberZpkgs(_compilerWsToml(root), members, profile);
    int ok = members.Length - fail;

    Console.WriteLine("");
    Console.WriteLine("test compiler: " + ok.ToString() + "/"
        + members.Length.ToString() + " zpkg present");
    if (fail > 0) { return 1; }

    // ── z42c [Test] units ────────────────────────────────────────────────
    int __rc = _testCompilerUnits(root, profile, members);
    if (__rc == 0) { _procEnd("test compiler", sw); }
    return __rc;
}

// `_resetDir` / `_copyAll` 已移至 common/xtask_fs.z42（scripts-batch3-layering）。

// Build + run each z42c [Test] unit through z42b.
//
// 解析面（drop-alllibs，2026-10-01）：Z42_LIBS = 纯 stdlib flat。
//   · 编译期：单元按名声明的编译器包（z42c.syntax 等）由 driver 从编译器目录解析（CompilerDomain 开发树档）；
//   · 运行期：z42b 及它为每个 [Test] 方法 fork 的子 VM 经 `_withCompilerProbing` 拿到各编译器成员 dist。
// 此前是把 stdlib + 编译器成员拷进一个 alllibs 目录当唯一 Z42_LIBS（VM 的 Z42_LIBS 只能是一个目录），
// 代价是编译器 dist 里的 stdlib 副本会遮蔽新 stdlib（#955）。
//
// 测试单元布局：src/compiler/<member>/tests/<unit>/{<name>.z42.toml + *.z42}。
// kind=lib（runner 按 [Test] 方法 fork z42vm，不需 Main）；z42.test 自动可用。
int _testCompilerUnits(string root, string profile, string[] members) {
    string flat = _libsDir(root);   // 纯 stdlib；编译器包见上方头注

    string vm     = _builtVm(root, "release");
    string driverZpkg = _driverZpkg(root, profile);
    // retire-test-runner: z42c [Test] units run through z42b (z42.builder.zpkg)
    // via z42vm, replacing the deleted Rust z42-test-runner. Build it here; incremental/cached when already current.
    string builderZpkg = _toolchainZpkg(root, _z42bToml());
    int bc = _buildZ42bWith(root, vm, driverZpkg, flat);
    if (bc != 0) { return bc; }

    int totalFailed = 0;
    int totalUnits = 0;
    int i = 0;
    while (i < members.Length) {
        string testsDir = Path.Join(root, "src/compiler/" + members[i] + "/tests");
        if (Directory.Exists(testsDir)) {
            foreach (var unit in _sortedStrings(Directory.Enumerate(testsDir))) {
                string unitDir = Path.Join(testsDir, unit);
                if (!Directory.Exists(unitDir)) { continue; }
                string[] tomls = Path.Glob(unitDir, "*.z42.toml");
                if (tomls.Length == 0) { continue; }
                totalUnits = totalUnits + 1;
                Console.WriteLine("");
                Console.WriteLine("── z42c test: " + members[i] + " / " + unit + " ──");
                // compile (release/packed) with z42c；stdlib 从 flat、单元声明的编译器包从编译器目录解析；
                // 输出落单元 toml 的 [build] output_dir 镜像。
                ProcessResult br = new Process(vm)
                    .Arg(driverZpkg).Arg("--mode").Arg(_z42cMode()).Arg("--")
                    .Arg("build").Arg(tomls[0]).Arg("--release")
                    .Env("Z42_LIBS", flat)
                    .Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit()).Run();
                if (br.ExitCode != 0) {
                    Console.WriteLine("  ✗ compile failed: " + unit);
                    totalFailed = totalFailed + 1;
                    continue;
                }
                // Build output → artifacts mirror via the unit toml's [build]
                // output_dir (mirror-build-output-per-component, 2026-06-16):
                //   src/compiler/<member>/tests/<unit> → artifacts/build/compiler/<member>/tests/<unit>
                // so the produced .zpkg lands in <mirror>/dist/, NOT beside source.
                string mirrorDist = Path.Join(
                    Path.Join(_compilerBuildRoot(root), members[i] + "/tests/" + unit),
                    "dist");
                string[] zps = Path.Glob(mirrorDist, "*.zpkg");
                // Guard against a recurrence of the prior false-green: before
                // commit 7870db60 z42c ignored [build] output_dir and wrote to
                // <projectDir>/dist, so this Glob found 0 zpkgs → the run loop
                // ran 0 times → "all passed" was reported without any unit ever
                // executing. Treat "compiled OK but no product at mirror" as a
                // failure so a path mismatch can never masquerade as success.
                if (zps.Length == 0) {
                    Console.WriteLine("  ✗ no zpkg produced at " + mirrorDist);
                    totalFailed = totalFailed + 1;
                    continue;
                }
                // Run each produced test zpkg through the test-runner. z42c now
                // emits the TIDX (test-index) section (port-z42c-tidx, 2026-06-25),
                // so the runner discovers + executes [Test] methods just like for
                // C#-built units. (Pre-TIDX this was a loud SKIP — z42c-built
                // zpkgs had no TIDX → runner exit 3, no discovery.)
                int j = 0;
                while (j < zps.Length) {
                    int rc = _withCompilerProbing(new Process(vm), root)
                        .Arg("--mode").Arg(_z42cMode()).Arg(builderZpkg)
                        .Arg("--").Arg("test").Arg(zps[j])
                        .Env("Z42_LIBS", flat)
                        .Stdout(Stdio.Inherit()).Stderr(Stdio.Inherit()).Run().ExitCode;
                    if (rc != 0) { totalFailed = totalFailed + 1; }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }

    Console.WriteLine("");
    if (totalFailed > 0) {
        Console.WriteLine("❌ z42c [Test]: " + totalFailed.ToString() + " unit(s) failed (of "
            + totalUnits.ToString() + ")");
        return 1;
    }
    Console.WriteLine("✅ z42c [Test]: all " + totalUnits.ToString() + " unit(s) passed (compiled + run via TIDX)");
    int ec = _testCompilerE2e(root, vm, flat);
    if (ec != 0) { return ec; }
    return _testSelfHostByteIdentical(root, vm, members, profile);
}


// Self-host 不动点：gen1 = 现有 canonical dist（`build compiler` 的 `z42c build
// --workspace` 产物）；gen2 = 用 gen1 自己的 driver 再跑一遍 SAME `--workspace` →
// 覆盖 canonical dist。`--workspace` 确定 → gen2 必逐字节等于 gen1 快照。
//
// 关键（simplify-compiler-build，2026-07-05）：gen1、gen2 现在**同走 --workspace**。此前
// gen2 用逐包 `build <toml> --output-dir` + `Z42_LIBS=flat`（含全部 z42c+stdlib 的胖目录），
// Phase 2 把 gen1 切到 --workspace 后二者分歧——单包胖-flat 构建拉入更大且非确定的依赖闭包
// （目录扫描顺序非确定，见 common-pitfalls §1）→ gen2>gen1 且逐次漂移。改为二者同路径后，
// 测试回到真正的「driver 复现自身」不动点语义。
int _testSelfHostByteIdentical(string root, string vm, string[] members, string profile) {
    Console.WriteLine("");
    Console.WriteLine("── z42c self-host 不动点：--workspace 再建一遍应逐字节复现 ──");

    string driverZpkg = _driverZpkg(root, profile);
    string stdlibFlat = _libsFlatDist(root, profile);

    // gen1 快照：把现有 canonical dist 的 7 个 <member>.zpkg 拷到独立目录（随后 gen2 会
    // 覆盖 canonical dist）。
    string snapDir = _tmpDir(root, "selfhost-gen1");
    _resetDir(snapDir);
    int i = 0;
    while (i < members.Length) {
        string src = _compilerMemberZpkg(root, members[i], profile);
        if (!File.Exists(src)) {
            Console.WriteLine("  ✗ gen1 missing (先跑 build compiler): " + src);
            return 1;
        }
        File.Copy(src, Path.Join(snapDir, members[i] + ".zpkg"));
        i = i + 1;
    }

    // gen2：用 gen1 的自包含 driver 再跑 --workspace → 覆盖 canonical dist。与 gen1
    // （_buildCompilerViaZ42c）**完全同参**由共用的 _z42cWorkspaceBuild 从结构上保证
    // （不动点 gen1==gen2 的前提）。
    _ensureDriverSelfContained(root, profile, members);
    int rc = _z42cWorkspaceBuild(vm, driverZpkg, Path.Join(root, "src/compiler"), stdlibFlat, true);   // gen2 必须真编，命中 cache 等于没测
    if (rc != 0) { Console.WriteLine("  ✗ gen2 --workspace 构建失败"); return 1; }
    _ensureDriverSelfContained(root, profile, members);

    int ok = 0;
    int fail = 0;
    i = 0;
    while (i < members.Length) {
        string member = members[i];
        i = i + 1;
        byte[] want = File.ReadAllBytes(Path.Join(snapDir, member + ".zpkg"));  // gen1
        byte[] got = File.ReadAllBytes(                                          // gen2
            _compilerMemberZpkg(root, member, profile));
        // Section-level compare: ignore BLID (16B BLAKE3-128 build_id tail).
        if (!_sectionsEqualIgnoreBlid(got, want)) {
            Console.WriteLine("  ✗ sections mismatch: " + member + " (gen2 " + got.Length.ToString() + "B vs gen1 " + want.Length.ToString() + "B)");
            fail = fail + 1;
        } else {
            Console.WriteLine("  ✓ " + member + " (sections byte-identical, BLID ignored)");
            ok = ok + 1;
        }
    }

    Console.WriteLine("");
    if (fail > 0) {
        Console.WriteLine("❌ z42c self-host 不动点: " + fail.ToString() + "/" + members.Length.ToString() + " packages gen1≠gen2");
        return 1;
    }
    Console.WriteLine("✅ z42c self-host 不动点: " + ok.ToString() + "/" + members.Length.ToString() + " packages gen1==gen2 (--workspace)");
    return 0;
}

// Compare zpkg files section-by-section, ignoring BLID (deferred in z42c).
// Header: "ZPK\0"[4]+major[2]+minor[2]+flags[2]+secCount[2]+reserved[4] = 16B.
// Directory: secCount * 12B (tag[4]+offset[4]+size[4]), starting at byte 16.
// BLID = bytes [66,76,73,68] ('B','L','I','D' in ASCII).
bool _sectionsEqualIgnoreBlid(byte[] got, byte[] want) {
    if (got.Length < 16 || want.Length < 16) { return false; }
    int gotSec  = _zpkgU16(got, 10);
    int wantSec = _zpkgU16(want, 10);
    // For each section in got, find matching section in want and compare data
    int gi = 0;
    while (gi < gotSec) {
        int gd   = 16 + gi * 12;
        int goff = _zpkgU32(got, gd + 4);
        int gsiz = _zpkgU32(got, gd + 8);
        bool found = false;
        int wi = 0;
        while (wi < wantSec) {
            int wd = 16 + wi * 12;
            if (got[gd] == want[wd] && got[gd+1] == want[wd+1] && got[gd+2] == want[wd+2] && got[gd+3] == want[wd+3]) {
                found = true;
                if (_zpkgU32(want, wd + 8) != gsiz) { return false; }
                int woff = _zpkgU32(want, wd + 4);
                int bi = 0;
                while (bi < gsiz) {
                    if (got[goff + bi] != want[woff + bi]) { return false; }
                    bi = bi + 1;
                }
            }
            wi = wi + 1;
        }
        if (!found) { return false; }
        gi = gi + 1;
    }
    // Verify want has no extra sections besides BLID
    int wi2 = 0;
    while (wi2 < wantSec) {
        int wd = 16 + wi2 * 12;
        bool isBlid = want[wd] == 66 && want[wd+1] == 76 && want[wd+2] == 73 && want[wd+3] == 68;
        if (!isBlid) {
            bool foundInGot = false;
            int gi2 = 0;
            while (gi2 < gotSec) {
                int gd = 16 + gi2 * 12;
                if (got[gd] == want[wd] && got[gd+1] == want[wd+1] && got[gd+2] == want[wd+2] && got[gd+3] == want[wd+3]) {
                    foundInGot = true;
                }
                gi2 = gi2 + 1;
            }
            if (!foundInGot) { return false; }
        }
        wi2 = wi2 + 1;
    }
    return true;
}

int _zpkgU16(byte[] data, int off) {
    return (int)data[off] | ((int)data[off + 1] << 8);
}

int _zpkgU32(byte[] data, int off) {
    int lo = (int)data[off] | ((int)data[off+1] << 8);
    int hi = (int)data[off+2] | ((int)data[off+3] << 8);
    return lo | (hi << 16);
}
