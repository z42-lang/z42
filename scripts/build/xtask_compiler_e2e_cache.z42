// xtask — z42c cache 目录布局 e2e（cache-dir-layout）。Same Z42Xtask namespace；
// 由 _testCompilerE2e（xtask_compiler_e2e.z42）跨文件调用。
//
// 约定（User 要求）：**不论是否增量都落 cache**；没配置 cache_dir 时默认 `${output_dir}/.cache`。
// 此前三条路径从不写 cache：--no-incremental / workspace 成员 / 多 [[exe]]（提前 return）。
// 这里只验「写」与「落点」；workspace 读 cache 是后续 change（incremental-future-workspace-wiring）。
// 例外（fix-output-dir-aux-outputs）：单工程 `--output-dir` 不写 cache（该路径从不读），见 ④。
namespace Z42Xtask;

using Std.IO;

int _e2eCacheBuild(string vm, string driverZpkg, string cwd, string[] args, string flat) {
    return _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Args(args).WorkingDirectory(cwd)
        .Stdout(Stdio.Null()).Stderr(Stdio.Inherit()).Run().ExitCode;
}

bool _e2eCacheHas(string cacheDir, string what) {
    if (File.Exists(Path.Join(cacheDir, "package.meta"))) { return true; }
    Console.WriteLine("  ✗ " + what + "：未落 cache（缺 " + Path.Join(cacheDir, "package.meta") + "）");
    return false;
}

int _e2eCacheLayoutChecks(string vm, string driverZpkg, string e2eDir, string flat) {
    Console.WriteLine("");
    Console.WriteLine("── cache 目录布局（cache-dir-layout）──");
    string root = Path.Join(e2eDir, "cachelayout");
    string libToml = "[project]\nname    = \"NAME\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n";

    // ① 单工程、无 [build]、--no-incremental → <proj>/artifacts/release/.cache
    string single = Path.Join(root, "single");
    Directory.Create(single);
    File.WriteAllText(Path.Join(single, "lib.z42"), "namespace CacheSingle;\n\npublic static class K { public static int One() { return 1; } }\n");
    File.WriteAllText(Path.Join(single, "cache.single.z42.toml"), libToml.Replace("NAME", "cache.single"));
    string[] a1 = new string[4];
    a1[0] = "build"; a1[1] = "cache.single.z42.toml"; a1[2] = "--release"; a1[3] = "--no-incremental";
    if (_e2eCacheBuild(vm, driverZpkg, single, a1, flat) != 0) { Console.WriteLine("  ✗ 单工程夹具构建失败"); return 1; }
    if (!_e2eCacheHas(Path.Join(single, "artifacts/release/.cache"), "单工程 --no-incremental")) { return 1; }

    // ② 多 [[exe]] → 同一 cache（此前提前 return 从不写）
    string multi = Path.Join(root, "multi");
    Directory.Create(multi);
    File.WriteAllText(Path.Join(multi, "a.z42"), "namespace CacheMulti.A;\n\nvoid Main() { }\n");
    File.WriteAllText(Path.Join(multi, "b.z42"), "namespace CacheMulti.B;\n\nvoid Main() { }\n");
    File.WriteAllText(Path.Join(multi, "cache.multi.z42.toml"),
        "[project]\nname    = \"cache.multi\"\nversion = \"0.1.0\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
        + "[[exe]]\nname  = \"a\"\nentry = \"CacheMulti.A.Main\"\n\n[[exe]]\nname  = \"b\"\nentry = \"CacheMulti.B.Main\"\n");
    string[] a2 = new string[2];
    a2[0] = "build"; a2[1] = "cache.multi.z42.toml";
    if (_e2eCacheBuild(vm, driverZpkg, multi, a2, flat) != 0) { Console.WriteLine("  ✗ 多 exe 夹具构建失败"); return 1; }
    if (!_e2eCacheHas(Path.Join(multi, "artifacts/debug/.cache"), "多 [[exe]]")) { return 1; }

    // ③ workspace：output_dir 模板不含成员名、未配 cache_dir → ${output_dir}/.cache/<成员名>（防碰撞子目录）
    string ws = Path.Join(root, "ws");
    string[] members = new string[2];
    members[0] = "cache.ws.a"; members[1] = "cache.ws.b";
    int m = 0;
    while (m < members.Length) {
        string md = Path.Join(ws, members[m]);
        Directory.Create(md);
        File.WriteAllText(Path.Join(md, "lib.z42"), "namespace CacheWs" + m.ToString() + ";\n\npublic static class K { public static int One() { return 1; } }\n");
        File.WriteAllText(Path.Join(md, members[m] + ".z42.toml"), libToml.Replace("NAME", members[m]));
        m = m + 1;
    }
    File.WriteAllText(Path.Join(ws, "z42.workspace.toml"),
        "[workspace]\nmembers = [\"*\"]\n\n[workspace.build]\noutput_dir = \"out/${profile}\"\n");
    string[] a3 = new string[3];
    a3[0] = "build"; a3[1] = "--workspace"; a3[2] = "--release";
    if (_e2eCacheBuild(vm, driverZpkg, ws, a3, flat) != 0) { Console.WriteLine("  ✗ workspace 夹具构建失败"); return 1; }
    m = 0;
    while (m < members.Length) {
        if (!_e2eCacheHas(Path.Join(ws, "out/release/.cache/" + members[m]), "workspace 成员 " + members[m])) { return 1; }
        m = m + 1;
    }
    // ④ 单工程 `--output-dir <dir>`（fix-output-dir-aux-outputs）：产物进 <dir>，且工程目录旁**不留任何东西**。
    //    这条路径从不读 cache ⇒ 不写；此前 cache 照写到 `<proj>/artifacts/<profile>/.cache`，xtask 自举预建
    //    与测试夹具每轮都在源码树里留一份。
    string od = Path.Join(root, "odproj");
    string odOut = Path.Join(root, "odout");
    Directory.Create(od);
    File.WriteAllText(Path.Join(od, "lib.z42"), "namespace CacheOd;\n\npublic static class K { public static int One() { return 1; } }\n");
    File.WriteAllText(Path.Join(od, "cache.od.z42.toml"), libToml.Replace("NAME", "cache.od"));
    string[] a4 = new string[5];
    a4[0] = "build"; a4[1] = "cache.od.z42.toml"; a4[2] = "--release"; a4[3] = "--output-dir"; a4[4] = odOut;
    if (_e2eCacheBuild(vm, driverZpkg, od, a4, flat) != 0) { Console.WriteLine("  ✗ 单工程 --output-dir 夹具构建失败"); return 1; }
    if (!File.Exists(Path.Join(odOut, "cache.od.zpkg"))) {
        Console.WriteLine("  ✗ 单工程 --output-dir：产物没进 " + odOut); return 1;
    }
    if (Directory.Exists(Path.Join(od, "artifacts")) || Directory.Exists(Path.Join(od, "dist"))) {
        Console.WriteLine("  ✗ 单工程 --output-dir：工程目录旁仍留下了 artifacts/ 或 dist/（cache / generated 没被接管）");
        return 1;
    }
    Console.WriteLine("  ✓ --no-incremental / 多 [[exe]] / workspace 成员均落 cache，默认 ${output_dir}/.cache");
    Console.WriteLine("  ✓ 单工程 --output-dir：产物进 <dir>，工程目录旁零写入");

    // ⑤ workspace 成员继承 [workspace.build]（unify-build-layout）：成员被**单独构建**、被 workspace 外的工程
    //    当作 **path 依赖代建**时，产物都落 workspace 的成员布局（与 `--workspace` 同一处），成员目录旁零写入。
    //    此前两者都走单工程默认 ⇒ `<member>/dist` + `<member>/artifacts/<profile>/.cache`（进源码树）。
    string ws2 = Path.Join(root, "ws2");
    string mem = Path.Join(ws2, "lib.a");
    Directory.Create(mem);
    File.WriteAllText(Path.Join(mem, "lib.z42"), "namespace CacheWs2A;\n\npublic static class K { public static int One() { return 1; } }\n");
    File.WriteAllText(Path.Join(mem, "cache.ws2.a.z42.toml"), libToml.Replace("NAME", "cache.ws2.a"));
    File.WriteAllText(Path.Join(ws2, "z42.workspace.toml"),
        "[workspace]\nmembers = [\"*\"]\n\n[workspace.build]\noutput_dir = \"out/${project_name}/${profile}\"\n");
    string memDist = Path.Join(ws2, "out/cache.ws2.a/release/dist/cache.ws2.a.zpkg");
    // (a) 单独构建成员
    string[] a5 = new string[3];
    a5[0] = "build"; a5[1] = "cache.ws2.a.z42.toml"; a5[2] = "--release";
    if (_e2eCacheBuild(vm, driverZpkg, mem, a5, flat) != 0) { Console.WriteLine("  ✗ 成员单独构建失败"); return 1; }
    if (!File.Exists(memDist)) { Console.WriteLine("  ✗ 成员单独构建：产物没落 workspace 成员布局（缺 " + memDist + "）"); return 1; }
    if (!_e2eCacheHas(Path.Join(ws2, "out/cache.ws2.a/release/.cache"), "成员单独构建")) { return 1; }
    if (Directory.Exists(Path.Join(mem, "dist")) || Directory.Exists(Path.Join(mem, "artifacts"))) {
        Console.WriteLine("  ✗ 成员单独构建：成员目录旁仍有 dist/ 或 artifacts/"); return 1;
    }
    // (b) workspace 外的工程以 path 依赖引用该成员 → 代建落同一处
    Directory.Delete(Path.Join(ws2, "out"), true);
    string cons = Path.Join(root, "consumer");
    Directory.Create(cons);
    File.WriteAllText(Path.Join(cons, "c.z42"), "namespace CacheCons;\n\nusing CacheWs2A;\n\npublic static class C { public static int F() { return K.One(); } }\n");
    File.WriteAllText(Path.Join(cons, "cache.cons.z42.toml"), libToml.Replace("NAME", "cache.cons")
        + "\n[dependencies]\n\"cache.ws2.a\" = { path = \"../ws2/lib.a\" }\n");
    string[] a6 = new string[3];
    a6[0] = "build"; a6[1] = "cache.cons.z42.toml"; a6[2] = "--release";
    if (_e2eCacheBuild(vm, driverZpkg, cons, a6, flat) != 0) { Console.WriteLine("  ✗ path 依赖消费方构建失败"); return 1; }
    if (!File.Exists(memDist)) { Console.WriteLine("  ✗ path 依赖代建：成员产物没落 workspace 成员布局（缺 " + memDist + "）"); return 1; }
    if (Directory.Exists(Path.Join(mem, "dist")) || Directory.Exists(Path.Join(mem, "artifacts"))) {
        Console.WriteLine("  ✗ path 依赖代建：成员目录旁仍有 dist/ 或 artifacts/"); return 1;
    }
    Console.WriteLine("  ✓ workspace 成员单独构建 / 被 path 依赖代建：均落 [workspace.build] 成员布局，成员目录旁零写入");
    return 0;
}

// 依赖身份进缓存键（add-dep-identity-to-cache-key）。path 依赖 foo 改 API、消费方 bar 源码不动：
// 此前 bar probe 全命中 → preserved 旧产物 → 运行期 undefined function（本应编译期报错）。
// 另验：foo 只改注释（#654 起 BLID 不变）→ bar 仍全命中，依赖身份不会让下游白重编。
int _e2eDepIdentityChecks(string vm, string driverZpkg, string e2eDir, string flat) {
    Console.WriteLine("");
    Console.WriteLine("── 依赖身份进缓存键（add-dep-identity-to-cache-key）──");
    string root = Path.Join(e2eDir, "depidentity");
    string foo = Path.Join(root, "foo");
    string bar = Path.Join(root, "bar");
    Directory.Create(foo);
    Directory.Create(bar);
    string fooSrc = "namespace DepId.Foo;\n\npublic static class Foo {\n    public static int Answer() { return 42; }\n}\n";
    File.WriteAllText(Path.Join(foo, "foo.z42"), fooSrc);
    File.WriteAllText(Path.Join(foo, "depid.foo.z42.toml"),
        "[project]\nname    = \"depid.foo\"\nversion = \"0.1.0\"\nkind    = \"lib\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n");
    File.WriteAllText(Path.Join(bar, "bar.z42"), "using DepId.Foo;\n\nint Main() { return Foo.Answer() - 42; }\n");
    File.WriteAllText(Path.Join(bar, "depid.bar.z42.toml"),
        "[project]\nname    = \"depid.bar\"\nversion = \"0.1.0\"\nkind    = \"exe\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
        + "[dependencies]\n\"depid.foo\" = { path = \"../foo\" }\n");
    string[] a = new string[3];
    a[0] = "build"; a[1] = "depid.bar.z42.toml"; a[2] = "--release";
    if (_e2eCacheBuild(vm, driverZpkg, bar, a, flat) != 0) { Console.WriteLine("  ✗ 夹具首次构建失败"); return 1; }
    // ① foo 只改注释 → 输出不变 → bar 必须仍能成功（且不因依赖身份误判）
    File.WriteAllText(Path.Join(foo, "foo.z42"), "// 只改注释\n" + fooSrc);
    ProcessResult r1 = _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Args(a).WorkingDirectory(bar)
        .Run();
    if (r1.ExitCode != 0 || !r1.Stdout.Contains("no changes")) {
        Console.WriteLine("  ✗ 依赖只改注释，消费方却没有命中缓存（exit " + r1.ExitCode.ToString() + "）");
        return 1;
    }
    // ② foo 改名（破坏性 API 变更）→ bar 必须重编 → 编译期报 E0401（非零退出），而不是 preserved 旧产物。
    //   不用「加参数」做夹具：z42c 目前不诊断实参个数不足（另案），加参数不会编译报错。
    File.WriteAllText(Path.Join(foo, "foo.z42"), fooSrc.Replace("Answer()", "Renamed()"));
    ProcessResult r2 = _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Args(a).WorkingDirectory(bar)
        .Run();
    if (r2.ExitCode == 0) {
        Console.WriteLine("  ✗ 依赖删掉了被调用的方法，消费方仍构建成功（命中了旧缓存）：" + r2.Stdout);
        return 1;
    }
    Console.WriteLine("  ✓ 依赖只改注释 → 消费方命中缓存；依赖删掉被调方法 → 消费方重编并报错");
    return 0;
}

int _e2eCount(string hay, string needle) {
    return hay.Split(needle).Length - 1;
}

ProcessResult _e2eWsBuild(string vm, string driverZpkg, string ws, string flat, bool noIncr) {
    Process p = _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Arg("build").Arg("--workspace").Arg("--release");
    if (noIncr) { p = p.Arg("--no-incremental"); }
    return p.WorkingDirectory(ws).Run();
}

// workspace 读 cache（workspace-read-cache）：此前 workspace 成员恒全量。成员 b 依赖 a。
int _e2eWorkspaceIncrChecks(string vm, string driverZpkg, string e2eDir, string flat) {
    Console.WriteLine("");
    Console.WriteLine("── workspace 读 cache（workspace-read-cache）──");
    string ws = Path.Join(e2eDir, "wsincr");
    string a = Path.Join(ws, "wsi.a");
    string b = Path.Join(ws, "wsi.b");
    Directory.Create(a);
    Directory.Create(b);
    string aSrc = "namespace WsiA;\n\npublic static class K {\n    public static int One() { return 1; }\n}\n";
    File.WriteAllText(Path.Join(a, "a.z42"), aSrc);
    File.WriteAllText(Path.Join(a, "wsi.a.z42.toml"),
        "[project]\nname    = \"wsi.a\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n");
    File.WriteAllText(Path.Join(b, "b.z42"), "namespace WsiB;\n\nusing WsiA;\n\npublic static class L {\n    public static int Two() { return K.One() + 1; }\n}\n");
    File.WriteAllText(Path.Join(b, "wsi.b.z42.toml"),
        "[project]\nname    = \"wsi.b\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"wsi.a\" = \"0.1.0\"\n");
    File.WriteAllText(Path.Join(ws, "z42.workspace.toml"),
        "[workspace]\nmembers = [\"*\"]\n\n[workspace.build]\noutput_dir = \"out/${member_name}/${profile}\"\n");
    ProcessResult r0 = _e2eWsBuild(vm, driverZpkg, ws, flat, false);
    if (r0.ExitCode != 0) { Console.WriteLine("  ✗ 首次构建失败：" + r0.Stderr); return 1; }
    // ① 无改动再建：两个成员都命中
    ProcessResult r1 = _e2eWsBuild(vm, driverZpkg, ws, flat, false);
    if (r1.ExitCode != 0 || _e2eCount(r1.Stdout, "no changes") != 2) {
        Console.WriteLine("  ✗ 无改动再建，应 2 个成员命中，实际 " + _e2eCount(r1.Stdout, "no changes").ToString());
        return 1;
    }
    // ② a 只改注释：a 重编但产物不变 → b 仍命中
    File.WriteAllText(Path.Join(a, "a.z42"), "// 只改注释\n" + aSrc);
    ProcessResult r2 = _e2eWsBuild(vm, driverZpkg, ws, flat, false);
    if (r2.ExitCode != 0 || _e2eCount(r2.Stdout, "no changes") != 1) {
        Console.WriteLine("  ✗ a 只改注释，应只有 b 命中，实际命中 " + _e2eCount(r2.Stdout, "no changes").ToString());
        return 1;
    }
    // ③ --no-incremental：一个都不命中
    ProcessResult r3 = _e2eWsBuild(vm, driverZpkg, ws, flat, true);
    if (r3.ExitCode != 0 || _e2eCount(r3.Stdout, "no changes") != 0) {
        Console.WriteLine("  ✗ --no-incremental 仍有成员命中缓存");
        return 1;
    }
    // ④ a 删掉 b 调用的方法：b 必须重编并报错
    File.WriteAllText(Path.Join(a, "a.z42"), aSrc.Replace("One()", "Uno()"));
    ProcessResult r4 = _e2eWsBuild(vm, driverZpkg, ws, flat, false);
    if (r4.ExitCode == 0) {
        Console.WriteLine("  ✗ a 删掉了 b 调用的方法，workspace 仍构建成功（b 命中了旧缓存）");
        return 1;
    }
    Console.WriteLine("  ✓ 无改动全命中；依赖只改注释下游命中；--no-incremental 不读；依赖删方法下游重编报错");
    return 0;
}

// using-csharp-rules 2.9b + 3.6：cached 文件的 `UsedNs` 随 meta 回来。f0 声明 `global using UnA;`，只有 f1 用到 UnA。
// 只改 f0 的注释 ⇒ f1 命中缓存；包级「global using 全包没用到」必须看到 f1 的用法，**不能**报 W0607。
// 修前 driver 不写 / 不读 meta 里的 `usedns` ⇒ cached 的 f1 用法集合为空 ⇒ 误报。
int _e2eUsedNsCacheChecks(string vm, string driverZpkg, string e2eDir, string flat) {
    Console.WriteLine("");
    Console.WriteLine("── cached 文件的 UsedNs 随 meta 回来（using-csharp-rules 2.9b）──");
    string root = Path.Join(e2eDir, "usednscache");
    Directory.Create(root);
    File.WriteAllText(Path.Join(root, "unc.z42.toml"),
        "[project]\nname    = \"unc\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n");
    string f0 = "namespace UnA;\n\npublic class W { public int V; }\n\nglobal using UnA;\n";
    File.WriteAllText(Path.Join(root, "f0.z42"), f0);
    File.WriteAllText(Path.Join(root, "f1.z42"), "namespace UnB;\n\npublic static class U {\n    public static int F() { W w = new W(); return w.V; }\n}\n");
    string[] a = new string[2];
    a[0] = "build"; a[1] = "unc.z42.toml";
    ProcessResult r0 = _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Args(a).WorkingDirectory(root).Run();
    if (r0.ExitCode != 0) { Console.WriteLine("  ✗ 夹具首次构建失败：" + r0.Stderr); return 1; }
    if (r0.Stderr.Contains("W0607") || r0.Stdout.Contains("W0607")) { Console.WriteLine("  ✗ 首次构建就报了 W0607：" + r0.Stderr + r0.Stdout); return 1; }
    File.WriteAllText(Path.Join(root, "f0.z42"), "// 只改注释\n" + f0);
    ProcessResult r1 = _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Args(a).WorkingDirectory(root).Run();
    if (r1.ExitCode != 0) { Console.WriteLine("  ✗ 只改注释的二次构建失败：" + r1.Stderr); return 1; }
    if (!r1.Stdout.Contains("cached: 1/2") && !r1.Stderr.Contains("cached: 1/2")) {
        Console.WriteLine("  ✗ 夹具没走到 cached 路径（期望 cached: 1/2）：" + r1.Stdout + r1.Stderr); return 1;
    }
    if (r1.Stderr.Contains("W0607") || r1.Stdout.Contains("W0607")) {
        Console.WriteLine("  ✗ f1 命中缓存后，global using 被误报成全包没用到：" + r1.Stderr + r1.Stdout); return 1;
    }
    Console.WriteLine("  ✓ f1 命中缓存时其 UsedNs 从 meta 回填，global using 不误报");
    return 0;
}
