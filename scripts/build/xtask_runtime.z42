// xtask — `build runtime`：直接驱动 cargo 构建 z42vm。
namespace Z42Xtask;

using Std.Time;   // Stopwatch — _procStart/_procEnd 进程计时标记

int _buildRuntime() {
    Stopwatch sw = _procStart("build runtime (cargo z42vm)");
    // --locked：Cargo.lock 入库，与 `test runtime` 一致；CI 的 bootstrap 也走这里。
    int __rc = _exec(_componentCargo("build", _root(), "release", _cargoTargetDir(_root()))
        .Arg("-p").Arg("z42").Arg("-p").Arg("z42-compression").Arg("-p").Arg("z42-interp").Arg("-p").Arg("z42-jit"));
    if (__rc == 0) { _componentCopyStd(_cargoOutFor(_root(), _detectHostRid(), "release")); }
    if (__rc == 0) { _procEnd("build runtime (cargo z42vm)", sw); }
    return __rc;
}

