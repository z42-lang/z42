// xtask — path 依赖闭包的两个解析域缺口（fix-path-dep-closure-scope）。
//
// A · workspace 成员依赖 workspace **外**的 path 工程：此前闭包只在 top-level 单工程构建时解析，
//     workspace 调用总带着 libsDirs 进来 ⇒ 外部 path 依赖永不代建，报「未找到 x.zpkg……path 依赖由
//     z42c 代建」（自相矛盾）。同一工程单独 build 一直是好的。
// B · path 依赖的**代建**与消费方都用 `Z42_LIBS` 当基础解析域，绕过了 `--compile-libs`：path 依赖自己
//     依赖一个只在 --compile-libs 里的包 ⇒ 代建失败。
// 两格都取「能编 + 能跑」的行为判据。工程落 repo 外（`_e2eTmpRoot`，按树分）。
namespace Z42Xtask;

using Std.IO;

int _e2ePathDepScopeChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp = _e2eTmpRoot(root, "pathdeps");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }

    // ── A：workspace 成员 → workspace 外的 path 依赖 ──────────────────────────────────
    string ws = Path.Join(tmp, "ws");
    string app = Path.Join(ws, "app");
    string ext = Path.Join(tmp, "ext");   // 必须在 workspace 根之外，否则 members=["*"] 把它吞成成员
    Directory.Create(app); Directory.Create(ext);
    File.WriteAllText(Path.Join(ws, "z42.workspace.toml"),
        "[workspace]\nmembers = [\"*\"]\n\n[workspace.build]\noutput_dir = \"artifacts/${project_name}/${profile}\"\n");
    File.WriteAllText(Path.Join(ext, "pdext.z42.toml"),
        "[project]\nname    = \"pdext\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n");
    File.WriteAllText(Path.Join(ext, "e.z42"), "namespace PdExt;\n\npublic static class E { public static int V() { return 7; } }\n");
    File.WriteAllText(Path.Join(app, "pdapp.z42.toml"),
        "[project]\nname    = \"pdapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\nentry   = \"Main\"\n\n"
        + "[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"pdext\" = { path = \"../../ext\" }\n");
    File.WriteAllText(Path.Join(app, "main.z42"), "using Std.IO;\nusing PdExt;\n\nvoid Main() { Console.WriteLine(E.V()); }\n");
    ProcessResult wa = new Process(vm).WorkingDirectory(ws).Arg(driverZpkg).Arg("--").Arg("build").Arg("--workspace")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (wa.ExitCode != 0) {
        Console.WriteLine("  ✗ pathdeps A：workspace 成员的外部 path 依赖没被代建: " + wa.Stdout + wa.Stderr);
        return 1;
    }
    string appZpkg = Path.Join(Path.Join(ws, "artifacts/pdapp/debug/dist"), "pdapp.zpkg");
    ProcessResult ra = new Process(vm).Arg(appZpkg).Env("Z42_LIBS", flat).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (ra.ExitCode != 0 || ra.Stdout.Trim() != "7") {
        Console.WriteLine("  ✗ pathdeps A：产物跑不出 7: rc=" + ra.ExitCode.ToString() + " " + ra.Stdout + ra.Stderr);
        return 1;
    }

    // ── B：path 依赖自己依赖一个只在 --compile-libs 里的包 ─────────────────────────────
    string libsDir = Path.Join(tmp, "libs");     // = Z42_LIBS：只有 stdlib
    string onlyDir = Path.Join(tmp, "only");     // 只有 pdbase
    string baseDir = Path.Join(tmp, "base");
    string midDir  = Path.Join(tmp, "mid");      // path 依赖：用 PdBase
    string topDir  = Path.Join(tmp, "top");      // 消费方：path 依赖 mid
    Directory.Create(libsDir); Directory.Create(onlyDir); Directory.Create(baseDir);
    Directory.Create(midDir); Directory.Create(topDir);
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(libsDir, Path.GetFileName(stdlib[si]))); si = si + 1; }
    File.WriteAllText(Path.Join(baseDir, "pdbase.z42.toml"),
        "[project]\nname    = \"pdbase\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n");
    File.WriteAllText(Path.Join(baseDir, "b.z42"), "namespace PdBase;\n\npublic static class B { public static int V() { return 5; } }\n");
    ProcessResult bb = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(Path.Join(baseDir, "pdbase.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (bb.ExitCode != 0) { Console.WriteLine("  ✗ pathdeps B：预建 pdbase 失败: " + bb.Stderr); return 1; }
    File.Copy(Path.Join(Path.Join(baseDir, "dist"), "pdbase.zpkg"), Path.Join(onlyDir, "pdbase.zpkg"));
    File.WriteAllText(Path.Join(midDir, "pdmid.z42.toml"),
        "[project]\nname    = \"pdmid\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
        + "[dependencies]\n\"pdbase\" = \"0.1.0\"\n");
    File.WriteAllText(Path.Join(midDir, "m.z42"), "namespace PdMid;\n\nusing PdBase;\n\npublic static class M { public static int V() { return B.V() + 1; } }\n");
    File.WriteAllText(Path.Join(topDir, "pdtop.z42.toml"),
        "[project]\nname    = \"pdtop\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
        + "[dependencies]\n\"pdmid\" = { path = \"../mid\" }\n");
    File.WriteAllText(Path.Join(topDir, "t.z42"), "namespace PdTop;\n\nusing PdMid;\n\npublic static class T { public static int V() { return M.V(); } }\n");
    string sep = Platform.IsWindows() ? ";" : ":";
    ProcessResult tb = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(Path.Join(topDir, "pdtop.z42.toml")).Arg("--release")
        .Arg("--compile-libs").Arg(libsDir + sep + onlyDir)
        .Env("Z42_LIBS", libsDir).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (tb.ExitCode != 0) {
        Console.WriteLine("  ✗ pathdeps B：path 依赖的代建没看见 --compile-libs 里的 pdbase: " + tb.Stdout + tb.Stderr);
        return 1;
    }
    Console.WriteLine("  ✓ path 依赖闭包：workspace 成员的外部 path 依赖被代建且能跑 / 代建与消费方都认 --compile-libs");
    return 0;
}
