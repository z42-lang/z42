// xtask — `doc` 命令族的两块引擎：
//   ① `doc gen` / `check docs-api`：用 z42.doc 的 DocMd 渲染器重新生成 reference/stdlib 包页，
//      并与仓库内文件对账（漂移门禁）。只对写了 `//!` 的包（已迁移）生效，未迁移的包页保持手写。
//   ② `doc index`：把 Rust 运行时各 crate 的条目与 rustdoc 写成 `z42 doc` 的外部索引
//      （artifacts/doc/rust.idx），让 `z42 doc` 一并查 Rust 符号。索引器是
//      src/toolchain/devtools/rust-index（syn 解析，沿 mod 声明走模块树，测试模块不进索引）。
namespace Z42Xtask;

using Std.IO;
using Std.Time;
using Z42.Doc;

// 包名 → 页名：z42.<domain> → <domain>。
string _docPageName(string pkg) {
    if (pkg.StartsWith("z42.")) { return pkg.Substring(4); }
    return pkg;
}

// type-split 包（一个类型一页）：z42.core 太大。硬编码清单，等 `[doc] split` 清单解析就绪后改读清单。
bool _isTypeSplit(string pkg) {
    string[] ts = new string[1];
    ts[0] = "z42.core";
    int i = 0;
    while (i < ts.Length) { if (ts[i] == pkg) { return true; } i = i + 1; }
    return false;
}

// 一个 type-split 包的产出：索引页 `<short>.md` + 每个类型 `<short>.<Type>.md`。
sealed class _GenFile {
    public string Name;
    public string Content;
    public _GenFile(string n, string c) { this.Name = n; this.Content = c; }
}

_GenFile[] _typeSplitFiles(string pkg, string shortName, DocIndex ix) {
    string pkgDir = DocMd.PkgDir(ix);
    _GenFile[] acc = new _GenFile[16];
    int n = 0;
    acc[n] = new _GenFile(shortName + ".md", DocMd.TypeIndex(pkg, pkgDir, ix)); n = n + 1;
    string[] nss = DocMd.Namespaces(ix);
    int i = 0;
    while (i < nss.Length) {
        TypeGroup[] groups = DocMd.TopLevelTypeGroups(ix, nss[i]);
        int j = 0;
        while (j < groups.Length) {
            if (n == acc.Length) { _GenFile[] g = new _GenFile[n * 2]; Array.Copy(acc, g, n); acc = g; }
            acc[n] = new _GenFile(shortName + "." + groups[j].Name + ".md", DocMd.TypePage(pkg, pkgDir, nss[i], groups[j], ix));
            n = n + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    _GenFile[] r = new _GenFile[n];
    Array.Copy(acc, r, n);
    return r;
}

// SUMMARY.md 里 type-split 包的页清单区段：mdBook 只构建 SUMMARY 列出的页，上百个类型页
// 手写必然漂移，这段由 doc gen / check docs-api 同步维护（标记注释夹住，区段外不许生成改动）。
string _summaryBegin(string shortName) { return "<!-- z42-doc:summary:" + shortName + "-begin（xtask doc gen 维护，勿手改） -->"; }
string _summaryEnd(string shortName)   { return "<!-- z42-doc:summary:" + shortName + "-end -->"; }

string _summaryBlock(string shortName, DocIndex ix) {
    string s = _summaryBegin(shortName) + "\n";
    s = s + "- [类型总览](stdlib/" + shortName + ".md)\n";
    // 命名空间一层草稿章（mdBook 草稿章无目标页、只作可展开的分组），类型挂其下；
    // 配 book.toml 的 [output.html.fold]（level=0：默认收起、当前页祖先自动展开）。
    // 成员级不进侧边栏——mdBook SUMMARY 不支持锚点条目；成员导航在类型页内（成员索引行 + <a id>）。
    string[] nss = DocMd.Namespaces(ix);
    int i = 0;
    while (i < nss.Length) {
        TypeGroup[] groups = DocMd.TopLevelTypeGroups(ix, nss[i]);
        if (groups.Length > 0) {
            s = s + "    - [" + nss[i] + "]()\n";
            int j = 0;
            while (j < groups.Length) {
                s = s + "        - [" + groups[j].Name + "](stdlib/" + shortName + "." + groups[j].Name + ".md)\n";
                j = j + 1;
            }
        }
        i = i + 1;
    }
    s = s + _summaryEnd(shortName);
    return s;
}

// 把 SUMMARY.md 里 shortName 的区段换成 / 对账生成内容。check=false 重写文件，check=true 只比对。
int _syncSummary(string root, string shortName, DocIndex ix, bool check) {
    string path = Path.Join(root, "docs/reference/src/SUMMARY.md");
    string text = File.ReadAllText(path);
    string begin = _summaryBegin(shortName);
    string end = _summaryEnd(shortName);
    int b = text.IndexOf(begin);
    int e = text.IndexOf(end);
    if (b < 0 || e < 0 || e < b) {
        ConsoleError.WriteLine("summary: " + path + " 缺少 " + begin + " … " + end + " 区段标记");
        return 1;
    }
    string want = text.Substring(0, b) + _summaryBlock(shortName, ix) + text.Substring(e + end.Length);
    if (check) {
        if (want != text) {
            ConsoleError.WriteLine("check docs-api: SUMMARY.md 的 " + shortName + " 区段与生成结果不一致。运行 `xtask doc gen`。");
            return 1;
        }
        return 0;
    }
    File.WriteAllText(path, want);
    return 0;
}

// 生成页源码链接的基址：取 book.toml 的 git-repository-url 口径（blob/main）。
// Z42_DOC_SOURCE_BASE 可覆盖（本地预览 / 镜像）。gen 与 check 同值，否则漂移门禁误报。
string _docSourceBase() {
    string env = Environment.GetEnvironmentVariable("Z42_DOC_SOURCE_BASE", "");
    if (env.Length > 0) { return env; }
    return "https://github.com/z42-lang/z42/blob/main";
}

// 生成全部已迁移包（写了 `//!`）的 reference 页到 docs/reference/src/stdlib/。返回写了几个。
int _docGen() {
    string root = _root();
    string outDir = Path.Join(root, "docs/reference/src/stdlib");
    string[] libs = _stdlibList(root);
    DocMd.SourceBase = _docSourceBase();
    int n = 0;
    int i = 0;
    while (i < libs.Length) {
        string pkg = libs[i];
        DocIndex ix = DocQuery.BuildIndex(root, pkg, "");
        if (DocMd.HasNamespaceDoc(ix)) {
            if (_isTypeSplit(pkg)) {
                _GenFile[] fs = _typeSplitFiles(pkg, _docPageName(pkg), ix);
                int j = 0;
                while (j < fs.Length) { File.WriteAllText(Path.Join(outDir, fs[j].Name), fs[j].Content); j = j + 1; }
                int rc = _syncSummary(root, _docPageName(pkg), ix, false);
                if (rc != 0) { return rc; }
                n = n + fs.Length;
            } else {
                string page = DocMd.PackagePage(pkg, DocMd.PkgDir(ix), ix);
                File.WriteAllText(Path.Join(outDir, _docPageName(pkg) + ".md"), page);
                n = n + 1;
            }
        }
        i = i + 1;
    }
    Console.WriteLine("doc gen: wrote " + n.ToString() + " package page(s)");
    return 0;
}

// doc 注释棘轮（z42-doc §4.6）：stdlib 各包跑 DocLint（W08xx 语法级检查），计数不得超过
// scripts/test/doc-lint-baseline.txt（只降不升）。--update 重写基线。W0803（链接 / @throws
// 类型解析）需要语义信息，归编译器 DocChecker pass，不在此列。
int _checkDocLints(bool update) {
    string root = _root();
    SourceFile[] all = SourceTree.Collect(root);
    DocLintFinding[] fs = new DocLintFinding[64];
    int n = 0;
    // 按包分组跑（W0808 的「同一命名空间一份 //!」按包判），再合并计数。
    // 范围 = stdlib（src/libraries/）：编译器域（z42c.* / z42.doc）的注释按 doc-system
    // §3.6「契约不显然时写」，不适用 W0805 全覆盖棘轮。
    int i = 0;
    while (i < all.Length) {
        string pkg = all[i].Pkg;
        if (pkg.Length == 0 || !all[i].Rel.StartsWith("src/libraries/")) { i = i + 1; continue; }
        string[] paths = new string[all.Length];
        int m = 0;
        while (i < all.Length && all[i].Pkg == pkg) { paths[m] = all[i].Abs; m = m + 1; i = i + 1; }
        string[] one = new string[m];
        int c = 0;
        while (c < m) { one[c] = paths[c]; c = c + 1; }
        DocLintFinding[] found = DocLint.CheckPaths(one);
        int k = 0;
        while (k < found.Length) {
            if (n == fs.Length) { DocLintFinding[] g = new DocLintFinding[n * 2]; Array.Copy(fs, g, n); fs = g; }
            fs[n] = found[k]; n = n + 1; k = k + 1;
        }
    }

    // 每码计数（码升序打印，便于人工比对）。
    string[] codes = new string[n];
    int[] counts = new int[n];
    int cn = 0;
    int j = 0;
    while (j < n) {
        int at = -1;
        int q = 0;
        while (q < cn) { if (codes[q] == fs[j].Code) { at = q; break; } q = q + 1; }
        if (at < 0) { codes[cn] = fs[j].Code; counts[cn] = 1; cn = cn + 1; }
        else { counts[at] = counts[at] + 1; }
        j = j + 1;
    }
    _sortCounts(codes, counts, cn);

    string baselinePath = Path.Join(root, "scripts/test/doc-lint-baseline.txt");
    if (update) {
        string outp = "# stdlib doc 注释棘轮基线（xtask check doc-lints --update 重写）。\n"
            + "# 只降不升：清零一条就从这里删掉那行；计数下降时随手更新。W0803 归编译器 pass，不在此列。\n";
        int w = 0;
        while (w < cn) { outp = outp + codes[w] + " " + counts[w].ToString() + "\n"; w = w + 1; }
        File.WriteAllText(baselinePath, outp);
        Console.WriteLine("check doc-lints: ↻ 基线重写（" + n.ToString() + " 条）→ " + baselinePath);
        return 0;
    }

    // 对账：超出基线 → 失败；基线里有而实际为零 → 提示收紧。
    string[] lines = File.ReadAllText(baselinePath).Split("\n");
    string fail = "";
    int printed = 0;
    int li = 0;
    while (li < lines.Length) {
        string line = lines[li].Trim();
        li = li + 1;
        if (line.Length == 0 || line.StartsWith("#")) { continue; }
        int sp = line.IndexOf(" ");
        if (sp < 0) { continue; }
        string code = line.Substring(0, sp);
        int base = int.Parse(line.Substring(sp + 1));
        int now = 0;
        int q = 0;
        while (q < cn) { if (codes[q] == code) { now = counts[q]; break; } q = q + 1; }
        if (now > base) {
            fail = fail + "\n  " + code + ": " + now.ToString() + " > 基线 " + base.ToString();
            int f = 0;
            while (f < n && printed < 15) {
                if (fs[f].Code == code) { ConsoleError.WriteLine("  " + fs[f].File + ":" + fs[f].Line.ToString() + ": " + fs[f].Code + " " + fs[f].Msg); printed = printed + 1; }
                f = f + 1;
            }
        } else if (now < base) {
            Console.WriteLine("  " + code + ": " + base.ToString() + " → " + now.ToString() + "（可收紧基线）");
        }
    }
    // 基线里没有的码：新出现的违规。
    int q2 = 0;
    while (q2 < cn) {
        string code = codes[q2];
        bool known = false;
        int li2 = 0;
        while (li2 < lines.Length) {
            string t = lines[li2].Trim();
            li2 = li2 + 1;
            if (t.StartsWith(code + " ")) { known = true; break; }
        }
        if (!known) { fail = fail + "\n  " + code + ": " + counts[q2].ToString() + " 条（基线外新违规）"; }
        q2 = q2 + 1;
    }
    if (fail.Length > 0) {
        ConsoleError.WriteLine("check doc-lints: 超出基线：" + fail);
        return 1;
    }
    Console.WriteLine("check doc-lints: ✓ " + n.ToString() + " 条在基线内（" + Path.GetFileName(baselinePath) + "）");
    return 0;
}

// 检查码按字典序排（W0801 < W0802 < …，字典序即数值序）。
void _sortCounts(string[] codes, int[] counts, int n) {
    int i = 1;
    while (i < n) {
        string c = codes[i]; int v = counts[i];
        int j = i - 1;
        while (j >= 0 && codes[j].CompareTo(c) > 0) { codes[j + 1] = codes[j]; counts[j + 1] = counts[j]; j = j - 1; }
        codes[j + 1] = c; counts[j + 1] = v;
        i = i + 1;
    }
}

// 书页代码引用棘轮（z42-doc §4.6/§4.9）：internals / reference 书页与 README 里的反引号符号
// 引用要能解析（引擎 = z42.doc 的 DocRefs，与 `z42 doc --page` 同一套），行号引用（`Foo.z42:57`）
// 与解析不了的多段链计入 scripts/test/doc-refs-baseline.txt，只降不升；--update 重写。
// 生成页（页首「由 z42 doc 生成」标记）自带 file:line 位置行、随 gen 重写不腐，不查；
// learn 的引用对象在 examples/（不进符号索引），由 learn↔examples 检查管，不在此列。
int _checkDocRefs(bool update) {
    string root = _root();
    // Rust 外部索引：门禁每次重建——不止「缺失才建」：rust.idx 过期时新引入的 Rust 符号查不到，
    // 刚合并的运行时改动会被误报成书页失同步（#1310 的 M13 符号就撞过）。cargo 增量，代价秒级。
    string rustIdx = Path.Join(root, "artifacts/doc/rust.idx");
    int rc = _docIndex();
    if (rc != 0 || !File.Exists(rustIdx)) {
        ConsoleError.WriteLine("check doc-refs: rust.idx 生成失败——先手动跑 `xtask doc index`");
        return 1;
    }
    DocIndex ix = DocQuery.BuildIndex(root, "", "");
    ExternalIndex.LoadDir(root, Path.Join(root, "artifacts/doc"), "", ix);

    // 分区域：internals / reference / readme（根 README + src/**/README.md）。其余页跳过。
    string[] pages = DocQuery.BookPages(root);
    string[] all = new string[pages.Length + 1];
    int an = 0;
    int pi = 0;
    while (pi < pages.Length) { all[an] = pages[pi]; an = an + 1; pi = pi + 1; }
    if (File.Exists(Path.Join(root, "README.md"))) { all[an] = Path.Join(root, "README.md"); an = an + 1; }

    string[] groups = new string[an];
    int[] lineNos = new int[an];
    int[] unresolved = new int[an];
    int gn = 0;
    string[] worstPage = new string[an];
    int[] worstCnt = new int[an];
    int printed = 0;
    int i = 0;
    while (i < an) {
        string p = all[i];
        i = i + 1;
        string rel = p.Substring(root.Length + 1);
        string group = "";
        if (rel.EndsWith("README.md")) { group = "readme"; }
        else if (rel.StartsWith("docs/internals/src/")) { group = "internals"; }
        else if (rel.StartsWith("docs/reference/src/")) { group = "reference"; }
        else { continue; }
        string md = File.ReadAllText(p);
        if (md.IndexOf("由 z42 doc 生成") >= 0) { continue; }   // 生成页：位置行随 gen 重写
        if (rel.EndsWith("SUMMARY.md")) { continue; }           // 纯链接清单
        int g = _groupAt(groups, gn, group);
        if (g < 0) { groups[gn] = group; g = gn; gn = gn + 1; }
        DocPage page = DocRefs.Extract(md);
        DocRefs.Resolve(page, ix);
        int r = 0;
        while (r < page.Refs.Length) {
            DocRef rf = page.Refs[r];
            if (rf.Kind == DocRef.LineNo) {
                lineNos[g] = lineNos[g] + 1;
                if (printed < 15) { ConsoleError.WriteLine("  " + rel + ":" + rf.Line.ToString() + ": 行号引用 " + rf.Text + " —— 写符号，位置用 z42 doc --page 现查"); printed = printed + 1; }
            } else if (rf.Multi && rf.Target == null) {
                unresolved[g] = unresolved[g] + 1;
            }
            r = r + 1;
        }
        int cnt = DocRefs.ProblemCount(page);
        if (cnt > worstCnt[g]) { worstCnt[g] = cnt; worstPage[g] = rel; }
    }

    string baselinePath = Path.Join(root, "scripts/test/doc-refs-baseline.txt");
    if (update) {
        string outp = "# 书页代码引用棘轮基线（xtask check doc-refs --update 重写）。\n"
            + "# 每区域两数：行号引用（要清零，之后变成硬指标）、解析不了的多段链（只降不升）。\n"
            + "# 生成页（z42 doc 生成）与 learn 不查（learn 的对象在 examples/，归 learn↔examples 检查）。\n";
        int w = 0;
        while (w < gn) { outp = outp + groups[w] + " " + lineNos[w].ToString() + " " + unresolved[w].ToString() + "\n"; w = w + 1; }
        File.WriteAllText(baselinePath, outp);
        Console.WriteLine("check doc-refs: ↻ 基线重写 → " + baselinePath);
        return 0;
    }

    string[] lines = File.ReadAllText(baselinePath).Split("\n");
    string fail = "";
    int li = 0;
    while (li < lines.Length) {
        string t = lines[li].Trim();
        li = li + 1;
        if (t.Length == 0 || t.StartsWith("#")) { continue; }
        string[] parts = t.Split(" ");
        if (parts.Length < 3) { continue; }
        string g = parts[0];
        int bl = int.Parse(parts[1]);
        int bu = int.Parse(parts[2]);
        int nowL = 0; int nowU = 0;
        int q = 0;
        while (q < gn) { if (groups[q] == g) { nowL = lineNos[q]; nowU = unresolved[q]; break; } q = q + 1; }
        if (nowL > bl || nowU > bu) {
            fail = fail + "\n  " + g + ": 行号 " + nowL.ToString() + "/" + bl.ToString() + "、未解析 " + nowU.ToString() + "/" + bu.ToString()
                + "（最差页 " + worstPage[q] + "）";
        } else if (nowL < bl || nowU < bu) {
            Console.WriteLine("  " + g + ": 行号 " + bl.ToString() + " → " + nowL.ToString() + "、未解析 " + bu.ToString() + " → " + nowU.ToString() + "（可收紧基线）");
        }
    }
    if (fail.Length > 0) {
        ConsoleError.WriteLine("check doc-refs: 超出基线：" + fail);
        return 1;
    }
    Console.WriteLine("check doc-refs: ✓ 各区域引用在基线内（" + Path.GetFileName(baselinePath) + "）");
    return 0;
}

int _groupAt(string[] groups, int n, string g) {
    int i = 0;
    while (i < n) { if (groups[i] == g) { return i; } i = i + 1; }
    return -1;
}

// 漂移门禁：重新生成并与仓库内文件 diff，不一致即失败并提示 `xtask doc gen`。
int _checkDocsApi() {
    string root = _root();
    string outDir = Path.Join(root, "docs/reference/src/stdlib");
    string[] libs = _stdlibList(root);
    DocMd.SourceBase = _docSourceBase();
    string failed = "";
    int i = 0;
    while (i < libs.Length) {
        string pkg = libs[i];
        DocIndex ix = DocQuery.BuildIndex(root, pkg, "");
        if (!DocMd.HasNamespaceDoc(ix)) { i = i + 1; continue; }
        if (_isTypeSplit(pkg)) {
            _GenFile[] fs = _typeSplitFiles(pkg, _docPageName(pkg), ix);
            int j = 0;
            while (j < fs.Length) {
                string path = Path.Join(outDir, fs[j].Name);
                string committed = File.Exists(path) ? File.ReadAllText(path) : "";
                if (committed != fs[j].Content) {
                    if (failed.Length > 0) { failed = failed + ", "; }
                    failed = failed + fs[j].Name;
                }
                j = j + 1;
            }
            if (_syncSummary(root, _docPageName(pkg), ix, true) != 0) { return 1; }
        } else {
            string page = DocMd.PackagePage(pkg, DocMd.PkgDir(ix), ix);
            string path = Path.Join(outDir, _docPageName(pkg) + ".md");
            string committed = File.Exists(path) ? File.ReadAllText(path) : "";
            if (committed != page) {
                if (failed.Length > 0) { failed = failed + ", "; }
                failed = failed + _docPageName(pkg);
            }
        }
        i = i + 1;
    }
    if (failed.Length > 0) {
        ConsoleError.WriteLine("check docs-api: 生成的页面与仓库内文件不一致（" + failed + "）。运行 `xtask doc gen` 重新生成。");
        return 1;
    }
    Console.WriteLine("check docs-api: ✓ 已迁移包的页面与源码一致");
    return 0;
}

int _docIndex() {
    string root = _root();
    Stopwatch sw = _procStart("doc index (Rust crates → artifacts/doc/rust.idx)");
    int c = _exec(_cargoRelease(_runtimeCargoConfig())
        .Arg("--manifest-path").Arg("src/toolchain/devtools/rust-index/Cargo.toml"));
    if (c != 0) { ConsoleError.WriteLine("  ✗ rust-index cargo build failed"); return c; }
    string bin = Path.Join(_cargoOutFor(root, _detectHostRid(), "release"),
        Platform.IsWindows() ? "z42-rust-index.exe" : "z42-rust-index");
    Process p = new Process(bin).Arg("--root").Arg(root)
        .Arg("--out").Arg(Path.Join(_docIndexDir(root), "rust.idx"))
        .Arg("--regen").Arg("xtask doc index");
    string[] crates = _docRustCrates(root);
    int i = 0;
    while (i < crates.Length) { p = p.Arg(crates[i]); i = i + 1; }
    c = _exec(p);
    if (c != 0) { ConsoleError.WriteLine("  ✗ rust-index failed"); return c; }
    _procEnd("doc index", sw);
    return 0;
}

// 要索引的 crate：`<crate 名>=<相对仓库根的 crate 根文件>`。运行时主 crate（lib + z42vm 二进制）加
// src/runtime/crates/ 下每个带 src/lib.rs 的子 crate（目录名的 `-` 换成 `_`，与 Rust 里引用它的写法一致）。
string[] _docRustCrates(string root) {
    string[] acc = new string[32];
    int n = 0;
    acc[n] = "z42=src/runtime/src/lib.rs"; n = n + 1;
    acc[n] = "z42vm=src/runtime/src/main.rs"; n = n + 1;
    foreach (var d in Directory.Enumerate(Path.Join(root, "src/runtime/crates"))) {
        string lib = "src/runtime/crates/" + d + "/src/lib.rs";
        if (n < acc.Length && File.Exists(Path.Join(root, lib))) { acc[n] = d.Replace("-", "_") + "=" + lib; n = n + 1; }
    }
    string[] r = new string[n];
    Array.Copy(acc, r, n);
    return r;
}
