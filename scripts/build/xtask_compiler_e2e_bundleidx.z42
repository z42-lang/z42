// xtask — exe 装配 indexed（开发态）依赖时连散装 zbc 一起拷（fix-bundle-indexed-deps）。
//
// workspace 里「exe 成员依赖 lib 成员」的 debug 构建此前一直跑不起来：lib 默认 indexed，装配进 exe 的
// dist 只拷了主文件、散装 zbc 没跟过去 ⇒ 运行期 `undefined function`。现在保持 indexed、连散装 zbc 一起
// 拷（保持相对布局）；与本包 / 别的依赖的散装 zbc 撞名 ⇒ 构建期报错。
namespace Z42Xtask;

using Std.IO;

string _e2eBiWsToml() {
    return "[workspace]\nmembers = [\"*\"]\n\n[workspace.build]\noutput_dir = \"artifacts/${project_name}/${profile}\"\n";
}

int _e2eBundleIndexedChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string tmp = _e2eTmpRoot(root, "bundleidx");
    if (Directory.Exists(tmp)) { try { Directory.Delete(tmp, true); } catch (Exception e) {} }

    // ① exe 成员 + lib 成员（源文件名不同）：debug 构建后 exe 能跑。
    string ws = Path.Join(tmp, "ok");
    Directory.Create(Path.Join(ws, "lib")); Directory.Create(Path.Join(ws, "app"));
    File.WriteAllText(Path.Join(ws, "z42.workspace.toml"), _e2eBiWsToml());
    File.WriteAllText(Path.Join(ws, "lib/bilib.z42.toml"),
        "[project]\nname    = \"bilib\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n");
    File.WriteAllText(Path.Join(ws, "lib/l.z42"), "namespace BiLib;\n\npublic static class L { public static int V() { return 11; } }\n");
    File.WriteAllText(Path.Join(ws, "app/biapp.z42.toml"),
        "[project]\nname    = \"biapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\nentry   = \"Main\"\n\n"
        + "[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"bilib\" = \"0.1.0\"\n");
    File.WriteAllText(Path.Join(ws, "app/main.z42"), "using Std.IO;\nusing BiLib;\n\nvoid Main() { Console.WriteLine(L.V()); }\n");
    ProcessResult b = _z42Proc(vm, flat).WorkingDirectory(ws).Arg(driverZpkg).Arg("--").Arg("build").Arg("--workspace")
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (b.ExitCode != 0) {
        Console.WriteLine("  ✗ bundleidx ①：exe + lib 成员 debug 构建失败: " + b.Stdout + b.Stderr);
        return 1;
    }
    ProcessResult r = _z42Proc(vm, flat).Arg(Path.Join(ws, "artifacts/biapp/debug/dist/biapp.zpkg"))
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (r.ExitCode != 0 || r.Stdout.Trim() != "11") {
        Console.WriteLine("  ✗ bundleidx ①：exe 跑不出 11（indexed 依赖的散装 zbc 没跟过去？）: rc="
            + r.ExitCode.ToString() + " " + r.Stdout + r.Stderr);
        return 1;
    }

    // ② 同名源文件：exe 与 lib 都有 x.z42 ⇒ 构建期撞名报错（而不是运行期加载到别人的代码）。
    string ws2 = Path.Join(tmp, "clash");
    Directory.Create(Path.Join(ws2, "lib")); Directory.Create(Path.Join(ws2, "app"));
    File.WriteAllText(Path.Join(ws2, "z42.workspace.toml"), _e2eBiWsToml());
    File.WriteAllText(Path.Join(ws2, "lib/bclib.z42.toml"),
        "[project]\nname    = \"bclib\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n");
    File.WriteAllText(Path.Join(ws2, "lib/x.z42"), "namespace BcLib;\n\npublic static class L { public static int V() { return 1; } }\n");
    File.WriteAllText(Path.Join(ws2, "app/bcapp.z42.toml"),
        "[project]\nname    = \"bcapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\nentry   = \"Main\"\n\n"
        + "[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"bclib\" = \"0.1.0\"\n");
    File.WriteAllText(Path.Join(ws2, "app/x.z42"), "using Std.IO;\nusing BcLib;\n\nvoid Main() { Console.WriteLine(L.V()); }\n");
    ProcessResult b2 = _z42Proc(vm, flat).WorkingDirectory(ws2).Arg(driverZpkg).Arg("--").Arg("build").Arg("--workspace")
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string o2 = b2.Stdout + b2.Stderr;
    if (b2.ExitCode == 0 || o2.IndexOf("collides") < 0) {
        Console.WriteLine("  ✗ bundleidx ②：同名散装 zbc 撞名没有在构建期报出: rc=" + b2.ExitCode.ToString() + " " + o2);
        return 1;
    }
    Console.WriteLine("  ✓ exe 装配 indexed 依赖：散装 zbc 随行、exe 能跑 / 同名撞车构建期报错");
    return 0;
}
