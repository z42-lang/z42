// xtask — `build test`：编译 golden 测试资产（_buildTest）+ 共享的 golden regen 机制（_regenGolden / _regenCore，
// `test` 门禁的构建波经 _regenForTest 调用）。文件名不带 `xtask_test_` 前缀是有意的：那个前缀专表「`test <x>`
// 命令的实现」，本文件编译测试资产、自己不含测试（命名规则见 scripts/README.md）。
//
// Recompiles every golden `.z42` the shared corpus walk finds (_walkGoldenCorpus, common/xtask_golden.z42 —
// see there for the segments and how the consumers' inclusion policies differ). Output goes to the artifacts
// mirror. The full (unfiltered) regen also rewrites the checked-in zbc wire-format byte baselines IN PLACE
// (_formatZbcFixtureCases), so `git diff` flags format drift. Tally + return 1 on any failure.
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

// `xtask build test` — compile the golden test assets (src/tests + library tests → `.zbc` mirror under
// artifacts/build/tests). Ensures z42c + stdlib + z42vm are present (build-if-missing, like the other build
// commands), then compiles the goldens WITHOUT rebuilding the toolchain.
int _buildTest() {
    int p = _ensureToolchainDeps(_root()); if (p != 0) { return p; }
    return _regenGolden();
}

// golden regen 的并发度。成本由**每个进程的 z42c 启动**主导（载 driver.zpkg + 兄弟包 + stdlib）而非编译本身，
// 所以并发度高于核数仍有收益。取 max(8, CpuCount())：少核机器（GitHub 标准 runner 4 核）保持 8、不外推；
// `Z42_REGEN_JOBS` 逃生舱可不改代码在 CI 上试别的值。
int _regenJobs() {
    string ov = Environment.GetEnvironmentVariable("Z42_REGEN_JOBS", "");
    if (ov.Length > 0) {
        try {
            int v = int.Parse(ov);
            if (v > 0) { return v; }
        } catch (Exception e) { }
        _vNormal("  ⚠ Z42_REGEN_JOBS 值非法（" + ov + "），回落到默认并发度");
    }
    int cpu = OperatingSystem.CpuCount();
    return cpu > 8 ? cpu : 8;
}

// One golden regen case: source .z42 → output .zbc.
class _GoldenCase {
    public string name;
    public string source;
    public string output;
    public bool   optAll;   // opt_all sidecar → 按 release 全优化编（见 _compileCaseSpawn）
    public _GoldenCase(string name, string source, string output, bool optAll) {
        this.name = name; this.source = source; this.output = output; this.optAll = optAll;
    }
}

// Select the regen set out of the shared corpus walk.
// Filters mirror _enumerateCasesF's --dir (category) / --file (name or source-path substring)
// narrowing so `test e2e --file X` on the fast --no-build / --toolchain path regenerates ONLY the matched
// case's .zbc. Both filters empty = the full set (`build test` + gate build-wave).
_GoldenCase[] _collectGoldenCasesF(string root, string dirFilter, string fileFilter) {
    List<_GoldenCase> cases = new List<_GoldenCase>();
    foreach (var e in _walkGoldenCorpus(root)) {
        if (e.seg == "lib-file") { continue; }   // stdlib [Test] file units — z42b's, not golden
        if (!e.hasSource) { continue; }
        if (e.isLib) {
            // --dir <cat> excludes library golden tests entirely (mirrors _enumerateCasesF).
            if (dirFilter.Length > 0) { continue; }
            // Skip [Test]/[Benchmark] dir tests — run by `xtask test stdlib` (z42b),
            // not golden regen (no Main → no golden output).
            if (e.hasTestMethods) { continue; }
            if (fileFilter.Length > 0 && !_e2eIncluded("", e.name, e.src, "", fileFilter)) { continue; }
        } else {
            if (!_e2eIncluded(e.cat, e.name, e.src, dirFilter, fileFilter)) { continue; }
        }
        string mirrorDir = _goldenArtifactDir(root, e.relUnderSrc);
        Directory.Create(mirrorDir);
        cases.Add(new _GoldenCase(e.name, e.src, Path.Join(mirrorDir, e.zbcName), e.optAll));
    }

    // Full regen only: the zbc wire-format byte baselines, rewritten in place. A
    // --dir / --file narrowed regen is for iterating on goldens and leaves them alone.
    if (dirFilter.Length == 0 && fileFilter.Length == 0) {
        foreach (var d in _formatZbcFixtureCases(root)) {
            cases.Add(new _GoldenCase("zbc-format/" + Path.GetFileName(d),
                Path.Join(d, "source.z42"), Path.Join(d, "source.zbc"), false));
        }
    }
    return cases.ToArray();
}

// The checked-in `.zbc` wire-format byte baselines (z42.package owns the writer):
// every `<fixtures>/zbc-format/<name>/` with a `source.z42`. Regen compiles each
// back onto its own committed `source.zbc` — that is what makes CI's
// "regen produced no diff" check mean "the committed bytes are current".
string _formatZbcFixtureDir(string root) {
    return Path.Join(root, "src/compiler/z42.package/tests/fixtures/zbc-format");
}

string[] _formatZbcFixtureCases(string root) {
    List<string> found = new List<string>();
    foreach (var d in _enumDirsSorted(_formatZbcFixtureDir(root))) {
        string full = Path.Join(_formatZbcFixtureDir(root), d);
        if (File.Exists(Path.Join(full, "source.z42"))) { found.Add(full); }
    }
    return found.ToArray();
}

int _regenGolden() {
    return _regenGoldenF("", "");
}

// Filtered golden regen: dirFilter/fileFilter narrow the compiled set the same way
// `test e2e --dir/--file` narrows the run set (via _collectGoldenCasesF), so the
// fast --no-build / --toolchain iteration path recompiles only the touched case(s).
// Both empty = full regen (the `build test` + gate build-wave behavior).
int _regenGoldenF(string dirFilter, string fileFilter) {
    string root = _root();
    // driverHome = driver 自己的 release dist（自包含）；golden 的 stdlib 依赖走 Z42_LIBS=stdlibDist。
    // --toolchain：用所选工具链的 z42c + stdlib + z42vm，否则用构建树。
    string tc = _toolchainDir(root);
    string driverHome = (tc.Length > 0) ? _toolchainDriverHome(tc) : _driverHome(root);
    if (driverHome.Length == 0) {
        ConsoleError.WriteLine("error: z42c driver not built (artifacts/build/compiler/z42c.*/release/dist)");
        ConsoleError.WriteLine("       Build it via stdlib/compiler build first.");
        return 1;
    }
    string driverZpkg = Path.Join(driverHome, "z42c.driver.zpkg");
    string stdlibDist = (tc.Length > 0) ? _toolchainLibs(tc) : _libsDir(root);
    // Golden regen z42c-compiles EVERY case — prefer the RELEASE z42vm (z42c runs many× faster than on the
    // debug vm); fall back to the debug vm only if release is absent. Regen only COMPILES the .zbc
    // (deterministic z42c output); the golden RUN resolves its own vm (_runVmGoldensF), so this doesn't
    // change what's tested.
    string vmBin = _activeVm(root, "release");
    if (!File.Exists(vmBin)) { vmBin = _activeVm(root, "debug"); }
    if (!File.Exists(vmBin)) {
        ConsoleError.WriteLine("error: z42vm not found (build via: cd src/runtime && cargo build)");
        return 1;
    }

    bool filtered = (dirFilter.Length > 0 || fileFilter.Length > 0);
    if (filtered) {
        string scope = (dirFilter.Length > 0 ? ("--dir " + dirFilter) : "")
            + (fileFilter.Length > 0 ? ((dirFilter.Length > 0 ? " " : "") + "--file " + fileFilter) : "");
        Console.WriteLine("Regenerating golden test artifacts (" + scope + ")...");
    } else {
        Console.WriteLine("Regenerating golden test artifacts...");
    }
    Console.WriteLine("");

    // ── Enumerate cases ──
    _GoldenCase[] cases = _collectGoldenCasesF(root, dirFilter, fileFilter);
    int caseCount = cases.Length;

    if (filtered && caseCount == 0) {
        Console.WriteLine("  (no golden case matched the filter — nothing to regenerate)");
    }

    // ── Compile each case (parallel batches) ─────────────────────────────
    // Each case spawns z42vm + z42c.driver to compile one source.z42 — the cost is dominated by per-process
    // driver startup, not the compile itself, so the cases parallelize well. Batches of `jobs`: spawn → wait →
    // collect. Outputs are independent .zbc files, so order doesn't matter.
    int jobs = _regenJobs();
    int pass = 0;
    List<string> failures = new List<string>();
    int k = 0;
    while (k < caseCount) {
        int bsz = jobs;
        if (k + bsz > caseCount) { bsz = caseCount - k; }
        ProcessHandle[] hs = new ProcessHandle[bsz];
        for (int b = 0; b < bsz; b = b + 1) {
            _GoldenCase c = cases[k + b];
            hs[b] = _compileCaseSpawn(vmBin, driverZpkg, stdlibDist, c.source, c.output, c.optAll);
        }
        for (int b = 0; b < bsz; b = b + 1) {
            string name = cases[k + b].name;
            bool ok = false;
            try {
                ProcessResult r = hs[b].Wait();
                ok = (r.ExitCode == 0);
            } catch (Exception e) {
                ok = false;
            }
            if (ok) {
                Console.WriteLine("  OK:   " + name);
                pass = pass + 1;
            } else {
                Console.WriteLine("  FAIL: " + name);
                failures.Add(name);
            }
        }
        k = k + bsz;
    }

    Console.WriteLine("");
    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Regenerated: " + pass.ToString() + " ok, "
        + failures.Count.ToString() + " failed, 0 skipped");
    Console.WriteLine("══════════════════════════════════════");

    if (failures.Count > 0) {
        Console.WriteLine("");
        Console.WriteLine("Failed tests:");
        foreach (var f in failures) { Console.WriteLine("  - " + f); }
        return 1;
    }
    return 0;
}

// Spawn (don't wait) the z42c compile of one golden case (z42vm 跑 z42c.driver.zpkg --emit-zbc；golden 的 stdlib
// 依赖经 Z42_LIBS=stdlibDist 解析）。Caller batches the Wait() across `jobs` concurrent handles; output .zbc
// paths are unique per case.
ProcessHandle _compileCaseSpawn(string vmBin, string driverZpkg, string stdlibDist, string source, string output, bool optAll) {
    Process p = _z42cProc(vmBin, stdlibDist, driverZpkg).Arg("--emit-zbc").Arg(source).Arg(output);
    // opt_all sidecar：这条用例要按**真实 release 全优化**编。默认 emit-zbc 优化集关掉了
    // 逃逸分析 / 内联 / loop-alloc-reuse（会改 golden 字节，见 IrDump.EmitZbcDefaultOpt），
    // 于是那几个 pass 在整个 golden 语料里一次也跑不到；用例加个 `opt_all` 空文件即可让它跑在优化后的代码上。
    if (optAll) { p = p.Arg("--opt-all"); }
    return p
        .Stdout(Stdio.Null())
        .Stderr(Stdio.Null())
        .Spawn();
}

// ── golden-asset rebuild (shared by `build test` + the gate build-wave) ─────

int _regenCore(bool rebuildStdlib) {
    // ⚠ release z42vm FIRST —— stdlib 是**用 z42vm 自建**的，VM 一旦旧于 src/runtime/，
    // 第一个 stage 就炸在指不到真因的 `unknown builtin __x` →
    // `z42c --workspace self-build failed` 上（本轮源码新加的 builtin 不在已建 VM 里）。
    // `_buildStdlib` 自己的 VM 兜底是 build-if-MISSING，判不了「旧」；cargo 才知道 runtime 源码变没变，
    // 且没变时近乎空转。
    int cr = _buildRuntime(); if (cr != 0) { return cr; }
    // _buildStdlib 顺带把 z42c per-member dist 建好，_regenGolden 直接用 driver 的 dist。
    if (rebuildStdlib) { int c = _buildStdlib(); if (c != 0) { return c; } }
    return _regenGolden();
}
