// xtask — flat workspace 的产物互不覆盖（fix-flat-workspace-packed）。
//
// **守的是什么**：`z42c build --workspace --output-dir <d>`（Milestone-1 flat 布局）让全部成员共用一个
// dist。debug 默认 indexed：散装 `.zbc` 按**工程内相对路径**落在 dist 下 ⇒ 两个成员都有 `x.z42` 时
// 只剩一个 `x.zbc`（后建的覆盖先建的），`_cleanOrphanZbc` 还会把别的成员的 zbc 当孤儿删掉。
// 修后 flat 成员一律 packed。
//
// 判据取**行为**：两个 exe 成员各有一个同名 `x.z42`、输出不同的数；flat debug 构建后两个产物都要能跑、
// 各自打印自己的数。修前第一个成员打印的是第二个成员的代码（或加载失败）。
namespace Z42Xtask;

using Std.IO;

string _e2eWsFlatMemberToml(string name) {
    return "[project]\nname    = \"" + name + "\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
         + "entry   = \"Main\"\n\n[sources]\ninclude = [\"*.z42\"]\n";
}

int _e2eWsFlatChecks(string root, string vm, string driverZpkg) {
    string flat = _libsFlatDist(root, "release");
    string ws = _e2eTmpRoot(root, "wsflat");
    if (Directory.Exists(ws)) { try { Directory.Delete(ws, true); } catch (Exception e) {} }
    string ma = Path.Join(ws, "ma");
    string mb = Path.Join(ws, "mb");
    string outDir = Path.Join(ws, "out");
    Directory.Create(ma); Directory.Create(mb); Directory.Create(outDir);
    File.WriteAllText(Path.Join(ws, "z42.workspace.toml"), "[workspace]\nmembers = [\"*\"]\n");
    File.WriteAllText(Path.Join(ma, "wsfa.z42.toml"), _e2eWsFlatMemberToml("wsfa"));
    File.WriteAllText(Path.Join(mb, "wsfb.z42.toml"), _e2eWsFlatMemberToml("wsfb"));
    File.WriteAllText(Path.Join(ma, "x.z42"), "using Std.IO;\n\nvoid Main() { Console.WriteLine(\"111\"); }\n");
    File.WriteAllText(Path.Join(mb, "x.z42"), "using Std.IO;\n\nvoid Main() { Console.WriteLine(\"222\"); }\n");

    // flat 布局只从 `--output-dir` 这一个目录解析依赖 ⇒ 调用方须预置 stdlib（同自举的用法）。
    string[] stdlib = Path.Glob(flat, "*.zpkg");
    int si = 0;
    while (si < stdlib.Length) { File.Copy(stdlib[si], Path.Join(outDir, Path.GetFileName(stdlib[si]))); si = si + 1; }

    // debug（不带 --release）：修前走 indexed，正是会撞的那条路。
    ProcessResult b = _z42Proc(vm, flat).WorkingDirectory(ws).Arg(driverZpkg).Arg("--").Arg("build")
        .Arg("--workspace").Arg("--output-dir").Arg(outDir)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (b.ExitCode != 0) {
        Console.WriteLine("  ✗ wsflat: flat workspace debug 构建失败: rc=" + b.ExitCode.ToString() + " stderr=" + b.Stderr);
        return 1;
    }
    ProcessResult ra = _z42Proc(vm, outDir).Arg(Path.Join(outDir, "wsfa.zpkg"))
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    ProcessResult rb = _z42Proc(vm, outDir).Arg(Path.Join(outDir, "wsfb.zpkg"))
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (ra.ExitCode != 0 || ra.Stdout.Trim() != "111" || rb.ExitCode != 0 || rb.Stdout.Trim() != "222") {
        Console.WriteLine("  ✗ wsflat: 两个成员的同名源 x.z42 在共用 dist 里互相覆盖：wsfa → rc="
            + ra.ExitCode.ToString() + " `" + ra.Stdout.Trim() + "` " + ra.Stderr
            + " / wsfb → rc=" + rb.ExitCode.ToString() + " `" + rb.Stdout.Trim() + "` " + rb.Stderr);
        return 1;
    }
    Console.WriteLine("  ✓ flat workspace：成员同名源不再在共用 dist 里互相覆盖（flat 成员一律 packed）");
    return 0;
}
