// xtask — `test compiler bootstrap`: staged-bootstrap boundary check.
//
// Enforces the staged-bootstrap discipline (docs/internals/src/compiler/self-hosting.md): the LAST PUBLISHED
// nightly's z42c must be able to compile the CURRENT repo source. If it can't, the
// source uses syntax / a zbc·zpkg format newer than the published nightly supports
// — a boundary violation that would break the bootstrap (build-and-test seeds from
// the previous nightly). The boundary is exercised in CI by every job that runs the
// ci-bootstrap action; this is the fast local equivalent (no CI job invokes it).
//
// Dual-compiles the z42c workspace and reports:
//   (A) nightly z42c → current source   ← the boundary check (must PASS)
//   (B) repo  z42c   → current source   ← the normal self-build (sanity)
// (A) fails but (B) passes ⇒ you used something newer than the published nightly:
// split into "support first (old-syntax-written), use later" per the discipline.
//
// WHAT THIS GATE DOES AND DOESN'T GUARD. Both runs go through `_ensureBootstrapSelfDepLibs`,
// exactly like the real `build compiler` path, so:
//
//   ✅ axis ① syntax          — the seed z42c must parse current source (incl. the self-dep
//                               libs it pre-builds), so new syntax fails here.
//   ✅ axis ② zbc/zpkg format — ditto; a format the seed can't emit/read fails here.
//   ✅ axis ③ OTHER stdlib    — z42.collections / z42.threading / … are NOT pre-built, so
//                               z42c source using their new APIs still fails here.
//   ❌ axis ③ SELF-DEP libs   — z42.core / z42.project / z42.build / z42.package / z42c.core /
//                               z42c.syntax are rebuilt from CURRENT source by the pre-build.
//                               Guarding them would be guarding a constraint that does not
//                               exist: the real build pre-builds them too (self-hosting.md
//                               axis ④) — 刻意不守，别把它当缺口补回去。
//   ❌ axis ④ runtime self-dep — still unverified here (this gate only compiles; it never
//                               RUNS the freshly built z42c). Cold-start runtime breakage
//                               (`undefined function …`) surfaces in CI's ci-bootstrap jobs
//                               (they RUN gen1 z42c to build stdlib + goldens) and compiler-checks.
namespace Z42Xtask;

using Std.IO;
using Std.Time;

int _bootstrapCheck(string ridArg) {
    Stopwatch sw = _procStart("test compiler bootstrap");
    string root = _root();
    string[] members = _compilerMembers(root);

    string rid = ridArg;
    if (rid.Length == 0) { rid = _detectHostRid(); }
    if (rid.Length == 0) {
        ConsoleError.WriteLine("error: cannot detect host RID — pass it explicitly (e.g. macos-arm64)");
        return 2;
    }
    if (!_have("gh")) {
        ConsoleError.WriteLine("error: `gh` (authenticated) is required to download the nightly seed");
        return 2;
    }

    string work = _compilerWsWork(root, "bootstrap-check");
    _resetDir(work);

    // ── fetch the latest nightly SDK package (z42vm + libs/ + programs/z42c/ seed) ──
    // The z42c seed lives in the SDK nightly (host tooling), not the runtime nightly —
    // the runtime package is a pure embeddable pack (native + stdlib only, no z42c/z42vm)
    // since it may be installed on a different host than it targets.
    string ext = "tar.gz";
    if (rid == "windows-x64") { ext = "zip"; }
    string asset = "z42-sdk-nightly-" + rid + "." + ext;
    string archive = Path.Join(work, "sdk." + ext);
    Console.WriteLine("→ downloading nightly SDK package (" + rid + ") …");
    int dc = _exec(new Process("gh").Arg("release").Arg("download").Arg("nightly")
        .Arg("-p").Arg(asset).Arg("-O").Arg(archive));
    if (dc != 0) {
        ConsoleError.WriteLine("error: `gh release download nightly` failed for asset " + asset);
        return 1;
    }

    string nightly = Path.Join(work, "nightly");
    Directory.Create(nightly);
    int xc;
    if (ext == "zip") {
        if (!_have("unzip")) { ConsoleError.WriteLine("error: `unzip` required to extract the windows nightly"); return 2; }
        xc = _exec(new Process("unzip").Arg("-q").Arg(archive).Arg("-d").Arg(nightly));
    } else {
        xc = _exec(new Process("tar").Arg("-C").Arg(nightly).Arg("-xzf").Arg(archive));
    }
    if (xc != 0) { ConsoleError.WriteLine("error: failed to extract " + archive); return 1; }

    // The SDK package's z42vm lives under bin/ (managed layout: z42 apphost at root,
    // bin/z42vm, libs/, native/, programs/z42{c,b}). z42c seed → programs/z42c/.
    string nvm = Path.Join(nightly, "bin/z42vm");
    if (File.Exists(nvm + ".exe")) { nvm = nvm + ".exe"; }
    if (!File.Exists(nvm)) { ConsoleError.WriteLine("error: nightly z42vm missing after extract (expected bin/z42vm)"); return 1; }
    // tar/unzip drop the executable bit — restore it (windows .exe needs none).
    if (ext != "zip") { _exec(new Process("chmod").Arg("+x").Arg(nvm)); }
    string nDriver = Path.Join(Path.Join(nightly, "programs/z42c"), "z42c.driver.zpkg");
    if (!File.Exists(nDriver)) {
        ConsoleError.WriteLine("error: nightly SDK package has no programs/z42c/ seed — needs a publish-nightly run carrying the z42c seed");
        return 1;
    }

    // ── (A) nightly z42c → current source (the boundary check) ──
    int a = _bcRunWorkspace(root, "nightly", nvm, nDriver, Path.Join(nightly, "libs"), members, work);

    // ── (B) repo z42c → current source (normal self-build sanity) ──
    int b = 2;
    string repoDriver = _driverZpkg(root, "release");
    string repoVm = _builtVm(root, "release");
    string repoStd = _libsDir(root);
    if (File.Exists(repoDriver) && File.Exists(repoVm)) {
        // colocate the repo z42c siblings into one dir (per-member dist isn't colocated)
        string rdh = Path.Join(work, "repo-driver-home");
        _resetDir(rdh);
        int mi = 0;
        while (mi < members.Length) {
            _copyAll(_compilerMemberDist(root, members[mi], "release"), rdh, members[mi] + ".zpkg");
            mi = mi + 1;
        }
        b = _bcRunWorkspace(root, "repo", repoVm, Path.Join(rdh, "z42c.driver.zpkg"), repoStd, members, work);
    } else {
        Console.WriteLine("── [repo] skipped: repo z42c not built (run `xtask build compiler` first) ──");
    }

    // ── verdict ──
    Console.WriteLine("");
    if (a == 0) {
        Console.WriteLine("✅ nightly z42c compiles current source — NO staged-bootstrap boundary violation");
    } else {
        ConsoleError.WriteLine("❌ BOUNDARY VIOLATION: the published nightly z42c CANNOT compile current source.");
        ConsoleError.WriteLine("   Current source uses syntax / zbc·zpkg format newer than the last nightly.");
        ConsoleError.WriteLine("   Fix per the staged-bootstrap rule: land the SUPPORT (old-syntax-written) first, publish");
        ConsoleError.WriteLine("   a nightly, THEN use the new syntax. Or revert the premature use.");
    }
    if (b == 0) { Console.WriteLine("✅ repo z42c self-build OK"); }
    else if (b == 2) { Console.WriteLine("ℹ repo self-build skipped (z42c not built)"); }
    else {
        ConsoleError.WriteLine("❌ REPO SELF-BUILD FAILED: the repo-built z42c cannot compile the current source.");
        ConsoleError.WriteLine("   This is the SECOND generation (gen1 built gen2) —— 只有本阶段能发现「gen1 编出的");
        ConsoleError.WriteLine("   gen2 是坏的」这类缺陷（如静态初始化顺序导致投影表全零 → 转换指令被静默丢弃）。");
    }
    // [repo]（第二代自建）失败也必须进退出码，否则本门只是「少打印一行成功」；`b == 2`（未构建）不算失败。
    int __rc = a;
    if (__rc == 0 && b != 0 && b != 2) { __rc = b; }
    if (__rc == 0) { _procEnd("test compiler bootstrap", sw); }
    return __rc;
}

// Compile the current z42c workspace (members in topo order) with a given seed
// (vm + driver + stdlib) into an ISOLATED output tree (not the repo's canonical dist).
// Each member is a single-project build against Z42_LIBS=runlibs; each freshly-built
// sibling is accumulated into runlibs so later members resolve the CURRENT-source
// (seed-compiled) version, not the seed's own bundled copy. Per-member `--output-dir`
// (not workspace-flat `--output-dir`) is required: the compiler members have deep
// interdependencies (z42c.ir → z42c.core types) that only the per-member dist layout
// resolves — a single flat workspace output dir breaks sibling type resolution (E0402).
// Returns 0 if all members built, else 1.
int _bcRunWorkspace(string root, string label, string vm, string driver, string stdlibDir, string[] members, string work) {
    Console.WriteLine("── [" + label + "] compiling current z42c workspace ──");
    string runlibs = Path.Join(work, label + "-runlibs");
    _resetDir(runlibs);
    _copyAll(stdlibDir, runlibs, "*.zpkg");
    _copyAll(Path.GetDirectoryName(driver), runlibs, "*.zpkg");
    // Mirror the REAL `build compiler` path (`_buildCompilerViaZ42c`): break the axis-④ self-dependency
    // ring by pre-building the CURRENT-source self-dep libs with this seed before compiling the workspace
    // (otherwise the nightly's older self-dep libs make z42c source using their new APIs false-red).
    // `runlibs` is both the prebuild output dir and the compile surface (Z42_LIBS), which keeps this check
    // isolated; the seed driver's own runtime libs are snapshotted first (`bcSeedRun`, mounted as probing),
    // since the prebuild overwrites runlibs with current-source libs the seed generation can't load
    // (same split as `_buildCompilerViaZ42c` / `_z42cProcSeed`).
    string bcSeedRun = Path.Join(work, label + "-seedrun");
    _resetDir(bcSeedRun);
    _copyAll(runlibs, bcSeedRun, "*.zpkg");
    _copyAll(runlibs, bcSeedRun, "*.zsym");
    if (_ensureBootstrapSelfDepLibs(root, vm, driver, runlibs, bcSeedRun) != 0) { return 1; }
    string outRoot = Path.Join(work, label + "-out");
    _resetDir(outRoot);
    int fail = 0;
    int i = 0;
    while (i < members.Length) {
        string m = members[i];
        string outDir = Path.Join(outRoot, m);
        int rc = _z42cProcMode(vm, runlibs, driver, "interp")
            .Arg("build").Arg(Path.Join(root, "src/compiler/" + m + "/" + m + ".z42.toml"))
            .Arg("--release").Arg("--output-dir").Arg(outDir)
            .Stdout(Stdio.Null()).Stderr(Stdio.Inherit()).Run().ExitCode;
        string produced = Path.Join(outDir, m + ".zpkg");
        if (rc == 0 && File.Exists(produced) && File.GetSize(produced) > 0L) {
            Console.WriteLine("   ✓ " + m);
            _copyAll(outDir, runlibs, m + ".zpkg");   // accumulate fresh sibling for later members
        } else {
            Console.WriteLine("   ✗ " + m + " FAILED");
            fail = 1;
        }
        i = i + 1;
    }
    return fail;
}
