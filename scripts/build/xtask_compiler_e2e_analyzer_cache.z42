// xtask — analyzer 诊断必须活过缓存命中（fix-analyzer-diags-preserved）。
//
// **守的是什么**：`[analyzers]` 的诊断与 `[lints]` 的决策不进任何缓存——它们在 PackageCompile
// 里每次构建都重新跑（analyzer 看 AST，cached CU 的 AST 也在）。但「整包全命中」时 driver 在
// `no changes; preserved` 处早退、**压根不进 PackageCompile** ⇒ 两个静默：
//   ① 什么都不改再构建一次：analyzer 的警告从终端上消失；
//   ② 只改 `[lints]`（比如把规则升成 error / 开 warnings-as-errors）：源码没动 ⇒ 全命中 ⇒
//      构建仍 exit 0，本该判红的诊断被吞掉。
// 与 warnings-survive-cache（`test compiler incremental` 那道门）同族：那道守 typecheck 警告（进 meta
// 回放），这道守 analyzer 这一层（不进 meta，只能靠「不早退」）。
//
// 三格：① 冷构建出 Z9002（阳性对照）→ ② 不改再构建仍出 Z9002 → ③ 只加
// `[lints] warnings-as-errors = true` ⇒ 构建必须失败且错因是 Z9002。
namespace Z42Xtask;

using Std.IO;

// analyzer：报告空 catch（Z9002，默认 warning）。与 pkgcompile 单测的夹具同形，类名独立。
string _e2eLintAnalyzerSrc() {
    return "namespace E2eLint;\n\nusing Z42.Syntax;\nusing Z42.Core;\n\n"
         + "public class E2eNoEmptyCatchAnalyzer : Analyzer {\n"
         + "    public DiagRule[] SupportedRules() { DiagRule[] r = new DiagRule[1]; r[0] = E2eNoEmptyCatchAnalyzer._rule(); return r; }\n"
         + "    public int[] ObservedKinds() { int[] k = new int[1]; k[0] = SyntaxKind.CatchClause; return k; }\n"
         + "    public void OnSyntaxNode(int kind, object node, DiagSink diags) {\n"
         + "        if (kind == SyntaxKind.CatchClause) {\n"
         + "            CatchClause c = node as CatchClause;\n"
         + "            if (c.Body is BlockStmt) { BlockStmt b = c.Body as BlockStmt; if (b.Count == 0) { diags.Report(E2eNoEmptyCatchAnalyzer._rule(), c.Span); } }\n"
         + "        }\n"
         + "    }\n"
         + "    static DiagRule _rule() { return new DiagRule(\"Z9002\", \"empty catch\", \"empty catch swallows exception\", \"Correctness\", AnalyzerSeverity.Warning, true); }\n"
         + "}\n";
}

string _e2eLintAnalyzerToml() {
    return "[project]\nname    = \"e2e.lint\"\nversion = \"0.1.0\"\nkind    = \"analyzer\"\n\n"
         + "[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[dependencies]\n\"z42c.syntax\" = \"0.1.0\"\n\"z42c.core\" = \"0.1.0\"\n";
}

// 消费方：kind=lib（exe 的 preserved 路径多一段侧车/依赖装配，与本判据无关）。
string _e2eLintAppToml(string lintsSection) {
    return "[project]\nname    = \"e2e.lintapp\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n"
         + "[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[analyzers]\n\"e2e.lint\" = { path = \"../lintpkg\" }\n" + lintsSection;
}

string _e2eLintAppSrc() {
    return "namespace E2eLintApp;\n\npublic static class A {\n"
         + "    public static int F() { try { return 1; } catch (Exception e) { } return 0; }\n"
         + "}\n";
}

ProcessResult _e2eLintBuild(string vm, string driverZpkg, string flat, string toml) {
    return _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Arg("build").Arg(toml).Arg("--release")
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
}

int _e2eAnalyzerDiagCacheChecks(string root, string vm, string driverZpkg, string e2eDir) {
    string flat = _libsFlatDist(root, "release");   // 纯 stdlib dist（同 _e2ePathAnalyzerChecks）
    string ldir = Path.Join(e2eDir, "lintpkg");
    string adir = Path.Join(e2eDir, "lintapp");
    _resetDir(ldir); _resetDir(adir);
    File.WriteAllText(Path.Join(ldir, "lint.z42"), _e2eLintAnalyzerSrc());
    File.WriteAllText(Path.Join(ldir, "e2e.lint.z42.toml"), _e2eLintAnalyzerToml());
    File.WriteAllText(Path.Join(adir, "a.z42"), _e2eLintAppSrc());
    string atoml = Path.Join(adir, "e2e.lintapp.z42.toml");
    File.WriteAllText(atoml, _e2eLintAppToml(""));

    // ① 冷构建：Z9002 必须出现（阳性对照——判据有对象）。
    ProcessResult b1 = _e2eLintBuild(vm, driverZpkg, flat, atoml);
    if (b1.ExitCode != 0 || b1.Stderr.IndexOf("Z9002") < 0) {
        Console.WriteLine("  ✗ analyzer-cache ①：冷构建失败或没报 Z9002（判据失去对象）: rc="
            + b1.ExitCode.ToString() + " stderr=" + b1.Stderr);
        return 1;
    }

    // ② 什么都不改再构建：整包全命中。analyzer 警告必须仍在。
    ProcessResult b2 = _e2eLintBuild(vm, driverZpkg, flat, atoml);
    if (b2.ExitCode != 0 || b2.Stderr.IndexOf("Z9002") < 0) {
        Console.WriteLine("  ✗ analyzer-cache ②：源码一字未改、空 catch 还在，第二次构建却不再报 Z9002。");
        Console.WriteLine("    形态：整包全命中 ⇒ preserved 早退 ⇒ analyzer 没跑。接线点：z42c.driver/src/Main.z42 canPreserve。");
        Console.WriteLine("    rc=" + b2.ExitCode.ToString() + " stderr=" + b2.Stderr);
        return 1;
    }

    // ③ 只改 [lints]：warnings-as-errors ⇒ Z9002 升级为 error ⇒ 构建必须失败。
    File.WriteAllText(atoml, _e2eLintAppToml("\n[lints]\nwarnings-as-errors = true\n"));
    ProcessResult b3 = _e2eLintBuild(vm, driverZpkg, flat, atoml);
    if (b3.ExitCode == 0 || b3.Stderr.IndexOf("Z9002") < 0) {
        Console.WriteLine("  ✗ analyzer-cache ③：开了 [lints] warnings-as-errors，源码没动的构建却仍 exit 0"
            + "（或失败但错因不是 Z9002）: rc=" + b3.ExitCode.ToString() + " stderr=" + b3.Stderr);
        return 1;
    }

    Console.WriteLine("  ✓ analyzer 诊断活过缓存命中：冷构建报 / 全命中仍报 / 只改 [lints] 立即生效");
    return 0;
}
