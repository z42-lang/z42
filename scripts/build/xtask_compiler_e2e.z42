// xtask — z42c e2e 专项检查（split from xtask_compiler.z42 for the 500-line code-org limit; called by
// _testCompilerE2e）。用自举出的 z42c 跑「需要多次构建对照 / 读产物结构」的检查（打包直跑、可复现 build_id、
// cache 布局、依赖身份、workspace 增量……）。只看退出码 / 输出 / 产物有无的命令行行为在 src 的夹具里
// （xtask_compiler_cli_fixtures.z42）。z42c 自身逐字节一致由 xtask_compiler.z42 的自举不动点覆盖；语言功能
// 由 src/tests 的 golden 覆盖（同一个 z42c、同一条 --emit-zbc 路径编译后在 z42vm 上跑）。
namespace Z42Xtask;

using Std.IO;

// z42c build/import e2e checks（build packed zpkg 直跑 + 6 工程可建 + 跨包 Call 链
// 可执行）。Split out of _testCompilerE2e（review §2.8）；纯逐字搬移、短路 return 1。
int _e2eBuildChecks(string root, string vm, string driverZpkg, string e2eDir, string flat) {
    int rc = 0;
    // build e2e（port-z42c-zpkg-build）：z42c build 产 packed zpkg → z42vm 直跑（entry 烤入）。
    // zpkg 级 byte-compare 对真 C# CLI 还差 TSIG/IMPL（follow-up change）；此处验证可执行性
    // + 核心七段（META/NSPC/EXPT/DEPS 已与 C# 逐字节一致，SIGS/MODS 同尺寸仅池索引移位）。
    string bdir = Path.Join(e2eDir, "buildapp");
    Directory.Create(bdir);
    string bsrc = Path.Join(bdir, "app.z42");
    File.WriteAllText(bsrc, "namespace Check.App;\n\nint Twice(int a) { return a + a; }\n\nclass Counter {\n    int v;\n    public int Bump(int d) { v = v + d; return v; }\n}\n\nvoid Main() {\n    var c = new Counter();\n    c.Bump(20);\n    c.Bump(1);\n    int x = Twice(c.Bump(0));\n    int ok = 0;\n    if (x == 42) { ok = 1; }\n    int dummy = 100 / ok;\n}\n");
    string btoml = Path.Join(bdir, "check.app.z42.toml");
    File.WriteAllText(btoml, "[project]\nname    = \"check.app\"\nversion = \"0.1.0\"\nkind    = \"exe\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n");
    rc = _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Arg("build").Arg(btoml)
        .Stdout(Stdio.Null()).Stderr(Stdio.Inherit()).Run().ExitCode;
    if (rc != 0) { Console.WriteLine("  ✗ z42c build failed"); return 1; }
    string appZpkg = Path.Join(bdir, "dist/check.app.zpkg");
    rc = _z42Proc(vm, _libsDir(root)).Arg(appZpkg)
        .Stdout(Stdio.Null()).Stderr(Stdio.Null()).Run().ExitCode;
    if (rc != 0) { Console.WriteLine("  ✗ z42c-built zpkg failed to run (exit " + rc.ToString() + ")"); return 1; }
    Console.WriteLine("  ✓ build e2e: z42c-built check.app.zpkg runs directly on z42vm (entry baked)");

    // zpkg 全文件 byte-compare（port-z42c-tsig）：同工程 z42c vs C# CLI（--strip-symbols=false
    // 关 sidecar/BLID）→ 逐字节 diff。两工程：check.app（exe，调用/对象/字段）+ demo.minimal
    // （namespaced 单类，packed-minimal 同构）。这是 .zpkg 包级对账 gate。
    string ddir = Path.Join(e2eDir, "buildns");
    Directory.Create(ddir);
    File.WriteAllText(Path.Join(ddir, "demo.z42"),
        "namespace Demo.Minimal;\n\nclass Greeter {\n    public string Hello() { return \"hi\"; }\n}\n\nvoid Main() {\n    var g = new Greeter();\n    g.Hello();\n}\n");
    File.WriteAllText(Path.Join(ddir, "demo.minimal.z42.toml"),
        "[project]\nname    = \"demo.minimal\"\nversion = \"0.1.0\"\nkind    = \"exe\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n");
    // hello-stdlib（port-z42c-import）：using Std + Console.WriteLine——跨包消费链对账工程。
    // ⚠ 放 /tmp（仓库外）：C# BuildLibsDirs 会 walk-up 仓库布局并按成员目录字母序扫
    // （z42.cli < z42.core，两者都声明 ns Std）→ 仓库内 DEPS 解析 Std→z42.cli.zpkg；
    // /tmp 下只剩 Z42_LIBS 单目录 → prelude-first → Std→z42.core.zpkg，两侧编译器环境等价。
    // ⚠️ 路径经 `_e2eTmpRoot` **按树分**（fix-e2e-tmp-per-tree）：留在仓库外（上面那条理由不变），
    // 但掺进树名，免得同机并行跑两棵 worktree 时互相覆盖 fixture。
    string hdir = _e2eTmpRoot(root, "buildhello");
    Directory.Create(hdir);
    File.WriteAllText(Path.Join(hdir, "hello.z42"),
        "using Std.IO;\n\nvoid Main() {\n    Console.WriteLine(\"hi\");\n}\n");
    File.WriteAllText(Path.Join(hdir, "hello.app.z42.toml"),
        "[project]\nname    = \"hello.app\"\nversion = \"0.1.0\"\nkind    = \"exe\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n");
    // textapp（port-z42c-instance-import）：StringBuilder（imported 类 VCall+DEPS）+
    // string.Substring（prim receiver → DepIndex instance 捷径 FQ Call）——实例跨包链对账工程
    string tdir = _e2eTmpRoot(root, "buildtext");
    Directory.Create(tdir);
    File.WriteAllText(Path.Join(tdir, "app.z42"),
        "using Std.IO;\nusing Std.Text;\n\nvoid Main() {\n    var sb = new StringBuilder();\n    sb.Append(\"ab\");\n    sb.Append(\"cd\");\n    string s = sb.ToString();\n    string sub = s.Substring(0, 2);\n    Console.WriteLine(sub);\n}\n");
    File.WriteAllText(Path.Join(tdir, "text.app.z42.toml"),
        "[project]\nname    = \"text.app\"\nversion = \"0.1.0\"\nkind    = \"exe\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n");
    // closcheck（port-z42c-closures）：无捕获/捕获 lambda + Func 形参 + 间接调用 + oracle。
    // 注意逃逸形态（Apply 传参）：C# 逃逸分析对非逃逸闭包发 stackAlloc=1（z42c 恒 0 延后）。
    string cdir = _e2eTmpRoot(root, "buildclos");
    Directory.Create(cdir);
    File.WriteAllText(Path.Join(cdir, "app.z42"),
        "int Apply(Func<int, int> f, int v) {\n"
        + "    return f(v);\n"
        + "}\n\n"
        + "int Main() {\n"
        + "    Func<int, int> dbl = x => x * 2;\n"
        + "    int k = 3;\n"
        + "    Func<int, int> mul = x => x * k;\n"
        + "    int ok = 0;\n"
        + "    if (dbl(21) == 42) { if (Apply(mul, 14) == 42) { ok = 1; } }\n"
        + "    return 100 / ok;\n"
        + "}\n");
    File.WriteAllText(Path.Join(cdir, "clos.app.z42.toml"),
        "[project]\nname    = \"clos.app\"\nversion = \"0.1.0\"\nkind    = \"exe\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n");
    // multifile（port-z42c-package-symbols）：同包跨文件互引（namespaced——C# no-ns 多文件互引自身有
    // pre-existing VCall 缺陷 `main.Pair.Sum not found`，挂账上游）
    string mdir = _e2eTmpRoot(root, "buildmulti");
    Directory.Create(mdir);
    File.WriteAllText(Path.Join(mdir, "types.z42"),
        "namespace App;\n\nclass Pair {\n    public int A;\n    public int B;\n    public int Sum() { return A + B; }\n}\n");
    File.WriteAllText(Path.Join(mdir, "main.z42"),
        "namespace App;\n\nint Main() {\n    var p = new Pair();\n    p.A = 40;\n    p.B = 2;\n    int ok = 0;\n    if (p.Sum() == 42) { ok = 1; }\n    return 100 / ok;\n}\n");
    File.WriteAllText(Path.Join(mdir, "multi.app.z42.toml"),
        "[project]\nname    = \"multi.app\"\nversion = \"0.1.0\"\nkind    = \"exe\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n");
    string[] cmpTomls = new string[6];
    cmpTomls[0] = btoml;
    cmpTomls[1] = Path.Join(ddir, "demo.minimal.z42.toml");
    cmpTomls[2] = Path.Join(hdir, "hello.app.z42.toml");
    cmpTomls[3] = Path.Join(tdir, "text.app.z42.toml");
    cmpTomls[4] = Path.Join(cdir, "clos.app.z42.toml");
    cmpTomls[5] = Path.Join(mdir, "multi.app.z42.toml");
    // replace-csharp Phase C：删 zpkg byte-compare-vs-C#（C# 已删）。改为 z42c build 6 工程
    // 验可建（功能性）；z42c 自身 byte-identical 由 self-host 不动点覆盖。
    int pi = 0;
    while (pi < 6) {
        string pdir = Path.GetDirectoryName(cmpTomls[pi]);
        rc = _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Arg("build").Arg(cmpTomls[pi])
            .Stdout(Stdio.Null()).Stderr(Stdio.Inherit()).Run().ExitCode;
        if (rc != 0) { Console.WriteLine("  ✗ z42c build failed: " + cmpTomls[pi]); return 1; }
        string[] zOut = Path.Glob(Path.Join(pdir, "dist"), "*.zpkg");
        if (zOut.Length != 1) { Console.WriteLine("  ✗ expected 1 zpkg in " + pdir + "/dist"); return 1; }
        pi = pi + 1;
    }
    Console.WriteLine("  ✓ z42c build: 6/6 projects built (multi-file packages; functional)");
    // hello-stdlib 直跑（跨包 Call 链可执行性）
    rc = _z42Proc(vm, _libsDir(root)).Arg(Path.Join(cdir, "dist/clos.app.zpkg"))
        .Stdout(Stdio.Null()).Stderr(Stdio.Null()).Run().ExitCode;
    if (rc != 0) { Console.WriteLine("  ✗ clos.app.zpkg failed to run (exit " + rc.ToString() + ")"); return 1; }
    rc = _z42Proc(vm, _libsDir(root)).Arg(Path.Join(tdir, "dist/text.app.zpkg"))
        .Stdout(Stdio.Null()).Stderr(Stdio.Null()).Run().ExitCode;
    if (rc != 0) { Console.WriteLine("  ✗ text.app.zpkg failed to run (exit " + rc.ToString() + ")"); return 1; }
    rc = _z42Proc(vm, _libsDir(root)).Arg(Path.Join(hdir, "dist/hello.app.zpkg"))
        .Stdout(Stdio.Null()).Stderr(Stdio.Null()).Run().ExitCode;
    if (rc != 0) { Console.WriteLine("  ✗ hello.app.zpkg failed to run (exit " + rc.ToString() + ")"); return 1; }
    Console.WriteLine("  ✓ import e2e: z42c-built hello.app.zpkg (using Std; Console.WriteLine) runs on z42vm");

    // path 依赖 e2e（add-path-dependencies 阶段2；fix-path-dep-closure 把它加深到 **2 层**）：
    // exe bar → lib foo → lib baz。`z42c build bar` 应：① 自动建**整个闭包**；② bar 解析到 foo
    // 符号；③ **闭包全体**（foo + baz）colocate 进 bar dist；④ bar.zpkg 直跑。
    //
    // 🔴 **第二层（baz）才是本检查的重点**。原版只造了 1 层，而深度为 1 时「直接依赖」恰好
    // 等于「闭包」⇒ `_bundleExeDeps` 只搬直接依赖这个缺陷被完整遮住：编译期正常（闭包 dist 已
    // 并进 libsDirs）、运行期才 `MissingSymbolException`，即 **path 依赖链深度 >1 不可用**。
    // ⭐ bar **故意不声明 baz** —— 它根本没引用过 baz 的符号，要求消费方声明一个自己不用的包，
    // 正是包管理器该替你做的事。
    string pdRoot = Path.Join(e2eDir, "pathdep");
    // 🔴 **先删整棵 fixture 树**：`e2eDir`（z42c.driver 的 tests/ 输出下的 `e2e`）跨轮次保留，
    // 而本检查的判据是「某个 zpkg 在不在 dist 里」—— 上一轮留下的产物会让它**假绿**。
    // 实测：修复退回后这条检查照样 ✓，清掉 `pathdep/` 才正确判红。
    // ⚠️ 凡是「判据 = 文件存在与否」的检查，都必须自己把地面清干净。
    if (Directory.Exists(pdRoot)) { Directory.Delete(pdRoot, true); }
    string fooDir = Path.Join(pdRoot, "foo");
    string barDir = Path.Join(pdRoot, "bar");
    string bazDir = Path.Join(pdRoot, "baz");
    Directory.Create(fooDir);
    Directory.Create(barDir);
    Directory.Create(bazDir);
    File.WriteAllText(Path.Join(bazDir, "baz.z42"),
        "namespace PathDep.Baz;\n\npublic static class Baz {\n    public static int Two() { return 2; }\n}\n");
    // 🔴 **baz 的清单刻意用裸 `z42.toml`**（其余两层仍用 `<name>.z42.toml`）——
    // 这正是 `z42 new` 写出来的形态（`builder_new.z42` 写的就是裸名），而 path 依赖解析
    // 此前自己 glob `"*.z42.toml"`：那个 pattern 要求文本含字面 `.z42.toml` 后缀，
    // 而 `z42.toml` 里 `z42` 前没有点 ⇒ **不匹配** ⇒ `z42 new` 造的工程当不了 path 依赖，
    // 报的还是「期望恰 1 份 *.z42.toml，实得 0」——离真正的原因很远。
    // 判据已收敛到 `ManifestLocator.FindIn`（它把裸名当首选形态）；这一格让两种拼写
    // 在同一次 e2e 里都被走到。**它藏了这么久，正是因为全部 fixture 都写 `<name>.z42.toml`。**
    File.WriteAllText(Path.Join(bazDir, "z42.toml"),
        "[project]\nname    = \"pathdep.baz\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n");
    File.WriteAllText(Path.Join(fooDir, "foo.z42"),
        "namespace PathDep.Foo;\n\nusing PathDep.Baz;\n\npublic static class Foo {\n    public static int Answer() { return 40 + Baz.Two(); }\n}\n");
    File.WriteAllText(Path.Join(fooDir, "pathdep.foo.z42.toml"),
        "[project]\nname    = \"pathdep.foo\"\nversion = \"0.1.0\"\nkind    = \"lib\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"pathdep.baz\" = { path = \"../baz\" }\n");
    File.WriteAllText(Path.Join(barDir, "bar.z42"),
        "using PathDep.Foo;\n\nint Main() {\n    int ok = 0;\n    if (Foo.Answer() == 42) { ok = 1; }\n    return 100 / ok;\n}\n");
    File.WriteAllText(Path.Join(barDir, "pathdep.bar.z42.toml"),
        "[project]\nname    = \"pathdep.bar\"\nversion = \"0.1.0\"\nkind    = \"exe\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"pathdep.foo\" = { path = \"../foo\" }\n");
    string barToml = Path.Join(barDir, "pathdep.bar.z42.toml");
    // --release：私有 path 依赖走「colocate + 运行期惰性加载」，惰性加载器只认 **packed** 依赖
    // zpkg（indexed = 开发态多文件布局，非惰性候选）；release 使 foo 闭包产 packed → 可被惰性加载。
    // 这也是真实部署态（z42.interactive→z42.repl 亦 --release）。
    rc = _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Arg("build").Arg(barToml).Arg("--release")
        .Stdout(Stdio.Null()).Stderr(Stdio.Inherit()).Run().ExitCode;
    if (rc != 0) { Console.WriteLine("  ✗ path 依赖 build 失败（foo 闭包未建 / bar 未解析到 foo）"); return 1; }
    // ③ **闭包全体** colocate 进 bar dist（_bundleExeDeps 真-stdlib 判据放行 path 依赖）。
    string barFoo = Path.Join(barDir, "dist/pathdep.foo.zpkg");
    if (!File.Exists(barFoo)) { Console.WriteLine("  ✗ path 依赖：foo.zpkg 未 colocate 进 bar/dist"); return 1; }
    // 🔴 第二层：bar 没有声明 baz，但 foo 需要它 ⇒ 必须随闭包一起搬进 dist。
    string barBaz = Path.Join(barDir, "dist/pathdep.baz.zpkg");
    if (!File.Exists(barBaz)) { Console.WriteLine("  ✗ path 依赖：**传递**依赖 baz.zpkg 未 colocate 进 bar/dist（深度 >1 不可用）"); return 1; }
    // ④ bar.zpkg 直跑（entry-zpkg 目录解析兄弟 foo.zpkg）。
    rc = _z42Proc(vm, _libsDir(root)).Arg(Path.Join(barDir, "dist/pathdep.bar.zpkg"))
        .Stdout(Stdio.Null()).Stderr(Stdio.Null()).Run().ExitCode;
    if (rc != 0) { Console.WriteLine("  ✗ path 依赖：bar.zpkg 直跑失败（exit " + rc.ToString() + "）"); return 1; }
    Console.WriteLine("  ✓ path 依赖 e2e（2 层）: bar → foo → baz 闭包自动建 + 全体 colocate + bar.zpkg 直跑");
    return 0;
}

// z42c self-compiled oracle checks：一串内联源程序经 z42c→zbc→z42vm，用 div-by-zero
// oracle 验功能（selfcheck/callcheck/typecheck/charcheck/trycheck/ifacecheck/sacheck +
// divzero 负向）。Split out of _testCompilerE2e（review §2.8）；纯逐字搬移、短路 return 1。
// 可复现 build_id（reproducible-build-id）：同一份源 + 同一 z42c ⇒ release packed 主 zpkg 逐字节一致
// （build_id 是它的哈希）。换目录编、只改注释/空白都不能变；真改代码必须变。
// 驱动路径（z42c build）；z42b 进程内编译路径由 z42c.pipeline 的 z42ccompiler 单测覆盖。
int _e2eReproBuild(string vm, string driverZpkg, string dir, string src, string flat) {
    Directory.Create(dir);
    File.WriteAllText(Path.Join(dir, "lib.z42"), src);
    File.WriteAllText(Path.Join(dir, "repro.lib.z42.toml"),
        "[project]\nname    = \"repro.lib\"\nversion = \"0.1.0\"\nkind    = \"lib\"\npack    = true\n\n[sources]\ninclude = [\"*.z42\"]\n");
    return _z42Proc(vm, flat).Arg(driverZpkg).Arg("--").Arg("build").Arg(Path.Join(dir, "repro.lib.z42.toml"))
        .Arg("--release").Arg("--no-incremental")
        .Stdout(Stdio.Null()).Stderr(Stdio.Inherit()).Run().ExitCode;
}

int _e2eReproChecks(string vm, string driverZpkg, string e2eDir, string flat) {
    Console.WriteLine("");
    Console.WriteLine("── 可复现 build_id（reproducible-build-id）──");
    string src = "namespace Repro;\n\npublic static class K {\n    public static int Add(int a, int b) { return a + b; }\n}\n";
    string commented = "// 顶部注释\n\nnamespace Repro;\n\npublic static class K {\n    // 成员注释\n    public static int Add(int a, int b)  { return a + b; }\n}\n";
    string a = Path.Join(e2eDir, "repro/a");
    string b = Path.Join(e2eDir, "repro/b/deeper");
    string c = Path.Join(e2eDir, "repro/c");
    string d = Path.Join(e2eDir, "repro/d");
    if (_e2eReproBuild(vm, driverZpkg, a, src, flat) != 0
        || _e2eReproBuild(vm, driverZpkg, b, src, flat) != 0
        || _e2eReproBuild(vm, driverZpkg, c, commented, flat) != 0
        || _e2eReproBuild(vm, driverZpkg, d, src.Replace("a + b", "a - b"), flat) != 0) {
        Console.WriteLine("  ✗ repro 夹具构建失败");
        return 1;
    }
    string rel = "dist/repro.lib.zpkg";
    if (!_filesEqual(Path.Join(a, rel), Path.Join(b, rel))) {
        Console.WriteLine("  ✗ 同一份源换目录编，zpkg 字节不同 —— 产物里又混进了绝对路径之类的环境信息");
        return 1;
    }
    if (!_filesEqual(Path.Join(a, rel), Path.Join(c, rel))) {
        Console.WriteLine("  ✗ 只改注释/空白，zpkg 字节不同 —— 产物里又混进了源文本哈希或行号");
        return 1;
    }
    if (_filesEqual(Path.Join(a, rel), Path.Join(d, rel))) {
        Console.WriteLine("  ✗ 真改了代码，zpkg 字节却没变 —— 对照失效");
        return 1;
    }
    Console.WriteLine("  ✓ 换目录 / 只改注释 → zpkg 逐字节一致；真改代码 → 不同");
    return 0;
}

int _testCompilerE2e(string root, string vm, string flat) {
    Console.WriteLine("");
    Console.WriteLine("── z42c e2e: self-compiled .zbc runs on z42vm ──");
    string driverZpkg = _driverZpkg(root, "release");
    string e2eDir = _workOut(root, "src/compiler/z42c.driver", "e2e");
    Directory.Create(e2eDir);

    // 命令行行为（旋钮 / 清单校验、--emit-zbc / --dump-ir 的诊断可见性）：用例在 src 的夹具里。
    if (_testCompilerCliFixtures(root, vm, driverZpkg, flat) != 0) { return 1; }

    // 语言功能正确性由 src/tests 的 golden 覆盖；z42c 自身的 byte-identical 由 self-host 不动点（gen1==gen2）
    // 覆盖（见 _testSelfHostByteIdentical）。

    if (_e2eBuildChecks(root, vm, driverZpkg, e2eDir, flat) != 0) { return 1; }
    if (_e2eReproChecks(vm, driverZpkg, e2eDir, flat) != 0) { return 1; }
    if (_e2eCacheLayoutChecks(vm, driverZpkg, e2eDir, flat) != 0) { return 1; }
    if (_e2eDepIdentityChecks(vm, driverZpkg, e2eDir, flat) != 0) { return 1; }
    if (_e2eWorkspaceIncrChecks(vm, driverZpkg, e2eDir, flat) != 0) { return 1; }
    if (_e2eUsedNsCacheChecks(vm, driverZpkg, e2eDir, flat) != 0) { return 1; }
    // 编译期扩展的解析域（add-package-roles 批 1）——实现在 xtask_compiler_e2e_analyzer.z42
    // （本文件已逼近 500 行硬限）。两格成对：analyzer 工程可引用契约 / 普通工程不可。
    if (_e2eAnalyzerDomainChecks(root, vm, driverZpkg, e2eDir) != 0) { return 1; }
    if (_e2eSdkLibExeCopy(root, vm, driverZpkg, e2eDir) != 0) { return 1; }
    if (_e2eSdkLibDeploySdk(root, vm, driverZpkg, e2eDir) != 0) { return 1; }
    // `[analyzers]` 的 path 条目（add-package-roles 批 2）：代建 + 指纹 + 双向校验，四格。
    if (_e2ePathAnalyzerChecks(root, vm, driverZpkg, e2eDir) != 0) { return 1; }
    // 用户工程**显式引用**编译器域库（relocate-compiler-domain-libs）：三格，见该函数头注。
    if (_e2eUserDomainRefChecks(root, vm, driverZpkg, e2eDir) != 0) { return 1; }
    // analyzer 诊断 / [lints] 必须活过整包全命中（fix-analyzer-diags-preserved）：三格，见该文件头注。
    if (_e2eAnalyzerDiagCacheChecks(root, vm, driverZpkg, e2eDir) != 0) { return 1; }
    // flat workspace 成员同名源不互相覆盖（fix-flat-workspace-packed）：见该文件头注。
    if (_e2eWsFlatChecks(root, vm, driverZpkg) != 0) { return 1; }
    // path 依赖闭包的解析域（fix-path-dep-closure-scope）：workspace 成员的外部 path 依赖 / --compile-libs。
    if (_e2ePathDepScopeChecks(root, vm, driverZpkg) != 0) { return 1; }
    // workspace 成员发现认 members / exclude / 裸名清单（fix-workspace-member-discovery）。
    if (_e2eWsMemberChecks(root, vm, driverZpkg) != 0) { return 1; }
    // exe 装配 indexed 依赖连散装 zbc 一起拷（fix-bundle-indexed-deps）。
    if (_e2eBundleIndexedChecks(root, vm, driverZpkg) != 0) { return 1; }
    // exe 私有依赖的复制判据（add-deployment-model 批 1）——工程落 /tmp，见该文件头注。
    if (_e2eDeployPredicateChecks(root, vm, driverZpkg) != 0) { return 1; }
    // probing-paths（add-deployment-model 批 3）：声明的运行期搜索目录 + 侧车跟随。
    if (_e2eProbingPathChecks(root, vm, driverZpkg) != 0) { return 1; }
    // `[dependencies]` 的 zpkg 产物引用（add-deployment-model）：类似 C# 引用 DLL。
    if (_e2eZpkgRefChecks(root, vm, driverZpkg) != 0) { return 1; }
    // `deploy = copy|shared`（add-deployment-model 批 4 use）：显式覆盖默认的复制判据。
    if (_e2eDeployUseChecks(root, vm, driverZpkg) != 0) { return 1; }
    // 按名/产物引用的传递闭包（add-deployment-model 批 2.2 use）。
    if (_e2eNamedClosureChecks(root, vm, driverZpkg) != 0) { return 1; }
    if (_e2eDeployDeclChecks(root, vm, driverZpkg) != 0) { return 1; }
    if (_e2eZ42bClosureChecks(root, vm) != 0) { return 1; }
    if (_e2eProbingArrayChecks(root, vm, driverZpkg) != 0) { return 1; }
    if (_e2eCompileLibsChecks(root, vm, driverZpkg) != 0) { return 1; }
    Console.WriteLine("✅ z42c e2e: self-compiled .zbc executes on z42vm");
    return 0;
}
