// xtask — `clean` 命令：按 target 删 artifacts/build/（编译产物）与 artifacts/intermediate/（中间物）。
// 从 xtask.z42 搬来（relocate-xtask-handlers, 2026-09-05）——它删的全是 build/
// 产物，归 build 族。
namespace Z42Xtask;

using Std.IO;
using Std.Cli;   // ParseResult

// ── clean ─────────────────────────────────────────────────────────────────────
//
//   clean         生产 cache/dist：各 stdlib 成员的 <lib>/<profile>/{cache,dist} + 扁平视图 intermediate/libraries/flat/
//   clean tests   测试的编译产物：build/ 下所有 tests/（golden .zbc、z42b 的 `<m>/<profile>/tests`；规则见
//                 test-layout.md §5）+ 旧位置 <工程目录>/artifacts/test-targets
//   clean bench   z42b 的 bench 目标输出（`<m>/<profile>/bench`；旧位置 <工程目录>/artifacts/bench-targets）
//   clean intermediate  整个 intermediate/（stdlib 扁平视图、夹具暂存拷贝、harness 工作目录、平台测试 bundle / 宿主、编译器
//                 自举快照、xtask 自检目录 —— 全部可再生）
//   clean all     build/ + intermediate/ + 旧工作树残留（tmp/、.scratch/、publish/、release/、顶层 test-reports/
//                 bench/ profile/）+ 源码树里各 z42 工程旁的 artifacts/、dist/
//                 **保留**：xtask/（驱动自身，正在运行）、tools/（下载的第三方工具）、
//                 packages/ .z42/（成品）、reports/（结果）
//
// tidy-artifacts-tmp-and-clean（2026-09-30）修了两处：
//   · `clean tests|bench` 此前删的是 `<lib>/<profile>/{tests,bench}` —— 当前布局里**不存在**这个目录
//     （golden 镜像在 `<lib>/tests`，dev 目标由 z42b 写在工程目录下），于是恒删 0 个、恒报 ✅。
//   · `clean all` 此前只删 build/，`.scratch` / `tmp` / `publish` 与源码树里的残留都不管。
//
// 源码树残留：单独编一个 workspace 成员（xtask 的 path 依赖、z42b 的 dev 目标父包）时不继承
// `[workspace.build].output_dir`，会走单工程默认布局写进 `<工程目录>/{artifacts,dist}`。只删**带
// `*.z42.toml` 的工程目录**旁边的这两个名字（不做全树通配，免得碰到 wasm / node 工程的同名目录）；
// 它们被 .gitignore 忽略、仓库里没有任何入库文件在其下。
int _clean(ParseResult r) {
    string root = _root();
    string sub  = r.GetPositional(0);   // "" | tests | bench | all
    if (sub == "all") { return _cleanAll(root); }
    if (sub == "tests" || sub == "bench") { return _cleanDevOutputs(root, sub); }
    if (sub == "intermediate") {
        int ni = _rmIfExists(_intermediateDir(root));
        Console.WriteLine("✅ clean intermediate: removed " + ni.ToString() + " dir(s)");
        return 0;
    }
    if (sub != "") {
        ConsoleError.WriteLine("xtask clean: unknown target '" + sub
            + "'  (empty=production cache/dist | tests | bench | intermediate | all)");
        return 2;
    }
    // 扁平视图由成员 dist 汇聚而来，成员 dist 删了它就是陈旧的 ⇒ 一起删。
    int n = 0;
    foreach (var prof in _cleanProfiles()) { n = n + _rmIfExists(_libsFlatDist(root, prof)); }
    string libsRoot = _libsBuildRoot(root);   // workspace.toml output_dir 模板前缀
    if (!Directory.Exists(libsRoot)) {
        Console.WriteLine("✅ clean: removed " + n.ToString() + " dir(s) [production cache/dist]");
        return 0;
    }
    foreach (var entry in _sortedStrings(Directory.Enumerate(libsRoot))) {
        foreach (var prof in _cleanProfiles()) {
            // cache / dist 位置按 workspace.toml 的 cache_dir / output_dir 模板解析，不写死目录名。
            n = n + _rmIfExists(_memberCache(_libsWsToml(root), entry, prof));
            n = n + _rmIfExists(_memberDist(_libsWsToml(root), entry, prof));
        }
    }
    Console.WriteLine("✅ clean: removed " + n.ToString() + " dir(s) [production cache/dist]");
    return 0;
}

// 成员目录下的 profile 子目录（产物、测试目标、golden 都按 profile 放在其中）。
string[] _cleanProfiles() { return new string[]{ "debug", "release" }; }

// `clean tests` / `clean bench`。
int _cleanDevOutputs(string root, string kind) {
    int n = 0;
    if (kind == "tests") {
        // 测试的编译产物全部在 build/ 镜像里名为 tests/ 的目录下（golden、z42b 的 `<m>/<profile>/tests`），
        // 按名字递归找，不再维护一张位置清单 —— 新组件的测试输出自动被覆盖。
        n = n + _rmTestsDirs(_buildDir(root), true);
    } else {
        // z42b bench 目标经 `--out-root` 落在输出目录的 profile 下（`_devTargetOutRoot`：`<m>/<profile>/bench`）。
        n = n + _rmProfileBenchDirs(_buildDir(root), true);
    }
    // 旧位置（不带 `--out-root` 时 z42b 的默认：`<sourceDir>/artifacts/<kind>-targets`）。
    string targets = (kind == "tests" ? "test" : "bench") + "-targets";
    foreach (var d in _srcZ42ProjectDirs(root)) {
        n = n + _rmIfExists(Path.Join(Path.Join(d, "artifacts"), targets));
    }
    Console.WriteLine("✅ clean " + kind + ": removed " + n.ToString() + " dir(s)");
    return 0;
}

// build/ 下每个名为 `tests` 的目录（测试的编译产物根）。不进入构建产物目录（dist / cache / publish），
// 也不进入 cargo 的 target 目录（`build/runtime/<profile>`，体量大且不含测试输出）：
// runtime 只认 `build/runtime/tests`。
int _rmTestsDirs(string dir, bool top) {
    if (!Directory.Exists(dir)) { return 0; }
    int n = 0;
    foreach (var e in _sortedStrings(Directory.Enumerate(dir))) {
        string p = Path.Join(dir, e);
        if (!Directory.Exists(p)) { continue; }
        if (e == "tests") { n = n + _rmIfExists(p); continue; }
        if (e == "dist" || e == "cache" || e == ".cache" || e == "publish") { continue; }
        if (top && e == "runtime") { n = n + _rmIfExists(Path.Join(p, "tests")); continue; }
        n = n + _rmTestsDirs(p, false);
    }
    return n;
}

// build/ 下所有「profile 目录（debug / release）里的 bench/」。跳过 cargo 的 target 目录（build/runtime）
// 与 src/bench 的镜像（build/bench，那是 bench 探针的编译产物，不是 z42b 的 bench 目标）。
int _rmProfileBenchDirs(string dir, bool top) {
    if (!Directory.Exists(dir)) { return 0; }
    int n = 0;
    foreach (var e in _sortedStrings(Directory.Enumerate(dir))) {
        string p = Path.Join(dir, e);
        if (!Directory.Exists(p)) { continue; }
        if (top && (e == "runtime" || e == "bench")) { continue; }
        if (e == "dist" || e == "cache" || e == ".cache" || e == "publish" || e == "tests") { continue; }
        if (e == "debug" || e == "release") { n = n + _rmIfExists(Path.Join(p, "bench")); continue; }
        n = n + _rmProfileBenchDirs(p, false);
    }
    return n;
}

int _cleanAll(string root) {
    int n = 0;
    n = n + _rmIfExists(_buildDir(root));
    n = n + _rmIfExists(_intermediateDir(root));
    n = n + _rmIfExists(_legacyTmpDir(root));
    n = n + _rmIfExists(_legacyScratchDir(root));
    n = n + _rmIfExists(_legacyPubStagingDir(root));
    n = n + _rmIfExists(_legacyReleaseDir(root));   // 归档已挪进 packages/archives（simplify-layout）
    foreach (var d in _legacyReportDirs(root)) { n = n + _rmIfExists(d); }   // 结果已收进 reports/
    int strays = 0;
    foreach (var d in _srcZ42ProjectDirs(root)) {
        strays = strays + _rmIfExists(Path.Join(d, "artifacts")) + _rmIfExists(Path.Join(d, "dist"));
        // cross-zpkg 用例：xtask 把依赖 zpkg 拷进 `<fixture>/<pkg>/libs/`（.gitignore 专门登记了
        // `src/compiler/z42c.pipeline/tests/fixtures/cross-zpkg/*/*/libs/`）。只在这条路径下删 `libs`，别处同名目录不碰。
        if (d.Replace("\\", "/").Contains("/src/compiler/z42c.pipeline/tests/fixtures/cross-zpkg/")) {
            strays = strays + _rmIfExists(Path.Join(d, "libs"));
        }
    }
    Console.WriteLine("✅ clean all: removed " + n.ToString() + " artifacts/ dir(s) (build + intermediate + old-layout leftovers)"
        + " + " + strays.ToString() + " source-tree output dir(s)");
    Console.WriteLine("   kept: artifacts/{xtask,tools,packages,.z42,reports}");
    return 0;
}

// src/ 下所有 z42 工程目录（含 `<name>.z42.toml` 或 `z42.toml` 清单的目录——测试夹具多用后者），
// 跳过输出目录与 node_modules 里的。
string[] _srcZ42ProjectDirs(string root) {
    string src = Path.Join(root, "src");
    string[] named = Path.GlobRecursive(src, "*.z42.toml");
    string[] plain = Path.GlobRecursive(src, "z42.toml");
    string[] tomls = new string[named.Length + plain.Length];
    int c = 0;
    foreach (var t in named) { tomls[c] = t; c = c + 1; }
    foreach (var t in plain) { tomls[c] = t; c = c + 1; }
    string[] dirs = new string[tomls.Length];
    int n = 0;
    foreach (var t in tomls) {
        string u = t.Replace("\\", "/");
        if (u.Contains("/artifacts/") || u.Contains("/dist/") || u.Contains("/node_modules/")) { continue; }
        string d = Path.GetDirectoryName(t);
        bool seen = false;
        int k = 0;
        while (k < n) { if (dirs[k] == d) { seen = true; } k = k + 1; }
        if (!seen) { dirs[n] = d; n = n + 1; }
    }
    string[] outArr = new string[n];
    int i = 0;
    while (i < n) { outArr[i] = dirs[i]; i = i + 1; }
    return outArr;
}

int _rmIfExists(string dir) {
    if (Directory.Exists(dir)) { Directory.Delete(dir, true); return 1; }
    return 0;
}
