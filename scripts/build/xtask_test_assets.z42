// xtask — `build test` golden test-asset compilation. Impl of the `build test`
// command (_buildTest) + the shared golden-regen machinery (_regenGolden) used by
// the `test` gate build-wave (_regenForTest → _regenCore in xtask_test.z42).
// (Was scripts/xtask_regen.z42; the standalone `regen` command was folded into
// `build test` — redesign-xtask-test, 2026-07-07.)
//
// Recompiles golden test source.z42 → source.zbc in two layouts:
//   Dir mode:  <root>/<cat>/<name>/source.z42 → <...>/source.zbc
//   Flat mode: src/tests/<cat>/<name>.z42     → src/tests/<cat>/<name>.zbc
// where <root> ∈ {src/tests, src/libraries/<lib>/tests}; excluded categories
// under src/tests: errors / parse / cross-zpkg. Tally + return 1 on any failure.
// Shared enumeration helpers come from common/xtask_golden.z42.
namespace Z42Xtask;

using Std;
using Std.IO;

// `xtask build test` — compile the golden test assets (src/tests + library tests →
// `.zbc` mirror under artifacts/build/tests), symmetric with build compiler/stdlib/
// toolchain/workload. Ensures z42c + stdlib + z42vm are present (build-if-missing,
// like the other build commands), then compiles the goldens — i.e. regen's golden
// compile WITHOUT rebuilding the toolchain (CI's compile-test-assets does the same
// via `regen --no-stdlib`).
int _buildTest() {
    int p = _ensureToolchainDeps(_root()); if (p != 0) { return p; }
    return _regenGolden();
}

// Golden regen cases: parallel growable arrays (name / source .z42 / output .zbc) + count.
class _GoldenCases {
    public string[] names;
    public string[] sources;
    public string[] outputs;
    public int count;
    public _GoldenCases() {
        this.names   = new string[0];
        this.sources = new string[0];
        this.outputs = new string[0];
        this.count   = 0;
    }
}

// Enumerate golden cases across the three layouts (dir-mode src/tests + per-library
// tests, flat-mode src/tests) into parallel arrays. Split out of _regenGolden (was
// ~100 lines inline) to keep that function within the size limit (review §2.8).
_GoldenCases _collectGoldenCases(string root) {
    return _collectGoldenCasesF(root, "", "");
}

// Filtered variant: mirrors _enumerateCasesF's --dir (category) / --file (name or
// source-path substring) narrowing so `test e2e --file X` on the fast --no-build /
// --toolchain path regenerates ONLY the matched case's .zbc instead of all ~333.
// Both filters empty = the full set (`build test` + gate build-wave — unchanged).
_GoldenCases _collectGoldenCasesF(string root, string dirFilter, string fileFilter) {
    string[] caseNames    = new string[64];
    string[] caseSources  = new string[64];
    string[] caseOutputs  = new string[64];
    int      caseCount    = 0;

    // Dir mode part 1: src/tests/<cat>/<name>/source.z42
    string testsRoot = Path.Join(root, "src/tests");
    string[] testCats = _enumDirsSorted(testsRoot);
    int ci = 0;
    while (ci < testCats.Length) {
        string cat = testCats[ci];
        if (_isNonRegenCat(cat)) { ci = ci + 1; continue; }
        string catDir = Path.Join(testsRoot, cat);
        string[] names = _enumDirsSorted(catDir);
        int ni = 0;
        while (ni < names.Length) {
            string name = names[ni];
            string caseDir = Path.Join(catDir, name);
            string src = Path.Join(caseDir, "source.z42");
            if (!_e2eIncluded(cat, name, src, dirFilter, fileFilter)) { ni = ni + 1; continue; }
            if (File.Exists(src)) {
                // zbc-format: checked-in byte baseline → regen overwrites in place
                // (git diff = format drift). All other run-goldens redirect to the
                // artifacts mirror (redirect-golden-zbc-to-artifacts, 2026-06-16).
                string outPath = "";
                if (cat == "zbc-format") {
                    outPath = Path.Join(caseDir, "source.zbc");
                } else {
                    string mirrorDir = _goldenArtifactDir(root,
                        Path.Join(Path.Join("tests", cat), name));
                    Directory.Create(mirrorDir);
                    outPath = Path.Join(mirrorDir, "source.zbc");
                }
                caseNames   = _append(caseNames,   caseCount, name);
                caseSources = _append(caseSources, caseCount, src);
                caseOutputs = _append(caseOutputs, caseCount, outPath);
                caseCount = caseCount + 1;
            }
            ni = ni + 1;
        }
        ci = ci + 1;
    }

    // Dir mode part 2: src/libraries/<lib>/tests/<name>/source.z42
    string libsRoot = Path.Join(root, "src/libraries");
    // --dir <cat> excludes library golden tests entirely (mirrors _enumerateCasesF).
    string[] libs = (dirFilter.Length > 0) ? new string[0] : _enumDirsSorted(libsRoot);
    int li = 0;
    while (li < libs.Length) {
        string libTestsDir = Path.Join(libsRoot, libs[li] + "/tests");
        if (Directory.Exists(libTestsDir)) {
            string[] names = _enumDirsSorted(libTestsDir);
            int ni = 0;
            while (ni < names.Length) {
                string name = names[ni];
                string caseDir = Path.Join(libTestsDir, name);
                // Skip [Test]/[Benchmark] dir tests — run by `xtask test stdlib`
                // (z42b), not golden regen (no Main → no golden output). Mirrors
                // _enumerateCases.
                if (_dirHasTestMethods(caseDir)) { ni = ni + 1; continue; }
                string src = Path.Join(caseDir, "source.z42");
                if (fileFilter.Length > 0 && !_e2eIncluded("", name, src, "", fileFilter)) { ni = ni + 1; continue; }
                if (File.Exists(src)) {
                    // run-golden → artifacts mirror (no zbc-format under libraries).
                    string mirrorDir = _goldenArtifactDir(root,
                        Path.Join(Path.Join(Path.Join("libraries", libs[li]), "tests"), name));
                    Directory.Create(mirrorDir);
                    string outPath = Path.Join(mirrorDir, "source.zbc");
                    caseNames   = _append(caseNames,   caseCount, name);
                    caseSources = _append(caseSources, caseCount, src);
                    caseOutputs = _append(caseOutputs, caseCount, outPath);
                    caseCount = caseCount + 1;
                }
                ni = ni + 1;
            }
        }
        li = li + 1;
    }

    // Flat mode: src/tests/<cat>/<name>.z42 (one level, not source.z42 in subdir)
    ci = 0;
    while (ci < testCats.Length) {
        string cat = testCats[ci];
        if (_isNonRegenCat(cat)) { ci = ci + 1; continue; }
        if (dirFilter.Length > 0 && cat != dirFilter) { ci = ci + 1; continue; }
        string catDir = Path.Join(testsRoot, cat);
        string[] entries = Path.Glob(catDir, "*.z42");
        int ei = 0;
        while (ei < entries.Length) {
            string flatPath = entries[ei];
            if (File.Exists(flatPath)) {
                string name = Path.GetFileNameWithoutExtension(flatPath);
                if (fileFilter.Length > 0 && !_e2eIncluded(cat, name, flatPath, dirFilter, fileFilter)) { ei = ei + 1; continue; }
                // flat run-golden → artifacts mirror (zbc-format is dir-mode only).
                string mirrorDir = _goldenArtifactDir(root, Path.Join("tests", cat));
                Directory.Create(mirrorDir);
                string outPath = Path.Join(mirrorDir, name + ".zbc");
                caseNames   = _append(caseNames,   caseCount, name);
                caseSources = _append(caseSources, caseCount, flatPath);
                caseOutputs = _append(caseOutputs, caseCount, outPath);
                caseCount = caseCount + 1;
            }
            ei = ei + 1;
        }
        ci = ci + 1;
    }

    _GoldenCases gc = new _GoldenCases();
    gc.names   = caseNames;
    gc.sources = caseSources;
    gc.outputs = caseOutputs;
    gc.count   = caseCount;
    return gc;
}

int _regenGolden() {
    return _regenGoldenF("", "");
}

// Filtered golden regen: dirFilter/fileFilter narrow the compiled set the same way
// `test e2e --dir/--file` narrows the run set (via _collectGoldenCasesF), so the
// fast --no-build / --toolchain iteration path recompiles only the touched case(s).
// Both empty = full regen (the `build test` + gate build-wave behavior).
int _regenGoldenF(string dirFilter, string fileFilter) {
    string root = _root();
    // replace-csharp Phase C：golden 编译改用 z42c（z42vm + z42c.driver.zpkg），不再 dotnet。
    // driverHome = 含 z42c.driver.zpkg + 7 个 z42c.* 兄弟；golden 的 stdlib 依赖走 Z42_LIBS=stdlibDist。
    // --toolchain (compile-once P3): compile goldens with the selected toolchain's
    // z42c + stdlib + z42vm when set; else the build-tree.
    string tc = _toolchainDir(root);
    string driverHome = (tc.Length > 0) ? _toolchainDriverHome(tc) : _assembleDriverHome(root);
    if (driverHome.Length == 0) {
        ConsoleError.WriteLine("error: z42c driver not built (artifacts/build/compiler/z42c.*/release/dist)");
        ConsoleError.WriteLine("       Build it via stdlib/compiler build first.");
        return 1;
    }
    string driverZpkg = Path.Join(driverHome, "z42c.driver.zpkg");
    string stdlibDist = (tc.Length > 0) ? _toolchainLibs(tc) : _libsDir(root);
    // Golden regen z42c-compiles EVERY case — prefer the RELEASE z42vm: z42c runs
    // many× faster optimized than the debug vm, and regen dominated the build-and-
    // test critical path (~39 min/leg on slow arm64 runners with the debug vm). This
    // is safe because _regenGolden is only reached on the CI-warm / --toolchain path
    // (_regenForTest gates on haveTc||noBuild; the local full build uses _regenCore),
    // where a CURRENT release/toolchain vm exists (ci-bootstrap cargo-builds it, or
    // the toolchain supplies it). Fall back to the debug vm only if release is absent.
    // NOTE: regen just COMPILES the .zbc (deterministic z42c output); the golden RUN
    // still resolves its own vm (_runVmGoldensF), so this doesn't change what's tested.
    string vmBin = _activeVm(root, "release");
    if (!File.Exists(vmBin)) { vmBin = _activeVm(root, "debug"); }
    if (!File.Exists(vmBin)) {
        ConsoleError.WriteLine("error: z42vm not found (build via cargo build --manifest-path src/runtime/Cargo.toml)");
        return 1;
    }

    bool filtered = (dirFilter.Length > 0 || fileFilter.Length > 0);
    if (filtered) {
        string scope = (dirFilter.Length > 0 ? ("--dir " + dirFilter) : "")
            + (fileFilter.Length > 0 ? ((dirFilter.Length > 0 ? " " : "") + "--file " + fileFilter) : "");
        Console.WriteLine("Regenerating golden test artifacts (" + scope + ")...");
    } else {
        Console.WriteLine("Regenerating golden test artifacts...");
    }
    Console.WriteLine("");

    // ── Enumerate cases (three layouts → parallel arrays; split: _collectGoldenCases) ──
    _GoldenCases gc = _collectGoldenCasesF(root, dirFilter, fileFilter);
    string[] caseNames   = gc.names;
    string[] caseSources = gc.sources;
    string[] caseOutputs = gc.outputs;
    int      caseCount   = gc.count;

    if (filtered && caseCount == 0) {
        Console.WriteLine("  (no golden case matched the filter — nothing to regenerate)");
    }

    // ── Compile each case (parallel batches) ─────────────────────────────
    // Each case spawns z42vm + z42c.driver to compile one source.z42 — the cost
    // is dominated by per-process driver startup (load driver.zpkg + 7 members +
    // stdlib), not the compile itself, so the ~333 cases parallelize well.
    // Batches of `jobs`: spawn jobs compiles → wait → collect. Outputs are
    // independent .zbc files, so order doesn't matter. Mirrors _runUnitsBatched.
    int jobs = 8;
    int pass = 0;
    int fail = 0;
    string[] failures = new string[8];
    int      failCount = 0;
    int k = 0;
    while (k < caseCount) {
        int bsz = jobs;
        if (k + bsz > caseCount) { bsz = caseCount - k; }
        ProcessHandle[] hs = new ProcessHandle[bsz];
        int b = 0;
        while (b < bsz) {
            hs[b] = _compileCaseSpawn(vmBin, driverZpkg, stdlibDist,
                                      caseSources[k + b], caseOutputs[k + b]);
            b = b + 1;
        }
        b = 0;
        while (b < bsz) {
            string name = caseNames[k + b];
            bool ok = false;
            try {
                ProcessResult r = hs[b].Wait();
                ok = (r.ExitCode == 0);
            } catch (Exception e) {
                ok = false;
            }
            if (ok) {
                Console.WriteLine("  OK:   " + name);
                pass = pass + 1;
            } else {
                Console.WriteLine("  FAIL: " + name);
                fail = fail + 1;
                failures = _append(failures, failCount, name);
                failCount = failCount + 1;
            }
            b = b + 1;
        }
        k = k + bsz;
    }

    Console.WriteLine("");
    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Regenerated: " + pass.ToString() + " ok, "
        + fail.ToString() + " failed, 0 skipped");
    Console.WriteLine("══════════════════════════════════════");

    if (failCount > 0) {
        Console.WriteLine("");
        Console.WriteLine("Failed tests:");
        int fi = 0;
        while (fi < failCount) {
            Console.WriteLine("  - " + failures[fi]);
            fi = fi + 1;
        }
        return 1;
    }
    return 0;
}

// Categories with no single-source golden .zbc to regenerate: errors / parse
// expect compile/parse failure (no .zbc), cross-zpkg / multi-exe are multi-
// package / multi-target project builds handled by their own runners.
// Distinct from golden's _isNonRunnableCat (cross-zpkg / multi-exe / zbc-format / zpkg-format).
bool _isNonRegenCat(string cat) {
    return cat == "errors" || cat == "parse" || cat == "cross-zpkg" || cat == "multi-exe"
        || cat == "manifest-targets";
}

// z42c 编译单个 golden（z42vm 跑 z42c.driver.zpkg --emit-zbc）。golden 的 stdlib 依赖
// （Assert/Console 等）经 Z42_LIBS=stdlibDist 解析；driver 自身 z42c.* 依赖从 driverHome 解析。
// Spawn (don't wait) the z42c compile of one golden case; caller batches the
// Wait() across `jobs` concurrent handles. Output .zbc paths are unique per case.
ProcessHandle _compileCaseSpawn(string vmBin, string driverZpkg, string stdlibDist, string source, string output) {
    return new Process(vmBin)
        .Arg(driverZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("--emit-zbc").Arg(source).Arg(output)
        .Env("Z42_LIBS", stdlibDist)
        .Stdout(Stdio.Null())
        .Stderr(Stdio.Null())
        .Spawn();
}
