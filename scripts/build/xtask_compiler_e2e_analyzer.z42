// xtask — 编译期扩展解析域的 e2e 门（add-package-roles 批 1）。
//
// 单独成文件而非并入 xtask_compiler_e2e.z42：后者已 487 行，逼近 500 行硬限
// （code-organization.md）。本门由 `_testCompilerE2e` 调用。
//
// **守的是什么**：`kind = "analyzer"` 的工程能不能 `[dependencies]` 到编译器的契约包
// （`z42c.semantics` 的 Generator / ModuleGenerator / GenSink / GenTarget）。
//
// 在此之前这条路是断的：契约 zpkg 只作为 z42c 的 payload 落在 `programs/z42c/`，**在 SDK
// 目录里、却不在解析器会去看的地方**。插件作者写不出插件，且没有任何东西会诊断它——他拿到
// 的是一句位置在别处的 `undefined type: ModuleGenerator`。那是一个有名字的已知失败模式
// （proposal §参照系调研的七家语言全都专门绕开了它）。
//
// **两格成对，缺一不可**：
//   ① `kind = "analyzer"` → 必须编过（能力在）；
//   ② 同一份源码改 `kind = "lib"` → 必须编**不**过（判别力在）。
//
// 只有①的门管不住「哪天有人图省事把 z42c.semantics 塞进 libs/ 了事」——那样①照样绿，
// 而解析域隔离已经没了（普通工程也能引用编译器语义层）。②正是为这个而写。
namespace Z42Xtask;

using Std.IO;

// analyzer 工程的最小源码：实现 ModuleGenerator 三个成员。只要契约解析得到，它就编得过。
string _e2eAnalyzerSrc() {
    return "namespace E2eGen;\n\nusing Std;\nusing Z42.Semantics;\n\n"
         + "public sealed class E2eProbeGenerator : ModuleGenerator {\n"
         + "    public void Generate(GenContext ctx, GenSink sink) {\n"
         + "        sink.AddSource(\"e2e\", \"namespace E2eOut; public static class O { public static int V() { return 1; } }\");\n"
         + "    }\n"
         + "    public string[] Consumes() { return new string[0]; }\n"
         + "    public string[] Produces() { return new string[0]; }\n"
         + "}\n";
}

string _e2eAnalyzerToml(string kind) { return _e2eAnalyzerTomlNamed("e2e.gen", kind); }

// 编译期扩展工程的最小清单：kind + 对契约包的依赖。
string _e2eAnalyzerTomlNamed(string name, string kind) {
    return _e2eAnalyzerTomlDecl(name, kind, true);
}

// `declare` = 是否在 [dependencies] 按名声明 SDK 库 z42c.semantics（add-sdk-libs：exe / lib 须声明，analyzer 免声明）。
string _e2eAnalyzerTomlDecl(string name, string kind, bool declare) {
    return "[project]\nname    = \"" + name + "\"\nversion = \"0.1.0\"\nkind    = \"" + kind + "\"\n\n"
         + "[sources]\ninclude = [\"*.z42\"]\n"
         + (declare ? "\n[dependencies]\n\"z42c.semantics\" = \"0.1.0\"\n" : "");
}

// 🔴 **Z42_LIBS 必须是纯 stdlib dist，不能用 e2e 其余检查那个 `flat`**。
// `flat`（`_assembleAllLibs`）把 stdlib **与全部 compiler member**（含 z42c.semantics）硬链进
// 同一个 alllibs/ 目录给测试用 —— 在那个环境里编译器包对**所有**工程可见，②格恒绿、门等于没有。
// 这里改用 `_libsFlatDist`（真·stdlib 扁平 dist），analyzer 工程靠 `CompilerDomain.Dirs()` 拿到契约包
// （本检查显式传 `Z42_COMPILER_LIBS`；未传时的开发树档 = 自 Z42_LIBS 上溯到 artifacts/build/ 再拼
// `compiler/z42c.driver/release/dist`）。
int _e2eAnalyzerDomainChecks(string root, string vm, string driverZpkg, string e2eDir) {
    string flat = _libsFlatDist(root, "release");
    string adir = Path.Join(e2eDir, "analyzerdomain");
    Directory.Create(adir);
    File.WriteAllText(Path.Join(adir, "gen.z42"), _e2eAnalyzerSrc());
    string atoml = Path.Join(adir, "e2e.gen.z42.toml");
    // ②格用**独立目录**：同目录只改 toml 会让增量缓存参与进来，把「解析得到吗」这个问题
    // 混进「缓存命中吗」。两格各自干净地走一遍完整解析。
    string bdir = Path.Join(e2eDir, "analyzerdomain_lib");
    Directory.Create(bdir);
    File.WriteAllText(Path.Join(bdir, "gen.z42"), _e2eAnalyzerSrc());
    string btoml = Path.Join(bdir, "e2e.gen.z42.toml");

    // add-sdk-libs 的可见性规则（三格；每格独立目录，免得增量缓存混进「解析得到吗」）：
    //   ① kind = "analyzer"，**不声明** → SDK 库自动可见 ⇒ 编过；
    //   ② kind = "lib"，按名声明 `"z42c.semantics" = "0.1.0"` → 可见 ⇒ 编过；
    //   ③ kind = "lib"，**不声明** → 不可见 ⇒ 必须编不过，且报错点名 z42c.semantics 并给出声明写法。
    //      ③ 编过 = 未声明的 SDK 库也漏给了普通工程（隔离失效）；红了但不点名 = 门失去判别力。
    File.WriteAllText(atoml, _e2eAnalyzerTomlDecl("e2e.gen", "analyzer", false));
    ProcessResult r1 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(atoml).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (r1.ExitCode != 0) {
        Console.WriteLine("  ✗ ① kind=analyzer（未声明）解析不到 z42c.semantics（SDK 库应对 analyzer 自动可见）: rc="
            + r1.ExitCode.ToString());
        Console.WriteLine("    stderr: " + r1.Stderr);
        return 1;
    }

    File.WriteAllText(btoml, _e2eAnalyzerTomlDecl("e2e.gen", "lib", true));
    ProcessResult r2 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(btoml).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (r2.ExitCode != 0) {
        Console.WriteLine("  ✗ ② kind=lib 按名声明了 z42c.semantics 却解析不到: rc=" + r2.ExitCode.ToString());
        Console.WriteLine("    stderr: " + r2.Stderr);
        return 1;
    }

    string cdir = Path.Join(e2eDir, "analyzerdomain_undeclared");
    Directory.Create(cdir);
    File.WriteAllText(Path.Join(cdir, "gen.z42"), _e2eAnalyzerSrc());
    string ctoml = Path.Join(cdir, "e2e.gen.z42.toml");
    File.WriteAllText(ctoml, _e2eAnalyzerTomlDecl("e2e.gen", "lib", false));
    ProcessResult r3 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(ctoml).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (r3.ExitCode == 0) {
        Console.WriteLine("  ✗ ③ kind=lib 未声明却解析到了 z42c.semantics —— SDK 库的声明隔离失效");
        return 1;
    }
    if (r3.Stderr.IndexOf("z42c.semantics") < 0 || r3.Stderr.IndexOf("按名声明") < 0) {
        Console.WriteLine("  ✗ ③ kind=lib 未声明时编不过，但报错没有点名 z42c.semantics / 没给声明写法（门失去判别力）");
        Console.WriteLine("    stderr: " + r3.Stderr);
        return 1;
    }
    Console.WriteLine("  ✓ SDK 库可见性：analyzer 免声明可见；lib 声明后可见；lib 未声明不可见且提示怎么声明");
    return 0;
}

// ── `[analyzers]` 的 path 条目（add-package-roles 批 2）─────────────────────────────────────
//
// **守的是什么**：用户自己的 generator 工程能不能被**直接按路径**挂上去——z42c 定位它、校验它
// 确是编译期扩展、**代建**、把产物喂给 generator 引擎，全程不需要用户手工把 zpkg 拷进 SDK libs。
//
// 此前 `[analyzers]` 只能「按名在 LibsDirs 找 `<name>.zpkg`」，path 被显式拒绝（更早是**静默忽略**：
// 解析层照单收下 `{ path = ... }`，消费端只读 `.Name`）。结果是 `[analyzers]` 机制在、**真实客户为零**
// ——全仓库除测试外无一工程用过它。
//
// **四格**（能力 + 判别力 + 两条反向）：
//   ① path 引用 → 代建 → generator 产的符号在消费方可用，产物跑起来打印 42；
//   ② 改 generator 源码（42→7）→ 消费方**必须**重编（handler 指纹）。仍打印 42 = 指纹没接上
//      path 条目：那是一个「改了扩展却编出旧结果」的静默错值；
//   ③ 被引工程 `kind = "lib"` → 必须报「不是 analyzer」。普通库挂上去的失败模式是
//      「加载成功、发现 0 个 handler、什么都不做」，一个静默空转；
//   ④ analyzer 工程写进 `[dependencies]` → 必须报错。它永不链入产物，写进依赖就是让运行期
//      代码引用一个不会到场的包。
string _e2ePathAnalyzerAppSrc() {
    return "namespace E2ePathApp;\n\nusing Std.IO;\nusing E2eOut;\n\nvoid Main() { Console.WriteLine(O.V().ToString()); }\n";
}

// generator 源：注入一个返回 `val` 的类，供②格用不同值区分「重编了没有」。
string _e2ePathGenSrc(string val) {
    return "namespace E2ePathGen;\n\nusing Std;\nusing Z42.Semantics;\n\n"
         + "public sealed class E2ePathGenerator : ModuleGenerator {\n"
         + "    public void Generate(GenContext ctx, GenSink sink) {\n"
         + "        sink.AddSource(\"e2e\", \"namespace E2eOut; public static class O { public static int V() { return "
         + val + "; } }\");\n"
         + "    }\n"
         + "    public string[] Consumes() { return new string[0]; }\n"
         + "    public string[] Produces() { return new string[0]; }\n"
         + "}\n";
}

string _e2ePathAppToml(string section) {
    return "[project]\nname    = \"e2e.pathapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
         + "entry   = \"E2ePathApp.Main\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[" + section + "]\n\"e2e.pathgen\" = { path = \"../pathgen\" }\n";
}

int _e2ePathAnalyzerChecks(string root, string vm, string driverZpkg, string e2eDir) {
    string flat = _libsFlatDist(root, "release");   // 同①②：必须是纯 stdlib dist，不能用 alllibs
    string gdir = Path.Join(e2eDir, "pathgen");
    string adir = Path.Join(e2eDir, "pathapp");
    Directory.Create(gdir);
    Directory.Create(adir);
    File.WriteAllText(Path.Join(gdir, "gen.z42"), _e2ePathGenSrc("42"));
    string gtoml = Path.Join(gdir, "e2e.pathgen.z42.toml");
    File.WriteAllText(gtoml, _e2eAnalyzerTomlNamed("e2e.pathgen", "analyzer"));
    File.WriteAllText(Path.Join(adir, "app.z42"), _e2ePathAnalyzerAppSrc());
    string atoml = Path.Join(adir, "e2e.pathapp.z42.toml");
    File.WriteAllText(atoml, _e2ePathAppToml("analyzers"));

    // ① 代建 + 产码 + 跑起来。
    ProcessResult b1 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(atoml).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b1.ExitCode != 0) {
        Console.WriteLine("  ✗ [analyzers] path 条目构建失败（用户写不出自己的 generator）: rc="
            + b1.ExitCode.ToString());
        Console.WriteLine("    stderr: " + b1.Stderr);
        return 1;
    }
    string appZpkg = Path.Join(Path.Join(adir, "dist"), "e2e.pathapp.zpkg");
    ProcessResult r1 = new Process(vm).Arg(appZpkg).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (r1.ExitCode != 0 || r1.Stdout.IndexOf("42") < 0) {
        Console.WriteLine("  ✗ generator 产的符号没能跑出预期值（期望 42）: rc=" + r1.ExitCode.ToString()
            + " stdout=" + r1.Stdout + " stderr=" + r1.Stderr);
        return 1;
    }

    // ② 只改 generator 源码 → 消费方必须重编出新值（handler 指纹覆盖 path 条目）。
    File.WriteAllText(Path.Join(gdir, "gen.z42"), _e2ePathGenSrc("7"));
    ProcessResult b2 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(atoml).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b2.ExitCode != 0) {
        Console.WriteLine("  ✗ 改 generator 后重建失败: " + b2.Stderr);
        return 1;
    }
    ProcessResult r2 = new Process(vm).Arg(appZpkg).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (r2.Stdout.IndexOf("7") < 0) {
        Console.WriteLine("  ✗ 改了 generator 源码，消费方却编出旧结果（handler 指纹漏了 path 条目）: stdout="
            + r2.Stdout);
        return 1;
    }

    // ③ 被引工程不是 analyzer → 必须拒绝（否则是「加载成功、零 handler、静默空转」）。
    File.WriteAllText(gtoml, _e2eAnalyzerTomlNamed("e2e.pathgen", "lib"));
    ProcessResult b3 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(atoml).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    // 断言**那一句**诊断，不是「凡含 analyzer 字样即可」：kind 校验若被删，kind=lib 的工程
    // 会在代建阶段因解析不到契约包而失败，那条失败经由本门的 "[analyzers] ... 构建失败" 转述
    // 也含 "analyzer" 字样 —— 宽断言会把「校验没了」判成绿。
    if (b3.ExitCode == 0 || b3.Stderr.IndexOf("不是 \"analyzer\"") < 0) {
        Console.WriteLine("  ✗ [analyzers] 收下了 kind=lib 的普通库（静默空转无人诊断）: rc="
            + b3.ExitCode.ToString() + " stderr=" + b3.Stderr);
        return 1;
    }
    File.WriteAllText(gtoml, _e2eAnalyzerTomlNamed("e2e.pathgen", "analyzer"));

    // ④ analyzer 写进 [dependencies] → 必须拒绝。
    string ddir = Path.Join(e2eDir, "pathdep");
    Directory.Create(ddir);
    File.WriteAllText(Path.Join(ddir, "app.z42"), _e2ePathAnalyzerAppSrc());
    string dtoml = Path.Join(ddir, "e2e.pathapp.z42.toml");
    File.WriteAllText(dtoml, _e2ePathAppToml("dependencies"));
    ProcessResult b4 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(dtoml).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b4.ExitCode == 0 || b4.Stderr.IndexOf("不能作运行期依赖") < 0) {
        Console.WriteLine("  ✗ 编译期扩展被当作运行期依赖收下了: rc=" + b4.ExitCode.ToString()
            + " stderr=" + b4.Stderr);
        return 1;
    }

    Console.WriteLine("  ✓ [analyzers] path：代建 + 产码可用 + 改扩展必重编 + 双向校验各自拒绝");
    return 0;
}


// ── 用户工程**显式引用**编译器域库（relocate-compiler-domain-libs）───────────────────────────
//
// **守的是什么**：隔离不是禁止，是「不隐式可见」。用户要写 linter / 格式化器 / 代码生成，就在
// `[dependencies]` 里**按名声明** SDK 库（`"z42c.syntax" = "*"`，add-sdk-libs）；引用到的 zpkg 要**被拷进他的
// 输出目录**（拷出去就能跑，不依赖 SDK 在不在）。
//
// **三格，缺一不可**：
//   ① 不声明 + `using Z42.Syntax` → 必须编**不**过（隔离在）；
//   ② 按名声明了 → 必须编过、`dist/` 里有 `z42c.syntax.zpkg`、且**整套 stdlib 没被拖进来**（能力在 + 不过度复制）；
//   ③ 旧写法 `${compiler_libs}` 路径宏（已删除）→ 必须当场报错并给出按名写法（而不是落成一句离原因很远的
//      「文件不存在: …/${compiler_libs}/…」）。
//
// 🔴 **为什么不能直接用开发树的 flat 当「用户的 libs」**：flat 里曾**有意**躺着破环预建
// （`_ensureBootstrapSelfDepLibs`）写进去的编译器域包 ⇒ ①格在开发树里天然不成立。2026-10-01 起
// `build compiler` 自建完即清走它们，但本门仍不依赖「最后跑的是哪条命令」。
// 故本门自己拼两个临时目录：`shipped/`（flat 减去编译器域 = 用户看到的 libs）+
// `cdomain/`（编译器域包，镜像 `<sdk>/programs/z42c/`，经 `Z42_COMPILER_LIBS` 交给 z42c 的编译器目录查找）。
// **这正是我实施时第一次验错的地方**（用了 flat，结论反了）。
string[] _e2eDomainPkgNames() {
    return new string[]{ "z42c.core", "z42c.syntax", "z42c.semantics", "z42c.pipeline", "z42c.driver",
                         "z42.package", "z42.project", "z42.build", "z42.scripting" };
}

bool _e2eIsDomainZpkg(string fname) {
    string[] d = _e2eDomainPkgNames();
    int i = 0;
    while (i < d.Length) { if (fname == d[i] + ".zpkg" || fname == d[i] + ".zsym") { return true; } i = i + 1; }
    return false;
}

string _e2eUserRefSrc() {
    return "namespace E2eUserLinter;\n\nusing Std;\nusing Std.IO;\nusing Z42.Syntax;\n\n"
         + "public static class Program {\n"
         + "    public static void Main() {\n"
         + "        Lexer lx = new Lexer(\"var x = 1;\", \"demo.z42\");\n"
         + "        lx.Tokenize();\n"
         + "        Console.WriteLine(\"tokens=\" + lx.Tokens().Length.ToString());\n"
         + "    }\n}\n";
}

string _e2eUserRefToml(string depLine) {
    return "[project]\nname    = \"e2euserlinter\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n"
         + "entry   = \"E2eUserLinter.Program.Main\"\n\n[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[dependencies]\n\"z42.core\" = \"0.1.0\"\n\"z42.io\"   = \"0.1.0\"\n" + depLine;
}

int _e2eUserDomainRefChecks(string root, string vm, string driverZpkg, string e2eDir) {
    string flat = _libsFlatDist(root, "release");
    string shipped = Path.Join(e2eDir, "userref_shipped");
    string cdomain = Path.Join(e2eDir, "userref_cdomain");
    _resetDir(shipped); _resetDir(cdomain);
    // shipped/ = flat 减编译器域（用户看到的 libs）
    foreach (var f in Directory.Enumerate(flat)) {
        if (!f.EndsWith(".zpkg") && !f.EndsWith(".zsym")) { continue; }
        if (_e2eIsDomainZpkg(f)) { continue; }
        File.Copy(Path.Join(flat, f), Path.Join(shipped, f));
    }
    // cdomain/ = 编译器域包（镜像 <sdk>/programs/z42c/）
    string[] dom = _e2eDomainPkgNames();
    int di = 0;
    int domN = 0;
    while (di < dom.Length) {
        string src = Path.Join(_compilerMemberDist(root, dom[di], "release"), dom[di] + ".zpkg");
        if (File.Exists(src)) { File.Copy(src, Path.Join(cdomain, dom[di] + ".zpkg")); domN = domN + 1; }
        di = di + 1;
    }
    if (domN == 0) {
        Console.WriteLine("  ✗ 用户显式引用门：cdomain/ 一个编译器域 zpkg 都没拼到（门是空的）");
        return 1;
    }

    // ① 不声明 ⇒ 看不见
    string adir = Path.Join(e2eDir, "userref_nodecl");
    Directory.Create(adir);
    File.WriteAllText(Path.Join(adir, "main.z42"), _e2eUserRefSrc());
    string atoml = Path.Join(adir, "e2euserlinter.z42.toml");
    File.WriteAllText(atoml, _e2eUserRefToml(""));
    ProcessResult r1 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(atoml).Arg("--release")
        .Env("Z42_LIBS", shipped).Env("Z42_COMPILER_LIBS", cdomain)
        .Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (r1.ExitCode == 0) {
        Console.WriteLine("  ✗ 普通工程没声明也解析到了 Z42.Syntax —— 隔离失效");
        return 1;
    }
    if (r1.Stderr.IndexOf("Lexer") < 0) {
        Console.WriteLine("  ✗ ①格编不过，但错误与 Z42.Syntax 的类型无关（门失去判别力）");
        Console.WriteLine("    stderr: " + r1.Stderr);
        return 1;
    }

    // ② 按名声明 ⇒ 能编 + 产物里有它 + 没把 stdlib 拖进来
    string bdir = Path.Join(e2eDir, "userref_decl");
    Directory.Create(bdir);
    File.WriteAllText(Path.Join(bdir, "main.z42"), _e2eUserRefSrc());
    string btoml = Path.Join(bdir, "e2euserlinter.z42.toml");
    File.WriteAllText(btoml, _e2eUserRefToml("\"z42c.syntax\" = \"*\"\n"));
    ProcessResult r2 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(btoml).Arg("--release")
        .Env("Z42_LIBS", shipped).Env("Z42_COMPILER_LIBS", cdomain)
        .Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (r2.ExitCode != 0) {
        Console.WriteLine("  ✗ 用户工程按名声明 z42c.syntax 后仍编不过: rc=" + r2.ExitCode.ToString());
        Console.WriteLine("    stderr: " + r2.Stderr);
        return 1;
    }
    string bdist = Path.Join(bdir, "dist");
    if (!File.Exists(Path.Join(bdist, "z42c.syntax.zpkg"))) {
        Console.WriteLine("  ✗ 引用到的 z42c.syntax.zpkg **没被拷进输出目录** —— 拷出去就跑不起来");
        return 1;
    }
    // 不过度复制：stdlib 仍从框架解析。`programs/z42c/` 是 driver 自包含闭包（含 stdlib 副本），
    // 解析域若排在框架之前，这里会看到整套 stdlib 被拷进来（实施时实测踩过）。
    if (File.Exists(Path.Join(bdist, "z42.core.zpkg"))) {
        Console.WriteLine("  ✗ 整套 stdlib 被拷进用户输出目录（编译器域解析域压过了框架）");
        return 1;
    }

    // ③ 旧写法 `${compiler_libs}`（宏已删除）⇒ 当场说清怎么改
    string cdir = Path.Join(e2eDir, "userref_oldmacro");
    Directory.Create(cdir);
    File.WriteAllText(Path.Join(cdir, "main.z42"), _e2eUserRefSrc());
    string ctoml = Path.Join(cdir, "e2euserlinter.z42.toml");
    File.WriteAllText(ctoml, _e2eUserRefToml(
        "\"z42c.syntax\" = { path = \"${compiler_libs}/z42c.syntax.zpkg\" }\n"));
    ProcessResult r3 = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(ctoml).Arg("--release")
        .Env("Z42_LIBS", shipped).Env("Z42_COMPILER_LIBS", cdomain)
        .Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (r3.ExitCode == 0 || r3.Stderr.IndexOf("已删除") < 0 || r3.Stderr.IndexOf("\"z42c.syntax\" = \"*\"") < 0) {
        Console.WriteLine("  ✗ 旧写法 ${compiler_libs} 没有当场报「已删除」并给出按名写法: rc="
            + r3.ExitCode.ToString());
        Console.WriteLine("    stderr: " + r3.Stderr);
        return 1;
    }
    Console.WriteLine("  ✓ 用户显式引用编译器域：不声明看不见 / 按名声明可用且拷进产物 / 旧宏写法当场报错并给出按名写法");
    return 0;
}

// ── exe 引用 SDK 库：默认复制 + 传递闭包（add-sdk-libs）──────────────────────────────────────
//
// 用户的 exe 只有 runtime（runtime 包里没有 SDK 库）⇒ 用到的 SDK 库必须复制进产物，**连同它在 SDK 库内的依赖**：
// 本格只声明 `z42c.pipeline`，而它依赖 `z42c.semantics` ⇒ 两个都要在 dist 里。反向：编译器目录里那套
// stdlib 副本**不能**被当私有依赖拷进来（stdlib 运行期从 libs/ 解析）。最后用 Z42_LIBS 真跑一遍。
//
// ⚠️ 为什么选 z42c.pipeline 而不是 z42.build：`_ensureBootstrapSelfDepLibs` 会把 z42.build / z42.project /
// z42.package / z42c.core / z42c.syntax 预建进开发树的 stdlib flat（`Z42_LIBS`），在那段时间里它们是「框架」，
// 按规则不复制（2026-10-01 起 `build compiler` 自建完即清走，但本格不赌命令顺序）。z42c.pipeline /
// z42c.semantics 从不进 flat，才稳定地代表发布态 SDK 里「不在 libs/ 的 SDK 库」。发布态全量形态由 `xtask test dist` 覆盖。
int _e2eSdkLibExeCopy(string root, string vm, string driverZpkg, string e2eDir) {
    string flat = _libsFlatDist(root, "release");   // 纯 stdlib：模拟「只有 runtime」
    string d = Path.Join(e2eDir, "sdklibexe");
    Directory.Create(d);
    File.WriteAllText(Path.Join(d, "main.z42"),
        "using Std.IO;\nusing Z42.Pipeline;\n\nvoid Main() { WsTier t = new WsTier(); Console.WriteLine(t != null ? \"sdkexe ok\" : \"sdkexe null\"); }\n");
    File.WriteAllText(Path.Join(d, "sdkexe.z42.toml"),
        "[project]\nname    = \"sdkexe\"\nversion = \"0.1.0\"\nkind    = \"exe\"\nentry   = \"Main\"\n\n"
        + "[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"z42c.pipeline\" = \"0.1.0\"\n");
    ProcessResult b = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(Path.Join(d, "sdkexe.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b.ExitCode != 0) {
        Console.WriteLine("  ✗ exe 按名声明 z42c.pipeline 却编不过: rc=" + b.ExitCode.ToString());
        Console.WriteLine("    stderr: " + b.Stderr);
        return 1;
    }
    string dist = Path.Join(d, "dist");
    if (!File.Exists(Path.Join(dist, "z42c.pipeline.zpkg")) || !File.Exists(Path.Join(dist, "z42c.semantics.zpkg"))) {
        Console.WriteLine("  ✗ exe 产物缺 SDK 库（应有 z42c.pipeline + 其依赖 z42c.semantics）: " + _e2eLs(dist));
        return 1;
    }
    if (File.Exists(Path.Join(dist, "z42.core.zpkg"))) {
        Console.WriteLine("  ✗ 编译器目录里的 stdlib 副本被当私有依赖拷进了 exe 产物: " + _e2eLs(dist));
        return 1;
    }
    ProcessResult r = new Process(vm).Arg(Path.Join(dist, "sdkexe.zpkg")).Env("Z42_LIBS", flat)
        .EnvRemove("Z42_HOME").EnvRemove("Z42_COMPILER_LIBS").Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (r.ExitCode != 0 || r.Stdout.Trim() != "sdkexe ok") {
        Console.WriteLine("  ✗ 复制了 SDK 库的 exe 在纯 stdlib 环境跑不起来: rc=" + r.ExitCode.ToString() + " " + r.Stdout + r.Stderr);
        return 1;
    }
    Console.WriteLine("  ✓ exe 引用 SDK 库：z42c.pipeline + 传递依赖 z42c.semantics 复制进产物、stdlib 副本未混入，可运行");
    return 0;
}

string _e2eLs(string dir) {
    if (!Directory.Exists(dir)) { return "(无 " + dir + ")"; }
    string[] xs = Directory.Enumerate(dir);
    string s = "";
    int i = 0;
    while (i < xs.Length) { s = s + (i > 0 ? ", " : "") + xs[i]; i = i + 1; }
    return s;
}

// ── `deploy = "sdk"`：不复制，运行期经 `${Z42_HOME}` 从所在 SDK 解析（add-sdk-libs）──────────────────
//
// 四格：① 构建成功；② 产物里**没有** SDK 库副本、侧车 probing-paths 带 `${Z42_HOME}/programs/z42c`；
// ③ 以一个只含 `programs/z42c/{z42c.pipeline,z42c.semantics}` 的目录当 Z42_HOME ⇒ 跑得起来（从「SDK」解析到了）；
// ④ 对 stdlib 写 `deploy = "sdk"` ⇒ 报错（只适用于 SDK 库）。
// 选 z42c.pipeline 的理由同 `_e2eSdkLibExeCopy`：开发树 stdlib flat 里预建着 z42.build 等，它们在这里是「框架」。
int _e2eSdkLibDeploySdk(string root, string vm, string driverZpkg, string e2eDir) {
    string flat = _libsFlatDist(root, "release");
    string d = Path.Join(e2eDir, "sdkdeploy");
    Directory.Create(d);
    File.WriteAllText(Path.Join(d, "main.z42"),
        "using Std.IO;\nusing Z42.Pipeline;\n\nvoid Main() { WsTier t = new WsTier(); Console.WriteLine(t != null ? \"sdkdeploy ok\" : \"sdkdeploy null\"); }\n");
    File.WriteAllText(Path.Join(d, "sdkdeploy.z42.toml"),
        "[project]\nname    = \"sdkdeploy\"\nversion = \"0.1.0\"\nkind    = \"exe\"\nentry   = \"Main\"\n\n"
        + "[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"z42c.pipeline\" = { version = \"0.1.0\", deploy = \"sdk\" }\n");
    ProcessResult b = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(Path.Join(d, "sdkdeploy.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (b.ExitCode != 0) {
        Console.WriteLine("  ✗ deploy = \"sdk\" 的 exe 编不过: rc=" + b.ExitCode.ToString());
        Console.WriteLine("    stderr: " + b.Stderr);
        return 1;
    }
    string dist = Path.Join(d, "dist");
    if (File.Exists(Path.Join(dist, "z42c.pipeline.zpkg")) || File.Exists(Path.Join(dist, "z42c.semantics.zpkg"))) {
        Console.WriteLine("  ✗ deploy = \"sdk\" 的 SDK 库仍被拷进了产物: " + _e2eLs(dist));
        return 1;
    }
    string sidecar = Path.Join(dist, "sdkdeploy.runtimeconfig.toml");
    if (!File.Exists(sidecar) || File.ReadAllText(sidecar).IndexOf("${Z42_HOME}/programs/z42c") < 0) {
        Console.WriteLine("  ✗ 侧车没有补 ${Z42_HOME}/programs/z42c: " + (File.Exists(sidecar) ? File.ReadAllText(sidecar) : "(无侧车)"));
        return 1;
    }
    // ③ 造一个最小「SDK」：只有 programs/z42c 里那两个包（取自编译器目录）。
    string sdk = Path.Join(e2eDir, "sdkdeploy_fakesdk");
    string prog = Path.Join(sdk, "programs/z42c");
    if (Directory.Exists(sdk)) { Directory.Delete(sdk, true); }
    Directory.Create(prog);
    string cdom = Path.GetDirectoryName(driverZpkg);
    File.Copy(Path.Join(cdom, "z42c.pipeline.zpkg"), Path.Join(prog, "z42c.pipeline.zpkg"));
    File.Copy(Path.Join(cdom, "z42c.semantics.zpkg"), Path.Join(prog, "z42c.semantics.zpkg"));
    ProcessResult r = new Process(vm).Arg(Path.Join(dist, "sdkdeploy.zpkg")).Env("Z42_LIBS", flat).Env("Z42_HOME", sdk)
        .EnvRemove("Z42_COMPILER_LIBS").Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    if (r.ExitCode != 0 || r.Stdout.Trim() != "sdkdeploy ok") {
        Console.WriteLine("  ✗ deploy = \"sdk\" 的 exe 在「SDK」上跑不起来: rc=" + r.ExitCode.ToString() + " " + r.Stdout + r.Stderr);
        return 1;
    }
    // ④ stdlib 写 deploy = "sdk" ⇒ 报错。
    string e = Path.Join(e2eDir, "sdkdeploy_bad");
    Directory.Create(e);
    File.WriteAllText(Path.Join(e, "main.z42"), "using Std.IO;\n\nvoid Main() { Console.WriteLine(\"x\"); }\n");
    File.WriteAllText(Path.Join(e, "bad.z42.toml"),
        "[project]\nname    = \"sdkdeploybad\"\nversion = \"0.1.0\"\nkind    = \"exe\"\nentry   = \"Main\"\n\n"
        + "[sources]\ninclude = [\"*.z42\"]\n\n[dependencies]\n\"z42.io\" = { version = \"0.1.0\", deploy = \"sdk\" }\n");
    ProcessResult bad = new Process(vm).Arg(driverZpkg).Arg("--").Arg("build").Arg(Path.Join(e, "bad.z42.toml")).Arg("--release")
        .Env("Z42_LIBS", flat).Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run();
    if (bad.ExitCode == 0 || bad.Stderr.IndexOf("只适用于") < 0) {
        Console.WriteLine("  ✗ 对 stdlib 写 deploy = \"sdk\" 没有报错（或报错不对）: rc=" + bad.ExitCode.ToString() + " " + bad.Stderr);
        return 1;
    }
    Console.WriteLine("  ✓ deploy = \"sdk\"：不复制、侧车补 ${Z42_HOME}/programs/z42c、在 SDK 上可运行；stdlib 误用报错");
    return 0;
}
