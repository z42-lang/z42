// xtask — `build stdlib` impl (unify-scripts-into-xtask, 2026-06-05). Folded from
// the former standalone scripts/build-stdlib.z42 so the LAST command that still
// shelled out to a separate .z42 via `dotnet -- run` now runs in-process.
//
// Compiles the z42 stdlib workspace and assembles the flat dist view. The stdlib
// is built by z42c (the self-hosting z42 compiler) — C# was fully removed
// 2026-06-26 (remove-dotnet-from-builds). Flow (_buildStdlibCore):
//
//   1. ensure seed — warm tree reuses in-tree z42c.driver.zpkg + stdlib dist; a
//      cold tree stages them from an SDK toolchain via _ensureSeed (see
//      common/xtask_common.z42). No dotnet anywhere.
//   2. build z42c  — z42c self-builds the 7 z42c.* members (_buildCompilerViaZ42c).
//   3. run-libs    — snapshot stdlib → .stdlib-run so the self-contained z42c.driver
//      has a stable Std.* copy to load while it recompiles stdlib.
//   4. z42c rebuild — z42vm runs z42c.driver `build --workspace --release` over
//      src/libraries; the per-member dist dirs are OVERWRITTEN with z42c-built
//      zpkg + .zsym (strip-symbols).
//   5. verify + flat view (hard-link) over the z42c-built products.
//
// Cold-bootstrap note: this runs INSIDE xtask.zpkg, so xtask (and the stdlib it
// depends on) must already exist. The CI/local cold bootstrap downloads the
// previous nightly's z42c seed and builds xtask FIRST (see .github/actions/
// ci-bootstrap); _buildStdlibCore's step 1 then stages that seed into the in-tree
// layout before the z42c-takeover rebuild.
namespace Z42Xtask;

using Std;
using Std.IO;

// 把各成员 dist/*.zpkg + *.zsym hard-link 汇聚到 flat view（VM 单目录查找点）。
// 不写 namespace index（VM 扫目录读 NSPC，嵌入解析器读 zpkg NSPC）。
void _assembleStdlibFlatView(string root, string profile) {
    string buildLibsRoot = Path.Join(root, "artifacts/build/libraries");
    string flatDir = Path.Join(root, "artifacts/build/libraries/dist/" + profile);
    string[] libs = _stdlibList(root);
    Directory.Create(flatDir);
    _cleanGlob(flatDir, "*.zpkg");
    _cleanGlob(flatDir, "*.zsym");
    int i = 0;
    while (i < libs.Length) {
        string srcDir = Path.Join(buildLibsRoot, libs[i] + "/" + profile + "/dist");
        _linkAll(srcDir, flatDir, "*.zpkg");
        _linkAll(srcDir, flatDir, "*.zsym");
        i = i + 1;
    }
}

int _buildStdlibCore() {
    string root = _root();
    string profile = "release";
    string buildLibsRoot = Path.Join(root, "artifacts/build/libraries");
    string flatDir = Path.Join(root, "artifacts/build/libraries/dist/" + profile);
    Stopwatch swAll = _procStart("build stdlib (z42c self-build + libs)");

    // ── 1+2. Produce the seed: stdlib + z42c, from CURRENT source ─────────
    //    Warm tree (prior build / nightly seed present): rebuild z42c via z42c.
    //    Cold tree (fresh checkout, no seed): _ensureSeed stages a z42c.driver.zpkg
    //    + stdlib dist from an SDK toolchain first. No dotnet — C# was removed
    //    2026-06-26 (remove-dotnet-from-builds).
    string[] members = _compilerMembers(root);
    // replace-csharp Phase C：C#-free warm 路径用绝对 release z42vm（_z42vm() 返回裸名 "z42vm"
    // 不在 PATH → warm 自建会 NotFound）。缺则 cargo 建（幂等）。
    string vm = _builtVm(root, "release");
    if (!File.Exists(vm)) { int rcv = _buildRuntime(); if (rcv != 0) { return rcv; } }
    // Cold tree → stage the z42c+stdlib seed from the resolved SDK; warm → no-op.
    // Shared with build compiler + CI (see _ensureSeed).
    int sc0 = _ensureSeed(root); if (sc0 != 0) { return sc0; }
    int zc = _buildCompilerViaZ42c(root, profile, members, vm, flatDir); if (zc != 0) { return zc; }

    // ── 3. 稳定 stdlib 快照（供 z42c.driver 运行期的 Std.*）──────────────────
    //    stdlib 正被重建 → driver 的运行期 Std.* 需一份不随构建 churn 的稳定副本。
    //    只拷 stdlib：driver 的 z42c 兄弟包已 bundle 在其自身 dist（自包含 exe，
    //    simplify-compiler-build），不再拼 {stdlib+z42c} 的 dogfood 目录。
    string stdlibRun = Path.Join(root, "artifacts/.scratch/stdlib-run/" + profile);
    _resetDir(stdlibRun);
    _copyAll(flatDir, stdlibRun, "*.zpkg");
    // z42c.driver 自包含（_buildCompilerViaZ42c 已保证兄弟包在其 dist）→ 直接跑。
    string z42cDriver = Path.Join(root, "artifacts/build/compiler/z42c.driver/" + profile + "/dist/z42c.driver.zpkg");
    if (!File.Exists(z42cDriver) || File.GetSize(z42cDriver) <= 0L) {
        ConsoleError.WriteLine("  ✗ z42c.driver.zpkg invalid: " + z42cDriver);
        return 1;
    }

    // ── 4. z42c rebuild stdlib per-member (M2 drop-in; overwrites seed) ──
    //    CWD=src/libraries → workspace discovery + per-member output_dir template;
    //    --mode interp (jit has cross-zpkg undefined-fn on compiler workloads);
    //    Z42_LIBS=stdlibRun：稳定 stdlib 快照供 driver 运行期 Std.*（fresh member 从
    //    workspace dist 解析、优先于快照，故重建自洽）。
    _vNormal("  z42c build --workspace (CWD=src/libraries, interp) → per-member dist");
    int bc = new Process(vm).Arg(z42cDriver).Arg("--mode").Arg("interp").Arg("--")
        .Arg("build").Arg("--workspace").Arg("--release")
        .WorkingDirectory(Path.Join(root, "src/libraries"))
        .Env("Z42_LIBS", stdlibRun)
        .Stdout(_verbAtLeast(3) ? Stdio.Inherit() : Stdio.Null()).Stderr(Stdio.Inherit()).Run().ExitCode;
    if (bc != 0) { ConsoleError.WriteLine("  ✗ z42c build --workspace stdlib failed (" + bc.ToString() + ")"); return 1; }

    // ── 5. Verify zpkg products (z42c-built) ─────────────────────────────
    string[] libs = _stdlibList(root);
    int ok = 0;
    int fail = 0;
    int i = 0;
    while (i < libs.Length) {
        string zpkg = Path.Join(buildLibsRoot,
            libs[i] + "/" + profile + "/dist/" + libs[i] + ".zpkg");
        if (File.Exists(zpkg) && File.GetSize(zpkg) > 0L) {
            long size = File.GetSize(zpkg);
            _vDetailed("    ✓ " + libs[i] + ".zpkg (" + size.ToString() + " bytes)");
            ok = ok + 1;
        } else {
            Console.WriteLine("    ✗ " + libs[i] + ".zpkg — workspace product missing at " + zpkg);
            fail = fail + 1;
        }
        i = i + 1;
    }

    _vlog(1, "  build-stdlib: " + ok.ToString() + " succeeded, " + fail.ToString() + " failed");
    if (fail > 0) { return 1; }

    // ── 6. Flat view (hard-link, z42c-built; overwrites step-1 C# seed view) ──
    _assembleStdlibFlatView(root, profile);
    _vNormal("  flat view: " + flatDir + "/   (VM single-dir lookup target)");
    _procEnd("build stdlib (z42c self-build + libs)", swAll);
    return 0;
}

// Stdlib member list — derived from the workspace manifest's `default-members`
// (single source of truth; no hand-maintained duplicate that could drift, cf.
// the old index.json). Order is irrelevant here: z42c `build --workspace`
// topo-sorts; this list only drives the verify + hard-link loops.
string[] _stdlibList(string root) {
    return _vgetListFromFile(root, "src/libraries/z42.workspace.toml", "workspace.default-members");
}

// z42c 编译器成员列表 — 同样派生自 compiler workspace 的 `default-members`（单一真相源，
// 对称 _stdlibList）。compiler/test/bench/package/bootstrap-check 都用同一份，避免字面量散落。
string[] _compilerMembers(string root) {
    return _vgetListFromFile(root, "src/compiler/z42.workspace.toml", "workspace.default-members");
}

// 组装 alllibs flat 视图：stdlib dist + z42c 7 成员 dist 全部 hard-link 到
// artifacts/.scratch/alllibs/<profile>，作为 z42c.driver 编译/运行的单一 Z42_LIBS 查找点
// （VM 取一个目录、非 colon-list；z42c.driver 的兄弟包与被测 stdlib 须同处一目录）。返回该目录。
// 三处消费共用：test stdlib（_testLibCore）/ test compiler units（_testCompilerUnits）/ bench。
string _assembleAllLibs(string root, string profile) {
    string flat = Path.Join(root, "artifacts/.scratch/alllibs/" + profile);
    Directory.Create(flat);
    _cleanGlob(flat, "*.zpkg");
    _linkAll(Path.Join(root, "artifacts/build/libraries/dist/" + profile), flat, "*.zpkg");
    string[] members = _compilerMembers(root);
    int i = 0;
    while (i < members.Length) {
        _linkAll(Path.Join(root, "artifacts/build/compiler/" + members[i] + "/" + profile + "/dist"), flat, "*.zpkg");
        i = i + 1;
    }
    return flat;
}

void _cleanGlob(string dir, string pattern) {
    string[] hits = Path.Glob(dir, pattern);
    int i = 0;
    while (i < hits.Length) {
        try { File.Delete(hits[i]); } catch (Exception e) { /* best-effort */ }
        i = i + 1;
    }
}

// Hard-link srcDir's matches into flatDir; fall back to Copy across filesystems
// (mirrors bash `cp -l ... || cp`).
void _linkAll(string srcDir, string flatDir, string pattern) {
    if (!Directory.Exists(srcDir)) { return; }
    string[] hits = Path.Glob(srcDir, pattern);
    int i = 0;
    while (i < hits.Length) {
        string dst = Path.Join(flatDir, Path.GetFileName(hits[i]));
        try { File.Link(hits[i], dst); }
        catch (Exception e) {
            try { File.Copy(hits[i], dst); } catch (Exception e2) { /* skip */ }
        }
        i = i + 1;
    }
}

// ── build sdk (compile-once P1.3) ────────────────────────────────────────────

// `build sdk [--out <dir>]` — assemble the current toolchain into a `.z42` layout
// consumable by `--toolchain <dir>`:
//   <out>/programs/z42c/*.zpkg   (z42c 7-pkg seed + 6 driver siblings)
//   <out>/libs/*.zpkg + *.zsym   (stdlib flat)
//   <out>/bin/z42vm[.exe]        (host VM)
// Default --out = artifacts/.z42 (the local SDK set; Decision 1). outOpt is the
// raw `--out` value ("" = default); a relative value resolves against repo root.
//
// P1.3 builds the toolchain via the warm C#-free path (_buildStdlib builds z42c +
// stdlib; it self-ensures z42vm) then assembles from the canonical build-tree
// artifacts. Pair-gen + conditional fixpoint (gen1→gen2, Decision 5/6) layers in
// P1.4 — here the assembled z42c/stdlib are whatever _buildStdlib produced.
// `noBuild` skips the rebuild and assembles from existing canonical artifacts —
// used in CI where the bootstrap already built the warm toolchain (avoids a
// redundant stdlib rebuild).
int _buildSdk(string outOpt, bool noBuild) {
    string root = _root();
    Stopwatch sw = _procStart("build sdk");
    string outDir = outOpt;
    if (outOpt.Length == 0) { outDir = Path.Join(root, "artifacts/.z42"); }
    else if (!Path.IsRooted(outOpt)) { outDir = Path.Join(root, outOpt); }

    // 1. build current toolchain (z42c 7-pkg seed + stdlib; ensures z42vm), C#-free.
    //    Skipped under --no-build (CI: bootstrap already produced warm artifacts).
    int c = 0;
    if (!noBuild) {
        c = _buildStdlib(); if (c != 0) { return c; }
    }

    // 2. assemble .z42 layout (reset for a clean SDK — no stale members).
    Console.WriteLine("build sdk -> " + outDir);
    _resetDir(outDir);

    string z42cDir = Path.Join(Path.Join(outDir, "programs"), "z42c");
    Directory.Create(z42cDir);
    string[] members = _compilerMembers(root);
    int i = 0;
    while (i < members.Length) {
        string m = members[i];
        string distDir = Path.Join(root, "artifacts/build/compiler/" + m + "/release/dist");
        _copyIfExists(Path.Join(distDir, m + ".zpkg"), Path.Join(z42cDir, m + ".zpkg"));
        _copyIfExists(Path.Join(distDir, m + ".zsym"), Path.Join(z42cDir, m + ".zsym"));
        i = i + 1;
    }
    Console.WriteLine("  ✓ programs/z42c/ (" + members.Length.ToString() + " pkgs)");

    Directory.Create(Path.Join(outDir, "libs"));
    c = _pkgCopyLibs(_libsDir(root), outDir); if (c != 0) { return c; }
    Console.WriteLine("  ✓ libs/ (stdlib)");

    string binDir = Path.Join(outDir, "bin");
    Directory.Create(binDir);
    string cargoOut = Path.Join(root, "artifacts/build/runtime/release");
    _copyIfExists(Path.Join(cargoOut, "z42vm"), Path.Join(binDir, "z42vm"));
    _copyIfExists(Path.Join(cargoOut, "z42vm.exe"), Path.Join(binDir, "z42vm.exe"));
    _makeExe(Path.Join(binDir, "z42vm"));
    Console.WriteLine("  ✓ bin/z42vm");

    // 4. complete + runnable SDK: merge z42c + toolchain apphosts (bin/z42, bin/z42c,
    //    bin/z42b, bin/z42d, bin/z42i + their programs payloads) from each toml's
    //    publish_dir (add-build-toolchain). noBuild → merge already-published trees.
    int mc = _sdkMergeApphosts(root, outDir, noBuild); if (mc != 0) { return mc; }
    Console.WriteLine("  ✓ apphosts (z42/z42c/z42b/z42d/z42i merged from publish_dir)");
    _procEnd("build sdk", sw);
    return 0;
}

// ── stage toolchain (script-zero: replaces scripts/ci-stage-toolchain.sh) ─────
// Stage ONLY the .zpkg/.zsym products (z42c per-member dist + stdlib flat dist +
// per-member dist + xtask.zpkg) into <dest> for upload as the `toolchain-<os>` CI
// artifact. NOT z42vm or cargo intermediates — consuming jobs cargo-build their
// own host z42vm. Byte-for-byte the same layout the former bash script produced.
int _stageToolchain(string dest) {
    if (dest.Length == 0) {
        ConsoleError.WriteLine("usage: xtask build stage-toolchain <dest-dir>");
        return 2;
    }
    string root = _root();
    Stopwatch sw = _procStart("build stage-toolchain");
    // 1. stdlib flat dist (Z42_LIBS lookup): every file in dist/release/
    string flatSrc = _libsDir(root);
    string flatDst = Path.Join(dest, "artifacts/build/libraries/dist/release");
    Directory.Create(flatDst);
    string[] flat = Path.Glob(flatSrc, "*");
    int fi = 0;
    while (fi < flat.Length) {
        _copyIfExists(flat[fi], Path.Join(flatDst, Path.GetFileName(flat[fi])));
        fi = fi + 1;
    }
    // 2. stdlib per-member dist (warm-seed self-build inputs)
    _stageMembers(Path.Join(root, "artifacts/build/libraries"), dest, "artifacts/build/libraries");
    // 3. z42c compiler per-member dist (7 zpkgs incl z42c.driver.zpkg = warm seed)
    _stageMembers(Path.Join(root, "artifacts/build/compiler"), dest, "artifacts/build/compiler");
    // 4. xtask dev CLI
    string xtDst = Path.Join(dest, "artifacts/xtask");
    Directory.Create(xtDst);
    _copyIfExists(Path.Join(root, "artifacts/xtask/xtask.zpkg"), Path.Join(xtDst, "xtask.zpkg"));
    Console.WriteLine("staged C#-free toolchain -> " + dest);
    _procEnd("build stage-toolchain", sw);
    return 0;
}

// Copy <baseSrc>/<m>/release/dist/*.{zpkg,zsym} → <dest>/<relBase>/<m>/release/dist/
// for every member dir <m> that has a release/dist (the flat `dist` dir has none).
void _stageMembers(string baseSrc, string dest, string relBase) {
    if (!Directory.Exists(baseSrc)) { return; }
    string[] members = _enumDirsSorted(baseSrc);
    int i = 0;
    while (i < members.Length) {
        string m = members[i];
        string srcDist = Path.Join(Path.Join(baseSrc, m), "release/dist");
        if (Directory.Exists(srcDist)) {
            string dstDist = Path.Join(Path.Join(Path.Join(dest, relBase), m), "release/dist");
            Directory.Create(dstDist);
            _stageCopyExt(srcDist, dstDist, "*.zpkg");
            _stageCopyExt(srcDist, dstDist, "*.zsym");
        }
        i = i + 1;
    }
}

void _stageCopyExt(string srcDir, string dstDir, string pattern) {
    string[] fs = Path.Glob(srcDir, pattern);
    int i = 0;
    while (i < fs.Length) {
        _copyIfExists(fs[i], Path.Join(dstDir, Path.GetFileName(fs[i])));
        i = i + 1;
    }
}
