// xtask — `build stdlib` impl (unify-scripts-into-xtask). Folded from
// the former standalone scripts/build-stdlib.z42 so the LAST command that still
// shelled out to a separate .z42 via `dotnet -- run` now runs in-process.
//
// Compiles the z42 stdlib workspace and assembles the flat dist view. The stdlib
// is built by z42c (the self-hosting z42 compiler) — C# was fully removed
// (remove-dotnet-from-builds). Flow (_buildStdlib):
//
//   1. ensure seed — warm tree reuses in-tree z42c.driver.zpkg + stdlib dist; a
//      cold tree stages them from an SDK toolchain via _ensureSeed (see
//      common/xtask_common.z42). No dotnet anywhere.
//   2. build z42c  — z42c self-builds the 7 z42c.* members (_buildCompilerViaZ42c).
//   3. run-libs    — snapshot stdlib → .stdlib-run so the self-contained z42c.driver
//      has a stable Std.* copy to load while it recompiles stdlib.
//   4. z42c rebuild — z42vm runs z42c.driver `build --workspace --release` over
//      src/libraries; the per-member dist dirs are OVERWRITTEN with z42c-built
//      zpkg + .zsym (strip-symbols).
//   5. verify + flat view (hard-link) over the z42c-built products.
//
// Cold-bootstrap note: this runs INSIDE xtask.zpkg, so xtask (and the stdlib it
// depends on) must already exist. The CI/local cold bootstrap downloads the
// previous nightly's z42c seed and builds xtask FIRST (see .github/actions/
// ci-bootstrap); _buildStdlib's step 1 then stages that seed into the in-tree
// layout before the z42c-takeover rebuild.
namespace Z42Xtask;

using Std.IO;
using Std.Time;

// 把各成员 dist/*.zpkg + *.zsym hard-link 汇聚到 flat view（VM 单目录查找点）。
// 不写 namespace index（VM 扫目录读 NSPC，嵌入解析器读 zpkg NSPC）。
void _assembleStdlibFlatView(string root, string profile) {
    string flatDir = _libsFlatDist(root, profile);
    string[] libs = _stdlibList(root);
    Directory.Create(flatDir);
    _cleanGlob(flatDir, "*.zpkg");
    _cleanGlob(flatDir, "*.zsym");
    int i = 0;
    while (i < libs.Length) {
        string srcDir = _libMemberDist(root, libs[i], profile);
        _linkAll(srcDir, flatDir, "*.zpkg");
        _linkAll(srcDir, flatDir, "*.zsym");
        i = i + 1;
    }
}

// `build stdlib` 命令入口（同时被 build compiler / 多个 test stage 直接调用）。
int _buildStdlib() {
    string root = _root();
    string profile = "release";
    string flatDir = _libsFlatDist(root, profile);
    Stopwatch swAll = _procStart("build stdlib (z42c self-build + libs)");

    // ── 1+2. Produce the seed: stdlib + z42c, from CURRENT source ─────────
    //    Warm tree (prior build / nightly seed present): rebuild z42c via z42c.
    //    Cold tree (fresh checkout, no seed): _ensureSeed stages a z42c.driver.zpkg
    //    + stdlib dist from an SDK toolchain first. No dotnet — C# was removed
    //    (remove-dotnet-from-builds).
    string[] members = _compilerMembers(root);
    // warm 路径用绝对 release z42vm（_z42vm() 返回裸名 "z42vm"
    // 不在 PATH → warm 自建会 NotFound）。缺则 cargo 建（幂等）。
    string vm = _builtVm(root, "release");
    if (!File.Exists(vm)) { int rcv = _buildRuntime(); if (rcv != 0) { return rcv; } }
    // Cold tree → stage the z42c+stdlib seed from the resolved SDK; warm → no-op.
    // Shared with build compiler + CI (see _ensureSeed).
    int sc0 = _ensureSeed(root); if (sc0 != 0) { return sc0; }
    int zc = _buildCompilerViaZ42c(root, profile, members, vm, flatDir); if (zc != 0) { return zc; }

    // ── 3. 稳定 stdlib 快照（供 z42c.driver 运行期的 Std.*）──────────────────
    //    stdlib 正被重建 → driver 的运行期 Std.* 需一份不随构建 churn 的稳定副本。
    //    只拷 stdlib：driver 的 z42c 兄弟包已 bundle 在其自身 dist（自包含 exe，
    //    simplify-compiler-build），不再拼 {stdlib+z42c} 的 dogfood 目录。
    string stdlibRun = _compilerWsWork(root, "stdlib-run/" + profile);
    _resetDir(stdlibRun);
    _copyAll(flatDir, stdlibRun, "*.zpkg");
    // z42c.driver 自包含（_buildCompilerViaZ42c 已保证兄弟包在其 dist）→ 直接跑。
    string z42cDriver = _driverZpkg(root, profile);
    if (!File.Exists(z42cDriver) || File.GetSize(z42cDriver) <= 0L) {
        ConsoleError.WriteLine("  ✗ z42c.driver.zpkg invalid: " + z42cDriver);
        return 1;
    }

    // ── 3.5 stdlib 携带插件（非 internal 条目）：release 验产物要求 dist 先在 ⇒ 必须先于 workspace。
    //      internal 授权条目（以宿主为 ParentPkg 编译）构造上宿主先建 ⇒ 挪到 4.5（见下）。
    if (_buildStdlibCarriedPlugins(root, vm, z42cDriver, stdlibRun, false) != 0) { return 1; }

    // ── 4. z42c rebuild stdlib per-member (M2 drop-in; overwrites seed) ──
    //    CWD=src/libraries → workspace discovery + per-member output_dir template;
    //    Z42_LIBS=stdlibRun：稳定 stdlib 快照供 driver 运行期 Std.*（fresh member 从
    //    workspace dist 解析、优先于快照，故重建自洽）。mode 经 _z42cMode()（默认 interp）。
    _vNormal("  z42c build --workspace (CWD=src/libraries) → per-member dist");
    int bc = _z42cWorkspaceBuild(vm, z42cDriver, Path.Join(root, "src/libraries"), stdlibRun, false);
    if (bc != 0) { ConsoleError.WriteLine("  ✗ z42c build --workspace stdlib failed (" + bc.ToString() + ")"); return 1; }

    // ── 5. Verify zpkg products (z42c-built) ─────────────────────────────
    string[] libs = _stdlibList(root);
    int fail = _verifyMemberZpkgs(_libsWsToml(root), libs, profile);
    int ok = libs.Length - fail;
    _vlog(1, "  build-stdlib: " + ok.ToString() + " succeeded, " + fail.ToString() + " failed");
    if (fail > 0) { return 1; }

    // ── 6. Flat view (hard-link, z42c-built; overwrites step-1 C# seed view) ──
    _assembleStdlibFlatView(root, profile);
    _vNormal("  flat view: " + flatDir + "/   (VM single-dir lookup target)");

    // ── 6.5 internal 授权的携带插件（plugin-internal-access）：以宿主为 ParentPkg 编译（--internal-of）。
    //      必须在 flat 汇聚之后——插件的解析域（flat）此刻才有**宿主的新 dist**（workspace 刚建完；
    //      stdlibRun 是旧快照、4.5 时 flat 还是种子态，都不行）。
    if (_buildStdlibCarriedPlugins(root, vm, z42cDriver, flatDir, true) != 0) { return 1; }
    if (_releaseGuard(root) != 0) { return 1; }
    _procEnd("build stdlib (z42c self-build + libs)", swAll);
    return 0;
}

// release guard：测试 / 基准的合成包（`<lib>.test.<unit>.zpkg` / `<lib>.bench.<unit>.zpkg`）绝不能进生产产物——
// 各库的 `<lib>/<profile>/dist/` 与 SDK 真正取库的 flat 视图（`_libsDir`）；那里的东西会随 SDK 发给用户。
// 测试 / 基准自己的输出在 `<lib>/<profile>/{tests,benches}/…` 下（其中按设计也有被测库的拷贝），不在判定面内。
// 漏改某处 output_dir 时这是唯一会响的地方，所以每次 build stdlib 都扫一遍（两层目录列举，毫秒级）。
int _releaseGuard(string root) {
    int bad = 0;
    string base_ = _libsBuildRoot(root);
    if (Directory.Exists(base_)) {
        foreach (var lib in _enumDirsSorted(base_)) {
            foreach (var prof in _enumDirsSorted(Path.Join(base_, lib))) {
                bad = bad + _releaseGuardDir(Path.Join(Path.Join(Path.Join(base_, lib), prof), "dist"));
            }
        }
    }
    bad = bad + _releaseGuardDir(_libsDir(root));
    return bad == 0 ? 0 : 1;
}

int _releaseGuardDir(string dir) {
    if (!Directory.Exists(dir)) { return 0; }
    int bad = 0;
    foreach (var f in Path.Glob(dir, "*.zpkg")) {
        if (_isHarnessZpkg(Path.GetFileName(f))) {
            ConsoleError.WriteLine("  ✗ release guard: 测试 / 基准包漏进了生产产物 " + f);
            bad = bad + 1;
        }
    }
    return bad;
}

// `<lib>.test.<unit>.zpkg` / `<lib>.bench.<unit>.zpkg`：`test` / `bench` 段后面还有段。库 `z42.harness.zpkg` 本身不算。
bool _isHarnessZpkg(string name) {
    string[] seg = name.Substring(0, name.Length - 5).Split(".");
    int i = 0;
    while (i < seg.Length - 1) {
        if (seg[i] == "test" || seg[i] == "bench") { return true; }
        i = i + 1;
    }
    return false;
}

// Stdlib member list — derived from the workspace manifest's `default_members`
// (single source of truth; no hand-maintained duplicate that could drift, cf.
// the old index.json). Order is irrelevant here: z42c `build --workspace`
// topo-sorts; this list only drives the verify + hard-link loops.
string[] _stdlibList(string root) {
    return _vgetListFromFile(root, "src/libraries/z42.workspace.toml", "workspace.default_members");
}

// z42c 编译器成员列表 — 同样派生自 compiler workspace 的 `default_members`（单一真相源，
// 对称 _stdlibList）。compiler/test/bench/package/bootstrap-check 都用同一份，避免字面量散落。
string[] _compilerMembers(string root) {
    return _vgetListFromFile(root, "src/compiler/z42.workspace.toml", "workspace.default_members");
}

// ── 编译器包的运行期 probing（drop-alllibs）──────────────────────────────────────────
//
// 运行期要**加载**编译器包的进程——z42b（自身依赖 `z42.build` / `z42.project`，并注入 `z42c.pipeline`）以及它为
// 编译器单元测试 fork 的子 VM——拿这里给的 `Z42_PROBING_PATHS`：各编译器成员的 dist，平台分隔。
// 编译期不需要它：driver 按名从编译器目录解析 SDK 库（`CompilerDomain` 开发树档）。
//
// 此前的做法是 alllibs（`artifacts/build/views/<profile>/all`）：把 stdlib flat 与全部编译器成员 dist **拷**进一个目录当
// `Z42_LIBS`，因为 VM 的 `Z42_LIBS` 只能是一个目录。它带来两类问题：① 编译器成员 dist 里的 stdlib 副本会把新 stdlib
// 遮蔽成旧的（#955，只能靠拷贝顺序 + 事后逐字节对账兜住）；② 工具链程序在它下面编译时，编译器包被当成「框架」⇒
// 是否复制进发布包取决于构建环境而不是清单。现在 `Z42_LIBS` 只是 stdlib flat，编译器包走 probing。
//
// 🔴 **不含 `z42c.driver`**：它的 dist 是自包含闭包（带全部编译器兄弟包；老 driver 建的还带 stdlib 副本）；probing 排在
// `Z42_LIBS` **之前**，放进来就是 #955 原样复发。其余成员的 dist 只有自己（下方逐目录断言，违反即抛——不靠约定）。
// ⚠️ 只给**这些进程**设，不往 xtask 自身环境里放：`Z42_PROBING_PATHS` 会**覆盖**程序侧车的 `probing-paths`，全局一设，
// 测 probing / `deploy = "sdk"` 的那些用例就被干扰了。
string _compilerProbingPaths(string root) {
    string[] members = _compilerMembers(root);
    string[] libs = _stdlibList(root);
    string sep = Platform.IsWindows() ? ";" : ":";
    string acc = "";
    int i = 0;
    while (i < members.Length) {
        string m = members[i];
        i = i + 1;
        if (m == "z42c.driver") { continue; }
        string dir = _compilerMemberDist(root, m, "release");
        if (!Directory.Exists(dir)) { continue; }
        int j = 0;
        while (j < libs.Length) {
            if (File.Exists(Path.Join(dir, libs[j] + ".zpkg"))) {
                throw new Exception("compiler probing: " + dir + " 里有 stdlib 包 " + libs[j]
                    + ".zpkg —— probing 排在 Z42_LIBS 之前，它会遮蔽 stdlib flat 里的新版本（#955）。"
                    + "编译器成员（driver 以外）的 dist 只应有它自己。");
            }
            j = j + 1;
        }
        acc = acc.Length == 0 ? dir : acc + sep + dir;
    }
    return acc;
}

// ── z42 子进程的唯一入口（xtask-proc-factory）───────────────────────────────────────────
//
// xtask 起的每个「跑 z42 代码」的子进程都从这两个函数建，不在调用点手写 `.Env("Z42_LIBS", …)` /
// `.Env("Z42_PROBING_PATHS", …)`。两个 env 各有一个静默坑：
//   ① 漏 `Z42_LIBS` 不报错——子进程**继承 xtask 自身的**（`.z42/libs`，上一版 SDK），静默跑在旧 stdlib 上；
//   ② 漏 probing 只在 z42b 真去加载编译器包时才炸（`MissingSymbolException ManifestLoader.Load`）。
// `xtask check proc-env` 守住「调用点不得再直接设这些变量」（见 _testProcEnv）。
//
// `exe` 是 z42vm，或 apphost / launcher 这类最终起 z42vm 的程序；`libs` 是它要看见的 stdlib 世界。
Process _z42Proc(string exe, string libs) {
    // 刻意**不**全局注入 Z42_PLUGINS：开发树的编译器域混着多代包，携带插件一加载就会把进程
    // 搞成混合域（双代注册、类型拒用）。携带是分发态特性——SDK 世界由 Z42_HOME/plugins 命中；
    // 开发树里需要的用例（harness-lint-carry 夹具等）按步显式设 env。
    return new Process(exe).Env("Z42_LIBS", libs);
}

// z42b 及其 fork 的子 VM：另挂编译器成员 dist 的 probing（见 _compilerProbingPaths）。z42b 在进程内用的是
// 本树的编译器包；编译器目录由 `Z42_LIBS`（本树 flat）上溯落到本树 driver 的 dist（CompilerDomain 的开发树档）。
Process _z42bProc(string vm, string libs) {
    return _z42Proc(vm, libs).Env("Z42_PROBING_PATHS", _compilerProbingPaths(_root()));
}

// 跑一个 z42c driver：`vm <driverZpkg> --mode <m> --`，调用方接着追加 z42c 的参数（build … / --emit-zbc …）。
//
// 编译器目录（CompilerDomain）应是这个 driver **自己**的 dist（自包含：driver + 全部编译器成员）。本树 driver
// 不用设：`Z42_LIBS` 在开发树里 ⇒ CompilerDomain 先取开发树档，就是本树 driver 的 dist。住在
// `<sdk>/programs/z42c/` 的 driver（种子 / nightly / 打包中的 SDK）设 `Z42_HOME=<sdk>`：否则落到继承来的
// `Z42_PORTABLE_VM` 反推的那份 SDK（跑 xtask 的种子），不是 driver 自己那份。
Process _z42cProc(string vm, string libs, string driverZpkg) {
    return _z42cProcMode(vm, libs, driverZpkg, _z42cMode());
}

// 跑**上一代** driver（自举）：它运行期要加载**那一代**的库（`runLibs`），而它编译的源码要解析**当前源**
// 新建的库（`libs`）。z42vm 找依赖的顺序是 入口目录 → `Z42_PROBING_PATHS` → `Z42_LIBS` ⇒ 那一代的库挂
// probing（同名包运行期先取它），`Z42_LIBS` 只当编译期依赖面。`runLibs` 为空或与 `libs` 相同 ⇒ 同 _z42cProc。
Process _z42cProcSeed(string vm, string libs, string runLibs, string driverZpkg) {
    Process p = _z42cProc(vm, libs, driverZpkg);
    if (runLibs.Length > 0 && runLibs != libs) { p = p.Env("Z42_PROBING_PATHS", runLibs); }
    return p;
}

// 同 _z42cProc，指定 driver 自己的执行模式；mode == "" ⇒ 不传 `--mode`（用 z42vm 的缺省）。
Process _z42cProcMode(string vm, string libs, string driverZpkg, string mode) {
    Process p = _z42Proc(vm, libs);
    string driverDir = Path.GetDirectoryName(driverZpkg);
    string programs = Path.GetDirectoryName(driverDir);
    if (Path.GetFileName(driverDir) == "z42c" && Path.GetFileName(programs) == "programs") {
        p = p.Env("Z42_HOME", Path.GetDirectoryName(programs));
    }
    p = p.Arg(driverZpkg);
    if (mode.Length > 0) { p = p.Arg("--mode").Arg(mode); }
    return p.Arg("--");
}

// `_cleanGlob` / `_linkAll` 已移至 common/xtask_fs.z42（scripts-batch3-layering）。

// stdlib 成员携带的插件工程（今天只有 z42.harness.lint）：逐个 z42c build --release 到插件工程
// 自己的 dist（release 验证的判据位），并把产物平铺进 flat 同级 plugins/。放 flat 之外是刻意的：
// libs 是运行期解析域，插件进插件目录（unify-plugin-packages 的查找域分离）。
// 冷启动垫底用的种子 driver zpkg（_ensureSeed 拷进 flat）在编译器自建完成后就成了**旧代副本**：
// 留在 flat / stdlibRun 里，任何携带插件的加载链都可能把它拉进与新 driver 同进程（双代注册、类型按名
// 实例化被拒）。flat 本该是纯 stdlib 世界——编译器包住各自成员 dist。此处双清（flat + stdlibRun）。
void _purgeSeedDriverZpkg(string root) {
    string flat = _libsFlatDist(root, "release");
    string[] victims = new string[2];
    victims[0] = Path.Join(flat, "z42c.driver.zpkg");
    victims[1] = Path.Join(_compilerWsWork(root, "stdlib-run/release"), "z42c.driver.zpkg");
    int i = 0;
    while (i < victims.Length) {
        if (File.Exists(victims[i])) {
            File.Delete(victims[i]);
            _vNormal("  purged stale seed driver: " + victims[i]);
        }
        i = i + 1;
    }
}

// internalOnly = false：非 internal 条目（release 验产物语义，先于 workspace）；true：internal 授权
// 条目（--internal-of 宿主旗标，后于 workspace）。两张清单按宿主清单的 [plugins.export] 条目分流；
// 今天只有 z42.harness.lint 一条，写死映射（多宿主携带出现时改读清单）。
int _buildStdlibCarriedPlugins(string root, string vm, string driver, string runLibs, bool internalOnly) {
    if (!internalOnly) { _purgeSeedDriverZpkg(root); }
    string flatDir = _libsFlatDist(root, "release");
    string pluginsDir = Path.Join(Path.GetDirectoryName(flatDir), "plugins");
    Directory.Create(pluginsDir);
    // 分流：今天唯一的携带条目（z42.harness.lint）是 internal 授权 ⇒ 归 6.5 阶段，3.5 只做清种子
    // 与目录（上一轮平铺产物留在 plugins/ 作冷自举兜底）。非 internal 条目出现时在此构建。
    if (!internalOnly) { return 0; }
    // 不清空、覆盖式：上一轮的插件产物是冷自举（编译器重建早于本步）的携带解析兜底。
    string toml = Path.Join(root, "src/libraries/z42.harness/plugins/lint/z42.z42.toml");
    string host = "z42.harness";     // 宿主（internal 授权的 ParentPkg 目标）
    if (!File.Exists(toml)) { ConsoleError.WriteLine("  ✗ carried plugin manifest missing: " + toml); return 1; }
    string dist = Path.Join(Path.GetDirectoryName(toml), "dist");
    // --output-dir 显式指到插件工程 dist（与 BuildLayout 缺省一致；显式免受 cwd 影响）。
    // internalOnly ⇒ --internal-of 宿主（同包待遇，宿主 internal 可见——plugin-internal-access）。
    int rc = internalOnly
        ? _z42cBuildPackageInternal(vm, driver, toml, runLibs, dist, runLibs, host)
        : _z42cBuildPackage(vm, driver, toml, runLibs, dist, runLibs);
    if (rc != 0) { ConsoleError.WriteLine("  ✗ carried plugin build failed: " + toml); return 1; }
    string zpkg = Path.Join(dist, "z42.harness.lint.zpkg");
    if (!File.Exists(zpkg)) { ConsoleError.WriteLine("  ✗ carried plugin produced no zpkg: " + zpkg); return 1; }
    _copyOverwrite(zpkg, Path.Join(pluginsDir, "z42.harness.lint.zpkg"));
    return 0;
}

// _z42cBuildPackage 的 internal 授权形态：多传 --internal-of（宿主同包待遇）。
int _z42cBuildPackageInternal(string vm, string driver, string tomlPath, string libs, string outputDir,
                              string runLibs, string internalOf) {
    return _z42cProcSeed(vm, libs, runLibs, driver)
        .Arg("build").Arg(tomlPath).Arg("--release").Arg("--output-dir").Arg(outputDir)
        .Arg("--internal-of").Arg(internalOf)
        .Stdout(_verbAtLeast(3) ? Stdio.Inherit() : Stdio.Null()).Stderr(Stdio.Inherit())
        .Run().ExitCode;
}

// 覆盖拷贝（File.Copy 无 overwrite 参数形态）。目标在则先删。
void _copyOverwrite(string src, string dst) {
    if (File.Exists(dst)) { File.Delete(dst); }
    File.Copy(src, dst);
}
