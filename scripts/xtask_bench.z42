// xtask — e2e benchmarks (migrate-scripts-to-z42). Native port of
// the former scripts/bench-run.sh + scripts/_merge-bench-results.py. Compiles
// bench/scenarios/*.z42, runs hyperfine on z42vm per scenario, then merges the
// hyperfine JSONs into bench/results/e2e.json — parse with native Std.Json,
// output string-built (replacing python3). Same Z42Xtask namespace; calls
// _exec/_root/_buildRuntime/_utcNow in xtask.z42 / xtask_package.z42.
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Json;
using Std.Cli;

// `bench` (no subcommand) — e2e hyperfine scenario runner. The `stdlib`
// subcommand (per-lib [Benchmark]) routes via _dispatchBench → _testLib, and
// `--diff` routes via _benchE2e → _benchDiff (both in xtask_cli.z42). This
// handler is the bare-e2e path; args from a Std.Cli ParseResult.
int _bench(ParseResult r) {
    bool quick = r.GetFlag("quick");
    string warmup = quick ? "1" : "3";
    string runs = quick ? "3" : "10";
    string root = _root();
    string scenDir = Path.Join(root, "bench/scenarios");
    string resultsDir = Path.Join(root, "bench/results");
    Directory.Create(resultsDir);
    // Bench needs z42vm + stdlib (scenarios `using Std.IO.Console`, resolved at
    // `libs`) + the self-contained z42c driver (scenarios compile via z42c, not
    // `dotnet run`). _ensureToolchainDeps builds each only if missing — CI bench
    // bootstraps xtask alone (against nightly .z42/libs), so the source-built tree
    // may start empty. A dev who changed z42c runs `build compiler` themselves.
    int dep = _ensureToolchainDeps(root); if (dep != 0) { return dep; }
    string vm = _builtVm(root, "release");
    string libs = _libsDir(root);
    // alllibs flat (stdlib + z42c 7 siblings) is the single Z42_LIBS dir for the
    // compile — z42c.driver needs its own siblings resolvable at runtime.
    string driverZpkg = _driverZpkg(root);
    string flat = _assembleAllLibs(root, "release");
    string work = Directory.CreateTempDir("xtask-bench");

    // add-exec-profile-matrix: probe the measured VM's real capabilities once,
    // and expand --mode into the modes to sweep (each → one z42vm --mode run +
    // one profile-tagged result). Non-runnable cells (e.g. jit on an interp-only
    // VM) are skipped with a printed reason — never silently dropped.
    string modeOpt = r.GetOption("mode");
    string probeZbc = _epEnsureProbe(root, vm, driverZpkg, flat);
    VmCaps vmc = _epProbe(vm, libs, probeZbc);
    string[] modes = _epModesToSweep(modeOpt);

    string benchmarks = "";
    int nb = 0;
    int count = 0;
    // Sort before iterating: filesystem enumeration order is non-deterministic
    // across OSes, and both --quick's "first 2" selection and the benchmarks
    // array order depend on it (common-pitfalls §1).
    foreach (var f in _sortedStrings(Directory.Enumerate(scenDir))) {
        if (!f.EndsWith(".z42")) { continue; }
        if (quick && count >= 2) { break; }
        string name = f.Substring(0, f.Length - 4);
        string src = Path.Join(scenDir, f);
        string srcText = File.ReadAllText(src);
        string ns = _extractNamespace(srcText);
        if (ns.Length == 0) { ConsoleError.WriteLine("error: no namespace in " + f); return 2; }
        // add-bench-speedup-cap-gating: skip scenarios whose declared
        // `// requires-caps:` are not all present on the measured VM (e.g. a
        // threads scenario on a wasm/interp-only build) — explicit skip, no crash.
        string[] missing = _epCapsMissing(_epScenarioRequiredCaps(srcText), vmc.Caps);
        if (missing.Length > 0) {
            Console.WriteLine("  ⊘ skip " + name + ": missing cap(s) " + _epJsonStrArr(missing)
                + " (VM caps=" + _epJsonStrArr(vmc.Caps) + ")");
            count = count + 1;
            continue;
        }
        // Compile once — the .zbc is mode-agnostic; only the measured run differs.
        string zbc = Path.Join(work, name + ".zbc");
        int cc = _exec(new Process(vm).Arg(driverZpkg).Arg("--mode").Arg(_z42cMode()).Arg("--")
            .Arg("--emit-zbc").Arg(src).Arg(zbc).Env("Z42_LIBS", flat));
        if (cc != 0) { return cc; }
        for (int mi = 0; mi < modes.Length; mi = mi + 1) {
            string m = modes[mi];
            string[] tiers = _epTiersForMode(m);
            string status = _epCellStatus(tiers, new string[0], vmc.ExecModes);
            if (status != "runnable") {
                Console.WriteLine("  ⊘ skip " + name + " [" + m + "]: " + status
                    + " (VM exec_modes=" + _epJsonStrArr(vmc.ExecModes) + ")");
                continue;
            }
            string outJson = Path.Join(work, name + "-" + m + "-bench.json");
            Console.WriteLine("→ Benchmarking " + name + " [" + m
                + "] (warmup=" + warmup + ", runs=" + runs + ")...");
            int hc = _exec(new Process("hyperfine")
                .Arg("--warmup").Arg(warmup).Arg("--runs").Arg(runs)
                .Arg("--export-json").Arg(outJson).Arg("--shell=none")
                .Arg("--command-name").Arg(name + "-" + m)
                .Arg(vm + " " + zbc + " " + ns + ".Main --mode " + m).Env("Z42_LIBS", libs));
            if (hc != 0) { return hc; }
            if (nb > 0) { benchmarks = benchmarks + ",\n"; }
            benchmarks = benchmarks + _benchObj(outJson, name, runs, tiers, vmc);
            nb = nb + 1;
        }
        count = count + 1;
    }

    string commit = _gitOut(root, "rev-parse", "--short", "HEAD");
    string branch = _gitOut(root, "rev-parse", "--abbrev-ref", "HEAD");
    string doc = "{\n  \"schema_version\": 2,\n  \"commit\": \"" + commit
        + "\",\n  \"branch\": \"" + branch + "\",\n  \"z42vm_version\": \"" + _epVmVersion(vm)
        + "\",\n  \"timestamp\": \"" + _utcNow() + "\",\n  \"benchmarks\": [\n"
        + benchmarks + "\n  ]\n}\n";
    string outFile = Path.Join(resultsDir, "e2e.json");
    File.WriteAllText(outFile, doc);
    Console.WriteLine("✅ E2E bench complete (" + nb.ToString() + " results). Results: " + outFile);
    return 0;
}

// `bench --diff [--current P] [--baseline P] [--threshold-time T] [--threshold-memory M] [--quiet]`
// Native port of the former scripts/bench-diff.sh. Compares current bench results
// against a baseline (both conform to bench/baseline-schema.json): per-benchmark
// delta = (cur - base) / base; a time delta > --threshold-time (default 0.05) or
// a memory delta > --threshold-memory (default 0.10) is a regression. Exit codes:
// 0 = no regression, 1 = regression above threshold, 2 = tool error.
int _benchDiff(ParseResult r) {
    string root = _root();
    string current = r.GetOption("current");
    if (current.Length == 0) { current = "bench/results/e2e.json"; }
    string baseline = r.GetOption("baseline");
    double thrTime = 0.05;
    string tt = r.GetOption("threshold-time");
    if (tt.Length > 0) { thrTime = Double.Parse(tt); }
    double thrMem = 0.10;
    string tm = r.GetOption("threshold-memory");
    if (tm.Length > 0) { thrMem = Double.Parse(tm); }
    bool quiet = r.GetFlag("quiet");
    if (baseline.Length == 0) { baseline = "bench/baselines/main-" + _osTag() + ".json"; }
    string curPath  = _absUnder(root, current);
    string basePath = _absUnder(root, baseline);
    if (!File.Exists(curPath))  { ConsoleError.WriteLine("error: current results not found: " + current); return 2; }
    if (!File.Exists(basePath)) { ConsoleError.WriteLine("error: baseline not found: " + baseline); return 2; }

    JsonValue cur  = JsonValue.Parse(File.ReadAllText(curPath));
    JsonValue base_ = JsonValue.Parse(File.ReadAllText(basePath));
    JsonValue curBs  = cur.Get("benchmarks");
    JsonValue baseBs = base_.Get("benchmarks");

    if (!quiet) {
        Console.WriteLine("Comparing:");
        Console.WriteLine("  current:  " + cur.Get("commit").AsString() + "  (" + current + ")");
        Console.WriteLine("  baseline: " + base_.Get("commit").AsString() + "  (" + baseline + ")");
        Console.WriteLine("  thresholds: time>" + thrTime.ToString() + "=fail, memory>" + thrMem.ToString() + "=fail");
        Console.WriteLine("");
    }

    int regressions = 0;
    int total = 0;
    // current-driven diff (matches baseline by name+metric; (new) when absent).
    int j = 0;
    while (j < curBs.Count()) {
        JsonValue c = curBs.At(j);
        string name   = c.Get("name").AsString();
        string metric = c.Get("metric").AsString();
        double curV   = c.Get("value").AsDouble();
        string unit   = c.Get("unit").AsString();
        string mkey   = _epBenchModeKey(c);
        total = total + 1;
        string label = name + " [" + metric + " " + mkey + "]";
        double baseV = _findBenchValue(baseBs, name, metric, mkey);
        if (baseV < 0.0) {
            if (!quiet) { Console.WriteLine("  " + label + "  (new)  " + curV.ToString() + " " + unit); }
            j = j + 1; continue;
        }
        if (baseV == 0.0) {
            if (!quiet) { Console.WriteLine("  " + label + "  baseline=0 (skip)"); }
            j = j + 1; continue;
        }
        double delta = (curV - baseV) / baseV;
        bool isMem = (metric == "memory" || unit == "bytes" || unit == "KB" || unit == "MB");
        double thr = isMem ? thrMem : thrTime;
        string sym = "≈";
        if (delta > thr) { sym = "↑"; regressions = regressions + 1; }
        else if (delta < (0.0 - thr)) { sym = "↓"; }
        if (!quiet || delta > thr) {
            Console.WriteLine("  " + label + "  " + baseV.ToString() + " " + unit
                + " → " + curV.ToString() + " " + unit + "  " + sym + " " + (delta * 100.0).ToString() + "%");
        }
        j = j + 1;
    }
    // baseline-only (removed) annotations — informational, never a regression.
    if (!quiet) {
        int k = 0;
        while (k < baseBs.Count()) {
            JsonValue b = baseBs.At(k);
            string name   = b.Get("name").AsString();
            string metric = b.Get("metric").AsString();
            string mkey   = _epBenchModeKey(b);
            if (_findBenchValue(curBs, name, metric, mkey) < 0.0) {
                Console.WriteLine("  " + name + " [" + metric + " " + mkey + "]  (removed)  "
                    + b.Get("value").AsDouble().ToString() + " " + b.Get("unit").AsString());
            }
            k = k + 1;
        }
    }

    // add-bench-speedup-cap-gating: derive interp/jit speedup where both were measured.
    _printSpeedups(curBs);

    Console.WriteLine("");
    if (regressions > 0) {
        Console.WriteLine("❌ " + regressions.ToString() + " regression(s) above threshold (out of " + total.ToString() + " benchmarks)");
        return 1;
    }
    Console.WriteLine("✅ no regression above threshold (" + total.ToString() + " benchmarks compared)");
    return 0;
}

// value of the benchmark matching name+metric+mode-key, or -1.0 if absent.
// add-exec-profile-matrix: mkey ("<mode_label>@<os>/<arch>") keeps interp-vs-jit
// and cross-platform results from ever comparing against each other.
double _findBenchValue(JsonValue benchmarks, string name, string metric, string mkey) {
    int i = 0;
    while (i < benchmarks.Count()) {
        JsonValue b = benchmarks.At(i);
        if (b.Get("name").AsString() == name && b.Get("metric").AsString() == metric
            && _epBenchModeKey(b) == mkey) {
            return b.Get("value").AsDouble();
        }
        i = i + 1;
    }
    return -1.0;
}

// add-bench-speedup-cap-gating: for each (name, metric, platform) measured under
// BOTH interp and jit, print the interp/jit speedup (>1 = jit faster). Iterates
// the jit-labelled entries and looks up the matching interp entry. Informational
// only — not a schema field, never a regression signal.
void _printSpeedups(JsonValue benchmarks) {
    bool header = false;
    int i = 0;
    while (i < benchmarks.Count()) {
        JsonValue b = benchmarks.At(i);
        if (b.ContainsKey("profile")) {
            JsonValue p = b.Get("profile");
            if (p.Get("mode_label").AsString() == "jit") {
                string name    = b.Get("name").AsString();
                string metric  = b.Get("metric").AsString();
                JsonValue plat = p.Get("platform");
                string suffix  = "@" + plat.Get("os").AsString() + "/" + plat.Get("arch").AsString();
                double jitV    = b.Get("value").AsDouble();
                double interpV = _findBenchValue(benchmarks, name, metric, "interp" + suffix);
                if (interpV > 0.0 && jitV > 0.0) {
                    if (!header) {
                        Console.WriteLine("");
                        Console.WriteLine("Speedup (interp/jit, >1 = jit faster):");
                        header = true;
                    }
                    double ratio = interpV / jitV;
                    Console.WriteLine("  " + name + " [" + metric + suffix + "]  " + ratio.ToString() + "x");
                }
            }
        }
        i = i + 1;
    }
}

// resolve a possibly-relative path under the repo root (absolute paths unchanged).
string _absUnder(string root, string p) {
    if (p.StartsWith("/")) { return p; }
    return Path.Join(root, p);
}

// one benchmark object from a hyperfine export JSON (time values are seconds → ms).
// add-exec-profile-matrix: carries the schema-v2 `profile` (mode composition +
// platform + probed caps) so interp/jit results never compare against each other.
string _benchObj(string hjson, string name, string runs, string[] tiers, VmCaps vm) {
    JsonValue r0 = JsonValue.Parse(File.ReadAllText(hjson)).Get("results").At(0);
    string val = (r0.Get("mean").AsDouble() * 1000.0).ToString();
    string lo  = (r0.Get("min").AsDouble()  * 1000.0).ToString();
    string hi  = (r0.Get("max").AsDouble()  * 1000.0).ToString();
    return "    {\n      \"name\": \"" + name + "\",\n      \"tier\": \"z42-e2e\""
        + ",\n      \"metric\": \"time\",\n      \"value\": " + val
        + ",\n      \"unit\": \"ms\",\n      \"ci_lower\": " + lo
        + ",\n      \"ci_upper\": " + hi + ",\n      \"samples\": " + runs
        + ",\n      \"profile\": " + _epProfileJson(tiers, new string[0], vm) + "\n    }";
}

string _gitOut(string root, string a, string b, string c) {
    ProcessResult r = new Process("git").Arg(a).Arg(b).Arg(c).WorkingDirectory(root).Run();
    if (r.ExitCode == 0) { return r.Stdout.Trim(); }
    return "unknown";
}

string _osTag() {
    ProcessResult r = new Process("uname").Arg("-sm").Run();
    if (r.ExitCode != 0) { return "unknown"; }
    return r.Stdout.Trim().ToLower().Replace(" ", "-");
}

// add-stdlib-bench-baseline: aggregate per-module z42b `--format json` bench_stats
// into one schema-v1 baseline doc. median_ns is the primary metric (value); min/max
// map to ci_lower/ci_upper. One instance is reused across all libs/modules by
// `bench stdlib --json` (null when not capturing → pretty passthrough untouched).
class MicroBenchAgg {
    string _items;   // comma+newline-joined schema-v2 benchmark objects
    int    _n;
    // add-exec-profile-matrix: the profile every micro result is tagged with.
    // Probed once (setProfileOnce) from the VM the z42b runner executes under, so
    // interp vs jit micro baselines never compare against each other. Defaults to
    // an interp/empty profile until set.
    string[] _tiers;
    VmCaps   _vm;
    string   _vmVersion;
    bool     _profSet;
    MicroBenchAgg() {
        this._items = ""; this._n = 0;
        this._tiers = new string[1]; this._tiers[0] = "interp";
        this._vm = new VmCaps(); this._vmVersion = ""; this._profSet = false;
    }
    internal int count() { return this._n; }

    // Record the execution profile (idempotent — first call wins). tiers comes
    // from the micro `--mode`; vm/vmVersion from probing the runner's VM binary.
    internal void setProfileOnce(string[] tiers, VmCaps vm, string vmVersion) {
        if (this._profSet) { return; }
        this._tiers = tiers; this._vm = vm; this._vmVersion = vmVersion;
        this._profSet = true;
    }

    // Parse one z42b `--format json` module output; append each benchmark's stats.
    // Non-benchmark entries (smoke [Test]) and failed benches (no bench_stats) skip.
    internal void addModuleJson(string moduleJson, string lib) {
        JsonValue root = JsonValue.Parse(moduleJson.Trim());
        if (!root.ContainsKey("results")) { return; }
        JsonValue results = root.Get("results");
        int i = 0;
        while (i < results.Count()) {
            JsonValue res = results.At(i);
            if (res.ContainsKey("is_benchmark") && res.Get("is_benchmark").AsBool()
                && res.ContainsKey("bench_stats")) {
                JsonValue bs = res.Get("bench_stats");
                string name = lib + "." + bs.Get("label").AsString();
                long med = bs.Get("median_ns").AsLong();
                long lo  = bs.Get("min_ns").AsLong();
                long hi  = bs.Get("max_ns").AsLong();
                long smp = bs.Get("samples").AsLong();
                if (this._n > 0) { this._items = this._items + ",\n"; }
                this._items = this._items
                    + "    {\n      \"name\": \"" + name + "\",\n"
                    + "      \"tier\": \"z42-micro\",\n      \"metric\": \"time\",\n"
                    + "      \"value\": " + med.ToString() + ",\n      \"unit\": \"ns\",\n"
                    + "      \"ci_lower\": " + lo.ToString() + ",\n      \"ci_upper\": " + hi.ToString() + ",\n"
                    + "      \"samples\": " + smp.ToString() + ",\n"
                    + "      \"profile\": " + _epProfileJson(this._tiers, new string[0], this._vm) + "\n    }";
                this._n = this._n + 1;
            }
            i = i + 1;
        }
    }

    // Wrap accumulated items in the schema-v2 envelope (reuses _gitOut/_utcNow).
    internal string toSchemaV2(string root) {
        string commit = _gitOut(root, "rev-parse", "--short", "HEAD");
        string branch = _gitOut(root, "rev-parse", "--abbrev-ref", "HEAD");
        return "{\n  \"schema_version\": 2,\n  \"commit\": \"" + commit
            + "\",\n  \"branch\": \"" + branch + "\",\n  \"z42vm_version\": \"" + this._vmVersion
            + "\",\n  \"timestamp\": \"" + _utcNow() + "\",\n  \"benchmarks\": [\n"
            + this._items + "\n  ]\n}\n";
    }
}
