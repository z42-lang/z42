// xtask — the z42 repo's unified dev CLI (add-xtask-cli, 2026-06-04).
//
// Run the native apphost at the repo root:  xtask <command> [args]
// (equivalent, still supported: `z42 xtask.zpkg <command> [args]` via the launcher;
//  cold start with no z42 on PATH: `Z42_PORTABLE_VM=$vm Z42_LIBS=$libs $vm
//  artifacts/xtask/xtask.zpkg -- <command>` — the form CI uses.)
//
// 顶层命令面（**权威来源是 `xtask -h`，由 Std.Cli 命令树自动生成**——本注释是导航用的
// 概览，不是清单；具体 flag/positional 一律看各层 `-h`，别在这里复列以免又漂）：
//
//   build   runtime | compiler | stdlib | sdk | stage-toolchain | workload | toolchain | test | all
//   test    (empty=all) | e2e | stdlib | targets | runtime | list | embedded | dist
//           | compiler | packages | bootstrap | vscode-syntax | incremental | lines
//           | changed | platform <p>
//   package sdk | runtime | workload | index
//   deps    check | install | env
//   bench   (empty=e2e) | stdlib | targets
//   run / profile / example / clean / feature-matrix
//
// 命令树、每个叶子的 flag/positional、逐层 `-h`、未知命令报错都在 xtask_cli.z42
// （`_runCli` + 各 `_xRouter()` / `_dispatchX`）——Main 只做 argv 取用与转发。
// 各命令的 handler 分散在 build/ test/ package/ install/ 子目录，映射见
// `scripts/README.md` 的源码结构表。
//
// 本文件只剩**入口**：`Main`（校验 VM → 转 _runCli）与 `run` 直通。任何 build /
// test / deps 的 handler 都不在这里——它们归各自的族目录
// （relocate-xtask-handlers, 2026-09-05：此前 _buildRuntime / _buildStdlib /
// _regenCore / _testChanged / _depsCheck / _clean / _featureMatrix 错落在此，
// 与「Main 只做转发」的自述矛盾）。`run` 留下是因为它是 _runCli 在 Resolve 之前
// 就拦截的裸直通，属于入口层而非某个命令族。
namespace Z42Xtask;

using Std;
using Std.IO;

void Main() {
    string[] argv = Environment.GetCommandLineArgs();
    _ensureDriverVm();
    Environment.Exit(_runCli(argv));
}

// ── run (thin passthrough to the launcher) ──────────────────────────────────

// Forwards `<app.zpkg|script.z42> [-- args]` verbatim to `z42 run`. Raw
// passthrough (intercepted in _runCli before Resolve) — the launcher itself
// handles the `--` app-args tail. Native spawn (each argv element a separate
// Arg → no shell re-splitting, so app args with spaces survive); _exec runs it
// at the repo root with inherited stdio.
int _run(string[] argv) {
    Process p = new Process("z42").Arg("run");
    int i = 1;
    while (i < argv.Length) { p = p.Arg(argv[i]); i = i + 1; }
    // spawn-failure (z42 not on PATH) throws — surface it gracefully (bash used to
    // return 127 here), rather than crashing with an uncaught exception.
    try {
        return _exec(p);
    } catch (Exception e) {
        ConsoleError.WriteLine("error: could not launch `z42 run` — is the z42 launcher on PATH? ("
            + e.Message + ")");
        return 127;
    }
}

// ── helpers ─────────────────────────────────────────────────────────────────
// The shared process / path / exec infrastructure (_root / _exec / _execIn /
// _ensureDriverVm / _z42vm / _builtVm / _libsDir) + the artifact/source paths +
// the cargo/driver bin-invocation builders all live in xtask_common.z42.
// The command tree + per-level help live in xtask_cli.z42 (Std.Cli router;
// help is generated by ArgParser/SubcommandRouter, no hand-written _help()).
