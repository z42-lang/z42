// xtask — the z42 repo's unified dev CLI (add-xtask-cli, 2026-06-04).
//
// Run the native apphost at the repo root:  xtask <command> [args]
// (equivalent, still supported: `z42 xtask.zpkg <command> [args]` via the launcher;
//  cold start with no z42 on PATH: `Z42_PORTABLE_VM=$vm Z42_LIBS=$libs $vm
//  artifacts/xtask/xtask.zpkg -- <command>` — the form CI uses.)
//
// 命令树由 Std.Cli 的声明式 `Command` 搭起：本文件只有根命令（全局选项 + 挂各命令族）与
// `run` 直通；每个命令族的 `Command` 类与它的 handler 同住领域目录（build/ package/ test/
// install/ bench/ common/），权威命令面是 `xtask -h`（逐层 `-h` 自动生成）。
namespace Z42Xtask;

using Std.IO;
using Std.Cli;

void Main() {
    _ensureDriverVm();
    Environment.Exit(new XtaskCommand().Invoke(Environment.GetCommandLineArgs()));
}

// 根命令：全局选项落成环境变量（子进程随之继承）+ 挂全部命令族。
class XtaskCommand : Command {
    [Option(help: "use a .z42 SDK layout (programs/z42c + libs + bin)", global: true)]
    public string Toolchain = "";
    [Option(help: "q[uiet] | m[inimal] (default) | n[ormal] | d[etailed] | diag[nostic]", shortName: "v", global: true)]
    public string Verbosity = "";

    public XtaskCommand() : base("xtask", "z42 repo dev CLI") {
        this.AddCommand(new BuildCommand());
        this.AddCommand(new PackageCommand());
        this.AddCommand(new TestCommand());
        this.AddCommand(new CheckCommand());
        this.AddCommand(new SetupCommand());
        this.AddCommand(new BenchCommand());
        this.AddCommand(new DocCommand());
        this.AddCommand(new ProfileCommand());
        this.AddCommand(new LayoutCommand());
        this.AddCommand(new CleanCommand());
        this.AddCommand(new RunCommand());
    }

    // --toolchain → Z42_HOME（单一「SDK 根」，各定位器都由它重定向到那份 `.z42`）；
    // --verbosity → Z42_VERBOSITY（_verbosity 读取）。
    public override void BeforeRun() {
        if (this.Toolchain.Length > 0) { Environment.SetEnvironmentVariable("Z42_HOME", this.Toolchain); }
        if (this.Verbosity.Length == 0) { return; }
        int lvl = _normVerbosity(this.Verbosity);
        if (lvl < 0) {
            throw new CliException("invalid --verbosity '" + this.Verbosity
                + "' (use q[uiet] | m[inimal] | n[ormal] | d[etailed] | diag[nostic])");
        }
        Environment.SetEnvironmentVariable("Z42_VERBOSITY", _verbName(lvl));
    }
}

// `run`：`run` 之后的参数（含 launcher 自己的选项与 `--` 尾巴）原样转给 PATH 上的 `z42 run`。
class RunCommand : Command {
    [Argument(help: "<app.zpkg|script.z42> [-- args], forwarded verbatim to `z42 run`", passthrough: true)]
    public string[] Args = new string[0];

    public RunCommand() : base("run", "run a zpkg / .z42 via the launcher") {}

    // Native spawn（每个参数单独 Arg → 不经 shell 重新分词，带空格的参数原样到达）；
    // 找不到 launcher 时报错退出，而不是抛未捕获异常。
    public override int Run() {
        Process p = new Process("z42").Arg("run").Args(this.Args);
        try {
            return _exec(p);
        } catch (Exception e) {
            ConsoleError.WriteLine("error: could not launch `z42 run` — is the z42 launcher on PATH? ("
                + e.Message + ")");
            return 127;
        }
    }
}
