// 发行包 golden：包内编译器编译一次，包内 VM 分模式执行，输出与退出码共同判定。
namespace Z42Xtask;

using Std.Collections;
using Std.IO;

// Golden legs: compile every dist case ONCE with the packaged z42c, then run the
// zbc under each mode with the packaged z42vm and diff stdout. Returns [pass, fail]
// where fail folds in compile errors (as the caller aggregates).
//
//   ① zbc 与 mode 无关 ⇒ 只编译一遍（jit 的用例集 = interp 的去掉 interpOnly，同一份源）；
//   ② 编译与运行都按批并行（同 golden regen / e2e goldens 的批模式，批内按原序判定打印，
//      输出确定）。
int[] _runDistGoldens(string[] modes, string root, string z42c, string z42vm, string libsDir, string work) {
    _selfcheckDistGoldens(root, z42c, z42vm, libsDir, modes);
    bool wantInterp = false;
    foreach (var m in modes) { if (m != "jit") { wantInterp = true; } }
    _DistCase[] cases = _enumerateDistCases(root);
    // ① compile once. zbc 名带序号：不同目录下可能有同名 case，并行编译时不能共用输出路径。
    string[] zbcs = new string[cases.Length];
    for (int i = 0; i < cases.Length; i = i + 1) {
        zbcs[i] = Path.Join(work, i.ToString() + "-" + cases[i].name + ".zbc");
    }
    bool[] compiled = _distCompileAll(cases, zbcs, wantInterp, z42c, libsDir);
    // ② run per mode.
    int pass = 0;
    int fail = 0;
    foreach (var mode in modes) {
        int[] r = _distRunMode(mode, cases, zbcs, compiled, z42vm, libsDir);
        pass = pass + r[0];
        fail = fail + r[1];
    }
    return new int[]{ pass, fail };
}

// 按批并行编译每个 case 到 zbcs[i]（jit-only 运行时跳过 interpOnly 的 case）；返回各 case 是否编译成功。
bool[] _distCompileAll(_DistCase[] cases, string[] zbcs, bool wantInterp, string z42c, string libsDir) {
    int n = cases.Length;
    bool[] compiled = new bool[n];
    int cjobs = _regenJobs();
    for (int i = 0; i < n; i = i + cjobs) {
        int bsz = i + cjobs > n ? n - i : cjobs;
        ProcessHandle[] hs = new ProcessHandle[bsz];
        bool[] live = new bool[bsz];
        for (int b = 0; b < bsz; b = b + 1) {
            _DistCase c = cases[i + b];
            if (!wantInterp && c.interpOnly) { continue; }
            try {
                Process cp = _z42Proc(z42c, libsDir).Arg("--emit-zbc").Arg(c.source).Arg(zbcs[i + b]);
                if (c.optAll) { cp = cp.Arg("--opt-all"); }   // opt_all sidecar，见 _compileCaseSpawn
                hs[b] = cp.Stdout(Stdio.Null()).Stderr(Stdio.Null()).Spawn();
                live[b] = true;
            } catch (Exception e) { ConsoleError.WriteLine("  (compile spawn error: " + e.Message + ")"); }
        }
        for (int b = 0; b < bsz; b = b + 1) { compiled[i + b] = live[b] && hs[b].Wait().ExitCode == 0; }
    }
    return compiled;
}

// 一个 mode 的运行腿：按批并行跑选中的 case，批内按原序判定打印。返回 [pass, fail（含编译失败）]。
int[] _distRunMode(string mode, _DistCase[] cases, string[] zbcs, bool[] compiled, string z42vm, string libsDir) {
    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Mode: " + mode);
    Console.WriteLine("══════════════════════════════════════");
    List<int> sel = new List<int>();
    for (int i = 0; i < cases.Length; i = i + 1) {
        if (!(mode == "jit" && cases[i].interpOnly)) { sel.Add(i); }
    }
    int mpass = 0;
    int mfail = 0;
    int compileFail = 0;
    int rjobs = _distRunJobs();
    for (int k = 0; k < sel.Count; k = k + rjobs) {
        int bsz = k + rjobs > sel.Count ? sel.Count - k : rjobs;
        ProcessHandle[] hs = new ProcessHandle[bsz];
        bool[] live = new bool[bsz];
        string[] actual = new string[bsz];
        int[] exits = new int[bsz];
        for (int b = 0; b < bsz; b = b + 1) {
            int ci = sel[k + b];
            actual[b] = "";
            exits[b] = -1;
            if (!compiled[ci]) { continue; }
            // entry passed explicitly — z42vm requires it.
            try {
                hs[b] = _z42Proc(z42vm, libsDir).Arg(zbcs[ci]).Arg(cases[ci].entryName).Arg("--mode").Arg(mode)
                    .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe())
                    .Spawn();
                live[b] = true;
            } catch (Exception e) { actual[b] = "<spawn error: " + e.Message + ">"; }
        }
        for (int b = 0; b < bsz; b = b + 1) {
            _DistCase c = cases[sel[k + b]];
            if (!compiled[sel[k + b]]) {
                compileFail = compileFail + 1;
                Console.WriteLine("  FAIL: " + c.name + " (compile failed)");
                continue;
            }
            if (live[b]) {
                try {
                    ProcessResult r = hs[b].Wait();
                    exits[b] = r.ExitCode;
                    actual[b] = _stripTrailingNewlines(r.Stdout + r.Stderr);
                } catch (Exception e) { actual[b] = "<wait error: " + e.Message + ">"; }
            }
            string expected = File.Exists(c.expected) ? _stripTrailingNewlines(File.ReadAllText(c.expected)) : "";
            if (exits[b] == 0 && actual[b] == expected) {
                mpass = mpass + 1;
            } else {
                mfail = mfail + 1;
                Console.WriteLine("  FAIL: " + c.name + " (exit " + exits[b].ToString() + ")");
                Console.WriteLine("    expected: " + _firstLine(expected));
                Console.WriteLine("    actual:   " + _firstLine(actual[b]));
            }
        }
    }
    Console.WriteLine("");
    Console.WriteLine("  Result: " + mpass.ToString() + " passed, " + mfail.ToString()
        + " failed, " + compileFail.ToString() + " compile errors");
    Console.WriteLine("");
    return new int[]{ mpass, mfail + compileFail };
}

// 运行阶段并发度：min(CpuCount, 8)。与编译不同，运行是真吃 CPU 的 VM 进程（含 GC / 线程类
// golden），不超核数；GitHub 4 核 runner 上 = 4，与 test-host 的 e2e goldens（jobs=4）同一量级。
// `Z42_DIST_JOBS` 逃生舱：不改代码在 CI 上试别的值（1 = 退回串行）。
int _distRunJobs() {
    string ov = Environment.GetEnvironmentVariable("Z42_DIST_JOBS", "");
    if (ov.Length > 0) {
        try { int v = int.Parse(ov); if (v > 0) { return v; } } catch (Exception e) { }
    }
    int cpu = OperatingSystem.CpuCount();
    if (cpu < 1) { return 1; }
    return cpu < 8 ? cpu : 8;
}

// ── Case shape + enumeration ───────────────────────────────────────────────
// _DistCase is dist-specific: it names the `.z42` SOURCE to compile with the
// packaged z42c, where the VM runner's _Case (xtask_test_vm.z42, same namespace)
// names a prebuilt `.zbc`. Both are mapped from the ONE shared corpus walk
// (_walkGoldenCorpus, common/xtask_golden.z42) — only the selection policy and
// the record shape stay local.

class _DistCase {
    public string name;
    public string source;     // source.z42 path
    public string expected;   // expected_output.txt path
    public string entryName;  // <ns>.Main / Main / <ns>.main / main (z42vm needs it)
    public bool interpOnly;   // jit 模式跳过（同 _GoldenEntry.interpOnly）
    public bool optAll;       // 按 release 全优化编（同 _GoldenEntry.optAll）
    public _DistCase(string name, string source, string expected, string entryName, bool interpOnly, bool optAll) {
        this.name = name; this.source = source; this.expected = expected; this.entryName = entryName;
        this.interpOnly = interpOnly; this.optAll = optAll;
    }
}

// True if source.z42 declares a unit test (a line starts with `[Test]` /
// `[Benchmark]`) → owned by `xtask test stdlib` (z42b reflection runner), not
// golden-runnable here.
bool _isTestRunnerSource(string src) {
    foreach (var line in File.ReadAllText(src).Split("\n")) {
        string ln = line.Trim();
        if (ln.StartsWith("[Test]") || ln.StartsWith("[Test(")
            || ln.StartsWith("[Benchmark]") || ln.StartsWith("[Benchmark(")) {
            return true;
        }
    }
    return false;
}

// Golden selection over the shared walk (_walkGoldenCorpus, common/xtask_golden.z42).
// Unlike the VM runner, dist compiles the `.z42` SOURCE with the PACKAGED z42c, so
// selection keys off source presence, not the artifacts mirror.
// 返回全部 mode 的并集；interpOnly 由调用方按 mode 过滤（编译只做一遍）。
_DistCase[] _enumerateDistCases(string root) {
    List<_DistCase> cases = new List<_DistCase>();
    foreach (var e in _walkGoldenCorpus(root)) {
        if (e.seg == "lib-file") { continue; }   // stdlib [Test] file units — z42b's, not golden
        if (!e.hasSource) { continue; }
        // Skip [Test]/[Benchmark]-based lib test dirs — owned by `xtask test stdlib`
        // (z42b), not golden-runnable (no Main; may be multi-file like secp256k1's
        // source.z42 + vectors.z42).
        if (e.isLib && _isTestRunnerSource(e.src)) { continue; }
        cases.Add(new _DistCase(e.name, e.src, e.expected, _deriveEntry(e.src), e.interpOnly, e.optAll));
    }
    return cases.ToArray();
}

