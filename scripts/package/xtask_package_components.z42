// Desktop runtime component build and installation, shared by SDK and runtime packages.
namespace Z42Xtask;
using Std.IO;
using Std.Cli;

string _componentBuildDir(string root) { return Path.Join(_buildMirror(root, Path.Join(root, "src/runtime")), "components"); }
string _componentCargoOut(string root, string profile) { return Path.Join(_componentBuildDir(root), profile); }
string _componentFeatures() { return "cli,interp,jit,shared-core,native-interop,net,tls"; }
string _componentLibrary(string stem, string rid = "") {
    if (rid.Length > 0) {
        if (rid.StartsWith("windows-")) { return stem + ".dll"; }
        return "lib" + stem + ((rid.StartsWith("macos-") || rid.StartsWith("ios")) ? ".dylib" : ".so");
    }
    if (Platform.IsWindows()) { return stem + ".dll"; }
    return "lib" + stem + (Platform.IsMacOS() ? ".dylib" : ".so");
}
Process _componentCargo(string verb, string root, string profile, string targetDir = "") {
    if (targetDir.Length == 0) { targetDir = _componentBuildDir(root); }
    string flags = Environment.GetEnvironmentVariable("RUSTFLAGS", "") + " -C prefer-dynamic -C rpath";
    if (Platform.IsMacOS()) { flags = flags + " -C link-arg=-Wl,-rpath,@loader_path"; }
    else if (Platform.IsLinux()) { flags = flags + " -C link-arg=-Wl,-rpath,$ORIGIN -C link-arg=-Wl,-rpath,$ORIGIN/../native"; }
    Process p = _cargoCmd(verb, _runtimeCargoConfig()).WorkingDirectory(root).Arg("--locked")
        .Arg("--manifest-path").Arg(_runtimeManifest())
        .Arg("--target-dir").Arg(targetDir)
        .EnvRemove("CARGO_ENCODED_RUSTFLAGS").Env("RUSTFLAGS", flags)
        .Env("CARGO_PROFILE_RELEASE_LTO", "false");
    if (profile == "release") { p = p.Arg("--release"); }
    return p;
}
Process _componentTargets(Process build) {
    return build
        .Arg("-p").Arg("z42")
        .Arg("-p").Arg("z42-interp").Arg("-p").Arg("z42-jit")
        .Arg("--no-default-features").Arg("--features")
        .Arg("z42/" + _componentFeatures().Replace(",", ",z42/")
            + ",z42-interp/shared-core,z42-interp/native-interop,z42-jit/shared-core");
}

int _componentBuild(string root, string profile) {
    // One graph unifies the shared core's features for both dynamic backends and host.
    Process build = _componentTargets(_componentCargo("build", root, profile))
        .Arg("--all-targets").Arg("--message-format=json-render-diagnostics");
    // Development targets and every library are in one graph, so transitive
    // dependency features cannot produce a second, incompatible core image.
    ProcessResult result = build.Stderr(Stdio.Inherit()).Run();
    if (result.ExitCode != 0) { return result.ExitCode; }
    File.WriteAllText(Path.Join(_componentCargoOut(root, profile), "component-test-executable.txt"),
        _componentArtifactExecutable(result.Stdout));
    return _componentBuildCompression(root, _detectHostRid(), profile, true);
}

void _componentCopyRequired(string source, string destination) {
    if (!File.Exists(source)) { throw new CliException("dynamic runtime artifact is missing: " + source); }
    File.Copy(source, destination);
}
int _packageDynamicRuntime(string rid, string profile, bool noBuild, bool verify) {
    string root = _root();
    string host = _detectHostRid();
    if (rid.Length == 0) { rid = host; }
    if (rid != host || _ridCategory(rid) != "desktop") {
        throw new CliException("dynamic runtime components require a native desktop build on the target RID");
    }
    if (!noBuild) { int seed = _buildStdlib(); if (seed != 0) { return seed; } }
    int c = _componentBuild(root, profile); if (c != 0) { return c; }
    string version = _versionsGet(root);
    string name = "z42-runtime-" + version + "-" + rid + "-dynamic" + (profile == "release" ? "" : "-" + profile);
    string pkg = Path.Join(_packagesDir(root), name);
    _resetDir(pkg);
    string native = Path.Join(pkg, "native");
    Directory.Create(native);
    string cargo = _componentCargoOut(root, profile);
    _componentInstallLibraries(cargo, pkg);
    _copyAbiHeaders(root, Path.Join(native, "include"));
    c = _pkgCopyLibs(_libsDir(root), pkg); if (c != 0) { return c; }
    c = _componentRelocate(native); if (c != 0) { return c; }
    File.WriteAllText(Path.Join(pkg, "manifest.toml"),
        "[package]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nrid = \"" + rid
        + "\"\nprofile = \"" + profile + "\"\nlinkage = \"dynamic\"\nallocator = \"system\"\n"
        + "[components]\nhost = \"" + _componentLibrary("z42") + "\"\ninterp = \"" + _componentLibrary("z42_interp")
        + "\"\njit = \"" + _componentLibrary("z42_jit") + "\"\n");
    c = _pkgFinish(root, pkg, "runtime-dynamic", rid); if (c != 0) { return c; }
    if (verify) { return _componentVerify(root, pkg, profile); }
    return 0;
}

void _componentInstallLibraries(string cargo, string pkg) {
    string native = Path.Join(pkg, "native");
    Directory.Create(native);
    foreach (var stem in new string[]{ "z42", "z42_interp", "z42_jit", "z42_compression" }) {
        string file = _componentLibrary(stem);
        _componentCopyRequired(Path.Join(cargo, file), Path.Join(native, file));
    }
    if (Platform.IsWindows()) { _componentCopyRequired(Path.Join(cargo, "z42.dll.lib"), Path.Join(native, "z42.dll.lib")); }
    _componentCopyStd(native);

}

void _componentCopyStd(string native, string target = "") {
    string[] args = target.Length == 0 ? new string[]{ "--print", "target-libdir" } : new string[]{ "--print", "target-libdir", "--target", target };
    string stdDir = _cmdOut("rustc", args);
    bool windows = target.Length == 0 ? Platform.IsWindows() : target.Contains("windows");
    bool apple = target.Length == 0 ? Platform.IsMacOS() : target.Contains("apple");
    string suffix = windows ? ".dll" : (apple ? ".dylib" : ".so");
    string pattern = (windows ? "std-*" : "libstd-*") + suffix;
    string[] std = Path.Glob(stdDir, pattern);
    if (std.Length != 1) { throw new CliException("expected one matching shared Rust std in " + stdDir); }
    File.Copy(std[0], Path.Join(native, Path.GetFileName(std[0])));
}

int _componentBuildStatic(string root, string profile) {
    return _componentBuildStaticLibraries(root, _detectHostRid(), profile);
}

string _componentStaticArchive(string cargo) {
    string name = Platform.IsWindows() ? "z42.lib" : "libz42.a";
    return Path.Join(Path.GetDirectoryName(cargo), "static/" + Path.GetFileName(cargo) + "/examples/" + name);
}
