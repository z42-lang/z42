// xtask — desktop packaging pipeline (split-runtime-launcher-packages, 2026-06-13).
// Extracted from xtask_package.z42 to stay within the 500-line file limit.
//
// Functions owned here:
//   _packageDesktop                — full SDK package ([1/5]–[5/5] pipeline)
//   _pkgStageToolchainComponents   — [2c/5]: build + `z42b publish` SDK components
//   _buildRuntimePackage           — runtime artifact (layout = runtimes/<ver>/: z42vm+libs)
//   desktop manifest/example/helper functions
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Time;

// ── desktop SDK pipeline ────────────────────────────────────────────────────

int _packageDesktop(string root, string pkgDir, string rid, string version, string profile, string hostRid, bool noBuild) {
    Stopwatch sw = _procStart("package desktop");
    string cargoTarget = _cargoTargetFor(rid);   // "" for host → reuse warm build dir
    bool rel = (profile == "release");

    // [1/5] z42c self-host compiler seed (7 zpkg) → programs/z42c/. The shipped
    // compiler runs on z42vm; the 7 z42c.* seed zpkgs are colocated so the VM
    // resolves the driver's 6 siblings next to the payload (stdlib via libs/). The
    // `bin/z42c` entry is the apphost trampoline produced in [2c].
    // _buildCompiler builds host z42vm + stdlib + z42c seed (self-seeded). --no-build
    // SKIPS that rebuild and reuses what the CI bootstrap already produced (warm) —
    // it only verifies the z42c seed is present, then the steps below assemble it.
    Console.WriteLine("[1/5] z42c seed");
    int c = 0;
    if (!noBuild) {
        c = _buildCompiler(); if (c != 0) { return c; }
    } else {
        string drv = _driverZpkg(root);
        if (!File.Exists(drv) || File.GetSize(drv) <= 0L) {
            ConsoleError.WriteLine("error: --no-build but no z42c seed at " + drv + " (bootstrap first)");
            return 1;
        }
    }
    string z42cDir = Path.Join(pkgDir, "programs/z42c");
    Directory.Create(z42cDir);
    string[] z42cSeedMembers = _compilerMembers(root);
    int zsi = 0;
    while (zsi < z42cSeedMembers.Length) {
        string zsp = Path.Join(root, "artifacts/build/compiler/" + z42cSeedMembers[zsi] + "/release/dist/" + z42cSeedMembers[zsi] + ".zpkg");
        _copyIfExists(zsp, Path.Join(z42cDir, z42cSeedMembers[zsi] + ".zpkg"));
        zsi = zsi + 1;
    }
    Console.WriteLine("      ✓ programs/z42c/ (z42c.* seed zpkgs, C#-free)");

    // [2/5] z42vm + libz42.* + z42-compression (cargo " + cargoTarget + ", " + profile + ")
    // staged to artifacts/publish/{z42vm,native}/ (packages.toml Decision 6),
    // not written into pkgDir directly — the final [assemble] step below merges
    // every staged component into pkgDir in one place.
    Console.WriteLine("[2/5] z42vm + libz42 + z42-compression (cargo " + cargoTarget + ", " + profile + ")");
    c = _pkgBuildAndStageRuntime(root, rid, profile); if (c != 0) { return c; }
    string cargoOut = _cargoOutFor(root, rid, profile);
    Console.WriteLine("      ✓ staged z42vm/ + native/ (libz42.* / z42.* / libz42_compression.*)");

    // [2c/5] build + stage toolchain components (workloads / launcher / z42b /
    // devtools / interactive) — apphost stub + 8 zpkg builds + 5 `z42b publish`
    // into per-component staging dirs. Extracted to keep _packageDesktop ≤60 lines.
    c = _pkgStageToolchainComponents(root, z42cDir, cargoOut, cargoTarget, rid, rel);
    if (c != 0) { return c; }

    // stdlib zpkg + zsym — staged to artifacts/publish/stdlib/libs/.
    Console.WriteLine("      staging stdlib zpkg + zsym");
    c = _pkgStageStdlib(root); if (c != 0) { return c; }
    Console.WriteLine("      ✓ staged stdlib/");

    // [assemble] merge every `sdk`-included component's staged subtree into
    // pkgDir (packages.toml `[package.sdk].include`; design.md Decision 6). This
    // is the only place pkgDir gets its bin/native/libs/programs content from —
    // everything above stages, nothing above writes pkgDir directly except the
    // [1/5] bootstrap seed (which the z42c component's staged output overwrites
    // with identical bytes).
    Console.WriteLine("[assemble] sdk package from staged components");
    _PackagesConfig cfg = _pkgcfgLoad(root);
    c = _pkgAssembleFromStaging(cfg, root, "sdk", pkgDir);
    if (c != 0) { return c; }
    Console.WriteLine("      ✓ pkgDir assembled from artifacts/publish/{z42vm,native,stdlib,z42c,launcher,z42b,devtools,interactive}");

    // [5/5] manifest.toml
    Console.WriteLine("[5/5] manifest.toml");
    _pkgEmitManifest(pkgDir, rid, version, profile, hostRid);
    _procEnd("package desktop", sw);
    return 0;
}

// [2c/5] of _packageDesktop — build the apphost stub + 8 toolchain zpkgs, then
// `z42b publish` each SDK component into its staging dir (artifacts/publish/<comp>/;
// [assemble] later merges into pkgDir). Self-contained: computes libs / hostVm /
// apphostStub / z42bZpkg locally (none used by _packageDesktop after this block).
// move-desktop-packaging-to-publish + add-package-layout-config task ④: each
// component's `[platform.desktop] bin`/`payload` (its own toml) drives placement;
// z42c.driver's 6 siblings colocate into programs/z42c/ via publish dependency-bundling.
int _pkgStageToolchainComponents(string root, string z42cDir, string cargoOut, string cargoTarget, string rid, bool rel) {
    Console.WriteLine("[2c/5] z42 launcher (apphost + launcher.zpkg)");
    // apphost stub (z42-apphost crate) → cargoOut/apphost — desktop workload's
    // per-RID stub AND the publish template (Z42_APPHOST_TEMPLATE) for z42/z42c/z42b.
    // NOT shipped in the SDK (Decision 9); delivered via the desktop workload.
    int c = _cargo(rel, "build", "src/toolchain/workload/desktop/platform/apphost/Cargo.toml", cargoTarget, ""); if (c != 0) { return c; }
    string libs = _libsDir(root);
    // replace-csharp Phase C: components built with z42c (host z42vm + colocated
    // z42c.driver.zpkg), NOT `dotnet run`. Host z42vm compiles regardless of target
    // rid → RID-independent zpkgs. Built into Z42_LIBS first so later components
    // resolve their workload/launcher deps (z42b must exist before it can publish).
    string hostVm = _builtVm(root, "release");
    string[] buildTomls = new string[]{
        "src/toolchain/workload/desktop/appbuilder/z42.workload.desktop.z42.toml",
        "src/toolchain/workload/ios/appbuilder/z42.workload.ios.z42.toml",
        "src/toolchain/workload/android/appbuilder/z42.workload.android.z42.toml",
        "src/toolchain/workload/wasm/appbuilder/z42.workload.wasm.z42.toml",
        "src/toolchain/launcher/core/z42.launcher.z42.toml",
        "src/toolchain/builder/core/z42.builder.z42.toml",
        // devtools (z42d): scaffold placeholder — subcommand prints "planned" but
        // builds+publishes through the same path. interactive (z42i) is built
        // separately below (after z42.repl) since it depends on z42.repl.
        "src/toolchain/devtools/core/z42.devtools.z42.toml",
    };
    int bi = 0;
    while (bi < buildTomls.Length) {
        c = _z42cBuildToml(hostVm, z42cDir, libs, buildTomls[bi]);
        if (c != 0) { return c; }
        bi = bi + 1;
    }
    // move-scripting-to-libraries：z42.scripting 已成 stdlib 成员，随 [1/5] _buildCompiler → _buildStdlib
    // 编入 libs；此处只需建 z42.repl（tty 交互层）→ libs（Z42_LIBS=stdlib dist，已含 scripting +
    // z42c.core/syntax）。z42.interactive 依赖 scripting + repl，二者皆在 libs，故用纯 stdlib libs 编
    // （不再需要 `.scripting-libs` 合并目录）。z42i 运行期仍 lazy-load z42c.pipeline（见下 KNOWN LIMITATION）。
    c = _buildReplLib(root, hostVm, z42cDir, libs);
    if (c != 0) { return c; }
    c = _z42cBuildToml(hostVm, z42cDir, libs,
                       "src/toolchain/interactive/core/z42.interactive.z42.toml");
    if (c != 0) { return c; }

    bool isWin = rid.StartsWith("windows-");
    string apphostStub = Path.Join(cargoOut, isWin ? "apphost.exe" : "apphost");
    // z42b zpkg from its toml (SoT: no hardcoded path — _toolchainZpkg = [build]
    // dist_dir cascade + project.name). z42b publishes itself deploy-only (no recompile).
    string z42bZpkg = _toolchainZpkg(root, "src/toolchain/builder/core/z42.builder.z42.toml");
    // `z42` = apphost stub patched to run programs/launcher/launcher.zpkg.
    c = _z42bPublish(hostVm, z42bZpkg, libs, apphostStub, "src/toolchain/launcher/core/z42.launcher.z42.toml", rid, _pkgStageDir(root, "launcher"));
    if (c != 0) { return c; }
    Console.WriteLine("      ✓ staged launcher/ (z42 apphost + programs/launcher/launcher.zpkg)");
    // bin/z42c = apphost trampoline → programs/z42c/z42c.driver.zpkg (+ 6 siblings colocated).
    c = _z42bPublish(hostVm, z42bZpkg, libs, apphostStub, "src/compiler/z42c.driver/z42c.driver.z42.toml", rid, _pkgStageDir(root, "z42c"));
    if (c != 0) { return c; }
    Console.WriteLine("      ✓ staged z42c/ (bin/z42c apphost + programs/z42c/z42c.driver.zpkg + siblings)");
    // bin/z42b = apphost trampoline → programs/z42b/z42.builder.zpkg.
    c = _z42bPublish(hostVm, z42bZpkg, libs, apphostStub, "src/toolchain/builder/core/z42.builder.z42.toml", rid, _pkgStageDir(root, "z42b"));
    if (c != 0) { return c; }
    Console.WriteLine("      ✓ staged z42b/ (bin/z42b apphost + programs/z42b/z42.builder.zpkg)");
    // bin/z42d = apphost trampoline → programs/z42d/z42.devtools.zpkg (scaffold).
    c = _z42bPublish(hostVm, z42bZpkg, libs, apphostStub, "src/toolchain/devtools/core/z42.devtools.z42.toml", rid, _pkgStageDir(root, "z42d"));
    if (c != 0) { return c; }
    Console.WriteLine("      ✓ staged z42d/ (bin/z42d apphost + programs/z42d/z42.devtools.zpkg, scaffold)");
    // bin/z42i = apphost trampoline → programs/z42i/z42.interactive.zpkg。
    // z42i 运行期经 ReplCompilerHost 反射注入编译器（lazy-load programs/z42c/z42c.pipeline.zpkg + 其
    // 传递闭包 z42c.semantics/... ）。历史 KNOWN LIMITATION（fix-repl-sdk-layout / add-z42-repl 遗留）：
    // semantics/pipeline 在 programs/z42c/、不在 libs/，而 ModuleLoader 只按「VM 启动 search_dirs（app dir
    // + Z42_LIBS）」解析被加载模块的依赖闭包 → 找不到 semantics → z42i shipped 全量求值报 undefined。
    // 已根治（fix-repl-sdk-compiler-closure）：ModuleLoader.load_module_from_path 现把被加载 zpkg 自身所在
    // 目录并入 search_dirs（镜像 app::run「entry-zpkg dir first」），programs/z42c/ 里的 7 兄弟自然解析——
    // 无需把编译器闭包复制进 z42i payload。故此处 publish 不变。
    c = _z42bPublish(hostVm, z42bZpkg, libs, apphostStub, "src/toolchain/interactive/core/z42.interactive.z42.toml", rid, _pkgStageDir(root, "z42i"));
    if (c != 0) { return c; }
    Console.WriteLine("      ✓ staged z42i/ (bin/z42i apphost + programs/z42i/z42.interactive.zpkg)");
    return 0;
}

// ── desktop workload (apphost stub, per-rid file: apphost-<rid>) ──────────────
// Decision 9 full gating + single RID-agnostic workload: the apphost stub for
// each desktop RID is a small native binary named `apphost-<rid>`. This per-RID
// build job emits its own `apphost-<rid>` into z42-workload-<v>-desktop-<rid>/;
// CI then COLLECTS all RIDs' stubs into ONE z42-workload-<v>-desktop package so
// any host can `publish --rid <target>` (cross-platform apphost output). No target
// runtime pack — desktop reuses the host runtime (`z42 install <ver>`). The apphost
// binary is cargo-built by _packageDesktop's z42-apphost crate build; it lands here, not in SDK bin/.
int _buildDesktopWorkload(string root, string rid, string version, string profile) {
    bool rel = (profile == "release");
    bool isWin = rid.StartsWith("windows-");
    string srcExe = isWin ? "apphost.exe" : "apphost";
    string dstExe = isWin ? ("apphost-" + rid + ".exe") : ("apphost-" + rid);
    string pkgName = "z42-workload-" + version + "-desktop-" + rid + (rel ? "" : "-" + profile);
    string pkgDir = Path.Join(_packagesDir(root), pkgName);
    Console.WriteLine("Desktop workload: " + pkgName);
    if (Directory.Exists(pkgDir)) { Directory.Delete(pkgDir, true); }
    Directory.Create(pkgDir);

    string cargoOut = _cargoOutFor(root, rid, profile);
    string stub = Path.Join(cargoOut, srcExe);
    if (!File.Exists(stub)) {
        ConsoleError.WriteLine("error: apphost stub not built at " + stub + "; run the z42-apphost crate cargo build first");
        return 1;
    }
    File.Copy(stub, Path.Join(pkgDir, dstExe));
    _makeExe(Path.Join(pkgDir, dstExe));
    Console.WriteLine("      ✓ " + dstExe + " (apphost stub)");

    // RID-agnostic manifest (any host; no runtime pack). The single CI-merged
    // package carries every RID's apphost-<rid>; this per-RID piece carries one.
    string m = _workloadPkgHeader("z42-workload-desktop", version, "", profile, "");
    m = m + "[contents.platform]\n";
    m = m + "apphost-prefix = \"apphost-\"  # apphost-<rid> per target; cross-platform output\n";
    m = m + "host           = [\"*\"]\n";
    m = m + "runtime-pack   = \"\"  # none — desktop reuses the host runtime (z42 install <ver>)\n\n";
    m = m + "[compat]\n";
    m = m + "host-min-version = \"" + version + "\"\n";
    File.WriteAllText(Path.Join(pkgDir, "manifest.toml"), m);
    Console.WriteLine("      ✓ manifest.toml (workload tooling — desktop, RID-agnostic)");
    return 0;
}

// ── launcher artifact ────────────────────────────────────────────────────────
// ── runtime artifact ─────────────────────────────────────────────────────────
// Pure embeddable runtime: native/ (embed libs + C ABI headers) + libs/ (stdlib
// zpkg) — NO z42c, NO z42vm CLI (2026-07-01 revision). Both are host-platform
// tooling, not part of "runtime": a runtime pack may run on a DIFFERENT host
// than it targets (e.g. the android runtime pack is installed from a Windows or
// macOS host), so a single-host-platform z42c binary inside it has no meaning —
// this now matches the ios/android/wasm runtime packs, which never carried
// z42c/z42vm either. The self-host bootstrap seed moved to the SDK package's
// programs/z42c/ (see docs/design/compiler/self-hosting.md). libs/ + native/
// are copied verbatim from the SDK package that _packageDesktop just assembled
// — single byte source → SDK and runtime pack stay byte-identical, and no
// native libs are re-collected/re-globbed here.
int _buildRuntimePackage(string root, string rid, string version, string profile) {
    string pkgName = "z42-runtime-" + version + "-" + rid + (profile == "release" ? "" : "-" + profile);
    string pkgDir = Path.Join(_packagesDir(root), pkgName);
    Console.WriteLine("Runtime package: " + pkgName);
    if (Directory.Exists(pkgDir)) { Directory.Delete(pkgDir, true); }
    Directory.Create(pkgDir);

    // libs/ + native/ (embed libs + include/ headers) merged from the same
    // staging root _packageDesktop just populated (packages.toml
    // `[package.runtime].include = ["native", "stdlib"]`) — no longer a
    // copy-from-the-SDK special case (design.md Decision 6).
    _PackagesConfig cfg = _pkgcfgLoad(root);
    int c = _pkgAssembleFromStaging(cfg, root, "runtime", pkgDir);
    if (c != 0) { return c; }

    Console.WriteLine("  ✓ runtime package (native/ + libs): " + pkgDir);
    return 0;
}

// ── manifest (desktop SDK) ───────────────────────────────────────────────────

void _pkgEmitManifest(string pkgDir, string rid, string version, string profile, string buildHost) {
    string buildDate = _utcNow();
    string binList = _quotedDirList(Path.Join(pkgDir, "bin"), "");
    string libsList = _quotedDirList(Path.Join(pkgDir, "libs"), ".zpkg");
    string staticList = _quotedExisting(Path.Join(pkgDir, "native"), "libz42.a", "z42.lib");
    string dynamicList = _quotedExisting(Path.Join(pkgDir, "native"), "libz42.dylib", "libz42.so");
    string m = "";
    m = m + "[package]\n";
    m = m + "name        = \"z42-" + rid + "\"\n";
    m = m + "version     = \"" + version + "\"\n";
    m = m + "abi-version = 1\n";
    m = m + "rid         = \"" + rid + "\"\n";
    m = m + "profile     = \"" + profile + "\"\n";
    m = m + "build-date  = \"" + buildDate + "\"\n";
    m = m + "build-host  = \"" + buildHost + "\"\n\n";
    m = m + "[contents]\n";
    m = m + "bin         = [" + binList + "]\n";
    m = m + "libs        = [" + libsList + "]\n\n";
    m = m + "[contents.native]\n";
    m = m + "static      = [" + staticList + "]\n";
    m = m + "dynamic     = [" + dynamicList + "]\n";
    m = m + "containers  = []\n";
    m = m + "includes    = [\"z42_abi.h\", \"z42_host.h\"]\n\n";
    m = m + "[contents.platform]\n";
    m = m + "# desktop package: no platform-native facade (C consumers use native/include/)\n\n";
    m = m + "[compat]\n";
    m = m + "host-min-version = \"" + version + "\"\n";
    File.WriteAllText(Path.Join(pkgDir, "manifest.toml"), m);
}

string _utcNow() {
    ProcessResult r = new Process("date").Arg("-u").Arg("+%Y-%m-%dT%H:%M:%SZ").Run();
    if (r.ExitCode == 0) { return r.Stdout.Trim(); }
    return "1970-01-01T00:00:00Z";
}

string _quotedDirList(string dir, string suffix) {
    if (!Directory.Exists(dir)) { return ""; }
    string acc = "";
    foreach (var f in Directory.Enumerate(dir)) {
        if (suffix.Length == 0 || f.EndsWith(suffix)) {
            if (acc.Length > 0) { acc = acc + ", "; }
            acc = acc + "\"" + f + "\"";
        }
    }
    return acc;
}

string _quotedExisting(string dir, string a, string b) {
    string acc = "";
    // length guards: skip empty names — z42 File.Exists is true for the dir itself
    // (Path.Join(dir,"")==dir), which would otherwise emit a spurious "".
    if (a.Length > 0 && File.Exists(Path.Join(dir, a))) { acc = "\"" + a + "\""; }
    if (b.Length > 0 && File.Exists(Path.Join(dir, b))) { if (acc.Length > 0) { acc = acc + ", "; } acc = acc + "\"" + b + "\""; }
    return acc;
}

// ── z42c / z42b invocation (internal SDK packaging) ─────────────────────────
// Apphost patching itself is NOT inlined here anymore (move-desktop-packaging-
// to-publish, add-package-layout-config task ④) — `_z42bPublish` below delegates
// to the single implementation in builder_publish.z42 (`_pubProduceApphost`),
// the same one `z42b publish` uses standalone. Keeping only one copy avoids the
// former "⚠ MAGIC must stay in sync with the Rust stub in N places" risk.

// Build one z42 package toml with z42c (z42vm + colocated z42c.driver.zpkg),
// replacing the former `dotnet run z42.Driver -- build` (replace-csharp Phase C).
// `vm` = host z42vm; `z42cDir` holds the 7 z42c.* seed zpkgs (driver siblings
// resolve colocated); `libs` = Z42_LIBS (stdlib + prior workload zpkgs). The toml
// itself carries its dist_dir, so emit location is unchanged from the C# path.
int _z42cBuildToml(string vm, string z42cDir, string libs, string toml) {
    return _exec(new Process(vm)
        .Arg(Path.Join(z42cDir, "z42c.driver.zpkg")).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("build").Arg(toml).Arg("--release")
        .Env("Z42_LIBS", libs));
}

// Publish `toml`'s desktop apphost into `outputDir` via an already-built
// `z42bZpkg` (z42.builder.zpkg) — `vm z42bZpkg -- publish <toml> --rid <rid>
// --output <outputDir>`. `libs` resolves z42b's own stdlib deps; `apphostStub`
// is forwarded as Z42_APPHOST_TEMPLATE (the raw, unpatched apphost binary that
// z42b's publish command patches — mirrors the launcher's Z42_APPHOST_TEMPLATE
// forwarding for `z42 publish`, Decision 3.5).
int _z42bPublish(string vm, string z42bZpkg, string libs, string apphostStub, string toml, string rid, string outputDir) {
    return _exec(new Process(vm)
        .Arg(z42bZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("publish").Arg(toml).Arg("--rid").Arg(rid).Arg("--output").Arg(outputDir)
        .Env("Z42_LIBS", libs)
        .Env("Z42_APPHOST_TEMPLATE", apphostStub));
}
