// xtask — `test package`：打出来的 z42 发行包的端到端检查。两段：
//
//   ① 发行包夹具（src/toolchain/launcher/tests/fixtures/package/，格式见该目录 README）：新手命令行路径、
//      `z42 run --bin/--set`、`repl`、单文件运行、桌面发布（apphost / 多 exe / 预编译 native）、发布态 analyzer
//      与 build hooks。这里只定义套件（打包 SDK 的工具表 + 占位符），执行与判定由通用引擎
//      common/xtask_fixture_harness.z42 负责；
//   ② golden 腿：用包里的 z42c 编每个 golden 的源码、包里的 z42vm 按 interp / jit 跑，stdout 对 expected_output。
//      golden 布局同 test-vm（src/tests/<cat>/<name>/source.z42、src/libraries/<lib>/tests/<name>/source.z42、
//      flat 的 src/tests/<cat>/<name>.z42）。
//
// 由 `_testDist`（xtask_test.z42）在进程内驱动。包目录取最新的 artifacts/packages/z42-*-release（或 env DIST_DIR）；
// mode 列表是 argv 里可选的 `interp|jit`（缺省 "interp jit"）。
//
// golden 遍历 / 入口推导 / 字符串小工具（_deriveEntry、_splitWords、_firstLine、_stripTrailingNewlines 等）只在
// common/xtask_golden.z42 定义一次；_latestReleasePkg 在 xtask_test.z42，挨着 _hasReleasePkg。
namespace Z42Xtask;

using Std.IO;

string _distFixturesSrc() { return "src/toolchain/launcher/tests/fixtures/package"; }

// `test package [interp|jit]` 的本体。全部通过返回 0，否则 1（缺包 / 夹具不符 / golden 编译失败或不符）。
// `modeArg` 是可选的 mode 位置参数（interp|jit），空 = 两种都跑。
int _testDistRun(string modeArg) {
    string root = _root();
    // DIST_SMOKE_ONLY=<tag> → 只跑 `tags` 含 <tag> 的发行包夹具（如 `launcher`：命令行路径那几例），
    // 跳过 golden 腿。本地快跑的开关；CI 不用它 —— CI 那一处 `test package` 必须把每条腿都跑到。
    string onlyTag = _envOpt("DIST_SMOKE_ONLY", "");

    // ── 包目录 ──────────────────────────────────────────────────────────
    string distDir = _envOpt("DIST_DIR", "");
    if (distDir.Length == 0) { distDir = _latestReleasePkg(root); }
    if (distDir.Length == 0 || !Directory.Exists(distDir)) {
        ConsoleError.WriteLine("error: no packaged distribution found at artifacts/packages/z42-*-release");
        ConsoleError.WriteLine("       Run: xtask package sdk");
        return 1;
    }
    string z42c     = _distExe(Path.Join(distDir, "bin/z42c"));
    string z42vm    = _distExe(Path.Join(distDir, "bin/z42vm"));
    string launcher = _distExe(Path.Join(distDir, "z42"));
    string libsDir  = Path.Join(distDir, "libs");

    // ── Preflight ───────────────────────────────────────────────────────
    // 被测对象缺件必须红在这里：缺件时退化成「静默 SKIP」的门，全部 SKIP 也会报绿，而缺件恰恰是这个检查存在的理由。
    // 只断言**本次真要跑的**那几条腿的被测对象：只跑 launcher 夹具时不需要 apphost 模板。
    bool bad = false;
    if (!File.Exists(z42c))         { ConsoleError.WriteLine("error: z42c not found at " + z42c); bad = true; }
    if (!File.Exists(z42vm))        { ConsoleError.WriteLine("error: z42vm not found at " + z42vm); bad = true; }
    if (!Directory.Exists(libsDir)) { ConsoleError.WriteLine("error: libs not found at " + libsDir); bad = true; }
    if (!File.Exists(launcher))     { ConsoleError.WriteLine("error: launcher (z42) not in package at " + distDir); bad = true; }
    if (!File.Exists(Path.Join(distDir, "programs/launcher/launcher.zpkg"))) {
        ConsoleError.WriteLine("error: programs/launcher/launcher.zpkg not in package at " + distDir); bad = true;
    }
    string apphostTmpl = "";
    if (onlyTag != "launcher") {
        apphostTmpl = _distApphostTemplate(root);
        if (apphostTmpl.Length == 0) {
            ConsoleError.WriteLine("error: desktop workload apphost stub not built at "
                + _distWorkloadDir(root) + " — run: xtask package workload");
            bad = true;
        }
    }
    if (bad) { return 1; }

    Console.WriteLine("z42 Distribution Test Runner");
    Console.WriteLine("  package:  " + distDir);
    Console.WriteLine("  compiler: " + z42c);
    Console.WriteLine("  vm:       " + z42vm);
    Console.WriteLine("  libs:     " + libsDir);

    string work = Directory.CreateTempDir("xtask-testdist");
    int overallPass = 0;
    int overallFail = 0;

    // ── ① 发行包夹具 ─────────────────────────────────────────────────────
    FixtureSuite suite = _distFixtureSuite(root, distDir, apphostTmpl, Path.Join(work, "fixtures"));
    suite.OnlyTag = onlyTag;
    int[] fx = _runFixtureSuite(root, suite);
    overallPass = overallPass + fx[0];
    overallFail = overallFail + fx[1];
    Console.WriteLine("");

    // ── ② golden 腿 ──────────────────────────────────────────────────────
    if (onlyTag.Length == 0) {
        if (modeArg.Length == 0) { modeArg = "interp jit"; }
        int[] gres = _runDistGoldens(_splitWords(modeArg), root, z42c, z42vm, libsDir, work);
        overallPass = overallPass + gres[0];
        overallFail = overallFail + gres[1];
    }

    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Total: " + overallPass.ToString() + " passed, " + overallFail.ToString() + " failed");
    Console.WriteLine("══════════════════════════════════════");
    if (overallFail > 0) {
        Console.WriteLine("（工作目录保留以便排查：" + work + "）");
        return 1;
    }
    Directory.Delete(work, true);   // 含一份整包拷贝（publish-apphost-sidecar 的 ahome/），通过就不留
    return 0;
}

// 发行包夹具套件：工具全部取自包内，环境按「用户机器」清理（不继承 xtask / CI 注入的 z42 变量）。
//   z42   包根的 launcher（缺省工具）。清掉 Z42_HOME 等 ⇒ 便携形态：launcher 由自己的位置找到所在的 SDK。
//   z42c  bin/z42c。Z42_HOME = 包根 ⇒ 安装形态（编译器域的 SDK 库从 Z42_HOME/programs/z42c 解析）。
//   z42b  bin/z42b。清掉 Z42_HOME 等（便携形态）。
//   run   bin/z42vm 跑 `target`。Z42_HOME = 包根。
//   exec  直接跑 `target`（如 `z42 publish` 发布出的 apphost）。清掉 Z42_HOME 等，用例按需用 `env` 指定。
// 占位符：{sdk} = 包根；{apphost_template} = desktop workload 的 apphost stub（只跑 launcher 夹具时为空）；
// {rid} = 包的 rid；{native_prefix} / {native_suffix} = 该 rid 的 native 库文件名前后缀（lib…so / lib…dylib / ….dll）。
FixtureSuite _distFixtureSuite(string root, string distDir, string apphostTmpl, string stageDir) {
    string[] userEnv = new string[]{ "Z42_HOME", "Z42_PORTABLE_VM", "Z42_PORTABLE_LIBS", "Z42_LIBS", "Z42_CONFIG", "Z42_MODE" };

    FixtureTool z42 = new FixtureTool("z42", _distExe(Path.Join(distDir, "z42")));
    z42.Requires = z42.Exe;
    z42.EnvRemove = userEnv;

    FixtureTool z42c = new FixtureTool("z42c", _distExe(Path.Join(distDir, "bin/z42c")));
    z42c.Requires = z42c.Exe;
    z42c.ClearAbsent = true;
    z42c.EnvSet = new string[]{ "Z42_HOME", "{sdk}" };
    z42c.EnvRemove = new string[]{ "Z42_LIBS", "Z42_PORTABLE_VM", "Z42_COMPILER_LIBS" };

    FixtureTool z42b = new FixtureTool("z42b", _distExe(Path.Join(distDir, "bin/z42b")));
    z42b.Requires = z42b.Exe;
    z42b.ClearAbsent = true;
    z42b.EnvRemove = new string[]{ "Z42_HOME", "Z42_PORTABLE_VM", "Z42_LIBS", "Z42_COMPILER_LIBS" };

    FixtureTool run = new FixtureTool("run", _distExe(Path.Join(distDir, "bin/z42vm")));
    run.Requires = run.Exe;
    run.Target = true;
    run.EnvSet = new string[]{ "Z42_HOME", "{sdk}" };
    run.EnvRemove = new string[]{ "Z42_LIBS", "Z42_PORTABLE_VM" };

    FixtureTool exec = new FixtureTool("exec", "");
    exec.EnvRemove = userEnv;

    string rid = _distPkgRid(distDir);
    string pfx = "lib";
    string sfx = ".so";
    if (rid.StartsWith("windows-")) { pfx = ""; sfx = ".dll"; }
    else if (rid.StartsWith("macos-") || rid.StartsWith("ios-") || rid.StartsWith("iossim-")) { sfx = ".dylib"; }

    FixtureSuite s = new FixtureSuite("发行包夹具", _distFixturesSrc());
    s.StageDir = stageDir;
    s.TmpTag = "dist";
    s.DefaultTool = "z42";
    s.Tools = new FixtureTool[]{ z42, z42c, z42b, run, exec };
    s.Vars = new FixturePair[]{
        new FixturePair("sdk", distDir),
        new FixturePair("apphost_template", apphostTmpl),
        new FixturePair("rid", rid),
        new FixturePair("native_prefix", pfx),
        new FixturePair("native_suffix", sfx)
    };
    return s;
}

// 包内程序的路径：Windows 上带 `.exe`。
string _distExe(string p) { return File.Exists(p) ? p : p + ".exe"; }

// 包的 rid：取自包目录名（z42-<version>-<rid>-release；version 可缺）—— 找已知的 OS 前缀，取到 `-release` 为止。
// 认不出时退回本机 rid。
string _distPkgRid(string distDir) {
    string pkgName = Path.GetFileName(distDir);
    foreach (var os in new string[]{ "macos-", "linux-", "windows-", "iossim-", "ios-", "android-" }) {
        int idx = pkgName.IndexOf(os);
        if (idx >= 0) {
            string rest = pkgName.Substring(idx);
            int rel = rest.IndexOf("-release");
            return rel >= 0 ? rest.Substring(0, rel) : rest;
        }
    }
    return _detectHostRid();
}

// Golden legs: compile every dist case ONCE with the packaged z42c, then run the
// zbc under each mode with the packaged z42vm and diff stdout. Returns [pass, fail]
// where fail folds in compile errors (as the caller aggregates).
//
// perf-dist-golden-parallel (2026-09-15): 此前逐 mode、逐 case **串行**「编 + 跑」——
// interp 313 + jit 309 例在 CI 上 linux 8 分钟 / windows 10 分钟，而 zbc 与 mode 无关，
// 等于每例编译两遍。现在：
//   ① 编译一遍（jit 的用例集 = interp 的去掉 interpOnly，同一份源）；
//   ② 编译与运行都按批并行（同 golden regen / e2e goldens 的批模式，批内按原序判定打印，
//      输出确定）。
// 覆盖面不变：仍是同一套用例、同一个打包 z42c/z42vm、同样两种 mode。
int[] _runDistGoldens(string[] modes, string root, string z42c, string z42vm, string libsDir, string work) {
    bool wantInterp = false;
    int mi = 0;
    while (mi < modes.Length) { if (modes[mi] != "jit") { wantInterp = true; } mi = mi + 1; }
    _DistCase[] cases = _enumerateDistCases(root);
    int n = cases.Length;

    // ① compile once. zbc 名带序号：不同目录下可能有同名 case，并行编译时不能共用输出路径。
    string[] zbcs = new string[n];
    bool[] compiled = new bool[n];
    int cjobs = _regenJobs();
    int i = 0;
    while (i < n) {
        int bsz = cjobs;
        if (i + bsz > n) { bsz = n - i; }
        ProcessHandle[] hs = new ProcessHandle[bsz];
        bool[] live = new bool[bsz];
        int b = 0;
        while (b < bsz) {
            _DistCase c = cases[i + b];
            zbcs[i + b] = Path.Join(work, (i + b).ToString() + "-" + c.name + ".zbc");
            live[b] = false;
            if (wantInterp || !c.interpOnly) {
                try {
                    Process cp = _z42Proc(z42c, libsDir).Arg("--emit-zbc").Arg(c.source).Arg(zbcs[i + b]);
                    if (c.optAll) { cp = cp.Arg("--opt-all"); }   // opt_all sidecar，见 _compileCaseSpawn
                    hs[b] = cp
                        .Stdout(Stdio.Null()).Stderr(Stdio.Null())
                        .Spawn();
                    live[b] = true;
                } catch (Exception e) { ConsoleError.WriteLine("  (compile spawn error: " + e.Message + ")"); }
            }
            b = b + 1;
        }
        b = 0;
        while (b < bsz) {
            compiled[i + b] = live[b] && hs[b].Wait().ExitCode == 0;
            b = b + 1;
        }
        i = i + bsz;
    }

    // ② run per mode.
    int pass = 0;
    int fail = 0;
    int rjobs = _distRunJobs();
    mi = 0;
    while (mi < modes.Length) {
        string mode = modes[mi];
        mi = mi + 1;
        Console.WriteLine("══════════════════════════════════════");
        Console.WriteLine(" Mode: " + mode);
        Console.WriteLine("══════════════════════════════════════");
        int[] sel = new int[n];
        int ns = 0;
        i = 0;
        while (i < n) {
            if (!(mode == "jit" && cases[i].interpOnly)) { sel[ns] = i; ns = ns + 1; }
            i = i + 1;
        }
        int mpass = 0;
        int mfail = 0;
        int compileFail = 0;
        int k = 0;
        while (k < ns) {
            int bsz = rjobs;
            if (k + bsz > ns) { bsz = ns - k; }
            ProcessHandle[] hs = new ProcessHandle[bsz];
            bool[] live = new bool[bsz];
            string[] spawnErr = new string[bsz];
            int b = 0;
            while (b < bsz) {
                int ci = sel[k + b];
                _DistCase c = cases[ci];
                live[b] = false;
                spawnErr[b] = "";
                if (compiled[ci]) {
                    // entry passed explicitly — z42vm requires it.
                    try {
                        hs[b] = _z42Proc(z42vm, libsDir).Arg(zbcs[ci]).Arg(c.entryName).Arg("--mode").Arg(mode)
                            .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe())
                            .Spawn();
                        live[b] = true;
                    } catch (Exception e) { spawnErr[b] = "<spawn error: " + e.Message + ">"; }
                }
                b = b + 1;
            }
            b = 0;
            while (b < bsz) {
                int ci = sel[k + b];
                _DistCase c = cases[ci];
                b = b + 1;
                if (!compiled[ci]) {
                    compileFail = compileFail + 1;
                    Console.WriteLine("  FAIL: " + c.name + " (compile failed)");
                    continue;
                }
                string actual = spawnErr[b - 1];
                if (live[b - 1]) {
                    try {
                        ProcessResult r = hs[b - 1].Wait();
                        actual = _stripTrailingNewlines(r.Stdout + r.Stderr);
                    } catch (Exception e) { actual = "<wait error: " + e.Message + ">"; }
                }
                string expected = "";
                if (File.Exists(c.expected)) { expected = _stripTrailingNewlines(File.ReadAllText(c.expected)); }
                if (actual == expected) {
                    mpass = mpass + 1;
                } else {
                    mfail = mfail + 1;
                    Console.WriteLine("  FAIL: " + c.name);
                    Console.WriteLine("    expected: " + _firstLine(expected));
                    Console.WriteLine("    actual:   " + _firstLine(actual));
                }
            }
            k = k + bsz;
        }
        Console.WriteLine("");
        Console.WriteLine("  Result: " + mpass.ToString() + " passed, " + mfail.ToString()
            + " failed, " + compileFail.ToString() + " compile errors");
        Console.WriteLine("");
        pass = pass + mpass;
        fail = fail + mfail + compileFail;
    }
    int[] res = new int[2];
    res[0] = pass;
    res[1] = fail;
    return res;
}

// 运行阶段并发度：min(CpuCount, 8)。与编译不同，运行是真吃 CPU 的 VM 进程（含 GC / 线程类
// golden），不超核数；GitHub 4 核 runner 上 = 4，与 test-host 的 e2e goldens（jobs=4）同一量级。
// `Z42_DIST_JOBS` 逃生舱：不改代码在 CI 上试别的值（1 = 退回串行）。
int _distRunJobs() {
    string ov = Environment.GetEnvironmentVariable("Z42_DIST_JOBS", "");
    if (ov.Length > 0) {
        try { int v = int.Parse(ov); if (v > 0) { return v; } } catch (Exception e) { }
    }
    int cpu = OperatingSystem.CpuCount();
    if (cpu < 1) { return 1; }
    return cpu < 8 ? cpu : 8;
}

// ── apphost stub 模板的真实位置（夹具占位符 {apphost_template}）────────────────
// stub 随 **desktop workload** 发布，SDK 包里**没有** bin/apphost —— 生产端见 `_buildDesktopWorkload`，
// 消费端见 launcher 的 `_desktopApphostStub`（读 installed workload 或 Z42_APPHOST_TEMPLATE 覆盖）。
// ⚠️ 别改成去包里找：那里恒找不到，发布类夹具就成了「永远缺件」—— preflight 会把它报成缺件，
// 而一旦有人把缺件降成 SKIP，这几条腿就变回从不运行、从不失败的门。
string _distWorkloadDir(string root) {
    string rid = _detectHostRid();
    return Path.Join(_packagesDir(root), "z42-workload-" + _versionsGet(root) + "-desktop-" + rid);
}

// "" = 未构建（调用方按缺件处理）。
string _distApphostTemplate(string root) {
    string rid = _detectHostRid();
    string name = rid.StartsWith("windows-") ? ("apphost-" + rid + ".exe") : ("apphost-" + rid);
    string p = Path.Join(_distWorkloadDir(root), name);
    if (File.Exists(p)) { return p; }
    return "";
}

// ── Case shape + enumeration ───────────────────────────────────────────────
// _DistCase is dist-specific: it names the `.z42` SOURCE to compile with the
// packaged z42c, where the VM runner's _Case (xtask_test_vm.z42, same namespace)
// names a prebuilt `.zbc`. Both are now mapped from the ONE shared corpus walk
// (_walkGoldenCorpus, common/xtask_golden.z42) — only the selection policy and
// the record shape stay local.

class _DistCase {
    public string name;
    public string source;     // source.z42 path
    public string expected;   // expected_output.txt path
    public string entryName;  // <ns>.Main / Main / <ns>.main / main (z42vm needs it)
    public bool interpOnly;   // jit 模式跳过（同 _GoldenEntry.interpOnly）
    public bool optAll;       // 按 release 全优化编（同 _GoldenEntry.optAll）
    public _DistCase(string name, string source, string expected, string entryName, bool interpOnly, bool optAll) {
        this.name = name; this.source = source; this.expected = expected; this.entryName = entryName;
        this.interpOnly = interpOnly; this.optAll = optAll;
    }
}

// True if source.z42 declares a unit test (a line starts with `[Test]` /
// `[Benchmark]`) → owned by `xtask test stdlib` (z42b reflection runner), not
// golden-runnable here.
bool _isTestRunnerSource(string src) {
    string rest = File.ReadAllText(src);
    while (rest.Length > 0) {
        string ln;
        int nl = rest.IndexOf("\n");
        if (nl < 0) { ln = rest; rest = ""; }
        else { ln = rest.Substring(0, nl); rest = rest.Substring(nl + 1); }
        ln = ln.Trim();
        if (ln.StartsWith("[Test]") || ln.StartsWith("[Test(")
            || ln.StartsWith("[Benchmark]") || ln.StartsWith("[Benchmark(")) {
            return true;
        }
    }
    return false;
}

// Golden selection over the shared walk (_walkGoldenCorpus, common/xtask_golden.z42).
// Unlike the VM runner, dist compiles the `.z42` SOURCE with the PACKAGED z42c, so
// selection keys off source presence, not the artifacts mirror.
// 返回全部 mode 的并集；interpOnly 由调用方按 mode 过滤（编译只做一遍）。
_DistCase[] _enumerateDistCases(string root) {
    _GoldenEntry[] entries = _walkGoldenCorpus(root);
    _DistCase[] cases = new _DistCase[entries.Length];
    int n = 0;

    int i = 0;
    while (i < entries.Length) {
        _GoldenEntry e = entries[i];
        i = i + 1;
        if (e.seg == "lib-file") { continue; }   // stdlib [Test] file units — z42b's, not golden
        if (!e.hasSource) { continue; }
        // Skip [Test]/[Benchmark]-based lib test dirs — owned by `xtask test stdlib`
        // (z42b), not golden-runnable (no Main; may be multi-file like secp256k1's
        // source.z42 + vectors.z42).
        if (e.isLib && _isTestRunnerSource(e.src)) { continue; }
        cases[n] = new _DistCase(e.name, e.src, e.expected, _deriveEntry(e.src), e.interpOnly, e.optAll);
        n = n + 1;
    }

    _DistCase[] tight = new _DistCase[n];
    int t = 0;
    while (t < n) { tight[t] = cases[t]; t = t + 1; }
    return tight;
}

// ── test-dist-private helpers ──────────────────────────────────────────────

// 与 `Environment.GetEnvironmentVariable(name, fallback)` 的差别：这里**空串也算没设**。
string _envOpt(string name, string fallback) {
    string? v = Environment.GetEnvironmentVariable(name);
    if (v == null) { return fallback; }     // 判过之后 v 已收窄为非空
    if (v.Length == 0) { return fallback; }
    return v;
}

