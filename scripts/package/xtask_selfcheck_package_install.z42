// xtask — package installer self-check (drop-package-staging；前身是 add-package-layout-config 阶段 3.3 的
// staging handler 自检 + 4.1b 的 assembly 自检，暂存去掉后合成这一份).
//
// Same rationale as xtask_selfcheck_packages_config.z42: xtask is an exe, so the
// [Test]-attribute reflection runner can't see it — this is a plain
// throw-on-mismatch self-check, not [Test]-discovered.
//
// 运行方式：`xtask package check`（经 _testPackages 聚合）。**它是 opt-in 的，
// 不在 `xtask test` 的 GREEN gate stage 里**——改打包系统时手动跑（见 scripts/README.md）。
//
// 用一个手搭的 _PackagesConfig（真 kind、假 cargoOut）走 `_pkgInstallPackage`，装进临时包目录：
// installers only copy — they never invoke cargo themselves, so no real build is needed —
// plus the repo's real, already-built stdlib dist for the stdlib component.
namespace Z42Xtask;

using Std.IO;

void _stgAssert(string what, bool cond) {
    if (!cond) { throw new Exception("packages-install: " + what + ": failed"); }
}

_PkgComponent _instComp(string name, string kind, string project) {
    _PkgComponent comp = new _PkgComponent();
    comp.name = name;
    comp.kind = kind;
    comp.project = project;
    comp.dest = "";
    return comp;
}

_PackagesConfig _instConfig(string pkgName, string[] include, _PkgComponent[] comps) {
    _PkgPackage pkg = new _PkgPackage();
    pkg.name = pkgName;
    pkg.include = include;
    _PackagesConfig cfg = new _PackagesConfig();
    cfg.packages = new _PkgPackage[1];
    cfg.packages[0] = pkg;
    cfg.components = comps;
    return cfg;
}

int _testPackagesInstall() {
    string root = _root();
    string fakeCargoOut = _xtaskWork(root, "install-test-cargo");
    if (Directory.Exists(fakeCargoOut)) { Directory.Delete(fakeCargoOut, true); }
    Directory.Create(fakeCargoOut);
    File.WriteAllText(Path.Join(fakeCargoOut, "z42vm"), "fake-z42vm-binary");
    File.WriteAllText(Path.Join(fakeCargoOut, "libz42.a"), "fake-static-lib");
    File.WriteAllText(Path.Join(fakeCargoOut, "libz42_compression.a"), "fake-compression-lib");
    File.WriteAllText(Path.Join(fakeCargoOut, "libz42_platform_ios.a"), "must-be-excluded");
    File.WriteAllText(Path.Join(fakeCargoOut, "libz42_repl.dylib"), "fake-repl-cdylib");

    // 一个假包：四种固定 kind 各一个组件（真 kind，假 cargoOut），按 include 顺序装进临时包目录。
    string pkgDir = _xtaskWork(root, "install-test-pkg");
    _resetDir(pkgDir);
    _PkgComponent[] comps = new _PkgComponent[]{
        _instComp("z42vm", "cargo-bin", ""), _instComp("native", "cargo-native", ""),
        _instComp("stdlib", "stdlib-glob", ""), _instComp("editor-assets", "editor-assets", "") };
    _PackagesConfig cfg = _instConfig("install-test-pkg",
        new string[]{ "z42vm", "native", "stdlib", "editor-assets" }, comps);
    _PkgInstallCtx ctx = new _PkgInstallCtx();
    ctx.CargoOut = fakeCargoOut;
    _stgAssert("install ok", _pkgInstallPackage(cfg, root, "install-test-pkg", pkgDir, ctx) == 0);

    // z42vm: bin/z42vm at the exact dest packages.toml declares, content matches the source (a real copy).
    string vmBin = Path.Join(pkgDir, "bin/z42vm");
    _stgAssert("bin/z42vm exists", File.Exists(vmBin));
    _stgAssert("bin/z42vm content", File.ReadAllText(vmBin) == "fake-z42vm-binary");
    // add-native-dep-config: the repl cdylib is NOT put into bin/ (kept out of the
    // shared dir the ext scanner walks). It is colocated into programs/z42i/ by z42.repl's
    // ProvideNative build hook during `z42b publish` — covered by the publish e2e.
    _stgAssert("bin/libz42_repl absent", !File.Exists(Path.Join(pkgDir, "bin/libz42_repl.dylib")));

    // native: native/libz42.a + native/libz42_compression.a, mobile facade excluded
    // (_copyNativeLibs' filter), headers copied from the real src/runtime/include/.
    _stgAssert("native/libz42.a exists", File.Exists(Path.Join(pkgDir, "native/libz42.a")));
    _stgAssert("native/libz42_compression.a exists", File.Exists(Path.Join(pkgDir, "native/libz42_compression.a")));
    _stgAssert("mobile facade excluded", !File.Exists(Path.Join(pkgDir, "native/libz42_platform_ios.a")));
    _stgAssert("native/libz42_repl absent", !File.Exists(Path.Join(pkgDir, "native/libz42_repl.dylib")));
    _stgAssert("native/include/z42_abi.h exists", File.Exists(Path.Join(pkgDir, "native/include/z42_abi.h")));
    _stgAssert("native/include/z42_host.h exists", File.Exists(Path.Join(pkgDir, "native/include/z42_host.h")));

    // stdlib: reuses the repo's real built dist — at least one zpkg lands at the declared libs/ dest.
    bool anyZpkg = false;
    foreach (var f in Directory.Enumerate(Path.Join(pkgDir, "libs"))) {
        if (f.EndsWith(".zpkg")) { anyZpkg = true; }
    }
    _stgAssert("stdlib libs/ has zpkg", anyZpkg);

    // 🔴 **装 libs 必须按成员清单，而不是「flat 里有什么拷什么」**（2026-09-28）。
    //
    // 上面那两组「不得出现在 libs/」的断言读的是**真实 flat 的当下状态** —— 而 flat 里有什么
    // 曾取决于最后跑的是哪条命令（`build compiler` 的破环预建往里写，`build stdlib` 末步又清空；2026-10-01 起
    // `build compiler` 自建完即清走，但中途失败仍可能留下）。
    // 所以它们**能抓到、抓不住**：实测 `build compiler` 之后打包，SDK 的 `libs/` 里就多出
    // `z42c.core` / `z42c.syntax` / `z42.package` / `z42.project` / `z42.build` 五个。
    //
    // 这一格改成**密闭**的：自己造一个「被污染的 libs」，看安装会不会把入侵者带进去。
    // 与命令顺序无关 ⇒ 它守的是**构造**，不是当下这一刻的目录内容。
    string fakeLibs = _xtaskWork(root, "install-test-fake-libs");
    _resetDir(fakeLibs);
    string[] mem = _stdlibList(root);
    int mi = 0;
    while (mi < mem.Length) {
        string src = Path.Join(_libsDir(root), mem[mi] + ".zpkg");
        if (File.Exists(src)) { File.Copy(src, Path.Join(fakeLibs, mem[mi] + ".zpkg")); }
        mi = mi + 1;
    }
    File.WriteAllText(Path.Join(fakeLibs, "z42c.core.zpkg"), "INTRUDER");          // 编译器域
    File.WriteAllText(Path.Join(fakeLibs, "z42.workload.ios.zpkg"), "INTRUDER");   // workload
    File.WriteAllText(Path.Join(fakeLibs, "totally.random.zpkg"), "INTRUDER");     // 随便什么
    string hermetic = _xtaskWork(root, "install-test-hermetic");
    _resetDir(hermetic);
    _stgAssert("污染过的 libs 也能装成功", _pkgCopyLibsOf(root, fakeLibs, hermetic) == 0);
    foreach (var f in Directory.Enumerate(Path.Join(hermetic, "libs"))) {
        _stgAssert("入侵者没被带进 libs/ (" + f + ")",
            f != "z42c.core.zpkg" && f != "z42.workload.ios.zpkg" && f != "totally.random.zpkg");
    }

    // 🔴 **编译器域一个都不许出现在 shipped `libs/`**（relocate-compiler-domain-libs 的验收信号）。
    //
    // 这条是从原 `compiler-libs` 自检里**救回来并泛化**的那一半：那块原本有两条成对断言，
    // ①「契约包在 compiler-libs/ 里」随该目录一并删除，而 ②「它**不在** libs/」**依然成立、
    // 而且现在更重要** —— 删机制时顺手把这半也删掉，正是本仓反复吃过的「迁移带走一道活门」。
    // 注释原话：只测①不测②，这门就管不住「哪天有人图省事把它塞进 libs/ 了事」。
    string[] domain = new string[]{ "z42c.core", "z42c.syntax", "z42c.optimization", "z42c.semantics", "z42c.emission", "z42c.pipeline",
                                   "z42c.driver", "z42.package", "z42.project", "z42.build",
                                   "z42.scripting" };
    int di = 0;
    while (di < domain.Length) {
        _stgAssert(domain[di] + " NOT in shipped libs/",
            !File.Exists(Path.Join(pkgDir, Path.Join("libs", domain[di] + ".zpkg"))));
        di = di + 1;
    }

    // 🔴 **workload 包一个都不许出现在 shipped `libs/`**（2026-09-28）。
    //
    // 实测发布包里曾有 `z42.workload.{desktop,ios,android,wasm}.zpkg` 四个 —— 不是有人存心放的，
    // 是它们的清单把 `dist_dir` 指向了 stdlib flat（为了让 launcher 的名字依赖解析得到），
    // 而打包把 flat **整目录**拷进 `libs/`。`libs/` 是用户面的标准库表面，workload 不属于那里。
    //
    // 按**前缀**判而不是列四个名字：下一个 workload 加进来时这门自动管得住它
    // （列名字的门只在有人想起来改它时才成立 —— 那正是「靠约定」）。
    foreach (var f in Directory.Enumerate(Path.Join(pkgDir, "libs"))) {
        _stgAssert("no workload zpkg in shipped libs/ (" + f + ")", !f.StartsWith("z42.workload."));
    }

    // editor-assets: 资产从仓库源码树拷到 editors/<target>/；生成器模板不得进包
    // （*.tpl.json 是 xtask 的输入，出现在用户扩展目录里只会造成困惑）。
    string edDir = Path.Join(pkgDir, "editors/vscode");
    _stgAssert("editors/vscode/package.json exists", File.Exists(Path.Join(edDir, "package.json")));
    _stgAssert("editors/vscode/language-configuration.json exists",
        File.Exists(Path.Join(edDir, "language-configuration.json")));
    _stgAssert("editors/vscode grammar exists",
        File.Exists(Path.Join(edDir, "syntaxes/z42.tmLanguage.json")));
    _stgAssert("generator template NOT packaged",
        !File.Exists(Path.Join(edDir, "syntaxes/z42.tmLanguage.tpl.json")));

    // 失败要响亮（不留半个包当成功）：① kind 装不了（apphost-stub 归 desktop workload）；② apphost 组件缺 z42b 上下文。
    string badDir = _xtaskWork(root, "install-test-bad");
    _resetDir(badDir);
    _PackagesConfig stubCfg = _instConfig("install-test-stub", new string[]{ "apphost-stub" },
        new _PkgComponent[]{ _instComp("apphost-stub", "cargo-bin", "") });
    _stgAssert("apphost-stub 不能装进普通包", _pkgInstallPackage(stubCfg, root, "install-test-stub", badDir, ctx) != 0);
    _PackagesConfig appCfg = _instConfig("install-test-app", new string[]{ "z42b" },
        new _PkgComponent[]{ _instComp("z42b", "apphost", "src/toolchain/builder/core/z42.builder.z42.toml") });
    _stgAssert("apphost 组件缺 z42b 上下文必须报错", _pkgInstallPackage(appCfg, root, "install-test-app", badDir, ctx) != 0);

    Directory.Delete(fakeCargoOut, true);
    Directory.Delete(pkgDir, true);
    Directory.Delete(badDir, true);
    Console.WriteLine("packages-install: PASS (z42vm/native/stdlib/editor-assets installers + hermetic libs + failure paths)");
    return 0;
}
