// xtask — `check packages`: packages.toml self-checks aggregator (simplify-xtask-verify,
// 2026-07-07).
//
// Runs the packages.toml pipeline self-checks in sequence — one command. Each is a plain
// throw-on-mismatch self-check (xtask is an exe, so the [Test]-attribute runner can't discover it):
//   1. _testPackagesConfig    — parse packages.toml + include resolution
//   2. _testPackagesInstall   — install components straight into a package dir（drop-package-staging：
//                               原 staging handler + assembly 两层合一）+ hermetic libs + failure paths
//   3. _testPackagesRelease   — --archive / finalize（命名映射 + 端到端；见 xtask_selfcheck_release.z42）
namespace Z42Xtask;


int _testPackages() {
    int c = _testPackagesConfig();   if (c != 0) { return c; }
    c = _testPackagesInstall();      if (c != 0) { return c; }
    c = _testPackagesRelease();      if (c != 0) { return c; }
    return 0;
}
