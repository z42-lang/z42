// xtask — release packaging (migrate-scripts-to-z42, split-runtime-launcher-packages).
// Desktop pipeline functions live in xtask_package_desktop.z42 (500-line split).
// Same Z42Xtask namespace; calls _exec/_root/_buildCompiler from xtask.z42 (cross-file).
// Desktop builds two artifacts: SDK (z42c+z42vm+libs) + runtime pkg.
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Cli;
using Std.Time;

// ── shared setup / finish (merge-package-release) ───────────────────────────
// Compute pkgDir (z42-<ver>-<rid>-<profile>[-<variant>]) + create bin/libs/native.
string _pkgSetupDir(string root, string rid, string version, string profile, string variant) {
    string pkgName = "z42-" + version + "-" + rid + "-" + profile;
    if (variant.Length > 0) { pkgName = pkgName + "-" + variant; }
    string pkgDir = Path.Join(_packagesDir(root), pkgName);
    Console.WriteLine("Package:    " + pkgName);
    Console.WriteLine("Output:     " + pkgDir);
    Console.WriteLine("Target RID: " + rid + "  (category=" + _ridCategory(rid) + ")");
    Console.WriteLine("Profile:    " + profile);
    Console.WriteLine("");
    if (Directory.Exists(pkgDir)) { Directory.Delete(pkgDir, true); }
    Directory.Create(Path.Join(pkgDir, "bin"));
    Directory.Create(Path.Join(pkgDir, "libs"));
    Directory.Create(Path.Join(pkgDir, "native/include"));
    return pkgDir;
}
// SHA-256 invariant check + success message on an assembled pkgDir.
int _pkgFinish(string root, string pkgDir) {
    Console.WriteLine("");
    Console.WriteLine("SHA-256 invariant check:");
    int c = _pkgSha256Check(root, pkgDir);
    if (c != 0) { ConsoleError.WriteLine("  ✗ SHA-256 invariant FAILED"); return c; }
    Console.WriteLine("  ✓ SHA-256 invariants OK");
    Console.WriteLine("");
    Console.WriteLine("✅ Package assembled: " + pkgDir);
    return 0;
}

// ── package sdk (host SDK only; merge-package-release) ───────────────────────
int _packageSdk(string profile, string variant, bool noBuild) {
    Stopwatch sw = _procStart("package sdk");
    string root = _root();
    string rid = _detectHostRid();
    if (_ridCategory(rid) != "desktop") {
        ConsoleError.WriteLine("package sdk: host RID is not desktop (" + rid + ")"); return 2;
    }
    string version = _versionsGet(root);
    if (version.Length == 0) { ConsoleError.WriteLine("error: versions.toml [project].version missing"); return 1; }
    string pkgDir = _pkgSetupDir(root, rid, version, profile, variant);
    int c = _packageDesktop(root, pkgDir, rid, version, profile, rid, noBuild); if (c != 0) { return c; }
    c = _pkgFinish(root, pkgDir); if (c != 0) { return c; }
    _procEnd("package sdk", sw); return 0;
}

// ── package runtime (native+stdlib; host or platform via rid) ────────────────
int _packageRuntime(string rid, string profile, string variant, bool noBuild) {
    Stopwatch sw = _procStart("package runtime");
    string root = _root();
    string hostRid = _detectHostRid();
    if (rid.Length == 0) { rid = hostRid; }
    string category = _ridCategory(rid);
    string version = _versionsGet(root);
    if (version.Length == 0) { ConsoleError.WriteLine("error: versions.toml [project].version missing"); return 1; }
    if (category == "desktop") {
        // host runtime pack owns its z42-runtime-<rid> dir + finishes internally.
        int rc = _buildRuntimePackage(root, rid, version, profile);
        if (rc == 0) { _procEnd("package runtime", sw); }
        return rc;
    }
    string pkgDir = _pkgSetupDir(root, rid, version, profile, variant);
    int c;
    if (category == "ios")          { c = _packageIos(root, pkgDir, rid, version, profile, hostRid); }
    else if (category == "android") { c = _packageAndroid(root, pkgDir, rid, version, profile, hostRid); }
    else if (category == "wasm")    { c = _packageWasm(root, pkgDir, rid, version, profile, hostRid); }
    else { ConsoleError.WriteLine("package runtime: unknown category '" + category + "' for rid " + rid); return 2; }
    if (c != 0) { return c; }
    c = _pkgFinish(root, pkgDir); if (c != 0) { return c; }
    _procEnd("package runtime", sw); return 0;
}

// ── package workload (build ONE per-RID desktop workload) ────────────────────
int _packageWorkloadBuild(string rid, string profile) {
    Stopwatch sw = _procStart("package workload (build per-RID)");
    string root = _root();
    if (rid.Length == 0) { rid = _detectHostRid(); }
    string version = _versionsGet(root);
    if (version.Length == 0) { ConsoleError.WriteLine("error: versions.toml [project].version missing"); return 1; }
    int c = _buildDesktopWorkload(root, rid, version, profile);
    if (c == 0) { _procEnd("package workload (build per-RID)", sw); }
    return c;
}

// Full host package (SDK + runtime + workload) — internal helper for `test dist`
// (needs a complete host release package). NOT a command anymore; the command layer
// uses the split _packageSdk / _packageRuntime / _packageWorkloadBuild.
int _buildPackageCore(string profile, string rid, string variant, bool noBuild) {
    string root = _root();
    string hostRid = _detectHostRid();
    if (rid.Length == 0) { rid = hostRid; }
    string category = _ridCategory(rid);
    string version = _versionsGet(root);
    if (version.Length == 0) { ConsoleError.WriteLine("error: versions.toml [project].version missing"); return 1; }
    string pkgDir = _pkgSetupDir(root, rid, version, profile, variant);

    int c;
    if (category == "desktop") {
        c = _packageDesktop(root, pkgDir, rid, version, profile, hostRid, noBuild);
        if (c != 0) { return c; }
        c = _buildRuntimePackage(root, rid, version, profile);
        if (c != 0) { return c; }
        c = _buildDesktopWorkload(root, rid, version, profile);
    } else if (category == "ios") {
        c = _packageIos(root, pkgDir, rid, version, profile, hostRid);
    } else if (category == "android") {
        c = _packageAndroid(root, pkgDir, rid, version, profile, hostRid);
    } else if (category == "wasm") {
        c = _packageWasm(root, pkgDir, rid, version, profile, hostRid);
    } else {
        ConsoleError.WriteLine("build package: unknown category '" + category + "' for rid " + rid);
        return 2;
    }
    if (c != 0) { return c; }
    return _pkgFinish(root, pkgDir);
}

// ── RID + version helpers ───────────────────────────────────────────────────

string _detectHostRid() {
    string arch = Platform.Arch();
    if (Platform.IsMacOS())   { if (arch == "x86_64") { return "macos-x64-unsupported"; } return "macos-arm64"; }
    if (Platform.IsWindows()) { return "windows-x64"; }
    // linux
    if (arch == "aarch64" || arch == "arm64") { return "linux-arm64"; }
    return "linux-x64";
}

string _ridCategory(string rid) {
    if (rid.StartsWith("macos-") || rid.StartsWith("linux-") || rid.StartsWith("windows-")) { return "desktop"; }
    if (rid.StartsWith("ios-") || rid.StartsWith("iossim-")) { return "ios"; }
    if (rid.StartsWith("android-")) { return "android"; }
    if (rid == "browser-wasm") { return "wasm"; }
    return "unknown";
}

string _ridToCargo(string rid) {
    if (rid == "macos-arm64")   { return "aarch64-apple-darwin"; }
    if (rid == "linux-arm64")   { return "aarch64-unknown-linux-gnu"; }
    if (rid == "linux-x64")     { return "x86_64-unknown-linux-gnu"; }
    if (rid == "windows-x64")   { return "x86_64-pc-windows-msvc"; }
    if (rid == "ios-arm64")     { return "aarch64-apple-ios"; }
    if (rid == "iossim-arm64")  { return "aarch64-apple-ios-sim"; }
    if (rid == "android-arm64") { return "aarch64-linux-android"; }
    if (rid == "android-x64")   { return "x86_64-linux-android"; }
    if (rid == "browser-wasm")  { return "wasm32-unknown-unknown"; }
    return "";
}

// Read versions.toml [project].version with native Std.Toml (was python3).
string _versionsGet(string root) {
    // shared reader (xtask_versions.z42); "" when versions.toml is absent.
    return _vReadOr(root, "project.version", "");
}

// ── cargo wrappers ──────────────────────────────────────────────────────────

// compile-once host reuse: when building for the HOST rid, pass an EMPTY target so
// cargo reuses the default host build dir (artifacts/build/runtime/<profile>) that
// ci-bootstrap / xtask-bootstrap-artifact already warmed (z42vm + cranelift + deps
// compiled, Swatinem-cached) instead of recompiling everything under a redundant
// --target <host-triple> tree. Cross RIDs (ios/android/wasm) keep their triple.
string _cargoTargetFor(string rid) {
    return (rid == _detectHostRid()) ? "" : _ridToCargo(rid);
}

// The cargo output dir matching _cargoTargetFor: <profile> for host (no triple),
// <triple>/<profile> for cross. All three desktop package functions read from here.
string _cargoOutFor(string root, string rid, string profile) {
    string t = _cargoTargetFor(rid);
    string sub = (t.Length == 0) ? profile : (t + "/" + profile);
    return Path.Join(root, Path.Join("artifacts/build/runtime", sub));
}

int _cargo(bool rel, string verb, string manifest, string target, string pkg) {
    Process p = new Process("cargo").Arg(verb);
    if (rel) { p = p.Arg("--release"); }
    if (pkg.Length > 0) { p = p.Arg("-p").Arg(pkg); }
    p = p.Arg("--manifest-path").Arg(manifest);
    if (target.Length > 0) { p = p.Arg("--target").Arg(target); }   // host: no --target → reuse warm build
    p = p.Arg("--quiet");
    return _exec(p);
}

// cargo rustc --crate-type=X (best-effort: rlib already exists; ignore failure like the .sh).
void _cargoRustc(bool rel, string target, string crateType) {
    Process p = new Process("cargo").Arg("rustc");
    if (rel) { p = p.Arg("--release"); }
    p = p.Arg("--lib").Arg("--crate-type=" + crateType)
        .Arg("--manifest-path").Arg(_runtimeManifest());
    if (target.Length > 0) { p = p.Arg("--target").Arg(target); }
    p = p.Arg("--quiet");
    _exec(p);
}

// ── file assembly helpers ───────────────────────────────────────────────────

// The shared `[package]` header for the workload manifests (desktop / ios / android
// / wasm). Empty rid / buildHost are omitted (desktop has neither). Adding a workload
// manifest field now changes one place instead of four (review §2.5). NOTE: does NOT
// cover the runtime-pkg manifest (`z42-<rid>`, no `kind`) nor the merged release
// manifest — those have distinct shapes and stay inline.
string _workloadPkgHeader(string name, string version, string rid, string profile, string buildHost) {
    string m = "[package]\n"
        + "name        = \"" + name + "\"\n"
        + "kind        = \"workload-tooling\"\n"
        + "version     = \"" + version + "\"\n"
        + "abi-version = 1\n";
    if (rid.Length > 0) { m = m + "rid         = \"" + rid + "\"\n"; }
    m = m + "profile     = \"" + profile + "\"\n"
          + "build-date  = \"" + _utcNow() + "\"\n";
    if (buildHost.Length > 0) { m = m + "build-host  = \"" + buildHost + "\"\n"; }
    return m + "\n";
}

void _copyIfExists(string src, string dst) {
    if (File.Exists(src)) { File.Copy(src, dst); }
}

void _makeExe(string path) {
    if (File.Exists(path)) { File.MakeExecutable(path); }
}

// Mobile/wasm packages don't ship z42c — bin/ gets a placeholder README.
// Shared by _packageAndroid / _packageWasm (ios writes its own inline).
void _pkgEmitBinReadmePlaceholder(string pkgDir, string targetLabel) {
    Directory.Create(Path.Join(pkgDir, "bin"));
    string content = "# bin/\n\n"
        + "Reserved for future cross tools targeting **" + targetLabel + "**\n"
        + "(e.g. z42-aotcross). Mobile / wasm packages do NOT ship the host compiler\n"
        + "(z42c); embed prebuilt .zbc from your host build pipeline.\n"
        + "See memory: project_mobile_no_compiler.\n";
    File.WriteAllText(Path.Join(pkgDir, "bin/README.md"), content);
}

// Copy the desktop VM native libs present in cargoOut into native/. Excludes
// mobile platform facades (libz42_platform_ios/android.*): they can linger stale
// in the shared cargo target dir and do NOT belong in a desktop SDK — they ship
// only in their own mobile runtime packs.
void _copyNativeLibs(string cargoOut, string pkgDir) {
    if (!Directory.Exists(cargoOut)) { return; }
    foreach (var f in Directory.Enumerate(cargoOut)) {
        if (f.StartsWith("libz42_platform")) { continue; }   // mobile facade — not desktop SDK
        // libz42_repl / z42_repl.dll — host-only REPL editor cdylib. Ships in
        // programs/z42i/ (beside the interactive payload), colocated by z42.repl's
        // ProvideNative build hook during publish; found by the repl-specific probe, NOT
        // <sdk>/native/. The hook `cargo build -p z42-repl` lands it in this SHARED
        // cargoOut, so this exclusion still guards against it leaking into <sdk>/native/
        // (where the eager ext scanner would warn `ignoring unknown lib repl`).
        // (add-native-dep-config)
        if (f.StartsWith("libz42_repl") || f.StartsWith("z42_repl")) { continue; }
        bool isLib = f.StartsWith("libz42") || f == "z42.lib" || f == "z42.dll" || f.StartsWith("z42_compression");
        if (isLib && (f.EndsWith(".a") || f.EndsWith(".dylib") || f.EndsWith(".so") || f.EndsWith(".lib") || f.EndsWith(".dll"))) {
            File.Copy(Path.Join(cargoOut, f), Path.Join(pkgDir, "native/" + f));
        }
    }
}

int _pkgCopyLibs(string libsDir, string pkgDir) {
    if (!Directory.Exists(libsDir)) {
        ConsoleError.WriteLine("error: stdlib not built at " + libsDir + "; run build stdlib");
        return 1;
    }
    foreach (var f in Directory.Enumerate(libsDir)) {
        if (f.EndsWith(".zpkg") || f.EndsWith(".zsym")) {
            File.Copy(Path.Join(libsDir, f), Path.Join(pkgDir, "libs/" + f));
        }
    }
    return 0;
}

// ── SHA-256 invariant (native byte compare) ─────────────────────────────────

int _pkgSha256Check(string root, string pkgDir) {
    bool fail = false;
    // 1. libs/* vs the flat dist source of truth
    string libsSrc = _libsDir(root);
    string pkgLibs = Path.Join(pkgDir, "libs");
    if (Directory.Exists(pkgLibs)) {
        foreach (var f in Directory.Enumerate(pkgLibs)) {
            string src = Path.Join(libsSrc, f);
            if (File.Exists(src) && !_filesEqual(Path.Join(pkgLibs, f), src)) {
                ConsoleError.WriteLine("  ✗ libs/" + f + " differs from source"); fail = true;
            }
        }
    }
    // 2. native/include/*.h vs src/runtime/include/ — only when present. Split
    //    (workload-tooling) packages carry no native/include; the headers live in
    //    the separate runtime pack (ios Sources/Z42VMC/include, android z42vm cpp/include).
    if (File.Exists(Path.Join(pkgDir, "native/include/z42_abi.h"))
        && !_filesEqual(Path.Join(pkgDir, "native/include/z42_abi.h"), Path.Join(root, "src/runtime/include/z42_abi.h"))) {
        ConsoleError.WriteLine("  ✗ native/include/z42_abi.h differs"); fail = true;
    }
    if (File.Exists(Path.Join(pkgDir, "native/include/z42_host.h"))
        && !_filesEqual(Path.Join(pkgDir, "native/include/z42_host.h"), Path.Join(root, "src/runtime/include/z42_host.h"))) {
        ConsoleError.WriteLine("  ✗ native/include/z42_host.h differs"); fail = true;
    }
    if (fail) { return 1; }
    return 0;
}

bool _filesEqual(string a, string b) {
    if (!File.Exists(a) || !File.Exists(b)) { return false; }
    byte[] ba = File.ReadAllBytes(a);
    byte[] bb = File.ReadAllBytes(b);
    if (ba.Length != bb.Length) { return false; }
    int i = 0;
    while (i < ba.Length) {
        if (ba[i] != bb[i]) { return false; }
        i = i + 1;
    }
    return true;
}
