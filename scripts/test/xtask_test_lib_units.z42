// xtask — stdlib [Test] unit machinery (split from xtask_test_lib.z42, 2026-06-30,
// for the 500-line code-org limit). Same Z42Xtask namespace; the lib-level
// orchestration (_testLib / _testLibCore / sharding) stays in xtask_test_lib.z42
// and calls these cross-file.
//
// Unit-level layer：**转发 z42b** —— `--list` 拿单元清单，再按 jobs 分批并行拉起
// `z42b <verb> <toml> --name <unit>`（xtask-forward-tests-to-z42b D1/D2）。
// 发现规则、合成清单、单元编译全部在 z42b 那一侧，xtask 只管并行与聚合。
namespace Z42Xtask;

using Std;
using Std.IO;

/// Parent toml's two dep sections, kept separate so the synthetic-manifest
/// writer can emit a single merged [dependencies] block. Stored as
/// (name, version) string pairs to avoid coupling xtask to z42.Project
/// internals.
class DepBundle {
    public string[] Names { get; set; }
    public string[] Versions { get; set; }
    public int Count { get; set; }
}

// _sortedStrings moved to xtask_common.z42 (shared string/collection helpers).

/// True iff any top-level `.z42` file in `dir` declares a `[Test]` method —
/// the marker the z42b discovers via the zpkg's TIDX section.
/// Distinguishes dir-mode [Test] units (e.g. z42.crypto/tests/secp256k1) from
/// Main-based golden cases (which the runner would reject with "no tests found").
bool _dirHasTestMethods(string dir) {
    foreach (var f in Directory.Enumerate(dir)) {
        if (!f.EndsWith(".z42")) { continue; }
        try {
            if (File.ReadAllText(Path.Join(dir, f)).Contains("[Test]")) { return true; }
        } catch (Exception) { /* unreadable → not a test source */ }
    }
    return false;
}

// Parent-toml dep harvest moved to xtask_manifest_targets.z42 (_baseDeps / _targetDeps,
// ManifestLoader-based 3-layer merge; add-tests-bench-manifest-config P2). DepBundle
// (above) stays here — it's the merged (name,version) shape both the harness=true
// synthetic-manifest writer and the new exit-target compiler consume.

/// 曾经这里住着 xtask 自己的执行器：`_runUnitsBatched`（按 jobs 分批并行编译 + 跑）与
/// `_compilePrep`（给每个单元算输出路径、目录单元还要落一份合成 mini-manifest）。D2 起
/// test/bench 全线转发 z42b，两者没有调用方，已删 —— 合成清单不再落盘，发现与执行都只剩
/// z42b 一份。下面的 `_renderSyntheticManifest` 留着，是 embedded golden 还在用
/// （xtask_test_embedded_golden.z42：把一个 golden case 当成微型工程编）。

/// Serialise a synthetic mini-manifest to TOML text. Kept hand-rolled
/// (no Std.Toml serializer round-trip) because the schema is tiny and
/// fixed-shape; this also avoids any quoting / ordering surprises in
/// generated output that diff would flag during reproducibility checks.
string _renderSyntheticManifest(string projName, string includeGlob,
                                 string outputDir, string cacheSubdir, DepBundle deps) {
    string body = "# Auto-generated by xtask test (add-tests-bench-manifest-config Phase 3, 2026-06-06).\n"
        + "# Synthesised per-test mini-manifest; not committed to source control.\n"
        + "# kind=lib: test files don't have Main(); [Test]-annotated methods\n"
        + "# get discovered by the z42b via the produced zpkg's TIDX\n"
        + "# section the same way single-file emit-zbc tests do.\n"
        + "\n"
        + "[project]\n"
        + "name    = \"" + projName + "\"\n"
        + "version = \"0.1.0\"\n"
        + "kind    = \"lib\"\n"
        + "\n"
        + "[sources]\n"
        + "include = [\"" + includeGlob + "\"]\n"
        + "\n"
        + "[build]\n"
        + "# output_dir is xtask-controlled; [[test]] entries cannot override it\n"
        + "# (synthetic manifest is regenerated each run). cache_dir is a per-unit\n"
        + "# subdir so two dir-mode units' source.zbc don't collide; dist_dir is\n"
        + "# omitted → shared ${output_dir}/dist (all <lib>.test.*.zpkg together).\n"
        + "output_dir = \"" + outputDir + "\"\n"
        + "cache_dir  = \"${output_dir}/cache/" + cacheSubdir + "\"\n"
        + "\n"
        + "# Force packed-mode zpkg in both profiles: the in-process VM (and the\n"
        + "# z42b that drives it) can only load packed zpkgs; default\n"
        + "# debug pack=false would land us with an indexed zpkg + scattered .zbc\n"
        + "# files which the runner refuses with `indexed zpkg cannot be loaded\n"
        + "# directly by the VM; use packed mode`.\n";
        // 此处曾写 `[profile.*] pack = true`——**那一直是空操作**：被消费的是
        // `[project].pack`，`Profile.Pack` 从无人读（restructure-profile-sections 已删该
        // 死字段）。删掉是行为等价的；若这些目标真需要 packed，该写进 `[project]`。
    if (deps.Count > 0) {
        body = body + "\n[dependencies]\n";
        int i = 0;
        while (i < deps.Count) {
            body = body + "\"" + deps.Names[i] + "\" = \"" + deps.Versions[i] + "\"\n";
            i = i + 1;
        }
    }
    return body;
}


// ── 转发 z42b（xtask-forward-tests-to-z42b 步骤 D1）────────────────────────────
//
// 旧路径给**每个单元**合成一份 mini-manifest 落盘 → fork 一次 `z42c build` → 再跑产物。
// 新路径把这三步压成一次 `z42b test <真 manifest> --name <unit>`：in-process 编译，父包
// 只建一次、各单元共用缓存。单单元成本约降 3 倍（实测见 proposal ②）。
//
// **并行仍留在这里**：并行测试执行必须分进程（单 VM 内 ModuleLoader 按命名空间去重、
// first-wins），而 z42b 定位不到自己（`__env_args` 只给 `--` 之后的参数）—— xtask 知道
// vm + builder zpkg 路径，所以由它来批量拉起。实测 z42.io 51 单元 8 路并行：31.07s → 11.25s。
//
// 随之消失的还有旧路径那套「编译退 0 但产物缺失」的重试绕行 —— 那个 Heisenbug 出自
// 合成清单的独立编译相位，这条路径上没有独立编译相位。

// 问 z42b 要单元清单（`--list`：只列不跑）。**发现规则从此只有 z42b 一份** —— 两套规则
// 各自漂移正是 #580 查出那三处分歧的来源。ok=false 表示 z42b 自己报错了（调用方判红）。
string[] _listUnitsViaZ42b(string root, string projToml, string kind, string filter,
                           string mode, string vm, string builderZpkg, string libs,
                           ref bool ok) {
    string verb = (kind == "bench") ? "bench" : "test";
    Process p = new Process(vm).Arg("--mode").Arg(mode).Arg(builderZpkg)
        .Arg("--").Arg(verb).Arg(projToml).Arg("--list");
    if (filter.Length > 0) { p = p.Arg("--filter").Arg(filter); }
    ProcessResult r = p.Env("Z42_LIBS", libs).WorkingDirectory(root).Run();
    if (r.ExitCode != 0) {
        ConsoleError.WriteLine("  ❌ z42b " + verb + " --list 失败 (rc=" + r.ExitCode.ToString() + ")");
        ConsoleError.Write(r.Stderr);
        ok = false;
        return new string[0];
    }
    ok = true;
    return _nonEmptyLines(r.Stdout);
}

string[] _nonEmptyLines(string s) {
    string[] raw = s.Split("\n");
    int n = 0;
    int i = 0;
    while (i < raw.Length) { if (raw[i].Trim().Length > 0) { n = n + 1; } i = i + 1; }
    string[] res = new string[n];
    int k = 0;
    i = 0;
    while (i < raw.Length) {
        string t = raw[i].Trim();
        if (t.Length > 0) { res[k] = t; k = k + 1; }
        i = i + 1;
    }
    return res;
}

// 并行跑单元：每 `jobs` 个一批 spawn `z42b <verb> <toml> --name <unit>`，等齐后按批内顺序
// 打印（输出顺序确定，不随调度漂移）。返回失败数。
// agg != null → capture 模式（bench 基线）：要 `--format json`，把每次调用的 TestReport 喂给
// 聚合器而不是原样打印。**转发天然适配**：这条路径是「每单元一次调用」，每次恰好输出一个
// TestReport 对象，正是 `addModuleJson` 期待的形状 —— 不需要多目标合并输出。
//（此前把 bench 挡在转发外，理由是「MicroBenchAgg 要一次一个对象、多目标合并未做」；
// 那是基于「每库一次 z42b」的设想，与实际落地的 --name 形状不符，故本次订正。）
int _runUnitsViaZ42b(string root, string projToml, string[] names, int nUnits, string kind,
                     int jobs, string mode, string vm, string builderZpkg, string libs,
                     string lib, MicroBenchAgg agg) {
    string verb = (kind == "bench") ? "bench" : "test";
    bool capture = (agg != null);
    int failed = 0;
    int i = 0;
    while (i < nUnits) {
        int bsz = jobs;
        if (i + bsz > nUnits) { bsz = nUnits - i; }
        ProcessHandle[] rh = new ProcessHandle[bsz];
        int b = 0;
        while (b < bsz) {
            Process pr = new Process(vm).Arg("--mode").Arg(mode).Arg(builderZpkg)
                .Arg("--").Arg(verb).Arg(projToml).Arg("--name").Arg(names[i + b]);
            if (capture) { pr = pr.Arg("--format").Arg("json"); }
            rh[b] = pr.Env("Z42_LIBS", libs).WorkingDirectory(root).Spawn();
            b = b + 1;
        }
        b = 0;
        while (b < bsz) {
            ProcessResult rr = rh[b].Wait();
            if (capture) {
                // json 模式：即使部分 bench 失败，stdout 仍是一个完整 TestReport（逐条带 status）。
                // 只要能解析就聚合（addModuleJson 只收有 bench_stats 的通过项），让部分失败的
                // 单元仍贡献它通过的那些 —— 与遗留 _runUnitsBatched 的语义逐字一致。
                string outp = rr.Stdout.Trim();
                if (outp.StartsWith("{")) {
                    agg.addModuleJson(outp, lib);
                    string note = (rr.ExitCode != 0) ? " (partial: some benches failed)" : "";
                    Console.WriteLine("  captured " + names[i + b] + note);
                } else {
                    Console.Write(rr.Stdout);
                    if (rr.Stderr.Length > 0) { Console.Write(rr.Stderr); }
                }
            } else {
                Console.Write(rr.Stdout);
                if (rr.Stderr.Length > 0) { Console.Write(rr.Stderr); }
            }
            if (rr.ExitCode != 0) { failed = failed + 1; }
            b = b + 1;
        }
        i = i + bsz;
    }
    return failed;
}
