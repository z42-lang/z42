// xtask — `check fnlines` gate stage（add-fn-line-lint）。
// 函数 / 方法体行数 lint：src/ 下非测试 .z42 / .rs 文件（code-organization.md「函数 / 方法行数」）。
//   > 60 行（硬限）→ 越界，走棘轮判定（新越界 / 继续膨胀 = 红）
//   > 40 行（软限）→ 只计数提示，不参与棘轮、永不变红
// 「行数」= 函数体内（开括号行与闭括号行**之间**）的非空、非注释行数；单行体（`{ … }` 同行收口）计 0。
//
// 为什么要这道门：函数限 40/60 自 code-organization.md 立规起一直是**纯文档、零 lint**，
// 实测（2026-10-18）src/ 下 69 个方法超 60 行硬限（最大 289 行）而无人知晓——
// 又一例「没有测试盯着的约定迟早会烂」。与 `check lines` 同一棘轮形状：先建基线，只许降不许升。
//
// 识别是**文本启发式**（不建 AST——门禁要 host-independent、<1s）：
//   .z42：成员缩进（0 / 4 空格）、含 `(…)`、以 `{` 收尾、非控制流 / 非 lambda（含 `=>`）/ 非 `new …{`
//        的行；签名跨行时向下最多并 6 行到 `)` 所在行。
//   .rs：`fn name(` 起头的签名，到首个以 `{` 收尾的行为止（`;` 收尾 = trait 声明，跳过）。
//   计括号深度前剥掉字符串 / 字符字面量与 `//` 注释，免被 `"{"` 这类字面量骚扰。
// 漏识别只会少算（棘轮更松），不会误红；识别到的体行数与 `wc` 口径一致可人工复核。
// 基线 `scripts/test/fn-limit-baseline.txt`：`path<TAB>name<TAB>lines`，同名重载按文件内出现序加 `#n`。
namespace Z42Xtask;

using Std.IO;
using Std.Time;

int _fnLimitHard() { return 60; }
int _fnLimitSoft() { return 40; }

// 一个方法的度量：键（`<relpath>\t<name>`，重载 `#n`）+ 体行数。
sealed class FnMeasureZ {
    public string Key;
    public int Lines;
    public FnMeasureZ(string key, int lines) { this.Key = key; this.Lines = lines; }
}

// `xtask check fnlines [--update]`
int _testFnLines(bool update) {
    Stopwatch sw = _procStart("check fnlines");
    string root = _root();
    string basePath = Path.Join(root, "scripts/test/fn-limit-baseline.txt");
    string[] files = _lineLintFiles(root);   // 与 `check lines` 同一受检集（排除 tests / bench / 产物）
    string[] over = new string[128]; int[] overN = new int[128]; int oc = 0;
    int scanned = 0; int fns = 0; int softs = 0;
    int i = 0;
    while (i < files.Length) {
        string text = "";
        try { text = File.ReadAllText(files[i]); }
        catch (Exception ex) { ConsoleError.WriteLine("  warn: cannot read " + files[i] + ": " + ex.Message); i = i + 1; continue; }
        scanned = scanned + 1;
        string rel = _relPath(root, files[i]);
        FnMeasureZ[] ms = _fnMeasures(rel, text, files[i].EndsWith(".rs"));
        int m = 0;
        while (m < ms.Length) {
            fns = fns + 1;
            if (ms[m].Lines > _fnLimitHard()) {
                if (oc == over.Length) {
                    string[] b1 = new string[oc * 2]; int[] b2 = new int[oc * 2];
                    int k = 0; while (k < oc) { b1[k] = over[k]; b2[k] = overN[k]; k = k + 1; }
                    over = b1; overN = b2;
                }
                over[oc] = ms[m].Key; overN[oc] = ms[m].Lines; oc = oc + 1;
            } else if (ms[m].Lines > _fnLimitSoft()) {
                softs = softs + 1;
            }
            m = m + 1;
        }
        i = i + 1;
    }
    _sortOverByPath(over, overN, oc);
    if (update) {
        _writeFnBaseline(basePath, over, overN, oc);
        Console.WriteLine("  ✓ baseline rewritten: " + oc.ToString() + " function(s) over " + _fnLimitHard().ToString() + " body lines");
        _procEnd("check fnlines", sw);
        return 0;
    }
    FnMeasureZ[] base = _readFnBaseline(basePath);
    int bc = base.Length;
    string[] bKey = new string[bc]; int[] bN = new int[bc];
    i = 0; while (i < bc) { bKey[i] = base[i].Key; bN[i] = base[i].Lines; i = i + 1; }
    int fails = 0; int warns = 0;
    i = 0;
    while (i < oc) {
        int at = _indexOfStr(bKey, bc, over[i]);
        string shown = over[i].Replace("\t", " :: ");
        if (at < 0) {
            ConsoleError.WriteLine("  ✗ " + shown + ": " + overN[i].ToString() + " body lines (new function over the " + _fnLimitHard().ToString() + "-line hard limit; extract helpers — code-organization.md)");
            fails = fails + 1;
        } else if (overN[i] > bN[at]) {
            ConsoleError.WriteLine("  ✗ " + shown + ": " + overN[i].ToString() + " body lines (baseline " + bN[at].ToString() + " — an over-limit function must not grow; extract helpers)");
            fails = fails + 1;
        } else {
            warns = warns + 1;
        }
        i = i + 1;
    }
    if (warns > 0) { Console.WriteLine("  ⚠ " + warns.ToString() + " known over-limit function(s) in the baseline (not grown)"); }
    if (softs > 0) {
        Console.WriteLine("  ℹ " + softs.ToString() + " function(s) over the " + _fnLimitSoft().ToString()
            + "-line soft limit (advisory only — consider extracting)");
    }
    i = 0;
    while (i < bc) {
        if (_indexOfStr(over, oc, bKey[i]) < 0) {
            Console.WriteLine("  ℹ " + bKey[i].Replace("\t", " :: ") + " is no longer over the limit — run `xtask check fnlines --update` to drop it from the baseline");
        }
        i = i + 1;
    }
    Console.WriteLine("  scanned " + scanned.ToString() + " file(s) / " + fns.ToString() + " function(s): " + oc.ToString()
        + " over " + _fnLimitHard().ToString() + " body lines (" + warns.ToString() + " known, " + fails.ToString() + " new/grown)");
    if (fails > 0) { return 1; }
    Console.WriteLine("  ✓ no new or grown over-limit functions");
    _procEnd("check fnlines", sw);
    return 0;
}

// 文件内全部方法的体行数（启发式，见文件头）。返回数组长度即个数。
FnMeasureZ[] _fnMeasures(string rel, string text, bool isRust) {
    string[] raw = text.Split("\n");
    int n = raw.Length;
    string[] code = new string[n];   // 剥字面量 + 行注释后的「代码形态」，供识别与括号计数
    int i = 0;
    while (i < n) { code[i] = _fnStripLiterals(raw[i]); i = i + 1; }
    FnMeasureZ[] outp = new FnMeasureZ[16]; int oc = 0;
    string[] seen = new string[16]; int[] seenN = new int[16]; int sc = 0;
    i = 0;
    while (i < n) {
        int hdr = isRust ? _fnRsHeaderEnd(code, i, n) : _fnZ42HeaderEnd(code, i, n);   // `{` 所在行号；-1 = 本行不是方法头
        if (hdr < 0) { i = i + 1; continue; }
        string name = _fnNameOf(code[i]);
        // 同名（重载 / 同文件多类）→ `#n` 消歧，键在文件内稳定（按出现序）。
        int sa = _indexOfStr(seen, sc, name);
        if (sa < 0) {
            if (sc == seen.Length) { string[] s1 = new string[sc * 2]; int[] s2 = new int[sc * 2]; int k = 0; while (k < sc) { s1[k] = seen[k]; s2[k] = seenN[k]; k = k + 1; } seen = s1; seenN = s2; }
            seen[sc] = name; seenN[sc] = 1; sc = sc + 1;
        } else {
            seenN[sa] = seenN[sa] + 1;
            name = name + "#" + seenN[sa].ToString();
        }
        int body = _fnBodyLines(raw, code, hdr, n);
        if (oc == outp.Length) { FnMeasureZ[] g = new FnMeasureZ[oc * 2]; int k = 0; while (k < oc) { g[k] = outp[k]; k = k + 1; } outp = g; }
        outp[oc] = new FnMeasureZ(rel + "\t" + name, body); oc = oc + 1;
        i = hdr + 1;   // 从 `{` 下一行继续：局部函数（更深缩进）不会再被当成成员头，嵌套 fn（.rs）各算各的
    }
    FnMeasureZ[] r = new FnMeasureZ[oc];
    i = 0; while (i < oc) { r[i] = outp[i]; i = i + 1; }
    return r;
}

// 体行数：开括号行之后、深度归零的闭括号行之前，非空且不以 `//` 起头的原始行数。
// 同行收口（`{ return x; }`）→ 0。
int _fnBodyLines(string[] raw, string[] code, int hdr, int n) {
    int depth = _fnBraceDelta(code[hdr]);
    if (depth <= 0) { return 0; }
    int body = 0; int j = hdr + 1;
    while (j < n && depth > 0) {
        depth = depth + _fnBraceDelta(code[j]);
        if (depth > 0) {
            string t = raw[j].Trim();
            if (t.Length > 0 && !t.StartsWith("//")) { body = body + 1; }
        }
        j = j + 1;
    }
    return body;
}

int _fnBraceDelta(string codeLine) {
    int d = 0; int i = 0; int len = codeLine.Length;
    while (i < len) {
        char c = codeLine.CharAt(i);
        if (c == '{') { d = d + 1; } else if (c == '}') { d = d - 1; }
        i = i + 1;
    }
    return d;
}

// .z42 方法头：成员缩进（0 / 4 空格）+ 含 `(`、以 `{` 收尾（签名跨行则向下并 ≤6 行到 `)` 行）+
// 非控制流 / 非 lambda / 非 `new …{` / 非类型声明；`(` 前至少两个 token（类型 + 名，或修饰 + 构造器名）。
// 返回 `{` 所在行号；-1 = 不是方法头。
int _fnZ42HeaderEnd(string[] code, int i, int n) {
    string l = code[i];
    int ind = _fnIndent(l);
    if (ind != 0 && ind != 4) { return 0 - 1; }
    string t = l.Trim();
    if (t.Length == 0 || t.StartsWith("}") || t.StartsWith("[") || t.StartsWith("#")) { return 0 - 1; }
    int lp = t.IndexOf('(');
    if (lp <= 0) { return 0 - 1; }
    if (t.IndexOf("=>") >= 0 || t.IndexOf("new ") >= 0 || t.IndexOf("=") >= 0 && t.IndexOf("=") < lp) { return 0 - 1; }
    string head = t.Substring(0, lp).Trim();
    if (_fnIsZ42Keyword(head)) { return 0 - 1; }
    if (head.IndexOf("class ") >= 0 || head.IndexOf("interface ") >= 0 || head.IndexOf("struct ") >= 0
        || head.IndexOf("enum ") >= 0 || head.IndexOf("record ") >= 0 || head.IndexOf("namespace ") >= 0
        || head.IndexOf("delegate ") >= 0) { return 0 - 1; }
    string[] toks = head.Split(" ");
    int tc = 0; int k = 0; while (k < toks.Length) { if (toks[k].Length > 0) { tc = tc + 1; } k = k + 1; }
    if (tc < 2) { return 0 - 1; }
    // 签名可能跨行：找到 `)` 所在行（≤6 行），该行须以 `{` 收尾。
    int j = i; int pd = 0; int steps = 0;
    while (j < n && steps < 7) {
        string cj = code[j];
        int q = 0; while (q < cj.Length) { char c = cj.CharAt(q); if (c == '(') { pd = pd + 1; } else if (c == ')') { pd = pd - 1; } q = q + 1; }
        string tj = cj.Trim();
        if (pd <= 0) {
            if (tj.EndsWith("{")) { return j; }
            return 0 - 1;   // `;`（abstract / extern / 接口声明 / 语句）或表达式体 → 不计
        }
        if (tj.EndsWith(";") || tj.EndsWith("{")) { return 0 - 1; }
        j = j + 1; steps = steps + 1;
    }
    return 0 - 1;
}

// .rs 函数头：本行含 `fn name(`（词边界），向下找首个以 `{` 收尾的行（≤12 行）；途中遇 `;` 收尾 = 声明，跳过。
int _fnRsHeaderEnd(string[] code, int i, int n) {
    string l = code[i];
    string t = l.Trim();
    if (t.StartsWith("}") || t.Length == 0) { return 0 - 1; }
    int at = _fnRsFnKeywordAt(l);
    if (at < 0) { return 0 - 1; }
    int j = i; int steps = 0;
    while (j < n && steps < 13) {
        string tj = code[j].Trim();
        if (tj.EndsWith("{")) { return j; }
        if (tj.EndsWith(";")) { return 0 - 1; }
        j = j + 1; steps = steps + 1;
    }
    return 0 - 1;
}

// `fn ` 关键字位置（前为行首 / 空格 / `)` / `>`，后接标识符起始字符）；-1 = 无。
int _fnRsFnKeywordAt(string l) {
    int from = 0;
    while (from < l.Length) {
        int rel = l.Substring(from, l.Length - from).IndexOf("fn ");
        if (rel < 0) { return 0 - 1; }
        int at = from + rel;
        bool okBefore = at == 0 || l.CharAt(at - 1) == ' ' || l.CharAt(at - 1) == ')' || l.CharAt(at - 1) == '>' || l.CharAt(at - 1) == '\t';
        bool okAfter = at + 3 < l.Length && (_fnIsIdentStart(l.CharAt(at + 3)));
        if (okBefore && okAfter) { return at; }
        from = at + 3;
    }
    return 0 - 1;
}

bool _fnIsIdentStart(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

// 方法名：`(` 前最后一个 token（.rs 取 `fn ` 后的标识符；泛型 `<…>` 剥掉）。运算符方法 → `operator<sym>`。
string _fnNameOf(string codeLine) {
    string t = codeLine.Trim();
    int rs = _fnRsFnKeywordAt(codeLine);
    string head;
    if (rs >= 0) {
        string after = codeLine.Substring(rs + 3, codeLine.Length - rs - 3);
        int e = 0; while (e < after.Length && (_fnIsIdentStart(after.CharAt(e)) || (after.CharAt(e) >= '0' && after.CharAt(e) <= '9'))) { e = e + 1; }
        return after.Substring(0, e);
    }
    int lp = t.IndexOf('(');
    head = lp < 0 ? t : t.Substring(0, lp).Trim();
    int lt = head.IndexOf('<');
    if (lt > 0) { head = head.Substring(0, lt); }
    string[] toks = head.Split(" ");
    string last = "";
    int k = 0; while (k < toks.Length) { if (toks[k].Length > 0) { last = toks[k]; } k = k + 1; }
    int oi = head.IndexOf("operator");
    if (oi >= 0) { return "operator" + last; }
    return last;
}

int _fnIndent(string l) {
    int i = 0; while (i < l.Length && l.CharAt(i) == ' ') { i = i + 1; }
    return i;
}

bool _fnIsZ42Keyword(string head) {
    string[] toks = head.Split(" ");
    string first = ""; int k = 0; while (k < toks.Length) { if (toks[k].Length > 0) { first = toks[k]; break; } k = k + 1; }
    return first == "if" || first == "else" || first == "while" || first == "for" || first == "foreach" || first == "switch"
        || first == "do" || first == "try" || first == "catch" || first == "finally" || first == "lock" || first == "using"
        || first == "return" || first == "throw" || first == "yield" || first == "case" || first == "default";
}

// 剥字符串 / 字符字面量（保留分隔符外的一切）与 `//` 注释：字面量里的括号与 `//` 不再干扰识别与计数。
// `"…"` 跟转义 `\"`；字符字面量只认 `'c'` / `'\c'` 两形（Rust 生命周期 `'a` 不动）。
string _fnStripLiterals(string line) {
    string outp = ""; int i = 0; int len = line.Length;
    while (i < len) {
        char c = line.CharAt(i);
        if (c == '/' && i + 1 < len && line.CharAt(i + 1) == '/') { break; }
        if (c == '"') {
            i = i + 1;
            while (i < len) {
                char d = line.CharAt(i);
                if (d == '\\') { i = i + 2; continue; }
                if (d == '"') { break; }
                i = i + 1;
            }
            outp = outp + "\"\"";
            i = i + 1;
            continue;
        }
        if (c == '\'') {
            if (i + 2 < len && line.CharAt(i + 2) == '\'') { outp = outp + "''"; i = i + 3; continue; }
            if (i + 3 < len && line.CharAt(i + 1) == '\\' && line.CharAt(i + 3) == '\'') { outp = outp + "''"; i = i + 4; continue; }
        }
        outp = outp + line.Substring(i, 1);
        i = i + 1;
    }
    return outp;
}

// 基线格式：每行 `path<TAB>name<TAB>lines`，按 path+name 序；缺文件 = 空基线。
FnMeasureZ[] _readFnBaseline(string path) {
    if (!File.Exists(path)) { return new FnMeasureZ[0]; }
    string[] lines = File.ReadAllText(path).Split("\n");
    FnMeasureZ[] outp = new FnMeasureZ[64]; int c = 0; int i = 0;
    while (i < lines.Length) {
        string l = lines[i].Trim();
        if (l.Length > 0 && !l.StartsWith("#")) {
            string[] f = l.Split("\t");
            if (f.Length == 3) {
                if (c == outp.Length) { FnMeasureZ[] g = new FnMeasureZ[c * 2]; int k = 0; while (k < c) { g[k] = outp[k]; k = k + 1; } outp = g; }
                outp[c] = new FnMeasureZ(f[0] + "\t" + f[1], int.Parse(f[2])); c = c + 1;
            }
        }
        i = i + 1;
    }
    FnMeasureZ[] r = new FnMeasureZ[c];
    i = 0; while (i < c) { r[i] = outp[i]; i = i + 1; }
    return r;
}

void _writeFnBaseline(string path, string[] a, int[] n, int c) {
    string s = "# function-body-line ratchet baseline (xtask check fnlines --update): path<TAB>name<TAB>lines; hard limit " + _fnLimitHard().ToString() + "\n";
    int i = 0;
    while (i < c) { s = s + a[i] + "\t" + n[i].ToString() + "\n"; i = i + 1; }
    File.WriteAllTextAtomic(path, s);
}
