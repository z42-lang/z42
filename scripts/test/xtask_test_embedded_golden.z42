// xtask — embedded test-host：golden → [Test] 归一 + 单元 zbc 发射
//
// 把 src/tests 的 golden case（source.z42 + expected_output.txt）包装成 [Test] 函数，
// and 把 stdlib 的 [Test] 文件/目录发射成 bundle 里的 .zbc 单元。纯「单个 case 怎么变成
// 一个可执行单元」，不含语料枚举与分片。
//
// 从 xtask_test_embedded.z42 拆出（原文件 848 行 = 500 行硬限的 1.7 倍，三个职责混装）。
// 同 Z42Xtask 命名空间，跨文件裸名互调。
namespace Z42Xtask;

using Std.IO;

// Build the shared z42 test-agent → app.zpkg (idempotent: skip if present).
string _ensureTestAgent(string root) {
    string toml = Path.Join(root, "src/toolchain/workload/test/agent/z42.testagent.z42.toml");
    string zpkg = _toolchainZpkg(root, toml);   // 按 toml 的 [build] 解析，不写死
    if (File.Exists(zpkg)) { return zpkg; }
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root, "release");
    string flat = _libsDir(root);   // 纯 stdlib flat：被编的东西只用 stdlib，driver 自包含（不需要 alllibs）
    Console.WriteLine("  build test-agent → z42.testagent.zpkg");
    int c = _exec(_z42cProc(vm, flat, driver)
        .Arg("build").Arg(toml).Arg("--release"));
    if (c != 0) { return ""; }
    return zpkg;
}

// ── golden → [Test] 归一 (wire-embedded-testhost G1) ─────────────────────────
//
// A golden case is a whole program (source.z42 [+ expected_output.txt]). To run
// it through the single Runner path, generate a [Test] wrapper in the SAME
// module that captures Main()'s stdout and asserts it equals the expected output
// (or, when there is no expected file, just runs Main — Assert-self-validating).
// Proven approach: combine golden source + injected `using Std.Test;` + appended
// [Test] → one module with a [Test] the agent runs like any other.

// Escape a string for embedding as a z42 double-quoted literal.
string _zEscape(string s) {
    string o = s.Replace("\\", "\\\\");
    o = o.Replace("\"", "\\\"");
    o = o.Replace("\r", "");
    o = o.Replace("\n", "\\n");
    return o;
}

// Build the combined golden+wrapper source. Injects `using Std.Test;` after the
// `namespace ...;` line if present, else at the top; appends the [Test] wrapper.
string _wrapGoldenSource(string src, bool hasExpected, string expected) {
    string inject = "using Std.Test;\n";
    string body;
    string[] lines = src.Split("\n");
    int nsIdx = -1;
    for (int i = 0; i < lines.Length; i = i + 1) {
        if (lines[i].Trim().StartsWith("namespace ")) { nsIdx = i; break; }
    }
    if (nsIdx < 0) {
        body = inject + src;
    } else {
        string head = "";
        for (int i = 0; i <= nsIdx; i = i + 1) { head = head + lines[i] + "\n"; }
        string tail = "";
        for (int i = nsIdx + 1; i < lines.Length; i = i + 1) {
            tail = tail + lines[i];
            if (i + 1 < lines.Length) { tail = tail + "\n"; }
        }
        body = head + inject + tail;
    }
    // Use short names (TestIO / Assert) via the injected `using Std.Test;` —
    // fully-qualified `Std.Test.TestIO` parses as a field-access chain (→ Null).
    string wrapper;
    if (hasExpected) {
        wrapper = "\n[Test] void __golden_check() {\n"
            + "    string __c = TestIO.captureStdout(() => { Main(); });\n"
            + "    Assert.Equal(\"" + _zEscape(expected.TrimEnd()) + "\", __c.TrimEnd());\n}\n";
    } else {
        // Assert-self-validating golden: Main throws on failure.
        wrapper = "\n[Test] void __golden_check() { Main(); }\n";
    }
    return body + wrapper;
}

// Build a golden case dir (<caseDir>/source.z42 [+ expected_output.txt]) into a
// [Test]-wrapped .zbc. Returns the .zbc path ("" on failure).
string _buildGoldenCase(string root, string caseDir) {
    string src = Path.Join(caseDir, "source.z42");
    if (!File.Exists(src)) { ConsoleError.WriteLine("error: no source.z42 in " + caseDir); return ""; }
    string srcText = File.ReadAllText(src);
    string expPath = Path.Join(caseDir, "expected_output.txt");
    bool hasExp = File.Exists(expPath);
    string exp = hasExp ? File.ReadAllText(expPath) : "";
    string combined = _wrapGoldenSource(srcText, hasExp, exp);

    string outDir = _workOut(root, "src/toolchain/workload/test", "");
    Directory.Create(outDir);
    string name = Path.GetFileName(caseDir);
    string wrappedSrc = Path.Join(outDir, name + ".golden.z42");
    File.WriteAllText(wrappedSrc, combined);
    string zbc = Path.Join(outDir, name + ".golden.zbc");
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root, "release");
    string flat = _libsDir(root);   // 纯 stdlib flat：被编的东西只用 stdlib，driver 自包含（不需要 alllibs）
    int c = _exec(_z42cProc(vm, flat, driver)
        .Arg("--emit-zbc").Arg(wrappedSrc).Arg(zbc));
    if (c != 0) { return ""; }
    return zbc;
}

// ── test-bundle 构建 (G2) ────────────────────────────────────────────────────
//
// Enumerate the corpus → compile each case to a .zbc (golden→[Test] wrapped;
// stdlib [Test] unit→direct emit) → copy into a bundle dir + write manifest.json
// (name→zbc). Build-time `filter` (substring; empty=all) bounds what's compiled
// so `--case`/`--filter` don't compile the whole corpus for a single run.

string _bundleSafeName(string name) {
    return name.Replace("/", "__").Replace(".", "_");
}

// Emit a stdlib [Test] unit (single .z42) → .zbc in `bundleDir`. Returns "" on fail.
string _emitUnitZbc(string root, string unitSrc, string safe, string bundleDir) {
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root, "release");
    string flat = _libsDir(root);   // 纯 stdlib flat：被编的东西只用 stdlib，driver 自包含（不需要 alllibs）
    string zbc = Path.Join(bundleDir, safe + ".zbc");
    int c = _exec(_z42cProc(vm, flat, driver)
        .Arg("--emit-zbc").Arg(unitSrc).Arg(zbc));
    if (c != 0) { return ""; }
    return zbc;
}

// Build a DIR-mode stdlib [Test] unit (tests/<name>/ with helper .z42 files, or
// an own manifest) into a packed .zpkg, then copy it into `bundleDir`. Reuses
// the host runner's `_renderSyntheticManifest` (same build path as `test lib`,
// no duplication) with empty deps — Z42_LIBS=flat resolves every `using`, same
// as single-file `--emit-zbc`. Returns the copied path ("" on failure).
string _emitDirUnit(string root, string lib, string name, string dirPath, string safe, string bundleDir) {
    string projName = lib + ".test." + name;
    string outDir = Path.Join(_workOut(root, "src/toolchain/workload/test", ""), "dm/" + projName);
    Directory.Create(outDir);
    // Synthetic toml written NEXT TO the sources (glob is manifest-relative);
    // dot-prefixed + unique so it's git-ignored and won't collide.
    string toml = Path.Join(dirPath, ".xtask-embed-" + projName + ".z42.toml");
    File.WriteAllText(toml, _renderSyntheticManifest(projName, "**/*.z42", outDir, name, _newBundle()));
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root, "release");
    string flat = _libsDir(root);   // 纯 stdlib flat：被编的东西只用 stdlib，driver 自包含（不需要 alllibs）
    int c = _exec(_z42cProc(vm, flat, driver)
        .Arg("build").Arg(toml).Arg("--release"));
    File.Delete(toml);   // clean up the synthetic manifest regardless of outcome
    if (c != 0) { return ""; }
    string produced = Path.Join(outDir, "dist/" + projName + ".zpkg");
    if (!File.Exists(produced)) { return ""; }
    string dest = Path.Join(bundleDir, safe + ".zpkg");
    File.Copy(produced, dest);
    return dest;
}

// Read a golden's expected_output.txt (or "" when absent = expect empty stdout).
string _readExpected(string path) {
    if (File.Exists(path)) { return File.ReadAllText(path); }
    return "";
}

// Compile a golden source (no [Test] wrap) → <safe>.zbc + write <safe>.expected
// sibling; return its manifest JSON entry, or "" on compile failure (e.g.
// compile-fail goldens — skipped, they aren't runnable-in-embed). Shared by the
// dir / flat / lib golden enumerations. Direct-run: agent runs it isolated.
string _goldenEntry(string root, string caseName, string src, string expTxt, string bundleDir) {
    string safe = _bundleSafeName(caseName);
    string zbc = _emitUnitZbc(root, src, safe, bundleDir);
    if (zbc.Length == 0) { return ""; }
    string entry = _deriveEntry(src);
    File.WriteAllText(Path.Join(bundleDir, safe + ".expected"), expTxt);
    return "    {\"name\": \"" + caseName + "\", \"zbc\": \"" + safe + ".zbc\", "
        + "\"entry\": \"" + entry + "\", \"expected\": \"" + safe + ".expected\"}";
}

