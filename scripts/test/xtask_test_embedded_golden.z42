// xtask — embedded test-host：golden → [Test] 归一 + 单元 zbc 发射
//
// 「单个 case 怎么变成一个可执行单元」：golden 编成 .zbc（直接跑或包成 [Test]），stdlib 的 [Test]
// 文件 / 目录发射成 bundle 里的 .zbc / .zpkg。语料枚举与分片在 xtask_test_embedded_corpus.z42。
namespace Z42Xtask;

using Std.IO;

// The release z42c driver over the pure stdlib flat (what is compiled here uses only stdlib; the
// driver is self-contained).
Process _releaseZ42c(string root) {
    return _z42cProc(_builtVm(root, "release"), _libsDir(root), _driverZpkg(root, "release"));
}

// Build the shared z42 test-agent → app.zpkg (idempotent: skip if present).
string _ensureTestAgent(string root) {
    string toml = Path.Join(root, "src/toolchain/workload/test/agent/z42.testagent.z42.toml");
    string zpkg = _toolchainZpkg(root, toml);   // 按 toml 的 [build] 解析，不写死
    if (File.Exists(zpkg)) { return zpkg; }
    Console.WriteLine("  build test-agent → z42.testagent.zpkg");
    int c = _exec(_releaseZ42c(root).Arg("build").Arg(toml).Arg("--release"));
    if (c != 0) { return ""; }
    return zpkg;
}

// ── golden → [Test] 归一（`test app desktop --zbc <golden-dir>`）──────────────
//
// A golden case is a whole program (source.z42 [+ expected_output.txt]). To run it
// through the [Test] runner, generate a wrapper in the SAME module that captures
// Main()'s stdout and asserts it equals the expected output (or, when there is no
// expected file, just runs Main — Assert-self-validating).

// Escape a string for embedding as a z42 double-quoted literal.
string _zEscape(string s) {
    string o = s.Replace("\\", "\\\\");
    o = o.Replace("\"", "\\\"");
    o = o.Replace("\r", "");
    o = o.Replace("\n", "\\n");
    return o;
}

// Build the combined golden+wrapper source. Injects `using Std.Harness;` after the
// `namespace ...;` line if present, else at the top; appends the [Test] wrapper.
string _wrapGoldenSource(string src, bool hasExpected, string expected) {
    string inject = "using Std.Harness;\n";
    string body = inject + src;
    int off = 0;   // offset just past the current line's "\n"
    foreach (var line in src.Split("\n")) {
        off = off + line.Length + 1;
        if (!line.Trim().StartsWith("namespace ")) { continue; }
        if (off > src.Length) { src = src + "\n"; }   // namespace is the unterminated last line
        body = src.Substring(0, off) + inject + src.Substring(off);
        break;
    }
    // Use short names (TestIO / Assert) via the injected `using Std.Harness;` —
    // fully-qualified `Std.Harness.TestIO` parses as a field-access chain (→ Null).
    string wrapper;
    if (hasExpected) {
        wrapper = "\n[Test] void __golden_check() {\n"
            + "    string __c = TestIO.captureStdout(() => { Main(); });\n"
            + "    Assert.Equal(\"" + _zEscape(expected.TrimEnd()) + "\", __c.TrimEnd());\n}\n";
    } else {
        // Assert-self-validating golden: Main throws on failure.
        wrapper = "\n[Test] void __golden_check() { Main(); }\n";
    }
    return body + wrapper;
}

// Build a golden case dir (<caseDir>/source.z42 [+ expected_output.txt]) into a
// [Test]-wrapped .zbc. Returns the .zbc path ("" on failure).
string _buildGoldenCase(string root, string caseDir) {
    string src = Path.Join(caseDir, "source.z42");
    if (!File.Exists(src)) { ConsoleError.WriteLine("error: no source.z42 in " + caseDir); return ""; }
    string srcText = File.ReadAllText(src);
    string expPath = Path.Join(caseDir, "expected_output.txt");
    bool hasExp = File.Exists(expPath);
    string exp = hasExp ? File.ReadAllText(expPath) : "";
    string combined = _wrapGoldenSource(srcText, hasExp, exp);

    string outDir = _workOut(root, "src/toolchain/workload/test", "");
    Directory.Create(outDir);
    string name = Path.GetFileName(caseDir);
    string wrappedSrc = Path.Join(outDir, name + ".golden.z42");
    File.WriteAllText(wrappedSrc, combined);
    string zbc = Path.Join(outDir, name + ".golden.zbc");
    Process proc = _releaseZ42c(root).Arg("--emit-zbc").Arg(wrappedSrc).Arg(zbc);
    if (File.Exists(Path.Join(caseDir, "opt_all"))) { proc = proc.Arg("--opt-all"); }   // same as the host gate
    int c = _exec(proc);
    if (c != 0) { return ""; }
    return zbc;
}

// ── bundle 单元发射 ─────────────────────────────────────────────────────────

string _bundleSafeName(string name) {
    return name.Replace("/", "__").Replace(".", "_");
}

// DIR-mode stdlib [Test] unit（tests/<name>/ 带 helper .z42）编成 packed .zpkg：先写合成清单（_dirUnitManifest），
// `z42c build <toml> --release`，再拷出产物（_copyDirUnit）。合成清单不带 deps——Z42_LIBS=flat 解析每个
// `using`，与单文件 `--emit-zbc` 一致。拆成两半是为了让 bundle 构建能并发 spawn 中间那步。
string _dirUnitProj(string lib, string name) { return lib + ".test." + name; }

string _dirUnitOut(string root, string projName) {
    return Path.Join(_workOut(root, "src/toolchain/workload/test", ""), "dm/" + projName);
}

// 写合成清单，返回其路径。清单写在**源码旁边**（glob 相对清单）；点开头且按工程名唯一——git 忽略、不互撞。
string _dirUnitManifest(string root, string lib, string name, string dirPath) {
    string projName = _dirUnitProj(lib, name);
    string outDir = _dirUnitOut(root, projName);
    Directory.Create(outDir);
    string toml = Path.Join(dirPath, ".xtask-embed-" + projName + ".z42.toml");
    File.WriteAllText(toml, _renderSyntheticManifest(projName, "**/*.z42", outDir, name));
    return toml;
}

// build 成功后把产物拷进 bundleDir，返回拷出的路径（产物不在 = ""）。
string _copyDirUnit(string root, string lib, string name, string safe, string bundleDir) {
    string projName = _dirUnitProj(lib, name);
    string produced = Path.Join(_dirUnitOut(root, projName), "dist/" + projName + ".zpkg");
    if (!File.Exists(produced)) { return ""; }
    string dest = Path.Join(bundleDir, safe + ".zpkg");
    File.Copy(produced, dest);
    return dest;
}

// Read a golden's expected_output.txt (or "" when absent = expect empty stdout).
string _readExpected(string path) {
    if (File.Exists(path)) { return File.ReadAllText(path); }
    return "";
}

// 已编好的 golden（<safe>.zbc 在 bundleDir）：写 <safe>.expected 旁车，返回 manifest 条目。
string _goldenEntryFor(string caseName, string src, string expTxt, string safe, string bundleDir) {
    string entry = _deriveEntry(src);
    File.WriteAllText(Path.Join(bundleDir, safe + ".expected"), expTxt);
    return "    {\"name\": \"" + caseName + "\", \"zbc\": \"" + safe + ".zbc\", "
        + "\"entry\": \"" + entry + "\", \"expected\": \"" + safe + ".expected\"}";
}

