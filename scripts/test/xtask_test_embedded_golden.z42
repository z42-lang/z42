// xtask — embedded test-host：golden / 单元 zbc 发射（+ `--zbc <golden-dir>` 的一例 bundle）
//
// 「单个 case 怎么变成一个可执行单元」：golden 编成 .zbc（隔离直接跑、比对 stdout），stdlib 的 [Test]
// 文件 / 目录发射成 bundle 里的 .zbc / .zpkg。语料枚举与分片在 xtask_test_embedded_corpus.z42。
namespace Z42Xtask;

using Std.IO;

// The release z42c driver over the pure stdlib flat (what is compiled here uses only stdlib; the
// driver is self-contained).
Process _releaseZ42c(string root) {
    return _z42cProc(_builtVm(root, "release"), _libsDir(root), _driverZpkg(root, "release"));
}

// Build the shared z42 test-agent → app.zpkg (idempotent: skip if present).
string _ensureTestAgent(string root) {
    string toml = Path.Join(root, "src/toolchain/workload/test/agent/z42.testagent.z42.toml");
    string zpkg = _toolchainZpkg(root, toml);   // 按 toml 的 [build] 解析，不写死
    if (File.Exists(zpkg)) { return zpkg; }
    Console.WriteLine("  build test-agent → z42.testagent.zpkg");
    int c = _exec(_releaseZ42c(root).Arg("build").Arg(toml).Arg("--release"));
    if (c != 0) { return ""; }
    return zpkg;
}

// ── 单个 golden 用例 → 一例 bundle（`test app desktop --zbc <golden-dir>`）──────
//
// 与语料 bundle 里的 golden 走同一条路（_goldenEntry + BundleRunner）：source.z42 原样编成 .zbc，
// 在隔离 VM 里直接跑入口、比对 stdout 与 expected_output.txt（没有则期望空输出）；`opt_all`、
// `// requires-caps:` 同样生效。golden 不包成 [Test] 交给 Runner：那样跑在共享 VM 里、与语料的隔离跑
// 不同口径（且反射发现把 `__` 前缀函数当编译器合成物滤掉，生成的包装函数名还得避开这个约定）。
// 返回 manifest.json 路径（"" = 失败）。
string _buildGoldenBundle(string root, string caseDir) {
    string src = Path.Join(caseDir, "source.z42");
    if (!File.Exists(src)) { ConsoleError.WriteLine("error: no source.z42 in " + caseDir); return ""; }
    _CorpusCase c = new _CorpusCase();
    string dir = caseDir;
    while (dir.Length > 1 && dir.EndsWith("/")) { dir = dir.Substring(0, dir.Length - 1); }
    c.name = Path.GetFileName(Path.GetDirectoryName(dir)) + "/" + Path.GetFileName(dir);
    c.kind = "golden"; c.src = src; c.dir = dir;
    c.exp = _readExpected(Path.Join(dir, "expected_output.txt"));
    c.optAll = File.Exists(Path.Join(dir, "opt_all"));

    string bundleDir = Path.Join(_workOut(root, "src/toolchain/workload/test", ""), "golden-bundle");
    Directory.Create(bundleDir);
    _cleanGlob(bundleDir, "*.zbc");
    string entry = _goldenEntry(root, c.name, c.src, c.exp, bundleDir, c.optAll);
    if (entry.Length == 0) { return ""; }
    return _writeBundleManifest(bundleDir, _withRequires(entry, _caseRequires(c)));
}

// Write `<bundleDir>/manifest.json` around the already-joined case entries; returns its path.
string _writeBundleManifest(string bundleDir, string items) {
    string mpath = Path.Join(bundleDir, "manifest.json");
    File.WriteAllText(mpath, "{\n  \"cases\": [\n" + items + "\n  ]\n}\n");
    return mpath;
}

// ── bundle 单元发射 ─────────────────────────────────────────────────────────

string _bundleSafeName(string name) {
    return name.Replace("/", "__").Replace(".", "_");
}

// Emit a single .z42 (stdlib [Test] unit / golden) → .zbc in `bundleDir`. Returns "" on fail.
// `optAll`: the golden's `opt_all` sidecar → `--opt-all`, exactly as the host golden gate
// compiles it — otherwise the bundle silently runs opt_all cases unoptimized (and any
// assertion that depends on an optimization's observable effect diverges).
string _emitUnitZbc(string root, string unitSrc, string safe, string bundleDir, bool optAll) {
    string zbc = Path.Join(bundleDir, safe + ".zbc");
    Process proc = _releaseZ42c(root).Arg("--emit-zbc").Arg(unitSrc).Arg(zbc);
    if (optAll) { proc = proc.Arg("--opt-all"); }
    int c = _exec(proc);
    if (c != 0) { return ""; }
    return zbc;
}

// Build a DIR-mode stdlib [Test] unit (tests/<name>/ with helper .z42 files) into a
// packed .zpkg, then copy it into `bundleDir`. Synthetic manifest (_renderSyntheticManifest)
// without deps — Z42_LIBS=flat resolves every `using`,
// same as single-file `--emit-zbc`. Returns the copied path ("" on failure).
string _emitDirUnit(string root, string lib, string name, string dirPath, string safe, string bundleDir) {
    string projName = lib + ".test." + name;
    string outDir = Path.Join(_workOut(root, "src/toolchain/workload/test", ""), "dm/" + projName);
    Directory.Create(outDir);
    // Synthetic toml written NEXT TO the sources (glob is manifest-relative);
    // dot-prefixed + unique so it's git-ignored and won't collide.
    string toml = Path.Join(dirPath, ".xtask-embed-" + projName + ".z42.toml");
    File.WriteAllText(toml, _renderSyntheticManifest(projName, "**/*.z42", outDir, name));
    int c = _exec(_releaseZ42c(root).Arg("build").Arg(toml).Arg("--release"));
    File.Delete(toml);   // clean up the synthetic manifest regardless of outcome
    if (c != 0) { return ""; }
    string produced = Path.Join(outDir, "dist/" + projName + ".zpkg");
    if (!File.Exists(produced)) { return ""; }
    string dest = Path.Join(bundleDir, safe + ".zpkg");
    File.Copy(produced, dest);
    return dest;
}

// Read a golden's expected_output.txt (or "" when absent = expect empty stdout).
string _readExpected(string path) {
    if (File.Exists(path)) { return File.ReadAllText(path); }
    return "";
}

// Compile a golden source (no [Test] wrap) → <safe>.zbc + write <safe>.expected
// sibling; return its manifest JSON entry, or "" on compile failure (e.g.
// compile-fail goldens — they aren't runnable-in-embed). Direct-run: the agent runs
// it isolated, no [Test] wrap.
string _goldenEntry(string root, string caseName, string src, string expTxt, string bundleDir, bool optAll) {
    string safe = _bundleSafeName(caseName);
    string zbc = _emitUnitZbc(root, src, safe, bundleDir, optAll);
    if (zbc.Length == 0) { return ""; }
    string entry = _deriveEntry(src);
    File.WriteAllText(Path.Join(bundleDir, safe + ".expected"), expTxt);
    return "    {\"name\": \"" + caseName + "\", \"zbc\": \"" + safe + ".zbc\", "
        + "\"entry\": \"" + entry + "\", \"expected\": \"" + safe + ".expected\"}";
}

