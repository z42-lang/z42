// xtask — multi-exe e2e runner. Each case under
// src/compiler/z42c.pipeline/tests/fixtures/multi-exe/<name>/ is ONE project whose z42.toml declares N `[[exe]]`
// targets sharing `[sources]`. We build it once (z42c produces dist/<exe>.zpkg
// per target — the compile-once-restamp path), then run EACH produced zpkg
// through z42vm, concatenate stdout in sorted (by zpkg path) order, and diff
// against expected_output.txt. Build/run helpers are shared with cross-zpkg
// (xtask_test_cross.z42).
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

// 构建前置与 cross-zpkg 共用 _ensureFixtureToolchain（test/xtask_test.z42）。
int _testMultiExeCore(string mode, bool noBuild) {
    int c = _ensureFixtureToolchain(noBuild); if (c != 0) { return c; }
    return _testMultiExeImpl(mode);
}

// Returns 0 if every multi-exe case passes, 1 on any failure (or setup error).
int _testMultiExeImpl(string mode) {
    string root = _root();
    if (!Directory.Exists(Path.Join(root, "src/compiler/z42c.pipeline/tests/fixtures/multi-exe"))) { return 0; }   // no cases → clean skip
    // 在 build/ 镜像的拷贝上编 / 跑，源码树零写入（同 cross-zpkg）。
    string testsDir = _stageFixtureTree(root, "src/compiler/z42c.pipeline/tests/fixtures/multi-exe");

    // Same toolset + VM-role split as cross-zpkg (_resolveToolset, common/xtask_toolset.z42):
    // compile on the release vm, run each exe zpkg on the debug vm (keeps debug-assertions +
    // overflow-checks coverage on real execution; compiling on debug adds no coverage).
    ToolsetZ ts = _resolveToolset(root);
    if (!ts.Ok) { return 1; }
    string stdlibDist = ts.StdlibDist;
    string compileVm  = ts.CompileVm;
    string runVm      = ts.RunVm;
    string driverZpkg = ts.DriverZpkg;

    int pass = 0;
    List<string> failures = new List<string>();
    foreach (var name in _enumDirsSorted(testsDir)) {
        string dir = Path.Join(testsDir, name);
        if (File.Exists(Path.Join(dir, "expected_output.txt"))) {
            Console.WriteLine("── MultiExe: " + name + " ──");
            string failLabel = _runOneMultiExe(compileVm, runVm, driverZpkg, stdlibDist, dir, name, mode);
            if (failLabel.Length == 0) { pass = pass + 1; } else { failures.Add(failLabel); }
        }
    }
    return _crossSummary(pass, failures.Count, failures.ToArray(), failures.Count);
}

// Build the ONE project (→ dist/<exe>.zpkg per `[[exe]]`), then run each produced
// zpkg and diff the concatenated (sorted-by-path) stdout against expected. The
// expected file lists each exe's output in sorted-by-zpkg-name order.
string _runOneMultiExe(string compileVm, string runVm, string driverZpkg, string stdlibDist, string dir, string name, string mode) {
    string toml = _findToml(dir);
    if (toml.Length == 0 || !_invokeBuildCompiler(compileVm, driverZpkg, stdlibDist, dir, toml)) {
        Console.WriteLine("    build failed");
        return name + " (build)";
    }
    string distDir = _fixtureDist(dir);
    string[] zpkgs = Path.GlobRecursive(distDir, "*.zpkg");
    if (zpkgs.Length < 2) {
        Console.WriteLine("    expected ≥2 exe zpkgs (one per [[exe]]), got " + zpkgs.Length.ToString());
        return name + " (zpkg count)";
    }
    _sortStrings(zpkgs);   // deterministic run order = sorted by path

    // Per-run libs dir: stdlib only (multi-exe fixtures declare no local deps).
    string testLibs = File.CreateTempDir("z42-mexe-");
    _copyStdlibZpkgs(stdlibDist, testLibs);

    string actual = "";
    bool runErr = false;
    foreach (var z in zpkgs) {
        try {
            ProcessResult vr = _z42Proc(runVm, testLibs)
                .Arg(z)
                .Arg("--mode").Arg(mode)
                .Run();
            actual = actual + vr.Stdout + vr.Stderr;
        } catch (Exception e) {
            runErr = true;
        }
    }
    Directory.Delete(testLibs, true);

    string expected = File.ReadAllText(Path.Join(dir, "expected_output.txt"));
    if (!runErr && actual == expected) {
        Console.WriteLine("  PASS (" + zpkgs.Length.ToString() + " exe)");
        return "";
    }
    Console.WriteLine("  FAIL");
    Console.WriteLine("    expected: " + _firstLines(expected, 4));
    Console.WriteLine("    actual:   " + _firstLines(actual, 4));
    return name;
}
