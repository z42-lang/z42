// CI 内嵌 shell 的「先用后赋」门。
//
// ## 守的是什么
//
// `.github/**` yml 里的多行 `run:` 块是真正的 CI 引导逻辑（`ci-bootstrap` 那段：下载种子、两代自举、
// 编 xtask / z42c / stdlib），都以 `set -euo pipefail` 开头 ⇒ **引用一个还没赋值的变量 = 当场 exit 1**。
// 这类错只在 CI 上暴露、代价一整轮 CI，本地手拼的命令覆盖不到它，`bash -n` 也只查语法。
// 本门把「那段 bash 的变量顺序」变成本地一秒能查的东西。
//
// ## 判据
//
// 每个 `run:` 块是**一个独立的 shell 作用域**（GitHub 每步起一个新 shell）。块内按行序走：
// 某处用了 `$X` / `${X}`，而 `X` 的首次赋值在**更晚的行**或**根本没有** ⇒ 红。
//
// 刻意**不判**以下形态（它们不会触发 `set -u`，判了就是误报）：
//   · `${X:-d}` / `${X-d}` / `${X:+d}` / `${X+d}` / `${X:?msg}` —— 带默认/替代，未设也安全；
//   · `${{ ... }}` —— GitHub 表达式，在 shell 看到之前就被替换掉了；
//   · `$1` `$@` `$*` `$?` `$$` `$!` `$#` `$-` `$_` —— 位置/特殊参数；
//   · `_csEnvNames()` 里列的环境变量 —— runner 或上层 `env:` 提供，不在脚本里赋值。
//
// ## ⚠️ 覆盖边界（写在这里，别让它变成隐形假保障）
//
// 扫 `.github/**` 全部 yml（composite action 清单 + workflow）。**只扫多行块（`run: |`），不扫单行
// `run: cmd`**：单行里不存在「顺序」问题，而「从未赋值」那一半在单行上几乎只会命中 runner 环境变量 ⇒
// 全是误报。⭐ 「会误报所以不扫」这种话，先跑一遍数出来再说。
//
// ⇒ 本门是「CI 内嵌 shell **不会在某一行踩 unbound 而当场 exit 1**」的保障，**不是**「这些 shell
// 写得对」的保障（引号/分词/退出码传播都不在判据里；拼错的变量名会顺带抓到）。
//
// 🔴 **空门守卫**：扫不到任何 yml、或一个多行块都没有 ⇒ **判红**。否则哪天引导脚本搬了家，
// 这道门会安静地变成「0 个块全部通过」。
//
// ⭐ 为什么不直接调 `shellcheck`：它**不在 GREEN 的依赖面里**，「装了才跑、没装就过」就是假门。
// 这道门用纯文本扫描，零外部依赖、必然会跑。想额外跑 shellcheck 的人手动跑。

namespace Z42Xtask;

using Std.IO;
using Std.Collections;

// 扫描根：`.github/` 整个（composite action 清单 + workflow）。见头注「覆盖边界」。
string _csScanDir(string root) { return Path.Join(root, ".github"); }

// runner / 上层 `env:` 提供的环境变量 —— 脚本里不赋值也能用。
// 🔴 **加进来之前先确认它真是环境提供的**：把一个「本该在脚本里赋值」的名字放进来 = 亲手
// 挖一个洞。本表刻意短，缺了就让门报出来、逐个判断再加。
string[] _csEnvNames() {
    return new string[]{
        "PWD", "HOME", "PATH", "TMPDIR", "USER", "SHELL", "OSTYPE", "LANG",
        "TERM", "IFS", "RANDOM", "LINENO", "FUNCNAME", "BASH_SOURCE", "PIPESTATUS", "SECONDS",
        "CI", "RUNNER_TEMP", "RUNNER_OS", "RUNNER_ARCH", "RUNNER_TOOL_CACHE",
        "GITHUB_WORKSPACE", "GITHUB_ENV", "GITHUB_OUTPUT", "GITHUB_PATH", "GITHUB_STEP_SUMMARY", "GITHUB_TOKEN",
        "GITHUB_SHA", "GITHUB_REF", "GITHUB_REPOSITORY", "GITHUB_EVENT_NAME", "GITHUB_RUN_ID",
        "CARGO_HOME", "RUSTUP_TOOLCHAIN"
    };
}

bool _csIdentChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

int _csIndent(string line) {
    int i = 0;
    while (i < line.Length) {
        char c = line.CharAt(i);
        if (c != ' ' && c != '\t') { return i; }
        i = i + 1;
    }
    return line.Length;   // 全空白
}

bool _csBlank(string line) { return line.Trim() == ""; }

// s 开头的标识符（没有则 ""）。
string _csLeadIdent(string s) {
    int k = 0;
    while (k < s.Length && _csIdentChar(s.CharAt(k))) { k = k + 1; }
    return s.Substring(0, k);
}

// 跳过命令名与其后的 `-flag` 参数，返回第一个非 flag 参数开头的标识符（`read -r X` → X）。
string _csFirstArgIdent(string t) {
    int sp0 = t.IndexOf(" ");
    string rest = t.Substring(sp0 + 1, t.Length - sp0 - 1).Trim();
    while (rest.StartsWith("-")) {
        int sp = rest.IndexOf(" ");
        if (sp < 0) { rest = ""; } else { rest = rest.Substring(sp + 1, rest.Length - sp - 1).Trim(); }
    }
    return _csLeadIdent(rest);
}

void _csAddNonEmpty(List<string> xs, string v) { if (v.Length > 0) { xs.Add(v); } }

// 一行里能被视作「赋值」的变量名。覆盖：
//   `X=…`（含 `A=1 B=2 cmd` 这种 env 前缀连写）、`for X in …`、`read [-r] X …`、`local X=…`。
// 判据：标识符紧跟 `=`（且不是 `==`），其前一个字符是行首 / 空白 / `;` / `(` / `&` / `|` / `{` / 反引号，
// 且**不是** `$`（那是取值不是赋值）。
List<string> _csAssignsIn(string line) {
    var names = new List<string>();
    string s = line;
    int i = 0;
    while (i < s.Length) {
        char c = s.CharAt(i);
        if (_csIdentChar(c) && (c < '0' || c > '9')) {
            // 前一个字符必须是「语句边界」
            bool boundary = (i == 0);
            if (i > 0) {
                char p = s.CharAt(i - 1);
                boundary = (p == ' ' || p == '\t' || p == ';' || p == '(' || p == '&' || p == '|' || p == '{' || p == '`');
            }
            int j = i;
            while (j < s.Length && _csIdentChar(s.CharAt(j))) { j = j + 1; }
            string name = s.Substring(i, j - i);
            if (boundary && j < s.Length && s.CharAt(j) == '=') {
                bool isEq = (j + 1 < s.Length && s.CharAt(j + 1) == '=');
                if (!isEq) { names.Add(name); }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    string t = s.Trim();
    // `for X in …`
    if (t.StartsWith("for ")) { _csAddNonEmpty(names, _csLeadIdent(t.Substring(4, t.Length - 4).Trim())); }
    // `mapfile -t X` / `readarray -t X`（数组读入）
    if (t.StartsWith("mapfile ") || t.StartsWith("readarray ")) { _csAddNonEmpty(names, _csFirstArgIdent(t)); }
    // `read [-flags] X [Y …]`
    if (t.StartsWith("read ")) { _csAddNonEmpty(names, _csFirstArgIdent(t)); }
    return names;
}

// 一行里「会触发 set -u」的变量取值。跳过头注列的四类。
List<string> _csUsesIn(string line) {
    var names = new List<string>();
    string s = line;
    int i = 0;
    while (i + 1 < s.Length) {
        if (s.CharAt(i) != '$') { i = i + 1; continue; }
        char nx = s.CharAt(i + 1);
        if (nx == '{') {
            // `${{ … }}` = GitHub 表达式，shell 看不到
            if (i + 2 < s.Length && s.CharAt(i + 2) == '{') { i = i + 3; continue; }
            int j = i + 2;
            int st = j;
            // `${#X}` 的 `#` 不属于名字
            if (j < s.Length && s.CharAt(j) == '#') { j = j + 1; st = j; }
            while (j < s.Length && _csIdentChar(s.CharAt(j))) { j = j + 1; }
            string name = s.Substring(st, j - st);
            // 紧跟 `:-` `-` `:+` `+` `:?` ⇒ 带默认，未设也安全
            bool guarded = false;
            if (j < s.Length) {
                char g = s.CharAt(j);
                guarded = g == '-' || g == '+' || g == '?' || g == ':';
            }
            if (name != "" && !guarded) { names.Add(name); }
            i = j;
        } else if (_csIdentChar(nx) && (nx < '0' || nx > '9')) {
            int j = i + 1;
            while (j < s.Length && _csIdentChar(s.CharAt(j))) { j = j + 1; }
            names.Add(s.Substring(i + 1, j - i - 1));
            i = j;
        } else {
            i = i + 2;   // `$1` `$@` `$?` … 位置/特殊参数
        }
    }
    return names;
}

// workflow 的各步之间靠 `echo "X=…" >> "$GITHUB_ENV"` 传值：那是**跨块**可见的赋值，按块判会误报。
// ⇒ 先全文件扫一遍这种行，把名字当作「进块前就已存在」。
List<string> _csEnvHandoffNames(string[] lines) {
    var names = new List<string>();
    foreach (var ln in lines) {
        if (ln.IndexOf("GITHUB_ENV") < 0) { continue; }
        foreach (var v in _csAssignsIn(ln)) { if (!names.Contains(v)) { names.Add(v); } }
    }
    return names;
}

// 一个 `run:` 块 → 报告数。`fileRel` / `lineNos` 只用于错误信息（指回 yml 的真实行号）。
// `pre` = 进块前就已存在的名字（`$GITHUB_ENV` 传过来的）。
int _csCheckBlock(string fileRel, List<string> body, List<int> lineNos, List<string> pre) {
    // pass 1：首次赋值行序
    var firstAt = new Dictionary<string, int>();
    for (int i = 0; i < body.Count; i++) {
        foreach (var v in _csAssignsIn(body[i])) { if (!firstAt.ContainsKey(v)) { firstAt[v] = i; } }
    }

    // pass 2：取值处比对
    string[] envs = _csEnvNames();
    int bad = 0;
    for (int u = 0; u < body.Count; u++) {
        string ln = body[u];
        if (ln.Trim().StartsWith("#")) { continue; }
        foreach (var v in _csUsesIn(ln)) {
            if (_strIn(envs, v) || pre.Contains(v)) { continue; }
            int at = firstAt.ContainsKey(v) ? firstAt[v] : -1;
            if (at < 0 || at > u) {
                string why = "从未赋值（拼错？或本该由上层 env: 提供）";
                if (at > u) { why = "首次赋值在更晚的第 " + lineNos[at].ToString() + " 行"; }
                ConsoleError.WriteLine("  ✗ " + fileRel + ":" + lineNos[u].ToString()
                    + ": `$" + v + "` 先用后赋 —— " + why);
                ConsoleError.WriteLine("      " + ln.Trim());
                bad = bad + 1;
            }
        }
    }
    return bad;
}

// 从一个 action.yml 里逐个取出 `run:` 块并判。
int _csCheckFile(string path, string fileRel, int[] outBad, int[] outBlocks) {
    string text = "";
    try { text = File.ReadAllText(path); } catch (Exception ex) { text = ""; }
    if (text == "") { return 0; }
    string[] lines = text.Replace("\r\n", "\n").Split("\n");
    List<string> pre = _csEnvHandoffNames(lines);

    int i = 0;
    while (i < lines.Length) {
        string t = lines[i].Trim();
        bool isRun = (t == "run: |" || t == "run: |-" || t == "run: >" || t.StartsWith("run: |"));
        if (!isRun) { i = i + 1; continue; }
        int runIndent = _csIndent(lines[i]);
        var body = new List<string>();
        var lineNos = new List<int>();
        int j = i + 1;
        while (j < lines.Length) {
            bool blank = _csBlank(lines[j]);
            if (!blank && _csIndent(lines[j]) <= runIndent) { break; }
            body.Add(blank ? "" : lines[j]);
            lineNos.Add(j + 1);
            j = j + 1;
        }
        // 末尾若是空行，不影响判定。
        outBlocks[0] = outBlocks[0] + 1;
        outBad[0] = outBad[0] + _csCheckBlock(fileRel, body, lineNos, pre);
        i = j;
    }
    return 0;
}

int _testCiShell() {
    string root = _root();
    string dir = _csScanDir(root);
    Console.WriteLine("① `.github/**` 的多行 run: 块无「先用后赋」（set -u 会当场退出）");
    if (!Directory.Exists(dir)) {
        ConsoleError.WriteLine("  ✗ 找不到 " + dir + " —— 本门没有扫描面（目录搬了？）");
        return 1;
    }
    int[] bad = new int[1];
    int[] blocks = new int[1];
    int files = 0;
    foreach (var r in Directory.EnumerateRecursive(dir)) {
        string relp = r.Replace("\\", "/");
        if (!relp.EndsWith(".yml") && !relp.EndsWith(".yaml")) { continue; }
        files = files + 1;
        _csCheckFile(Path.Join(dir, relp), ".github/" + relp, bad, blocks);
    }
    Console.WriteLine("  扫描 " + files.ToString() + " 个 yml，"
        + blocks[0].ToString() + " 个多行 run: 块");
    if (files == 0 || blocks[0] == 0) {
        ConsoleError.WriteLine("  ✗ 一个多行 run: 块都没扫到 —— 门是空的（yml 结构变了？）");
        return 1;
    }
    if (bad[0] > 0) {
        ConsoleError.WriteLine("  ❌ ci-shell: " + bad[0].ToString() + " 处先用后赋");
        ConsoleError.WriteLine("     这类错只在 CI 上暴露、每次代价一整轮 CI：`set -euo pipefail` 的 -u");
        ConsoleError.WriteLine("     会在那一行当场 exit 1。把赋值挪到第一次使用之前即可。");
        return 1;
    }
    Console.WriteLine("  ✓ 无先用后赋");
    return 0;
}
