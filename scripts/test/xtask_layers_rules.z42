// 运行时分层门（`xtask check layers`）的数据：源文件 → 目标组件映射表 + 允许依赖矩阵。
//
// 目标结构的唯一定义是 docs/runtime-audit.md §4「目标目录与模块分层」（模块总览、地基模块内部、
// vm 子系统、引擎 / 能力 / 工具 / 门面、易混边界）。这里只把它翻成机器可查的两张表：
//
//   · _lyMapTable：src/runtime/src 下的相对路径前缀 → 组件，**最长前缀胜出**。前缀以 `/` 结尾的是目录；
//     不带 `/` 的同时匹配同名文件与同名目录（`metadata/types` 覆盖 `types.rs` 与 `types/`）。
//     注释写的是 §4 里的目标位置。文件按「整个文件将来去哪」归属；一个文件里混着两处归属的，
//     按主体归，拆分时跟着改表。
//   · _lyAllowTable：组件 → 允许直接引用的组件。同组件内引用恒允许。
//
// 迁移（§6.1 L-2…L-7）每挪一个文件，改这里的一行；新文件落在已登记的前缀下自动继承归属，
// 落在未登记的位置 → 门红，逼人先回答「它属于哪一层」。
namespace Z42Xtask;

using Std.Collections;

// 组件名全集（报告与校验用）。`vm.core` = vm 的 mod.rs / vm.rs（VmCore / VmContext 的组合）。
string[] _lyComponents() {
    return new string[]{ "pal", "metadata", "object", "gc",
        "vm.diagnostics", "vm.threads", "vm.runtime", "vm.loader", "vm.exec", "vm.core",
        "interp", "jit", "corelib", "interop", "profiler", "debugger", "facade", "host" };
}

// 路径前缀 → 组件（每行 `前缀 = 组件`；`#` 之后是注释，写 §4 的目标位置）。按层分四段，只为守函数行数。
string[] _lyMapTable() {
    string[][] parts = new string[][]{ _lyMapBase(), _lyMapVmLow(), _lyMapVmHigh(), _lyMapTop() };
    List<string> all = new List<string>();
    foreach (var p in parts) { all.AddRange(p); }
    return all.ToArray();
}

// 地基：pal / metadata / object / gc。
string[] _lyMapBase() {
    return new string[]{
        "pal/                          = pal",
        "metadata/                     = metadata        # 静态包信息（hub 与未单列的文件）",
        "metadata/zbc_reader/          = metadata        # reader/",
        "metadata/bytecode             = metadata        # ir/",
        "metadata/types                = object          # object types/ value/ object/ array/",
        "metadata/vstr.rs              = object          # object string/",
        "corelib/str_meta.rs           = object          # object string/（非 ASCII 字符索引）",
        "gc/refs.rs                    = object          # object header/（GC 字里的标记位）",
        "gc/obj_ref.rs                 = object          # object header/ 句柄",
        "gc/arr_ref.rs                 = object          # object header/ 句柄",
        "gc/var_region/block.rs        = object          # object header/（16 B 统一头）",
        "gc/var_region/var_ref.rs      = object          # object header/ 句柄",
        "gc/                           = gc"
    };
}

// vm 下层：diagnostics / threads / runtime。
string[] _lyMapVmLow() {
    return new string[]{
        "counters.rs                   = vm.diagnostics  # diagnostics/counters",
        "observer.rs                   = vm.diagnostics  # diagnostics/events",
        "gc/safepoint.rs               = vm.threads      # threads/safepoint",
        "gc/ambient.rs                 = vm.threads      # §4.2「ambient → vm」：每线程的当前堆指针",
        "thread/                       = vm.threads      # 空桩（§4.4 删除）",
        "metadata/seg_vec.rs           = vm.runtime      # runtime/ids（无锁表）",
        "metadata/func_table.rs        = vm.runtime      # runtime/ids",
        "metadata/type_table.rs        = vm.runtime      # runtime/ids",
        "metadata/str_table.rs         = vm.runtime      # runtime/ids",
        "metadata/tokens.rs            = vm.runtime      # runtime/ids",
        "metadata/resolver             = vm.runtime      # runtime/resolve + dispatch/ic",
        "metadata/loader/type_registry.rs = vm.runtime   # runtime/types（组装 TypeDesc）",
        "metadata/loader/constraints.rs = vm.runtime     # runtime/types/constraints",
        "vm_context/isa_cache.rs       = vm.runtime      # runtime/dispatch/isa",
        "vm_context/static_table.rs    = vm.runtime      # runtime/statics",
        "vm_context/statics.rs         = vm.runtime      # runtime/statics",
        "vm_context/symres.rs          = vm.runtime      # runtime/resolve（缺符号判定）",
        "interp/dispatch.rs            = vm.runtime      # runtime/dispatch（vtable / isa；ToString 部分属 exec）",
        "interp/vcall_resolve.rs       = vm.runtime      # runtime/dispatch/vcall",
        "interp/obj_new_resolve.rs     = vm.runtime      # runtime/dispatch/ctor",
        "corelib/builtin_table.rs      = vm.runtime      # runtime/builtins.rs"
    };
}

// vm 上层：loader / exec / core。
string[] _lyMapVmHigh() {
    return new string[]{
        "metadata/loader/              = vm.loader       # loader/package、availability、locate",
        "metadata/lazy_loader          = vm.loader       # loader/lazy",
        "metadata/context.rs           = vm.loader       # loader/contexts",
        "metadata/namespace_index.rs   = vm.loader       # loader/locate",
        "metadata/merge.rs             = vm.loader       # loader/package",
        "probing.rs                    = vm.loader       # loader/locate（probing）",
        "vm_context/lookup.rs          = vm.loader       # VmContext 上的加载 / 查找入口",
        "objops/                       = vm.exec         # exec/ops",
        "semantics.rs                  = vm.exec         # exec/ops/scalar",
        "exception/                    = vm.exec         # exec/exception",
        "stack_guard.rs                = vm.exec         # exec/stack_guard",
        "corelib/abi/                  = vm.exec         # exec/call/builtin_abi",
        "interp/forward.rs             = vm.exec         # exec/call/forward（两引擎共用）",
        "interp/type_param_env.rs      = vm.exec         # exec/call（型参标记的绑定，两引擎共用）",
        "interp/exec_struct.rs         = vm.exec         # exec/ops/struct_ops（interp、jit、corelib 共用）",
        "interp/transient_arena.rs     = vm.exec         # exec/call（§4.4：JIT / objops 也用 → 下沉）",
        "interp/stack_alloc.rs         = vm.exec         # exec/call（同上）",
        "interp/struct_arena.rs        = vm.exec         # exec/call（同上）",
        "vm_context/cctor.rs           = vm.exec         # exec/init",
        "vm_context/frame_stack.rs     = vm.exec         # exec/call",
        "vm_context/frames.rs          = vm.exec         # exec/call",
        "vm_context/reg_pool.rs        = vm.exec         # exec/call",
        "vm_context/engine_guards.rs   = vm.exec         # exec/call（帧在栈上时装的线程局部指针）",
        "vm_context/                   = vm.core         # vm.rs / lib.rs：VmCore、VmContext 的组合"
    };
}

// 引擎 / 能力 / 工具 / 门面 / 产品。
string[] _lyMapTop() {
    return new string[]{
        "interp/                       = interp",
        "metadata/superinstr.rs        = interp          # interp/superinstr.rs",
        "jit/                          = jit",
        "corelib/                      = corelib",
        "vm_context/resources.rs       = corelib         # OS 资源表 → corelib 扩展状态",
        "interop/                      = interop",
        "vm_context/native.rs          = interop         # native_types 等 → interop 扩展状态",
        "gc/sampler.rs                 = profiler        # profiler cpu/",
        "gc/snapshot.rs                = profiler        # profiler heap/",
        "gc/retention.rs               = profiler        # profiler heap/",
        "corelib/sync_contention.rs    = profiler        # profiler locks/",
        "corelib/diagnostics.rs        = profiler        # Std.Diagnostics 剖析类 builtin 由 profiler 登记",
        "lib.rs                        = facade",
        "config                        = facade          # z42 config/",
        "app.rs                        = facade          # z42 app.rs",
        "boot.rs                       = facade          # z42 app.rs",
        "startup.rs                    = host            # z42vm 可执行文件（main.rs 的 mod startup）",
        "vm.rs                         = facade          # z42 app.rs",
        "aot.rs                        = facade          # 空桩（§4.4 删除）",
        "signal_handler.rs             = facade          # z42 crash.rs",
        "host/                         = host            # z42-host",
        "main.rs                       = host            # z42vm 可执行文件"
    };
}

// 组件 → 允许直接引用的组件（`@base` = pal metadata object gc；`@vm` = 全部 vm.*；`*` = 除 host 外全部）。
// 引擎之间、能力 / 工具之间、能力 / 工具与引擎之间互不允许（§4.1 硬规则 2）。
string[] _lyAllowTable() {
    return new string[]{
        "pal            =",
        "metadata       =",
        "object         = metadata",
        "gc             = object metadata pal",
        "vm.diagnostics = @base",
        "vm.threads     = @base vm.diagnostics",
        "vm.runtime     = @base vm.diagnostics vm.threads",
        "vm.loader      = @base vm.diagnostics vm.threads vm.runtime",
        "vm.exec        = @base vm.diagnostics vm.threads vm.runtime vm.loader vm.core",
        "vm.core        = @base @vm",
        "interp         = @base @vm",
        "jit            = @base @vm",
        "corelib        = @base @vm",
        "interop        = @base @vm",
        "profiler       = @base @vm",
        "debugger       = @base @vm",
        "facade         = *",
        "host           = * facade"
    };
}

// 表行 `左 = 右  # 注释` → [左, 右]（两侧 trim，注释剥掉）。
string[] _lyRow(string row) {
    string s = row;
    int h = s.IndexOf("#");
    if (h >= 0) { s = s.Substring(0, h); }
    int eq = s.IndexOf("=");
    string[] r = new string[2];
    r[0] = eq < 0 ? s.Trim() : s.Substring(0, eq).Trim();
    r[1] = eq < 0 ? "" : s.Substring(eq + 1).Trim();
    return r;
}

// 相对路径（`gc/arc_heap/alloc.rs`）→ 组件；没有前缀命中 → ""（未登记）。
string _lyComponentOf(string rel) {
    string best = "";
    int bestLen = -1;
    foreach (var row in _lyMapTable()) {
        string[] kv = _lyRow(row);
        if (kv[0].Length > bestLen && _lyPrefixMatch(rel, kv[0])) { best = kv[1]; bestLen = kv[0].Length; }
    }
    return best;
}

// 目录前缀（以 `/` 结尾）只匹配目录下的文件；文件 / 主干前缀匹配同名文件或同名目录。
bool _lyPrefixMatch(string rel, string prefix) {
    if (!rel.StartsWith(prefix)) { return false; }
    if (prefix.EndsWith("/") || rel.Length == prefix.Length) { return true; }
    char next = rel.CharAt(prefix.Length);
    return next == '/' || next == '.';
}

// from 能否直接引用 to。
bool _lyAllowed(string from, string to) {
    if (from == to) { return true; }
    foreach (var row in _lyAllowTable()) {
        string[] kv = _lyRow(row);
        if (kv[0] != from) { continue; }
        foreach (var t in kv[1].Split(" ")) {
            if (t == to) { return true; }
            if (t == "*" && to != "host") { return true; }
            if (t == "@base" && (to == "pal" || to == "metadata" || to == "object" || to == "gc")) { return true; }
            if (t == "@vm" && to.StartsWith("vm.")) { return true; }
        }
        return false;
    }
    return false;
}

// 平台实现与编译期选择只属于 pal/sys；PAL 上层也受零平台分支门禁约束。
bool _lyPlatformExempt(string rel) { return rel.StartsWith("pal/sys/"); }
