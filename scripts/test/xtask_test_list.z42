// xtask — `test list`: read-only catalog of the case-granular test corpus.
// Answers "what cases exist, how do I run one, which caps does it need" without
// reading source. Reuses the single corpus enumeration (_enumerateCorpus in
// xtask_test_embedded_corpus.z42) so the catalog never drifts from what the embed
// bundle actually sees.
//
// Scope: src/tests goldens (run via `test e2e --file`) + stdlib [Test] units (run via
// `test stdlib -k`). Coarser stage-level suites (cross-zpkg, compiler fixpoint,
// platform, runtime cargo, bench) are NOT case-granular; see test-gate.md.
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

// The command a developer runs to execute just this one case.
string _runCmdFor(_CorpusCase c) {
    if (c.kind == "golden") { return "test e2e --file " + c.name; }
    // unit / dir-unit → stdlib [Test] runner, narrowed by leaf name.
    return "test stdlib " + c.lib + " -k " + c.leaf;
}

// `test list [--dir <bucket>] [--filter <substr>] [--kind golden|test|all] [--json]`
int _testList(string dirF, string filter, string kindF, bool json) {
    string root = _root();

    _CorpusCase[] all = _enumerateCorpus(root, filter);

    // Post-filter by --dir (bucket exact) and --kind (golden vs [Test]).
    List<_CorpusCase> cases = new List<_CorpusCase>();
    foreach (var c in all) {
        if (dirF.Length > 0 && c.bucket != dirF) { continue; }
        if (kindF == "golden" && c.kind != "golden") { continue; }
        if (kindF == "test" && c.kind == "golden") { continue; }
        cases.Add(c);
    }

    if (json) { return _testListJson(cases.ToArray()); }
    return _testListPretty(cases.ToArray());
}

// Human catalog: grouped by bucket, one line per case with run command + mode +
// declared `requires-caps` (the on-device runner skips the case where one is missing). Trailing summary counts.
int _testListPretty(_CorpusCase[] cases) {
    Console.WriteLine("case catalog — src/tests goldens (test e2e --file) + stdlib [Test] (test stdlib -k)");
    Console.WriteLine("");
    int golden = 0;
    int tests = 0;
    int withReq = 0;
    string curBucket = "";
    foreach (var c in cases) {
        if (c.bucket != curBucket) {
            if (curBucket.Length > 0) { Console.WriteLine(""); }
            curBucket = c.bucket;
            Console.WriteLine(curBucket);
        }
        string kindTag = (c.kind == "golden") ? "golden" : "test  ";
        string mode = (c.kind == "golden" && c.interpOnly) ? "[interp]" : "[interp+jit]";
        string note = "";
        string[] req = _caseRequires(c);
        if (req.Length > 0) {
            note = "  requires: " + String.Join(",", req);
            withReq = withReq + 1;
        }
        Console.WriteLine("  " + _padRight(c.name, 40) + " " + kindTag
            + "  " + _padRight(mode, 12) + "  " + _runCmdFor(c) + note);
        if (c.kind == "golden") { golden = golden + 1; } else { tests = tests + 1; }
    }
    Console.WriteLine("");
    string summary = "Total: " + cases.Length.ToString() + " cases (" + golden.ToString()
        + " golden, " + tests.ToString() + " [Test])";
    summary = summary + "; " + withReq.ToString() + " declare required caps (skipped by the runner where missing)";
    Console.WriteLine(summary);
    return 0;
}

// Machine catalog: JSON array of {name, bucket, kind, run, interpOnly, requires}.
int _testListJson(_CorpusCase[] cases) {
    int n = cases.Length;
    string outv = "[\n";
    int i = 0;
    while (i < n) {
        _CorpusCase c = cases[i];
        string obj = "  {\"name\": \"" + c.name + "\", \"bucket\": \"" + c.bucket
            + "\", \"kind\": \"" + c.kind + "\", \"run\": \"" + _runCmdFor(c)
            + "\", \"interpOnly\": " + (c.interpOnly ? "true" : "false");
        string[] req = _caseRequires(c);
        obj = obj + ", \"requires\": [" + (req.Length > 0 ? "\"" + String.Join("\", \"", req) + "\"" : "") + "]}";
        if (i + 1 < n) { obj = obj + ","; }
        outv = outv + obj + "\n";
        i = i + 1;
    }
    outv = outv + "]";
    Console.WriteLine(outv);
    return 0;
}
