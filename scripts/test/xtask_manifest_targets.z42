// xtask — manifest-driven test/bench/example target engine. Consumed by the per-package
// flow (_testPkgsCore, xtask_test_lib.z42), the `test toolchain builder` fixture flow
// (xtask_test_targets.z42) and the example runner (xtask_test_example.z42).
//
// 名字里没有 `xtask_test_` 前缀是有意的：那个前缀专表「`test <x>` 命令的实现」，
// 本文件是被三个消费者共用的**引擎**、不对应任何命令。
// Reads a project's `<name>.z42.toml` via Z42.Project's ManifestLoader (no hand-rolled
// TOML) and turns `[tests]`/`[benches]`/`[examples]` + `[[test]]`/`[[bench]]`/`[[example]]`
// into runnable units.
//
// **test/bench 只有一条路：转发 z42b**（`--list` 拿清单 → 并行 `--name` 逐个跑）。
// 约定发现、显式目标（两种 harness）、孤儿源守卫、「本包压根没有测试」的分流全部住在 z42b，
// xtask 侧只剩：清单 lint（`_validateRunTargets`）、并行编排、bench 聚合。
// example 是唯一还留在本文件里执行的一类 —— 它不是测试（判据是「编得过 + 可选跑得通」），
// 走 `_runExitTarget` / `_compileTarget`。
//
// NOTE (xtask's dependencies): `using Z42.Project` resolves because xtask.z42.toml declares
// z42.project / z42.build as SDK libs (`deploy = "sdk"`); stdlib (`z42.*` in
// Z42_LIBS) stays visible without being listed.
namespace Z42Xtask;

using Std.IO;
using Std.Json;
using Z42.Project;

// ── manifest access (null-tolerant: missing/broken toml → convention defaults) ──

// Load a project manifest, or null when the toml is absent / unparsable. Callers
// treat null as "auto convention scan, no explicit targets, no dev-deps".
ProjectManifest _loadManifestOr(string tomlPath) {
    if (!File.Exists(tomlPath)) { return null; }
    try { return ManifestLoader.Load(tomlPath); }
    catch (Exception e) { return null; }
}

// section.Auto for a kind ("test"/"bench"/"example"); null manifest → true.
bool _sectionAuto(ProjectManifest m, string kind) {
    if (m == null) { return true; }
    if (kind == "bench")   { return m.BenchSection.Auto; }
    if (kind == "example") { return m.ExampleSection.Auto; }
    return m.TestsSection.Auto;
}

// Explicit [[test]]/[[bench]]/[[example]] targets for a kind (empty when none).
RunTarget[] _explicitTargets(ProjectManifest m, string kind) {
    if (m == null) { return new RunTarget[0]; }
    if (kind == "bench")   { return m.Benches; }
    if (kind == "example") { return m.Examples; }
    return m.Tests;
}

// ── three-layer dev-dep merge (target > section > project) ─────────────────────
// 只服务 example 目标（`_targetDepsPairs`）；test/bench 的依赖合并在 z42b 里。

void _bundleAddSection(DepBundle b, ProjectManifest m, string kind) {
    if (kind == "bench")        { _bundleAddDeps(b, m.BenchSection.Deps, m.BenchSection.DepCount); }
    else if (kind == "example") { _bundleAddDeps(b, m.ExampleSection.Deps, m.ExampleSection.DepCount); }
    else                        { _bundleAddDeps(b, m.TestsSection.Deps, m.TestsSection.DepCount); }
}

DepBundle _newBundle() {
    DepBundle b = new DepBundle();
    b.Names = new string[16]; b.Versions = new string[16]; b.Count = 0;
    return b;
}

// Insert one (name, version) into a bundle, first-wins dedup by name (grows on
// demand). "" version → "*".
void _bundlePut(DepBundle b, string name, string ver) {
    int j = 0;
    while (j < b.Count) { if (b.Names[j] == name) { return; } j = j + 1; }
    if (b.Count == b.Names.Length) {
        int cap = b.Names.Length * 2;
        string[] nn = new string[cap]; string[] nv = new string[cap];
        Array.Copy(b.Names, nn, b.Count); Array.Copy(b.Versions, nv, b.Count);
        b.Names = nn; b.Versions = nv;
    }
    if (ver.Length == 0) { ver = "*"; }
    b.Names[b.Count] = name; b.Versions[b.Count] = ver; b.Count = b.Count + 1;
}

// Append DepEntry[] into a bundle (first-wins dedup).
void _bundleAddDeps(DepBundle b, DepEntry[] deps, int n) {
    int i = 0;
    while (i < n) { _bundlePut(b, deps[i].Name, deps[i].Version); i = i + 1; }
}

// Three-layer merge from raw (name, version) pairs instead of a DepEntry[] — for
// the example runner, whose local ExampleUnit carries deps as primitive string
// arrays (avoids an imported-type field). Priority: pairs > section > project.
DepBundle _targetDepsPairs(ProjectManifest m, string kind, string[] names, string[] versions, int n) {
    DepBundle b = _newBundle();
    int i = 0;
    while (i < n) { _bundlePut(b, names[i], versions[i]); i = i + 1; }
    if (m != null) { _bundleAddSection(b, m, kind); _bundleAddDeps(b, m.Deps, m.DepCount); }
    return b;
}

// ── explicit-target validation ───────────────────────────────────────────────

// Returns "" when the kind's explicit targets are valid, else an error message.
// Rules: [[target]] missing name → error; harness=false missing entry → error;
// duplicate name within a kind → error. (example ignores harness — always Main.)
string _validateRunTargets(RunTarget[] t, int n, string kind) {
    int i = 0;
    while (i < n) {
        RunTarget x = t[i];
        if (x.Name.Length == 0) {
            return "[[" + kind + "]] #" + (i + 1).ToString() + " missing required `name`";
        }
        if (kind != "example" && !x.Harness && !x.HasEntry) {
            return "[[" + kind + "]] '" + x.Name + "' has harness=false but no `entry`";
        }
        int j = i + 1;
        while (j < n) {
            if (t[j].Name == x.Name) { return "duplicate [[" + kind + "]] name '" + x.Name + "'"; }
            j = j + 1;
        }
        i = i + 1;
    }
    return "";
}

// ── example 目标的执行器（exit-code）───────────────────────────────────────────
// examples 不走 z42b —— 它们不是测试，判据是「编得过（+ 可选跑得通）」。

// One example target: compile to a runnable exe zpkg, and (when runAfter) run it.
// Returns 0 pass / 1 fail. runAfter=false → compile-only gate (example default).
int _runExitTarget(string root, string projDir, string projPrefix, string subdir,
                   string tName, bool tHasEntry, string tEntry, string[] tSources, int tSrcCount,
                   DepBundle deps, string vm, string driverZpkg, string libs,
                   bool runAfter) {
    string projName = projPrefix + "." + tName;
    string zpkg = _compileTarget(root, vm, driverZpkg, projDir, projName, subdir, tName, tHasEntry, tEntry, tSources, tSrcCount, deps, "exe", tName, libs);
    if (zpkg.Length == 0) { return 1; }
    if (!runAfter) { Console.WriteLine("✓ " + tName + " (compiled)"); return 0; }
    // The exe zpkg bakes the entry (== tEntry) → run it directly, no CLI entry arg.
    // exit-code is the verdict (non-zero = fail, no golden).
    ProcessResult rr = _z42Proc(vm, libs).Arg(zpkg).Run();
    Console.Write(rr.Stdout);
    if (rr.Stderr.Length > 0) { Console.Write(rr.Stderr); }
    if (rr.ExitCode != 0) { Console.WriteLine("✗ " + tName + " (exit " + rr.ExitCode.ToString() + ")"); return 1; }
    Console.WriteLine("✓ " + tName);
    return 0;
}

// Compile one target's sources into a zpkg (kindStr "exe"/"lib") via a synthetic
// mini-manifest + `z42c build`. Returns the produced zpkg path, or "" on a
// no-source-match / compile error (message printed). Writes the synth toml at
// projDir (globs resolve relative to it) and deletes it afterwards.
string _compileTarget(string root, string vm, string driverZpkg, string projDir,
                      string projName, string subdir, string tName, bool tHasEntry,
                      string tEntry, string[] tSources, int tSrcCount, DepBundle deps,
                      string kindStr, string label, string libs) {
    string outDir = Path.Join(_workRootOf(root, projDir), "targets/" + projName);
    if (Directory.Exists(outDir)) { try { Directory.Delete(outDir, true); } catch (Exception e) {} }
    Directory.Create(Path.Join(outDir, "dist"));
    string[] inc = _targetIncludes(projDir, subdir, tName, tSources, tSrcCount);
    if (inc.Length == 0) {
        ConsoleError.WriteLine("✗ " + label + ": no source files match (sources glob / convention empty)");
        return "";
    }
    string synth = Path.Join(projDir, ".xtask-" + projName + ".z42.toml");
    bool wantEntry = (kindStr == "exe") && tHasEntry;
    File.WriteAllText(synth, _renderTargetManifest(projName, kindStr, tEntry, wantEntry, inc, outDir, deps));
    ProcessResult br = _z42cProc(vm, libs, driverZpkg).Arg("build").Arg(synth).Run();
    try { File.Delete(synth); } catch (Exception e) {}
    if (br.ExitCode != 0) {
        ConsoleError.WriteLine("✗ COMPILE ERROR: " + label);
        Console.Write(br.Stdout); Console.Write(br.Stderr);
        return "";
    }
    string zpkg = Path.Join(Path.Join(outDir, "dist"), projName + ".zpkg");
    if (!File.Exists(zpkg)) {
        ConsoleError.WriteLine("✗ " + label + ": no zpkg produced at " + zpkg);
        return "";
    }
    return zpkg;
}

// Resolve a target's source globs to projDir-relative include patterns. Explicit
// sources verbatim; else convention <subdir>/<name>.z42 (single) or
// <subdir>/<name>/**/*.z42 (dir). Absent → empty (caller errors "no match").
string[] _targetIncludes(string projDir, string subdir, string tName, string[] tSources, int tSrcCount) {
    if (tSrcCount > 0) {
        if (_countMatches(projDir, tSources, tSrcCount) == 0) { return new string[0]; }
        string[] r = new string[tSrcCount];
        int i = 0;
        while (i < tSrcCount) { r[i] = _z42cInclude(tSources[i]); i = i + 1; }
        return r;
    }
    string single = Path.Join(Path.Join(projDir, subdir), tName + ".z42");
    if (File.Exists(single)) { return new string[]{ _z42cInclude(subdir + "/" + tName + ".z42") }; }
    string dir = Path.Join(Path.Join(projDir, subdir), tName);
    if (Directory.Exists(dir)) { return new string[]{ subdir + "/" + tName + "/**/*.z42" }; }
    return new string[0];
}

// Rewrite a source include for the synth manifest: `<dir>/<base>` → `<dir>/**/<base>`
// (recursive from <dir>, includes depth 0). Patterns already using `**` / bare basenames pass through.
string _z42cInclude(string pattern) {
    if (pattern.IndexOf("/**/") >= 0) { return pattern; }
    if (pattern.StartsWith("**/")) { return pattern; }
    int slash = pattern.LastIndexOf("/");
    if (slash < 0) { return pattern; }
    string dir = pattern.Substring(0, slash);
    string base = pattern.Substring(slash + 1, pattern.Length - slash - 1);
    return dir + "/**/" + base;
}

// Count files matching any projDir-relative glob (for no-match validation).
int _countMatches(string projDir, string[] patterns, int n) {
    int total = 0;
    int i = 0;
    while (i < n) { total = total + _expandGlob(projDir, patterns[i]).Length; i = i + 1; }
    return total;
}

// Expand one projDir-relative glob → absolute paths. Handles `<a>/**/<suffix>`
// (recursive), `**/<suffix>`, `<dir>/<basePat>` (single dir), and bare `<basePat>`.
string[] _expandGlob(string projDir, string pattern) {
    int mid = pattern.IndexOf("/**/");
    if (mid >= 0) {
        string prefix = pattern.Substring(0, mid);
        string suffix = pattern.Substring(mid + 4, pattern.Length - (mid + 4));
        return Path.GlobRecursive(Path.Join(projDir, prefix), suffix);
    }
    if (pattern.StartsWith("**/")) {
        return Path.GlobRecursive(projDir, pattern.Substring(3, pattern.Length - 3));
    }
    int slash = pattern.LastIndexOf("/");
    if (slash >= 0) {
        string d = pattern.Substring(0, slash);
        string basePat = pattern.Substring(slash + 1, pattern.Length - slash - 1);
        return Path.Glob(Path.Join(projDir, d), basePat);
    }
    return Path.Glob(projDir, pattern);
}

// Hand-rolled mini-manifest: [project] name/kind, [sources] include globs (projDir-relative),
// merged [dependencies]. 显式入口（目标的 `entry`）写成同名的单个 `[[exe]]`——
// `[project]` 没有 `entry` 键（z42c 自动检测唯一 Main，写了报错）；`[[exe]]` 产物同样落 dist/<name>.zpkg。
string _renderTargetManifest(string projName, string kindStr, string entry, bool hasEntry,
                             string[] inc, string outputDir, DepBundle deps) {
    string body = "# Auto-generated by xtask (add-tests-bench-manifest-config P2/P3).\n"
        + "[project]\n"
        + "name    = \"" + projName + "\"\n"
        + "version = \"0.1.0\"\n";
    if (!hasEntry) { body = body + "kind    = \"" + kindStr + "\"\n"; }
    body = body + "\n[sources]\ninclude = [\"" + string.Join("\", \"", inc) + "\"]\n\n"
        + "[build]\noutput_dir = \"" + outputDir + "\"\n"
        + "dist_dir   = \"${output_dir}/dist\"\n"
        + "cache_dir  = \"${output_dir}/cache\"\n\n";
    if (hasEntry) { body = body + "\n[[exe]]\nname  = \"" + projName + "\"\nentry = \"" + entry + "\"\n"; }
    if (deps.Count > 0) {
        body = body + "\n[dependencies]\n";
        int i = 0;
        while (i < deps.Count) {
            body = body + "\"" + deps.Names[i] + "\" = \"" + deps.Versions[i] + "\"\n";
            i = i + 1;
        }
    }
    return body;
}

// ── per-package driver (called by _testPkgsCore, xtask_test_lib.z42) ───────────

// 跑一个 lib 的 test/bench：**一律转发 z42b**——发现规则、孤儿源守卫、harness=false、
// 「本包压根没有测试」的分流只在 z42b 一处，xtask 不另起一套（两套规则必然各自漂移）。
// 返回该 lib 的失败数，或 -1 表示目标声明有误（调用方中止整个 stage）。
// totalFiles / libsTested 按引用更新。
//
// File.Exists(parentToml)：`src/libraries` 的枚举里混着 README.md 之类的非工程条目，须显式跳过。
int _runLibKind(string root, string projDir, string lib, string kind,
                string label, string filter, string builderZpkg, int jobsN, string mode,
                string vm, string driverZpkg, string libs, MicroBenchAgg agg,
                ref int totalFiles, ref int libsTested) {
    string parentToml = Path.Join(projDir, lib + ".z42.toml");
    if (!File.Exists(parentToml)) { return 0; }
    // 清单 lint（名字缺失 / 重名 / harness=false 缺 entry）留在 xtask 侧：z42b 对
    // HasEntry=false 是「自动探测入口」而不是错误，这条 lint 它不复制。
    ProjectManifest man = _loadManifestOr(parentToml);
    RunTarget[] tgts = _explicitTargets(man, kind);
    string verr = _validateRunTargets(tgts, tgts.Length, kind);
    if (verr.Length > 0) { ConsoleError.WriteLine("error: " + lib + ": " + verr); return -1; }
    return _runLibViaZ42b(root, projDir, parentToml, lib, kind, label, filter,
                          builderZpkg, jobsN, mode, vm, driverZpkg, libs, agg,
                          ref totalFiles, ref libsTested);
}

// 一个 lib 的 test 走转发：`z42b test <真 manifest> --list` 拿单元名 → 并行拉起
// `z42b test <toml> --name <unit>`。
//
// 零单元时**不在这里判**：直接不带 --name 跑一次 z42b，让它自己的判定说了算 ——
// 孤儿源守卫（有源却零单元 → 红）与「本包压根没有测试」（→ 绿）都住在 z42b 里，
// 判据只该有一处。
int _runLibViaZ42b(string root, string projDir, string parentToml, string lib, string kind,
                   string label, string filter, string builderZpkg, int jobsN, string mode,
                   string vm, string driverZpkg, string libs, MicroBenchAgg agg,
                   ref int totalFiles, ref int libsTested) {
    bool ok = true;
    string[] names = _listUnitsViaZ42b(root, parentToml, kind, filter, mode, vm, builderZpkg, libs, ref ok);
    if (!ok) { return -1; }
    if (names.Length == 0) {
        // 零单元：交给 z42b 自己裁定（红/绿），不在 xtask 侧复制一份判据。
        // filter 非空时零命中是过滤器的事，不是发现规则的 bug —— 直接跳过。
        if (filter.Length > 0) { return 0; }
        Process zp = _z42bProc(vm, libs).Arg("--mode").Arg(mode).Arg(builderZpkg)
            .Arg("--").Arg(kind).Arg(parentToml);
        if (_z42bSupportsOutRoot(vm, builderZpkg, libs)) {
            zp = zp.Arg("--out-root").Arg(_devTargetOutRoot(root, parentToml, kind));
        }
        ProcessResult rr = zp.WorkingDirectory(root).Run();
        Console.Write(rr.Stdout);
        if (rr.Stderr.Length > 0) { Console.Write(rr.Stderr); }
        return (rr.ExitCode != 0) ? 1 : 0;
    }
    Console.WriteLine("");
    Console.WriteLine("── " + lib + " (" + label + ", z42b) : " + names.Length.ToString() + " unit(s) ──");
    totalFiles = totalFiles + names.Length;
    libsTested = libsTested + 1;
    // capture 模式（bench 基线）：给聚合结果打上执行 profile 标签 —— 从 runner 实际运行的那个
    // VM 探出来，interp 与 jit 的 micro 基线不能互相比。
    if (agg != null) {
        string epMode = (mode.Length > 0) ? mode : "interp";
        string epProbe = _epEnsureProbe(root, vm, driverZpkg, libs);
        VmCaps epVm = _epProbe(vm, libs, epProbe);
        agg.setProfileOnce(_epTiersForMode(epMode), epVm, _epVmVersion(vm));
    }
    return _runUnitsViaZ42b(root, parentToml, names, names.Length, kind,
                            jobsN, mode, vm, builderZpkg, libs, lib, agg);
}

// ── micro bench 结果聚合（`bench stdlib --json`：lib / units / targets 三个 flow 共用）──────────
// 住在这里而不是 bench/：消费方全是 test 族（[[bench]] 目标与 [Benchmark] 单元的 z42b json 输出），bench 族自己不用。
// Aggregate per-module z42b `--format json` bench_stats into one schema-v2
// baseline doc. median_ns is the primary metric (value); min/max
// map to ci_lower/ci_upper. One instance is reused across all libs/modules by
// `bench stdlib --json` (null when not capturing → pretty passthrough untouched).
class MicroBenchAgg {
    string _items;   // comma+newline-joined schema-v2 benchmark objects
    int    _n;
    // The profile every micro result is tagged with.
    // Probed once (setProfileOnce) from the VM the z42b runner executes under, so
    // interp vs jit micro baselines never compare against each other. Defaults to
    // an interp/empty profile until set.
    string[] _tiers;
    VmCaps   _vm;
    string   _vmVersion;
    bool     _profSet;
    public MicroBenchAgg() {
        this._items = ""; this._n = 0;
        this._tiers = new string[1]; this._tiers[0] = "interp";
        this._vm = new VmCaps(); this._vmVersion = ""; this._profSet = false;
    }
    internal int count() { return this._n; }

    // Record the execution profile (idempotent — first call wins). tiers comes
    // from the micro `--mode`; vm/vmVersion from probing the runner's VM binary.
    internal void setProfileOnce(string[] tiers, VmCaps vm, string vmVersion) {
        if (this._profSet) { return; }
        this._tiers = tiers; this._vm = vm; this._vmVersion = vmVersion;
        this._profSet = true;
    }

    // Parse one z42b `--format json` module output; append each benchmark's stats.
    // Non-benchmark entries (smoke [Test]) and failed benches (no bench_stats) skip.
    internal void addModuleJson(string moduleJson, string lib) {
        JsonValue root = JsonValue.Parse(moduleJson.Trim());
        JsonValue results = null;
        if (!root.TryGet("results", ref results)) { return; }
        int i = 0;
        while (i < results.Count()) {
            JsonValue res = results.At(i);
            bool isBench = false;
            JsonValue bs = null;
            if (res.TryGetValue<bool>("is_benchmark", ref isBench) && isBench
                && res.TryGet("bench_stats", ref bs)) {
                string name = lib + "." + bs.Get("label").AsString();
                long med = bs.Get("median_ns").AsLong();
                long lo  = bs.Get("min_ns").AsLong();
                long hi  = bs.Get("max_ns").AsLong();
                long smp = bs.Get("samples").AsLong();
                // mean_ns / stddev_ns: optional in older reports → default -1.
                long mean = -1; bs.TryGetValue<long>("mean_ns", ref mean);
                long sd   = -1; bs.TryGetValue<long>("stddev_ns", ref sd);
                if (this._n > 0) { this._items = this._items + ",\n"; }
                this._items = this._items
                    + "    {\n      \"name\": \"" + name + "\",\n"
                    + "      \"tier\": \"z42-micro\",\n      \"metric\": \"time\",\n"
                    + "      \"value\": " + med.ToString() + ",\n      \"unit\": \"ns\",\n"
                    + "      \"ci_lower\": " + lo.ToString() + ",\n      \"ci_upper\": " + hi.ToString() + ",\n"
                    + "      \"mean_ns\": " + mean.ToString() + ",\n      \"stddev_ns\": " + sd.ToString() + ",\n"
                    + "      \"samples\": " + smp.ToString() + ",\n"
                    + "      \"profile\": " + _epProfileJson(this._tiers, new string[0], this._vm) + "\n    }";
                this._n = this._n + 1;
            }
            i = i + 1;
        }
    }

    // Wrap accumulated items in the schema-v2 envelope.
    internal string toSchemaV2(string root) {
        string commit = _gitOut(root, "rev-parse", "--short", "HEAD");
        string branch = _gitOut(root, "rev-parse", "--abbrev-ref", "HEAD");
        return "{\n  \"schema_version\": 2,\n  \"commit\": \"" + commit
            + "\",\n  \"branch\": \"" + branch + "\",\n  \"z42vm_version\": \"" + this._vmVersion
            + "\",\n  \"timestamp\": \"" + _utcNow() + "\",\n  \"benchmarks\": [\n"
            + this._items + "\n  ]\n}\n";
    }
}
