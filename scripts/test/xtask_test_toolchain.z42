// `xtask test toolchain [<comp>]` —— 工具链组件自己的用例（test-layout.md §1）：`src/toolchain/<comp>/` 下
// 每个工程的 `tests/`，与库、编译器成员同一套 `[Test]` runner（_testPkgsCore → z42b）。
//
// 只收 `tests/` 里有 `fixtures/` 以外内容的工程：`tests/fixtures/` 是各 harness 的私有地盘（builder 的
// manifest-targets / z42b 两套归 `xtask test toolchain builder`），不算单元。工具链用例从不进 app 语料，天然 host-only。
namespace Z42Xtask;

using Std.IO;
using Std.Time;
using Std.Collections;
using Z42.Project;

// `xtask test toolchain [<comp>] [--target <name>]`：各工程的 [Test] 单元；comp 为空或是 builder 时再跑 builder 的
// manifest 目标夹具（`[[test]]` / `[[example]]` / `[[bench]]` 与 z42b 自身的清单 / hook / 发现规则，
// test-layout §3 的 fixtures 表）。GREEN 里两者是两个 stage（`toolchain [Test]`、`manifest targets`）。
int _testToolchain(string comp, bool noBuild, string filter, string target) {
    Stopwatch sw = _procStart("test toolchain");
    int rc = 0;
    if (target.Length == 0) {
        rc = _testToolchainCore(comp, noBuild, filter, comp == "builder" || comp == "z42.builder");
    }
    if (rc == 0 && (comp.Length == 0 || comp == "builder" || comp == "z42.builder")) {
        rc = _testTargetsCore("test", target, noBuild);
    }
    if (rc == 0) { _procEnd("test toolchain", sw); }
    return rc;
}

// comp = `src/toolchain/` 下的组件目录名（builder / interactive …）或包名（z42.repl）；空 = 全部。
// noUnitsOk：该组件只有夹具、没有单元（builder）时不报错。
int _testToolchainCore(string comp, bool noBuild, string filter, bool noUnitsOk) {
    string root = _root();
    List<string> dirs = new List<string>();
    foreach (var d in _toolchainTestPkgs(root)) {
        if (!_toolchainPkgMatches(root, d, comp)) { continue; }
        dirs.Add(d);
    }
    if (dirs.Count == 0) {
        if (comp.Length > 0 && !noUnitsOk) {
            ConsoleError.WriteLine("error: no toolchain package with tests matches '" + comp + "'");
            return 2;
        }
        Console.WriteLine("  (no toolchain package has tests)");
        return 0;
    }
    return _testPkgsCore("test", "toolchain", dirs.ToArray(), noBuild, filter, "4", "interp", null, "", "", "");
}

// `src/toolchain/` 下有单元用例的工程目录（排序稳定）：目录里有工程清单，且 `tests/` 下有
// `fixtures/` 以外的条目。不进 `tests/` 内部找工程 —— fixture 工程不是被测对象。
string[] _toolchainTestPkgs(string root) {
    List<string> found = new List<string>();
    _tcCollect(Path.Join(root, "src/toolchain"), found);
    return _sortedStrings(found.ToArray());
}

void _tcCollect(string dir, List<string> found) {
    if (_tcHasUnits(dir) && _toolchainPkgName(dir).Length > 0) { found.Add(dir); }
    foreach (var e in _sortedStrings(Directory.Enumerate(dir))) {
        if (e == "tests" || e.StartsWith(".")) { continue; }
        string sub = Path.Join(dir, e);
        if (Directory.Exists(sub)) { _tcCollect(sub, found); }
    }
}

bool _tcHasUnits(string dir) {
    string td = Path.Join(dir, "tests");
    if (!Directory.Exists(td)) { return false; }
    foreach (var e in Directory.Enumerate(td)) {
        if (e != "fixtures") { return true; }
    }
    return false;
}

// 工程名取 project.name；工作区和非工程目录不作为测试包。
string _toolchainPkgName(string dir) {
    ManifestLocation found = _findManifest(dir);
    return found.Kind == ManifestLocateKind.Project
        ? ManifestLoader.Load(found.ManifestPath).Project.Name : "";
}

bool _toolchainPkgMatches(string root, string dir, string comp) {
    if (comp.Length == 0) { return true; }
    if (_toolchainPkgName(dir) == comp) { return true; }
    string base = Path.Join(root, "src/toolchain") + "/";
    string rel = dir.StartsWith(base) ? dir.Substring(base.Length) : dir;
    return rel == comp || rel.StartsWith(comp + "/");
}
