// z42b 命令行与 manifest 目标夹具；断言随最小工程放在 expect.toml，执行复用通用引擎。
namespace Z42Xtask;

int _testBuilderCliFixtures(string root, TargetTooling tt) {
    DevFixtureTool builder = new DevFixtureTool("z42b", tt.Vm, true);
    builder.Pre = new string[]{ tt.BuilderZpkg, "--mode", _z42cMode(), "--" };
    builder.Requires = tt.BuilderZpkg;
    int failed = 0;
    foreach (var fixtures in new string[]{ "z42b", "manifest-targets" }) {
        FixtureSuite s = new FixtureSuite("z42b 命令行与构建夹具", "src/toolchain/builder/tests/fixtures/" + fixtures);
        s.DefaultTool = "z42b";
        s.DefaultLibs = tt.Libs;
        s.Vars = new FixturePair[]{ new FixturePair("vm", tt.Vm), new FixturePair("rid", _detectHostRid()) };
        s.Tools = new FixtureTool[]{ builder };
        int[] results = _runFixtureSuite(root, s);
        failed = failed + results[1];
    }
    return failed;
}
