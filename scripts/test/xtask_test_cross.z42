// xtask — cross-zpkg e2e runner.
//
// Each fixture under src/compiler/z42c.pipeline/tests/fixtures/cross-zpkg/<name>/ ships z42.toml
// packages target / [ext] / main (+ optional oldtarget/) plus expected_output.txt (or
// expected_build_error.txt for a negative case; see that directory's README). Packages are built in
// dependency order, each <pkg>/libs/ seeded with the prior zpkgs so cross-package symbols resolve;
// then main's zpkg runs on z42vm with a temp libs dir (stdlib + the fixture's packages) and
// stdout+stderr is diffed against expected:
//   1. z42c build <target>/z42.toml   (no deps)
//   2. z42c build <ext>/z42.toml      (deps on target)
//   3. z42c build <main>/z42.toml     (deps on target + ext)
//   4. z42vm <main>.zpkg --mode <interp|jit>
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

// 硬链接写穿透门。本 stage 把 stdlib **硬链接**进每个 fixture 的临时
// `Z42_LIBS`（`_copyStdlibZpkgs`），而 `File.Copy` 是
// truncate 语义 ⇒ 写到别名上会把**真正的 flat dist 与成员 dist 一起改掉**。躲过它
// 靠的是「fixture 包都叫 `demo.*`，不与 `z42.*` 撞名」这个巧合，没有任何东西约束它。
//
// ⇒ 每轮开跑前**真做一遍**：建一对硬链接、往其中一条 `_copyAll`，断言另一条没变。
// （查「规则在不在」要查行为——静态扫一眼 `_copyAll` 里有没有那行 unlink 是查码。）
// 注入验证：把 `_unlinkIfExists` 从 `_copyAll` 里去掉，本门当场红。
int _assertCopyDoesNotWriteThroughHardLinks(string root) {
    string tmp = _xtaskWork(root, "fs-writethrough");
    _resetDir(tmp);
    string srcDir = Path.Join(tmp, "src");
    string aliasDir = Path.Join(tmp, "alias");
    string otherDir = Path.Join(tmp, "other");
    Directory.Create(srcDir); Directory.Create(aliasDir); Directory.Create(otherDir);

    string keep = Path.Join(srcDir, "p.zpkg");
    File.WriteAllText(keep, "ORIGINAL");
    _linkAll(srcDir, aliasDir, "*.zpkg");          // alias/p.zpkg 与 src/p.zpkg 同 inode
    File.WriteAllText(Path.Join(otherDir, "p.zpkg"), "OVERWRITE");
    _copyAll(otherDir, aliasDir, "*.zpkg");        // 往别名上写

    string after = File.ReadAllText(keep);
    if (after != "ORIGINAL") {
        Console.WriteLine("  ✗ 拷贝穿透了硬链接：src/p.zpkg 本应是 ORIGINAL，实际是 " + after);
        Console.WriteLine("    `File.Copy` 保留 inode ⇒ 写别名会改掉源文件。");
        Console.WriteLine("    修法：写入前先 File.Delete(dst) 断链（scripts/common/xtask_fs.z42）。");
        return 1;
    }
    // 硬链接本身还在不在（别把优化一起删了）：copy 之后 alias 应是独立的新文件。
    if (File.ReadAllText(Path.Join(aliasDir, "p.zpkg")) != "OVERWRITE") {
        Console.WriteLine("  ✗ 断链之后 _copyAll 没把新内容写进去");
        return 1;
    }
    Directory.Delete(tmp, true);
    return 0;
}

// Returns 0 if every cross-zpkg case passes, 1 on any failure (or setup error).
int _testCrossZpkgImpl(string mode) {
    string root = _root();
    if (_assertCopyDoesNotWriteThroughHardLinks(root) != 0) { return 1; }

    // 在 build/ 镜像里的**拷贝**上编 / 跑，源码树零写入（`_stageFixtureTree`）。下面所有路径
    // （`_fixtureDist` / `<pkg>/libs` / expected_*.txt）都相对 testsDir。
    if (!Directory.Exists(Path.Join(root, "src/compiler/z42c.pipeline/tests/fixtures/cross-zpkg"))) { return 0; }
    string testsDir = _stageFixtureTree(root, "src/compiler/z42c.pipeline/tests/fixtures/cross-zpkg");
    // Toolset (_resolveToolset, shared with the multi-exe harness). With `--toolchain` active,
    // z42c.driver + stdlib + z42vm come from that `.z42` set, which ships RELEASE z42vm only →
    // compile + run both use it. On the build tree the two roles split:
    //   compileVm = RELEASE  — runs z42c.driver to build fixtures (the hot path: the per-fixture
    //                          3-stage z42c compile dominates wall time)
    //   runVm     = DEBUG    — runs each fixture's main.zpkg, so debug-assertions +
    //                          overflow-checks still guard real cross-package execution
    //                          (compiling on debug adds NO coverage — assertions fire at run).
    ToolsetZ ts = _resolveToolset(root);
    if (!ts.Ok) { return 1; }
    string stdlibDist = ts.StdlibDist;
    string compileVm  = ts.CompileVm;
    string runVm      = ts.RunVm;
    string driverZpkg = ts.DriverZpkg;

    // ── Enumerate test directories ───────────────────────────────────────
    string[] names = _enumDirsSorted(testsDir);

    int pass = 0;
    var failures = new List<string>();

    // ── 分波并发 ─────────────────────────────────────────────
    //
    // 每个 fixture 内部 target→ext→main **有真实依赖、必须串行**；但 **fixture 之间
    // 完全独立**。所以按「波次」并发：全部 target 一起编 → 等 → 全部 ext → 等 →
    // 全部 main → 等 → 全部 run。波内并发度见 _crossJobs()。
    //
    // ⚠️ 成本由每进程 z42c 启动主导：**瓶颈是进程数，不是 I/O**（stdlib 拷贝换成硬链接实测
    // 只是噪声）。别往 I/O 方向猜。
    var actList = new List<string>();
    foreach (var name in names) {
        // `expected_build_error.txt` = **期望 main 编译失败**的负例 fixture（内容 = stderr 必须包含的
        // 子串）。两个都没有的目录不是 fixture。
        string _fxDir = Path.Join(testsDir, name);
        if (File.Exists(Path.Join(_fxDir, "expected_output.txt"))
            || File.Exists(Path.Join(_fxDir, "expected_build_error.txt"))) {
            actList.Add(name);
        }
    }
    string[] act = actList.ToArray();
    int nAct = act.Length;

    string[] label = new string[nAct];   // "" = 仍存活；非空 = 失败标签（后续波次跳过它）
    for (int i = 0; i < nAct; i++) { label[i] = ""; }

    _crossBuildWave(act, label, testsDir, "target", compileVm, driverZpkg, stdlibDist);
    // 可选 `oldtarget/` —— 与 target **同工程名**、但成员更少的
    // 旧版依赖，只在运行前顶替 target 的产物（见 _applySkewReplace）。不参与 main 的编译。
    _crossBuildWave(act, label, testsDir, "oldtarget", compileVm, driverZpkg, stdlibDist);
    _crossBuildWave(act, label, testsDir, "ext",    compileVm, driverZpkg, stdlibDist);
    _crossBuildWave(act, label, testsDir, "main",   compileVm, driverZpkg, stdlibDist);
    _crossRunWave(act, label, testsDir, stdlibDist, runVm, mode);

    for (int i = 0; i < nAct; i++) {
        if (label[i].Length == 0) {
            Console.WriteLine("  PASS " + act[i]);
            pass = pass + 1;
        } else {
            Console.WriteLine("  FAIL " + label[i]);
            failures.Add(label[i]);
        }
    }

    return _fixtureSummary(pass, failures);
}


// ── 波次 build / run ─────────────────────────────────────────────────────

// 波内并发度。同 golden regen 的理由：成本由每进程 z42c 启动主导，超核数仍获益，
// 但少核机器（GitHub 4 核 runner）不冒进 → max(8, CpuCount())；`Z42_XPKG_JOBS` 逃生舱
// 便于在 CI 上实测更高值而不改代码。
int _crossJobs() {
    string ov = Environment.GetEnvironmentVariable("Z42_XPKG_JOBS", "");
    if (ov.Length > 0) {
        try { int v = int.Parse(ov); if (v > 0) { return v; } } catch (Exception e) { }
    }
    int cpu = OperatingSystem.CpuCount();
    return cpu > 8 ? cpu : 8;
}

// 一波 build：对所有仍存活的 fixture 并发编同一个 stage（target/ext/main）。
// stage 的依赖 libs 就地准备好后再 spawn；失败者写 label，后续波次自动跳过。
void _crossBuildWave(string[] act, string[] label, string testsDir, string stage,
                     string vmBin, string driverZpkg, string stdlibDist) {
    int jobs = _crossJobs();
    int k = 0;
    while (k < act.Length) {
        int bsz = jobs; if (k + bsz > act.Length) { bsz = act.Length - k; }
        FixtureBuildZ[] hs = new FixtureBuildZ[bsz];
        for (int b = 0; b < bsz; b++) {
            int idx = k + b;
            if (label[idx].Length > 0) { continue; }
            string dir = Path.Join(testsDir, act[idx]);
            string pkgDir = Path.Join(dir, stage);
            // 在建 libs 前判断可选目录；_prepPkgLibs 会创建 pkgDir。
            if ((stage == "ext" || stage == "oldtarget") && !Directory.Exists(pkgDir)) { continue; }
            string deps = stage == "ext" || stage == "main" ? _fixtureDist(Path.Join(dir, "target")) : "";
            string toml = _prepPkgLibs(pkgDir, deps);
            if (stage == "main") {
                _copyZpkgs(_fixtureDist(Path.Join(dir, "ext")), Path.Join(pkgDir, "libs"));
            }
            if (toml.Length == 0) {
                label[idx] = act[idx] + " (" + stage + ": no toml)";
                continue;
            }
            string expErr = stage == "main" ? _crossExpectedBuildError(dir) : "";
            string expWarn = stage == "main" ? _crossExpectedBuildWarning(dir) : "";
            hs[b] = _spawnBuildPkgE(vmBin, driverZpkg, stdlibDist, pkgDir, toml, expErr, expWarn);
        }
        for (int b = 0; b < bsz; b++) {
            if (hs[b] != null && !_awaitBuildPkg(hs[b])) {
                label[k + b] = act[k + b] + " (" + stage + " build)";
            }
        }
        k = k + bsz;
    }
}

// 波内并发执行、按夹具顺序回收；每个 job 独占一份临时 libs。
void _crossRunWave(string[] act, string[] label, string testsDir,
                   string stdlibDist, string runVm, string mode) {
    int jobs = _crossJobs();
    for (int k = 0; k < act.Length; k = k + jobs) {
        int bsz = jobs; if (k + bsz > act.Length) { bsz = act.Length - k; }
        CrossRunZ[] runs = new CrossRunZ[bsz];
        for (int b = 0; b < bsz; b++) {
            int idx = k + b;
            string dir = Path.Join(testsDir, act[idx]);
            // 编译负例在 build 波已经验证，不产生可运行的 main。
            if (label[idx].Length > 0 || File.Exists(Path.Join(dir, "expected_build_error.txt"))) { continue; }
            try {
                runs[b] = _spawnCrossRun(dir, stdlibDist, runVm, mode);
            } catch (Exception e) {
                label[idx] = act[idx] + " (run setup: " + e.Message + ")";
            }
        }
        for (int b = 0; b < bsz; b++) {
            if (runs[b] != null && !_awaitCrossRun(runs[b], Path.Join(testsDir, act[k + b]))) {
                label[k + b] = act[k + b];
            }
        }
    }
}

class CrossRunZ {
    public ProcessHandle H;
    public string Libs;
}

CrossRunZ _spawnCrossRun(string dir, string stdlibDist, string runVm, string mode) {
    string mainDir = Path.Join(dir, "main");
    string mainDist = _fixtureDist(mainDir);
    string toml = _findManifest(mainDir).ManifestPath;
    string name = toml.Length > 0 ? _tomlField(toml, "project.name", "") : "";
    // packed exe 的 dist 还含依赖；优先按工程名取主包，避免误运行依赖。
    string zpkg = name.Length > 0 ? Path.Join(mainDist, name + ".zpkg") : "";
    if (!File.Exists(zpkg)) { zpkg = _firstZpkg(mainDist); }
    if (zpkg.Length == 0) { throw new Exception("no zpkg"); }
    CrossRunZ run = new CrossRunZ();
    run.Libs = File.CreateTempDir("z42-xpkg-");
    try {
        _copyStdlibZpkgs(stdlibDist, run.Libs);
        _copyZpkgs(_fixtureDist(Path.Join(dir, "target")), run.Libs);
        _copyZpkgs(_fixtureDist(Path.Join(dir, "ext")), run.Libs);
        _applySkewAbsent(dir, run.Libs, mainDist);
        _applySkewReplace(dir, run.Libs, mainDist);
        run.H = _z42Proc(runVm, run.Libs).Arg(zpkg).Arg("--mode").Arg(mode).Spawn();
    } catch (Exception e) {
        Directory.Delete(run.Libs, true);
        throw e;
    }
    return run;
}

bool _awaitCrossRun(CrossRunZ run, string dir) {
    string actual = "";
    string error = "";
    bool ok = false;
    try {
        ProcessResult r = run.H.Wait();
        actual = r.Stdout + r.Stderr;
        r.EnsureSuccess();
        ok = true;
    } catch (Exception e) { error = e.Message; }
    Directory.Delete(run.Libs, true);
    string expected = File.ReadAllText(Path.Join(dir, "expected_output.txt"));
    if (ok && actual == expected) { return true; }
    Console.WriteLine("  ── " + Path.GetFileName(dir) + " ──");
    if (error.Length > 0) { Console.WriteLine("    run: " + error); }
    Console.WriteLine("    expected: " + _firstLines(expected, 3));
    Console.WriteLine("    actual:   " + _firstLines(actual, 3));
    return false;
}

// ── 版本 skew 模拟 ───────────────────────────────────────────
//
// 可选 `skew-absent.txt` —— 每行一个 zpkg 文件名，
// 运行**前**从两处删除，模拟「编译时依赖在场、运行时不在场」的版本 skew。
//
// ⚠️ 必须两处都删：packed exe build 会把依赖 zpkg **colocate 进 main/dist**，而 VM 的
// 惰性加载器先搜 entry zpkg 同目录再搜 Z42_LIBS —— 只删 libs 里那份，colocate 副本仍会
// 被找到，负例会静默变成正例。
//
// 只影响声明了本文件的 fixture；其余用例零行为变化。
void _applySkewAbsent(string caseDir, string testLibs, string mainDist) {
    string marker = Path.Join(caseDir, "skew-absent.txt");
    if (!File.Exists(marker)) { return; }
    foreach (var line in File.ReadAllText(marker).Split("\n")) {
        string nm = line.Trim();
        if (nm.Length > 0) {
            string a = Path.Join(testLibs, nm);
            if (File.Exists(a)) { File.Delete(a); }
            string c = Path.Join(mainDist, nm);
            if (File.Exists(c)) { File.Delete(c); }
        }
    }
}

// 可选 `skew-replace.txt` —— 每行一个 zpkg 文件名，运行**前**
// 用 `oldtarget/` 建出的同名产物顶替 testLibs 与 main/dist 里那份。
//
// 与 `skew-absent.txt`（整包不在场）的分工：absent 只能演示「依赖整个消失」，证不了
// 「**类型还在、某个成员没了**」——而后者才是依赖版本 skew 的常态。oldtarget 与 target
// **同工程名**、成员更少，main 仍按 target（新版）编译，运行时却加载到 oldtarget（旧版）。
//
// ⚠️ 与 absent 同理，必须两处都顶替：packed exe build 会把依赖 colocate 进 main/dist，
// 而惰性加载器先搜 entry zpkg 同目录 —— 只换 libs 那份，colocate 的新版仍会赢。
void _applySkewReplace(string caseDir, string testLibs, string mainDist) {
    string marker = Path.Join(caseDir, "skew-replace.txt");
    if (!File.Exists(marker)) { return; }
    string oldDist = _fixtureDist(Path.Join(caseDir, "oldtarget"));
    foreach (var line in File.ReadAllText(marker).Split("\n")) {
        string nm = line.Trim();
        if (nm.Length > 0) {
            string src = Path.Join(oldDist, nm);
            if (File.Exists(src)) {
                string a = Path.Join(testLibs, nm);
                if (File.Exists(a)) { File.Delete(a); }
                File.Copy(src, a);
                string c = Path.Join(mainDist, nm);
                if (File.Exists(c)) { File.Delete(c); File.Copy(src, c); }
            }
        }
    }
}

// Return first `n` lines joined by '|'.
string _firstLines(string s, int n) {
    string result = "";
    int count = 0;
    int start = 0;
    int i = 0;
    while (i < s.Length && count < n) {
        if (s.CharAt(i) == '\n') {
            if (result.Length > 0) { result = result + "|"; }
            result = result + s.Substring(start, i - start);
            count = count + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (count < n && start < s.Length) {
        if (result.Length > 0) { result = result + "|"; }
        result = result + s.Substring(start, s.Length - start);
    }
    return result;
}

// 读 fixture 的 `expected_build_error.txt`（trim；不存在 → ""）。
string _crossExpectedBuildError(string dir) {
    string f = Path.Join(dir, "expected_build_error.txt");
    if (!File.Exists(f)) { return ""; }
    return File.ReadAllText(f).Trim();
}

// 读 fixture 的 `expected_build_warning.txt`（trim；不存在 → ""）。
string _crossExpectedBuildWarning(string dir) {
    string f = Path.Join(dir, "expected_build_warning.txt");
    if (!File.Exists(f)) { return ""; }
    return File.ReadAllText(f).Trim();
}

// 重建一个 pkg 的 libs 目录（并入 srcLibsDir 的 zpkg），返回该 pkg 的 toml（"" = 找不到）。
string _prepPkgLibs(string pkgDir, string srcLibsDir) {
    string pkgLibs = Path.Join(pkgDir, "libs");
    if (Directory.Exists(pkgLibs)) { Directory.Delete(pkgLibs, true); }
    Directory.Create(pkgLibs);
    if (srcLibsDir.Length > 0) { _copyZpkgs(srcLibsDir, pkgLibs); }
    return _findManifest(pkgDir).ManifestPath;
}
