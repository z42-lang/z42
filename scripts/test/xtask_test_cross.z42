// xtask — cross-zpkg e2e runner (folded from the former scripts/test-cross-zpkg.z42
// by the unify-scripts-into-xtask cross-zpkg fold). Same Z42Xtask namespace; the
// generic helpers it relies on (_enumDirsSorted / _sortStrings / _append) live in
// xtask_golden.z42, and _root / _z42vm come from xtask.z42 (cross-file, same ns).
//
// Each test under src/tests/cross-zpkg/<name>/ ships three z42.toml packages
// (target / ext / main) plus expected_output.txt. We build them in
// dependency order, populating each one's <pkg>/libs/ with prior zpkgs so
// PackageCompiler's lib lookup resolves cross-package symbols. Then run
// main's zpkg through z42vm with a temp libs dir that bundles stdlib +
// our two test packages, capture stdout, and diff against expected.
//
// Build / run sequence per test (z42c.driver.zpkg on z42vm):
//   1. z42vm z42c.driver.zpkg build <target>/z42.toml   (no deps)
//   2. z42vm z42c.driver.zpkg build <ext>/z42.toml      (deps on target)
//   3. z42vm z42c.driver.zpkg build <main>/z42.toml     (deps on target + ext)
//   4. z42vm <main>.zpkg --mode <interp|jit>            (run + capture stdout)
//
// `mode` arrives as the function parameter (resolved by _testCrossZpkg in
// xtask_test.z42), replacing the former Z42_VM_MODE env hop.
namespace Z42Xtask;

using Std;
using Std.IO;

// Returns 0 if every cross-zpkg case passes, 1 on any failure (or setup error).
int _testCrossZpkgImpl(string mode) {
    string root = _root();

    string testsDir = Path.Join(root, "src/tests/cross-zpkg");
    // --toolchain (compile-once P3): when an active toolchain is selected, locate
    // z42c.driver + its siblings + stdlib + z42vm from that `.z42` set (the
    // downloaded current-sdk consumed cross-job) instead of the build-tree.
    // The toolchain ships RELEASE z42vm only → compile + run both use it.
    //
    // speed-up-cross-zpkg-compile-vm: the cross-zpkg wall-time cost is the per-fixture
    // 3-stage z42c compile (target→ext→main), ~40 z42c invocations per full run. On the
    // build-tree path those ran on the DEBUG vm and were the ~18min pole of
    // test-host(linux-x64). Split the two roles:
    //   compileVm = RELEASE  — runs z42c.driver to build fixtures (the hot path)
    //   runVm     = DEBUG    — runs each fixture's main.zpkg, so debug-assertions +
    //                          overflow-checks still guard real cross-package execution
    //                          (the coverage that only debug vm gives; compiling on
    //                          debug adds NO coverage — assertions fire at run, not build).
    string tc = _toolchainDir(root);
    string stdlibDist;
    string driverHome;
    string compileVm;
    string runVm;
    if (tc.Length > 0) {
        stdlibDist = _toolchainLibs(tc);
        driverHome = _toolchainDriverHome(tc);   // driver + 7 siblings colocated
        compileVm = _toolchainVm(tc);
        runVm = compileVm;                        // toolchain ships release vm only
    } else {
        stdlibDist = _libsDir(root);
        // replace-csharp Phase B：cross-zpkg gate 改用 z42c（z42vm + z42c.driver.zpkg），
        // 不再依赖 dotnet。driverHome = 含 z42c.driver.zpkg + 7 个 z42c.* 兄弟的目录
        // （z42vm 从 entry zpkg 所在目录解析其依赖；compilation 的 fixture deps + stdlib 走 Z42_LIBS）。
        driverHome = _assembleDriverHome(root);
        runVm = _builtVm(root, "debug");
        compileVm = _builtVm(root, "release");
        // Release vm missing (rare local path): fall back to debug for compile too.
        if (!File.Exists(compileVm)) { compileVm = runVm; }
    }
    if (driverHome.Length == 0) {
        ConsoleError.WriteLine("error: z42c driver not built (artifacts/build/compiler/z42c.*/release/dist)");
        ConsoleError.WriteLine("       Build it via: ./xtask test compiler  (or build stdlib)");
        return 1;
    }
    string driverZpkg = Path.Join(driverHome, "z42c.driver.zpkg");
    if (!File.Exists(compileVm) || !File.Exists(runVm)) {
        ConsoleError.WriteLine("error: z42vm not found (compile=" + compileVm + " run=" + runVm + ")");
        ConsoleError.WriteLine("       Build it via: cargo build --manifest-path src/runtime/Cargo.toml");
        return 1;
    }

    // ── Enumerate test directories ───────────────────────────────────────
    string[] names = _enumDirsSorted(testsDir);

    int pass = 0;
    int fail = 0;
    string[] failures = new string[8];
    int      failCount = 0;

    int i = 0;
    while (i < names.Length) {
        string name = names[i];
        string dir = Path.Join(testsDir, name);
        if (!File.Exists(Path.Join(dir, "expected_output.txt"))) {
            i = i + 1;
            continue;
        }

        Console.WriteLine("── Test: " + name + " ──");
        string failLabel = _runOneCrossCase(compileVm, runVm, driverZpkg, stdlibDist, dir, name, mode);
        if (failLabel.Length == 0) {
            pass = pass + 1;
        } else {
            fail = fail + 1;
            failures = _append(failures, failCount, failLabel);
            failCount = failCount + 1;
        }

        i = i + 1;
    }

    return _crossSummary(pass, fail, failures, failCount);
}

// Build + run one cross-zpkg case: three-stage build in dep order (target → ext
// → main, each seeding the next one's libs), then run main's zpkg through z42vm
// and diff stdout against expected_output.txt. Returns "" on pass, else a
// failure label (containing `name`) for the summary. Extracted from
// _testCrossZpkgImpl so the driver loop stays a thin pass/fail tally (review §2.8).
string _runOneCrossCase(string compileVm, string runVm, string driverZpkg, string stdlibDist, string dir, string name, string mode) {
    string targetDir = Path.Join(dir, "target");
    string extDir    = Path.Join(dir, "ext");
    string mainDir   = Path.Join(dir, "main");

    // Stages 1–3 build fixtures with compileVm (release: the hot path); the final
    // main.zpkg run below uses runVm (debug: assertion + overflow coverage).

    // Stage 1: target (no deps).
    if (!_buildCompilerPkg(compileVm, driverZpkg, stdlibDist, targetDir, "")) {
        return name + " (target build)";
    }

    // Stage 2: ext (deps on target/dist).
    if (!_buildCompilerPkg(compileVm, driverZpkg, stdlibDist, extDir, _fixtureDist(targetDir))) {
        return name + " (ext build)";
    }

    // Stage 3: main (deps on target + ext). _buildCompilerPkg only seeds from a
    // single dir; main needs both, so populate libs manually here.
    string mainLibs = Path.Join(mainDir, "libs");
    if (Directory.Exists(mainLibs)) { Directory.Delete(mainLibs, true); }
    Directory.Create(mainLibs);
    _copyZpkgs(_fixtureDist(targetDir), mainLibs);
    _copyZpkgs(_fixtureDist(extDir), mainLibs);
    string mainToml = _findToml(mainDir);
    if (mainToml.Length == 0 || !_invokeBuildCompiler(compileVm, driverZpkg, stdlibDist, mainDir, mainToml)) {
        Console.WriteLine("    main build failed");
        return name + " (main build)";
    }

    // Stage 4: run the MAIN APP's zpkg (by project name) through z42vm.
    // A packed exe build can leave dependency zpkgs alongside main.zpkg in the
    // dist dir; the former `_firstZpkg` (sorted glob[0]) then intermittently
    // picked a *dependency* that sorts before the app — e.g. generic_field_carry
    // (app `demo.gmain`, dep `demo.gext` < `demo.gmain`) → the dep has no baked
    // entry → "no entry point" (flaky; only that case is vulnerable). Select the
    // app zpkg by name so the run is correct regardless of what else is in dist.
    // (fix-crosszpkg-run-app-by-name)
    string appName = _tomlName(mainToml);
    string mainZpkg = "";
    if (appName.Length > 0) {
        string cand = Path.Join(_fixtureDist(mainDir), appName + ".zpkg");
        if (File.Exists(cand)) { mainZpkg = cand; }
    }
    if (mainZpkg.Length == 0) { mainZpkg = _firstZpkg(_fixtureDist(mainDir)); }   // fallback
    if (mainZpkg.Length == 0) {
        Console.WriteLine("    main produced no zpkg");
        return name + " (no zpkg)";
    }

    // Per-test libs dir: stdlib zpkgs + target + ext.
    string testLibs = File.CreateTempDir("z42-xpkg-");
    _copyStdlibZpkgs(stdlibDist, testLibs);
    _copyZpkgs(_fixtureDist(targetDir), testLibs);
    _copyZpkgs(_fixtureDist(extDir), testLibs);

    string actual = "";
    bool runErr = false;
    try {
        ProcessResult vmResult = new Process(runVm)
            .Arg(mainZpkg)
            .Arg("--mode").Arg(mode)
            .Env("Z42_LIBS", testLibs)
            .Run();
        // bash: `$(... 2>&1)` — merge stderr into stdout. We approximate
        // by concatenating; a passing VM run produces no stderr, so for
        // successful tests the order doesn't matter.
        actual = vmResult.Stdout + vmResult.Stderr;
    } catch (Exception e) {
        runErr = true;
    }
    Directory.Delete(testLibs, true);

    string expected = File.ReadAllText(Path.Join(dir, "expected_output.txt"));
    if (!runErr && actual == expected) {
        Console.WriteLine("  PASS");
        return "";
    }
    Console.WriteLine("  FAIL");
    Console.WriteLine("    expected: " + _firstLines(expected, 3));
    Console.WriteLine("    actual:   " + _firstLines(actual,   3));
    return name;
}

// Print the pass/fail tally + any failure list; returns process rc (0 = all pass).
int _crossSummary(int pass, int fail, string[] failures, int failCount) {
    Console.WriteLine("");
    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Total: " + pass.ToString() + " passed, "
        + fail.ToString() + " failed");
    Console.WriteLine("══════════════════════════════════════");

    if (failCount > 0) {
        Console.WriteLine("");
        Console.WriteLine("Failed tests:");
        int fi = 0;
        while (fi < failCount) {
            Console.WriteLine("  - " + failures[fi]);
            fi = fi + 1;
        }
        return 1;
    }
    return 0;
}

// ── z42c build path (replace-csharp Phase B：cross-zpkg gate 脱 dotnet) ──────

// 组装 z42c driver-home：含 z42c.driver.zpkg + 7 个 z42c.* 兄弟（从 per-member dist）。
// z42vm 从 entry zpkg 所在目录解析其依赖，故 driver 的 z42c.* 依赖放这里，与
// compilation 的 Z42_LIBS（stdlib + fixture deps）隔离，避免单-libs 目录污染。
// 返回 driver-home 目录路径；z42c 未构建（缺任一成员 dist）返回 ""。
string _assembleDriverHome(string root) {
    string baseDir = Path.Join(root, "artifacts/build/compiler");
    // Single SoT: compiler workspace default-members (same source as build/test/
    // bootstrap-check), so adding a z42c.* member doesn't silently drift this assembly.
    string[] members = _compilerMembers(root);
    // Fixed scratch path (not a /tmp TempDir): the returned home lives for the whole
    // cross-zpkg run and had no deleter → every run leaked a /tmp dir. artifacts/.scratch
    // is gitignored + reused; delete+recreate makes it self-cleaning across runs.
    string home = Path.Join(root, "artifacts/.scratch/xpkg-driver");
    if (Directory.Exists(home)) { Directory.Delete(home, true); }
    Directory.Create(home);
    int i = 0;
    while (i < members.Length) {
        string m = members[i];
        string src = Path.Join(Path.Join(Path.Join(Path.Join(baseDir, m), "release"), "dist"), m + ".zpkg");
        if (!File.Exists(src)) { return ""; }
        try { File.Copy(src, Path.Join(home, m + ".zpkg")); } catch (Exception e) { return ""; }
        i = i + 1;
    }
    return home;
}

// 用 z42c 编译一个 package（z42vm 跑 z42c.driver.zpkg）。先把上一阶段产物 copy 进
// <pkgDir>/libs，再 build → <pkgDir>/artifacts/debug/dist（与 C# 路径一致 → 下游
// run/diff 不变）。
bool _buildCompilerPkg(string vmBin, string driverZpkg, string stdlibDist, string pkgDir, string srcLibsDir) {
    string pkgLibs = Path.Join(pkgDir, "libs");
    if (Directory.Exists(pkgLibs)) { Directory.Delete(pkgLibs, true); }
    Directory.Create(pkgLibs);
    if (srcLibsDir.Length > 0) { _copyZpkgs(srcLibsDir, pkgLibs); }
    string toml = _findToml(pkgDir);
    if (toml.Length == 0) {
        Console.WriteLine("    error: no toml in " + pkgDir);
        return false;
    }
    return _invokeBuildCompiler(vmBin, driverZpkg, stdlibDist, pkgDir, toml);
}

// 单次 z42c build。outDir = <pkgDir>/artifacts/debug/dist。Z42_LIBS = temp(stdlib +
// pkgDir/libs)；z42c.* 由 driver-home 解析。WorkingDirectory=pkgDir（镜像手验）。
bool _invokeBuildCompiler(string vmBin, string driverZpkg, string stdlibDist, string pkgDir, string toml) {
    string outDir = _fixtureDist(pkgDir);
    Directory.Create(outDir);
    string libs = File.CreateTempDir("z42-xpkg-libs-");
    _copyStdlibZpkgs(stdlibDist, libs);
    _copyZpkgs(Path.Join(pkgDir, "libs"), libs);
    bool ok = false;
    try {
        ProcessResult br = new Process(vmBin)
            .Arg(driverZpkg).Arg("--mode").Arg(_z42cMode())
            .Arg("--").Arg("build").Arg(toml)
            .Arg("--output-dir").Arg(outDir).Arg("--release")
            .WorkingDirectory(pkgDir)
            .Env("Z42_LIBS", libs)
            .Stdout(Stdio.Null())
            .Stderr(Stdio.Null())
            .Run();
        ok = br.ExitCode == 0;
    } catch (Exception e) {
        ok = false;
    }
    Directory.Delete(libs, true);
    return ok;
}

// ── Path / file helpers (cross-specific) ─────────────────────────────────

// Thin wrappers over _copyAll (build/xtask_compiler.z42): identical error
// handling (Directory.Exists guard + try/catch skip), plus a harmless self-copy
// guard (src≠dst always holds for these fixture-staging callers).
void _copyZpkgs(string srcDir, string dstDir) {
    _copyAll(srcDir, dstDir, "*.zpkg");
}

// Stdlib artifacts live in the FLAT dist view at
// artifacts/build/libraries/dist/release (the same layout Z42_LIBS / _z42vm
// consume). Copy *.zpkg + *.zsym from there.
void _copyStdlibZpkgs(string distDir, string dstDir) {
    _copyAll(distDir, dstDir, "*.zpkg");
    _copyAll(distDir, dstDir, "*.zsym");
}

// <pkgDir>/artifacts/debug/dist — where a per-package z42c build lands its zpkg
// (mirrors the former C# path; consumed by run/diff + downstream lib seeding).
string _fixtureDist(string pkgDir) {
    return Path.Join(Path.Join(Path.Join(pkgDir, "artifacts"), "debug"), "dist");
}

string _findToml(string dir) {
    if (!Directory.Exists(dir)) return "";
    string[] hits = Path.Glob(dir, "*.toml");
    if (hits.Length == 0) return "";
    return hits[0];
}

string _firstZpkg(string dir) {
    if (!Directory.Exists(dir)) return "";
    string[] hits = Path.Glob(dir, "*.zpkg");
    if (hits.Length == 0) return "";
    return hits[0];
}

// [project] `name` from a z42.toml (the bare `name = "..."` line; dependency
// entries are quoted-key `"pkg" = "ver"`, so their key != "name"). Empty on miss.
// Used to pick the app zpkg by name in Stage 4 (fix-crosszpkg-run-app-by-name).
string _tomlName(string tomlPath) {
    if (!File.Exists(tomlPath)) return "";
    string txt = File.ReadAllText(tomlPath);
    string[] lines = txt.Split("\n");
    int i = 0;
    while (i < lines.Length) {
        string ln = lines[i].Trim();
        int eq = ln.IndexOf("=");
        if (eq > 0 && ln.Substring(0, eq).Trim() == "name") {
            string rest = ln.Substring(eq + 1);
            int q1 = rest.IndexOf("\"");
            if (q1 >= 0) {
                string after = rest.Substring(q1 + 1);
                int q2 = after.IndexOf("\"");
                if (q2 >= 0) { return after.Substring(0, q2); }
            }
        }
        i = i + 1;
    }
    return "";
}

// Return first `n` lines joined by '|' — matches bash `head -3 | tr '\n' '|'`.
string _firstLines(string s, int n) {
    string result = "";
    int count = 0;
    int start = 0;
    int i = 0;
    while (i < s.Length && count < n) {
        if (s.CharAt(i) == '\n') {
            if (result.Length > 0) { result = result + "|"; }
            result = result + s.Substring(start, i - start);
            count = count + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (count < n && start < s.Length) {
        if (result.Length > 0) { result = result + "|"; }
        result = result + s.Substring(start, s.Length - start);
    }
    return result;
}
