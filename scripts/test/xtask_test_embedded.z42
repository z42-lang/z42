// xtask — embedded test-host (wire-embedded-testhost, 2026-08-02;
// wire-z42b-embedded-test ②b, 2026-08-29).
//
// xtask is the fleet ORCHESTRATOR here: it discovers/compiles the corpus into a
// test-bundle (manifest.json + case zbcs) and, per RID, hands that bundle to z42b
// (the single-bundle EXECUTOR):
//   • host (desktop)  → z42b test <manifest> --rid host   → runs it in-process via
//                       Std.Test.BundleRunner (no testhost/agent spawn on the host).
//   • device (wasm/   → z42b test <manifest> --rid <dev> --out <dir> [--build|--run]
//     ios/android)      → z42b owns the full device pipeline: native platform build
//                       (wasm-pack / xcframework / cargo-ndk) + deploy + device RUN
//                       (Playwright / xcodebuild-sim / gradle, CI-gated). The
//                       test-agent is resolved by z42b from the installed `test`
//                       workload (dogfood, PR-4) — xtask no longer hands it over.
//
// `xtask test embedded [target] [--rid <rid>] [--format json|pretty|tap]`
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Cli;

// Build the shared z42 test-agent → app.zpkg (idempotent: skip if present).
string _ensureTestAgent(string root) {
    string toml = Path.Join(root, "src/toolchain/workload/test/agent/z42.testagent.z42.toml");
    string zpkg = Path.Join(root, "src/toolchain/workload/test/agent/dist/z42.testagent.zpkg");
    if (File.Exists(zpkg)) { return zpkg; }
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root);
    string flat = _assembleAllLibs(root, "release");
    Console.WriteLine("  build test-agent → z42.testagent.zpkg");
    int c = _exec(new Process(vm).Arg(driver).Arg("--mode").Arg(_z42cMode()).Arg("--")
        .Arg("build").Arg(toml).Arg("--release").Env("Z42_LIBS", flat));
    if (c != 0) { return ""; }
    return zpkg;
}

// ── golden → [Test] 归一 (wire-embedded-testhost G1) ─────────────────────────
//
// A golden case is a whole program (source.z42 [+ expected_output.txt]). To run
// it through the single Runner path, generate a [Test] wrapper in the SAME
// module that captures Main()'s stdout and asserts it equals the expected output
// (or, when there is no expected file, just runs Main — Assert-self-validating).
// Proven approach: combine golden source + injected `using Std.Test;` + appended
// [Test] → one module with a [Test] the agent runs like any other.

// Escape a string for embedding as a z42 double-quoted literal.
string _zEscape(string s) {
    string o = s.Replace("\\", "\\\\");
    o = o.Replace("\"", "\\\"");
    o = o.Replace("\r", "");
    o = o.Replace("\n", "\\n");
    return o;
}

// Build the combined golden+wrapper source. Injects `using Std.Test;` after the
// `namespace ...;` line if present, else at the top; appends the [Test] wrapper.
string _wrapGoldenSource(string src, bool hasExpected, string expected) {
    string inject = "using Std.Test;\n";
    string body;
    string[] lines = src.Split("\n");
    int nsIdx = -1;
    for (int i = 0; i < lines.Length; i = i + 1) {
        if (lines[i].Trim().StartsWith("namespace ")) { nsIdx = i; break; }
    }
    if (nsIdx < 0) {
        body = inject + src;
    } else {
        string head = "";
        for (int i = 0; i <= nsIdx; i = i + 1) { head = head + lines[i] + "\n"; }
        string tail = "";
        for (int i = nsIdx + 1; i < lines.Length; i = i + 1) {
            tail = tail + lines[i];
            if (i + 1 < lines.Length) { tail = tail + "\n"; }
        }
        body = head + inject + tail;
    }
    // Use short names (TestIO / Assert) via the injected `using Std.Test;` —
    // fully-qualified `Std.Test.TestIO` parses as a field-access chain (→ Null).
    string wrapper;
    if (hasExpected) {
        wrapper = "\n[Test] void __golden_check() {\n"
            + "    string __c = TestIO.captureStdout(() => { Main(); });\n"
            + "    Assert.Equal(\"" + _zEscape(expected.TrimEnd()) + "\", __c.TrimEnd());\n}\n";
    } else {
        // Assert-self-validating golden: Main throws on failure.
        wrapper = "\n[Test] void __golden_check() { Main(); }\n";
    }
    return body + wrapper;
}

// Build a golden case dir (<caseDir>/source.z42 [+ expected_output.txt]) into a
// [Test]-wrapped .zbc. Returns the .zbc path ("" on failure).
string _buildGoldenCase(string root, string caseDir) {
    string src = Path.Join(caseDir, "source.z42");
    if (!File.Exists(src)) { ConsoleError.WriteLine("error: no source.z42 in " + caseDir); return ""; }
    string srcText = File.ReadAllText(src);
    string expPath = Path.Join(caseDir, "expected_output.txt");
    bool hasExp = File.Exists(expPath);
    string exp = hasExp ? File.ReadAllText(expPath) : "";
    string combined = _wrapGoldenSource(srcText, hasExp, exp);

    string outDir = Path.Join(root, "artifacts/build/embedded-test");
    Directory.Create(outDir);
    string name = Path.GetFileName(caseDir);
    string wrappedSrc = Path.Join(outDir, name + ".golden.z42");
    File.WriteAllText(wrappedSrc, combined);
    string zbc = Path.Join(outDir, name + ".golden.zbc");
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root);
    string flat = _assembleAllLibs(root, "release");
    int c = _exec(new Process(vm).Arg(driver).Arg("--mode").Arg(_z42cMode()).Arg("--")
        .Arg("--emit-zbc").Arg(wrappedSrc).Arg(zbc).Env("Z42_LIBS", flat));
    if (c != 0) { return ""; }
    return zbc;
}

// ── test-bundle 构建 (G2) ────────────────────────────────────────────────────
//
// Enumerate the corpus → compile each case to a .zbc (golden→[Test] wrapped;
// stdlib [Test] unit→direct emit) → copy into a bundle dir + write manifest.json
// (name→zbc). Build-time `filter` (substring; empty=all) bounds what's compiled
// so `--case`/`--filter` don't compile the whole corpus for a single run.

string _bundleSafeName(string name) {
    return name.Replace("/", "__").Replace(".", "_");
}

// Emit a stdlib [Test] unit (single .z42) → .zbc in `bundleDir`. Returns "" on fail.
string _emitUnitZbc(string root, string unitSrc, string safe, string bundleDir) {
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root);
    string flat = _assembleAllLibs(root, "release");
    string zbc = Path.Join(bundleDir, safe + ".zbc");
    int c = _exec(new Process(vm).Arg(driver).Arg("--mode").Arg(_z42cMode()).Arg("--")
        .Arg("--emit-zbc").Arg(unitSrc).Arg(zbc).Env("Z42_LIBS", flat));
    if (c != 0) { return ""; }
    return zbc;
}

// Build a DIR-mode stdlib [Test] unit (tests/<name>/ with helper .z42 files, or
// an own manifest) into a packed .zpkg, then copy it into `bundleDir`. Reuses
// the host runner's `_renderSyntheticManifest` (same build path as `test lib`,
// no duplication) with empty deps — Z42_LIBS=flat resolves every `using`, same
// as single-file `--emit-zbc`. Returns the copied path ("" on failure).
string _emitDirUnit(string root, string lib, string name, string dirPath, string safe, string bundleDir) {
    string projName = lib + ".test." + name;
    string outDir = Path.Join(root, "artifacts/build/embedded-test/dm/" + projName);
    Directory.Create(outDir);
    // Synthetic toml written NEXT TO the sources (glob is manifest-relative);
    // dot-prefixed + unique so it's git-ignored and won't collide.
    string toml = Path.Join(dirPath, ".xtask-embed-" + projName + ".z42.toml");
    File.WriteAllText(toml, _renderSyntheticManifest(projName, "**/*.z42", outDir, name, _newBundle()));
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root);
    string flat = _assembleAllLibs(root, "release");
    int c = _exec(new Process(vm).Arg(driver).Arg("--mode").Arg(_z42cMode()).Arg("--")
        .Arg("build").Arg(toml).Arg("--release").Env("Z42_LIBS", flat));
    File.Delete(toml);   // clean up the synthetic manifest regardless of outcome
    if (c != 0) { return ""; }
    string produced = Path.Join(outDir, "dist/" + projName + ".zpkg");
    if (!File.Exists(produced)) { return ""; }
    string dest = Path.Join(bundleDir, safe + ".zpkg");
    File.Copy(produced, dest, true);
    return dest;
}

// Read a golden's expected_output.txt (or "" when absent = expect empty stdout).
string _readExpected(string path) {
    if (File.Exists(path)) { return File.ReadAllText(path); }
    return "";
}

// Compile a golden source (no [Test] wrap) → <safe>.zbc + write <safe>.expected
// sibling; return its manifest JSON entry, or "" on compile failure (e.g.
// compile-fail goldens — skipped, they aren't runnable-in-embed). Shared by the
// dir / flat / lib golden enumerations. Direct-run: agent runs it isolated.
string _goldenEntry(string root, string caseName, string src, string expTxt, string bundleDir) {
    string safe = _bundleSafeName(caseName);
    string zbc = _emitUnitZbc(root, src, safe, bundleDir);
    if (zbc.Length == 0) { return ""; }
    string entry = _deriveEntry(src);
    File.WriteAllText(Path.Join(bundleDir, safe + ".expected"), expTxt);
    return "    {\"name\": \"" + caseName + "\", \"zbc\": \"" + safe + ".zbc\", "
        + "\"entry\": \"" + entry + "\", \"expected\": \"" + safe + ".expected\"}";
}

// Build the test bundle. Returns the manifest.json path ("" if no cases matched).
// fix-wasm-corpus-capability-gate: a test case whose lib/path needs a runtime
// capability the TARGET platform lacks is excluded from that target's bundle —
// so the in-browser (wasm) corpus stays platform-honest instead of running
// socket/thread/native-fs tests that can't work there (and used to trap the VM).
// Capability model: net→socket, threading→threads, io/json/toml/yaml stream +
// operating_system/env_cwd/process_which → native-fs/env/process. Coarse,
// library-level, covers both [Test] units and goldens (matches the exec-profile
// "caps are ground truth of the target" model). Extend the absent lists as new
// capability-specific test groups appear.
//
// tier2-mobile-coverage: two tiers of tier-2 target, DIFFERENT capability sets:
//   • wasm — NO native facilities at all (no threads, no dlopen native-ext, no
//     real fs, no OS entropy, no system clock). Excludes the union below.
//   • mobile (ios sim / android emu) — a REAL native runtime WITH pthreads,
//     statically-linked native-ext (compression), OS entropy, a system clock,
//     and a writable app-sandbox filesystem. So mobile KEEPS threading /
//     compression / crypto.secure_random / time.datetime / fs / streams that
//     wasm must drop. Mobile only lacks the APP-SANDBOX gaps: server/loopback
//     sockets + DNS (no CI network), process fork/exec, a TTY/console, mutable
//     env, and desktop-specific OS-identity strings. Those are the SHARED gaps
//     (both wasm and mobile fail them). Mobile's fs/stream KEEP-IN set is a
//     capability HYPOTHESIS validated by the tier-2 CI shard run (see
//     embedded-app-run.md §5.8) — a case that turns out to need something the
//     sandbox denies moves up into the mobile-excluded list on the next cycle.
bool _targetExcludes(string rid, string caseName) {
    bool isWasm    = rid.Contains("wasm");
    bool isAndroid = rid.Contains("android");
    bool isMobile  = rid.Contains("ios") || isAndroid;
    if (!isWasm && !isMobile) { return false; }   // desktop runs everything

    // ── SHARED gaps: neither wasm NOR the mobile app sandbox can run these ──
    if (caseName.StartsWith("z42.net/"))         { return true; }   // sockets/servers/DNS (no CI network; sandbox blocks bind/listen)
    if (caseName.StartsWith("z42.io/process"))   { return true; }   // process spawn — no fork/exec in the app sandbox (basic/spawn/stdio/stdin/timeout/which/failure/env_cwd)
    if (caseName.StartsWith("z42.io/console"))   { return true; }   // console/tty — no TTY in the test harness (console/console_tty)
    if (caseName.StartsWith("z42.io/env"))       { return true; }   // env vars — not mutable/inherited on wasm or the mobile harness (env_cwd/env_set/environment_extra)
    if (caseName == "z42.io/ansi_color")         { return true; }   // env-driven ANSI
    if (caseName == "z42.io/operating_system")   { return true; }   // OS name / current_dir — differs from desktop expectations
    if (caseName == "z42.io/platform")           { return true; }   // OS/family identity strings — wasm reports "wasm", mobile "ios"/"android", not a desktop OS
    if (caseName == "z42.cli/cli_env_fallback_and_mutex") { return true; }  // env/process

    // ── WASM-ONLY gaps: mobile's native runtime HAS all of these → keep them
    //    IN for ios/android (they were only excluded because wasm can't) ──
    if (isWasm) {
        if (caseName.StartsWith("z42.threading/")) { return true; }   // no threads
        // z42.compression is a [Native(lib="z42_compression")] facade (brotli/gzip/
        // zstd/zip/lz4/tar). wasm has no dlopen → the ext registry is empty → the
        // metadata resolver panics ("unknown builtin `__brotli_compress` …") the
        // moment such a case loads. Mobile links the native-ext statically → it runs.
        if (caseName.StartsWith("z42.compression/")) { return true; }
        if (caseName.Contains("stream"))           { return true; }   // native FileStream (io/json/toml/yaml *stream*); mobile has a real fs
        if (caseName.StartsWith("z42.io/file"))      { return true; }  // native fs (file_temp/bytes/extras/atomic_write/chmod_link_size/last_write_time/…)
        if (caseName.StartsWith("z42.io/directory")) { return true; }  // native fs (directory/directory_copy/directory_temp)
        if (caseName.StartsWith("z42.io/path_glob")) { return true; }  // fs glob (path_glob/path_glob_recursive)
        if (caseName == "z42.io/gc_heap_snapshot")   { return true; }  // writes a heap-snapshot file
        if (caseName.StartsWith("z42.crypto/secure_random")) { return true; }  // OS entropy (basic/distribution)
        if (caseName == "z42.core/datetime")         { return true; }  // DateTime.UtcNow → system clock (time 迁入 core 后 case 名变；parse/calendar/offset cases still run)
    }

    // ── ANDROID-ONLY gap: iOS's simulator sandbox runs this; the Android
    //    emulator app's does NOT. Surfaced by the tier2-mobile-coverage discovery
    //    dispatch (run 32422098038): iOS all-green, Android red on it.
    //    (iOS keeps it — do NOT move it into the shared/mobile list.) ──
    if (isAndroid) {
        // GENUINE gap: the Android app sandbox denies POSIX hard links
        // (File.Link → "Permission denied"; symlinks still work). Not fixable —
        // permanent Android exclusion.
        if (caseName == "z42.io/file_chmod_link_size") { return true; }
        // MEMORY gap (NOT /tmp): gc_heap_snapshot calls GC.WriteHeapSnapshot, which
        // serialises the WHOLE live heap to a V8 JSON string (+ ReadAllText reloads
        // it). In the embedded runner [Test] units share ONE VM, so by the time this
        // case runs (idx ~337/464, ~112 units into its shard) the accumulated heap
        // is large → the snapshot balloons to multi-GB. The Android emulator's tight
        // budget → the low-memory-killer SIGKILLs the app (dispatch 32435384808:
        // android shard 2 hit ~2.4GB RSS + 2.2GB swap → LMK; shards 1/3 without this
        // case are green). iOS-sim (macOS host, ample RAM) runs it fine and desktop
        // isn't shared-VM, so exclude on Android ONLY. Already excluded on wasm
        // (line above). The /tmp→CreateTempDir portability fix still applies to the
        // test itself. (embedded-app-run.md §5.8.)
        if (caseName == "z42.io/gc_heap_snapshot") { return true; }
        // NOTE (/tmp-portability follow-up landed): directory / directory_copy /
        // file_extras / file_last_write_time used to be excluded here too — they
        // hardcoded `/tmp/...` write paths the Android emulator has no writable /tmp
        // for. They now write under File.CreateTempDir (portable, Android-writable —
        // z42.io/file_temp proves it), so those 4 Android excludes were REMOVED and
        // they run in the full-coverage shards. (embedded-app-run.md §5.8.)
    }
    return false;
}

// One enumerated corpus case (structural descriptor, rid-independent). Shared SoT
// for both the embedded bundle builder (_buildTestBundle) and the `test list`
// catalog (_testList) — one enumeration, two consumers, no drift.
//   kind: "golden"   → direct-run (src/tests + lib goldens) via _goldenEntry
//         "unit"     → stdlib [Test] file  (tests/<f>.z42)   via _emitUnitZbc
//         "dir-unit" → stdlib [Test] dir   (tests/<nm>/)     via _emitDirUnit
class _CorpusCase {
    public string name;        // caseName, e.g. "classes/basic_class" | "z42.io/env_cwd"
    public string bucket;      // grouping key (src/tests <cat> or stdlib <lib>)
    public string kind;        // golden | unit | dir-unit
    public string src;         // source .z42 path (golden/unit); "" for dir-unit
    public string exp;         // expected-output text (goldens only)
    public string lib;         // owning lib (unit/dir-unit)
    public string leaf;        // leaf name for safe-name / emit (unit base, dir-unit subdir)
    public string dir;         // case dir (golden dir-mode / dir-unit / lib-golden)
    public bool interpOnly;    // golden has an `interp_only` sidecar → no jit run
    public _CorpusCase() {
        this.name = ""; this.bucket = ""; this.kind = "";
        this.src = ""; this.exp = ""; this.lib = "";
        this.leaf = ""; this.dir = ""; this.interpOnly = false;
    }
}

// Growable _CorpusCase[] append (mirrors _appendCase).
_CorpusCase[] _appendCorpus(_CorpusCase[] arr, int n, _CorpusCase c) {
    if (n < arr.Length) { arr[n] = c; return arr; }
    _CorpusCase[] bigger = new _CorpusCase[arr.Length * 2 + 8];
    int i = 0; while (i < n) { bigger[i] = arr[i]; i = i + 1; }
    bigger[n] = c;
    return bigger;
}

// Enumerate the full corpus (goldens + stdlib [Test] units/dir-units/lib-goldens)
// as descriptors — filter by name substring, but rid-INDEPENDENT (no capability
// exclusion, no cap): those are bundle-time policy applied by _buildTestBundle.
// Emission order is stable (sorted cats, then per-lib units→dir-units→lib-goldens),
// so a bucket's cases stay CONTIGUOUS — which _sampleCorpus relies on.
_CorpusCase[] _enumerateCorpus(string root, string filter) {
    _CorpusCase[] cs = new _CorpusCase[64];
    int n = 0;

    // 1. golden e2e — dir-mode (<cat>/<name>/source.z42 + expected_output.txt) AND
    // flat-mode (<cat>/<name>.z42 + <name>.expected_output.txt).
    string testsRoot = Path.Join(root, "src/tests");
    foreach (var cat in _sortedStrings(Directory.Enumerate(testsRoot))) {
        string catDir = Path.Join(testsRoot, cat);
        if (!Directory.Exists(catDir)) { continue; }
        if (_isNonRunnableCat(cat)) { continue; }
        foreach (var name in _sortedStrings(Directory.Enumerate(catDir))) {
            string full = Path.Join(catDir, name);
            _CorpusCase c = new _CorpusCase();
            if (Directory.Exists(full)) {
                if (!File.Exists(Path.Join(full, "source.z42"))) { continue; }
                if (_isExcludedDirName(cat, name)) { continue; }
                c.name = cat + "/" + name;
                c.src = Path.Join(full, "source.z42");
                c.exp = _readExpected(Path.Join(full, "expected_output.txt"));
                c.dir = full;
                c.interpOnly = File.Exists(Path.Join(full, "interp_only"));
            } else if (name.EndsWith(".z42")) {
                string nm = name.Substring(0, name.Length - 4);
                c.name = cat + "/" + nm;
                c.src = full;
                c.exp = _readExpected(Path.Join(catDir, nm + ".expected_output.txt"));
                c.dir = catDir;
            } else {
                continue;   // sidecar (.expected_output.txt / .interp_only) or non-source
            }
            if (filter.Length > 0 && !c.name.Contains(filter)) { continue; }
            c.bucket = cat; c.kind = "golden";
            cs = _appendCorpus(cs, n, c); n = n + 1;
        }
    }

    // 2. stdlib per-lib: [Test] file units (2), [Test] dir units (2b), lib goldens (2c).
    string libsRoot = Path.Join(root, "src/libraries");
    foreach (var lib in _sortedStrings(Directory.Enumerate(libsRoot))) {
        string tdir = Path.Join(libsRoot, lib, "tests");
        if (!Directory.Exists(tdir)) { continue; }
        // 2. file units (tests/*.z42)
        foreach (var f in _sortedStrings(Directory.Enumerate(tdir))) {
            if (!f.EndsWith(".z42")) { continue; }
            string caseName = lib + "/" + f.Substring(0, f.Length - 4);
            if (filter.Length > 0 && !caseName.Contains(filter)) { continue; }
            _CorpusCase c = new _CorpusCase();
            c.name = caseName; c.bucket = lib; c.kind = "unit";
            c.src = Path.Join(tdir, f); c.lib = lib;
            c.leaf = f.Substring(0, f.Length - 4);
            cs = _appendCorpus(cs, n, c); n = n + 1;
        }
        // 2b. dir-mode [Test] units (tests/<nm>/ with [Test] methods)
        foreach (var nm in _sortedStrings(Directory.Enumerate(tdir))) {
            string dpath = Path.Join(tdir, nm);
            if (!Directory.Exists(dpath)) { continue; }
            if (!_dirHasTestMethods(dpath)) { continue; }
            string caseName = lib + "/" + nm;
            if (filter.Length > 0 && !caseName.Contains(filter)) { continue; }
            _CorpusCase c = new _CorpusCase();
            c.name = caseName; c.bucket = lib; c.kind = "dir-unit";
            c.lib = lib; c.leaf = nm; c.dir = dpath;
            cs = _appendCorpus(cs, n, c); n = n + 1;
        }
        // 2c. lib-mode goldens (tests/<nm>/source.z42 WITHOUT [Test])
        foreach (var nm in _sortedStrings(Directory.Enumerate(tdir))) {
            string dpath = Path.Join(tdir, nm);
            if (!Directory.Exists(dpath)) { continue; }
            if (_dirHasTestMethods(dpath)) { continue; }
            string gsrc = Path.Join(dpath, "source.z42");
            if (!File.Exists(gsrc)) { continue; }
            string caseName = lib + "/" + nm;
            if (filter.Length > 0 && !caseName.Contains(filter)) { continue; }
            _CorpusCase c = new _CorpusCase();
            c.name = caseName; c.bucket = lib; c.kind = "golden";
            c.src = gsrc; c.exp = _readExpected(Path.Join(dpath, "expected_output.txt"));
            c.lib = lib; c.leaf = nm; c.dir = dpath;
            c.interpOnly = File.Exists(Path.Join(dpath, "interp_only"));
            cs = _appendCorpus(cs, n, c); n = n + 1;
        }
    }

    _CorpusCase[] outc = new _CorpusCase[n];
    int i = 0; while (i < n) { outc[i] = cs[i]; i = i + 1; }
    return outc;
}

// Per-category sampling for the embed smoke cap: pick up to `cap` cases spread
// EVENLY across buckets (round-robin) instead of the old "first `cap` in sort
// order" (which starved alphabetically-late categories). cap<=0 or total<=cap →
// return all (desktop = full coverage). Deterministic: buckets are the contiguous
// runs from _enumerateCorpus (first-appearance/sorted order), within-bucket order
// preserved, and the result is emitted in original enumeration order.
_CorpusCase[] _sampleCorpus(_CorpusCase[] cases, int cap) {
    int total = cases.Length;
    if (cap <= 0 || total <= cap) { return cases; }
    // Bucket boundaries: contiguous runs of equal .bucket.
    int[] starts = new int[total];
    int[] lens   = new int[total];
    int nb = 0;
    int i = 0;
    while (i < total) {
        int j = i;
        while (j < total && cases[j].bucket == cases[i].bucket) { j = j + 1; }
        starts[nb] = i; lens[nb] = j - i; nb = nb + 1;
        i = j;
    }
    // Round-robin one case per bucket per round until `cap` reached (or all drained).
    bool[] selected = new bool[total];
    int[] cursor = new int[nb];
    int picked = 0;
    bool progress = true;
    while (picked < cap && progress) {
        progress = false;
        int b = 0;
        while (b < nb && picked < cap) {
            if (cursor[b] < lens[b]) {
                selected[starts[b] + cursor[b]] = true;
                cursor[b] = cursor[b] + 1;
                picked = picked + 1;
                progress = true;
            }
            b = b + 1;
        }
    }
    // Emit in original enumeration order (stable bundle / manifest ordering).
    _CorpusCase[] outc = new _CorpusCase[picked];
    int k = 0; i = 0;
    while (i < total) { if (selected[i]) { outc[k] = cases[i]; k = k + 1; } i = i + 1; }
    return outc;
}

// Full-coverage sharding for parallel tier-2 CI (tier2-shard-full-coverage).
// Partition the (already capability-filtered) corpus into n DISJOINT slices by
// stable enumeration index: shard k gets every case where index % n == k-1. No
// cap — the union of shards 1..n is the FULL runnable corpus (100% coverage),
// with zero overlap. index%n interleaves across the contiguous bucket runs from
// _enumerateCorpus, so each shard stays category-balanced. Deterministic: keyed
// on enumeration order only, so re-runs and shard boundaries are reproducible.
_CorpusCase[] _shardCorpus(_CorpusCase[] cases, int k, int n) {
    int total = cases.Length;
    int cnt = 0;
    int i = 0;
    while (i < total) { if ((i % n) == (k - 1)) { cnt = cnt + 1; } i = i + 1; }
    _CorpusCase[] outc = new _CorpusCase[cnt];
    int o = 0; i = 0;
    while (i < total) { if ((i % n) == (k - 1)) { outc[o] = cases[i]; o = o + 1; } i = i + 1; }
    return outc;
}

// Build the test bundle. Returns the manifest.json path ("" if no cases matched).
// Pipeline: enumerate full corpus → exclude cases needing caps the target lacks
// (_targetExcludes) → SELECT (shard slice OR per-category smoke sample) → compile
// the selection. Desktop (cap=0, no shard) compiles the full included set unchanged.
//
// Two select modes on tier-2 (wasm/ios/android):
//   • shardN>0  → full-coverage slice k/n (_shardCorpus, NO cap). Nightly CI
//     fans out n parallel shard jobs; their union = 100% of the runnable corpus.
//     (tier2-shard-full-coverage — replaces the smoke-only tier-2 coverage.)
//   • shardN==0 → per-category smoke sample to embedCap=60 (_sampleCorpus). This
//     is the fast local/manual default: fix-wasm-embed-timeout / android-emu cap
//     kept the whole corpus (~433 cases) from blowing the emulator/browser job
//     wall (>20min; android hit 60min). tidy-test-system spread the cap per
//     category (round-robin) so late-sorted categories still get representation.
string _buildTestBundle(string root, string filter, string rid, int shardK, int shardN) {
    string bundleDir = Path.Join(root, "artifacts/build/embedded-test/bundle");
    Directory.Create(bundleDir);
    _cleanGlob(bundleDir, "*.zbc");
    int embedCap = (rid.Contains("wasm") || rid.Contains("ios") || rid.Contains("android")) ? 60 : 0;

    // enumerate (structural) → capability-exclude → select (shard slice | smoke sample).
    _CorpusCase[] all = _enumerateCorpus(root, filter);
    _CorpusCase[] incl = new _CorpusCase[all.Length];
    int ni = 0;
    int excluded = 0;
    int a = 0;
    while (a < all.Length) {
        if (_targetExcludes(rid, all[a].name)) { excluded = excluded + 1; }
        else { incl[ni] = all[a]; ni = ni + 1; }
        a = a + 1;
    }
    _CorpusCase[] included = new _CorpusCase[ni];
    int c0 = 0; while (c0 < ni) { included[c0] = incl[c0]; c0 = c0 + 1; }
    // --shard k/n wins over the smoke cap: run the full 1/n slice, no cap.
    _CorpusCase[] sel;
    if (shardN > 0) { sel = _shardCorpus(included, shardK, shardN); }
    else            { sel = _sampleCorpus(included, embedCap); }
    int capped = (shardN > 0) ? 0 : (ni - sel.Length);

    // compile the selection → manifest items.
    string items = "";
    int count = 0;
    int si = 0;
    while (si < sel.Length) {
        _CorpusCase c = sel[si];
        string entry = "";
        if (c.kind == "unit") {
            string safe = _bundleSafeName(c.name);
            string zbc = _emitUnitZbc(root, c.src, safe, bundleDir);
            if (zbc.Length == 0) { ConsoleError.WriteLine("  ✗ unit " + c.name); si = si + 1; continue; }
            entry = "    {\"name\": \"" + c.name + "\", \"zbc\": \"" + safe + ".zbc\"}";
        } else if (c.kind == "dir-unit") {
            string safe = _bundleSafeName(c.name);
            string zbc = _emitDirUnit(root, c.lib, c.leaf, c.dir, safe, bundleDir);
            if (zbc.Length == 0) { ConsoleError.WriteLine("  ✗ dir-unit " + c.name); si = si + 1; continue; }
            entry = "    {\"name\": \"" + c.name + "\", \"zbc\": \"" + safe + ".zpkg\"}";
        } else {   // golden
            entry = _goldenEntry(root, c.name, c.src, c.exp, bundleDir);
            if (entry.Length == 0) { ConsoleError.WriteLine("  ✗ golden " + c.name); si = si + 1; continue; }
        }
        if (count > 0) { items = items + ",\n"; }
        items = items + entry;
        count = count + 1;
        si = si + 1;
    }

    if (excluded > 0) {
        Console.WriteLine("  (excluded " + excluded.ToString() + " case(s) requiring caps '"
            + rid + "' lacks — socket/threads/native-fs)");
    }
    if (shardN > 0) {
        Console.WriteLine("  (embed shard " + shardK.ToString() + "/" + shardN.ToString()
            + ": full-coverage slice — selected " + sel.Length.ToString() + " of "
            + ni.ToString() + " runnable case(s); union of all " + shardN.ToString()
            + " shards = 100%)");
    }
    if (capped > 0) {
        Console.WriteLine("  (embed smoke: sampled " + sel.Length.ToString() + " of "
            + ni.ToString() + " per-category (cap " + embedCap.ToString() + "); skipped "
            + capped.ToString() + " — full coverage runs on desktop or via --shard)");
    }
    if (count == 0) { ConsoleError.WriteLine("error: no cases matched filter"); return ""; }
    string mpath = Path.Join(bundleDir, "manifest.json");
    File.WriteAllText(mpath, "{\n  \"cases\": [\n" + items + "\n  ]\n}\n");
    Console.WriteLine("  bundle: " + count.ToString() + " cases → " + mpath);
    return mpath;
}

// ── wasm embedded test-host (add-wasm-testhost G6) ───────────────────────────
//
// Assemble a browser-servable dir that runs the SAME test bundle through the
// wasm-embedded VM (z42_wasm.runTestApp → z42::app::run → agent). Reuses the
// desktop bundle builder + test-agent; adds the wasm crate build + asset
// assembly + the static harness. RUN is browser/Playwright-gated (CI); this
// command builds + assembles the deployable dir (compile-once, per platform).
string _buildWasmTesthost(string root, string filter, int shardK, int shardN) {
    // 1. bundle (goldens 归一 + stdlib units) — identical to the desktop bundle,
    // minus tests needing caps wasm lacks (socket/threads/native-fs; see _targetExcludes).
    Console.WriteLine("→ build test-bundle" + (filter.Length > 0 ? (" (filter: " + filter + ")") : " (all)"));
    string manifest = _buildTestBundle(root, filter, "browser-wasm", shardK, shardN);
    if (manifest.Length == 0) { return ""; }

    // 2. native build + deploy 下沉 z42b (z42b-device-run PR-1): z42b runs
    // wasm-pack → pkg-web, stages {app,libs,bundle}+files.json, and copies the wasm
    // pkg + static harness on top (browser-fetched, not via VFS). xtask keeps corpus
    // build (1); the test-agent is resolved by z42b from the installed `test`
    // workload (dogfood, PR-4) — not handed over by xtask.
    string outDir = Path.Join(root, "artifacts/build/wasm-test");
    int ac = _z42bBuildDeployable(root, manifest, "browser-wasm", outDir);
    if (ac != 0) { ConsoleError.WriteLine("error: z42b build/stage wasm deployable failed"); return ""; }

    Console.WriteLine("  wasm test-host → " + outDir);
    Console.WriteLine("  serve that dir (e.g. `python3 -m http.server`) and open index.html;");
    Console.WriteLine("  Playwright/CI reads window.__report (the JSON report) once window.__done.");
    return outDir;
}

// `test embedded --rid browser-wasm --run`: run the already-built deployable in the
// browser via z42b's wasm driver (spawns the playwright embedded config). The build
// step (`--rid browser-wasm` without --run) must have produced the deployable +
// bundle/manifest.json. node is provisioned on PATH (CI setup-node / local); z42b
// spawns npx playwright. z42b-device-run PR-1.
int _runWasmTesthost(string root) {
    string outDir   = Path.Join(root, "artifacts/build/wasm-test");
    string manifest = Path.Join(outDir, "bundle/manifest.json");
    if (!File.Exists(manifest)) {
        ConsoleError.WriteLine("error: wasm deployable not built — run `test embedded --rid browser-wasm` first (missing " + manifest + ")");
        return 1;
    }
    // --run only spawns playwright (deploy already done); out unused there.
    return _z42bDevice(root, manifest, "browser-wasm", outDir,
        new string[] { "--run", "--build-root", root });
}

// Invoke `z42b test <manifest> --rid <device> --out <dir>` + extra flags, with flat
// stdlib in Z42_LIBS. z42b is the single-target device executor (z42b-device-run);
// xtask (fleet orchestrator) provisions the bundle + stdlib + native tooling and
// hands them over. The test-agent is NOT handed over — z42b resolves it from the
// installed `test` workload (dogfood, PR-4), so Z42_PORTABLE_VM (inherited from the
// caller's env; CI sets it) must point at the SDK home. `extra` selects the sub-step:
//   ["--stage-only"]                → assemble deployable only (②b; ios/android)
//   ["--build", "--build-root", R]  → native build + deploy (wasm build 下沉)
int _z42bDevice(string root, string manifestPath, string rid, string destDir, string[] extra) {
    string vm = _builtVm(root, "release");
    if (!File.Exists(vm)) { vm = _builtVm(root, "debug"); }
    string builderZpkg = _toolchainZpkg(root, _z42bToml());
    if (builderZpkg.Length == 0 || !File.Exists(builderZpkg)) {
        ConsoleError.WriteLine("error: z42b (z42.builder.zpkg) not built; run build toolchain");
        return 1;
    }
    string flat = _assembleAllLibs(root, "release");
    Process p = new Process(vm).Arg("--mode").Arg("interp").Arg(builderZpkg)
        .Arg("--").Arg("test").Arg(manifestPath).Arg("--rid").Arg(rid)
        .Arg("--out").Arg(destDir);
    for (int i = 0; i < extra.Length; i = i + 1) { p = p.Arg(extra[i]); }
    ProcessResult res = p.Env("Z42_LIBS", flat).Run();
    if (res.Stdout.Length > 0) { Console.Write(res.Stdout); }
    if (res.Stderr.Length > 0) { ConsoleError.WriteLine(res.Stderr); }
    return res.ExitCode;
}

// Native build + deploy 下沉 z42b: z42b runs the platform build (wasm-pack /
// xcframework) then stages the full deployable (wasm: + pkg/harness; ios: into the
// XCTest Resources). --build-root lets z42b's driver locate the native platform
// crate (src/toolchain/workload/<plat>/…).
int _z42bBuildDeployable(string root, string manifestPath, string rid, string destDir) {
    return _z42bDevice(root, manifestPath, rid, destDir,
        new string[] { "--build", "--build-root", root });
}

// ── mobile embedded test-host (add-wasm-testhost G6: ios / android) ───────────
//
// iOS/Android have real filesystems (unlike wasm), so they read the bundled
// corpus straight from paths and call the SAME `z42_host_run_app` C symbol
// (→ z42::app::run) as desktop — no VFS. The agent writes its JSON report to a
// file (out-path arg) which the native test reads back. Only the packaging +
// thin native shell differ per platform.

// The on-device {app,libs,bundle} corpus is staged by z42b (_z42bBuildDeployable,
// Slice 2/3) — the layout iOS Resources / Android assets consume. iOS/Android read
// it straight from paths (real filesystem, no VFS) and call the SAME
// z42_host_run_app C symbol as desktop; only the native shell differs per platform.

// iOS: build the xcframework + assemble the embedded corpus into the XCTest bundle
// Resources — both 下沉 z42b (z42b-device-run PR-2, `--build`: cargo × slices +
// xcodebuild -create-xcframework + stage). xtask keeps corpus build + agent; the
// platform build/deploy is z42b's ios driver. The embedded runner is
// Z42EmbeddedTests.testEmbeddedBundle (in the Z42VM scheme) — RUN via
// `test embedded --rid <ios> --run` (→ z42b xcodebuild test, one sim boot).
string _buildIosTesthost(string root, string filter, string rid, int shardK, int shardN) {
    if (Process.Which("xcodebuild") == null) {
        ConsoleError.WriteLine("error: xcodebuild not found (Xcode required for iOS)"); return "";
    }
    Console.WriteLine("→ build test-bundle" + (filter.Length > 0 ? (" (filter: " + filter + ")") : " (all)"));
    string manifest = _buildTestBundle(root, filter, rid, shardK, shardN);
    if (manifest.Length == 0) { return ""; }

    string here = Path.Join(root, "src/toolchain/workload/ios/platform");
    string resDir = Path.Join(here, "Tests/Z42VMTests/Resources/embedded");
    int ac = _z42bBuildDeployable(root, manifest, rid, resDir);
    if (ac != 0) { ConsoleError.WriteLine("error: z42b build ios deployable failed"); return ""; }

    Console.WriteLine("  iOS embedded test-host ready.");
    Console.WriteLine("  RUN (sim/CI): test embedded --rid " + rid + " --run  (→ z42b xcodebuild test)");
    Console.WriteLine("    → Z42EmbeddedTests.testEmbeddedBundle (embedded corpus) + R1–R7.");
    return here;
}

// `test embedded --rid iossim-arm64 --run`: run the already-built iOS test-host on a
// simulator via z42b's ios driver (ONE `xcodebuild test -scheme Z42VM` runs R1–R7 +
// embedded). The build step (`--rid iossim-arm64` without --run) must have produced
// the xcframework + Resources/embedded corpus; R1–R7 fixtures come from
// `test platform ios assets`. z42b resolves the sim UDID + writes junit.xml.
// z42b-device-run PR-2.
int _runIosTesthost(string root, string rid) {
    string here = Path.Join(root, "src/toolchain/workload/ios/platform");
    string manifest = Path.Join(here, "Tests/Z42VMTests/Resources/embedded/bundle/manifest.json");
    if (!File.Exists(manifest)) {
        ConsoleError.WriteLine("error: ios test-host not built — run `test embedded --rid " + rid + "` first (missing " + manifest + ")");
        return 1;
    }
    // --run only spawns xcodebuild (build/deploy already done); out unused.
    return _z42bDevice(root, manifest, rid, "",
        new string[] { "--run", "--build-root", root });
}

// Android: assemble the embedded corpus into the androidTest assets + build
// libz42_platform_android.so via cargo-ndk — both 下沉 z42b (z42b-device-run PR-3,
// `--build`: cargo ndk -t <abi> build --release + stage). xtask keeps corpus build
// + agent; the platform .so build/deploy is z42b's android driver (which resolves
// the NDK + ABI from the rid). `rid` selects the ABI — `android-x64` builds only
// x86_64 (e.g. for an x64 emulator), `android-arm64` only arm64-v8a. The embedded
// runner is Z42EmbeddedInstrumentedTest (in the z42vm test apk) — RUN via
// `test embedded --rid <android> --run` (→ z42b gradlew connectedAndroidTest, one
// emulator boot with R1–R7). Real filesystem → no VFS, same z42_host_run_app core.
string _buildAndroidTesthost(string root, string filter, string rid, int shardK, int shardN) {
    if (Process.Which("cargo-ndk") == null) {
        ConsoleError.WriteLine("error: cargo-ndk not found (cargo install cargo-ndk)"); return "";
    }
    Console.WriteLine("→ build test-bundle" + (filter.Length > 0 ? (" (filter: " + filter + ")") : " (all)"));
    string manifest = _buildTestBundle(root, filter, rid, shardK, shardN);
    if (manifest.Length == 0) { return ""; }

    string here = Path.Join(root, "src/toolchain/workload/android/platform");
    string assetsDir = Path.Join(here, "z42vm/src/androidTest/assets/embedded");
    int ac = _z42bBuildDeployable(root, manifest, rid, assetsDir);
    if (ac != 0) { ConsoleError.WriteLine("error: z42b build android deployable failed"); return ""; }

    Console.WriteLine("  Android embedded test-host ready (.so + androidTest assets).");
    Console.WriteLine("  RUN (emulator/CI): test embedded --rid " + rid + " --run  (→ z42b gradlew connectedAndroidTest)");
    Console.WriteLine("    → Z42EmbeddedInstrumentedTest.embeddedBundle (embedded corpus) + R1–R7.");
    return here;
}

// `test embedded --rid <android> --run`: run the already-built Android test-host on
// a connected emulator via z42b's android driver (ONE `gradlew
// :z42vm:connectedAndroidTest` runs R1–R7 + embedded). The build step (`--rid
// <android>` without --run) must have produced the .so (jniLibs) + androidTest
// assets/embedded corpus; R1–R7 fixtures come from `test platform android assets`.
// The emulator is booted by the CI action (reactivecircus) or local dev (design D2
// asymmetry). Gradle writes its own junit — the CI report consumer reads that path.
// z42b-device-run PR-3.
int _runAndroidTesthost(string root, string rid) {
    string here = Path.Join(root, "src/toolchain/workload/android/platform");
    string manifest = Path.Join(here, "z42vm/src/androidTest/assets/embedded/bundle/manifest.json");
    if (!File.Exists(manifest)) {
        ConsoleError.WriteLine("error: android test-host not built — run `test embedded --rid " + rid + "` first (missing " + manifest + ")");
        return 1;
    }
    // --run only spawns gradlew (build/deploy already done); out unused.
    return _z42bDevice(root, manifest, rid, "",
        new string[] { "--run", "--build-root", root });
}

// `xtask test embedded [target.zbc | golden-case-dir] [--platform desktop|wasm]
//                      [--case <name>] [--filter <pat>] [--format ...]`
int _testEmbedded(ParseResult r) {
    string root = _root();
    string target = r.GetPositional(0);
    string caseOpt = r.GetOption("case");
    string filterOpt = r.GetOption("filter");
    string format = r.GetOption("format");
    if (format.Length == 0) { format = "json"; }
    string rid = r.GetOption("rid");
    // --shard k/n: parallel-CI full-coverage slice. Reuses the golden/stdlib
    // `_parseShard` ([0,0] = no sharding). When set, the bundle builder runs the
    // FULL runnable corpus slice k/n with NO smoke cap (each shard = a disjoint
    // 1/n of all cases; union of n shards = full coverage). Without --shard the
    // tier-2 cap (60, per-category sample) still applies = fast local/manual smoke.
    int[] sh = _parseShard(r.GetOption("shard"));
    int shardK = sh[0];
    int shardN = sh[1];

    int dep = _ensureToolchainDeps(root); if (dep != 0) { return dep; }

    // Target RID: the arch suffix selects the actual slice / ABI to build (via
    // the shared _ridCategory from the packaging path), so e.g. `android-x64`
    // builds only the x86_64 .so — not both. An empty rid (or any desktop RID)
    // runs in-process on the host. RUN of the mobile/wasm hosts is
    // Playwright / xcodebuild-sim / emulator-gated (CI).
    string tfilter = (caseOpt.Length > 0) ? caseOpt : filterOpt;
    string cat = (rid.Length == 0) ? "desktop" : _ridCategory(rid);
    if (cat == "wasm") {
        // --run: the deployable was already built (a prior `--rid browser-wasm` step);
        // delegate the browser RUN to z42b's wasm driver (playwright embedded). z42b-
        // device-run PR-1. Otherwise BUILD the deployable (build 下沉 z42b via
        // _buildWasmTesthost → z42b --build).
        if (r.GetFlag("run")) {
            return _runWasmTesthost(root);
        }
        string wout = _buildWasmTesthost(root, tfilter, shardK, shardN);
        return (wout.Length > 0) ? 0 : 1;
    }
    if (cat == "ios") {
        // --run: the xcframework + Resources/embedded corpus were already built (a
        // prior `--rid <ios>` step); delegate the sim RUN to z42b's ios driver (one
        // xcodebuild test = R1–R7 + embedded). z42b-device-run PR-2. Otherwise BUILD
        // (xcframework + stage 下沉 z42b via _buildIosTesthost → z42b --build).
        if (r.GetFlag("run")) {
            return _runIosTesthost(root, rid);
        }
        string iout = _buildIosTesthost(root, tfilter, rid, shardK, shardN);
        return (iout.Length > 0) ? 0 : 1;
    }
    if (cat == "android") {
        // --run: the .so + androidTest assets/embedded corpus were already built (a
        // prior `--rid <android>` step); delegate the emulator RUN to z42b's android
        // driver (one gradlew connectedAndroidTest = R1–R7 + embedded). z42b-device-
        // run PR-3. Otherwise BUILD (cargo-ndk + stage 下沉 z42b via
        // _buildAndroidTesthost → z42b --build).
        if (r.GetFlag("run")) {
            return _runAndroidTesthost(root, rid);
        }
        string aout = _buildAndroidTesthost(root, tfilter, rid, shardK, shardN);
        return (aout.Length > 0) ? 0 : 1;
    }
    if (cat == "unknown") {
        ConsoleError.WriteLine("error: unknown --rid '" + rid + "' (try browser-wasm | ios-arm64 | iossim-arm64 | android-arm64 | android-x64, or omit for host desktop)");
        return 1;
    }
    // cat == "desktop" → fall through to the in-process desktop path below.

    // Run-target resolution:
    //   --case/--filter, or no positional → build a test-bundle (all/subset) and
    //     run every case in its manifest, aggregating into one report (G2/G3/G4).
    //   golden case dir (has source.z42) → wrap into a [Test] .zbc (G1).
    //   plain path → use as the .zbc directly.
    string runArg = "";
    if (caseOpt.Length > 0 || filterOpt.Length > 0 || target.Length == 0) {
        string filter = (caseOpt.Length > 0) ? caseOpt : filterOpt;
        Console.WriteLine("→ build test-bundle" + (filter.Length > 0 ? (" (filter: " + filter + ")") : " (all)"));
        string manifest = _buildTestBundle(root, filter, target, shardK, shardN);
        if (manifest.Length == 0) { return 1; }
        runArg = manifest;
    } else if (Directory.Exists(target) && File.Exists(Path.Join(target, "source.z42"))) {
        Console.WriteLine("→ golden case → [Test] wrap: " + target);
        runArg = _buildGoldenCase(root, target);
        if (runArg.Length == 0) { ConsoleError.WriteLine("error: wrap/build golden case failed"); return 1; }
    } else {
        runArg = target;
    }

    // Host desktop: DELEGATE to z42b — the single-bundle EXECUTOR
    // (unify-test-pipeline ②b). z42b runs the bundle/module in-process via the
    // shared Std.Test.BundleRunner (goldens isolated + compared, units shared-VM),
    // the SAME core the on-device agent embeds. No desktop testhost / agent spawn
    // on the host: xtask (fleet orchestrator) built the bundle; z42b runs it.
    string vm = _builtVm(root, "release");
    if (!File.Exists(vm)) { vm = _builtVm(root, "debug"); }
    string builderZpkg = _toolchainZpkg(root, _z42bToml());
    if (builderZpkg.Length == 0 || !File.Exists(builderZpkg)) {
        ConsoleError.WriteLine("error: z42b (z42.builder.zpkg) not built; run build toolchain");
        return 1;
    }
    string libs = _libsDir(root);
    Console.WriteLine("→ embedded run (z42b): test " + runArg + " --rid host --format " + format);
    ProcessResult res = new Process(vm).Arg("--mode").Arg("interp").Arg(builderZpkg)
        .Arg("--").Arg("test").Arg(runArg).Arg("--rid").Arg("host").Arg("--format").Arg(format)
        .Env("Z42_LIBS", libs).Run();
    Console.Write(res.Stdout);
    if (res.Stderr.Length > 0) { ConsoleError.WriteLine(res.Stderr); }
    return res.ExitCode;
}
