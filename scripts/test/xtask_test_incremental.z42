// xtask — `test incremental` 暴力对账器（add-file-level-incremental D4/D8 硬验收；
// add-indexed-zpkg-min-patch 扩展为 dist 全文件对账）。
// 对每个语料工程：全量基线 → 逐文件 append 注释 touch → 增量 build → 与同源态
// `--no-incremental` 全量 build 的 **dist 全部文件（主 zpkg + 散装 zbc）逐文件字节**
// 比对 → 还原。任一不等即红并指名文件。语料 toml 无 pack → debug 默认 indexed，
// 故最小 patch 面（散装 zbc 字节稳定）天然纳入对账。
// 逐文件注释轮之后再跑两轮：**改声明**（`_reconcileDeclTouch`，逐文件追加一个新自由函数——
// 注释轮碰不到声明面，名字级失效判据的主战场全靠它）与 **dist 被清空 + cache 全命中**
// （`_reconcileDistWiped`，那条「全命中但必须重新装配」的路径由 fix-incr-allcached-cache-drop
// 才真正接上 cache）。
// 同时输出 D8 计时（增量 vs 全量墙钟，逐工程汇总）——「更快」是被测量的事实。
//
// 语料（实施期修订，见 change tasks 备注）：z42c 7 包经 --workspace 路径不落 cache
// （且已有 gen1==gen2 不动点门禁），单工程语料取：
//   ① demo —— 合成多特性工程（跨文件类引用/继承/接口/try·catch/switch/数组/闭包/静态），
//      覆盖 label 残留（多块函数）与 import token 路径；
//   ② xtask 自身 —— 40+ 文件真实工程（stdlib-only 依赖，单 Z42_LIBS 可解析）。
// 运行于 artifacts/.scratch/incr-reconcile/（拷贝源，不动真实工程）。
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Time;
using Std.Cli;
using Std.Crypto;

int _testIncremental(ParseResult r) {
    Stopwatch sw = _procStart("test incremental");
    string root = _root();
    // 前置：z42c + stdlib（复用既有 warm/cold 链）。
    string vm = _builtVm(root, "release");
    string driver = Path.Join(root, "artifacts/build/compiler/z42c.driver/release/dist/z42c.driver.zpkg");
    if (!File.Exists(vm) || !File.Exists(driver)) {
        int bc = _buildCompiler();
        if (bc != 0) { return bc; }
    }
    string libs = Path.Join(root, "artifacts/build/libraries/dist/release");
    string scratch = Path.Join(root, "artifacts/.scratch/incr-reconcile");
    if (Directory.Exists(scratch)) { Directory.Delete(scratch, true); }

    int rc = _reconcileProject(vm, driver, libs, _incrDemoDir(scratch), "demo");
    if (rc != 0) { return rc; }
    rc = _reconcileProject(vm, driver, libs, _incrXtaskCopy(root, scratch), "xtask");
    if (rc != 0) { return rc; }

    Console.WriteLine("\n✅ incremental reconciler: all dist files byte-identical (demo + xtask)");
    _procEnd("test incremental", sw);
    return 0;
}

// 逐文件 touch 对账一个工程。projDir 内须有 t.z42.toml（dist 落 projDir/dist）。
int _reconcileProject(string vm, string driver, string libs, string projDir, string label) {
    Console.WriteLine("\n── reconcile: " + label + " (" + projDir + ") ──");
    string toml = Path.Join(projDir, "t.z42.toml");
    string[] srcs = _sortedStrings(Path.GlobRecursive(projDir, "*.z42"));
    // 初始 build（填 cache）。
    if (_incrBuild(vm, driver, libs, toml, false) != 0) { ConsoleError.WriteLine("  ✗ initial build failed"); return 1; }
    double incrMs = 0.0;
    double fullMs = 0.0;
    int i = 0;
    while (i < srcs.Length) {
        string f = srcs[i];
        string orig = File.ReadAllText(f);
        File.WriteAllText(f, orig + "\n// incr-reconcile-touch\n");
        Stopwatch ti = Stopwatch.StartNew();
        int c1 = _incrBuild(vm, driver, libs, toml, false);
        incrMs = incrMs + ti.Elapsed().TotalMilliseconds();
        if (c1 != 0) { ConsoleError.WriteLine("  ✗ incr build failed after touching " + f); File.WriteAllText(f, orig); return 1; }
        DistSnapZ snapA = _distSnapshot(projDir);
        Stopwatch tf = Stopwatch.StartNew();
        int c2 = _incrBuild(vm, driver, libs, toml, true);
        fullMs = fullMs + tf.Elapsed().TotalMilliseconds();
        if (c2 != 0) { ConsoleError.WriteLine("  ✗ full build failed after touching " + f); File.WriteAllText(f, orig); return 1; }
        DistSnapZ snapB = _distSnapshot(projDir);
        string mism = _snapshotDiff(snapA, snapB);
        if (mism.Length > 0) {
            ConsoleError.WriteLine("  ✗ MISMATCH: incremental != full after touching " + f + " (" + mism + ")");
            File.WriteAllText(f, orig);
            return 1;
        }
        File.WriteAllText(f, orig);   // 还原（下轮 hash 回原值 → 该文件重编，正确性不受影响）
        i = i + 1;
    }
    Console.WriteLine("  ✓ " + srcs.Length.ToString() + "/" + srcs.Length.ToString()
        + " files byte-identical (whole dist); wall-clock incr=" + incrMs.ToString() + "ms full=" + fullMs.ToString()
        + "ms (D8: per-touch avg " + (incrMs / (double)srcs.Length).ToString() + "ms vs "
        + (fullMs / (double)srcs.Length).ToString() + "ms)");
    int dc = _reconcileDeclTouch(vm, driver, libs, projDir, toml, srcs);
    if (dc != 0) { return dc; }
    return _reconcileDistWiped(vm, driver, libs, projDir, toml);
}

// 「改声明」轮（incr-name-level-invalidation）。上面那轮只 append 注释——**压根碰不到声明面**，
// 于是名字级失效判据的主战场（新增名字 / 名字指纹变化 / 传播）全程没有门看着。
// 本轮逐文件在末尾追加一个**新的自由函数声明**（= 新名字 + 该文件声明面变化），再做同款
// 「增量 dist == 全量 dist 逐字节」对账。名字每轮唯一、且随即还原，故不会跨文件撞名。
int _reconcileDeclTouch(string vm, string driver, string libs, string projDir, string toml, string[] srcs) {
    int i = 0;
    while (i < srcs.Length) {
        string f = srcs[i];
        string orig = File.ReadAllText(f);
        File.WriteAllText(f, orig + "\nint __incrDeclProbe" + i.ToString() + "() { return " + i.ToString() + "; }\n");
        int c1 = _incrBuild(vm, driver, libs, toml, false);
        if (c1 != 0) { ConsoleError.WriteLine("  ✗ decl-touch incr build failed after " + f); File.WriteAllText(f, orig); return 1; }
        DistSnapZ snapA = _distSnapshot(projDir);
        int c2 = _incrBuild(vm, driver, libs, toml, true);
        if (c2 != 0) { ConsoleError.WriteLine("  ✗ decl-touch full build failed after " + f); File.WriteAllText(f, orig); return 1; }
        DistSnapZ snapB = _distSnapshot(projDir);
        string mism = _snapshotDiff(snapA, snapB);
        if (mism.Length > 0) {
            ConsoleError.WriteLine("  ✗ MISMATCH: incremental != full after declaring a new function in " + f + " (" + mism + ")");
            File.WriteAllText(f, orig);
            return 1;
        }
        File.WriteAllText(f, orig);
        i = i + 1;
    }
    Console.WriteLine("  ✓ decl-touch (new free function per file): " + srcs.Length.ToString() + "/" + srcs.Length.ToString()
        + " byte-identical to full");
    return 0;
}

// 「全命中 + 必须重新装配」这一轮（fix-incr-allcached-cache-drop）。
// 场景：源一个没动（cache 全命中），但 dist 主文件被清掉 → 不能走 `preserved` 捷径，必须拿
// **全部 cached IrModule** 重新装配一次 dist。此前 `Prepare` 在全命中时无条件早退、返回全 null 的
// cached[]，这条路径于是悄悄退化成「整包重编」——结果照样对，所以逐文件 touch 那轮抓不到它。
// 本轮盯的正是「用 64 份 cache 装配出来的 dist」必须与全量逐字节相同：修复让这条路径第一次真的
// 走 cached 装配，正确性得有门看着。
int _reconcileDistWiped(string vm, string driver, string libs, string projDir, string toml) {
    string dist = Path.Join(projDir, "dist");
    // 基线：全量重建一次 dist（源未动）。
    if (_incrBuild(vm, driver, libs, toml, true) != 0) { ConsoleError.WriteLine("  ✗ dist-wiped: full baseline build failed"); return 1; }
    DistSnapZ full = _distSnapshot(projDir);
    // 清 dist（cache 保留）→ 增量重建：全命中但无法 preserved，只能从 cache 装配。
    if (Directory.Exists(dist)) { Directory.Delete(dist, true); }
    if (_incrBuild(vm, driver, libs, toml, false) != 0) { ConsoleError.WriteLine("  ✗ dist-wiped: incremental rebuild failed"); return 1; }
    DistSnapZ fromCache = _distSnapshot(projDir);
    string mism = _snapshotDiff(fromCache, full);
    if (mism.Length > 0) {
        ConsoleError.WriteLine("  ✗ MISMATCH: dist wiped + all-cached reassembly != full (" + mism + ")");
        return 1;
    }
    Console.WriteLine("  ✓ dist wiped + all-cached reassembly: " + fromCache.N.ToString() + "/" + fromCache.N.ToString()
        + " files byte-identical to full");
    return 0;
}

int _incrBuild(string vm, string driver, string libs, string toml, bool noIncremental) {
    Process p = new Process(vm).Arg(driver).Arg("--mode").Arg(_z42cMode()).Arg("--").Arg("build").Arg(toml);
    if (noIncremental) { p = p.Arg("--no-incremental"); }
    return p.Env("Z42_LIBS", libs).Stdout(Stdio.Null()).Stderr(Stdio.Null()).Run().ExitCode;
}

// ── dist 快照（rel 排序列表 + blake3-128 指纹并行数组；z42 无交错 byte[][]）────────

public sealed class DistSnapZ {
    public string[] Rels;
    public string[] Hashes;
    public int      N;
    public DistSnapZ(string[] rels, string[] hashes, int n) {
        this.Rels = rels; this.Hashes = hashes; this.N = n;
    }
}

DistSnapZ _distSnapshot(string projDir) {
    string dist = Path.Join(projDir, "dist");
    string[] a = Path.GlobRecursive(dist, "*.zpkg");
    string[] b = Path.GlobRecursive(dist, "*.zbc");
    string[] all = new string[a.Length + b.Length];
    int i = 0;
    while (i < a.Length) { all[i] = a[i]; i = i + 1; }
    int j = 0;
    while (j < b.Length) { all[a.Length + j] = b[j]; j = j + 1; }
    all = _sortedStrings(all);
    string[] hs = new string[all.Length];
    i = 0;
    while (i < all.Length) { hs[i] = _blakeHexOf(all[i]); i = i + 1; }
    return new DistSnapZ(all, hs, all.Length);
}

string _blakeHexOf(string path) {
    byte[] bts = File.ReadAllBytes(path);
    byte[] h = Blake3.HashLen(bts, 16);
    string ds = "0123456789abcdef";
    string r = "";
    int i = 0;
    while (i < h.Length) {
        int v = (int)h[i];
        r = r + ds.Substring((v >> 4) & 0xF, 1) + ds.Substring(v & 0xF, 1);
        i = i + 1;
    }
    return r;
}

// 逐文件（rel 与指纹）比较；返回首个不一致描述（"" = 全等）。
string _snapshotDiff(DistSnapZ a, DistSnapZ b) {
    if (a.N != b.N) { return "file count " + a.N.ToString() + " vs " + b.N.ToString(); }
    int i = 0;
    while (i < a.N) {
        if (a.Rels[i] != b.Rels[i]) { return "file set differs: " + a.Rels[i] + " vs " + b.Rels[i]; }
        if (a.Hashes[i] != b.Hashes[i]) { return "bytes differ: " + a.Rels[i]; }
        i = i + 1;
    }
    return "";
}

// 合成 demo 工程：跨文件引用链 + 多块函数（if/switch/try）+ 接口/继承/静态/数组。
string _incrDemoDir(string scratch) {
    string d = Path.Join(scratch, "demo");
    Directory.Create(d);
    File.WriteAllText(Path.Join(d, "t.z42.toml"),
        "[project]\nname = \"incrpkg\"\nversion = \"0.1.0\"\nkind = \"lib\"\n[sources]\ninclude = [\"**/*.z42\"]\n");
    File.WriteAllText(Path.Join(d, "shape.z42"),
        "namespace D;\n"
        + "public interface IShape { int Area(); }\n"
        + "public class Rect : IShape {\n"
        + "    public int W;\n    public int H;\n"
        + "    public static int Made = 0;\n"
        + "    public Rect(int w, int h) { this.W = w; this.H = h; Rect.Made = Rect.Made + 1; }\n"
        + "    public virtual int Area() { return this.W * this.H; }\n"
        + "}\n");
    File.WriteAllText(Path.Join(d, "square.z42"),
        "namespace D;\n"
        + "public class Square : Rect {\n"
        + "    public Square(int s) : base(s, s) { }\n"
        + "    public override int Area() { return this.W * this.W; }\n"
        + "}\n");
    File.WriteAllText(Path.Join(d, "calc.z42"),
        "namespace D;\n"
        + "public class Calc {\n"
        + "    public int Sum(int n) {\n"
        + "        int[] xs = new int[]{ 1, 2, 3 };\n"
        + "        int acc = 0;\n"
        + "        int i = 0;\n"
        + "        while (i < xs.Length) { acc = acc + xs[i]; i = i + 1; }\n"
        + "        switch (n) {\n"
        + "            case 0: acc = acc + 10;\n"
        + "            default: acc = acc - 1;\n"
        + "        }\n"
        + "        try {\n"
        + "            var sq = new Square(n);\n"
        + "            acc = acc + sq.Area();\n"
        + "        } catch (Exception e) {\n"
        + "            acc = 0 - 1;\n"
        + "        }\n"
        + "        return acc + Rect.Made;\n"
        + "    }\n"
        + "}\n");
    File.WriteAllText(Path.Join(d, "strings.z42"),
        "namespace D;\n"
        + "string Banner(string who) { string p = \"hi, \"; return p + who + \"!\"; }\n"
        + "double Ratio(double a) { double k = 2.5; return a / k; }\n");
    File.WriteAllText(Path.Join(d, "leaf.z42"),
        "namespace D;\nint LeafOnly() { return 42; }\n");
    return d;
}

// 拷贝 xtask 源（真实 40+ 文件工程）到 scratch，替换独立 toml（dist 落本地，不动真品）。
string _incrXtaskCopy(string root, string scratch) {
    string d = Path.Join(scratch, "xtask");
    Directory.Create(d);
    string src = Path.Join(root, "scripts");
    string[] files = _sortedStrings(Path.GlobRecursive(src, "*.z42"));
    int i = 0;
    while (i < files.Length) {
        string rel = files[i].Substring(src.Length + 1);
        string dst = Path.Join(d, rel);
        string parent = Path.GetDirectoryName(dst);
        if (parent.Length > 0) { Directory.Create(parent); }
        File.Copy(files[i], dst);
        i = i + 1;
    }
    File.WriteAllText(Path.Join(d, "t.z42.toml"),
        "[project]\nname = \"incrpkg\"\nversion = \"0.1.0\"\nkind = \"lib\"\n[sources]\ninclude = [\"**/*.z42\"]\n");
    return d;
}
