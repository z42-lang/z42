// xtask — `test incremental` 暴力对账器（add-file-level-incremental D4/D8 硬验收；
// add-indexed-zpkg-min-patch 扩展为 dist 全文件对账）。
// 对每个语料工程：全量基线 → 逐文件 append 注释 touch → 增量 build → 与同源态
// `--no-incremental` 全量 build 的 **dist 全部文件（主 zpkg + 散装 zbc）逐文件字节**
// 比对 → 还原。任一不等即红并指名文件。语料 toml 无 pack → debug 默认 indexed，
// 故最小 patch 面（散装 zbc 字节稳定）天然纳入对账。
// 逐文件注释轮之后再跑两轮：**改声明**（`_reconcileDeclTouch`，逐文件追加一个新自由函数——
// 注释轮碰不到声明面，名字级失效判据的主战场全靠它）与 **dist 被清空 + cache 全命中**
// （`_reconcileDistWiped`，那条「全命中但必须重新装配」的路径由 fix-incr-allcached-cache-drop
// 才真正接上 cache）。
// 同时输出 D8 计时（增量 vs 全量墙钟，逐工程汇总）——「更快」是被测量的事实。
//
// 语料（实施期修订，见 change tasks 备注）：z42c 7 包经 --workspace 路径不落 cache
// （且已有 gen1==gen2 不动点门禁），单工程语料取：
//   ① demo —— 合成多特性工程（跨文件类引用/继承/接口/try·catch/switch/数组/闭包/静态），
//      覆盖 label 残留（多块函数）与 import token 路径；
//   ② xtask 自身 —— 40+ 文件真实工程（stdlib-only 依赖，单 Z42_LIBS 可解析）。
// 运行于 artifacts/.scratch/incr-reconcile/（拷贝源，不动真实工程）。
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Time;
using Std.Cli;
using Std.Crypto;

int _testIncremental(ParseResult r) {
    Stopwatch sw = _procStart("test incremental");
    string root = _root();
    // 前置：z42c + stdlib（复用既有 warm/cold 链）。
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root, "release");
    if (!File.Exists(vm) || !File.Exists(driver)) {
        int bc = _buildCompiler();
        if (bc != 0) { return bc; }
    }
    string libs = _libsDir(root);
    string scratch = Path.Join(root, "artifacts/.scratch/incr-reconcile");
    if (Directory.Exists(scratch)) { Directory.Delete(scratch, true); }

    int rc = _reconcileProject(vm, driver, libs, _incrDemoDir(scratch), "demo");
    if (rc != 0) { return rc; }
    rc = _reconcileProject(vm, driver, libs, _incrDemoPackedDir(scratch), "demo-packed");
    if (rc != 0) { return rc; }
    rc = _reconcileProject(vm, driver, libs, _incrXtaskCopy(root, scratch), "xtask");
    if (rc != 0) { return rc; }
    rc = _knobTakesEffect(vm, driver, libs, _incrDemoDir(Path.Join(scratch, "knob")));
    if (rc != 0) { return rc; }
    // wire-optimize-manifest：`[optimize]` 与上面那道 `[build] incremental` 同族（解析了没人读）。
    // 独立工程目录 —— 本门会反复改 toml 并比对产物字节，不能与别的判据共用一份工程。
    rc = _optimizeKnobTakesEffect(vm, driver, libs, _optKnobDir(Path.Join(scratch, "optknob")));
    if (rc != 0) { return rc; }
    // add-l0-protocol-table 批 1：`[syntax]` 与上面两道同族（解析了没人读）。此前 E0301 零发射点。
    rc = _syntaxKnobTakesEffect(vm, driver, libs, _synKnobDir(Path.Join(scratch, "synknob")));
    if (rc != 0) { return rc; }
    rc = _reconcileStdlibReadback(root, vm, driver, libs, scratch);
    if (rc != 0) { return rc; }

    Console.WriteLine("\n✅ incremental reconciler: all dist files byte-identical (demo + demo-packed + xtask + stdlib readback)"
        + " + [build] incremental / [optimize] / [syntax] knobs take effect");
    _procEnd("test incremental", sw);
    return 0;
}

// ── `[build] incremental` 这个旋钮**真的生效**吗（wire-build-incremental）────────────
//
// 为什么要单独一道：这个键此前**被解析进 BuildConfig.Incremental 就再没人读过**——
// design 文档明文承诺它、examples 的 preset 真的在写它，而写 false 毫无效果。
// 上面那两轮对账**测不到它**：它们验的是「增量结果 == 全量结果」，而一个从不生效的
// 开关恰恰不会让两者不等 —— 门全绿，洞照样在。
//
// 判据取**行为**而非解析：同一份源码连编两次，
//   · 默认（incremental 未写 / = true）→ 第二次必须命中缓存，打印 `preserved`
//   · `incremental = false`            → 第二次必须重新装配，**不得**出现 `preserved`
// 任一条不成立即红。stdout 经 Stdio.ToFile 落盘后读回，确定性判定、不靠计时。
int _knobTakesEffect(string vm, string driver, string libs, string projDir) {
    Console.WriteLine("\n── knob: [build] incremental takes effect (" + projDir + ") ──");
    string toml = Path.Join(projDir, "t.z42.toml");
    string logPath = Path.Join(projDir, "build.out");

    // 第 1 次：填 cache。
    if (_incrBuild(vm, driver, libs, toml, false) != 0) {
        ConsoleError.WriteLine("  ✗ initial build failed"); return 1;
    }
    // 第 2 次（默认 = 增量开）：应命中缓存 → preserved。
    if (_incrBuildTo(vm, driver, libs, toml, logPath) != 0) {
        ConsoleError.WriteLine("  ✗ second build failed"); return 1;
    }
    if (!File.ReadAllText(logPath).Contains("preserved")) {
        ConsoleError.WriteLine("  ✗ incremental ON: 第二次构建没有命中缓存（输出里没有 `preserved`）——");
        ConsoleError.WriteLine("    要么增量整体坏了，要么本判据依赖的输出措辞变了；两者都得查。");
        return 1;
    }
    Console.WriteLine("  ✓ default (incremental on): 第二次构建命中缓存");

    // 关掉旋钮：[build] incremental = false。
    string t = File.ReadAllText(toml);
    File.WriteAllText(toml, t + "\n[build]\nincremental = false\n");
    if (_incrBuildTo(vm, driver, libs, toml, logPath) != 0) {
        ConsoleError.WriteLine("  ✗ build with incremental=false failed"); return 1;
    }
    if (File.ReadAllText(logPath).Contains("preserved")) {
        ConsoleError.WriteLine("  ✗ `[build] incremental = false` 没有生效 —— 第二次构建仍然命中了缓存。");
        ConsoleError.WriteLine("    这个键曾经就是这样：解析进 BuildConfig.Incremental 后无人读取。");
        ConsoleError.WriteLine("    接线点：z42c.driver/src/Main.z42 的 incrOff。");
        return 1;
    }
    Console.WriteLine("  ✓ incremental = false: 缓存未被命中（旋钮生效）");
    return 0;
}

// ── `[optimize]` 这个段**真的生效**吗（wire-optimize-manifest）─────────────────────
//
// 与上面那道 `[build] incremental` 同族、同病因：`[optimize]` 被解析进
// `ProjectManifest.OptimizeNames/Values` 后**再没人读过** —— `BuildCommand` 调的是
// `Opt.Resolve(isRelease, 0, 0, cliAdd, cliRemove)`，两个 0 硬编码。于是写
// `inline = false` 毫无效果、零诊断，而 `ProjectManifest.z42` 的注释还写着
// 「消费方按名映射到 Opt 位…交 Opt.Resolve」。
//
// 上面所有对账**都测不到它**：它们验「增量结果 == 全量结果」，而一个从不生效的开关
// 恰恰不会让两者不等 —— 门全绿，洞照样在。这正是本仓「死旋钮」那一族的标准形状。
//
// 判据取**产物字节**（不靠日志措辞）：同一份源，
//   · `[optimize] inline = true`  → 记下 zpkg 字节
//   · 改成 `inline = false`       → 字节**必须不同**（否则旋钮没生效）
//   · 再改回 `true`               → 字节**必须回到**第一次（否则不可复现）
// 第 2 步同时兼一道**缓存身份**判据：只改 toml、源码不动，若优化集没进包级 cache key，
// probe 会全命中而产物不变 —— 那就是「全量生效、增量被忽略」，比从不生效更难查。
int _optimizeKnobTakesEffect(string vm, string driver, string libs, string projDir) {
    Console.WriteLine("\n── knob: [optimize] takes effect (" + projDir + ") ──");
    string toml = Path.Join(projDir, "t.z42.toml");
    string baseToml = File.ReadAllText(toml);

    File.WriteAllText(toml, baseToml + "\n[optimize]\ninline = true\n");
    if (_incrBuild(vm, driver, libs, toml, true) != 0) {
        ConsoleError.WriteLine("  ✗ build with inline=true failed"); File.WriteAllText(toml, baseToml); return 1;
    }
    // ⚠️ 定位产物必须在**首次构建之后** —— 之前 dist/ 还不存在（第一版就这么写的，直接红在
    // 「找不到 dist zpkg」上，而那不是被测对象的问题）。
    string zpkg = _onlyDistZpkg(projDir);
    if (zpkg == "") {
        ConsoleError.WriteLine("  ✗ 构建后仍找不到 dist 下唯一的 .zpkg（本判据依赖它）");
        File.WriteAllText(toml, baseToml); return 1;
    }
    byte[] onBytes = File.ReadAllBytes(zpkg);

    // 只改 toml、**源码一个字节不动** → 既验旋钮生效，也验优化集进了包级 cache key。
    File.WriteAllText(toml, baseToml + "\n[optimize]\ninline = false\n");
    if (_incrBuild(vm, driver, libs, toml, false) != 0) {
        ConsoleError.WriteLine("  ✗ build with inline=false failed"); File.WriteAllText(toml, baseToml); return 1;
    }
    byte[] offBytes = File.ReadAllBytes(zpkg);
    if (_bytesEqual(onBytes, offBytes)) {
        ConsoleError.WriteLine("  ✗ `[optimize] inline = false` 没有生效 —— 产物与 inline=true 逐字节相同。");
        ConsoleError.WriteLine("    这个段曾经就是这样：解析进 ProjectManifest.Optimize* 后无人读取。");
        ConsoleError.WriteLine("    接线点：z42c.driver/src/Main.z42 的 effOptSet（Opt.FromToml + Opt.Resolve）；");
        ConsoleError.WriteLine("    若只在全量构建生效而增量不生效，查那里把优化集并进 depsId 的那一行。");
        File.WriteAllText(toml, baseToml); return 1;
    }
    Console.WriteLine("  ✓ inline=false 改变了产物字节（旋钮生效，且增量认到了它）");

    // 改回去必须回到原字节 —— 否则「生效」可能只是某种不确定性。
    File.WriteAllText(toml, baseToml + "\n[optimize]\ninline = true\n");
    if (_incrBuild(vm, driver, libs, toml, false) != 0) {
        ConsoleError.WriteLine("  ✗ rebuild with inline=true failed"); File.WriteAllText(toml, baseToml); return 1;
    }
    if (!_bytesEqual(onBytes, File.ReadAllBytes(zpkg))) {
        ConsoleError.WriteLine("  ✗ 改回 inline=true 没有回到原字节 —— 旋钮的效果不可复现。");
        File.WriteAllText(toml, baseToml); return 1;
    }
    Console.WriteLine("  ✓ 改回 inline=true 回到原字节（可复现）");
    File.WriteAllText(toml, baseToml);
    return 0;
}

// `[optimize]` 门的专用夹具：**必须自带可内联的调用**。
//
// 🔴 为什么不复用 `_incrDemoDir`：实测复用它时 `inline=true` 与 `false` 编出的字节**完全相同**
// （`cached: 0/6` 说明缓存身份已正确认到旋钮变化 —— 是夹具里压根没有可内联的调用）。
// 那样本门就成了「恒红」或（若判据写反）「恒绿」的摆设 —— 判别力来自夹具，不是来自判据措辞。
// 这里的 `Add` 是小函数、在循环里被调用，正是内联 pass 的靶子（手工验证时 960→956 字节）。
string _optKnobDir(string scratch) {
    string d = Path.Join(scratch, "proj");
    Directory.Create(d);
    File.WriteAllText(Path.Join(d, "t.z42.toml"),
        "[project]\nname = \"optknobpkg\"\nversion = \"0.1.0\"\nkind = \"lib\"\n"
        + "[sources]\ninclude = [\"**/*.z42\"]\n");
    File.WriteAllText(Path.Join(d, "m.z42"),
        "namespace OK;\n"
        + "public static class M {\n"
        + "    static int Add(int a, int b) { return a + b; }\n"
        + "    public static int Sum(int n) {\n"
        + "        int s = 0; int i = 0;\n"
        + "        while (i < n) { s = Add(s, i); i = i + 1; }\n"
        + "        return s;\n"
        + "    }\n"
        + "}\n");
    return d;
}

// `[syntax]` 语法特性门。此前 `LanguageFeatures` 零调用方、`E0301 FeatureDisabled` 零发射点 ——
// 「解析了、建模了、文档写了、从没人读」那一族的第三例（前两例：`[build] incremental`、`[optimize]`）。
//
// **四条判据，缺一不可**：
//   V3-负 `control_flow = false` ⇒ 用 `foreach` **必须**报 E0301（只验「开着能编过」等于没测门）
//   V3-正 不写 `[syntax]`        ⇒ 一切照旧（阳性对照：证明红不是夹具本身有问题）
//   V4   未知特性名              ⇒ 报错退出、**不静默忽略**（同 `Opt.ByName` 口径）
//   V5   只改 toml 不碰源码      ⇒ 产物**字节必须变**（特性集进了包级 cache key；
//                                  否则「全量生效、增量被忽略」，比从不生效更难查）
int _syntaxKnobTakesEffect(string vm, string driver, string libs, string projDir) {
    Console.WriteLine("\n── knob: [syntax] takes effect (" + projDir + ") ──");
    string toml = Path.Join(projDir, "t.z42.toml");
    string baseToml = File.ReadAllText(toml);
    string log = Path.Join(projDir, "out.txt");

    // V3-正（阳性对照）：不写 `[syntax]` 必须编得过。先跑它 —— 若连这步都红，后面的红说明不了任何事。
    if (_incrBuild(vm, driver, libs, toml, true) != 0) {
        ConsoleError.WriteLine("  ✗ 阳性对照失败：不写 [syntax] 时夹具就编不过（红与特性门无关）");
        File.WriteAllText(toml, baseToml); return 1;
    }
    string zpkg = _onlyDistZpkg(projDir);   // ⚠️ 必须在首次构建之后才去定位（dist 此前不存在）
    if (zpkg == "") {
        ConsoleError.WriteLine("  ✗ 构建后仍找不到 dist 下唯一的 .zpkg（本判据依赖它）");
        File.WriteAllText(toml, baseToml); return 1;
    }
    byte[] onBytes = File.ReadAllBytes(zpkg);
    Console.WriteLine("  ✓ 阳性对照：不写 [syntax] 编得过");

    // V3-负：关掉 control_flow ⇒ 夹具里的 `foreach`/`while` 必须让构建失败并报 E0301。
    File.WriteAllText(toml, baseToml + "\n[syntax]\ncontrol_flow = false\n");
    int rcOff = _incrBuildErrTo(vm, driver, libs, toml, log);
    string offOut = File.Exists(log) ? File.ReadAllText(log) : "";
    if (rcOff == 0) {
        ConsoleError.WriteLine("  ✗ `[syntax] control_flow = false` 没有生效 —— 构建照常成功。");
        ConsoleError.WriteLine("    这个段曾经就是这样：LanguageFeatures 零调用方、E0301 零发射点。");
        ConsoleError.WriteLine("    接线点：z42c.driver/src/Main.z42 建 feats 那段 → CompileInput.Features →");
        ConsoleError.WriteLine("    IncrementalDriver 的**两处** new Parser → Parser._requireFeature。");
        File.WriteAllText(toml, baseToml); return 1;
    }
    if (offOut.IndexOf("E0301") < 0) {
        ConsoleError.WriteLine("  ✗ 构建失败了，但诊断里没有 E0301 —— 红的理由不对（可能是夹具语法本身出错）。");
        ConsoleError.WriteLine("    实际输出：" + offOut);
        File.WriteAllText(toml, baseToml); return 1;
    }
    Console.WriteLine("  ✓ control_flow=false ⇒ 报 E0301（门真会红，且红的理由对）");

    // V4：未知特性名必须报错退出，不能静默忽略（拼错一个名字而编译照常通过 = 又一句假话）。
    File.WriteAllText(toml, baseToml + "\n[syntax]\nno_such_feature = false\n");
    int rcUnk = _incrBuildErrTo(vm, driver, libs, toml, log);
    string unkOut = File.Exists(log) ? File.ReadAllText(log) : "";
    if (rcUnk == 0) {
        ConsoleError.WriteLine("  ✗ 未知特性名 `no_such_feature` 被静默忽略了 —— 拼错名字不该编译通过。");
        File.WriteAllText(toml, baseToml); return 1;
    }
    // 同样要问「红的理由对不对」—— 未知名报错与「夹具本身编不过」的退出码长得一样。
    if (unkOut.IndexOf("unknown syntax feature") < 0) {
        ConsoleError.WriteLine("  ✗ 构建失败了，但诊断里没有 `unknown syntax feature` —— 红的理由不对。");
        ConsoleError.WriteLine("    实际输出：" + unkOut);
        File.WriteAllText(toml, baseToml); return 1;
    }
    Console.WriteLine("  ✓ 未知特性名报错退出（且理由对）");

    // V5：只改 toml、**源码一个字节不动** ⇒ 产物字节必须变（= 特性集进了包级 cache key）。
    // 用一个**真会改变发射结果**的开关：关掉 exceptions 会让夹具里的 try 报错，不能用来比字节 ⇒
    // 改用「显式写上 control_flow = true」这一形态：它与「不写」在语义上等价，但会进 depsId ⇒
    // 产物应当**字节相同**、而 probe 必须**不命中**（否则说明 depsId 没认到 toml 变化）。
    File.WriteAllText(toml, baseToml + "\n[syntax]\ncontrol_flow = true\n");
    // ⚠️ `cached: N/M` 与诊断一样走 **stderr**（`wrote -> …` 才在 stdout）。本判据要读前者 ⇒
    // 必须用 err 捕获版。第一版用了 stdout 版，于是「实际输出」里只有 `wrote -> …`、判据恒红 ——
    // 与 V3-负 第一版同一个根因（读错了流）。
    if (_incrBuildErrTo(vm, driver, libs, toml, log) != 0) {
        ConsoleError.WriteLine("  ✗ control_flow=true 构建失败"); File.WriteAllText(toml, baseToml); return 1;
    }
    string onOut = File.Exists(log) ? File.ReadAllText(log) : "";
    if (!_bytesEqual(onBytes, File.ReadAllBytes(zpkg))) {
        ConsoleError.WriteLine("  ✗ 显式 control_flow=true 与「不写」产出的字节不同 —— 两者语义应当等价。");
        File.WriteAllText(toml, baseToml); return 1;
    }
    if (onOut.IndexOf("cached: 0/") < 0) {
        ConsoleError.WriteLine("  ✗ 改了 [syntax] 却命中了缓存 —— 特性集没进包级 cache key（depsId）。");
        ConsoleError.WriteLine("    后果是「全量生效、增量被忽略」，比从不生效更难查（[optimize] 实测踩过）。");
        ConsoleError.WriteLine("    实际输出：" + onOut);
        File.WriteAllText(toml, baseToml); return 1;
    }
    Console.WriteLine("  ✓ 改 [syntax] 让缓存失效（特性集在 depsId 里），且等价写法字节相同");

    File.WriteAllText(toml, baseToml);
    return 0;
}

// `[syntax]` 门的专用夹具：**必须自带会被 control_flow 挡住的语法**。
//
// 🔴 同 `_optKnobDir` 的理由：`[optimize]` 那道门第一版复用了 `_incrDemoDir`，而那份夹具压根没有
// 可内联的调用 ⇒ 翻旋钮什么都不变、门零判别力。这里的 `foreach` + `while` 正是 `control_flow`
// 关掉之后必须报 E0301 的靶子。**判别力来自夹具，不来自判据措辞。**
string _synKnobDir(string scratch) {
    string d = Path.Join(scratch, "proj");
    Directory.Create(d);
    File.WriteAllText(Path.Join(d, "t.z42.toml"),
        "[project]\nname = \"synknobpkg\"\nversion = \"0.1.0\"\nkind = \"lib\"\n"
        + "[sources]\ninclude = [\"**/*.z42\"]\n");
    File.WriteAllText(Path.Join(d, "m.z42"),
        "namespace SK;\n"
        + "public static class M {\n"
        + "    public static int SumArr(int[] xs) {\n"
        + "        int s = 0;\n"
        + "        foreach (int v in xs) { s = s + v; }\n"   // control_flow 的靶子①
        + "        int i = 0;\n"
        + "        while (i < 3) { s = s + i; i = i + 1; }\n"  // 靶子②（证明门不是只挡 foreach）
        + "        return s;\n"
        + "    }\n"
        + "}\n");
    return d;
}

// dist 下唯一的 .zpkg 路径（本门的判据载体）；找不到返回 ""。
string _onlyDistZpkg(string projDir) {
    string[] zs = Path.GlobRecursive(Path.Join(projDir, "dist"), "*.zpkg");
    if (zs.Length != 1) { return ""; }
    return zs[0];
}

bool _bytesEqual(byte[] a, byte[] b) {
    if (a.Length != b.Length) { return false; }
    int i = 0;
    while (i < a.Length) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}

// `_incrBuild` 的捕获版：stdout 落盘供判定（stderr 仍丢弃）。
// 诊断捕获版：**stderr 落盘**。z42c 的诊断走 ConsoleError ⇒ 只捕 stdout 读不到任何错误文本
// （`[syntax]` 门第一版就是这样：构建确实失败了，但「实际输出」是空的 —— 幸好判据同时要求
// 「红的理由对不对」，否则只判退出码就会变成一道读不到东西却自称通过的门）。
int _incrBuildErrTo(string vm, string driver, string libs, string toml, string errPath) {
    return new Process(vm).Arg(driver).Arg("--mode").Arg(_z42cMode()).Arg("--").Arg("build").Arg(toml)
        .Env("Z42_LIBS", libs).Stdout(Stdio.Null()).Stderr(Stdio.ToFile(errPath)).Run().ExitCode;
}

int _incrBuildTo(string vm, string driver, string libs, string toml, string outPath) {
    return new Process(vm).Arg(driver).Arg("--mode").Arg(_z42cMode()).Arg("--").Arg("build").Arg(toml)
        .Env("Z42_LIBS", libs).Stdout(Stdio.ToFile(outPath)).Stderr(Stdio.Null()).Run().ExitCode;
}

// 逐文件 touch 对账一个工程。projDir 内须有 t.z42.toml（dist 落 projDir/dist）。
int _reconcileProject(string vm, string driver, string libs, string projDir, string label) {
    Console.WriteLine("\n── reconcile: " + label + " (" + projDir + ") ──");
    string toml = Path.Join(projDir, "t.z42.toml");
    string[] srcs = _sortedStrings(Path.GlobRecursive(projDir, "*.z42"));
    // 初始 build（填 cache）。
    if (_incrBuild(vm, driver, libs, toml, false) != 0) { ConsoleError.WriteLine("  ✗ initial build failed"); return 1; }
    double incrMs = 0.0;
    double fullMs = 0.0;
    int i = 0;
    while (i < srcs.Length) {
        string f = srcs[i];
        string orig = File.ReadAllText(f);
        File.WriteAllText(f, orig + "\n// incr-reconcile-touch\n");
        Stopwatch ti = Stopwatch.StartNew();
        int c1 = _incrBuild(vm, driver, libs, toml, false);
        incrMs = incrMs + ti.Elapsed().TotalMilliseconds();
        if (c1 != 0) { ConsoleError.WriteLine("  ✗ incr build failed after touching " + f); File.WriteAllText(f, orig); return 1; }
        DistSnapZ snapA = _distSnapshot(projDir);
        Stopwatch tf = Stopwatch.StartNew();
        int c2 = _incrBuild(vm, driver, libs, toml, true);
        fullMs = fullMs + tf.Elapsed().TotalMilliseconds();
        if (c2 != 0) { ConsoleError.WriteLine("  ✗ full build failed after touching " + f); File.WriteAllText(f, orig); return 1; }
        DistSnapZ snapB = _distSnapshot(projDir);
        string mism = _snapshotDiff(snapA, snapB);
        if (mism.Length > 0) {
            ConsoleError.WriteLine("  ✗ MISMATCH: incremental != full after touching " + f + " (" + mism + ")");
            File.WriteAllText(f, orig);
            return 1;
        }
        File.WriteAllText(f, orig);   // 还原（下轮 hash 回原值 → 该文件重编，正确性不受影响）
        i = i + 1;
    }
    Console.WriteLine("  ✓ " + srcs.Length.ToString() + "/" + srcs.Length.ToString()
        + " files byte-identical (whole dist); wall-clock incr=" + incrMs.ToString() + "ms full=" + fullMs.ToString()
        + "ms (D8: per-touch avg " + (incrMs / (double)srcs.Length).ToString() + "ms vs "
        + (fullMs / (double)srcs.Length).ToString() + "ms)");
    int dc = _reconcileDeclTouch(vm, driver, libs, projDir, toml, srcs);
    if (dc != 0) { return dc; }
    return _reconcileDistWiped(vm, driver, libs, projDir, toml);
}

// 「改声明」轮（incr-name-level-invalidation）。上面那轮只 append 注释——**压根碰不到声明面**，
// 于是名字级失效判据的主战场（新增名字 / 名字指纹变化 / 传播）全程没有门看着。
// 本轮逐文件在末尾追加一个**新的自由函数声明**（= 新名字 + 该文件声明面变化），再做同款
// 「增量 dist == 全量 dist 逐字节」对账。名字每轮唯一、且随即还原，故不会跨文件撞名。
int _reconcileDeclTouch(string vm, string driver, string libs, string projDir, string toml, string[] srcs) {
    int i = 0;
    while (i < srcs.Length) {
        string f = srcs[i];
        string orig = File.ReadAllText(f);
        File.WriteAllText(f, orig + "\nint __incrDeclProbe" + i.ToString() + "() { return " + i.ToString() + "; }\n");
        int c1 = _incrBuild(vm, driver, libs, toml, false);
        if (c1 != 0) { ConsoleError.WriteLine("  ✗ decl-touch incr build failed after " + f); File.WriteAllText(f, orig); return 1; }
        DistSnapZ snapA = _distSnapshot(projDir);
        int c2 = _incrBuild(vm, driver, libs, toml, true);
        if (c2 != 0) { ConsoleError.WriteLine("  ✗ decl-touch full build failed after " + f); File.WriteAllText(f, orig); return 1; }
        DistSnapZ snapB = _distSnapshot(projDir);
        string mism = _snapshotDiff(snapA, snapB);
        if (mism.Length > 0) {
            ConsoleError.WriteLine("  ✗ MISMATCH: incremental != full after declaring a new function in " + f + " (" + mism + ")");
            File.WriteAllText(f, orig);
            return 1;
        }
        File.WriteAllText(f, orig);
        i = i + 1;
    }
    Console.WriteLine("  ✓ decl-touch (new free function per file): " + srcs.Length.ToString() + "/" + srcs.Length.ToString()
        + " byte-identical to full");
    return 0;
}

// 「全命中 + 必须重新装配」这一轮（fix-incr-allcached-cache-drop）。
// 场景：源一个没动（cache 全命中），但 dist 主文件被清掉 → 不能走 `preserved` 捷径，必须拿
// **全部 cached IrModule** 重新装配一次 dist。此前 `Prepare` 在全命中时无条件早退、返回全 null 的
// cached[]，这条路径于是悄悄退化成「整包重编」——结果照样对，所以逐文件 touch 那轮抓不到它。
// 本轮盯的正是「用 64 份 cache 装配出来的 dist」必须与全量逐字节相同：修复让这条路径第一次真的
// 走 cached 装配，正确性得有门看着。
int _reconcileDistWiped(string vm, string driver, string libs, string projDir, string toml) {
    string dist = Path.Join(projDir, "dist");
    // 基线：全量重建一次 dist（源未动）。
    if (_incrBuild(vm, driver, libs, toml, true) != 0) { ConsoleError.WriteLine("  ✗ dist-wiped: full baseline build failed"); return 1; }
    DistSnapZ full = _distSnapshot(projDir);
    // 清 dist（cache 保留）→ 增量重建：全命中但无法 preserved，只能从 cache 装配。
    if (Directory.Exists(dist)) { Directory.Delete(dist, true); }
    if (_incrBuild(vm, driver, libs, toml, false) != 0) { ConsoleError.WriteLine("  ✗ dist-wiped: incremental rebuild failed"); return 1; }
    DistSnapZ fromCache = _distSnapshot(projDir);
    string mism = _snapshotDiff(fromCache, full);
    if (mism.Length > 0) {
        ConsoleError.WriteLine("  ✗ MISMATCH: dist wiped + all-cached reassembly != full (" + mism + ")");
        return 1;
    }
    Console.WriteLine("  ✓ dist wiped + all-cached reassembly: " + fromCache.N.ToString() + "/" + fromCache.N.ToString()
        + " files byte-identical to full");
    return 0;
}

int _incrBuild(string vm, string driver, string libs, string toml, bool noIncremental) {
    Process p = new Process(vm).Arg(driver).Arg("--mode").Arg(_z42cMode()).Arg("--").Arg("build").Arg(toml);
    if (noIncremental) { p = p.Arg("--no-incremental"); }
    return p.Env("Z42_LIBS", libs).Stdout(Stdio.Null()).Stderr(Stdio.Null()).Run().ExitCode;
}

// ── dist 快照（rel 排序列表 + blake3-128 指纹并行数组；z42 无交错 byte[][]）────────

public sealed class DistSnapZ {
    public string[] Rels;
    public string[] Hashes;
    public int      N;
    public DistSnapZ(string[] rels, string[] hashes, int n) {
        this.Rels = rels; this.Hashes = hashes; this.N = n;
    }
}

DistSnapZ _distSnapshot(string projDir) {
    string dist = Path.Join(projDir, "dist");
    string[] a = Path.GlobRecursive(dist, "*.zpkg");
    string[] b = Path.GlobRecursive(dist, "*.zbc");
    string[] all = new string[a.Length + b.Length];
    int i = 0;
    while (i < a.Length) { all[i] = a[i]; i = i + 1; }
    int j = 0;
    while (j < b.Length) { all[a.Length + j] = b[j]; j = j + 1; }
    all = _sortedStrings(all);
    string[] hs = new string[all.Length];
    i = 0;
    while (i < all.Length) { hs[i] = _blakeHexOf(all[i]); i = i + 1; }
    return new DistSnapZ(all, hs, all.Length);
}

string _blakeHexOf(string path) {
    byte[] bts = File.ReadAllBytes(path);
    byte[] h = Blake3.HashLen(bts, 16);
    string ds = "0123456789abcdef";
    string r = "";
    int i = 0;
    while (i < h.Length) {
        int v = (int)h[i];
        r = r + ds.Substring((v >> 4) & 0xF, 1) + ds.Substring(v & 0xF, 1);
        i = i + 1;
    }
    return r;
}

// 逐文件（rel 与指纹）比较；返回首个不一致描述（"" = 全等）。
string _snapshotDiff(DistSnapZ a, DistSnapZ b) {
    if (a.N != b.N) { return "file count " + a.N.ToString() + " vs " + b.N.ToString(); }
    int i = 0;
    while (i < a.N) {
        if (a.Rels[i] != b.Rels[i]) { return "file set differs: " + a.Rels[i] + " vs " + b.Rels[i]; }
        if (a.Hashes[i] != b.Hashes[i]) { return "bytes differ: " + a.Rels[i]; }
        i = i + 1;
    }
    return "";
}

// 合成 demo 工程：跨文件引用链 + 多块函数（if/switch/try）+ 接口/继承/静态/数组 + 方法级泛型 + struct 值类型。
string _incrDemoDir(string scratch) { return _incrDemoDirNamed(scratch, "demo", false); }

// packed 变体（workspace-read-cache）：indexed 布局下 cache 的 .zbc 原样拷进 dist，读回 IR 的缺陷（如方法级泛型
// 形参没恢复）照不出来；packed 从读回的 IrFunction 重新生成 SIGS/MODS，才会让这类缺陷变成字节差异。
string _incrDemoPackedDir(string scratch) { return _incrDemoDirNamed(scratch, "demo-packed", true); }

string _incrDemoDirNamed(string scratch, string name, bool pack) {
    string d = Path.Join(scratch, name);
    Directory.Create(d);
    File.WriteAllText(Path.Join(d, "t.z42.toml"),
        "[project]\nname = \"incrpkg\"\nversion = \"0.1.0\"\nkind = \"lib\"\n" + (pack ? "pack = true\n" : "")
        + "[sources]\ninclude = [\"**/*.z42\"]\n");
    File.WriteAllText(Path.Join(d, "gen.z42"),
        "namespace D;\n"
        + "public static class Gen {\n"
        + "    public static T Pick<T>(T a, T b, bool first) { if (first) { return a; } return b; }\n"
        + "    public static int Count<T>(T[] xs) { return xs.Length; }\n"
        + "}\n"
        + "public struct Pt { public int X; public int Y; }\n"
        + "public static class PtOps { public static int Sum(int a) { Pt p = new Pt(); p.X = a; p.Y = 2; Pt q = p; return q.X + q.Y; } }\n");
    File.WriteAllText(Path.Join(d, "shape.z42"),
        "namespace D;\n"
        + "public interface IShape { int Area(); }\n"
        + "public class Rect : IShape {\n"
        + "    public int W;\n    public int H;\n"
        + "    public static int Made = 0;\n"
        + "    public Rect(int w, int h) { this.W = w; this.H = h; Rect.Made = Rect.Made + 1; }\n"
        + "    public virtual int Area() { return this.W * this.H; }\n"
        + "}\n");
    File.WriteAllText(Path.Join(d, "square.z42"),
        "namespace D;\n"
        + "public class Square : Rect {\n"
        + "    public Square(int s) : base(s, s) { }\n"
        + "    public override int Area() { return this.W * this.W; }\n"
        + "}\n");
    File.WriteAllText(Path.Join(d, "calc.z42"),
        "namespace D;\n"
        + "public class Calc {\n"
        + "    public int Sum(int n) {\n"
        + "        int[] xs = new int[]{ 1, 2, 3 };\n"
        + "        int acc = 0;\n"
        + "        int i = 0;\n"
        + "        while (i < xs.Length) { acc = acc + xs[i]; i = i + 1; }\n"
        + "        switch (n) {\n"
        + "            case 0: acc = acc + 10;\n"
        + "            default: acc = acc - 1;\n"
        + "        }\n"
        + "        try {\n"
        + "            var sq = new Square(n);\n"
        + "            acc = acc + sq.Area();\n"
        + "        } catch (Exception e) {\n"
        + "            acc = 0 - 1;\n"
        + "        }\n"
        + "        return acc + Rect.Made;\n"
        + "    }\n"
        + "}\n");
    File.WriteAllText(Path.Join(d, "strings.z42"),
        "namespace D;\n"
        + "string Banner(string who) { string p = \"hi, \"; return p + who + \"!\"; }\n"
        + "double Ratio(double a) { double k = 2.5; return a / k; }\n");
    File.WriteAllText(Path.Join(d, "leaf.z42"),
        "namespace D;\nint LeafOnly() { return 42; }\nint UseGen() { int[] xs = new int[]{ 1, 2 }; return Gen.Pick<int>(Gen.Count<int>(xs), 0, true); }\n");
    return d;
}

// 拷贝 xtask 源（真实 40+ 文件工程）到 scratch，替换独立 toml（dist 落本地，不动真品）。
string _incrXtaskCopy(string root, string scratch) {
    string d = Path.Join(scratch, "xtask");
    Directory.Create(d);
    string src = Path.Join(root, "scripts");
    string[] files = _sortedStrings(Path.GlobRecursive(src, "*.z42"));
    int i = 0;
    while (i < files.Length) {
        string rel = files[i].Substring(src.Length + 1);
        string dst = Path.Join(d, rel);
        string parent = Path.GetDirectoryName(dst);
        if (parent.Length > 0) { Directory.Create(parent); }
        File.Copy(files[i], dst);
        i = i + 1;
    }
    File.WriteAllText(Path.Join(d, "t.z42.toml"),
        "[project]\nname = \"incrpkg\"\nversion = \"0.1.0\"\nkind = \"lib\"\n[sources]\ninclude = [\"**/*.z42\"]\n");
    return d;
}
