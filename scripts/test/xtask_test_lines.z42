// xtask — `test lines` gate stage（add-line-count-lint，三面评审 L-10 / C-10 文本结构阶段）。
// 文件行数硬上限 lint：src/ 下非测试 .z42 / .rs 文件 > 500 行即越界（code-organization.md）。
// 先 warn 后 fail 的落地方式 = **棘轮基线**：`scripts/test/line-limit-baseline.txt` 记录已知越界文件
// 及其当时行数；越界文件若不在基线（新越界）或比基线更长（继续膨胀）→ 红；在基线内且不增长 → 只 warn。
// 拆分后降到上限以下的文件在下次 `--update` 时自动从基线消失（只降不升）。
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Cli;
using Std.Time;

// 文件行数硬上限（code-organization.md：.z42 / .rs 500 行）。
int _lineLimitHard() { return 500; }

// `xtask test lines [--update]`
int _testLines(bool update) {
    Stopwatch sw = _procStart("test lines");
    string root = _root();
    string basePath = Path.Join(root, "scripts/test/line-limit-baseline.txt");
    string[] files = _lineLintFiles(root);
    string[] over = new string[64]; int[] overN = new int[64]; int oc = 0;
    int scanned = 0;
    int i = 0;
    while (i < files.Length) {
        int n = _countLines(files[i]);
        scanned = scanned + 1;
        if (n > _lineLimitHard()) {
            if (oc == over.Length) {
                string[] b1 = new string[oc * 2]; int[] b2 = new int[oc * 2];
                int k = 0; while (k < oc) { b1[k] = over[k]; b2[k] = overN[k]; k = k + 1; }
                over = b1; overN = b2;
            }
            over[oc] = _relPath(root, files[i]); overN[oc] = n; oc = oc + 1;
        }
        i = i + 1;
    }
    _sortOverByPath(over, overN, oc);
    if (update) {
        _writeLineBaseline(basePath, over, overN, oc);
        Console.WriteLine("  ✓ baseline rewritten: " + oc.ToString() + " file(s) over " + _lineLimitHard().ToString() + " lines");
        _procEnd("test lines", sw);
        return 0;
    }
    string[] bPath = new string[64]; int[] bN = new int[64];
    int bc = _readLineBaseline(basePath, bPath, bN);
    int fails = 0; int warns = 0;
    i = 0;
    while (i < oc) {
        int at = _indexOfStr(bPath, bc, over[i]);
        if (at < 0) {
            ConsoleError.WriteLine("  ✗ " + over[i] + ": " + overN[i].ToString() + " lines (new file over the " + _lineLimitHard().ToString() + "-line hard limit; split it — code-organization.md)");
            fails = fails + 1;
        } else if (overN[i] > bN[at]) {
            ConsoleError.WriteLine("  ✗ " + over[i] + ": " + overN[i].ToString() + " lines (baseline " + bN[at].ToString() + " — an over-limit file must not grow; split it)");
            fails = fails + 1;
        } else {
            Console.WriteLine("  ⚠ " + over[i] + ": " + overN[i].ToString() + " lines (known, baseline " + bN[at].ToString() + ")");
            warns = warns + 1;
        }
        i = i + 1;
    }
    // 基线里已经不越界 / 已删除的条目：提示棘轮更新（不阻断）。
    i = 0;
    while (i < bc) {
        if (_indexOfStr(over, oc, bPath[i]) < 0) {
            Console.WriteLine("  ℹ " + bPath[i] + " is no longer over the limit — run `xtask test lines --update` to drop it from the baseline");
        }
        i = i + 1;
    }
    Console.WriteLine("  scanned " + scanned.ToString() + " file(s): " + oc.ToString() + " over " + _lineLimitHard().ToString()
        + " lines (" + warns.ToString() + " known, " + fails.ToString() + " new/grown)");
    if (fails > 0) { return 1; }
    Console.WriteLine("  ✓ no new or grown over-limit files");
    _procEnd("test lines", sw);
    return 0;
}

// 受检文件：src/ 下 .z42 / .rs，排除测试（任一路径段为 tests / 以 _tests 结尾、文件名以 _tests.rs 结尾）、
// bench/、构建产物（target/、artifacts/）。
string[] _lineLintFiles(string root) {
    string srcDir = Path.Join(root, "src");
    string[] all = Directory.EnumerateRecursive(srcDir);   // 返回相对 srcDir 的路径
    string[] outp = new string[256]; int n = 0;
    int i = 0;
    while (i < all.Length) {
        string p = Path.Join(srcDir, all[i]);
        if ((p.EndsWith(".z42") || p.EndsWith(".rs")) && !_lineLintExcluded(p)) {
            if (n == outp.Length) { string[] b = new string[n * 2]; int k = 0; while (k < n) { b[k] = outp[k]; k = k + 1; } outp = b; }
            outp[n] = p; n = n + 1;
        }
        i = i + 1;
    }
    string[] r = new string[n];
    i = 0; while (i < n) { r[i] = outp[i]; i = i + 1; }
    return r;
}

bool _lineLintExcluded(string p) {
    string u = p.Replace("\\", "/");
    if (u.EndsWith("_tests.rs") || u.EndsWith("/tests.rs")) { return true; }
    string[] segs = u.Split("/");
    int i = 0;
    while (i < segs.Length - 1) {
        string s = segs[i];
        if (s == "tests" || s == "bench" || s == "target" || s == "artifacts" || s.EndsWith("_tests")) { return true; }
        i = i + 1;
    }
    return false;
}

int _countLines(string path) {
    string t = "";
    try { t = File.ReadAllText(path); }
    catch (Exception ex) { ConsoleError.WriteLine("  warn: cannot read " + path + ": " + ex.Message); return 0; }
    int n = 0; int i = 0; int len = t.Length;
    while (i < len) { if (t.CharAt(i) == '\n') { n = n + 1; } i = i + 1; }
    if (len > 0 && t.CharAt(len - 1) != '\n') { n = n + 1; }
    return n;
}

string _relPath(string root, string p) {
    string u = p.Replace("\\", "/");
    string r = root.Replace("\\", "/");
    if (u.StartsWith(r + "/")) { return u.Substring(r.Length + 1, u.Length - r.Length - 1); }
    return u;
}

void _sortOverByPath(string[] a, int[] n, int c) {
    int i = 1;
    while (i < c) {
        string kp = a[i]; int kn = n[i]; int j = i - 1;
        while (j >= 0 && a[j].CompareTo(kp) > 0) { a[j + 1] = a[j]; n[j + 1] = n[j]; j = j - 1; }
        a[j + 1] = kp; n[j + 1] = kn;
        i = i + 1;
    }
}

int _indexOfStr(string[] a, int c, string key) {
    int i = 0; while (i < c) { if (a[i] == key) { return i; } i = i + 1; }
    return 0 - 1;
}

// 基线格式：每行 `path<TAB>lines`，按 path 序；缺文件 = 空基线。
int _readLineBaseline(string path, string[] outPath, int[] outN) {
    if (!File.Exists(path)) { return 0; }
    string[] lines = File.ReadAllText(path).Split("\n");
    int c = 0; int i = 0;
    while (i < lines.Length) {
        string l = lines[i].Trim();
        if (l.Length > 0 && !l.StartsWith("#")) {
            string[] f = l.Split("\t");
            if (f.Length == 2 && c < outPath.Length) { outPath[c] = f[0]; outN[c] = int.Parse(f[1]); c = c + 1; }
        }
        i = i + 1;
    }
    return c;
}

void _writeLineBaseline(string path, string[] a, int[] n, int c) {
    string s = "# line-limit ratchet baseline (xtask test lines --update): path<TAB>lines; hard limit " + _lineLimitHard().ToString() + "\n";
    int i = 0;
    while (i < c) { s = s + a[i] + "\t" + n[i].ToString() + "\n"; i = i + 1; }
    File.WriteAllTextAtomic(path, s);
}
