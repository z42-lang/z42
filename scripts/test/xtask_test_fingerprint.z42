// xtask — `test compiler fingerprint`：编译器输出变了，版本号必须累加。
//
// 增量缓存的键里，编译器身份 = `CompilerFingerprint.Entries` 的内容哈希 + zbc/zpkg 格式 Minor（见
// docs/internals/src/compiler/compiler-fingerprint.md）。规则是「凡是影响输出的编译器改动都要累加」；
// 产物可复现（同源 + 同编译器 ⇒ 逐字节相同）之后可以机械地判：
//
//   同一份 base stdlib 源码，base 编译器编一遍、本树编译器编一遍，逐包比 zpkg 字节。
//   字节变了 ∧ 指纹没变 ∧ 格式没变 ⇒ 红（缓存会把旧编译器的产物当成新的）。
//
// 输入：`--base <dir>` = base 源码树根，其 stdlib **已由 base 编译器建好**（产物位置按该树
// src/libraries/z42.workspace.toml 的模板解析）。CI 里就是 bench-pr 的 base-src（同 runner 已建）；
// `--base-driver` = base 侧 driver，用来判两侧是不是同一套编译器（见 _compilerSetsEqual）。
// 本树一侧：把 base 的 src/libraries 拷进 scratch，用本树 driver 以 `--no-incremental` 重建。
// 覆盖面 = stdlib 实际走到的编译器路径；stdlib 没用到的 codegen 分支测不到（假阴性，不会假阳性）。
namespace Z42Xtask;

using Std.IO;
using Std.Cli;
using Std.Time;

// 编译器身份三元组 "fp/zbc/zpkg"，从源码树读。fp 片段是 `CompilerFingerprint.Entries` 的**条目数**：
// 指纹本身是内容哈希、源码里读不出来；条目数是可打印且「追加一条即变」的代理。
// 分工：数只给人看，决策用 `_fingerprintSourceOf` 的全文比较（改了既有条目正文也能看见）。
string _fingerprintSourceOf(string tree) {
    string p = Path.Join(tree, "src/compiler/z42c.pipeline/src/CompilerFingerprint.z42");
    if (!File.Exists(p)) { return ""; }
    return File.ReadAllText(p);
}

int _fpEntryCount(string tree) {
    string t = _fingerprintSourceOf(tree);
    // 回落：很旧的 base 树（`--base <任意旧树>`）没有 CompilerFingerprint.z42，指纹还是
    // `CacheStore.z42` 里的一个 int 常量。读出的旧整数与本树条目数不同 ⇒ 判「身份已变」，
    // 这是事实：换表示本身就让所有旧 `.meta` 失效。
    if (t.Length == 0) {
        return _srcIntConst(Path.Join(tree, "src/compiler/z42c.pipeline/src/CacheStore.z42"),
            "public static int CompilerFingerprint = ");
    }
    // 数 `Entries` 初始化块里的字符串字面量行（每条一行，见该文件的「只许追加」纪律）。
    int k = t.IndexOf("Entries = new string[]");
    if (k < 0) { return -1; }
    // z42 的 `String.IndexOf` **没有 (needle, startIndex) 重载** —— 先切尾再找。
    string tail = t.Substring(k, t.Length - k);
    int e = tail.IndexOf("};");
    if (e < 0) { return -1; }
    string body = tail.Substring(0, e);
    // 数引号对。⚠️ **跳过 `//` 注释行** —— 条目注释里的双引号会虚增条目数，打印的身份数字随之失真。
    int n = 0;
    int i = 0;
    bool inLineComment = false;
    while (i < body.Length) {
        char c = body.CharAt(i);
        if (c == '\n') { inLineComment = false; }
        else if (!inLineComment && c == '/' && i + 1 < body.Length && body.CharAt(i + 1) == '/') {
            inLineComment = true;
        }
        else if (!inLineComment && c == '"') { n = n + 1; }
        i = i + 1;
    }
    return n / 2;   // 每条 slug 两个引号
}

string _compilerIdentityOf(string tree) {
    string fp = _fpEntryCount(tree).ToString();
    string zbc = _srcIntConst(Path.Join(tree, "src/compiler/z42.package/src/BinaryFormat/ZbcFormat.z42"),
        "public static int Minor = ").ToString();
    string zpkg = _srcIntConst(Path.Join(tree, "src/compiler/z42.package/src/ZpkgWriter.z42"),
        "public static int Minor = ").ToString();
    return fp + "/" + zbc + "/" + zpkg;
}

// ── 「源码没变就没得 bump」守卫 ──────────────────────────────────
//
// 两侧 driver 源码相同但**自举代不同**（base 侧是「PR 的 z42c 编 base 源码」，本树侧是种子链产物），
// 而 z42c 自建每推进一代恰有一两个包字节不同（stdlib 构建不是代际收敛的）⇒ 同源 driver 编出的 stdlib
// 本就可能差一两个包。源码逐字节相同时「输出变了」不可能是「身份该变而没变」，没有 slug 可加，
// 照提示 bump 只会平白让全网增量缓存作废一次。
//
// 比 `src/compiler` **与** `src/libraries`（stdlib 变了也可能改变编译器输出）两棵树，都相同才跳过；
// 跳过时大声说明，不静默 return 0。VM 改动不在此列：两侧 stdlib 都在同一个 PR VM 上编，本门对 VM
// 造成的输出变化本就没有分辨力。
bool _srcDirsEqual(string a, string b) {
    bool aEx = Directory.Exists(a);
    bool bEx = Directory.Exists(b);
    if (aEx != bEx) { return false; }
    if (!aEx) { return true; }
    string[] ea = _sortedStrings(Directory.Enumerate(a));
    string[] eb = _sortedStrings(Directory.Enumerate(b));
    // 先按名字集合比，再逐项下钻：名字不同就不必读内容。
    int na = 0;
    int nb = 0;
    int i = 0;
    while (i < ea.Length) { if (!_fpSkipEntry(ea[i])) { na = na + 1; } i = i + 1; }
    i = 0;
    while (i < eb.Length) { if (!_fpSkipEntry(eb[i])) { nb = nb + 1; } i = i + 1; }
    if (na != nb) { return false; }
    i = 0;
    int j = 0;
    while (i < ea.Length) {
        string name = ea[i];
        i = i + 1;
        if (_fpSkipEntry(name)) { continue; }
        // 对齐 b 侧的下一个非跳过项
        while (j < eb.Length && _fpSkipEntry(eb[j])) { j = j + 1; }
        if (j >= eb.Length || eb[j] != name) { return false; }
        j = j + 1;
        string pa = Path.Join(a, name);
        string pb = Path.Join(b, name);
        if (Directory.Exists(pa) || Directory.Exists(pb)) {
            if (!_srcDirsEqual(pa, pb)) { return false; }
        } else {
            if (!_filesEqual(pa, pb)) { return false; }
        }
    }
    return true;
}

// 源码树里混着构建产物（`src/libraries/<lib>/artifacts/...`）——它们必然不同，不是源码差异。
bool _fpSkipEntry(string name) {
    return name == "artifacts" || name == ".cache" || name == "cache" || name == "dist";
}

// ── 可比性判据：两侧是不是**同一套编译器** ────────────────────────────────────
//
// 🔴 判据必须覆盖**整个编译器包集合**（src/compiler 下全部成员），不能只看 `z42c.driver.zpkg`：
// driver 只是最上一层，只比它 ⇒ 改 semantics 的 PR 两侧照样「相同」，门就会拿没验过的结论判红。
//
// `baseDir` = bench-pr.yml 平铺出来的 base 编译器产物目录（base 的
// `artifacts/build/compiler/*/release/dist/*.zpkg` 全拷进同一个目录）。逐个拿本树同名成员包去比；
// **任一缺失或不同即判「不可比」**（宁可说判不了，也不要拿没验过的结论挡 PR）。
bool _compilerSetsEqual(string baseDir, string root) {
    if (!Directory.Exists(baseDir)) { return false; }
    string[] members = _enumDirsSorted(_compilerBuildRoot(root));
    int n = 0;
    int i = 0;
    while (i < members.Length) {
        string m = members[i];
        i = i + 1;
        string head = _compilerMemberZpkg(root, m, "release");
        if (!File.Exists(head)) { continue; }          // 没建出来的成员不参与判定
        string bp = Path.Join(baseDir, m + ".zpkg");
        if (!File.Exists(bp)) {
            Console.WriteLine("    ⓘ base 侧缺成员包：" + m + ".zpkg ⇒ 按不可比处理");
            return false;
        }
        if (!_filesEqual(bp, head)) {
            Console.WriteLine("    ⓘ 成员包字节不同：" + m + ".zpkg ⇒ 两侧不是同一套编译器");
            return false;
        }
        n = n + 1;
    }
    // 一个都没比到 = 没有判别力，同样不能宣称「验过了」。
    if (n == 0) {
        Console.WriteLine("    ⓘ 本树 artifacts/build/compiler 下没有可比的成员包 ⇒ 按不可比处理");
        return false;
    }
    Console.WriteLine("    ⓘ 逐字节比过 " + n.ToString() + " 个编译器成员包");
    return true;
}

int _testFingerprint(ParseResult r) {
    Stopwatch sw = _procStart("test compiler fingerprint");
    string root = _root();
    string baseTree = r.GetOption("base");
    if (baseTree.Length == 0) {
        ConsoleError.WriteLine("usage: xtask test compiler fingerprint --base <base 源码树根（其 stdlib 已由 base 编译器建好）>");
        return 2;
    }
    string baseDriver = r.GetOption("base-driver");
    string baseId = _compilerIdentityOf(baseTree);
    string headId = _compilerIdentityOf(root);
    Console.WriteLine("  编译器身份（CompilerFingerprint/zbc/zpkg）：base " + baseId + " · 本树 " + headId);
    if (baseId.Contains("-1") || headId.Contains("-1")) {
        ConsoleError.WriteLine("  ✗ 读不到版本常量（CacheStore.z42 / ZbcFormat.z42 / ZpkgWriter.z42 改名了？同步本脚本）");
        return 1;
    }

    // 源码没变 ⇒ 没得 bump（见 _srcDirsEqual 头注：剩下的差异只可能是代际漂移）。
    bool sameCompiler = _srcDirsEqual(Path.Join(baseTree, "src/compiler"), Path.Join(root, "src/compiler"));
    bool sameStdlib = _srcDirsEqual(Path.Join(baseTree, "src/libraries"), Path.Join(root, "src/libraries"));
    if (sameCompiler && sameStdlib) {
        Console.WriteLine("  base 与本树的 src/compiler + src/libraries **逐字节相同** ⇒ 跳过字节对比。");
        Console.WriteLine("  （本门只管「编译器变了却没累加身份」；源码没变时无 slug 可加，而两侧 driver");
        Console.WriteLine("    的自举代不同本就会让一两个包字节不同 —— 那是代际漂移，不是身份问题。）");
        _procEnd("test compiler fingerprint", sw);
        return 0;
    }
    if (!sameCompiler) { Console.WriteLine("  src/compiler 与 base 不同 ⇒ 照常对比字节"); }
    else { Console.WriteLine("  src/compiler 相同但 src/libraries 不同 ⇒ 照常对比字节（stdlib 能改变编译器行为）"); }

    // 可比性先算、先打印：门每一轮都该说清自己这轮有没有判别力，不只在判红时才交代
    // （否则字节没变的那一路永远看不到它，判据本身没法被验证）。
    bool comparable = true;
    if (baseDriver.Length > 0) {
        if (!File.Exists(baseDriver)) {
            Console.WriteLine("  ⚠ --base-driver 指向的文件不存在：" + baseDriver + "（按可比处理，照常判定）");
        } else {
            comparable = _compilerSetsEqual(Path.GetDirectoryName(baseDriver), root);
            if (comparable) {
                Console.WriteLine("  ✓ 两侧编译器是同一套包（每个成员包逐字节相同）⇒ 差异不可能来自自举代，判定有效");
            } else {
                Console.WriteLine("  ⚠ 两侧编译器**不是同一套包** ⇒ 本门在这种输入下没有判别力");
            }
        }
    }

    // 本树编译器重编 base 的 stdlib 源码（拷进 scratch，产物按拷贝里的 workspace 模板落在 scratch 内）。
    string scratch = _workOut(root, "src/compiler/z42c.pipeline", "fingerprint");
    _resetDir(scratch);
    string srcLibs = Path.Join(scratch, "src/libraries");
    Directory.Copy(Path.Join(baseTree, "src/libraries"), srcLibs, true);
    int bc = _z42cWorkspaceBuild(_builtVm(root, "release"), _driverZpkg(root, "release"), srcLibs, _libsDir(root), true);
    if (bc != 0) {
        // 本树编译器编不过 base 源码（如新增诊断、PR 同时改了 stdlib）⇒ 无从对比。不判红，但明示没测。
        Console.WriteLine("::warning::test compiler fingerprint: 本树编译器编不过 base 的 stdlib 源码，本次未检查编译器输出是否变化");
        _procEnd("test compiler fingerprint", sw);
        return 0;
    }

    string baseWs = Path.Join(baseTree, "src/libraries/z42.workspace.toml");
    string headWs = Path.Join(srcLibs, "z42.workspace.toml");
    string[] dirs = _enumDirsSorted(Path.Join(baseTree, "src/libraries"));
    string changed = "";
    string missing = "";
    int nChanged = 0;
    int nSame = 0;
    int nMissing = 0;
    int i = 0;
    while (i < dirs.Length) {
        string m = dirs[i];
        i = i + 1;
        if (Path.Glob(Path.Join(Path.Join(baseTree, "src/libraries"), m), "*.z42.toml").Length == 0) { continue; }
        string a = Path.Join(_memberDist(baseWs, m, "release"), m + ".zpkg");
        string b = Path.Join(_memberDist(headWs, m, "release"), m + ".zpkg");
        if (!File.Exists(a) && !File.Exists(b)) { continue; }
        // 🔴 只有一侧在场 ≠ 「字节变了」：`_filesEqual` 对缺文件只会答「不相等」，会把**输入不完整**
        // 报成「编译器输出变了，请加 slug」。输入缺失必须单独报错。
        if (!File.Exists(a) || !File.Exists(b)) {
            missing = missing + (nMissing > 0 ? ", " : "") + m + (File.Exists(a) ? "(head 缺)" : "(base 缺)");
            nMissing = nMissing + 1;
            continue;
        }
        if (_filesEqual(a, b)) { nSame = nSame + 1; continue; }
        // 带上两侧尺寸：差 11 字节和差 3KB 是完全不同的故事，而事后回看只有 CI 日志。
        changed = changed + (nChanged > 0 ? ", " : "") + m
            + "(base " + File.GetSize(a).ToString() + "B / head " + File.GetSize(b).ToString() + "B)";
        nChanged = nChanged + 1;
    }
    if (nMissing > 0) {
        ConsoleError.WriteLine("  ✗ 有 " + nMissing.ToString() + " 个包只有一侧有产物，无从比对：" + missing);
        ConsoleError.WriteLine("    这**不是**「编译器输出变了」——是本门的输入不完整，别据此加指纹 slug。");
        ConsoleError.WriteLine("    base 侧缺 ⇒ 该树必须**真跑过** `xtask build stdlib`；门比的是 per-member dist");
        ConsoleError.WriteLine("    （`" + _memberDist(baseWs, "<pkg>", "release") + "`），只把 flat libs 铺进");
        ConsoleError.WriteLine("    `artifacts/intermediate/libraries/flat/release/` **不够**（那是运行期 libs，不是本门的比对面）。");
        return 1;
    }
    if (nSame + nChanged == 0) {
        ConsoleError.WriteLine("  ✗ base 树里找不到已建好的 stdlib 产物（先用 base 编译器建 " + baseWs + "）");
        return 1;
    }
    if (nChanged == 0) {
        Console.WriteLine("  ✓ 编译器输出未变（" + nSame.ToString() + " 个包逐字节一致）");
        _procEnd("test compiler fingerprint", sw);
        return 0;
    }
    Console.WriteLine("  编译器输出变了：" + nChanged.ToString() + " 个包（" + changed + "）");
    Console.WriteLine("  ⓘ 本树 driver：" + _driverZpkg(root, "release"));
    // 本门默认两侧 driver 只差在被测源码上；bench-pr.yml 的编排不满足（BASEDRIVER 是 PRDRIVER 又编
    // 一代 ⇒ 两侧恒差一代），叠加代际漂移，「编译器真改了」的 PR 上也会报出分辨不了真假的红。
    // 两侧不是同一套编译器时本门没有判别力：如实说「判不了」、不判红，也别据此 bump
    // （平白作废一次全网增量缓存，下个 PR 照样红）。
    // ⚠️ 止血不是根治：根治要让门自己用同一个上游 driver 把两侧编到同一代。
    if (!comparable) {
        Console.WriteLine("    base 编译器包目录：" + Path.GetDirectoryName(baseDriver));
        Console.WriteLine("    上面那 " + nChanged.ToString() + " 个包的差异**可能**来自自举代差异，也可能来自你的改动 ——");
        Console.WriteLine("    本门分辨不了，因此**不判红**，也请不要据此 bump 指纹。");
        Console.WriteLine("    要确认是不是自己的改动：让 base 树与本树处在同一代，再跑一次本门");
        Console.WriteLine("    （base 树多跑/少跑一遍 `build stdlib` 就会改变结论 —— 这本身就是漂移的证据）。");
        Console.WriteLine("::warning::test compiler fingerprint: 两侧编译器非同一套包，本次未能判定编译器输出是否变化");
        _procEnd("test compiler fingerprint", sw);
        return 0;
    }
    if (baseDriver.Length == 0) {
        Console.WriteLine("    两侧 driver 是否同一二进制，看 bench-pr 日志里的 `driver sha` 两行；"
            + "不同 ⇒ 先怀疑自举代差异，不是你的改动（传 `--base-driver` 可让本门自己判）。");
    }
    // 判定：格式/条目数变了（baseId 变），**或**指纹源文件全文变了（改了既有条目正文也算）。
    // 全文比较是精确判据；条目数只用于打印（见 `_compilerIdentityOf` 头注）。
    bool fpSrcChanged = _fingerprintSourceOf(baseTree) != _fingerprintSourceOf(root);
    if (baseId != headId || fpSrcChanged) {
        Console.WriteLine("  ✓ 编译器身份已变（" + baseId + " → " + headId + "），旧缓存会作废");
        _procEnd("test compiler fingerprint", sw);
        return 0;
    }
    ConsoleError.WriteLine("  ✗ 编译器输出变了，但编译器身份没变 —— 增量缓存会把旧编译器的产物当成新的。");
    ConsoleError.WriteLine("    请在 src/compiler/z42c.pipeline/src/CompilerFingerprint.z42 的 `Entries` 末尾");
    ConsoleError.WriteLine("    追加一行本次变更的 slug（规则见 docs/internals/src/compiler/compiler-fingerprint.md）。");
    return 1;
}
