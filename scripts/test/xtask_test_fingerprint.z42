// xtask — `test fingerprint`：编译器输出变了，版本号必须累加（guard-compiler-fingerprint）。
//
// 增量缓存的键里，编译器身份 = `CacheStore.CompilerFingerprint` + zbc/zpkg 格式 Minor（见
// version-bumping.md「编译器语义指纹」）。规则是「凡是影响输出的编译器改动都要累加」，此前全靠自觉。
// #654 之后产物可复现（同源 + 同编译器 ⇒ 逐字节相同），于是可以机械地判：
//
//   同一份 base stdlib 源码，base 编译器编一遍、本树编译器编一遍，逐包比 zpkg 字节。
//   字节变了 ∧ 指纹没变 ∧ 格式没变 ⇒ 红（缓存会把旧编译器的产物当成新的）。
//
// 输入：`--base <dir>` = base 源码树根，其 stdlib **已由 base 编译器建好**（产物位置按该树
// src/libraries/z42.workspace.toml 的模板解析）。CI 里就是 bench-pr 的 base-src（同 runner 已建）。
// 本树一侧：把 base 的 src/libraries 拷进 scratch，用本树 driver 以 `--no-incremental` 重建。
// 覆盖面 = stdlib 实际走到的编译器路径；stdlib 没用到的 codegen 分支测不到（假阴性，不会假阳性）。
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Cli;
using Std.Time;

// `_srcIntConst`（源码里读 int 常量）住在 common/xtask_common.z42 —— `_ensureSeed`
// 的种子代际校验也用它，故提到公共层。

// 编译器身份三元组 "fp/zbc/zpkg"，从源码树读。
// 指纹片段改读 `CompilerFingerprint.Entries` 的**条目数**（fingerprint-content-derived）：
// 指纹本身是那张列表的内容哈希、不再是源码里的一个数，`_srcIntConst` 抓不到它。
// 条目数是**可打印**且「追加一条即变」的代理；精确判定由 `_fingerprintSourceOf` 的全文比较做
// —— 两者分工：数用来给人看，全文用来做决策（改了既有条目正文也能看见）。
string _fingerprintSourceOf(string tree) {
    string p = Path.Join(tree, "src/compiler/z42c.pipeline/src/CompilerFingerprint.z42");
    if (!File.Exists(p)) { return ""; }
    return File.ReadAllText(p);
}

int _fpEntryCount(string tree) {
    string t = _fingerprintSourceOf(tree);
    // 🔴 **过渡期回落**：base 树可能早于 fingerprint-content-derived，那时指纹还是
    // `CacheStore.z42` 里的一个 int 常量、`CompilerFingerprint.z42` 根本不存在。
    // 没有这条回落，守门读出 -1 并判「读不到版本常量」⇒ **换方案的那个 PR 自己必红**
    // （实测：`base -1/44/49 · 本树 2/44/49` ⇒ ✗）。
    //
    // 回落后：base 读出旧的整数（如 41）、本树读出条目数（如 2）⇒ 两者不同 ⇒ 守门正确地
    // 认为「编译器身份已变」—— 而那确实是事实：换表示本身就让所有旧 `.meta` 失效。
    //
    // ⚠️ 这条回落在两侧都有新文件之后就永远走不到了，但**先留着**：它同时护住
    // 「拿很旧的 base 跑守门」这个合法用法（`--base <任意旧树>`）。
    if (t.Length == 0) {
        return _srcIntConst(Path.Join(tree, "src/compiler/z42c.pipeline/src/CacheStore.z42"),
            "public static int CompilerFingerprint = ");
    }
    // 数 `Entries` 初始化块里的字符串字面量行（每条一行，见该文件的「只许追加」纪律）。
    int k = t.IndexOf("Entries = new string[]");
    if (k < 0) { return -1; }
    // z42 的 `String.IndexOf` **没有 (needle, startIndex) 重载** —— 先切尾再找。
    string tail = t.Substring(k, t.Length - k);
    int e = tail.IndexOf("};");
    if (e < 0) { return -1; }
    string body = tail.Substring(0, e);
    int n = 0;
    int i = 0;
    while (i < body.Length) { if (body.CharAt(i) == '"') { n = n + 1; } i = i + 1; }
    return n / 2;   // 每条 slug 两个引号
}

string _compilerIdentityOf(string tree) {
    string fp = _fpEntryCount(tree).ToString();
    string zbc = _srcIntConst(Path.Join(tree, "src/compiler/z42.package/src/BinaryFormat/ZbcFormat.z42"),
        "public static int Minor = ").ToString();
    string zpkg = _srcIntConst(Path.Join(tree, "src/compiler/z42.package/src/ZpkgWriter.z42"),
        "public static int Minor = ").ToString();
    return fp + "/" + zbc + "/" + zpkg;
}

// ── 「源码没变就没得 bump」守卫（2026-09-28）──────────────────────────────────
//
// 🔴 **本门会对完全不碰编译器的 PR 假红**，实测四个独立数据点都指向同一个包：
//   · #925（改了编译器）、#927（只改 Rust VM）、#928（只改构建脚本）——都是「1 个包（z42.json）」；
//   · 本地拿**本树自己**当 base（差异为零）跑本门，同样报 z42.json。
//
// 机理是**代际混淆**，它由本门的编排构造出来，与被测 PR 无关：base 侧的 driver 是
// 「PR 的 z42c 编 base 源码」（bench-pr.yml），本树侧的 driver 是「种子链编本树源码」——
// 源码相同、**自举代不同**。而 `stdlib-build-not-generationally-convergent` 是本仓库
// 已记录的既有性质：z42c 自建每跑一遍推进一代，**每代恰有一两个包的字节不同**，要几代才到
// 不动点。于是「两个不同代的同源 driver」编出的 stdlib 本就会有一两个包不一样。
//
// ⇒ 源码逐字节相同时，「输出变了」在**定义上**就不可能是「编译器身份该变而没变」——
// 没有任何 slug 可以追加。此前的处置是照提示 bump 一行（#925 就是这么绿的），那是
// **治症状**：既没消除代际漂移，又平白让全网增量缓存作废一次。
//
// 比 `src/compiler`（编译器本体，含 z42.package 的格式写端）**与** `src/libraries`
// （编译器自己也编译/运行在它之上，stdlib 变了确实可能改变输出）两棵树；两棵都逐字节
// 相同才跳过。跳过时**大声说明**，不做静默 return 0——静默跳过正是本仓库反复吃过的假门形状。
//
// ⚠️ VM 改动不在此列，也**不该**在：本门两侧的 stdlib 都是在**同一个 PR VM** 上编出来的
// （bench-pr.yml 那行注释写明了「这一步用 PR 的 VM 跑」），所以它对 VM 造成的输出变化本就
// 没有分辨力，跳过不损失覆盖。
bool _srcDirsEqual(string a, string b) {
    bool aEx = Directory.Exists(a);
    bool bEx = Directory.Exists(b);
    if (aEx != bEx) { return false; }
    if (!aEx) { return true; }
    string[] ea = _sortedStrings(Directory.Enumerate(a));
    string[] eb = _sortedStrings(Directory.Enumerate(b));
    // 先按名字集合比，再逐项下钻：名字不同就不必读内容。
    int na = 0;
    int nb = 0;
    int i = 0;
    while (i < ea.Length) { if (!_fpSkipEntry(ea[i])) { na = na + 1; } i = i + 1; }
    i = 0;
    while (i < eb.Length) { if (!_fpSkipEntry(eb[i])) { nb = nb + 1; } i = i + 1; }
    if (na != nb) { return false; }
    i = 0;
    int j = 0;
    while (i < ea.Length) {
        string name = ea[i];
        i = i + 1;
        if (_fpSkipEntry(name)) { continue; }
        // 对齐 b 侧的下一个非跳过项
        while (j < eb.Length && _fpSkipEntry(eb[j])) { j = j + 1; }
        if (j >= eb.Length || eb[j] != name) { return false; }
        j = j + 1;
        string pa = Path.Join(a, name);
        string pb = Path.Join(b, name);
        if (Directory.Exists(pa) || Directory.Exists(pb)) {
            if (!_srcDirsEqual(pa, pb)) { return false; }
        } else {
            if (!_filesEqual(pa, pb)) { return false; }
        }
    }
    return true;
}

// 源码树里混着构建产物（`src/libraries/<lib>/artifacts/...` 实测就有）——它们**必然**不同，
// 不是源码差异。跳过它们与缓存目录。
bool _fpSkipEntry(string name) {
    return name == "artifacts" || name == ".cache" || name == "cache" || name == "dist";
}

int _testFingerprint(ParseResult r) {
    Stopwatch sw = _procStart("test fingerprint");
    string root = _root();
    string baseTree = r.GetOption("base");
    if (baseTree.Length == 0) {
        ConsoleError.WriteLine("usage: xtask test fingerprint --base <base 源码树根（其 stdlib 已由 base 编译器建好）>");
        return 2;
    }
    string baseId = _compilerIdentityOf(baseTree);
    string headId = _compilerIdentityOf(root);
    Console.WriteLine("  编译器身份（CompilerFingerprint/zbc/zpkg）：base " + baseId + " · 本树 " + headId);
    if (baseId.Contains("-1") || headId.Contains("-1")) {
        ConsoleError.WriteLine("  ✗ 读不到版本常量（CacheStore.z42 / ZbcFormat.z42 / ZpkgWriter.z42 改名了？同步本脚本）");
        return 1;
    }

    // 源码没变 ⇒ 没得 bump（见上方守卫的头注：剩下的差异只可能是代际漂移）。
    bool sameCompiler = _srcDirsEqual(Path.Join(baseTree, "src/compiler"), Path.Join(root, "src/compiler"));
    bool sameStdlib = _srcDirsEqual(Path.Join(baseTree, "src/libraries"), Path.Join(root, "src/libraries"));
    if (sameCompiler && sameStdlib) {
        Console.WriteLine("  base 与本树的 src/compiler + src/libraries **逐字节相同** ⇒ 跳过字节对比。");
        Console.WriteLine("  （本门只管「编译器变了却没累加身份」；源码没变时无 slug 可加，而两侧 driver");
        Console.WriteLine("    的自举代不同本就会让一两个包字节不同 —— 那是代际漂移，不是身份问题。）");
        _procEnd("test fingerprint", sw);
        return 0;
    }
    if (!sameCompiler) { Console.WriteLine("  src/compiler 与 base 不同 ⇒ 照常对比字节"); }
    else { Console.WriteLine("  src/compiler 相同但 src/libraries 不同 ⇒ 照常对比字节（stdlib 能改变编译器行为）"); }

    // 本树编译器重编 base 的 stdlib 源码（拷进 scratch，产物按拷贝里的 workspace 模板落在 scratch 内）。
    string scratch = Path.Join(root, "artifacts/.scratch/fingerprint");
    _resetDir(scratch);
    string srcLibs = Path.Join(scratch, "src/libraries");
    Directory.Copy(Path.Join(baseTree, "src/libraries"), srcLibs, true);
    int bc = _z42cWorkspaceBuild(_builtVm(root, "release"), _driverZpkg(root, "release"), srcLibs, _libsDir(root), true);
    if (bc != 0) {
        // 本树编译器编不过 base 源码（如新增诊断、PR 同时改了 stdlib）⇒ 无从对比。不判红，但明示没测。
        Console.WriteLine("::warning::test fingerprint: 本树编译器编不过 base 的 stdlib 源码，本次未检查编译器输出是否变化");
        _procEnd("test fingerprint", sw);
        return 0;
    }

    string baseWs = Path.Join(baseTree, "src/libraries/z42.workspace.toml");
    string headWs = Path.Join(srcLibs, "z42.workspace.toml");
    string[] dirs = _enumDirsSorted(Path.Join(baseTree, "src/libraries"));
    string changed = "";
    string missing = "";
    int nChanged = 0;
    int nSame = 0;
    int nMissing = 0;
    int i = 0;
    while (i < dirs.Length) {
        string m = dirs[i];
        i = i + 1;
        if (Path.Glob(Path.Join(Path.Join(baseTree, "src/libraries"), m), "*.z42.toml").Length == 0) { continue; }
        string a = Path.Join(_memberDist(baseWs, m, "release"), m + ".zpkg");
        string b = Path.Join(_memberDist(headWs, m, "release"), m + ".zpkg");
        if (!File.Exists(a) && !File.Exists(b)) { continue; }
        // 🔴 **只有一侧在场 ≠ 「字节变了」**。此前这里直接落到 `_filesEqual`，而它对
        // 「文件不存在」只会答「不相等」⇒ 门把**输入不完整**报成了「编译器输出变了，请加
        // 指纹 slug」。实测代价：base 树只铺了 flat libs（`dist/release/`）而没有 per-member
        // 产物时，**25 个包全部**被判为变了，指示去追加一条根本不需要的 slug。
        // 判别只靠「全变太反常」这种先验，太脆 —— 输入缺失必须自己响。
        // 同 `audit-silent-gates`：门在输入不完整时给出了看似正当的结论。
        if (!File.Exists(a) || !File.Exists(b)) {
            missing = missing + (nMissing > 0 ? ", " : "") + m + (File.Exists(a) ? "(head 缺)" : "(base 缺)");
            nMissing = nMissing + 1;
            continue;
        }
        if (_filesEqual(a, b)) { nSame = nSame + 1; continue; }
        changed = changed + (nChanged > 0 ? ", " : "") + m;
        nChanged = nChanged + 1;
    }
    if (nMissing > 0) {
        ConsoleError.WriteLine("  ✗ 有 " + nMissing.ToString() + " 个包只有一侧有产物，无从比对：" + missing);
        ConsoleError.WriteLine("    这**不是**「编译器输出变了」——是本门的输入不完整，别据此加指纹 slug。");
        ConsoleError.WriteLine("    base 侧缺 ⇒ 该树必须**真跑过** `xtask build stdlib`；门比的是 per-member dist");
        ConsoleError.WriteLine("    （`" + _memberDist(baseWs, "<pkg>", "release") + "`），只把 flat libs 铺进");
        ConsoleError.WriteLine("    `artifacts/build/libraries/dist/release/` **不够**（那是运行期 libs，不是本门的比对面）。");
        return 1;
    }
    if (nSame + nChanged == 0) {
        ConsoleError.WriteLine("  ✗ base 树里找不到已建好的 stdlib 产物（先用 base 编译器建 " + baseWs + "）");
        return 1;
    }
    if (nChanged == 0) {
        Console.WriteLine("  ✓ 编译器输出未变（" + nSame.ToString() + " 个包逐字节一致）");
        _procEnd("test fingerprint", sw);
        return 0;
    }
    Console.WriteLine("  编译器输出变了：" + nChanged.ToString() + " 个包（" + changed + "）");
    // 判定：格式/条目数变了（baseId 变），**或**指纹源文件全文变了（改了既有条目正文也算）。
    // 全文比较是精确判据；baseId 只用于打印（见 `_compilerIdentityOf` 头注）。
    bool fpSrcChanged = _fingerprintSourceOf(baseTree) != _fingerprintSourceOf(root);
    if (baseId != headId || fpSrcChanged) {
        Console.WriteLine("  ✓ 编译器身份已变（" + baseId + " → " + headId + "），旧缓存会作废");
        _procEnd("test fingerprint", sw);
        return 0;
    }
    ConsoleError.WriteLine("  ✗ 编译器输出变了，但编译器身份没变 —— 增量缓存会把旧编译器的产物当成新的。");
    ConsoleError.WriteLine("    请在 src/compiler/z42c.pipeline/src/CompilerFingerprint.z42 的 `Entries` 末尾");
    ConsoleError.WriteLine("    追加一行本次变更的 slug（规则见 version-bumping.md「编译器语义指纹」）。");
    return 1;
}
