// xtask — stdlib [Test] harness (split from xtask_test.z42, 2026-06-30, for the
// 500-line code-org limit). Same Z42Xtask namespace; calls _root/_exec/_builtVm/
// _builtBin/_buildStdlib/_buildRuntime/_assembleAllLibs/_compilerMembers/
// _cleanGlob/_linkAll/_sortedStrings/_parseShard etc. cross-file (same namespace).
//
// `test stdlib|bench [lib]`: discover each src/libraries/<lib>/tests|bench/*,
// compile to zpkg via z42c, run through z42b; results aggregated.
// Single-file tests (tests/foo.z42) go through emit-zbc; dir-mode tests
// (tests/<name>/source.z42) synthesise a mini-manifest + `z42c build`.
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Toml;
using Std.Time;
using Std.Cli;

// Count a lib's [Test] units (single-file tests/*.z42 + dir-mode tests/<name>/
// source.z42) — drives shard load balancing.
int _libUnitCount(string root, string lib) {
    string td = Path.Join(Path.Join(root, "src/libraries/" + lib), "tests");
    if (!Directory.Exists(td)) { return 0; }
    int c = Path.Glob(td, "*.z42").Length;
    string[] entries = Path.Glob(td, "*");
    int i = 0;
    while (i < entries.Length) {
        if (File.Exists(Path.Join(entries[i], "source.z42"))) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// Libs assigned to shard k of n, balanced by [Test] unit count: sort libs by
// count desc, then round-robin sorted positions across shards (longest-first
// keeps the heavy libs in distinct shards → even load).
string[] _shardLibs(string root, int k, int n) {
    string[] all = _stdlibList(root);
    int m = all.Length;
    int[] cnt = new int[m];
    int[] idx = new int[m];
    int i = 0;
    while (i < m) { cnt[i] = _libUnitCount(root, all[i]); idx[i] = i; i = i + 1; }
    int a = 0;
    while (a < m) {
        int best = a;
        int b = a + 1;
        while (b < m) { if (cnt[idx[b]] > cnt[idx[best]]) { best = b; } b = b + 1; }
        int t = idx[a]; idx[a] = idx[best]; idx[best] = t;
        a = a + 1;
    }
    string[] picked = new string[m];
    int oc = 0;
    int p = 0;
    while (p < m) {
        if ((p % n) == (k - 1)) { picked[oc] = all[idx[p]]; oc = oc + 1; }
        p = p + 1;
    }
    string[] sized = new string[oc];
    i = 0;
    while (i < oc) { sized[i] = picked[i]; i = i + 1; }
    return sized;
}

int _testLib(ParseResult r, string kind) {
    Stopwatch sw = _procStart((kind == "bench") ? "bench stdlib" : "test stdlib");
    string lib = r.GetPositional(0);
    string[] libs;
    int[] sh = _parseShard(r.GetOption("shard"));
    if (sh[1] > 0) {
        libs = _shardLibs(_root(), sh[0], sh[1]);
        Console.WriteLine("→ shard " + sh[0].ToString() + "/" + sh[1].ToString()
            + ": " + libs.Length.ToString() + " libs");
    } else if (lib.Length > 0) {
        libs = new string[1]; libs[0] = lib;
    } else {
        libs = new string[0];
    }
    // add-stdlib-bench-baseline: `bench stdlib --json <out>` → capture aggregated
    // bench_stats into a schema-v1 baseline file (median_ns primary metric). Only
    // for bench; test path passes null (unchanged pretty behaviour).
    string jsonOut = (kind == "bench") ? r.GetOption("json") : "";
    MicroBenchAgg agg = (jsonOut.Length > 0) ? new MicroBenchAgg() : null;
    // extend-ab-bench-micro-criterion Part B: optional explicit toolchain override
    // (micro A/B base capture points these at the pre-built base toolchain).
    int __rc = _testLibCore(kind, libs, r.GetFlag("no-build"), r.GetOption("filter"), r.GetOption("jobs"), r.GetOption("mode"), agg,
                            r.GetOption("vm"), r.GetOption("driver"), r.GetOption("libs"));
    if (agg != null) {
        string outPath = _absUnder(_root(), jsonOut);
        File.WriteAllText(outPath, agg.toSchemaV2(_root()));
        Console.WriteLine("wrote baseline -> " + jsonOut + " (" + agg.count().ToString() + " benchmarks)");
    }
    if (__rc == 0) { _procEnd((kind == "bench") ? "bench stdlib" : "test stdlib", sw); }
    return __rc;
}

int _testLibCore(string kind, string[] reqLibsIn, bool noBuild, string filter, string jobs, string mode, MicroBenchAgg agg,
                 string ovVm, string ovDriver, string ovLibs) {
    // kind = "test" → discover <lib>/tests/, merge [tests.dependencies], emit
    // <lib>.test.<unit> to <lib>/release/tests/. "bench" → <lib>/bench/,
    // [bench.dependencies], <lib>.bench.<unit> to <lib>/release/bench/. The
    // z42b runs both [Test] and [Benchmark] regardless.
    //
    // extend-ab-bench-micro-criterion Part B: ovVm/ovDriver/ovLibs (empty = derive
    // from in-tree). When all set, use that PROVIDED toolchain (a pre-built base
    // toolchain — vm + z42c.driver.zpkg + flat libs dir) instead of `_builtVm` /
    // `_driverZpkg` / `_assembleAllLibs`, and skip the in-tree rebuild. The micro
    // A/B base capture points these at the same `.ab-base-alllibs` the e2e A/B uses,
    // so base benchmarks compile+run against a proven-consistent base stdlib.
    string subdir = (kind == "bench") ? "bench" : "tests";
    string label  = (kind == "bench") ? "bench" : "test";
    if (jobs.Length == 0) { jobs = "1"; }   // forwarded to z42b
    string[] reqLibs = reqLibsIn;
    int nReq = reqLibsIn.Length;
    string root = _root();
    bool useOverride = ovVm.Length > 0 && ovDriver.Length > 0 && ovLibs.Length > 0;
    if (!noBuild && !useOverride) {
        Console.WriteLine("→ Preparing tooling (stdlib + z42vm; release)...");
        int c = _buildStdlib(); if (c != 0) { return c; }
        c = _buildRuntime(); if (c != 0) { return c; }
        // _buildStdlib already self-builds z42c (→ _buildCompilerViaZ42c:
        // 7 z42c.* members + self-contained driver); test
        // units compile through that z42c (z42vm + z42c.driver.zpkg). A trailing
        // _buildCompiler would be a redundant byte-identical gen2 self-build; the
        // _buildRuntime above already refreshes the release z42vm for format skew.
    }
    // add-tests-bench-manifest-config §6 (2026-06-07): test artifacts persist
    // under each lib's output_dir in a parallel `tests/` subtree
    // (<lib>/<profile>/tests/{dist,cache}/) instead of a throwaway temp dir, so
    // they're inspectable, incrementally cached, and visible to the CI
    // release-guard. _compileTestUnit derives the path from root + lib.
    // compile toolchain: z42vm + z42c.driver.zpkg + a single flat
    // Z42_LIBS dir. z42c.driver runs as a packed zpkg whose OWN siblings
    // (z42c.project / z42c.semantics / …) must be resolvable at runtime, AND
    // the stdlib the test units depend on must live in the SAME dir (the VM
    // takes one dir, not a colon-list). Mirror _testCompilerUnits' alllibs
    // flat: link the stdlib dist + the 7 z42c members into one dir. Computed
    // once; threaded through _runUnitsBatched → _compilePrep so every unit
    // compiles via z42c, not `dotnet z42c.dll`.
    string vm = useOverride ? ovVm : _builtVm(root, "release");
    string driverZpkg = useOverride ? ovDriver : _driverZpkg(root);
    string libs = useOverride ? ovLibs : _assembleAllLibs(root, "release");
    // retire-test-runner: the reflective runner is z42b (z42.builder.zpkg), run
    // via z42vm — replaces the deleted Rust z42-test-runner. z42b loads each
    // compiled test/bench artifact (Std.Test.ModuleLoader) and runs its
    // [Test]/[Benchmark] free functions by reflection (Std.Test.Runner.RunModule),
    // exiting 0 (all passed) / 1 (any failure). Its deps (z42.test/.project/.build
    // + core) resolve from `libs`, same flat dir the test units compile against.
    // Build z42b unconditionally (even under --no-build): it's a z42c incremental
    // compile of a few small files — near-no-op when current — and it guarantees
    // the runner exists AND its zpkg format matches the current z42c (the format-
    // skew guard the old cargo test-runner build couldn't give). Its deps resolve
    // from `libs` (the same flat dir the test units compile against).
    string builderZpkg = _toolchainZpkg(root, _z42bToml());
    Console.WriteLine("→ Building z42b (z42.builder.zpkg; reflective test runner)...");
    int bcRC = _buildZ42bWith(root, vm, driverZpkg, libs);
    if (bcRC != 0) { return bcRC; }
    string libsRoot = Path.Join(root, "src/libraries");
    string[] libList;
    if (nReq > 0) {
        libList = new string[nReq];
        int k = 0;
        while (k < nReq) { libList[k] = reqLibs[k]; k = k + 1; }
    } else {
        // add-tests-bench-manifest-config Phase 3.3 (2026-06-06): sort
        // Directory.Enumerate output so first-wins downstream behaviour is
        // platform-stable (common-pitfalls.md §1 — macOS APFS vs Linux ext4
        // give different orderings; CI on Linux blew up here before).
        libList = _sortedStrings(Directory.Enumerate(libsRoot));
    }
    int totalFailed = 0;
    int totalFiles = 0;
    int libsTested = 0;
    // parallelize-and-jit-stdlib-tests A: `jobs` now means unit-level batch
    // width (how many units compile+run concurrently), not the runner's
    // within-unit --jobs. Default 1 = serial. `test all` passes 4.
    int jobsN = 1;
    try { jobsN = int.Parse(jobs); } catch (Exception e) { jobsN = 1; }
    if (jobsN < 1) { jobsN = 1; }
    // mode forwarded to z42b: "" / "interp" → in-process interp;
    // "jit" → runner forces subprocess fork of z42vm --mode jit.
    if (mode.Length == 0) { mode = "interp"; }
    // add-tests-bench-manifest-config P2: discovery is now manifest-aware. Each
    // lib's [tests]/[benches] section (Auto → convention scan, byte-identical to
    // the legacy path for the many libs declaring no section) + explicit
    // [[test]]/[[bench]] targets (harness=true → z42b reflection; harness=false →
    // exit-code) drive _runLibKind (xtask_manifest_targets.z42). 3-layer dev-deps
    // (target > section > project) via ManifestLoader replace the raw-toml harvest.
    foreach (var lib in libList) {
        int f = _runLibKind(root, libsRoot, lib, subdir, kind, label, filter,
                            builderZpkg, jobsN, mode, vm, driverZpkg, libs, agg,
                            ref totalFiles, ref libsTested);
        if (f < 0) { return 2; }
        totalFailed = totalFailed + f;
    }
    Console.WriteLine("");
    Console.WriteLine("════════════════════════════════════════════════");
    if (totalFailed > 0) {
        Console.WriteLine("  ❌ stdlib " + label + ": " + totalFailed.ToString()
            + " file(s) failed (of " + totalFiles.ToString() + " in " + libsTested.ToString() + " lib(s))");
        return 1;
    }
    Console.WriteLine("  ✅ stdlib " + label + ": all " + totalFiles.ToString()
        + " file(s) passed (in " + libsTested.ToString() + " lib(s))");
    return 0;
}

// ── add-tests-bench-manifest-config Phase 3 helpers ─────────────────────────
//
// Phase 3 enables BOTH single-file tests (tests/foo.z42) and dir-mode tests
// (tests/<name>/source.z42 + optional sibling files). Single-file goes
// through the legacy z42c emit-zbc path (cheap; no manifest); dir-mode
// synthesises a tiny mini-manifest and calls `z42c build` so the
// compiler's regular project pipeline handles the multi-file package.
//
// Synthetic manifest content per dir-mode unit:
//   [project] name = "<lib>.test.<unit>"  kind = "exe"  version = "0.1.0"
//   [sources] include = ["<absolute>/<unit>/**/*.z42"]
//   [dependencies] = parent.[dependencies] ∪ parent.[tests.dependencies]
//   [build] output_dir = "<work>/<lib>/<unit>"  (Phase 3.1.4 forced isolation)
// The merged deps make z42.test resolvable after Phase 4 moves it from
// [dependencies] to [tests.dependencies]: this xtask reads BOTH sections so
// the migration is safe regardless of which section a parent puts a dep in.

