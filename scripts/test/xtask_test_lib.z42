// xtask — `test stdlib|bench [lib]`：stdlib（与编译器域库）的 [Test] / [Benchmark] 跑测器。
// 备工具链后逐包转发 z42b（发现 / 编译 / 运行都在 z42b；单元级并行见 xtask_test_lib_units.z42），
// 汇总结果；`--shard k/n` 按单元数均衡分包。
namespace Z42Xtask;

using Std.IO;
using Std.Time;
using Std.Collections;

// 包的源码根 —— **两个 workspace 都要认**：用户 stdlib（`Std.*`）在 `src/libraries/`；编译器域库
// 在 `src/compiler/`。🔴 只扫 `src/libraries/` 会让编译器域库的扁平 `tests/*.z42` 单元静默停跑——
// `xtask test compiler` 只认 `tests/<unit>/*.z42.toml` 目录单元，接不住它们。
string _libSrcRoot(string root, string lib) {
    string a = Path.Join(root, "src/libraries");
    if (Directory.Exists(Path.Join(a, lib))) { return a; }
    return Path.Join(root, "src/compiler");
}

// 一个包的 `tests/` 是不是**编译器格式**（`tests/<unit>/*.z42.toml` 独立工程）—— 那种归
// `xtask test compiler` 跑，本跑测器必须让开。
//
// 🔴 **判据刻意是「有没有 *.z42.toml」而不是「找到几个单元」**：
//   · 不能指望「找到 0 个就自然跳过」—— 清单感知的发现会去编**包本体**，然后报
//     `no [Test] or [Benchmark] found`，算失败；
//   · 也不能「单元数为 0 就排除」—— 有源却零约定单元的包必须继续被枚举，孤儿源守卫打的那行
//     ⚠ 是有意保留的欠债信号，滤掉就等于悄悄消音。
bool _isCompilerFormatTests(string root, string lib) {
    string td = Path.Join(Path.Join(root, "src/compiler"), Path.Join(lib, "tests"));
    if (!Directory.Exists(td)) { return false; }
    foreach (var e in Directory.Enumerate(td)) {
        string unitDir = Path.Join(td, e);
        if (!Directory.Exists(unitDir)) { continue; }
        if (Path.Glob(unitDir, "*.z42.toml").Length > 0) { return true; }
    }
    return false;
}

// 参与 stdlib 跑测器的包 = 两个 workspace 的目录并集（排序稳定），减去编译器格式测试的那些。
string[] _allTestableLibs(string root) {
    List<string> r = new List<string>();
    r.AddRange(_sortedStrings(Directory.Enumerate(Path.Join(root, "src/libraries"))));
    foreach (var b in _sortedStrings(Directory.Enumerate(Path.Join(root, "src/compiler")))) {
        if (!_isCompilerFormatTests(root, b)) { r.Add(b); }
    }
    return r.ToArray();
}

// Count a lib's [Test] units (single-file tests/*.z42 + dir-mode tests/<name>/
// source.z42) — drives shard load balancing.
int _libUnitCount(string root, string lib) {
    string td = Path.Join(Path.Join(_libSrcRoot(root, lib), lib), "tests");
    if (!Directory.Exists(td)) { return 0; }
    int c = Path.Glob(td, "*.z42").Length;
    foreach (var e in Path.Glob(td, "*")) {
        if (File.Exists(Path.Join(e, "source.z42"))) { c = c + 1; }
    }
    return c;
}

// Libs assigned to shard k of n, balanced by [Test] unit count: sort libs by
// count desc, then round-robin sorted positions across shards (longest-first
// keeps the heavy libs in distinct shards → even load).
string[] _shardLibs(string root, int k, int n) {
    string[] all = _allTestableLibs(root);   // 两个 workspace 并集（见 _libSrcRoot 头注）
    int m = all.Length;
    int[] cnt = new int[m];
    int[] idx = new int[m];
    int i = 0;
    while (i < m) { cnt[i] = _libUnitCount(root, all[i]); idx[i] = i; i = i + 1; }
    int a = 0;
    while (a < m) {
        int best = a;
        int b = a + 1;
        while (b < m) { if (cnt[idx[b]] > cnt[idx[best]]) { best = b; } b = b + 1; }
        int t = idx[a]; idx[a] = idx[best]; idx[best] = t;
        a = a + 1;
    }
    List<string> picked = new List<string>();
    for (int p = k - 1; p < m; p = p + n) { picked.Add(all[idx[p]]); }
    return picked.ToArray();
}

int _testLib(LibUnitsCommand c, string kind, string jsonOut) {
    Stopwatch sw = _procStart((kind == "bench") ? "bench stdlib" : "test stdlib");
    string lib = c.Lib;
    string[] libs;
    int[] sh = _parseShard(c.Shard);
    if (sh[1] > 0) {
        libs = _shardLibs(_root(), sh[0], sh[1]);
        Console.WriteLine("→ shard " + sh[0].ToString() + "/" + sh[1].ToString()
            + ": " + libs.Length.ToString() + " libs");
    } else if (lib.Length > 0) {
        libs = new string[] { lib };
    } else {
        libs = new string[0];
    }
    // `bench stdlib --json <out>` → capture aggregated bench_stats into a baseline file
    // (median_ns primary metric). Only for bench; the test path passes "".
    MicroBenchAgg agg = (jsonOut.Length > 0) ? new MicroBenchAgg() : null;
    // --vm/--driver/--libs: optional explicit toolchain override (see _testLibCore).
    int __rc = _testLibCore(kind, libs, c.NoBuild, c.Filter, c.Jobs, c.Mode, agg, c.Vm, c.Driver, c.Libs);
    if (agg != null) {
        string outPath = _absUnder(_root(), jsonOut);
        Directory.Create(Path.GetDirectoryName(outPath));   // 结果目录（reports/benches）可能还不存在
        File.WriteAllText(outPath, agg.toSchemaV2(_root()));
        Console.WriteLine("wrote baseline -> " + jsonOut + " (" + agg.count().ToString() + " benchmarks)");
    }
    if (__rc == 0) { _procEnd((kind == "bench") ? "bench stdlib" : "test stdlib", sw); }
    return __rc;
}

int _testLibCore(string kind, string[] reqLibsIn, bool noBuild, string filter, string jobs, string mode, MicroBenchAgg agg,
                 string ovVm, string ovDriver, string ovLibs) {
    // kind = "test" → discover <lib>/tests/, merge [tests.dependencies], emit
    // <lib>.test.<unit> to <lib>/release/tests/. "bench" → <lib>/benches/,
    // [bench.dependencies], <lib>.bench.<unit> to <lib>/release/benches/. The
    // z42b runs both [Test] and [Benchmark] regardless.
    //
    // ovVm/ovDriver/ovLibs (empty = derive from in-tree): when all set, use that PROVIDED
    // toolchain (vm + z42c.driver.zpkg + flat libs dir) and skip the in-tree rebuild — the
    // micro A/B base capture (bench-pr.yml) points these at the base toolchain the e2e A/B uses.
    string root = _root();
    // 包序必须排序（_allTestableLibs）：Directory.Enumerate 的顺序随文件系统而变，下游 first-wins
    // 行为要平台稳定。
    string[] libList = reqLibsIn.Length > 0 ? reqLibsIn : _allTestableLibs(root);
    List<string> dirs = new List<string>();
    foreach (var l in libList) { dirs.Add(Path.Join(_libSrcRoot(root, l), l)); }
    return _testPkgsCore(kind, "stdlib", dirs.ToArray(), libList, noBuild, filter, jobs, mode, agg, ovVm, ovDriver, ovLibs);
}

// 共用的 [Test] / [Benchmark] 跑测器：给定一组包（目录 + 包名，清单 = <dir>/<name>.z42.toml），先备工具链
// （z42vm + stdlib + z42b），再逐包转发给 z42b。`suite` 只用于汇总行（stdlib / toolchain）。
int _testPkgsCore(string kind, string suite, string[] dirs, string[] names, bool noBuild, string filter,
                  string jobs, string mode, MicroBenchAgg agg, string ovVm, string ovDriver, string ovLibs) {
    string label  = (kind == "bench") ? "bench" : "test";
    if (jobs.Length == 0) { jobs = "1"; }   // forwarded to z42b
    string root = _root();
    bool useOverride = ovVm.Length > 0 && ovDriver.Length > 0 && ovLibs.Length > 0;
    if (!noBuild && !useOverride) {
        Console.WriteLine("→ Preparing tooling (z42vm + stdlib; release)...");
        // ⚠ z42vm FIRST — stdlib is self-built BY z42vm, so a VM older than
        // src/runtime/ blows up the very first stage with an error that points
        // nowhere near the cause (a builtin added in this tree but missing from
        // the stale VM surfaces as `unknown builtin __x` →
        // `z42c --workspace self-build failed`). _buildStdlib's own VM guard is
        // build-if-MISSING, so it cannot catch staleness; cargo is the only thing
        // that knows whether the runtime sources changed, and it is a ~0.2s no-op
        // when they did not.
        int c = _buildRuntime(); if (c != 0) { return c; }
        c = _buildStdlib(); if (c != 0) { return c; }
        // _buildStdlib already self-builds z42c (_buildCompilerViaZ42c); test units
        // compile through that z42c. A trailing _buildCompiler would be a redundant
        // byte-identical gen2 self-build.
    }
    // compile toolchain: z42vm + z42c.driver.zpkg + Z42_LIBS = 纯 stdlib flat。driver 的 dist
    // 自包含；编译器域的测试库（_allTestableLibs）按名声明的编译器包由 driver 从编译器目录解析；z42b 运行期
    // 加载编译器包经 `_z42bProc`（z42b 启动点统一挂）。override（--vm/--driver/--libs，bench A/B 的
    // base 侧）照旧用调用方给的目录。
    string vm = useOverride ? ovVm : _builtVm(root, "release");
    string driverZpkg = useOverride ? ovDriver : _driverZpkg(root, "release");
    string libs = useOverride ? ovLibs : _libsDir(root);
    // The reflective runner is z42b (z42.builder.zpkg) on z42vm: it discovers [Test]/[Benchmark]
    // functions by runtime reflection and exits 0 (all passed) / 1 (any failure). Its deps resolve
    // from `libs`, the same flat dir the test units compile against.
    // Build z42b unconditionally (even under --no-build): an incremental compile, near-no-op when
    // current, and it guarantees the runner exists AND its zpkg format matches the current z42c.
    string builderZpkg = _toolchainZpkg(root, _z42bToml());
    Console.WriteLine("→ Building z42b (z42.builder.zpkg; reflective test runner)...");
    int bcRC = _buildZ42bWith(root, vm, driverZpkg, libs);
    if (bcRC != 0) { return bcRC; }
    int totalFailed = 0;
    int totalFiles = 0;
    int libsTested = 0;
    // `jobs` = unit-level batch width (how many units compile+run concurrently).
    // Default 1 = serial.
    int jobsN = 1;
    try { jobsN = int.Parse(jobs); } catch (Exception e) { jobsN = 1; }
    if (jobsN < 1) { jobsN = 1; }
    // mode forwarded to z42b: "" / "interp" → in-process interp;
    // "jit" → runner forces subprocess fork of z42vm --mode jit.
    if (mode.Length == 0) { mode = "interp"; }
    // Per lib: _runLibKind (xtask_manifest_targets.z42) lints the manifest's explicit targets, then
    // forwards to z42b (discovery: [tests]/[benches] section + explicit [[test]]/[[bench]]).
    int pi = 0;
    while (pi < dirs.Length) {
        int f = _runLibKind(root, dirs[pi], names[pi], kind, label, filter,
                            builderZpkg, jobsN, mode, vm, driverZpkg, libs, agg,
                            ref totalFiles, ref libsTested);
        if (f < 0) { return 2; }
        totalFailed = totalFailed + f;
        pi = pi + 1;
    }
    Console.WriteLine("");
    Console.WriteLine("════════════════════════════════════════════════");
    // 孤儿源守卫（「tests/ 有 .z42 源、却没产出任何单元」= 假绿）住在 z42b 里（_dtOrphanSourceDir），
    // 转发时逐 lib 生效 —— 判据只该有一处。
    if (totalFailed > 0) {
        Console.WriteLine("  ❌ " + suite + " " + label + ": " + totalFailed.ToString()
            + " file(s) failed (of " + totalFiles.ToString() + " in " + libsTested.ToString() + " lib(s))");
        return 1;
    }
    Console.WriteLine("  ✅ " + suite + " " + label + ": all " + totalFiles.ToString()
        + " file(s) passed (in " + libsTested.ToString() + " lib(s))");
    return 0;
}
