// xtask — `test toolchain builder` / `bench targets` impl（_testTargetsCore）：manifest-target
// fixture runner. Runs the end-to-end fixtures under
// src/toolchain/builder/tests/fixtures/manifest-targets/<name>/ — each a real project whose z42.toml
// declares `[[test]]`/`[[bench]]`/`[[example]]` targets — through the SAME
// path the stdlib per-lib flow uses (**转发 z42b**). This is where harness=false
// (exit-code) targets, explicit-target overlay, 3-layer dev-deps and named selection
// get exercised (stdlib libs declare no explicit targets, so they only exercise the
// convention path); plus the z42b behaviour smokes (`_smoke*`) over fixtures/z42b.
//
// Tooling prep mirrors _testLibCore (release build-tree). The example gate
// (xtask_test_example.z42) reuses _prepFixtureTooling.
namespace Z42Xtask;

using Std.IO;
using Z42.Project;

// Resolved toolchain for a manifest-target run (release build-tree paths).
class TargetTooling {
    public string Vm { get; set; }
    public string DriverZpkg { get; set; }
    public string Libs { get; set; }         // stdlib flat（Z42_LIBS）
    public string BuilderZpkg { get; set; }  // z42b reflective runner
    // 夹具在 build/ 镜像的**拷贝**上跑（z42b 把目标 / 父包产物写在
    // 清单目录旁，直接跑源码树里的夹具就会在 src/tests 下留产物）。两棵树各拷一次，整个 run 共用
    // —— 不能每个 smoke 各自重置：reuse-parent 等用例要看前面用例留下的父包产物。
    public string FixturesRoot { get; set; }      // src/toolchain/builder/tests/fixtures/manifest-targets 的拷贝
    public string Z42bFixturesRoot { get; set; }  // src/toolchain/builder/tests/fixtures/z42b 的拷贝
    public bool   Ok { get; set; }
}

// Root dir holding the e2e manifest-target fixtures.
string _fixturesRoot(string root) { return Path.Join(root, "src/toolchain/builder/tests/fixtures/manifest-targets"); }

// 一次 `z42b <verb> …` 的进程：reflective runner + `--mode`，cwd = 仓库根；调用方续接目标与自己的 flag，再
// `_exec` 或 `.Stdout(Pipe()).Run()`。
Process _z42bVerb(string root, TargetTooling tt, string verb) {
    return _z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg(verb).WorkingDirectory(root);
}

// smoke 开场：夹具不在 ⇒ false（夹具可选，调用方 return 0）；在 ⇒ 打 banner。
bool _smokeBegin(string toml, string title) {
    if (!File.Exists(toml)) { return false; }
    Console.WriteLine("");
    Console.WriteLine("── " + title + " ──");
    return true;
}

// True when the release build-tree stdlib exists (z42.core.zpkg present). The
// noBuild gate stages need it (same assumption as the stdlib stage); when absent
// (e.g. a CI leg that offloaded stdlib / consumes a --toolchain elsewhere) the
// stage skips cleanly rather than failing the z42b build.
bool _releaseStdlibReady(string root) {
    return File.Exists(Path.Join(_libsDir(root), "z42.core.zpkg"));
}

// Build (unless noBuild) + resolve the release toolchain, then build z42b so
// harness=true targets can run. Mirrors _testLibCore's prep so the two flows use
// identical z42c / stdlib / z42b artifacts.
TargetTooling _prepFixtureTooling(string root, bool noBuild) {
    TargetTooling t = new TargetTooling();
    t.Ok = false;
    if (!noBuild) {
        Console.WriteLine("→ Preparing tooling (z42vm + stdlib; release)...");
        int c = _buildRuntime(); if (c != 0) { return t; }   // ⚠ VM first — see _testLibCore
        c = _buildStdlib();      if (c != 0) { return t; }
    }
    t.Vm = _builtVm(root, "release");
    t.DriverZpkg = _driverZpkg(root, "release");
    t.Libs = _libsDir(root);
    t.BuilderZpkg = _toolchainZpkg(root, _z42bToml());
    Console.WriteLine("→ Building z42b (z42.builder.zpkg; reflective test runner)...");
    if (_buildZ42bWith(root, t.Vm, t.DriverZpkg, t.Libs) != 0) { return t; }
    t.Ok = true;
    return t;
}

// `xtask test toolchain builder [name]` / `xtask bench targets [name]` core. kind =
// "test" | "bench". name = "" → run every matching target in every fixture;
// otherwise only the target(s) whose name == name (across fixtures); a name that
// matches nothing → error listing the available names, non-zero exit.
int _testTargetsCore(string kind, string name, bool noBuild) {
    string root = _root();
    string fixRoot = _fixturesRoot(root);
    if (!Directory.Exists(fixRoot)) {
        Console.WriteLine("(no manifest-target fixtures)");
        return 0;
    }
    if (noBuild && !_releaseStdlibReady(root)) {
        Console.WriteLine("(skip manifest targets: release stdlib not built on this leg)");
        return 0;
    }
    TargetTooling tt = _prepFixtureTooling(root, noBuild);
    if (!tt.Ok) { return 2; }
    tt.FixturesRoot = _stageFixtureTree(root, "src/toolchain/builder/tests/fixtures/manifest-targets");
    tt.Z42bFixturesRoot = Directory.Exists(Path.Join(root, "src/toolchain/builder/tests/fixtures/z42b"))
        ? _stageFixtureTree(root, "src/toolchain/builder/tests/fixtures/z42b") : "";
    fixRoot = tt.FixturesRoot;
    string label  = (kind == "bench") ? "bench" : "test";
    int failed = 0;
    int[] mref = new int[] { 0 };   // matched
    string avail = "";
    foreach (var fx in _sortedStrings(Directory.Enumerate(fixRoot))) {
        string projDir = Path.Join(fixRoot, fx);
        string toml = _findToml(projDir);
        if (toml.Length == 0 || !Directory.Exists(projDir)) { continue; }
        failed = failed + _runFixtureKind(root, fx, toml, kind, label, name, tt, mref, ref avail);
    }
    int matched = mref[0];
    if (name.Length > 0 && matched == 0) {
        ConsoleError.WriteLine("error: no " + label + " target named '" + name + "'");
        if (avail.Length > 0) { ConsoleError.WriteLine("  available: " + avail); }
        return 2;
    }
    // z42b behaviour smokes — only on the full (unnamed) `test` run, so bench /
    // named-target runs don't duplicate them.
    if (kind == "test" && name.Length == 0) {
        failed = failed + _smokeCompileThenTest(root, tt);
        failed = failed + _smokeFallbackOutRoot(root, tt);
        failed = failed + _smokeDevTargetInternal(root, tt);
        failed = failed + _smokeReuseParentMissing(root, tt);
        failed = failed + _smokeOrphanGuard(root, tt);
        failed = failed + _smokeNoTests(root, tt);
        failed = failed + _smokeListTargets(root, tt);
        failed = failed + _smokeHarnessFalse(root, tt);
        failed = failed + _smokeBundleHost(root, tt);
        failed = failed + _smokeGoldenBundleHost(root, tt);
        failed = failed + _selfcheckBundleCompileFailure(root);
        failed = failed + _selfcheckGateStages();
        failed = failed + _selfcheckDiagCodes(root);
        failed = failed + _smokeCompileFailClean(root, tt);
        failed = failed + _smokeManifestSections(root, tt);
        failed = failed + _smokeBuildHooksMode(root, tt);
        failed = failed + _smokeHookPlugin(root, tt);
        failed = failed + _smokeHookSingleFile(root, tt);
        failed = failed + _smokeHookDir(root, tt);
        failed = failed + _smokeHookInclude(root, tt);
        failed = failed + _smokeHookPluginBroken(root, tt);
        failed = failed + _smokeHookCarry(root, tt);
        failed = failed + _smokeWorkspaceDefault(root, tt);
    }
    Console.WriteLine("");
    if (failed > 0) {
        Console.WriteLine("  ❌ manifest-target " + label + ": " + failed.ToString() + " failure(s)");
        return 1;
    }
    Console.WriteLine("  ✅ manifest-target " + label + ": all passed (" + matched.ToString() + " target(s))");
    return 0;
}

// compile-then-test smoke: build + run the compile-then-test fixture through the
// single `z42b test <z42.toml>` entry — the project-manifest → _buildProject →
// Runner.RunModule path (distinct from the already-compiled-artifact path the
// stdlib/compiler stages cover). Returns 0 pass / 1 fail; skips cleanly (0) when
// the fixture is absent.
int _smokeCompileThenTest(string root, TargetTooling tt) {
    string toml = Path.Join(tt.FixturesRoot, "compile-then-test/z42.toml");
    if (!_smokeBegin(toml, "compile-then-test (z42b test <z42.toml>)")) { return 0; }
    int rc = _exec(_z42bVerb(root, tt, "test").Arg(toml));
    if (rc != 0) {
        Console.WriteLine("  ❌ compile-then-test: `z42b test <toml>` exited " + rc.ToString());
        return 1;
    }
    Console.WriteLine("  ✅ compile-then-test: `z42b test <toml>` passed");
    return 0;
}

// 零目标回落也认 `--out-root`：compile-then-test 夹具没声明任何 [[test]]、源里自带 [Test] ⇒ 走
// `_buildProject` 回落；out-root 必须对这条路同样生效，否则产物写回清单目录旁（夹具在源码树里就写进源码树）。
// 断言三条：① 通过；② 清单目录旁**没有** artifacts/ 与 dist/；③ out-root 下**有**建出的 zpkg（证明产物去了那儿，
// 而不是压根没写 —— 没有 ③ 的话 ② 在「什么都没建」时也成立）。
int _smokeFallbackOutRoot(string root, TargetTooling tt) {
    string toml = Path.Join(tt.FixturesRoot, "compile-then-test/z42.toml");
    if (!_smokeBegin(toml, "fallback --out-root (零目标回落：产物落 --out-root，不落清单目录旁)")) { return 0; }
    string projDir = Path.GetDirectoryName(toml);
    string[] beside = new string[] { Path.Join(projDir, "artifacts"), Path.Join(projDir, "dist") };
    // 上一个 smoke（不带 --out-root）在拷贝旁留下的产物先清掉，否则 ② 判不出来。
    foreach (var d in beside) { if (Directory.Exists(d)) { Directory.Delete(d, true); } }
    string outRoot = _workOut(root, "src/toolchain/builder", "z42b-fallback-out-root");
    if (Directory.Exists(outRoot)) { Directory.Delete(outRoot, true); }
    int rc = _exec(_z42bVerb(root, tt, "test").Arg(toml).Arg("--out-root").Arg(outRoot));
    if (rc != 0) {
        Console.WriteLine("  ❌ fallback --out-root: `z42b test <toml> --out-root` exited " + rc.ToString());
        return 1;
    }
    foreach (var d in beside) {
        if (Directory.Exists(d)) {
            Console.WriteLine("  ❌ fallback --out-root: 清单目录旁仍然出现了 " + d + " —— 回落路径无视了 --out-root");
            return 1;
        }
    }
    if (!Directory.Exists(outRoot) || Path.GlobRecursive(outRoot, "compile-then-test.zpkg").Length == 0) {
        Console.WriteLine("  ❌ fallback --out-root: " + outRoot + " 下没有 compile-then-test.zpkg —— 产物去哪了？");
        return 1;
    }
    Console.WriteLine("  ✅ fallback --out-root: 产物落在 --out-root 下，清单目录旁零写入");
    return 0;
}

// dev-target internal smoke: 驱动 `z42b test <toml>` **按 [[test]] 目标编译 + 运行**，锁住两条性质：
//   ① 目标**只编自己声明的源**（把整个工程编进每个目标会让 ② 的断言假阳性，因为父包源被一起编了）；
//   ② 目标**看得见父包的 internal**（类与成员两条判定路径都覆盖）。
// 回归方向（普通消费包仍被拒）由 cross-zpkg/class_internal_access 守着。
int _smokeDevTargetInternal(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "dev-target-internal/z42.toml");
    if (!_smokeBegin(toml, "dev-target internal (z42b test <toml>：按目标编译 + 可见父包 internal)")) { return 0; }
    // 负例：先在两个目标的 dist 里放一份**损坏的**父包同置副本，模拟上一轮留下的过期拷贝。z42b 若
    // 「已存在就不拷」，运行期会加载到这份垃圾 ⇒ 本 smoke 判红；正确行为是每次覆盖成刚建好的父包。
    // 只在全新树上跑的话过期副本永远不出现，这个 bug 就永远是绿的。
    string targetsRoot = Path.Join(Path.GetDirectoryName(toml), "artifacts/test-targets");
    foreach (var t in new string[] { "internals_tests", "dirunit" }) {
        string distDir = Path.Join(Path.Join(targetsRoot, t), "dist");
        Directory.Create(distDir);
        File.WriteAllText(Path.Join(distDir, "dt.internal.zpkg"), "STALE-COLOCATED-PARENT-COPY");
    }
    int rc = _exec(_z42bVerb(root, tt, "test").Arg(toml));
    if (rc != 0) {
        Console.WriteLine("  ❌ dev-target internal: `z42b test <toml>` exited " + rc.ToString());
        return 1;
    }
    Console.WriteLine("  ✅ dev-target internal: 目标按源隔离编译，且可见父包 internal（预置的过期同置副本已被覆盖）");
    return 0;
}

// `--reuse-parent` smoke：xtask 每个库先跑一个单元把父包建好，其余单元带
// `--reuse-parent` 并行复用。这里锁住它的安全边：**父包 dist 不在时必须照常建**，而不是把一个不存在
// 的目录当成父包交给编译器（那样目标编译会解析不到父包 internal ⇒ 判红，或更糟地悄悄用上旧产物）。
// 先整个删掉 fixture 的父包产物，再带 flag 只跑 dirunit（它要看父包 internal）。
int _smokeReuseParentMissing(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "dev-target-internal/z42.toml");
    if (!_smokeBegin(toml, "reuse-parent (父包 dist 不在时 --reuse-parent 仍须先建父包)")) { return 0; }
    // 父包 dist 的位置取 z42.project 的 `BuildLayout`（z42b `_computeDirs` 用的同一份答案），不写死。
    // xtask 调 z42b 不带 --release ⇒ debug。
    string parentOut = BuildLayout.Resolve(ManifestLoader.Load(toml), Path.GetDirectoryName(toml), false).DistDir;
    if (Directory.Exists(parentOut)) { Directory.Delete(parentOut, true); }
    int rc = _exec(_z42bVerb(root, tt, "test").Arg(toml).Arg("--name").Arg("dirunit").Arg("--reuse-parent"));
    if (rc != 0) {
        Console.WriteLine("  ❌ reuse-parent: 父包 dist 缺失时带 --reuse-parent 失败（rc=" + rc.ToString() + "）—— 复用把缺件当成了成功");
        return 1;
    }
    Console.WriteLine("  ✅ reuse-parent: 父包 dist 缺失时照常先建父包，目标通过");
    return 0;
}

// 编译失败的**收尾姿势** smoke。守的不是「会不会红」—— 它一直会红；守的是**红得干净**：编译失败
// 必须以一条人话报错退出，不是抛未捕获异常——否则用户拿到的是带 z42b 内部栈帧的崩溃，看起来像
// z42b 自己崩了，而「你的清单写错了」上一行早已打印过。
//
// 三条断言缺一不可：① 判红（否则清单写错等于没写错）；② 输出里**没有** uncaught
// exception / 栈帧；③ 输出里**有** `compile failed` —— 没有 ③ 的话，哪天它因为别的原因
// 早早退出，②也会「通过」，门就悄悄失去意义——红了不等于红对了。
int _smokeCompileFailClean(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "empty-glob/z42.toml");
    if (!_smokeBegin(toml, "compile-fail 收尾 (编译失败须干净退出，不得是未捕获异常)")) { return 0; }
    ProcessResult r = _z42bRunPiped(root, tt, "test", toml, "");
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode == 0) {
        Console.WriteLine("  ❌ compile-fail 收尾: 清单 include 一个文件都不匹配，竟然返回 0");
        return 1;
    }
    if (all.IndexOf("uncaught exception") >= 0) {
        Console.WriteLine("  ❌ compile-fail 收尾: 以未捕获异常收场 —— 看起来像 z42b 崩了，而不是「你的清单写错了」");
        return 1;
    }
    if (all.IndexOf("compile failed") < 0) {
        Console.WriteLine("  ❌ compile-fail 收尾: 判红了，但输出里没有 `compile failed` —— 红的理由对不上，门已失去意义");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ compile-fail 收尾: 干净判红（rc=" + r.ExitCode.ToString() + "），无未捕获异常");
    return 0;
}

// 清单段生效 smoke：z42b 的编译按**整份清单**决策。**预期判红**：fixture 设
// `[syntax] ternary = false`，测试目标里用了 `?:` ⇒ 必须报 E0301。z42b 若只传平铺字段、静默忽略
// 清单的 [syntax] / [optimize] / [lints] / [plugins]，这里会跑出绿色。
// 断言两条：① 判红；② 红的理由是 E0301（不是别的原因早早退出——红了不等于红对了）。
int _smokeManifestSections(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "manifest-sections/z42.toml");   // 跑拷贝，源码树零写入
    if (!_smokeBegin(toml, "manifest sections (z42b 按整份清单编译：[syntax] 生效且被测试目标继承)")) { return 0; }
    ProcessResult r = _z42bRunPiped(root, tt, "test", toml, "");
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode == 0) {
        Console.WriteLine("  ❌ manifest sections: `[syntax] ternary = false` 下 `?:` 竟然编过 —— 清单段被 z42b 忽略");
        return 1;
    }
    if (all.IndexOf("E0301") < 0) {
        Console.WriteLine("  ❌ manifest sections: 判红了，但不是 E0301 —— 红的理由对不上");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ manifest sections: [syntax] 经 z42b 生效并被测试目标继承（E0301，rc=" + r.ExitCode.ToString() + "）");
    return 0;
}

// build hooks smoke：`[build] hooks` 目录经开发树的 ICompiler 编译 → 动态实例化 → 挂进管线执行，并断言
// hook 收到的 Target.Mode：普通 `z42b publish` 传 `publish`，`--self-contained` 传
// `publish-self-contained`。项目 hook 靠这个值决定要不要准备 embed 产物（scripts/xtask_hooks.z42：embed apphost
// 要把整个 VM 编成 libz42.a，普通 publish 一个字节都用不到）。两条路各断言一次，传反、传同值都会红。
// 只看 hook 打出的那一行，不看退出码：fixture 不登记 stub / embed 产物，普通 publish 回落到假模板、
// self-contained 报「embed apphost not available」，都与本格无关。Z42_EMBED_* 显式置空，免得外部环境让
// self-contained 跳过 hook。
int _smokeBuildHooksMode(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "build-hooks/z42.toml");
    if (!_smokeBegin(toml, "build hooks mode (publish / publish --self-contained 传给 hook 的 Target.Mode)")) { return 0; }
    string[] flags = new string[] { "", "--self-contained" };
    string[] want  = new string[] { "(mode=publish)", "(mode=publish-self-contained)" };
    int i = 0;
    while (i < flags.Length) {
        Process p = _z42bVerb(root, tt, "publish").Arg(toml).Arg("--rid").Arg(_detectHostRid());
        if (flags[i].Length > 0) { p = p.Arg(flags[i]); }
        ProcessResult r = p.Env("Z42_APPHOST_TEMPLATE", tt.Vm)
            .Env("Z42_EMBED_APPHOST", "").Env("Z42_EMBED_LIBS", "").Env("Z42_EMBED_DYLIB", "")
            .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
        string all = r.Stdout + r.Stderr;
        if (all.IndexOf("BUILD-HOOKS-SMOKE: BeforeAssets ran " + want[i]) < 0) {
            Console.WriteLine("  ❌ build hooks mode: `z42b publish " + flags[i] + "` 传给 hook 的不是 " + want[i]);
            Console.WriteLine("    输出: " + all);
            return 1;
        }
        i = i + 1;
    }
    Console.WriteLine("  ✅ build hooks mode: publish → publish；--self-contained → publish-self-contained");
    return 0;
}

// hook 插件 smoke：`[plugins]` 里两个带 hook 能力位的插件工程（path 条目）→
// z42b 反射出 BuildHooks 具体类、按声明序组合执行。断言两行标记都在**且 A 在 B 前**——只查「都在」会把
// 组合顺序错乱判绿；只查先后（IndexOf 比大小）不查存在会把「都打了但漏断言」漏掉。
int _smokeHookPlugin(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "hook-plugin/z42.toml");
    if (!_smokeBegin(toml, "hook plugin ([plugins] 插件加载进 z42b、按声明序执行)")) { return 0; }
    ProcessResult r = _z42bRunPiped(root, tt, "build", toml, "");
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode != 0) {
        Console.WriteLine("  ❌ hook plugin: `z42b build` exited " + r.ExitCode.ToString());
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    int ia = all.IndexOf("HOOK-PLUGIN-SMOKE: A BeforeCompile");
    int ib = all.IndexOf("HOOK-PLUGIN-SMOKE: B BeforeCompile");
    if (ia < 0 || ib < 0) {
        Console.WriteLine("  ❌ hook plugin: 两个插件的标记行没有都出现（ia=" + ia.ToString() + ", ib=" + ib.ToString() + "）");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    if (ia >= ib) {
        Console.WriteLine("  ❌ hook plugin: 声明序是 A 在前，输出里 B 先于 A —— 组合顺序错乱");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ hook plugin: 两个插件按声明序加载并执行");
    return 0;
}

// 单文件 hook 插件 smoke：`[plugins]` 条目 path 直接指向 .z42 源文件（无插件工程
// 清单）⇒ z42b 合成最小插件清单（PluginSynth.Synth）→ ICompiler 代建 → 反射出 BuildHooks 执行。
// 断言标记行出现——这一条覆盖「合成 + 代建 + 加载 + 执行」全链；清单解析与组合顺序由 hook-plugin 钉。
int _smokeHookSingleFile(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "hook-single-file/z42.toml");
    if (!_smokeBegin(toml, "hook single-file plugin ([plugins] 单文件条目 → 合成清单代建)")) { return 0; }
    ProcessResult r = _z42bRunPiped(root, tt, "build", toml, "");
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode != 0) {
        Console.WriteLine("  ❌ hook single-file plugin: `z42b build` exited " + r.ExitCode.ToString());
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    if (all.IndexOf("HOOK-SINGLE-FILE-SMOKE: BeforeCompile") < 0) {
        Console.WriteLine("  ❌ hook single-file plugin: 单文件插件的标记行没有出现（合成/代建/加载断了？）");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ hook single-file plugin: 单文件条目合成清单、代建并执行");
    return 0;
}

// 免清单目录 hook 插件 smoke：`[plugins]` 条目 path 指向**没有工程清单**的
// 目录 ⇒ z42b 合成（include = <目录>/**/*.z42 全收）→ 代建 → 反射出包内全部 BuildHooks。两个类分住
// 两个文件——**两条**标记都在才判绿（漏收任何一个文件即缺一条）。
int _smokeHookDir(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "hook-dir-no-manifest/z42.toml");
    if (!_smokeBegin(toml, "hook dir plugin ([plugins] 免清单目录条目 → 全收代建)")) { return 0; }
    ProcessResult r = _z42bRunPiped(root, tt, "build", toml, "");
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode != 0) {
        Console.WriteLine("  ❌ hook dir plugin: `z42b build` exited " + r.ExitCode.ToString());
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    int ia = all.IndexOf("HOOK-DIR-SMOKE: A BeforeCompile");
    int ib = all.IndexOf("HOOK-DIR-SMOKE: B BeforeCompile");
    if (ia < 0 || ib < 0) {
        Console.WriteLine("  ❌ hook dir plugin: 两个文件的标记行没有都出现（目录全收漏文件？ia="
            + ia.ToString() + ", ib=" + ib.ToString() + "）");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ hook dir plugin: 免清单目录全收、两个 hook 类都执行");
    return 0;
}

// 源集 hook 插件 smoke：`[plugins]` 条目写 include/exclude（对齐 [tests]）
// ⇒ z42b 合成最小清单（PluginSynth.SynthSet）→ ICompiler 代建 → 反射出全部 BuildHooks。
// 两个类分住两文件——**两条**标记都在才判绿（漏收任何一个文件即缺一条）。
int _smokeHookInclude(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "hook-include/z42.toml");
    if (!_smokeBegin(toml, "hook include plugin ([plugins] 源集条目 include/exclude → 合成清单代建)")) { return 0; }
    ProcessResult r = _z42bRunPiped(root, tt, "build", toml, "");
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode != 0) {
        Console.WriteLine("  ❌ hook include plugin: `z42b build` exited " + r.ExitCode.ToString());
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    int ia = all.IndexOf("HOOK-INCLUDE-SMOKE: A BeforeCompile");
    int ib = all.IndexOf("HOOK-INCLUDE-SMOKE: B BeforeCompile");
    if (ia < 0 || ib < 0) {
        Console.WriteLine("  ❌ hook include plugin: 两个文件的标记行没有都出现（源集漏文件？ia="
            + ia.ToString() + ", ib=" + ib.ToString() + "）");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ hook include plugin: 源集 include 全收、两个 hook 类都执行");
    return 0;
}

// 携带 hook smoke：app 零 [plugins]，依赖的 lib 经 [plugins.export] 携带
// hook 插件 ⇒ z42b 沿闭包自动加载执行。先编插件产物（放它的 dist），再以 Z42_PLUGINS 指向 dist 编 app。
int _smokeHookCarry(string root, TargetTooling tt) {
    string dir = Path.Join(tt.Z42bFixturesRoot, "hook-carry");
    string toml = Path.Join(dir, "z42.toml");
    if (!_smokeBegin(toml, "hook carry (lib 携带的 hook 插件自动执行，app 零配置)")) { return 0; }
    // ① 编 hook 插件（dist = <fixture>/lib/hooks/dist）
    int rc1 = _exec(_z42bVerb(root, tt, "build").Arg(Path.Join(dir, "lib/hooks/z42.z42.toml")));
    if (rc1 != 0) {
        Console.WriteLine("  ❌ hook carry: hook 插件工程编不过（rc=" + rc1.ToString() + "）");
        return 1;
    }
    // ② 编 app：Z42_PLUGINS 指向插件 dist，携带自动生效
    Process p2 = _z42bVerb(root, tt, "build").Arg(toml)
        .Env("Z42_PLUGINS", Path.Join(dir, "lib/hooks/dist"));
    ProcessResult r = p2.Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode != 0) {
        Console.WriteLine("  ❌ hook carry: `z42b build` exited " + r.ExitCode.ToString());
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    if (all.IndexOf("HOOK-CARRY-SMOKE: carried BeforeCompile ran") < 0) {
        Console.WriteLine("  ❌ hook carry: 构建成功但携带 hook 没执行（闭包解析或加载断了？）");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ hook carry: lib 携带的 hook 在 app 构建里自动执行");
    return 0;
}

// 坏 hook 插件 smoke：[plugins] 指向的插件工程编译不过 ⇒ `z42b build` 非 0 退出。代建失败若降级成
// 「跳过该插件」，构建会静默缺 hook 照样退 0——publish 产物悄悄少东西。
int _smokeHookPluginBroken(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "hook-plugin-broken/z42.toml");
    if (!_smokeBegin(toml, "broken hook plugin (插件编不过 ⇒ z42b build 判红)")) { return 0; }
    ProcessResult r = _z42bRunPiped(root, tt, "build", toml, "");
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode == 0) {
        Console.WriteLine("  ❌ broken hook plugin: 插件编译失败仍退 0 —— 降级成「无 hook」了");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    if (all.IndexOf("HOOK-PLUGIN-SMOKE") >= 0) {
        Console.WriteLine("  ❌ broken hook plugin: 判红了但坏插件的标记行竟出现（挂错夹具？）");
        return 1;
    }
    Console.WriteLine("  ✅ broken hook plugin: 判红（rc=" + r.ExitCode.ToString() + "）");
    return 0;
}

// 孤儿源守卫 smoke：**预期判红**的 fixture —— tests/ 下有 .z42 源，但默认 glob 不认领，
// 且该子目录没有自己的 toml（有的话它就是独立工程）。守卫不在的话 z42b 会回落到「编译本包
// 自己再跑」，而该 fixture 的 src/ 里**特意放了一个通过的 [Test]** —— 于是回落会跑出
// 「1 passed」的绿色。这个 fixture 锁的就是那片静默。断言方向与其它 smoke 相反：rc == 0 才是失败。
int _smokeOrphanGuard(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "orphan-source/z42.toml");
    if (!_smokeBegin(toml, "orphan-source guard (有源零单元必须判红)")) { return 0; }
    int rc = _exec(_z42bVerb(root, tt, "test").Arg(toml));
    if (rc == 0) {
        Console.WriteLine("  ❌ orphan-source guard: 有源却零单元竟然返回 0 —— 守卫失效，「没跑」又一次等价于「全过」");
        return 1;
    }
    Console.WriteLine("  ✅ orphan-source guard: 有源零单元判红（rc=" + rc.ToString() + "）");
    return 0;
}

// 「本包压根没有测试」smoke：一个无 tests/、src/ 里零个 [Test] 的库，`z42b test` 必须
// **退 0**（无事可做），不得判红 —— 否则 xtask 转发后全仓无测试的库会集体变红。
// 与 compile-then-test 的区别只有「src/ 里有没有 [Test]」，那条
// smoke 正好守着反方向（有 [Test] → 照常编+跑）。
//
// `bench` 动词同样要退 0：GREEN gate 的 stdlib [Benchmark]
// stage 对无 bench 的库走的就是 `z42b bench <toml>`。fixture 的注释里故意写着 attribute 字面量，
// 锁住「注释不算测试」这条判据。
int _smokeNoTests(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "no-tests/z42.toml");
    if (!_smokeBegin(toml, "no-tests (没有测试的库不得判红)")) { return 0; }
    foreach (var verb in new string[] { "test", "bench" }) {
        int rc = _exec(_z42bVerb(root, tt, verb).Arg(toml));
        if (rc != 0) {
            Console.WriteLine("  ❌ no-tests: `z42b " + verb + "` 把无测试的库判红（rc=" + rc.ToString() + "）—— 转发后会拖红整条 stage");
            return 1;
        }
        Console.WriteLine("  ✅ no-tests: `z42b " + verb + "` 无测试的库退 0（无事可做）");
    }
    return 0;
}

// `--list` smoke：列目标名而不编不跑。这是**转发架构的接缝** —— xtask 靠它拿单元清单后
// 并行拉起 `z42b test <toml> --name <unit>`，发现规则只有 z42b 一份。断言：dev-target fixture 恰好列出 dirunit + internals_tests，
// 且**没有**任何编译/运行的痕迹。
int _smokeListTargets(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "dev-target-internal/z42.toml");
    if (!_smokeBegin(toml, "list targets (z42b test --list：只列不跑)")) { return 0; }
    ProcessResult rr = _z42bVerb(root, tt, "test").Arg(toml).Arg("--list").Run();
    if (rr.ExitCode != 0) {
        Console.WriteLine("  ❌ list targets: rc=" + rr.ExitCode.ToString());
        return 1;
    }
    string outp = rr.Stdout.Trim();
    if (outp != "dirunit\ninternals_tests") {
        Console.WriteLine("  ❌ list targets: 期望 `dirunit` + `internals_tests`，实得: " + outp);
        return 1;
    }
    if (rr.Stdout.Contains("compiled:") || rr.Stdout.Contains("PASS")) {
        Console.WriteLine("  ❌ list targets: --list 不该编译或运行任何东西");
        return 1;
    }
    Console.WriteLine("  ✅ list targets: 2 个目标名，未编译未运行");
    return 0;
}

// harness=false smoke：z42b 直接跑「自带 Main、退出码即判定」的目标。
//
// 必须 fork 子进程而非 in-process：这类目标的 Main 通常自己调 `Environment.Exit(code)`，
// in-process 会把 z42b 一并带走、后面的目标全不跑。本条守着那个分叉真的走了子进程。
//
// 顺带覆盖「纯测试工程」形态：该 fixture 整个包只有 [[test]] 目标、**没有自己的源**，
// 所以 z42b 必须跳过父包构建（无条件建会撞「no .z42 sources under <projdir>」）。
int _smokeHarnessFalse(string root, TargetTooling tt) {
    string toml = Path.Join(tt.FixturesRoot, "basic/z42.toml");
    if (!_smokeBegin(toml, "harness=false (z42b 直接跑自驱 Main，退出码判定)")) { return 0; }
    int rc = _exec(_z42bVerb(root, tt, "test").Arg(toml).Arg("--name").Arg("exit_ok"));
    if (rc != 0) {
        Console.WriteLine("  ❌ harness=false: `z42b test --name exit_ok` exited " + rc.ToString());
        return 1;
    }
    Console.WriteLine("  ✅ harness=false: 自驱 Main 经子进程跑通，退出码判定生效");
    return 0;
}

// bundle-host smoke: compile a trivial [Test] unit →
// .zbc, wrap it in a 1-case manifest, and run it through the single
// `z42b test <manifest.json> --rid host` entry — exercising the in-process
// Std.Harness.BundleRunner path (the host half of the embedded flow xtask delegates
// to z42b), which the default gate would otherwise not cover (`test app desktop` is a
// separate stage). Returns 0 pass / 1 fail; skips cleanly (0) if the fixture is absent.
int _smokeBundleHost(string root, TargetTooling tt) {
    string src = Path.Join(tt.FixturesRoot, "bundle-host/pass_unit.z42");
    if (!File.Exists(src)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── bundle-host (z42b test <manifest.json> --rid host) ──");
    string outDir = Path.Join(_workOut(root, "src/toolchain/workload/test", ""), "smoke-bundle-host");
    Directory.Create(outDir);
    string zbc = Path.Join(outDir, "pass_unit.zbc");
    int ec = _exec(_z42cProc(tt.Vm, tt.Libs, tt.DriverZpkg).Arg("--emit-zbc").Arg(src).Arg(zbc).WorkingDirectory(root));
    if (ec != 0) { Console.WriteLine("  ❌ bundle-host: compile fixture failed"); return 1; }
    string manifest = Path.Join(outDir, "manifest.json");
    File.WriteAllText(manifest, "{\"cases\":[{\"name\":\"bundle_host_smoke\",\"zbc\":\"pass_unit.zbc\"}]}\n");
    int rc = _exec(_z42bVerb(root, tt, "test").Arg(manifest).Arg("--rid").Arg("host").Arg("--format").Arg("json"));
    if (rc != 0) {
        Console.WriteLine("  ❌ bundle-host: `z42b test <manifest> --rid host` exited " + rc.ToString());
        return 1;
    }
    Console.WriteLine("  ✅ bundle-host: `z42b test <manifest> --rid host` passed");
    return 0;
}

// 单例 golden 也须经 bundle 编译与隔离执行，stdout 不符必须使宿主失败。
int _smokeGoldenBundleHost(string root, TargetTooling tt) {
    string dir = Path.Join(_workOut(root, "src/toolchain/workload/test", ""), "smoke-golden-host");
    Directory.Create(dir);
    File.WriteAllText(Path.Join(dir, "source.z42"),
        "namespace GoldenBundleSmoke;\nusing Std.IO;\nvoid Main() { Console.WriteLine(\"golden bundle\"); }\n");
    string expected = Path.Join(dir, "expected_output.txt");
    File.WriteAllText(expected, "golden bundle\n");
    string manifest = _buildGoldenBundle(root, dir);
    if (manifest.Length == 0) { return 1; }
    int rc = _exec(_z42bVerb(root, tt, "test").Arg(manifest).Arg("--rid").Arg("host"));
    if (rc != 0) { ConsoleError.WriteLine("  ❌ golden bundle: matching stdout failed"); return 1; }
    File.WriteAllText(expected, "wrong output\n");
    manifest = _buildGoldenBundle(root, dir);
    if (manifest.Length == 0) { return 1; }
    ProcessResult mismatch = _z42bVerb(root, tt, "test").Arg(manifest).Arg("--rid").Arg("host").Run();
    if (mismatch.ExitCode == 0) {
        ConsoleError.WriteLine("  ❌ golden bundle: mismatched stdout passed"); return 1;
    }
    Console.WriteLine("  ✅ golden bundle: matching stdout passes, mismatched stdout fails");
    return 0;
}

// 跑一个 fixture 的 `kind` 目标 —— 与 stdlib 那条路一样，**一律转发 z42b**（`--name` 对约定单元、
// harness=true / false 三种形态是同一个入口）。把本 fixture 的目标名追加进 `avail`（点不中时的提示），
// 命中数加到 mref[0]，返回失败数。filter 语义：name=="" → 全跑；否则精确名。
int _runFixtureKind(string root, string fixName, string toml,
                    string kind, string label, string name,
                    TargetTooling tt, int[] mref, ref string avail) {
    ProjectManifest man = _loadManifestOr(toml);
    RunTarget[] tgts = _explicitTargets(man, kind);
    string verr = _validateRunTargets(tgts, tgts.Length, kind);
    if (verr.Length > 0) { ConsoleError.WriteLine("error: " + fixName + ": " + verr); return 1; }
    // 发现交给 z42b：`--list` 一次拿全（约定单元 + 显式目标，两种 harness 都在内）。
    bool ok = true;
    string[] all = _listUnitsViaZ42b(root, toml, kind, "", "interp", tt.Vm, tt.BuilderZpkg, tt.Libs, ref ok);
    if (!ok) { return 1; }
    foreach (var u in all) { avail = _appendName(avail, u); }
    string[] sel = all;   // 精确名筛选（0 或 1 个）
    if (name.Length > 0) { sel = _strIn(all, name) ? new string[] { name } : new string[0]; }
    if (sel.Length == 0) { return 0; }
    mref[0] = mref[0] + sel.Length;
    Console.WriteLine("");
    Console.WriteLine("── " + fixName + " (" + sel.Length.ToString() + " " + label + ") ──");
    // jobs=1：fixture 数量小，串行输出更好读（stdlib 那条才需要并行）。
    return _runUnitsViaZ42b(root, toml, sel, sel.Length, kind,
                            1, "interp", tt.Vm, tt.BuilderZpkg, tt.Libs, fixName, null);
}

// Append a target name to a comma-space list (for the not-found hint), deduped.
string _appendName(string acc, string name) {
    if (acc.Length == 0) { return name; }
    if (acc.Contains(name)) { return acc; }
    return acc + ", " + name;
}
