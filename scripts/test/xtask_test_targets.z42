// xtask — `test targets` / `bench targets` impl（_testTargetsCore）：manifest-target
// fixture runner (add-tests-bench-manifest-config P4).
// Same Z42Xtask namespace. Runs the end-to-end fixtures under
// src/tests/manifest-targets/<name>/ — each a real project whose z42.toml
// declares `[[test]]`/`[[bench]]`/`[[example]]` targets — through the SAME
// path the stdlib per-lib flow uses: **转发 z42b**（D2 起两条路合一）。This is
// where harness=false (exit-code) targets, explicit-target overlay, 3-layer
// dev-deps and named selection get exercised in a dedicated gate (existing stdlib
// libs declare no explicit targets, so they only exercise the convention path).
//
// Tooling prep mirrors _testLibCore (release build-tree): stdlib + runtime +
// self-built z42c + z42b, assembled into one flat Z42_LIBS. `xtask example` and
// the example gate (xtask_test_example.z42) reuse _prepFixtureTooling here.
namespace Z42Xtask;

using Std.IO;
using Z42.Project;

// Resolved toolchain for a manifest-target run (release build-tree paths).
// Auto-properties (+ implicit default ctor) so `new TargetTooling()` works, per
// the DepBundle pattern in this codebase.
class TargetTooling {
    public string Vm { get; set; }
    public string DriverZpkg { get; set; }
    public string Libs { get; set; }         // stdlib flat（Z42_LIBS）
    public string BuilderZpkg { get; set; }  // z42b reflective runner
    // isolate-xtask-fixture-builds：夹具在 artifacts/tmp 的**拷贝**上跑（z42b 把目标 / 父包产物写在
    // 清单目录旁，直接跑源码树里的夹具就会在 src/tests 下留产物）。两棵树各拷一次，整个 run 共用
    // —— 不能每个 smoke 各自重置：reuse-parent 等用例要看前面用例留下的父包产物。
    public string FixturesRoot { get; set; }      // src/tests/manifest-targets 的拷贝
    public string Z42bFixturesRoot { get; set; }  // src/tests/z42b 的拷贝
    public bool   Ok { get; set; }
}

// Root dir holding the e2e manifest-target fixtures.
string _fixturesRoot(string root) { return Path.Join(root, "src/tests/manifest-targets"); }

// True when the release build-tree stdlib exists (z42.core.zpkg present). The
// noBuild gate stages need it (same assumption as the stdlib stage); when absent
// (e.g. a CI leg that offloaded stdlib / consumes a --toolchain elsewhere) the
// stage skips cleanly rather than failing the z42b build.
bool _releaseStdlibReady(string root) {
    return File.Exists(Path.Join(_libsDir(root), "z42.core.zpkg"));
}

// Build (unless noBuild) + resolve the release toolchain, then build z42b so
// harness=true targets can run. Mirrors _testLibCore's prep so the two flows use
// identical z42c / stdlib / z42b artifacts.
TargetTooling _prepFixtureTooling(string root, bool noBuild) {
    TargetTooling t = new TargetTooling();
    t.Ok = false;
    if (!noBuild) {
        Console.WriteLine("→ Preparing tooling (z42vm + stdlib; release)...");
        int c = _buildRuntime(); if (c != 0) { return t; }   // ⚠ VM first — see _testLibCore
        c = _buildStdlib();      if (c != 0) { return t; }
    }
    t.Vm = _builtVm(root, "release");
    t.DriverZpkg = _driverZpkg(root, "release");
    t.Libs = _libsDir(root);
    t.BuilderZpkg = _toolchainZpkg(root, _z42bToml());
    Console.WriteLine("→ Building z42b (z42.builder.zpkg; reflective test runner)...");
    if (_buildZ42bWith(root, t.Vm, t.DriverZpkg, t.Libs) != 0) { return t; }
    t.Ok = true;
    return t;
}

// `xtask test targets [name]` / `xtask bench targets [name]` core. kind =
// "test" | "bench". name = "" → run every matching target in every fixture;
// otherwise only the target(s) whose name == name (across fixtures); a name that
// matches nothing → error listing the available names, non-zero exit.
int _testTargetsCore(string kind, string name, bool noBuild) {
    string root = _root();
    string fixRoot = _fixturesRoot(root);
    if (!Directory.Exists(fixRoot)) {
        Console.WriteLine("(no manifest-target fixtures)");
        return 0;
    }
    if (noBuild && !_releaseStdlibReady(root)) {
        Console.WriteLine("(skip manifest targets: release stdlib not built on this leg)");
        return 0;
    }
    TargetTooling tt = _prepFixtureTooling(root, noBuild);
    if (!tt.Ok) { return 2; }
    tt.FixturesRoot = _stageFixtureTree(root, "src/tests/manifest-targets", "manifest-target-fixtures");
    tt.Z42bFixturesRoot = Directory.Exists(Path.Join(root, "src/tests/z42b"))
        ? _stageFixtureTree(root, "src/tests/z42b", "z42b-fixtures") : "";
    fixRoot = tt.FixturesRoot;
    string label  = (kind == "bench") ? "bench" : "test";
    string[] fixtures = _sortedStrings(Directory.Enumerate(fixRoot));
    int failed = 0;
    int matched = 0;
    string avail = "";
    int i = 0;
    while (i < fixtures.Length) {
        string projDir = Path.Join(fixRoot, fixtures[i]);
        string toml = _findToml(projDir);
        if (toml.Length == 0 || !Directory.Exists(projDir)) { i = i + 1; continue; }
        int[] mref = new int[1]; mref[0] = matched;
        failed = failed + _runFixtureKind(root, fixtures[i], toml, kind, label,
                                          name, tt, mref, ref avail);
        matched = mref[0];
        i = i + 1;
    }
    if (name.Length > 0 && matched == 0) {
        ConsoleError.WriteLine("error: no " + label + " target named '" + name + "'");
        if (avail.Length > 0) { ConsoleError.WriteLine("  available: " + avail); }
        return 2;
    }
    // compile-then-test smoke (add-z42b-compile-then-test): drive the whole
    // toml→build→[Test] path through the single `z42b test <toml>` entry once —
    // only on the full (unnamed) `test` run, so bench / named-target runs don't
    // duplicate it. Covers the new project-manifest path the artifact-driven
    // stdlib/compiler stages don't exercise.
    if (kind == "test" && name.Length == 0) {
        failed = failed + _smokeCompileThenTest(root, tt);
        failed = failed + _smokeFallbackOutRoot(root, tt);
        failed = failed + _smokeDevTargetInternal(root, tt);
        failed = failed + _smokeReuseParentMissing(root, tt);
        failed = failed + _smokeOrphanGuard(root, tt);
        failed = failed + _smokeNoTests(root, tt);
        failed = failed + _smokeListTargets(root, tt);
        failed = failed + _smokeHarnessFalse(root, tt);
        failed = failed + _smokeBundleHost(root, tt);
        failed = failed + _smokeCompileFailClean(root, tt);
        failed = failed + _smokeManifestSections(root, tt);
        failed = failed + _smokeBuildHooks(root, tt);
        failed = failed + _smokeBuildHooksBroken(root, tt);
        failed = failed + _smokeBuildHooksMode(root, tt);
    }
    Console.WriteLine("");
    if (failed > 0) {
        Console.WriteLine("  ❌ manifest-target " + label + ": " + failed.ToString() + " failure(s)");
        return 1;
    }
    Console.WriteLine("  ✅ manifest-target " + label + ": all passed (" + matched.ToString() + " target(s))");
    return 0;
}

// compile-then-test smoke: build + run the compile-then-test fixture through the
// single `z42b test <z42.toml>` entry (add-z42b-compile-then-test). Exercises the
// new project-manifest → _buildProject → Runner.RunModule path (distinct from the
// already-compiled-artifact path stdlib/compiler stages cover abundantly).
// Reuses the prepared tooling (built z42b + flat Z42_LIBS). Returns 0 pass /
// 1 fail; skips cleanly (0) when the fixture is absent.
int _smokeCompileThenTest(string root, TargetTooling tt) {
    string toml = Path.Join(tt.FixturesRoot, "compile-then-test/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── compile-then-test (z42b test <z42.toml>) ──");
    int rc = _exec(_z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml)
        .WorkingDirectory(root));
    if (rc != 0) {
        Console.WriteLine("  ❌ compile-then-test: `z42b test <toml>` exited " + rc.ToString());
        return 1;
    }
    Console.WriteLine("  ✅ compile-then-test: `z42b test <toml>` passed");
    return 0;
}

// 零目标回落也认 `--out-root`（fix-z42b-fallback-out-root）：compile-then-test 夹具没声明任何 [[test]]、源里自带
// [Test] ⇒ 走 `_buildProject` 回落。此前那条路从磁盘重新加载清单，`_runDevTargets` 套在内存里的 out-root 覆盖到不了
// ⇒ 产物照样写回 `<清单目录>/artifacts` + `<清单目录>/dist`（夹具若在源码树里，就是写进源码树）。
// 断言三条：① 通过；② 清单目录旁**没有** artifacts/ 与 dist/；③ out-root 下**有**建出的 zpkg（证明产物去了那儿，
// 而不是压根没写 —— 没有 ③ 的话 ② 在「什么都没建」时也成立）。
int _smokeFallbackOutRoot(string root, TargetTooling tt) {
    string toml = Path.Join(tt.FixturesRoot, "compile-then-test/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── fallback --out-root (零目标回落：产物落 --out-root，不落清单目录旁) ──");
    string projDir = Path.GetDirectoryName(toml);
    string[] beside = new string[] { Path.Join(projDir, "artifacts"), Path.Join(projDir, "dist") };
    int bi = 0;
    // 上一个 smoke（不带 --out-root）在拷贝旁留下的产物先清掉，否则 ② 判不出来。
    while (bi < beside.Length) { if (Directory.Exists(beside[bi])) { Directory.Delete(beside[bi], true); } bi = bi + 1; }
    string outRoot = _tmpDir(root, "z42b-fallback-out-root");
    if (Directory.Exists(outRoot)) { Directory.Delete(outRoot, true); }
    int rc = _exec(_z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml).Arg("--out-root").Arg(outRoot)
        .WorkingDirectory(root));
    if (rc != 0) {
        Console.WriteLine("  ❌ fallback --out-root: `z42b test <toml> --out-root` exited " + rc.ToString());
        return 1;
    }
    bi = 0;
    while (bi < beside.Length) {
        if (Directory.Exists(beside[bi])) {
            Console.WriteLine("  ❌ fallback --out-root: 清单目录旁仍然出现了 " + beside[bi] + " —— 回落路径无视了 --out-root");
            return 1;
        }
        bi = bi + 1;
    }
    if (!Directory.Exists(outRoot) || Path.GlobRecursive(outRoot, "compile-then-test.zpkg").Length == 0) {
        Console.WriteLine("  ❌ fallback --out-root: " + outRoot + " 下没有 compile-then-test.zpkg —— 产物去哪了？");
        return 1;
    }
    Console.WriteLine("  ✅ fallback --out-root: 产物落在 --out-root 下，清单目录旁零写入");
    return 0;
}

// dev-target internal smoke (z42b-owns-test-targets): 驱动 `z42b test <toml>` 走
// **按 [[test]] 目标编译 + 运行**的新路径，并锁住两条此前不成立的性质：
//   ① 目标**只编自己声明的源**（此前 in-process 路径把 include 硬编码成 `**/*.z42`，
//      会把整个工程编进每个目标 —— 那也会让 ① 的 internal 断言假阳性，因为父包源被一起编了）；
//   ② 目标**看得见父包的 internal**（类与成员两条判定路径都覆盖）。
// 回归方向（普通消费包仍被拒）由 cross-zpkg/class_internal_access 守着。
int _smokeDevTargetInternal(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "dev-target-internal/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── dev-target internal (z42b test <toml>：按目标编译 + 可见父包 internal) ──");
    // fix-devtarget-parent-copy-stale 的负例：先在两个目标的 dist 里放一份**损坏的**父包同置副本，
    // 模拟上一轮留下的过期拷贝。z42b 若沿用「已存在就不拷」，运行期会加载到这份垃圾、父包类型解析
    // 不到 ⇒ 本 smoke 判红；正确行为是每次覆盖成刚建好的父包。（此前这里只在全新树上跑，过期副本
    // 从未出现过 ⇒ 那个「不刷新」的 bug 在这道门下永远是绿的。）
    string[] targetNames = new string[] { "internals_tests", "dirunit" };
    string targetsRoot = Path.Join(Path.GetDirectoryName(toml), "artifacts/test-targets");
    int ti = 0;
    while (ti < targetNames.Length) {
        string distDir = Path.Join(Path.Join(targetsRoot, targetNames[ti]), "dist");
        Directory.Create(distDir);
        File.WriteAllText(Path.Join(distDir, "dt.internal.zpkg"), "STALE-COLOCATED-PARENT-COPY");
        ti = ti + 1;
    }
    int rc = _exec(_z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml)
        .WorkingDirectory(root));
    if (rc != 0) {
        Console.WriteLine("  ❌ dev-target internal: `z42b test <toml>` exited " + rc.ToString());
        return 1;
    }
    Console.WriteLine("  ✅ dev-target internal: 目标按源隔离编译，且可见父包 internal（预置的过期同置副本已被覆盖）");
    return 0;
}

// `--reuse-parent` smoke（perf-z42b-reuse-parent）：xtask 每个库先跑一个单元把父包建好，其余单元带
// `--reuse-parent` 并行复用。这里锁住它的安全边：**父包 dist 不在时必须照常建**，而不是把一个不存在
// 的目录当成父包交给编译器（那样目标编译会解析不到父包 internal ⇒ 判红，或更糟地悄悄用上旧产物）。
// 先整个删掉 fixture 的父包产物，再带 flag 只跑 dirunit（它要看父包 internal）。
int _smokeReuseParentMissing(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "dev-target-internal/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── reuse-parent (父包 dist 不在时 --reuse-parent 仍须先建父包) ──");
    // 父包 dist 的位置取 z42.project 的 `BuildLayout`（z42b `_computeDirs` 用的同一份答案，unify-build-layout），
    // 不再写死 z42b 的旧默认 `artifacts/<name>/<profile>`。xtask 调 z42b 不带 --release ⇒ debug。
    string parentOut = BuildLayout.Resolve(ManifestLoader.Load(toml), Path.GetDirectoryName(toml), false).DistDir;
    if (Directory.Exists(parentOut)) { Directory.Delete(parentOut, true); }
    int rc = _exec(_z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml).Arg("--name").Arg("dirunit").Arg("--reuse-parent")
        .WorkingDirectory(root));
    if (rc != 0) {
        Console.WriteLine("  ❌ reuse-parent: 父包 dist 缺失时带 --reuse-parent 失败（rc=" + rc.ToString() + "）—— 复用把缺件当成了成功");
        return 1;
    }
    Console.WriteLine("  ✅ reuse-parent: 父包 dist 缺失时照常先建父包，目标通过");
    return 0;
}

// 孤儿源守卫 smoke：**预期判红**的 fixture —— tests/ 下有 .z42 源，但默认 glob 不认领，
// 且该子目录没有自己的 toml（有的话它就是独立工程）。守卫不在的话 z42b 会回落到「编译本包
// 自己再跑」，而该 fixture 的 src/ 里**特意放了一个通过的 [Test]** —— 于是回落会跑出
// 「1 passed」的绿色，下游 #571 的零测试判红也接不住。这个 fixture 锁的就是那片静默。
//
// 断言方向与其它 smoke 相反：rc == 0 才是失败。
// 编译失败的**收尾姿势**：必须是一条干净的错误退出，不是未捕获异常。
//
// 守的不是「会不会红」—— 它一直会红。此前 `z42.build` 的 Compile 相位在编译失败时抛
// `Exception("compile failed")`，而 Run 的唯一调用方（z42b `_orchestrate`）直接
// `return p.Run(ctx)`、中间无人接 ⇒ 用户拿到的是一段带 z42b 内部栈帧的
// `Error: uncaught exception: Std.Exception: compile failed`，看起来像 z42b 自己崩了，
// 而「你的清单写错了」这句话上一行就已经打印过。**同 E0493 当年那条的形状。**
//
// 三条断言缺一不可：① 判红（否则清单写错等于没写错）；② 输出里**没有** uncaught
// exception / 栈帧；③ 输出里**有** `compile failed` —— 没有 ③ 的话，哪天它因为别的原因
// 早早退出，②也会「通过」，门就悄悄失去意义（#802 第③格的教训：红了不等于红对了）。
int _smokeCompileFailClean(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "empty-glob/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── compile-fail 收尾 (编译失败须干净退出，不得是未捕获异常) ──");
    ProcessResult r = _z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml)
        .WorkingDirectory(root)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode == 0) {
        Console.WriteLine("  ❌ compile-fail 收尾: 清单 include 一个文件都不匹配，竟然返回 0");
        return 1;
    }
    if (all.IndexOf("uncaught exception") >= 0) {
        Console.WriteLine("  ❌ compile-fail 收尾: 以未捕获异常收场 —— 看起来像 z42b 崩了，而不是「你的清单写错了」");
        return 1;
    }
    if (all.IndexOf("compile failed") < 0) {
        Console.WriteLine("  ❌ compile-fail 收尾: 判红了，但输出里没有 `compile failed` —— 红的理由对不上，门已失去意义");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ compile-fail 收尾: 干净判红（rc=" + r.ExitCode.ToString() + "），无未捕获异常");
    return 0;
}

// 清单段生效 smoke（add-build-session）：z42b 的编译按**整份清单**决策。**预期判红**：fixture 设
// `[syntax] ternary = false`，测试目标里用了 `?:` ⇒ 必须报 E0301。此前 z42b 只传平铺字段、清单的
// [syntax] / [optimize] / [lints] / [analyzers] 被静默忽略 ⇒ 这里会跑出绿色。
// 断言两条：① 判红；② 红的理由是 E0301（不是别的原因早早退出——红了不等于红对了）。
int _smokeManifestSections(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "manifest-sections/z42.toml");   // isolate-xtask-fixture-builds：跑拷贝，src/tests 零写入
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── manifest sections (z42b 按整份清单编译：[syntax] 生效且被测试目标继承) ──");
    ProcessResult r = _z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml)
        .WorkingDirectory(root)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode == 0) {
        Console.WriteLine("  ❌ manifest sections: `[syntax] ternary = false` 下 `?:` 竟然编过 —— 清单段被 z42b 忽略");
        return 1;
    }
    if (all.IndexOf("E0301") < 0) {
        Console.WriteLine("  ❌ manifest sections: 判红了，但不是 E0301 —— 红的理由对不上");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ manifest sections: [syntax] 经 z42b 生效并被测试目标继承（E0301，rc=" + r.ExitCode.ToString() + "）");
    return 0;
}

// build hooks smoke（drop-legacy-compile-request）：`[build] hooks` 目录经开发树的 ICompiler 编译 → 动态实例化 →
// 挂进管线执行。断言两条：① `z42b build` 成功；② 输出里有 hook 打的标记行（证明 hook 真的被编译、加载、调用，
// 而不是被静默跳过）。失败方向由 _smokeBuildHooksBroken 守。
int _smokeBuildHooks(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "build-hooks/z42.toml");   // isolate-xtask-fixture-builds：跑拷贝，src/tests 零写入
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── build hooks (z42b build：[build] hooks 经开发树编译器编译并执行) ──");
    ProcessResult r = _z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("build").Arg(toml)
        .WorkingDirectory(root)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string all = r.Stdout + r.Stderr;
    if (r.ExitCode != 0) {
        Console.WriteLine("  ❌ build hooks: `z42b build` exited " + r.ExitCode.ToString());
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    if (all.IndexOf("BUILD-HOOKS-SMOKE: BeforeAssets ran") < 0) {
        Console.WriteLine("  ❌ build hooks: 构建成功但 hook 没有执行（被静默跳过？）");
        Console.WriteLine("    输出: " + all);
        return 1;
    }
    Console.WriteLine("  ✅ build hooks: hook 目录按 lib 清单编译、加载并执行");
    return 0;
}

// broken hooks smoke（fail-build-on-hooks-error）：清单声明了 `[build] hooks`，hook 源却编译不过 ⇒ `z42b build`
// 与 `z42b publish` 都必须**非 0 退出**，且输出里有 hooks 的编译诊断。此前两条路都降级为「无 hook」照样退 0：
// build 少跑了 hook，publish 则悄悄改用 Z42_APPHOST_TEMPLATE —— 本 smoke 故意设上这个变量（值不是真 stub，回落后
// 会在部署阶段才失败），并断言没有走到部署那一行，锁住「不许回落」。
int _smokeBuildHooksBroken(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "build-hooks-broken/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── broken build hooks (hooks 编译失败 ⇒ build / publish 都判红) ──");
    string[] verbs = new string[] { "build", "publish" };
    int vi = 0;
    while (vi < verbs.Length) {
        Process p = _z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
            .Arg("--").Arg(verbs[vi]).Arg(toml);
        if (verbs[vi] == "publish") { p = p.Arg("--rid").Arg(_detectHostRid()).Env("Z42_APPHOST_TEMPLATE", tt.Vm); }
        ProcessResult r = p.WorkingDirectory(root)
            .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
        string all = r.Stdout + r.Stderr;
        if (r.ExitCode == 0) {
            Console.WriteLine("  ❌ broken build hooks: `z42b " + verbs[vi] + "` 在 hooks 编译失败时仍退 0 —— 又降级成了「无 hook」");
            Console.WriteLine("    输出: " + all);
            return 1;
        }
        if (all.IndexOf("hooks compile failed") < 0) {
            Console.WriteLine("  ❌ broken build hooks: `z42b " + verbs[vi] + "` 判红了，但不是因为 hooks 编译失败");
            Console.WriteLine("    输出: " + all);
            return 1;
        }
        if (all.IndexOf("z42 publish (") >= 0) {   // 判红了，但是先回落 Z42_APPHOST_TEMPLATE 部署、后来才失败
            Console.WriteLine("  ❌ broken build hooks: `z42b publish` hooks 失败后仍回落到 Z42_APPHOST_TEMPLATE 继续部署");
            Console.WriteLine("    输出: " + all);
            return 1;
        }
        Console.WriteLine("  ✅ broken build hooks: `z42b " + verbs[vi] + "` 判红（rc=" + r.ExitCode.ToString() + "）");
        vi = vi + 1;
    }
    return 0;
}

// hook 收到的 Target.Mode（hooks-embed-on-demand）：普通 `z42b publish` 传 `publish`，`--self-contained` 传
// `publish-self-contained`。项目 hook 靠这个值决定要不要准备 embed 产物（scripts/hooks/hooks.z42：embed apphost
// 要把整个 VM 编成 libz42.a，普通 publish 一个字节都用不到）。两条路各断言一次，传反、传同值都会红。
// 只看 hook 打出的那一行，不看退出码：fixture 不登记 stub / embed 产物，普通 publish 回落到假模板、
// self-contained 报「embed apphost not available」，都与本格无关。Z42_EMBED_* 显式置空，免得外部环境让
// self-contained 跳过 hook。
int _smokeBuildHooksMode(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "build-hooks/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── build hooks mode (publish / publish --self-contained 传给 hook 的 Target.Mode) ──");
    string[] flags = new string[] { "", "--self-contained" };
    string[] want  = new string[] { "(mode=publish)", "(mode=publish-self-contained)" };
    int i = 0;
    while (i < flags.Length) {
        Process p = _z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
            .Arg("--").Arg("publish").Arg(toml).Arg("--rid").Arg(_detectHostRid());
        if (flags[i].Length > 0) { p = p.Arg(flags[i]); }
        ProcessResult r = p.Env("Z42_APPHOST_TEMPLATE", tt.Vm)
            .Env("Z42_EMBED_APPHOST", "").Env("Z42_EMBED_LIBS", "").Env("Z42_EMBED_DYLIB", "")
            .WorkingDirectory(root).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
        string all = r.Stdout + r.Stderr;
        if (all.IndexOf("BUILD-HOOKS-SMOKE: BeforeAssets ran " + want[i]) < 0) {
            Console.WriteLine("  ❌ build hooks mode: `z42b publish " + flags[i] + "` 传给 hook 的不是 " + want[i]);
            Console.WriteLine("    输出: " + all);
            return 1;
        }
        i = i + 1;
    }
    Console.WriteLine("  ✅ build hooks mode: publish → publish；--self-contained → publish-self-contained");
    return 0;
}

int _smokeOrphanGuard(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "orphan-source/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── orphan-source guard (有源零单元必须判红) ──");
    int rc = _exec(_z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml)
        .WorkingDirectory(root));
    if (rc == 0) {
        Console.WriteLine("  ❌ orphan-source guard: 有源却零单元竟然返回 0 —— 守卫失效，「没跑」又一次等价于「全过」");
        return 1;
    }
    Console.WriteLine("  ✅ orphan-source guard: 有源零单元判红（rc=" + rc.ToString() + "）");
    return 0;
}

// 「本包压根没有测试」smoke：一个无 tests/、src/ 里零个 [Test] 的库，`z42b test` 必须
// **退 0**（无事可做），不得判红 —— 否则 xtask 转发后全仓无测试的库会集体变红，而今天
// 它们是被静默跳过的。与 compile-then-test 的区别只有「src/ 里有没有 [Test]」，那条
// smoke 正好守着反方向（有 [Test] → 照常编+跑）。
//
// `bench` 动词同样要退 0（fix-bench-stage-zero-unit-kind）：GREEN gate 的 stdlib [Benchmark]
// stage 对无 bench 的库走的就是 `z42b bench <toml>`。fixture 的注释里故意写着 attribute 字面量，
// 锁住「注释不算测试」这条判据。
int _smokeNoTests(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "no-tests/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── no-tests (没有测试的库不得判红) ──");
    string[] verbs = new string[] { "test", "bench" };
    int vi = 0;
    while (vi < verbs.Length) {
        int rc = _exec(_z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
            .Arg("--").Arg(verbs[vi]).Arg(toml)
            .WorkingDirectory(root));
        if (rc != 0) {
            Console.WriteLine("  ❌ no-tests: `z42b " + verbs[vi] + "` 把无测试的库判红（rc=" + rc.ToString() + "）—— 转发后会拖红整条 stage");
            return 1;
        }
        Console.WriteLine("  ✅ no-tests: `z42b " + verbs[vi] + "` 无测试的库退 0（无事可做）");
        vi = vi + 1;
    }
    return 0;
}

// `--list` smoke：列目标名而不编不跑。这是**转发架构的接缝** —— xtask 靠它拿单元清单后
// 并行拉起 `z42b test <toml> --name <unit>`，发现规则从此只有 z42b 一份（两套规则各自漂移
// 正是 #580 查出那三处分歧的来源）。断言：dev-target fixture 恰好列出 dirunit + internals_tests，
// 且**没有**任何编译/运行的痕迹。
int _smokeListTargets(string root, TargetTooling tt) {
    string toml = Path.Join(tt.Z42bFixturesRoot, "dev-target-internal/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── list targets (z42b test --list：只列不跑) ──");
    ProcessResult rr = _z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml).Arg("--list")
        .WorkingDirectory(root).Run();
    if (rr.ExitCode != 0) {
        Console.WriteLine("  ❌ list targets: rc=" + rr.ExitCode.ToString());
        return 1;
    }
    string outp = rr.Stdout.Trim();
    if (outp != "dirunit\ninternals_tests") {
        Console.WriteLine("  ❌ list targets: 期望 `dirunit` + `internals_tests`，实得: " + outp);
        return 1;
    }
    if (rr.Stdout.Contains("compiled:") || rr.Stdout.Contains("PASS")) {
        Console.WriteLine("  ❌ list targets: --list 不该编译或运行任何东西");
        return 1;
    }
    Console.WriteLine("  ✅ list targets: 2 个目标名，未编译未运行");
    return 0;
}

// harness=false smoke：z42b 直接跑「自带 Main、退出码即判定」的目标。
//
// 必须 fork 子进程而非 in-process：这类目标的 Main 通常自己调 `Environment.Exit(code)`，
// in-process 会把 z42b 一并带走、后面的目标全不跑。本条守着那个分叉真的走了子进程。
//
// 顺带覆盖「纯测试工程」形态：该 fixture 整个包只有 [[test]] 目标、**没有自己的源**，
// 所以 z42b 必须跳过父包构建（无条件建会撞「no .z42 sources under <projdir>」）。
int _smokeHarnessFalse(string root, TargetTooling tt) {
    string toml = Path.Join(tt.FixturesRoot, "basic/z42.toml");
    if (!File.Exists(toml)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── harness=false (z42b 直接跑自驱 Main，退出码判定) ──");
    int rc = _exec(_z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(toml).Arg("--name").Arg("exit_ok")
        .WorkingDirectory(root));
    if (rc != 0) {
        Console.WriteLine("  ❌ harness=false: `z42b test --name exit_ok` exited " + rc.ToString());
        return 1;
    }
    Console.WriteLine("  ✅ harness=false: 自驱 Main 经子进程跑通，退出码判定生效");
    return 0;
}

// bundle-host smoke (wire-z42b-embedded-test ②b): compile a trivial [Test] unit →
// .zbc, wrap it in a 1-case manifest, and run it through the single
// `z42b test <manifest.json> --rid host` entry — exercising the in-process
// Std.Test.BundleRunner path (the host half of the embedded flow xtask delegates
// to z42b), which the default gate would otherwise not cover (`test embedded` is a
// separate stage). Returns 0 pass / 1 fail; skips cleanly (0) if the fixture is absent.
int _smokeBundleHost(string root, TargetTooling tt) {
    string src = Path.Join(tt.FixturesRoot, "bundle-host/pass_unit.z42");
    if (!File.Exists(src)) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── bundle-host (z42b test <manifest.json> --rid host) ──");
    string outDir = Path.Join(_buildTestOutDir(root, "embedded-test"), "smoke-bundle-host");
    Directory.Create(outDir);
    string zbc = Path.Join(outDir, "pass_unit.zbc");
    int ec = _exec(_z42Proc(tt.Vm, tt.Libs).Arg(tt.DriverZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("--emit-zbc").Arg(src).Arg(zbc)
        .WorkingDirectory(root));
    if (ec != 0) { Console.WriteLine("  ❌ bundle-host: compile fixture failed"); return 1; }
    string manifest = Path.Join(outDir, "manifest.json");
    File.WriteAllText(manifest, "{\"cases\":[{\"name\":\"bundle_host_smoke\",\"zbc\":\"pass_unit.zbc\"}]}\n");
    int rc = _exec(_z42bProc(tt.Vm, tt.Libs).Arg(tt.BuilderZpkg).Arg("--mode").Arg(_z42cMode())
        .Arg("--").Arg("test").Arg(manifest).Arg("--rid").Arg("host").Arg("--format").Arg("json")
        .WorkingDirectory(root));
    if (rc != 0) {
        Console.WriteLine("  ❌ bundle-host: `z42b test <manifest> --rid host` exited " + rc.ToString());
        return 1;
    }
    Console.WriteLine("  ✅ bundle-host: `z42b test <manifest> --rid host` passed");
    return 0;
}

// 跑一个 fixture 的 `kind` 目标 —— 与 stdlib 那条路一样，**一律转发 z42b**
// （xtask-forward-tests-to-z42b D2）。把本 fixture 的目标名追加进 `avail`（点不中时的提示），
// 命中数加到 mref[0]，返回失败数。filter 语义：name=="" → 全跑；否则精确名。
//
// 这里曾是 xtask 自有执行器唯一还在用的地方：约定单元走合成 mini-manifest 批量编译
// （_runUnitsBatched）、显式 harness=true 走 _runReflectTarget、harness=false 走
// _runExitTargets。三条随 D2 一并退休 —— z42b 的 `--name` 对三种形态都是同一个入口
// （harness=false 由它 fork 子进程、退出码即判定，#612）。于是本 stage 从「测 xtask 的
// 引擎」变成「测 z42b 对这些 fixture 形态的处理」，与下面那批 _smoke* 同向。
int _runFixtureKind(string root, string fixName, string toml,
                    string kind, string label, string name,
                    TargetTooling tt, int[] mref, ref string avail) {
    ProjectManifest man = _loadManifestOr(toml);
    RunTarget[] tgts = _explicitTargets(man, kind);
    string verr = _validateRunTargets(tgts, tgts.Length, kind);
    if (verr.Length > 0) { ConsoleError.WriteLine("error: " + fixName + ": " + verr); return 1; }
    // 发现交给 z42b：`--list` 一次拿全（约定单元 + 显式目标，两种 harness 都在内）。
    bool ok = true;
    string[] all = _listUnitsViaZ42b(root, toml, kind, "", "interp", tt.Vm, tt.BuilderZpkg, tt.Libs, ref ok);
    if (!ok) { return 1; }
    int a = 0;
    while (a < all.Length) { avail = _appendName(avail, all[a]); a = a + 1; }
    string[] sel = (name.Length > 0) ? _namesEq(all, name) : all;
    if (sel.Length == 0) { return 0; }
    mref[0] = mref[0] + sel.Length;
    Console.WriteLine("");
    Console.WriteLine("── " + fixName + " (" + sel.Length.ToString() + " " + label + ") ──");
    // jobs=1：fixture 数量小，串行输出更好读（stdlib 那条才需要并行）。
    return _runUnitsViaZ42b(root, toml, sel, sel.Length, kind,
                            1, "interp", tt.Vm, tt.BuilderZpkg, tt.Libs, fixName, null);
}

// 精确名筛选（0 或 1 个）。
string[] _namesEq(string[] names, string name) {
    int i = 0;
    while (i < names.Length) {
        if (names[i] == name) { string[] r = new string[1]; r[0] = names[i]; return r; }
        i = i + 1;
    }
    return new string[0];
}

// Append a target name to a comma-space list (for the not-found hint), deduped.
string _appendName(string acc, string name) {
    if (acc.Length == 0) { return name; }
    if (acc.Contains(name)) { return acc; }
    return acc + ", " + name;
}
