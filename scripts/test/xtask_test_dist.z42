// xtask — packaged-distribution e2e (unify-scripts-into-xtask; folded from the
// former standalone scripts/test-dist.z42). Same Z42Xtask namespace.
//
// End-to-end test of the PACKAGED z42 distribution: compile each golden
// source.z42 with the packaged z42c, run the result with the packaged z42vm
// (no dotnet/cargo) in interp/jit, and diff stdout against expected_output.txt.
// Also launcher smokes: the beginner CLI path (xtask_test_dist_cli.z42) and `z42 run --bin/--set` / `repl`.
//
// Golden layout (same as test-vm):
//   src/tests/<cat>/<name>/source.z42         (dir mode) + expected_output.txt
//   src/libraries/<lib>/tests/<name>/source.z42
//   src/tests/<cat>/<name>.z42                (flat mode) + <name>.expected_output.txt
//
// Driven in-process by `_testDist` (xtask_test.z42). The package dir is the
// latest artifacts/packages/z42-*-release (or env DIST_DIR); the mode list is
// the optional `interp|jit` positional from argv (index 2; default "interp jit").
//
// Shared golden-walk / entry-derivation / string helpers (_enumDirsSorted,
// _sortStrings, _append, _isNonRunnableCat, _deriveEntry, _extractNamespace,
// _isWordEnd, _isIdentChar, _hasMain, _indexOfFrom, _firstLine, _splitWords,
// _stripTrailingNewlines) live ONCE in xtask_golden.z42 (same namespace) and are
// not redefined here. _latestReleasePkg lives in xtask_test.z42 next to
// _hasReleasePkg.
namespace Z42Xtask;

using Std;
using Std.IO;

// `test dist [interp|jit]` body — run in-process. Returns 0 on pass, 1 on any
// failure (compile error / mismatch / launcher-smoke fail / missing package).
// `modeArg` is the optional mode positional (interp|jit). Empty → both
// modes ("interp jit").
int _testDistRun(string modeArg) {
    string root = _root();
    // DIST_SMOKE_ONLY=launcher → run only the launcher smokes (beginner CLI path +
    // `z42 run <dir> --bin`), skipping the heavier desktop-publish + golden legs.
    // 保留作本地快跑的开关；**CI 不再用它**（fix-package-gates-false-red, 2026-09-06）——
    // 它曾是 CI 唯一的 `test dist` 调用形态，于是另两条腿永远没人跑，双双烂掉而无人知：
    // apphost 腿的模板判据停在 apphost 迁进 workload 之前（恒 SKIP，见
    // _distApphostTemplate），golden 腿调 z42c 的 CLI 根本不存在（`--emit zbc -o`，
    // 282 个 case 全 compile fail）。
    string smokeOnly = _envOpt("DIST_SMOKE_ONLY", "");

    // ── Resolve the packaged distribution dir ────────────────────────────
    string distDir = _envOpt("DIST_DIR", "");
    if (distDir.Length == 0) { distDir = _latestReleasePkg(root); }
    if (distDir.Length == 0 || !Directory.Exists(distDir)) {
        ConsoleError.WriteLine("error: no packaged distribution found at artifacts/packages/z42-*-release");
        ConsoleError.WriteLine("       Run: xtask package sdk");
        return 1;
    }
    string z42c    = Path.Join(distDir, "bin/z42c");
    if (!File.Exists(z42c)) { z42c = z42c + ".exe"; }     // Windows: bin/z42c.exe
    string z42vm   = Path.Join(distDir, "bin/z42vm");
    if (!File.Exists(z42vm)) { z42vm = z42vm + ".exe"; }  // Windows: bin/z42vm.exe
    string libsDir = Path.Join(distDir, "libs");

    // ── Preflight ────────────────────────────────────────────────────────
    bool bad = false;
    if (!File.Exists(z42c))      { ConsoleError.WriteLine("error: z42c not found at " + z42c); bad = true; }
    if (!File.Exists(z42vm))     { ConsoleError.WriteLine("error: z42vm not found at " + z42vm); bad = true; }
    if (!Directory.Exists(libsDir)) { ConsoleError.WriteLine("error: libs not found at " + libsDir); bad = true; }
    // 三个 smoke 套件各自的被测对象也必须 preflight（fix-silent-gates, 2026-09-06）。
    // 此前它们缺件时是「静默 SKIP + 返回 [0,0]」，而终判只看 overallFail>0 ——
    // 于是**全部 SKIP 也返回绿**。而 SKIP 的条件字面上就是「被测对象从包里消失了」，
    // 那恰恰是这个 job 存在的理由。缺件必须红在这里，不能退化成 no-op。
    //
    // ⚠️ preflight 只断言**本次真要跑的那几条腿**的被测对象
    // （fix-package-gates-false-red, 2026-09-06）：DIST_SMOKE_ONLY=launcher 时
    // apphost 腿根本不跑，为它的模板报错是纯误报（CI package-host 正是这么红的）。
    string pfLauncher = Path.Join(distDir, "z42");
    if (!File.Exists(pfLauncher)) { pfLauncher = pfLauncher + ".exe"; }
    if (!File.Exists(pfLauncher)) {
        ConsoleError.WriteLine("error: launcher (z42) not in package at " + distDir); bad = true;
    }
    if (!File.Exists(Path.Join(distDir, "programs/launcher/launcher.zpkg"))) {
        ConsoleError.WriteLine("error: programs/launcher/launcher.zpkg not in package at " + distDir); bad = true;
    }
    string apphostTmpl = "";
    if (smokeOnly != "launcher") {
        apphostTmpl = _distApphostTemplate(root);
        if (apphostTmpl.Length == 0) {
            ConsoleError.WriteLine("error: desktop workload apphost stub not built at "
                + _distWorkloadDir(root) + " — run: xtask package workload");
            bad = true;
        }
    }
    if (bad) { return 1; }

    Console.WriteLine("z42 Distribution Test Runner");
    Console.WriteLine("  compiler: " + z42c);
    Console.WriteLine("  vm:       " + z42vm);
    Console.WriteLine("  libs:     " + libsDir);
    Console.WriteLine("");

    string work = Directory.CreateTempDir("xtask-testdist");

    int overallPass = 0;
    int overallFail = 0;

    // ── Launcher smoke (portable + installed) ────────────────────────────
    int[] smoke = _launcherSmoke(distDir, work);
    overallPass = overallPass + smoke[0];
    overallFail = overallFail + smoke[1];

    if (smokeOnly != "launcher") {
        // ── desktop-publish smoke (build app → z42 publish → run produced exe) ──────
        int[] ah = _apphostSmoke(distDir, work, apphostTmpl);
        overallPass = overallPass + ah[0];
        overallFail = overallFail + ah[1];

        // ── Golden cases per mode ────────────────────────────────────────────
        // The optional mode positional (formerly Z42_DIST_MODES); empty → both.
        if (modeArg.Length == 0) { modeArg = "interp jit"; }
        string[] modes = _splitWords(modeArg);
        int[] gres = _runDistGoldens(modes, root, z42c, z42vm, libsDir, work);
        overallPass = overallPass + gres[0];
        overallFail = overallFail + gres[1];
    }

    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Total: " + overallPass.ToString() + " passed, " + overallFail.ToString() + " failed");
    Console.WriteLine("══════════════════════════════════════");
    if (overallFail > 0) { return 1; }
    return 0;
}

// Golden legs: compile every dist case ONCE with the packaged z42c, then run the
// zbc under each mode with the packaged z42vm and diff stdout. Returns [pass, fail]
// where fail folds in compile errors (as the caller aggregates).
//
// perf-dist-golden-parallel (2026-09-15): 此前逐 mode、逐 case **串行**「编 + 跑」——
// interp 313 + jit 309 例在 CI 上 linux 8 分钟 / windows 10 分钟，而 zbc 与 mode 无关，
// 等于每例编译两遍。现在：
//   ① 编译一遍（jit 的用例集 = interp 的去掉 interpOnly，同一份源）；
//   ② 编译与运行都按批并行（同 golden regen / e2e goldens 的批模式，批内按原序判定打印，
//      输出确定）。
// 覆盖面不变：仍是同一套用例、同一个打包 z42c/z42vm、同样两种 mode。
int[] _runDistGoldens(string[] modes, string root, string z42c, string z42vm, string libsDir, string work) {
    bool wantInterp = false;
    int mi = 0;
    while (mi < modes.Length) { if (modes[mi] != "jit") { wantInterp = true; } mi = mi + 1; }
    _DistCase[] cases = _enumerateDistCases(root);
    int n = cases.Length;

    // ① compile once. zbc 名带序号：不同目录下可能有同名 case，并行编译时不能共用输出路径。
    string[] zbcs = new string[n];
    bool[] compiled = new bool[n];
    int cjobs = _regenJobs();
    int i = 0;
    while (i < n) {
        int bsz = cjobs;
        if (i + bsz > n) { bsz = n - i; }
        ProcessHandle[] hs = new ProcessHandle[bsz];
        bool[] live = new bool[bsz];
        int b = 0;
        while (b < bsz) {
            _DistCase c = cases[i + b];
            zbcs[i + b] = Path.Join(work, (i + b).ToString() + "-" + c.name + ".zbc");
            live[b] = false;
            if (wantInterp || !c.interpOnly) {
                try {
                    hs[b] = new Process(z42c).Arg("--emit-zbc").Arg(c.source).Arg(zbcs[i + b])
                        .Env("Z42_LIBS", libsDir)
                        .Stdout(Stdio.Null()).Stderr(Stdio.Null())
                        .Spawn();
                    live[b] = true;
                } catch (Exception e) { ConsoleError.WriteLine("  (compile spawn error: " + e.Message + ")"); }
            }
            b = b + 1;
        }
        b = 0;
        while (b < bsz) {
            compiled[i + b] = live[b] && hs[b].Wait().ExitCode == 0;
            b = b + 1;
        }
        i = i + bsz;
    }

    // ② run per mode.
    int pass = 0;
    int fail = 0;
    int rjobs = _distRunJobs();
    mi = 0;
    while (mi < modes.Length) {
        string mode = modes[mi];
        mi = mi + 1;
        Console.WriteLine("══════════════════════════════════════");
        Console.WriteLine(" Mode: " + mode);
        Console.WriteLine("══════════════════════════════════════");
        int[] sel = new int[n];
        int ns = 0;
        i = 0;
        while (i < n) {
            if (!(mode == "jit" && cases[i].interpOnly)) { sel[ns] = i; ns = ns + 1; }
            i = i + 1;
        }
        int mpass = 0;
        int mfail = 0;
        int compileFail = 0;
        int k = 0;
        while (k < ns) {
            int bsz = rjobs;
            if (k + bsz > ns) { bsz = ns - k; }
            ProcessHandle[] hs = new ProcessHandle[bsz];
            bool[] live = new bool[bsz];
            string[] spawnErr = new string[bsz];
            int b = 0;
            while (b < bsz) {
                int ci = sel[k + b];
                _DistCase c = cases[ci];
                live[b] = false;
                spawnErr[b] = "";
                if (compiled[ci]) {
                    // entry passed explicitly — z42vm requires it.
                    try {
                        hs[b] = new Process(z42vm).Arg(zbcs[ci]).Arg(c.entryName).Arg("--mode").Arg(mode)
                            .Env("Z42_LIBS", libsDir)
                            .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe())
                            .Spawn();
                        live[b] = true;
                    } catch (Exception e) { spawnErr[b] = "<spawn error: " + e.Message + ">"; }
                }
                b = b + 1;
            }
            b = 0;
            while (b < bsz) {
                int ci = sel[k + b];
                _DistCase c = cases[ci];
                b = b + 1;
                if (!compiled[ci]) {
                    compileFail = compileFail + 1;
                    Console.WriteLine("  FAIL: " + c.name + " (compile failed)");
                    continue;
                }
                string actual = spawnErr[b - 1];
                if (live[b - 1]) {
                    try {
                        ProcessResult r = hs[b - 1].Wait();
                        actual = _stripTrailingNewlines(r.Stdout + r.Stderr);
                    } catch (Exception e) { actual = "<wait error: " + e.Message + ">"; }
                }
                string expected = "";
                if (File.Exists(c.expected)) { expected = _stripTrailingNewlines(File.ReadAllText(c.expected)); }
                if (actual == expected) {
                    mpass = mpass + 1;
                } else {
                    mfail = mfail + 1;
                    Console.WriteLine("  FAIL: " + c.name);
                    Console.WriteLine("    expected: " + _firstLine(expected));
                    Console.WriteLine("    actual:   " + _firstLine(actual));
                }
            }
            k = k + bsz;
        }
        Console.WriteLine("");
        Console.WriteLine("  Result: " + mpass.ToString() + " passed, " + mfail.ToString()
            + " failed, " + compileFail.ToString() + " compile errors");
        Console.WriteLine("");
        pass = pass + mpass;
        fail = fail + mfail + compileFail;
    }
    int[] res = new int[2];
    res[0] = pass;
    res[1] = fail;
    return res;
}

// 运行阶段并发度：min(CpuCount, 8)。与编译不同，运行是真吃 CPU 的 VM 进程（含 GC / 线程类
// golden），不超核数；GitHub 4 核 runner 上 = 4，与 test-host 的 e2e goldens（jobs=4）同一量级。
// `Z42_DIST_JOBS` 逃生舱：不改代码在 CI 上试别的值（1 = 退回串行）。
int _distRunJobs() {
    string ov = Environment.GetEnvironmentVariable("Z42_DIST_JOBS") ?? "";
    if (ov.Length > 0) {
        try { int v = int.Parse(ov); if (v > 0) { return v; } } catch (Exception e) { }
    }
    int cpu = OperatingSystem.CpuCount();
    if (cpu < 1) { return 1; }
    return cpu < 8 ? cpu : 8;
}

// ── Launcher smoke: returns [pass, fail] ───────────────────────────────────
int[] _launcherSmoke(string distDir, string work) {
    int pass = 0;
    int fail = 0;
    string launcher = Path.Join(distDir, "z42");
    if (!File.Exists(launcher)) { launcher = launcher + ".exe"; }   // Windows: z42.exe
    // unify-launcher-apphost (2026-06-21): z42 is an apphost; its launcher.zpkg
    // payload lives at programs/launcher/ (was the package root).
    if (!File.Exists(launcher) || !File.Exists(Path.Join(distDir, "programs/launcher/launcher.zpkg"))) {
        Console.WriteLine("Launcher smoke: SKIP (z42 or programs/launcher/launcher.zpkg not in package)");
        Console.WriteLine("");
        int[] r0 = new int[2]; r0[0] = 0; r0[1] = 0; return r0;
    }
    // 新手路径（new → run → build → clean / 版本 / 帮助）：见 xtask_test_dist_cli.z42。
    int[] cli = _launcherCliSmoke(launcher, work);
    pass = pass + cli[0];
    fail = fail + cli[1];
    Console.WriteLine("Launcher smoke (run / repl): " + launcher);
    // (unify-run-modes P4) `z42 run <dir> --bin`: build a source project with the
    // packaged z42c and run the selected [[exe]] target — real end-to-end of the
    // run front door + multi-exe selection. Copy the multi-exe fixture into a
    // writable temp first (build writes dist/ there). Skips if bin/z42c or the
    // fixture is absent.
    string z42cBin = Path.Join(distDir, "bin/z42c");
    if (!File.Exists(z42cBin)) { z42cBin = z42cBin + ".exe"; }
    string mexeSrc = Path.Join(_root(), "src/tests/multi-exe/two_mains");
    if (File.Exists(z42cBin) && Directory.Exists(mexeSrc)) {
        string mexeWork = Path.Join(work, "mexe-run");
        Directory.Copy(mexeSrc, mexeWork, true);
        try {
            ProcessResult rr = new Process(launcher).Arg("run").Arg(mexeWork).Arg("--bin").Arg("greet")
                .EnvRemove("Z42_HOME").EnvRemove("Z42_PORTABLE_VM")
                .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
            string got = rr.Stdout.Trim();
            if (got == "greet-main") {
                Console.WriteLine("  ✓ z42 run <dir> --bin greet → greet-main");
                pass = pass + 1;
            } else {
                Console.WriteLine("  FAIL: z42 run <dir> --bin greet → '" + got + "' (stderr: " + rr.Stderr.Trim() + ")");
                fail = fail + 1;
            }
            // launcher-forwards-set: `--set` 是优先级链最高层，但主前门 `z42 run`
            // 此前根本传不进去（放 app 前会被当成 app 路径，放 app 后被静默丢弃）。
            // 这条断言盯住转发链；同时 `--bogus` 一条盯住"未识别 flag 不再当路径"。
            ProcessResult rs = new Process(launcher).Arg("run").Arg(mexeWork)
                .Arg("--bin").Arg("greet").Arg("--set").Arg("gc-mode=concurrent")
                .EnvRemove("Z42_HOME").EnvRemove("Z42_PORTABLE_VM")
                .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
            if (rs.Stdout.Trim() == "greet-main" && rs.ExitCode == 0) {
                Console.WriteLine("  ✓ z42 run --set <knob> 转发给 z42vm");
                pass = pass + 1;
            } else {
                Console.WriteLine("  FAIL: z42 run --set → rc=" + rs.ExitCode.ToString()
                    + " out='" + rs.Stdout.Trim() + "' err='" + rs.Stderr.Trim() + "'");
                fail = fail + 1;
            }
            ProcessResult rb = new Process(launcher).Arg("run").Arg("--bogus").Arg(mexeWork)
                .EnvRemove("Z42_HOME").EnvRemove("Z42_PORTABLE_VM")
                .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
            if (rb.ExitCode != 0 && rb.Stderr.IndexOf("unknown option") >= 0) {
                Console.WriteLine("  ✓ z42 run 未识别 flag 明确报错（不再当成 app 路径）");
                pass = pass + 1;
            } else {
                Console.WriteLine("  FAIL: z42 run --bogus → rc=" + rb.ExitCode.ToString()
                    + " err='" + rb.Stderr.Trim() + "'");
                fail = fail + 1;
            }
        } catch (Exception e) {
            Console.WriteLine("  FAIL: z42 run --bin smoke: " + e.Message);
            fail = fail + 1;
        }
    } else {
        Console.WriteLine("  SKIP: z42 run <dir> --bin (bin/z42c or multi-exe fixture missing)");
    }
    // (repl-run-config) `z42 repl --config <file> -c <expr>`: verify the launcher
    // consumes `--config` (sets Z42_CONFIG on the REPL's z42vm) and passes `-c`
    // through to z42i, which evals. Needs the interactive host in the package.
    string z42i = Path.Join(distDir, "programs/z42i/z42.interactive.zpkg");
    if (File.Exists(z42i)) {
        string rcfg = Path.Join(work, "repl-cfg.toml");
        File.WriteAllText(rcfg, "[runtime]\ngc-mode = \"stw\"\n");
        try {
            ProcessResult rp = new Process(launcher).Arg("repl").Arg("--config").Arg(rcfg).Arg("-c").Arg("1 + 2")
                .EnvRemove("Z42_HOME").EnvRemove("Z42_PORTABLE_VM")
                .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
            string got = rp.Stdout.Trim();
            // mode/gc effect isn't observable in stdout; assert eval works with the
            // flag present (proves --config didn't leak to z42i as a bad arg).
            if (got.Contains("3")) {
                Console.WriteLine("  ✓ z42 repl --config <file> -c '1 + 2' → 3");
                pass = pass + 1;
            } else {
                Console.WriteLine("  FAIL: z42 repl --config -c → '" + got + "' (stderr: " + rp.Stderr.Trim() + ")");
                fail = fail + 1;
            }
        } catch (Exception e) {
            Console.WriteLine("  FAIL: z42 repl --config smoke: " + e.Message);
            fail = fail + 1;
        }
    } else {
        Console.WriteLine("  SKIP: z42 repl --config (programs/z42i not in package)");
    }
    Console.WriteLine("");
    int[] res = new int[2]; res[0] = pass; res[1] = fail; return res;
}

// ── apphost stub 模板的真实位置 ──────────────────────────────────────────────
// Decision 9（add-desktop-workload）：stub 随 **desktop workload** 发布，SDK 包里
// **没有** bin/apphost —— 生产端见 `_buildDesktopWorkload`（"lands here, not in SDK
// bin/"），消费端见 launcher 的 `_desktopApphostStub`（读 installed workload 或
// Z42_APPHOST_TEMPLATE 覆盖）。
//
// ⚠️ 这条曾是本文件里一个「不会红的门」：`_apphostSmoke` 一直拿 `<pkg>/bin/apphost`
// 当模板，而 apphost 早已迁到 workload —— 判据恒不满足 ⇒ desktop-publish smoke
// 自迁移起**一次都没跑过**（静默 SKIP + 返回 [0,0]）。fix-silent-gates 把它升成硬
// preflight，却照抄了那条过时路径，于是变成「为包里本就不该有的东西报错」。
// 这里改回真实位置，让这条 smoke 真的跑起来。
string _distWorkloadDir(string root) {
    string rid = _detectHostRid();
    return Path.Join(_packagesDir(root), "z42-workload-" + _versionsGet(root) + "-desktop-" + rid);
}

// "" = 未构建（调用方按缺件处理）。
string _distApphostTemplate(string root) {
    string rid = _detectHostRid();
    string name = rid.StartsWith("windows-") ? ("apphost-" + rid + ".exe") : ("apphost-" + rid);
    string p = Path.Join(_distWorkloadDir(root), name);
    if (File.Exists(p)) { return p; }
    return "";
}

// ── desktop-publish smoke: returns [pass, fail] ────────────────────────────────────
// Build a tiny app.zpkg with the packaged z42c, `z42 publish` it (with
// Z42_APPHOST_TEMPLATE pointing at the desktop workload's apphost-<rid>, which is
// exactly what an installed workload would hand the launcher), then run the
// produced native exe against a Z42_HOME pointing at the package and assert it
// runs the app. Exercises patch + macOS re-sign + local-first resolution.
// `tmpl` is preflight-verified non-empty by the caller — no SKIP path here.
int[] _apphostSmoke(string distDir, string work, string tmpl) {
    int pass = 0;
    int fail = 0;
    string launcher = Path.Join(distDir, "z42");
    if (!File.Exists(launcher)) { launcher = launcher + ".exe"; }   // Windows
    string z42c = Path.Join(distDir, "bin/z42c");
    if (!File.Exists(z42c)) { z42c = z42c + ".exe"; }               // Windows
    string libs = Path.Join(distDir, "libs");
    Console.WriteLine("desktop-publish smoke: " + tmpl);

    // The app prints where its `mode` knob came from. `[profile.release] mode` below
    // is baked by `z42c build` into `app.runtimeconfig.toml`; `z42 publish` must carry
    // that sidecar into the deploy layout and the apphost must hand it to z42vm as
    // Z42_APP_CONFIG. Asserting `app-config` here fails if ANY link in that chain
    // breaks — which is exactly how the chain was dead before
    // sidecar-reaches-published-apps (2026-09-05): the settings a project declares
    // were silently inert in the shape users actually ship.
    string appSrc =
        "namespace AhSmoke;\n" +
        "using Std;\n" +
        "using Std.IO;\n" +
        "using Std.Runtime;\n" +
        "void Main() {\n" +
        "    Console.WriteLine(\"APPHOST_OK\");\n" +
        "    Console.WriteLine(\"MODE_SRC=\" + RuntimeConfig.Source(\"mode\"));\n" +
        "    Environment.Exit(0);\n" +
        "}\n";
    string appToml =
        "[project]\n" +
        "name = \"app\"\n" +
        "version = \"0.1.0\"\n" +
        "kind = \"exe\"\n" +
        "entry = \"AhSmoke.Main\"\n" +
        "[sources]\n" +
        "include = [\"*.z42\"]\n" +
        "[dependencies]\n" +
        "\"z42.core\" = \"0.1.0\"\n" +
        "\"z42.io\" = \"0.1.0\"\n" +
        "[build]\n" +
        "dist_dir = \".\"\n" +
        // apphost = true 是 gate-apphost-on-config 之后 publish 的准入条件（缺它 z42b
        // 直接 rc=2）。这条 fixture 停在门加上之前的写法 —— 因为 smoke 自己也从没跑过，
        // 没有任何东西会因为它过时而变红（fix-package-gates-false-red, 2026-09-06）。
        "[platform.desktop]\n" +
        "apphost = true\n" +
        "publish_dir = \".\"\n" +
        "[profile.release.runtime]\n" +
        "mode = \"interp\"\n";

    string ad = Path.Join(work, "ahsmoke");
    Directory.Create(ad);
    File.WriteAllText(Path.Join(ad, "app.z42"), appSrc);
    File.WriteAllText(Path.Join(ad, "app.z42.toml"), appToml);
    string appZpkg = Path.Join(ad, "app.zpkg");
    string producedExe = Path.Join(ad, (distDir.IndexOf("windows-") >= 0) ? "app.exe" : "app");  // Windows apphost .exe

    try {
        // 1. build app.zpkg with the packaged z42c (deps from package libs).
        int bc = new Process(z42c).Arg("build").Arg(Path.Join(ad, "app.z42.toml")).Arg("--release")
            .Env("Z42_LIBS", libs).Stdout(Stdio.Null()).Stderr(Stdio.Null()).Run().ExitCode;
        if (bc != 0 || !File.Exists(appZpkg)) {
            Console.WriteLine("  FAIL: build app.zpkg (rc=" + bc.ToString() + ")");
            Console.WriteLine("");
            int[] rf = new int[2]; rf[0] = pass; rf[1] = fail + 1; return rf;
        }
        // 2. z42 publish — portable trampoline (drop Z42_HOME / Z42_PORTABLE_VM
        //    so it resolves the package itself). Z42_APPHOST_TEMPLATE stands in for
        //    an installed desktop workload (same env the launcher itself forwards to
        //    z42b after resolving `runtimes/<ver>/workloads/desktop/apphost-<rid>`).
        //    apphost-as-config: desktop publish is `publish <toml>` (--rid defaults
        //    to host) reading [platform.desktop].publish_dir (= "." → exe beside the
        //    built zpkg). unify-platform-deploy-rid removed the `desktop` subcommand.
        int pc = new Process(launcher).Arg("publish").Arg(Path.Join(ad, "app.z42.toml"))
            .EnvRemove("Z42_HOME").EnvRemove("Z42_PORTABLE_VM").Env("Z42_APPHOST_TEMPLATE", tmpl)
            .Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run().ExitCode;
        if (pc != 0 || !File.Exists(producedExe)) {
            Console.WriteLine("  FAIL: z42 publish (rc=" + pc.ToString() + ")");
            Console.WriteLine("");
            int[] rf = new int[2]; rf[0] = pass; rf[1] = fail + 1; return rf;
        }
        Console.WriteLine("  ✓ z42 publish → " + producedExe);

        // 3. run the produced exe with Z42_HOME → <ahome>/launcher 是包的一份**真拷贝**
        //    (portable-style: launcher.zpkg + bin/z42vm)。
        //    这里曾用 File.SymLink，而它**在 Windows 上未实现**（pal/fs.rs 的 non-unix
        //    分支直接 bail "not implemented on this platform"）⇒ 这条 smoke 一接通就在
        //    Windows 上抛（fix-more-silent-gates 续，2026-09-06）。改用目录拷贝：跨平台
        //    行为一致、无需 symlink 特权，而且更贴近真实安装形态（用户的 Z42_HOME 下是
        //    真目录不是链接）。代价是每次拷 ~56MB，CI 上几秒。
        //    （`File.SymLink` 缺 Windows 实现本身是独立的 stdlib 缺口，不在本轮射程。）
        string ahome = Path.Join(work, "ahome");
        Directory.Create(ahome);
        string lnk = Path.Join(ahome, "launcher");
        if (!Directory.Exists(lnk)) { Directory.Copy(distDir, lnk, true); }
        ProcessResult r = new Process(producedExe).Arg("x")
            .Env("Z42_HOME", ahome).EnvRemove("Z42_PORTABLE_VM").EnvRemove("Z42_PORTABLE_LIBS").EnvRemove("Z42_LIBS")
            .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
        if (r.Stdout.IndexOf("APPHOST_OK") >= 0) {
            Console.WriteLine("  ✓ produced apphost runs the app");
            pass = pass + 1;
            // The project's [profile.release] must reach the published binary.
            if (r.Stdout.IndexOf("MODE_SRC=app-config") >= 0) {
                Console.WriteLine("  ✓ published app reads its runtimeconfig sidecar");
                pass = pass + 1;
            } else {
                Console.WriteLine("  FAIL: sidecar did not reach the published app; got '"
                    + r.Stdout.Trim() + "' (expected MODE_SRC=app-config)");
                fail = fail + 1;
            }
        } else {
            Console.WriteLine("  FAIL: produced apphost stdout='" + r.Stdout.Trim() + "' stderr='" + r.Stderr.Trim() + "'");
            fail = fail + 1;
        }
    } catch (Exception e) {
        Console.WriteLine("  FAIL: desktop-publish smoke: " + e.Message);
        fail = fail + 1;
    }
    // (unify-run-modes P5) multi-exe publish: a 2-[[exe]] project → 2 apphosts.
    // Reuses the same packaged launcher/z42c/apphost-stub as the single-app smoke;
    // asserts both `aexe` and `bexe` apphosts are produced (one per [[exe]]).
    try {
        string mpd = Path.Join(work, "mexe-pub");
        Directory.Create(mpd);
        File.WriteAllText(Path.Join(mpd, "a.z42"),
            "namespace App.A;\nusing Std;\nusing Std.IO;\nvoid Main() { Console.WriteLine(\"A_OK\"); Environment.Exit(0); }\n");
        File.WriteAllText(Path.Join(mpd, "b.z42"),
            "namespace App.B;\nusing Std;\nusing Std.IO;\nvoid Main() { Console.WriteLine(\"B_OK\"); Environment.Exit(0); }\n");
        File.WriteAllText(Path.Join(mpd, "app.z42.toml"),
            "[project]\nname = \"mexeapp\"\nversion = \"0.1.0\"\npack = true\n" +
            "[sources]\ninclude = [\"*.z42\"]\n" +
            "[dependencies]\n\"z42.core\" = \"0.1.0\"\n\"z42.io\" = \"0.1.0\"\n" +
            "[build]\ndist_dir = \"dist\"\n" +
            "[platform.desktop]\napphost = true\npublish_dir = \".\"\n" +
            "[[exe]]\nname = \"aexe\"\nentry = \"App.A.Main\"\n" +
            "[[exe]]\nname = \"bexe\"\nentry = \"App.B.Main\"\n");
        int pcm = new Process(launcher).Arg("publish").Arg(Path.Join(mpd, "app.z42.toml"))
            .EnvRemove("Z42_HOME").EnvRemove("Z42_PORTABLE_VM").Env("Z42_APPHOST_TEMPLATE", tmpl)
            .Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run().ExitCode;
        bool winPkg = distDir.IndexOf("windows-") >= 0;
        string aexe = Path.Join(mpd, winPkg ? "aexe.exe" : "aexe");
        string bexe = Path.Join(mpd, winPkg ? "bexe.exe" : "bexe");
        if (pcm == 0 && File.Exists(aexe) && File.Exists(bexe)) {
            Console.WriteLine("  ✓ z42 publish multi-exe → aexe + bexe apphosts");
            pass = pass + 1;
        } else {
            Console.WriteLine("  FAIL: z42 publish multi-exe (rc=" + pcm.ToString()
                + " aexe=" + (File.Exists(aexe) ? "y" : "n") + " bexe=" + (File.Exists(bexe) ? "y" : "n") + ")");
            fail = fail + 1;
        }
    } catch (Exception e) {
        Console.WriteLine("  FAIL: multi-exe publish smoke: " + e.Message);
        fail = fail + 1;
    }
    // (add-precompiled-native) prebuilt native colocation: a lib declaring [native.<name>].dir
    // (no [build] hooks) + a committed fake prebuilt at <dir>/<rid>/<derived> + a path-dep exe →
    // z42 publish copies the prebuilt native by target rid beside the app zpkg (dist/) and into
    // the payload. Asserts file placement (fake bytes are not dlopen-loadable → we do not run).
    try {
        // host rid from the package dir name (format z42-<version>-<rid>-release; version optional):
        // locate a known os-family prefix and take through the arch up to "-release" (robust to the
        // version segment, matching the existing `IndexOf("windows-")` style above).
        string pkgName = Path.GetFileName(distDir);
        string prid = "";
        string[] osPfx = new string[]{ "macos-", "linux-", "windows-", "iossim-", "ios-", "android-" };
        int oi = 0;
        while (oi < osPfx.Length && prid.Length == 0) {
            int idx = pkgName.IndexOf(osPfx[oi]);
            if (idx >= 0) {
                string rest = pkgName.Substring(idx);        // e.g. "macos-arm64-release"
                int rel = rest.IndexOf("-release");
                prid = (rel >= 0) ? rest.Substring(0, rel) : rest;   // "macos-arm64"
            }
            oi = oi + 1;
        }
        // rid-derived <prefix><name><suffix> (mirrors z42b _pubNativeFileName).
        string pfx = "lib"; string sfx = ".so";
        if (prid.StartsWith("windows-")) { pfx = ""; sfx = ".dll"; }
        else if (prid.StartsWith("macos-") || prid.StartsWith("ios-") || prid.StartsWith("iossim-")) { pfx = "lib"; sfx = ".dylib"; }
        string nfname = pfx + "pnfoo" + sfx;

        string pnRoot = Path.Join(work, "prebuilt-native");
        string pnlibDir = Path.Join(pnRoot, "pnlib");
        string pnappDir = Path.Join(pnRoot, "pnapp");
        Directory.Create(pnlibDir);
        Directory.Create(pnappDir);
        // lib pnlib: trivial z42 source + [native.pnfoo] dir="prebuilt" (no [build] hooks).
        File.WriteAllText(Path.Join(pnlibDir, "pnlib.z42"),
            "namespace Pn.Lib;\n\npublic static class Pnlib {\n    public static int Answer() { return 42; }\n}\n");
        File.WriteAllText(Path.Join(pnlibDir, "pnlib.z42.toml"),
            "[project]\nname = \"pnlib\"\nversion = \"0.1.0\"\nkind = \"lib\"\n" +
            "[sources]\ninclude = [\"*.z42\"]\n" +
            "[dependencies]\n\"z42.core\" = \"0.1.0\"\n" +
            "[native.pnfoo]\ndir = \"prebuilt\"\n");
        // committed fake prebuilt at prebuilt/<rid>/<derived> (fake bytes — placement only).
        string pdir = Path.Join(Path.Join(pnlibDir, "prebuilt"), prid);
        Directory.Create(pdir);
        File.WriteAllText(Path.Join(pdir, nfname), "FAKE_PREBUILT_NATIVE\n");
        // exe pnapp path-deps pnlib + payload layout.
        File.WriteAllText(Path.Join(pnappDir, "pnapp.z42"),
            "namespace Pn.App;\nusing Std;\nusing Std.IO;\nusing Pn.Lib;\n" +
            "void Main() { Console.WriteLine(\"PN_\" + Pnlib.Answer().ToString()); Environment.Exit(0); }\n");
        File.WriteAllText(Path.Join(pnappDir, "pnapp.z42.toml"),
            "[project]\nname = \"pnapp\"\nversion = \"0.1.0\"\nkind = \"exe\"\nentry = \"Pn.App.Main\"\npack = true\n" +
            "[sources]\ninclude = [\"*.z42\"]\n" +
            "[dependencies]\n\"z42.core\" = \"0.1.0\"\n\"z42.io\" = \"0.1.0\"\n\"pnlib\" = { path = \"../pnlib\" }\n" +
            "[build]\ndist_dir = \"dist\"\n" +
            "[platform.desktop]\napphost = true\npublish_dir = \".\"\npayload = \"payload/pnapp.zpkg\"\n" +
            "[profile.release.runtime]\nmode = \"interp\"\n");
        int pcn = new Process(launcher).Arg("publish").Arg(Path.Join(pnappDir, "pnapp.z42.toml"))
            .EnvRemove("Z42_HOME").EnvRemove("Z42_PORTABLE_VM").Env("Z42_APPHOST_TEMPLATE", tmpl)
            .Stdout(Stdio.Null()).Stderr(Stdio.Pipe()).Run().ExitCode;
        // native colocated beside the built zpkg (dist/) by _pubCopyPrebuiltNative, then carried
        // into the payload dir by _pubCopyDistDeps.
        string distNative    = Path.Join(Path.Join(pnappDir, "dist"), nfname);
        string payloadNative = Path.Join(Path.Join(pnappDir, "payload"), nfname);
        if (pcn == 0 && File.Exists(payloadNative)) {
            Console.WriteLine("  ✓ prebuilt native colocated by rid → payload/" + nfname);
            pass = pass + 1;
        } else {
            Console.WriteLine("  FAIL: prebuilt native (rc=" + pcn.ToString()
                + " dist=" + (File.Exists(distNative) ? "y" : "n")
                + " payload=" + (File.Exists(payloadNative) ? "y" : "n") + ")");
            fail = fail + 1;
        }
    } catch (Exception e) {
        Console.WriteLine("  FAIL: prebuilt-native smoke: " + e.Message);
        fail = fail + 1;
    }
    Console.WriteLine("");
    int[] res = new int[2]; res[0] = pass; res[1] = fail; return res;
}

// ── Case shape + enumeration ───────────────────────────────────────────────
// _DistCase is dist-specific: it names the `.z42` SOURCE to compile with the
// packaged z42c, where the VM runner's _Case (xtask_test_vm.z42, same namespace)
// names a prebuilt `.zbc`. Both are now mapped from the ONE shared corpus walk
// (_walkGoldenCorpus, common/xtask_golden.z42) — only the selection policy and
// the record shape stay local.

class _DistCase {
    public string name;
    public string source;     // source.z42 path
    public string expected;   // expected_output.txt path
    public string entryName;  // <ns>.Main / Main / <ns>.main / main (z42vm needs it)
    public bool interpOnly;   // jit 模式跳过（同 _GoldenEntry.interpOnly）
    public _DistCase(string name, string source, string expected, string entryName, bool interpOnly) {
        this.name = name; this.source = source; this.expected = expected; this.entryName = entryName;
        this.interpOnly = interpOnly;
    }
}

// True if source.z42 declares a unit test (a line starts with `[Test]` /
// `[Benchmark]`) → owned by `xtask test stdlib` (z42b reflection runner), not
// golden-runnable here.
bool _isTestRunnerSource(string src) {
    string rest = File.ReadAllText(src);
    while (rest.Length > 0) {
        string ln;
        int nl = rest.IndexOf("\n");
        if (nl < 0) { ln = rest; rest = ""; }
        else { ln = rest.Substring(0, nl); rest = rest.Substring(nl + 1); }
        ln = ln.Trim();
        if (ln.StartsWith("[Test]") || ln.StartsWith("[Test(")
            || ln.StartsWith("[Benchmark]") || ln.StartsWith("[Benchmark(")) {
            return true;
        }
    }
    return false;
}

// Golden selection over the shared walk (_walkGoldenCorpus, common/xtask_golden.z42).
// Unlike the VM runner, dist compiles the `.z42` SOURCE with the PACKAGED z42c, so
// selection keys off source presence, not the artifacts mirror.
// 返回全部 mode 的并集；interpOnly 由调用方按 mode 过滤（编译只做一遍）。
_DistCase[] _enumerateDistCases(string root) {
    _GoldenEntry[] entries = _walkGoldenCorpus(root);
    _DistCase[] cases = new _DistCase[entries.Length];
    int n = 0;

    int i = 0;
    while (i < entries.Length) {
        _GoldenEntry e = entries[i];
        i = i + 1;
        if (e.seg == "lib-file") { continue; }   // stdlib [Test] file units — z42b's, not golden
        if (!e.hasSource) { continue; }
        if (!e.isLib && _isNonRunnableCat(e.cat)) { continue; }
        // Skip [Test]/[Benchmark]-based lib test dirs — owned by `xtask test stdlib`
        // (z42b), not golden-runnable (no Main; may be multi-file like secp256k1's
        // source.z42 + vectors.z42).
        if (e.isLib && _isTestRunnerSource(e.src)) { continue; }
        cases[n] = new _DistCase(e.name, e.src, e.expected, _deriveEntry(e.src), e.interpOnly);
        n = n + 1;
    }

    _DistCase[] tight = new _DistCase[n];
    int t = 0;
    while (t < n) { tight[t] = cases[t]; t = t + 1; }
    return tight;
}

// ── test-dist-private helpers ──────────────────────────────────────────────

string _envOpt(string name, string fallback) {
    string? v = Environment.GetEnvironmentVariable(name);
    if (v == null) { return fallback; }
    string nonNull = v ?? "";
    if (nonNull.Length == 0) { return fallback; }
    return nonNull;
}

