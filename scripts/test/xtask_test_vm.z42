// xtask — VM golden-test runner (folded from the former scripts/test-vm.z42 by
// the test-vm fold). Same Z42Xtask namespace; the golden-walk + entry-derivation
// helpers it calls (_deriveEntry / _enumDirsSorted / _isNonRunnableCat /
// _firstLine / _stripTrailingNewlines / ...) live in xtask_golden.z42.
//
// Runs VM golden tests in interp / jit mode. Each golden case's source +
// sidecars live in src; the compiled .zbc lives in the artifacts mirror
// (redirect-golden-zbc-to-artifacts, 2026-06-16 — keeps src/ free of build
// output). Sidecar (src) → artifact (mirror) mapping:
//   src/tests/<cat>/<name>/source.z42 + expected_output.txt
//     → artifacts/build/tests/<cat>/<name>/source.zbc                     (dir)
//   src/libraries/<lib>/tests/<name>/source.z42
//     → artifacts/build/libraries/<lib>/tests/<name>/source.zbc           (dir)
//   src/tests/<cat>/<name>.z42 + <name>.expected_output.txt
//     → artifacts/build/tests/<cat>/<name>.zbc                            (flat)
//
// For each case: derive entry name from the .z42 source (mirrors the C#
// GoldenTests resolution: `<namespace>.Main` > `Main` > `<namespace>.main` >
// `main`), then run `z42vm <artifact> <entry> --mode <mode>` and diff stdout
// against the expected file.
//
// Parallel mode: spawn `jobs` subprocesses per batch via Process.Spawn,
// wait on the batch, then aggregate. Output is collected into per-job
// strings and printed in original order so the terminal stays readable.
//
// Goldens deliberately run against the DEBUG vm binary at
// artifacts/build/runtime/debug/z42vm (the caller _testE2e builds it first).
// `modes` / `jobs` arrive as parameters (the former Z42_VM_MODES / Z42_VM_JOBS
// env config is now resolved by _testE2e in xtask_test.z42).
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Text;

// Returns 0 if every case in every mode passes, 1 on any failure (or setup error).
// shardK/shardN (both > 0) split the golden set across parallel CI machines: a
// shard keeps cases whose stable enumeration index ≡ shardK-1 (mod shardN). 0/0 =
// run all. The empty-set guard runs on the FULL set so a (legitimately) empty shard
// is not an error.
int _runVmGoldens(string[] modes, int jobs, int shardK, int shardN) {
    return _runVmGoldensF(modes, jobs, shardK, shardN, "", "");
}

// `test e2e` sub-selection: dirFilter narrows to one src/tests/<cat>; fileFilter
// matches a case by name or a source-path substring. Both "" = run everything.
int _runVmGoldensF(string[] modes, int jobs, int shardK, int shardN, string dirFilter, string fileFilter) {
    string root = _root();
    if (jobs < 1) { jobs = 1; }

    // --toolchain (compile-once P3): run goldens on the toolchain's z42vm (release)
    // when a toolchain is selected; else the build-tree debug binary.
    string vmBin = _activeVm(root, "debug");
    if (!File.Exists(vmBin)) {
        ConsoleError.WriteLine("error: VM binary not found at " + vmBin);
        ConsoleError.WriteLine("       Build via: cargo build --manifest-path src/runtime/Cargo.toml");
        return 1;
    }

    // Pin Z42_LIBS to the freshly-built stdlib so spawned golden VMs resolve the
    // NEW z42.core, not whatever stale Z42_LIBS the xtask apphost inherited (e.g.
    // an installed .z42/libs). Without this, a golden using a brand-new stdlib
    // function/extern (add-method-invoke-non-generic: Std.Type.GetType) fails at
    // run time with "undefined function" against a stale z42.core, even though it
    // compiled fine. Mirrors the regen step's stdlibDist selection.
    // Z42_HOME (--toolchain) may be an SDK layout (has libs/) or a managed layout
    // (runtimes/, no libs/); use the toolchain libs only when they actually exist,
    // else the build-tree stdlib.
    string tc = _toolchainDir(root);
    string tcLibs = (tc.Length > 0) ? _toolchainLibs(tc) : "";
    string goldenLibs = (tcLibs.Length > 0 && File.Exists(Path.Join(tcLibs, "z42.core.zpkg")))
        ? tcLibs : _libsDir(root);
    Environment.SetEnvironmentVariable("Z42_LIBS", goldenLibs);

    int overallPass = 0;
    int overallFail = 0;

    int mi = 0;
    while (mi < modes.Length) {
        string mode = modes[mi];
        Console.WriteLine("══════════════════════════════════════");
        Console.WriteLine(" Mode: " + mode);
        Console.WriteLine("══════════════════════════════════════");

        _Case[] cases = _enumerateCasesF(root, mode, dirFilter, fileFilter);
        if (cases.Length == 0) {
            if (dirFilter.Length > 0 || fileFilter.Length > 0) {
                ConsoleError.WriteLine("❌ no golden cases match --dir/--file filter.");
            } else {
                ConsoleError.WriteLine("❌ no runnable golden fixtures found.");
                ConsoleError.WriteLine("   Hint: run `xtask build test` first.");
            }
            return 1;
        }
        if (shardN > 0) {
            _Case[] f = new _Case[cases.Length];
            int fc = 0;
            int ci = 0;
            while (ci < cases.Length) {
                if ((ci % shardN) == (shardK - 1)) { f[fc] = cases[ci]; fc = fc + 1; }
                ci = ci + 1;
            }
            _Case[] sized = new _Case[fc];
            ci = 0;
            while (ci < fc) { sized[ci] = f[ci]; ci = ci + 1; }
            cases = sized;
            Console.WriteLine(" shard " + shardK.ToString() + "/" + shardN.ToString()
                + ": " + cases.Length.ToString() + " cases");
        }

        int[] pf = _runVmCases(cases, vmBin, mode, jobs);
        Console.WriteLine("");
        Console.WriteLine("  Result: " + pf[0].ToString() + " passed, "
            + pf[1].ToString() + " failed");
        Console.WriteLine("");

        overallPass = overallPass + pf[0];
        overallFail = overallFail + pf[1];
        mi = mi + 1;
    }

    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Total: " + overallPass.ToString() + " passed, "
        + overallFail.ToString() + " failed");
    Console.WriteLine("══════════════════════════════════════");

    if (overallFail > 0) {
        return 1;
    }
    return 0;
}

// Run all cases for one mode — sequential (jobs<=1) or parallel batches.
// Returns [pass, fail].
int[] _runVmCases(_Case[] cases, string vmBin, string mode, int jobs) {
    if (jobs > 1) { return _runVmBatch(cases, vmBin, mode, jobs); }
    int pass = 0;
    int fail = 0;
    int i = 0;
    while (i < cases.Length) {
        if (_runOneCase(vmBin, cases[i], mode)) { pass = pass + 1; }
        else { fail = fail + 1; }
        i = i + 1;
    }
    int[] res = new int[2];
    res[0] = pass;
    res[1] = fail;
    return res;
}

// Parallel: spawn `jobs` cases per batch, wait on the batch, then judge + print
// failures in original order so the terminal stays readable. Returns [pass, fail].
int[] _runVmBatch(_Case[] cases, string vmBin, string mode, int jobs) {
    int pass = 0;
    int fail = 0;
    int i = 0;
    while (i < cases.Length) {
        int batchSize = jobs;
        if (i + batchSize > cases.Length) { batchSize = cases.Length - i; }

        ProcessHandle[] handles = new ProcessHandle[batchSize];
        _Case[]         batch   = new _Case[batchSize];
        int b = 0;
        while (b < batchSize) {
            batch[b] = cases[i + b];
            handles[b] = _spawnCase(vmBin, batch[b], mode);
            b = b + 1;
        }

        b = 0;
        while (b < batchSize) {
            ProcessResult r = handles[b].Wait();
            if (_judgeResult(batch[b], r)) {
                pass = pass + 1;
            } else {
                _printFailLine(batch[b], r);
                fail = fail + 1;
            }
            b = b + 1;
        }
        i = i + batchSize;
    }
    int[] res = new int[2];
    res[0] = pass;
    res[1] = fail;
    return res;
}

// ── Case shape ───────────────────────────────────────────────────────────

class _Case {
    public string name;
    public string artifact;     // .zbc path
    public string expected;     // expected_output.txt path
    public string entryName;    // <ns>.Main / Main / <ns>.main / main

    public _Case(string name, string artifact, string expected, string entryName) {
        this.name = name;
        this.artifact = artifact;
        this.expected = expected;
        this.entryName = entryName;
    }
}

// ── Execution ────────────────────────────────────────────────────────────

bool _runOneCase(string vmBin, _Case c, string mode) {
    ProcessResult r;
    try {
        r = new Process(vmBin)
            .Arg(c.artifact).Arg(c.entryName).Arg("--mode").Arg(mode)
            .Run();
    } catch (Exception e) {
        Console.WriteLine("  FAIL: " + c.name);
        Console.WriteLine("    (spawn error: " + e.Message + ")");
        return false;
    }
    bool ok = _judgeResult(c, r);
    if (!ok) { _printFailLine(c, r); }
    return ok;
}

ProcessHandle _spawnCase(string vmBin, _Case c, string mode) {
    return new Process(vmBin)
        .Arg(c.artifact).Arg(c.entryName).Arg("--mode").Arg(mode)
        .Stdout(Stdio.Pipe())
        .Stderr(Stdio.Pipe())
        .Spawn();
}

bool _judgeResult(_Case c, ProcessResult r) {
    // bash: actual=$(... 2>&1) — merge stderr into stdout. We approximate
    // with concatenation (stderr-empty on pass, so ordering doesn't matter).
    // bash $(...) also strips trailing newlines from both sides — mirror that.
    string actual = _stripTrailingNewlines(r.Stdout + r.Stderr);
    string expected = "";
    if (File.Exists(c.expected)) {
        expected = _stripTrailingNewlines(File.ReadAllText(c.expected));
    }
    return actual == expected;
}

void _printFailLine(_Case c, ProcessResult r) {
    Console.WriteLine("  FAIL: " + c.name);
    string actual = r.Stdout + r.Stderr;
    string expected = "";
    if (File.Exists(c.expected)) { expected = File.ReadAllText(c.expected); }
    if (expected.Length == 0) {
        Console.WriteLine("    expected: <empty>");
    } else {
        Console.WriteLine("    expected: " + _firstLine(expected));
    }
    Console.WriteLine("    actual:   " + _firstLine(actual));
}

// ── Enumeration ──────────────────────────────────────────────────────────

// `test e2e` filter: keep a case iff it passes the --dir (category) and --file
// (name or source-path substring) narrowing. Both empty = keep all.
bool _e2eIncluded(string cat, string name, string srcPath, string dirFilter, string fileFilter) {
    if (dirFilter.Length > 0 && cat != dirFilter) { return false; }
    if (fileFilter.Length > 0) {
        if (name == fileFilter) { return true; }
        string norm = srcPath.Replace("\\", "/");
        string f = fileFilter.Replace("\\", "/");
        if (!norm.Contains(f)) { return false; }
    }
    return true;
}

_Case[] _enumerateCases(string root, string mode) {
    return _enumerateCasesF(root, mode, "", "");
}

_Case[] _enumerateCasesF(string root, string mode, string dirFilter, string fileFilter) {
    _Case[] cases = new _Case[64];
    int n = 0;

    // Dir mode part 1: src/tests/<cat>/<name>/
    string testsDir = Path.Join(root, "src/tests");
    string[] cats = _enumDirsSorted(testsDir);
    int ci = 0;
    while (ci < cats.Length) {
        string catDir = Path.Join(testsDir, cats[ci]);
        if (_isNonRunnableCat(cats[ci])) { ci = ci + 1; continue; }
        if (dirFilter.Length > 0 && cats[ci] != dirFilter) { ci = ci + 1; continue; }
        string[] names = _enumDirsSorted(catDir);
        int ni = 0;
        while (ni < names.Length) {
            string dir = Path.Join(catDir, names[ni]);
            if (_isExcludedDirName(cats[ci], names[ni])) { ni = ni + 1; continue; }
            if (!_e2eIncluded(cats[ci], names[ni], Path.Join(dir, "source.z42"), dirFilter, fileFilter)) { ni = ni + 1; continue; }
            // run-golden .zbc lives in the artifacts mirror, not beside source.z42
            // (redirect-golden-zbc-to-artifacts). Sidecars (expected_output.txt,
            // interp_only, source.z42 for entry derivation) stay in src `dir`.
            string artifact = Path.Join(
                _goldenArtifactDir(root, Path.Join(Path.Join("tests", cats[ci]), names[ni])),
                "source.zbc");
            if (File.Exists(artifact)) {
                if (mode == "jit" && File.Exists(Path.Join(dir, "interp_only"))) {
                    ni = ni + 1;
                    continue;
                }
                string expected = Path.Join(dir, "expected_output.txt");
                string entry = _deriveEntry(Path.Join(dir, "source.z42"));
                _Case c = new _Case(names[ni], artifact, expected, entry);
                cases = _appendCase(cases, n, c);
                n = n + 1;
            }
            ni = ni + 1;
        }
        ci = ci + 1;
    }

    // Dir mode part 2: src/libraries/<lib>/tests/<name>/ — library golden tests are
    // not a src/tests category, so a --dir <cat> filter excludes them entirely.
    string libsRoot = Path.Join(root, "src/libraries");
    string[] libs = (dirFilter.Length > 0) ? new string[0] : _enumDirsSorted(libsRoot);
    int li = 0;
    while (li < libs.Length) {
        string libTests = Path.Join(libsRoot, libs[li] + "/tests");
        if (Directory.Exists(libTests)) {
            string[] names = _enumDirsSorted(libTests);
            int ni = 0;
            while (ni < names.Length) {
                string dir = Path.Join(libTests, names[ni]);
                if (fileFilter.Length > 0 && !_e2eIncluded("", names[ni], Path.Join(dir, "source.z42"), "", fileFilter)) { ni = ni + 1; continue; }
                // [Test]/[Benchmark] dir tests (e.g. z42.crypto/tests/secp256k1)
                // have no Main and are run by `test lib` via z42-test-runner — the
                // golden runner must skip them (else "entry function …Main not
                // found"). Mirrors the C# GoldenTests src/libraries [Test]-dir
                // exclusion (7b2a1b2a) + xtask test-lib discovery (902ce26c).
                if (_dirHasTestMethods(dir)) { ni = ni + 1; continue; }
                // run-golden .zbc → artifacts mirror; sidecars stay in src `dir`.
                string artifact = Path.Join(
                    _goldenArtifactDir(root,
                        Path.Join(Path.Join(Path.Join("libraries", libs[li]), "tests"), names[ni])),
                    "source.zbc");
                if (File.Exists(artifact)) {
                    if (mode == "jit" && File.Exists(Path.Join(dir, "interp_only"))) {
                        ni = ni + 1;
                        continue;
                    }
                    string expected = Path.Join(dir, "expected_output.txt");
                    string entry = _deriveEntry(Path.Join(dir, "source.z42"));
                    _Case c = new _Case(names[ni], artifact, expected, entry);
                    cases = _appendCase(cases, n, c);
                    n = n + 1;
                }
                ni = ni + 1;
            }
        }
        li = li + 1;
    }

    // Flat mode: src/tests/<cat>/<name>.zbc
    ci = 0;
    while (ci < cats.Length) {
        if (_isNonRunnableCat(cats[ci])) { ci = ci + 1; continue; }
        if (dirFilter.Length > 0 && cats[ci] != dirFilter) { ci = ci + 1; continue; }
        string catDir = Path.Join(testsDir, cats[ci]);
        // flat run-golden .zbc → artifacts mirror; sidecars (.interp_only,
        // .expected_output.txt, .z42) stay in src `catDir`.
        string mirrorCat = _goldenArtifactDir(root, Path.Join("tests", cats[ci]));
        string[] hits = Path.Glob(mirrorCat, "*.zbc");
        int hi = 0;
        while (hi < hits.Length) {
            string artifact = hits[hi];
            string name = Path.GetFileNameWithoutExtension(artifact);
            if (fileFilter.Length > 0 && !_e2eIncluded(cats[ci], name, Path.Join(catDir, name + ".z42"), dirFilter, fileFilter)) { hi = hi + 1; continue; }
            string interpMarker = Path.Join(catDir, name + ".interp_only");
            if (mode == "jit" && File.Exists(interpMarker)) {
                hi = hi + 1;
                continue;
            }
            string expected = Path.Join(catDir, name + ".expected_output.txt");
            string srcFile = Path.Join(catDir, name + ".z42");
            string entry = _deriveEntry(srcFile);
            _Case c = new _Case(name, artifact, expected, entry);
            cases = _appendCase(cases, n, c);
            n = n + 1;
            hi = hi + 1;
        }
        ci = ci + 1;
    }

    // Trim to exact length.
    _Case[] tight = new _Case[n];
    int t = 0;
    while (t < n) { tight[t] = cases[t]; t = t + 1; }
    return tight;
}

_Case[] _appendCase(_Case[] arr, int count, _Case v) {
    if (count < arr.Length) {
        arr[count] = v;
        return arr;
    }
    int newCap = arr.Length * 2;
    if (newCap < 4) { newCap = 4; }
    _Case[] bigger = new _Case[newCap];
    int i = 0;
    while (i < count) { bigger[i] = arr[i]; i = i + 1; }
    bigger[count] = v;
    return bigger;
}
