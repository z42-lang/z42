// xtask — 学习手册（docs/learn）↔ examples 的双向引用校验。不需要 SDK，秒级。
//
// mdBook 对 include 出错非常宽容：文件缺失只打一行 ERROR、原样保留指令文本，锚点缺失连日志都没有、
// 渲染成空代码块，退出码都是 0。所以这些规则必须由这里强制：
//   B1 include 的文件存在                 B2 锚点存在且 ANCHOR / ANCHOR_END 成对
//   B3 禁止行号 include 与 rustdoc_include / playground
//   B4 整文件 include 的目标不得含锚点行（否则锚点行会被渲染出来）
//   B5 页面 <p>.md 只能 include examples/<p>/ 下的文件（章节之间零耦合）
//   B6 z42 / console 代码块的正文必须恰好是一条 include（书里不出现未经验证的代码与输出）
//   B7 每个 .console 都被某页 include        B8 每个工程目录都被某个 .console 的沙箱覆盖
//   B9 examples 下每个章节目录都对应一页     B10 SUMMARY 与页面文件一一对应
namespace Z42Xtask;

using Std;
using Std.IO;

// 返回违规条数（每条已打印）。
int _checkLearnBook(string root) {
    string src = Path.Join(root, "docs/learn/src");
    string ex = Path.Join(root, "examples");
    if (!Directory.Exists(src)) { ConsoleError.WriteLine("  ✗ docs/learn/src missing"); return 1; }
    string[] pages = _learnPages(src);
    string[] included = new string[0];
    int bad = 0;
    int i = 0;
    while (i < pages.Length) {
        PageCheck pc = _checkLearnPage(root, src, pages[i]);
        bad = bad + pc.Bad;
        included = _concatStrings(included, pc.Included);
        i = i + 1;
    }
    bad = bad + _checkSummary(src, pages);
    bad = bad + _checkExamplesCoverage(root, ex, pages, included);
    bad = bad + _checkProseDiagCodes(root, src, pages);
    return bad;
}

// B11：**正文里引用的诊断码，必须出现在该章自己的 transcript 里**（否则登记进 allowlist）。
//
// 为什么需要这道门：全书的代码与输出都由 `.console` 重放钉着——改坏了判红。而**正文不受任何
// 门禁管**，于是正文里写的诊断码会随着码被重排而烂掉，且烂得毫无声息。
// 实例（2026-09-23 抓到）：第 16 章正文写 `E0470`，而「赋值目标不是左值」这条码早已经
// `enforce-diagnostic-code-uniqueness` 归位两次（#749 → E0477，#759/#762 → E0482）。
// **同章的 run.console 是对的**（写着 E0482，它被重放）⇒ 正文与 transcript 自相矛盾而没人发现。
// 更阴的是 E0470 是个**活着的、完全不同**的诊断（`ref` 实参不可取址）——不是「码不存在」，
// 而是静默指向别的东西，存在性检查抓不到它。
//
// 例外（正文提及但本章不演示，如「写 `a ?? b` 会报 E0480」）登记在
// `scripts/test/learn-prose-diag-allow.txt`（`<页面路径> <码>` 每行一条）。
// 这份清单**只应缩短**：给某条加演示示例后就把它删掉。
int _checkProseDiagCodes(string root, string src, string[] pages) {
    string allowPath = Path.Join(root, "scripts/test/learn-prose-diag-allow.txt");
    string allow = File.Exists(allowPath) ? File.ReadAllText(allowPath) : "";
    int bad = 0;
    int i = 0;
    while (i < pages.Length) {
        string page = pages[i];
        string[] codes = _diagCodesIn(File.ReadAllText(Path.Join(src, page)));
        if (codes.Length > 0) {
            string tx = _transcriptTextFor(root, page);
            int c = 0;
            while (c < codes.Length) {
                string code = codes[c];
                bool allowed = allow.Contains(page + " " + code);
                if (!allowed && !tx.Contains(code)) {
                    ConsoleError.WriteLine("  ✗ B11 docs/learn/src/" + page + " — 正文引用 " + code
                        + " 但本章 transcript 里没有它（码被重排过？给它加个演示示例，或登记进 scripts/test/learn-prose-diag-allow.txt）");
                    bad = bad + 1;
                }
                c = c + 1;
            }
        }
        i = i + 1;
    }
    return bad;
}

// 文本里出现的全部 `E####` / `W####`（去重，出现序）。
string[] _diagCodesIn(string text) {
    string[] acc = new string[16];
    int n = 0;
    int i = 0;
    while (i + 4 < text.Length) {
        char c = text.CharAt(i);
        if ((c == 'E' || c == 'W') && _allDigits(text, i + 1, 4)) {
            string code = text.Substring(i, 5);
            bool dup = false;
            int k = 0;
            while (k < n) { if (acc[k] == code) { dup = true; } k = k + 1; }
            if (!dup && n < acc.Length) { acc[n] = code; n = n + 1; }
            i = i + 5;
        } else { i = i + 1; }
    }
    string[] outp = new string[n];
    int j = 0;
    while (j < n) { outp[j] = acc[j]; j = j + 1; }
    return outp;
}

bool _allDigits(string text, int from, int count) {
    int i = 0;
    while (i < count) {
        if (from + i >= text.Length) { return false; }
        char c = text.CharAt(from + i);
        if (c < '0' || c > '9') { return false; }
        i = i + 1;
    }
    return true;
}

// 该页对应的 examples 目录下全部 `.console` 文本拼起来（页面 `a/b.md` → `examples/a/b/**`）。
string _transcriptTextFor(string root, string page) {
    string stem = page.EndsWith(".md") ? page.Substring(0, page.Length - 3) : page;
    string dir = Path.Join(Path.Join(root, "examples"), stem);
    if (!Directory.Exists(dir)) { return ""; }
    string acc = "";
    // ⚠️ `Directory.EnumerateRecursive` 返回的是**相对于 dir 的相对路径**（同 `_learnPages` 的用法），
    // 必须自己 join 回去才能读 —— 直接拿它喂 `ReadAllText` 会抛 `No such file or directory`
    // （本门禁第一版就是这么崩的）。再 `File.Exists` 过一道，挡住目录条目。
    string[] all = Directory.EnumerateRecursive(dir);
    int i = 0;
    while (i < all.Length) {
        if (all[i].EndsWith(".console")) {
            string full = Path.Join(dir, all[i]);
            if (File.Exists(full)) { acc = acc + File.ReadAllText(full); }
        }
        i = i + 1;
    }
    return acc;
}

// docs/learn/src 下全部 .md（相对路径，正斜杠，字典序），不含 SUMMARY.md。
string[] _learnPages(string src) {
    string[] all = _sortedStrings(Directory.EnumerateRecursive(src));
    string[] acc = new string[all.Length];
    int n = 0;
    int i = 0;
    while (i < all.Length) {
        string rel = all[i].Replace("\\", "/");
        if (rel.EndsWith(".md") && rel != "SUMMARY.md") { acc[n] = rel; n = n + 1; }
        i = i + 1;
    }
    string[] r = new string[n];
    int k = 0;
    while (k < n) { r[k] = acc[k]; k = k + 1; }
    return r;
}

// 一页的检查结果：违规条数 + 该页 include 到的文件（绝对路径）。
// （不用 `ref string[]` 出参：release 构建下逃逸分析会把该数组栈分配，出帧后失效。）
class PageCheck {
    public int      Bad      { get; set; }
    public string[] Included { get; set; }
}

PageCheck _checkLearnPage(string root, string src, string page) {
    string mdPath = Path.Join(src, page);
    string mdDir = Path.GetDirectoryName(mdPath);
    string[] lines = File.ReadAllText(mdPath).Replace("\r\n", "\n").Split("\n");
    string mirror = _collapseDots(Path.Join(root, "examples/" + page.Substring(0, page.Length - 3))) + "/";
    string[] got = new string[lines.Length];
    int gn = 0;
    int bad = 0;
    bool inFence = false;
    string fenceLang = "";
    bool fenceIgnore = false;
    string body = "";
    int fenceLine = 0;
    int li = 0;
    while (li < lines.Length) {
        string l = lines[li];
        string loc = "docs/learn/src/" + page + ":" + (li + 1).ToString();
        if (l.TrimStart().StartsWith("```")) {
            if (!inFence) {
                inFence = true; body = ""; fenceLine = li + 1;
                string info = l.Trim().Substring(3).Trim();
                string[] parts = info.Split(",");
                fenceLang = parts.Length > 0 ? parts[0].Trim() : "";
                fenceIgnore = _strArrHasTrimmed(parts, "ignore");
                bad = bad + _checkExampleAttr(root, parts, loc);
            } else {
                inFence = false;
                if ((fenceLang == "z42" || fenceLang == "console") && !fenceIgnore
                        && !_isSingleInclude(body)) {
                    // ```z42 另允许「一行 `// <出处>` 注释 + 一条 include」，注释须与 include 同指一个文件。
                    string why = fenceLang == "z42" ? _fencePathComment(body, mdDir) : "console blocks take no path comment";
                    if (why != "") {
                        ConsoleError.WriteLine("  ✗ B6 " + "docs/learn/src/" + page + ":" + fenceLine.ToString()
                            + " — ```" + fenceLang + " block must be exactly one {{#include}} from examples/"
                            + (fenceLang == "z42" ? ", optionally preceded by a `// <path>` comment" : "")
                            + " (or mark it `" + fenceLang + ",ignore`): " + why);
                        bad = bad + 1;
                    }
                }
            }
        } else if (inFence) {
            body = body + l + "\n";
        }
        int at = l.IndexOf("{{#");
        if (at >= 0) {
            int end = l.IndexOf("}}");
            string directive = end > at ? l.Substring(at + 3, end - at - 3).Trim() : l.Substring(at + 3);
            string resolved = "";
            bad = bad + _checkIncludeDirective(mdDir, mirror, directive, loc, ref resolved);
            if (resolved.Length > 0) { got[gn] = resolved; gn = gn + 1; }
        }
        li = li + 1;
    }
    string[] r = new string[gn];
    int k = 0;
    while (k < gn) { r[k] = got[k]; k = k + 1; }
    PageCheck pc = new PageCheck();
    pc.Bad = bad;
    pc.Included = r;
    return pc;
}

// 一条 `{{#…}}` 指令：B1–B5。resolved = 目标文件的绝对路径（校验通过时）。
int _checkIncludeDirective(string mdDir, string mirror, string directive, string loc, ref string resolved) {
    if (!directive.StartsWith("include ")) {
        ConsoleError.WriteLine("  ✗ B3 " + loc + " — only {{#include}} is allowed (got {{#" + directive + "}})");
        return 1;
    }
    string arg = directive.Substring(8).Trim();
    string file = arg;
    string anchor = "";
    int colon = arg.IndexOf(":");
    if (colon >= 0) { file = arg.Substring(0, colon); anchor = arg.Substring(colon + 1); }
    if (anchor.Length > 0 && _isDigits(anchor.Substring(0, 1))) {
        ConsoleError.WriteLine("  ✗ B3 " + loc + " — line-range include `" + arg + "`: use an ANCHOR instead");
        return 1;
    }
    string target = _collapseDots(Path.Join(mdDir, file));
    if (!File.Exists(target)) {
        ConsoleError.WriteLine("  ✗ B1 " + loc + " — included file does not exist: " + file);
        return 1;
    }
    if (!target.StartsWith(mirror)) {
        ConsoleError.WriteLine("  ✗ B5 " + loc + " — this page may only include files under " + _repoRel(mirror) + " (got " + _repoRel(target) + ")");
        return 1;
    }
    // Windows 检出可能是 CRLF（core.autocrlf）：统一成 LF 再找锚点行。
    string text = File.ReadAllText(target).Replace("\r\n", "\n");
    if (anchor.Length == 0) {
        if (text.Contains("ANCHOR:") || text.Contains("ANCHOR_END:")) {
            ConsoleError.WriteLine("  ✗ B4 " + loc + " — whole-file include of a file with ANCHOR lines (they would be rendered): include an anchor");
            return 1;
        }
    } else if (!text.Contains("ANCHOR: " + anchor + "\n") || !text.Contains("ANCHOR_END: " + anchor)) {
        ConsoleError.WriteLine("  ✗ B2 " + loc + " — anchor `" + anchor + "` not found (need `ANCHOR: " + anchor + "` and `ANCHOR_END: " + anchor + "`) in " + _repoRel(target));
        return 1;
    }
    resolved = target;
    return 0;
}

// 信息串里的 `example=<examples 下相对路径>`（将来 playground 按钮用）必须指向存在的路径。
int _checkExampleAttr(string root, string[] parts, string loc) {
    int i = 0;
    while (i < parts.Length) {
        string p = parts[i].Trim();
        if (p.StartsWith("example=")) {
            string rel = p.Substring(8);
            if (!Directory.Exists(Path.Join(root, "examples/" + rel)) && !File.Exists(Path.Join(root, "examples/" + rel))) {
                ConsoleError.WriteLine("  ✗ B6 " + loc + " — example=" + rel + " does not exist under examples/");
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

bool _isSingleInclude(string body) {
    string t = body.Trim();
    return t.StartsWith("{{#include ") && t.EndsWith("}}") && t.IndexOf("\n") < 0;
}

// B6 的第二种合法形态（仅 ```z42）：**一行出处注释 + 一条 include**。
//
//   ```z42
//   // examples/basics/variables/types/types.z42
//   {{#include ../../../../examples/basics/variables/types/types.z42:decl}}
//   ```
//
// 注释是给读者看「这段代码是哪个文件里的」。**门禁校验它与 include 指向同一个文件** ——
// 这正是它比页面上手写的加粗标注强的地方：标注没人管，改了 include 忘了改标注不会判红，
// 而这里会。返回 "" 表示合法，否则返回要报给用户的原因。
string _fencePathComment(string body, string mdDir) {
    string t = body.Trim();
    int nl = t.IndexOf("\n");
    if (nl < 0) { return "not a two-line body"; }
    string first = t.Substring(0, nl).Trim();
    string rest  = t.Substring(nl + 1).Trim();
    if (!first.StartsWith("// ")) { return "first line must be a `// <path>` comment"; }
    if (!_isSingleInclude(rest)) { return "second line must be exactly one {{#include}}"; }
    string claimed = first.Substring(3).Trim();
    // include 的实参（去掉 `:锚点`）→ 仓库相对路径，与注释比对。
    int a0 = rest.IndexOf("{{#include ") + 11;
    int a1 = rest.IndexOf("}}");
    string arg = rest.Substring(a0, a1 - a0).Trim();
    int colon = arg.IndexOf(":");
    if (colon >= 0) { arg = arg.Substring(0, colon); }
    string actual = _repoRel(_collapseDots(Path.Join(mdDir, arg)));
    if (claimed != actual) {
        return "path comment `" + claimed + "` does not match the include target `" + actual + "`";
    }
    return "";
}

// B10：SUMMARY.md 里的每个链接指向存在的页面；每个页面都在 SUMMARY 里。
int _checkSummary(string src, string[] pages) {
    string summary = File.ReadAllText(Path.Join(src, "SUMMARY.md"));
    int bad = 0;
    int i = 0;
    while (i < pages.Length) {
        if (!summary.Contains("](" + pages[i] + ")")) {
            ConsoleError.WriteLine("  ✗ B10 docs/learn/src/" + pages[i] + " is not listed in SUMMARY.md");
            bad = bad + 1;
        }
        i = i + 1;
    }
    string[] parts = summary.Split("](");
    int k = 1;
    while (k < parts.Length) {
        int close = parts[k].IndexOf(")");
        string link = close >= 0 ? parts[k].Substring(0, close) : "";
        if (link.EndsWith(".md") && !File.Exists(Path.Join(src, link))) {
            ConsoleError.WriteLine("  ✗ B10 SUMMARY.md links to a missing page: " + link);
            bad = bad + 1;
        }
        k = k + 1;
    }
    return bad;
}

// B7 / B8 / B9：examples 这一侧没有孤儿。
int _checkExamplesCoverage(string root, string ex, string[] pages, string[] included) {
    if (!Directory.Exists(ex)) { return 0; }
    string[] files = _sortedStrings(Directory.EnumerateRecursive(ex));
    string[] consoleDirs = new string[files.Length];
    int cdn = 0;
    int bad = 0;
    int i = 0;
    while (i < files.Length) {
        string rel = files[i].Replace("\\", "/");
        string abs = _collapseDots(Path.Join(ex, rel));
        if (rel.EndsWith(".console")) {
            consoleDirs[cdn] = Path.GetDirectoryName(abs) + "/"; cdn = cdn + 1;
            if (!_strArrHas(included, abs)) {
                ConsoleError.WriteLine("  ✗ B7 examples/" + rel + " is not included by any page");
                bad = bad + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < files.Length) {
        string rel = files[i].Replace("\\", "/");
        if (rel.EndsWith("z42.toml")) {
            string projDir = _collapseDots(Path.GetDirectoryName(Path.Join(ex, rel))) + "/";
            if (!_underAny(projDir, consoleDirs, cdn)) {
                ConsoleError.WriteLine("  ✗ B8 examples/" + rel + " — project is not exercised by any .console (put one in its directory or a parent)");
                bad = bad + 1;
            }
        }
        if (rel.EndsWith(".z42") || rel.EndsWith(".console") || rel.EndsWith("z42.toml")) {
            if (!_hasChapterPage(rel, pages)) {
                ConsoleError.WriteLine("  ✗ B9 examples/" + rel + " — no page docs/learn/src/<part>/<chapter>.md for its chapter directory");
                bad = bad + 1;
            }
        }
        i = i + 1;
    }
    return bad;
}

// examples/<a>/<b>/... ↔ 页面 <a>/<b>.md
bool _hasChapterPage(string rel, string[] pages) {
    int i = 0;
    while (i < pages.Length) {
        string chapter = pages[i].Substring(0, pages[i].Length - 3) + "/";
        if (rel.StartsWith(chapter)) { return true; }
        i = i + 1;
    }
    return false;
}

bool _underAny(string dir, string[] prefixes, int n) {
    int i = 0;
    while (i < n) { if (dir.StartsWith(prefixes[i])) { return true; } i = i + 1; }
    return false;
}

bool _strArrHasTrimmed(string[] a, string v) {
    int i = 0;
    while (i < a.Length) { if (a[i].Trim() == v) { return true; } i = i + 1; }
    return false;
}

bool _isDigits(string s) {
    if (s.Length == 0) { return false; }
    int i = 0;
    while (i < s.Length) {
        string c = s.Substring(i, 1);
        if (c.CompareTo("0") < 0 || c.CompareTo("9") > 0) { return false; }
        i = i + 1;
    }
    return true;
}

string[] _concatStrings(string[] a, string[] b) {
    string[] r = new string[a.Length + b.Length];
    int i = 0;
    while (i < a.Length) { r[i] = a[i]; i = i + 1; }
    int k = 0;
    while (k < b.Length) { r[a.Length + k] = b[k]; k = k + 1; }
    return r;
}

string _repoRel(string abs) {
    string root = _collapseDots(_root()) + "/";
    return abs.StartsWith(root) ? abs.Substring(root.Length) : abs;
}

bool _strArrHas(string[] a, string v) {
    int i = 0;
    while (i < a.Length) { if (a[i] == v) { return true; } i = i + 1; }
    return false;
}
