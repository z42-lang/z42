// xtask — `test dist` 的编译期扩展冒烟：**在打出来的包上**验 analyzer/generator 整条链。
//
// 🔴 **为什么必须在发布态验**：这条链的 e2e（`xtask_compiler_e2e_analyzer.z42`）跑在**开发树**里
// —— `Z42_LIBS` 指向 build-tree 的扁平 dist，契约包靠 `_compilerDomainDirs()` 探测序的**最后一档**
// （自 Z42_LIBS 上溯到 artifacts/build/）命中。发布态走的是完全不同的一档（`Z42_HOME/programs/z42c`），
// 开发树那格**证明不了它**。
//
// 代价是实打实吃过的：`add-package-roles` 批 1 声称打通了「用户能写 generator」，开发树的门一直绿，
// 而**发布态那条路是断的** —— 契约 zpkg 落在 `programs/z42c/`，解析器却去看一个发布包里**恒不存在**
// 的 `compiler-libs/`。插件作者拿到的是一句位置在别处的 `E0443: undefined type`，没有任何东西诊断它。
// 这个缺口潜伏到 `relocate-compiler-domain-libs`（2026-09-27）才被翻出来 —— 潜伏得了，正因为**没有
// 发布态的门**。本文件就是那道门。
//
// 三格，按用户的实际动作排：
//   ① 写 analyzer 工程（`kind = "analyzer"` + 依赖契约包）⇒ **用包里的 z42c** 编得过；
//   ② 普通工程 `[analyzers]` 挂上它 ⇒ 编得过，且 generator 生成的代码**真能跑**（输出 42）；
//   ③ 同一份源码改成 `kind = "lib"` ⇒ **必须编不过**。少了这格，①「编过了」可能只是因为契约包
//      对所有工程都可见（那样解析域隔离就没了，而 `libs/` 里曾经确实漏过编译器域包）。
namespace Z42Xtask;

using Std;
using Std.IO;

string _distAnalyzerGenSrc() {
    return "namespace DistGen;\n\nusing Std;\nusing Z42.Semantics;\n\n"
         + "public sealed class DistProbeGenerator : ModuleGenerator {\n"
         + "    public void Generate(GenContext ctx, GenSink sink) {\n"
         + "        sink.AddSource(\"distgen\", \"namespace DistOut; public static class O { public static int V() { return 42; } }\");\n"
         + "    }\n"
         + "    public string[] Consumes() { return new string[0]; }\n"
         + "    public string[] Produces() { return new string[0]; }\n"
         + "}\n";
}

string _distAnalyzerToml(string kind) {
    return "[project]\nname    = \"dist.gen\"\nversion = \"0.1.0\"\nkind    = \"" + kind + "\"\n\n"
         + "[sources]\ninclude = [\"*.z42\"]\n\n"
         + "[dependencies]\n\"z42c.semantics\" = \"0.1.0\"\n";
}

// 包里的 z42c（Windows 带 .exe）。`Z42_HOME` 指向包根 —— 那正是用户装完 SDK 后的形态。
ProcessResult _distZ42c(string distDir, string cwd, string toml) {
    string z42c = Path.Join(distDir, "bin/z42c");
    if (!File.Exists(z42c)) { z42c = z42c + ".exe"; }
    return new Process(z42c).WorkingDirectory(cwd)
        .Arg("build").Arg(toml).Arg("--release")
        .EnvRemove("Z42_LIBS").EnvRemove("Z42_PORTABLE_VM").EnvRemove("Z42_COMPILER_LIBS")
        .Env("Z42_HOME", distDir)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
}

// 返回 [pass, fail]。
int[] _analyzerDistSmoke(string distDir, string work) {
    int[] acc = new int[2];
    acc[0] = 0; acc[1] = 0;
    string z42cBin = Path.Join(distDir, "bin/z42c");
    if (!File.Exists(z42cBin)) { z42cBin = z42cBin + ".exe"; }
    if (!File.Exists(z42cBin)) {
        Console.WriteLine("Analyzer smoke: SKIP (bin/z42c not in package)");
        Console.WriteLine("");
        return acc;
    }
    Console.WriteLine("Analyzer smoke (编译期扩展，发布态): " + distDir);

    string gen = Path.Join(work, "anlz/gen");
    string app = Path.Join(work, "anlz/app");
    string lib = Path.Join(work, "anlz/aslib");
    Directory.Create(gen); Directory.Create(app); Directory.Create(lib);

    // ① analyzer 工程：用包里的 z42c 编得过（契约包从 `<pkg>/programs/z42c/` 解析）。
    File.WriteAllText(Path.Join(gen, "gen.z42"), _distAnalyzerGenSrc());
    File.WriteAllText(Path.Join(gen, "dist.gen.z42.toml"), _distAnalyzerToml("analyzer"));
    ProcessResult g = _distZ42c(distDir, gen, "dist.gen.z42.toml");
    acc = _distCheck(acc, g.ExitCode == 0, "kind=analyzer 工程用包里的 z42c 编得过", g);

    // ② 消费方挂 `[analyzers]` ⇒ 编得过，且 generator 产的代码真能跑。
    File.WriteAllText(Path.Join(app, "main.z42"),
        "using Std;\nusing Std.IO;\nusing DistOut;\n\nvoid Main() { Console.WriteLine(O.V().ToString()); }\n");
    File.WriteAllText(Path.Join(app, "app.z42.toml"),
        "[project]\nname    = \"anlzapp\"\nversion = \"0.1.0\"\nkind    = \"exe\"\n\n"
        + "[sources]\ninclude = [\"*.z42\"]\n\n"
        + "[analyzers]\n\"dist.gen\" = { path = \"../gen\" }\n");
    ProcessResult b = _distZ42c(distDir, app, "app.z42.toml");
    acc = _distCheck(acc, b.ExitCode == 0, "普通工程 [analyzers] 挂上 generator 后编得过", b);

    string vm = Path.Join(distDir, "bin/z42vm");
    if (!File.Exists(vm)) { vm = vm + ".exe"; }
    ProcessResult r = new Process(vm).WorkingDirectory(app).Arg("dist/anlzapp.zpkg")
        .EnvRemove("Z42_LIBS").EnvRemove("Z42_PORTABLE_VM").Env("Z42_HOME", distDir)
        .Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    acc = _distCheck(acc, r.ExitCode == 0 && r.Stdout.Trim() == "42",
        "generator 生成的代码在发布态真能跑（42）", r);

    // ③ 判别力：同一份源码写 kind=lib ⇒ 必须编不过，且错因指向契约包。
    //    编过了说明契约包对**普通**工程也可见 —— 那样 ① 的「编过」什么都证明不了
    //    （`libs/` 里曾经确实漏过编译器域包，2026-09-28 才修）。
    File.WriteAllText(Path.Join(lib, "gen.z42"), _distAnalyzerGenSrc());
    File.WriteAllText(Path.Join(lib, "dist.gen.z42.toml"), _distAnalyzerToml("lib"));
    ProcessResult l = _distZ42c(distDir, lib, "dist.gen.z42.toml");
    bool refused = l.ExitCode != 0
        && (l.Stderr.IndexOf("Z42.Semantics") >= 0 || l.Stderr.IndexOf("z42c.semantics") >= 0
            || l.Stderr.IndexOf("ModuleGenerator") >= 0 || l.Stderr.IndexOf("GenContext") >= 0);
    acc = _distCheck(acc, refused, "同源码 kind=lib 编不过，且错因指向契约包（解析域隔离仍在）", l);

    Console.WriteLine("");
    return acc;
}
