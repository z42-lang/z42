// `xtask test app <desktop|wasm|ios|android|all> [stage|build|assets|bundle|run] [--filter] [--shard k/n]
//               [--format json|pretty|tap] [--zbc <file|golden-dir>]` —— 嵌入宿主测试一条命令（test-layout.md §6）。
// desktop 也是一个嵌入宿主（C ABI 宿主），与 wasm / iOS / Android 同一条流水线；本地与 CI 走同一路径：
//
//   准备 test agent（设备平台）→ 平台 R1–R7（分片时只在第 1 片）→ 组嵌入 bundle → 构建宿主（副本里）→ 运行 → 报告
//
// 带 step 时只做那一步（调试用）：stage = 同步宿主工程副本；build = 原生构建；assets = R1–R7 夹具 + stdlib；
// bundle = 组嵌入语料 bundle 并放进宿主；run = 在宿主 / 设备上运行。各步本身（宿主副本、z42b 设备驱动、
// bundle 构建）在 xtask_test_{platform,embedded,device_host}.z42 里。
//
// 本机不具备的平台**跳过**并说明原因，不算失败（非 macOS / 没装 Xcode 跑不了 iOS；Linux 没有 KVM 且没有
// 接着的设备跑不了 Android）。`all` 跑本机支持的全部平台，最后给一张汇总表。
namespace Z42Xtask;

using Std.IO;
using Std.Cli;

int _testApp(ParseResult r) {
    string which = r.GetPositional(0);
    string step = r.GetPositional(1);
    string filter = r.GetOption("filter");
    string format = r.GetOption("format");
    string zbc = r.GetOption("zbc");
    int[] sh = _parseShard(r.GetOption("shard"));
    string[] plats;
    if (which == "all") { plats = new string[]{ "desktop", "wasm", "ios", "android" }; }
    else if (which == "desktop" || which == "wasm" || which == "ios" || which == "android") { plats = new string[]{ which }; }
    else {
        ConsoleError.WriteLine("error: xtask test app <desktop|wasm|ios|android|all> — unknown platform '" + which + "'");
        return 2;
    }
    if (step.Length > 0 && step != "stage" && step != "build" && step != "assets" && step != "bundle" && step != "run") {
        ConsoleError.WriteLine("error: xtask test app " + which + " — unknown step '" + step + "' (stage | build | assets | bundle | run)");
        return 2;
    }
    if (step.Length > 0 && which == "all") {
        ConsoleError.WriteLine("error: a single step needs a single platform (xtask test app <platform> " + step + ")");
        return 2;
    }
    if (zbc.Length > 0 && which != "desktop") {
        ConsoleError.WriteLine("error: --zbc runs on the desktop host only (xtask test app desktop --zbc <file>)");
        return 2;
    }
    string root = _root();
    // z42b 每次增量重编（源未变时近 no-op）：只查「在不在」会让本地改过 z42b 源后继续跑旧的 z42b。
    int dep = _ensureZ42b(root); if (dep != 0) { return dep; }
    if (zbc.Length > 0) { return _runDesktopEmbedded(root, "", zbc, format, 0, 0); }

    string[] outcome = new string[plats.Length];
    bool failed = false;
    bool agentReady = false;
    int i = 0;
    while (i < plats.Length) {
        string p = plats[i];
        Console.WriteLine("");
        Console.WriteLine("════ test app " + p + (step.Length > 0 ? " " + step : "") + " ════");
        string skip = _appSkipReason(root, p);
        if (skip.Length > 0) {
            Console.WriteLine("  ⏭  skipped: " + skip);
            outcome[i] = "skipped — " + skip;
            i = i + 1;
            continue;
        }
        // 设备平台经 z42b 的设备驱动跑，要从 SDK 里解析 test agent；desktop 在 z42b 进程内跑，不需要。
        if (!agentReady && p != "desktop" && (step.Length == 0 || step == "bundle" || step == "run")) {
            if (_provisionTestAgent(root) != 0) { return 1; }
            agentReady = true;
        }
        int rc = step.Length > 0 ? _testAppStep(root, p, step, filter, format, sh[0], sh[1])
                                 : _testAppOne(root, p, filter, format, sh[0], sh[1]);
        outcome[i] = rc == 0 ? "passed" : "FAILED (exit " + rc.ToString() + ")";
        if (rc != 0) { failed = true; }
        i = i + 1;
    }

    Console.WriteLine("");
    Console.WriteLine("── test app ──");
    int k = 0;
    while (k < plats.Length) { Console.WriteLine("  " + _padRight(plats[k], 10) + outcome[k]); k = k + 1; }
    return failed ? 1 : 0;
}

// 本机跑不了这个平台的原因；能跑返回 ""。只判断宿主条件（OS / 虚拟化 / 设备），缺可安装的工具
// （wasm-pack、cargo-ndk…）不算跳过 —— 那是该装的东西，由各步报错并给出安装提示。
string _appSkipReason(string root, string platform) {
    if (platform == "ios") {
        if (!Platform.IsMacOS()) { return "iOS 模拟器只在 macOS 上有"; }
        if (Process.Which("xcodebuild") == null) { return "没装 Xcode（xcodebuild 不在 PATH）"; }
        return "";
    }
    if (platform == "android") {
        if (Platform.IsLinux() && !File.Exists("/dev/kvm") && !_androidDeviceAttached(root)) {
            return "Linux 上没有 /dev/kvm，Android 模拟器跑不起来（也没有接着的设备）";
        }
        return "";
    }
    return "";
}

// 一个平台的整条流水线。
int _testAppOne(string root, string platform, string filter, string format, int shardK, int shardN) {
    bool firstShard = shardN == 0 || shardK == 1;
    if (platform == "desktop") {
        // C ABI 宿主的 R1–R7（与语料无关，分片时只在第 1 片），再在 z42b 进程内跑嵌入语料。
        if (firstShard) { int c = _platformDispatch("desktop", "", root); if (c != 0) { return c; } }
        return _runDesktopEmbedded(root, filter, "", format, shardK, shardN);
    }
    if (platform == "wasm") {
        // R1–R7 与语料无关，分片时只在第 1 片跑。
        if (firstShard) { int c = _platformDispatch("wasm", "", root); if (c != 0) { return c; } }
        if (_buildWasmTesthost(root, filter, shardK, shardN).Length == 0) { return 1; }
        return _runWasmTesthost(root);
    }
    if (platform == "ios") {
        // iOS 的 R1–R7（Z42VMTests）与嵌入语料（Z42EmbeddedTests）在同一次 `xcodebuild test` 里跑：
        // 先建 xcframework + 放语料，再放 R1–R7 夹具，最后一次模拟器启动跑完两组。
        string rid = "iossim-arm64";
        if (_buildIosTesthost(root, filter, rid, shardK, shardN).Length == 0) { return 1; }
        int a = _platformDispatch("ios", "assets", root); if (a != 0) { return a; }
        return _runIosTesthost(root, rid);
    }
    // android：同样一次 connectedAndroidTest 跑 R1–R7 + 嵌入语料。ABI 跟宿主架构走（_androidHostRid）；
    // 没有接着的设备时 z42b 会自己起 AVD（_runAndroidTesthost 先补装模拟器组件）。
    string arid = _androidHostRid();
    int b = _platformDispatch("android", "build", root); if (b != 0) { return b; }
    int s = _platformDispatch("android", "assets", root); if (s != 0) { return s; }
    if (_buildAndroidTesthost(root, filter, arid, shardK, shardN).Length == 0) { return 1; }
    return _runAndroidTesthost(root, arid);
}

// 只做一步（调试 / CI 分步）。stage / build / assets 是平台三段式里的同名阶段；bundle / run 是嵌入语料段。
int _testAppStep(string root, string platform, string step, string filter, string format, int shardK, int shardN) {
    if (step == "stage" || step == "build" || step == "assets") { return _platformDispatch(platform, step, root); }
    string iosRid = "iossim-arm64";
    if (step == "bundle") {
        if (platform == "desktop") { return _buildTestBundle(root, filter, "", shardK, shardN).Length > 0 ? 0 : 1; }
        if (platform == "wasm")    { return _buildWasmTesthost(root, filter, shardK, shardN).Length > 0 ? 0 : 1; }
        if (platform == "ios")     { return _buildIosTesthost(root, filter, iosRid, shardK, shardN).Length > 0 ? 0 : 1; }
        return _buildAndroidTesthost(root, filter, _androidHostRid(), shardK, shardN).Length > 0 ? 0 : 1;
    }
    // run：desktop / wasm 的 R1–R7 与语料是两次运行；iOS / Android 一次设备运行同时跑两组。
    if (platform == "desktop") {
        int c = _platformDispatch("desktop", "run", root); if (c != 0) { return c; }
        return _runDesktopEmbedded(root, filter, "", format, shardK, shardN);
    }
    if (platform == "wasm") {
        int c = _platformDispatch("wasm", "run", root); if (c != 0) { return c; }
        return _runWasmTesthost(root);
    }
    if (platform == "ios") { return _runIosTesthost(root, iosRid); }
    return _runAndroidTesthost(root, _androidHostRid());
}

// 把 test agent 装进 z42b 会去找的 SDK：z42b 由 Z42_PORTABLE_VM（= xtask 用来跑 z42b 的那个 VM，
// 见 _z42bDevice）推出 SDK 根，再找 `<home>/runtimes/*/workloads/test/z42.testagent.zpkg`。
// 构建树里 home = VM 所在目录的上一级（artifacts/build/runtime）。CI 原先用一个单独的 step 做这件事。
int _provisionTestAgent(string root) {
    string agent = _ensureTestAgent(root);
    if (agent.Length == 0) { ConsoleError.WriteLine("error: build test-agent failed"); return 1; }
    string home = Path.GetDirectoryName(Path.GetDirectoryName(_z42bDeviceVm(root)));
    string dest = Path.Join(home, "runtimes/dev/workloads/test");
    Directory.Create(dest);
    File.Copy(agent, Path.Join(dest, "z42.testagent.zpkg"));
    Console.WriteLine("  test agent → " + dest);
    return 0;
}

