// xtask — `package sdk --verify` 的端到端腿：在刚组装出的 SDK 上跑。两段：
//
//   ① 发行包夹具（src/toolchain/launcher/tests/fixtures/package/，格式见该目录 README）：新手命令行路径、
//      `z42 run --bin/--set`、`repl`、单文件运行、桌面发布（apphost / 多 exe / 预编译 native）、发布态 analyzer
//      与 build hooks。这里只定义套件（打包 SDK 的工具表 + 占位符），执行与判定由通用引擎
//      common/xtask_fixture_harness.z42 负责；
//   ② golden 腿（xtask_package_goldens.z42）：包内 z42c 编译，包内 z42vm 按 interp / jit 跑，退出 0 且输出匹配才通过。
//      golden 布局同 test-vm（src/tests/<cat>/<name>/source.z42、src/libraries/<lib>/tests/<name>/source.z42、
//      flat 的 src/tests/<cat>/<name>.z42）。
//
// 由 `_packageVerify`（本文件）在进程内驱动：先跑 packages.toml 自检（xtask_package_selfcheck.z42），备好本机桌面
// workload（apphost 腿要它的 stub），再跑这里的两段。golden 腿 interp / jit 都跑。
//
// golden 遍历 / 入口推导 / 字符串小工具（_deriveEntry、_splitWords、_firstLine、_stripTrailingNewlines 等）只在
// common/xtask_golden.z42 定义一次。
namespace Z42Xtask;

using Std.Collections;
using Std.IO;

string _distFixturesSrc() { return "src/toolchain/launcher/tests/fixtures/package"; }

// `package sdk --verify`：packages.toml 自检 → 安装脚本顶层清单对账 → 备好本机桌面 workload → 在 `sdkDir`
// （本次刚组装出的 SDK）上跑发行包夹具与 golden。全部通过返回 0。
int _packageVerify(string sdkDir) {
    Console.WriteLine("");
    Console.WriteLine("── verify: packages.toml 自检 ──");
    int c = _pkgSelfCheck(); if (c != 0) { return c; }
    string root = _root();
    c = _verifyInstallScriptLists(root, sdkDir); if (c != 0) { return c; }
    if (_distApphostTemplate(root).Length == 0) {
        Console.WriteLine("── verify: 本机桌面 workload 不在，先打一份（apphost 腿要它的 stub）──");
        c = _packageWorkloadBuild("", "release"); if (c != 0) { return c; }
    }
    Console.WriteLine("── verify: 打包出的 SDK 端到端 ──");
    return _verifyDist(sdkDir);
}

// 安装脚本（scripts/install/install.{sh,ps1}）只替换 SDK 自己的顶层条目、其余（已装 workload 等）保留，所以各自
// 内嵌一份顶层清单——引导期还没有 z42，清单读不了 packages.toml。这里拿**本次真组装出的 SDK** 的顶层条目逐个
// 对账两份脚本：SDK 新增顶层目录而脚本没跟上时当场红。
// Windows 上 launcher 是 `z42.exe`，对账时统一去掉 `.exe`。
int _verifyInstallScriptLists(string root, string sdkDir) {
    string[] shList  = _installListSh(File.ReadAllText(Path.Join(root, "scripts/install/install.sh")));
    string[] ps1List = _installListPs1(File.ReadAllText(Path.Join(root, "scripts/install/install.ps1")));
    if (shList.Length == 0 || ps1List.Length == 0) {
        ConsoleError.WriteLine("error: install script top-level list not found (install.sh `for entry in …; do` / install.ps1 `foreach ($entry in @(…))`)");
        return 1;
    }
    int bad = 0;
    int total = 0;
    foreach (var e in _sortedStrings(Directory.Enumerate(sdkDir))) {
        if (e.StartsWith(".")) { continue; }
        total = total + 1;
        string name = e.EndsWith(".exe") ? e.Substring(0, e.Length - 4) : e;
        if (!_strIn(shList, name))  { ConsoleError.WriteLine("error: install.sh replace list lacks SDK top-level entry `" + e + "`");  bad = bad + 1; }
        if (!_strIn(ps1List, name)) { ConsoleError.WriteLine("error: install.ps1 replace list lacks SDK top-level entry `" + e + "`"); bad = bad + 1; }
    }
    if (bad > 0) { return 1; }
    Console.WriteLine("  ✓ install.sh / install.ps1 replace lists cover all " + total.ToString() + " SDK top-level entries");
    return 0;
}

// install.sh 的 `for entry in a b c; do` → [a, b, c]；找不到 → 空。
string[] _installListSh(string text) {
    foreach (var ln in text.Split("\n")) {
        string t = ln.Trim();
        if (!t.StartsWith("for entry in ")) { continue; }
        int semi = t.IndexOf(";");
        return _splitWords(semi > 0 ? t.Substring(13, semi - 13) : t.Substring(13));
    }
    return new string[0];
}

// install.ps1 的 `foreach ($entry in @("a", "b"))` → [a, b]（`z42.exe` → `z42`，与 sh 侧同名对账）；找不到 → 空。
string[] _installListPs1(string text) {
    foreach (var ln in text.Split("\n")) {
        string t = ln.Trim();
        if (!t.StartsWith("foreach ($entry in @(")) { continue; }
        int open = t.IndexOf("@(");
        int close = t.IndexOf("))");
        if (close <= open) { return new string[0]; }
        List<string> xs = new List<string>();
        foreach (var raw in t.Substring(open + 2, close - open - 2).Split(",")) {
            string v = raw.Trim().Replace("\"", "");
            xs.Add(v.EndsWith(".exe") ? v.Substring(0, v.Length - 4) : v);
        }
        return xs.ToArray();
    }
    return new string[0];
}

// 发行包夹具 + golden 腿（interp / jit）。全部通过返回 0，否则 1（缺包 / 夹具不符 / golden 编译失败或不符）。
int _verifyDist(string distDir) {
    string root = _root();
    // DIST_SMOKE_ONLY=<tag> → 只跑 `tags` 含 <tag> 的发行包夹具（如 `launcher`：命令行路径那几例），
    // 跳过 golden 腿。本地快跑的开关；CI 不用它 —— CI 必须把每条腿都跑到。
    string onlyTag = _envOpt("DIST_SMOKE_ONLY", "");

    // ── 包目录 ──────────────────────────────────────────────────────────
    if (distDir.Length == 0 || !Directory.Exists(distDir)) {
        ConsoleError.WriteLine("error: no packaged distribution found at artifacts/packages/z42-*-release");
        ConsoleError.WriteLine("       Run: xtask package sdk");
        return 1;
    }
    string z42c     = _distExe(Path.Join(distDir, "bin/z42c"));
    string z42vm    = _distExe(Path.Join(distDir, "bin/z42vm"));
    string launcher = _distExe(Path.Join(distDir, "z42"));
    string libsDir  = Path.Join(distDir, "libs");

    // ── Preflight ───────────────────────────────────────────────────────
    // 被测对象缺件必须红在这里：缺件时退化成「静默 SKIP」的门，全部 SKIP 也会报绿，而缺件恰恰是这个检查存在的理由。
    // 只断言**本次真要跑的**那几条腿的被测对象：只跑 launcher 夹具时不需要 apphost 模板。
    bool bad = false;
    if (!File.Exists(z42c))         { ConsoleError.WriteLine("error: z42c not found at " + z42c); bad = true; }
    if (!File.Exists(z42vm))        { ConsoleError.WriteLine("error: z42vm not found at " + z42vm); bad = true; }
    if (!Directory.Exists(libsDir)) { ConsoleError.WriteLine("error: libs not found at " + libsDir); bad = true; }
    if (!File.Exists(launcher))     { ConsoleError.WriteLine("error: launcher (z42) not in package at " + distDir); bad = true; }
    if (!File.Exists(Path.Join(distDir, "programs/launcher/launcher.zpkg"))) {
        ConsoleError.WriteLine("error: programs/launcher/launcher.zpkg not in package at " + distDir); bad = true;
    }
    string apphostTmpl = "";
    if (onlyTag != "launcher") {
        apphostTmpl = _distApphostTemplate(root);
        if (apphostTmpl.Length == 0) {
            ConsoleError.WriteLine("error: desktop workload apphost stub not built at "
                + _distWorkloadDir(root) + " — run: xtask package workload");
            bad = true;
        }
    }
    if (bad) { return 1; }

    Console.WriteLine("z42 Distribution Test Runner");
    Console.WriteLine("  package:  " + distDir);
    Console.WriteLine("  compiler: " + z42c);
    Console.WriteLine("  vm:       " + z42vm);
    Console.WriteLine("  libs:     " + libsDir);

    string work = Directory.CreateTempDir("xtask-testdist");
    int overallPass = 0;
    int overallFail = 0;

    // ── ① 发行包夹具 ─────────────────────────────────────────────────────
    FixtureSuite suite = _distFixtureSuite(root, distDir, apphostTmpl, Path.Join(work, "fixtures"));
    suite.OnlyTag = onlyTag;
    int[] fx = _runFixtureSuite(root, suite);
    overallPass = overallPass + fx[0];
    overallFail = overallFail + fx[1];
    Console.WriteLine("");

    // ── ② golden 腿 ──────────────────────────────────────────────────────
    if (onlyTag.Length == 0) {
        int[] gres = _runDistGoldens(new string[]{ "interp", "jit" }, root, z42c, z42vm, libsDir, work);
        overallPass = overallPass + gres[0];
        overallFail = overallFail + gres[1];
    }

    Console.WriteLine("══════════════════════════════════════");
    Console.WriteLine(" Total: " + overallPass.ToString() + " passed, " + overallFail.ToString() + " failed");
    Console.WriteLine("══════════════════════════════════════");
    if (overallFail > 0) {
        Console.WriteLine("（工作目录保留以便排查：" + work + "）");
        return 1;
    }
    Directory.Delete(work, true);   // 含一份整包拷贝（publish-apphost-sidecar 的 ahome/），通过就不留
    return 0;
}

// 发行包夹具套件：工具全部取自包内，环境按「用户机器」清理（不继承 xtask / CI 注入的 z42 变量）。
//   z42   包根的 launcher（缺省工具）。清掉 Z42_HOME 等 ⇒ 便携形态：launcher 由自己的位置找到所在的 SDK。
//   z42c  bin/z42c。Z42_HOME = 包根 ⇒ 安装形态（编译器域的 SDK 库从 Z42_HOME/programs/z42c 解析）。
//   z42b  bin/z42b。清掉 Z42_HOME 等（便携形态）。
//   run   bin/z42vm 跑 `target`。Z42_HOME = 包根。
//   exec  直接跑 `target`（如 `z42 publish` 发布出的 apphost）。清掉 Z42_HOME 等，用例按需用 `env` 指定。
// 占位符：{sdk} = 包根；{apphost_template} = desktop workload 的 apphost stub（只跑 launcher 夹具时为空）；
// {rid} = 包的 rid；{native_prefix} / {native_suffix} = 该 rid 的 native 库文件名前后缀（lib…so / lib…dylib / ….dll）。
FixtureSuite _distFixtureSuite(string root, string distDir, string apphostTmpl, string stageDir) {
    string[] userEnv = new string[]{ "Z42_HOME", "Z42_PORTABLE_VM", "Z42_PORTABLE_LIBS", "Z42_LIBS", "Z42_CONFIG", "Z42_MODE" };

    FixtureTool z42 = new FixtureTool("z42", _distExe(Path.Join(distDir, "z42")));
    z42.Requires = z42.Exe;
    z42.EnvRemove = userEnv;

    FixtureTool z42c = new FixtureTool("z42c", _distExe(Path.Join(distDir, "bin/z42c")));
    z42c.Requires = z42c.Exe;
    z42c.ClearAbsent = true;
    z42c.EnvSet = new string[]{ "Z42_HOME", "{sdk}" };
    z42c.EnvRemove = new string[]{ "Z42_LIBS", "Z42_PORTABLE_VM" };

    FixtureTool z42b = new FixtureTool("z42b", _distExe(Path.Join(distDir, "bin/z42b")));
    z42b.Requires = z42b.Exe;
    z42b.ClearAbsent = true;
    z42b.EnvRemove = new string[]{ "Z42_HOME", "Z42_PORTABLE_VM", "Z42_LIBS" };

    FixtureTool run = new FixtureTool("run", _distExe(Path.Join(distDir, "bin/z42vm")));
    run.Requires = run.Exe;
    run.Target = true;
    run.EnvSet = new string[]{ "Z42_HOME", "{sdk}" };
    run.EnvRemove = new string[]{ "Z42_LIBS", "Z42_PORTABLE_VM" };

    FixtureTool exec = new FixtureTool("exec", "");
    exec.EnvRemove = userEnv;

    string rid = _distPkgRid(distDir);
    string pfx = "lib";
    string sfx = ".so";
    if (rid.StartsWith("windows-")) { pfx = ""; sfx = ".dll"; }
    else if (rid.StartsWith("macos-") || rid.StartsWith("ios-") || rid.StartsWith("iossim-")) { sfx = ".dylib"; }

    FixtureSuite s = new FixtureSuite("发行包夹具", _distFixturesSrc());
    s.StageDir = stageDir;
    s.TmpTag = "dist";
    s.DefaultTool = "z42";
    s.Tools = new FixtureTool[]{ z42, z42c, z42b, run, exec };
    s.Vars = new FixturePair[]{
        new FixturePair("sdk", distDir),
        new FixturePair("apphost_template", apphostTmpl),
        new FixturePair("rid", rid),
        new FixturePair("native_prefix", pfx),
        new FixturePair("native_suffix", sfx)
    };
    return s;
}

// 包内程序的路径：Windows 上带 `.exe`。
string _distExe(string p) { return File.Exists(p) ? p : p + ".exe"; }

// 包的 rid：取自包目录名（z42-<version>-<rid>-release；version 可缺）—— 找已知的 OS 前缀，取到 `-release` 为止。
// 认不出时退回本机 rid。
string _distPkgRid(string distDir) {
    string pkgName = Path.GetFileName(distDir);
    foreach (var os in new string[]{ "macos-", "linux-", "windows-", "iossim-", "ios-", "android-" }) {
        int idx = pkgName.IndexOf(os);
        if (idx >= 0) {
            string rest = pkgName.Substring(idx);
            int rel = rest.IndexOf("-release");
            return rel >= 0 ? rest.Substring(0, rel) : rest;
        }
    }
    return _detectHostRid();
}

// ── apphost stub 模板的真实位置（夹具占位符 {apphost_template}）────────────────
// stub 随 **desktop workload** 发布，SDK 包里**没有** bin/apphost —— 生产端见 `_buildDesktopWorkload`，
// 消费端见 launcher 的 `_desktopApphostStub`（读 installed workload 或 Z42_APPHOST_TEMPLATE 覆盖）。
// ⚠️ 别改成去包里找：那里恒找不到，发布类夹具就成了「永远缺件」—— preflight 会把它报成缺件，
// 而一旦有人把缺件降成 SKIP，这几条腿就变回从不运行、从不失败的门。
// 名字与生产端同源（`_desktopWorkloadPkgName` / `_desktopApphostName`，xtask_package_desktop.z42）；verify 只认
// release profile 的那份（缺则 `_packageVerify` 以 release 补打）。
string _distWorkloadDir(string root) {
    return Path.Join(_packagesDir(root), _desktopWorkloadPkgName(_versionsGet(root), _detectHostRid(), "release"));
}

// "" = 未构建（调用方按缺件处理）。
string _distApphostTemplate(string root) {
    string p = Path.Join(_distWorkloadDir(root), _desktopApphostName(_detectHostRid()));
    if (File.Exists(p)) { return p; }
    return "";
}

// ── test-dist-private helpers ──────────────────────────────────────────────

// 与 `Environment.GetEnvironmentVariable(name, fallback)` 的差别：这里**空串也算没设**。
string _envOpt(string name, string fallback) {
    string? v = Environment.GetEnvironmentVariable(name);
    return (v == null || v.Length == 0) ? fallback : v;
}

