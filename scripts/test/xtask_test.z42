// xtask — test orchestration (split from xtask.z42 for the 500-line code-org
// limit). Same Z42Xtask namespace; these call _exec/_root/_z42vm/_build*/
// _regenCore/_at defined in xtask.z42 (cross-file, same namespace).
namespace Z42Xtask;

using Std;
using Std.IO;
using Std.Toml;
using Std.Time;
using Std.Cli;

// ── GREEN gate 的 stage 计时归因 ─────────────────────────────────────────────
//
// 为什么不复用 _procStart/_procEnd：那一对只在 `-v diagnostic`(>=4) 才打印耗时，
// 而 CI 跑的是默认 verbosity —— 于是 `xtask test` 在 CI 日志里是个黑盒，只有一个
// 总时长，想知道「哪个 stage 吃掉了墙钟」必须本地复现或调高 verbosity 重跑一次。
// stage 数是个位数、边界天然清晰，所以这里**无条件**打印每个 stage 的耗时，并在
// 末尾给一张降序表 —— 任何 CI 慢下来的排查都从这张表开始，而不是从一次重跑开始。

// stage 计时账本：名字 + 毫秒并行数组（沿用仓库既有并行数组风格，见 DistSnapZ）。
public sealed class StageLogZ {
    public string[] Names;
    public long[] Ms;
    public int Count;
    public StageLogZ() { Names = new string[24]; Ms = new long[24]; Count = 0; }
    public void Add(string n, long ms) {
        if (Count < Names.Length) { Names[Count] = n; Ms[Count] = ms; Count = Count + 1; }
    }
}

Stopwatch _stageStart(string name) {
    // 注册校验：banner 名必须已在 _gateStageNames() 里登记。这半边保证「加了 stage
    // 却没进代码侧清单」当场炸，另半边（_checkGateStageDoc）保证清单与文档一致——
    // 两个环扣上，新 stage 才没法悄悄绕过 test-gate.md。
    if (!_isRegisteredStage(name)) {
        throw new Exception("stage '" + name + "' 未在 _gateStageNames() 登记 —— "
            + "加 stage 要同时改 _gateStageNames() 与 docs/book/src/dev/test-gate.md 的 gate-stages 区");
    }
    Console.WriteLine("\n=== stage: " + name + " ===");
    return Stopwatch.StartNew();
}

bool _isRegisteredStage(string name) {
    string[] all = _gateStageNames();
    int i = 0;
    while (i < all.Length) { if (all[i] == name) { return true; } i = i + 1; }
    return false;
}

void _stageEnd(StageLogZ log, string name, Stopwatch sw) {
    long ms = sw.Elapsed().TotalMilliseconds();
    log.Add(name, ms);
    Console.WriteLine("--- stage: " + name + " — " + _fmtDur(ms) + " ---");
}

// 降序耗时表 + 占比。stage 数 ≤ 24 → 选择排序足够，不值得引入更复杂的排序。
void _stageSummary(StageLogZ log, long totalMs) {
    if (log.Count == 0) { return; }
    int[] order = new int[log.Count];
    int i = 0;
    while (i < log.Count) { order[i] = i; i = i + 1; }
    i = 0;
    while (i < log.Count) {
        int best = i;
        int j = i + 1;
        while (j < log.Count) {
            if (log.Ms[order[j]] > log.Ms[order[best]]) { best = j; }
            j = j + 1;
        }
        int t = order[i]; order[i] = order[best]; order[best] = t;
        i = i + 1;
    }
    Console.WriteLine("\n── stage wall-clock (降序) ──");
    i = 0;
    while (i < log.Count) {
        int k = order[i];
        long pct = totalMs > 0 ? (log.Ms[k] * 100) / totalMs : 0;
        Console.WriteLine("  " + _padRight(log.Names[k], 48) + _fmtDur(log.Ms[k])
            + "  (" + pct.ToString() + "%)");
        i = i + 1;
    }
    Console.WriteLine("  " + _padRight("TOTAL", 48) + _fmtDur(totalMs));
}

string _padRight(string s, int width) {
    string o = s;
    while (o.Length < width) { o = o + " "; }
    return o;
}

// ── test e2e ────────────────────────────────────────────────────────────────

// `test e2e [--dir <cat>] [--file <path>] [--mode interp|jit] [--no-rebuild] [--jobs=N]`
// — the src/tests end-to-end suite. Unifies what were two commands (`test vm` single-
// source goldens + `test cross-zpkg` multi-package fixtures):
//   - default (no --dir/--file): run the golden runner over all categories, THEN the
//     cross-zpkg multi-package harness.
//   - `--dir cross-zpkg`: only the multi-package harness.
//   - `--dir <cat>`: only that src/tests category's goldens (skips cross-zpkg + libs).
//   - `--file <path>`: a single golden case (name or source-path substring).
// The golden runner (_runVmGoldensF) and the cross-zpkg runner (_testCrossZpkgCore)
// stay separate harnesses; this only routes between them.
int _testE2e(ParseResult r) {
    Stopwatch sw = _procStart("test e2e");
    string dir = r.GetOption("dir");
    string file = r.GetOption("file");
    string modeArg = r.GetOption("mode");
    string modes = modeArg.Length > 0 ? modeArg : "interp jit";
    bool rebuild = !r.GetFlag("no-rebuild");
    bool noBuild = r.GetFlag("no-build");
    string[] mw = _splitWords(modes);
    string xmode = mw.Length > 0 ? mw[0] : "interp";   // cross-zpkg runs a single mode
    string shardOpt = r.GetOption("shard");
    int __rc;
    if (dir == "cross-zpkg") {
        // cross-zpkg only: build unless the caller opted out (--no-rebuild/--no-build)
        __rc = _testCrossZpkgCore(xmode, noBuild || !rebuild);
    } else if (dir == "multi-exe") {
        // multi-exe only (unify-run-modes P3): same build/consume prep as cross-zpkg.
        __rc = _testMultiExeCore(xmode, noBuild || !rebuild);
    } else {
        __rc = _testE2eCore(modes, rebuild, noBuild, r.GetOption("jobs"), shardOpt, dir, file);
        // default (no --dir/--file narrowing, and NOT sharded) also runs the cross-zpkg
        // harness once; the golden run above already built the toolchain (or --no-rebuild
        // was set), so cross-zpkg consumes it (noBuild=true) rather than rebuilding.
        // When sharded (CI vm-jit `--shard N/4`), skip it here: cross-zpkg is a fixed
        // multi-package set, NOT sharded, so running it per-shard is Nx redundant — the
        // CI drives it once via an explicit `--dir cross-zpkg` step. Local full runs
        // (`xtask test e2e`, unsharded) still get it.
        if (__rc == 0 && dir.Length == 0 && file.Length == 0 && shardOpt.Length == 0) {
            __rc = _testCrossZpkgCore(xmode, true);
            if (__rc == 0) { __rc = _testMultiExeCore(xmode, true); }
        }
    }
    if (__rc == 0) { _procEnd("test e2e", sw); }
    return __rc;
}

// `test runtime` — the Rust VM's own unit/integration harness (cargo test on
// src/runtime), incl. the zbc/zpkg format strict-pin baselines (zbc_compat /
// lazy_loader). `--test-threads=1` is REQUIRED: the --lib unit tests have a
// pre-existing cross-thread memory-corruption race that SIGSEGVs under parallel
// scheduling (reproducible on macOS too); serialized passes 736/736. RUST_MIN_STACK
// lowers crash probability further. Root-causing the race is tracked separately
// (suspect: GC region raw-pointer Send/Sync unsoundness with concurrent VmCores).
int _testRuntime() {
    Stopwatch sw = _procStart("test runtime");
    // --features z42-test-fixtures：build.rs 里「用 z42c 编两个 .z42 fixture + emit
    // cfg」那块默认关闭（否则它 rerun-if-changed 到 z42c.driver.zpkg，而该文件被
    // `xtask build compiler` 每轮重写 → 下一次 cargo 全量重编，release 实测 62s）。
    // Rust 单测是唯一真正需要那两个 fixture 的地方，故在这里按需打开——覆盖面不变，
    // 只是把成本从「所有人的每次构建」挪到「真的要跑 Rust 单测时」。
    int __rc = _exec(new Process("cargo").Arg("test").Arg("--locked")
        .Arg("--features").Arg("z42-test-fixtures")
        .Arg("--manifest-path").Arg(_runtimeManifest())
        .Arg("--").Arg("--test-threads=1")
        .Env("RUST_MIN_STACK", "8388608"));
    if (__rc == 0) { _procEnd("test runtime", sw); }
    return __rc;
}

// regen goldens for a test stage: --toolchain active OR --no-build set → z42c+stdlib
// already present, only regen the golden .zbc (_regenGolden, --toolchain-aware);
// else full _regenCore (rebuild stdlib + runtime + goldens). Shared: _testE2eCore + _testAll.
int _regenForTest(bool haveTc, bool noBuild) {
    return _regenForTestF(haveTc, noBuild, "", "");
}

// Filtered variant: on the warm path (_regenGolden), narrow the recompiled golden
// set to the --dir/--file selection so `test e2e --file X --no-build` recompiles
// only case X. The cold full-rebuild path (_regenCore: stdlib+runtime+all goldens)
// is unaffected — it's the "I changed the toolchain, rebuild everything" path.
int _regenForTestF(bool haveTc, bool noBuild, string dirFilter, string fileFilter) {
    return (haveTc || noBuild) ? _regenGoldenF(dirFilter, fileFilter) : _regenCore(true);
}

// cargo-build the DEBUG z42vm + z42-compression cdylib — the runtime the VM golden
// runner resolves (artifacts/build/runtime/debug/z42vm; JIT dlopens the compressor).
// Shared: _testE2eCore + _testAll.
int _buildDebugVmAndCompression() {
    int cd = _exec(new Process("cargo").Arg("build").Arg("-q").Arg("--manifest-path").Arg(_runtimeManifest()));
    if (cd != 0) { return cd; }
    return _exec(new Process("cargo").Arg("build").Arg("-q").Arg("--manifest-path").Arg("src/runtime/crates/z42-compression/Cargo.toml"));
}

int _testE2eCore(string modes, bool rebuild, bool noBuild, string jobs, string shard, string dirFilter, string fileFilter) {
    if (jobs.Length == 0) { jobs = "1"; }
    // --toolchain (compile-once P3) / --no-build (compile-once A1): consume an
    // already-built z42c+stdlib → regen goldens only; else full rebuild.
    bool haveTc = _toolchainDir(_root()).Length > 0;
    // Build the debug z42vm BEFORE regen (see _testAll): regen resolves the debug
    // vm, so a stale one lacking a new builtin panics during regen. Skipped under a
    // toolchain (its vm is used instead).
    if (!haveTc) {
        int cb = _buildDebugVmAndCompression();
        if (cb != 0) { return cb; }
    }
    if (rebuild) {
        int c = _regenForTestF(haveTc, noBuild, dirFilter, fileFilter);
        if (c != 0) { return c; }
    }
    // modes is a space-separated token string (e.g. "interp jit"); split to the
    // string[] _runVmGoldens expects. jobs parses to int (default 1 on garbage).
    string[] modeList = _splitWords(modes);
    int jobsN = 1;
    try { jobsN = int.Parse(jobs); } catch (Exception e) { jobsN = 1; }
    int[] sh = _parseShard(shard);
    return _runVmGoldensF(modeList, jobsN, sh[0], sh[1], dirFilter, fileFilter);
}

// ── cross-zpkg harness (invoked by `test e2e`) ──────────────────────────────

// noBuild=true: skip the debug-vm/stdlib/z42c rebuild — `test all` already prepared
// them in its build wave (z42c was being self-built a 2nd time here). `test e2e`
// passes noBuild per its --no-rebuild/--no-build flags (or true after a golden run).
// cross-zpkg 与 multi-exe 两个 fixture harness 的**共用**构建前置：确保 debug z42vm
// （cargo，跑 fixtures）+ stdlib + z42c（种子自建，编 fixtures）就位。
//
// `--toolchain` 激活时（compile-once P3 的 consume 路径）整个跳过——工具链已供给
// z42c+stdlib+z42vm，没有可建的东西。`noBuild` 同理（调用方已建过）。
// 返回 0 = 就位；非 0 = 构建失败的 rc，调用方直接透传。
//
// 收敛自 _testCrossZpkgCore / _testMultiExeCore 两份**逐行相同**的拷贝
// （dedupe-cross-multiexe, 2026-09-06）。这里的**次序**尤其不该存两份：z42vm 必须先于
// stdlib 自建（stdlib 正是用 z42vm 建的），两份拷贝意味着改一处漏一处——#497 修的
// 就是另一条构建波上的同类次序问题。
int _ensureFixtureToolchain(bool noBuild) {
    if (noBuild || _toolchainDir(_root()).Length > 0) { return 0; }
    int cr = _exec(new Process("cargo").Arg("build").Arg("-q")
        .Arg("--manifest-path").Arg(_runtimeManifest()));
    if (cr != 0) { return cr; }
    string root = _root();
    if (!File.Exists(Path.Join(_libsDir(root), "z42.core.zpkg"))) {
        int cs = _buildStdlib(); if (cs != 0) { return cs; }
    }
    return _buildCompiler();   // z42c 自建（种子）
}

int _testCrossZpkgCore(string mode, bool noBuild) {
    int c = _ensureFixtureToolchain(noBuild); if (c != 0) { return c; }
    return _testCrossZpkgImpl(mode);
}

// ── test dist (packaged-distribution e2e) ────────────────────────────────────

// `test dist [interp|jit]` — native port of the former scripts/test-dist.sh.
// Ensure a host release package exists, then run the in-process dist e2e
// (_testDistRun, xtask_test_dist.z42) which drives the PACKAGED z42c/z42vm
// against the goldens + a launcher smoke — no separate compile + zpkg spawn.
// Not in the default GREEN gate (run on demand).
int _testDist(ParseResult r) {
    Stopwatch sw = _procStart("test dist");
    string root = _root();
    // Ensure a host release package exists — its internal build (_packageDesktop)
    // produces z42c + z42vm + stdlib itself. _testDistRun consumes ONLY the package
    // (bin/z42c, bin/z42vm, libs/), so the former source-tree prebuild wave
    // (_buildCompiler + cargo + _buildStdlib) was redundant with _buildPackageCore
    // and unused by the runner (review §2.4 — removed).
    if (!_hasReleasePkg(root)) {
        int c = _buildPackageCore("release", "", "", false); if (c != 0) { return c; }
    }
    int __rc = _testDistRun(r.GetPositional(0));
    if (__rc == 0) { _procEnd("test dist", sw); }
    return __rc;
}

bool _hasReleasePkg(string root) {
    string pkgs = _packagesDir(root);
    if (!Directory.Exists(pkgs)) { return false; }
    foreach (var name in Directory.Enumerate(pkgs)) {
        if (name.StartsWith("z42-") && name.EndsWith("-release")) { return true; }
    }
    return false;
}

// latest artifacts/packages/z42-*-release dir (absolute path), or "" if none.
// Lives here alongside _hasReleasePkg; called by _testDistRun (xtask_test_dist.z42).
string _latestReleasePkg(string root) {
    string pkgs = _packagesDir(root);
    if (!Directory.Exists(pkgs)) { return ""; }
    string best = "";
    foreach (var name in Directory.Enumerate(pkgs)) {
        if (name.StartsWith("z42-") && name.EndsWith("-release")) {
            string full = Path.Join(pkgs, name);
            if (Directory.Exists(full)) {
                // Prefer the lexicographically-greatest (stable; usually one host pkg).
                if (best.Length == 0 || name.CompareTo(Path.GetFileName(best)) > 0) { best = full; }
            }
        }
    }
    return best;
}

// ── test all (unified GREEN gate) ───────────────────────────────────────────

// `test` (no target) — the full GREEN gate, sequential: build once, then run
// compiler + VM goldens + cross-zpkg + stdlib, short-circuiting on first
// failure. Mirrors the former scripts/test-all.sh's stage set (the --parallel wave +
// --scope auto-narrow optimizations are a later increment).
// True if the comma/space-separated `skip` list names `stage`. Lets CI decompose
// the monolithic gate: test-host legs run `test all --skip stdlib,cross-zpkg` while
// dedicated parallel jobs (stdlib-interp shards / cross-zpkg-interp) cover those
// stages — cutting the per-leg critical path. Local `xtask test` passes skip="" →
// full gate, unchanged.
bool _skipHas(string skip, string stage) {
    if (skip.Length == 0) { return false; }
    string[] parts = _splitWords(skip.Replace(",", " "));
    int i = 0;
    while (i < parts.Length) { if (parts[i] == stage) { return true; } i = i + 1; }
    return false;
}

// ── stage 清单 ↔ test-gate.md 防漂移门（fix-xtask-doc-drift, 2026-09-05）─────
//
// 为什么要这道门：docs/book/src/dev/test-gate.md 自称「GREEN gate stage 组成的唯一
// 权威清单（SoT）」，页内还明文警告过「历史上复列 5-6 处、已互相漂移」——然后它自己
// 还是烂了：multi-exe（unify-run-modes P3）、manifest targets（add-tests-bench-manifest-
// config P4）、examples（设计 D4）三次加 stage 都没同步该页，文档停在 6 个而 gate 实跑 9 个。
// **纯纪律守不住一份没有测试盯着的清单**（同 format-fixture 那次的教训），所以把「gate 跑
// 哪些 stage」变成数据 + 开跑前与文档对账。形态照 `test vscode-syntax`（生成产物 ↔ 源表）。
//
// 加/删/改名一个 stage 的正确姿势：改 _gateStageNames() + test-gate.md 的
// gate-stages 区，两处一致才绿；只改一处 → 本门变红并打印差异。

// gate 的规范 stage 名单（代码侧唯一 SoT），顺序 = _testAll 的实际执行顺序。
// 含 build wave：它也走 _stageStart 打 banner、也计入耗时表，对读日志的人就是一个 stage。
string[] _gateStageNames() {
    return new string[]{
        "build wave (debug vm + regen)",
        "e2e goldens (interp; jit → vm-jit-consistency)",
        "e2e cross-zpkg",
        "e2e multi-exe",
        "stdlib [Test]",
        "manifest targets ([[test]])",
        "examples (compile gate + test=true run)",
        "compiler",
        "vscode-syntax",
        "lines"
    };
}

// test-gate.md 里机器可读清单区的边界标记（HTML 注释：渲染成 book 时不可见）。
string _gateStagesDocPath(string root) {
    return Path.Join(root, "docs/book/src/dev/test-gate.md");
}

// 从 test-gate.md 的 <!-- gate-stages:begin/end --> 区抽出 stage 名（每行一个
// `- \`name\``）。区块缺失返回 null（调用方报「标记不见了」而非「清单为空」——
// 两种失败原因不同，混在一起会让人去改清单而不是去找被删掉的标记）。
string[] _gateStagesFromDoc(string text) {
    int b = text.IndexOf("<!-- gate-stages:begin -->");
    int e = text.IndexOf("<!-- gate-stages:end -->");
    if (b < 0 || e < 0 || e < b) { return null; }
    // "\n" 而非 '\n'：z42 的 Split 无 char 重载。CRLF 下每行尾留的 \r 由下面的 Trim() 吃掉。
    string[] lines = text.Substring(b, e - b).Split("\n");
    string[] names = new string[32];
    int n = 0;
    int i = 0;
    while (i < lines.Length) {
        string ln = lines[i].Trim();
        // 只认 "- `name`" 形状，其余（标记行 / 空行 / 说明文字）跳过。
        if (ln.StartsWith("- `") && ln.EndsWith("`")) {
            names = _append(names, n, ln.Substring(3, ln.Length - 4));
            n = n + 1;
        }
        i = i + 1;
    }
    string[] outNames = new string[n];
    int j = 0;
    while (j < n) { outNames[j] = names[j]; j = j + 1; }
    return outNames;
}

// 对账 _gateStageNames() 与 test-gate.md。不一致 → 打印逐条差异后返回 1。
int _checkGateStageDoc() {
    string root = _root();
    string docPath = _gateStagesDocPath(root);
    if (!File.Exists(docPath)) {
        ConsoleError.WriteLine("error: gate stage SoT 文档不存在: " + docPath);
        return 1;
    }
    string[] want = _gateStageNames();
    string[] got = _gateStagesFromDoc(File.ReadAllText(docPath));
    if (got == null) {
        ConsoleError.WriteLine("error: test-gate.md 缺 <!-- gate-stages:begin/end --> 标记区");
        ConsoleError.WriteLine("       该区是 stage 清单的机器可读副本，不能删——见 _checkGateStageDoc");
        return 1;
    }
    bool same = (want.Length == got.Length);
    int i = 0;
    while (same && i < want.Length) { if (want[i] != got[i]) { same = false; } i = i + 1; }
    if (same) { return 0; }
    ConsoleError.WriteLine("error: GREEN gate stage 清单与 docs/book/src/dev/test-gate.md 不一致");
    ConsoleError.WriteLine("       代码 (_gateStageNames, scripts/test/xtask_test.z42):");
    int k = 0;
    while (k < want.Length) { ConsoleError.WriteLine("         " + (k + 1).ToString() + ". " + want[k]); k = k + 1; }
    ConsoleError.WriteLine("       文档 (gate-stages 区):");
    k = 0;
    while (k < got.Length) { ConsoleError.WriteLine("         " + (k + 1).ToString() + ". " + got[k]); k = k + 1; }
    ConsoleError.WriteLine("       → 改了 gate 组成就两处一起改；文档区是给人读的 SoT，代码是执行的 SoT。");
    return 1;
}

int _testAll(bool noBuild, string skip) {
    Stopwatch sw = _procStart("test");
    // stage 清单 ↔ 文档对账：放在构建波之前，几毫秒，失败即停——文档漂移不该让人
    // 等十几分钟的 gate 跑完才发现。
    int dc = _checkGateStageDoc(); if (dc != 0) { return dc; }
    // build wave (once): stdlib + compiler driver + release runtime + golden zbc.
    // compile-once consume: skip the redundant z42c+stdlib rebuild when they're
    // already present — either a --toolchain is set (CI downloads current-sdk) OR
    // --no-build is passed (the CI bootstrap step already built the canonical
    // z42c+stdlib). In both cases only regen the goldens (the bootstrap doesn't
    // produce them); the stages below already run --no-build. This removes the CI
    // build-wave redundancy (~12-15 min/leg) — `xtask test all` locally still does
    // the full build by default (noBuild=false).
    bool haveTc = _toolchainDir(_root()).Length > 0;
    // Build the debug z42vm + compression cdylib BEFORE regen. golden regen
    // (_regenGolden) resolves the debug vm via _activeVm(root,"debug"); if it runs
    // first against a STALE debug vm that predates a newly-added VM builtin, every
    // golden compile panics ("unknown builtin") and regen returns 1 — which then
    // early-returns here before the debug vm ever gets rebuilt. Building it first
    // keeps regen on a current vm. (The [Test]/[Benchmark] runner is now z42b —
    // z42.builder.zpkg, built by the lib/compiler stages with the current z42c.)
    StageLogZ slog = new StageLogZ();
    // build wave 也计时：它常常是整个 gate 里最大的一块（CI 上 regen + 自建），
    // 不计的话下面的 stage 表加起来对不上总时长，反而误导。
    Stopwatch swStage = _stageStart("build wave (debug vm + regen)");
    int c = _buildDebugVmAndCompression(); if (c != 0) { return c; }
    c = _regenForTest(haveTc, noBuild);
    if (c != 0) { return c; }
    _stageEnd(slog, "build wave (debug vm + regen)", swStage);
    // NOTE: the Rust VM unit harness (`test runtime` = cargo test) is intentionally
    // NOT a stage here. It spawns signal-crash helpers (signal_handler_e2e) that hang
    // in signal-restricted sandboxes, which would make the always-run gate unusable.
    // It runs as its own per-leg CI step + on-demand `xtask test runtime` +
    // `test changed` (src/runtime → test runtime). (redesign-xtask-test)
    // replace-csharp Phase C：删除 dotnet build/test stage——z42c 编译器正确性由 stage「compiler」
    // （自举不动点 gen1==gen2 + units）保证，golden 编译已全程 z42c（_regenGolden）。
    // stage 2: e2e goldens — INTERP only. JIT is gated by the dedicated
    // vm-jit-consistency CI job (linux-x64): cranelift JIT behaviour is
    // host-independent, so running jit here on every build-and-test OS leg was
    // redundant (5× the slow per-case cranelift compile). Splitting interp (here,
    // all OS) from jit (one linux job) keeps full coverage while taking the slow
    // jit stage off every host leg's critical path.
    swStage = _stageStart("e2e goldens (interp; jit → vm-jit-consistency)");
    c = _testE2eCore("interp", false, false, "4", "", "", ""); if (c != 0) { return c; }
    _stageEnd(slog, "e2e goldens (interp; jit → vm-jit-consistency)", swStage);
    // stage 3: e2e cross-zpkg (skippable: CI offloads to a dedicated cross-zpkg-interp job)
    if (!_skipHas(skip, "cross-zpkg")) {
        swStage = _stageStart("e2e cross-zpkg");
        c = _testCrossZpkgCore("interp", true); if (c != 0) { return c; }
        _stageEnd(slog, "e2e cross-zpkg", swStage);
    }
    // stage 3b: e2e multi-exe (unify-run-modes P3 — one project → N exe zpkgs)
    if (!_skipHas(skip, "multi-exe")) {
        swStage = _stageStart("e2e multi-exe");
        c = _testMultiExeCore("interp", true); if (c != 0) { return c; }
        _stageEnd(slog, "e2e multi-exe", swStage);
    }
    // stage 4: stdlib [Test] (no build) (skippable: CI shards it across stdlib-interp jobs)
    if (!_skipHas(skip, "stdlib")) {
        swStage = _stageStart("stdlib [Test]");
        c = _testLibCore("test", new string[0], true, "", "4", "interp", null, "", "", ""); if (c != 0) { return c; }
        _stageEnd(slog, "stdlib [Test]", swStage);
    }
    // stage 4b: manifest-target fixtures (add-tests-bench-manifest-config P4 —
    // [[test]] harness true/false exit-code + explicit-overlay). noBuild=true:
    // the wave + stdlib stage already prepared the release toolchain.
    if (!_skipHas(skip, "targets")) {
        swStage = _stageStart("manifest targets ([[test]])");
        c = _testTargetsCore("test", "", true); if (c != 0) { return c; }
        _stageEnd(slog, "manifest targets ([[test]])", swStage);
    }
    // stage 4c: example compile-gate (design D4): compile ALL examples across
    // projects (build failure = stage failure), run those marked test=true.
    if (!_skipHas(skip, "examples")) {
        swStage = _stageStart("examples (compile gate + test=true run)");
        c = _testExampleGate(true); if (c != 0) { return c; }
        _stageEnd(slog, "examples (compile gate + test=true run)", swStage);
    }
    // stage 5: z42c self-host byte-identical (0.3.10 gate)
    // Skippable: CI offloads to a dedicated compiler-checks(linux-x64) job (1×)
    // — running on all 4 OS legs was 4× redundant (host-independent output).
    if (!_skipHas(skip, "compiler")) {
        swStage = _stageStart("compiler");
        c = _testCompiler(true); if (c != 0) { return c; }
        _stageEnd(slog, "compiler", swStage);
    }
    // stage 6: VSCode grammar ↔ Lexer 关键字一致性（跨子系统 SoT，性质同自举不动点；
    // ≈一次 z42c fork，成本可忽略——add-vscode-syntax-ext, 2026-07-07）
    // Skippable: same rationale as compiler — host-independent, 1× on CI.
    if (!_skipHas(skip, "vscode")) {
        swStage = _stageStart("vscode-syntax");
        c = _testVscodeSyntax(); if (c != 0) { return c; }
        _stageEnd(slog, "vscode-syntax", swStage);
    }
    // stage 7: 文件行数硬上限 lint（add-line-count-lint）：新越界 / 继续膨胀 → 红；基线内 → warn。
    // 纯文本扫描（~1s），host-independent。Skippable: "lines"。
    if (!_skipHas(skip, "lines")) {
        swStage = _stageStart("lines");
        c = _testLines(false); if (c != 0) { return c; }
        _stageEnd(slog, "lines", swStage);
    }
    Console.WriteLine("\n✅ GREEN — all stages passed");
    _stageSummary(slog, sw.Elapsed().TotalMilliseconds());
    _procEnd("test", sw);
    return 0;
}

// ── shard parsing (shared: _testE2eCore + the test-lib harness) ──────────────
// The stdlib [Test]/[Benchmark] harness (_testLib/_testLibCore + unit discovery,
// dep harvest, batched compile/run, synthetic manifest) lives in xtask_test_lib.z42.

// Parse a `--shard k/n` spec → [k, n]; returns [0,0] for empty/invalid (= no
// sharding). Used to split the slow jit suites across N parallel CI machines.
int[] _parseShard(string s) {
    int[] r = new int[2]; r[0] = 0; r[1] = 0;
    if (s.Length == 0) { return r; }
    int slash = -1;
    int i = 0;
    while (i < s.Length) { if (s.CharAt(i) == '/') { slash = i; break; } i = i + 1; }
    if (slash <= 0) { return r; }
    if (slash >= s.Length - 1) { return r; }
    try {
        int k = int.Parse(s.Substring(0, slash));
        int n = int.Parse(s.Substring(slash + 1, s.Length - slash - 1));
        if (k >= 1 && n >= 1 && k <= n) { r[0] = k; r[1] = n; }
    } catch (Exception e) { r[0] = 0; r[1] = 0; }
    return r;
}

