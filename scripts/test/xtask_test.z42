// xtask — test orchestration: the GREEN gate (`test`), `test e2e`, `test runtime`, the GC-mode
// stage, and the stage list ↔ test-gate.md drift check.
namespace Z42Xtask;

using Std.IO;
using Std.Time;
using Std.Collections;

// ── GREEN gate 的 stage 计时归因 ─────────────────────────────────────────────
//
// 为什么不复用 _procStart/_procEnd：那一对只在 `-v diagnostic`(>=4) 才打印耗时，
// 而 CI 跑的是默认 verbosity —— 于是 `xtask test` 在 CI 日志里是个黑盒，只有一个
// 总时长，想知道「哪个 stage 吃掉了墙钟」必须本地复现或调高 verbosity 重跑一次。
// stage 数是个位数、边界天然清晰，所以这里**无条件**打印每个 stage 的耗时，并在
// 末尾给一张降序表 —— 任何 CI 慢下来的排查都从这张表开始，而不是从一次重跑开始。

// stage 计时账本：名字 + 毫秒并行列表。
public sealed class StageLogZ {
    public List<string> Names;
    public List<long> Ms;
    public StageLogZ() { Names = new List<string>(); Ms = new List<long>(); }
    public void Add(string n, long ms) { Names.Add(n); Ms.Add(ms); }
}

StageRun _stageStart(string name) {
    // 注册校验：banner 名必须已在 _gateStageNames() 里登记。这半边保证「加了 stage
    // 却没进代码侧清单」当场炸，另半边（_checkGateStageDoc）保证清单与文档一致——
    // 两个环扣上，新 stage 才没法悄悄绕过 test-gate.md。
    if (!_isRegisteredStage(name)) {
        throw new Exception("stage '" + name + "' 未在 _gateStageNames() 登记 —— "
            + "加 stage 要同时改 _gateStageNames() 与 docs/internals/src/devinfra/test-gate.md 的 gate-stages 区");
    }
    Console.WriteLine("\n=== stage: " + name + " ===");
    StageRun r = new StageRun();
    r.Name = name;
    r.Sw = Stopwatch.StartNew();
    return r;
}

// 一个在跑的 stage：`_stageStart` 返回，`_stageEnd` 从它取名——名字只在 start 处写一遍。
class StageRun {
    public string Name;
    public Stopwatch Sw;
    public StageRun() { this.Name = ""; this.Sw = null; }
}

bool _isRegisteredStage(string name) { return _strIn(_gateStageNames(), name); }

void _stageEnd(StageLogZ log, StageRun r) {
    long ms = r.Sw.Elapsed().TotalMilliseconds();
    log.Add(r.Name, ms);
    Console.WriteLine("--- stage: " + r.Name + " — " + _fmtDur(ms) + " ---");
}

// 一个 gate stage：skip 列表点名 key → 跳过（返回 0）；否则 banner + 跑 body，成功才记账。
// key = "" → 不可跳过。
int _gateStage(StageLogZ log, string skip, string key, string name, Func<int> body) {
    if (key.Length > 0 && _skipHas(skip, key)) { return 0; }
    StageRun r = _stageStart(name);
    int rc = body();
    if (rc == 0) { _stageEnd(log, r); }
    return rc;
}

// 降序耗时表 + 占比。
void _stageSummary(StageLogZ log, long totalMs) {
    if (log.Names.Count == 0) { return; }
    var order = new List<int>();
    for (int i = 0; i < log.Names.Count; i++) { order.Add(i); }
    order.Sort((a, b) => log.Ms[b] > log.Ms[a] ? 1 : (log.Ms[b] < log.Ms[a] ? -1 : 0));
    Console.WriteLine("\n── stage wall-clock (降序) ──");
    foreach (var k in order) {
        long pct = totalMs > 0 ? (log.Ms[k] * 100) / totalMs : 0;
        Console.WriteLine("  " + _padRight(log.Names[k], 48) + _fmtDur(log.Ms[k])
            + "  (" + pct.ToString() + "%)");
    }
    Console.WriteLine("  " + _padRight("TOTAL", 48) + _fmtDur(totalMs));
}

// ── test e2e ────────────────────────────────────────────────────────────────

// `test e2e [--dir <cat>] [--file <path>] [--mode interp|jit] [--no-rebuild] [--jobs=N]`
// — the src/tests end-to-end suite (single-source goldens + multi-package fixtures):
//   - default (no --dir/--file): run the golden runner over all categories, THEN the
//     cross-zpkg and multi-exe harnesses.
//   - `--dir cross-zpkg` / `--dir multi-exe`: only that harness.
//   - `--dir <cat>`: only that src/tests category's goldens (skips cross-zpkg + libs).
//   - `--file <path>`: a single golden case (name or source-path substring).
// The golden runner (_runVmGoldensF) and the cross-zpkg runner (_testCrossZpkgCore)
// stay separate harnesses; this only routes between them.
int _testE2e(TestE2eCommand c) {
    Stopwatch sw = _procStart("test e2e");
    string dir = c.Dir;
    string file = c.File;
    string modes = c.Mode.Length > 0 ? c.Mode : "interp jit";
    bool rebuild = !c.NoRebuild;
    bool noBuild = c.NoBuild;
    string[] mw = _splitWords(modes);
    string xmode = mw.Length > 0 ? mw[0] : "interp";   // cross-zpkg runs a single mode
    string shardOpt = c.Shard;
    int __rc;
    if (dir == "cross-zpkg") {
        // cross-zpkg only: build unless the caller opted out (--no-rebuild/--no-build)
        __rc = _testCrossZpkgCore(xmode, noBuild || !rebuild);
    } else if (dir == "multi-exe") {
        // multi-exe only: same build/consume prep as cross-zpkg.
        __rc = _testMultiExeCore(xmode, noBuild || !rebuild);
    } else {
        __rc = _testE2eCore(modes, rebuild, noBuild, c.Jobs, shardOpt, dir, file);
        // default (no --dir/--file narrowing, and NOT sharded) also runs the cross-zpkg +
        // multi-exe harnesses once; the golden run above already built the toolchain (or --no-rebuild
        // was set), so cross-zpkg consumes it (noBuild=true) rather than rebuilding.
        // When sharded (CI vm-jit `--shard N/4`), skip it here: cross-zpkg is a fixed
        // multi-package set, NOT sharded, so running it per-shard is Nx redundant — the
        // CI drives it once via an explicit `--dir cross-zpkg` step. Local full runs
        // (`xtask test e2e`, unsharded) still get it.
        if (__rc == 0 && dir.Length == 0 && file.Length == 0 && shardOpt.Length == 0) {
            __rc = _testCrossZpkgCore(xmode, true);
            if (__rc == 0) { __rc = _testMultiExeCore(xmode, true); }
        }
    }
    if (__rc == 0) { _procEnd("test e2e", sw); }
    return __rc;
}

// `test runtime` — the Rust VM's own unit/integration harness (cargo test on
// src/runtime), incl. the zbc/zpkg format strict-pin baselines (zbc_compat /
// lazy_loader). `--test-threads=1` is REQUIRED: the --lib unit tests have a
// cross-thread memory-corruption race that SIGSEGVs under parallel scheduling
// (reproducible on macOS too). RUST_MIN_STACK lowers crash probability further.
// (Suspect: GC region raw-pointer Send/Sync unsoundness with concurrent VmCores.)
int _testRuntime() {
    Stopwatch sw = _procStart("test runtime");
    // --features z42-test-fixtures：build.rs 里「用 z42c 编三个 .z42 fixture + emit
    // cfg」那块默认关闭（否则它 rerun-if-changed 到 z42c.driver.zpkg，而该文件被
    // `xtask build compiler` 每轮重写 → 下一次 cargo 全量重编）。
    // Rust 单测是唯一真正需要这些 fixture 的地方，故在这里按需打开——覆盖面不变，
    // 只是把成本从「所有人的每次构建」挪到「真的要跑 Rust 单测时」。
    // --workspace：不带它时包选择落到 Cargo.toml 的 `default-members`（只有根包 z42 +
    // z42-compression），z42-abi / z42-repl / z42-rs / z42-macros / z42-host 的测试整批不跑。
    // 这是全仓唯一的 `cargo test` 入口（CI 的 "Rust VM unit tests" 即此）；z42-abi 守的正是
    // C ABI 结构体布局契约——坏了直接表现为嵌入端内存错位。
    int __rc = _exec(_cargoCmd("test", _runtimeCargoConfig()).Arg("--locked").Arg("--workspace")
        .Arg("--features").Arg("z42-test-fixtures")
        .Arg("--manifest-path").Arg(_runtimeManifest())
        .Arg("--").Arg("--test-threads=1")
        .Env("RUST_MIN_STACK", "8388608"));
    if (__rc == 0) { _procEnd("test runtime", sw); }
    return __rc;
}

// GREEN 里的 Rust 单测（`test runtime` 的**窄版**）。
//
// 完整的 `test runtime` 不能进 GREEN：它会拉起 signal 崩溃辅助进程（`tests/signal_handler_e2e.rs`），
// 在限制信号的沙箱里**挂住**。但「本地全绿、CI test-host 红」的典型事故都落在 lib 单测与编译失败
// （公共 struct 加字段后 `tests/` 里的字面构造点没补）上，不需要跑那批。
//
// ⇒ 本 stage = `--lib`（跑）+ `--no-run`（只编所有 target、一个都不跑）。
// 🔴 **`--lib` 排除 `tests/` 是结构性的，不是靠过滤器**：signal / loom 那几个都在 `tests/` 下，
// `--lib` 根本到不了它们。**不用 `--skip <名字>` 这类过滤**——那种写法会随文件改名悄悄失效
// （本仓库踩过「带过滤器跑 cargo test = 等于没跑全局门」）。
//
// 完整版仍保留为 `xtask test runtime` / CI 的独立 leg / `test changed`。
int _testRuntimeUnits() {
    string m = _runtimeManifest();
    // `--workspace` / `--features z42-test-fixtures`：见 `_testRuntime`。
    int rc = _exec(_cargoCmd("test", _runtimeCargoConfig()).Arg("--locked").Arg("--workspace")
        .Arg("--features").Arg("z42-test-fixtures")
        .Arg("--manifest-path").Arg(m)
        .Arg("--lib")
        .Arg("--").Arg("--test-threads=1")
        .Env("RUST_MIN_STACK", "8388608"));
    if (rc != 0) { return rc; }
    // 只编不跑：抓「跨 src/ 与 tests/ 都构造的公共 struct 加了字段却没补齐」这类编译漏。
    return _exec(_cargoCmd("test", _runtimeCargoConfig()).Arg("--locked").Arg("--workspace")
        .Arg("--features").Arg("z42-test-fixtures")
        .Arg("--manifest-path").Arg(m)
        .Arg("--no-run"));
}

// regen goldens for a test stage: --toolchain active OR --no-build set → z42c+stdlib
// already present, only regen the golden .zbc (_regenGolden, --toolchain-aware);
// else full _regenCore (rebuild stdlib + runtime + goldens). Shared: _testE2eCore + _testAll.
int _regenForTest(bool haveTc, bool noBuild) {
    return _regenForTestF(haveTc, noBuild, "", "");
}

// Filtered variant: on the warm path (_regenGolden), narrow the recompiled golden
// set to the --dir/--file selection so `test e2e --file X --no-build` recompiles
// only case X. The cold full-rebuild path (_regenCore: stdlib+runtime+all goldens)
// is unaffected — it's the "I changed the toolchain, rebuild everything" path.
int _regenForTestF(bool haveTc, bool noBuild, string dirFilter, string fileFilter) {
    return (haveTc || noBuild) ? _regenGoldenF(dirFilter, fileFilter) : _regenCore(true);
}

// cargo-build the DEBUG z42vm + z42-compression cdylib — the runtime the VM golden
// runner resolves (artifacts/build/runtime/debug/z42vm; JIT dlopens the compressor).
// Shared: _testE2eCore + _testAll.
int _buildDebugVmAndCompression() {
    int cd = _exec(_cargoCmd("build", _runtimeCargoConfig()).Arg("-q").Arg("--manifest-path").Arg(_runtimeManifest()));
    if (cd != 0) { return cd; }
    return _exec(_cargoCmd("build", _runtimeCargoConfig()).Arg("-q").Arg("--manifest-path").Arg("src/runtime/crates/z42-compression/Cargo.toml"));
}

int _testE2eCore(string modes, bool rebuild, bool noBuild, string jobs, string shard, string dirFilter, string fileFilter) {
    if (jobs.Length == 0) { jobs = "1"; }
    // --toolchain / --no-build: consume an already-built z42c+stdlib → regen goldens
    // only; else full rebuild.
    bool haveTc = _toolchainDir(_root()).Length > 0;
    // Build the debug z42vm BEFORE regen (see _testAll): regen resolves the debug
    // vm, so a stale one lacking a new builtin panics during regen. Skipped under a
    // toolchain (its vm is used instead).
    if (!haveTc) {
        int cb = _buildDebugVmAndCompression();
        if (cb != 0) { return cb; }
    }
    if (rebuild) {
        int c = _regenForTestF(haveTc, noBuild, dirFilter, fileFilter);
        if (c != 0) { return c; }
    }
    // modes is a space-separated token string (e.g. "interp jit"); split to the
    // string[] _runVmGoldensF expects. jobs parses to int (default 1 on garbage).
    string[] modeList = _splitWords(modes);
    int jobsN = 1;
    try { jobsN = int.Parse(jobs); } catch (Exception e) { jobsN = 1; }
    int[] sh = _parseShard(shard);
    return _runVmGoldensF(modeList, jobsN, sh[0], sh[1], dirFilter, fileFilter);
}

// compile one real package under each GC mode, with the collector tuned to fire
// hundreds of times, and require that it actually did.
//
// **Why a compiler build and not the golden suite**: golden cases are short-lived
// programs that never collect — vacuous for GC-defect coverage; a `z42c.semantics`
// build genuinely stresses the collector.
//
// **Why both modes.** `generational` is the default, so every other stage exercises it —
// but only at the 32 MB default nursery, far too few collections to catch premature-
// collection defects. And `stw` is exercised by nothing else — uncovered modes are where
// such defects live for months.
//
// **Why these settings** — collections over one `z42c.semantics` build (`--jobs 1`, deterministic
// across hosts):
//
//   default (generational), nursery 1M   ~250 collections
//   Z42_GC_MODE=stw, budget 16M           ~35 collections   ← the knee: 8M is several hundred
//                                                             but much longer wall time
//
// The stw budget tracks the live set — it drifts when object sizes change, and both counts
// drop whenever the compiler itself allocates less — so the floors are set at roughly half the
// observed counts. Their job is to catch a *collapse* (a flipped default, a policy change that
// stops the collector firing), not to pin an exact number; re-baseline the two numbers above
// when a compiler-side allocation change moves them.
//
// The generational leg deliberately leaves `Z42_GC_MODE` **unset**: it is testing *the
// default*, so hard-coding the mode here would let a flipped default go unnoticed. The
// asserted collection floor is what makes that safe — if the default changes, or a policy
// change stops the collector firing, the count collapses and this stage goes red rather
// than silently testing nothing.
int _testGcModeWorkload(string label, string modeEnv, string nurseryEnv, string budgetEnv,
                        int minCycles, int jobs) {
    string root = _root();
    string vm = _builtVm(root, "release");
    string driver = _driverZpkg(root, "release");
    string flat = _libsDir(root);   // 纯 stdlib flat；z42c.semantics 按名声明的编译器包由 driver 从编译器目录解析
    string toml = root + "/src/compiler/z42c.semantics/z42c.semantics.z42.toml";
    Console.WriteLine("  ▶ z42c.semantics --release --no-incremental (" + label + ")");
    // 编译器目录由 _z42cProc* 显式指向本树刚建的 driver dist（不指时 semantics 会对着种子 SDK 里的旧编译器包编）。
    // mode "" = 保持 z42vm 缺省模式（回收次数下限是按这个模式标定的）。
    Process p = _z42cProcMode(vm, flat, driver, "")
        .Arg("build").Arg(toml).Arg("--release").Arg("--no-incremental")
        // 显式给并行度：`z42c build` 的默认值是 min(4, 核数)，而回收次数在多线程下随平台与时序
        // 剧烈波动 ⇒ 串行腿钉 1 以保持确定性。
        .Arg("--jobs").Arg(jobs.ToString())
        // 产物进 runtime 的 tests/ 输出，不落 `src/compiler/z42c.semantics/dist`
        // （这次构建只为给 GC 施压，产物本身没人用）。
        .Arg("--output-dir").Arg(_workOut(root, "src/runtime", "gc-modes"))
        .Env("Z42_GC_TRACE", "1");
    if (modeEnv != "")    { p = p.Env("Z42_GC_MODE", modeEnv); }
    if (nurseryEnv != "") { p = p.Env("Z42_GC_NURSERY_BYTES", nurseryEnv); }
    if (budgetEnv != "")  { p = p.Env("Z42_GC_MAX_BYTES", budgetEnv); }
    // stderr is piped so the `z42-gc:` trace lines can be counted; stdout stays inherited so
    // build progress is still visible in the log.
    ProcessResult r = p.Stdout(Stdio.Inherit()).Stderr(Stdio.Pipe()).Run();
    if (r.ExitCode != 0) {
        Console.WriteLine(r.Stderr);
        Console.WriteLine("  x " + label + " build failed (exit " + r.ExitCode.ToString() + ")");
        return 1;
    }
    int cycles = _countGcCycles(r.Stderr);
    if (cycles < minCycles) {
        Console.WriteLine("  x " + label + ": only " + cycles.ToString() + " GC cycles (want >= "
            + minCycles.ToString() + ") — the collector is not being exercised, so this stage "
            + "is not testing what it claims. Check Z42_GC_MODE's default and the auto-collect "
            + "policy before relaxing this floor.");
        return 1;
    }
    Console.WriteLine("  ok " + label + ": clean, " + cycles.ToString() + " GC cycles");
    return 0;
}

// Count `z42-gc: <Kind> …` cycle lines in a captured `Z42_GC_TRACE=1` stderr. The other trace
// shapes (`near heap limit`, `over budget`) are not cycles and must not be counted.
int _countGcCycles(string stderrText) {
    int n = 0;
    foreach (var line in stderrText.Split("\n")) {
        if (line.StartsWith("z42-gc: ") && line.Contains("  (cycle ")) { n = n + 1; }
    }
    return n;
}

int _testGcModes() {
    // The default leg: mode UNSET on purpose — see the note above.
    int c = _testGcModeWorkload("default mode, nursery 1M", "", "1M", "", 120, 1);
    if (c != 0) { return c; }
    c = _testGcModeWorkload("Z42_GC_MODE=stw, budget 16M", "stw", "", "16M", 20, 1);
    if (c != 0) { return c; }
    // 多线程编译腿：分代写屏障一类漏洞（年轻对象写进老对象不标脏卡）只在 `--jobs 4` + 小年轻代下
    // 才稳定复现 —— 串行腿撞不上。回收次数在多线程下不确定（多个线程同时越过
    // 阈值时请求会合并），下限只用来抓「回收器完全没被触发」，不追求压测强度（那由上面的串行腿保证）。
    return _testGcModeWorkload("default mode, nursery 1M, --jobs 4", "", "1M", "", 20, 4);
}

// ── cross-zpkg harness (invoked by `test e2e`) ──────────────────────────────

// cross-zpkg 与 multi-exe 两个 fixture harness 的**共用**构建前置：确保 debug z42vm
//（cargo，跑 fixtures）+ stdlib + z42c（种子自建，编 fixtures）就位。
//
// `--toolchain` 激活时整个跳过——工具链已供给 z42c+stdlib+z42vm，没有可建的东西。
// `noBuild` 同理（`test` 的 build wave / `test e2e` 的 golden run 已建过，或 --no-rebuild）。
// 返回 0 = 就位；非 0 = 构建失败的 rc，调用方直接透传。
//
// ⚠️ 这里的**次序**只此一份（z42vm 必须先于 stdlib 自建——stdlib 正是用 z42vm 建的），
// 别再在别处复制一份构建波。
int _ensureFixtureToolchain(bool noBuild) {
    if (noBuild || _toolchainDir(_root()).Length > 0) { return 0; }
    int cr = _exec(_cargoCmd("build", _runtimeCargoConfig()).Arg("-q")
        .Arg("--manifest-path").Arg(_runtimeManifest()));
    if (cr != 0) { return cr; }
    string root = _root();
    if (!File.Exists(Path.Join(_libsDir(root), "z42.core.zpkg"))) {
        int cs = _buildStdlib(); if (cs != 0) { return cs; }
    }
    return _buildCompiler();   // z42c 自建（种子）
}

int _testCrossZpkgCore(string mode, bool noBuild) {
    int c = _ensureFixtureToolchain(noBuild); if (c != 0) { return c; }
    return _testCrossZpkgImpl(mode);
}

// ── xtask test (unified GREEN gate) ───────────────────────────────────────────

// True if the comma/space-separated `skip` list names `stage`. Lets CI decompose
// the monolithic gate: test-host legs run `test --skip stdlib,cross-zpkg` while
// dedicated parallel jobs (stdlib-interp shards / cross-zpkg-interp) cover those
// stages — cutting the per-leg critical path. Local `xtask test` passes skip="" →
// full gate.
bool _skipHas(string skip, string stage) {
    return skip.Length > 0 && _strIn(_splitWords(skip.Replace(",", " ")), stage);
}

// ── stage 清单 ↔ test-gate.md 防漂移门 ─────────────────────────────────────
//
// 为什么要这道门：test-gate.md 自称「GREEN gate stage 组成的唯一权威清单（SoT）」，
// 但**纯纪律守不住一份没有测试盯着的清单**——历史上加 stage 不同步该页的事故反复发生。
// 所以把「gate 跑哪些 stage」变成数据 + 开跑前与文档对账。
//
// 加/删/改名一个 stage 的正确姿势：改 _gateStageNames() + test-gate.md 的
// gate-stages 区，两处一致才绿；只改一处 → 本门变红并打印差异。

// gate 的规范 stage 名单（代码侧唯一 SoT），顺序 = _testAll 的实际执行顺序。
// 含 build wave：它也走 _stageStart 打 banner、也计入耗时表，对读日志的人就是一个 stage。
string[] _gateStageNames() {
    return new string[]{
        "build wave (debug vm + regen)",
        "rust units (cargo test --lib + --no-run)",
        "e2e goldens (interp; jit → vm-jit-consistency)",
        "e2e cross-zpkg",
        "e2e multi-exe",
        "stdlib [Test]",
        "toolchain [Test]",
        "stdlib [Benchmark]",
        "manifest targets ([[test]] + [[example]])",
        "examples (learn book transcripts)",
        "docs (relative links)",
        "compiler",
        "gc modes (z42c.semantics build)",
        "vscode-syntax",
        "diagcodes",
        "stage2",
        "ci-shell",
        "proc-env",
        "layout",
        "versions",
        "layers"
    };
}

// test-gate.md 里机器可读清单区的边界标记（HTML 注释：渲染成 book 时不可见）。
string _gateStagesDocPath(string root) {
    return Path.Join(root, "docs/internals/src/devinfra/test-gate.md");
}

// 从 test-gate.md 的 <!-- gate-stages:begin/end --> 区抽出 stage 名（每行一个 `- \`name\``）。
string[] _gateStagesFromDoc(string text) { return _docListBlock(text, "gate-stages"); }

// 文档里机器可读清单区 <!-- <name>:begin/end --> 的条目：每行 `- \`item\` …`，取第一对反引号里的
// 内容，其后的文字是给人读的说明（test-layout.md 的清单带「搬去哪 / 为什么」）。区块缺失返回 null
// （调用方报「标记不见了」而非「清单为空」——两种失败原因不同，混在一起会让人去改清单而不是去找
// 被删掉的标记）。
string[] _docListBlock(string text, string name) {
    int b = text.IndexOf("<!-- " + name + ":begin -->");
    int e = text.IndexOf("<!-- " + name + ":end -->");
    if (b < 0 || e < 0 || e < b) { return null; }
    // "\n" 而非 '\n'：z42 的 Split 无 char 重载。CRLF 下每行尾留的 \r 由下面的 Trim() 吃掉。
    string[] lines = text.Substring(b, e - b).Split("\n");
    var items = new List<string>();
    foreach (var line in lines) {
        string ln = line.Trim();
        // 只认 "- `item`…" 形状，其余（标记行 / 空行 / 说明文字）跳过。
        if (!ln.StartsWith("- `")) { continue; }
        string rest = ln.Substring(3);
        int q = rest.IndexOf("`");
        if (q <= 0) { continue; }
        items.Add(rest.Substring(0, q));
    }
    return items.ToArray();
}

// 对账 _gateStageNames() 与 test-gate.md。不一致 → 打印逐条差异后返回 1。
int _checkGateStageDoc() {
    string root = _root();
    string docPath = _gateStagesDocPath(root);
    if (!File.Exists(docPath)) {
        ConsoleError.WriteLine("error: gate stage SoT 文档不存在: " + docPath);
        return 1;
    }
    string[] want = _gateStageNames();
    string[] got = _gateStagesFromDoc(File.ReadAllText(docPath));
    if (got == null) {
        ConsoleError.WriteLine("error: test-gate.md 缺 <!-- gate-stages:begin/end --> 标记区");
        ConsoleError.WriteLine("       该区是 stage 清单的机器可读副本，不能删——见 _checkGateStageDoc");
        return 1;
    }
    if (string.Join("\n", want) == string.Join("\n", got)) { return 0; }
    ConsoleError.WriteLine("error: GREEN gate stage 清单与 docs/internals/src/devinfra/test-gate.md 不一致");
    ConsoleError.WriteLine("       代码 (_gateStageNames, scripts/test/xtask_test.z42):");
    int k = 0;
    while (k < want.Length) { ConsoleError.WriteLine("         " + (k + 1).ToString() + ". " + want[k]); k = k + 1; }
    ConsoleError.WriteLine("       文档 (gate-stages 区):");
    k = 0;
    while (k < got.Length) { ConsoleError.WriteLine("         " + (k + 1).ToString() + ". " + got[k]); k = k + 1; }
    ConsoleError.WriteLine("       → 改了 gate 组成就两处一起改；文档区是给人读的 SoT，代码是执行的 SoT。");
    return 1;
}

// `test` (no target) — the full GREEN gate, sequential: build once, then run every stage
// in _gateStageNames() order, short-circuiting on first failure.
int _testAll(bool noBuild, string skip) {
    Stopwatch sw = _procStart("test");
    // stage 清单 ↔ 文档对账：放在构建波之前，几毫秒，失败即停——文档漂移不该让人
    // 等十几分钟的 gate 跑完才发现。
    int dc = _checkGateStageDoc(); if (dc != 0) { return dc; }
    // build wave (once): stdlib + compiler driver + release runtime + golden zbc.
    // Skip the z42c+stdlib rebuild when they're already present — either a --toolchain
    // is set (CI downloads current-sdk) OR --no-build is passed (the CI bootstrap step
    // already built them). In both cases only regen the goldens (the bootstrap doesn't
    // produce them); the stages below run --no-build.
    bool haveTc = _toolchainDir(_root()).Length > 0;
    // Build the debug z42vm + compression cdylib BEFORE regen. golden regen
    // (_regenGolden) resolves the debug vm via _activeVm(root,"debug"); if it runs
    // first against a STALE debug vm that predates a newly-added VM builtin, every
    // golden compile panics ("unknown builtin") and regen returns 1 — which then
    // early-returns here before the debug vm ever gets rebuilt. Building it first
    // keeps regen on a current vm.
    StageLogZ slog = new StageLogZ();
    // build wave 也计时：它常常是整个 gate 里最大的一块（CI 上 regen + 自建），
    // 不计的话下面的 stage 表加起来对不上总时长，反而误导。
    int c = _gateStage(slog, skip, "", "build wave (debug vm + regen)", () => {
        int bc = _buildDebugVmAndCompression();
        return bc != 0 ? bc : _regenForTest(haveTc, noBuild);
    });
    if (c != 0) { return c; }
    // Rust 单测（窄版 —— `--lib` 跑 + `--no-run` 编；完整版为何不进 gate 见 `_testRuntimeUnits` 头注）。
    // 放在 build wave 之后、最靠前：Rust 逻辑坏掉**第一时间**红，而不是等后面的 stage 跑完。
    c = _gateStage(slog, skip, "rust-units", "rust units (cargo test --lib + --no-run)", () => _testRuntimeUnits());
    if (c != 0) { return c; }
    // e2e goldens — INTERP only. JIT is gated by the dedicated vm-jit-consistency CI
    // job (linux-x64): cranelift JIT behaviour is host-independent, so running jit on
    // every OS leg would be redundant and put the slow per-case cranelift compile on
    // every host leg's critical path.
    c = _gateStage(slog, skip, "", "e2e goldens (interp; jit → vm-jit-consistency)",
        () => _testE2eCore("interp", false, false, "4", "", "", ""));
    if (c != 0) { return c; }

    // e2e cross-zpkg (skippable: CI offloads to a dedicated cross-zpkg-interp job)
    c = _gateStage(slog, skip, "cross-zpkg", "e2e cross-zpkg", () => _testCrossZpkgCore("interp", true));
    if (c != 0) { return c; }
    // e2e multi-exe (one project → N exe zpkgs)
    c = _gateStage(slog, skip, "multi-exe", "e2e multi-exe", () => _testMultiExeCore("interp", true));
    if (c != 0) { return c; }
    // stdlib [Test] (no build) (skippable: CI shards it across stdlib-interp jobs)
    c = _gateStage(slog, skip, "stdlib", "stdlib [Test]",
        () => _testLibCore("test", new string[0], true, "", "4", "interp", null, "", "", ""));
    if (c != 0) { return c; }
    // 工具链组件的 [Test] 单元（test-layout §1；src/toolchain/<comp>/**/tests）。与 stdlib 同一个
    // runner，单独成 stage：CI 的 host 腿 `--skip stdlib`（stdlib 另有分 OS 的 job），工具链用例量小、
    // 又多是 host 相关（REPL 终端键位），就留在每条 host 腿上跑。
    c = _gateStage(slog, skip, "toolchain", "toolchain [Test]", () => _testToolchainCore("", true, "", false));
    if (c != 0) { return c; }
    // stdlib [Benchmark] —— 只验**语料能不能跑**，不看快慢。
    //
    // 为什么它必须在 GREEN gate 里：bench 语料的另一个看门人 `bench-regression`(bench-pr.yml)
    // **不在分支保护的 required 列表里**——会红但不挡人的门等价于没有门。把它提进 required 不可行：
    // bench-pr.yml 是 path-filtered，纯文档 PR 上根本不触发 ⇒ required check 恒 pending。所以拆两层：
    //   「语料能不能跑」→ 本 stage（确定性；只有跑挂才红，不判时间 ⇒ 零噪声）
    //   「跑多快」      → 留给 bench-regression 那套 A/B 判红
    // host-independent ⇒ CI 只在 linux-x64 腿跑，其余腿 `--skip bench`（同 cross-zpkg 的处置）。
    c = _gateStage(slog, skip, "bench", "stdlib [Benchmark]",
        () => _testLibCore("bench", new string[0], true, "", "4", "interp", null, "", "", ""));
    if (c != 0) { return c; }
    // manifest-target fixtures ([[test]] harness true/false exit-code + explicit-overlay,
    // [[example]]). noBuild=true:
    // the wave + stdlib stage already prepared the release toolchain.
    c = _gateStage(slog, skip, "targets", "manifest targets ([[test]] + [[example]])", () => {
        int tc = _testTargetsCore("test", "", true);
        return tc != 0 ? tc : _testManifestExamples(true);
    });
    if (c != 0) { return c; }
    // 学习手册配套示例：书 ↔ examples 引用校验 +
    // 用 SDK 里真实的 `z42` 重放每个 examples/**/*.console。SDK 用 artifacts/.z42：本地完整 gate
    // 先建（apphost 发布 + 组装）；--no-build（CI）消费前一步 `build toolchain` + `package dev-sdk`
    // 的产物，缺失即红。
    c = _gateStage(slog, skip, "examples", "examples (learn book transcripts)", () => _gateExamples(noBuild));
    if (c != 0) { return c; }
    // 文档门禁：相对链接死链清零。不需要 SDK、秒级。
    c = _gateStage(slog, skip, "docs", "docs (relative links)", () => _testDocs(_root()));
    if (c != 0) { return c; }
    // z42c self-host byte-identical. Skippable: CI offloads to a dedicated
    // compiler-checks(linux-x64) job (host-independent output).
    c = _gateStage(slog, skip, "compiler", "compiler", () => _testCompiler(true));
    if (c != 0) { return c; }
    // recompile one real package under each GC mode, with the collector tuned to fire
    // hundreds of times (see _testGcModeWorkload). Premature-collection defects surface
    // as the compiler crashing mid-build on a dangling reference, and a GC mode nothing
    // else exercises is where they hide — so both modes run, each with an asserted
    // collection floor. Skippable: host-independent, CI runs it 1x.
    c = _gateStage(slog, skip, "gcgen", "gc modes (z42c.semantics build)", () => _testGcModes());
    if (c != 0) { return c; }
    // VSCode grammar ↔ Lexer 关键字一致性（跨子系统 SoT，性质同自举不动点；
    // ≈一次 z42c fork，成本可忽略）
    // Skippable: same rationale as compiler — host-independent, 1× on CI.
    c = _gateStage(slog, skip, "vscode", "vscode-syntax", () => _testVscodeSyntax());
    if (c != 0) { return c; }
    // 诊断码唯一性对账：一个码号挂两个含义、
    // 或发射一个没在登记表里登记过的码 → 红。纯文本扫描（~1s），host-independent。Skippable: "diagcodes"。
    c = _gateStage(slog, skip, "diagcodes", "diagcodes", () => _testDiagCodes(false));
    if (c != 0) { return c; }
    // 阶段-2 欠账（分阶段引入纪律）：过渡形态必须挂账、且不得超期。
    // 「阶段 2 忘了不会红」是本仓库反复吃过的亏 —— 诊断码那条线有 ④⑥ 盯着，其余一直靠谁记得。
    // 纯文本扫描（~1s），host-independent。Skippable: "stage2"。
    c = _gateStage(slog, skip, "stage2", "stage2", () => _testStage2Debt());
    if (c != 0) { return c; }
    // CI 内嵌 shell 的先用后赋（`.github/**` 的多行 `run:` 块；判据见 xtask_test_ci_shell.z42）。
    // 纯文本扫描（~1s），host-independent，零外部依赖。Skippable: "ci-shell"。
    c = _gateStage(slog, skip, "ci-shell", "ci-shell", () => _testCiShell());
    if (c != 0) { return c; }
    // xtask 子进程的 Z42_LIBS / Z42_PROBING_PATHS 只经 _z42Proc / _z42bProc 设置。漏设不在漏处报错
    // （继承 xtask 自身的旧 SDK libs / z42b 加载编译器包才炸），集中到工厂才不会漏。纯文本扫描。Skippable: "proc-env"。
    c = _gateStage(slog, skip, "proc-env", "proc-env", () => _testProcEnv());
    if (c != 0) { return c; }
    // 测试布局（test-layout.md 里能机械判定的部分）：src/tests 类别登记、能力词表 ↔
    // platform.rs、requires-caps / [Skip(feature:)] 只用已生效能力名。纯文本扫描。Skippable: "layout"。
    c = _gateStage(slog, skip, "layout", "layout", () => _testLayout());
    if (c != 0) { return c; }
    // versions.toml ↔ 投影文件（Cargo.toml / build.gradle.kts / Package.swift）一致。与机器无关的
    // 纯文本比对（本机装没装齐是 `setup check` 的事）。Skippable: "versions"。
    c = _gateStage(slog, skip, "versions", "versions", () => _checkVersions());
    if (c != 0) { return c; }
    // stage 15: 运行时分层（runtime-audit §5.5 的目标组件与依赖方向）：跨组件引用与 pal 外的平台 cfg / libc
    // 只减不增（基线 gates.toml [layers.*]）。纯文本扫描，host-independent。Skippable: "layers"。
    c = _gateStage(slog, skip, "layers", "layers", () => _testLayers(false));
    if (c != 0) { return c; }
    Console.WriteLine("\n✅ GREEN — all stages passed");
    _stageSummary(slog, sw.Elapsed().TotalMilliseconds());
    _procEnd("test", sw);
    return 0;
}

// examples stage 的 body（说明见 _testAll 里该 stage 处）。
int _gateExamples(bool noBuild) {
    if (!noBuild) {
        int c = _buildToolchain(); if (c != 0) { return c; }
        c = _packageDevSdk(""); if (c != 0) { return c; }
    }
    ExamplesOptions eo = new ExamplesOptions();
    eo.Filter = ""; eo.Sdk = ""; eo.BookOnly = false; eo.Bless = false; eo.Keep = false; eo.TimeoutS = 120;
    return _testExamples(eo);
}

// ── shard parsing (shared: _testE2eCore + the test-lib harness) ──────────────

// Parse a `--shard k/n` spec → [k, n]; returns [0,0] for empty/invalid (= no
// sharding). Used to split the slow jit suites across N parallel CI machines.
int[] _parseShard(string s) {
    int[] r = new int[2]; r[0] = 0; r[1] = 0;
    if (s.Length == 0) { return r; }
    int slash = s.IndexOf("/");
    if (slash <= 0) { return r; }
    if (slash >= s.Length - 1) { return r; }
    try {
        int k = int.Parse(s.Substring(0, slash));
        int n = int.Parse(s.Substring(slash + 1, s.Length - slash - 1));
        if (k >= 1 && n >= 1 && k <= n) { r[0] = k; r[1] = n; }
    } catch (Exception e) { r[0] = 0; r[1] = 0; }
    return r;
}

