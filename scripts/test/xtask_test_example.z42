// xtask — 清单 `[examples]` / `[[example]]` 目标（工程级 example target）。
// 与仓库根 `examples/`（学习手册配套示例，见 xtask_test_examples.z42）无关。
//
// example target 默认「只编不跑」：GREEN 的 targets stage 编译每个声明的 example
// （必须能编过），只运行标了 `test = true` 的，退出码判定。entry 取 `[[example]].entry`，约定文件则取
// 源文件 `namespace` + ".Main"。
//
// 发现：扫描声明了 examples 的工程（stdlib 各库 + manifest-target fixtures）：`[examples]` 段自动 glob
// （约定目录 `examples/`）+ 显式 `[[example]]`。复用 example 构建器（xtask_example_build.z42）与 fixture 工具准备（_prepFixtureTooling）。
namespace Z42Xtask;

using Std.IO;
using Std.Collections;
using Z42.Project;

// targets stage 的 example 部分：编译全部工程的 example target，运行 `test = true` 的。
// noBuild → 复用已准备好的 release 工具链。返回 0 通过 / 1 失败 / 2 准备失败。
int _testManifestExamples(bool noBuild) {
    string root = _root();
    if (noBuild && !_releaseStdlibReady(root)) {
        Console.WriteLine("(skip manifest examples: release stdlib not built on this leg)");
        return 0;
    }
    TargetTooling tt = _prepFixtureTooling(root, noBuild);
    if (!tt.Ok) { return 2; }
    string[] roots = new string[] { Path.Join(root, "src/libraries"), _fixturesRoot(root) };
    ExampleCounts counts = new ExampleCounts();
    foreach (var r in roots) {
        if (!Directory.Exists(r)) { continue; }
        foreach (var proj in _sortedStrings(Directory.Enumerate(r))) {
            string projDir = Path.Join(r, proj);
            string toml = _findManifest(projDir).ManifestPath;
            if (toml.Length > 0 && Directory.Exists(projDir)) {
                _exampleRunProject(root, projDir, proj, toml, tt, counts);
            }
        }
    }
    Console.WriteLine("");
    if (counts.Failed > 0) {
        Console.WriteLine("  ❌ examples: " + counts.Failed.ToString() + " failure(s) (" + counts.Compiled.ToString() + " compiled, " + counts.Ran.ToString() + " ran)");
        return 1;
    }
    Console.WriteLine("  ✅ examples: " + counts.Compiled.ToString() + " compiled, " + counts.Ran.ToString() + " ran");
    return 0;
}

class ExampleCounts {
    public int Compiled;
    public int Ran;
    public int Failed;
}

// 编译一个工程的全部 example，只运行 RunInTest 标记的目标。
void _exampleRunProject(string root, string projDir, string projName, string toml,
                        TargetTooling tt, ExampleCounts counts) {
    ProjectManifest man = _loadManifestOr(toml);
    RunTarget[] tgts = _explicitTargets(man, "example");
    string verr = _validateRunTargets(tgts, tgts.Length, "example");
    if (verr.Length > 0) { ConsoleError.WriteLine("error: " + projName + ": " + verr); counts.Failed = counts.Failed + 1; return; }
    foreach (var ex in _discoverExamples(projDir, man, tgts)) {
        DepBundle deps = _exampleDeps(man, ex.DepNames, ex.DepVersions, ex.DepCount);
        int rc = _runExampleTarget(root, projDir, projName, tt, ex, deps);
        counts.Compiled = counts.Compiled + 1;
        if (ex.RunInTest) { counts.Ran = counts.Ran + 1; }
        if (rc != 0) { counts.Failed = counts.Failed + 1; }
    }
}

// Local example unit. xtask reads the imported RunTarget (z42.project) but does not
// construct it, so synthesised / normalised examples use this local type; deps are
// carried as raw (name, version) arrays.
class ExampleUnit {
    public string   Name        { get; set; }
    public string   Entry       { get; set; }
    public bool     HasEntry    { get; set; }
    public string[] Sources     { get; set; }
    public int      SrcCount    { get; set; }
    public string[] DepNames    { get; set; }   // raw dep (name, version) pairs — primitive
    public string[] DepVersions { get; set; }   // arrays only (no imported DepEntry field)
    public int      DepCount    { get; set; }
    public bool     RunInTest   { get; set; }
}

// All example targets for a project: convention auto (section [examples] auto,
// dir `examples/`) overlaid by explicit [[example]] (same name overrides). Auto
// examples derive entry = <namespace>.Main from their source file.
ExampleUnit[] _discoverExamples(string projDir, ProjectManifest man, RunTarget[] explicitTgts) {
    List<ExampleUnit> acc = new List<ExampleUnit>();
    if (_sectionAuto(man, "example")) { acc.AddRange(_autoExamples(projDir)); }
    foreach (var t in explicitTgts) {
        ExampleUnit norm = _normalizeExample(projDir, t);
        int at = 0;
        while (at < acc.Count && acc[at].Name != t.Name) { at = at + 1; }
        if (at < acc.Count) { acc[at] = norm; } else { acc.Add(norm); }
    }
    return acc.ToArray();
}

// Convention examples under <projDir>/examples/: single-file *.z42 (name=stem)
// and dir */source.z42 (name=dir). Entry = source namespace + ".Main".
ExampleUnit[] _autoExamples(string projDir) {
    string dir = Path.Join(projDir, "examples");
    if (!Directory.Exists(dir)) { return new ExampleUnit[0]; }
    List<ExampleUnit> r = new List<ExampleUnit>();
    foreach (var e in _sortedStrings(Directory.Enumerate(dir))) {
        string full = Path.Join(dir, e);
        if (Directory.Exists(full)) {
            string src = Path.Join(full, "source.z42");
            if (File.Exists(src)) {
                r.Add(_mkExample(e, _fileEntry(src), new string[] { "examples/" + e + "/**/*.z42" }));
            }
        } else if (e.EndsWith(".z42")) {
            string stem = e.Substring(0, e.Length - 4);
            r.Add(_mkExample(stem, _fileEntry(full), new string[] { "examples/" + e }));
        }
    }
    return r.ToArray();
}

// Convert an explicit [[example]] RunTarget → ExampleUnit, deriving entry from the
// convention source when the target omits one. (Reads imported RunTarget fields;
// never `new`s it.)
ExampleUnit _normalizeExample(string projDir, RunTarget t) {
    string entry = t.Entry;
    bool hasEntry = t.HasEntry;
    if (!hasEntry) {
        string single = Path.Join(Path.Join(projDir, "examples"), t.Name + ".z42");
        string dsrc = Path.Join(Path.Join(Path.Join(projDir, "examples"), t.Name), "source.z42");
        if (File.Exists(single)) { entry = _fileEntry(single); }
        else if (File.Exists(dsrc)) { entry = _fileEntry(dsrc); }
        hasEntry = entry.Length > 0;
    }
    string[] dn = new string[t.DepCount];
    string[] dv = new string[t.DepCount];
    int di = 0;
    while (di < t.DepCount) { dn[di] = t.Deps[di].Name; dv[di] = t.Deps[di].Version; di = di + 1; }
    ExampleUnit u = new ExampleUnit();
    u.Name = t.Name; u.Entry = entry; u.HasEntry = hasEntry;
    u.Sources = t.Sources; u.SrcCount = t.SrcCount;
    u.DepNames = dn; u.DepVersions = dv; u.DepCount = t.DepCount; u.RunInTest = t.RunInTest;
    return u;
}

// A convention example unit: Main program, harness ignored, entry derived.
ExampleUnit _mkExample(string name, string entry, string[] inc) {
    ExampleUnit u = new ExampleUnit();
    u.Name = name; u.Entry = entry; u.HasEntry = entry.Length > 0;
    u.Sources = inc; u.SrcCount = inc.Length;
    u.DepNames = new string[0]; u.DepVersions = new string[0]; u.DepCount = 0; u.RunInTest = false;
    return u;
}

// <namespace>.Main from a source file (or "Main" when no namespace is declared).
string _fileEntry(string file) {
    string ns = "";
    try { ns = _extractNamespace(File.ReadAllText(file)); } catch (Exception e) { ns = ""; }
    if (ns.Length > 0) { return ns + ".Main"; }
    return "Main";
}
