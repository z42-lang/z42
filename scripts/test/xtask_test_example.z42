// xtask — example target runner (add-tests-bench-manifest-config P3).
// Same Z42Xtask namespace. Examples are a first-class dev target that DEFAULT to
// "compile-only" (design D4): `xtask test` compiles every declared example as a
// gate (must always build), runs only those marked `test = true`; `xtask example
// [name]` compiles + runs one (or all test=true when name omitted), exit-code
// judged. example targets are always Main programs — `harness` is ignored; the
// entry is the explicit `[[example]].entry` or, for convention files, the source
// file's `namespace` + ".Main".
//
// Discovery scans every project (stdlib libs + manifest-target fixtures) that
// declares examples: section `[examples]` auto glob (convention dir `examples/`)
// + explicit `[[example]]`. Reuses the exit-target compiler (_runExitTarget,
// xtask_manifest_targets.z42) and the fixture tooling prep (_prepFixtureTooling).
namespace Z42Xtask;

using Std;
using Std.IO;
using Z42.Build.Project;

// `xtask test` example gate: compile ALL examples across every project (fail the
// stage if any won't build), run those with `test = true`. noBuild → reuse the
// already-prepared release toolchain. Returns 0 (pass) / 1 (fail) / 2 (setup).
int _testExampleGate(bool noBuild) {
    string root = _root();
    if (noBuild && !_releaseStdlibReady(root)) {
        Console.WriteLine("(skip examples: release stdlib not built on this leg)");
        return 0;
    }
    TargetTooling tt = _prepFixtureTooling(root, noBuild);
    if (!tt.Ok) { return 2; }
    int rcTop = _topLevelExamplesGate(root, tt);   // gate-toplevel-examples：仓库根 examples/
    int rcProj = _exampleRun(root, tt, "", true);   // gate: compile all, run test=true
    return rcProj != 0 ? rcProj : rcTop;
}

// `xtask example [name]` — compile + run one example by name, or (no name) every
// example marked test=true. Always builds tooling first (dev convenience).
int _testExample(string name) {
    string root = _root();
    TargetTooling tt = _prepFixtureTooling(root, false);
    if (!tt.Ok) { return 2; }
    return _exampleRun(root, tt, name, false);
}

// Core: iterate every project dir under src/libraries + src/tests/manifest-targets,
// discover its example targets, compile all (gate), and run the selected ones.
// gate=true → run only RunInTest targets; gate=false → run `name` (exact) or all
// RunInTest when name=="". A name matching nothing → error listing available.
int _exampleRun(string root, TargetTooling tt, string name, bool gate) {
    string[] roots = new string[2];
    roots[0] = Path.Join(root, "src/libraries");
    roots[1] = _fixturesRoot(root);
    int failed = 0;
    int compiled = 0;
    int ran = 0;
    string avail = "";
    int ri = 0;
    while (ri < roots.Length) {
        if (Directory.Exists(roots[ri])) {
            string[] projs = _sortedStrings(Directory.Enumerate(roots[ri]));
            int pi = 0;
            while (pi < projs.Length) {
                string projDir = Path.Join(roots[ri], projs[pi]);
                string toml = _findToml(projDir);
                if (toml.Length > 0 && Directory.Exists(projDir)) {
                    int[] cref = new int[3]; cref[0] = compiled; cref[1] = ran; cref[2] = failed;
                    _exampleRunProject(root, projDir, projs[pi], toml, tt, name, gate, cref, ref avail);
                    compiled = cref[0]; ran = cref[1]; failed = cref[2];
                }
                pi = pi + 1;
            }
        }
        ri = ri + 1;
    }
    if (!gate && name.Length > 0 && ran == 0 && failed == 0) {
        ConsoleError.WriteLine("error: no example named '" + name + "'");
        if (avail.Length > 0) { ConsoleError.WriteLine("  available: " + avail); }
        return 2;
    }
    Console.WriteLine("");
    if (failed > 0) {
        Console.WriteLine("  ❌ examples: " + failed.ToString() + " failure(s) (" + compiled.ToString() + " compiled, " + ran.ToString() + " ran)");
        return 1;
    }
    Console.WriteLine("  ✅ examples: " + compiled.ToString() + " compiled, " + ran.ToString() + " ran");
    return 0;
}

// ── 顶层 examples/ 编译门（gate-toplevel-examples）─────────────────────────────
//
// 🔴 `_exampleRun` 只扫 `src/libraries/*` 与 manifest-target fixtures，而 `src/libraries/`
// 下**没有任何** `examples/` 目录或 `[[example]]` 声明 ⇒ 仓库根 `examples/` 的 22 个 `.z42`
// **从来没有被任何 stage 编译过**，stage 却打印「✅ examples: 1 compiled」（那 1 个是合成
// fixture）。实测后果：8 个示例编不过，其中 5 个用的是 z42 **压根没有的语法**（C#-ism），
// 最久的一条烂了多久无从查起——因为没有任何东西看过它们。
//
// 判据 = `z42c --emit-zbc <file>` 的退出码（#550 之后它不再吞诊断，有错即非零）。
//
// **双向棘轮**（同 `line-limit-baseline.txt` 的惯例，那套机制抓到过我自己的误判）：
//   · 名单外编不过 → **红**（新增破坏）
//   · 名单内编不过 → 响亮打印，不阻断（已知欠债）
//   · **名单内却编过了 → 红**，提示从名单删除（防「修好了忘删」变成下一个假保障）
int _topLevelExamplesGate(string root, TargetTooling tt) {
    string dir = Path.Join(root, "examples");
    if (!Directory.Exists(dir)) { return 0; }
    string[] known = _knownBrokenExamples(root);
    string[] names = _sortedStrings(Directory.Enumerate(dir));
    string tmp = File.CreateTempDir("z42-ex-gate-");
    int ok = 0; int knownBad = 0; int failed = 0;
    int i = 0;
    while (i < names.Length) {
        string n = names[i];
        if (n.EndsWith(".z42")) {
            string src = Path.Join(dir, n);
            ProcessResult r = new Process(tt.Vm)
                .Arg(tt.DriverZpkg).Arg("--").Arg("--emit-zbc").Arg(src).Arg(Path.Join(tmp, "o.zbc"))
                .Env("Z42_LIBS", tt.Libs)
                .Run();
            bool compiled = r.ExitCode == 0;
            bool listed = _strArrHas(known, n);
            if (compiled && !listed) { ok = ok + 1; }
            else if (!compiled && listed) {
                knownBad = knownBad + 1;
                Console.WriteLine("  ⚠ examples/" + n + "：已知编不过（在 examples-known-broken.txt 名单里）");
            } else if (compiled && listed) {
                failed = failed + 1;
                ConsoleError.WriteLine("  ✗ examples/" + n + "：**现在编得过了** —— 请从 "
                    + "scripts/test/examples-known-broken.txt 删掉它（名单留着就会变成下一个假保障）");
            } else {
                failed = failed + 1;
                ConsoleError.WriteLine("  ✗ examples/" + n + "：编译失败（新增破坏）");
                ConsoleError.WriteLine(r.Stdout + r.Stderr);
            }
        }
        i = i + 1;
    }
    Directory.Delete(tmp, true);
    Console.WriteLine("  顶层 examples/：" + ok.ToString() + " 编过, " + knownBad.ToString()
        + " 已知欠债, " + failed.ToString() + " 失败");
    return failed > 0 ? 1 : 0;
}

// 已知编不过的顶层 example 文件名（一行一个，`#` 起头为注释）。缺文件 = 空名单。
string[] _knownBrokenExamples(string root) {
    string f = Path.Join(root, "scripts/test/examples-known-broken.txt");
    if (!File.Exists(f)) { return new string[0]; }
    string[] lines = File.ReadAllText(f).Split("\n");
    string[] outp = new string[lines.Length];
    int n = 0;
    int i = 0;
    while (i < lines.Length) {
        string t = lines[i].Trim();
        int h = t.IndexOf("#");                      // 行尾注释（`name.z42   # 卡在哪个构造`）
        if (h >= 0) { t = t.Substring(0, h).Trim(); }
        if (t.Length > 0) { outp[n] = t; n = n + 1; }
        i = i + 1;
    }
    string[] r = new string[n];
    i = 0; while (i < n) { r[i] = outp[i]; i = i + 1; }
    return r;
}

bool _strArrHas(string[] a, string v) {
    int i = 0;
    while (i < a.Length) { if (a[i] == v) { return true; } i = i + 1; }
    return false;
}

// Discover + compile/run one project's examples. Updates cref[0]=compiled,
// cref[1]=ran, cref[2]=failed; appends names to `avail`.
void _exampleRunProject(string root, string projDir, string projName, string toml,
                        TargetTooling tt, string name, bool gate, int[] cref, ref string avail) {
    ProjectManifest man = _loadManifestOr(toml);
    RunTarget[] tgts = _explicitTargets(man, "example");
    string verr = _validateRunTargets(tgts, tgts.Length, "example");
    if (verr.Length > 0) { ConsoleError.WriteLine("error: " + projName + ": " + verr); cref[2] = cref[2] + 1; return; }
    ExampleUnit[] examples = _discoverExamples(projDir, man, tgts);
    int i = 0;
    while (i < examples.Length) {
        ExampleUnit ex = examples[i];
        avail = _appendName(avail, ex.Name);
        // run decision: gate → run iff RunInTest; explicit `xtask example name` →
        // run iff name matches (any name); `xtask example` (no name) → RunInTest.
        bool selected = (name.Length > 0) ? (ex.Name == name) : ex.RunInTest;
        bool runAfter = selected;
        // gate compiles EVERYTHING; `xtask example <name>` only touches the match.
        if (!gate && name.Length > 0 && ex.Name != name) { i = i + 1; continue; }
        DepBundle deps = _targetDepsPairs(man, "example", ex.DepNames, ex.DepVersions, ex.DepCount);
        int rc = _runExitTarget(root, projDir, projName + ".example", "examples",
                                ex.Name, ex.HasEntry, ex.Entry, ex.Sources, ex.SrcCount, deps,
                                tt.Vm, tt.DriverZpkg, tt.Libs, runAfter);
        cref[0] = cref[0] + 1;
        if (runAfter) { cref[1] = cref[1] + 1; }
        if (rc != 0) { cref[2] = cref[2] + 1; }
        i = i + 1;
    }
}

// Local example unit. xtask can reference/read the imported RunTarget (z42.project)
// but CANNOT `new` it (constructing an all-libs-indexed type errors E0401), so
// synthesised/normalised examples use this local type instead. Carries raw
// DepEntry[] (reading imported DepEntry fields is fine; only construction fails).
class ExampleUnit {
    public string   Name        { get; set; }
    public string   Entry       { get; set; }
    public bool     HasEntry    { get; set; }
    public string[] Sources     { get; set; }
    public int      SrcCount    { get; set; }
    public string[] DepNames    { get; set; }   // raw dep (name, version) pairs — primitive
    public string[] DepVersions { get; set; }   // arrays only (no imported DepEntry field)
    public int      DepCount    { get; set; }
    public bool     RunInTest   { get; set; }
}

// All example targets for a project: convention auto (section [examples] auto,
// dir `examples/`) overlaid by explicit [[example]] (same name overrides). Auto
// examples derive entry = <namespace>.Main from their source file.
ExampleUnit[] _discoverExamples(string projDir, ProjectManifest man, RunTarget[] explicitTgts) {
    ExampleUnit[] auto = new ExampleUnit[0];
    if (_sectionAuto(man, "example")) { auto = _autoExamples(projDir); }
    ExampleUnit[] acc = new ExampleUnit[auto.Length + explicitTgts.Length];
    int n = 0;
    int i = 0;
    while (i < auto.Length) { acc[n] = auto[i]; n = n + 1; i = i + 1; }
    int ti = 0;
    while (ti < explicitTgts.Length) {
        RunTarget t = explicitTgts[ti];
        int at = _indexOfTarget(acc, n, t.Name);
        ExampleUnit norm = _normalizeExample(projDir, t);
        if (at >= 0) { acc[at] = norm; } else { acc[n] = norm; n = n + 1; }
        ti = ti + 1;
    }
    ExampleUnit[] r = new ExampleUnit[n];
    int k = 0;
    while (k < n) { r[k] = acc[k]; k = k + 1; }
    return r;
}

int _indexOfTarget(ExampleUnit[] a, int n, string name) {
    int i = 0;
    while (i < n) { if (a[i].Name == name) { return i; } i = i + 1; }
    return -1;
}

// Convention examples under <projDir>/examples/: single-file *.z42 (name=stem)
// and dir */source.z42 (name=dir). Entry = source namespace + ".Main".
ExampleUnit[] _autoExamples(string projDir) {
    string dir = Path.Join(projDir, "examples");
    if (!Directory.Exists(dir)) { return new ExampleUnit[0]; }
    string[] entries = _sortedStrings(Directory.Enumerate(dir));
    ExampleUnit[] tmp = new ExampleUnit[entries.Length];
    int c = 0;
    int i = 0;
    while (i < entries.Length) {
        string e = entries[i];
        string full = Path.Join(dir, e);
        if (Directory.Exists(full)) {
            string src = Path.Join(full, "source.z42");
            if (File.Exists(src)) {
                string[] inc = new string[1]; inc[0] = "examples/" + e + "/**/*.z42";
                tmp[c] = _mkExample(e, _fileEntry(src), inc); c = c + 1;
            }
        } else if (e.EndsWith(".z42")) {
            string stem = e.Substring(0, e.Length - 4);
            string[] inc = new string[1]; inc[0] = "examples/" + e;
            tmp[c] = _mkExample(stem, _fileEntry(full), inc); c = c + 1;
        }
        i = i + 1;
    }
    ExampleUnit[] r = new ExampleUnit[c];
    int k = 0;
    while (k < c) { r[k] = tmp[k]; k = k + 1; }
    return r;
}

// Convert an explicit [[example]] RunTarget → ExampleUnit, deriving entry from the
// convention source when the target omits one. (Reads imported RunTarget fields;
// never `new`s it.)
ExampleUnit _normalizeExample(string projDir, RunTarget t) {
    string entry = t.Entry;
    bool hasEntry = t.HasEntry;
    if (!hasEntry) {
        string single = Path.Join(Path.Join(projDir, "examples"), t.Name + ".z42");
        string dsrc = Path.Join(Path.Join(Path.Join(projDir, "examples"), t.Name), "source.z42");
        if (File.Exists(single)) { entry = _fileEntry(single); }
        else if (File.Exists(dsrc)) { entry = _fileEntry(dsrc); }
        hasEntry = entry.Length > 0;
    }
    string[] dn = new string[t.DepCount];
    string[] dv = new string[t.DepCount];
    int di = 0;
    while (di < t.DepCount) { dn[di] = t.Deps[di].Name; dv[di] = t.Deps[di].Version; di = di + 1; }
    ExampleUnit u = new ExampleUnit();
    u.Name = t.Name; u.Entry = entry; u.HasEntry = hasEntry;
    u.Sources = t.Sources; u.SrcCount = t.SrcCount;
    u.DepNames = dn; u.DepVersions = dv; u.DepCount = t.DepCount; u.RunInTest = t.RunInTest;
    return u;
}

// A convention example unit: Main program, harness ignored, entry derived.
ExampleUnit _mkExample(string name, string entry, string[] inc) {
    ExampleUnit u = new ExampleUnit();
    u.Name = name; u.Entry = entry; u.HasEntry = entry.Length > 0;
    u.Sources = inc; u.SrcCount = inc.Length;
    u.DepNames = new string[0]; u.DepVersions = new string[0]; u.DepCount = 0; u.RunInTest = false;
    return u;
}

// <namespace>.Main from a source file (or "Main" when no namespace is declared).
string _fileEntry(string file) {
    string ns = "";
    try { ns = _extractNamespace(File.ReadAllText(file)); } catch (Exception e) { ns = ""; }
    if (ns.Length > 0) { return ns + ".Main"; }
    return "Main";
}
