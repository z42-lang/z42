// xtask — `test compiler incremental` 的 stdlib 整体读回对账。
//
// 小语料（demo / demo-packed / xtask）覆盖不到 stdlib 用到的全部指令与元数据（如方法级泛型形参、
// struct 指令的寄存器类型），所以用整个 stdlib 再做一轮：
//   release 全量建一遍 → 清空全部成员 dist（cache 保留）→ 再建：每个成员都全命中但无法 preserved，只能由
//   cache 读回的 IR 重新打包 → 每个包必须与全量逐字节一致。
// 运行于 z42c.pipeline 的 tests/ 输出下的 incremental/stdlib（拷贝源，不动真实产物）。
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

int _wsReadbackBuild(string vm, string driver, string libs, string cwd, bool noIncr) {
    Process p = _z42cProc(vm, libs, driver)
        .Arg("build").Arg("--workspace").Arg("--release");
    if (noIncr) { p = p.Arg("--no-incremental"); }
    return p.WorkingDirectory(cwd).Stdout(Stdio.Null()).Stderr(Stdio.Inherit()).Run().ExitCode;
}

int _reconcileStdlibReadback(string root, string vm, string driver, string libs, string scratch) {
    Console.WriteLine("\n── reconcile: stdlib workspace readback ──");
    string srcLibs = Path.Join(scratch, "stdlib/src/libraries");
    Directory.Copy(Path.Join(root, "src/libraries"), srcLibs, true);
    string ws = Path.Join(srcLibs, "z42.workspace.toml");
    List<string> members = new List<string>();
    foreach (var d in _enumDirsSorted(srcLibs)) {
        if (Path.Glob(Path.Join(srcLibs, d), "*.z42.toml").Length > 0) { members.Add(d); }
    }
    if (_wsReadbackBuild(vm, driver, libs, srcLibs, true) != 0) { ConsoleError.WriteLine("  ✗ stdlib full build failed"); return 1; }
    // 全量快照：拷到 snap 目录（z42 无交错数组，不在内存里存每包字节）。
    string snap = Path.Join(scratch, "stdlib-full-snap");
    _resetDir(snap);
    foreach (var m in members) {
        string z = Path.Join(_memberDist(ws, m, "release"), m + ".zpkg");
        if (File.Exists(z)) { File.Copy(z, Path.Join(snap, m + ".zpkg")); }
        Directory.Delete(_memberDist(ws, m, "release"), true);
    }
    if (_wsReadbackBuild(vm, driver, libs, srcLibs, false) != 0) { ConsoleError.WriteLine("  ✗ stdlib all-cached rebuild failed"); return 1; }
    List<string> bad = new List<string>();
    foreach (var m in members) {
        string z = Path.Join(_memberDist(ws, m, "release"), m + ".zpkg");
        if (!_filesEqual(z, Path.Join(snap, m + ".zpkg"))) { bad.Add(m); }
    }
    if (bad.Count > 0) {
        ConsoleError.WriteLine("  ✗ MISMATCH: all-cached reassembly != full for " + bad.Count.ToString()
            + " package(s): " + String.Join(", ", bad.ToArray()));
        return 1;
    }
    Console.WriteLine("  ✓ dist wiped + all-cached reassembly: " + members.Count.ToString() + "/" + members.Count.ToString() + " stdlib packages byte-identical to full");
    return 0;
}
