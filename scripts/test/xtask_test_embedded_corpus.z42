// xtask — embedded test-host：语料枚举 / 分片 / bundle 组装
//
// 扫描 src/tests + stdlib tests 得到 _CorpusCase 全集，按 filter 筛、按 shard 切片或抽样，
// 再调 xtask_test_embedded_golden.z42 里的发射器逐个产出 .zbc，最后写 manifest.json 成 test-bundle。
namespace Z42Xtask;

using Std.IO;
using Std.Collections;

// One enumerated corpus case (structural descriptor, rid-independent). Shared SoT
// for both the embedded bundle builder (_buildTestBundle) and the `test list`
// catalog (_testList) — one enumeration, two consumers, no drift.
//   kind: "golden"   → direct-run (src/tests + lib goldens) via _compileBundleCases + _goldenEntryFor
//         "unit"     → stdlib [Test] file  (tests/<f>.z42)   via _compileBundleCases (--emit-zbc)
//         "dir-unit" → stdlib [Test] dir   (tests/<nm>/)     via _compileBundleCases (_dirUnitManifest → build)
class _CorpusCase {
    public string name;        // caseName, e.g. "classes/basic_class" | "z42.io/env_cwd"
    public string bucket;      // grouping key (src/tests <cat> or stdlib <lib>)
    public string kind;        // golden | unit | dir-unit
    public string src;         // source .z42 path (golden/unit); "" for dir-unit
    public string exp;         // expected-output text (goldens only)
    public string lib;         // owning lib (unit/dir-unit)
    public string leaf;        // leaf name for safe-name / emit (unit base, dir-unit subdir)
    public string dir;         // case dir (golden dir-mode / dir-unit / lib-golden)
    public bool interpOnly;    // golden has an `interp_only` sidecar → no jit run
    public bool optAll;        // golden has an `opt_all` sidecar → compiled with `--opt-all` (same as the host gate)
    public _CorpusCase() {
        this.name = ""; this.bucket = ""; this.kind = "";
        this.src = ""; this.exp = ""; this.lib = "";
        this.leaf = ""; this.dir = ""; this.interpOnly = false; this.optAll = false;
    }
}

// Enumerate the full corpus (goldens + stdlib [Test] units/dir-units/lib-goldens)
// as descriptors — filter by name substring, but rid-INDEPENDENT (no capability
// exclusion, no cap): those are bundle-time policy applied by _buildTestBundle.
//
// Selection maps the shared corpus walk (_walkGoldenCorpus, common/xtask_golden.z42);
// only the ORDER is corpus-specific and load-bearing: a bucket's cases must stay
// CONTIGUOUS (_sampleCorpus and the shard slicer rely on it), and within a
// src/tests bucket dir-mode and flat-mode cases interleave in one raw-basename
// sort — hence the per-bucket regrouping below rather than a single pass.
_CorpusCase[] _enumerateCorpus(string root, string filter) {
    _GoldenEntry[] es = _walkGoldenCorpus(root);
    List<_CorpusCase> cs = new List<_CorpusCase>();

    // 1. src/tests goldens — per category, dir-mode (<cat>/<name>/source.z42) and
    // flat-mode (<cat>/<name>.z42) merged back into one sorted-by-entry-name run.
    foreach (var cat in _enumDirsSorted(Path.Join(root, "src/tests"))) {
        foreach (var e in _entriesInBucket(es, "tests-dir", "tests-flat", cat)) {
            if (e.seg == "tests-dir") {
                if (!e.hasSource) { continue; }
                if (_isExcludedDirName(cat, e.name)) { continue; }
            }
            string caseName = cat + "/" + e.name;
            if (filter.Length > 0 && !caseName.Contains(filter)) { continue; }
            _CorpusCase c = new _CorpusCase();
            c.name = caseName; c.bucket = cat; c.kind = "golden";
            c.src = e.src; c.exp = _readExpected(e.expected); c.dir = e.dir;
            c.interpOnly = e.interpOnly; c.optAll = e.optAll;
            cs.Add(c);
        }
    }

    // 2. stdlib per-lib: [Test] file units (2), [Test] dir units (2b), lib goldens (2c).
    foreach (var lib in _enumDirsSorted(Path.Join(root, "src/libraries"))) {
        // 2. file units (tests/*.z42)
        foreach (var e in _entriesInBucket(es, "lib-file", "lib-file", lib)) {
            string caseName = lib + "/" + e.name;
            if (filter.Length > 0 && !caseName.Contains(filter)) { continue; }
            _CorpusCase c = new _CorpusCase();
            c.name = caseName; c.bucket = lib; c.kind = "unit";
            c.src = e.src; c.lib = lib; c.leaf = e.name;
            cs.Add(c);
        }
        _GoldenEntry[] dirs = _entriesInBucket(es, "lib-dir", "lib-dir", lib);
        // 2b. dir-mode [Test] units (tests/<nm>/ with [Test] methods)
        foreach (var e in dirs) {
            if (!e.hasTestMethods) { continue; }
            string caseName = lib + "/" + e.name;
            if (filter.Length > 0 && !caseName.Contains(filter)) { continue; }
            _CorpusCase c = new _CorpusCase();
            c.name = caseName; c.bucket = lib; c.kind = "dir-unit";
            c.lib = lib; c.leaf = e.name; c.dir = e.dir;
            cs.Add(c);
        }
        // 2c. lib-mode goldens (tests/<nm>/source.z42 WITHOUT [Test])
        foreach (var e in dirs) {
            if (e.hasTestMethods || !e.hasSource) { continue; }
            string caseName = lib + "/" + e.name;
            if (filter.Length > 0 && !caseName.Contains(filter)) { continue; }
            _CorpusCase c = new _CorpusCase();
            c.name = caseName; c.bucket = lib; c.kind = "golden";
            c.src = e.src; c.exp = _readExpected(e.expected);
            c.lib = lib; c.leaf = e.name; c.dir = e.dir;
            c.interpOnly = e.interpOnly; c.optAll = e.optAll;
            cs.Add(c);
        }
    }

    return cs.ToArray();
}

// Entries of `bucket` (src/tests category or lib name) drawn from one or two
// segments, merged back into raw-directory-entry-name order. Both segments are
// already name-sorted inside the walk, so a two-pointer merge suffices; pass the
// same segment twice to select just that one.
_GoldenEntry[] _entriesInBucket(_GoldenEntry[] es, string segA, string segB, string bucket) {
    List<_GoldenEntry> a = new List<_GoldenEntry>();
    List<_GoldenEntry> b = new List<_GoldenEntry>();
    foreach (var e in es) {
        if (e.cat != bucket) { continue; }
        if (e.seg == segA) { a.Add(e); }
        else if (e.seg == segB) { b.Add(e); }
    }
    List<_GoldenEntry> merged = new List<_GoldenEntry>();
    int ia = 0; int ib = 0;
    while (ia < a.Count || ib < b.Count) {
        if (ib >= b.Count || (ia < a.Count && a[ia].entryName.CompareTo(b[ib].entryName) <= 0)) {
            merged.Add(a[ia]); ia = ia + 1;
        } else {
            merged.Add(b[ib]); ib = ib + 1;
        }
    }
    return merged.ToArray();
}

// Per-category sampling for the embed smoke cap: pick up to `cap` cases spread
// EVENLY across buckets (round-robin) — "first `cap` in sort order" would starve
// alphabetically-late categories. cap<=0 or total<=cap →
// return all (desktop = full coverage). Deterministic: buckets are the contiguous
// runs from _enumerateCorpus (first-appearance/sorted order), within-bucket order
// preserved, and the result is emitted in original enumeration order.
_CorpusCase[] _sampleCorpus(_CorpusCase[] cases, int cap) {
    int total = cases.Length;
    if (cap <= 0 || total <= cap) { return cases; }
    // Bucket boundaries: contiguous runs of equal .bucket.
    int[] starts = new int[total];
    int[] lens   = new int[total];
    int nb = 0;
    int i = 0;
    while (i < total) {
        int j = i;
        while (j < total && cases[j].bucket == cases[i].bucket) { j = j + 1; }
        starts[nb] = i; lens[nb] = j - i; nb = nb + 1;
        i = j;
    }
    // Round-robin one case per bucket per round until `cap` reached (or all drained).
    bool[] selected = new bool[total];
    int[] cursor = new int[nb];
    int picked = 0;
    bool progress = true;
    while (picked < cap && progress) {
        progress = false;
        int b = 0;
        while (b < nb && picked < cap) {
            if (cursor[b] < lens[b]) {
                selected[starts[b] + cursor[b]] = true;
                cursor[b] = cursor[b] + 1;
                picked = picked + 1;
                progress = true;
            }
            b = b + 1;
        }
    }
    // Emit in original enumeration order (stable bundle / manifest ordering).
    List<_CorpusCase> outc = new List<_CorpusCase>();
    i = 0;
    while (i < total) { if (selected[i]) { outc.Add(cases[i]); } i = i + 1; }
    return outc.ToArray();
}

// Full-coverage sharding for parallel tier-2 CI. Partition the (already capability-filtered) corpus into n DISJOINT slices by
// stable enumeration index: shard k gets every case where index % n == k-1. No
// cap — the union of shards 1..n is the FULL runnable corpus (100% coverage),
// with zero overlap. index%n interleaves across the contiguous bucket runs from
// _enumerateCorpus, so each shard stays category-balanced. Deterministic: keyed
// on enumeration order only, so re-runs and shard boundaries are reproducible.
_CorpusCase[] _shardCorpus(_CorpusCase[] cases, int k, int n) {
    List<_CorpusCase> outc = new List<_CorpusCase>();
    int i = k - 1;
    while (i < cases.Length) { outc.Add(cases[i]); i = i + n; }
    return outc.ToArray();
}

// Build the test bundle. Returns the manifest.json path ("" if no cases matched).
// Pipeline: enumerate full corpus → SELECT (shard slice OR per-category smoke
// sample) → compile the selection. Platform capability gating is NOT done here:
// each case's `// requires-caps:` goes into its manifest entry and the on-device
// runner (Std.Harness.BundleRunner) skips it when the target VM's Capabilities()
// lack one — the runtime is the ground truth, there is no per-rid table to drift.
//
// Two select modes on tier-2 (wasm/ios/android):
//   • shardN>0  → full-coverage slice k/n (_shardCorpus, NO cap). Nightly CI
//     fans out n parallel shard jobs; their union = 100% of the runnable corpus.
//   • shardN==0 → per-category smoke sample to embedCap=60 (_sampleCorpus) — the fast
//     local default; the whole corpus would blow the emulator/browser job wall.
string _buildTestBundle(string root, string filter, string rid, int shardK, int shardN) {
    string bundleDir = Path.Join(_workOut(root, "src/toolchain/workload/test", ""), "bundle");
    int embedCap = (rid.Contains("wasm") || rid.Contains("ios") || rid.Contains("android")) ? 60 : 0;

    _CorpusCase[] included = _enumerateCorpus(root, filter);
    int ni = included.Length;
    // --shard k/n wins over the smoke cap: run the full 1/n slice, no cap.
    _CorpusCase[] sel;
    if (shardN > 0) { sel = _shardCorpus(included, shardK, shardN); }
    else            { sel = _sampleCorpus(included, embedCap); }
    int capped = (shardN > 0) ? 0 : (ni - sel.Length);

    if (shardN > 0) {
        Console.WriteLine("  (embed shard " + shardK.ToString() + "/" + shardN.ToString()
            + ": full-coverage slice — selected " + sel.Length.ToString() + " of "
            + ni.ToString() + " runnable case(s); union of all " + shardN.ToString()
            + " shards = 100%)");
    }
    if (capped > 0) {
        Console.WriteLine("  (embed smoke: sampled " + sel.Length.ToString() + " of "
            + ni.ToString() + " per-category (cap " + embedCap.ToString() + "); skipped "
            + capped.ToString() + " — full coverage runs on desktop or via --shard)");
    }
    string mpath = _compileTestBundle(root, sel, bundleDir);
    if (mpath.Length == 0) { return ""; }
    Console.WriteLine("  bundle: " + sel.Length.ToString() + " cases → " + mpath);
    return mpath;
}

// manifest 只发布完整语料；重建前清掉旧产物，失败不能留下可被后续 run 消费的旧 manifest。
string _compileTestBundle(string root, _CorpusCase[] sel, string bundleDir) {
    _resetDir(bundleDir);
    if (sel.Length == 0) { ConsoleError.WriteLine("error: no cases matched filter"); return ""; }
    string[] entries = _compileBundleCases(root, sel, bundleDir);
    if (entries == null) { return ""; }
    string[] items = new string[sel.Length];
    for (int i = 0; i < sel.Length; i++) { items[i] = _withRequires(entries[i], _caseRequires(sel[i])); }
    return _writeBundleManifest(bundleDir, String.Join(",\n", items));
}

// 编译选中的用例进 bundleDir，返回与 sel 对齐的 manifest 条目；任一失败返回 null，并打印失败用例与诊断。
// 分批：spawn 一批 → 逐个 wait → 收尾（golden 写 .expected、dir-unit 删合成清单并拷出 zpkg）。各例输出路径互不相同。
string[] _compileBundleCases(string root, _CorpusCase[] sel, string bundleDir) {
    string[] entries = new string[sel.Length];
    bool failed = false;
    int jobs = _regenJobs();
    int k = 0;
    while (k < sel.Length) {
        int bsz = jobs;
        if (k + bsz > sel.Length) { bsz = sel.Length - k; }
        ProcessHandle[] hs = new ProcessHandle[bsz];
        string[] tomls = new string[bsz];
        for (int b = 0; b < bsz; b = b + 1) {
            _CorpusCase c = sel[k + b];
            string safe = _bundleSafeName(c.name);
            tomls[b] = "";
            Process p;
            if (c.kind == "dir-unit") {
                tomls[b] = _dirUnitManifest(root, c.lib, c.leaf, c.dir);
                p = _releaseZ42c(root).Arg("build").Arg(tomls[b]).Arg("--release");
            } else {
                p = _releaseZ42c(root).Arg("--emit-zbc").Arg(c.src).Arg(Path.Join(bundleDir, safe + ".zbc"));
                // opt_all 旁车 → `--opt-all`，与宿主 golden 门编法一致；否则 bundle 会把这些用例按未优化编，
                // 依赖优化可观察效果的断言就和宿主分叉。
                if (c.kind == "golden" && c.optAll) { p = p.Arg("--opt-all"); }
            }
            hs[b] = p.Spawn();
        }
        for (int b = 0; b < bsz; b = b + 1) {
            _CorpusCase c = sel[k + b];
            string safe = _bundleSafeName(c.name);
            ProcessResult r = hs[b].Wait();
            if (tomls[b].Length > 0) { File.Delete(tomls[b]); }   // 合成清单不管成败都删
            string entry = "";
            if (r.ExitCode == 0) {
                if (c.kind == "unit") {
                    entry = "    {\"name\": \"" + c.name + "\", \"zbc\": \"" + safe + ".zbc\"}";
                } else if (c.kind == "dir-unit") {
                    if (_copyDirUnit(root, c.lib, c.leaf, safe, bundleDir).Length > 0) {
                        entry = "    {\"name\": \"" + c.name + "\", \"zbc\": \"" + safe + ".zpkg\"}";
                    }
                } else {
                    entry = _goldenEntryFor(c.name, c.src, c.exp, safe, bundleDir);
                }
            }
            if (entry.Length == 0) {
                failed = true;
                ConsoleError.WriteLine("  ✗ " + c.kind + " " + c.name);
                if (r.Stdout.Length > 0) { ConsoleError.Write(r.Stdout); }
                if (r.Stderr.Length > 0) { ConsoleError.Write(r.Stderr); }
            }
            entries[k + b] = entry;
        }
        k = k + bsz;
    }
    return failed ? null : entries;
}

// The capabilities a case declares (`// requires-caps: a, b` in its source; see
// test-layout.md §4). A file case reads its file; a dir case unions every .z42 under
// its dir. Same parser as the bench scenarios (_epScenarioRequiredCaps) — one syntax.
string[] _caseRequires(_CorpusCase c) {
    string[] files = new string[0];
    if (c.src.Length > 0) { files = new string[]{ c.src }; }
    else if (c.dir.Length > 0 && Directory.Exists(c.dir)) { files = _sortedStrings(Path.GlobRecursive(c.dir, "*.z42")); }
    List<string> acc = new List<string>();
    foreach (var f in files) {
        foreach (var cap in _epScenarioRequiredCaps(File.ReadAllText(f))) {
            if (!acc.Contains(cap)) { acc.Add(cap); }
        }
    }
    return acc.ToArray();
}

// Append `"requires": [...]` to a manifest entry object (`{...}`) when non-empty.
string _withRequires(string entry, string[] reqs) {
    if (reqs.Length == 0) { return entry; }
    string arr = "\"" + String.Join("\", \"", reqs) + "\"";
    int close = entry.LastIndexOf("}");
    return entry.Substring(0, close) + ", \"requires\": [" + arr + "]" + entry.Substring(close);
}
