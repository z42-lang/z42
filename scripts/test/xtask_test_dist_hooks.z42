// xtask — 发布态 build hooks 冒烟（add-sdk-libs：analyzer / hooks 自动看见 SDK 库）。
//
// 守的洞：`[build] hooks` 的 hook 类要继承 `Z42.Build.BuildHooks`，而 `z42.build` 不在 shipped `libs/`、在 SDK 的
// 编译器目录（`programs/z42c/`）。z42b 编 hooks 时此前只给 `Z42_LIBS` ⇒ **装好的 SDK 里 hooks 一律编不过**
// （`E0494: 命名空间 Z42.Build 不存在` / `E0443: undefined type: BuildHooks`）。
//
// 开发树那格（`xtask test targets` 的 `_smokeBuildHooks`）测不到它：那里的 `Z42_LIBS` 是混装了编译器包的 alllibs，
// 洞被盖住了。所以这格必须用**打包出的 SDK**、并清掉全部 z42 相关环境变量（真实用户的样子）。
namespace Z42Xtask;

using Std;
using Std.IO;

int[] _hooksDistSmoke(string distDir, string work) {
    int[] r = new int[2];
    Console.WriteLine("build-hooks smoke (发布态 SDK): " + distDir);
    string z42b = Path.Join(distDir, "bin/z42b");
    if (!File.Exists(z42b)) { z42b = z42b + ".exe"; }   // Windows
    string d = Path.Join(work, "hookssmoke");
    Directory.Create(Path.Join(d, "hooks"));
    Directory.Create(Path.Join(d, "src"));
    string toml = Path.Join(d, "z42.toml");
    File.WriteAllText(toml,
        "[project]\nname = \"hooksmoke\"\nversion = \"0.1.0\"\nkind = \"exe\"\nentry = \"Main\"\n"
        + "[sources]\ninclude = [\"src/**/*.z42\"]\n"
        + "[build]\nhooks = \"hooks\"\n");
    File.WriteAllText(Path.Join(d, "src/main.z42"), "using Std.IO;\n\nvoid Main() { Console.WriteLine(\"hook app\"); }\n");
    File.WriteAllText(Path.Join(d, "hooks/hooks.z42"),
        "namespace Build;\n\nusing Std.IO;\nusing Z42.Build;\n\n"
        + "public class ProjectHooks : BuildHooks {\n"
        + "    public override void BeforeAssets(IPipelineContext ctx) { Console.WriteLine(\"DIST-HOOKS-SMOKE: BeforeAssets ran\"); }\n"
        + "}\n");
    ProcessResult pr = new Process(z42b).Arg("build").Arg(toml)
        .EnvRemove("Z42_HOME").EnvRemove("Z42_PORTABLE_VM").EnvRemove("Z42_LIBS").EnvRemove("Z42_COMPILER_LIBS")
        .WorkingDirectory(d).Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
    string all = pr.Stdout + pr.Stderr;
    if (pr.ExitCode == 0 && all.Contains("DIST-HOOKS-SMOKE: BeforeAssets ran")) {
        Console.WriteLine("  ✓ 装好的 SDK 上 `z42b build` 编译并执行了 build hooks（hook 继承 Z42.Build.BuildHooks）");
        r[0] = 1;
    } else {
        Console.WriteLine("  FAIL: build hooks on the packaged SDK (rc=" + pr.ExitCode.ToString() + ")");
        Console.WriteLine("    " + all.Replace("\n", "\n    "));
        r[1] = 1;
    }
    Console.WriteLine("");
    return r;
}
