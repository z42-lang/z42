// 阶段-2 欠账门（分阶段引入纪律的配套）。
//
// ## 守的是什么
//
// > 🔴 阶段 2 最容易被忘掉——因为忘了不会红。阶段 1 的过渡形态能一直跑下去，没有任何东西提醒你
// > 回来收尾，于是过渡形态**沉淀成常态**。**新开一个分阶段引入时，先想好阶段 2 由什么来提醒你**
// > ——没有提醒就等于没打算做。
//
// 诊断码那条线有 `xtask check diagcodes` 规则 ④⑥ 盯着；其余分阶段引入的过渡形态（新 stdlib API
// 等一个 nightly 再消费、格式 support 先行、为种子 ABI 留的转发层……）靠本门盯——它们的注释
// 同样会腐成假话（消费落地后没人回来改「今天没有调用方」那句）。
//
// ## 怎么用
//
// 在过渡形态**所在的那个文件**里写一行标记：
//
//     // STAGE2-DEBT(<tag>,YYYY-MM-DD): <阶段 2 要做的那件事>
//
// `<tag>` 是文件内唯一的短 slug（一个文件可以有多条债）；`YYYY-MM-DD` 是**挂账日**。
// 身份 = `<带根前缀的相对路径>#<tag>`（如 `src/compiler/.../X.z42#tag`、`scripts/build/Y.z42#tag`）。
// 挂账日写在标记里（登记表就是源码本身，无独立清单可腐坏）；宽限天数是门内常量。
//
// ⚠️ **说明必须写在标记那一行之内**：扫描只取该行 `)` 之后的部分，续行会被静默丢掉。
//
// 两条判据：
//   ① **挂账日**：标记必须带日期——没有日期的新债直接红（挂账日即起算日，写在源码里不会被
//      任何重置拨时钟；要推期限就改标记里的日期，理由写在说明文本里）。
//   ② **到期**：挂账超过宽限期（门内常量 7 天）→ 红，逼人回来收尾。
//
// ## ⚠️ 覆盖边界（写在这里，别让它变成隐形假保障）
//
// 本门**只看得见带 `STAGE2-DEBT` 标记的债**。没标记的过渡形态它一无所知 —— 所以它是「新债不会
// 再裸奔」的保障，**不是**「全仓没有裸奔的债」的保障。
//
// ⚠️ **判据刻意不是「去种子里查这个符号还在不在」**：那个更精确，但 CI 里拿不到「上一个 nightly
// 的种子」这个事实（同 diagcodes ⑥ 的取舍）。挂账天数是个能在纯文本扫描里算出来的近似。
namespace Z42Xtask;

using Std.IO;

// 宽限天数。阶段 2 的前提是「支持侧
// 随 nightly 发布**并成为种子**」，nightly 每天发 ⇒ 2 天够；余下是给发布链偶发失败 + 人回来
// 收尾留的余量。比 diagcodes 的 3 天宽，因为那条只要求常量进种子，而这里还要求真的把活干完。
int _s2GraceDays() { return 7; }

// 扫 `src/` / `scripts/` 下的 .z42 与 .rs，外加 `.github/` 下的 .yml，抽出
// `STAGE2-DEBT(<tag>,<date>): <text>` → id `<带根前缀的相对路径>#<tag>` + 挂账日 + 说明（三个数组同下标）。
//
// ⚠️ 扫描面 = 「过渡形态实际会出现在哪」——自举引导发生在「还没有 xtask」的时刻只能写成 bash，
// 天然落在 `.github/**.yml` 里；兼容副本 / 临时 env 传参落在 `scripts/`。门要跟着过渡形态的
// 落点走，新增落点时记得扩这里。
int _s2Scan(string root, string[] outIds, string[] outDates, string[] outTexts) {
    string[] roots = new string[3];
    roots[0] = "src";
    roots[1] = "scripts";
    roots[2] = ".github";
    int n = 0;
    int ri = 0;
    while (ri < roots.Length) {
        string rootRel = roots[ri];
        ri = ri + 1;
        n = _s2ScanOne(Path.Join(root, rootRel), rootRel, outIds, outDates, outTexts, n);
    }
    return n;
}

int _s2ScanOne(string dir, string idPrefix, string[] outIds, string[] outDates, string[] outTexts, int startN) {
    if (!Directory.Exists(dir)) { return startN; }
    string[] rel = Directory.EnumerateRecursive(dir);
    int n = startN;
    int f = 0;
    while (f < rel.Length) {
        string relp = rel[f].Replace("\\", "/");
        f = f + 1;
        if (_dcContains(relp, "/artifacts/")) { continue; }
        if (!relp.EndsWith(".z42") && !relp.EndsWith(".rs") && !relp.EndsWith(".yml")) { continue; }
        // 🔴 **排除本门自己**：头注里写着标记的语法示例、代码里有 `"STAGE2-DEBT("` 字面量，
        // 扫到自己就凭空多出 `#<tag>` / `#"` 这种垃圾条目。
        if (relp.EndsWith("xtask_test_stage2.z42")) { continue; }
        string text = "";
        try { text = File.ReadAllText(Path.Join(dir, relp)); }
        catch (Exception ex) { text = ""; }
        if (text == "") { continue; }
        if (text.IndexOf("STAGE2-DEBT(") < 0) { continue; }
        string[] lines = text.Split("\n");
        int li = 0;
        while (li < lines.Length) {
            string line = lines[li];
            li = li + 1;
            int at = line.IndexOf("STAGE2-DEBT(");
            if (at < 0) { continue; }
            string rest = line.Substring(at + 12);   // "STAGE2-DEBT(".Length
            int close = rest.IndexOf(")");
            if (close <= 0) { continue; }
            string head = rest.Substring(0, close).Trim();   // "<tag>,YYYY-MM-DD"
            string note = rest.Substring(close + 1).Trim();
            if (note.StartsWith(":")) { note = note.Substring(1).Trim(); }
            string tag = head;
            string date = "";
            int comma = head.IndexOf(",");
            if (comma > 0) { tag = head.Substring(0, comma).Trim(); date = head.Substring(comma + 1).Trim(); }
            if (tag == "") { continue; }
            if (n < outIds.Length) {
                outIds[n] = idPrefix + "/" + relp + "#" + tag;
                outDates[n] = date;
                outTexts[n] = note;
                n = n + 1;
            }
        }
    }
    return n;
}

int _testStage2Debt() {
    string root = _root();
    string[] ids = new string[256];
    string[] dates = new string[256];
    string[] notes = new string[256];
    int n = _s2Scan(root, ids, dates, notes);

    int bad = 0;
    int today = _dcCivilDays(_dcToday());
    int a = 0;
    while (a < n) {
        // 挂账日随标记一起扫出来（同文件多条债各自的日期；别回头重扫文件取「最后一个」）。
        string date = dates[a];
        if (date.Length != 10) {
            ConsoleError.WriteLine("  ✗ 阶段-2 欠账缺挂账日: " + ids[a] + " —— 标记写成 STAGE2-DEBT(<tag>,YYYY-MM-DD)，日期即起算日");
            bad = bad + 1;
        } else {
            int dd = _dcCivilDays(date);
            if (dd < 0) {
                ConsoleError.WriteLine("  ✗ 挂账日不是 YYYY-MM-DD: " + ids[a] + "（" + date + "）");
                bad = bad + 1;
            } else if (today >= 0 && (today - dd) > _s2GraceDays()) {
                ConsoleError.WriteLine("  ✗ 阶段-2 欠账超期 " + (today - dd).ToString() + " 天（宽限 "
                    + _s2GraceDays().ToString() + " 天）: " + ids[a]);
                ConsoleError.WriteLine("      支持侧早该随 nightly 进种子了 —— 回去把阶段 2 做掉，然后删标记。");
                bad = bad + 1;
            }
        }
        a = a + 1;
    }

    if (bad > 0) { return 1; }
    Console.WriteLine("  ✓ 阶段-2 欠账 " + n.ToString() + " 条，均已挂账且未超期");
    return 0;
}
