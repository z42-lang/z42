// xtask — `test toolchain builder` 的 workspace 根 smoke（_testTargetsCore 调用）：z42b 在 workspace 根
// 按 `default_members` 逐成员 build / test，`--workspace` 覆盖全部成员。
// fixture：src/toolchain/builder/tests/fixtures/z42b/workspace-default（跑拷贝，源码树零写入）。
namespace Z42Xtask;

using Std.IO;

int _smokeWorkspaceDefault(string root, TargetTooling tt) {
    string ws = Path.Join(tt.Z42bFixturesRoot, "workspace-default");
    if (!File.Exists(Path.Join(ws, "z42.workspace.toml"))) { return 0; }
    Console.WriteLine("");
    Console.WriteLine("── workspace default_members (z42b build / test <workspace>, --workspace) ──");
    int failed = 0;

    // ① build：只建 default_members（hello）+ 它按名依赖的兄弟成员 greet；故意编不过的 broken 不碰。
    ProcessResult b = _z42bRunPiped(root, tt, "build", ws, "");
    string bo = b.Stdout + b.Stderr;
    if (b.ExitCode != 0 || bo.IndexOf("[1/2] ws.greet (dependency)") < 0 || bo.IndexOf("[2/2] ws.hello") < 0
        || bo.IndexOf("ws.broken") >= 0) {
        Console.WriteLine("  ❌ workspace build: 期望只建 ws.greet（依赖）+ ws.hello，rc=0；实得 rc="
            + b.ExitCode.ToString());
        Console.WriteLine("    输出: " + bo);
        failed = failed + 1;
    } else {
        Console.WriteLine("  ✅ workspace build: default_members + 依赖，按拓扑序");
    }

    // ② test：目标只有 hello，它的 [Test] 经兄弟成员 greet 跑通。
    ProcessResult t = _z42bRunPiped(root, tt, "test", ws, "");
    string to = t.Stdout + t.Stderr;
    if (t.ExitCode != 0 || to.IndexOf("test_line_uses_sibling") < 0 || to.IndexOf("ws.broken") >= 0) {
        Console.WriteLine("  ❌ workspace test: 期望跑 ws.hello 的测试且通过；实得 rc=" + t.ExitCode.ToString());
        Console.WriteLine("    输出: " + to);
        failed = failed + 1;
    } else {
        Console.WriteLine("  ✅ workspace test: 只测 default_members，依赖成员先建");
    }

    // ③ --workspace：全部成员 ⇒ 必须建到 broken 并失败。
    ProcessResult a = _z42bRunPiped(root, tt, "build", ws, "--workspace");
    string ao = a.Stdout + a.Stderr;
    if (a.ExitCode == 0 || ao.IndexOf("member `ws.broken` failed to build") < 0) {
        Console.WriteLine("  ❌ workspace build --workspace: 期望建到 ws.broken 并失败；实得 rc=" + a.ExitCode.ToString());
        Console.WriteLine("    输出: " + ao);
        failed = failed + 1;
    } else {
        Console.WriteLine("  ✅ workspace build --workspace: 覆盖全部成员");
    }
    return failed;
}

// `z42b <verb> <target> [flag]`，stdout/stderr 收回（smoke 看输出断言）。
ProcessResult _z42bRunPiped(string root, TargetTooling tt, string verb, string target, string flag) {
    Process p = _z42bVerb(root, tt, verb).Arg(target);
    if (flag.Length > 0) { p = p.Arg(flag); }
    return p.Stdout(Stdio.Pipe()).Stderr(Stdio.Pipe()).Run();
}
