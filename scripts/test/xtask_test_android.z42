// xtask — Android platform backend (IPlatformBackend):
//   ① BuildProject : cargo-ndk × ABIs → jniLibs, then gradle :z42vm:assembleRelease (AAR)
//   ② Assets       : fixtures → androidTest/assets/test-fixtures; stdlib → main/assets/stdlib
//   ③ RunTests     : z42b's android driver (`_runAndroidTesthost`) — ONE
//                    `gradlew :z42vm:connectedAndroidTest` (R1–R7 + embedded corpus)
//
// The cargo-ndk .so build stays here (_cargoNdkJniLibs) — z42b builds no native code; the
// embedded corpus staging and the run are z42b's (builder_device_android.z42), and so is the
// device lifecycle: an attached device (CI's emulator action, a dev's running emulator or
// phone) is reused; with none attached z42b boots the AVD headless and shuts it down after
// (test-layout.md §6). All of it runs in the staged host copy (_stageDeviceHost). Needs
// cargo-ndk + ANDROID_NDK_HOME + JDK + Android SDK.
namespace Z42Xtask;

using Std.IO;
using Std.Toml;

public class AndroidBackend : IPlatformBackend {
    public string Name() { return "android"; }

    public AssetLayout Assets(string root) {
        string here = _deviceHost(root, "android");
        string[] stdlibDirs = new string[1];
        stdlibDirs[0] = Path.Join(here, "z42vm/src/main/assets/stdlib");
        return new AssetLayout(Path.Join(here, "z42vm/src/androidTest/assets/test-fixtures"),
                               stdlibDirs, false);
    }

    // ① cargo-ndk per ABI → jniLibs, then gradle assembleRelease → AAR.
    public int BuildProject(string root) {
        if (Process.Which("cargo") == null) {
            ConsoleError.WriteLine("error: cargo not found (https://rustup.rs)");
            return 1;
        }
        if (Process.Which("cargo-ndk") == null) {
            ConsoleError.WriteLine("error: cargo-ndk not found (cargo install cargo-ndk)");
            return 1;
        }
        string here = _deviceHost(root, "android");
        string ndk = _androidNdkDir(root);
        if (ndk.Length == 0) { return 1; }

        TomlValue toml = _vparse(root);
        string[] abis = _vgetList(toml, "platform.android.abis");
        int c = _cargoNdkJniLibs(root, abis, Path.Join(here, "z42vm/src/main/jniLibs"));
        if (c != 0) { return c; }

        // gradle assembleRelease → z42vm-release.aar
        string gradlew = Path.Join(here, "gradlew");
        if (!File.Exists(gradlew)) {
            ConsoleError.WriteLine("error: gradlew not present at " + gradlew + " (gradle wrapper needed)");
            return 1;
        }
        // AGP locates the SDK via ANDROID_HOME / ANDROID_SDK_ROOT (or sdk.dir in
        // local.properties). CI's setup-android action exports these; locally they
        // are unset, so point gradle at the hermetic SDK (setup --os
        // android → artifacts/tools/android-sdk). Without this gradle aborts with
        // "SDK location not found".
        string sdk = _androidSdkDir(root);
        if (sdk.Length == 0) { return 1; }
        Console.WriteLine("  ./gradlew :z42vm:assembleRelease");
        return _execIn(new Process(gradlew).Arg(":z42vm:assembleRelease")
            .Env("ANDROID_NDK_HOME", ndk).Env("ANDROID_HOME", sdk).Env("ANDROID_SDK_ROOT", sdk), here);
    }

    // ③ z42b runs the staged host project on a device (the embedded bundle must be built —
    // `xtask test app android` does the whole pipeline).
    public int RunTests(string root) {
        return _runAndroidTesthost(root, _androidHostRid());
    }
}

// ANDROID_NDK_HOME env, else auto from versions.toml install_root/ndk/<version>.
string _androidNdkDir(string root) {
    string env = Environment.GetEnvironmentVariable("ANDROID_NDK_HOME", "");
    if (env.Length > 0) {
        if (Directory.Exists(env)) { return env; }
        ConsoleError.WriteLine("error: ANDROID_NDK_HOME set but not a dir: " + env);
        return "";
    }
    TomlValue toml = _vparse(root);
    string installRoot = _vget(toml, "build.android.install_root");
    string ver = _vget(toml, "build.android.ndk.version");
    string auto = Path.Join(root, Path.Join(installRoot, Path.Join("ndk", ver)));
    if (Directory.Exists(auto)) { return auto; }
    ConsoleError.WriteLine("error: NDK not found — run `xtask setup --os android` (installs to " + auto + "), or set ANDROID_NDK_HOME");
    return "";
}

// ANDROID_HOME / ANDROID_SDK_ROOT env, else auto from versions.toml install_root.
string _androidSdkDir(string root) {
    string env = Environment.GetEnvironmentVariable("ANDROID_HOME", "");
    if (env.Length == 0) { env = Environment.GetEnvironmentVariable("ANDROID_SDK_ROOT", ""); }
    if (env.Length > 0) {
        if (Directory.Exists(env)) { return env; }
        ConsoleError.WriteLine("error: ANDROID_HOME/ANDROID_SDK_ROOT set but not a dir: " + env);
        return "";
    }
    TomlValue toml = _vparse(root);
    string installRoot = _vget(toml, "build.android.install_root");
    string auto = Path.Join(root, installRoot);
    if (Directory.Exists(auto)) { return auto; }
    ConsoleError.WriteLine("error: Android SDK not found — run `xtask setup --os android` (installs to " + auto + "), or set ANDROID_HOME");
    return "";
}

// cargo ndk -t <abi>… -o <outDir> build --release → <outDir>/<abi>/*.so（jniLibs 形）。crate 在源码位置编；cargo-ndk 在 crate 目录里跑，找不到 src/runtime/.cargo，
// 所以显式传 `--config`。
int _cargoNdkJniLibs(string root, string[] abis, string outDir) {
    if (Process.Which("cargo") == null) {
        ConsoleError.WriteLine("error: cargo not found (https://rustup.rs)");
        return 1;
    }
    if (Process.Which("cargo-ndk") == null) {
        ConsoleError.WriteLine("error: cargo-ndk not found (cargo install cargo-ndk)");
        return 1;
    }
    string ndk = _androidNdkDir(root);
    if (ndk.Length == 0) { return 1; }
    string rustDir = Path.Join(_deviceHostSrc(root, "android"), "rust");
    string jniLibs = outDir;

    Process p = new Process("cargo").Arg("ndk");
    foreach (var abi in abis) { p = p.Arg("-t").Arg(abi); }
    p = p.Arg("-o").Arg(jniLibs).Arg("build").Arg("--release")
        .Arg("--config").Arg(Path.Join(root, _runtimeCargoConfig()));
    // cargo-ndk's C-dep CMake cross-builds (zlib-ng via z42-compression) use
    // CMake's *built-in* Android toolchain, which locates the NDK via the
    // ANDROID_NDK / ANDROID_NDK_ROOT env vars — NOT ANDROID_NDK_HOME (which
    // only cargo-ndk + gradle read). Without these, cmake aborts with
    // "Neither the NDK nor a standalone toolchain was found", which cascades
    // into a misleading "unable to find a build program corresponding to
    // Ninja". Set all three so cmake finds the NDK; the default Unix Makefiles
    // generator (make from Xcode CLT / build-essential) then works — no Ninja
    // needed on any platform.
    p = p.Env("ANDROID_NDK_HOME", ndk).Env("ANDROID_NDK", ndk).Env("ANDROID_NDK_ROOT", ndk);
    Console.WriteLine("  cargo ndk build --release (" + abis.Length.ToString() + " ABI) -> " + jniLibs);
    return _execIn(p, rustDir);
}

// The android RID matching the host CPU: an emulator only runs (hardware-accelerated) an image
// of the host's own architecture — Apple Silicon → arm64, CI's linux-x64 → x86_64.
string _androidHostRid() {
    return Platform.Arch() == "aarch64" ? "android-arm64" : "android-x64";
}

// adb sees at least one device in the `device` state. SDK = ANDROID_HOME / ANDROID_SDK_ROOT,
// else the hermetic one (same order as _androidSdkDir, but silent: "no SDK" just means "no device").
bool _androidDeviceAttached(string root) {
    string sdk = Environment.GetEnvironmentVariable("ANDROID_HOME", "");
    if (sdk.Length == 0) { sdk = Environment.GetEnvironmentVariable("ANDROID_SDK_ROOT", ""); }
    if (sdk.Length == 0) { sdk = Path.Join(root, _vget(_vparse(root), "build.android.install_root")); }
    string adb = Path.Join(sdk, "platform-tools/adb");
    if (!File.Exists(adb)) { return false; }
    ProcessResult res = new Process(adb).Arg("devices").Run();
    if (res.ExitCode != 0) { return false; }
    foreach (var line in res.Stdout.Split("\n")) {
        string t = line.Trim();
        if (t.EndsWith("\tdevice") || t.EndsWith(" device")) { return true; }
    }
    return false;
}

// The emulator tier (emulator + system image + AVD + Gradle, ~4GB) is an install-on-use
// dependency with no command of its own (simplify-xtask-deps): needed only when z42b has to
// boot an AVD, installed here when missing. An external SDK (ANDROID_HOME) is never modified —
// missing emulator/ there is an error. Install failure = test failure.
int _ensureAndroidEmulatorTier(string root) {
    string sdk = _androidSdkDir(root);
    if (sdk.Length == 0) { return 1; }
    if (File.Exists(Path.Join(sdk, "emulator/emulator"))) { return 0; }
    string hermetic = Path.Join(root, _vget(_vparse(root), "build.android.install_root"));
    if (sdk != hermetic) {
        ConsoleError.WriteLine("error: SDK at " + sdk + " (ANDROID_HOME/ANDROID_SDK_ROOT) lacks emulator/;"
            + " install it there, or unset the env to use the hermetic SDK (auto-managed)");
        return 1;
    }
    Console.WriteLine("  Android emulator tier missing — installing (~4GB, one-time)");
    return _installAndroidEmulator(false);
}
