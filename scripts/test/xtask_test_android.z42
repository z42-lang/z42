// xtask — Android platform backend (add-platform-test-pipeline, 2026-06-15).
// Implements IPlatformBackend (logic ported from the former
// src/toolchain/workload/android/platform/build.sh, now removed):
//   ① BuildProject : cargo-ndk × ABIs → jniLibs, then gradle :z42vm:assembleRelease (AAR)
//   ② Assets       : fixtures → androidTest/assets/test-fixtures; stdlib → main/assets/stdlib
//   ③ RunTests     : local emulator-lifecycle harness (test.sh: boot + connectedAndroidTest)
//
// z42b-device-run PR-3: the embedded corpus build+deploy (cargo-ndk .so + stage)
// AND the emulator RUN (gradlew connectedAndroidTest) 下沉 z42b's android driver
// (builder_device_android.z42). CI drives z42b directly — `test embedded --rid
// android-x64` (→ z42b --build) + the reactivecircus action's `script` calls z42b
// --run. This backend's ③ RunTests keeps test.sh for the LOCAL path only: the
// emulator AVD lifecycle (boot/poll/kill) stays out of z42b by design (D2
// asymmetry — CI's reactivecircus action supplies the emulator; test.sh supplies it
// locally). Needs cargo-ndk + ANDROID_NDK_HOME + JDK + Android SDK.
namespace Z42Xtask;

using Std.IO;

public class AndroidBackend : IPlatformBackend {
    public string Name() { return "android"; }

    public AssetLayout Assets(string root) {
        string here = Path.Join(root, "src/toolchain/workload/android/platform");
        string[] stdlibDirs = new string[1];
        stdlibDirs[0] = Path.Join(here, "z42vm/src/main/assets/stdlib");
        return new AssetLayout(Path.Join(here, "z42vm/src/androidTest/assets/test-fixtures"),
                               stdlibDirs, false);
    }

    // ① cargo-ndk per ABI → jniLibs, then gradle assembleRelease → AAR.
    public int BuildProject(string root) {
        if (Process.Which("cargo") == null) {
            ConsoleError.WriteLine("error: cargo not found (https://rustup.rs)");
            return 1;
        }
        if (Process.Which("cargo-ndk") == null) {
            ConsoleError.WriteLine("error: cargo-ndk not found (cargo install cargo-ndk)");
            return 1;
        }
        string here = Path.Join(root, "src/toolchain/workload/android/platform");
        string rustDir = Path.Join(here, "rust");
        string jniLibs = Path.Join(here, "z42vm/src/main/jniLibs");

        string ndk = this._resolveNdk(root);
        if (ndk.Length == 0) { return 1; }

        TomlValue toml = _vparse(root);
        string[] abis = _vgetList(toml, "platform.android.abis");

        // cargo ndk -t <abi> ... -o <jniLibs> build --release   (run in rust/)
        Process p = new Process("cargo").Arg("ndk");
        foreach (var abi in abis) { p = p.Arg("-t").Arg(abi); }
        p = p.Arg("-o").Arg(jniLibs).Arg("build").Arg("--release");
        // cargo-ndk's C-dep CMake cross-builds (zlib-ng via z42-compression) use
        // CMake's *built-in* Android toolchain, which locates the NDK via the
        // ANDROID_NDK / ANDROID_NDK_ROOT env vars — NOT ANDROID_NDK_HOME (which
        // only cargo-ndk + gradle read). Without these, cmake aborts with
        // "Neither the NDK nor a standalone toolchain was found", which cascades
        // into a misleading "unable to find a build program corresponding to
        // Ninja". Set all three so cmake finds the NDK; the default Unix Makefiles
        // generator (make from Xcode CLT / build-essential) then works — no Ninja
        // needed on any platform.
        p = p.Env("ANDROID_NDK_HOME", ndk).Env("ANDROID_NDK", ndk).Env("ANDROID_NDK_ROOT", ndk);
        Console.WriteLine("  cargo ndk build --release (ABIs from versions.toml) -> " + jniLibs);
        int c = _execIn(p, rustDir);
        if (c != 0) { return c; }

        // gradle assembleRelease → z42vm-release.aar
        string gradlew = Path.Join(here, "gradlew");
        if (!File.Exists(gradlew)) {
            ConsoleError.WriteLine("error: gradlew not present at " + gradlew + " (gradle wrapper needed)");
            return 1;
        }
        // AGP locates the SDK via ANDROID_HOME / ANDROID_SDK_ROOT (or sdk.dir in
        // local.properties). CI's setup-android action exports these; locally they
        // are unset, so point gradle at the hermetic SDK (deps install --os
        // android → artifacts/tools/android-sdk). Without this gradle aborts with
        // "SDK location not found".
        string sdk = this._resolveSdk(root);
        if (sdk.Length == 0) { return 1; }
        Console.WriteLine("  ./gradlew :z42vm:assembleRelease");
        return _execIn(new Process(gradlew).Arg(":z42vm:assembleRelease")
            .Env("ANDROID_NDK_HOME", ndk).Env("ANDROID_HOME", sdk).Env("ANDROID_SDK_ROOT", sdk), here);
    }

    // ③ LOCAL emulator-lifecycle path (z42b-device-run PR-3: CI runs z42b --run via
    // the reactivecircus action instead; this stays for `test platform android run`
    // on a dev box). Delegates to test.sh (emulator boot + gradle connectedAndroidTest).
    // emulator tier（emulator + system-image + AVD + Gradle，~4GB）是"用到才装"
    // 依赖，零命令面（simplify-xtask-deps, User 裁决 2026-07-07）：在这里检测缺失
    // 并自动安装，绝不由用户手动触发。安装失败 = 测试失败（不吞不跳过）。
    public int RunTests(string root) {
        string sdk = this._resolveSdk(root);
        if (sdk.Length == 0) { return 1; }
        if (!File.Exists(Path.Join(sdk, "emulator/emulator"))) {
            TomlValue toml = _vparse(root);
            string hermetic = Path.Join(root, _vget(toml, "build.android.install_root"));
            if (sdk != hermetic) {
                ConsoleError.WriteLine("error: SDK at " + sdk + " (ANDROID_HOME/ANDROID_SDK_ROOT) lacks emulator/;"
                    + " install it there, or unset the env to use the hermetic SDK (auto-managed)");
                return 1;
            }
            Console.WriteLine("  emulator tier missing — auto-installing (~4GB, one-time)");
            int ic = _depsInstallAndroidEmulator(false);
            if (ic != 0) { return ic; }
        }
        string here = Path.Join(root, "src/toolchain/workload/android/platform");
        Console.WriteLine("  bash test.sh  (emulator + connectedAndroidTest; full port → CI change)");
        return _execIn(new Process("bash").Arg("test.sh"), here);
    }

    // ANDROID_NDK_HOME env, else auto from versions.toml install_root/ndk/<version>.
    string _resolveNdk(string root) {
        string env = Environment.GetEnvironmentVariable("ANDROID_NDK_HOME") ?? "";
        if (env.Length > 0) {
            if (Directory.Exists(env)) { return env; }
            ConsoleError.WriteLine("error: ANDROID_NDK_HOME set but not a dir: " + env);
            return "";
        }
        TomlValue toml = _vparse(root);
        string installRoot = _vget(toml, "build.android.install_root");
        string ver = _vget(toml, "build.android.ndk.version");
        string auto = Path.Join(root, Path.Join(installRoot, Path.Join("ndk", ver)));
        if (Directory.Exists(auto)) { return auto; }
        ConsoleError.WriteLine("error: NDK not found. Set ANDROID_NDK_HOME or install to " + auto);
        return "";
    }

    // ANDROID_HOME / ANDROID_SDK_ROOT env, else auto from versions.toml install_root.
    string _resolveSdk(string root) {
        string env = Environment.GetEnvironmentVariable("ANDROID_HOME") ?? "";
        if (env.Length == 0) { env = Environment.GetEnvironmentVariable("ANDROID_SDK_ROOT") ?? ""; }
        if (env.Length > 0) {
            if (Directory.Exists(env)) { return env; }
            ConsoleError.WriteLine("error: ANDROID_HOME/ANDROID_SDK_ROOT set but not a dir: " + env);
            return "";
        }
        TomlValue toml = _vparse(root);
        string installRoot = _vget(toml, "build.android.install_root");
        string auto = Path.Join(root, installRoot);
        if (Directory.Exists(auto)) { return auto; }
        ConsoleError.WriteLine("error: Android SDK not found. Set ANDROID_HOME or run deps install --os android (-> " + auto + ")");
        return "";
    }
}
