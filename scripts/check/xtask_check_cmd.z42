// xtask `check`：不编译、不跑用例的静态检查（纯文本扫描 / 生成物比对，秒级）。
//
//   xtask check            全部跑一遍（顺序同 GREEN gate 里的对应 stage），汇总哪些红
//   xtask check <name>     只跑一个
//   xtask check <name> --update   重写该检查在 scripts/test/gates.toml 的机器区段
//                                 （diagcodes / doc-refs / layers；其余无 --update）
//
// 它们在 GREEN gate 里仍各是一个 stage（stage 名不变，见 test-gate.md）；这里只是单跑的入口。
namespace Z42Xtask;

using Std.IO;
using Std.Cli;

// 名字 → 说明。顺序即 `xtask check` 全跑的顺序（= GREEN gate 里的顺序）。
string[] _checkNames() {
    return new string[]{ "vscode-syntax", "diagcodes", "stage2", "ci-shell", "proc-env", "layout", "versions", "layers", "docs-api", "doc-lints", "doc-refs" };
}

string _checkDesc(string name) {
    if (name == "vscode-syntax") { return "VSCode grammar ↔ Lexer keyword table (regenerate in memory, diff vs committed)"; }
    if (name == "diagcodes")     { return "every emitted diagnostic code is registered exactly once in DiagnosticCodes"; }
    if (name == "stage2")        { return "staged-introduction debt: every STAGE2-DEBT 标记（<tag>,date) marker carries a claim date and none is past grace"; }
    if (name == "ci-shell")      { return "CI composite actions' run: blocks use no variable before assigning it (set -u)"; }
    if (name == "proc-env")      { return "Z42_LIBS / Z42_PROBING_PATHS are set only via _z42Proc / _z42bProc"; }
    if (name == "layout")        { return "test layout spec: src/tests categories, capability vocabulary, artifacts mirror"; }
    if (name == "versions")      { return "versions.toml ↔ its projections (Cargo.toml / build.gradle.kts / Package.swift) agree"; }
    if (name == "layers")        { return "runtime module layering: cross-component refs + platform cfg / libc outside pal within the gates.toml baseline (`--update` after shrinking)"; }
    if (name == "docs-api")      { return "generated reference stdlib pages match the source doc comments (run `xtask doc gen` to regenerate)"; }
    if (name == "doc-lints")     { return "stdlib doc comments: any W08xx finding is red (hard gate, no allowlist)"; }
    if (name == "doc-refs")      { return "book pages and READMEs cite code by resolvable symbols, no stale line numbers (run `xtask check doc-refs --update` after fixing)"; }
    return "";
}

class CheckCommand : Command {
    [Option(help: "diagcodes / doc-refs / layers: rewrite the gates.toml machine section from the current tree")]
    public bool Update;
    [Argument(help: "one check (default: all; `xtask check -h` lists them)")]
    public string Name = "";

    public CheckCommand() : base("check", "static checks — no build, no test run (no name = all)") {}

    public override int Run() {
        if (this.Name.Length > 0) { return _checkNamed(this.Name, this.Update); }
        if (this.Update) {
            throw new CliException("--update needs a check name (diagcodes / doc-refs / layers)");
        }
        return _checkAll();
    }
}

int _checkNamed(string name, bool update) {
    if (_checkDesc(name).Length == 0) {
        ConsoleError.WriteLine("xtask check: unknown check '" + name + "'");
        foreach (var n in _checkNames()) { ConsoleError.WriteLine("  " + _padRight(n, 15) + _checkDesc(n)); }
        return 2;
    }
    if (update && name != "diagcodes" && name != "doc-refs" && name != "layers") {
        ConsoleError.WriteLine("xtask check: --update only applies to diagcodes / doc-refs / layers");
        return 2;
    }
    return _checkOne(name, update);
}

// 全跑：不在第一处红就停 —— 一次看到所有红的检查。
int _checkAll() {
    string failed = "";
    foreach (var n in _checkNames()) {
        Console.WriteLine("");
        Console.WriteLine("── check " + n + " ──");
        if (_checkOne(n, false) != 0) { failed = failed.Length == 0 ? n : failed + ", " + n; }
    }
    Console.WriteLine("");
    if (failed.Length > 0) {
        ConsoleError.WriteLine("❌ check: " + failed);
        return 1;
    }
    Console.WriteLine("✅ check: all " + _checkNames().Length.ToString() + " passed");
    return 0;
}

int _checkOne(string name, bool update) {
    if (name == "vscode-syntax") { return _testVscodeSyntax(); }
    if (name == "diagcodes")     { return _testDiagCodes(update); }
    if (name == "stage2")        { return _testStage2Debt(); }   // stage2 无 --update：挂账日在源码标记里
    if (name == "ci-shell")      { return _testCiShell(); }
    if (name == "proc-env")      { return _testProcEnv(); }
    if (name == "versions")      { return _checkVersions(); }
    if (name == "layers")        { return _testLayers(update); }
    if (name == "docs-api")      { return _checkDocsApi(); }
    if (name == "doc-lints")     { return _checkDocLints(); }   // doc-lints 无 --update：硬门，白名单在 gates.toml [doc-lints]
    if (name == "doc-refs")      { return _checkDocRefs(update); }
    return _testLayout();
}
