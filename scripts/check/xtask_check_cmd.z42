// 静态检查与引用报告的入口；名称、说明与处理函数只在此登记。
namespace Z42Xtask;

using Std.IO;
using Std.Cli;

class CheckSpec {
    public string Name;
    public string Description;
    public Func<int> Body;
    public CheckSpec(string name, string description, Func<int> body) {
        this.Name = name; this.Description = description; this.Body = body;
    }
}

CheckSpec[] _checks() {
    return new CheckSpec[]{
        new CheckSpec("vscode-syntax", "VSCode grammar agrees with Lexer keywords", () => _testVscodeSyntax()),
        new CheckSpec("diagcodes", "diagnostic registration, documentation, liveness and test coverage", () => _checkDiagCodes()),
        new CheckSpec("ci-shell", "CI shell variables are assigned before use", () => _checkCiShell()),
        new CheckSpec("proc-env", "z42 child-process environments use the shared factories", () => _checkProcEnv()),
        new CheckSpec("layout", "test categories, capabilities and artifact layout agree", () => _checkLayout()),
        new CheckSpec("versions", "versions.toml agrees with its projections", () => _checkVersions()),
        new CheckSpec("doc-lints", "stdlib doc comments have no W08xx findings", () => _checkDocLints()),
        new CheckSpec("doc-refs", "report stale line numbers and unresolved book/README code references", () => _checkDocRefs())
    };
}

class CheckCommand : Command {
    public CheckCommand() : base("check", "static checks and code-reference reports") {
        this.SetDefaultAction("run all checks and report every failure");
        foreach (var check in _checks()) { this.AddCommand(new CheckOneCommand(check)); }
    }
    public override int Run() { return _checkAll(); }
}

class CheckOneCommand : Command {
    private CheckSpec _check;
    public CheckOneCommand(CheckSpec check) : base(check.Name, check.Description) { this._check = check; }
    public override int Run() { return this._check.Body(); }
}

int _checkAll() {
    string failed = "";
    foreach (var check in _checks()) {
        Console.WriteLine("\n── check " + check.Name + " ──");
        if (check.Body() != 0) { failed = failed.Length == 0 ? check.Name : failed + ", " + check.Name; }
    }
    if (failed.Length > 0) { ConsoleError.WriteLine("❌ check: " + failed); return 1; }
    Console.WriteLine("✅ check: all passed");
    return 0;
}
